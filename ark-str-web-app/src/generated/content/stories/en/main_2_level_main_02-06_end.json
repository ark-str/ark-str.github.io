  "blocks": [
    {
      "type": "narration",
      "text": "第十八关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "...I thought we agreed that this was going to be my grand entrance.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "You're too slow.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The important thing is that we're all safe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We should get moving.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Let's start heading back down from this building to the east. Reunion won't know where we are.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Are we... safe?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Yes... For now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Your complexion doesn't look too good...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I'm... a little dizzy...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "It's... fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Miss Misha, how long have you been in Lungmen?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "About... a week.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Just one week...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Mm... A lot of strange people appeared in the city... and then...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I'm not sure what happened... Everyone started fleeing, so I also...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It was Reunion... Reunion attacked Chernobog.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I don't know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Were you... Infected before?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I... I don't know...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "But these last few days, these things... began growing on my leg.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Misha? Misha? !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Medic! Where's the medic squad? !",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
