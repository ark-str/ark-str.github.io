  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十九关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Don't let them get through!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "W should have escaped with Misha...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "We can't let!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Out of my way! Do you have a death wish?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Uaaagh!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "O-ohhh... That savage fighting style reminds me of someone from Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "They do have a lot in common, don't they?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Franka, don't just stand there!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Hurry up and do something!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Sure, sure.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Hah, looks like all those legends about Lungmen's Inspector are true...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Stay focused.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Hey, I'm not just...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "...Staring at other people! *Bang!*",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "text": "Argh!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "See those enemy squads on the second floor? I found 'em first!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Good job.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Hehe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...Let's go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "We can't let our client handle this alone.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Franka, have you found Misha?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "I can't find her anywhere.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "W probably... already took her away...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Tsk... Don't you think that was a bit too fast...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What was that... an explosion?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Franka, gather your squad. We have to back up the L.G.D.!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "text": "Rhodes Island, watch out!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "text": "Th-this enemy...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "text": "They...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What happened...? Talk to me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The enemy...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...What? !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That's...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "H-how is that possible...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Tsk... Is this some kind of trick?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "It's a miracle! It's a miracle!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Why...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Don't just stand there! Take cover!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "We've been sent a miracle!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Is that you...? It's really you!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...He's fine!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "H-he's fine again!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Skullshatterer is still alive!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Skullshatterer! It's really you!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Hooray! !",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Could it be...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...No...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Reunion's morale has been boosted since the reappearance of their leader.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "It'll be more difficult to suppress them now.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...Skullshatterer, things are looking dire.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "But at least... you've come back to us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "I'm so relieved... I'm so, so glad...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Misha should have made it out of here as well.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Now, we can fight without any regrets!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...I will stay here and hold them back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "You should all go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "I'll protect you all...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "What are you talking about, Skullshatterer...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Didn't you promise that'd we go back to Ursus together? We still have to teach them a lesson!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Take care of yourselves. Don't die.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No... Impossible...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Hurry up and move it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Hoshiguma, contact the L.G.D. forces stationed outside immediately!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "We've neutralized most of the traps and ambushes. The enemy leader, W, and the target are still missing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Right now, we're changing the mission objectives!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "All squads, move in and take out Reunion!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Why...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Why is this happening...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
