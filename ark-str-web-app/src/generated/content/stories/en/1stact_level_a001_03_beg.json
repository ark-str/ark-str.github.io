{
  "server": "en",
  "storyId": "1stact_level_a001_03_beg",
  "groupId": "1stact",
  "stageId": "a001_03",
  "title": "An Unexpected Journey",
  "storyCode": "GT-3",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/a001/level_a001_03_beg.txt",
  "sourceHash": "803b1ded5be79baba4fb40684675533b0df6bc5b4ec3364b688f4191fbad274e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Ngh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "You... you took out all my buddies?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "...S-stay away from me! I'm begging you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "I, I'll give you all my coins! My weapons! Anything you want...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Where's the girl?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "What are you talking about...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Don't come any closer...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "You monster—!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Clear \\ Visibility: 14 km\nForest at the foot of Mt. Terrat"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "This rock...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Stay close to me, you two. Watch your step, and stay inside my footprints. Don't go around touching things either.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "I'm afraid this forest is even more dangerous than we suspected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Is something carved on that rock?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "These are marks left behind by bounty hunters. We need to take heed of these, or we may well end up stepping in a trap.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "So, how are we going to avoid the traps?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Just watch me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "An animal trap on a rope... how old-fashioned.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Here's a rolling log trap, hidden by the foliage. Would've tripped it if we rushed forward.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Miss Carol, watch your step.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "text": "Uh, huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "If you take another step in that direction, there's probably a spiked pitfall waiting for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "text": "Oh...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "You sure are the real deal. You're pretty good at this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Of course. After all, I used to...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "It's not realistic to go around all the traps. Looks like we'll have to disarm some of them after all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "The most perilous path for them will soon become the safest path for us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Let's go.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Wait.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Something's not right here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Is it a trap?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "No...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "A symbol drawn with blood...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "'...Monster?'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "What's the meaning of this? In all my years, I've never seen a symbol like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "...Oh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Is this what I think it is...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Monster... Monster!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "D-don't come this way!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "It was you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Skadi, you're Skadi, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...So, the chief of Dewville was with you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Huh? You know Carol...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Hand her over to me. Now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Grani, something's not right about her eyes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "I can't just do that. Let's talk this over peacefully—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "H-huh?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Oww!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "That was just a warning.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "No! Miss Carol, Big Bob...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Wh-why would she attack you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "You know each other right, so why—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "No time to explain! Run for it!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "*gasp* *gasp*... Is she still after us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "text": "G-Grani... I, I can't run for any longer...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "That woman... is she really a monster? She's not even short of breath!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Why must I waste my time on you?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "She's really gonna kill me! Whoa, what is she doing to Miss Carol?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "text": "Her eyes, they're so red... G-Grani!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "No, no, no! This can't be happening!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Stop!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Ambush!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "'Captain'",
      "text": "Now! Fiiire!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Hmm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "'Captain'",
      "text": "That's her right there, the walking Catastrophe! Hurry, shoot her down!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Stop it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "'Captain'",
      "text": "What do you think you're doing, kid?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "I don't know why she's after us, but she's still my coworker!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "'Captain'",
      "text": "G-get out of my way, you rascal—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Hurry up and run!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "—There's an opening to the east! Hurry!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "No way we're letting you escape! Die, monster!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "(Ægirian) Scatter and fall!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
