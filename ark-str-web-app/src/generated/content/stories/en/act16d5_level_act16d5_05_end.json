{
  "server": "en",
  "storyId": "act16d5_level_act16d5_05_end",
  "groupId": "act16d5",
  "stageId": "act16d5_05",
  "title": "Crude Mounts",
  "storyCode": "WR-5",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act16d5/level_act16d5_05_end.txt",
  "sourceHash": "7f537ea0ea48255e59b43400cfe1fe58321f7f42141e741bceb74045eb7cee31",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Stay away! Get back!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "It—it bit off my hand—ha, haha—why can't I feel any pain at all, why—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Eek—stay away!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "Are you okay?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Why did you only just come?! Why did nobody sound the bell?! Where'd the vigilant monk go?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "You know we trusted you, so we did what you said! Why! Why did my husband have to die?! How can you make up for that?! How?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "We'll talk when we're safe.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Waaahhh—mama, mama! Give my mama back!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Whoa, there! Even less close for comfort!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "M-Mister, mama, mama—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Let's ignore this fellow for now! There seems be something disastrous afoot outside! Young lady, hold on tight, we're going to slip out of here!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa—! Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Another one?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "I can't—I can't deal with this!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "Where the hell did they all come from?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "Damnit, there's no way I can hold back this many—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh...?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Though they may figures in a painting, there is no need to slaughter them all... observing such a scene only serves to inspire outbursts of sorrow.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Lava, I am here to watch this place. Thou would best hurry to take others to refuge.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "You...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Worry not for me. I have traveled many times here. I have had all manner of thought on the future, anxieties indeterminate—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "—but for that in front of me, I have never been one moment nor fraction irresolute.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Leave this to me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "Alright. Keep going east. When you're done, find me and we'll converge.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Understood!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "I am here! None shall come forward!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Those who pass this line—shall be cut down.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Waaahhh—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Ow, ow! My dear young lady! Might you be able to stop pulling on my hair!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Mamaaa—mamaaaa—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "These cretins only keep gkh-gkh-gkhing! How can things so bent on chasing you not spit out a human word or two?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "...DON'T... RUN...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Good heavens, I was only joking! You need not! You absolutely need not—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "*whimper* Mister, l—look in front!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Eh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Yaaagh!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "A—Are you that fortune-teller...? Where are the other two heroes?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Behind you, behind you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Why did you bring it over here!? Think of something—think of something!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "What can I possibly think of?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Lead them away from here, away!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "I... I'm...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "*whimper* Waaahhhh, mama, mama—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Oh, just stop crying! Stop! Stop crying, girl!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Agh! Those things are looking at us! Get out of here, get out of—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaaaaaagh!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Huh...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Y-You used your fan?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Hide yourselves further away.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhao? Gkhaa—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "In one move...?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Ao!?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "A-Amazing...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Ow-Owie, it hurts so much, it hurts so much—just what are these things, and how can they look so soft, yet be so hard when striking them?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Oh, stop goggling at me. The proverb puts it well; even a cornered burdenbeast will bite. Here, we'd best just hurry on our way!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhao...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Man alive, Nothing, your kickboxing work's not bad, but you've never done a rescue business like this, eh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Deal with the enemies in front of you without checking movement on your whole perimeter, and sooner or later you'll give yourself grief.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Ah, ahahah... that was quite dangerous just now! My apologies for the grief I gave you, benefactor. Only thanks to you am I safe and sound.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Alright, quick, go and get everyone left into shelter.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Er, what about you, benefactor?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Me? Don't you mind, I walk light as a feather. They won't ever notice me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "(Can the single skill of light-footedness really explain that?!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "And then... how do we cut down these Ink Spirit numbers fast...?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Eyaah! Wh—what's that fire in the garden?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Hoo! This blaze soaring skyward makes quite a spectacle!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Ho? Could it be that the name 'Lava' held this exact meaning?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Lavaaa.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "Confirm the extent of all enemy scatter in the vicinity for me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "This big of an arena?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "I'm worried about the surrounding buildings getting caught up, so I've been sort of keeping my Arts tied down...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "...but there's just too many enemies. If we keep dragging this out, I'm concerned casualties are going to end up tough to estimate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Roger. Special times, special methods, right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "I'll find a high vantage point. You focus on casting.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "I'll help you sort all the ones outside your Arts range. I guarantee I'm not gonna miss a single one.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "Good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "I'll submit the mission report afterwards... after all, it's not just the Infected that Rhodes Island helps.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Infected...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "What's up?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Huh... nothing, actually. By the way, Lava.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "You seen Mr. Umbrella-Boiler anywhere?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
