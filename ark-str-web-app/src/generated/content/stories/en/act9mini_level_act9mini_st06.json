{
  "server": "en",
  "storyId": "act9mini_level_act9mini_st06",
  "groupId": "act9mini",
  "stageId": null,
  "title": "Somebody",
  "storyCode": "",
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act9mini/level_act9mini_st06.txt",
  "sourceHash": "90050a08fc7cfe45d0cf2bfeb2da835171abccd1ef177da6742b17fb459a6129",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔1.5-4"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Mr. Malkiewicz!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Over here. Please, this way, Mr. Malkiewicz!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Oh, so this is the right place.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Sorry. I'm not too familiar with the roads here, so it took me a while. Sorry to keep you waiting.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "And thank you for agreeing to come pick me up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "No need to thank me. It's the least I could do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Please, this way. The venue is in the district across the way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "R-Right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Excuse me, but...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Yes?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "No, never mind. It's nothing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Today's forum takes place right before the Major's main events... doesn't it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Yes, that's right. The General Chamber of Commerce organized this meeting, and while it is a forum, the format is somewhat relaxed. All spokespersons and corporate representatives will be in attendance.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Hm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Just show the invitation letter and you'll be let in.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Of course. Of course... I have it right here...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Um, excuse me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Y-Yes... I'm here. Yes, please, go ahead!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Pardon me for asking, but do you need any assistance?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Uhh... Excuse me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Frightfully sorry. I noticed you've been adjusting your coat...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "If you've run into any trouble, if there is anything I can assist you with at all, please don't hesitate to tell me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Oh, no... My coat is fine. I mean, no, it's not a huge deal. It's just...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's just... I'm not used to it yet... Sorry, this is a personal problem. Please don't worry about it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Is that so...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "You seem a little nervous?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Yes, just a little. Sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's my first time at one of these forums. I'm afraid I'm... still not quite used to this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "You needn't be so nervous, Spokesman Malkiewicz.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "This forum is a meeting organized by the General Chamber of Commerce. The spokespersons who represent the Chamber are the most esteemed attendees...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Please, try to calm down.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "But... I'm no big shot... certainly not esteemed. I... It was just a coincidence...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Something's gone wrong somewhere. I shouldn't be here...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "You are too humble, sir...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Sorry, I have a phone call.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Please, go ahead.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Hello? This is Malkiewicz... Please go ahead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Y-Yes, not a problem...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It fits very well. I don't need anything more. Thank you very much.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Oh, no, I should be thanking you. For sending someone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "N-No, not at all! He's very kind, and he didn't offend me in any way whatsoever. It only took us so long because I was slow to get ready. Please, don't make things hard for him...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's a joke...? Y-Yes... Of course...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Yes, I will be there shortly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Okay, see you later...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Sorry to keep you waiting.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Not at all, sir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "About what we just discussed—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "—Agghh!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Please watch your step, Mr. Malkiewicz!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "We'll head upstairs via Corridor 4. Please follow me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Uh, y-yes. Sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "The venue is right ahead. Please make your way there and show the attendant at the door your invitation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Yes, yes... thanks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "In that case, please excuse—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "W-Wait!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Go ahead, Mr. Malkiewicz.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Actually... I was going to say... I'm not one of those people you'd call esteemed...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "So you really needn't talk to me like this. What I'm trying to say is... just call me Malkiewicz.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I'm afraid that... wouldn't be appropriate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "You are the spokesman for the General Chamber of Commerce. As a staff member of the Chamber, I admire your work, and you have my utmost respect...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "If that's it, I really don't deserve your admiration.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I haven't done anything of importance. Perhaps everyone will realize I'm not cut out for this job after this meeting today.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "And if I got a phone call right now, telling me I'm fired right this minute, I wouldn't be surprised at all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "You're overthinking it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "The General Chamber of Commerce must have appointed you spokesman after due consideration... Your abilities were recognized.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "My... what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Deep Male Voice",
      "text": "I dialed the spokesman's number, and you answered.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Deep Male Voice",
      "text": "Therefore, you are the spokesman.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I... I don't quite think so.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "If I have to give a reason, all I can say is... perhaps it's just something Mr. Czarny came up with on a whim...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "And I was only picked because I happened to be there...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I am sorry, but I beg your pardon?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "No, it's nothing... Don't worry about it...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Actually...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Yes?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I... I've met you before, Mr. Malkiewicz. I was fortunate enough to work on a project with you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Oh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "It's only natural that you don't remember. It happened a long time ago, after all, and it was only a brief collaboration.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Gerald, the team leader...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "You remember my name? I'm honored.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I knew you right away, actually... but, like you said, it was a long time ago. I wasn't sure if it was something I should bring up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "If I remember correctly, we were reaching out to newcomers for the knightclubs... and we were assigned to the same list of names.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Yes, that's correct.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Do you remember the knights we were assigned to contact?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I... I'm sorry, but I don't remember.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It was a few infected knights...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Right, right. Yes, the Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Please... don't call them that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "They were just knights, unfortunate enough to get infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Yes... Truly unfortunate...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "However, they were fortunate enough to have met you. Thanks to you, they were able to join a proper knightclub. I am sure that was more than those Infected... I mean, the knights could ask for.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "About that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I think you might be mistaken. We didn't actually finish that job.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "What...? Hold on, if I recall correctly...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Was it... the time we tried to recruit the Flametail Knight, the Fartooth Knight, those ones?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Do you remember now? That's right. They had just won a few matches... You reminded them to review the contract the knightclub provided them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "The knights were still young. We couldn't bring ourselves to lie to them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "It's true that the knightclub's terms for the infected knights weren't very reasonable. I mean, they may seem fair at first glance.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "However, we normally wouldn't go into the fine print for the infected knights.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Right... normally, we wouldn't have done that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Though this did have to do with the knights' future...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "No one can predict the future.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Just like... Just like you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "If I hadn't taken a look at your file beforehand, I wouldn't have recognized you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I looked in the mirror before I left home this morning. If the person in the mirror hadn't waved with me, I would not have recognized myself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "...In any case. Thank you for remembering who I am.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "This is embarrassing to say, but I'm actually still wondering if this is all a dream.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's just too surreal...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "If this were a dream, I imagine it must be a pleasant dream.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Y-You think so?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Is it not?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Well... I don't think it's necessarily one...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "To tell the truth, I think I might feel more terrified than anything else.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Terrified?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "What are you terrified of?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Many, many things. I hardly get any sleep, and regardless of whether all this is real or fake, nothing good will come of it... The only difference it makes is that things are bad in entirely different ways.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "The way you think is... peculiar.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "R-Really...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Yes. After all, you are experiencing quite the rags to riches story.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "From a lowly office worker, you rose to the top and joined the big leagues... I think most of us have dreamt of something similar.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's something that everyone has fantasized... Indeed...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "What's so bad about it? It's not often that dreams actually come true.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Luck was on your side, Mr. Malkiewicz.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "But I didn't really... I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Do you really understand? There are many who envy you for what you have gone through.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "To tell the truth—At the very least, I envy you very much.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Maybe... this is why...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I beg your pardon?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Uhh, I mean, perhaps this is what's most terrifying.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's all going too well, too natural, and it's all too structured... It all happened way too quickly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Just two days ago, I was worried I couldn't pay rent for the month. I wasn't able to convince Maria Nearl to join our knightclub, and I was most likely going to get a pay cut.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "That was when I ran into Mr. Czarny... He was very busy during the Major's preliminaries, and I helped run some errands.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "And then...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "And then I took a phone call.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "A phone call?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "A phone call.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bold Female Voice",
      "text": "From now on, you no longer belong to the Słoma Food Company, nor the Mieszko Group——Please keep in mind at all times that you are representing the General Chamber of Commerce.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Wait...! I don't want to be...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bold Female Voice",
      "text": "You have no right to ask questions.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "I-I don't think...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "No, I... I understand...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bold Female Voice",
      "text": "Very good. I wish you the best of luck.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "There was no way I could possibly understand...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Even though, from head to heels, this getup is specially tailored to make me a big deal, that doesn't mean I've really become one...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Actually, I don't think this outfit suits me at all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Nonsense... It looks great on you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "This may come off as rude... but I ask you to forgive me in light of us having worked together in the past.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "What is it? Please...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "A bit of advice, Mr. Malkiewicz.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "As someone whom fortune has smiled upon, you should try to refrain from sharing your feelings to those who, like me, are less fortunate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I really wish to empathize with the way you feel, but alas...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I can't.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "There are many who wish to be in your position, myself included, but we aren't so fortunate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Do you understand?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I do... but still...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Perhaps you do have your worries. You feel fear, anxiety, and hesitation... but no matter what you are feeling...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "You are well groomed and dressed to kill, you have the invitation in your hand, and you are walking inside this building as the spokesman for the General Chamber of Commerce.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "Regardless of what you think yourself, in the eyes of everyone else, you are very much a big deal.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "The venue is straight ahead, Mr. Malkiewicz. Please excuse me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Wait...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Staff Worker",
      "text": "I wish you a pleasant day.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "I heard you were once an entrepreneur, Mr. Malkiewicz?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Y-Yes... I founded a company with a friend before. A very small one...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "It must have been a success?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "No, not at all. You flatter me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "You're too humble! If we ever get the chance, please do share with us your stories of entrepreneurship.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Your thoughts on the treatment of the independent knights was thought-provoking too...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Thank you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Right, would you like a drink? Let me get you—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "W-Watch out!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "M-My apologies... I am deeply sorry, Mr. Malkiewicz!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "No, it's okay. No big deal. Please don't mind it at all...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "My god, your clothes—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Clothes...? Uhh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Oh, the wine...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "I-I'm terribly sorry!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "I-I'll fetch you some towels right away!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "No, no. It's okay. I'm fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Uh, thanks...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Please wait a moment. Don't move. I'll wipe it clean—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Please, you don't have to...! I-I can do it myself!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Please take your coat off. I'm afraid it will be difficult to get the stain out. I will arrange for someone to get it dry cleaned.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Take my coat off...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Oh... and if you are not satisfied with that, I can pay you for the coat...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Mr. Malkiewicz? Are you alright, Mr. Malkiewicz?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "N-No, thank you... It's okay. This is good enough. Please don't pay me anything!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Huh? But...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's no problem. I mean it... Thank you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "This will do... I'm sorry, I was in a bit of a daze...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "It happens. I understand. You don't seem very well, though. Perhaps you are a little exhausted?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Were you thinking about work just now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Uh... I suppose so...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I was just thinking about some advice I got from a friend.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "I guess he was right. It turns out my own thoughts don't matter, a lot of the time...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corporate Employee",
      "text": "Uh, what do you mean...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "Don't worry about it, please. I'm talking to myself, that's all.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It's just... even if I don't think I'm a big deal...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Malkiewicz",
      "text": "It looks like... I'm stuck wearing these suits for a while.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
