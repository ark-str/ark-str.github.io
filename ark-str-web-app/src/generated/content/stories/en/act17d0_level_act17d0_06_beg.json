{
  "server": "en",
  "storyId": "act17d0_level_act17d0_06_beg",
  "groupId": "act17d0",
  "stageId": "act17d0_06",
  "title": "Battle of the Lord's Manor",
  "storyCode": "OD-6",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act17d0/level_act17d0_06_beg.txt",
  "sourceHash": "aa5541217238de3c9f5179f37517185436b5a510747c1b305dbc4f7250741f7f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "How long has it been, dear sister?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Six months? A year? Longer?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Drudge, you attacked the Lord's men and stormed his manor. This is treason!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Treason? Hah. Heh heh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "You have to know, Picale.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "If it weren't for that rotting old man's obsession with protecting his infected... oh, distressed assets.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "This wouldn't even be your place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Relax, girl.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Check out these toys from an enthusiastic Columbian donor.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "The TSW-2 Ultrasonic Impact Unit, a product of advanced technology. It's experimental, never used in the field before. The only downside is the size.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "It was real tough to hide in town. Took a while.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Took me a while to get you out of the mansion too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "So tell me, my dearest little sister, what good are your sick moves now? What good is that iron will of yours?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "And check out my friends here. Sarkaz friends.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "They're not your run-of-the-mill braindead devils. They're from Columbia too. They get the job done.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "You know what that means?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "It means they're here for progress. Progress you and the old man could never understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Get your margins high enough and money's more powerful than you can possibly imagine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Whatever happened to the old man's worthless logic?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Boss, we found this in a big house.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Give it to me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Oh, an appointment letter from the Lord Ameer of Bayalir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Fine grain papyrus, embossed signature, blocky Bayalir writing, and this black seal.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Hmph.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Where's the old man?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "He wasn't there. We searched every room and found plenty of townsfolk, but not the old man you're talking about.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Father is dead. I am the Lord of Long Spring now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "You have disobeyed your Lord, and in so doing disobeyed the Lord Ameer, and for that your punishment is death!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "That's the plan you and the old man came up with?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Hahaha...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Hahahahaha...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Grrgh!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "This is getting stupid. You really think you can use the Lord Ameer to outmaneuver me? Don't make me laugh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "You're gonna execute me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "The old man's proud Reproba guards are lying headless in an alley somewhere right now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Those tough guards are gone now, and who's left to stop me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "You're a psychotic piece of shit! You grew up with them! They treated you like their own son! I didn't think you were this far gone...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "They shouldn't have gotten in my way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "And neither should you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "We're blood, so let me make it a little clearer for you, sis. I wanna be sure you understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Yes, you're a Lord of Sargon now. Sure.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "But me? I'm a bum, abandoned by my family.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "And in a few years, when you meet an unfortunate end, I'll go to the Court of Bayalir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "With my pedigree, plus the resources and wealth to prove my loyalty to the Lord Ameer, do you think he might just hand Long Spring back to me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "No!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Why don't I give you another scenario: let's say you die in battle just a short while after taking charge.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Then I hand your corpse over to the Lord Ameer, and get to join the Zhayedan, would that work out better for me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Drudge, you're a disgusting, horrific, disaster of a person!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "You're getting excited, sis.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "All that's just hypothetical. It's not real. We're having a brother-sister talk here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Because I know a much better place for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "See these things with the rocks on them?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "If you're so eager to protect the Infected, why not join 'em?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Drudge!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Once you die from it, I'll find a nice cave to bury you in.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Then you and the old man can watch me dig out the Originium buried under the mines and turn Long Spring into the mineral heart of Bayalir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "So, what do you think?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "...You sold out your family, and sold out our land! I curse you, Drudge. May you die a horrible death!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Whatever makes you happy, sis. Curse away. Use that voice while you've still got it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "I guess we're done here.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) You, come here.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Columbian) What is it, Boss?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) Bring the Infected to the egghead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Columbian) Right. I'm on it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Columbian) What about this kid? Looks like he's on his way out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) Bring him, dead or alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) As for my sister...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) Turn her Infected. You Sarkaz must know how to do it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Columbian) Roger.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Columbian) But that isn't in our contract. There'll be an extra fee.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) Save it. You know there'll be plenty of money to go around once our work here is done and the mine is up and running.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "What a nice brother you have there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "(Closes eyes)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Raises weapon)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Erm...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "We're under attack! Get a shield up, protect the boss!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Wha?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "What's happening?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Boss, we've got company!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "I thought you took care of all the guardsmen!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "I saw! I saw! It's...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Aagh!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Caster, get the monsters moving!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary Caster",
      "text": "Wait... I see... It's...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Hurry!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Ahhhh! My shoulder! My shoulder!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Don't panic! Where's the enemy?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "I... I don't see them!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Fall back. They've got crossbows. Get to cover!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Cover Drudge! We can't let anything happen to him!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "I saw! It's a Feline!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Look out! Retreat! Retreat!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "You... You're with Rhodes Island...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Can you move, Reproba?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Thanks...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Originiutant",
      "text": "Gaa...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary Caster",
      "text": "Okay, it's working.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary Caster",
      "text": "This isn't over yet. Hahaha.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Hmph, the old man's toys can only be useful at a time like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "You, take the monsters and finish them off.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Roger.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "There's too many. I can't guarantee your safe escape.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "This will do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Where are my weapons?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "What for?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "It's my fault Drudge turned out like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "I can't face my late father...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "But I will carve out that traitor's heart and bury it in Long Spring if it's the last thing I do!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Don't be hasty, there's too many of them. Getting yourself killed won't help the town survive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "I've sent out the signal. They should be here in a minute.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Boss! Those mercenaries and Rhodes Island are assaulting us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "What are you afraid of? With this mansion tough as iron, I don't believe those mercenaries can cause us any harm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Tell those casters to finish that Feline with monsters. Others go defend the entrance.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Roger.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Report?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "They have formed a defensive line with the courtyard walls. I suppose there are snipers and hulky mercenaries hiding behind.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "The same way as usual?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "A wall like this doesn't even bother me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Let's show them who's the real boss here.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Now that's a big hole in the wall. I didn't expect a technology like this.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Cover fire! Breaching!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Roger!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Stop them. Now!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Out of my way!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Not over yet!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Bastards! Where the hell are the snipers?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Snipers? There's no more snipers I'm afraid.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Where did you...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Ugh...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "We've breached the out wall. Nicely done, old man.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Don't let your guard down. There's still many of them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Wait... what's that thing they just pushed out?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "That's...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Get down!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "*cough*... Bless my ears...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Are you okay?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Yeah, I'm fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "What about the others?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "All fine. but now I feel everywhere hurts...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "What is this weapon?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "How come they even have stuff like this?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "An experimental weapon of Volvort Kochinski... How unexpected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Now we're in trouble.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "It's about to fire again. Find cover!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "If it hits you, you'll be doomed for sure.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Boss! They've breached the out wall!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Don't you see they are being suppressed? What are you worried about?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Take care of my sister and that Feline first. Then we'll deal with the rest.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "I'm having the edge. Now it's just a matter of killing a few more.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Five! These are your monsters, huh? Drudge! Get out and face me!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Six! C'mon, You ugly and filthy monsters! I'm gonna smash you all into shreds!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Calm down, Lady Picale. Save your strength.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "There's... too many of them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "No... *cough*... *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Lady Picale... Miss Schwarz...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Doctor!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "You... *cough* *cough*... have to get out of here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Come, monster...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "What are you doing?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(It hurts... so bad.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Where am I...? Did I pass out?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(What is this...?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "...You sold out your family, and sold out our land! I curse you, Drudge. May you die a horrible death!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Lady Picale! She's on the ground?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(What happened?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Oof... ouch...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(That's... blood?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Oh...)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Ow... so cold.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) Bring the Infected to the egghead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Columbian) Right. I'm on it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "(Columbian) What about this kid? Looks like he's on his way out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) Bring him, dead or alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) As for my sister...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "(Columbian) Turn her Infected. You Sarkaz must know how to do it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(He... What is he doing to the Infected?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(I can't stand up...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Who is that...?)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(It's Miss Schwarz...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Alone...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(I have to help her...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(Hah... It all comes down to this, in the end.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "You... run...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "What are you doing?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Leave me alone! Get out of here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Is that a refined Originium Ingot?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Why do you...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "I haven't used... Arts... in so long.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(There's so much I still want to do.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(I don't want to die yet...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "(A doctor should be saving lives. I have to... save...)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary Caster",
      "text": "My eyes! My eyes! Ahhhh!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Get up! Hold the line!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "*cough* *cough*... *cough*.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "What happened... what was that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "The Originiutants! They're out of control!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "How?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Where's the Ultrasonic Emitter?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "The little twerp fried it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "We've completely lost control! What do we do?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Gaaaagh!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "The Feline's back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "text": "Get a shield up, protect the boss!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Drudge!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Your life is forfeit!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "Again with the nagging!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "I want their heads on a platter now!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Drudge",
      "text": "What is it this time?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Target located. At my position.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "We're getting them out of there. Open fire!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
