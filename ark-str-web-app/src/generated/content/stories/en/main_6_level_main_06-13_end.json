{
  "server": "en",
  "storyId": "main_6_level_main_06-13_end",
  "groupId": "main_6",
  "stageId": "main_06-13",
  "title": "Nostalgia",
  "storyCode": "6-15",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_06-13_end.txt",
  "sourceHash": "d09d85d91ae6693d0a18ea31730981e564378a9c9ee0ce77dfe2c2b4d5a5f908",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Blaze. I need you to lead the team to seize the advantage.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "(You want to organize a raid?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(I'm very worried about our current situation.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Both we and the Yetis have used our respective skills to locate the Doctor and FrostNova. Thanks to your Arts, they are now safe.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(And... The two are very close. If you can save one, you can save the other.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(There are two things we can't be sure of right now.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(First, who will reach them first...?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "(Second, FrostNova's attitude.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Exactly.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(If we get the initiative, we'll have to subdue FrostNova immediately. But we also have to trade her for Yeti Squad's cooperation.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(That way, we avoid fighting, and also deepen the opportunity for communication.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(But if they get there first...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Um, Amiya, the heartbeat detector found something. We have a position, but we don't know the depth...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Right!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Hey... Wait!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Where's the fire? Aww.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "As soon as the Doctor comes up, she gets all panicky and forgets herself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "I'm not sure if this is a bug in Amiya or a feature...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "You know, the stuff she just said, that's not like her at all. She came up with it too fast.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "At least she didn't come around to a sneak attack. This one's on us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Not quite. If we ambushed them, the Yetis would just fight to the death.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "I'm here to rescue you all, not cause more casualties. She didn't give up on her winning outcome.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...I guess I should apologize. It's the mercenary in me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "You didn't do it, did you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Keeping a level head after her victories and keeping to her tactical goals are what makes me trust Amiya as field commander.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "I'm gonna go check on the Yetis.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Huh?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "This structure... It's so complicated. It makes my head hurt.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "Describe it to me and I'll draw it up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Huh? I didn't even finish my eighth grade textbook in middle school. Give me a break.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "What did you do instead of class again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "I went to train.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Why not let Nesti try? He's got some Arts, doesn't he?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "He's all about reciting poetry and writing essays. That's not your structural probing business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "Well, why not try to express it through numbers?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Good idea. I'm okay at math. Let's try it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "Does it feel hot to you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "No. I'm wearing this thick heavy thing and even so I still feel Sister's Originium freezing my skin off...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Oh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Hi, Rhodes Island cat.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Sorry, but when I sweat, the air around me heats up, and then I just keep sweating.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Thanks to you guys, I'm feeling a lot cooler than usual.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "Are you nervous?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "A little. I never thought I'd be working with the enemy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "For now, at least, we aren't enemies. After digging out our Sister, we'll do what she says. But we'll cross that bridge when we come to it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "...You guys really aren't anything like the other Reunion folks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "You think the rest of Reunion is all the same? Are you and the bunny the same?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Hey, yeah. Good point. We've got all kinds on our side.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "Everyone's got all kinds.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "At least you're willing to listen to us. The Ursus soldiers all just shoot us on sight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "The arrows start flying and they don't stop until one side is dead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Good thing we're a pharmaceutical company and not a bunch of Ursus soldiers.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Do pharmaceutical companies all have equipment like yours?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "The world is a dangerous place and we have to protect ourselves, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "It would be nice if you spent your time farming instead of battling.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "If you can grow a harvest of red wheat, you'll feed half a town's starving Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "If they weren't starving, they wouldn't have gone into that little town. Then they wouldn't have been shot.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "If only.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "Enough of that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "He's pretty sentimental. You know, I think all Ursus are pretty sentimental.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member C",
      "text": "No slacking off!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Oops, sorry. Time to get back to work.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "No big deal. Go back to your work.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "But that thing you're carrying, it's got a powerful smell.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "Oh? This...? I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member C",
      "text": "What's she talking about?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Nothing. Don't worry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Hey, a mite peckish.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member C",
      "text": "Oh...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "What are you looking at me for?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "15:22 P.M.\nRuins of Chernobog 'District 14'\nSector Surface\n3 hours into the excavation operation"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Amiya, stop!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Your fingers are bleeding! Stop digging with your hands!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "But... I can feel something down there... Right down here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I can't feel it if I'm using a tool... I have to use my fingers to pick up on that tiny whisper of a feeling...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Amiya!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's close!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "(Meteorite...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "(But...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "(Leave her be.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "If we let them get there first...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "It's okay, you can do it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member D",
      "text": "Use Arts! I- I can't. I really can't!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "We can do this even without our Sister, right? Hurry up and make the temperatures nice and different. The bigger the difference, the better!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member D",
      "text": "I'll try... But don't blame me if it doesn't work!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member B",
      "text": "Who else can we blame besides you...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member C",
      "text": "Don't tease him. He has to concentrate.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Here! Right here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...A wall? Did I get it wrong?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Just smash it! Break through...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "But if it collapses, I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I... got it wrong.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti #1",
      "text": "It's open!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Blaze! Meteorite!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "On it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Get ready.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You win.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Said I won't lose.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You didn't give me a winning choice.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Yeti #1",
          "text": "Sister!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti #1",
          "text": ".....This one......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti #1",
          "text": "This is the one they call the Doctor.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "So am I being shot or hanged?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......!",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Hi.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "The leader of Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "That's me. You can call me Amiya.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "(Her rings... are turning red?)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "......!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "(Aren't you going to stop her?)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "(Why would I stop our only chance at winning?)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "Blaze!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "I respect Amiya's decision.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya, no.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Nesti, is Rhodes Island not fighting you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nesti",
          "text": "They're not.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Then here on this battlefield, we are not enemies.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "FrostNova...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "There is no reason to fight if we are not enemies.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Go back, Doctor, to your people.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti #1",
          "text": "...Our Sister is so magnanimous.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member B",
          "text": "Like she needs your approval.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Quiet down.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Little rabbit.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Uh, my name is Amiya...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "You're going to Lungmen too, aren't you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...That's right.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Then we will be enemies before long, little rabbit. Just, not yet.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "FrostNova, you and your team aren't as destructive as the other Reunion units.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Don't blame my people. You don't know what they've been through.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But you don't want them to go on like this!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...Oh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "It seems you can read my mind?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I can't. But I do sense your unease and your consternation.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "All of this will be swept away after the fall of Lungmen.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Rhodes Island, we can honestly understand you and your squad.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "You may think I'm wrong, and that we don't understand you at all...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But FrostNova, ma'am, I know exactly what you've been through.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......Childish.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "FrostNova, those clothes aren't yours, are they?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "They're not. This was once the cloak of the 'Patriot.' I wove it into a coat.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......Oh......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "How can you tell?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Never mind...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Everyone has some things they can't say, I suppose.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "FrostNova, Rhodes Island does not seek out conflict. We want to avoid unnecessary bloodshed.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "And which bloodshed was necessary?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "At the very least, we don't want to fight your squad!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "They are all good, decent people. We absolutely cannot hurt them, or let them hurt innocent people!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...Then you must pray we do not meet again.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "FrostNova!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I think I don't much want to hurt you either. But if I have to, I will kill you all.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You can come to Rhodes Island. We don't have to fight.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Then you can try to beat me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Defeat me in battle, and I will consider it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "But of course, once we meet on the battlefield, we are enemies. And as enemies, we will fight to the death.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Oh yes. This one, for the fox.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "...What?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "A special remedy for frostbite. One-of-a-kind recipe. It relieves the burning and pain.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I've studied these things for a long time. And you fought very well back there.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Warriors willing to sacrifice themselves are the strongest, in my eyes.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "Thank you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "FrostNova...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Hey, wait. I have something to say too.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Yeti #1!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti #1",
          "text": "Oh... huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "What's happening?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Let's get a drink next time! Your vodka smells great!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti #1",
          "text": "Don't say that out loud!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Hm.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Haha...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Goodbye, Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I hope we never meet again.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Lungmen Substructure"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Here you are, after all.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Hello, FrostNova.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Hello, Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
