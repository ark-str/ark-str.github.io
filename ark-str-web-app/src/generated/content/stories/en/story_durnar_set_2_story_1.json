{
  "server": "en",
  "storyId": "story_durnar_set_2_story_1",
  "groupId": "story_durnar_set_2",
  "stageId": null,
  "title": "A Glass with Old Stories",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_durnar_2_1.txt",
  "sourceHash": "fd1647522eb3406c12d50739169b573abbf33f42d25b29c92d7c762e1f970c83",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "Late night\nRhodes Island Landship, 'Just One More Pint' Bar"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Dario...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Yes, ma'am?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Can I drink yet...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Today, I—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Yes, yes. You've told me plenty of times.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "You had to teach some kids who weren't listening, and you fought the reserve operators in a drill to test both their limits and yours, which led you and the other instructors into a heated, 'friendly' conversation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Would you like me to repeat your ramblings?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "No...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Very well, then.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I just want some booze!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Ten more minutes, ma'am. We serve alcohol after 9. Those are the rules.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Following all those rules will kill you one day!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Following rules is what gives our lives order.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "If you are not happy with that, I am sure you know with whom you can file a complaint.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "We are just staff members here, and we must follow the rules she made.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Grr...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Gimme an apple juice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Coming right up.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hmph...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I worked my butt off the whole day, and I can't even get a sip of booze...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "If I were—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "If you were younger, you would've flipped the table and put your electric blade to his throat.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hank?! What are you doing here?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "I've been here the whole time, Instructor Makayla.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Don't use my real name here. I'm Dur-nar.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Instructor Dur-nar.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Drop the 'Instructor.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "That's a no-go, Instructor.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Ma'am, your drink.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Thanks...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "*Sigh*, everyone's so stubborn, you're all a bunch of burdenbeasts...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Thank you for the compliment, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Thank you for the compliment, ma'am.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "That wasn't a...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Whatever...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Would you like something to drink, sir?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Ice water, please.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Coming right up.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hah... How come I've trained up a man like this...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Takes a gulp of apple juice)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Go on, Hank... What are you up to now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "I'm usually out in the field as a liaison between Blacksteel and Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Our partners at Blacksteel are here for a meeting, and I'm their bodyguard. I'll be taking them back once they're done.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Sounds like something you'd do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Did anyone get hurt on your way here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "We had some injuries, but nothing too serious.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "It's all thanks to your teaching, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "The stuff I taught you back then is way outdated by now. Keep using those tricks, and not even the Originium armor they're testing in the military can save you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "They've already deployed that armor to a few teams.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Not the original either, mass produced ones, usually to elite soldiers like you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well, count me out. I can't wear that stuff.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "You can. Even Big Mark wears it fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Finishes the apple juice)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Phew.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well, you haven't changed one bit. Just a few sentences and you drive the conversation into a dead end.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Sorry, Instructor.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Here's your ice water.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Thanks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Speaking of Big Mark, where is he?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "The guy wrote in for me, and got everyone to sign off on the paperwork to let me work here, but he's too busy to come see me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Big Mark isn't a Rhodes Island employee. He's a project testing manager at Volvort Kochinski. He's a busy man, so it's only natural he hasn't had the time to leave Columbia and come visit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Volvort Kochinski? Why did he send me to Rhodes Island, then?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "I'm not too sure myself. You should probably ask him.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "He's the one you were the most proud of. I'm sure he'll be glad to tell you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Now don't be like that. I'm proud of all of you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "All of you, Hank.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "All of you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Ma'am, it's time. May I get you something?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hm? Booze time?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Yes, ma'am. It's 9 o'clock.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hell yeah. Give me a 'Raging Sands.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "And give this guy a 'Liberi Tears.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Instructor, I—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Say no more. I get it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Coming right up.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Instructor...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Come, tell me, how did you survive?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "If my memory serves, my objections didn't change anything, right...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "The field commander sent us to the front lines. He treated us like cannon fodder.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Thankfully, his men didn't think that way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "They saw us as a kind of symbol. They saw in us you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "It was like as long as we were there, Sergeant Major Makayla Springthunder was there fighting the battle with them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I was just a sergeant. Where'd they get the major part...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "*Sigh*... And then?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "We finished our original objectives with the help of the surrounding units, and after getting some rest, they sent us a new mission.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "To seize the enemy's HQ.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "The enemy forces weren't in any shape to mount much resistance, so we split into two teams as soon as we reached their HQ.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "One team stayed outside, to mop up any remaining hostiles and provide support. The other went inside.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "We never thought the enemy would blow up their HQ to take everyone with them. The guys who went inside didn't make it out alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "This apparently drove a wedge between the top brass after the war was over, and while they were busy fighting each other, we were reassigned from the front.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "And a couple months after that, our team was discharged.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Just like you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Yeah, I know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "All of us blamed ourselves. We were lost.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "We used to think that, as Columbian citizens, it was our duty to answer the president's call to join the military, to protect our homeland, to defend our borders and beliefs. That's what we were meant to do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "But actually, all we did in the service was put up with a bunch of arrogant officers.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yelling at our teammates didn't do anything, and taking our anger out on you wasn't going to get us anywhere, but that one month, aside from our training and work, we were stuck in that cycle of negative emotion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "After we were discharged, most of us went back to Columbia. It was only once I adjusted back to civilian life that those negative emotions started to fade away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "I don't know much about strategy, but if it wasn't for you, that war would not have ended so quickly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "That victory was Columbia's, but if it wasn't for your decisive assault putting pressure on the commanders, the tug-of-war that came afterwards would've been far worse, and more men would've died on the field.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "How come you're so good at comforting people, but you're terrible at making conversation, Hank?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Please stop making fun of me, Instructor...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Oh, don't mind me too much. It's just something I said off the top of my head.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Right, weren't you going to take over the family business and rake in the dough? What happened to that? Why are you here at Rhodes Island, serving as an operator?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Report, Instructor—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "No reporting. Just tell me like normal...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "I talked to my sister about it, and we decided that it was the best to have her take over the family business while I would be her second-in-command.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I thought you said you didn't get along with your sister... or at least that's what I think you told me before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "But after I was discharged, I put some thought into it. Then, for the first time, I had a good discussion with her.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "She's been smart ever since we were kids. She majored in business too. We figured she would be the better choice to expand the family business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "And when my father finally decides to retire and hand the business down to her, I'll leave Rhodes Island and go back home to help out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Right now... I guess I'm here to earn some experience.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "I wanted to expand my horizons through the lens of Rhodes Island and also make some connections, both inside and outside Columbia.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "This is very important to my life in the future.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Mm-hmm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I've been wondering, but what does your family do again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "We're in asset management.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Not sure what that is.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "My family manages the Maylander Child Rights Protection Foundation's wealth.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Maylander... Child Rights Protection Foundation?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "It's an NGO working to improve life for Columbian children.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "So a charity?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "If it's at all possible, I would like you to—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well, it really sounds like you were born for this kind of business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Be sure to really throw yourself into that work.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Don't make a fool of yourself. Got it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Right, good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "As long as you're living well, I'm happy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Gives me something to boast about to my coworkers, haha.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Ma'am, sir, your drinks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "(Lights up Dur-nar's drink with Originium Arts)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Enjoy.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Finally.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Downs the whole thing in one shot)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Phew—Hot hot hot!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Ah, that's the stuff.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "You're basically spitting fire, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Easy peasy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "You drink yours too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Instructor, you know I—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Drink it, Private Hank.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "That's an order.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes, Instructor!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "(Downs the beverage in one go)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Huff—Phew...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "How is it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "It's not that spicy, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well, of course.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "That's just white grape juice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "White grape juice?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well, I can tell you don't go to bars often.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "'Liberi Tears' is bartender lingo. It means a glass of white grape juice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "You think I forgot how allergic to alcohol you were?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Instructor...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "You know how exhausting it was to carry you from the base to the army hospital that night? I'd rather not try that again.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Dario!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Something else for you, ma'am?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "An 'Iceflame.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "You, Hank? Another glass of Tears?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Sure.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Just a moment.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "What's up?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Where did you go after that court-martial?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well... I'd rather keep it to myself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "I would like to know, please.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "And I'm sure the others would like to know as well.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "(Takes out a voice recorder)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Uhh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hold on, easy. Why the recorder?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "'We' would like to know, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Oh, you prick. So this is why you came all the way here, why you're drinking with me?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "This is what all seventeen of us want to know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "And I'm the only one who works at Rhodes Island, so it falls on me to do this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "And you couldn't have found somewhere more private...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "It's easier to get you to talk in this environment.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "If we talked somewhere else, like the training grounds, you would definitely slip away with some work excuse.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "And I certainly wouldn't have been able to stop you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well, you did your homework...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "All thanks to you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "F-Fine, I'll go into it a little bit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "And I'll say this first: I don't remember everything. If I don't have an answer, pushing it isn't going to help.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Thanks, Instructor.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Here are your drinks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Enjoy.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Just in time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Let's talk and drink.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Takes a sip of the 'Iceflame')",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hah—That time—I think I went home right after they threw me out of the army.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I drowned my sorrows at the bars back home, day in and day out, then I'd go outside to make trouble.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "My family was understanding, at least. Pampered me all the time. They helped me keep from ending up a total failure.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "After that, my sister pulled some strings, and I got a job working riot police at the local department.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "What? These days, lots of little sisters outdo their big sisters, you know?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "She's much more mature than me. She always took care of everything back home when we were kids, too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "It's like I should've been the little sister instead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Takes a sip of the 'Iceflame')",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "It's a peaceful little town, so there wasn't much for me to do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "After that, the city government decided to reorganize the police force and cut down on the riot police, so I got canned.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I guess they figured they could spend the money elsewhere, with how peaceful the place was.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "So I became a shut-in again and mooched off my parents. I felt bad about it, so I took some of the money I saved up and moved to a nearby nomadic city to look for work.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I looked around for a few weeks, and a company wanted me to help manage their security detail. I signed up without thinking too much about it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "It wasn't until after I started that I found out their so-called security detail was just a few random bums they picked off the street to guard the place. They didn't have any training, and no equipment either.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I wanted to do something about it, but whenever I asked for a budget, the higher-ups would start making up excuses and told me not to worry about it if I knew what's good for me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Now what's that about?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Seriously, bunch of douchebags!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Takes a gulp of the 'Iceflame')",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I had nothing to say to those stupid suits and their fancy business, those jackwads!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Well, it so happens that there was a convoy heading out to resupply pioneers hiring bodyguards.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "So I took a few of the kids who were willing to come with me and joined them as mercenaries.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Is that why when we first contacted your parents—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "You see, out in the frontier, it's not all that uncommon for a letter to take a whole month to not even get delivered.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Have you been out there?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "No.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "You should see it for yourself, if you ever find the time.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I never thought I'd get to see places like that in Columbia.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "The food was terrible, and so was everything we had to use, but everyone held out hope for a good life.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "But then? Bandits, wild beasts, Catastrophes, you name it. You'll find them out there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Those days were intense.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Rusthammers, beasts, gangs.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "And the goddamned scouts.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "New Manfist's a helluva shithole.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Finishes the 'Iceflame')",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "*Cough*",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "None of the folks I brought with me made it out alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "It was just me, a disgraced old vet, cast out by the explorers, with nowhere to go except back to the city.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I went back home to find my old man had kicked the bucket. My little sister took over his work, while her big sister was as much a failure as she'd always been.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Heh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Really, when I got the letter, I was wondering if a schlub like me really deserved an invite to this place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "And clearly I didn't need to worry about that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Thanks to all of you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "And you too, Corporal Mark Green.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "I'm proud of all of you.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "(Turns off the recorder)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "That's all I have to say.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Let's leave it there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "Yes, Instructor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "(Puts his recorder away)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Life here isn't bad. There's a bunch of cute kids to teach, a bunch of loyal, dependable coworkers to talk to, even a commander with a pretty good head.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Plus, I met an old friend here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Not you. A Vulpo.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "She's an Infected girl. I fought her before with my electric blade. These days, though? We hang out and talk to each other.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "It's nice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Makes me wonder how long this is going to last...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hank",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Hmph...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dur-nar",
      "text": "Dario!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dario",
      "text": "Yes, ma'am?",
