  "storyId": "main_8_level_main_08-01_end",
  "groupId": "main_8",
  "stageId": "main_08-01",
  "title": "Yesterday, the Chaff Cracked",
  "storyCode": "R8-1",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_08-01_end.txt",
  "sourceHash": "304b44d6b30d7045686392f334fe8d2398131dd05f17b33bf6b3161729eee4ff",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Infected Patrol Unit",
      "text": "Ngh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "I didn't cut off your hands! Pick yourself up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Patrol Unit",
      "text": "...Don't you dare think this is over!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "I'll cut out your tongue right here, then.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Patrol Unit",
      "text": "Eek!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "...Off he goes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "Are you oka—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "What have you done! Oh, God, Talulah... Look at what you've done!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "Talulah, we'll have to transport the village in two days. Just look at what you've...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "You fought a patrolman! There'll be hell to pay now!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "Letting him beat you was even less of an idea. It's getting late, and he's on the run. If I kill him now, we'll be long gone by the time the others find his remains.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "But that wouldn't solve any of our problems. Once the patrol unit regroups, they'd still come looking for us. They might well be out to get revenge on us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "And yet you did it! Now what do we do!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "Calm down. They're looking for Infected. They still don't know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "Don't know what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "They don't know what I'm about to do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "Hey... Talulah!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "It's okay. Come on, I'll walk you back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "Your leg there... It will need special attention to heal.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "Hah. So today's the day you start helping me walk? Always thought I was still in good shape myself. Who'd've guessed I couldn't outrun it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "Talulah, there's something I need to tell you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "What is it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "text": "Ah, good question. Heh, hahah, sorry, I don't remember. Look at me now. Look at my memory...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "That's some impressive forgetfulness, alright.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
