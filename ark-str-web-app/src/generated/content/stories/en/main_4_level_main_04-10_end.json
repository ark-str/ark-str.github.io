{
  "server": "en",
  "storyId": "main_4_level_main_04-10_end",
  "groupId": "main_4",
  "stageId": "main_04-10",
  "title": "Extinguished Flames",
  "storyCode": "4-10",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-10_end.txt",
  "sourceHash": "99eb89f3cc865e5fbd4166ae0e891a61e51e7fd597b1403f5766ba97bc0f1d8e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Meteorite! We've managed to push the Yeti Squadron back!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "But...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "I seem to have underestimated you, Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Perhaps I held back a bit too much.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(I can't feel my fingers anymore... Damn it...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...What's going on...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The cold current... is still gathering around her?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "This time...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "You won't be so lucky.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...? !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Oh no...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Is she trying to absorb all the ice surrounding us and release it at once? !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "——♩——♬——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...She's going to drain all the heat from our bodies!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "These Arts are on a complete different scale from what we saw before...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Let it all come to an end.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "May your anger be buried by purest frost.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Nnngh...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...♩...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Something... is stopping the cold from gathering...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "...Gah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Is this your doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Didn't I already tell you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I won't let you... come any closer...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...Did you disrupt my cold current using your own Arts?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...What a good kid.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Frostleaf used her blade to sever the cold current...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "But, but... she can't hold out long in that condition!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Her blade... it's about to break!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...That's more than enough.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "This is our last chance!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Amiya... now is the time!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Cover me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Be careful!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Roger!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Starting firing - suppress Reunion's movements!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Meteorite, go!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "On my way...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "What?! The enemy is... rushing towards us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "No, she's... she's going straight towards FrostNova?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "As if we'd let you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Fire!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Agh...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Meteorite!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Don't worry, it wasn't a direct hit!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "She, she's still able to run?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Damn it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "I told you! You'll never reach the Yetis!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Keep firing! Don't give her an opening!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...Oh no!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Gaah...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Nooo!! She... she was hit... It can't be...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...It's just a scratch! You'll have to do better than that if you want to stop me!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "More... I need to do more...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(The flow of the cold air... fluctuated for a moment?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Wait... Where is that flow coming from...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "--!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I know this feeling...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Could it be...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I'll just have to give this a try!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I have to hit it...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Everyone, believe in me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Rhodes Island's leader...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "She shattered the Originium we planted with her Arts?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "It's getting hazy...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I knew it! FrostNova created that cold current by planting Originium!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Meteorite!! Now's your chance!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Frostleaf...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "I... I promise to save you!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "So, wait for me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Please wait for me!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Wake up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Nnh...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I've got you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Who...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Up here! Quick! Hold on to me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Meteo...rite?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Who said you could play the hero?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Do you think I could just sit there and watch you die?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Put me down... I'm not... some pet...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "I won't let go of you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Amiya! Jessica!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "...All right!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Everyone, let's get out of here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Meteorite, go ahead with Frostleaf. I'll cover your retreat!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Understood!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "...Gah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Haah... Haah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Frostleaf... hang in there...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Don't die... don't you dare die on me!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Don't worry... you can't get rid of me that easily...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Jeez, both you and Amiya too! Why do both of you have to be like this?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "No matter how strong you might be... you're both just kids after all!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "You're still treating me like a kid...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "...If I could save all of you by giving up my life, I think that's a pretty good deal.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "You... Mark my words! If you ever try to do something like this again...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "If you ever... I'd...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "*sigh*... Sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Start running, Meteorite.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Don't... look back...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Hurry! Just go!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Evacuate this area immediately! Protect the medics and the injured!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Snipers...! Aim at those effigies. Keep firing!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Disrupt their formation! Demolish the entire building to cover our escape!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The explosions are making the haze thicker...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Here's our opening! Get moving!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Everyone, we're retreating from this square!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "So... they got away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "How long have you been watching?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Just a few minutes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "These warriors are worthy of praise.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Tch.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Be careful.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Your body isn't in very good condition.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...I don't need you to remind me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Just do what you need to do, old timer.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "I'm going to go after Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "We have to get rid of them first. Only then, will we be able...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...to go to Lungmen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Phew...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Haah......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We're almost at the escape point.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Doctor, we...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...Amiya!! We've finally gotten through to the L.G.D.!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "It's an emergency communication!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Madam Ch'en!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Listen... up...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Madam Ch'en? Can you hear me clearly?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...Lungmen...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...What's going on?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...I'm safe now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "But...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...Reunion took over one of our important facilities and is now forcefully opening a passage between the slums and the outer city.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Amiya...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Lungmen... is in danger.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "............"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "W managed to lure Lungmen and Rhodes Island right into our trap.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "That's right. They won't be able to escape. Faust and Crownslayer have already broken their defenses at one location.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "As you said, this will be our opening to flood into Lungmen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "We will set up ambushes around every corner. The road to Lungmen will run red with fresh blood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Right, that old flag-waver should be coming back to Chernobog soon.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Our victory is assured.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Do you have any other orders for me, Talulah?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "The time is upon us...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "text": "...to turn this rotten city into ashes.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
