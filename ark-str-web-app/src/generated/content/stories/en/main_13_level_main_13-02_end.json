  "bodyAvailable": true,
  "blocks": [
    {
      "type": "choice",
      "options": [
        {
          "label": "Stay calm!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Don't panic!",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Panicking Citizen",
          "text": "Out of my way, out of my way!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Crying Citizen",
          "text": "Th-The monsters are coming!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Panicking Citizen",
          "text": "Get out of my way!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Crying Citizen",
          "text": "Get away! There's blood on you! Like those monsters!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Doctor, I'm here! Grab my hand!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Grab my hand, Doctor.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "You...",
          "value": "2",
          "blocks": []
        },
        {
          "label": "You're not Amiya!",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Damazti...",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya?",
          "text": "...Why?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya?",
          "text": "What should The King of Sarkaz look like?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You're not the one you once were.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "I heard Logos's bone whistle.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "The myriad souls still reject us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "However... a change has occurred. A part of us has left us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "We must make a choice... we cannot remain stagnant.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "...King of Sarkaz.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "I tried to imitate you, but I failed.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "A new Damazti...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Is this your choice? To formally stand against us?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "We simply decided to try.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Hm—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "Will we learn our meaning in battle against you, King of Sarkaz?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "Where does our path lead?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Once... I asked the previous Damazti what I should do. He said I must overcome all doubt and hesitation.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "If you still call me the King of Sarkaz after being reborn...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Then go find the answer yourself. You won't get it from me.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Oh, did I hurt you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "That Ascalon woman is so annoying. Is she so persistent with everyone?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Look out, Amiya!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You're the one they're after!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "H-How—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "I have long waited to rummage in your emotions and memories, little king.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "I thought the Revenant would cause you some difficulty, but you seem to be in better condition than I expected.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Cautus, no, Chimera.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "You are no Theresa.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Confessarius Guard",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Let go of me—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "You had the fortune to be conferred the crown, but do you truly understand your power?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "We have studied the King of Sarkaz for thousands of years.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "As for you...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Get... away... from... Doctor!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Oh? Still mustering the power of the King of Sarkaz, even when surrounded by Confessarius witchcraft? I'm starting to miss Liz.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Well, this is a benefit to our experiments. I'll spare the Doctor's life, for now, and teach you to leverage your emotions.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "But I must make sure you behave before handing you over to the leader.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Great Damazti, that nasty woman is coming. May I count on you to deal with the rest?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "Very well.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Damazti Cluster",
          "text": "Maybe she will temper us.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ascalon",
          "text": "Doctor! Stay where you are!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ascalon",
          "text": "The most important thing is—",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Let her go—",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Let Amiya go!",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Huff, huff, huff...",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Huff, huff, huff...",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Where is this place? What are these statues?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "They look like they could come alive at any time.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Statues of the Sarkaz races?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "You're tough, 'Doctor'. I respect that.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Awake?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "How did you follow me with that feeble constitution of yours? I examined your body, but found nothing.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Well... not exactly nothing.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Your structure is... unusual. Different from all the samples I've seen. I would very much like to study you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "In great detail. Unfortunately, this place has been abandoned a long time, and the equipment is far from adequate. It would not do to damage such a precious sample.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Perhaps I could bring you back to Londinium. But Theresis seems to pay particular attention to you...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya...",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Look, 'Doctor'. What is she looking at?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "She's trembling.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What did you do to her?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "'The King of Sarkaz grants the promised land.' The little bunny simply got a taste of her own power.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We don't need to be crossing swords. You want knowledge? Rhodes Island has it.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Salus",
              "text": "Laughable attempt at flattery.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "What do you want? We can talk about it.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Salus",
              "text": "Meaningless negotiation.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "Stop, or I'll drown you in lava.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Salus",
              "text": "A trembling threat.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Painfully amusing, the way you hopelessly grasp at straws.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "No operators at your side. Nothing for you to command. Even the King of Sarkaz whom you served is leaving you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "What can you do?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "I've asked the leader many times: why does power so often end up in the hands of the ordinary?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "What have these forgotten Kings of Sarkaz given us, besides a life of exile and persecution?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Will you, 'Doctor', be one of the causes of another round of suffering?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You have questions, but this is not the time or place to answer them.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Remove the spell on Amiya, and I'll do my best to answer.",
          "value": "2",
          "blocks": []
        },
        {
          "label": "I have the same questions, but hurting Amiya is not the answer.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "I appreciate your intelligence, but there has never been a shortage of smart people.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "There is nothing that can compare to this opportunity, what we have pursued for thousands of years.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "If she can force the crown upon the head of this little bunny—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Then it can be forced out.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You want to steal Amiya's crown!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Steal? No, this crown is not a ring lying on the battlefield for the taking.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "You'll never understand.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "What's this? A rock?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "How touching, putting yourself in front of her. But meaningless.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "If you're so obsessed, I have a better way to deal with you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Perhaps that brain beneath the hood holds secrets beneficial to our experiments.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "There. Don't try to resist.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Share your memories with me—",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Get out of my head!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "What? What could possibly repel a Confessarius's...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "The King of Sarkaz? But her mind should have been shackled...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "*Ancient Sarkaz Language*",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "The shackles of myriad souls are not so easily broken. She remains amidst the myriad souls.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "She has chosen to protect you subconsciously. Hah.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Wait... That's not all?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Her connection with the crown is growing?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya! Wake up!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Ah, such intense emotions.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Looks like Theresa's choice was not entirely one of desperation, after all.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Why don't we cut straight to the chase, then? I hope this won't break your little head. That would be a shame.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "The Confessarii left more than statues in this cavern.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "*Sarkaz incantation*",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You promised—",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Reject the voice!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Tsk—",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ascalon",
          "text": "That was reckless, Doctor. If I didn't run into—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Look out.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Vampire Arts... what have you done to your bloodline?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Hard to imagine that you're related to Shining.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "The amount of grief that your degeneration has caused that fine girl...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "*Cough* *cough*—Lord of the Banshees.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "I'm impressed. It couldn't have been easy to get here.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "I should have been more careful, knowing that the sitting Lord of the Banshees is rather rebellious.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ascalon",
          "text": "You're more dangerous than we expected.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ascalon",
          "text": "Urgent situation. Interrogation out of the question. Kill her and leave.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "I know.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "This is the Lord of the Banshees? The Elegiac Court? Indeed, these incantations are no less refined than that of your famous mother.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "But... did you know?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Salus",
          "text": "Such refined runes, refined Arts... they are far from the Sarkaz's roots.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Ascalon!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "—!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Doctor.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "We've left the cave. Ascalon is scouting the area.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Your right forearm is broken. I made a makeshift splint, but I'm no medic.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What about Amiya?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Still unconscious. The Confessarius said something to the effect of 'trapped in the myriad souls', but...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "She's alive, at least.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "I can understand Ascalon's objection to your methods. She's concerned for more than just your safety.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "But it's also true that you bought us time. The Confessarius and Amiya would be behind Londinium's walls by now, if not for your efforts.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What of the Confessarius?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "She got away.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Rock and earth, blood... and the wail of the Banshee.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Is this the Sarkaz that the Confessarii want? One so obsessed with bloodline and witchcraft?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Their target is the King of Sarkaz.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We must inform Kal'tsit and Shining.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "...Wait.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "The vapor around us...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "...This can't be. Careful, Doctor. We may still be inside the enemy's trap.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What is it?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "I don't often see that look on your face.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "This is not Victoria.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "This is the Convallis of the Banshees.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
