  "stageId": "main_04-09",
  "title": "Bad to the Bone",
  "storyCode": "4-9",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-09_end.txt",
  "sourceHash": "3b8a15412b80c943803ceef1b049a68b58a63ccae3d56ce6ca39af9eb49f43ae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Frostleaf, watch out! Don't rush so far forward!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I know what I'm doing!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Aaah! Aaaagghhh!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "She sliced through the shield using a blade of frigid air?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Wh-what?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Get lost!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Amiya! Frostleaf has broken the enemy's formation, and is now charging towards their commander!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Snipers, casters, I need you to cover Frostleaf!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Ohh...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "And just what do you want, little fox?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I want you to scream and beg. I want you to pay...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "...with your life.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Out of my way!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Woah!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "B-Black Arts...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "H-hurry, run for it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "I don't want to end up like Mephisto's minions...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Mephisto, we're not letting you get away!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Heh. I should have guessed that these goons weren't enough to stop you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "You're going to pay for what you've done, you sick bastard!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "You can't escape.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Little fox, you're getting a bit too close for comfort.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Because I am the one who will take your life.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Those who do not respect the sanctity of life...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Do not deserve on of their own.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Hehhh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Is that so.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "What... My feet...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Amiya! Reunion forces are appearing from all directions! Even though there aren't a lot of them...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Oh no, it's the Yeti Squadron...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "They've all... come together!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "All right, I need to introduce you to a new friend.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Ahem~ Next up, put your hands together for the real star of the show...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "The nightmare of the northwest tundra, the master of the Yetis...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Miss... Frost... Novaaaaaaa!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "She will freeze every bit of your flesh, every drop of your blood...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Bit. By. Bit!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...We need to get out of here...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Mephisto...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "I should have left you to slowly freeze to death in the tundra like the psychopath you are.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Oh my, scary, scary~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "But Rhodes Island is right in front of us.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Frostleaf...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Back up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Amiya, take them with you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I refuse!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That person... that person is...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "She's... coming towards me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "We can't win.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Hah... Even though I would've liked to live a bit longer...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I'm glad that I had the chance to meet all of you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Hurry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Frostleaf?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Hurry!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Don't worry, Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "I'll give you a painless death.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
