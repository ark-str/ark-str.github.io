  "groupId": "main_6",
  "stageId": "main_06-03",
  "title": "Lost at Once",
  "storyCode": "6-3",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_06-03_end.txt",
