{
  "server": "en",
  "storyId": "main_4_level_main_04-08_beg",
  "groupId": "main_4",
  "stageId": "main_04-08",
  "title": "Acute Stress Disorder",
  "storyCode": "4-8",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-08_beg.txt",
  "sourceHash": "1cc9528a93d9b158a0185382385330a6808218a0811f1e4dacd6897cf7e88a50",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Hmm...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Where is this...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We're getting close to the coordinates that Frostleaf sent us, but...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What a disgusting smell.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's the stench of something burning...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Where did Reunion lead us to?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Tsk! Watch out for the sneak attack!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Darn it...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "text": "I... I missed?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Don't worry. We're safe here!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "text": "Guh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Wh-what's wrong?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "text": "Guh... urgh... aah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "He won't be able to answer you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Wh-what?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "From that building!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Wait, is that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Frostleaf! Frostleaf, is that you",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "It is. I've taken care of the enemy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Sorry for making you worry, Amiya.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Ugh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Are you injured?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Medic, hurry!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No way... Why is your body all frostbitten? What happened to you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Don't worry, it's minor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Meteorite and Jessica are still in the main square.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "They should be safe for the time being, but it's hard to say how long that's going to last for.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I managed to lure the enemy out, so Reunion hasn't found them yet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The enemy?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Our cover hasn't been blown yet, so there's no need for concern yet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "But, he's going to come soon...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Where are you hiding, little fox?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Hurry and come out. Our game of hide and seek is about to come to an end.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "For every minute you stay hidden, I'll break another one of your friends' fingers--",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Do you still plan to keep running?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Mephisto...!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "(He's bluffing. Don't take the bait.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(What is he doing...)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Reunion is moving.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That little...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We have to get in touch with Meteorite...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Why can't I get through? We've clearly already crossed the contaminated area...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "*sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Take a look at this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Your communicator?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's... frozen over? Did it get... ruined by the frost?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Mephisto is a nobody.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "There's something wandering in this city...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "...that is far more terrifying.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Something more terrifying?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "The Yetis. If we run into them, we'll be in serious trouble.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Yetis? Are you talking about the Yeti Squadron? What are they exactly...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I don't have time to explain right now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "But they are the ones... behind the sudden temperature drop, as well as our squads' injuries.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "It seems like this squad has already established their territory within this city.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The sky is getting darker. This is a good opportunity for us...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We'll be able to cross this open area more easily.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Let's go rescue Meteorite and Jessica first.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I'll lead the way.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What are those things in the main square? I can't really see...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Are they... statues of some sort? Their shapes are really strange...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "And this smell makes me want to vomit...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Over here. Don't get separated.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Don't go look at those things...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "--We have company.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Let's take them out before they notice us.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
