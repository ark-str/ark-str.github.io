{
  "server": "en",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "Singer",
  "storyCode": "SV-2",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "8f1f9d93b9b33fb8b694e7560efd03f357aa0dc2a8fafc32ba396f0ab087f37d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "3:23 P.M. \\ Overcast\nIberia, Sal Viento"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "This is the place on the map.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I can't say it smells any good.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Hello.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "May I ask—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Another Male Inhabitant",
      "text": "(He hangs his head low, and does not speak.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Monsters?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "They're all humans.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "(She utters Iberian.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Is this not how they speak anymore?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "(Iberian again, the accent somewhat changed.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Moreover, I'm a singer right now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "A singer doesn't do that. Mister José said so.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Ninety-nine...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Someone's talking.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Ninety-nine.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "A... child? He's mumbling a number.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I can't have misheard.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "You—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "My necklace just...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "You will not escape!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "text": "Ninety-nine, ninety-nine...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "You can't run.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "text": "*Whimper*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Why take what's mine? Why bring me here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "A hole, a few ropes. The ambushes outside were at least much more adequate than this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Come out, all of you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I needed to find you, anyway. Quickly, if you don't mind.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "She's very peculiar.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "Quite, Sheetmetal. Such a person, I've never before seen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Nor I.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "So you know how to speak after all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Who are you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "A wandering singer.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "I know not what a wandering singer is.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "Sheetmetal, do not speak to her.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Your face, unfamiliar. Your attire, strange. You are not one from here. What is your business?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I want to ask a question.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Your clothes, very new.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Have you seen my fellow person?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "You have much strength. You are able to eat your fill.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "She came here before I did.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Your case, very heavy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "An instrument is not a light thing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "The thing in your grasp, very uncanny.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I assume your harps should come more or less the same.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "(Plucks strings)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Ears, pained. It is a weapon.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "It is able to not be.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "Sheetmetal, this person, uncanny. Do not heed her. To speak, very tiring.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Bench. Let go of him.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Bench... Do you mean this child?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I didn't intend anything for him. He took something of mine. Things like that are significant.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "You came to rob something.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I'm only taking back what's mine. And looking for someone who can understand me when I talk.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "text": "*Whimper*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Our child, you may not touch.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Our things, you may not rob.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Our rules, may not be broken.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "Sheetmetal, you have gotten nearer. What are you doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "She is going to harm our child, steal what is ours, break our rules.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "Is she not our sister? If she is, she too has a share.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "She is surely not.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "You don't understand me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I'll go and ask someone else.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "You may not leave.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "One moment, Sheetmetal...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "Ouch!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "text": "There—There is a hole here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Woodframe's hole. You forgot.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Oh, it comes in handy after all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "text": "Those from outside, to our place, you should not have come!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
