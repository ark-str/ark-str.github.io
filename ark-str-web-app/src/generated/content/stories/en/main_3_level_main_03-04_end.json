  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "What the hell...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "All that, for only a single Reunion squad...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "And a really big guy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Now that was the highlight. I'm totally exhausted just from dealing with him!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Impossible.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "How could so many Infected vanish so quickly?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Was that giant guy just a diversion?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Did Reunion manage to completely evacuate this area in such a short period of time?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No... Madam Ch'en should have blocked off their escape route...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "I'm not seeing the designated waypoint.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Something... isn't right about this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Weeds, ruins, sand dunes...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "All of which are potential spots for an ambush...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "But, I'm not seeing anything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "No footsteps, no sounds of clothing brushing against plants, no smell of explosives...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "I can't tell what's going on!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Penguin Logistics, wake up and do your job!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "This isn't right at all!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Hush!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "What's that sound...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "... ... ... Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "It's from... underground?!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Amiya! The noise is coming from underground!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Doctor!! Get down, now!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "These guys... will really stop at nothing!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "How... did you block that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "My 'Hannya' is not something you can penetrate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "We'll see... about that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "The temperature is rising sharply! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Is he trying to detonate his staff?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Doctor! Run away! At that distance, you'll--",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "You'll---",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "It's over!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No... Noooo---!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "You can't-----",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I won't let you hurt Doctor------! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "You are powerful...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "But... look at you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "You're so strong.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "*cough*... It hurts...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Even though you have this kind of power...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "You still... in cold blood... watch your fellow Infected...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "I can't... forgive...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "I can't forgive those like you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Ugh...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "... ...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "No... Don't...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
