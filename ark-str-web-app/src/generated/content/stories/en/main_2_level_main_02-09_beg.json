  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十一关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Why are there so many Reunion members here?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Aaargh!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Am I the only one who thinks that there are more and more of them coming?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Ugh!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Nope. It's clear that they have more reinforcements coming.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Curses... We still haven't had a chance to avenge them yet...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "They ended up finding us first.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Franka, look.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Over by the east exit, I think those are Reunion's casters hiding over there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "A lot of them approaching from the central passage as well as from the high-rises to our sides...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "...They're trying to sneak over while pretending like they haven't noticed us yet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "But, we're on top of the roof...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "No matter how many they send at us, they'll be doomed if they get knocked over...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "I feel like they're insulting my intelligence by launching an attack as brazen as this...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Is Reunion launching their offensive?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "All operators, regroup!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Wait, I think I just saw...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Isn't that the Reunion commander we ran into earlier?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "... Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Did you turn her over to Lungmen?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Franka, we have to hold back the Reunion forces first!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(We'll have to make our way down once they're too afraid to keep attacking us!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(We'll have to spread out the battlefield for now!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "(Understood. We'll be doing a hit and run then!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What does it have to do with you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...How dare you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "My comrades, attaaack!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
