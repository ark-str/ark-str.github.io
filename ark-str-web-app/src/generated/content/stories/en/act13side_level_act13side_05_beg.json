  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 5-1"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Withered Knight",
      "text": "Guah... Uhhh—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corrupted Knight",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Withered Knight",
      "text": "Aaah... ah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "An Armorless Union Member",
      "text": "Report. The Withered Knight is displaying rejection symptoms after the injection.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "An Armorless Union Member",
      "text": "No... We didn't observe similar reactions in the other knights. The pharmacists think it could be an allergic reaction that occurs in Sarkaz.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "An Armorless Union Member",
      "text": "What? T-That's a waste...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "An Armorless Union Member",
      "text": "It's almost as concentrated as the restoration gels they sell in stores as it is... This stuff is for fixing armor, and they're human. If we keep injecting this into their bodies, we'll end up causing irreparable damage to their brains...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "An Armorless Union Member",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "An Armorless Union Member",
      "text": "Okay, I understand... They're Sarkaz... not human...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "An Armorless Union Member",
      "text": "*Sigh*... You heard them. Increase the concentration by another 0.3%... We'll find out the Sarkaz limit.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "What... are you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Withered Knight",
      "text": "Gkhaa... Gkhaa...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Corrupted Knight",
      "text": "You... Nightzmora... must die...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The young Nightzmora lets out a long sigh. He looks up to find the familiar night sky has been dispelled by the bright lights of the city.\nIs this, too, a symbol of a civilization's advancement? Is Kazimierz conquering the night skies with its bright neon lights?\nHe finds himself struck with a sense of melancholy."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "Hey!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "Maria!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "Thank goodness... You're okay!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "U-Uh, Zofia? P-Please. Don't cry...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bald Marcin",
      "text": "I'm glad you're alright, Maria.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Old Knight",
      "text": "How were we supposed to face Old Nearl if something happened to you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Craftsman",
      "text": "Not that we can face him the way things are now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "Ahaha... You're not that old. What are you talking about? *cough*.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "Uhh... Zofia? Could you let go... Please?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "Alright.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Sorry to interrupt this exemplary show of sisterly love... but it seems Margaret is missing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "Uh... When did you...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "I've been here since the hugging.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "Ugh... Who are you again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "Oh, this guy helped me out just now—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Knight",
      "text": "It's you! Y-You're...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "A case of mistaken identity, Old Knight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Knight",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "So? Where's Margaret?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "After all that ruckus, is the insensitive Radiant Knight still going to carry on with the Major, foolhardy as she is?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "I... I don't know if we should tell her...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Heh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "The Armorless Union isn't going to give up so easily. They'll attack again sooner or later. You're all in danger!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "But... telling Margaret is exactly what they want us to do...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "This is the Grand Knight Territory. There is nowhere to run. They'll always find you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "These are different times, not like before. The General Chamber of Commerce is growing even as we speak.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "This is for your own safety, Maria. We have to tell Margaret.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "Is that really going to solve anything?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "Are they really going to give up just because she pulls out of the Major?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "(W-What am I thinking...?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "It's not a bad thing to be so lost in thought. So long as you're not like a certain someone, anyway.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Okay, if Margaret isn't here, I still have something else to attend to. Cheerio.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "Hold on, what are you—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Knight",
      "text": "Zofia.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Old Knight",
      "text": "Let him go. Don't ask any more. It's okay.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "Alright then...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Zofia",
      "text": "I owe you for saving Maria though. If there's anything we can do to help... let us know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Hm... Right. Your attack glanced to the side, Maria. Your balance was off, and you were a little too slow too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Seems like this is an emotional problem, though, and I can't pretend I know how girls work.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Maria",
      "text": "Is it an emotional problem?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Knights don't fight on the battlefield.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "You won't be getting very far on borrowed ideals alone.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Roy",
      "text": "Confessarius. Seriously? Just the name gives me chills.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Monique",
      "text": "If you're going to question that, try Darksteel.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Roy",
      "text": "I'll pass... He's a Sarkaz too, isn't he? Something like a legendary mercenary?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Roy",
      "text": "A Sarkaz from Kazdel, the Radiant Knight, and this Rhodes Island... Interesting.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Monique",
      "text": "Interesting, and also in the way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Roy",
      "text": "We have to deal with both the Board and the Knights Association, we have to take care of the Infected so discreetly, and we even have to be careful and cautious about it. When will all this be over?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Monique",
      "text": "Soon...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Roy",
      "text": "Right... soon.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Roy",
      "text": "But Darksteel doesn't step up. Doesn't that mean we'll have to take care of all this dirty work ourselves?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Wait.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Let's show some mercy. Why not?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Withered Knight",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "They lost. I have the right to do whatever I want with them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "They are my kin, and I can't bear to see my kin end up like this in Kazimierz. Let me take care of them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "Your kin... heh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "These filthy creatures don't deserve to be my war prize.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "I'll break one arm each for their punishment. Take them away, the eyesores.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Ah, that's it? I thought we'd have to fight to come to an agreement.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nightmare Knight",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Toland",
      "text": "Eh, hey now. Keep your blade where it is. Forget I said anything.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "A Voice on the Television",
      "text": "Reigning victorious over the Candle Knight, the Radiant Knight is making huge waves in both in the media and on the intercity net.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A Voice on the Television",
      "text": "Furthermore, citizens are trembling in fear with Infected terrorism on the rise across the Grand Knight Territory.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A Voice on the Television",
      "text": "Area 0's officer-in-charge and a General Chamber of Commerce spokesman have announced they will hold a press conference in the upcoming days.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Młynar",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Spokesman Malkiewicz",
      "text": "Anyway... That's about the size of it, Doctor, Miss Amiya.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Spokesman Malkiewicz",
      "text": "I'm afraid... things aren't very calm in Area 0 these days, and the Infected are taking the fall for the uprisings that happened the other day.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Spokesman Malkiewicz",
      "text": "These are extraordinary circumstances... but we don't want to put a stop to the sheltering and medical treatment just because of this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Spokesman Malkiewicz",
      "text": "Please avoid wandering around town the next couple days. I'm very sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Doctor... the news...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gravel",
      "text": "It's not 100% false, unfortunately.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gravel",
      "text": "The Infected have actually been making a lot of noise, especially after the Radiant Knight defeated the Candle Knight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gravel",
      "text": "We had eleven cases of violence just yesterday.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Gossip is a fearful thing, and the media knows that best.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "That can't be true.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Hibiscus",
          "text": "Apparently some of the Board members were assaulted?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Hibiscus",
          "text": "Whoa... There are even protests going on.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Hibiscus",
          "text": "I just hope it won't affect the knights... That lady yesterday said she'd buy toys for her siblings with her winnings.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Then... does that mean Nearl is...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Protestors",
          "text": "Deport the Infected! The Infected don't belong in the Grand Knight Territory!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Protestors",
          "text": "The Infected quarantine zone is an Oripathy petri dish!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Commuting Worker",
          "text": "What's going on here? I just got out of my meeting. How did things get so out of hand?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Hurrying Worker",
          "text": "Hm? Look at that city block over there. Isn't that the Infected shelter and treatment center?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Hurrying Worker",
          "text": "The protest's let up a little already. It was way worse this afternoon. They had a huge banner, too.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Do you need something?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Protesting Knight",
          "text": "The Radiant Knight... Do you know why those Infected dare do this out in the open?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Protesting Knight",
          "text": "They're committing terrorist attacks all over the city, dragging innocent citizens into the fray. Do you know where they got the courage to do this?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Protesting Knight",
          "text": "It was you! It was you and the Blood Knight. It was you infected knights who gave them the right the resist!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Protesting Knight",
          "text": "I... I know you're no villain, champion. I even used to be a fan of yours.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Protesting Knight",
          "text": "But by staying in the Major, you are only giving the Infected false hope.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Protesting Knight",
          "text": "False hope that... they can change the status quo.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "A Protesting Knight",
          "text": "You'd do well to keep your nose clean, Radiant Knight... Don't end up regretting your actions.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "............",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "What's the matter, Nearl?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "You don't look like a knight who just won a match.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "No...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Nearl.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "If there's something on your mind, tell us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Right... I'm just thinking about the Infected.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "About that... we have another lead. Amiya knows already. There's no doubt that someone is behind all this.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "But you don't need to worry about that right now.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "Trust me, and trust Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Alright.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Keep your light shining bright, and worry about nothing else, Nearl.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "At the same time... Please don't push yourself either. You're strong, but your exhaustion is building up.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Try to take it easier once in a while.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Kazimierz... is my home.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "I'm very happy to see Maria all grown up and aiming to become a knight, and that Zofia and Old Marcin are both doing well...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "But, right this moment, I feel more relieved that you two are here by my side.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Are we your family too, Nearl?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "It's hard to say, Liz.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "It'll be some time before winter comes, but it still gets pretty chilly at night here in Kazimierz. Liz, go back to Amiya.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "We've all been worried about you ever since you 'left' Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "I know, but that's exactly why I can't drag them into my own mess.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "But you're fine dragging us into it?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "You're free to leave now, if you want.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "Well, well, look at you. Our Radiant Knight acting all snarky.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Music...? Is there a bar nearby?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "It used to be a row of regular old offices here. If I remember correctly, there was a publisher.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "The Grand Knight Territory wasn't this big...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "But, for the past couple decades, every time there was a Major, the Grand Knight Territory would pick out three cities to dock with after a round of competitive bidding.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "The Kawalerielki Alliance.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "The city's changing... and even though this is my home, it feels a little... foreign.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "You haven't been back for very long yet, Nearl.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "And you dove straight into the Kazimierz Major right away... you chose to throw yourself into your ideals.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "You haven't started living a new, proper life here just yet.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "I will, sooner or later. But now's not the time.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "You must be tired... I can feel it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Should we take a walk? The night breeze might sweep away some of your exhaustion.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Sure. Take my hand.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Of course.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "How tough was the Candle Knight?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "I was surprised to find a knight like her in Kazimierz these days.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "She's strong, but her hesitation proved to be her weakness. It's too bad we couldn't face each other when she's at her best.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "Did you enjoy it?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "I used to despise knight sports. No... even now, I feel nothing but sorrow for the shape Kazimierz is in.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "But... haven't we been through a lot together?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The three friends walk slowly down the street under the Kazimierz night sky.\nFar away from the loud markets and hustle and bustle, only traces of the city's warmth can be felt in this alley.\nThe warmth comes from liquor and song, as well as the aroma of baked goods that yet lingers as pedestrians come and go."
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "This doesn't change what we need to do.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "And that's even if, after everything has come to pass, my journey is destined to be ridiculed.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "—Like wings taking flight in the night breeze.\n—Like a traveler with a heart full of dreams.\n—The knight sets out on her journey.\n—In search of true love."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "What a beautiful voice...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "Maybe it's a wandering singer.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Is there a place so romantic in Kazimierz too?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "It's proof that there are people who live here.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "—A fate as fragile as a cornflower.\n—To face a test fierce as windstorms."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Hmm... Hmhmm...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Liz, would you care to dance?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Huh? Me? What...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "It's fine. Take my hand.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Alright...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Oh... S-Slow down, Nearl...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Alright.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The blue bird takes flight in the gentle night sky.\nIt dances amongst the glowing neon towers and navigates through a gently flowing river of time.\nTaking the Sarkaz's hand, the knight waltzes back and forth under the dim lamplights.\nThe sight is reminiscent of the noblest statues found in Laterano."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "You're beautiful, Liz.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "R-Really?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Perhaps you will actually be able to dance one day.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "When that day comes... will you be there by our side?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "Of course.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The knight stops and kneels down before the lady of the lamp."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "I promise, Liz.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nightingale",
          "text": "Mhm...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "We'll be waiting, Nearl.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "At the end of your journey, before your light burns out, we'll be there with you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "When the time comes, if—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Shining",
          "text": "Nearl.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Margaret",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Roy",
          "text": "Good evening, Radiant Knight... and the lovely Sarkaz ladies.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Roy",
          "text": "I'm absolutely delighted to see you again so soon.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
