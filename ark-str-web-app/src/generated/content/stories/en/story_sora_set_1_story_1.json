{
  "server": "en",
  "storyId": "story_sora_set_1_story_1",
  "groupId": "story_sora_set_1",
  "stageId": null,
  "title": "Distance",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_sora_1_1.txt",
  "sourceHash": "2a7c7eb1d0641a7fa4e466aed223a6de18a8e4949bca6cd53f6cccd5c94afffd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "空"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Lungmen Citizen",
      "text": "What's going on?! Who are these people...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Lungmen Citizen",
      "text": "It's... it's Reunion! Why are they attacking us?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "H-Huh...? What is going on—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Lungmen Citizen",
      "text": "What... What are you people doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Lungmen Citizen",
      "text": "Stop it! This is our neighborhood!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Gah, scram if you don't want trouble!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "Ughh—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "You... You can't do this...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Why not? You know what kind of a rotten life you've got in this pathetic place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Stop it—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Who's there?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "I know that voice... It's her...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I made it... *pant*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Please don't hurt them. They are innocent!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "You've already razed a few blocks' worth of streets and shops. There are the homes of innocent civilians... How are they supposed to get by now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Who cares?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Like I give a crap how they live. Now scram, or you're next!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I'm not going to back down. I've spent my life bringing happiness... to encourage people to stay positive and live on.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "That's why... if you're going to destroy their lives... I will protect them. I am more than capable.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Besides, I've got help.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Stop bluffi—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "(Whistles)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Who's there...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Sorry we kept ya waitin', Sora.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Croissant, Exusiai, and... Texas.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "I don't think they're all that discouraged by anything you just said.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "In that case, it's time that we, Penguin Logistics, allies of justice, show you what for! Boink! Kapow! We'll knock you all down, just like that!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "'Penguin Logistics?' Heh, you really think you can stop us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "It's an emergency, so we've got no time to check with the boss, but he's not one to just stand aside while a bunch of bad guys muck up our turf! This is where we do business, after all!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Watch out. We don't know what these men might do. I'll stall them here and put a stop to it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Okay, Exusiai and I will take them out. Croissant, help evacuate the residents.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "On it, yeehaw!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "First, let's secure the path east...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Heyah—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "W-Why can't... I... move?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Hmph, take this—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "*cough*... It's the singing girl's Arts... Stop her song. Take her out first!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "*Pant*... *pant*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "Did they... stop?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Heh... Trying to ambush us? Let's kick this into Overloading Mode, then!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Now. Run.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "text": "Running away? Not so fast... Let's try... this—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "text": "Impossible... Not even my Arts are working...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Heheh, that's not all that Sora can do! Sora, rouse me up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Okay... on it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "Miss Sora... Is it really you? But... Why are you here...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Now! Get 'em—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Lungmen Citizen",
      "text": "Just who are you people...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Get clear first!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "There ain't time to think 'bout all that... Giddy up! Get movin'!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "(Huh? That girl over there...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trapped Lungmen Citizen",
      "text": "(Ugh... I can't. I can't let anybody see me like this...!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Texas, the L.G.D.'s gonna be here mighty soon!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Alright. Exusiai, Sora—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Yes, I got it...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Time to split! Buh-bye!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "That girl...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I think I've seen her before... No, I've definitely met her before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Is that her...?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "She was at the front of the line to hand me a letter at my first fan meeting in Lungmen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Then, after one last letter, she stopped coming to my events...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I'm sure of it. She's my very first fan, after all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "But... what is she doing here in the slums?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "And... those Originium crystals on her arm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Did she... become an Infected?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "A few days later\nPenguin Logistics Office"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Ahh... I'm pooped.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Huh, Sora? I didn't know you were here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Oh, Exusiai, Croissant. Yeah, I'm done with practice for the day.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "That's good. We're about to head out. You wanna come with us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "We gave the L.G.D. a hand the other day, and apparently they gave Boss a call, asking us to stop by their office to get a 'Lungmen Benevolent Organization' certificate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "After we've done a photoshoot in front of L.G.D. HQ, let's see if anybody dares pull me over~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "If'n yer drivin', yeah, you'll get pulled over. With them pitchers, though, I reckon ain't nobody gonna come checkin' my business licenses no more...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "If you ask me, I think your little side business deserves to be inspected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Heh, just makin' a quick buck.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So what'cha doin', Sora? Hmm... This a letter?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Yeah, it's... a letter from a fan.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Boy, that brings me back. When ya first got here, there was always all kindsa presents pilin' up in front of Penguin Logistics. Mailboxes stuffed to burstin' with fan mail.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Haha... Why don't you two go on ahead? I'll wait for Texas.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Sounds good. Here's the key. I'm hitching a ride with Croissant~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Don't worry yer li'l wings, Exusiai. I'll get'cha there safe n' sound n' right on time!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Don't be late, Sora! We don't get to be stand-up, model citizens every day!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Yeah, I won't.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "(This should be the one...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "(The handwriting... I remember it very well.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "(She was there at my fan meeting... My very first fan...)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Oh... Have you been waiting for me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Sora?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Hm? Oh, sorry, Texas. I spaced out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "It's alright.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Did something happen...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Oh, don't worry... It's not a big deal...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Texas... Were the people we helped in the slums the other day... all Infected?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "That's what's on your mind?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Yeah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Was there somebody you knew?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I'm not sure... but I think there was a girl... who I might've met once... probably.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "If that was really her, then she'd only be there because she was Infected. She wasn't... someone who lived there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Did you see the letters?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Letters? What letters?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "They came with the notice from L.G.D. this morning. Apparently they're letters of appreciation from the residents we saved.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Those letters are the reason the government is giving us that certificate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Isn't that what you're reading right now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Oh, no... This is... a fan letter from before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "A fan letter? You're reading it now, of all times...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Uh... Don't worry about it...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "It really is nothing, Texas. I suddenly felt like it. That's all...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Are you coming with me to the L.G.D.? I'll drive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Mmhm. I'll go!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Get in the car then.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Texas... If... Just if. If a Lungmenite becomes infected, what options do they have?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "I can only think of two.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "They either have to leave Lungmen or go to the slums.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Right... There's no other way... I know that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Texas.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Hmm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "In the future... will I be allowed to go on deliveries alone? I don't want to be a bother... but I am a member of Penguin Logistics, and I want to help out like everybody else.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Can you protect yourself?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I... I can...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Once you prove to me you can hold your own, I won't stop you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Yeah, thanks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "It kind of feels like I'm always thanking you...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "A week later...\nLungmen, somewhere in the slums"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Hello, is anybody home? Your package is here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "Who is it...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Hello, the items you ordered on the Penguin Logistics website are here. Could you please sign for the package~?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "A package...? Leave it outside the door.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Okay!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Umm... could you please sign for the package as well?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "I... I'm not sure I can step outside...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Huh? Is everything okay? Do you need any help?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "No, that's not what I meant... I don't want to come outside... You... You're not infected, right? I have Oripathy... I could spread it to you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "I appreciate Penguin Logistics at least letting me place orders, but you could catch Oripathy from me. Please just go!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Mister... Mister? Please, calm down.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "We've got long, stable relationships with Infected clients. Oripathy isn't something you can catch from physical contact.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Don't worry. All Penguin Logistics staff have received Oripathy prevention training. You can't hurt me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "And if you need any assistance, we can help you out anytime. We've partnered with a pharmaceutical company on several projects...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Mister, are you okay?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "Are you... not afraid of me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Of course not! Penguin Logistics aims to serve all customers with wholehearted devotion!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "Never mind... Leave it at the door.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Okay...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "Right, can I count on you people to deliver a letter uptown for me next time?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Of course! Penguin Logistics offers mail delivery too!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "Eh... fine. I need to let somebody there know how I'm doing. If they're willing to write back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Um, Mister...? If you would like, I can help you get in touch...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "No, never mind. Just stay away from me. My brain is a mess right now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Okay...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Dweller",
      "text": "Let's leave it at that. I'll use you guys again next time.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "It wasn't her...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I couldn't find her today either... Maybe she's already left Lungmen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Maybe it never was her anyway...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "But the handwriting in the appreciation letter to Penguin Logistics is the same as the fan letter I got.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "She didn't leave an address or a name. It was just a simple thank you letter, but I know it. It was you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "...I just... want to see you once again...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Are you willing to see me? Should... I even see you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "There is something I want to tell you face to face. I want to tell you that you've got to cheer up and find hope again.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Tomorrow... I'll come again tomorrow.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Two weeks later...\nLungmen slums, during a delivery"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Hello, is anybody home? Your package is here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Hello, the items you ordered on the Penguin Logistics website are here. Could you please sign for the package~?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Is anybody home?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(Grits teeth)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Hm... this is the right delivery time...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Yeah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Hello? Is there really nobody home?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(Trembles)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "...It's her voice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "But...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "(It's the right place... Are they not home?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I'll leave it at the door and send them a delivery confirmation... Okay.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "Sora subconsciously places her hand on the edge of her pocket. Slowly, she takes out the letter.\nOn the old, tattered envelope are the words 'To Miss Sora.'\nSora has read the letter inside and compared it with the letter of appreciation countless times. Its contents have been etched into her soul—\nNot only do the words of appreciation within evoke her nostalgia, they help keep her mind at ease."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "How come I can't find you? I saw you around here not too long ago... Have you really gone somewhere else?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "I... want to see you again.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "The person inside grips the door handle.\nYet the door does not open."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "But it's no big deal... I know we'll meet again.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Okay, time for the next package... Where does this one go...?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "She's gone... right?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "(Bends over)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "(Picks up the package)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "Thank you... Miss Sora.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "Looks like you got my letter.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "I want to see you again too, but right now... my body... my disease...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "You'll be happy once I finally find the courage to face myself again, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "I... I'll come to your concerts again, and I will be there at your fan meetings.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Slum Infected",
      "text": "Someday.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
