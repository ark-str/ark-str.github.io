        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Platinum!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "Hello, Doctor.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "You're in a good mood. Did something nice happen?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What's wrong? Why are you taking a nap in front of my office?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "You're finally awake. Did you need me for something?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "Nothing special.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "I just realized something. It's actually pretty easy to tell dreams and reality apart.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "*Sigh*... Anyway, here.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "A leave application?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Again? How many times does that make this month?",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "You can just deny it. Whatever.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "But anyway, I have something else I want to ask you.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Uhh... Let's start with that one first.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "What is it this time?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Platinum",
          "text": "Do you... have some free time right now?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
