{
  "server": "en",
  "storyId": "act12d0_level_act12d0_07_end",
  "groupId": "act12d0",
  "stageId": "act12d0_07",
  "title": "First Come First Served",
  "storyCode": "RI-7",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act12d0/level_act12d0_07_end.txt",
  "sourceHash": "886a3f533085f349b1eb55a03c1a7adb8e0b8fbe962c5ad5f6f32126e6cdd453",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Ceobe",
      "text": "I can't believe Reunion here is so tough. Hmph, I won't lose to you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Tch, this silly girl.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Wake up!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ceobe",
      "text": "Hm? Where am I?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ceobe",
      "text": "Oh, it's Gavial! Everyone else too!",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Good morning.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Ceobe",
              "text": "Ehehe. Good morning, Doctor.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Ceobe",
              "text": "Um, Doctor looks a little scary right now. Did I do something wrong?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Ceobe",
              "text": "Doctor, please don't be mad...",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "(Bop her on the head)",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Ceobe",
              "text": "Hnng... Doctor, that hurt.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Ceobe",
              "text": "Why did you bop me on the head...?",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Looks like she's back to her senses, at least.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Kay, do you remember how you got here?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceobe",
          "text": "Umm... I forgot!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Alright.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Come lie down, I'll check and see if there's anything wrong with you. Don't run off again.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceobe",
          "text": "Okay~ Ehh, where are we?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "We're... Hm, it's a long story. Just lie down already!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceobe",
          "text": "Ooh—",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Gavial, what the hell are you doing?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Ugh, that's a long story too. Just let me work.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Ten minutes later..."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Alright, everything looks okay. Go wait with the Doctor and don't wander off. If you do it again, it's no more honey biscuits for you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceobe",
          "text": "Okay! Honey biscuits!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Are you done?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "I'm done.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "So now can you tell me what the hell you're doing, Gavial?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "*Sigh*, I said it's a long story. Short version is I'm here to look for you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "You're not getting the engine back.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "That too. But there's another reason I'm looking for you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Another reason?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Do you have your people mining ore?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Yes.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "...Tch.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Gavial, I never took you for the sore loser type.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Are you that broken up about being beaten by the Big, Ugly Thing?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "No, your Big Ugly Whatever is great. I'm totally fine with that.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "But if you're putting your people at risk of Oripathy infection for the sake of some ore, then as a doctor I have no choice but to stop you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Huh? Oripathy? Oh, you're talking about Stone Disease.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "I'm not putting anyone at risk.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "I told them many times to stay away from the depths of the mine.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "But your people are getting infected!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "There's always someone who doesn't listen. I can't control them all. Isn't that right, Yogi?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yogi",
          "text": "Yes, my brother wanted to dig out more ore for the Great Chief, so he went deeper into the mine.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Huh? Why didn't you say so earlier?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yogi",
          "text": "You didn't ask.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "That's pretty important...!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You told me they don't take Oripathy seriously here.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Agh, fine.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": ".......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Doctor, did I really not ask?!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "You really didn't ask.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Agh, Doctor, take my side here!",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Also...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hey, why are you taking your clothes off?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Huh? Your body...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "I've been running around the mine ever since I was a kid. It's only natural I would get the Stone Disease.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "I dare say no one knows better than me where the diseased rocks are.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "All right then.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "My mistake. Sorry for accusing you, Zumama.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "It's fine.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Utage",
          "text": "Eh, that's all it took?! We're all good now?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Utage",
          "text": "Isn't everybody supposed to stubbornly stick to their guns until we all end up in one big honkin' battle?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Croissant",
          "text": "Ya shouldn't hope fer stuff like that!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Gavial isn't like that.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Too bad.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Then let's talk about the other thing.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "You have our engine, don't you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Yes.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Can you return that to us? We can't leave without it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "No.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "If you want to leave, I can have someone escort you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "No good. Kal'tsit will get mad.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "You won't hand it over no matter what?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "No matter what.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Utage",
          "text": "Oh, looks like we're gonna fight after all.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Looks like it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "That was the plan from the very beginning.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Oh, are we fighting that? Fun!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "High Priest",
          "text": "Hello, nice to meet you!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "...High Priest, why did you bring the Big Ugly out?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "High Priest",
          "text": "Huh? Aren't we going to fight Gavial? Do we not need it? If not, I'll drive it back. I still want to test the engine.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "...We need it, but not now. I still have something to say.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "High Priest",
          "text": "Oh, alright. You have your talk first then. Call me when you want to fight!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Sure.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hey, what was that about an engine?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "That's right, your engine is powering the Big Ugly right now. If you want it, you'll have to fight for it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hehe. Deal!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Come with me. We'll see who comes out on top.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
