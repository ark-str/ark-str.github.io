{
  "server": "en",
  "storyId": "act17d0_level_act17d0_06_end",
  "groupId": "act17d0",
  "stageId": "act17d0_06",
  "title": "Battle of the Lord's Manor",
  "storyCode": "OD-6",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act17d0/level_act17d0_06_end.txt",
  "sourceHash": "8f255eb2c2a3d2ee146f111890b93dc2eec16472eda37b6b0b14ce6ac3c9934a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Clear!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Okay, you're on guard duty!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Alexsandr, see if any of the mercs on the ground are alive!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "On it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Tina, get your bandages. Take a headcount and patch up the wounded.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Roger!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "No playing dead!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "Wait, please... lower your gun! I'll tell you anything!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Kötz, tie him up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Sure.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Where's the doctor? Dr. Miarow!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Over here!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "...*cough*...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Tina! Bandages! Hurry!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Stay with me! Don't close your eyes, boy!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Why... what happened?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "When you push yourself to use Originium Arts... it worsens your Originium infection...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Rhodes Island doesn't have a countermeasure? Isn't this what you people do?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Between the blood loss, burns, and acute Oripathy symptoms, even if we were back on the landship...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "...*cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I said stay with me, kid.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "...You can do this. Remember how you wanted to travel the world? Picture that Columbia you were dreaming about.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "...Stay with me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "...*cough*...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "...Doctor...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "...He's gone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "...I'm sorry. I couldn't...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "No... it's not your fault.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "...No... I had nothing to do with that. It wasn't me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "(Russian profanity), I'm going to twist your *profanity* head off.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "I just...don't...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "You're done for, (Russian profanity). You're toasted.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "text": "No! Don't hurt me! It wasn't me! No!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Alexsandr! Stop! Calm down!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Where did that guard captain go? The Lord's daughter?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "She chased someone trying to get away. Rangers went with her, don't worry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Wait... the crystals on the doctor's skin... are glowing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Huh?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "So soon? How?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "We've got bigger problems! Find an empty room here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "What are you doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "No time to explain! Move!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "We need cloth! Curtains, bedspreads, anything!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Get the doctor into that little house! Hurry!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "What's happening?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "What's wrong with the doctor? Why...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "M-Miss Cohen, please calm down. Franka's dealing with the doctor's—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Dealing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Dealing with what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "You've never seen it before? I'll explain it to you later—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Cover the doors and all the windows! No cracks!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "The chimney! Block it! And the vents!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "What... are they doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "I'm not sure? What's wrong with... the doctor's corpse?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Don't look.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Why?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Don't look...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "We're good here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Doors and windows good! Ready.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Hey, is that room lighting up? The window's glowing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Miss Cohen! Get back!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Don't watch...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "What on earth is going on?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "The doctor...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Oh...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
