  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "We're in the clear!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "You okay, Big Bob—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Huh? That wound on your leg...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "There are some stragglers over there! They're probably from the Valk Vanguards!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "I can handle this on my own! Go after the ones who are fleeing!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Sure.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Hmm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "This kid...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Hey, hey, why are you giving me that look?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "G-get away from me or I'll put a hole through you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Huh?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "You took care of them all?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "That's right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Impressive. This kid's got talent.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Stay there and don't move. I'll patch you up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "It's fine, I can take care of myself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "No means no.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "You saw it, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Mhm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "You saw the crystalization on my body, right? Are you trying to get yourself infected?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Our mission at Rhodes Island is to help all the Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Rhodes Island...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "text": "Rhodes Island? Aren't you from Victoria...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Former Victoria Mounted Police. Now, I'm a Rhodes Island operator!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Stay back, lass. I'm an Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Miss Carol, this might get a bit messy. You should step back a bit.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "All right, I stopped the bleeding.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "You do this a lot, huh? For the Infected?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "You're not afraid of me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "A lot of my coworkers are already Infected, but I can't tell who is and who isn't.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Well, it's sometimes hard to tell until it's time to hit the showers, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "...Hmph.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "Thanks, shorty. You're naive, but you're a good person.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
