{
  "server": "en",
  "storyId": "story_ethan_set_1_story_1",
  "groupId": "story_ethan_set_1",
  "stageId": null,
  "title": "'Old Friends in Foreign Places'",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_ethan_1_1.txt",
  "sourceHash": "8ae0a5b4c778bea8111e201af563ff70fcbdafa64f544744be29cefb399ac17a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 伊桑"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Oh, here you are.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Sorry to keep you waiting, Madame Oni.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "When did you get here? Yesterday?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yep... I came with the Messenger convoy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Rhodes Island's Messengers told me you'd left last month? What took you so long?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Our convoy ran into a little trouble on the way. We came across a few Infected Creatures. We got lucky, though.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Well, I'm glad you got here in one piece.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "So you came all the way here just for this?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Here, this is who you're after.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The tall policewoman hands a thick file to the short Savra."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Oh, thanks. Let's see here...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Are you sure he's the one?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Definitely... no question.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Looks like we're not the first you've turned to for help. You also asked Lee's Detective Agency, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "So who he is?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "A really good friend.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "*Sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Let me ask you again. Are you sure it's him?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "My answer's still the same, Officer Hoshiguma. I am pretty sure that's him.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "You still don't know how serious this is, don't you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Do you know how much trouble this is going to be if he's actually the 'Kevin' you were talking about?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Right, I know, I know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "*Sigh*, Old Ch'en sure knows how to ruin my day.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Rhodes Island's position in Lungmen is delicate, to say the least, and the one you're looking for there... Well, it's a long story.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "This case is technically being taken on by a civilian agency, but, well...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "If things get out of hand, it's gonna be my head. You get that, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yeah, I get it, Madame Oni.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "This is personal, though. Nothing to do with Rhodes Island. Relax.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Kam!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Right here, Inspector Hoshiguma.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "This is Officer Kam. He'll help you look.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "What's up, Officer Kam.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "(Nods)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Report back the instant something happens.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Thanks for the help, Madame Oni.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Be careful, and don't go looking for trouble, especially not there. Don't stay too long.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Right, I get it.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Inspector Hoshiguma told me you work as an informant for Rhodes Island?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yeah, I do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Speaking of, how's Ch'en Sir doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Oh, don't worry about it if you can't tell me. I just figured I'd ask.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Um, I don't know Officer Ch'en that well...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "But I guess she's been keeping busy helping everybody out. Seems like she's doing alright.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Well, that's good to hear.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Here we are.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The short Savra takes a look around the area.\nThe scars of war and the onslaughts the city has suffered are still clearly visible. The walls of the houses here, blown apart by cannon fire, have yet to be repaired. The damaged roads are still covered with fresh cement that has yet to dry.\nNonetheless, the morning streets are bustling, the slum dwellers are making their rounds, and the hawkers' peddling and the construction sounds nearby echo in unison.\nThe city is slowly recovering."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Do you speak Yan or Lungmenese?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I get by. Studied a bit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Don't say anything weird after we get inside. Do as I say.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "The people here aren't all that friendly to outsiders.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Secondly, don't go running around, and don't go taking any strolls in the back alleys.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "There are still some roads being repaired, and some of the buildings are really badly damaged and haven't been demolished yet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yeah, Ah Sir, I get it. Don't worry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "Three bucks a bottle! Just three bucks! Ice cold soda! You ain't gonna find soda cheaper than this in Lungmen!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Porter",
      "text": "Yo, Ah Hoi, gimme a bottle!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "You got it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "That's him.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Ah Hoi the soda guy. That's what everyone here calls him these days, at least.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Selling soda, huh? I didn't know he had a brain for business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "I'll wait for you around the corner.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Here's a communicator. If things look like they're about the get hairy, call for help.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "It costs an arm and a leg, so don't break it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I've known him a long time... I won't need it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Just take it. Better safe than sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "It's almost Sauin. Everyone at the department's got plenty to do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "You're not from here, and the Infected district's situation's complicated. You don't know what it's like.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "If things go wrong, the cops around won't get to you in time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I get it, I get it. I promise it'll be fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "*Sigh*... Well, be careful.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "Soda! Three bucks a bottle...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yo...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "How's business?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "You...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yep, it's me. Never thought I'd see you again.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "*Sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "So you actually came.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soda Hawker",
      "text": "I knew this would happen one day. I just didn't expect it to happen so soon.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "This isn't the reaction I was expecting...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "It's been a while, Kevin.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "We haven't seen each other since you went to Chernobog. How long has it been, three years?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I don't really know what happened to you since.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Looks like you're holding up pretty well, though.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "I'm getting by...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "That's good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Why don't you say something? It feels kinda awkward.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "We didn't use to be like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "I've got no last words to say.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Err, what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Passerby Old Man",
      "text": "*Cough*.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Passerby Old Man",
      "text": "Am I interrupting?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Oh, not at all... Good morning, Master Lin.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin?",
      "text": "Heavens, I am parched. Give me a bottle of your soda.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Here you go. Three dollars, please.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin?",
      "text": "I'm getting on in years. My legs aren't what they used to be. Would it be a problem if I took a seat here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Not at all. Please, go ahead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Hah.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "What? What's that for?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Nothing, I've just never seen you like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I remember when we used to go junk diving together. You'd pick a fight with those wandering bums every day.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "You never this friendly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "So that's why you're laughing at me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Nah, I'm not really trying to make fun of you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "You live in this hut?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "This is the Lungmen slums. Practically everyone here lives in one of these.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "It's much better than the old days when we lived on the streets. At least I have a roof over my head now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "That's a good thing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Being able to settle down is already pretty great for kids like us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "So...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Are you alone? Where are the others?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "What happened after that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You really want to know? Still care?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "What happened to the others after that...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "They're dead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Are you surprised? All Infected die sooner or later. If we don't die fighting, we die in some quiet corner, alone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "If you want to know the gory details, I can lay them on you. They all died in the most undignified way possible. There, happy?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "*Sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Is that all you wanted to say?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "If you want to fight... let's not do it here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Fight? Why would I fight you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "The folks here live a difficult life. If you kill me here, the L.G.D. will shut the whole place down. It'd be a big pain for my neighbors.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Hold on...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I think we've got a misunderstanding.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You aren't here to kill me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "No, hold on a second.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Why would I kill you? What are you talking about?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You can drop the act. I understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You left Reunion and went somewhere else.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Going by that trendy getup, it's gotta be a great place, eh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Most Infected don't get to live as good of a life as you do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "But if you want to keep living that high life, you still have one last obstacle.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "That's people like us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "I know who you are. I know you used to be Reunion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Once I'm dead, you won't have anyone to rat you out anymore. No one will ever know you were cut from the same cloth as us lowlifes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "(Silence)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "I knew this day would come.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Or should I say I've known for three years this day would come, when you told me you were thinking about leaving Reunion?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "It's not like we get to live all that long anyway. Everyone else's dead, and I don't think all this peace and quiet is going to last that much longer for me either.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "(Silence)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "What's wrong? Lost your tongue?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "A year ago...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "A year ago... I heard there were a few Reunion folks still in Lungmen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I spent all my money this year just to ask around, just to find you guys.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I held out hope that you were doing okay, that you made it through everything alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Looks like I shouldn't have.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Hold on, you really aren't here to kill me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "How could I be...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I don't know what you've been through these last few years, but I've always thought of you as a brother.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Back when we were starving in Kazimierz, you stole a few cans of food just for the rest of us, and you got beaten up so bad.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "When we were out in the wilderness, you fought off those bandits with Packy. That's how I'm still alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I'm grateful for you guys. If it wasn't for you, I would've died out there a long time ago.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "That's why I came here to look for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "But I kinda regret it now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I shouldn't have come.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Well, how about this? You're alive. That's good enough for me. It's a load off my mind.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Take this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "What is it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "It's Oripathy medicine. Here's the instructions. Follow them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Well, that's it, then. You take care.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Wait!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Hold on!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "It's my bad. I got it all wrong.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "I apologize. This is all my fault.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "I didn't mean it. I just thought that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "*Sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "A lot has happened these past few years. I've gotten a lot more suspicious.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Passerby Customer",
      "text": "Ah Hoi, a bottle for me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Right away! Three bucks, please!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Kevin puts on a tattered Industrial Arts casting glove and takes out a few bottles of light yellow soda. He tightly squeezes the glass bottles with both his hands. Before long, the surface of the bottles has begun to frost up."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "When did you learn to use Arts like this...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Remember that group of soldiers from up north?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "You mean... the Yetis?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "That's right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "After you left, I was assigned to the Airborne unit with a few other guys.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "We worked with the Yetis for a very long time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "They're the ones who taught me this. I don't have much talent for Arts. All I can do is chill a few bottles of soda.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "They were good people. FrostNova, too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "But they're all dead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "So what happened to the others...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Packy died on our way to Lungmen. You know how serious his Oripathy was.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Waltz... The Lungmen squads killed him when he tried to shield the others.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "I'm alive only because I got lucky.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "My jetpack broke down midflight. I crash-landed right in the garbage collector.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "By the time I came to, the war was over already.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You know the most pathetic part? It was the junkmen from the slums here who found me. They dug me up from the mounds of trash, and that's how I'm still here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Passerby Girl",
      "text": "Ah Hoi! A soda, please!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You got it. Three bucks.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Kevin turns around yet again and takes out a few more bottles of soda."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Take a look at the people here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "They're all normal folks. There are some Infected too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "All of them have their own lives.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "But, back then, that thought never so much as crossed my mind.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "When I took up arms, I really thought I was fighting for all the Infected out there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Looking back, I guess I was just some rioter who smashed and burned everything in my tracks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "In the end, I'm not even sure what I was doing these last couple years.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "In hindsight, I guess you were the one who really tried to figure it all out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I don't actually want to figure anything out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I'm not as ambitious as you're making me out to be.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "As long as I don't go hungry and I get a place to call home, that's good enough for me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "But charging into somebody's house, dragging them out, and then beating them up, hurting them...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I may be an Infected, but to do all that just to get by? No way, not me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I'm not one to talk about righteousness, but that just isn't right. I know it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "And that's why I left Reunion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "*Sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Anyway, I really mean it. It's a good thing you're still alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "I'm gonna get going.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You're leaving already?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yeah... I actually sneaked out of work.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "This stuff...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "How much do they cost...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Don't worry about it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "They don't actually sell them out on the market. Just take them yourself, and don't let anybody know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Right...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Hey, hold on...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "Here. Take a few of these sodas. I bottled them myself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Thanks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "This is probably gonna be the last time we get to see each other.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kevin",
      "text": "You take care.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yeah... You too.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Back already? That was quick.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yeah, I guess.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "I don't mind. You can talk to the Inspector more about it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin",
      "text": "Well, hello, Officer Kam.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Good morning... Mister Lin.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin",
      "text": "It must be tiring to be on duty so early.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin",
      "text": "Oh, you're the young man who visited Ah Hoi just now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "R-Right, that's me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin",
      "text": "I don't know what happened between you, but Ah Hoi's a good man. Try not to make things too hard for him.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Master Lin",
      "text": "Well, I'll let you return to your duties now. Please excuse me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Have a good day, Mister Lin...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Who's that old man...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Don't worry about it. Let's go.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The short Savra glances around the area one last time.\nThe scars and destruction left behind by war are slowly beginning to heal.\nAs time goes on, these traces will become a part of Lungmen, as a part of its long history.\nOn its war-torn streets, the citizens of Lungmen keep toiling away, living one day to the next."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Done already?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yep.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Don't worry. He has nothing to do with Reunion anymore.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "The Kevin of Reunion is gone. He's Ah Hoi the soda guy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Well, one less thing for me to worry about.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Kam!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Right here, Inspector Hoshiguma.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Close the file, and I'll leave the paperwork to you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "So... what's our conclusion for this case...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "He's just a normal Infected. Nothing special about him.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Anything else to keep in the files?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "No need. Let's not look for trouble.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer Kam",
      "text": "Understood... I'll get right to it.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "As for you... Here, take this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "What's is it...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "It's our file on you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "So the L.G.D. investigated me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "I may not look it, but I'm an L.G.D.'s inspector. I've got to do my job.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "To protect Lungmen's hard-earned peace, I need to investigate everything, and Rhodes Island is no exception.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "But well, this right now is a private matter. It's got nothing to do with the L.G.D., and I'll pretend the report's contents never existed in the first place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "He's Ah Hoi, a Lungmen citizen, and you're Ethan, a Rhodes Island operator.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Let's leave it at that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Thanks... Madame Oni.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Oh, and stop calling me that. It's not like we ever rubbed elbows or something.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Oh, my bad. Thank you, Officer Hoshiguma.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Uh, sorry, Inspector.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Right, do you have a way to get back to Rhodes Island?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Yeah, I'll head back with the branch office convoy next week.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Sounds good. Have a safe trip back, and tell the Doctor and Ch'en I said hello.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "No problem.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Two weeks later..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Hm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "(I'll put it here.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Midnight",
      "text": "Huh? What's this? Soda?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Midnight",
      "text": "I didn't know the cafeteria had any today.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Oh, I brought it here with me. Help yourselves.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Midnight",
      "text": "Well, don't mind if I do!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Spot",
      "text": "Maybe you should mind a little, grabbing all the freebies the first opportunity you get.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Don't worry about it. Just a gift from a friend.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "Right, it's just soda...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ethan",
      "text": "...from a friend of mine.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
