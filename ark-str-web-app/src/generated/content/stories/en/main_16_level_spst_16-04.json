{
  "server": "en",
  "storyId": "main_16_level_spst_16-04",
  "groupId": "main_16",
  "stageId": "spst_16-04",
  "title": "No Way Forward",
  "storyCode": "EG-10",
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_spst_16-04.txt",
  "sourceHash": "55dfd10e121b14b55ea03761e0030baecda334f7c29f8255c2e25716ffae63eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=1>Far North Border, Ursus</>"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "Urgh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "I can't... run... anymore...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "This is it...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "text": "Is someone there?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "text": "I'll take a look—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "text": "No, please let me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "text": "I can sense that it's only a poor soul who has suffered much.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Exhausted, dehydrated, starved...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "You're Infected too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "*cough* *cough*!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "text": "He's one of us, comrades!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "text": "Please, save him, just as you saved all of us—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "text": "Perform your miracle!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "It's not a miracle...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Oripathy is not the main reason for his pain. I can only stop his illness from tormenting him, but I cannot give him food, clean water, or a safe place to sleep.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I can't perform miracles. I'm not all-powerful. I simply... believe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pious Voice",
      "text": "You're always so humble. We understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "...Can you hear me, sir?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I'll hold your hand...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "'Believe. Believe in our life.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "'Believe in our body and mind, believe every beat of our heart, believe every inhale and exhale.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "'Believe that we are the source of all strength.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "No longer will you live in fear of death.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "The pain brought about by the rapid growth of Originium in his body begin to fade.\nHe can still hear the voices, but he is no longer writhing in pain."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "Wh-Who are you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "You saved me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "*cough* *cough*—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "What can I do to repay you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "You can call me Hierda, like everyone else here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "text": "A miracle—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "text": "Hierda has once again saved our comrade!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "text": "She saved all of us! With her motherly caress, she takes away our pain!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "text": "Hierda!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pious Voice",
      "text": "Hierda.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Many Voices",
      "text": "Hierda!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "Hierda... Hierda.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "text": "Yes, that is my name.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "What do you look like? I can't see you clearly, or any of the others...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "text": "Your head is wounded. Did you fall and hurt yourself?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "text": "Maybe a mild brain hemorrhage is affecting your vision. Don't worry, we can help you walk...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "text": "Where are you going?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "text": "I don't know...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "text": "Then come with us, for now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pious Voice",
      "text": "You're taking us to a place without pain, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "text": "Yes, as long as you're willing to come with me...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "text": "As long as we believe.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
