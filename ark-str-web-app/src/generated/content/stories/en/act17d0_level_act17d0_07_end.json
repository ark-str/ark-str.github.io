{
  "server": "en",
  "storyId": "act17d0_level_act17d0_07_end",
  "groupId": "act17d0",
  "stageId": "act17d0_07",
  "title": "Bunker Defense Line",
  "storyCode": "OD-7",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act17d0/level_act17d0_07_end.txt",
  "sourceHash": "3f1064983499af45c607d63d0da2d6396faf157067be1ce3cebe2bb6f9eeb8b6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Away with you!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "This is endless!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "How many of these *profanity* things did they make?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Liskarm! Look out behind you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Originiutant",
      "text": "Gaa...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "! !",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Watch out!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Franka!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "What are you doing?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Give me a hand, Miss Lord!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "Oh, okay!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "You... run!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Don't speak!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "My leg...You... just leave me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Cut the bullshit!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Piggyback, quick!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Picale",
      "text": "They're coming back!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Now! Get out of here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Over here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Mr. Occphen! What are you doing here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "How could I just wait around down there? I'm a Rhodes Island Operator too!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Damn straight! You really saved us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Get ready to blow the engine...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Three, two, one...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "What's the situation?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "They've been pushed back, for now. But they'll come for us again before long.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "There... seems to be less of them?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "I'm all out of 'welcome mats.' Ammo's gone too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "What's the plan, Alexsandr?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Get to the shelter.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Get to the shelter! Take the Rhodes Island Operators and get to shelter!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "What about you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I'll cover you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Cover? And who's covering you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I don't need cover.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Hey! Get it together! Alexsandr!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I'm all together.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I'm tired of all the hiding and running.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Running can't win you the war. History's shown.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "But this isn't a war.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "It is to me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "When they pull weapons on the Infected and try to kill my friends, it's a war.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I've been through plenty of wars in my time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "If I can kill even one more *profanity* monster here, it'll give the townsfolk a better shot at survival.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I'll make my stand here until I run out of ammo. Until the very end.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "The battle's not over. How could I retreat?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "You're the one who says not to play hero!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I don't think I'm playing hero, Tina.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I'm just doing the right thing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "No matter what happens, the show ends here, today.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Alexsandr! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I'm staying too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "But why...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "It was always going to turn out like this. We all knew it, from the moment you decided to stay and fight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I'll stay behind and help the warrior hold them back. And if things go bad, I'll cover his retreat.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Mr. Rangers...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Alexsandr, take this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "What's this?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "An Originium bomb I tried my hand at making. There's only two left.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "...Thanks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Stay alive!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "...No promises.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "You didn't tell her the truth. You're not going to run.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Hahaha... You didn't have to go blowing this old man's scheme.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "You need someone to hold these monsters back.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "This is...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "The old Lord's blade. I borrowed it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "This is a fine blade. The old Lord had good taste.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Beautifully decorated steel, and a hand-lain turquoise handle that's as nice as any modern industrially-manufactured weapon.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "It's a lot safer to stand in the back with a bow and arrow than fighting on the front line.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I'm so much older and slower than I was.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "But the blade, she's as sharp as ever.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I still don't know your name, warrior.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Alexsandr Senaviev.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "You can call me Alexsandr.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I should tell you my name too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "But the sands buried my name the day we stained the valley red with blood, along with the past.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "It's fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "You decided to stay and fight. That's what matters.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "'Rangers'.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "'They told me I'd died. They were wrong. I was reborn. '",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "No matter how many of those monsters there are.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Let them come.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
