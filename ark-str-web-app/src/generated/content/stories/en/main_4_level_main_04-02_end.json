{
  "server": "en",
  "storyId": "main_4_level_main_04-02_end",
  "groupId": "main_4",
  "stageId": "main_04-02",
  "title": "A Walk in the Rain",
  "storyCode": "4-2",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-02_end.txt",
  "sourceHash": "538affa3b62933b883ef82ec86ce7ee2a044ec68aef934e255f85fb6778790b0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Ahh...! Look out!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Ouch!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "S-sorry, I didn't mean to run into you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Don't worry about it. You're very polite.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Ehehe...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Um, ma'am, what are you doing here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "It's still raining. You're not going to go inside?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Ah, um... I'm just... taking a walk.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Are you looking for help?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Oh! How'd you know?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I can't tell you~ It's a secret.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Aw... it's fine though!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Ma'am, do you think...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Hmm... that probably won't work. You're a bit too short...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Hey, you shouldn't say stuff like that! You're shorter than me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Whoa!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "W-well, we could try... Um, could you help me move that board? Let's do it together!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "There's a record player under that metal rack. I want to take it back home.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Sure.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "1... 2... 3! Together!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We did it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Woah, you're really strong, ma'am! Thank you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "But... this record player is broken.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "It's okay! It's always been broken.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "But one day, I'll be able to fix it. I collected a lot of records, but I've never listened to them before...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "...But one day, I'll play them for everyone!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Such a difficult thing, said so casually...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...What am I doing this for... What can I even do...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Ma'am, you're not scared of me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Scared of what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "I'm an Infected!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Haha... I am too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "What?! That's such a pity. You're so pretty, too...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "There's nothing wrong with being an Infected. Whether you are healthy or infected...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "If you're a good person, that will never change.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Huh...? I don't get it...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "(Grrrrrr...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Are you hungry?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "...Mmhm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Here, take this. It's all I have.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Wow! Thank you, ma'am!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "But... why did you come here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's because...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's because I made a promise to someone.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Bye bye, ma'am!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Sure, bye bye!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Even a child like that... In the end, will just...",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "Those who were robbed of their identity. The Infected. You've long lost the right to call yourselves people."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What can I accomplish? What more... can I do...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Why... can I not protect those around me...",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "You cannot."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No... I...",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "Famine... Persecution... Death...\nThese are the only things awaiting the Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No, that's not true...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "As long as Rhodes Island is fighting for the Infected...",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "You are but one of the few lucky ones."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No... We've all come together to fight towards a common goal.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "This world has already become cold and callous."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No, not yet...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The Infected can't succumb to despair just yet...",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "You.\nAllow the rage to consume you.\nOnly then..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No... I won't...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I made a promise...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I made a promise to her...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Who's that...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "A big sister once told me that these dolls won't work unless you make them yourself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "So that's why I'm giving this to you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Another Girl's Voice",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That voice just now...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That silhouette...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Is that Madam Ch'en?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "------",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "------------",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "------!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Another Girl's Voice",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Madam Ch'en...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "... ...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Madam Ch'en, what are you doing here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I thought you were...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "None of your concern.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "This is Lungmen's business, and I will take care of it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Madam Ch'en...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "This is the first time...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I've seen that look in her eyes...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
