{
  "server": "en",
  "storyId": "main_1_level_main_01-07_beg",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "The Tyrant",
  "storyCode": "1-7",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_01-07_beg.txt",
  "sourceHash": "2b0b203a73452e2f441a5748e819e94098aae43aab2a0ab1c0a1ce9642413c7f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Prepare for impact!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Spread out—!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "There's too much coming... at this rate, every single building in this city is going to be destroyed!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "This is looking bad...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "We have to relocate!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Hold on!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Aaaaagh!! It's falling... It's falling!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "The sky is crashing down!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Aghhhh! It hurtsss...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "My hand... my hand! Where's my hand...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "No, no way!! I don't want to die...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Aaaaaaaghh!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "Defenders!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "Protect our Casters! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "...!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "What's that sound?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "A massive cluster just toppled the building across the street from us! Get down! !",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "Eeek...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "... Don't stand there... Medic! Watch out!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Oh no... Medic, get out of there!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "text": "Aaaahh!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "text": "...Huh, D-Doctor?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "The Doctor pushed the medic out of the way? Wouldn't that mean... Doctor...?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "No, Doctor!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "Dr. {@nickname}!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "Huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "N-Nearl's charging forward!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "Get down, Doctor!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "Aagh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "She made it in time!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "She did it... She saved the Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "*cough*... Haah...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Nearl! Doctor! Hurry back over here!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "It's fine now!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "I can still hold my shield...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "Jump, Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "Jump!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor, Doctor...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "You're, you're not hurt?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "I'm fine... It's no big deal.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Thanks for saving me, Nearl.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "How could you... put yourself in danger like that!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "At least take me with you, so I can protect you!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "I can't allow you to be harmed...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "Especially, right before my eyes!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "We should count ourselves lucky that everyone is still safe...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "(How much longer is this going to last?)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "(How long are we going to be able to stay alive?)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "... Hm...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Are fewer rocks falling now?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "So we managed to weather the first impact...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "But we have to be careful still. Nobody knows how long this Catastrophe will continue for.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "At least... we weren't caught dead in the middle of it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "We were lucky to slip through.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Mmhm...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "How's everyone doing?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "Looks like all of the Operators made it through just fine...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "Some were lightly injured, but considering the circumstances, we were quite fortunate!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "text": "We... we made it!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Ugh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Some of the Reunion members have also...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "...Huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Huh... Ahh! ! Rhodes Island!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "...What?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Arghh...!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "They're still trying to attack us?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Rhodes Island!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "What's wrong with you bunch!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Come back here...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "They've gone insane.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "text": "Do they not value their lives at all?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Dobermann...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "We have no choice...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "We'll suppress them first, and then immediately relocate!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
