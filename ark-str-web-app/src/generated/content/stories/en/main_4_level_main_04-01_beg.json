{
  "server": "en",
  "storyId": "main_4_level_main_04-01_beg",
  "groupId": "main_4",
  "stageId": "main_04-01",
  "title": "Consolation",
  "storyCode": "4-1",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-01_beg.txt",
  "sourceHash": "f621cca8a5edb6eb24ba021198f6a38c8cccb37c6e7e7baad9792eb46eab7b4e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十一关（前）\n8:36 P.M. \\ Rainy \\ Visibility: 12 km\nRhodes Island"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Welcome back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Mm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "I already heard what happened from the recon squad.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Amiya, let me check your hands.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "There's no need for that, Dr. Kal'tsit...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Amiya.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I, I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...All right.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "It looks fine. The rings haven't cracked or discolored.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "But it might be different next time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Listen closely, Amiya...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Be a little more careful.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Dr. Kal'tsit, I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...I need some rest.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Go ahead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Mm...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Never put Amiya in this much risk again.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "You are also responsible for what happened.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "When you first came back to Rhodes Island, she looked a bit like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "These emotions never really left Amiya.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "This has to change.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "...Dr. {@nickname}, you should stay with her.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Don't mess up.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "*knock* *knock*",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "It's open.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Dr. {@nickname}...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Worried? I am?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...You saw right through me, hehe...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I thought I did a good job hiding it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Yes, I'm a bit worried... just a little, though.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I'm already used to doing this.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "After all, I can't drag down everyone else any more.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Right, Doctor?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...I don't understand.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor... I don't understand.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "(Stay silent)",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "No, I... I know what we're trying to do. I also know... that some sacrifices are inevitable.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But I... what I don't know is...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Why must I watch people disappear before my eyes one by one... even though they can be saved?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "We were so close... Maybe just a little bit more...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I know that I have a duty... and I will continue to move forward...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But right now... I just feel so tired.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "...",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Amiya...",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Please let me have some time alone, Dr. {@nickname}.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Thank you.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Good morning, Dr. {@nickname}.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Oh, Dr. Kal'tsit, you're here as well?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Amiya.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "I have a rather urgent mission here, and need some people to help out.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "An abandoned city was discovered not far from Lungmen.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "I surmise that it's one of the cities that formed in the aftermath of the Chernobog incident.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "We'll have to explore that city, uncover more information, and search for any survivors.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "If the situation is particularly serious, for example, if Reunion is hiding there, then there may be serious ramifications on our future operations.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Here's the specific proposal that I have in mind. Look over it when you have time.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Understood.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Oh, one more thing.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Franka submitted a report to me mentioning that they had to return to Blacksteel.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "As for the situation in the Lungmen slums, Penguin Logistics requested for you to meet them there to discuss some information.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "There are some more sensitive details, so it'd be best for you to go in person.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I know. I'll head over right now.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor, let's go--",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "I still have some things to discuss with Dr. {@nickname}.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "May I listen in?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "You may not.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I can cover my ears...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "You cannot. You should get going.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Aww...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Dr. Kal'tsit, you're not allowed to bully Dr. {@nickname}.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "I won't.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "...You...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "You couldn't even do something so basic.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Forget it, I had a feeling this would happen.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Amiya is an incredibly resilient kid.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "But, if she has to force herself to be strong, there will come a day when the pressure breaks her.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Do not let this happen.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "If there is a next time, you'd better be a little more useful.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "--?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "What's with that face?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Excuse me, but what do you mean by Amiya's rings...?",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "text": "It's related to the state of her health.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "text": "If Amiya is involved in an intense battle...",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "text": "...You must check her rings immediately afterwards.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "text": "No matter what changes you see, you must report them to me.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "text": "For the time being, that's all you're allowed to know.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "text": "Oh, right. You have to go down to the medical center in two days to have a physical done. Don't forget it.",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "text": "...You can go. Liskarm is waiting outside to escort you.",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
