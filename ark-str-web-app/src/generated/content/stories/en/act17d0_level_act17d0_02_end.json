{
  "server": "en",
  "storyId": "act17d0_level_act17d0_02_end",
  "groupId": "act17d0",
  "stageId": "act17d0_02",
  "title": "Defensive Range Expansion",
  "storyCode": "OD-2",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act17d0/level_act17d0_02_end.txt",
  "sourceHash": "e99735038a8a1ffd2e4531cb6e3d174ab58c615c5e6b4dab795127dc48214fb1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Cease fire! Watch out for civilians!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "They're getting away, Cohen!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Don't bother with them, protect the others!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Someone come here, there are injured people here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Let's bring them inside.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Doctor! Are you ok?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "I'm here! I'm fine!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Townsfolk",
      "text": "My leg! My leg is broken! My leg! ......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Calm down, your leg is still here, it's just dislocated. Grit your teeth.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Girl",
      "text": "Mama... Mamaaa...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Has anyone seen Algar's mother?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Wounded Townsfolk",
      "text": "Help me......please......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "We're running out of bandages......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Those... (profanity)!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Is there a fire over there?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Isn't the town center in that direction?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Looks like this isn't the only place that was attacked.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Why? Where did the lord's guards go?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Don't care about those guards or whatever anymore.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "There are sounds of fighting everywhere now, and it's only getting worse. We can't stay here, it's too wide open.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Let's move those wounded behind this building for now!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Townsfolk",
      "text": "Monsters! The monsters have come again!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Woman",
      "text": "Help!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "This is endless!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Alexsandr! Get on the roof and cover us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "There's no time, doctor. We need to leave this place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "But, where can we go?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Let's go to your clinic.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "These Infected......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Don't worry too much about it, let's get everyone to go to your clinic first.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "......Alright.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Someone lend a hand! He can't walk anymore!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Kötz, can you go and check if there's anyone else hiding in these houses? Let's get everyone here to the clinic.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Stay safe!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "......This is really a disaster.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Forty plus people......Is everyone here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Yes......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Everyone we've rescued......is here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "How many are we missing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Quite a number, maybe they went to the other side of the town.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "But some old ones......they didn't make it......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Don't beat yourself up, it's not your fault.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "These monsters, where are they from? Are they trained beasts?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "I don't know......I've never seen anything like them before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "When those thugs drew their weapons, these monsters began burrowing out of the ground.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Who cares where they came from. How can there be so many of them?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "How's the surrounding situation?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "A big mess.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "There's sounds of combat from the other side of the town. I don't know what happened there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "How much ammo do we have left?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Not much, I only have four magazines left. If Alexsandr runs out of ammo then we're in big trouble.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Ammo isn't the biggest problem right now. This house isn't going to last much longer.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Judging by those monsters' size, if we let even one or two escape, they will definitely smash through this wall and it'll be impossible to stop them then. We need a plan.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Doctor, how are the patients doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Many of them are wounded, I'm only able to do some simple treatment.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "We're lacking bandages and disinfectants.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Is there any way to leave the town for now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Where would we go after leaving town? While bringing so many with us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Without food and water, going onto the wasteland means certain death.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "I don't think these monsters will give up on attacking us. If we get to the wastelands, we'll just be in a worse position without any cover or means of hiding ourselves. Besides, we've all witnessed their burrowing abilities......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "I know a place......It might be safe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "There's a special building at the south side of town. It might be the safest place in town, barring the lord's residence.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Do elaborate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "There was this medical organization called Rhodes Island which rented a piece of land at the edge of town.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Later they hired workers to dig a fair amount of soil and stone and built a very solid house there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "......It could be the strongest building around here? It looks just like a fortress.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "How do you know that this 'Rhodes Island' would be willing to help us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "There's only one watchman at that building, and I know him. I've purchased some medical supplies from him before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "There's a lot of soil, most likely they dug out a basement.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Sounds like a safe house used by mercenaries.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Doesn't sound reliable.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Unless we have a better option, I suggest we take a look.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Without food nor water, staying in this place is no different than waiting for death.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "That building is at the edge of town. We can head over from outside town to avoid being seen by others.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "......Hmm......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Kötz, is your shield still usable?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Half of it. I can use it to bash someone......probably.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "I need someone to go with me, to help protect the doctor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "I'll go. Worse comes to worst I can always shield the doctor with my body.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Don't talk crap.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Kötz and I will go with the doctor to check out that 'safe house.' Tina, you stay here with Alexsandr.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Doctor, no matter what happens next, please follow my orders.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Kötz, protect the doctor well.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "I'll keep him safe.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "I don't see any lights, is there no one there?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Keep your distance. This building's door has been smashed.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Even here......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "What are these thugs' goals? To rob and plunder like common bandits?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "H......help......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Help! Anyone! Help me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "I......I don't want to die......Damn it......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "It's the watchman!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Don't move and stay here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "I'll go have a look.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "......If only I didn't take this job......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "I don't want to die here......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Who are you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Don't move, your leg's broken.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "M......mercenaries......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Don't kill me! I beg you! Don't kill me! I really don't know where the key is! I'm just a simple watchman!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Please believe me! I really don't know!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Calm down! I'm here to help.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "You......you're not together with those guys......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Help me! Help me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "I! Said! Calm down!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Kötz! Bring the doctor!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Mister Occphen, your leg......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "You......you're that Infected doctor!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Oh, thank heavens!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Don't worry, let me look at your leg.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Man, this place has been turned upside down.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "The inside looks a lot smaller than the outside.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Secret doors, hidden rooms and fortified walls. Aren't all safe houses like that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "What's this?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Radio equipment? It's completely destroyed though.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Such a large machine, looks very retro. Turns out this world also had communications equipment like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "They even have cars after all, it's not strange for them to have radio.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "There were other 'broken electronics' back at the run-down house we stayed at before, like the fridge, fans, a kettle......Though none of them actually used electricity.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Just like this wireless radio, and that car we got.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "All these machines have a device filled with black crystals. I suppose that is the energy source for these devices.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Ouch ouch ouch! Please be gentler, doctor!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Please bear with it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "......Luckily it's not very serious, the bone isn't broken.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "You're the person in charge of this place?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "This is......Rhodes Island's branch office. I'm actually just a simple watchman.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Let me guess, those thugs came here and forced you to open the basement door, but you persisted in your duty and kept playing dumb, which resulted in you getting beaten up and left here to die?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "......Something like that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Wait, how did you know there's a basement?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "You've been tricked. We're actually the thugs' backup, here to get you to confess everything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "What? ?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Kötz!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Don't get angry, I'm just trying to liven up the atmosphere.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "You......What are you actually planning to do?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Don't worry, they're good people. They've been protecting the inhabitants of the infected zone all this while.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "The infected zone was attacked as well? ?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "This......It's messed up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "What about the lord's soldiers? Where are Lord Tulla's soldiers?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "The lord's soldiers still haven't appeared. They might be in trouble as well.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Mister Watchman, we need your help.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "But, what can I do to help? I can't even stand up right now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "The Infected townsfolk have also been attacked, with many of them being injured and the buildings of the infected zone suffering heavy damages.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "We need you to open up the safe house and let them hide in here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "That...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "In return, we will guarantee your safety. You can trust us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "But, but I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Based on the contract I signed with Rhodes Island, the entire safe house is the property of Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "......I don't have the authority......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "......Ugh......Infected......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "text": "Alright, let them come. Losing my job is better than losing my life.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "text": "Thank you!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
