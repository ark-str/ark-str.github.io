{
  "server": "en",
  "storyId": "main_3_level_main_03-05_end",
  "groupId": "main_3",
  "stageId": "main_03-05",
  "title": "Call",
  "storyCode": "3-5",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_03-05_end.txt",
  "sourceHash": "f16b1b6c0a4235f78977c17cc3092f508a5b81cd3a691770ddd9acdeca234397",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Fall back! Everyone, regroup!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Let them go!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The enemy is going to cut off our squads at this rate!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We can't afford to let that happen, in case more reinforcements show up...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "These Reunion forces... are not targeting us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Our top priority is to keep our operators safe!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Snipers, stop attacking the fleeing Reunion forces!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Focus on helping Madam Hoshiguma first!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "So annoying!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Not bad, not bad. You actually managed to soak up all my attacks~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "But, how much more can you take?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "That depends on how long you can survive!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "---Ch'en! Hurry up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Surround that woman!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Ohhh, did L.G.D. come to play?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Lower your weapons!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "We meet again, Madam~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "You won't talk your way out of this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "All that you've done to Lungmen... I'll do to you twice over.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Oh my, how scary~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "But I'm not here to play with you today.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Amiya, catch~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Me? This is... some kind of phone?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "That's right. Someone wants to talk to you~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Anyway, that concludes my mission.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Before I forget, I have something for you as well, Madam.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "See you later~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Watch out!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...A short-range bomb...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No, it's a flashbang!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Don't let her trick you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...It's too late.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "She already got away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "She sure got out of there fast. All she needed was a momentary distraction to slip through our defenses.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Also, you should be careful of that thing you're holding. If it's another bomb...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "This... seems like a regular cellphone...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Except... could it be...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Hello?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Is that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Amiya...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Misha! Tell me, where are you?! I'm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Amiya...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Girl's Voice",
      "text": "...Prioritize... treating the heavily injured!! We need a blood transfusion here!! Hurry!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Man's Voice",
      "text": "...Damn it... Why... Even though we're all Infected...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Man's Voice",
      "text": "Rhodes Island... why would they do this to us...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Girl's Voice",
      "text": "...We were always abandoned from the very beginning!! We have no escape... nothing at all...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Boy's Voice",
      "text": "Don't die! Don't leave me!! We promised... We promised to go home together...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Girl's Voice",
      "text": "*sobbing*... Brother... please don't...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Do you hear their voices...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Reunion's... Infected?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I remember now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "No, I never forgot. I just... didn't want to remember...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "That's right. It was Reunion that destroyed my home. My father also...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "But... we brought it upon ourselves.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "That year, I watched my younger brother, dragged away before my own eyes... He called out for me, crying my name, but I turned away...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...and hid inside my room.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "When he found me again... He had sacrificed so many things.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Even though he still loved me, I was afraid, and I ran away...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "But I now understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Everything that he has done... was just to give the oppressors a taste of the suffering that the Infected go through every day.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "And now, I am one of them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...It is time for me to atone for my sins.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Misha, don't be rash!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No matter how you treated the Infected in the past, you can always change--",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "It's no use.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "What can I change?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Because I... was one of those who turned a blind eye...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "After becoming an Infected, I finally... can see it clearly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "The way normal people treated the Infected... is how the Infected would treat normal people.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Because they deserve it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "All of this... Is nothing more than the weeds of evil that have sprouted from the seeds of cruelty I planted...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "This torment is my karmic justice.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "But, why... Why?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Why did that happen to him, even though he had done nothing wrong?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "All he was guilty of was suddenly coming down with the infection...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "He was so young... He had only started asking for me to help with his homework!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "If only I... If only I had protected him back then...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Misha! Please calm down!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "You didn't hurt any innocents! None of this was your fault!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "From the very beginning, who's innocent?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "The only thing that's wrong... is this label that the Infected have been given...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "If this is a cycle of revenge against each other... Then tell me, who was the one who set this tragedy in motion...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "If Ursus had never treated the Infected like monsters...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...then what reason would anyone have to hate Ursus so much?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Who ordained that the Infected must suffer like this?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Misha...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Skullshatterer is dead. You can come back to us now. I promise, we'll...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Amiya... I've already found my answer...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I am an Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I stand on the side of the Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Don't...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "That's right, Amiya. You're also an Infected...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "So you should be able to understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That's right. I'm just like you... just like everyone in Rhodes Island. We all understand how you feel...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "But, Misha, even if you accept your identity, that won't change who you are!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Please wait for me! I'm coming to find you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Don't come.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Misha! Where are you--",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "You're right, Amiya. You're absolutely right... I was just feeling guilty. Guilty... because I was too weak.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "But I've made up my mind.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Even if it's only a single step... it is a step that I must take.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "I'm sorry, Amiya. I'm so sorry...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "To be an Infected... is to be a part of Reunion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "That is all we are, after all...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Goodbye...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Misha? Misha?! Misha!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
