{
  "server": "en",
  "storyId": "main_4_level_main_04-09_beg",
  "groupId": "main_4",
  "stageId": "main_04-09",
  "title": "Bad to the Bone",
  "storyCode": "4-9",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-09_beg.txt",
