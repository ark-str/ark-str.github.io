{
  "server": "en",
  "storyId": "main_16_level_spst_16-03",
  "groupId": "main_16",
  "stageId": "spst_16-03",
  "title": "Homecoming",
  "storyCode": "EG-9",
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_spst_16-03.txt",
  "sourceHash": "5e13cb66f78161e5df28583f744df1b79b259650a43550ef9e2588ce6be1626c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "'All units, this is Dispatch.'\n'All units, cease fire immediately. We have an urgent request from Deity Grypherburg.'\n'Repeat, all units, cease fire immediately.'\n'Please acknowledge.'"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "(Exhales)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Scope of the ceasefire?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Radioman",
      "text": "All active units.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "(Nods)",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "'Acknowledged.'"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Inform Lieutenant Yelchin and ensure that all units in the 2nd Division observe the ceasefire.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "'All units remain on standby. Maintain battle stations.'\n'Until the threat is completely eliminated, we shall continue to serve our duty to protect Deity Grypherburg and the people.'"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "...Summon the quartermaster.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soldier",
      "text": "Sir, we do not have a quartermaster for this operation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soldier",
      "text": "You expected this to be only a quick response, and that it would not take much time to eliminate the rebellious Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Respond to Dispatch as usual.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "And what is your name, soldier?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Soldier",
      "text": "Private Vyacheslav Kinov, sir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Very well. Inform the Lieutenant, Private Kinov. Your services are not needed here for now.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "...You had me leave my post to come to you for this little thing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "You're out of your mind.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "Oh, look at you, Patya, all high and mighty in that Shieldguard armor...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "Does that pretty helmet of yours block your sight?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "The maggots in the rations, bolts that snap like twigs, even duds!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "Is this what they send us out to die with?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "If there are maggots in your rations, you eat them with the rations. If the weapons are hard to use, use your bare hands.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "We're soldiers. We fight and win. There are only two ends: Keep fighting, or die.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "You're the one who's out of his mind!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "If you find that someone hasn't been doing his job, you report to your superior, not complain to me here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "I'm not the quartermaster—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "I thought the Defender Regiments were supposed to be on the top deck.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "...Sorry, sir. I was away from my post.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "I will report this to the commissar myself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Cold Soldier",
      "text": "(Salutes)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "S-Sir!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "What did you find out, soldier?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Tell me the reason for your anger.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "...The quality of our supplies and equipment on this operation is exceedingly poor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "The rations are insufficient, the cans damaged and filled with maggots...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "Many of the bolts were not made of steel, but crude iron.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "And the reserve Originium bombs are so weak that they're little more than glorified duds.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "How are we supposed to proceed the operation with these?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Why did you enlist, soldier?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "To...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Speak up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "To—to prove myself! I want people to know my name—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "Like they know yours!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "They'll know your name when the Army sends your tags back to your mother, and she etches them on a white birch tree.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Angry Soldier",
      "text": "No, not like that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "There is little room for the individual to choose, when the collective is at war.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "But...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Keep this hope in your heart, boy, and your 'discovery' too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "For the survival of Ursus and her people, there is only one option...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Officer",
      "text": "Set this land on fire.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
