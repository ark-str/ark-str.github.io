  "blocks": [
    {
      "type": "narration",
      "text": "sqrrel"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Huff... phew...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "It'sokay... Everything'sfine... Calmdown... I'mnotnervous atall... Phew...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "It's no goooood! WhatdoIdo? Tomorrow's thesecondlecture!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ugh, mychesthurts. Ican'tbreathe... ughh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "...Huff...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "GuessI'm waytoonervous still.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ican'tgetmydraftfixed. G-Gottamakeitsimple andeasytounderstand. Alsogotta becareful thateachsentence isn'tmorethan twentywordslong. Notlikelasttime.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Also... HowfastItalk... But... uh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "That'snotsomethingIcancontrol.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "*Sigh*...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Whoa! Oh... thealarm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ohnolookatthetime.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Istillhaven'tfinished checkingmyequipment fortheday, andIstill haven'tputmyreporttogether. Ican'tdothisanymore. Ican'tkeep neglectingmyduties!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Gottagetittogether...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "You know, you can go apologize any time. Why do I have to go with you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Don't tell me you're shy. Please, I've had enough of your jokes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Huh? Apologize? Me? I... Ugh, this sucks. Anyway, that's not what's happening!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Then let go of me. Stop pulling.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "No way! Dammit! If it wasn't for Silence and the Doctor's complaining, I wouldn't be wasting my time with all this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "I was just trying to get a barbecue going. It wasn't supposed to turn out like that... Urgh, this is bullshit. The notes I borrowed from Ice Cube are all wet...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "So you are actually trying to study?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "W-What're you giggling for? I'm allowed to study! Besides, you were there setting everything on fire with me just the same. Why aren't they giving you an earful?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Don't you lump me in with you... That was an accident! I didn't think I'd lose control all of a sudden!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Like I care—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hey, keep your voice down! There she is...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "You keep YOUR voice down!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Hmm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "It'swellventilatedhere, theemergencyexit's notblocked, theemergencylight's working, andall firesuppressionequipment's functioningproperly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Okay, noprobleminthiscorridor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Nextup'sthelivingarea, themedicalarea, andthedeck.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Phew, lookslikeIcan finishcheckingeverything beforedinner. Afterthat, Igot thisseason's fireriskanalysis tofinish, andIgotta handoutbrochures...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hey...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ohno! Notenoughtime! WhatdoIdo? I'mnotdonewith tomorrow'slectureeither. I'msogonnamessupagain... *Sigh*.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hey, I'm talking to you! What are you ignoring me for?! That's rude!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "You're a fine one to talk, Ifrit...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Eh? What? I'mhere!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Oh, it'sIfritandSkyfire. Sorry, Iwasjustthinkingaboutwork, soIwasn'tpayingattention.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Doyouneedmeforsomething?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Uh! Ohno! Didyousetsomething onfireagain?! That'sweird. Ididn't hearanyalarms.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "T-T-Thisisbad. Wegottahurry—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Wait, no, calm down already. There's no fire!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hey, I'm telling you, stop...! Why are you running? There's no fire!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Huh? Oh, there'snofire?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Thankgoodness...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Why did you assume there was a fire as soon as you saw us?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Youtwoarealwaysthere wheneverthere'safire...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Oh, I-I'msorry! That'snotwhatI'mtryingtosay!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "And just what are you trying to say?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "How are you not done with this dumb back-and-forth yet?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hey, shorty. What are you up to? What's the rush?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Shorty?! MycodenameisShaw. Pleasecallme bymycodename!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Okay, fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "So what are you doing? What's with all the papers? It's all packed with words... and why are these crossed out?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Oh, these? They'retheinspectionsheets foreachsection oftheship... EverythingIcrossedoff hasbeeninspected. Everything'sfinethere.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Huh? You gotta check every last one of these places?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "That'sright. Everylastone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Damn, sounds like such a pain. And you got so many of these forms.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ofcourse! That'smyjob!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "You've got quite a few of these too. A tough job indeed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Ohh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hey, what about this? What's this stack?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Hey! Stopit, don'tmessthatup! That'sa reportIgottagiveto ClosureandtheDoctor! Ihaven'tfinishedwritingityet...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Don't you get tired working like this every day?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "I couldn't stick with it. All the inspections, all the reports. That sounds so boring. Isn't there something... you know... cooler?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Like, say... uh... I guess you look kinda cool when you use that fire extinguisher. Got me all wet last time, though.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "(That's a rather roundabout way to compliment someone... Don't tell me she believes this makes for an apology!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "(It doesn't work at all!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "It'swork. It'snotsomething youshouldbeselfishabout!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Hm, but...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Personallyspeaking, IguessIcan'tblameyou forthinkingthisway.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Right? Right?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Butthefactis puttingoutfires isonlyatinyfraction oftheworkwedo. Mostofthetime, wehelpfindmissingitems ordoinspectionwork...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "It'sboringandtedious.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Firepreventionisn't allthatfun tolearnabout, andnobodylikesit whenwekeepmaking apointoutofit. Alsowehavesomeregulations thatweremade outofsafetyconcerns, butIknowthey canbeabittoomuch forday-to-daylife.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "LasttimeIgavealecture atthelocalprimaryschool, andthekidsthere weren'tinterestedinlisteningto whatIhadtosay. Theyallranaway beforeIevengot halfwaythrough...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "AndI... IknowI'mnot thebestatspeaking...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Oh, ohh... So you do know that, huh...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "—Thatsaid!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Whoa! W-Why'd you raise your voice?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "That said... what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Evenhelping acitizentakethering offherfingerwhen itgetsstuck ismeaningfulwork, andsomeone'sgotta doit.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "I... It'sbeenafewyears sinceIjoinedthe firedepartment. I'mnorookieanymore!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ofcourse, Igettiredof doingthesamework overandovertoo.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Thisismyjob, though.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Itwasmydreamtobecomeafirefighter eversinceIwasakid...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Thisismyjobandmydecision, andIwillberesponsible forbothofthem!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "So you are the one responsible for this operation?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Y-Yes, sir... Chief!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "U-Uhh, Imean... It'sanhonortomeetyou, Chief!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Relax. There is no need to be so tense.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "It's all thanks to you and everyone else at the fire department that there were no causalities in this rescue operation. On behalf of all of Lungmen, please accept my thanks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Is there anything you want for your reward? Money, an extended holiday? You deserve it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Th-Thanksalot, Chief!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "MayImakearequestformyreward?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Go ahead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Iwouldliketoholdalarge-scale publicinformation campaignonfiresafety withtheL.G.D.!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ifatallpossible, Iwouldalsolike anincreasein firesafetyinformationsessions atschoolsacross alldistricts...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ibelieve furthereducationin firesafety canhelplower fireoccurrences aswellasinjuries, deaths, andpropertyloss! P-Pleasegivethissomethought!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Hmm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Very well, I'll agree to this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Really?! Awesome!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "However, I also expect to see an acceptably feasible proposal for an information campaign of this scale.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "And since you requested it, it falls on you to put together this proposal. If you want to see it happen soon, I'm afraid you won't be getting any of that vacation time for your reward.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Thankyou, Chief! Youcancountonme!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "I took a quick glance at your file and work logs before our meeting.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Your performance in school was impeccable, and I'm confident you could find yourself a much better line of work, if you wished.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "As for your current job, it seems you are unparalleled in the field. Your logs show that, up until today, you've been volunteering your own time to patrol on the weekends for the past two months?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Yes...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "I have a question.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ofcourse, Chief! Please, askaway!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Relax, this is nothing formal. If you would prefer not to answer, you have the right. This is just my own personal curiosity asking.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "What drives you to go so far?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Thisis... well...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ijustthinkthat... everythingthatIdo isworthdoing...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Oh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "WhenIwasakid, therewasastorenotfaraway frommyschool. Ilovedthatplace. WheneverIdidsomethingright, myparentswould takemethere tobuysomenuts asareward.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "AndI'dtaketherewardstickers Iearnfromclassand stickthemonthewallthere. Whenmyrewardboard wasfullofstickers, theoldmanatthestore wouldgiveme asmallbagofnuts.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Thenutsthere weresotastyandcrunchy. Evennow, Idon'tthinkI'veever hadanythingtastierthanthosenuts.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "But... Therewasafire oneday.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Itwasn'tahugefire, ithappenedatnight, probablybecausethewiring wasagingindisrepair.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Theshopowner wasn'tthereatnight, sonoonewashurt, buteverything wasgone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Alltheprettynuts ontheshop'sdisplaywindow... mystickers... allofit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Theownertoldeveryone itwasablessing noonewashurt, andthatitcould've beenalotworse.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Butthen... WhenIwenttocheckonhimlater... Ifoundhimcryinghiseyesout...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Idon'twannasee anyonelosewhat's precioustothemanymore.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "This must be gruesome work to do day after day.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Notatall, Chief!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "This isn't an official inquiry. You may answer honestly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Totellthetruth, Chief... Itdoes... feelalittletoughsometimes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Can you bear with it and remain steadfast to your position?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Yes, Ican!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "It'sexhaustingsometimes, but... Icandoit!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Very good...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Lungmen is lucky to have a young woman like you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "Now put your proposal together. I will arrange for a liaison to reach out. If you are going to do it, then give it your best effort... Do not come to regret your decision!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Of course!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wei Yenwu",
      "text": "I thank all of you, for all that you have done for Lungmen.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Mostofthetime, withtherightprecautions, firedanger canactually beavoided.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Aslongaswekeepup safetyinspections... andaslongas everyoneknows theirsafetypreceautions and whattolookoutfor, wecanactually keepfiredamage toaminimum!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "That's true. For example, never set up a charcoal barbecue grill indoors...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Oh, shut up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Neverbarbecueindoors!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Also, ifyourequipment's wornout, butitgoesunnoticed duringinspections andnevergetsreplaced, thenyoumight findyourselfunable touseitwhenyou needitthemost, andwhatcould've beenaneasily solvedproblem insteadturnsinto ahugedisaster.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Like, say, thisfireextinguisher... Look, ifthebuttonhereisstuck, youwouldn'tbe abletotakethefireextinguisherout.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Andtakealookhere. Doyounormally noticethisleverhere? Ifthisisbroken, youwon'tbeableto usethefirebarrierwall tostopthefire fromspreading.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Allthiscanbeavoided solongasIdomyworkproperly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Oh, I never noticed that little thing...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Italkedaboutthis inourlastlecture! Pleaserememberit!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Well, what am I supposed to do?! You know how fast you talk? I can't get half of what you say!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Uhh...! R-Right... Mybad...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Thistime, I'llmakesureI'mwell-prepared, andI'llmakesureallofyou willcometoknow firesafetyandprevention likethebackofyourhands.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Start by getting your talking speed under control!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Uhh... You'reright...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Actually, Dr.Kal'tsitandAmiya approvedmyapplication rightinthebeginning toinstallfireequipment allthroughouttheship.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Ifrit, Skyfire. Youmaynothave everpaidmuchattention tothesethings.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Butaslongaswemakesure theequipmentisoperatingproperly andthateverybody knowshowtouseit, youwon'tneedtocometome whensomethingdoeshappen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Itdoesn'tmatterwhetheryou'reat RhodesIslandorelsewhere. Wherethere'safire, there'salways anextinguishercloseby, andyoucanquicklyputitoutyourself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "With these cans and stuff? Now that you mention it, I do see them all over the place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "But if you're gonna put it like that, can't we just get Casters like MuMu to use their Arts to put the fire out? Why go through all the trouble?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "I'lladmittherearesome OriginiumArtsthatcandothat.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "But, Ifrit, noteveryonehappens toknowhowtouse Artslikethat.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Buteveryone cantakecareoffires withfireequipment aslongastheyknow howtouseit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Andit'snothardtouseeither. Aslongasyou gothroughsome basicfiresafetytraining, anyonecandoit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Andactually...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "IfIcanmakefiresafety commonknowledge hereatRhodesIsland byholdingmorelectures, wecancompletely eradicatedangerslike usingunauthorizedelectronics!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hey, hold up. Why does it feel like you're yelling at me?! I told you last time I won't do that again!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "*Cough*... No, no, notatall. You'reimaginingthings.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Firedoesn'tdistinguishgoodandbad. Anythingitburnsisdoneforgood. Didn'ttheDoctor tellyoulasttime?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Yeah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "It's true that all my enemies burn to cinders whenever I use my Arts on them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "YourOriginiumArts arewaytoodangerous eveninbattle, Skyfire!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Alotofoperators can'tevenget anywherenearyou, andiftheydon't putout theflamesyourelease, itcouldlead tomuchworsedamage... Justlikethattime intheforest!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Younearlyburneddown thewholewoods!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Uh... D-Did I now...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Hahaha! So lame!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Youstoplaughing, Ifrit. Thesamegoesforyou!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Ughh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Anyway, ratherthanputtingoutfires afterthefact, Iwouldrather weputastop toallthefiresattheirsource!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "I'mdoingallthis sothatnoonehasto loseanythingeveragain...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Wow, hey... That's actually a pretty cool thing to say.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Hm? Whatwasthatjustnow?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "Nothing at all!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "If that's where your heart is, then you'd better do a good job! I'm going to that lecture tomorrow, and don't you dare disappoint me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Y-Yeah...! I'lldomybest!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "But, hmm. Remember the podium last time? I couldn't even see you behind it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "text": "That's not gonna fly... Oh, I know! I'll ask Closure to do something about it!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Eh? But—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "She'sgone...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Don't worry about it. Just let her do her thing. Perhaps she'll actually figure out something nice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "So how is your lecture coming along?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Imanagedtogetitwritten, butIjustdon'tthink it'sgoodenough... Everyonesaid theydidn'tknow whatIwastalkingabout lasttimetoo...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Hmph, if they can't figure it out, it just goes to show the level they are at. That being said...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Okay, let me take a look at your draft. I don't mind helping you with some minor edits.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Huh? Yousureaboutthat?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "I'm telling you I don't mind! It has absolutely nothing to do with me being sorry for setting the hallway on fire last time! Don'tyoudaregetthewrongidea!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Slowdown! You'retalkingwaytoofast!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Isee... sothisishow everyonefeels whentheyhearmetalk...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skyfire",
      "text": "Stop babbling already!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Andthat'sthe lastparttakencareof... Yep, it'sallgood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Castertraininggrounds re-inspection... thesimulationcabins... thecanteen... Okay, allofit's takencareof... Good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Phew... NowIjustneedto putmyreporttogether andhandittotheDoctor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "BothSkyfireandIfritleft... Iwonderifthey'llbefine. Theywon'tcauseanotheraccident, right...? *Sigh*... I'mstartingtogetworried.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Mmph!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "—Watch out!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "Hm? Say...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Sorry, it'sallmyfault! Iwasn'tpayingattention... Areyouhurt? DoIneedto takeyoutotheclinic?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "Oh... I'm fine. You don't need to apologize...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "What about you... Are you with the Lungmen Fire Department?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Oh, yesIam! MycodenameatRhodesIsland isShaw!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "I knew it! I got the right person...! I didn't expect to bump into you here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Excuseme, butyouare...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "Please, don't be so polite. You can call me Waai Fu. I saw you on TV before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "I'm not sure if you remember, but it was that accident caused by the heater that's against regulations? I think it was a pretty big deal. Master Wei even took it upon himself to do some fire safety PSAs.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Oh, thatone...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "One of my classmates was in that very building, and she kept telling me it's all thanks to you firefighters that everyone's still alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "All of them are really thankful for everything you've done, and they've been paying extra care to the safety code. The city's awareness campaign was right after that... I learned so much because of that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Hehe... That'sgreat!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "I heard you led the rest of the firefighters at the forefront in that rescue operation. You really left an impression, with how cool and brave you were.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Oh, notatall. Y-You'regivingmetoomuchcredit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "Don't be so humble! That's just how amazing you are!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "Oh, right... I forgot to mention. My classmate is looking to join the fire department, and she's prepping for the exam now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "Eh?! Ifsheneedsanything, letmeknow! Ihavesomematerials shecanborrow!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "That's perfect! I know she's got to be studying so hard for her exam day after day. I bet she'll be so jealous if she finds out I met you here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "text": "You'reexaggerating. Ihopeshepassestheexam!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "Not at all. It's no exaggeration.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "It may seem like no big deal, but she told me it was a miracle that everyone made it out alive and unharmed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Waai Fu",
      "text": "Shaw, you're a hero to her.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
