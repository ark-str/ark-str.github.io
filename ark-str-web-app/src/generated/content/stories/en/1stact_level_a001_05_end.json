{
  "server": "en",
  "storyId": "1stact_level_a001_05_end",
  "groupId": "1stact",
  "stageId": "a001_05",
  "title": "Different Opinions",
  "storyCode": "GT-5",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/a001/level_a001_05_end.txt",
  "sourceHash": "49dbde6d0e09276e5bc92feb4a0b2005f9bfc3d7dcb7e0a509f4d7a6f8596a5f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Gah...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "You... You meddling brat!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Your head's practically split open, just do what's good for you and get out of our way!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Heh, this is nothing. I've been through worse in my daily training!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Guh—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "How many of them are left...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Forget it, I lost track. As long as they don't make it inside...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "E-Earthquake?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Huh? Is that an avalanche over there? Why though?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "You've gotta be kidding... She can even smash through a stone wall that thick?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "A new entrance opened up over there! Hurry, let's go in there!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Damn it, those guys are definitely going to swarm in through that new passageway Skadi just created!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "I have to find Carol—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Stop right there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Skadi...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Unbelievable... Not even a mountain can stand in her way. Those rumors really were true.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Where's the girl?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "I'm not telling you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I'm not the only one after that... thing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "You ought to cooperate before I'm forced to do things the hard way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "I can't just hand Carol over to you if you don't tell me what's going on!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "So... you intend to impede a mission from Rhodes Island?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "What mission? You didn't even tell me anything about that!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Unless you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Hey, don't just start swinging at your comrades!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I'm not your comrade.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "This is your last chance. Take me to see that girl.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "No chance in hell. My mission is to keep her safe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Aaaaghh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Damn... All she did was tap her sword against my lance, but it feels like my arm is about to snap...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Do you think you can really protect her with abilities of this caliber?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Whether or not I can... has nothing to do with whether or not I will!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Huh? Wait a second!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Watch out!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Tch, that ought to have done the trick!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "text": "Yeah, we... no, we didn't get her?! She's still unscathed!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...You again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Gah...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "text": "The l-living Catastrophe! You're the one who hurt the captain! We can't let you leave alive—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Now's my chance!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Don't you even think about it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "You guys really should worry about holding her back first!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "...Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "What just happened?! That kid just vaulted over our heads?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "See you later, Skadi!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "You...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Sorry! When you're ready to explain to me what's going on, maybe then we can talk about Carol!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Stop, get back here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Sorry again!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "text": "How could you just let her go like that?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "She's too fast for us to catch!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "text": "Whatever, let's just deal with this one first.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "text": "With how much bigger you are, I bet you can't leap over us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "...You're all dead.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "It really is like a maze in here with all these winding paths. Carol was right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Hmm? What's a bounty hunter doing here—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "Ugh... save me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "Poor guy...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "He looks like he got pummeled a few times...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "B-but Skadi is still outside the cave, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "What's this opening? It looks like the wall was blasted open...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "That must mean—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "You already figured it out.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I'm a pretty good actor, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "text": "So it was your doing...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
