  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Yahoo!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Eyes on the road, Exusiai! Hands on ten and two!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "I finally caught you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Texas... please... slower next time...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "S- sorry. I was holding back as much as I could.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "But at least we're all back together. Now we gotta go find the boss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Wait, why do I feel like we're missing something?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...where's Bison?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "What? Wasn't he with you guys?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "...We didn't leave him back there did we?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...We're so used to doing things our own way, leaving him behind was kind of inevitable.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "So then we should probably go back and get him?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Isn't Mostima here? I think he'll be okay.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Hey! W- waait up! *Cough* *hack*",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "...A bicycle?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Wowee! If you'n keep up with Texas on a bicycle, yer somethin' else, Bison!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Hey! Which alley'd he go down?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "That way!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "He's got a lot of guys on his tail.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Let's not be too hard on the kid who shook off a crew of armed mobsters on a bicycle.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...No, it's an ambush. Exusiai!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "A little late for that!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Nng!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "I did it! I caught them!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Sure did. Thanks for leading the way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Who——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Good night, sweet prince.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Oof.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Damn. A second too late.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Good evening, Penguin Logistics. I am Gambino Ricci, head of the Family.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "And it looks like I've got a hostage.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "But you ain't gonna make a scene over a little thing like this, eh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "We left him behind...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ain't that the honest truth.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "What do you want?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Hmph... I'm sick of you scuttling around like cockroaches, getting into my business, makin' yourselves a real pain in my tail.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "That's the value of the little prince here. I got a hostage and all you can do is take me head on.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "And that'll save me a lotta trouble. That turns my little penguin problem into a very solvable problem.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Penguin Logistics got nowhere to run.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Yeah, okay. Great. Just the way I like it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "...What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Turns out we're thinking in the same direction.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Croissant, Sora, form up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Exusiai, cover us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Let's get our Bison back.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
