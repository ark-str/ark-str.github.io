{
  "server": "en",
  "storyId": "main_7_level_main_07-01_beg",
  "groupId": "main_7",
  "stageId": "main_07-01",
  "title": "Night of Farewells",
  "storyCode": "7-2",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_07-01_beg.txt",
  "sourceHash": "461059c5ab0da85f1c753f33c18dd82f1dba23ca925eeeb1d1291c820aa05737",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "6:30 p.m."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "Number 00000-00002, Clearance Level-8.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "Dr. {@nickname}, thank you for visiting the Rhodes Island Integrated Bioprocessing Unit. Your intentions have been determined through analysis of available biological data.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "In addition, the system detects that you are in a bad mood.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Leave me alone.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Dr. {@nickname} is displaying aggression.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Rest assured the system will not electrocute you. There is no need to fear these tests.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Dr. {@nickname} fell silent.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Whether silent protest or refusal to communicate, I believe it is an expression of an autism spectrum disorder.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Please, by all means. The system treats all equally.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "And what would count for a good mood?",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Good and bad are subjective judgments.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "However, this system has collected nearly all documented states of mental activity, as well as hormonal criteria for various types of neurological excitement.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "So you could argue that the system's subjective judgment is substantially closer to objective truth.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Therefore, no matter what action Dr. {@nickname} may take, the system will be able to process it to some degree.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Which is to say: you may do as you wish.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "PRTS is equipped with a nonlethal pacification function.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Should you take unreasonable action, you will lose consciousness for 3.55 working hours, ensuring you maintain a behavioral standard close to normal.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "Welcome home, Doctor.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Can this really be called home?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Are you Dr. {@nickname}?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Huh?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......?",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Hello?",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "It's you. I'm sure of it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "I can feel it... you're a little different.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "But... the person you're holding, that uniform...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Can I ask who's that you're holding?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "A fighter.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Fighter?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Oh... she wounded you. Were you fighting?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "No, you weren't... This isn't a lethal wound.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "One of my people.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Is she Infected too...?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "No, that's not what you meant.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Dr. {@nickname}, you seem like you lost something.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "A friend.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "She's your friend?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "But... you barely know her at all.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "I don't know... this might disappear soon.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What... do you feel?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Traces of people communicating with each other. Smell, warmth, shape.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "I'm not sure, but she...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The girl reaches out to FrostNova."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "(Let her).",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Hm.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "No.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "You don't want me to do that?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "No. I'm an outsider. I don't know her.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "I can't do this, can I?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "I'm sorry.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "(Stop her).",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Can you read minds, like Amiya?",
          "value": "4",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "No, I can't...",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Amiya is special. I know Amiya's Arts... and I think she suffers a lot.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "5",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "I... I can't touch her, and I can't feel her.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Her connection to this world has no connection to me.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "I... I have no right to touch her.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "I'm having trouble understanding you.",
          "value": "6",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "The other operators say that too.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "There are a lot of big personalities at Rhodes Island... But I might be weird, even for them.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Sorry.",
          "value": "7",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "No, it's fine. I'm used to it.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Did you want... to use this machine?",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "8",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "P-please don't be mad...",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "When you don't speak, I... I don't know what to say.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Did you want... to use this machine?",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "I'm sorry, little girl.",
          "value": "9",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "I'm fine.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "I'd much rather someone be straight with me than be scared of me. So I'm fine.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "text": "Did you want... to use this machine?",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "If this is indeed the final resting place of the Infected.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "...it is.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Just a second. Let me check the log.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Yes, they cleaned this cabin already. Put her on this slab. Easy now. There.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Then the slab will slide in there, and... wait for it to close, and finally press this button.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You're really familiar with it.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Oh, I've had to use it a lot.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Why...?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "This is where all of Rhodes Island's Infected end up.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "And if I knew them, if I felt them, if they were my teammates, I always take care of them myself.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "The original manual was really complicated, but I wrote down how to use it in my terminal. Just a quick look and I can feel it.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Feel what?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Hmm... it's like a chain.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "A chain...?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Or I could say it's like seeing the links between people.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Sending off the people tied to you means untangling the lines around them. The other ends of the threads are still tied to us, but even when the one side is gone, the threads don't hang down.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "It feels like you've lost something inside yourself. Something you didn't know was there, but knowing it won't come back.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Why would you want to feel that?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Because if you know the feeling, it won't suddenly sting you, right?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "So then you...?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "Excuse me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "Identifier for Rosmontis, elite operator present in Rhodes Island Integrated Infected Bioprocessing Unit, will expire in fifteen minutes.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "I will update you momentarily. Stand in place for about fifteen seconds.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "In addition, there is a skirmish taking place by the starboard hull. If possible, please assist after updating your identification code, in order to reduce resource consumption.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Oh, okay. I'll go do that.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "I'm making a note of it in my terminal.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "Reminding you for the sixth time, if you would allow access to this system, it could send the information directly to...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "No.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "I'm... the only one who can use this.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "Understood.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Elite operator...?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "PRTS means me.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Should I call you Rosmontis?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Yes... Rosmontis.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "What... about her?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "I think... I should at least know her name.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "FrostNova.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "FrostNova...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "A good name.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Hello, FrostNova.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "...Bye bye.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
