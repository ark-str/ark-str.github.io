{
  "server": "en",
  "storyId": "act19side_level_act19side_06_end",
  "groupId": "act19side",
  "stageId": "act19side_06",
  "title": "Free From Dream",
  "storyCode": "DV-6",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act19side/level_act19side_06_end.txt",
  "sourceHash": "d075875311b09cb82a16d31f5b47bad98ffd459f9d7b815c2063b75a93142cb0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "...Sonny.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "We did this of our own volition.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "I don't get it, Doc Moore... who are you talking for here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Message.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "I received a message, one that is different from that previous ones.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Hngh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Does your head hurt again, Joyce?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "There is nothing wrong with me physically, Dr. Silence.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Detecting unexpected data transmission. Processing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Data?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Yes... Sonny, we all know...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "This is... a gamble.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "The results are... unpredictable. But this was our choice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Data transmission terminated. Analysis indicates that Sonny is the intended recipient.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Doc Moore, you're talking like one of our... no, one of the test subjects lying there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Hypothesis cannot be confirmed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "The source of the data is unknown. I simply sensed it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Doc Silence, is she right? Doc Moore can hear my friends?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Joyce, was your use of the word 'sense' intentional?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Yes, Dr. Silence.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "The content of the dream has changed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "What did you see?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Analysis failed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Your eyes look different... are you feeling sad?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Detecting signal fluctuations in peripheral system.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "...Della.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Dellareed? Are you thinking of her again? Does Device #9 have something to do with Director Franks's experiments?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Motive, emotion, not logical connections.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Dr. Silence, I sense that this was our own choice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Your own choice?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Sonny, if I guarantee that I will do all that can be done to correct the wrongs, will you let Dorothy Franks go?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Listen, Doc Silence, we appreciate your help getting us here, and that you got us to the truth about the experiments.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "We can definitely believe you're on our side.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "But can you really be sure she won't start it all back up again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "No, I can't.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "But if she does, I will handle her for you.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Whew... the experiments have been suspended, Dorothy is unharmed, and the test subjects are regaining consciousness.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I still find all this hard to believe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "There is no cause for alarm. Emotional fluctuations are normal.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "You woke up just in time, Joyce.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I've never seen Olivia that angry... I thought she would just leave Dorothy to her own devices.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "But I still don't understand how you heard the voices of the test subjects.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Their consciousnesses were linked by Dorothy's 'Hub', but how did you get involved?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Didn't you say Device #9 had nothing to do with the 'Hub'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Insufficient data available.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "But I heard the voice of Mr. Myers when I woke up from my dream.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "When you woke up...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "The conflict in the corridor? Why would that wake you, when the battle before didn't?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "This is all so strange...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Anyway, I guess all's well that ends well. Thanks to Olivia.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Dr. Silence has met expectations.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "She's changed so much, come to think of it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "When I first met her, she was just one of many students you'd see on a college campus, shy, introverted, unremarkable.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "This description matches my memory.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I could hardly recognize her when she was pressing Dorothy for answers, only to step in to protect her.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "It was like I saw... a shadow of someone else.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "That of Director Saria?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "H-How did you know?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Don't tell Olivia I said that!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Dr. Silence won't let this affect her friendship with you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "But as her friend, I don't want to remind her of her unpleasant past.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Let's go. I should finish my job too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Communications have yet to be restored... not good. The boss...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "And my sister... how many messages have I been getting?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Please come with me, Director Franks. It's time to leave.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "One moment, please.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "With the experiments halted, they will wipe this lab off the map.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "There's something I have to take with me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "It's... a photo?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "Yes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "A photo of a group of Pioneers...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Is this girl... you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "I meant every word I said to Sonny.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "My mother, my whole family... they were all Pioneers.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "From a young age I heard them talk about their dreams and saw their struggles with my own eyes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "They gave me a chance to chase my own dreams.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "But most Pioneers will never know the luck that came to me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "What happened to your family?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "Most of them have left me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "When I was invited to attend Ironforge Polytechnic's summer camp for 'talented students'...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "A Catastrophe destroyed my mother's camp.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "She never heard about my miraculous acceptance, or my scholarship.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "I'm sorry...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "Was it really the right choice to stop these experiments?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "Those Pioneers, those whose lives hang by a thread, they live each day not knowing if they'll see the next.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "I could have helped them...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dorothy",
      "text": "They didn't have to be swallowed up by the sand in despair, like my family was.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Parvis",
      "text": "Why do you ask this, Silence?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Parvis",
      "text": "Without our experiments, the child would not have lasted more than a few days after leaving Haydn 1.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Parvis",
      "text": "We saved her life. She wants for nothing, and will contribute to scientific advancement.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Parvis",
      "text": "How lucky is she, compared to all those children who die of Oripathy in the barrenlands?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Parvis",
      "text": "I trusted you, put you in charge of her. Yet you make such petty accusations towards me, towards science itself?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "I don't know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "This is not a question for me to answer.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Joyce reminded me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "I should not judge things by my own standards, even if I can never accept what you did.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "Did we not choose to be tormented by uncertainty and self-doubt?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Silence",
      "text": "As researchers, it's our duty to seek the answer ourselves.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Is everything ready?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Our team has entered the site and is approaching the lab area.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Good. Get ready.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Colonel, I know there have been delays, but if you give me a little more time...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Colonel's Voice",
      "text": "You never told me there were other people at the site, Clooney.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Do you mean the pharmaceutical company?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "There's nothing to worry about. They're partnered with Rhine Lab. I will...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Colonel's Voice",
      "text": "I don't need your promises.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Colonel's Voice",
      "text": "All I need here is results.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "I apologize. This is just a small hiccup...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Colonel's Voice",
      "text": "If you can't deliver results, then you have to at least stop making trouble for me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Colonel's Voice",
      "text": "You'd do well to remember that.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Can we proceed, Director Clooney?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "We don't have a choice.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "One more thing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Put me on spec com.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Huh... communications have been restored?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Elena.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Director?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I'm so glad it's you. I've been trying to reach you... did you get my message? I put everything that happened here in my report.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Something's wrong with Dorothy... Director Franks's experiments. But Silence and I have things under control.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "We've settled things with the Pioneers. They're leaving the labs as we speak.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "I know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "You... you do? Oh wow...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "You did your job. The cleanup detail is on the way in.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Defense? They're finally here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Whew, that's a relief. I was worried about the Transmitter we've been storing here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "They know what to do. You can leave now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I should stay and help. Next to Dorothy, I'm the most familiar with these experiments.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "I'm at the observation station, Elena. Two directors are more than enough to handle the situation, don't you agree?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Er, that's not what I meant...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Then listen to me and leave the site immediately.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "May I ask why?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "No, you may not waste my time with meaningless questions. I want you in the control room, now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Yes... sir.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Is there a problem, Researcher Urbica?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "The director... Ferdinand wants me to leave immediately.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "Leave?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Go and let Olivia know that the Defense Section is coming.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ptilopsis",
      "text": "What about you? Are you leaving?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I... something's not right with the director. If... if he didn't know how far Dorothy went, why is he completely unconcerned about what happened to the experiments?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Director Clooney, Miss Urbica is not leaving the labs.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Should we adjust the plan?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "No.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ferdinand",
      "text": "Proceed.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Is everybody out?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pioneer Team Member",
      "text": "Yes, sir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Next.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "What are they doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pioneer Team Member",
      "text": "They say it's a 'precautionary measure'. Probably a sedative or something.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pioneer Team Member",
      "text": "I guess we made a little too much noise, huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Don't forget what I said. If anyone asks, I was the one behind everything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pioneer Team Member",
      "text": "Don't worry, no one's letting you take all the credit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "But...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Next.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Sonny Romano.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Wasn't asking for your name.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Tell your leader that I take sole responsibility for the kidnapping.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "Right hand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Are you gonna get to it after the injection?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "What the...? Doc Urbica? Why'd you push me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Don't take the shot!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhine Defense Member",
      "text": "You're interfering with our work, researcher.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I developed that stuff in that syringe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Need me to explain what it's for?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Huh? Aren't they with you and Doc Silence?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Why do you always doubt the people you should trust, when you're so eager to trust people you should doubt?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Take that band off, quick!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "The treatment wristband?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I remembered why Joyce woke up when I saw the syringes in their hands!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "It's this—the treatment bands!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "The ones you got have been modified. There's a sensor on them similar to the equipment in Dorothy's lab. If it comes into contact with Transmitter...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I need to report to the director. Someone is behind all this, using... using...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Dammit, communications are down again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "What's the matter?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "I... I get it now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "All this time...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sonny",
      "text": "Doc Urbica, are you okay? Are you crying?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "Crying? No, I just...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "It's not important.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Elena",
      "text": "This isn't over, Sonny. Dorothy was never your enemy!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
