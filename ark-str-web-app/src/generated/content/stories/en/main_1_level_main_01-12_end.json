{
  "server": "en",
  "storyId": "main_1_level_main_01-12_end",
  "groupId": "main_1",
  "stageId": "main_01-12",
  "title": "Pyrrhic Victory",
  "storyCode": "1-12",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_01-12_end.txt",
  "sourceHash": "2cb4e1f4e552e6e2ebde5e3803be45dc0cb811f2723584be30938ac5e3541d46",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Ahh... What a nostalgic feeling!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Amiya, was it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Ah, ahaha! I see... So that's what's going on.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "I remember now, Amiya.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "I've already gotten what I came for. You can all go now. Shoo.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "You...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "W...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "... What, do you lot want to stay here and die? That's perfectly fine by me. You're all free to do as you please.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "We're falling back. Let them go. Talulah's orders.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Forget it. Things get boring when they get dragged out too long. I hate being bored, that's all there is to it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "However, I do look forward to seeing you again, Amiya.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "As well as... that person.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What...? !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Next time, I will hear the truth from you, {@Nickname}.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "Bye~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What... Why... is she doing this?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Reunion... they've left.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "--We've long missed the rendezvous time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Retreat back to Rhodes Island... immediately.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I'll escort... the Operators in the back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "Amiya...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I'm fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "... All right..",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Go, Amiya.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "... ...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "... Boss...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Where are the others...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Nearl and the others have already broken out with Amiya and Dr. {@nickname}.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Those who stayed behind...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "... They're all gone.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "... What...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "We're the only two left.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "I remember now... That, that freak... Talulah... single-handedly...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "She knocked away our Guards like they were toy bricks...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "That monster cut through our Defenders as if they were butter...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Hush... Your wounds are deep.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "The Catastrophe...! She is Catastrophe incarnate... How, how else could she have reduced our squads to ashes in an instant...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Even though I saw it with my own eyes, I can't... I can't believe it...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "The screams... Aagh... Gaaaah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Snap out of it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "I'm so sorry... I, I don't know how...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Calm down.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "I gave you some emergency treatment.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "... Boss... what happened to your arm...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "At least I still have one I can use.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Boss... You should go. I'm sure you'll be able to break your way out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "We only managed to stall her for a few minutes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Until Dr. {@nickname} and Amiya are safe, I cannot go.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "I have to stop that monster first.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Boss... I also...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "The price of your life... was paid with my arm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "If you can live even a single minute longer, it will be worth it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "I'll be right back. Take care of yourself.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Boss... I'm sorry... that I'm so unworthy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Amiya...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "I'm sure you'll be able to... make everyone's dreams...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "They're all... I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "... ...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "... Amiya?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "... ... Amiya?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Oh, huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "What's the matter?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "N-nothing... I just suddenly felt...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Grief...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "*sniff*... Urk...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "Grief... huh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "Aauugh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "... Don't cry...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "At least... for now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Someone once said to me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Tears... should be saved for when the war is over.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Now... is not the time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "Nnh... Ugh... Nn...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Let's go...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...We're going home.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
