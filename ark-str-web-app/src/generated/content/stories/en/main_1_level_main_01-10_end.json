  "blocks": [
    {
      "type": "narration",
      "text": "第十一关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "We've broken through Reunion's encirclement!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "But... they...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "... I... Aaaagh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Shh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "...Don't let Amiya hear you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "Amiya's kept a clear head through this! She's a lot more mature than we thought...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Ngh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Mmh...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Even if that's the case, we can't let her hear this!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "We mustn't burden her any further. She's already... carrying the weight of the world on her shoulders.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "...We can't... let their efforts go to waste!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "They made the ultimate choice to let us live, so we have to return the favor... by making sure Amiya and the Doctor return safely.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "That's right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Now isn't the time to be dejected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "As the Radiant Knight, shouldn't you always be our beacon of hope, no matter what happens?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "... I'm not sure anymore. But, I will do my part.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "Regroup! Don't let your guard down! We're almost there!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "*sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Those who told me not to worry... None of them ended up coming back.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Doctor {@nickname}...? What happened...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "P-please... let me down...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Mm, I'm fine. I can walk on my own...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I just... lost consciousness for a little... but I'm okay.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...We managed to make it out?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What about Ace and the others...?",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I see.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "It's okay. I'm sure Ace will be fine.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Everyone in Rhodes Island is very strong.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "We're almost at the south exit. Once we leave Chernobog, we'll be...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "We'll... be...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor... Can I... lean on you for a bit...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Just... a little...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Talulah",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Talulah",
          "text": "What a pain.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mephisto",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mephisto",
          "text": "How did that guy... manage to do this...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mephisto",
          "text": "Half of the city was burnt to ashes, the entire plaza became a sea of flames... Steel was melting and reforming...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mephisto",
          "text": "But how was he... able to keep fighting?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "He fought until the bitter end... Impressive.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Talulah",
          "text": "I'll remember this.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Talulah",
          "text": "...Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
