{
  "server": "cn",
  "storyId": "story_crosly_set_1_story_1",
  "groupId": "story_crosly_set_1",
  "stageId": null,
  "title": "欲摘其冠",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_crosly_1_1.txt",
  "sourceHash": "8943d84e30510ff6270eb199e2d05f3e2469c4a8c2d92d13638c37ea0658c28b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......弑君者小姐，我很抱歉，罗德岛不会批准你前往乌萨斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "凯尔希医生之前传回的信息中特意嘱咐过，如果你提起这件事，就告诉你这个结论。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "我一定是这里最熟悉乌萨斯的人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "正是因为你太熟悉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "凯尔希医生说，如果你表现出愤怒，那就证明她的判断是正确的。她在你的调令上写了特别批注——你可以去任何地方，除了乌萨斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "她凭什么替我做决定？我已经不是那个躲在她身后的小女孩了，也不是复仇的奴隶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "我想回家，去搞清楚我父亲到底是怎么死的，搞清楚那个该死的石棺到底是什么东西！这有错吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "没有错。凯尔希医生给你留了一段录音。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希的录音",
      "text": "柳德米拉，当你站在那台吞噬了你父亲的机器面前，当你手里拿着那张童年的画作时，你打算做什么？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "做什么？\n寻找真相。"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希的录音",
      "text": "你想要真相。但真相是过去式，柳德米拉。找到之后，你又打算怎么做？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "找到真相之后怎么做？\n当然是复仇。"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希的录音",
      "text": "你会说，你要成为那个弑君之人。可你的刀刃又要挥向谁？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "刀刃挥向谁？\n已经被政治洪流淹没的贵族，那台冰冷的石棺，又或者是......你。"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希的录音",
      "text": "如果你只是想要一个有关这一切的答案，等我回来，我会告诉你我能告诉你的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希的录音",
      "text": "即使有些事我依然无法告诉你，但我可以保证那也会比你亲自返回乌萨斯所能找到的多得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希的录音",
      "text": "我想，这个承诺足够打消你返回乌萨斯的念头。除非，你还有别的想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希的录音",
      "text": "我期待你的想法能够说服阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "弑君者小姐，抱歉。不让你前往乌萨斯，不只是凯尔希医生的意思，也是我和博士的共同判断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你对乌萨斯的想法掺杂了太多的个人因素，我不能让这些因素干扰罗德岛在乌萨斯的行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "但我向你保证，只要凯尔希医生返回——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......够了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "她一直待在不知道什么鬼地方，就让那个小兔子传话！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "她说我不够格？哈！我知道，她在拐着弯说，我在找死。她根本不了解我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机A",
      "text": "说得没错，我们的柳德米拉可不是孬种！要是没有你，老皮特早成灰了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机B",
      "text": "就是！那个什么凯尔希医生，她懂什么叫跑卡车吗？她知道干好我们这行要多大本事吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机A",
      "text": "你不是说你知道她的秘密吗？我看她就是怕你！怕你回去之后把她的秘密都翻出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "哼，没错！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机B",
      "text": "别理那帮大公司的官僚！他们根本没把你当自己人看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机A",
      "text": "对！柳德米拉，别生闷气了。为了那种人生气不值得。来，接着！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "谢了，老乔......这苹果挺脆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机A",
      "text": "那当然，刚从农场那些人手里换来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "农场？我们什么时候和农场有合作了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机A",
      "text": "在你不在的时候，我们和荒野上的几座村子有了联络，放心，合法合规。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机B",
      "text": "大伙正商量着今晚搞个烤肉会，这不，都指望着你来主持呢——主要是怕伊雷妮又把肉烤焦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "哼，我看你们是想蹭我的盐汽水喝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机B",
      "text": "嘿嘿，说真的，柳德米拉，留下来跟我们乐呵乐呵，把那什么罗德岛的破事都忘了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "这——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "谁在说我坏话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机B",
      "text": "我只是实话实说，伊雷妮，你的烤肉手法真不如柳德米拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "去你的吧，活都干完了吗，就在这里喝盐汽水？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡车司机A",
      "text": "干活去干活去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "柳德米拉，这次打算待多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "这次外勤时间不会很久，过几天我就要回去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "不多待几天？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我还会回来的。反正最近也没有地方可去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "拿去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "这是......《运输保障署特别合伙人协议》？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "“......根据协议，运输保障署为乙方柳德米拉·伊里尼奇娜提供在新沃尔西尼的住所，以及身份证明......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "我知道你的情况特殊。但上次你说要走时，我就在想这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "柳德米拉，这份合同不是束缚，是个保障。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "签了它，你在新沃尔西尼就有了根。不管罗德岛那边怎么安排，只要你愿意，这里永远有你的一辆车，一张床。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "我想让你留下来。不是作为什么外派干员，而是作为我们的家人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "家人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "你还在犹豫什么？还是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "这太诱人了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一个合法的身份，一群单纯热情的伙伴，一个没有政治阴谋和源石技艺轰炸的角落。\n如果签了字，我就能理所当然地留在这里。\n我可以告诉自己，是为了保护伊雷妮，是为了帮助运输保障署对抗家族......这是一个多么完美的、正义的理由。\n那样，我就再也不用去想乌萨斯的风雪，不用去想凯尔希那个该死的问题了。\n而且，我和伊雷妮说过，我会一直看着她。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "柳德米拉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "......伊雷妮，谢谢你。真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "但这份合同太重了。我......我得考虑考虑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "没关系！我知道这对你来说是大事。合同你先拿着，什么时候想通了，随时来找我签字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "走，去喝一杯热咖啡，老山姆刚煮的，加了双倍的糖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "看着伊雷妮的背影，柳德米拉将合同折叠起来，放进了胸口贴身的口袋。\n那里还放着一张皱巴巴的、通往乌萨斯边境的旧地图。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "对了，我们现在有新的合作伙伴了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "老乔刚才和我说过了。怎么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "该怎么说呢......其实我对他们不是很放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "他们说自己来自远方的农庄，我仔细审查过他们的身份，没有问题，待人也很有礼貌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "但里面有些人给我的感觉有些像你。我想让你去探一探他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "像我？......好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "让我看看，清单上都是些生活物资，看起来没有问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "至于货物本身......唔，也没问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "交货地点在这里吗？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "“苏茜杂货铺”？倒是很普通的名\n——？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "......雷德，为什么你会？难道——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "这是我要问的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德/柳德米拉",
      "text": "柳德米拉，你把运输保障署的人怎么了？！/说，雷德，你把这家杂货铺的人怎么了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "你是送货的司机？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你是交货对象？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "这批货物......没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我来帮你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "好久不见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "我听他们说过运输保障署里有个很厉害的瑞柏巴，只是人不在，没想到是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "看来你的省亲之旅很顺利，九知道会高兴的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "九......农庄是怎么回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "就是农庄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "九在那里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "对，九和其他人在那里。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "塔露拉呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "......算了，不告诉你估计又要打一场。她也在，九看着她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你们准备物资难道是要——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "我们正在筹备后续的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "所以我们需要大量物资。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "卡西米尔和莱塔尼亚没人愿意和我们交易，我抱着试一试的心态来到这里，没想到那个法官和伊雷妮署长很愿意帮助我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "那是你隐瞒了你们的身份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "你会到处说你过去是整合运动的人吗，柳德米拉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "我们只是一群生活在乌萨斯边境农庄的农民，我没有说一句谎话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你们......为什么......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "雷德，你什么意思？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "差不多搬完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "我看过清单，基本没什么问题，回去替我谢谢伊雷妮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "就说下次再来估计要很久以后了，感谢她对我们这群农民的照顾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "雷德！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "这是为了你好，柳德米拉，你已经不是整合运动的人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "还是说，你想回来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "如果你有这个想法，那就跟我一起走，九见到你会更高兴。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "九和塔露拉，如果我答应回到她们身边，一定能进入乌萨斯。\n而且，塔露拉......我曾经多少次懊悔于我没有更多地观察她，没有更早发现她的堕落。\n这是个机会。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "你可以好好想想，柳德米拉。现在的整合运动不一样了。我们这次回去，是为了帮助一些人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "但你呢，你还是过去那个柳德米拉吗？还是你是卡车司机柳德米拉，或者别的什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "你真的想回来吗？还是你只是要和过去一样，搭一趟便车？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我没有搭便车！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "随你怎么说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "如果你自己没想好怎么走，就算把你运到了切尔诺伯格的废墟上，你也只是个迷路的幽灵。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "车要开了。离远点，别被卷进轮子里。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "等等！雷德！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "混蛋......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "老师，我来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "她一直花钱租着这间房间，房间里一尘不染，和老师死去前一样。\n她拿出了通往乌萨斯的旧地图，又拿出了伊雷妮给的那份合同，最后，是雷德签署的收据单。"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "老师......你说过，我不应该回到乌萨斯报仇，我的力量还太弱，我的觉悟也还不够。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "但是，究竟怎么样才算拥有足够的力量和觉悟？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你在生气。是因为凯尔希拒绝了你？还是因为雷德戳穿了你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "还是说，你其实认为，伊雷妮的提议是那么不合时宜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "凯尔希她根本不懂！她说我在找死，说我没有目标。还有雷德，他凭什么说我是乘客？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "是啊。在整合运动，你是“弑君者”。塔露拉指哪里，你就去哪里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "后来，你是“物流专家”。伊雷妮让你送什么，你就送什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "柳德米拉，你总是在半路跳上一辆已经开动的车。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "整合运动的车，罗德岛的车，互助会的车......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "闭嘴！我为了那些目标流过血！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你流血，是为了证明自己属于那个故事。因为你害怕如果故事结束了，或者故事里没有你的位置了，你就什么都不是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你害怕那个除了“复仇者”和“司机”之外的，空空荡荡的自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我要去查清真相，我要去给父亲扫墓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "腿长在你身上，你想去，谁能拦你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你确实想要真相，你确实想要去给父亲扫墓，你也确实想要找到石棺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "但你见过塔露拉，见过伊雷妮，你悔恨于没有发现塔露拉的堕落，你对伊雷妮许下承诺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "为什么？这和石棺的真相有关吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "不，这只和你有关，只和“弑君者”柳德米拉有关。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "回忆一下。你上一次要去乌萨斯时，老师是什么表情？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "她......她在笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "她在笑你天真。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "她说：“柳德米拉，杀死一个皇帝，其实比杀一只羽兽难不了多少。只要他流血，他就会死。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "“......但是，杀了他之后呢？”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "对。杀了他之后呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "皇位空出来了，谁去坐？国家乱了，谁去管？新的暴君上台了，你要再杀一次吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "那些流出来的血，能填补你心里的洞吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你从不想这些。你只管“杀”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "因为“杀人”太简单了。它是一个有终点的动作。刀拔出来，人倒下，任务结束。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你留在现在的运输保障署也是一样。把货送到，签字，任务结束。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你喜欢这种感觉。因为只要盯着那个靶子，你就不用去管靶子后面的未来有多复杂，也不用去想任务结束后的自己该去哪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "你把自己简化成了一把刀，因为刀不需要思考未来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "......所以我才会迷茫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "没错。我知道，一旦踏上那片冻土，我无法只是关注所谓的真相，我也无法只是去研究所的废墟前哭一场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我在那里长大，我知道生活在那里是什么样的光景，我跟着整合运动见过生活在那片土地上的人的苦难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "所以我一定无法放着那些人和事不管。我害怕的是，当我再一次面对那些人和事时，我依然无能为力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "我的仇恨只是因为父亲的遭遇？我的愤怒只是因为我没有得到真相？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我是不是依然只能告诉自己，我是“弑君者”，我的刀只为杀死君王存在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉？",
      "text": "杀死一个君王很简单，杀死一顶冠冕却是那么困难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "所以我才想依赖罗德岛，或者整合运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我不是希望它们能够为我提供庇护，我希望它们能够帮助我，共同抵御那片冻土上的风雪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "但是......我明明已经知道答案是什么。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "柳德米拉！你跑哪去了？一下午没见人影。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "快来，这是你要的伏特加！虽然比不上乌萨斯的烈，但在叙拉古这已经是最好的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "伊雷妮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "嗯？怎么了？这么严肃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "是不是决定要签字了？笔我都给你准备好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我要走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "走？去哪？罗德岛召回你了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "不。是我自己要走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我要回乌萨斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "现在？可是......北边很冷的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "是不是......是不是我们哪里做得不好？还是说农庄那帮人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "都不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "你说过，你会盯着我，你现在可是准备要爽约。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "正因为我一直盯着你，所以我才知道，你是怎么把当初的卡车互助会发展到今天的规模，你为了这一切付出了怎样的心血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你和另一个人的经历都在告诉我，想要做到什么，必须自己去做，必须从头开始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "......这会很难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "所以我一直在逃避。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "......但你一定要去，对吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "一定要去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "好。拦着想回家的瑞柏巴，不是朋友该做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "但你听着，柳德米拉。不管你在那边找到了什么，或者没找到什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "text": "如果累了，运输保障署的大门永远不锁。那个合同，我给你留着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "好。我答应你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "怎么？想通了？还是来送行的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "“苏茜杂货铺”是怎么回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "......一个朋友的名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你也和以前不太一样了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "这一车货，我帮你们送到边境线。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "......为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "就当是付给你们的车费。也当是......还清我之前欠整合运动的最后一点人情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "你要去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "先回趟罗德岛收拾行李，然后，去乌萨斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "一个人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "一个人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷德",
      "text": "那么，说不定未来还能见面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "有机会的话。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "柳德米拉走进会议室，凯尔希在那里等她。\n这一回，她主动开口。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "凯尔希，你会对我隐瞒许多东西，对吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "如果我判断这是必要的，那么是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "你只会告诉我你认为我需要知道的一切，对吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "我不否认。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "那么，我不要了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "罗德岛依然不会同意批准你前往乌萨斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我只是回趟家而已，乌萨斯，那里是我的故乡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我会一个人回去。腿长在我自己身上，你拦不住我，罗德岛也管不着我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "我会在那里走走看看，或许再做些什么事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "或许到时候还会遇到你们的干员，那就到时候再说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "柳德米拉",
      "text": "就这样。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "说完，她头也不回地走出会议室。\n凯尔希没有阻拦她。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
