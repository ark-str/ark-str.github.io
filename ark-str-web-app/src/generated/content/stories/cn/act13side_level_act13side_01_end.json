{
  "server": "cn",
  "storyId": "act13side_level_act13side_01_end",
  "groupId": "act13side",
  "stageId": "act13side_01",
  "title": "金盏花",
  "storyCode": "NL-1",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act13side/level_act13side_01_end.txt",
  "sourceHash": "296ee467c4bb779f52e339d811dc69388eaea7b839cc0780ab73244c38704988",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 1-2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "留步，马克维茨先生。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "是您啊，麦基先生，您......您有事找我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "又见面了，你收到联合会的信件了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "特锦赛期间负责赛事监督的发言人只有我们俩......这可是个苦差事，但也备受瞩目。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "如果想要在摘掉“发言人”三个字之后还能继续平步青云，眼下这可是最好的机会了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "哈哈......不怕您笑话，我宁可不被这么瞩目，去负责场地活动的策划一类......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "您擅长这些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "可没什么擅长不擅长的，我只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "您又谦虚了，您适应得比那些老员工都快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "——不过今天找您，是有一些别的事情我想提前知会您一声。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "咱们找一间休息室聊吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "啊，听您的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "什么事需要这么谨慎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "其实这些，本不该我来和您说，但是恰尔内先生走得匆忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "卡瓦莱利亚基除了核心的大骑士领本土，每届会从商业发展最迅速的城市中选出三座，合并成为如今的大骑士领。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "在特锦赛结束之后的几个月内，除了大骑士领外的移动城市，会根据航线工程师的设计，在一个月内回到原本的航线之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "每次四城合并都是一次机遇。可观的人流量，无缝通商，以及......处理一些问题的机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "说实在的，要不是四城联合的规模实在过于庞大，无法有效移动，躲避天灾，也难处理物资分配和开采问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "我真希望四城联合永不解散。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "不过今天要说的是一个......嗯......潜规则。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "是关于......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "......感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "梅什科工业集团今年为大骑士领提供了七个移动平台，相当于其他国家一座城区的规模......当然，这是台面上的部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "这些，我都从同事那里听闻过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "现在我们应当关注的重点是零号地块。它不在梅什科工业交付的合法名单上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "这个地块性质特殊，它是一个规模很小的移动平台，现在连接在西南边角，十七号城区之外。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "那里是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "是的，那里就在感染者收容治疗中心旁边。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "原谅我的无礼，马克维茨先生，接下来我们交谈的每一句话，都要录像记录。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "这是规定......发言人之中不允许有任何背叛联合会的行为。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "......我明白了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "您的脸色很难看......我知道，我一开始听说的时候，也是您这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "可这也太不人道了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "......您现在是董事会的执行人，商业联合会的发言人，马克维茨兄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "......我只是提醒您这一点，当然，不是警告或是威胁什么的——哈哈，恰尔内先生总会给人这样的感觉对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "尽在把握，了如指掌。你不听他的可不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人马克维茨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "我可没那个意思，马克维茨兄，我们得相互扶持。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "您该好好想想我的话，我接下来还要去和几个骑士团确认行程。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "发言人麦基",
      "text": "回头见。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "......玛恩纳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "你在吗？玛——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "......佐菲娅姑母？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "啊......玛嘉烈，你怎么还在家里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "玛莉娅那孩子不是说你去骑士协会了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "一些程序上的琐事罢了，花不了多少功夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "......呵呵，你真的变了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "是因为那个叫“罗德岛”的地方？你以前可根本不擅长那些文书工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "还记得你刚报名成为骑士的时候吗？独立骑士玛嘉烈·临光，总是把各种证件和手续搞混......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "嗯......那时候多亏了有你，姑母。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "唉......玛莉娅那丫头也就算了，你年纪不是和我差不多吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "以前花了那么大力气让你习惯直呼其名，怎么几年没见，又变回去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "难道我们生疏了？嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "......呵呵，没有的事，佐菲娅。我只是很久没和家人这样面对面交流了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "你是来探望叔叔的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "嗯......他还在工作吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "还没回。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "......玛恩纳他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "......我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "我不会敌视他，也不会埋怨他的，佐菲娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛嘉烈",
      "text": "我不会的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "啊......比赛就要开始了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老骑士",
      "text": "......还是老样子，人多得夸张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老骑士",
      "text": "那边那个锋盔骑士团的家伙，去年是不是也见过？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "嗨，别管那种家伙，就连左手骑士都是玛莉娅的手下败将啦，锋盔骑士团算什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "欸......只是偶然，偶然而已，总是这么说怪让人不好意思的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光头马丁",
      "text": "......唔。今晚的比赛，似乎也有“锈铜”奥尔默·英格拉参与......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老骑士",
      "text": "哈，都是熟人啊，玛莉娅——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "——你少说两句。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "没事的啦，科瓦尔师傅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "我已经放弃成为竞技骑士的想法了，那实在不适合我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老骑士",
      "text": "就是！成为自己的方式有那么多，没必要被迫做什么选择！这是老年人的忠告！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老骑士",
      "text": "再说，你的表现已经很亮眼啦，敬你一杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "说起来，玛嘉烈的那身盔甲是不是还没有做最终调试？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "她之前穿的那一身虽然做工是不错，但怎么看也不适合玛嘉烈这样勇猛的库兰塔啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "啊......我已经在着手调整了，还需要点时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "还有姐姐的武器......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光头马丁",
      "text": "玛嘉烈刚参加骑士竞技时，用的是一把战锤。再后来，她改用一把骑士长剑，光芒在她的剑刃上萦绕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光头马丁",
      "text": "现在——是一柄剑枪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "哈！米诺斯的D32夹钢锻造工艺，极佳的源石技艺传导性！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "真怀念啊，那时候玛嘉烈来找我给她换一把趁手的剑——那可是临光老爷的孙女第一次开口让我帮忙——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老骑士",
      "text": "别怀旧了，科瓦尔，耀骑士下周就要登场了，你们到底有没有在帮她！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "啊啊？你以为我是你吗？整天只知道喝酒，游手好闲？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "光头马丁",
      "text": "（锈铜骑士参加的是......夺旗赛......？为什么沸血骑士团会浪费一个精英骑士参加这种吃力不讨好的赛制......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光头马丁",
      "text": "（锈铜的对手是......唔，都是些小有名气的骑士团......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光头马丁",
      "text": "（......慢着，有感染者骑士......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "特锦赛正赛，嗯哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "在成为感染者的时候，你想过会有这么一天吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你想过能站在这个赛场上，为自己赢取那感觉几辈子都赚不到的财富吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "我知道......我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "加入红松骑士团是我的荣幸，野鬃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哈，喊我名字就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "好！等我拿到奖金，请你喝酒，艾沃娜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "好啊，除了灰毫根本没人陪我喝酒，我正无聊得很——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "——夺旗战的规则还记得吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "记得，尽量待在得分线里，尽量避免直接冲突——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "欸，那是索娜教你的那套——要我说，打烂那群贵族骑士的盔甲，你就是冠军啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "有人抢分，你就先把人解决了，不是很简单吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "哈、哈哈哈......如果我能做到的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "自信点。不好好闹上一场，他们是不会看得起你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "想让别人仰视你，很简单，把他们揍趴下，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "不过好像有人是冲你来的，哈，那家伙还没在灰毫那边吃够苦头？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "奥尔默·英格拉......他是为了报复感染者才来到这里的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "真是心胸狭隘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "贵族子弟，啐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "看来灰毫那一仗挫败他的自尊心了，虚有其表的家伙根本不该站在赛场上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "啊——手痒。不然找个机会私下把他揍一顿得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "广播里的声音",
      "text": "现在——有请各骑士入场——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "上吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "......好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "孩子们还在等我们回去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "......嘎哈。红松骑士团......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "感染者，一群祸害......也敢自称骑士？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "......该死！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
