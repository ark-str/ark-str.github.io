{
  "server": "cn",
  "storyId": "main_13_level_main_13-12_end",
  "groupId": "main_13",
  "stageId": "main_13-12",
  "title": "猩红烟火",
  "storyCode": "13-14",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_13-12_end.txt",
  "sourceHash": "94933527dbcc8769b9fef9736848dd5f6e9b9051c7d0a15744311f8f7bb59078",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "你昨晚没有把东西送到我的营帐......玛格达尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "你也没有离开布伦特伍德镇，可悲的选择。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "为什么不离开？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "这里是我的家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "你是有新的订单吗？我可以连昨天的花一并送过去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "......你今后不用再为那些订单操心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "我是来向你告别的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "我即将前往食腐者之王阁下的军团中......作战。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "好吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "再见。如果这是你想听到的问候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "......你太单纯，单纯到近乎愚蠢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "我一直试图保护一些东西，但是它们却总是自取灭亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "也许我一开始就错了，玛格达尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "我听不懂你在说什么，“锹子”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "我曾无比羡慕你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "维多利亚过去是高贵而又强大的国家，你们理所应当地占据了太多好东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "你们靠着发达的冶金学和蒸汽骑士征服了另一个帝国，靠着迷人的艺术和丰富的学术吸引了全泰拉的天才......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "而如今，你们停下了向外征服的脚步。你们的统治者，流连于酒宴上的红酒杯，吹嘘着胸前勋章的虚名。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "荣光被亲自掐灭，被取代的命运也早已注定——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "嗯？这个挂钟你还留着......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "时间过得真快，镇上的人应该都出发去工地了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "......你们的死亡无法避免，玛格达尔。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "大君很不耐烦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "所以仪式被要求提前了，而你们在那个菲林的带领下，确实超额完成了任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "这里的人都会是开启仪式的钥匙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "当然，也包括你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾达",
      "text": "......刚刚在萨卡兹的军营里，威尔被那些魔族佬留下了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "芙蕾达......你看到了吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......我得去找芙蕾达！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "放开我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "你不能离开这间温室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "再等等吧，玛格达尔，我会陪着你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "等着我们最后的告别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "为什么......镇上的人从来没有违背过你们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "芙蕾达带着全镇的人满足了你们的所有要求！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "殿下决定了这场战争，你们的公爵响应了这场战争。这个结果与我们，或是你们都无关。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "我们只需要服从命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "那让我去警告工地上的人！就像以前一样，你当作什么都不知道，求你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "我为殿下效命，我不会允许你破坏仪式......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "......除非你能越过我，玛格达尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭军尉官",
      "text": "你能做到吗，“园丁”？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "玛格达尔，你急匆匆的要去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "你衣服上的血......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......没事——修剪枝杈时不小心剪破了手指......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "汉克，芙蕾达在哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "芙蕾达？她早上一个人从军营那边回来之后，就去找那些萨卡兹长官了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "她看上去失魂落魄的，看见谁都说对不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "是发生什么事了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......快让大家赶紧远离这个地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "越远越好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "你们今天怎么一个比一个奇怪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "来不及解释了，我得去通知其他人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "可我们马上就要建完了呀？再说，要是我们旷工，被那些长官抓住怎么办？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "烟花？哪来的烟花？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的市民",
      "text": "谁把那堵墙炸开了？那是......芙蕾达？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恐惧的市民",
      "text": "发生什么事了？地震了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐惧的女性",
      "text": "快......快逃！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恐惧的市民",
      "text": "你在流血......该死，不要过来！那些恶心的怪物正从你身上掉下来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "萨卡兹到底想干嘛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "汉克，汉克！你不能闭上眼睛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "我......也感觉好累......好困......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "玛格达尔！坚持住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "队长，我抓住她了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "所有人注意！抓稳滑索，不要接触地面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "赶紧救人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "玛格达尔小姐，现在还不能睡哦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "洛洛小姐？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "这家伙可真沉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "昏迷的市民",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "费斯特先生......自救军......怎么会？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "我们看到镇里大白天放烟花就猜到出事了！我们昨天打开的缺口被封上了，但你们的那门礼炮炸出了新的路线。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "抓紧洛洛的手，玛格达尔！我们的战斗部队不足，只能先带着大家尽快撤退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "喔哦！费斯特，你改良后的滑索速度好像更快了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "对了，芙蕾达镇长在哪？我们没找到她的位置。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......芙蕾达她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "该死，我的滑索怎么开始抖起来了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "那个懦弱的驻军指挥官呢，他又藏到哪里去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "......无所谓，我来接手这里的指挥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "我能感觉到，我的血......在沸腾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "不用通知厄尔苏拉少校的部队，我们自己就能解决这些可笑的维多利亚人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "杀死他们。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "这座小镇里的驻军正在组织反攻，他们的气势......比我们之前遭遇过的萨卡兹都要高涨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "外面的老维斯还有多少炸药？他来得及支援我们吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "估计不太行，除去布设滑索的成员，我们能参与战斗的人员本来就不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "把那几台爬行者都开起来，我们需要强行突围！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "洛洛，小心！你们的滑索！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "好疼——\n没事吧，玛格达尔小姐？"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "你还能走吗？啧，这些恶心的玩意——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "这是大君的赐福，这是鲜血的王庭为我们保留的仁慈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "我们体内......纯净的血脉正在苏醒，别和这些维多利亚人浪费时间了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "洛洛小姐，你先走吧——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "玛格达尔小姐，做好战斗准备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "没那么难，我们以前......也都没经历过战斗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "深呼吸就好，下定决心。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "火炮？我们的炸药不是用完了吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "快，洛洛，玛格达尔小姐，趁现在！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "我们接收到了几位老熟人的联络，他们带来了一支支援部队！他们甚至有个识别码——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "“典范军”！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "这里是战车火力手号角，所有人注意，避开我的轰炸区。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "榴弹填装完毕，第二轮发射！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "突破口打开了，掩护自救军和市民！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "号角，继续压制。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "那些法阵......得想办法让这些巫术玩意先停下来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "维娜，别再让我开车了，我要加入地面部队！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "汉娜，看你前面的路！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "好吧好吧——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "让战车尽量抵近法阵的核心，我来搞定那东西！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "维娜！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你们还有其他的任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "所有人员按照常规部署整队。摩根，汉娜，你们和号角小姐按原计划指挥战车开路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "希勒少尉、达格达、戴菲恩，麻烦你们指挥地面编队组织防线，拦住那些血魔大君的小虫。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "放心。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "收到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "收到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "Misery先生，敌方部队的指挥官交给你了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "你大胆执行你的计划即可。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "费斯特，好久不见，寒暄放在之后。我需要自救军帮我布置滑索到法阵上方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "没问题！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "事不宜迟，先把那个奇怪的法阵给解决了再说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我的背后就交给各位了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "欢呼的市民",
      "text": "看啊！我们维多利亚战车的炮火轻而易举就可以把那些东西轰成碎末！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "欢呼的市民",
      "text": "我们早就说过，那些魔族佬在我们维多利亚的军队面前不堪一击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "欢呼的市民",
      "text": "碾碎他们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "不对，镇上布置的源石结晶太多了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "镇长办公室，小广场，图书馆......我们夜以继日修建那些东西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "不可能来得及——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛格达尔",
      "text": "......结束了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......法阵已经破损，血魔的子裔在失控，抓住机会！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "步兵集团停止前进，护送身边的市民退出法阵范围。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "战车分队跟我继续推进，摧毁镇子里剩余的源石结晶，搜救市民！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
