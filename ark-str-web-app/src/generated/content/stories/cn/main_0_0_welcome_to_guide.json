{
  "server": "cn",
  "storyId": "main_0_0_welcome_to_guide",
  "groupId": "main_0",
  "stageId": null,
  "title": "序章·上",
  "storyCode": "",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/guide/beg/0_welcome_to_guide.txt",
