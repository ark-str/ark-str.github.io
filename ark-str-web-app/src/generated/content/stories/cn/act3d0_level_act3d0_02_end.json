    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "快！博士！我们往沙滩那边走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "沙滩上有大量游客聚集，混进人群里面他们就追不上我们了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保镖",
      "text": "站住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "就凭你们！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "欸，你是——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "黑！太好了你终于来了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "还好有你在，克洛宁这是怎么了！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "博士，她就是我之前跟你说......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "小姐，老爷不在城里，你得听克洛宁的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "黑？你在说什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "快跟我回去找克洛宁，把这些人都交给他。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "我不想对小姐动手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "......黑？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
