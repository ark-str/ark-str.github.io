{
  "server": "cn",
  "storyId": "act19side_level_act19side_07_beg",
  "groupId": "act19side",
  "stageId": "act19side_07",
  "title": "疯狂的信号",
  "storyCode": "DV-7",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act19side/level_act19side_07_beg.txt",
  "sourceHash": "3cb1e9086dc6802b14644644d9a763d79779331514ef2d3df9a024df32aec450",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "你有多久没回来了，塞雷娅主任？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "走神了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "真是难得啊......在想基地里的事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "你还记得海顿一号实验室吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "当然，伊芙利特就是从那地方出来的吧？我们俩还一起去现场调查过呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "类似的废墟，后来我找到了好几百处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "与军方合作风险极高。过去的莱茵生命习惯于躲在层层合同之后，操控其他实验室来进行这些危险的实验。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "可这一回，斐尔迪南选择了自己冲锋陷阵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "这意味着，稍有不慎，莱茵生命就会变成下一处废墟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "要是真的失败了的话......斐尔迪南也会变成躺在废墟里的尸体吧？他的真实死因甚至不会出现在报纸上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "斐尔迪南没有退路了。这次实验，他只能成功。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "你是在担心赫默他们吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "我是在分析风险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "没想到你也会嘴硬啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "好啦好啦，她会没事的，为了伊芙芙，她这些年可是越来越坚强啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "你在安慰我吗，缪尔赛思主任？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "没这个必要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "我从来没有怀疑过赫默和白面鸮的能力。她们会承担起自己的责任，我们也一样。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我们会好好配合的。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "缪尔赛思",
              "text": "我有没有说过，我一直很欣赏罗德岛的工作方式？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我也相信干员们的能力。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "缪尔赛思",
              "text": "哎呀，太会说话了，我开始考虑跳槽了哦。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "塞雷娅越来越有人情味了。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "缪尔赛思",
              "text": "对吧对吧，你也有这样的感觉是吧？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "缪尔赛思",
              "text": "果然，这不是我的错觉。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "......侦测到多具动力甲靠近的信号。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "博士，那位黎博利雇佣兵又追上来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "或者她本就守在附近。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "Dr.{@nickname}，你确定克丽斯腾就在这里吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "塞雷娅说的没错，斐尔迪南承受不了这次失败，可我们也没有试错的时间了吧？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "斐尔迪南不想让别人找到总辖。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "只有一个地方最容易掌控。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "只有一个地方最能掩人耳目。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "......莱茵总部。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "最符合条件的还真是这里啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "在发现联络不上克丽斯腾之后，我去过她家，去过实验基地，还把她最常去的地方都找了个遍......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "所有莱茵职员都知道，总辖极少老老实实待在办公室里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "每天在办公楼里来来回回询问总辖下落的员工们，谁能想到她可能就在我们头顶？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "扫描完毕。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "博士，如你所料，莱茵内部跨楼层的出入通道处有大量武装人员把守。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "目前的莱茵总部应该已在斐尔迪南掌控中。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "包括我与缪尔赛思在内，我们需要小心行事。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......抓住他们。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "糟了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "还愣着干什么？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "全体注意，实验区入口处出现异常情况，一名拓荒者和一名莱茵研究员......唔呃！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "到头来还是得动手伤人，我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......正当防卫。我会为你作证。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "左边有紧急出口，我们往那里跑！先出去再说——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "有人追上来了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "做好准备。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "等等，怎么会是你？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "埃、埃琳娜小姐......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我没有伤到你吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "还好，我猜到您会动手，所以做了一些准备。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "都不许动。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "特里蒙城警察局，玛丽·班纳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我正在抓捕一名犯下绑架罪与故意伤人罪的嫌犯，麻烦你们配合一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "嫌犯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......玛丽。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "要逮到你可真不容易啊，对吧，“领队”先生？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "把你的武器扔到地上，然后举起双手。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "抬起右手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "拓荒队成员",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "请抬起右手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "......注射器？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "等一下，你们打算做什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "身体检查。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "该实验区有危险物质泄漏的可能性，按照规定，需要对所有人员启动预防程序。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "能不能让我看一眼注射药剂？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "情况紧急，麻烦让开。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "白面鸮",
          "text": "警告，流程与以往记录不符。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "你们的这种行为完全不符合规定......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "规定？我不需要一个......被逐出莱茵的研究员来教我什么是规定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "唔......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "那我呢？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "我有没有资格要求你交出注射器？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "弗兰克斯主任......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "我是359号基地的负责人。请立刻向我报告你们的行动目的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......抱歉，主任。本基地的一切事务已由斐尔迪南主任接管。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "没有他的命令，您也无权过问我们的行动。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "我没记错的话，在莱茵生命，只有总辖能够更换实验项目负责人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "斐尔迪南凭什么越俎代庖？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "我也没有办法回答您的疑问。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "差不多够了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "任务完成，全体撤退。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "......走了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "白面鸮",
          "text": "是的，防卫科的人正在飞速撤离基地。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "我本来以为他们要抓走拓荒者们......难道是我误解了斐尔迪南？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "斐尔迪南他......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "拓荒队成员",
          "text": "呃呃呃——！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "白面鸮",
          "text": "赫默医生，接受过注射的拓荒者们全体陷入了昏迷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "立刻实施救援！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "弗兰克斯主任，你知不知道该怎么应急处理......弗兰克斯主任？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "女士，我还以为我们是来救桑尼先生的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "别以为那短短几句话就能让我改变看法！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......你收到我给你写的信了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "博取同情的招数用过一次就没有效果了，罗马诺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我只庆幸没让你逃出去，否则的话，我可不知道还会遇到什么“惊喜”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "你不相信我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我凭什么要相信你？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "四年前，你不想被抓进收治区，我相信了你，帮你四处躲藏——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "然后你是怎么对我的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "我那时候快疯了，矿石病和保险费逼疯了我，我不得不......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你打破了窗户，闯进我的房间，逼我把所有值钱的东西交给你——就为了那该死的保险费，你觉得交够了钱，他们就能让你回去当律师！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你知不知道奶奶受了多大惊吓，在那之后就一病不起？你还记不记得她有多喜欢你，从小对你比对我还要好？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你又知不知道，在你因为害怕而匆匆一走了之后，我是怎么一边担心你被其他警察抓到，一边冒着丢工作的风险替你掩饰......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你什么都不知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你就是个冷血自私的罪犯，我从来都不该对你心软......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "警长！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "不管你们俩有什么前尘旧怨，我们都必须离开这里，立刻，马上——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你在为这个绑架了你的人说情？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "听我说，真正有问题的是莱茵生命......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "这震动......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "呃......是从里面传出来的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......多萝西的实验室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "跑！！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "真的......发生了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "剧烈的震动......影响范围这么大......是天灾？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "不，不是天灾，是实验室......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "实验区的中央，本应无比坚固的建筑物上出现了一道裂痕。\n那并不是震动导致的。\n建筑是被硬生生撕开的——从内部最深的地方。\n有什么东西正在“破壳而出”，一点一点，又无比迅速。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "刹那间，一半楼层都已被吞吃殆尽。\n废墟之上，银白色将整个基地容纳入自己的怀抱。\n新生的庞然大物轻盈地转动着自己几何形的躯干，冷冷地注视着地面上的所有人。"
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "眼前的这一幕并没有超出她的理解。\n她知晓一切的原理，计算过所有的可能性。\n但她依然忘了呼吸，忘了眨眼，忘了脚下震颤的大地，以及周遭呼啸的狂风。\n她一直以来的梦想从一沓图纸、一句承诺变成了活生生的现实。"
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "非常美丽......",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "但也异常恐怖。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "快趴下——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "你刚才站的位置非常危险......只差一点点，你就会被砖瓦砸伤！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "......来不及了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "什么来不及了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "多萝西",
          "text": "医生，你没能真的阻止我。我的实验......还是成功了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "斐尔迪南主任，实验区那东西——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "你很恐惧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "恐惧......呵呵，怎么会？多么震撼人心的成果啊！我、我衷心地为您......和弗兰克斯主任感到高兴。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "你的牙齿正在打颤。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "哈......哈哈......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "很好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "畏惧未知而庞大之物，这是弱小者的本能。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "您说得对，在您的成果面前，我们的敌人......哥伦比亚的敌人都将感到恐惧，并为之颤抖！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "威慑敌人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "这是那帮军人成天操心的事。他们资助我，我给他们武器——各取所需而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "不过你提醒了我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "是时候进行下一个阶段的实验了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......那会不会激怒它？基地里的人都会......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "他们的付出是伟大的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "记住他们的名字。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "作为真正意义上的开拓者，他们将会被载入史册。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "他们用无畏的精神孕育了这头巨大的猛兽，而我们将掌握它、利用它，让它成为我们的双手和双眼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "就像我们的祖先，那些勇敢的开拓者驱使着驮兽，让文明征服了荒野——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我们也将驱使这头由技术创造的猛兽，开拓更多前人未至之境。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "——我们将成为先驱者，拓展文明的边界。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "这......是那些银色怪物？它们变得......如此巨大......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "这些普通的攻击都没有用！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "该死的——怪物！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "你们看到那些箭了吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "先后射出去的三支箭正在整齐划一地逼近银色几何体，它们飞得越来越慢，直到慢得可以忽略不计。\n但它们并没有坠落。\n在银色光芒的包裹下，它们在同一个瞬间消失在了众人的视线里。"
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "......这怪物会变魔术？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "是分解。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "好在它看起来很安静......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "都闪开！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "唔呃......那是能量炮？还是弩箭？从哪里发出来的......速度太快，连我都看不清楚......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "它的移动和攻击方式都无法用常理解释。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "又或者......对它而言，移动和攻击根本就是一回事......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "假设这真是......多萝西实验的最终完成品，那整个基地都被纳入了它的感知范围。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "只要它产生了想法，它就能在瞬间改变自己认知域中的所有物体的物理性质......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "换成好懂一点的说法，我们都成了一个发疯的小孩手里的橡皮泥，是吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......差不多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "不要再攻击它，警长，否则的话，它会在几分钟内把整个基地夷为平地！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "警长，你该不会......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我该不会还带着一批搭载大量爆破物的无人机？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "怎么可能！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "难道是那些莱茵生命的人......他们不会是来帮我们对付这个实验品的吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "当然不是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你们还记得我刚才说的话吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......将整个基地夷为平地那部分？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "已经开始了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "是我眼花了吗？还是那辆吊车......变成了一个规则的球体？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "要不了多久，居住地也会遭殃！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "该死，要是这个基地完蛋了，特里蒙......其他城市的人还都被蒙在鼓里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "他们不知道自己可能会在睡梦中被一群愚蠢科学家造出来的怪物揉成团！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我们必须马上离开这里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......消息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我们得把消息传出去。他早就想好了要走到这一步......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "到底谁要走到这一步？是多萝西·弗兰克斯指使的吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "不，不是的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "——是一个骗了我很久，把我耍得团团转的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "他想把你们拓荒者的遭遇......还有整个基地发生的事情全部抹消。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "莱茵生命的人都有可能站在他那边......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "警局大概也都被买通了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "我打赌没有任何一家媒体敢报道这条新闻。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "埃琳娜小姐，您知道我们该把信息传给谁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......罗德岛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "我这就去找赫默医生。这将是我们本次行动最关键的任务。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "那样的话， 你会被困在这里......你们甚至会有生命危险！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "......我相信博士，也相信您，埃琳娜小姐。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "格雷伊",
          "text": "我们一定能做到。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......相信我？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我能做的事......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "监控站......我得去监控站。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "......需要搭车吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "那边的载具......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我问你们莱茵生命借的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "正好，我也要回去找这次事件真正的犯人。我们应该顺路吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "能不能算我一个？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "不管怎么说，警官，我还是你抓住的嫌犯......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "玛丽没有回答，但是她向桑尼伸出了手。\n一旁的埃琳娜也做出了一模一样的举动。\n桑尼拉住了两只手，跃上发动了的载具。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "警察，拓荒者，研究员——三个人一起冲向基地边缘。\n背后的风沙一路追赶，却没能将他们留下。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
