    {
      "type": "dialogue",
      "speakerName": "齐尔查克",
      "text": "我当时也是这么说开锁工具的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森西",
      "text": "锅打好了！",
