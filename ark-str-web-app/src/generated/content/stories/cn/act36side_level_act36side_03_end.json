    {
      "type": "dialogue",
      "speakerName": "玛露西尔",
      "text": "和你相处的时光很愉快......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森西",
      "text": "放心吧，老夫绝不会让你的付出白费的。",
