{
  "server": "cn",
  "storyId": "main_3_level_main_03-02_end",
  "groupId": "main_3",
  "stageId": "main_03-02",
  "title": "记忆",
  "storyCode": "3-2",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_03-02_end.txt",
  "sourceHash": "73a1c6ca46b9f5e2206458f87353a350a14f635336927ccc8c166dc2c3283ffa",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十四关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你就是米莎吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "......听碎骨他说了好久，今天，终于见到你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......你也是......感染者......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "为什么要加入......整合运动？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我的妻子，孩子......都死在切尔诺伯格人的手里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "乌萨斯感染者的遭遇，比牲畜还不如。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "毁灭切尔诺伯格——？作为复仇，太轻了，太轻了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "他们手上有多少感染者的血？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "米莎——我们被人恐惧，被人愚弄，被人侮辱，被人迫害——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "——只因我们是感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "仅仅是这样而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我，我有些激动，忘了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "伊万，来帮忙接下伤员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "这个废弃矿场只是临时据点，大家在这里暂时整顿一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "等到时机成熟，我们就撤回切尔诺伯格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......亚——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我已经舍弃了那个名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "为什么......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "过去的那个人已经死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "叫我碎骨就可以了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你——是不是有点害怕？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "碎......骨？......为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "呵......你会明白的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "大家知道你流落龙门之后，都自告奋勇的要把你救出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "在龙门，我们也接纳了许多感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "——但你们......在伤害别人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "我不愿意......我不想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "感染者为什么要互相......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "以眼还眼，理所应当。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "乌萨斯人说，对待亲人，就该像春天一样温暖......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "但对待敌人————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "..................",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......你知道吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "不——你——你不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "他们来抓我时，我被拖出了家门去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我看见妈妈她，抓着我的手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你看见的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你一定——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "他们殴打妈妈，妈妈不肯松手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "他们在雪地上拖出一条血路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "如果整合运动......如果感染者能......如果————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "如果能早一些的话，早一些的话！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我们感染者就不用遭遇那么多苦难了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "我......我......我没敢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......我......呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "米莎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "会好的......一切都会好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我不怪你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "当时......谁有勇气呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "但至少现在，整合运动给了我勇气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "亚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "碎骨......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你可以选择，不去相信我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "——即便你相信我们了，你也可以选择，不加入我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "但你是一个感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "整合运动......一定会为了感染者的自由战斗到底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "可你们......摧毁了切尔诺伯格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "有无数无辜的人死去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "——无辜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "呵，谁是无辜的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "切尔诺伯格实行隔离制度时，有谁反对过吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "在我们被拖去矿场，在乌萨斯把我们丢弃在矿场和冻野，任由我们在寒冬中死去时，有谁反对过吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "有谁，站出来，反对过吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "我，我不知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......整合运动有这样两个领袖，他们与乌萨斯战斗了很长时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "他们说过，是有那么些乌萨斯人，也在为了感染者，与乌萨斯抗争。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "但他们不在切尔诺伯格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "切尔诺伯格冷眼看着我们死去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "不，切尔诺伯格乐于看到我们死去！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "切尔诺伯格，是一座理当被毁灭的城市！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "我也遇到过别的帮助感染者的人......他们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "罗德岛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "明明是感染者，却帮助龙门，伤害我们？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "杀死我们的同胞，残害我们的兄弟？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你看不清事实。但你现在该看清了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......对不起，我太生气了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "没事......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......我理解你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "这么长时间以来，你过得......很辛苦吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "大家都过得很痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "而现在，至少每个人都抱着希望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "塔露拉......是她带领感染者，反抗残忍的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "整合运动就是我们的希望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......果然大家，都吃过很多苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "如果整合运动真的能保护他们的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "当然了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "就像整合运动会保护大家......我也会保护你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "再也不会让你受伤了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "————碎骨......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "唔，找到了——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "看来他们的损失不小呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "还好没回公司......不然又要兜一大圈再出来执行任务了呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "预估一下整合运动的撤退路线。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "把大致路线和方位一起，全都发给阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "很快的，马上就好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "——嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "我们可不能让整合运动太闲着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嗯嗯，大概......这样......这里......差不多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "准备好了吗，能天使？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "要做什么？该怎么做？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "先做点热身运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "就从他们的岗哨开始。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
