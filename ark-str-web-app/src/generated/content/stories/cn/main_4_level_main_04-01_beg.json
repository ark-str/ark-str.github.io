{
  "server": "cn",
  "storyId": "main_4_level_main_04-01_beg",
  "groupId": "main_4",
  "stageId": "main_04-01",
  "title": "免费拥抱",
  "storyCode": "4-1",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-01_beg.txt",
  "sourceHash": "cd9d026cd79424778e9e594580f2b784dd68112510ae3aa1a8d3016cbc22d321",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十一关（前）\n8:36 p.m. \\ 雨 \\ 能见度 12公里\n罗德岛"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "你们回来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "详细情况我从侦查小队那里了解过了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "阿米娅，让我检查一下你的手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不用了，凯尔希医生.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我，我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......好吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "还好。戒指没有裂纹，也没有变色。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "下次就不一定了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "听着，阿米娅——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "小心一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "凯尔希医生，我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......我想休息一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "不要再让阿米娅置身这种危险之下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "你也有责任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "你刚回罗德岛的时候，大概也是这种气氛，",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "这种情绪从来没有离开过阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "这不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "......Dr.{@nickname}，你去陪陪她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "别搞砸了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（敲门）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "门开着。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "{@nickname}博士......？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "心事？我吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......被你发现了呀......哈哈......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我以为我一直藏得很好呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "是的，我是有一点心事......就一点点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我已经习惯了这么做了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "毕竟不能增加大家的负担呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "是吧，博士？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......我不明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士......我不明白。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（沉默）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "不，我......我知道我们在做什么。我也知道，牺牲是不可避免的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "可我......我不知道......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "为什么我只能看着一个个可以被拯救的人......在我眼前消逝呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "明明触手可及......也许有时候就差一点点......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我知道我身上的责任......我会继续走下去......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "但现在......我真的好累。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "阿米娅......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "让我一个人静一静吧，{@nickname}博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "谢谢你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "早呀{@nickname}博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "咦，凯尔希医生也在吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "阿米娅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "我这里有一件比较紧急的任务，我需要调用一些人手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "在龙门城外，发现了一块已经被废弃的城区。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "我推测是在切尔诺伯格事件中侥幸逃出的城区之一。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "有必要探索这座城区，发掘更多的有关信息，以及搜救幸存者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "如果是更加严重的情况，譬如，城区中窝藏着整合运动之类，则对我们之后的安排，同样会有更大的影响。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "具体安排的计划书在这里，拿上吧，有时间就看一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "了解。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "哦，还有。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "芙兰卡向我提交了报告，提到了她们需要回黑钢复命的事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "关于龙门贫民区的情况，企鹅物流认为应该与你在贫民区内进行意见交换。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "一些细枝末节的事情，你最好去现场看看。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我知道了，我现在就去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士也一起——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "我和Dr.{@nickname}还有些事情要谈。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我可以旁听吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "不行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我可以捂上耳朵——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "不行，去吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "呜......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "凯尔希医生可不许欺负{@nickname}博士哦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "知道。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "......你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "这么简单的事情都做不到。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "算了，我已经料到会是这种结果。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "阿米娅是一个很坚强的孩子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "但是，过于坚强的外壳，总有一天会被过大的压力碾成粉尘。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "不要让这种事情发生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "如果有下次，希望你能稍微发挥点作用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "——？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "怎么了，那个表情。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "请问，阿米娅的戒指是？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "凯尔希",
              "text": "这与她的身体状况有关。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "凯尔希",
              "text": "如果阿米娅参与了激烈的战斗——",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "凯尔希",
              "text": "——战后，你必须立刻检查她的戒指。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "凯尔希",
              "text": "无论戒指产生了什么变化，都必须向我报告。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "凯尔希",
              "text": "其他的，现在你还不适合知道。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "凯尔希",
              "text": "哦对了，两天后你还需要去检测中心做一次身体检查。别忘了。",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "凯尔希",
              "text": "——去吧。雷蛇在外面等着护送你。",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
