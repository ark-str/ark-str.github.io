  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "可恶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "这里，究竟怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "这边的屋子，也都给我搜干净！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "放开他......不！你们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "反抗？太迟了！可恨的切尔诺伯格人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性",
      "text": "快跑！不要管我......孩子就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "妈妈......妈妈......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警",
      "text": "别管平民！先把阵线守住！这些面具混蛋，人实在是太多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "别让军警闲着！继续打！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警",
      "text": "增援怎么还没到！我们要......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "上啊，上啊！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "怎么回事......？！为什么，为什么整合运动会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "遮遮掩掩这么多年，还是露出本性了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "感，感染者......在袭击乌萨斯人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "为，为什么！感染者这样去骚扰乌萨斯政府的话，会死无葬身之地的......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "不，他们的攻势相当猛烈。这绝对是有预谋的行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "之前我们救出博士的位置，相当机密......就连那里都被他们渗入了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "可能切尔诺伯格各处，都已经遭到了整合运动的袭击。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "啊......这，怎么会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "嘘！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员A",
      "text": "还有逃脱的切尔诺伯格人吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员B",
      "text": "我在搜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员A",
      "text": "一个也别漏掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员A",
      "text": "切尔诺伯格的冷血动物......刻在我父辈身上的痛苦，这次，就让我全都还给你们！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "（咳......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员A",
      "text": "什么声音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员B",
      "text": "在那里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "（唔！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "（他，他们，发......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "（安静！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "（唔......！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "......呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员A",
      "text": "在这儿！找到了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "......呜哇哇哇！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "啊！不，别......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员B",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员B",
      "text": "躲在巷子里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员B",
      "text": "出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "啊，啊啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员B",
      "text": "躲在那里，就有用吗......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "对，对不起！对不起啊！！至少，至少饶了我的儿子！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员B",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......我们应该，立刻突袭整合运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "......阿米娅......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我知道有风险，杜宾教官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "只是，等这些整合运动解散后再行动......会耗费大量时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "何况，谁知道现在的状况，会持续到什么时候......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那么，就应该迅速击溃敌人并转移。我说的，没错吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "——————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "明白了，我服从你的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "各小组，听好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "这些整合运动，还没有意识到我们的存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "记住，果断、迅速地解决掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "Dr.{@nickname}，调集队伍吧，现在是你证明自己的时候了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "现在的局势，可不允许我们有所保留。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "早就该交给我了！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "简单，我会轻松解决的。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "阿米娅，看你的了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......“如果争端能够避免，那我们应当沉默——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——如果战斗是必要的，那就战斗到最后！”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "罗德岛的信条......从来没有改变过！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
