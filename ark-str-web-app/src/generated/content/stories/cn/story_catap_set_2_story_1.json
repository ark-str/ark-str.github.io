{
  "server": "cn",
  "storyId": "story_catap_set_2_story_1",
  "groupId": "story_catap_set_2",
  "stageId": null,
  "title": "改变",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_catap_2_1.txt",
  "sourceHash": "83033f87b1e21d909b28dd65d9e3b08a141729c30dbdc41f7f4816f3b22c8ebe",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔偏远地区\n空爆的家乡"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "就是这里吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "对，就这。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我当初可是在这条街上撒满了金币呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "别贫了，现在不还是条普通的街道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我说的可全是实话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "实话，你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "哈哈哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "唉，别这样嘛，我可是认真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "真的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "好吧好吧，信你一回。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "什么时候回罗德岛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "今天晚上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "够吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "就回来看一眼，半天多足够啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "嗯哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "现在早上七点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "那我就——下午七点左右，在这里等你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "好叻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "一会给你多带些特产。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "你先确认一下自己会不会被抓再说吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "带好终端，保持通讯畅通，有问题立刻联系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "别搞得我和小孩子一样啊，去吧去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "这就嫌我烦了啊，行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "不拿特产来我可不载你回去啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "行啊，到时候给你弄几个本地的枣尝尝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "好，让我看看这鬼地方到底有啥变化。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "镇子边上还是老样子嘛，不过镇中心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "哎呀，看上去花了不少钱啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "要是那死老头子肯定半枚金币都不会掏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "小骑士老爷，或许人还不错？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "小老爷是真不错，我们这儿的日子比以前舒坦多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "哟，几年不见，活得挺滋润啊菲隆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "收到信还知道回来啊，阿莱塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "看你这身，最近混得不错嘛。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你以前可不会直接用名字称呼我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "怎么，把我诨名忘了，还是现在看不起我了，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "是是是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "空爆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "您满意了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这还差不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "你这家伙和几年前也没多大变化嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "出去做啥了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "出去之后找了份卖力气的活干，不过报酬还不错，还能到处旅游。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你呢，在那之后还好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "你是不知道啊，你刚走那阵，老头子把整个镇子都翻了个遍，结果收回去的财宝连原来的四分之一都没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "气得他啊，直接就把税翻倍了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "啊这......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "现在呢，现在还这样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "那倒没有，也就两三个月吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "后来不知道怎的，大城市那儿的调查团来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "也不知道老爷们谈了点什么，之后老头子就再也没出现过，听说是去祖宅休养，不管事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "小老爷来了之后，先把税收改了回去，又在镇里花了大把的钱，才有了现在这个样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "嗯哼，小老爷有戏啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "这样，你难得回来一趟，肯定连路都认不得了，今天我就带你重新熟悉一下镇子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "诶诶诶等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我通缉令还在呢，就这么进去，不合适吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "哎呀信上不就和你说过，小老爷上来的时候就把和那件事有关的通缉令全撤了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "真的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "怎么，还信不过你菲隆兄弟？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "信，怎么不信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你赶紧前头带路啊，我看镇里面都快变成迷宫了，一个人走准会迷路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "对了，你这次回来，准备留多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我们公司的移动舰船正好开过这里，我就请个小假过来看看，今天就走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "出去还变大忙人了？有你的啊空爆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这不收到你的信特意回来看一眼吗？真是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "赶紧的，带路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "好好好走走走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "喏，这儿熟吧，以前我做工的厂房，现在整个重修了一遍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "里面还配了空调，比以前舒服得不是一点半点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "菲隆，问你个事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "咋了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "以前镇子最外面那块地，是种吃的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "现在怎么全是葡萄？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "可不单单只是那里哦，小老爷准备把庄稼地全拿去种葡萄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我们这地好，种的葡萄质量高，能卖好价钱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那吃的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "不会一日三餐全吃葡萄吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "哈，怎么会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "种了葡萄，咱们有的是钱去其他地方买粮食。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "全靠从外头运？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "不得不说城里的老爷办法就是多，现在我们这儿的菜场能买到好多从没吃过的玩意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "啊这样，挺好挺好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（小老爷好像是比老头子靠谱些了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（但不种吃的，万一城里的老爷抬价，怎么办？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "以前啊，城里的厂子东一个西一个，现在小老爷准备把它们整合到一起，等到时候大厂子建完，我们就能跟着小老爷一起赚大钱了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（算啦，这问题太扫兴了，没啥问的必要。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "正好聊到，带你到大厂子里看看怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "听你的，毕竟我在的时候大厂子还一块砖都没垒叻。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "还真大啊，老头子祖宅都没这规模吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "那是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "现在还没建完呢，一半施工一半运作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "等到时候建完，估计全镇子的人都能有活干。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "全......都有？不可能吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "“只要想干活，就有活干。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "小老爷亲口和我们说的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "你还记得小时候喂我们吃萝卜的爷爷吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "秃头那个？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "以前他家里人多，用不着他种田，天天闲得慌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "现在小老爷给他安排了保安的活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "又有事干又能补贴家用，爷爷可高兴了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "是这理没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（但这环境......可不太像个能安心干活的地方......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "不过小老爷没想过把厂子旁边弄干净点吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我们过来那一路，满鼻子都是酸味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "小老爷说了，让我们忍忍，等大厂建好了会一起弄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "他可是老头子的儿子，你还真就每句话都信啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "毕竟托小老爷的福，大家这一阵都过得不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我看是你过得不错吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "哈哈那是，比以前好多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "说不定哪天小老爷把你卖咯，你还得陪着笑脸给他数钱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "不至于不至于。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那你倒是具体说说，小老爷给了你什么好处？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "那可有得好说了，我们找家餐馆坐着聊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "餐馆？我们这儿都有这么高档的东西了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "有啊，便宜管饱味道还不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "有意思，快点带路，我正好有点饿了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "嗝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "怎么样，味道不错吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "啊啊，嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（我还以为是什么豪华餐厅叻。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这不是快餐店兼酒吧吗？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（嗯......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（不过我们这儿以前被老头子收这收那的，吃了上顿没下顿那都是常有的事。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（快餐......好像的确能算是个豪华餐点。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（量大管饱，还不是很贵。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（不过这外头......变化也太大了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "小老爷不会把以前的镇中心全拆了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "啊，是，基本上全拆了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "你猜猜，这家快餐店以前是什么地方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "什么地方......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "喷泉广场？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那现在广场还在吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "拆了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "切，连个参照物都没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我再想想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "法庭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "近了近了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "还不是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "总不会是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（模仿爆炸的动作）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这个吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "对咯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "小老爷这是要把老爷子的痕迹全抹干净啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "连这地方都给重建了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那小老爷呢，小老爷住哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "就那儿，顶楼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "一会你出去看看就明白了，那样的高楼，我们这里可是独一栋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "镇子上有钱和有点名望的人现在都住那儿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你不也赚了挺多的，怎么没搬进去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "嗨，和镇上赚大钱的人比，我还是差了点。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "托你的福，我呢，有了笔积蓄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "老头子还在横行霸道的时候，我把它藏得好好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "小老爷上来之后，我就想着把这些钱拿出来，做点小生意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "不错嘛，你从小就运气好，脑子也好使，一定挣了很多吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "挣？没有......哪那么容易......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "本来小老爷要开工厂，划了一大块地，我就准备在这地旁边开小商店。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "结果店面租好了，小老爷工厂从另外一头开始造。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "钱都付了，我只好咬咬牙，把这店开起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "平常会来光顾的也就附近几户人家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "每年都小亏，亏到现在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "也不知道这工厂啥时候能造过来啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那你还吹小老爷好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "这你就不懂了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "自从那位骑士小姐造访过老头子之后，我们这儿也算是有骑士竞技比赛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "但真正普及啊，还是全靠小老爷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "现在我们不仅有比赛看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "（小声）还有钱赚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "看比赛......赚钱？有这种好事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "怎么没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "（看看手表）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "正好，下午的比赛快开始了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "你票我包了，走，看看去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（听上去好像挺不错。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（但我怎么就觉得，不太对劲呢？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "应该就是这排了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（坐下）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这沙发椅？！呜啊，好舒服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "小老爷还真肯花这钱啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "这室内竞技场可是比小老爷住的那栋楼还要大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "在大工厂造完之前，这地方可就是我们镇上的地标了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "大、气派、舒服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我们能享受这个，不得给小老爷说几句好话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "呵，那倒是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "怎么椅子上还有终端的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "这个啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我跟你说空爆，这个就是我赚钱的秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "怎么说？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "欢迎各位来到竞技场，我是今天这一场比赛的解说员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "首先，有请我们镇子里的好小伙，独立骑士——拉兹！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "拉兹？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这家伙不是给老头子当差的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "怎么回事？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "那天好多人因为你的事被撤职了，拉兹也在其中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "他本来想回家继续种田的，但在和那位高贵的骑士小姐偶遇后，他突然就开始说什么“我想当职业骑士”之类的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "一开始我也以为他在说胡话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "可他是玩真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "在骑士竞技被迎到镇子里之后，他就跑去做镇里第一批职业骑士了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "这家伙本来就长得不错，手上也有点本事，在镇里挺受欢迎的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "当然最主要的还是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "他能赢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "不过今天这一场......不太好说啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "他的对手，将是前辉煌盾工业装备测试员，独立骑士——斯通先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "装备测试员......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "喂喂喂这家伙一看就不好惹啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我懂，别急。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "各位的终端现已开启。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "为选手下注？还是购买投放支援物资的筹码？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "骑士们的命运由他们——也由你们决定！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "终端亮了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "（在终端上一阵点击）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你在干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "别吵，等我一会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "斯通赢面大......但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "拉兹的赔率......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "好，这场还是压拉兹！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "（在终端上一阵点击）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你打了......五千？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这个数字......不是货币吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "是的。现在只是个数字，但出竞技场的时候，终端上打过多少钱，扣完奖金，就得付多少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这样总有人会付不出来，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "付不出来......就得给小老爷打工还债。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你知不知道自己在干什么？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我在押拉兹赢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "只要他赢了，我就能再赚一笔，懂吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我研究过了，虽然数据上拉兹不好看，但他会赢的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我赌他会赢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "如果输了怎么办！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "是，偶尔我是会失手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "但只要我押拉兹赢，他就一定会赢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "你相信他，也相信我，好吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "比赛开始！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "（不再理睬空爆，双眼直勾勾看着赛场。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（菲隆......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（你到底知不知道，拉兹和对手在技巧和装备上根本没得比？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（一个佣兵熟手，打一个有点天赋的乡下大头兵？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（我知道你运气好，但这样......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "拉兹，好，打得好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（上来就用死力气，放杜宾教官那儿可是要吃鞭子的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我告诉你拉兹会赢的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "（在终端上输入了1000）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "好样的拉兹，狠狠揍他！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（他能这样支撑多久呢？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一刻钟后"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "拉兹，你怎么就拼不过那土老帽了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "别，别后退啊，我现在就给你打支援物资！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "（在终端上一阵点击）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（对方开始反击了......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（等等？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那个外乡人怎么在往死里打？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "这、这一场本来就是，无、无限制的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "啧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我的钱......我，我的钱啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（打开联络终端）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（小声）喂听得到吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "收到，怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "你要被捕了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（小声）差不多吧，你准备一下，把车开到镇中心那个竞技场旁边。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（小声）有信心活着开出去吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "......收到，担心我还不如担心你自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "保持联系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（小声）谢了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（填充弹药）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（给武器加压）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "拉兹，拉兹你不可以输！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "你死不要紧我的钱怎么办啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "给我让开！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这个距离打中还不误伤......有点悬啊......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（瞄准）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（不管了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（拉兹，你这老好人没必要死在这种地方。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（把欠你的人情还掉，我对这鬼地方也就没什么好留念的了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（外地的傻大个，再给我靠过来一点啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（扣住扳机）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（屏息凝神）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "精彩的一击！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "斯通先生在即将获得胜利的时刻突然回头望向观众席。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "我们好小伙则抓住了这个机会！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "举剑直刺，一招制敌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "真是教科书般的绝地反击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解说员",
      "text": "独立骑士拉兹——获得胜利！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "赢，赢了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "赢了！赢了！！我又赚了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "我跟你说什么来着空爆，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "只要我买拉兹，他就一定赢。一定赢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "哈哈哈哈哈哈！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（收回武器）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲隆",
      "text": "空爆，空爆？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "喂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "到了，看右面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "看来最坏的情况没发生嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "好事好像也没发生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "卡西米尔其他地方都是这样的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "如果你指的是骑士竞技和竞技场的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "现在几点？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "差不多下午五六点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我们随便找个地方吃点东西，买点特产，然后就回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "离这鬼地方越远越好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "*卡西米尔粗口*",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "哼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "先上车吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "后面那个捧着一袋子钱想要追上来的，是你朋友吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "只是有点交情，不太熟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "开快些吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "我倒觉得没必要，他装钱的袋子破了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "回头捡钱去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "（打方向盘）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "好像是回头了，怎么，你还想看看？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "没什么好看的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "啊——好饿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我们吃饭去吧，兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "这不已经上路了吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "放心，空爆，我研究过了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛外勤干员",
      "text": "餐馆马上就到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
