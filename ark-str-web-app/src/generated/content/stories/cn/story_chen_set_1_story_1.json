    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我没想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民区居民",
      "text": "我知道你不是。",
      "portraitKey": null
