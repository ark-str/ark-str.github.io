    {
      "type": "dialogue",
      "speakerName": "贫民区居民",
      "text": "我求你，陈警司。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民区居民",
      "text": "你是个好人，我不想你出事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民区居民",
      "text": "你发个消息，让那些阿sir都散了，别来了。",
