{
  "server": "cn",
  "storyId": "act14side_level_act14side_04_end",
  "groupId": "act14side",
  "stageId": "act14side_04",
  "title": "立雪求道",
  "storyCode": "BI-4",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act14side/level_act14side_04_end.txt",
  "sourceHash": "a3f07c4ed5fdfd6fde6c66ae113820482f0f1a437d68ef2cee698723894bedc5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "老爷，喝口热水吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "从昨天开始您就滴水未进，走了这一路，之后还要参加狩猎，这......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "不必了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "这是我的决定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "不要让我说第二次，角峰。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "别再说了，角峰大哥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "老爷的脾气你应该最清楚，明知老爷肯定不会接受，又何必这样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......至少我得试试。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "老爷他......太冒险了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "风险与机遇并存，一直不都是这么过来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "我们只需要听老爷的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "真冷。这雪是不是越来越大了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "真慢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "要我们两家一起等着他，好大的排场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "他一路步行而来，这倒确实不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "真稀奇，你竟也会夸他？听说这一路上，恩希欧迪斯是被交口称赞，受欢迎得很啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "阿克托斯，你可要小心点，说不定再过几天，耶拉冈德最虔诚的信徒就要从你阿克托斯变成他恩希欧迪斯了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "风凉话就免了，菈塔托丝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我虽不信任恩希欧迪斯，但他若做得对，我便说对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "如果你把我喊过来就是为了说这些，那就恕我不奉陪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "我也没有那么闲，阿克托斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "我只是要提醒你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "提醒？有什么事是需要你菈塔托丝来提醒我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "你认为没有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "阿克托斯，逞口舌之快对我们都没有好处。在当下，我们两家之间才是最牢固的盟友关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "逞口舌之快的恐怕不是我，菈塔托丝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我不喜欢你和恩希欧迪斯的那种弯弯绕绕，我一向只看行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "你只看行动，那正好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "那我们就谈谈两天前的那场爆炸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "怎么，难道菈塔托丝你要承认那是你布朗陶家所为？哼，我可不信，这事不是你的风格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "还是说，你知道主谋是谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "......我要是说我知道呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "——此话当真？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "绝无虚言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "阿克托斯，你要不要猜猜，我们的这位援兵究竟会是什么人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "莫希，莫希！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "人呢，跑哪儿去了......？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "夫人。您找我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "我找没找你，这还用问吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "平时你不是挺机灵的，怎么偏偏在这种时候瞎跑！我明明说了这次狩猎一定要好好准备......算了，你准备得怎么样了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "我可实话和你说了，莫希，你是我手下最可靠的战士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "这次我能不能给布朗陶家争光，让菈塔托丝那个臭女人没话可说，可全都看你的表现了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "夫人，恕我直言......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "你有什么想说的就说，别扭扭捏捏的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "属下认为，夫人若是真的有心在这次仪式上有所表现，令菈塔托丝夫人对您刮目相看，只将目光放在狩猎上，或许还有所不足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "这我也知道......但除此之外还能怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "菈塔托丝那女人总会把一切都想好，半点空间也不给我留。哼，就算我承认她比我聪明一点点好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "但我也......我也不是个废物！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "所以这次不管怎么样，你都一定要给我大出风头，莫希！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "让我们一起压一压菈塔托丝那个臭女人的气焰，我一定要让她好好瞧瞧我的厉害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......我明白您对布朗陶家的心意，夫人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "既然如此，您就更不能只盯着狩猎本身来考虑这次的行动了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "那你说说，我们还能干点什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "如果夫人相信我的判断——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "你这说的什么废话，我不信你还能信谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "感谢您的信任，夫人。那么就请将此事交给我吧，我有一些想法......但需要见机行事，目前我还不能妄下结论。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "以及夫人，为了行动能够顺利，此事最好也不要对尤卡坦老爷提及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "连尤卡坦也不行？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "也对，那家伙总是当我是个小姑娘一样拦着我做事，还和菈塔托丝告密，别以为我不知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露丝",
      "text": "那就全都交给你了，莫希！一定不要让我失望！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "当然，请您放心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......届时，属下一定会让您大出风头。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "“响铃之音来自祂最澄澈的心灵，爱祂的人无不垂首聆听，而耶拉冈德注视着所有虔诚的子民。”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "——听。整点的铃声刚刚响起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "您险些就来迟了，恩希欧迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "请您原谅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "通向真知的路总不好走，这一定也是耶拉冈德给予希瓦艾什的考验。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "从图里卡姆出发，步行来到喀兰圣山，确实是辛苦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "但......希望您真的能够找到正确的道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "有圣女大人的这句祝福，前路已然明朗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "正如此刻，我正朝耶拉冈德的教诲而去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "您的口才当真出众，恩希欧迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "过誉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "这次竟劳圣女大人亲自接见，诚惶诚恐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "恩希欧迪斯大人摆出如此阵仗，我又怎么敢驳了您的面子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "大长老现在何处？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "大长老在做祭拜的准备，我就出来迎接您了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "这次圣猎，我将遵循耶拉冈德的旨意，与各位共进退，完成这场仪式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "您是说......您要亲自进入猎场？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "怎么，恩希欧迪斯大人也认为我的决定过于轻率吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "......绝无此意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "我只是感慨——看来圣女大人已逐渐有了身为三大家族统领者的自觉。这是谢拉格之幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "只是做我分内之事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "侍女",
      "text": "圣女大人，恩希欧迪斯大人，圣猎即将开始，请尽快移步......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......时候是差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "请随我来吧，恩希欧迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "圣女大人请。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "恩希欧迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "有何吩咐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不论您的路是否走对，谢拉格总有它自己的方向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "没有人能够替所有耶拉冈德的子民做决定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "您所言......亦正是我所想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "功过是非自有他人评判。事到如今，义理俱成，我断无退却之理。我之所为......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "——不过尽人事罢了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "耶拉冈德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "本代圣女在此宣誓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我将带领谢拉格最优秀的战士，揪出躲藏在群山之中的山雪鬼，将其消灭，为谢拉格带来安宁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "耶拉冈德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我阿克托斯，将一如既往，带领我佩尔罗契家的战士，跟随圣女揪出躲藏在这群山之中的山雪鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "并且带回最丰盛的猎物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "耶拉冈德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "我菈塔托丝，将一如既往，带领布朗陶家的战士，跟随圣女追击躲藏在这群山之中的山雪鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "并且带回最精美的猎物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "耶拉冈德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "我恩希欧迪斯，将一如既往，带领希瓦艾什家的战士，跟随圣女围剿躲藏在这群山之中的山雪鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希欧迪斯",
      "text": "并且带回最狰猛的猎物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "愿信仰归于耶拉冈德，繁荣归于谢拉格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大长老",
      "text": "......愿信仰归于耶拉冈德，繁荣归于谢拉格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三家家主",
      "text": "愿信仰归于耶拉冈德，繁荣归于谢拉格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "在场所有人",
      "text": "——愿信仰归于耶拉冈德，繁荣归于谢拉格！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "各位，清点行装。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我们出发！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
