{
  "server": "cn",
  "storyId": "main_3_level_main_03-05_beg",
  "groupId": "main_3",
  "stageId": "main_03-05",
  "title": "呼叫",
  "storyCode": "3-5",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_03-05_beg.txt",
  "sourceHash": "62d529c4b9bcd3d3628831fe6175dadf7284acf84da6e2c3205ca1919982a52b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十七关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "{@nickname}博士......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我......我不是......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "雾散了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "近卫局发来通讯，他们发现了更多整合运动的踪迹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "说是在跟踪一个敌人，女性，白发——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "阿米娅，老陈催促我，让你......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "——你脸色不太好。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "交给我吧",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "那......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "那就交给你了，{@nickname}博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "最好能在五分钟内出发。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——{@nickname}博士——",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你是在害怕吗？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "啊......？我......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "博士......我没有在害怕什么......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "当然，我害怕，害怕再一次失去......所以才......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "不，我只是不想的......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......难道说，你不喜欢这种力量？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我......我不知道......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我不知道该不该这么说......但我......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "它不应该光是......伤害别人。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我不想让博士看到我，这么近的看到我......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "......夺走生命。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "阿米娅，没有必要后悔。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我没有后悔。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "不，我是说......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我就是会为了博士而使用力量，无论他背负着什么，我不后悔杀死他。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "但是，当然......原本，应该会有更好的办法吧。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "因为没能找到那个办法，所以他死去了。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "这一点......我很后悔。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我不希望......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "不希望{@Nickname}你看到这样的我。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "明明说着让这片大地的感染者从痛苦中脱身......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "关键时刻，却还是要一次又一次的，说服自己，去剥夺感染者的生命。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我真是，太弱了。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅，至少你保护了我。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......这是我应该做的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我明白了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我从来都不认为，有什么事情真的命中注定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "只是，无论如何......无论我会走到哪一步......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我都会保护你的，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我保证。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "不行！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "你们先走！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "我得去......得去把碎骨救回来！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "你疯了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "你这是自投罗网......要去，就大家一起去！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "我可不能，不能让他在这荒野中......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "那就上吧！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "怎么会——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "整合运动......折返了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "他们要做什么——？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "星熊警官！快回撤！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "近卫局，别懈怠！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "准备好防御对方的攻击！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "掩护！掩护我！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "那个女人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "不行，那个女人的盾，我们是越不过去的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "快！迂回！趁他们还没反应过来......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "先把碎骨，把碎骨——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "把他抢回来！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "罗德岛！他们在转移目标，你们要注意！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "不好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "星熊警官！小心你的右边！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "——嗯——？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "呼呼，用盾挡开了？有些意思——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "爆炸？整合运动的偷袭？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "当然不止是偷袭哦~",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "就请你在这里乖乖呆着，别向后去了哦？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "啧——哪来的混蛋！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "又是爆炸！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "阿米娅！我遭到整合运动远程火力的压制！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "其余的整合运动，正朝你们的方向快速移动！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "唔，这面盾还挺厚实的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "我似乎有点自找麻烦的意思呢......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "算了，就当我帮整合运动一点小忙吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "要让我看到有趣的事情哦。可别让我太失望了~",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "是切城的那个叫W的人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "难道说，陈长官他们被她甩掉了吗？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "小心敌人的突袭！迅速援护星熊警官！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "还有很多敌人埋伏在周围！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "只有暴露他们的踪迹，我们才能取得优势！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士！请指挥各小队应对敌人的袭击！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
