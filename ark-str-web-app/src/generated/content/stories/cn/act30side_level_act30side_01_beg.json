{
  "server": "cn",
  "storyId": "act30side_level_act30side_01_beg",
  "groupId": "act30side",
  "stageId": "act30side_01",
  "title": "注意事项",
  "storyCode": "RS-1",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act30side/level_act30side_01_beg.txt",
  "sourceHash": "394845304779060f26b1c20cca6a023c7432ad0e56ddf6370d2434ac530c64ab",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "身手矫健的山雪鬼",
      "text": "嗬！哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "气喘吁吁的山雪鬼",
      "text": "呼......呼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力尽的山雪鬼",
      "text": "哈......！嚯啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斗志昂扬的山雪鬼",
      "text": "吃我一招！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "众山雪鬼",
      "text": "哈啊——！冲啊——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你们都没吃饭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "再来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力尽的山雪鬼",
      "text": "老大，不、不行了，真的不行了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "站起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "我是怎么教你们的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "站起来，抓紧你们手里的武器！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斗志昂扬的山雪鬼",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "气喘吁吁的山雪鬼",
      "text": "呼......呼......嗬啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "速度太慢。力道不足。法术太仓促。战术太死板。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "也就有些默契罢了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "总体还是太弱。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "身手矫健的山雪鬼",
      "text": "那哪能和老大比......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力尽的山雪鬼",
      "text": "哈......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力尽的山雪鬼",
      "text": "能让老大夸一句，这段时间的训练也算值得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斗志昂扬的山雪鬼",
      "text": "还不够！迟早有一天，我也要像老大那样，能单手切碎山石！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "气喘吁吁的山雪鬼",
      "text": "就凭你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "看来你们休息够了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "那就再来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "众山雪鬼",
      "text": "啊——？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的山雪鬼",
      "text": "老大！不好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "不要慌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的山雪鬼",
      "text": "呼......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的山雪鬼",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "发生了什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的山雪鬼",
      "text": "啊，大事，出大事了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的山雪鬼",
      "text": "山下那边忽然见血了......我们都应付不来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的山雪鬼",
      "text": "十万火急！老大你快去看看吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "哇！开车了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "哈哈哈哈哈！妈妈快来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "——哇！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母亲",
      "text": "都告诉你别在车上跑这么快了！伤到哪里没有？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "（摇头）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "妈妈，你看，是戴奇怪帽子的外国人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母亲",
      "text": "怎么说话呢！不许拿手指着别人，圣女大人不喜欢不礼貌的孩子，还不快道歉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "对不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母亲",
      "text": "哎，这位先生，真是对不起啊，孩子不懂事......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "没关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "借过一下。前面是我的位子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（车厢内的总人数明显超过定员。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（当地平民和观光客的人数基本持平，唔，作为观光列车，这倒是少见。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（最后排靠墙角堆放的麻袋有点古怪......麻袋内有异动，是违规携带的活物？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（唔，没有其他异常，也没有值得在意的人物......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（情报只指向开往银心湖的列车，实际线索果然没有那么好找。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（还是得找个机会去包厢检查一下......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚咚。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "从刚刚起，椅背后方就一直传来异动。\n谢拉格的列车上，难道有什么专门踢人椅背的怪兽吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚咚咚咚咚。\n像是对他的无反应感到不满，椅背又被连环踢了好几下。\n片刻之后，坐在后排的孩子探出头来。"
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "怪帽子叔叔，怪帽子叔叔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "叔叔，你是不是特别喜欢坐车呀，前两天我也看到你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "......你见过我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "见过！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "叔叔，你是不是之前没见过铁轨和火车，所以才特别喜欢坐车啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "咳咳。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "叔叔你怎么还咳嗽了呀？别害羞，我不会笑话你的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "我们这的火车可好可厉害了，我也好喜欢啊！我妈说，都是圣女大人和恩希欧迪斯老爷厉害，是耶拉冈德保佑我们呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "淘气的小孩",
      "text": "不如......我把我的小火车玩具借给你，我们一起玩开火车游戏吧，叔叔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母亲",
      "text": "玩什么玩具！你乖乖回来坐好，别去烦人家！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母亲",
      "text": "实在不好意思啊，先生，打扰你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母亲",
      "text": "这孩子就是欠教训，我一定好好管教他！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "不，没什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（这顶帽子......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外国佬",
      "text": "（看起来很奇怪吗？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "今天的乘客可真不少，新建成的耶拉冈德像看来确实是很受欢迎！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "每次上车我都觉得，卡西米尔骑士竞技的比赛现场——\n哎哟！有什么东西在攻击我的脚趾！"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "这是......羽兽？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "出逃的羽兽",
      "text": "（用力啄咬）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哎、哎哎哎，羽兽兄，高抬贵“首”......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "欸！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "就这么把它给放了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "没问题吗？我怎么记得车上好像说是不给带宠物的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "规矩是这么定的，不过呢，有的时候不会查得太严，也算是给有需要的老乡们行个方便嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "放心，这种羽兽一般都会用麻袋装着，不会出太大问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "不说这些。来吧，女士，我订的包厢就在前面。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "呼......哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "挤死我了，终于又能坐下来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "没想到这趟车的坐票这么难买，这次真是多谢你帮忙，大叔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "举手之劳，女士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "对我不用这么客气，也别女士女士的了，叫我罗莎琳就行。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "那么恭敬不如从命......\n“罗莎琳”，这是一个很适合你的名字。非常动听。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嘿嘿，好听吧，是我妈取的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "大叔你叫什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "你可以称呼我为哈洛德。当然，继续叫“大叔”也没问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "你的运气不错，罗莎琳。如果错过这班车，恐怕就很难在天黑之前抵达银心湖了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "真的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嘿，幸好最后还是赶上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哈洛德也是要去银心湖吧？你是要去干嘛来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我想我已经回答过这个问题了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "谢拉格的风光如此壮美，我当然是要去一饱眼福的啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我可不会被骗到，你们这一大群人，看起来一点都不像是来观光的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我们看着不像观光客吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "不太像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "呃，更像是来找茬的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "啊，哈哈，找茬？绝无此事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我可是已经被谢拉格的风景人文迷得神魂颠倒，甚至开始考虑退休之后要不要干脆来这里养老了呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "嗯，嗯，只要不出大问题，我们当然就可以是观光客......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "那要是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "——那你呢，罗莎琳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "在游客里，你的谢拉格语算是说得很不错了，这是你头一次来谢拉格？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "你这话题转移得也太生硬了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "算了。我没有说过吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我勉强算是半个谢拉格人吧，虽然我自己完全没什么感觉啦，我是跟着我妈在乌萨斯长大的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哦，令堂是乌萨斯人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "对。不过我妈告诉我说，我是在谢拉格出生的，我爹是个谢拉格人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "小时候的事我记不太清了，要说是旅行的话，也算是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "唔，原来如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "这么说来，从见面起我就一直想问......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "罗莎琳，你一直抱在怀里的盒子是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "这是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "抱歉，如果有冒犯到你的个人隐私，你可以什么都不用说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "没事。也没什么不好说的，我只是在想该怎么说......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "这是我妈托付给我的......遗物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "这......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "请容许我表达哀悼之情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我很抱歉提及你的伤心之事，罗莎琳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "节哀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嘁，我有什么好伤心的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我这次回来，就是为了完成我妈的心愿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶驮兽的牧民",
      "text": "锏小姐，这......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "已经没事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "该解决的，我都解决了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶驮兽的牧民",
      "text": "多亏了您......锏小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶驮兽的牧民",
      "text": "不然谁知道会变成什么样，耶拉冈德在上，都是活生生的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "我只能做到这一步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "抱歉。场面......不太好看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶驮兽的牧民",
      "text": "唉，现在也只能这样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "text": "老大，你身上的血迹要不要处理一下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "等会再说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "时间紧急，虽然我处理过，但难保后续不会再出问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "现在最要紧的是找到“那个人”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "text": "可是老大，我们接到消息，对方现在已经离开车站了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "text": "如果现在去联系铁路的人停车，恐怕会引起恐慌......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "停车？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "没必要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "text": "那还能怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "你看下面。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "text": "这是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "text": "列车马上就要通过下面的山道了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "text": "等等，老、老大？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "她落下的身姿似比雪还要轻，又像比石更重。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "让我看看......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "人会在哪？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
