{
  "server": "cn",
  "storyId": "main_1_level_main_01-07_end",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "暴君",
  "storyCode": "1-7",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_01-07_end.txt",
  "sourceHash": "654d439cb575f84fda8ce80e49a2183702b295bbe7bff2888d4219c988046d23",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "哈，哈，哈.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "成功了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "我们不仅击退了整合运动......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "灾势也在以肉眼可见的程度衰弱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "情况太糟糕了......各位还是要多加小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "天灾......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "原本的街道都被倒塌的废墟掩盖，被摧毁的建筑，形成了障碍物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "源石，已经开始疯长了吗......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "明明到了最后关头，所有事情却都在阻挠我们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "如果我们能——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "......能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "什么来了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "整合运动？他们追上来了？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "那么多的......整合运动......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "他们......不是追上来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "他们是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "——从各个地方涌了出来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "广场，坡道，建筑......四处的废墟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "这个数量，呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "难怪除了那些真的要被砸成泥浆的人以外，他们一点都不惧怕天灾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "哪怕天灾，说多些.......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "已经消灭了他们一半人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "剩下的也够把我们在这里淹死十几次了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "别停下脚步！继续顺着撤退路线行动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "在开阔地带停下等于找死！至少到达广场出口处之后再整顿队形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "临光......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "必须战斗。破开突围口以后，趁对方队伍混乱立刻脱离。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "能行吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "希望渺茫，但我们没有别的办法。只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "即使是数十倍于自己数量的敌人，如果只是些暴徒，罗德岛依然有机会！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "无需惊慌！备战姿态！防御阵形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "......啧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "这样的数量，如果要拿下切尔诺伯格，也许......真的有可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "实在......太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "整合运动究竟......是从哪里纠集起这么多感染者的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "这种包围网......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "整合运动是真的，很看得起我们啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "大，大群整合运动敌人......包围了广场！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "敌人停止了行动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "有敌人一名，正在靠近罗德岛的阵线！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "为什么，那个人会一个人，走向我们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "难道敌人派出了使者？不可能......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "她......她是资料上，整合运动的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "她身上，有某种气味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "......临光......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "我不清楚，但是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "那是......钢铁和硫磺的味道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "有什么东西在焚烧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "如果是火焰的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛的各位干员......最高警戒状态。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......她就是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "整合运动的暴君......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......塔露拉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "大概......是能烧尽整片大地的火焰吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
