{
  "server": "cn",
  "storyId": "story_fmout_set_1_story_1",
  "groupId": "story_fmout_set_1",
  "stageId": null,
  "title": "占卜",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_fmout_1_1.txt",
  "sourceHash": "b0f5171e185007dbdecc7a127db582a83e916a0da1f79e164a64e9505d19a8da",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 远山"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "周末\n罗德岛食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "总之，只要像这样——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "牌就能很自然地从手中像水一样落下——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "掉在手上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "学会了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "还没有！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "远山姐姐再表演一下嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "哼哼，那，看仔细了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "好——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "都看清楚了没？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "没有——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "但是很遗憾，今天的牌艺课已经结束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "呜——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "再玩一会好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那一会下一位在这里上课的老师就要对我生气了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "大家也不想我被别的老师骂吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "就一会，就一会嘛，不会有事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "规矩可是很重要的，不能因为自己的欲望就随意舍弃它哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那么，给大家布置一个作业吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "如果有人可以在下周上课的时候给大家表演一下自己的练习成果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "就能从老师的百宝箱里抽一个奖励。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "百宝箱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "真的吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "真的哦，老师前两天刚刚在百宝箱里加了点好玩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "只要能鼓起勇气给大家表演，每个人都有份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "好啦下课，别忘了带好自己的牌和玩具。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我们下周见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "再见老师！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "呼——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哎呀，真是辛苦您了呐，课程还顺利吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "说是上课，其实也就是陪孩子们玩乐而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "倒是你身上的担比较重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "要教孩子们算清楚加减乘除，也是件费脑又费力的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "其实也没那么麻烦，算久了就懂了嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "而且我教的也不算数学，嗯，当初取的什么名来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "“经营兴趣班”？好像是叫这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哎呀其实和你一样的啦，只管玩不管学。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那可是件好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "毕竟做生意可是很残酷的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "你可真了解啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "虽然并非本意，但占卜本质上也是种生意啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "你说的是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那我就不打扰你布置教室了，再会。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "对了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "远山老师，请稍等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "还有什么事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "是这样的，您看，博士最近好像要和嘉维尔他们一起出趟远门，去萨尔贡的一个角落里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "嗯嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我呢，准备跟着一起去逛，看看能不能顺带做点买卖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "了解了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "所以啊，那个，能不能通——融一下，帮我算算？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你应该知道——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这个自然会有的，只是，嗯，那什么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "钱都拿去进货了哈，现在手上真的没有余额。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我不取钱财当报酬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "真的？太好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "但是我需要你一个承诺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你要向我承诺——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "上课的时候不可以给孩子们推销东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "即使是零食，也不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "啊，哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哎呀怎么会呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "就算上课是玩，但我也有好好教学的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "有，或没有，都与我无关。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我只是需要你的承诺作为代价。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "如果反悔的话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "谁知道呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "意下如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你的代价，我收下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "不用契约书......之类的东西吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我们的约定建立在彼此的信任上，不需要契约。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那么，开始吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "考虑到一会还要上课，我们就用简单点的占法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "（取出塔罗）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哇，这，这工艺？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "感觉每一张都能卖个好价钱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这个把牌在桌上摊开以后转啊转的，是在洗牌吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "啊啊，请稍等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "直接像你课上那样花洗也可以吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "有些占卜师的确会这样行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "但那太伤牌了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "就像在暴风雪中执拗前行的旅人，无论身体如何健壮，衣物如何保暖，温度终究会被一丝一丝抽掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "等到失温的那刻，再行补救终究无济于事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "啊哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "只是个萨米人比较常用的比喻，我想你能理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "是是，我懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "嗯，好了，它们应该能为你解开些迷惑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "把牌收拢好，切一下，然后从你切的位置放三张牌下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "切记，先别翻开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那远山你岂不是啥都没做嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我只是为你解谜，自己的命运难道不应该由自己揭开吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "还是说，你乐意将命运交予他人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好吧我知道了，我自己来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "收拢好......切牌......把三张牌背面朝上放在自己面前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这样就行吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "动作很干脆，看来你并不迷茫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那么，请吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "以自己的想法翻开卡片。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "总觉得你一本正经的，我也要有压力了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "没什么好怕的，来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "翻开第一张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "（翻牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "金杯的骑士，逆位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我不太懂，正逆有什么关系嘛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "简单来说，逆位牌表明你现在受到了阻碍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "放轻松，所谓阻碍，并不是一件全然的坏事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "只是现在无法成功继续下去而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "突破阻碍，成功或许就在不远处了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "是这样啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "让我仔细看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你是在经营上遇到问题了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "呃，算是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "基本上每个月都是这样呢，有时候决策做错了就没钱赚，很头疼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "可能看见过机会，但没抓住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这种事对于做买卖的人来说天天都在发生啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "所以这次准备孤注一掷了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我相信直觉，去嘉维尔老家一定能赚笔大的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "原来如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "根据我的了解，罗德岛采购业务方面其实一直缺人手，只要你肯帮他们干些活，钱不成问题，风险也大多会由罗德岛分担。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "为什么要选择独立经营呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这个嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "习惯自己单干啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "看来你的决策并非完全逐利呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "也没你说的那么大，就是见识下世面顺便挣些钱补贴家用啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好东西总是要花钱的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那这个，这个牌，简单来说，是不是就是不太好啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "是过程不会太轻松。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那我会不会就——远山——救救我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "别急，这只是一个开端。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "来，翻开第二张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "呜呜，好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "（颤抖着翻牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "权杖一，正位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "会，会是什么呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你抓住了机会，准备从中再次获得自己于生命中的优势。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "虽然很危险，但是你信心满满向生活发起了挑战。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "听上去像是好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "以前我为自己占卜的时候也曾翻到过它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "唉——你们也会为自己占卜的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "在某个灵光闪现的时刻，占卜师完全可以窥探一下自己的道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我还以为占卜师只会收钱给别人办事呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "金钱终究解决不了所有问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "并且，有些道路，外人是无法干涉的，只有通过与自己的谈话，去摸索，去探求，才有机会寻到端倪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "还挺复杂的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "就像可颂你选择以自己的力量做买卖。所有决策，任何选择，都是多年商业经验的结晶，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "他人能给出的只是建议，决定权永远在自己手中——就像现在这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "即使三张牌都是最坏的结果，你真就会改变决策吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "钱都花了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "所以你只是来求个安慰，希望我能说出一个听上去舒服的结果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "啊不用回答我，很多人都是这样的，我非常理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "大家在举棋不定的时候，总会希望有什么不实在的东西来解决一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "可惜，我并不是你们所期盼的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我所能做的，只是浅窥前路，并奉上力所能及的帮助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你支付了报酬，我就有义务竭尽全力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "仅此而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "远山......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "让我们继续吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你会经历冒险，但旅途似乎并不会平静。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "至于结果，我们可以期待最后一张牌所揭示的答案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "尽头说不定连一张龙门币都没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "感觉越来越危险了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我只是说了一种较坏的可能性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "真的赚到钵满盆满也并不是没可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "真是这样就好啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那我到时候要去调香师那里做一整套的香氛助眠疗程。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "账单就拜托你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "赚到钱我就帮你付款！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "哼哼，一言为定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那么，让我们来探索你这次旅途的终点吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "最后一张牌，请。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "（唰地翻开塔罗牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "双月，正位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "是正位啊，还好还好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "这可......不好说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你......有没有了解过嘉维尔老家的情况？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我调查过萨尔贡市场，这些绝对好卖的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "如果是这样，那最好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "（会不会有不是寻常萨尔贡市场的可能性呢......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "（正位双月......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "旅途不会平静，前面的牌也都预示了这一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "小心被蒙蔽、小心被欺骗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "我的意见是，如果可以，请谨慎行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你喜欢月亮吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "喜欢也算不上吧，不过烦闷的时候在甲板上看看月亮，心情是会好些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那月影呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "嗯，有人会特别去看影子吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "在月亮的光辉之下，经常有东西会被忽视。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "这张牌揭示的东西，也是如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "总有东西会被光辉遮盖，会被刻意隐藏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "是福是祸，需要自己仔细斟酌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好，我会注意的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "这张牌所要展示的，应该就是这些了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "结合三张牌向你揭示的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "可颂，你的未来并不轻松。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "至少跟着博士一起出发的这次旅行，阻碍很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你自己有这样的感觉吗？比如心里隐约的不安和迷惑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "有一点吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "但，撑一撑应该能过去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这个，牌里有说我投资必失败吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "没有，再者塔罗也从不会出现言之凿凿的未来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那我应该还有救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "实在不行，敲个储蓄罐应该还能撑几天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "但愿如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "占卜的话，到此就结束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "还有什么需要我做的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "远山，你也抽一张吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "你刚刚不是也说了吗，占卜师自己也会占卜的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我想看看你运气怎么样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "但那是在我准备——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "来嘛来嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "塔罗可不是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哎呀别管了抽嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "（“请”远山抓了张牌。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "来嘛，翻开吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "等等，我准备一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "（翻开塔罗牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "圣杯十......逆位......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这个是不好的意思吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那我把它倒一下——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "等等别碰牌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哦好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "对不起啊远山。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "不对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "牌的正逆以翻牌者为准。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "所以这张牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "是正位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "对喔！你坐我对面！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那这个牌，是不是好的意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "对我的职业和人际关系来说，很不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "（抓住远山的手蹭了几下）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "让我向你借一点好运吧，这样我就能回本了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你要是这样坚持的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "请随意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "呜呜一定要让我回本啊啊啊啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我突然想到一个事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "如果我借了你的运气，那刚刚的占卜是不是全都不算数了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "谁知道呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "原来没有这种规矩的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "需要再占卜一次的话，可要重新支付报酬哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那还是算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "我多蹭几下，应该不收钱吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "哼哼~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "就算给你打个折，不收钱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "谢谢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "五分钟后"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "可颂老师，我来啦！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上课的小干员",
      "text": "远山老师也在啊，您好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "哦噢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你们好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "那么，我先走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "祝你赚到的龙门币能填满整个罗德岛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "下次有东西要买记得找我啊，我给你打个大折扣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "时运可是千变万化的，到时候再详谈吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "（挥挥手离开）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "（希望我的运势真的能帮到你，可颂。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
