        {
          "type": "dialogue",
          "speakerName": "瓦莱丝",
          "text": "别动，老实点！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "武装的领民",
          "text": "你别以为我们不知道！你就是专门来诬陷恩希欧迪斯老爷的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "武装的领民",
          "text": "你这个道貌岸然的伪君子！我呸！",
