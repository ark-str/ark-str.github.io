    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "坏消息呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "坏消息就是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "......这又是什么声音？",
