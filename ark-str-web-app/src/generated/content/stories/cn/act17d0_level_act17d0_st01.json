    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "不清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "目标人物启动了不明实验装置，冲击波把我们所有人推开了。",
