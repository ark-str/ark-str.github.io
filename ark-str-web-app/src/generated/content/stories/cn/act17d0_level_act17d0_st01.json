    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "准备好复制器，他们可能碰上麻烦了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "这，怎么回事？！他们人呢？",
