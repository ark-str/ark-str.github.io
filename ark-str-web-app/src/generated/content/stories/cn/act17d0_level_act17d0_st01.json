    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "听上去像是重型工业机械......但这速度太灵活了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "让我看看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......我真不敢相信我的眼睛。",
