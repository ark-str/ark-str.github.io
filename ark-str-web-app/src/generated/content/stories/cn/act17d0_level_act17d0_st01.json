    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "发......发生了什么......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "亚历山大，她醒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "干得漂亮。",
