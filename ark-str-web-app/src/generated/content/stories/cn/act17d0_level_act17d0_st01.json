{
  "server": "cn",
  "storyId": "act17d0_level_act17d0_st01",
  "groupId": "act17d0",
  "stageId": "act17d0_st01",
  "title": "拉马克行动",
  "storyCode": "OD-ST-1",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act17d0/level_act17d0_st01.txt",
  "sourceHash": "2e326da06be7b825dd47e07249b3a00f8ce165c0259bca2b358fe2314b4ed2cc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "我们已进入磁山二号，重复一遍，我们已进入磁山二号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "双月、艾拉，你们那边情况如何？完毕。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "一切照旧，我们很快就能完成收尾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "完毕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "艾拉？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "双月，准备接敌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "text": "已就位！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "text": "复制器已开启！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "地雷部署！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "如果情报无误，这就是最后一批了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "我们处理完毕后就向你们靠拢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "Gówno！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "text": "艾拉通讯完毕！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "情况就是这样。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "放心交给波兰人吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "我已经听到雷电地雷触发的声音了，她们会没事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "而你，闪击，把注意力放回警戒上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "听你的，女士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "注意仪表读数，情报显示这个建筑物里有封存的核废料。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "霜华，我们离目标还有多远？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "穿过前面的检查站和材料储藏室，就是主实验室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "无人机显示雇佣兵在检查站及周边建造了简易工事 。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "没有掩体，没有死角，入口位置堵死，周边布设了大量铁丝网。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "人数。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "九人，大致位置已标记在了小队的终端上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "检查站进入储藏室的长廊入口完全封死了，无人机无法进一步深入。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "汇报完毕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "还有其他入口吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "没有看到入口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "好，我会解决。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "有什么建议吗，Lord？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "燃烧榴弹还有剩余，你要用几颗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "两发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "检查站入口的阻塞太庞杂了，如果爆破，瓦砾会对突入造成很大影响。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "我的计划是炸开墙体上方和右侧的墙面，一个人挂绳在上方提供火力压制，剩余人员从右侧缺口突入。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "霜华，压制和支援交给你来办。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "收到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "贴片炸药爆炸后，战车，你从上方缺口抛射榴弹，其他人按照标识位置投掷闪光弹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "地面突入按照闪击、灰烬、战车的顺序来，行动要紧凑，不留可趁之机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "有问题就现在提出。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "都确认了？那好，各自就位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "霜华，等你的信号，然后我们开始行动。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "正在前往预定位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "贴片炸药部署完毕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "炸药部署完毕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "准备——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "闪光弹！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "榴弹已射出！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "突入！突入！突入！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "敌人倒下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "闪击，两点钟方向！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "已投掷手榴弹！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "十点钟，机枪手！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我来压制，你们继续推进！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "榴弹已射出！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "工事已破坏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "坏家伙倒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "还有三个，正前方！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "两个！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "已净空！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "已净空！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "已净空！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "已净空！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "有人受伤吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "好，我们继续前进。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "霜华，注意警戒后方！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "我来开门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "闪击，警戒。战车，用无人机看一下走廊和储藏室的情况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "已经在做了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "前面怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "储藏室里堆满了弹药补给，他们在这里驻扎了有一段时间了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "材料室里没有敌人，只有几个在培养皿中的黑色结晶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "有威胁吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "不好判断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "这些罐子里是什么东西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "发光的矿物晶体，以前没见过这种东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "矿石，合成物，只要它在发光，就可能有放射性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "别担心，盖革计数器没有反应。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "那就直接穿过去，先不管这些石头了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "各位，没时间可以浪费了，行动。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "text": "灰烬，这里是双月。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "text": "我们刚刚解决了敌人，但是他们用大量障碍物堵住了走廊通道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "text": "我们要换一条路向核心区靠拢，完毕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "我们正在准备进入主实验室，请尽快支援，完毕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "text": "收到，双月通讯完毕。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "怎么办，需要等一等她们吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "不，时间紧急，不宜拖延，继续前进。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "前面就是主实验室大门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "准备好，我们直接进去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "注意警戒，看到目标优先制服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "别驻足太久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "这里没有人，只有这些奇怪的机器。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "别放松警惕，这里的实验器材还在运作，说明目标人物还在这里。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "那我们得先真正进入到实验室里才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "这里是实验室内的控制间，看到玻璃那边的器械了吗？那儿才是真正进行实验的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "当心......这里的敌人数量还不明朗。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "text": "不受欢迎的朋友们总是不请自来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "（发现目标，先别开枪。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "（报告周围情况。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "（没发现其他人。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "（没有看到其他敌人。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "把手举起来，列维博士，离开终端机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "text": "我还在想你们要多久才会出现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "text": "你们干掉了我的保安？真是太遗憾了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "text": "我昨天才给他们结了薪水。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "text": "不过烦请各位轻拿轻放，这里的易碎品很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "不要轻举妄动，这场闹剧结束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "text": "结束了？我的新实验才刚刚开始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "停下你的当前动作......我不会警告第二次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "text": "哈哈哈哈哈，如果我拒绝呢？",
