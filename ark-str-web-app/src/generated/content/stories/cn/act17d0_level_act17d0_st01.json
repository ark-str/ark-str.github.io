    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "需要我侦察吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "不，不要妄动。",
