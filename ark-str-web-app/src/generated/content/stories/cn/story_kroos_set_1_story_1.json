{
  "server": "cn",
  "storyId": "story_kroos_set_1_story_1",
  "groupId": "story_kroos_set_1",
  "stageId": null,
  "title": "苹果",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_kroos_1_1.txt",
  "sourceHash": "b75859fbd9bd47804e406401cb2cff5c7783de3c23db8bd269909337ab2b0d44",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "某个闲暇清晨\n罗德岛主舰"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "我怎么又被克洛丝绕进去了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "别生气啦，队长，克洛丝没有恶意的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "不是生气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "就是——明明我在监督她干活，怎么每次......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "她只是想多放松一会啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "下次还是你盯着克洛丝吧，她好像比较听你的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "我也没做什么啦，就是盯着她干活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "如果她有事情，我就帮她一起干，过一会她就不让我做了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "就这样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "嗯，没什么特别的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "不愧是你啊，米格鲁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "也不知道为什么，她只要想偷懒，我就拦不住......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "有时候是肚子不舒服、有时候么杜宾教官找，我怎么就信了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "等我反应过来，人已经溜掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "克洛丝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "可算让我找到你了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "别跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "米格鲁你去那边堵她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "好，好的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "呼，呼呼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "克洛丝，跟我回去值日！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（我就休息一下嘛！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "站住！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（呀，芬怎么越跑越快了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（我得想个办法。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "您还想听点什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "好的，镜头在曲库里搜寻一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（是稀音吗？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（嗯......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（好，试试看吧。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "您好~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "啊，克洛丝小姐您好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我可以坐在稀音旁边吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "哦——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "小姐说她不介意，请坐吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "谢谢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "呼，呼——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "您好像很累的样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "因为，后面有一只库兰塔在追呀~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "克洛丝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "啊，我也听到了，是芬小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "其实我和芬在捉迷藏呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "结果抓着抓着，就变成赛跑了~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "镜头，帮帮忙吧~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "哦——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "小姐说听上去很有趣，让镜头给克洛丝小姐提供帮助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "谢谢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "但是，我没法保证您不被芬小姐认出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "要是真被抓住，那我也就只好乖乖认输啦~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "既然您都这么说了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜子",
      "text": "哔哔！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M一号",
      "text": "嘀——嘀——嘀——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M二号",
      "text": "叮咚！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（这些小车一直都藏在旁边吗，我都没发现呢。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜子",
      "text": "哔哔！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M一号",
      "text": "嘀——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M二号",
      "text": "叮咚叮咚！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "刚刚应该是在这里跳了一下就不见了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "人呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "这家伙越来越会躲了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "如果是克洛丝的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "应该会——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "藏在——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "芬——我看到克洛丝往食堂那边去了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "好，我这就来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "呼——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "恭喜，看来克洛丝小姐没有被抓住呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "以前在出任务的时候看到过稀音的藏身手法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "果然很厉害呢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "镜头使用的是最新研制的复合隐蔽技术，融合了迷彩、光线折射等多种科技。主要是为了满足小姐的需求。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "对不起小姐，忘记给您播放音乐了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "那么——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "哈——真好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我也在这里休息一会，可以吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "欢迎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "说起来，稀音小姐现在在做什么呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "小姐在构思作品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "虽然看上去只是在发呆，但小姐这时候的确是在思考。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "这时候镜头就负责给小姐放音乐和递食物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "没有人会追着稀音小姐干活吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "从镜头的记录里来看——好像没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "如果有的话，镜头就会为小姐使用隐蔽技术，没人能找得到她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "真好~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "如果我也能像稀音一样生活就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "小姐好像也说过类似的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "好像是：“能够像卡特斯那样生活就好了。”——之类的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "卡特斯有什么好嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "很累的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "从小到大都被人说，卡特斯不是应该活泼好动吗，你怎么就这么懒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "但我就是想把脑袋放空，然后在沙发上待一天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "这样不是很好吗~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "小姐说，克洛丝有选择的权力，已经很幸福了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "用镜头来打个比方吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "镜头抓拍的速度是很快的，经过系统辅助运算，就算是飞奔的库兰塔，镜头也能抓拍成功然后把照片放进相册里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "但小姐是做不到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "就算是拍摄人物，小姐也要像画素描一样，等——上很久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "所以小姐景物拍得好，并不是因为小姐只喜欢景物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "小姐什么都想拍，但她能拍到的，只有近乎静止的东西，只有它们，才有耐心一直等在那里，等着小姐拍完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "这就是原因。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "克洛丝虽然不喜欢动，但真正活动起来，还是很敏捷的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "算是吧~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "镜头和卡达编辑过有克洛丝参加的作战记录。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "平常都是在预定地点附近，但是要求来了也可以很迅速地转移，和普通的卡特斯没什么区别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "那只是因为不好好干就没命了嘛~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "任务很辛苦的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "可没有镜头帮忙，稀音小姐连转移都做不到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "“做不到”和“不想做”，镜头觉得还是有些区别的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "“太多的事情做不了，所以就让我们把能做的事做到最好。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "稀音小姐是这么和镜头说的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "当然了，小姐能做到的事其实也比较少，做起来也比较方便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "对于克洛丝来说，是不是因为知道自己的极限，所以只把精力放在最需要自己努力的地方呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "有可能哦~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "看来镜头的判断是正确的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "也有可能只是不想干活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "镜头相信克洛丝小姐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "滋，滋滋——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "啊，不好意思，这里信号不太好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "镜头刚刚为您选选取的励励志程序运行出错了了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "您看需不需不需要要要要要——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "镜头？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（旁边的小车也不动了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（这是，坏了？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "——!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "稀音，你是要说什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "呣——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "慢慢来，我听着呢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "唔——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "欸——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我猜猜~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "唔，是——梅尔吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "是————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我知道啦，我去找梅尔，稀音就在这里守着镜头吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "不会过太久的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "一会见~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "是————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "的————",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "不好意思啊芬，我认错人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "莱恩哈特先生和克洛丝差别还是挺大的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "虽然都是卡特斯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "真的很抱歉，一着急看岔了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "没事，我们重新找找看，如果找不到，就去请流星小姐或者远山小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "克洛丝逃不掉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "今天队长好像对克洛丝特别有意见呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "平时不也是睁一只眼闭一只眼的吗，今天好像特别生气的样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "不是生气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "今天克洛丝开溜的时候和我说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "和你说？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "说今天是我带领大家的周年纪念日，想先给我买点礼物去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "那不是很好嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "结果她一出门就没回来，等你回宿舍我才反应过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "今天真的是纪念日吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "是的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "那克洛丝也太过分了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "一会我会帮你说说她的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "啊对了，队长，周年快乐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "啊，嗯嗯，谢谢你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "刚刚那个，是不是克洛丝？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "还是我又看岔了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "是克洛丝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "她好像有急事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "走，我们去看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "梅尔的宿舍兼“鲁特拉工作室”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "应该是这里了~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（这应该是自动门啊，怎么没开？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "梅尔小姐，您在吗~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（哦——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（门坏了啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "（是摁这边的按钮吗？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "梅尔小姐~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "有些事情想要麻烦你，可以吗~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "梅，咳，咳咳......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊，找我吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哎呀我开循环扇了啊怎么浓度还这么高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我这里在上漆呢，你先出去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我这边先收个尾，一会就好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "哦，咳，咳咳。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "咳咳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "呼，呼——哈——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我来了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "说吧，什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "如果是那种修修补补的活，你直接去工程部吧，找我没用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "咳，是这样的——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哦——镜头宕机了，那不是应该找可露希尔吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "稀音好像觉得找您比较合适~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "也行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "还好我今天没什么特别紧急的活，不然你真的要白跑一趟了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "记住啦，以后那些四轮智能机械出什么问题，优先找可露希尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我知道了~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那我们走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "克洛丝好像真的有事唉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "我们回去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "唉，不跟着克洛丝了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "有事的话，就不打扰她了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "把克洛丝的烂摊子收拾一下，我们就去吃点好吃的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "就在这里~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哎呀走慢一点，我还没吃早饭呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "稀音小姐~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "镜头？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "你好呀克洛丝小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "哎呀，梅尔小姐也来啦，欢迎欢迎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "这不是好好的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "啊......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "其实您刚一走镜头就重启了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "因为镜头有些功能容易出错，重启还是很常见的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "那......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "啊您是说小姐吗？小姐想和您说的是：“没事的。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "可能小姐的音调太——长，导致您误会她的意思了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "是，这样啊~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那我不是白跑一趟嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "不好意思啦梅尔小姐，镜头健康得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，我看看......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "应该不是外部的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "之前的确宕机了对吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那就是机体本身存在问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "刚刚你自己也说，重启很常见，对吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "可露希尔怎么没帮你解决这问题？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "可露希尔小姐已经为镜头预订了更新配件，再过不久就可以升级了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哦？哦——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那批零件原来是给你的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "昨天我去她小黑屋的时候她还跟我装了半天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "说是什么“高级移动摄影器材在极端条件下使用的精尖零件”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "原来就是你啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那正好，我们现在就去可露希尔那里一趟，我和她一起帮你解决这个问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "这样你出任务的时候就不存在当场宕机的可能性了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "感谢您，梅尔小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "但小姐她行动不太方便，镜头要和小姐一起走，可能没办法直接和您去可露希尔小姐那里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我会带她慢慢过去的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "可以吧，稀音小姐~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "既然小姐都这么说了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，那就出发吧，早点收工，我能早睡一会，明天还有一大堆活要干呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镜头",
      "text": "哎呀梅尔小姐，不要推着我跑啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "没事的，梅尔小姐只是性子比较急~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我们就慢慢晃过去好了~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我认路的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稀音",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "行动预备组A1宿舍"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我回来啦~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "回来啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "芬，这是给你买的甜点~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "纪念日快乐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "哇，是小麦芬！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "放桌上就好，明天一起分着吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "好的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "浴室有人用吗~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "我们都上床啦，就剩你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "好~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "你看嘛芬，克洛丝真的努力了一天哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "而且给你买了礼物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "啊——嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "其实我也不是想责怪她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "她要是真的想休息，和我说，我也不会拒绝的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "但她总是用那种方法，有时候是让我有点不开心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "克洛丝只是不好意思说出口啦，她人很好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "我觉得她是在耍我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "那是因为和你关系好嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "克洛丝对大多数人都不会这样的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "唉，那我宁愿她对我正常点......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "早点睡吧，我们明天还要训练呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "记得起来以后叫醒克洛丝，她回来的时候看上去确实很疲惫，我怕她明天起不来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "要是真睡过头，杜宾教官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "安心啦芬，我会把她拖起来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "但愿如此......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "唔，不想了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "睡觉睡觉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "晚安。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格鲁",
      "text": "晚安，队长。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
