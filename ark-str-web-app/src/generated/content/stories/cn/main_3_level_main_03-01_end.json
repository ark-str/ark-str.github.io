  "stageId": "main_03-01",
  "title": "会合",
  "storyCode": "3-1",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_03-01_end.txt",
  "sourceHash": "5058f05ec0387d731f8bff79598dc555f1a97f4a370137c1755c3273ae397b15",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "长官——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "整合运动的大部队已经撤退。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官，我这边也处理完毕了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——————啧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "前些天抓住的那些整合运动嫌疑人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "刑讯科问出什么没有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动嫌疑人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "这把弩，你眼熟吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动嫌疑人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "你能拉得动这把弩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "这个弹药是什么构造，怎么回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "你们在贫民区做些什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "你来龙门，又要做些什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动嫌疑人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "......没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "那些人什么都不说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "或者说......他们可能什么都不知道吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "就和刚刚解决的整合运动一样，应该都是些听话的喽啰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——让他们指认。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "用点方法也不要紧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "小队信息，领导方式，来源，战术分布......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "有多少，让他们说多少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "他们说多少，就给我多少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "无论有什么新消息，立刻通知我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "难道近卫局曾经抓捕过整合运动的成员？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "并不能确定他们的身份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "再怎么猜测，也只是怀疑而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "联系星熊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "特别督查组那边怎么样了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "还在被一个感染者——单方面压制吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "他们那里的整合运动似乎也已经撤退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "忧心这是诱敌之计的星熊督察正在排查风险......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "啧，一个人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "想来就来，想走就走？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "下一步的任务，你应该也很清楚了，阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "接下来，就是要夺回米莎吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "这是一次联合作战。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "近卫局主攻，罗德岛负责搜索和突袭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你们只要能拖慢整合运动的撤退进度，就算完成任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "搜索敌人的话......我们可能会被发现吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "现在，我们的侦察小队也缺乏支援——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "光是我们可不成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "专业的事，就交给专家去做吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "芙兰卡，帮我联络企鹅物流。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "又要麻烦能天使和德克萨斯他们两个了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
