{
  "server": "cn",
  "storyId": "main_1_level_main_01-08_beg",
  "groupId": "main_1",
  "stageId": "main_01-08",
  "title": "意志",
  "storyCode": "1-8",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_01-08_beg.txt",
  "sourceHash": "9f81c734a84ef7c6380c328ad741e9ca5f8d7dc8dc3fe5fdff301e03d16fbea7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十一关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "阿米娅，带博士离开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "......立刻！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不行！我不能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "你也感觉到了！她......再这样下去，整个救援队都会葬送在这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "那个塔露拉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "她是活生生的怪物！阿米娅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们一起战斗的话，不会有问题的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "那博士呢？你能保证博士的安全吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "E4小队，我们留在这里断后！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "一定要让阿米娅和Dr.{@nickname}，以及各个医疗小组安全撤离！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "不，交给我和我的小队吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "Ace！现在难道是说这种话的时候吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "我很冷静。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "你难道没看到吗，她周围的东西，都在融化！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我不会留下你们独自战斗的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛......绝不会丢下你们的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "阿米娅，时间宝贵！你必须撤退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——你应该信任我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我不能看着罗德岛的任何一个人牺牲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "想想任务目标，想想我们的目的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不是说这个的时候！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "——？热量......在......她手里......聚集？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "她周身的景象......扭曲了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "不，那是她......加热了周围的空气！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "小心，她将要使用的法术......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不对......不对！临光！！快回来！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那不是......那个法术会把你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——安静。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "呜呃......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "哈，哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "临光！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "咳......退后！我不要紧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "只不过是......有点烫而已......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "说什么......不要紧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "全身的铠甲没有一块是完好的，究竟哪里不要紧了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "你不能再与她战斗了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "我说了——退后！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "临光！你这倔脾气......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "蹲下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "咳，咳......又是什么把戏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "......不可见的火扫过了我们的头顶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "后撤。整个街区都在融化......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "别做无谓的牺牲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "我是在和什么东西战斗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "必须干扰她施术的过程......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "狙击干员！瞄准目标敌人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "反抗会为大地带去希望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "但反抗，改变不了你们的命运。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "射击！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "切尔诺伯格已得解放。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "我们的工作已经完成，而我对你们产生了些许兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "什么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "不过，也就仅此而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "你们做出了错误的选择。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "罗德岛，你们该真正站在感染者这边。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "怎么......回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "为什么整个广场......都被烧焦了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "刚刚......发生了......什么......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "呼......呼吸......好烫......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "石块，弩箭，弓矢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "都没了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "一瞬间......她周围的所有事物，全都都被燃烧殆尽......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "你们具备解放者该有的韧性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "......连渣滓都没剩下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "阿米娅。你很清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "必须有人，挡住她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——但我厌烦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "阿米娅！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "你们总要为杀害同胞而付出代价。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "我将赐予你们一个我十分喜爱的结局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——毁灭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "糟了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "走，走......快走！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "那种热量和规模......不行，不行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "保护阿米娅和博士！快！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "来不及了——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "让我挡住她！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "啊啊！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "......嗯？？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "阿......阿米娅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不会让你伤害他们的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我不会......允许你这么做的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "————哦？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "咕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "必须......让大家......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "阿米娅她一个人......挡下了敌人的法术......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "不行......那力量太庞大了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "哪怕是阿米娅......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "哪怕是阿米娅也撑不了多久的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "阿米娅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "没问题......我没问题......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我没问题的——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我要......我必须......保护你们！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "黑色......将敌人的法术封在了广场上......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "唔......唔啊......呃......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "阿米娅......她，她设下的屏障，在燃烧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "阿米娅，不可以！！那样的话，你的戒指——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "哪怕......虽然......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "博士，对不起——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "哪怕会带来灾难，哪怕我会......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我也不能......再看着重要的人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "呵————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "啊......啊啊......！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "阿米娅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "可恶......再这样下去，阿米娅会......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "你要干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "去毁掉那个龙女的法术！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "——“卡西米尔的光芒啊，耀骑士将为你奉献自身——”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "博士！快走！我们会帮助阿米娅的，你必须......",
