  "storyId": "main_4_level_main_04-09_end",
  "groupId": "main_4",
  "stageId": "main_04-09",
  "title": "彻入骨髓",
  "storyCode": "4-9",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-09_end.txt",
  "sourceHash": "a257c1adeef6864e3e8d0a29122c115a851c63c1ac62a12a0951b84abb9fa009",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "霜叶，小心！别冲那么前！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我知道自己在做什么——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "唔，唔唔额！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "寒气切开了盾牌？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "什，什么？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "闪开！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "阿米娅！霜叶打乱敌阵，冲向敌方指挥官了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "狙击干员，术师干员，掩护霜叶！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哦哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你想做什么呢，小狐狸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "要你赎罪，要你痛哭流涕——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "——要你的命。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "别挡道！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "呜哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "黑，黑色的法术......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "快，快跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我不想和梅菲斯特的手下一个下场......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "梅菲斯特，看你还能逃到哪里去！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哦。看来这些家伙还不足以拦住你们罗德岛嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "为你的所作所为付出代价吧，残忍的家伙！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "你逃不掉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "小狐狸，你离我离得，有点近哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "因为我就是将手刃你的那个人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "不尊重生命的人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "不配拥有生命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哦——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "怎么会，我的脚——？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "阿米娅！各个方向都出现了整合运动的敌人！虽然数量不多......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "糟了，是雪怪小队......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "雪怪小队......聚拢起来了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "好了，得向你们介绍一位新朋友才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "嗯哼~接下来，请热烈欢迎我们这个舞台的真正主角——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "西北冻原的噩梦，雪怪们的公主——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "————霜————星————小————姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "她会把你们的血肉，一点一滴的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "全·都·冻·成·碎·渣·哦~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "————糟了！————",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——梅菲斯特————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "我该先把你这个连野兽都不如的杀人狂，丢在雪原里等死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "啊呀，好可怕好可怕~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "但罗德岛在那边哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "霜叶——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "退后。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "阿米娅，带她们走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那个是......那个是——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "她......向我们走过来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我们不可能赢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "呵......虽然感觉还没活够......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "能遇见你们，我已经很开心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "快走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "霜叶？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "放心吧，罗德岛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "我会让你们死的毫无痛苦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
