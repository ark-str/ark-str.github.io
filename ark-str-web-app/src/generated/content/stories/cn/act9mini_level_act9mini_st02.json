{
  "server": "cn",
  "storyId": "act9mini_level_act9mini_st02",
  "groupId": "act9mini",
  "stageId": null,
  "title": "落灰",
  "storyCode": "",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act9mini/level_act9mini_st02.txt",
  "sourceHash": "b766feeceb6fa33fcba679efc92e5798abf689d15fca4c18d6af8c36ba239597",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔1.5-灰松鼠"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶，我们要去哪里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "还没到你提问的时候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "拿稳小炮，跟紧了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "是的奶奶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "快到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "那边是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "竞技场，从大骑士领来的家伙们建的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "我们是要去看比赛吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "比赛？不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "我要带你去参加训练。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "还记得我教你的东西吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "是的，奶奶，我记得很清楚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "架盾、起炮、轰击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "盯紧敌人、注意弹药、炮不离手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "还有，嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "炮声轰鸣，胜利已在眼前！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "你比你的父亲要可靠得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "至少在我闭上眼前，还有人能够记得这些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶，请别说这样的丧气话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "呵，古木哪有不烂的道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "与其就这么腐朽掉，不如做新芽的肥料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "不必，只是咳嗽一下，没什么好担心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "你父亲那一辈，甚至我的几位兄弟，早都忘了卡利斯卡是怎么繁荣的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "林业？那片林子是我们靠功勋、靠火炮换回来的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "“炮声轰鸣，胜利已在眼前”......那帮见钱眼开的家伙连格言都记不住了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶，请您别生气了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "哼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "格蕾纳蒂，你是棵好苗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "可别长歪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "是，我不会让您失望的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "沸血骑士团——竞技场屠夫——养好伤后再度归来——一如既往的残暴！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "而另一边——另一边是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "威严的祖母",
      "text": "咳，咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "曾经的南方林业巨子——卡利斯卡集团的一员——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "如今则是一位感染者——隶属于红松骑士团——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "让我们欢迎——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "（呼......放轻松，奶奶已经教会我了，我可以的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "（我准备好了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "灰毫骑士，格蕾纳蒂·卡利斯卡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哎呀，小灰终于进场了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "格蕾纳蒂进场总是慢悠悠的，也不和观众表示一下，一点都不痛快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "这就是卖点嘛，有人可喜欢这一套了，你看那儿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激动的粉丝",
      "text": "格蕾纳蒂！格蕾纳蒂看我一眼呀！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "嗯......行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "欢呼声作不了假。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "而且那个持炮的姿势，还挺有贵族范的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "当然我最期待的还是她开炮轰人的时候啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那是肯定有的啦，听到轰隆隆的响声观众可兴奋了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "要是有更过瘾的就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "怎么，你还想看她用炮筒砸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "哈哈，有机会还真想见识一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "巨斧对坚盾！究竟谁才是最后的赢家，让我们拭目以待！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "点开您的终端，做出您的选择，支持您的选手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "当然更重要的是，给自己一个填满钱包的机会！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "比赛——开始——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "你手上那块塑料最好能多撑一会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "矿石病垃圾。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "真没劲，上了赛场就话都不多说一句。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你又不是第一次看小灰比赛，那叫认真，认真懂不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "可这样很无聊啊......不发泄一下情绪，怎么在气势上压过对手哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "骑士竞技又不是谁嗓门大谁赢呀，主要是对抗得好看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "看嘛，就是这样的。锈铜被逼退了，大家也都很高兴，对不对？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "可是今天这场，是不是太稳了？连主动攻击都很少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "这也得挑对手嘛，遇上锈铜这种偏重进攻的骑士，组织好防御才是最佳策略。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "而且小灰又能用她最爱的技巧了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "盾击挡开接一炮，百试不爽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "（小灰这一场进攻欲望是不太强，她到底在想什么啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "令人惊讶，屠夫的切肉斧在灰毫骑士面前居然毫无办法！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "每一次格挡，每一发炮击都让英格拉无功而返！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫骑士的防御完美无缺，她正在一点点推进，压缩属于屠夫的活动空间！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "毫无疑问，这将是一场拉锯战，不到最后一刻，谁都不知道胜利的桂冠花落谁家！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "赶紧拿起终端为您支持的选手下注吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "抑或是即刻订购一瓶印有选手logo的赛场特供冰镇矿泉水，让身旁的观众知道您到底支持哪一方！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "现在下单，立刻有专人为您送至座位！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "还有这种东西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "真的有，只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "这价格......我为什么不去赛场外面买十瓶回来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你不会下单了吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "就买一瓶尝尝鲜，嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "你就只会缩在那塑料板后面吗，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "喝，等我敲碎它，你有的是时间尖叫，石头老鼠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "卡利斯卡这样的小企业是不会给你收尸的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（扣下扳机）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "呜哇，小灰生气了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "英格拉也太毒了吧，揪着人痛点不放干嘛呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "卡利斯卡林业以前还是挺有名气的，最近倒是听不到什么新闻了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "不会真的和格蕾纳蒂有关吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "要真让小灰来经营，他们家的公司说不定现在还能做大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "自己经营不善，就把气撒在别人头上，这样的公司肯定做不好啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "听说小灰是在一桌子叔父叔母面前被全体表决逐出家族的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "全票通过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "那她父母......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "听说也被要挟着把自己的女儿投出家族了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "虽然回家以后还是给小灰准备了来大骑士领的资金。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但你也应该知道吧，本应该支持自己的父母都举起了手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "太痛苦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "还好小灰够坚强。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "特别坚强。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "呃......她不会真生气了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我看看——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "还好还好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "这种时候生气不是很正常的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "要我肯定先把锈铜捅个对穿再考虑其他问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰的打法太耗脑子了，弹药数量又有限，赌气多打一发弹药可能就输了呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "现在应该还在让锈铜以为自己生气了的阶段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "毕竟，误导对手也是很重要的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "令人震惊，英格拉的肩甲居然被轰碎了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫骑士仍旧在步步紧逼，难道胜负马上就要揭晓了吗！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "又是一声炮响，看来灰毫骑士已经准备好亲手拉响胜利的礼炮了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "发生什么事了？！各位观众看到了吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "刚刚锈铜居然用斧头劈开了一枚炮弹！感谢两位选手，为我们上演了一出在电视剧集中才能见到的场面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "是的，我说的正是斯沃玛视频投资拍摄的都市悬疑电视剧《大骑士领二十四夜》中的经典场景，有兴趣的观众可以立即下单购买光碟！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "前三十名购入者可以获得男女主角签名海报一张，先到先得，过时不候！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "咕咚咕咚——呼，这水和路边便利店买的也没什么区别嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "我不是早提醒过你了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嘻嘻，算啦，就当付了笔代购费吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "话说回来，莫布还真是不放过每一个能做广告的机会啊，真烦人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "这就是他的工作嘛，理解一下啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "不过谁能想到锈铜会斧劈炮弹呢，硬生生给了莫布一个插广告的机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "要不是那一下小灰心软了，想着把锈铜轰倒，就没瞄准脑袋......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "比赛现在就结束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "她弹匣里炮弹不多了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "应该只剩一发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "该换弹匣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "希望英格拉别在这时候给咱家小灰添什么麻烦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（还有一发吗。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（把他轰退的同时借力后撤，争取到的时间应该足够。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（以英格拉的竞赛风格，应该不会有后手。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（时机差不多了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "你就这点本事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（变快了？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（不好！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "锈铜鞋子上那是，推进器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "这一下可麻烦了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "加油啊小灰！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "没了炮弹，你还能做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰，你还有弹药吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "没有，备用弹匣刚刚用来挡弩箭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那怎么办，用炮筒砸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "有需要的话我可以分心帮你对付几个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "然后像之前那样乘机拿走我的分数？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "别再惦记那件事啦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "当初大家初次见面，没有提防才有问题啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "以后不会了，我们约定过的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我能相信格蕾纳蒂不会为了自己的利益牺牲其他感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "格蕾纳蒂也相信索娜不会背后捅她刀子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "对不对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......哼，算是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那你准备怎么对付面前的骑士？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我真的能腾出空来帮一把的，有需要就赶紧说哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "我有我的办法。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "刚刚还占据优势的灰毫骑士在换弹时被抓住破绽，锈铜开始了复仇，难道屠夫的切肉斧终究还是要见血了吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫骑士究竟会如何反击呢，我们看到她——她拆下空弹匣甩向锈铜，然而没有任何——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "哦不对，她甚至丢下了炮冲向锈铜，她到底要做什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "英格拉举起了武器，灰毫骑士却只剩一面盾牌！灰毫——灰毫格开了战斧，然后——喔！！一击头槌，连我这儿都听得到响声！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "喔！一套连贯的徒手打击，英格拉后退了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "格蕾纳蒂一个翻滚回到了她的武器旁，换弹，上膛，一气呵成！英格拉又要再次被炮火支配了吗！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "啊哈，我们又一次听到了炮响，灰毫骑士重新掌握了局面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "虽然难看了点......这脱身方法还挺实用的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "不过我真的没想到她丢下那门炮之后速度会那么快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰也是札拉克嘛，灵活一点很正常的啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "那她为什么不和你一样用轻巧点的武器呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "个人爱好呗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我是建议过她换件更适合在赛场上使用的远程武器，标枪啊、弩啦、投石索之类的，她都不喜欢，就是爱用那门从老家带来的炮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "有时候根本施展不开，维护还费时费力的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "真是固执。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "习惯就好啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "她剩下的弹药就只有最后八发了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "如果打完了会发生什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "不知道欸，会发生什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我是从来没见过小灰把备弹全部打完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "......呼，呼，你是在羞辱我吗，灰毫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "说话啊，你这个，石头！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（扣下扳机）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "你准备装哑巴到什么时候！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "受够了，我受够了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "喝啊！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰真的太坏了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "她不会从一开始就准备和英格拉玩拉锯战的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "又不回话又打不倒，换我我也气。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哟，你来啦查丝汀娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "灰毫她为什么要羞辱锈铜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "这个，说来话就长啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我碰见小灰的时候，她就对观众席上面的骑士老爷们一肚子怒火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "其他的感染者骑士都觉得她只是单纯地对骑士老爷不满。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但是她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "如果没有感染的话，她也是骑士贵族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......我听说过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "在受到感染后，她骑士家族的长辈同辈没有一个人对她表示过同情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "所有人都将家族的逐渐衰落归咎在她身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "正常人都知道这和得病没关系啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但他们就这样做了，她的家族，卡利斯卡的札拉克们一致同意剥夺小灰的地位，把她踢出家族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰曾经是那么信赖这些亲属，愿意与他们分享趣事，愿意同他们切磋武艺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但最后，小灰以为的至亲好友，一位都没伸出援手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "听说还有人恨不得让她彻底从大地上消失——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "这，不至于吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那天我也在，帮小灰挡了一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你们应该能理解小灰为什么对骑士老爷们深恶痛绝了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "至于锈铜英格拉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "他所做的每一件事，都在深深刺痛小灰的心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "也就是这个原因，小灰才准备在拉锯战中对抗到最后吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "为了将一位高高在上的骑士老爷彻底打倒在地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "也为了......平息她自己的愤怒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哎，查丝汀娜，帮我看看小灰弹匣里还有几发炮弹？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......四发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "噢哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "快要结束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "一阵猛烈的攻势并没有击倒灰毫骑士，锈铜却开始体力不支了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "我们能看到他正准备发起最后的冲锋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "漫长的拉锯战马上就能见分晓了吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "请各位观众注意您的投注号码，说不定在胜负见分晓的同时，还能获得一份意外大礼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "本场赛后幸运抽奖由呼啸守卫赞助，概率竟然是惊人的百分之零点五！还没有下注的观众，请抓住这最后的机会！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "英格拉举起了他的屠刀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "格蕾纳蒂也摆出了一个防御姿态！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "胜负马上就要见分晓了吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哎呀，小灰她什么时候偷学我的招！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "锈铜在冲锋，锈铜还在冲锋，灰毫也举起盾牌，却把炮口对准了身后！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "难道她要硬接下锈铜一击吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "双方越来越近，越来越近了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "借着炮击的加速度，灰毫居然从锈铜的斧旁蹿了过去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "太快了太快了！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "她舍弃了盾牌，把炮口摁在英格拉后背上扣动了扳机！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "锈铜骑士倒下了！灰毫骑士获得了胜利！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "等等，灰毫骑士又一次把炮口对准了锈铜，难道，残虐的英格拉也有被欺凌的一天吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "......呵，缩在壳里的札拉克。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "灰毫......格蕾纳蒂......我记住......你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "等我养好伤......你......你们感染者，一个都逃不掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（扣住扳机）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "（将炮口对准天空）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "这一枚炮弹是献给观众的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "你不配。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锈铜骑士",
      "text": "你......呜......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫骑士最终没有攻击倒下的英格拉，在打出最后一发炮弹后，她独自一人走向了出口！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的粉丝",
      "text": "格蕾纳蒂！格蕾纳蒂——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "本次比赛——抽奖——奖金——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "这一次感觉怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "不是很好，父亲，火炮拿久了手还是会抖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "要不要换一件更轻便的武器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "不用，火炮很适合我，它的威力能够补足灵活性上的不足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "而且，或许某一天，我将不在赛场，而是到更广阔的地方作战。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "就像祖母那样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "到那个时候，这件武器一定会变得更加实用的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "好吧......听你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "小坚果啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "父亲，我不是小孩子了，您没有必要这样称呼我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "格蕾纳蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "这次训练做得不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "奶奶如果看到你现在的成果，一定会开心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "祖母......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "奶奶走之前和几位大伯做过约定，只要你想学，他们就会继续资助你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "所以不用担心钱的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "无论你最终成为骑士还是继承家业。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "继续练习下去，总有一天，你会成为卡西米尔知名的火炮手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "嗨，卡利斯卡家已经多少代没有出过一名真正的火炮手了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "想必各位长辈和祖辈都会为你而骄傲吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父亲",
      "text": "可不要让他们失望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "是的，父亲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成长的女孩",
      "text": "我会的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嘿，小灰，小灰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "嗯，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "怎么了嘛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你怎么突然开始发呆了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "没什么，在想些事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "英格拉可真惨，刚从医院出来就又被你送回去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "他罪有应得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那最后一发还往天上打？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "比赛已经结束了，就算我再看不起英格拉，也不能再对他下手了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "不然我和他又有什么区别？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "可惜了，本来还想在报纸上看到“屠夫惨遭屠戮”之类的标题来着......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "英格拉家族让这则新闻上不了报纸的可能性比较大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "索娜，其实我从刚才就想问你个问题......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嗯，怎么了小灰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "你手上拿着的，是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你的应援水瓶啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "索娜你怎么又买这种无聊的东西了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "还好啦，主要是那时候有点口渴又懒得出去买水。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "哟，我们的骑士凯旋啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......我也要向灰毫学习，变得更强。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "查丝汀娜，“那件事”怎么样了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......完成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "好叻，辛苦辛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "这次的奖金一到账我就会汇去“那个账号”，听说银行那边已经开始关注最近的频繁转账问题了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "还能用个人消费糊弄一下吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......你觉得呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "也是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "留给我们的时间，不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "不过现在还没到考虑这个的时候啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我们先去庆祝一下吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
