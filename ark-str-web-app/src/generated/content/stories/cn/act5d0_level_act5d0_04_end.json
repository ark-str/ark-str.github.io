{
  "server": "cn",
  "storyId": "act5d0_level_act5d0_04_end",
  "groupId": "act5d0",
  "stageId": "act5d0_04",
  "title": "7:59P.M.",
  "storyCode": "CB-4",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act5d0/level_act5d0_04_end.txt",
  "sourceHash": "73f7e9d0a48a369aec0b2f79ee185f29d47c0e35d4cbfdefe4cd53782f8554f4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "text": "喂，这是在拍电影吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众B",
      "text": "那不是企鹅物流那群人吗？又在打架？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众B",
      "text": "对！左勾拳！就这样！帅喔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "text": "每次都是他们赢，没意思啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众B",
      "text": "也是。喂，不知道哪儿冒出来的黑服，你们不要输太惨啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘿咻，不能用实弹可真麻烦啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "这里再怎么说也是市中心，当然不能用实弹了。能天使姐，背后！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哎呀，危险危险~谢啦，可颂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "这么纠缠下去可没完没了！德克萨斯小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "嗯......空和我，能天使和可颂，兵分两路，我们去大地的尽头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "太棒...不，我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哦~分头引开这些敌人是吗？没问题，我最擅长这个！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "能天使姐，路上麻烦你小心一点，赔偿清单在变长......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等等，你们说的那个“大地的尽头”是什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "一个小时后集合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "所以是什么意思！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "可是我们要怎么杀出去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我有一个办法......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "你，你想干嘛！？你这天使——我可不怕你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "可颂，上来！这辆摩托还挺帅的嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "好嘞，走着！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "抢车？好主意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "嗯，就你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "你别过来啊，该死的狼——你——噫噫——车、车给你，别打脸！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "嗯，空，赶紧上来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "好、好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "抓紧了，可不能比能天使他们动作慢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "还是稍、稍微慢——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "那我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "企鹅物流就把这小子丢这儿了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "那不是正好，一起上，看他怎么反抗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "嘁！那帮家伙一个个的在想什么！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "该死——！这附近有没有——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "text": "啊，要自行车吗？借你也可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "自、自行车......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "算了，也没空挑挑拣拣了，谢谢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "text": "好好加油啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "你竟然敢帮企鹅物流——！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "text": "反正你们有车，也追得上吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "忍着，不要对平民出手，否则我们就完蛋了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "对、对不起，追！都给我去追！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "哼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "“绑架拜松，分裂企鹅物流和峯驰物流，刺杀大帝”，你的好主意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我们的目的是取而代之。没必要杀光那些蠢货，这笔账你都不会算了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "德克萨斯，她可是德克萨斯。还有那个拉特兰人和峯驰物流的大少爷，给她们留后路，我们还会有安稳日子吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "必须得斩草除根。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "那样会引起其他人的瞩目。不止我们盯着这块蛋糕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "哈！你怕了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "进退是需要动脑子的，蠢货。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "低声下气地恳请鼠王已经是我的底线，懦夫。在龙门的这么些年，你变得畏首畏尾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "如果不是念在你对家族的贡献，我早就把你撵出去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我们都有各自的事情要做，嘲讽的话一会再说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "你说的没错。我要用我自己的手段和企鹅物流分个胜负。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "能靠死人解决的问题，就不要让活人互相扯皮，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "......随便你。但我最后警告你一次，这里是龙门，不是叙拉古。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "在叙拉古的失败之后，我就明白，我们不该放过任何一个机会，要不择手段地摧毁敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "而不是妥协，商议，再落入圈套。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "我们应该用西西里人最传统的方式解决问题。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "是啊，家族不需要懦夫......也不需要匹夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "分出一支小队，去贫民窟找鼠王。交易的内容有变。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "卡彭先生，但如果说服不了鼠王......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "哼，我们如果真想在龙门站稳脚跟，岂能容忍那只老鼠一直趴在我们头上？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "他迟早是我们要牵制的对象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "现在，按照这份名单一个个找过去，都是和鼠王有接触的龙门人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我们时间不多，今晚必须得到结果，争分夺秒，快。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我在龙门这么多年什么都没干......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "错了，甘比诺·里奇，大错特错。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
