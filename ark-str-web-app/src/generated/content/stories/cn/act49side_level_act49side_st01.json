{
  "server": "cn",
  "storyId": "act49side_level_act49side_st01",
  "groupId": "act49side",
  "stageId": "act49side_st01",
  "title": "蒙不失诵",
  "storyCode": "TA-ST-1",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act49side/level_act49side_st01.txt",
  "sourceHash": "0ad10371f90e3add5d49282fe1abdbf73df09fda7de33ad32e6dbc377887ba87",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=2>？？？</>"
    },
    {
      "type": "dialogue",
      "speakerName": "年长的声音",
      "text": "啊......是了，是了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年长的声音",
      "text": "这便是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年长的声音",
      "text": "......大炎的“天数”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=2>1102年 深秋</>"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "哟，还在值班呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "鬼姐——不是，熊sir......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "这不是前阵子中秋节，下城区有市民看花灯看上了车道，我们巡逻的人手不够，没拦住人，结果差点出事故。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "为这事，局长可是发了好一通火......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "嘿呦，那是不太应该。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "我们全队都吃处罚，这个月的执勤时间都得加倍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "她还说最近魏总督不在，我们都得格外小心点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "也是，多小心点总没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "大家伙都辛苦了，正好带了点吃的，大伙分分吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "熊sir，这多不好意思......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "别犟，肚子叫得跟打雷似的，吃点吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "欸我不是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "好端端的，哪来的雷啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "等等，我是眼花了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "执勤的近卫局成员",
      "text": "那边的天上......是什么东西？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的游客",
      "text": "师傅，先不忙着上船，你看那边，好像有什么东西在江上动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的游客",
      "text": "是循兽？可循兽怎么会在江上，背上还驮着什么......酒盏？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "蜃景罢了，你们勾吴城外说不定也有。有什么好看的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "（......破。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的游客",
      "text": "欸，怎么突然下雨了......江上的循兽呢？跑哪去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "今年这场秋雨......怕是要冻煞人啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "炎国士兵",
      "text": "报！报——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎国士兵",
      "text": "巨兽......巨兽抵达最后警戒位置！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎国士兵",
      "text": "最高级警备！重复一遍，全军立即进入最高级警备！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎国士兵",
      "text": "*炎国粗口*......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎国士兵",
      "text": "那东西根本不像是什么“兽”，那明明就是一座山......一整座山......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "府中杂役",
      "text": "大人，您留步吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "府中杂役",
      "text": "太尉大人重病在床，什么人都不可见的，您——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "府中杂役",
      "text": "......啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "太尉在府中吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "府中杂役",
      "text": "在......在！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......带路吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "咳咳......咳咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "......刚才恍惚梦中，仿佛见到故人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "我还以为......是先帝，要来带我走了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "我知道太尉时常追思先帝......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "但此刻就惦记身后事，怕是太心急了一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "陛下......光临......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "恕臣......不能起身行礼了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......几日不见，太尉怎么病成了这副样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "吃过药了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "劳陛下体恤......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "我这痨病本就是陈年顽疾......前阵子中秋气候反常，又染上了风寒......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "朽木之躯，怕是熬不过这个冬天了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......太尉是大炎股肱之臣，不可妄自菲薄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "太尉曾经将多少外敌强虏挡在大炎国门之外，又怎么会畏惧这小小风寒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "安心休养，我还等着太尉早日康复，为我分忧，为大炎解难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "咳咳......老臣年迈昏聩，实在是......不堪所用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "如今大炎，人才济济。大小事务，也都由陛下圣断，又何须老臣置喙......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......我听明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "太尉大人是不满我独断专行，这才要告病还家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "老臣......万万不敢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "近半个月来，来自各地官府，还有各部官员，请战的文书跨过内阁堆满了我的桌子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "各个言辞激烈，几近死谏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "太尉在这个时候称病，到底是要逼我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "咳咳......陛下的确是看见了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "如今大炎上下，对这桩千年的难题，到底是何态度......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "陛下就算不信老臣......也该相信......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "......“人心所向”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "只要能避免让大炎将士轻易流血赴死，任何其他解决之道，我都愿意尝试。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "我本以为，太尉最应该体谅我的心思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "陛下熟读炎国千卷青史......咳咳——难道不曾见......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "古往今来，那些该流的血......哪一次是避......能避得过的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "当断则断。若是一味求全，优柔姑息......要流的血，只多不少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "我本以为......这是陛下早就明白的道理......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "那罪人进入岁陵已半月有余，依然不知吉凶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "如今大炎四方扰攘，不止是那五只巨兽雄踞，更有外敌环伺......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "放他在岁陵里多待一日，大炎的危险就多上十分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "这些不是我一人之见......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "哪怕我能为陛下压制众意一时......也绝不是长久之法......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......那你想要如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "我不能要求陛下收回圣命......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "我只恳请陛下......定下一个时日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "......大炎可以等待的最后时日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "到底是不是该流的血，千百年后，史官、百姓，自有公论。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "在当下，只怕太尉说了不算——我也说了不算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "那等不住的，到底是大炎，还是有些人的争功之心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "......陛下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......但是太尉所言，不无道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "我还记得，那人是八月既望进的岁陵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "那就等到下一个望日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "如果那人在岁陵中依然得不出一个结果，那就依太尉的主意行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "陛下......圣明......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "那便如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "......太尉大人，风寒不是大病，但也要小心休养。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "我听说丹燕的雪梨润肺最好，我一会儿让人送来几枚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "今日吃罢雪梨，睡上一觉，太尉这病也就该好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴影中的人",
      "text": "明日早朝，莫要迟了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=2>望日前三日</>"
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "我们......总算是出来了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "这些巨兽代理人的能耐......当真神奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "镇抚仪式，现在才算结束了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "或许......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "不对，这到底是第几次......我们结束镇抚仪式了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "我们在界园里待了多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "从天师府终端显示的时间来看，现在离我们进入界园，应该过去了......半月有余？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "半月有余？可我怎么觉得，我们好像在里面过了很长一段时间......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "这段时间里，也不知岁陵那边是否有别的动向......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "左兄刚才说，“第几次”......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "我总有一种感觉，我们已经不是第一次站在这里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "结束镇抚仪式，收下玉尺，离开界园，回到小镇......这样的事好像发生了很多次，又好像......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "有时是易先生迎接我们，有时是那个棋手阻拦了我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "有时是后兽化蝶，重创岁兽......也有在半路就中了伥的圈套，莫名其妙被赶出园子的时候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "你一直有这种感觉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "不，之前只是隐隐觉得不对劲，直到刚才，我忽然才有了一种在界园里反反复复进出了许多次的感觉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "若是这样，也许直到现在，镇抚仪式才算是真正结束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......但愿如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "对了，信物在谁手里？好像每次镇抚仪式结束的时候，易先生的玉尺都交给了不一样的人......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "不在我这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "那难道——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一个小物件从左乐的口袋中掉落。\n出乎所有人的预料，那并非是一把玉尺，却是一个小巧的“玩偶”。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "这是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "小姨、云兄，我们拿到过这东西吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哟，都活着出来了，能耐不小嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "祖师！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "祖......祖师。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "你小子，又不是天师府的门生，攀哪门子亲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "呃，那晚辈该称呼您......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "什么称呼不称呼，你轻功好，脚程快，赶紧去做你该做的事儿去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "该做的事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "秉烛人从园子里得了信物，然后该干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "回司岁台，交付玉尺，述职。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "那就快去，还磨蹭什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "可玉尺——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "信物就是信物，不一样肯定有不一样的道理，你直接回司岁台去就是了。难道你还怕那个代理人报失窃不成？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "前辈，我还想问，如今百灶城中——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "磨磨唧唧的，到底你是秉烛人还是我是秉烛人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "城里到底是什么样，你自己用眼睛看不就知道了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "多大的人了，见机行事的道理还不明白吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "我陪左乐同去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "你留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麟青砚",
      "text": "祖师......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "百灶城里现在又用不着人来判冤决狱，你回去也是白搭。你留在这儿，用处还更大些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "姓云的小子也一样，你们都不算司岁台的人，留下，免得添乱。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三人对视片刻，只得默然听令。\n左乐将信物收入怀中，告别众人，纵跃而去。"
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "老......前辈，我还有一事想问......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "我们在进入岁陵前，您带走的那位自称是山海众的姑娘，现在何处？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "哦？看不出来你呆头呆脑，居然也会惦记着人家小姑娘？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "在下只是记得，她曾经说过，界园中存在一件可以阻止炎国与岁兽之间发生战争的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "而您之前特别允许我们进入界园，刚才却完全没有打算检查左乐手中的信物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "是不是意味着......您完全相信，她说的话是对的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "真有意思......你这些心眼子，怎么也不像是跟着那个练武的学出来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "云青萍",
      "text": "在下当然相信您的安排自有道理，我只是有些担心，如果真的是如此重要的物件，左乐是否会遇到危险......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "哼，危险不危险的......事到如今，也没谁能置身事外了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“老天师”",
      "text": "要是那小子真的有当秉烛人的觉悟，这种时候也该站出来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梁",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "怎么了？少见你这么闷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁",
      "text": "我只是在忧心，那件信物，他们能顺利送到吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁",
      "text": "知道信物究竟是何物的人只能袖手旁观，可以帮我们的人却连该将信物往哪送都不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "那位老天师能做到这份上，已经是对我们天大的照顾。剩下的事，只能看我们一家人的造化了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁",
      "text": "没想到最后竟是牵扯了这几位年轻人进来，也不知该说是庆幸，还是让人担忧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "一百多年来，也有不少人走入过这座园子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "而只有他们将那一点生机，从我们遗落的记忆里摘取下来，护送到了这世上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "无论如何也该相信，他们与我们这一家人，多少有些缘分吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁",
      "text": "先生所言在理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "哎，世上风物万千，与人相遇，还是要讲究一个缘分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "早早买好了票，做了攻略，背了地图，站在正门等着开园，结果打雷下雨，什么都没看到，也是有的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "随便从哪个角门进了园子，一路游游逛逛，只要心向一处，结果就能歪打正着，也是有的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "兴起而来，兴尽而返......强求始终，反倒不雅了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "我们就安心在这里等着，守好这座园子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "易",
      "text": "......这良辰美景，还真是没法让人轻易放下呀。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=2>？？？</>"
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "......麻烦麻烦，同样的道理讲了一遍又一遍，说得我口干舌燥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "这不是又回到了最初的起点？我们辩了几千年的时间，兄台的木头脑袋似乎还是绕不过这个弯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低沉的声音",
      "text": "你才是冲天角一根筋，胡搅蛮缠的功夫比做学问的能耐大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低沉的声音",
      "text": "最简单的道理——没有规矩，不成方圆。人活于世，当然要辨是非分善恶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低沉的声音",
      "text": "真要像你说的，所有人都齐万物，倒黑白，这世上得乱成什么样子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "荒矣谬矣......你坚持的循规蹈矩，不过也是画地为牢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "我且问你，要造一房一屋，一城一池，姑且有规矩可循。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "可若要丈量千古功过，万民民心——又该以何为规，以何为矩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低沉的声音",
      "text": "规矩，当然是合时而立，为人而立。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低沉的声音",
      "text": "我又几时说过，要为了立规矩而立规矩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "这是......在哪......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......你们是谁？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "好好好......那我反倒要请教。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "你说规矩非立不可，那该让谁来当这个立规矩的人呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "样貌奇特的工匠",
      "text": "当然是由有德之人——有德方能服众，人人信服的规矩才是规矩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "你瞧，这问题不就来了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "要定规矩，就要先找有德之人，可什么样的人才算有德？为了找这样的有德之人，是不是又得定一套规矩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "矩兄，枉你活了这万年寿数，却连这先有羽兽还是先有蛋的问题都搞不清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "样貌奇特的工匠",
      "text": "呵！简直是无理取闹，强词夺理，倒果为因。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "样貌奇特的工匠",
      "text": "这世上本就有名为“公义”的规矩，又岂是人凭空捏造的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你们在说什么......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "哟，看上去，这位也快要醒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "醒否？梦否？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "样貌奇特的工匠",
      "text": "不必问了，看她这般浑浑噩噩，庸庸碌碌，的确如在梦中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "如梦似醒，非梦非醒。我瞧这位姑娘，现在撞上了难题，可是头疼得很呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "样貌奇特的工匠",
      "text": "冥顽不灵，不明事理，那自然遇上什么问题都要头疼，走什么路都要撞墙的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "这倒是没说错......这姑娘知行不一，自无为却求有为，确实是自相矛盾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "样貌奇特的工匠",
      "text": "事到如今，她指望找到一个有体有形的“公正”，还恨不得将“公正”就这样揣进口袋装走。我瞧她比我那不成器的徒弟还要痴上几分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "样貌奇特的工匠",
      "text": "是了，如果不是世上头一号痴人，又怎会做这般痴心妄想之梦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "矩兄也不必苛责，这世上多的是人缘木求鳞，敲冰求火。又能奈他们何呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "只有一点你说得没错......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣着朴素的老者",
      "text": "这位姑娘，到底是个痴人......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "谁——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "你怎么了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "没什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你刚才，什么都没听到？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "你这人好奇怪，从刚才开始就一直魂不守舍的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "难不成是被那些伥怪打坏了脑子？——那我也没辙的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "多谢你，我还不至于——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我只是觉得......自己好像......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "不是第一次来到这里......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
