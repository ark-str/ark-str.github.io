{
  "server": "cn",
  "storyId": "act45side_level_act45side_03_beg",
  "groupId": "act45side",
  "stageId": "act45side_03",
  "title": "音乐室内的光芒",
  "storyCode": "SS-3",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act45side/level_act45side_03_beg.txt",
  "sourceHash": "a80d4bcfd705f7ff8f4172205fda274a91d90cda5edd5cb6d308cfae36b2ba1c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "狱警",
      "text": "犯人48038，出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的犯人",
      "text": "长官，您有什么吩咐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狱警",
      "text": "检查个人物品，有没有遗漏？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的犯人",
      "text": "没有，东西我都带齐了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狱警",
      "text": "沿着走廊往前面走，走到尽头的那个小窗，签个字离开就行了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的犯人",
      "text": "好、好的，谢谢长官！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "有力的小跑声在长廊上回荡。\n而沉闷的皮靴声则一点点向走廊的最深处靠近。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狱警",
      "text": "海铃。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狱警",
      "text": "滚吧，今年别让我再看到你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "海铃熟练地拿起自己的琴盒，慢悠悠地走出了监狱。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "叙拉古还是和从前一样，用连绵的小雨迎接她的回归。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "这条街，还有前后两条街，每家店都派人盯着，绝对不能让她跑了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谨慎的打手",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的打手",
      "text": "大哥，北街那边传来消息，她朝这边过来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "盯紧她，别让她跑了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的打手",
      "text": "她......她好像没有要躲的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "......让其他人都聚过来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "狭窄的胡同里，一群凶神恶煞的打手，正将提着琴盒的少女团团围住。"
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "又见面了......海铃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "呵，我一开始还在想，你这种高手，怎么没有一个家族把你纳入麾下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "我们家族遭难后，四处打听，才知道你原来是个臭名昭著的“叛徒”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "你前后换过十几个名字，在各个家族间来回接活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "我们的合同里没有写我不能替别人干活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "而且我早就说过——我只是拿人钱财，替人消灾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "所以你就把我们的机密告诉了对家？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "......我不懂你在说什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "*哥伦比亚粗口*，别装傻了！自从你来过后，我们的人就不断遭到暗算！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领头的打手",
      "text": "亏我和老大当时那么信任你，还邀请你加入我们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "弗朗西斯，我不记得我有做过什么对不起你们的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "哼，是你亏欠的人实在太多，想都想不起来了吧？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "老大死了，大家都死了，几百号人现在只剩我们十几个了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "......什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "我们一帮兄弟好不容易从哥伦比亚漂泊到这鬼地方，全栽在你一个人手上了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的打手",
      "text": "别跟她废话了，我们这么多人在这，今天必须给她个教训！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "我不想和你们起冲突......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "虽然海铃努力想要通过言语平息冲突，但对方逼近的脚步没有丝毫停下的意思——\n她不得不放下了拿在手上的琴盒。"
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "所有人......跟我上！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好心的老妇人",
      "text": "小姐，不要再往前走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好心的老妇人",
      "text": "那边刚发生了点事，你一个人去不安全。赶紧绕路吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴着帽子的少女",
      "text": "......谢谢提醒。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "少女并没有理会路人的劝告，而是朝她说的方向继续走去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "雨淅淅沥沥地下着，冲刷着叙拉古的一切。\n少女走进小巷，这里干干净净，仿佛是刚建好一样，一尘不染。\n叙拉古的清洁工总是这么专业。\n潮湿的空气中，闻不到一丝血的气味。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "海铃......你在哪里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你在......找海铃吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一座娱乐场里的台球室。没有人会想到，有人将它当作自己的住所。\n几个纸箱简单地拼成了一张床，最基本的生活用品全被塞进了快餐店赠送的袋子里。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "台球桌上摆满了信封，里面装着海铃的酬劳。\n海铃一一拆开这些信封，将里面的金币随手扔在桌上，一枚枚印刻着“家族”“秩序”的金币很快堆成了一座小山。\n这些金币就这样被随意地放在毫无保护的地方，就算丢了，她也一点都不会心疼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "海铃再次确认了一遍——这封信里什么都没有。\n她将信封翻了过来，上面印着一枚家族徽记，还有一个寄件地址。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的打手",
      "text": "老爷，她来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "监狱里的那些人，没找你麻烦吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "都是老熟人了，更何况，他们都知道我背后的雇主是谁，何必找不痛快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "不过老爷特地把我叫来，恐怕不只是为了问我这种小事吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "呵呵，就是单纯关心一下合作伙伴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "老爷，我们什么时候成合作伙伴了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "我们之前签订合同时，你甚至不愿意以你家族的名义委托我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "既然想成为“合作伙伴”，从现在起当然要开诚布公——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "海铃，我想和你做笔长期生意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "什么生意必须当面谈？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苍老的声音",
      "text": "我想——邀请你加入我的家族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八幡海铃",
      "text": "你说......什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "里面没人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "你明明那么怕她，为什么还要跟过来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "你不是家族成员，当然不懂！我必须......替大家报仇雪恨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "你们和海铃之间到底发生过什么事，她那么不可饶恕吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "你如果经历过这种“背叛”，一定也不会原谅她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "我们家族大部分成员都是从哥伦比亚拓荒区逃难至此的普通人，缺少人脉和资源，所以经常会遭到各种本地帮派的挤对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "这种情况持续了很多年，直到有一天，老大花重金请来了一个打手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "那个人是海铃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "嗯。雇佣她以后，我们度过了很长一段时间的安稳日子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "那段日子真的很美好，再也不用担心据点突然被人偷袭，也不用担心有人上门来找麻烦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "但我们邀请她加入我们家族时，她却拒绝了，而且第二天她整个人还直接消失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "正当我们觉得疑惑的时候，不知道谁引来的对家打手，偷袭了我们的据点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "那场面我至今都不愿回想......实在太惨了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "你觉得是海铃出卖了你们？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "除了她还能是谁，哪有这么巧合的事情？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "......我不相信海铃会做出这种背信弃义的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "我认识的海铃，和你说的一样，能力强大，令人安心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "而且会对自己加入的组织尽职尽责。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "可是，事实就摆在我面前......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "你有在那帮偷袭你的人中，看见她的身影吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "......没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "那你还记得那些偷袭者的面貌吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "一辈子都忘不了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子深吸了一口气，将手伸向了口袋里的防身武器。"
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "如果......是有人故意离间你们呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "text": "如果......是有人一直在监视海铃呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗朗西斯",
      "text": "......你这是什么意思？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "弗朗西斯还没反应过来，四周的柜门突然全部被推开。\n每个柜子里都站着一个身形魁梧的打手，他们手里拿着武器，一齐指向房间中央的两人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "神秘的打手们",
      "text": "不许动。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
