{
  "server": "cn",
  "storyId": "story_mantic_set_1_story_1",
  "groupId": "story_mantic_set_1",
  "stageId": null,
  "title": "缄默",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_mantic_1_1.txt",
  "sourceHash": "fd75007e595004ea8c58a508cab74d0d617794b199f1d0f8c07650edae9bb054",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "罗德岛指挥室"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "把她带回来是我的失误，抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "我需要了解当时的情况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "如我在报告中所述，她昏倒在安全屋附近，奄奄一息，身上盖着一层沙尘，和大多数在沙漠遭遇天灾的人一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "我想给她一口水喝，出于一点以前的习惯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "救助他人的善心没有错，只要能承担相应的责任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "我承认，我没充分考虑她可能会是什么人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "我给了她淡盐水，把她留在村落附近的阴凉处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "下一次见到她就是在飞行器上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "显然，我被她跟踪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "你当时什么都没有察觉到，是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "返程前我执行了完整的舱内检查，没有异常状况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "她是在半途中突然出现的，我甚至不能确定她是否一直潜伏在飞行器内部。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "如果不是她当时体能不足，我没有把握闪避她的袭击。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "根据我们目前的情报，她确实掌握着某种类似隐形的源石技艺，如果你能提供更多细节，我们与她的周旋也许可以轻松一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "抱歉，凯尔希医生。我确实没有发现任何征兆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "甚至没有看到过她在黄沙上留下脚印。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "这或许也是有效的情报。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "对于她袭击你的理由，你是否有判断？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "可能是旧仇，也可能是误会。或者只是穿越荒漠后的应激反应。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "或者只是因为你看到了她。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Stormeye",
          "text": "我也这样想过。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "罗德岛会对她的背景持续调查，但是有的答案或许只能来自她本人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "为了让你放心，Stormeye，她来到罗德岛之后没有伤害任何人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "她接受了体检，在静脉注射过程中自行拔掉针头离开了医疗部，随后被安置到了单间宿舍。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "通过感染监控装置返回的数据来看，目前她没有生命危险。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "只是她一直拒绝与我们沟通。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Stormeye",
          "text": "好。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "那么，接下来是你关心的问题，{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "罗德岛尝试着追溯了她携带的那些身份牌，它们大部分比她本人的年纪更大，是数十年前地区冲突的遗留物。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "我们只能从中得知，她的活动范围穿越了大半个萨尔贡。除此之外，那些身份牌之间找不到更深层的联系。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "另一方面的调查从她携带的武器入手。可以肯定的是，她的主要作战方式是暗杀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "她携带了许多精巧的小型道具，做工并不像是自制。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "但罗德岛无法追踪任何武器与毒剂的来源。以我们现在的情报网络，查不到一丝一毫的信息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "同时，萨尔贡的暗杀活动并不少见，所以我们也无法将她的行动与特定的某一事件对应起来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "最后，从她与罗德岛接触后的行为来看，我们恐怕很难从她那里直接问出任何信息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "她已经苏醒三天了，但一直没有接受我们提供的食物和水。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "如果她对自己的过去这样忠诚，罗德岛真的能与她达成合作吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "——这件事交由你来评判，{@nickname}。如果你有空，可以去看看她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "对罗德岛来说，她首先是感染者，这和她的过往无关。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "如果她愿意配合，罗德岛是可以接纳她的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "老规矩，转酒瓶。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "瓶口指到的人拿走任务。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "所有人沉默地围成一圈。瓶子并不在乎自己选择谁，他们都一样。\n瓶口在她面前停了下来，她取出纸条，安静地退出人群。"
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "所有的指令都在瓶子里的纸条上。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "队长每一次都会说这些话，就好像默认这里有新人。\n她不知道实际上有哪些人来了或者走了，这里的人有时候只有三四个，有时候多达十几个。\n她觉得队长也不知道，因为那个戴白色面罩的人声音也变了。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "哈啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（很危险......差点就又睡着了......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（呃......我身上披着的是什么？这件衣服质地好奇怪......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "我好多年没见到曼提柯了！那个小姑娘还不愿意出来吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（监视的人来了......）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "请冷静一点，华法琳医生。被您绑......请上手术台的话，可能会激发那孩子潜藏的一些心理创伤。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "那凯尔希想怎么办？虽然我们确实有最先进的医疗技术，但是也做不到隔着房门治病。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "凯尔希医生说的是，再给她一些时间......如果她自己不愿意开门，我们也不能做什么。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "对了，我给她找了件旧制服外套，毕竟她之前的那身没法穿了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "那些又是沙子又是血的布料换掉之后，她看起来精神多了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "别太担心，您的实验......呃，您关心的患者应该会很快恢复过来的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "......安静了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "监视的人，走了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "他们知道......我是感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "他们在等我投降......用治病的许诺，骗我投降。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "唔......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "摸不到......就算在身上，用力按到痛，也摸不到里面的源石......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "所以，知道我是感染者的，一定是上面的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "被发现了吗？我没能杀掉那个士兵......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "他们在考验我......想知道我还能不能用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "那样的话，就太好了......我已经，很多天，没有得到指令了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "我会证明自己的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "腿上，被戴上了奇怪的镣铐......像是移动城市才有的科技......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "这里有柔软的床铺......墙缝里也看不见沙子......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "如同梦境中的生活......难道我已经在那位帕夏的身边了吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "喂喂，你好？在睡觉吗？睡醒了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "我知道......肚子饿久了的话是不能一口气吃很多东西的，所以我煮了很淡很淡的粥。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "......没醒啊，那我放在小窗口了哦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "嘿，小古米~今天的早餐轮到你做了吗？早知道这样我就早点起床啦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "啊，你也是来找这个新人的吗？我昨天就想问她要不要和我拼一套美甲套装，但是她一直没出现。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "我听医疗部的干员说她要好好休息，不能随便打扰的哦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "我也不是要上门推销啦，只是想看看她有没有出来活动。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "我好不容易找到一个感觉适合蓝色指甲油的人，随便放过的话很可惜欸。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "呃，宴，在这种事情上不要露出那么认真的表情嘛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（她们习惯于用名字互称......不像是扮演出来的。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（所以，抓到我的，是敌人......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（我的武器，被没收了......尖锐的家具，这里也没有......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（这些人做好了审问的准备，不会让我......提前逃跑......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（而且这里很多人都见过我了......我已经没用了。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（没关系，总有一天会变成这样的......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "对了，昨天和前天放在这里的餐盘她是不是都没有拿？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音B",
          "text": "好像是。她也和瓦伊凡一样可以时不时少吃一顿饭吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "我不知道......饿着肚子不难过吗？而且食物浪费掉多可惜呀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音A",
          "text": "算啦，新朋友好像还没有睡醒呢，我们还是不要吵到她吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "......她们也走了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "那些话......真的是故意说给我听的吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "博士，没想到您也会有空到干员宿舍这边来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "毕竟每次路过您的办公室，都能看到桌上堆满了战斗资料和要处理的文书......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "凯尔希建议我有空来看看她。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "凯尔希医生竟然对您也这样说了......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我很好奇她的情况。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "啊，对，医疗部接收了那位曼提柯女孩之后，大家也都很关心她。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "从办公桌前站起来走走也是一种锻炼身体。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "......虽然很高兴博士您接受了我的劝告，但只是走走恐怕不够。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "啊，但还是先说说那位曼提柯女孩的事情吧。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "从医疗干员的角度来说，我们都想帮助那个女孩。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "虽然她的感染已经发展到了中期，但以罗德岛目前的技术还完全可以控制，避免其进一步恶化。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "感染监控装置收集到的数据显示，她现在体内的源石结晶比较活跃，同时本人因为绝食而非常虚弱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "我们都不想看到病人这样自我消耗......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "不过，突然被带到陌生的环境，醒来还发现自己躺在手术台上，觉得害怕确实很正常。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "我，呃，我带着芙蓉做的健康餐，想来跟她打个招呼，表达我们的善意。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "博士，您有什么想法吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "告诉她罗德岛能够保护她。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "保护？博士，您的意思是......她害怕的不仅仅是陌生的罗德岛吗？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "唔，也许她也很害怕矿石病吧。作为医疗干员，我们会保证她的生命安全的。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "出于善意还是不要给她吃健康餐吧。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "嗯，博士您说得对，健康餐主要成分是冷食，对几天没吃东西的她来说刺激性太强了，而且也不能迅速补充能量。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "告诉她罗德岛需要她的能力。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "咦，博士的意思是，您觉得她也可以成为预备干员吗？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "说实话，要是在演习里遇到看不见的对手，我肯定会很紧张，哈哈。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "呼，有博士在，总觉得说服对方的概率更大一些。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "对了，别把罗德岛的行动描述得太凶险。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "好的，博士。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "其实作为预备干员，我也不知道前辈们，还有博士您，究竟经历过怎样的苦战......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "但是很多人都说，您救过他们。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "你可以把自己信任罗德岛的理由告诉她。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "我自己吗？我相信罗德岛治疗矿石病的决心，也很敬仰凯尔希老师的学识与能力。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "安赛尔",
              "text": "而且在一些危险行动中救治伤员时，我相信博士会指挥好一切，而我只需要做好医疗干员该做的事情。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "我大概会把这些告诉她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "博士，您要和我一起去吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你藏在这里几天了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你甚至没有杀死一只野兽，给自己弄点食物的能力，对吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "我......我并不想这样......我不是故意要藏起来的，只是谁都看不见我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "我......没有武器，也没有碰过武器......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你明明天生就有武器。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "我一直很小心......我的尾巴，从没伤害过任何人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你想用你的柔弱骗取谁的同情呢？你已经没有观众了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你的矿石病都发展到现在的地步了，你还觉得自己能正常地在市集上打工，从别人手里换来食物？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "你......你怎么知道......你是谁？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你应该很清楚，过去的那种生活里已经没有你的位置了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你得学会拿起武器，这是现在的你唯一的价值。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "不......我不会......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你看，这是矿石病的止痛药。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "你想活下去，对吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "我的队伍恰好可以接纳你这样的怪物。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴白色面罩的人",
          "text": "加入我们吧，领袖会救你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "呜......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "熟悉的饥饿感，以及在缺水中意识缓缓枯萎的感觉。\n在长时间的蹲伏中，这种境况时有发生。她能够判断自己目前的身体机能，如果是在执行任务，她还不会失手。\n不过，以往的每一次任务都会指定一个交付地点，只要到了那里，她就能得到休息。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "这一次的纸条上，没有写......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "啊......我明明已经没用了，却还希望得救......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "明明早就知道......队长，是在说谎......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "门外的声音",
          "text": "你好......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "你好，我是安赛尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "抱歉，我不知道该怎么称呼你。不过在罗德岛，有很多人不愿意提起自己的姓名，于是选择用代号来自称。你也可以给自己起一个。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（他们都说这里是罗德岛，罗德岛是哪里？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（这件衣服上也是这么写的......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "我能够理解......你醒来，发现自己在陌生的环境里，一定会很紧张。所以我首先要澄清，我们没有恶意。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "嗯......当时我就是站在旁边做记录的助手之一，所以我真心希望你不要误会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "我们是一家无国籍的医疗公司，旨在帮助泰拉各地的感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "虽然你并不是主动前来求医的，而是意外被带到了罗德岛，但由于你当时的身体状况不佳，我们出于医者的本职进行了临床检查。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（他也说这里是医疗公司......是哥伦比亚人来这里开的公司吗？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "我们真的很想帮助你......不过你不愿意接受的话，我们也不会强求。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "啊，但是罗德岛眼下并不在萨尔贡境内。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（不在......萨尔贡？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "如果你想回去，我们也只能在下一次停靠移动城市的时候让你离舰，请你自己找到回家的路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "当然如果你愿意留在这里的话更好。呃，我们的体检也不会涉及什么个人隐私的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "而且，应该已经有人向你介绍过博士了吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（博士......确实是一个总被提到的称号......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "博士说，你的能力会在他的战术里有一席之地。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "因为感染者的处境并不好，我们尝试救助感染者的时候，也难免会跟其他人产生一些冲突。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "所以，也需要一些有战斗能力和战斗意愿的伙伴，去保护其他人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（需要的意思是......我，我还有用吗？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "呃，不要害怕，我想你会和我一样先当个预备干员吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "而且前辈们都说博士的指挥值得信任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "许多从绝境中生还的前辈说，博士把他们带了回来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（......真的？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（他们不会让我去送死？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "（清嗓子）......你、你们好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "......博士，她好像还是没有回应。您要先回去吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "不，请等一等......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "现在房间里听不到任何动静，也有可能对方正在睡觉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "不要走......我可以证明自己......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "指挥者，请不要丢下我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "安赛尔",
          "text": "我虽然很担心她，但目前还是不要过度打扰她比较好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "我在这里......请注意到我呀......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "惊慌的曼提柯女孩",
          "text": "我想活下去......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "门似乎微微晃动了一下。",
