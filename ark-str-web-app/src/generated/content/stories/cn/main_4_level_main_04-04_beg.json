{
  "server": "cn",
  "storyId": "main_4_level_main_04-04_beg",
  "groupId": "main_4",
  "stageId": "main_04-04",
  "title": "不要恐慌",
  "storyCode": "4-4",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-04_beg.txt",
  "sourceHash": "7dc996f8be26b5701842e9c21b3cab971d1240bb80814031f4d52d1db140cd07",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "没等太久吧。近卫局的会议稍微耽误了点时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "没事的，陈长官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "（陈长官，就像什么事都没发生过一样......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "情况如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛的侦查小队已经提供了一些有效情报。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我总结了一下，从其中选了几条你会感兴趣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "啊......星熊警官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "别在意。我也想稍微听一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "继续说吧，阿米娅，没关系的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "好的。依据罗德岛从部分感染者那里得来的线索——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "侦查小队已经查明了龙门平民区内整合运动的一部分窝点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "然后呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "有数支整合运动小队正在谋划针对龙门的防卫力量发动袭击。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们甚至查到一个整合运动向内渗透的渠道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "呵，真是嚣张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "龙门近卫局被小看了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "关于那个切尔诺伯格分城废墟的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛有数支侦查小队正同时在分城执行任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "其中确实徘徊着许多整合运动的成员，而原本的居民基本都不知去向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "有一支小队甚至与整合运动发生了三次以上战斗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "只是，以目前的情报量而言，我们还不能断定这个分城与整合运动的行动究竟有何联系......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "但我建议，将这座分城作为接下来的重点作战目标之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......是吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "星熊，帮我去拿下报表。在我桌子左边第三格抽屉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "现在？行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你继续说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "嗯，综上所述......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛建议，应该发动一次联合作战，完全剿灭龙门内部的整合运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "并不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "近卫局不会允许的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......什么？陈长官......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我说，不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你，是感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "再在贫民区内执行任务，只会引起更大的骚乱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "这是近卫局的决定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "啊，稍等，我接一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这里是阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是，是阿米娅吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......！杰西卡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "是的，这里是杰西卡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是在进行什么隐秘行动吗，声音这么轻......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "我们在分城废墟发现了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "......整合运动的领袖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "而且有......两个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "什么？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "丧家犬就这样灰溜溜的跑回来了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我可不属于你们这种下等种族哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——如果你不是成功完成了任务，我一定让你这张脸上多添一两道疤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "麻烦被炸的手足全失的小孩子用嘴来为我化妆，真过意不去呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我们两个斗嘴——可是没什么好处的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我姑且承认了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "那么，鱼上钩了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "一定。就看爱国者那个老家伙能不能把真货带回去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "说起来，你还挺怕这老头的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我心情已经有些不太好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哎呀，抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不过在钓上大鱼之前，对吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "要么我们俩，就先相互忍耐一下吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哼。是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我先得解决这些小的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "罗德岛的几位，出来吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——想要在我面前隐藏自己，是绝对不可能的哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "杰西卡，别！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "这可能是陷阱......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "他发现我们了！必须——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "如果击倒敌人的领袖的话，我们......必须......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "嗯，果然在啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是哪里来的小猫咪呢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "这里可不是让你随意玩耍的地方哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "喂，你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "是！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——分食丰盛的猎物之前——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "先去尝尝小的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "噢噢，噢噢噢！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "呿！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
