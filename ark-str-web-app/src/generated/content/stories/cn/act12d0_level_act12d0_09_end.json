  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act12d0/level_act12d0_09_end.txt",
  "sourceHash": "6c773b44aa89f81581134463b1b946f26afe70a7c7d186dc248b1ca59840d2a1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "结束了，特米米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......还、还没有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "努尔，佩塔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪伦",
      "text": "博士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "博士——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "不想让你的同伴受到伤害的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "别逼我生气啊，特米米！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......嘉维尔你不留下来的话，我是不会收手的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪伦",
      "text": "救我啊，博士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "博士，我好怕呜呜呜......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "交给你的任务完成了？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "迪伦",
              "text": "博士，别这么不上道嘛，小姑娘这么情真意切，配合一下又不会死。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Lancet-2",
              "text": "唉，这里的人这么淳朴，老实说，欺骗他们让我有些良心不安呢，虽然我没有心。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "迪伦",
              "text": "哎呀，博士，你别用那种眼神看着我。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "迪伦",
              "text": "安心，我怎么也是罗德岛的干员，这点小事都做不好怎么行。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "不要怕！我这就来救你们！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Lancet-2",
              "text": "博士——！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Lancet-2！",
          "value": "4",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "诶？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿达克利斯人",
              "text": "什么时候挣脱的！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "迪伦",
              "text": "哈哈，抱歉啊，其实从一开始就没绑住。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "博士，难道你早就料到了特米米会这么做？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "博士——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迪伦",
          "text": "哇，你们两个演的比我还起劲啊。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "当然。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "想不发现才难。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "你你你、你是怎么发现的？！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "首先，是你在第一次提到祖玛玛时出现的犹豫。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "啊？犹豫？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "然后，是在祭典时，你对嘉维尔突然行动的惊慌。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "最后，迪伦，东西呢？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迪伦",
          "text": "哦，我放在Lancet-2身上了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "呜呜......要不是为了博士，我可不会轻易让人在我身体里放东西哦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "这是......火箭筒？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迪伦",
          "text": "对，在特米米的部族里找到的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "难道说......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迪伦",
          "text": "没错，把我们轰下来的罪魁祸首，就是这个小丫头啦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "特米米。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "呜呜呜，我错了，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "过来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "呜呜呜......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "趴到我大腿上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嘉维尔，你不要打我，我知道错了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "那可不行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "对付不听话的小鬼，当然要打尾巴！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "呜呜呜......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "刻俄柏",
          "text": "打尾巴，好像很痛的样子......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "知道错了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "知道错了，呜呜呜......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "知道错了就好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "总之，这下应该算是没事了，博士。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "累了。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "哈哈哈，确实这一连串发生的事还挺多的。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "喂，博士，你该不会站着睡着了吧。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "你刚才居然没有用那招什么大风车。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "我当然不伤到特米米这孩子啊。唉，我可是都有点累了。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "这个大家伙......乍一看虽然好像很丑，但是这个棱角，粗犷的设计感，杂乱却有效的线路连接，仔细看看有一种独特的美。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "嗯，是适合结婚的类型呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哦，Lancet-2，你快去看看引擎还有没有救。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "诶？难道引擎在这个大家伙身上？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "对啊，被我们打爆了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "哇，可怜的引擎，可怜的大个子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "迪伦先生，可以过来帮我个忙吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迪伦",
          "text": "好嘞。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "喂，祖玛玛，你怎么了，傻站在那儿。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "嘉维尔，嘉维尔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "啊？干什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "那个，那个！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哪个啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "那个，那个会动会说话的机器是怎么回事！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哦，你说Lancet-2啊，她是我们的同伴啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "我、我可以和她说话吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "这有什么不行的？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "那个，你好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "你好？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你是机器吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "我的产品名称是雷神存在者S—Typer62六轮作业平台，隶属罗德岛，代号Lancet-2。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "哦哦！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "是的，我拥有一定程度的智能，如果是不怎么困难的问题的话，我应该可以为你解答。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "顺便一提，作为面向医疗的作业平台，我的知识储备偏向医疗方面，这点还请注意哦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "^%&$*#(#......！！！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "有什么事吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "我可以抱抱你吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "诶？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "那家伙在干什么啊，脑子进水了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "这不是很明显吗，她被那台机器震慑了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "就像她第一次见到移动城市时的震撼一样，一台能自己行动，还会自己说话的机器对她的冲击，比那还要大！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "别说她了，我也兴奋得不行好吗！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "噢，这位美丽的小姐，我可以有幸邀请你进行一次约会吗！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "我知道这片雨林中景色最美的地方，让我们去那里度过一个美好的下午吧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "咦，我、我被邀请了吗？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "怎么办，稍微有点开心......博士，我应该接受吗？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "接受吧。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "森蚺",
              "text": "大祭司，你不要抢，不然别怪我不顾我们这么多年的情谊。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "老实说，我现在和博士心情相同。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "有点想笑。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "不准抢走我的Lancet-2！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Lancet-2",
              "text": "诶，博士，你忽然这样说，我还没有做好心理准备......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "嘉维尔，你们那里能造出这样的机器吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "啊？呃，我觉得可露希尔应该可以吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "好。我决定了，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你的那个叫罗德岛的地方还缺人吗，我也要加入你们。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "我要去你们那里学习机械技术。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哈？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "我虽然也想过去外面学习，但因为部族的关系一直没有认真考虑这件事，现在我觉得这是个好机会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "那、那我也要去！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
