          "text": "嗯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "喂，嘉维尔，来帮我翻译一下这家伙在说什么。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "燧石",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
