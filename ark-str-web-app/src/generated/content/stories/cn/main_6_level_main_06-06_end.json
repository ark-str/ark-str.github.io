{
  "server": "cn",
  "storyId": "main_6_level_main_06-06_end",
  "groupId": "main_6",
  "stageId": "main_06-06",
  "title": "断弦",
  "storyCode": "6-7",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_06-06_end.txt",
  "sourceHash": "a160c024a3f8cb308c0e9566d2d9ba8caff3265c399f8731b92429b27ace1adf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "他不哭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "他这个眼神，怎么和脑死了一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "他我可怜不起来。我可怜浮士德，他救了我的命，也是个好指挥官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德把梅菲斯特托付给了我们......这是他最后的命令。我们会做到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "干我什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "一起出城，你们存活的可能性会大些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "......行，那走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你们要把他带去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德说过，不希望我们带他回切尔诺伯格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......可他又有哪里可以去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你们跟浮士德多久了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "哈......一开始，是他跟着我们才对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "四五年前，浮士德并不会用什么战术，弩箭用的也并不好。这些都是我们教他的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "他不断地学，不断地练习，和雪怪切磋，和爱国者的士兵一起训练，他越来越强......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "爱国者和霜星都教过他。他成了我们的队长，虽然我们不怎么这么叫他，但他名副其实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "......你们很幸运。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "不管梅菲斯特怎么样，浮士德从来没逼我们做过什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "射手们，不要省高爆弩弹了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "这些弩弹，一会儿还能用来对付近卫局啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德一直坚持为我们死去的队友这么做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "“表达敬意可以不算是浪费。”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "灰喉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "如果我没记错，他应该是梅菲斯特身边的弩手，整合运动的另一位指挥官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......你认识他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "我不知道。我不知道自己和他......算不算认识。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "罗德岛能做的事，好像真的不多。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "是啊。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "罗德岛就是这样......大多数时候，都是这样。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "但哪怕只有一点点能做的，我们也会去做。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我们一定会去做。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "博士是在想过去的事情吗？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "是在想......过去也看过许多次死亡？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "我是猜不出博士的心思，也不想直接感知博士你的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "因为......我想博士有一天能亲自告诉我。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我们真的有成功救下过什么感染者吗？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "......干员们付出了许多。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "死亡会比拯救更令人印象深刻。任何一次死亡，都会很难忘。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "但是我很清楚，如果没有干员们的努力，我们会看见更多死亡。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "更多，更多，更多的死亡......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "以前我以为，罗德岛就是为了感染者去战斗的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "可是现在，倒在我们手下的却都是感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "阿米娅......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "罗德岛在为什么而战？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "你现在问这种问题？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "煌。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "......你说吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "这个问题，我也常常问自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "感染者，普通人，每天都在我们面前死去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......我们不会，也不应该只是“阻止一次死亡”。对于这片大地来说，这没有意义。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "就像现在......就像我们面对的这场战斗一样。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "让战斗双方死去的，绝不是一把弩，一个法术......一场爆炸或是一个伤口。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我们要战胜的，是催生了这一切的......普通人对感染者的仇视，感染者对普通人的仇视，他们互相厮杀的理由。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我们要铲除滋生仇恨的土壤。既用药物，也用行动。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "啊——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "那是不是整合运动发射的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......是施加了源石技艺的弩弹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "好烂的烟火啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "按临光说的，在切尔诺伯格的时候，这长鳞的小子还有着相当强的战斗力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "她说那时候她的胳膊都差点被打断，凭我对这个女人的了解，至少我肯定是打不断的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "但刚才我只觉得他的弦已经完了，弩弹里也没剩下多少法术。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "怎么回事啊，臭小子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我想，他可能......没有理由再战斗下去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "我说，阿米娅，有没有他用法术避过了攻击的可能性？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......抱歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "道什么歉啊。我只是可惜那个小子。凭我一眼看穿人的本事看，他不坏。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "现在说什么都太晚了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "并不晚。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "过去埋下的悲剧，现在开花结果......而未来的悲剧，我们还有能力去阻止。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "我去回收他的弩。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "她开窍了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你不知道她的过去吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "她没告诉我啊？我们也没那么熟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "她的父母是矿石病学者，为了感染者研究矿石病，却死在了一场感染者与当局发生的冲突之中。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "她只是认为，我们遭遇的和她遭遇的并没有区别。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "灰喉比你想的敏感得多。她大概只是不想表达。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "不肯说出来，我哪知道......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "他是你的朋友吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......我不知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "你是谁？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "需要我自我介绍吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "不用了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "和感染者做朋友是很危险的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "我不在乎朋友是不是感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "这样吗......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "节哀顺变。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......为什么要问我这些？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "因为我很怕你和感染者做朋友。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "阿米娅，通讯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "这里是阿米娅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嘉维尔？你在哪里？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......贫民区底部通道？有新通道，怎么会？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......黑色雨披，以及......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "雪怪小队？他们在和逃入贫民区的整合运动汇合？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "......最坏的事儿还是发生了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
