  "storyId": "act5d0_level_act5d0_02_beg",
  "groupId": "act5d0",
  "stageId": "act5d0_02",
  "title": "7:15P.M.",
  "storyCode": "CB-2",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act5d0/level_act5d0_02_beg.txt",
  "sourceHash": "7c0385936d2b2b6871ef2352af778d252156971328bfa9fe6e753c37b1fc9daf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "咳咳，咳，大家还好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "勉强，挡住了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "及时的反应，二位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哎呀，这可......炸得真彻底啊。嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "————*难以名状的企鹅尖啸*————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "（怎、怎么了？老板发出很奇怪的声音喔！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "（喂！刚才那箱黑胶唱片是不是老板从黑市上淘来的哥伦比亚珍藏品？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "（好像是的，怎么办，我已经很久没有见过老板这种万物皆空的表情了......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "什么怎么办——啊！他们上车了！那群穿黑衣服的家伙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等等！可如果他们一开始就设好了陷阱，为什么不埋伏我们？情况古怪，我们应该定制一个具体的计划再去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "德克萨斯！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "上车。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "......你们，给我听好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "今晚的所有违章罚单全部报销。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "我要让他们，给我的黑胶陪葬啊啊啊——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "看见了，就是前面那辆！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "能天使！把我的老伙计拿来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "得令！老板！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "那是把铳枪！？但您要怎么扣扳机......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "啊哈！见识不小嘛，小少爷，让我们的铳械专家来介绍一下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "总计四十二层运输纸板，工业胶水无缝粘贴，高质量橡皮筋驱动，嗯，真是一把不错的铳枪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......就是说，玩具？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "其实就是弹弓——痛！不对，是和平铳枪！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "在龙门市区不允许使用实弹，这是规矩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "每次我都在想，老板只有在这个时候遵守规矩呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "如果连我们都不守规矩了，龙门立刻就会被炸上天，明白吗？打开车篷，德克萨斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "注意点。不要像上次那样撞在信号灯上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "我有那么高吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "二号狙击位准备就绪，老板~！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等、等等，路上还有其他的车辆，我们难道就直接——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "开车的黑帮",
      "text": "那帮家伙开火了！喂，还击啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后座的黑帮",
      "text": "开什么玩笑，车开得这么颠簸怎么瞄准！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "开车的黑帮",
      "text": "你、你中弹了！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后座的黑帮",
      "text": "血，我流血了，快给我绷带——不对，这是什么，橡皮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "开车的黑帮",
      "text": "只是橡皮！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后座的黑帮",
      "text": "但这橡皮能打穿玻璃！快甩开他们、啊，好疼！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "准头不错，老板！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "咬紧他们，德克萨斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "要加速了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "慢点，小心前面的货车——噫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "抓稳点喔，德克萨斯姐飙起车来是不讲情面的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "阿能，打爆他们的车胎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "用橡皮弹打橡胶车胎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "只要我想，就能做到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "德克萨斯小姐，就不能阻止他们一下吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "（撇开头）......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "算啦算啦，他们玩得很开心嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "看招看招！给我表演一下原地大回旋！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "开车的黑帮",
      "text": "喂，方向盘打不动了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后座的黑帮",
      "text": "废话，赶紧跳车！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等等！车速这么快，我们也会被卷进去的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "好嘞，连环追尾就交给你了！德克萨斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "啧，尽给我找麻烦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
