{
  "server": "cn",
  "storyId": "story_fartth_set_1_story_1",
  "groupId": "story_fartth_set_1",
  "stageId": null,
  "title": "容身之所",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_fartth_1_1.txt",
  "sourceHash": "29cff8c3db111dcfd369f9f85ab09ac826e94364222bb71d54f36a1b4f2b8232",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "“你会回来？真的？当上骑士就回来？”\n“......那就这么说定了。我们都等着你荣归故里，到时我们就到处去宣传，这里可是骑士查丝汀娜的故乡！”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我的......故乡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "小心一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天真的孩子",
      "text": "对不起，姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天真的孩子",
      "text": "我没在村子里见过你，你是外乡来的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我出生在这里，后来去了大骑士领。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天真的孩子",
      "text": "大骑士领！难道姐姐你是一名骑士？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天真的孩子",
      "text": "肯定没错，这副盔甲比休伯特用木板做的漂亮多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天真的孩子",
      "text": "可以让我看看你的弩箭吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "和善的村民",
      "text": "米伦！不要缠着人家！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "和善的村民",
      "text": "真是抱歉小姐，这孩子最近迷上了骑士小说，一见生人就问个不停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "和善的村民",
      "text": "您......看起来有些眼熟......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "丹卡婶婶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "......查丝汀娜？你真的回来了......啊，现在应该叫你“远牙骑士”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "我们从报纸上看到了你取得封号的消息，大家都为你高兴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "你还记得柯尔叔叔吗？他把你的每条新闻都剪下来贴在墙上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "只要你赢了比赛，他就会额外开一瓶酒为你庆祝——虽然我们都觉得他只是为自己的贪杯找借口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "不过......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "你生病了......这还是我们从报纸上看到的，村里的人都很担心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我的病情控制得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "那就好，那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "嗯？米伦，你手里拿的是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米伦",
      "text": "骑士姐姐的箭匣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "别碰！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "......我是说把它还给远牙骑士，这是很贵重的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "就算不会伤人也很危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "是我欠考虑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "丹卡婶婶",
      "text": "远牙骑士，您要进村坐坐吗？大伙都很想念您，只是我需要先去通知一声......做些准备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "发什么呆啊，远牙骑士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "感染者转移之后要先清点人数。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......二组全员到齐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "（什么时候数的......明明看着在发呆啊？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急切的男人",
      "text": "有没有人看到小佐拉？她去哪儿了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "出什么事了，法洛恩老师？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "法洛恩",
      "text": "我本来以为小佐拉只是对新的聚集区好奇，出去探险了，但她到现在都没回来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "从第九住宅区转移过来的时候有没有人看见她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "法洛恩",
      "text": "我没注意......那时候天色还没亮，我光顾着给腿脚受伤的同乡引路......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "别太担心，我们会找到她的，但需要先缩小搜索范围，两个区块之间隔了不少建筑设施。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "索娜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我可能知道那个孩子去了哪里。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一天前"
    },
    {
      "type": "dialogue",
      "speakerName": "开朗的感染者",
      "text": "又见到你们了，我的朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "这是半年来的第几次了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "开朗的感染者",
      "text": "第四次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "开朗的感染者",
      "text": "我们在这片废弃厂区待得算久的啦，距离上次转移足足过了三个月。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "开朗的感染者",
      "text": "有一次可是刚落脚没几天就被无胄盟找上门了。打那以后我收拾行李都只用两个包袱，方便随时跑路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "唉......索娜也在找适合长住的地方，现在只能委屈你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "开朗的感染者",
      "text": "这也不是你们的错。我们现在还能在大骑士领生活，全靠红松骑士团接济。再说了，感染者又能在哪里歇脚呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "开朗的感染者",
      "text": "我们还在移动地块边缘流浪的时候就已经习惯了，只是小佐拉有些不高兴，早上还跟法洛恩老师吵了一架。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......商业联合会的清剿决策还在收紧，除了商业地块之外，居民区也不比之前安全了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "之前有骑士在附近街道看到无胄盟巡逻的迹象，虽然人员不多，但是个值得警戒的信号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "要我说，我们直接干掉巡逻小队，告诉那群董事这里就是红松骑士团的地盘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "然后让他们顺理成章地趁我们人手不足炸毁工厂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "查丝汀娜，你觉得呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......只是座废弃工厂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "就是！到时候在附近另找个地方——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......不是家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "他们的家已经毁在天灾之中，现在应该转移到更安全的地方，让更多的人活下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "远牙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我们现在还没有跟商业联合会明着掰手腕的能力，或许有一天我们会有自己的地块，让所有大骑士领的感染者都有家可回。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "明天一早出发。小灰和我最熟悉路线规划，我们领队。艾沃娜负责扫清障碍，查丝汀娜负责侦察援护。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "至于今天晚上——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我来守夜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "那是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......佐拉？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "前些天这条小路还没有巡逻的黑衣人啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "不行，再绕路的话我要迟到了，只能......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你在这里做什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "唔——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "晚上不能离开聚集区，很危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "查丝汀娜姐姐......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我送你回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "不，不行。丽塔还在等我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "丽塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "请不要告诉法洛恩老师，如果他知道我和居民区的孩子交朋友，他一定会生气的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "可丽塔真的不是坏人。她不在意我的病，还夸我画画很好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "查丝汀娜姐姐，我们为什么隔三岔五就要换地方住？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "只要把身体裹起来，我就跟普通人没什么差别。丽塔带我进过商店，没有人发现我生了病。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "我真的不想再走了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "村子被毁掉之后，我们只能在荒地上兜圈子，剩下的食物也越来越少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "是法洛恩老师找到了索娜姐姐，我们才能进入大骑士领。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "可我们好像还是四处流浪，只是从地上变到地下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "慢慢地，我开始记不清村头的树丛结的是哪种莓果，以前我很爱吃的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "如果村子还在，我们就不需要像现在这样了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "感染者能回到哪里去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "姐姐，你的家也被天灾毁了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "不，那座村庄自建成以来从未受过灾害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "真好......它在哪里？景色漂亮吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "在北部森林和平原的交界地带。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "那里......确实是个很美的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "告诉我吧，查丝汀娜姐姐！你的家乡是什么样子的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "下次吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手",
      "text": "谁在那里！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......第三支巡逻小队？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通讯器中的声音",
      "text": "......巡逻小队请回复......是否需要增援......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我们必须走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "可......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "可我还没跟丽塔道别......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "法洛恩",
      "text": "我提醒过她，不要跟非感染者的孩子在一起玩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "聚集区里没有同龄的孩子，小佐拉难免会想找个朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "无胄盟可不会在意她是不是孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "她是名感染者。对他们而言幼小代表的不是可爱天真，而是易于“清扫”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "法洛恩",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "查丝汀娜，关于佐拉的猜测，你有多大把握？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......我不能确定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "撤离第九区时我们已经打草惊蛇，现在仓库可能正被无胄盟把守，无论是侦察员还是突击队，人数只会多不会少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者骑士",
      "text": "除了这个区块的感染者，我们还需要为另一批灾民保驾护航，他们今天刚移动到大骑士领边缘，正等待我们救援。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手A",
      "text": "我刚听到那间储藏室里有点动静，要不要过去看一下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手B",
      "text": "废弃仓库有些肮脏的小动物也很正常，我才不要进去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "储藏室......是佐拉之前画画的地方！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "绿色......红色的飘带......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "对，对......还有黄色，跟她的眼睛一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "......箭匣上也有花纹，里面有很多发亮的弩箭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "姐姐的箭很准，只要射出一支，就、就能把黑衣人都吓跑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "不用怕......不用怕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "狙击镜的位置不太对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "要是放那么前面，我就射不准了啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "查丝汀娜姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "呜......对不起......我只是想来拿送给丽塔的道别礼物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "就算不能送出去，我也想自己留下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "会再见面的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "先从这里出去......你还走得动吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "藏进来的时候我的脚扭了一下......对不起姐姐......我好害怕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "没关系的，不需要道歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......闭上眼睛，佐拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我的家乡，昨天你问我它是什么样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "闭上眼睛，我说给你听。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "什、什么声音......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "查丝汀娜姐姐你还好吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "不要睁开眼睛，我没事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "振翅的小虫伏在穗上，收获的镰刀挥过，它跃进泥土。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "还有风。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "风的旋律是柯尔叔叔常吹的那支小调，柔软地抚过耳畔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "这就是我的......家。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "（增援的人手来得太快，很难从正门带佐拉离开......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手",
      "text": "什么声音？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通讯器中的声音",
      "text": "我们遇袭了，这里果然就是那群感染者骑士窝藏难民的据点，提高警惕！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "（......想想办法，团体赛的时候也是一对多......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......野鬃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "调用这么大规模的杀手小队驻守废弃仓库，商业联合会什么时候也会做亏本买卖了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手",
      "text": "就一个人还想跟我们作对......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手",
      "text": "哼，多一个帮手也——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "你冲得太前面了，野鬃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "骑枪的使命就是深入敌军，分割战场，这是战术！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "那制定计划的意义在哪里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "计划赶不上变化嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰的意思是你离我们的阵形太远，她的盾没办法保护你啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......我没这么说！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "我们不是来接人的吗，查丝汀娜去哪儿了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "在那儿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "查丝汀娜，你猜得真准，小佐拉果然在这儿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "你们......谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "太客气了，查丝汀娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "其余的骑士已经去救助新的伙伴了，本来我们就打算留下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "谁能想到你冲得比我还快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "虽然我们没聊过几句，但现在我还挺喜欢你的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "十一点钟、两点钟方向有增援。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "对方站位太过分散，我的弹药不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "交给我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手",
      "text": "对方有狙击手！聚拢阵形，别被逐个击破！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "多谢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "漂亮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "正面出口打开。驻守工厂的无胄盟杀手都已经被打趴下啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "通讯装置处理完毕，短时间内不会有更多追兵。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "不对。"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "小佐拉？你可以睁开眼睛啦，错过这样一场大战实在可惜，不过你还是小孩子嘛。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "风声不对。"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "查丝汀娜？你怎么了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无胄盟杀手",
      "text": "呃——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......哇，好险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "我完全没意识到楼上还藏着一个狙击手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "查丝汀娜，你怎么发现他的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "听不见风的声音。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "嗯......那里有扇窗户，风会影响箭的轨迹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "我猜你也没听明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哈哈......过段时间你们就能适应查丝汀娜的说话风格啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "佐拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐拉",
      "text": "查丝汀娜姐姐......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "已经没有危险了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "我们回家。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "“滴滴”——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "谁？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“正义骑士号”",
      "text": "（疑惑的滴滴声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "这是野鬃的......宠物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“正义骑士号”",
      "text": "（欢快的滴滴声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“正义骑士号”",
      "text": "（响亮的滴滴声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "等、等一下......大家会被吵醒的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "开关......开关在哪里......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "开关在挡板后面哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "不过我不建议你关掉她。突然接收不到周围的信息，正义号会很寂寞的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你喜欢跟人待在一起，对不对？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“正义骑士号”",
      "text": "（欢快的滴滴声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "嗯？查丝汀娜......什么东西的声音......从没听过......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......我的口笛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "原来你还会吹笛子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "哦......我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你是想要听众才让正义号叫人来的，是不是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你可算找对人了！虽然不太懂音乐，但我是名非常优秀的观众。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "请开始你的演奏吧，远牙骑士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "你只是喜欢凑热闹吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "格蕾纳蒂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你也是被正义号叫醒的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "我是被你吵醒的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "那你得感谢我，查丝汀娜正准备为我们演奏曲子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "别为难查丝汀娜......这是口笛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "在家乡，我认识一位腿脚不方便的老奶奶，她总在屋子里吹曲子，用的就是这种自制乐器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "嗯......确实有些怀念以前常听的民谣小调了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你们背着我偷偷来楼顶聚会？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "亏我念在救援行动比较辛苦的分上，还想让你们多睡一会儿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "text": "你也被吵醒了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我在想小佐拉的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "艾沃娜之前说得对，在地下躲藏并非长久之计。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "大家习惯了颠沛流离的生活，逐渐忘记感染者也应该有自己的家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "既然都醒着，下来陪我聊聊，我有了一个新想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "哎，那演奏......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "下次，艾沃娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查丝汀娜",
      "text": "下次吹给你们听，我家乡的曲子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
