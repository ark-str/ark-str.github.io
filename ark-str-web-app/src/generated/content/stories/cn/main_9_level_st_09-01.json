{
  "server": "cn",
  "storyId": "main_9_level_st_09-01",
  "groupId": "main_9",
  "stageId": "st_09-01",
  "title": "风暴突击",
  "storyCode": "9-1",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_st_09-01.txt",
  "sourceHash": "11ff90f1bca779e684c8b4b1a21b64f8d37cf8f90cbe59277b88db3d21e06499",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "我们已进入仓库。侦查组，报告情况。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "队长，东南角有生命体征。距离你们七排货架，活动范围一米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "人数？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "一人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "有没有源石反应？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "暂时没发现。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "好，各自就位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "风笛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "你在找什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "队长，是不是有人在唱歌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "别分心。这说明目标不在警戒状态。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "按照作战计划，等我信号，你来突入。现在，继续前进。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "五、四、三......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "准备——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "掩体已破坏！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "咳咳咳......怎、怎么回事？突然好大的烟！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "不许动！待在原地，举起双手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "我、我......你们是......维多利亚士兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "为什么你这样称呼我们？你不也是维多利亚人吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "他要逃跑。大提琴，注意拦截！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "队长，他没有往出口去，他折回来了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "三角铁！目标扑向了后排货架！只要监测到源石反应，立刻发射弩弹！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "其他人，到我盾后集合！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "快！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "风笛，你在做什么？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "我捂住了！大家快跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "队长，没有源石反应，风笛身下不是炸弹。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "啊！虚惊一场嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "......目标呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "不好意思，撞得有点狠。他一时半会站不起来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "那这些箱子里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "我看看啊，全都是土豆和胡萝卜，还有花椰菜哎！被我压坏了。好可惜，看起来都挺好吃的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "不要放松警惕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "这排，这排，还有这排......都一样。队长，这仓库里全是果蔬粮食啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "三角铁，注意周围有没有其他人靠近。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "双簧管，你和风笛一起搜查仓库。有发现随时给信号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "大提琴，把这位瘫倒在地的先生绑起来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "唔呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "现在，先生，麻烦你回答几个问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "我、我什么都不知道，我每天都会在这里分拣土豆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "你是小丘郡的居民？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "你听说过鬼魂部队么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "鬼......什么？呵、呵呵......部队说的不就是你们这些当兵的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "把洛瑞、朱利亚和克里斯他们抓走......现在是不是、是不是也轮到我了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "请你冷静一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "听好。有人看到，昨天半夜有一批源石制品被送进了这个仓库。而如今它们不在这里。你需要对此作出解释。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "解释？你们真想要这个，而不是直接吊死我？我、我......呸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "嘿！你怎么乱吐唾沫？也太不注意卫生了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "有线索吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "没有，队长，到处都是土豆。如果消息没错的话，他们的动作有够快的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "带走他。他一定知道些什么，只是还不愿意开口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "我就说......你们都一样！费尽心思地找我们的错处，折磨我们......你们这些维多利亚的吃人恶兽！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "啊？又来？他觉得把一个维多利亚同胞叫作维多利亚人算是种辱骂吗？真是搞不明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "队长，有人来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "几个？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "（准备散开。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "（是，队长。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "报告，队长，他们好像是自己人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "人在这里。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚士兵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "（队长，我们被包围了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "（从人数上来说，是。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "（听声音的话，留在外面的人好像不是很多。从我手边破墙的话，我们有机会哎！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "（稍安勿躁。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "看起来这里刚刚发生了一场激烈的战斗。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "丽塔·斯卡曼德罗斯，第七前线步兵营，第二风暴突击队队长。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你好，斯卡曼......斯卡曼德罗斯中尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "我的名字不算好记。您可以叫我号角，上尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好的，号角女士。我叫凯利，路易斯·凯利。抱歉，我们这里不流行代号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "凯利上尉，您和您的部下想必也是为了追查这个仓库而来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "是的，我们也收到了情报。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "那您应当能理解事件的严重性。一批数量不少的非法源石制品，两个月前就被人从军用运输路线上窃走，最后消失在这一带。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "不需要我来提醒您，上尉，这么多武器，加上周边各郡近期失窃的那些，如果全部落到不法分子的手里，受到威胁的可远不止小丘郡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "......好，谢谢你说这些。我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "我们也很感谢您的配合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "希尔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希尔",
      "text": "长官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "把这个年轻人......这个可疑分子抓回军营。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "啊？这人是我们好不容易找到的线索！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希尔",
      "text": "长官，她的矛在妨碍我执行任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "风笛，松手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "可是我们的任务——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "——我们现在在小丘郡地界上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "凯利上尉从口袋里掏出一块手帕，擦了擦额上的汗。"
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "很高兴你想通了，中尉。你与这位年轻的瓦伊凡女士，还有其他诸位......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "咳咳，你们一路从伦蒂尼姆赶过来，想必路途艰辛，累得不轻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "这是我们身为维多利亚军人的职责。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "是啊，没错。接下来，如果你们还想在小丘郡活动的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "我们必须继续追查源石制品失窃案，这是来自伦蒂尼姆的命令。我想汉密尔顿上校也会理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "当然，当然。你们可以随我一块回军营。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "队长，我们真的要把人让给他们吗？他们绝对是故意的！从我们进入郊区地块开始，他们就跟了上来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "直到现在我们抓到了人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "“帝国驻军有责任对驻地发生的危害公共安全的事件进行响应。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "他们没有违反规定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "唉......好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "上尉，人是你们的了。按照规定，我们也可以参与审讯——希望您还记得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "哈、哈哈......这确实符合规定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "不、不要......放开我！不要抓我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希尔",
      "text": "呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "救我......救救我！我什么都没干......我不知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌张的青年",
      "text": "啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "希尔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希尔",
      "text": "这些塔拉渣滓总是这么聒噪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯利上尉",
      "text": "......带走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "欸欸，这人怎么这样啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "（队长，我觉得......那个年轻菲林在向我们求救。他很害怕跟他们走。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "（......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "（三角铁？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "我在，队长。我还在外面树上老位置，他们没注意到我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "（那就好。你带着侦察小组，继续沿附近运输路线调查。有线索立刻汇报。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角铁",
      "text": "好。队长，需要向驻军通报吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "......注意保护自己。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
