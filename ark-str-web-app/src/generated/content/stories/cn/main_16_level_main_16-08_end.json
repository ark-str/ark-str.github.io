  "sourceHash": "a94d4e43ae5818f89994d9e68a7fcbb606c547ad684529fc208d0ae0965db1f6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=1>乌萨斯远北中心矿区</>"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "科谢尼娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科谢尼娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "需要歇歇吗？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "啊？不......不用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我只是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "如果你现在还有顾虑......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我们也可以自己去找。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "（摇头）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "给你们带路是我自己的选择，何况我本身也确实想知道关于“奥卡”的真相，我没什么顾虑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "就算将来追查到我，我最多也不过是被流放罢了......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "博士，前面的路应该是安全的，我没有检测到其他人的存在——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "咦？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "科谢尼娅的视线扫向Mon3tr，很快又僵硬地撇开。\n你注意到这一路来，这位研究员一直默默跟在Mon3tr的身后，时不时地打量着她，而现在连Mon3tr都察觉到了这一点。"
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "科谢尼娅，你一直在偷看我......我哪里看上去很奇怪吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "什么？不，不是！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "......我只是，看着你，想起了一些很久以前的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "什么事？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "你瞧......问题就在于，其实我也没法完全想起来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "那些记忆太久远了，已经模糊到看不清楚，像浸了水油，字迹散成一团的纸......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "但也许......我能问你一些问题吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "当然啦！虽然我也不确定自己能不能回答得上来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "你说，你叫Mon3tr，对吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "对，这是我的名字。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "Mon3tr......Mon3tr。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "她轻轻地咀嚼着这个陌生的名字。"
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "Mon3tr小姐，你——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "你会不会很冷......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "欸？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我是说......我的意思是，你穿得很单薄。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "如果你需要的话，我可以把外套脱下来给你，至少能在进入矿洞前为你遮些风。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "......就是它可能有点旧了——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "哦、哦！我明白了，不用！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "因为你是第一个问我这种问题的人，所以我有点没反应过来，不过我确实不冷！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（对Mon3tr摇头）",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Mon3tr",
              "text": "嗯，我没觉得冷，但是谢谢你的关心！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mon3tr",
              "text": "博士，你刚才是想说什么吗？",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        },
        {
          "label": "（向科谢尼娅点头）",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "没事。你们聊。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Mon3tr",
              "text": "没关系的，科谢尼娅，你可以信任我们。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mon3tr",
              "text": "我们还要同行好一段路呢，有什么问题都可以问我。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "科谢尼娅",
              "text": "嗯......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "科谢尼娅",
              "text": "你们刚才说到，你们是凯尔希所长的同伴......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "科谢尼娅",
              "text": "凯尔希所长......她现在，还好吗？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mon3tr",
              "text": "啊......",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你对凯尔希很熟悉？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我想......或许算不上熟悉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "当时我只是作为伊利亚老师的助手参与研究，能直接接触到凯尔希所长的机会并不多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "所以我只记得一些......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "科谢尼娅！科谢尼娅！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "老师，我在......我在！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "上午的实验数据为什么还没有出现在我的桌上？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "对不起老师，我这就去拿！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "我说了多少遍，想参与进来就要跟上整个项目的节奏。如果我需要的只是一个把仪表上的数字抄到纸上的助手，我三岁的女儿也能干。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "还有，这些稿纸上写的是什么？能量转换公式？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "科谢尼娅，我认为你应该先做好自己的本职工作，再去做一些尝试。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "这是什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "啊，不值得浪费您时间的东西，凯尔希所长。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "科谢尼娅毕竟还只是一个年轻的学生，熟悉实验项目还需要些时间，如果出了什么差错，责任也在我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "这是你推导出的公式？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "对......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "很有创意的理论模型，推演的逻辑也没有问题。假如这个公式成立的话，我们将得到一套转化率极高的供能装置。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "但这组数据似乎没有考虑到动能的折损，数据的有效性还有待验证。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "真要命......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "对......对不起，凯尔希所长。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "不必道歉。你只是想积极地参与进来，不是吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "下一次汇报，你也可以来旁听。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "真、真的......？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "还有，不必那么苛责，伊利亚。年轻人的探索欲弥足珍贵，你应该适当地给予鼓励。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "你在这个年纪，犯过比这离谱得多的错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊利亚",
          "text": "好吧，您说得对。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "谢......谢谢您......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "凯尔希所长......她确实曾一度点燃过我的理想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我曾经和在那里的许多人一样，无比迫切地希望这项对石棺的研究，能最终指向一种全新的、普惠大众的清洁能源。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "如此，矿工能从危险的矿区作业中解放出来，感染者能不再用生命当作燃料去驱动乌萨斯这头畸形的庞然大物。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "那时的我是多么天真，竟从未想过......国家性格的形成也像人一样有其原因，它不是那样轻易就能被撼动或改变的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "无论如何，在那场事故之后，能再次听到凯尔希所长的名字，我真的很高兴。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我在想，至少，我能不能——能不能......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "再见到她？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "科谢尼娅，关于这件事......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "抱歉！如果这个请求使你们为难，那就当我没有说过吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我只是以为，你们听上去、看上去，都和所长有关，你们也许会认识她，知道她的去向，或者清楚她过得好不好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "不过，我大概本来就没资格知道这些......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "科谢尼娅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "你会再见到凯尔希的。肯定会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "啊，这么说她确实还......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "太好了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "无论如何，我们都会再见到凯尔希的。博士，对不对？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......没错。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我会期待的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "如果可以的话，我也想去塞拉菲娜提到的，凯尔希所长创立的“罗德岛”看看......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "请等一下......有些奇怪......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我们一路走过来，好像完全没有见到过任何其他人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "不只是矿工，这里已经很接近矿井了，我们连一支纠察队、一个卫兵都没有见到过。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "女大公封锁了整个矿区。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "这里的人应该都被转移了？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "封锁矿区我知道，但人员转移——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "不......这和我得知的情况不一样。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我以为这里的问题只关乎“奥卡”的实验失败，可是我从来没有听说过有谁要清空整个矿区。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "的确很奇怪。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自从我们进入矿区后，遇到的防卫力量就少得可怜。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "甚至不如布列斯克城内的防守严密。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那些消失的矿工......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "到底去了哪里？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "<p=1>乌萨斯远北地区，苔原</>\n雷尔金在车厢的门板上刻下最后一笔，然后扔掉了石头。"
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "我也会画这个符号了，下次我帮你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "行，下次换你来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我这边都整理好了，其他车厢里的东西也都搬出来了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "保尔他们那边已经搬完了，剩下两辆车里面本来就没什么可用的物资，我们要把机械元件拆下来带走吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我记得你说你以前在城里的机械厂干活。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "对。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "那拆一些吧，适配性强的、在其他机器上也能用的部件，也许能卖了换钱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "前提是......会有人愿意接手。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "还有伤员也需要考虑在内。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "塞拉菲娜女士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "队伍里有太多失去行动能力的伤员，在脱离载具的条件下立刻继续上路根本不现实。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "我们需要休整。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "雷尔金！东西都清点好了，省着点吃预计能撑两三天吧，应该够我们走到下一个村庄。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我以为会更多点......没什么，有粮食就已经很不错了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "别乔克还带人挖到了一些鼷兽囤积的坚果，顶饿，而且能放很久。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "现在比起食物，我们更缺医疗物资——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "那我们能去哪里找？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "那只有移动城市，或者流动医疗点了。如果能联系上流动医疗点......",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "雷尔金下意识地看向Raidian。"
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "我可以尝试联系附近的流动医疗点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "谢谢您，塞拉菲娜女士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "先别急着道谢，我有一个条件。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "女士，我感谢你和你的小队为我们提供的帮助，但我们现在的情况——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "条件是，在我尝试联系流动医疗点期间，伤员不能继续赶路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "作为医护人员，我认为伤员需要继续休息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "不会把他们颠来倒去的那种休息。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "你要带哪些人去？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "利特，保尔，还有几个能从他们车间主管手里哄出子儿来的油子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "你过去并不喜欢那几个洗矿厂里出来的油滑家伙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "这与我的喜好无关。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "为什么不带上我？就因为我可能会反驳你？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我们是去附近的村庄求助，不是去圣骏堡的舞会上募捐，“老爷”。你那套东西，对大字不识的农民没用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "你再这样喊我，我会打烂你的鼻子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "恐怕在那之前你的手指骨就断了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "你并不觉得去村庄求助是个好主意。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "......没错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "但在塞拉菲娜女士联系上流动医疗点之前，我们不能就这样无所事事地待着。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我们不是伤员。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "但我们不是没有无所事事过。大伙之前还唱过歌，跳过舞——你还拉了手风琴！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "你也说了，那是之前。现有的物资很快会用完，在那之前，我必须做些力所能及的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "而在我们离开的时候......我需要你留在这里，照看剩下的所有人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "我不认为这次那些村民就会向我们提供帮助。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "当然，感染者不是普通人开门时乐见的对象，这点我们已经从之前的经历里体会得很清楚了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "雷尔金进去多久了？我们是不是得去看看情况？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "你冷静点。雷尔金让我们等消息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "可上次——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "出来吧，“小枝条”。我知道你一直跟着我们。雷尔金肯定也发现了，他只是不说。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "为什么不跟尼克托他们一起留在后方呢？你奶奶也需要你照顾。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "奶奶说，没关系......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "我想，帮忙。所以就，来了。我能帮忙！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "尼克托知道你跟着我们来了吗？他会以为你掉队了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "我，给他，留了......信。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "那也行。其实我也觉得你能帮上忙，可雷尔金说什么都不愿意带上你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "老师......他去，做什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "他去交涉了，看能不能从村民手里换到点粮食。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "我们，用什么......和他们换？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "载具上的零件。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "可他明明什么也没带就过去了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "......也许他要先展示友好的态度，拿着武器或者零件铁块过去可不算是毫无威胁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "不行，上次他也什么都没带，结果那些人一边和他周旋，一边派人从后门出去喊了纠察队来——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "我得去帮他！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "保尔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "唉......我们也跟上去！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "（小声）你给我站住！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "雷尔金就在里面——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "矿工伸出手捂住同伴的嘴，闪到一旁。\n门内传出模糊的交谈声。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "门内的声音",
          "text": "......明白......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门内的声音",
          "text": "（金属摩擦的声音）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门内的声音",
          "text": "......已经......去通知......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门内的声音",
          "text": "（撞击声）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "（小声）动静听上去不对劲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "唔唔呜呜呜——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "（小声）答应我你不会直接闯进去，我就松手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "（点头）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "恢复正常呼吸的一瞬间，情绪激动的矿工就将手指向了民居的后门。\n所有人都看到了雪地上那几枚向远处延伸的、清晰的脚印。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "（小声）......该死。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "（小声）你们几个，随便出一个人去敲门。急迫一点，等里面的人问起就编个说辞。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "油滑的矿工",
          "text": "（小声）凭什么你不去？万一雷尔金已经被抓住，下一个不就轮到敲门的人了吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "（小声）我、我去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "（小声）不，别乔克——",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "别乔克屈起手指，轻轻敲在木门上。\n从门内传来的声响几乎立刻就消失了。"
        },
        {
          "type": "dialogue",
          "speakerName": "门内的声音",
          "text": "谁啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "（小声）......继续敲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "（敲门）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "门内的声音",
          "text": "这么快就回来了......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "村民",
          "text": "呃！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "发生什么——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "老先生！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "雷尔金，你没事？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "利特？我不是让你们在外面等——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "......别乔克？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "你为什么在这儿？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "......所以，你们都是受到指示，从矿区出来找补给的矿工。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "是的，完全正确，好心的先生！我替那个鲁莽的家伙向您道歉，他没怎么离开过矿井，才分不清好人和坏人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "激动的矿工",
          "text": "对不起，对不起。我们之前向其他村庄求助的时候，发生过一些不愉快的事情，我还以为这次也一样——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "保尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "你倒是个实诚的孩子。至于其他村庄的人会怎么对感染者，我也清楚......不如说，乌萨斯大部分人都这样。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "不过，你们又不是那些不服从管理，一心只想制造混乱的感染者。你们是矿工，对吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "当然！您一定也知道，如果没有上面的大人们允许，我们走不出矿区半步。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "这位是我们的工头。上面要求他在找到补给之后，才能带我们回去复命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "要是找不到，上面的老爷是不是就不会给你们饭吃了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "唉，是的。我们这些成年人倒还好，只是像“小枝条”这样的孩子，正是经不起饿的年纪，又要怎么办呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "“小枝条”，是说这孩子？她也是矿工？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "......你几岁了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "十、十——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "十岁？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "十五岁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "哈哈，你有点怕羞，就像我女儿......如果她还活着，现在孩子都该有你这么大了吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "她染上石头病之后就主动去了矿区。不过那地方不在这边，在东部，北原矿场？总之是更远的地方......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "别乔克",
          "text": "矿、矿区，很好。别......别担心，爷爷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "爷爷......哈哈，爷爷......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "我甚至不知道是在什么时候，什么原因让她得了病。问她，她也不愿说。我已经很久没得到她的消息了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "唉，不说这个了！管理你们矿区的人应该待你们还不错，不像有些完全不管死活的，既不给人吃的，也不给他们其他的活路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "听说有些矿工为了活命，宁愿被纠察队抓去也要逃走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "您能帮助我们吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "在你们进来之前，我家老婆子就已经出去找其他人商量这件事啦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "原来那脚印是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "利特，零件呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "在我这儿。给。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "雷尔金接过，把用衣物包裹的东西直接递给眼前的老人。"
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "这是给您的。应该能把它装在收割机上，替换老化的零件。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我们不想白白让您给出存粮。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "行啊，行啊......说实话，我也不懂这些，只知道收割机确实坏了有一段时间了。如果你想帮忙，可以帮我直接把它换上去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "冷静的矿工",
          "text": "我来看看吧，我以前是机械厂工人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "好啊，那再好不过了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "......居然真的换到了粮食，而且还不少。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "根纳季先生说，他们村今年明明是个丰年，收割机却坏了。好不容易人工收完了苔麦，却没想到根本没有商队来，余粮也就卖不出去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "没有现钱，大家日子都过得紧巴巴的。就算这样，他们还是愿意把东西拿出来给我们，而不是等到开春再卖。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "尼克托",
          "text": "利特说那些零件可比苔麦值钱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "就我们现在的情况而言，粮食才是无价的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "小伙子......你们必须马上就回去吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我们完成了任务，确实应该回去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "我还想着让你们把肚子都填饱了再走呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "就算不跟我们一起，西边有些空屋，是以前村里的几户人家搬走后留下来的，你可以让大伙都去那儿，自己生火，做点吃的，暖暖身子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "......谢谢您......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "我真不知道要怎么才能表达感谢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "不用。那了不起的姑娘帮我们修好了收割机，来年就能派上用场，真要说起来，我们才得感谢你们呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "而且我们其实也没帮上什么忙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "村子里，大伙过冬的储备粮多数是不能动的，虽然现在纠察队来得少了些，但税吏时不时来一趟也一样伤筋动骨。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "现在也就是我们几个老家伙从各户的存粮里多少掏了点出来，好给你们回去交差。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "别的我们也帮不了啦——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "也许您能把您女儿的名字告诉我，我们——嗯——回到矿区之后，也许能托人帮您问问。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "哦，她不在咱们远北！她在北原，要往东边走了，可远着呢......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷尔金",
          "text": "您告诉我吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "好吧，反正告诉你也没什么关系。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "友善的村民",
          "text": "她叫米拉娜......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "暗处，一双空洞无神的眼睛觑着所有人。\n篝火噼啪，轻易掩去了他含糊的呢喃。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "霍里",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍里",
          "text": "得到......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍里",
          "text": "救赎。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
