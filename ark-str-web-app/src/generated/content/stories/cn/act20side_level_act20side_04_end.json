{
  "server": "cn",
  "storyId": "act20side_level_act20side_04_end",
  "groupId": "act20side",
  "stageId": "act20side_04",
  "title": "“大水坑”",
  "storyCode": "IC-4",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act20side/level_act20side_04_end.txt",
  "sourceHash": "604d55faf8998e8cc257c11a1b19fc03a16f549babc71e9ebd016b2f1d4d58a1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "根据大家表决的结果，陪伴了我们半年多的“大水坑”即将完成它的历史使命。它会被爆破拆解，重新回归为工程材料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "市民们，这场稍微延长了一点的夏日狂欢恐怕即将结束了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "呜呜呜，我会永远记得这段美好的时光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "超级旋转大滑梯真是怎么玩都玩不够，居然就要和它告别了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "不过！取代“大水坑”的，会是更新的，更美的，更不一样的建筑！！毕竟这里可是际崖城，是最棒的建筑设计师们缔造的城市！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "斯第奇·画布和卡奇·叙光是际崖城新生代里最引人瞩目的建筑设计师，他们会在未来的几个月里交出自己的设计方案......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "到那时，又会是一场怎样的强者对决呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "呼呼，简直让人想起几年前，他们初露锋芒的时候，围绕着穹顶的那场竞标大赛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "当年的穹顶之争没有胜利者，那么这次，谁会取得下一个际崖城地标的设计权呢？让我们——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "我先喝口水。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "克罗绮，你今天这个状态，不会是喝了酒来的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "暂时没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "这风格可不像你啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "依娜姆给我看的录像里，地上的比赛中有一个职位叫做主持人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "我打算拓展一下职业路径。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "总之！建筑设计师们的设计虽然暂时还等不来，但是，市民们，这个夏天的尾巴可是稍纵即逝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "就让我们在滑梯消失前的最后时间里，去玩它个爽吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "哦！！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉维尔！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "特米米，小心！你慢点！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "之前你们在阿卡胡拉的大瀑布玩水，我听说了以后可是羡慕了好久呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘿嘿，这次我也可以加入啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "你这孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "嗯？平常你都小心翼翼地藏着尾巴，这么一看，是不是又变粗了点？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "欸？才没有！我来之前才刚用卷尺量过！已经好几个月没有变粗了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "哦，看来真的很在意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "呜呜呜，看我的泼水攻击！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "很大胆嘛！来就来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "她们似乎比你更像杜林人呢，斯第奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "你也未必知道什么叫“杜林人”，鲁珀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "你好像有点紧张，在担心和卡奇的竞标吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "担心他？笑话！我还没沦落到担心比不过卡奇的境地。不过是他的方案一向比较招外行人的喜欢罢了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "也有些人是比较看好我的方案的，或许我该拿出点不同的风格，好赢过那家伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "要不然干脆......唉！现在还是别想了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "......说实话，如果不论美学，仅从可玩度上而言，这“大水坑”也还算凑合吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "原来你也会享受这些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "偶尔的话。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "斯第奇，你在这儿啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "想不想感受下流速全开滑梯的威力？因为会对设备有损耗，平常可没这机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "我刚和极境哥试了几次，那种速度感！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "不过掉进水里的时候会有点疼，你要不要试试？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "不用，我对这种玩法可没有一点兴趣......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "哟吼，小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "卡奇老弟，这冲击力，没的说！水花居然能溅这么高！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "我们要不试试换种玩法，比如说......比谁的水花小？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "压水花？好思路！听起来不会那么疼了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我的沙堡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "（卡奇老弟，我们是不是惹祸了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "（呃，就算是斯第奇，也不至于为了沙堡生气吧？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "（可他看起来就是生气了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "（要不然我们......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "就这么跑了？你们两个，给我回来！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "嗯，情绪调动相当不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "这都是我学习的成果，感谢这些录像带。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "接下来，我们可以用一系列的比赛，维持住“竞赛”这个概念的热潮，再借着几个月后卡奇和斯第奇的竞标，把气氛推到最高点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "我们是不是可以印发一批小纸片，让观众们可以借此表达自己对某一方的支持，最后如果猜对了会有点奖品之类的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "我们管这东西叫奖券，克罗绮你真是无师自通。地上的商人们可是把这东西当做自己敛财的手段呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "杜林人对这样赚钱可没兴趣......不如让输的那一方承包胜利者一个月的酒吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "唔，刺激一点承包两个月也行。这个可以由投票决定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "然后关于输几个月酒的竞猜或许也能再发一批奖券......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "......我开始担心际崖城市民的未来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "唔，这种其实没派上什么用场的感觉真是难得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "怎么？你一定得揍些什么才满意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "也不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "不过，如果顺利的话，阿卡胡拉能收获些杜林的技术，这就不算白回来一趟了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉维尔虽然很早就离开了家，但其实还蛮关心阿卡胡拉的吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "嗯，就算看过了各种各样的地方，还是雨林里最让我安心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "那你会回来吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "暂时还没这个打算。我在罗德岛上还有病人呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "相当多提亚卡乌希望你回去，你甚至可以考虑成为王酋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "他们还希望地上会直接长蕉果。这片大地总不会遂了每个人的愿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "嘉维尔，你来担任阿卡胡拉的王酋是最合适的，只有你才能镇住所有提亚卡乌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "所有人都在期待着你的回归。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "而如果你实在不愿意，那么，最后结果可能会变成萨尔贡宫廷派一个王酋来管理阿卡胡拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "到时候，阿卡胡拉一定不会再像如今这么自由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "依娜姆，不是还有你这个大酋长吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "......不，有些事情我是没办法做的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "我可以想办法帮大家从外面倒一点破烂回来。但真正能够把提亚卡乌紧紧拧成一条藤蔓的，不会是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "依娜姆，我也并不是在逃避责任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "只是，我还没想好怎么做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "嘉维尔居然在“想”，真难得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "喂，祖玛玛，想打架吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我的意思是，嘉维尔一般都是做了再去想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "关于我自己，或许可以。但如果关于这么多提亚卡乌......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "该结束的总会结束，不是吗，就像是这大滑梯一样，拆掉，然后会建新的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "其实我刚才没听见你们在聊什么啦，我只是想说，朋友们，趁它还没消失，我来给你们拍张合照吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "哈哈，也好，复杂的东西暂时放到一边。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "眼下先要尽兴！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "特米米，你也笑起来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "看来你们已经学会杜林人的哲学了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "毕竟休个假可不容易，怎么能浪费呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "说得好，我该敬你一杯！想尝尝浆果番茄酒吗？我请。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "不，这个还是算了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "嗯，消失得很轻盈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我还以为你会喝得烂醉如泥，然后错过目睹这玩意被炸掉的美好景色。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "哈哈，我只是比较擅长享受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "但是，在这种时候，我更倾向于保持清醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "这是我对正在消逝之物最基本的尊重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "哇哦，难道你其实是个深藏不露的聪明人？这种人设就算是在际崖城的图书馆藏书中也算是烂俗了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "你这小子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "斯第奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "......卡奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "接下来就是要动真格的了，我们公平竞争，各凭本事吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "不介意的话，握个手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "......好吧，出于对另一位际崖城公民最基本的尊重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "我说，你们是不是其实关系蛮好的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "你用哪只眼睛看出来的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "接下来就是要动真格的了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "......克罗绮什么时候又喝上了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "预热的预热，前奏的前奏，际崖城大竞技系列第一季！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "恰卡恰卡恰卡恰卡——咚咚！游泳大赛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克罗绮·砖石",
      "text": "几位，有没有兴趣？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
