    },
    {
      "type": "dialogue",
      "speakerName": "杰克",
      "text": "那，那我帮你推轮椅吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "获救者代表",
      "text": "我没事，恢复得很好，你看！",
