    },
    {
      "type": "dialogue",
      "speakerName": "罗德岛干员",
      "text": "你还好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰克",
      "text": "我......我不知道！",
