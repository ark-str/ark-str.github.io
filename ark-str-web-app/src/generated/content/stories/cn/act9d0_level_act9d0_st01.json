{
  "server": "cn",
  "storyId": "act9d0_level_act9d0_st01",
  "groupId": "act9d0",
  "stageId": "act9d0_st01",
  "title": "求生",
  "storyCode": "DM-ST-1",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act9d0/level_act9d0_st01.txt",
  "sourceHash": "f7aaa90597892b784738899ffa5b5fcc3811f72d85bce48a5e6fa142d5cd1d09",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你们还要往前走吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不进行治疗的话，你会感染的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "——我凭什么相信一个魔族？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "魔族、魔族呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "身边尽是些魔族，我都快忘记这个称呼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "嘁，你不要跟在我们后面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我已经离得很远了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "别这么假惺惺的，要是想动手的话，现在就动手啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "卢、卢布廖夫，别刺激她比较好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......行了，我们自己走就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "别管她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "对、对不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "感染就感染，我们不要魔族帮忙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嗯哼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "这附近有一家废弃的医院。切尔诺伯格区级医院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你们想知道在哪里吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "卢布廖夫......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "别听她的，肯定都是骗我们的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "咱们甩掉她......走快点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "看到那边的巷子了吗？你从那个拐角跑进去，一分钟之内跑到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "——跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "跑的还挺快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "她、她怎么这么快就跟上来了——唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "卢布廖夫......你的腿！血、血变成黑色了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "嘁，要不是刚才救了你，我怎么会跑不过她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "对不起、对不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "算了！小声点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "别让她发现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "前面的街道，左拐，能看到一处被毁掉的广场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "广场西边，那座最大的白色建筑，是医院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "废弃的医院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......我们，好像已经被发现了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "都是你不听话——算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "喂，魔族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......你为什么要告诉我们？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "一时兴起啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你们两个，什么关系？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......我只是出来找吃的，遇见了他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "是卢布廖夫救了我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嗯......所以你听他的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "算了，随便吧，现在，轮到你帮帮你自己的救命恩人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "你想让他做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "卢布廖夫......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "没什么。我说过，前面不远，就有一家医院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "当然，整合运动也不傻，不会干放着那些医疗物资视作无物......所以，如果你想救这位卢布廖夫小朋友......就去偷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那里都是感染者暴徒，是杀了你们的家人、亲人、朋友的暴徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "也只有那里有抑制矿石病早期症状的药剂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "去偷，去抢，怎么都好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "但是不要指望那边的人会帮你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "别去！没必要听他的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "但、但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "别去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他知道你的名字，卢布廖夫，你知道他的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "这和现在有什么关系！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "别去！你做不到的！那里都是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......我想试试......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "不光是卢布廖夫哥哥，好多人都在天灾发生的时候受了伤......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "大家都很痛......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "你怎么能不听我的话！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他没有义务听你的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "想要救那些人，想法很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "记住我说的那家医院，医疗物资已经被集中在了地下仓库。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你可以从停车场的通风管道潜进去，或者从排水沟里走，只要化学废料没那么多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "说不定，你会死在那里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "看吧，你的脚都在打颤，别想了！我们就不该听这个魔族的话！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "赶紧走吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "噫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "发、发生什么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "龙门发生了不少事......也让这里出现了一些缺口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在如今的切尔诺伯格，那可是难得的战地医院，怎么会没有别的人打它的主意呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你们觉得为什么......身为魔族的我，会对那里有一家医院这么清楚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "你这个——唔，啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他很痛苦，而且照这个势头发展下去，他无药可救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "如果你不做决定的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你们就死在这里吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "你、呜、你到底想做什么！别过来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "还是不去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "啊......不过你现在去说不定也晚了，既然已经发生暴乱，去偷东西就更难了吧——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我，我去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——嗯......会死哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "为什么要听她的话，是我把你救出来的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "可我、我想试试......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "你哪能做到啊！我们继续去找药店和食物，这样就好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "对不起！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "啊......等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "连他的名字都不知道，想出声阻止都没法子，真可怜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "你......你骗他！你这个魔鬼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "骗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我可没有说一句谎话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "当然，信不信我，由你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "信不信他，也随便你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......我，我要去找他，呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "他、他没有我什么都做不到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在担心他会逃跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在想......他为什么要把你一个人留给我，留给一个魔族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "我没有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "*乌萨斯粗口*！你这个怪物——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "闭嘴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......就在这里等他。一步都不许动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "否则，我现在就可以杀了你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "呜——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你以为我是谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我是凶手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是毁了这座城市，伤害你父母和朋友的凶手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......啊，哈哈，对了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "忘记你还有这把刀。那刀柄上的是萨卡兹的配饰，还染着血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你猜猜看是谁的血？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "呜......呜呜，我，我不知道......你让他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哭吧，孩子是可以哭的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "至于之后的死活......就要看你们的表现了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "他做不到的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "如果不是我把他从废墟地下挖出来，他早就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......他不能没有我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "没有谁......是不能没有另一个人的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "又安静下来了，这座废城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "自从那场屠杀之后，反抗者就少了很多。不错啊，这样才能少费点力气，少死点人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不过，医院的方向，好像也没动静了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "他......他没有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "他也许......根本就没有去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "都已经......呜，这么久了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他逃跑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "但是你救了他，他也会为了救你而努力，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "还是说，只有你才能救他，他不能救你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "他......他一直以来什么事都做不好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "去找食物的时候也是！他连店里有其他人都察觉不到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "都怪他！我的腿才会——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你要去哪儿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "我......自己回去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我说过，离开这儿你就会死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "但是他已经逃走了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嚯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你的眼神，你在恨他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "我，我没有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "就算......就算他去了......已经这么久了......他肯定已经......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——住嘴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在他回来之前，你什么都不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你可以觉得他会回来，也可以觉得不会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "但觉得他不会，怀疑他，恨他，是你的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你假定他的失败，他的逃走，为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "因为你是救了他的人？你是强的那一方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......呜呜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "呜啊啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你还有劲哭啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "放心吧，很快你就会痛得哭不出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "念在你年纪小，又不是萨卡兹，如果你真撑不下去的话，可以告诉我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我来帮你解脱。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "呜......呃嗯......呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "已经意识模糊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "算了......看来是真的来不及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "不要......我还能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "他......等他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你重新信任他，只是因为你太怕死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "小孩总是善于察言观色的。想这样从我这里博好感，可没戏呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不过，的确已经耽误太长时间了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "最后十分钟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "放心，真到了那个时候，我倒也不至于让一个孩子在痛苦中死去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......已经连呜咽的力气都没有了吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在想什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在恨我吗？还是在恨他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "又或者，在后悔自己要多管闲事，救一个人，害得自己负伤？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......我没有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你还有力气说话，倒是让我刮目相看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "听着，卢布廖夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "决定一个人所作所为的，是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是出身？身份？还是过去？一直以来扣在他身上的行为枷锁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "都不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是他生命中的一切对他产生的影响，是时刻在改变的，他自己的信念和想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "以及，他到底多么相信自己的这个信念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你救了他，但你自己心底里都不相信他，瞧不起他，因为你把自己当做了他的救世主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他呢，也很单纯。你救了他，所以他想救你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在这方面，他的确比你强一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "收好你的刀，那是萨卡兹的刀。我替它的主人把它送给你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "使用它，学会使用它，或者拿去卖了换点钱，随你喜欢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那么，就这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "你......你在说什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "卢、卢布廖夫！你还好吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "你看！你看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我把一整个医疗箱都偷到手了！有止痛剂，还有绷带！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "卢布廖夫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "吵死......了，我还没死......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "好、好的，我这就给你包扎一下伤口......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "这个绷带是怎么用来着......这、这是抑制剂？我、我来打开......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......你的父母，不是医生吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "欸......他们没教过我，我试试......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......你受伤了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "没关系的，轻伤而已......只是被人用铁棍敲了一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "笨......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......嘿嘿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "那个......萨卡兹呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "啊......我进来的时候，就没见到她人了......她刚才一直和你在一起吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "卢布廖夫哥哥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......呃，那个，你、你叫什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "嗯？啊......安德烈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "全名呢......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "安德烈·费奥多尔·奥斯特洛夫斯基......嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "笑什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "你总算问我了，卢布廖夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "......对不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "没、没有那个意思......你不用道歉的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "好了，现在好点了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚强的孩子",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我来扶着你，我们先回去一趟吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "大人们见到这个医疗箱，也会高兴的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我看着那两个孩子笑了。\n当不安的种子消散之后，他们才可能在这座城市里......在这片大地上生存。\n活着吧，只有活着才能受苦。\n就像飞蛾扑火，就像虫子扎进深坑。\n即使付出代价，也总要追寻点什么。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你说是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......塔露拉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
