{
  "server": "cn",
  "storyId": "main_13_level_main_13-08_end",
  "groupId": "main_13",
  "stageId": "main_13-08",
  "title": "幻境迁流",
  "storyCode": "13-10",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_13-08_end.txt",
  "sourceHash": "419b6c956b248132da03b7eeee328aa48b2a101d0682ddafb52d5a163069cf31",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这里是，一片战场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我的战场，“魔王”的战场。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "我们会为您拿下最后一座城市。他们的抵抗已经行至终点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你是......食腐者王庭之主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你叫什么名字？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "我没有名字，我只是您的属臣，“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "这是您的命运，您为我们带来了救赎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "我们始终渴望的，我们终于达成的......救赎。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "您的意志，就是我们的意志。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "您已回应预言，预言便会降下它的赏赐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "请交给我们，这场战役不会拖延得太久。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "这些天，你看起来很疲倦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "阿米娅，这样可不行，你需要休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......特蕾西娅小姐？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这些......都是我做的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "这些都是你必须要去做的，阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "你已经来到了这一切的起点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "这也是我们命定的终点。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "别这样，阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "“魔王”，我把这顶冠冕亲自加诸你身，我为你带来了这些痛苦......与光荣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "我们会一起面对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "这是......众魂的结论，我们不能违抗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅",
      "text": "你越拒绝，你就越痛苦；你越反抗，你就越无力。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "我们曾见过如此之多命运的反抗者，预言早早在他们的面前彰显，他们早已明晰，自己将倒毙于何处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "我们感怀于那些无谓的挑战，这也许会织就英雄的史诗，但英雄本人，却注定沉沦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "你越拒绝，你就越痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "因为你明白，所有的选择，所有的挣扎，所有的精疲力尽，咽下的悲哀，皆无意义。拒绝只会让命运的甘霖变得苦涩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "你越反抗，你就越无力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "因为你发现，所有的斗争，所有的不屈，所有你我的血迹，枯槁的话语，皆无所去。反抗只会让注定的归宿填满荆棘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "你又何必......你又何必。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "我们只是想，让你安眠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "闭上眼睛吧，阿米娅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "“我见你，头顶黑冠，将千万生灵，熬成回忆。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "“我见魔王，将所有种群，尽数奴役。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "你会后悔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "你会像我一样后悔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "最后的终点......仍是这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "等到死亡来临，你会发现，所有预言，全部实现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "我......是大地上最可怖的灾难。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那么......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那么，我会杀死你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "哪怕，你就是我，你就是“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "我曾......和你做过相同的选择。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "我曾以为我已经足够强大，强大到足以挣脱命运的束缚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "你做不到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅？",
      "text": "阿米娅......你做不到的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "也许吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你也许尝试过，你也许经历了一切的苦涩，终究还是发现自己落入相同的深渊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "但我还没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我还没有行过，你们说的，“注定的道路”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我决定向你们挑战。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我会向你们挑战，以我，魔王之名，“阿米娅”之名。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "如果一切的结局，早就被你们借预言的口吻编订成册，如果我们生命的全部意义，都只是证明你们的结论不可违逆......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那我们为何还要生活？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那我们为何还要存在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那爱国者先生终其一生的抗争，凯尔希医生殚精竭虑的选择，Dr.{@nickname}每一次牵起我的手，坚定地与我同行——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这一切只成了命运的注脚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我绝不承认。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "阿米娅，这只会为你带来痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "这只会是，无尽的折磨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "萨卡兹的众魂，我质问你，特蕾西娅小姐是否打破了她的命运？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "哪怕是特雷西斯，他是否也曾向你们迎头痛击？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西娅？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "特蕾西娅小姐......她为此，把这顶王冠，交给了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "她不相信你们描画的，注定可悲的未来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹众魂？",
      "text": "所以她现在饱受折磨......所以她现在无时无刻不在聆听我们的声音！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹众魂？",
      "text": "哪怕是为了免除她的痛苦，“魔王”，你也应该——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "特蕾西娅小姐从不需要任何拯救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "“魔王”也不会是征服和复仇的象征。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......也许，才需要是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹众魂？",
      "text": "多么自大，多么狂妄——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不，正因为我已戴起黑冠，我才会向你们挥剑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹众魂？",
      "text": "你无法逃过命运的选择。你越逃，就只会越快让它来到——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我不会逃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我就等在这里，“命运”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "等到你们的一切筹谋消散，等到你们的一切嘲弄落空。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我会让你们看见——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们......这片大地上的人们，可以为自己选定结局。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "唔——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿米娅，你醒了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "身体上有什么不舒服的吗？\n你被赦罪师的巫术影响，你做噩梦了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......已经没事了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "博士，这份力量不会是诅咒，不会是带来灾难的禁忌巫术。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "特蕾西娅小姐把它交给我，是为了......我们能用它找到自己的路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我相信你。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "你醒了，阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "没关系......Logos先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "无论是不是赦罪师的巫术影响，我也许都迟早要面对这些......诘问。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "在梦里，那些声音再度向我宣告了预言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "预言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是的......爱国者先生死前说出的那个预言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "无论是什么声音，都是赦罪师的无聊把戏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "不必当真。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这究竟是赦罪师的拷问手法，还是众魂依然在连接着我的内心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "也许是我自己......一直把那个可怕的预言记在心底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "但这不重要，我已经拒绝了他们的邀请。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "又一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "......好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "但我仍希望你接受凯尔希医生的全面检查。你的戒指......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "呃，不过Logos先生，我们这是在......？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Logos征用了这支萨卡兹运输小队的车辆。用女妖之主的身份。\n我们需要躲过赦罪师的追踪。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "昨天，可露希尔的无人机找到了我们，他们之前停留的W的安全屋也遭到了赦罪师的袭击，夜莺被赦罪师带走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......赦罪师。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "我们对这支以赦罪师为名的萨卡兹疏于防范。特雷西斯的计划也为他们提供了行动的空间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "但他们终于走出了躲藏的阴影。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "博士，明椒他们正把你需要的源石样品装车，他们已经起了疑心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "他们现在只是畏惧我，才继续勉强执行我的命令，但恐怕很快，我就需要真正以咒术胁迫他们了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "五批结晶的样本，已经够了。阿米娅的状态也已经好转。"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "那么，接下来，我们去布伦特伍德，与凯尔希医生会合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "博士，你看起来有些心神不宁......你在担心什么？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "我在担心特雷西斯想要的，根本不是什么血魔巫术装置。\n他想获得......更加让人不安的力量。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
