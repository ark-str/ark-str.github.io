{
  "server": "cn",
  "storyId": "story_phatom_set_1_story_1",
  "groupId": "story_phatom_set_1",
  "stageId": null,
  "title": "合作",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_phatom_1_1.txt",
  "sourceHash": "7521050b15b06024be302c687d770d42792e685b03df13b7fea0241fb6063f6f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "罗德岛本舰\n某个偏僻的角落"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "清除异物、愈合伤口、擦干血迹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "我所能做的，只有这些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "更精细的治疗，你需要医疗部专业医师的帮助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......这些就足够了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "你要到哪里去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "回我该去的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "该去的地方......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "你是说......独自一个人的地方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "你、你不去和小队的人一起庆祝吗？你们这次的任务很重要，他们都很高兴，你也可以一起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "不必了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "庆祝的时刻不必有我。正午的阳光下不必有阴影。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "或许该去参加庆祝的是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "这......我不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "请随意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......我该离开了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "——给我慢着！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "总算找到你了，傀影干员！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "絮雨医师，您之前是在帮他处理伤口吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "啊......嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "虽然您不是正式编制的医疗部医师，但我还是有责任提醒您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "根据《罗德岛伤员管理与治疗条例》上的章程，所有受伤干员必须在罗德岛医疗部进行登记。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "像您这样私下为干员治疗伤口，小伤小病也就算了，万一傀影干员因为您的不完全治疗导致任何并发症或伤口恶化，医疗部会很头疼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "很对不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "要求絮雨小姐进行治疗的是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "没有非难她的必要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "我只是向她陈述事实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "至于你，傀影干员，你的问题更严重！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "受伤之后为什么不来医疗部报到？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "如果不是与你一同参加外勤任务的蓝毒小姐在接受治疗时向我报告了你的情况，你是不是想把这伤痛带到下一场战斗中去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "这是对罗德岛的不负责，也是对你自己的不负责。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "希望你能认识到这点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "是我的过错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "我向您致歉，医生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好，我接受你的道歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "现在，我要对你进行诊疗以全面确认你的身体状况，可以吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "别摆出那副表情，等等，别开口，不许出声，别想用你的源石技艺溜走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "我是不会再上一次当的，只要我认知到半点不对劲我就立刻按这个报警按钮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "墙壁上原来还有这种按钮吗......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "放轻松，我没有要带着你走过大厅然后进入医疗部的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "蓝毒小姐和我说了，你不喜欢人多的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "所以我把设备都带来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "我会帮你进行医疗信息的收集和整理，然后和絮雨医师一起为你处理伤口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "可以吧，絮雨医师。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "那您认可吗，傀影干员？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（叹气）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（默默颔首）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好，那我立刻为你进行诊疗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "如果可以的话，能为我描述伤口位置和大致情况吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "为什么不说话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（指指抿起的嘴巴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "我想，是因为亚叶小姐刚才说，不许开口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "（白眼）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "现在可以了，请说吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......弩箭刺穿肩膀、利刃划过手掌、寒冰束缚双足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "肩膀，刺穿伤；利器对手部造成伤害；低温......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "右腿没受什么影响，但左小腿好像没完全恢复。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好，我们一个一个来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "肩膀刺穿伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "刚刚为他做了伤口愈合，应该没有什么大碍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "唔......如果只是普通的金属箭矢倒还好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "清创做了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "已经处理了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "从愈合情况上来看应该不存在中毒或者感染的可能性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好，下一个位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "掌心割裂伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "嗯，愈合得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "但是，身上受到两处外伤，创口感染的可能性也会大幅提升，一会我会为你打预防针，这样感染方面的问题就不用担心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "最后，左小腿冻伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "没事的，你就这样别动，我带了专门的检测仪器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "可能会有点痛，请忍一忍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "样本已采集\n分析开始——"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "等数据出来，我就可以下最终的诊断决定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "还有其他不适或受伤的部位吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（嗯？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（Miss.Christine？好像叼着什么......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "——你在听我说话吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......嗯。没有，没有其他伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "傀影干员的恢复能力的确很出众。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "有可能真的是我过虑了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "傀影干——傀影先生是特种干员吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "他们是这样喊的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "但你身上的这几种伤口类型，我在先锋和重装干员身上见的比较多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "听说你们这次的任务很艰难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "“幸亏有他的支援，我们才能活着回来。”这样的话，我已经从许多人口中听到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "但他们大多不知道你的代号，甚至都没有见过你的模样，只知道在战场上闪过的影子帮了他们一把。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "记住我对他们没有好处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "这话我听腻了。我治疗过的部分干员总喜欢强调这一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "我们不说这个，别扯太多有的没的。在这里的人大多数都没那么天真，或许哪一天我们会分道扬镳，搞不好哪天真的就兵戎相见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "但傀影先生，就算是我多管闲事......我觉得我得告诉你，至少在现在，他们只是想表达自己的感激之情，仅此而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "有些话，如果在能说的时候不说给别人听，之后或许就再也没有机会了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "（轻声）......别像我一样犯傻，把事情都憋在心里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "蓝毒说，你帮她挡下了一支弩箭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "她想感谢你，但却找不到你，所以托我带了些东西过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "这枚胸针，是她赠送给你的礼物，请你收下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "这个......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "收下吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......多谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "我会向她传达我的谢意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "分析已结束\n正在输出分析报告"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "情况不妙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "傀影先生，你能尝试活动一下吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（略微不协调地走动）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好，足够了，请先坐下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "应该是源石技艺造成温度骤降后导致的冻伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "虽然不严重，但已经影响到你行动了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "只是些小伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "对于病痛的鉴别，请以医疗人士的专业意见作为参考，谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "傀影先生近期最好静养。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "这是我的意见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "我同意絮雨医师的观点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "表面上是冻伤，但实质上还是源石技艺致伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "你的感染状况本就不容乐观，对于一切可能增加你感染进程的情况，我们都要尽力避免。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "充分休息，健康饮食，进行适当的修复性运动，这是你现在所需要做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "当然，最重要的，还是定期来医疗部接受治疗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "疗程不会太长，只要一个月，你就能重新参加任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "如果你不喜欢来医疗部，我可以帮你安排巡诊，减少你和他人的接触。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "如果同意的话，请在这份告知书最末尾签字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（再次叹气）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（签上了自己的代号）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好，谢谢合作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "现在该给您打针了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "这是新式的注射器，不会产生太多疼痛感的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "请把手伸出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "（使用注射器）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "好，这样前期的预防治疗算是大功告成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "我下午还有会议，就不继续打扰你们了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "请好好享受一个月的假期，傀影先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "再见。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "她离开了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "呼......我还是不太习惯和亚叶小姐搭话，总是会紧张......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "你还好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "没什么问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miss.Christine",
      "text": "喵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "Miss.Christine。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miss.Christine",
      "text": "（蹭了蹭傀影。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "别闹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "接下来的假期，就请傀影先生好好休息吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "假期？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "我从来没有想过。假期，该做什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "唔，比如......观影?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "如果是我，我会去看一场电影，然后将那时的心情记录下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "那时候，我总会幻想自己像影片中的人那样生活，同时，又能矛盾地感觉到自己真实地在屏幕外呼吸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......当心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "幻想去过别人的生活，并不是一件好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "我明白，只是，这是我习惯的放松方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "而且......这么说有些不好意思，只是好像有一些干员，很喜欢读我写下来的那些东西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "虽然我并不认为自己写得很好，但如果大家能够喜欢的话，我觉得这样也不坏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "这样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miss.Christine",
      "text": "喵——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "Miss.Christine？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "很痒，不要这样......嗯？这是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "我猜，她可能是想让您看看这张传单。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "“多媒体密室项目诚征工作人员数名——”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "“需要相关人员负责设计密室整体紧迫而压抑的探险氛围。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "“需要相关人员设计密室中的解密与机关。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "“需要相关人员——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "——进行扮演。”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "“企划及运营为期一个月。期间支付薪金，包一日三餐。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "“有兴趣的干员和留岛人员请至人事部详谈。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "多媒体密室......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "听说是一种强调感官刺激和浸入式体验的新型娱乐方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "好像......大部分密室主题都以恐怖与悬疑为主要元素。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "前一段时间还见到过一次，当时的主题是米诺斯的地下迷宫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "我其实很想去试试看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "但是那一天A1小队的干员体验完毕后和我说——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "“吓死我了！”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "可是，她们说这话的时候看上去很开心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（恐惧，但却喜悦？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "（唔......喜欢受到惊吓？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "我当时没敢去，现在想起来，又有点后悔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "这次或许我可以，呃，请求温蒂和我一起去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "Miss.Christine，你希望我看到这个吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miss.Christine",
      "text": "喵！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "我想我明白你的意思了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "絮雨",
      "text": "您要离开了？那，您想好假期的去处了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "只是有些想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "如果适量的恐惧能为别人带去快乐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傀影",
      "text": "或许......我可以尝试。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
