{
  "server": "cn",
  "storyId": "act30side_level_act30side_05_beg",
  "groupId": "act30side",
  "stageId": "act30side_05",
  "title": "逃票？",
  "storyCode": "RS-5",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act30side/level_act30side_05_beg.txt",
  "sourceHash": "ac3fe81ad6b75a5fa3c50e4916b8393eb9171778181cfffde6195dd3ec22cf6e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "嘶......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "怎么回事......？地上怎么这么多空酒瓶子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......怪了，我怎么会睡在会客厅地板上？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "罗莎琳......好孩子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......阿克托斯......这个......混账东西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "（鼾声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "爹？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "嗯？呃......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "吵什么！连个安稳觉都不让人睡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "不对，慢着，我这是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "爹！您什么时候回来的，怎么也不提前让人带话说一声？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "昨天这是怎么回事，咱们怎么都睡到地上去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......别瞎嚷嚷，吵得我头疼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "老爷，还有大老爷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "太好了，你们可算醒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "古罗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "昨天这是怎么回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "昨天老爷和大老爷都喝醉了，说是要不醉不休，说什么都不愿意回房间睡，我们怎么劝都不成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "我没办法，只好往炉子里多添了两把柴，这样至少不会冷着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "老爷，昨天的事你不记得了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我......等会，你让我想想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "昨天，昨天......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我记得，昨天我是要给耶拉冈德像落成仪式的前夜晚会做准备。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "圣女大人让我选出谢拉格最好的酒水，用来招待来客，所以我就挨个尝了尝......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "然后，然后我就不大记得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "哼，你自然是不记得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "你喝得烂醉连人都分不清，还抱着柱子要和人家干杯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "都多大年纪了，丢人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "行了，爹，我这不也是为了圣女大人，为了谢拉格吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "古罗还在这呢，你少骂我两句，给我留点面子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我从来都教你，面子里子都是自己挣的，光要我给你留有什么用！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......算了，先不和你计较。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "古罗，怎么没瞧见罗莎琳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "大老爷，罗莎琳小姐一早就上山去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "什么？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "罗莎琳小姐醒得早，老爷和大老爷那会都还没醒，小姐就说，干脆让你们再睡会儿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "我想着也是，就没喊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "她就这样走了，也好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "或许，或许这就是耶拉冈德为我佩尔罗契家做出的安排。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "见面不识，这是缘分未够，缘分未够啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "爹，你这又打什么哑谜呢？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我隐约记得昨天是来了个小丫头没错，不过我确实是醉得不轻，不大想得起来那丫头的长相了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "你们说，那丫头叫罗莎琳？这名字......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "阿克托斯，你过来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "此事，我不该瞒你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "便如当初，亦是你自己做了选择一般。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "如今该如何做，终究需你自己决断。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "护卫？",
      "text": "......耶拉冈德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "护卫？",
      "text": "这祖孙三代真的就喝了整整一宿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "护卫？",
      "text": "还把我和其他护卫一起拉上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "护卫？",
      "text": "嘶——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "护卫？",
      "text": "好久没有喝过这么多酒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "护卫？",
      "text": "而且，真的一点正事都没说......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......既然侧面行不通，那么，干脆从正面来吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "看这个方向，罗莎琳小姐是往山上去了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哦——这就是雪山啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "近看比远看还要更壮观，谢拉格的山还是有点真本事的嘛。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "呃，有点头晕，昨天真的喝多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "不知道那老伯和大叔醒了没有，博士怎么没告诉我，谢拉格人竟然这么热情？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "等回头下山，再送点什么过去做谢礼吧......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嘶，真冷，这风刮得人身上怪疼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我记得......这山好像是得自己爬上去，才是对耶拉冈德信仰虔诚来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "好高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "......难得来一次，那就试试好了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "雪山上最纯净的空气？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "听起来挺不错的，你们这能刷卡吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "好，那我要两箱，直接送到驮峰酒店606号房。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精明商人",
      "text": "好嘞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客B",
      "text": "哇，佐菲娅姐姐，你又买这么多啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客B",
      "text": "昨天你还买了四箱什么雪山泉水，这么多东西，我们要怎么带回去啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "傻！哪用我们自己带？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "回头给玛恩纳和玛嘉烈各寄一部分，这么看我买得还不够多呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "谢拉格的空气和水确实都不错，黑骑士当初选择了这里，现在日子应该也过得不错......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "好了，不说这个。听说这谢拉格的雪山需要亲自攀爬登顶，才算虔诚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客A",
      "text": "走吧，我们也试试！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客B",
      "text": "确实，这本旅游手册上也是这么写的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国游客B",
      "text": "佐菲娅姐姐，我们来比一比，谁最先到山顶！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格青年",
      "text": "莱利老爹，你咋不告诉她们，咱们已经有上山的缆车啦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "嚯嚯嚯，游客们有自己的主意，老头子就不过去添乱咯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格青年",
      "text": "那倒也是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格青年",
      "text": "我看这些游客还都挺喜欢爬山的，现在也就他们爱爬了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格青年",
      "text": "不过，她们那些话说得也有道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "走了！坐缆车去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格青年",
      "text": "真坐？这不算对耶拉冈德信仰不坚定？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "算什么算！这是耶拉冈德爱惜子民，才给咱们的便利！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "老头子若是还坚持不坐，那才是对耶拉冈德信仰不坚定！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格青年",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "啊什么啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "咱们都是耶拉冈德的子民，只要你不对耶拉冈德不敬，心里想着耶拉冈德，耶拉冈德自然会保佑咱们的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "好险，山上居然还有缆车可坐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "怎么哪儿的景点都一个样......不跟着当地人走，就是容易吃点亏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "虽然不知道到底怎么才算是对耶拉冈德信仰坚定......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "但看谢拉格眼下这情况，耶拉冈德应该还挺保佑这儿的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哎，前面的老人家！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "请问缆车的票在哪买？劳您指个方向！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "老先生，请留步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "你是谁？怎么这副打扮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "是这样的，我是来自维多利亚的记者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "虽然人们都说这耶拉冈德像好，但是，建造这种东西肯定是劳民伤财的，我正在收集一些——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "滚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "我儿子每个月都会把钱寄回来，还会给我打电话，说在那边工作得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "你们这些外国人，就是见不得我们谢拉格的好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "那么，他为什么不回来呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "他说他签了一些什么什么协议，要在那边待着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "什么协议来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格青年",
      "text": "保密协议。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......建雕像也需要保密协议吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "我告诉你，外国佬，你要是想编派我们耶拉冈德，我现在就给你一拐杖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "谢拉格老人",
      "text": "咦，人呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "哼，哼哼哼，赞美耶拉冈德......♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "勇敢的驮兽~勇敢的人~耶拉冈德教导我们~护佑家园，哼哼~♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "哼，哼哼哼......♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "嗯？这雪怎么有点不对劲......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "哎哟！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "小心点。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "这下面是个陷阱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "没摔到吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "哎，锏小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "这哪来的坑......肯定是莱利那老家伙为了抓野味挖的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "真是多谢你啊锏小姐，要不是你，俺这肯定就踩空滑下去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "没事，不用客气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "锏小姐今天要上山办事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "有什么要俺们帮忙的不？俺和莱利、雷昂他们几个老家伙今儿约好了上山，有啥事尽管吩咐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "是要上山有点事，但不用帮忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "你和老莱利还在和维多利亚人喝酒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "是啊，咱们两边拼酒，现在平局！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "谁都不服气咧，这喝酒要是输给那群维多利亚来的，多给恩希欧迪斯老爷，还有圣女大人丢脸啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "而且这维多利亚人突然跑来俺们这，还扎营住下了，你说这算什么事儿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "就算俺没读过啥书，也知道突然乌泱泱来这么大群人，还个个五大三粗壮实得很，肯定不是什么好事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "俺和老莱利就想着，俺们借着一起喝酒，至少要替恩希欧迪斯老爷把这群人给盯住咯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "你放心，锏小姐，咱们一定能赢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "行，能喝吐他们最好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "不行就叫我，别太勉强。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "盯着维多利亚人这事，是你们自己琢磨出来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "嘿嘿，俺们和其他老乡一起想的主意。乡亲们都是同意的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "现在日子越来越好，大伙都知道好歹，谁都别想把俺们的好日子搅和咯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "不过锏小姐，俺说句实在话，你别生气啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "好，你尽管说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "我就是想说啊，俺们这不是和维多利亚来的一起喝酒嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "这群维多利亚人，俺们这一个月也算是有些了解，别的不说，他们人其实真不坏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "喝醉了，也没给俺们添多少麻烦，平时偶尔还来帮着干点活啥的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "有个和俺差不多年纪的老骨头，喝多了耍酒疯也不干别的，就脱了衣服要跳雪里游泳，俺就看他那背啊，没一块好肉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "也不知道这是遭过多少罪，想想就疼得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "这事你们知道也无妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "这次这位维多利亚子爵阁下来庆贺耶拉冈德像落成，带来的人都是他手下的亲兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "大多都是跟着他征战已久的老兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "你们只是一起喝酒，不必考虑太多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "唉。这什么亲兵不亲兵的，俺可搞不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "不过他们那群人确实看着年纪都不轻了，有几个小伙子，但看着好像身上都长了石头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "那应该是之前宣传过的，那个什么石头病吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "......矿石病。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "平日接触没什么，不用太紧张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "不过，该有的防范还是要做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "可以去罗德岛在城里的办事处，或者刚建好的医院，在那都能拿到防护手册。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "哎，这些俺们懂，锏小姐别操心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "俺也就是和锏小姐多废话两句，要是恩希欧迪斯老爷和诺希斯老爷，那俺可不敢打扰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "这么说，我看起来很闲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "俺不是这个意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "这不是，几位老爷成天忙大事儿，俺们也不好打扰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "锏小姐虽然也忙，但平常总帮着俺们，俺们都知道你是跟俺们站一块的，那就是自己人嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "自己人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "也不对，哎，几位老爷也是自己人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "俺嘴笨，反正就是那个意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "是不是耽误锏小姐时间了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "没事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "......我这有件事要麻烦你，还有山上的老莱利他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "一句话的事儿，尽管吩咐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "帮我找到一个装模作样的维多利亚人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "装模作样的维多利亚人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "戴着礼帽，穿黑色大衣，领子遮着脸，身上还挂着宝石装饰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "显眼得很，一眼就认得出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "这人搞啥，在俺们谢拉格穿成这样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "谁知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锏",
      "text": "大概不怎么聪明吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "行嘞，包在俺身上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠闲的老乡",
      "text": "一有消息，俺就让老雷昂家的驮兽给锏小姐你送过来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "爹，你说的是真的吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "昨天的那丫头......罗莎琳她、她是我的女儿？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "应当不会错。那孩子的长相，像你，也像塔季扬娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "老头子眼还没花，不会认错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "是吗......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "女儿......我的女儿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "哈哈哈！我就说那是个好丫头，长得也好，性子也好！好啊，好丫头！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "罗莎琳，罗莎琳......她长得像我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "对，是像我，我想起来了，那丫头是棕色头发，和我一样！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "眼睛嘴巴都像塔季扬娜，特别是眼睛，和塔季扬娜一模一样！多好看......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......这时间过得真快，一转眼小罗莎琳都长这么大了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "不行，罗莎琳上山去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "那她什么时候回来？她还回来吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "阿克托斯，还有件事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "爹，我得去给我闺女准备点礼物，有什么事回头再说！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我记得她小的时候最喜欢烤甜奶酪，还有兽肉炖菜，我现在就去买！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "还有塔季扬娜，塔季扬娜是不是也来了？她是不是不愿意见我？那我、我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "好！不管了，我直接上山一趟，把东西给罗莎琳送过去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "然后再问问她塔季扬娜的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "阿克托斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "怎么了，爹，我得抓紧点时间——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "你给我站住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "......你站住，还有些事，你得知道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿克托斯被父亲喝止在原地，心中不禁生出些许不好的预感。\n或许是宿醉的缘故，他忽然感到头痛难忍，胃沉沉下坠，冷意不知从哪里钻出，爬上背脊。\n阿克托斯此时才发现许久未见的父亲背脊已略微佝偻，不复记忆中的高大，像株逐渐枯萎的大树。\n年老的修士那干枯的声音并未因阿克托斯的心慌而停下。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "罗莎琳那孩子说，她和母亲一起离开后，一直定居在乌萨斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "那孩子离开的时候太小了，还记不住事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "她说这么些年，她从来不知父亲是谁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "这趟回来，除了要好好看看咱们的耶拉冈德像，还有就是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "送她母亲的遗物回来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "坏的预感似乎总会成真。\n屋外呼啸的风雪，屋内跳动的炉火，连带分不出属于谁的呼吸声似乎都短暂地静止。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "遗物......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "这是什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "可、可塔季扬娜还那么年轻，怎么会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "这不可能......这怎么可能......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "老头子亲耳所闻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "阿克托斯，当年的事......是我们佩尔罗契家对不住她们母女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "老头子心中有愧，却无悔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "阿克托斯，你又如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "好了，不管你要说什么，与我说都无用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "你爹我不是完人，也不是圣人，更不是受害者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "老头子老了，听不了你要说的话，更指点不了你什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "惟愿今后日日清扫耶拉冈德足下尘土，以此度过余生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "你......自己好好想想吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "塔季扬娜......罗莎琳......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "老爷，大老爷！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古罗",
      "text": "菈塔托丝夫人来访，说有急事要谈！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "啧，好大的酒味......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "明天就是仪式了，阿克托斯，你可别现在喝酒误事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......我现在没心情和你唱戏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "说吧，出什么事了。没事你菈塔托丝可不会登门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "呵呵，你对我倒是很了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "行了，那我就直说了，阿克托斯，我是来给你提个醒的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "我还记得，当年你阿克托斯不顾家里人反对，娶了一个乌萨斯女人，还生了一个女儿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "之后希瓦艾什夫妇出事，没多久你的妻子和女儿便离开谢拉格，这事在咱们三家范围内，可是无人不知啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......哼，你的鼻子还是这么灵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "我就当你是在夸我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "我这次来，就是要和你说说你的女儿，那个叫罗莎琳的姑娘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "罗莎琳她怎么了，你少借题发挥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "她和我们三家的事扯不上关系！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "我对翻旧账没兴趣，只不过，她回来的时机实在不巧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "你知不知道这姑娘现在在哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托丝",
      "text": "她很可能已经被维多利亚的密探盯上了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "终于到了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "缆车只能到这儿了，接下来还是得自己爬啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "也行吧，离山顶也不远了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "刚刚还能看到几个游客的，到这儿就完全没人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "上下左右都是白茫茫的......嘶，怎么还有点吓人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗯......？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......不......运气......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "......什、什么声音？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......自从到了谢拉格，就没一件事顺利过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "谁在前面！出、出来！休想吓唬我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "前面那是......是个坑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "谁这么无聊在路边挖坑，不对，这肯定不是单纯的坑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "这是陷阱！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是的，没错。这是个陷阱。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "这位小姐，小心脚下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "以及，如果方便的话，可以麻烦您顺便将我拉上来吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
