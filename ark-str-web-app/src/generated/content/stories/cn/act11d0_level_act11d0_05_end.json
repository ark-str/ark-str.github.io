{
  "server": "cn",
  "storyId": "act11d0_level_act11d0_05_end",
  "groupId": "act11d0",
  "stageId": "act11d0_05",
  "title": "冬灵挽歌",
  "storyCode": "TW-5",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act11d0/level_act11d0_05_end.txt",
  "sourceHash": "5b9389a8784968ae14e95d0ce6a0f1050790da96bb41824626b52d8b67c5bfd4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 5下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "快！这边走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "谢谢、谢谢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "亚叶姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "丽萨！你带着平民先走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "呃——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "这群暴徒......他们在无差别攻击街道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者A",
      "text": "喂！我们好不容易才抢下这玩意，你倒是射准一点啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者B",
      "text": "闭嘴！要操纵这玩意儿哪有那么简单！得亏我以前在音乐学院学习过——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者A",
      "text": "哪门子学院！？喂，宪兵！不要轻举妄动，我们有人质的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者B",
      "text": "人质在哪儿呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者A",
      "text": "*莱塔尼亚粗口*！街上在跑的不都是吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "啧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "亚叶小姐！不能让他们继续破坏下去了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "这附近的房屋都是木质结构，这样下去整片街道都会化为火海——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "火！快灭火！其他人赶紧离开这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "还有很多来不及撤离的平民，我们得帮他们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "但这不是完全没法靠近吗——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——呃，这火力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "亚叶小姐！麻烦你照顾伤员！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "喂！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顽固的镇民",
      "text": "你们这些冬灵人！感染者！蛀虫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顽固的镇民",
      "text": "为什么要烧了我的家！为什么！明明是我们养着你们的——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "小心头顶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顽固的镇民",
      "text": "呃？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "顽固的镇民",
      "text": "唔......呃，塔佳娜？你、你还好吗！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "呜......我还好，他们控制不住那些自律施术单元，这里很危险！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顽固的镇民",
      "text": "我们一起反抗！把他们赶出去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "现在——还不是时候——！呃——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顽固的镇民",
      "text": "你的脚——！好、好吧，我听你的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "离开这里！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（脚踝的刺痛......是骨折了吗？真糟糕......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（得快点和其他人汇合......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "你这，贵族的爪牙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......全部撤离了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "是、是的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "塞弗林长官，受伤的人很多，这里人手不够......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "医生们，听这位沃尔珀小姐的话，没受伤的年轻人也都去帮忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "知道了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "如果亚叶姐姐在的话......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "等等......她们没有回来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "喂！亚叶和塔佳娜呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "她们、她们好像还在十二音街道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——我刚才问的不是“全部撤离”吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "噫！对、对不起！但是，亚叶和塔佳娜应该不会有事的，他们救下了那么多人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "叛乱者抢占了城防设施，没有正规武装力量的她们怎么才能没事——咳咳，咳咳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——咳，找几个身强力壮的，和我去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "但是他们有火力优势，说不定已经有了人质，我们不应该再去刺激他们了，我们应该等着谈判的机会！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "机会！等着敌人给我们机会！你上过战场吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "对、对不起！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "但他的担忧不无道理。大裂谷留下的活性源石极有可能残留在沃伦姆德的地基内，任由他们破坏，后果不堪设想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "你们从哪里进来的！无关人士赶紧离开这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "没有宪兵队的我们倒更像无关人士......我见过你一面，罗德岛的干员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "感谢理解，断崖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "......简单的现场判断，如果他们继续用那种装置轰炸街道，十分钟到半小时沃伦姆德就会搁浅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "最好的处理方法是切断这片街道与城区的链接，但沃伦姆德不比移动城邦，街道缺乏自主移动的动力源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "其实拖拉机可以做得到......前提是，街道上没有那么多叛军。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "武装介入城镇事务需要申请手续吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......请便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "也请二位......务必救出塔佳娜和亚叶小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "塞弗林长官——这里还需要——啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......丽萨？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "是......是灰喉前辈？这位是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "干员断崖，天灾信使莱恩哈特的护卫，他本人有别的任务，我就被拖来这里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "丽萨，安托和亚叶呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "亚叶姐姐还在里面！安托......安托姐姐，那个......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "不用勉强，我明白了，只是确认一下......一会再说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "......呜呜......有、有罗德岛的前辈们来帮忙真是太好了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "——不、不行，现在还不能松懈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "我会照顾好伤员的，请一定要把亚叶姐姐救回来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "嗯，我会的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "那么小的孩子......也是干员？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "阿米娅比丽萨大不了几岁，别忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "......原来如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "这场营救完全在计划之外，没有任何防护设备，你没问题吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "——真意外，传闻中的灰喉小姐并不是个能热情地迎接源石的人，我还担心过来着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......我只是不想惨剧发生太多次，救人要紧，闲话少说吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "怎么回事，怎么还有人敢冲进来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "这两个人动作好快！快、快解决他们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "有不少本地人，没关系吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "尽量避开要害，动手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
