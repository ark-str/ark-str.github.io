{
  "server": "cn",
  "storyId": "act42side_level_act42side_01_end",
  "groupId": "act42side",
  "stageId": "act42side_01",
  "title": "圣秩",
  "storyCode": "MT-1",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act42side/level_act42side_01_end.txt",
  "sourceHash": "998c1f9f5a0d926aa5e0fc31ec4bd7074732f9ae1e78ea6d65f169ccbd04ff1a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "几个路口都查过了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七厅调查员",
      "text": "嗯，并未发现可疑人员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七厅调查员",
      "text": "我们也在附近询问了可能目击到异常的公民，没什么有价值的线索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "天气太潮湿的话，柱子上可能会长蘑菇，但再怎么样都不会自己长炸弹的，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七厅调查员",
      "text": "但......怎么可能？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七厅调查员",
      "text": "除非是教皇厅或育婴圣堂的公职人员，否则持有任何爆炸物，都意味着要受到公证所的实时监督。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七厅调查员",
      "text": "别说爆炸，拉特兰都多少年没出现过一声计划之外的铳响了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "蕾缪安蹲下身子，从已经半毁的石柱里取出了一块炸弹的碎片。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "结构很精巧......这种类型的炸弹，如果填装的是常规爆破物，受损的不可能只有这根柱子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七厅调查员",
      "text": "您是说......自制的？为了什么，恶作剧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "拉特兰热武装管控名录是由教皇厅最资深的爆破专家编撰的，几乎所有能产生有效爆炸的材料都被考虑进去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "要用名录之外的材料拼凑出这样一枚炸弹，恐怕要费上不少力气。没人会为一时兴起的恶作剧做到这个地步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "更何况，现在正值第二届万国峰会，如此特殊的时间点......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "蕾缪安又想起了那一抹红色，她有些不安，但更多的是疑惑。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "将约维塔街，不，整个司提望区近期人口流动的相关文件给我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七厅调查员",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "这些明显派得上用场的资料，在我们得到命令的同时，就应该有人负责及时调取才对啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "在这里在这里！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（捶胸）呼——呼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "实在是抱歉，蕾缪安枢机，这是您刚刚要的资料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我是第七厅调查员阿摩斯，今后将担任您的枢机辅佐官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "你迟到了，阿摩斯辅佐官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "按照帕特里奇昂阁下的说法，你会在我到达现场后的十分钟内赶来增援......但现在已经过去将近半小时了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "抱歉抱歉，我本来在准备欢迎会的茶点。我以为事情没那么急......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "（嘘——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "第七厅既然委派你当我的辅佐官，你应该对我有所耳闻吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "噤、噤声的蕾缪安......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "工作的时候，别说任何借口。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "费德里科，吃冰淇淋吗？我请你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "我在执行任务的过程中没有食用甜品的习惯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "以及，在离开公证所前，我已经吃过了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "原来休息室最后那点存货是你小子吃光的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "看在我发现了这个秘密的分上，你应该告诉我，你突然从公证所跑出来，究竟要做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "你已经在这里站了十分钟了，但这个路口明明什么都没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "我没有向同僚同步私人事务的义务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "你刚刚还说自己在“执行任务”......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "这个声音......\n哦哦哦——你在等告解车！"
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "费德里科，虽然作为公证所投诉率最高的执行者，你确实累积了不少“罪恶”，但你想要主动忏悔还是太稀奇了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "给你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "之前报销萨尔贡外勤任务的费用时，把买黄金之城文化盲盒的花销也算进去了，导致报销的钱比实际任务开支多了一倍......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "我满怀愧疚地出门......当时正好有一辆告解车从面前经过，我就......顺便办了张年卡，给你用吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "机械提示音",
      "text": "到站通知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "机械提示音",
      "text": "自律告解车，编号“ELCARO-001”，即将到达，请有告解需求的公民排队等候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "机械提示音",
      "text": "“主愿每一位迷途之人获得救赎。”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自律告解车",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "告解车缓缓进入两人的视野，费德里科伸出手去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "哈哈哈哈哈哈哈哈哈哈哈哈哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "费德里科，连机器人都知道你没情感方面的需求......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "几乎所有拉特兰人在日常生活中都会接触告解车，某种程度上，这些机器处理的数据比公证所的资料更加多元且详实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "它们是天然的案卷，异常在其中显形。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......我已经得出了一些结论。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凯莱",
      "text": "唔......等等，费德里科，不告诉我是什么结论也没关系，但你究竟在查什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "凡怀信仰者，自省即为功课。放眼整个圣城，作为教堂的延伸，告解车的数量可能只略少于甜品车。\n这种移动公共设施在拉特兰的大街小巷里穿行，让每一位拉特兰公民的情绪能在第一时间得到纾解。\n在那小小的隐秘的空间里，面对圣像、面对铳械、面对美妙的音乐，你可以向车载电子告解师尽情地倾诉一切——\n小到摄入过量糖分的羞耻，大到背叛同胞、戕害族类的罪恶。\n拒载了费德里科的自律告解车“ELCARO-001”在巷子深处停下。随后它打开了门，神秘的客人闪身进来。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不是你叮嘱我凡事小心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "确认完毕，我屁股后面没留尾巴，你也没给那个冷面男动手动脚的机会。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我会祈祷你不被他逮住然后被拆掉的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "穿着企鹅物流的制服在拉特兰跑，太显眼了呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "这可是我当初亲自设计的礼服，就在毕业典礼上穿过一回！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我还没说你呢！要知道......你的声音从一辆告解车的音箱里传出来，真是要多怪有多怪！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哎呀，虽然不愿意承认，但——是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我费了老大劲才找齐替代的材料——集市、面包房、游乐场，还有学校的秘密商店......我熟悉的渠道都找了个遍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "结果造出来的东西连根柱子都没炸断！稍微好用一点的材料全被管控起来了，问谁谁都说不出理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "总不至于是为了最近的那场万国峰会吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "如果拉特兰居然有人觉得一场美丽又动听的爆炸会对万国峰会产生什么威胁，那一定不是我有问题，是拉特兰有问题！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "至于万国峰会......他们刚公布了峰会的最后一项活动——在那座圣堂里举行一场“降生仪式”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "造了一座夸张到全城上下都能看见的建筑，居然不是用来当甜品博物馆，而是在里面当众展示生孩子？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘿嘿，我也不能什么都信你嘛，毕竟，你现在只是一位“车载电子告解师”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不过现在我确实信了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "拉特兰......肯定发生了一些很了不得的变化。最要命的是，其他人完全不觉得有什么问题！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "那我们就该想点办法破坏它们，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "要是我真研究明白了怎么拿厨房材料拼凑成的炸弹炸翻那么大一座圣堂，拉特兰所有的大学是不是该联合起来给我颁个终身成就奖？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "拉特兰人对爆炸的热爱居然需要专门唤醒，听起来像在做梦。明明只需要扔进铳械工坊待一下午就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "对哦，铳械工坊！工坊关停归关停，里面的人又没丢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我知道你要说什么，一旦出了事，铳械工坊是最容易被查到的地方，太危险了，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "放心，我会万事小心的。你也千万别被人拆了，等事情结束我亲自拆你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不管怎么说......欢迎来到拉特兰！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "调查已经结束，辛苦啦，各位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "在记录上签字确认后，就可以返回第七厅了。如果欢迎会的茶点还没有凉透，可以请大家一起帮我消灭它们吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "啊对了，阿摩斯辅佐官，你得陪我去见一趟铳骑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "有什么问题吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "如果您说的铳骑是指帕特里奇昂阁下，我......我让约里尔陪您去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "理由？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "十多年前，一座移动修道院在押送犯人返回拉特兰的途中发生了骚乱，一位铳骑与她的同僚爆发了激烈的冲突......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "等到教皇厅派去的人赶到时，现场已经死伤惨重，那位铳骑也已堕天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "后来，她被驱逐出了拉特兰，从此音讯全无。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我听说过这个案子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "那位铳骑正是我的妻子，而率队赶去善后，最后将她放逐的，正是帕特里奇昂阁下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "阿摩斯辅佐官，你待在第七厅的时间远比我久，应该不需要重新了解我们与铳骑的职责所在——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "啊不不，您误会了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "那件事情，完完全全就是我妻子的错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "每一个对着同胞举起守护铳的萨科塔，都该受律法的裁决，被逐出乐园。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我没有任何立场怪罪帕特里奇昂阁下......我只是，没法说服自己就这么见他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "之前遇到需要和铳骑对接的情况，你也是这样处理的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我......抱歉，是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "非常抱歉！您给我五分钟，我整理一下情绪，或许还是可以与您同去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我不是在怪罪你。我只是在想，第七厅的工作就是这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "总是见到不想见的人，见不到想见的人，或者更糟——以不喜欢的方式见到想见的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我可是很讨厌以上级的口吻对莫斯提马她们交代工作的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "可他们都说，您是主动提出要进入第七厅工作的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "因为在这个位置上，有很多我能做到的事呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "你也一样，阿摩斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "谢谢您。但我确实是个没什么追求的人，我妻子还在的时候是这样，她离开之后更是这样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "七厅倒是还有很多事需要你做。比如，如果我没记错的话，法柏尔区还有几座铳械工坊需要人手去处理？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "这可是当下的头等要务，铳械工坊的接收工作没有纰漏，才不会再出现像今天这样的爆炸案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "交给你了，快去快回，好吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "忙碌的修女",
      "text": "累了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙碌的修女",
      "text": "从清晨到现在，您已经割了六垄麦子了，要不去草垛边休息一会儿吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙碌的修女",
      "text": "阿尔图罗小姐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "没关系，我的体力没那么差。更何况......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙碌的修女",
      "text": "更何况？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "没什么。我只是忍不住想要看看，这片田野的边际在哪里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "它似乎望不到尽头，连我的琴声也无法穿越它。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那您可得再加把劲了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "又见面了，席德佳修女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "午安，阿尔图罗小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "我是来送午饭的——面包、冰淇淋饼干，搭配一大杯精酿啤酒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "谢谢。您刚刚说，加把劲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "我是说，咱们还有的忙呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "看看这些金黄的麦穗和层层的麦浪......拉特兰迎来了又一个丰收的好年成啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "除去我们自己的口粮，兰登修道院今年估计能匀出以往两倍的粮食用来制作瘤奶面包和精酿啤酒，到时候又能多一大笔收入！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "您笑什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "你们聊起生活的样子，让我越来越喜欢这个监狱了，席德佳修女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "您对这个监狱的尊重，也让我越来越喜欢您了，阿尔图罗小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "我有点好奇，您到底犯下了怎样的过错？我听其他修女说，您的琴声很动人，也很危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "我有一个问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "如果没记错的话，兰登修道院设立的初衷，是为了保护教宗以及拉特兰教会的重要神职人员......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "我也有点好奇，这里是从什么时候开始行使“监狱”职能的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "对一些身份特殊的人员进行监管，不也正是为了保护......呃，重要的神职人员，为了戍卫拉特兰的安宁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "从始至终，兰登修道院的意义都不曾变过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "而且，对圣城越重要，修道院就离破产越远。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "身为一位黎博利，您居然这么快地适应了这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "啊，什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "我就是在这里长大的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "......原来如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "哦，我差点忘了，这是您昨天托我借来的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "阿尔图罗小姐，您为什么突然想要读《圣徒行记》？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿尔图罗望向远方。\n她的身后是略显残破的修道院，身前是灿烂的金黄色麦浪。麦田与圣城的边缘相连，又似乎延伸向无限远的远方，没有尽头。\n风吹过麦浪，没有惊起多余的声响，拉特兰像是安静地沉睡着。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "......一个囚徒，当然是为了告解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
