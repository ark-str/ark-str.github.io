{
  "server": "cn",
  "storyId": "act17d0_level_act17d0_06_end",
  "groupId": "act17d0",
  "stageId": "act17d0_06",
  "title": "领主宅邸攻防战",
  "storyCode": "OD-6",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act17d0/level_act17d0_06_end.txt",
  "sourceHash": "573685bd8dada05bb2fefb845100e41d2c4bd1bb03a76b17df471c9917f24ef0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "已净空！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "好的，警戒交给你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "亚历山大，看看躺在地上的雇佣兵还有没有人活着！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "马上就办。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "蒂娜，把绷带拿来。我们清点人数，给伤员包扎一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "别装死！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "text": "等等，把......把铳口移开！我什么都说！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "库兹，把他绑起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "医生呢？米亚罗医生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "在这里！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "......咳......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "蒂娜！绷带！快！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "保持清醒！小伙子，不要闭上眼睛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "为什么......发生什么事了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "强行使用源石技艺......源石感染扩散了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "罗德岛没有办法吗？你们不是最擅长这个吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "失血、灼伤、矿石病剧烈发作，就算是在罗德岛本舰......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "......咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "撑住，小伙子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......坚持住，你不是还想远游他乡吗？想想你梦中的哥伦比亚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......坚持住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "咳咳......咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "......咳......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "......医生......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "......他走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......抱歉，我没能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "不......不是你的错。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "text": "......不......这和我没关系，我不是负责的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "*俄语粗口*，今天你别想活着出去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "text": "......我只是......别......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "你完了，*俄语粗口*，你死定了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "text": "别！别打我！不是我干的！别！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "亚历山大！别这样！冷静点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "那个卫兵队长去哪儿了？就那位领主之女？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "她追着逃走的人跑出去了，巡林者跟着她一起过去了，别担心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "等等......医生身上的结晶......在发光？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "这？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "这么快？为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "别管这个了！找个房间！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "你们要做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "来不及解释了！动作快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "找布料来！窗帘、床单，什么都可以！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "把医生抬到那边的小屋子里！快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "发生什么事了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "医生怎么了？为什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "科，科恩小姐，请您冷静一下，芙兰卡已经在处理医生的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "处理？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "处理什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "你们没有见过吗？我可能要之后再来解释——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "堵住门窗！不要留出缝隙！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "烟囱！把烟囱也堵住！还有通风口！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "这是......这是在做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "不清楚？医生的尸体......出什么问题了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "别去看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "别去看......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "上面堵死了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "门窗堵死了！没问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "等等，屋子里亮起来了？窗户在发光？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "科恩小姐！别靠近！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "别看......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "到底发生什么事了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "医生他......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
