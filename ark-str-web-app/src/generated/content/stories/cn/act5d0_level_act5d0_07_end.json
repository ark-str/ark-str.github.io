{
  "server": "cn",
  "storyId": "act5d0_level_act5d0_07_end",
  "groupId": "act5d0",
  "stageId": "act5d0_07",
  "title": "11:08P.M.",
  "storyCode": "CB-7",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act5d0/level_act5d0_07_end.txt",
  "sourceHash": "6e1c8254e460e4b0970798892c7c129d6ec081eda6efe7be28ac8c5d4df68c6c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "哈啊，哈啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "再来啊，企鹅物流！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "你们这不是关系挺好的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "嘁！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "干嘛要冲着我来！？吃我一锤！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "呃！你到底是帮哪边的！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "不、不是我动的手！是那个天使！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "诶嘿，打歪了，也没差啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "趁现在——危险！你往我这儿砍做什么！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "对不起，我还是觉得应该忠于首领！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "但我也是啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "呃。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "都躺地上干什么？没死的都爬起来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "是、是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "这么勉强部下可不好哦，有医疗补贴吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "......有点混乱，但总之把穿黑衣服的全部打趴下就行了吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "真是乱成一锅粥啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "是啊——欸！？莫斯提马小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "但是看你们还挺有活力的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "......你什么时候来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "老板喊我来的嘛。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "嘁，是那个奇怪的萨科塔人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "给我滚开！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "好了好了，冷静一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "在这里打赢了又能有什么结果？各退一步吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "她把首领给挡住了！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "不对！那是法杖！首领小心！她是个术师！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "......看来没有和她正面作战是正确的选择......喂，先不要靠近他们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "......我从没见过你这样的萨科塔，不，你是萨卡兹？你到底是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "普通的信使啊，不然呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "故弄玄虚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "该死——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "中场休息一下......你们大概是不会听的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "你在小看我！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "别来无恙，各位，上次见面是多久以前了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "你在看哪里！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "有个几年了？还是几个月？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "咕呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "日子过得太充实，就会让人忘记时间呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "......差不多四年零三个月哦，莫斯提马。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "嗯，那还真是好久不见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "别摆出那种表情嘛，你有那么一点点严肃我都会觉得你生病了的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不是感人的重逢吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "感人与否先不论，但现在不是时候叙旧呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "你真的打算在这里动手吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "只是适当运动一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "......那好吧，记得手下留情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "没问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "而且，还有另一位客人在等着我呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "——？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "无论看几次都觉得，莫斯提马小姐轻描淡写地挥舞法杖，结果总是会很夸张呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "那些黑手党已经吓傻了耶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘿咻，是不是该趁现在多敲晕两个？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "怎么了？不继续了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "......也许你的确有些实力，但我发誓不会让你轻松离开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "别总是这么杀气腾腾的，就当是饭后运动吧——唔。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "怎、怎么了，刚才这些火焰是不是凝固了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "......看来伊斯正好路过这附近，还是速战速决吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "你在自言自语些什么？面对我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "你变得越来越焦躁了，作为一名家族领袖，这样可不利于控制战局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "嘁！你那副游刃有余的样子真是让人恼火！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "法术！快躲开！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "别去帮倒忙了，我们去对付企鹅物流就行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "......我们好像被小看了，让他们见识见识吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "得令！嘿——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "这就是信使，莫斯提马......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "信使......外面的信使都是这样的吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "——起风了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "——风？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "德克萨斯，撤退，快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "——明白！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "text": "喂！怎么开始地震了！？那个术师做了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "真是，老年人总是这么心急。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "别想跑——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "呃——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "嘁，这是法术，先撤退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "沙尘暴？在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "情况是不是有点不太妙！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "德克萨斯！这边是出口！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "拜松和莫斯提马人呢？唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "他们被沙暴隔开了，我去一趟！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "等等，能天使！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "真是的，每次和莫斯提马有关，这家伙就头脑发热。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "德克萨斯！莫斯提马！你们在哪儿！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "啊，眼睛里进了沙子——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "不要慌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "莫斯提马小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "遮住风沙，跟着我走就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "text": "......话说回来，这么近距离感受一番，的确是一位不该随便招惹的老先生呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "地面、地面塌陷了！是流沙，后退！不要被卷进去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "首领！请下指示！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "其他人呢！卡彭呢！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "趁着沙尘暴离开了，有一些我们的人混在他们的队伍里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "首领！这里也要塌了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "......走，我们还有机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "text": "该死！到底发生了什么！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "机会，机会......啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "奇怪......我怎么不记得，你们剩下什么机会？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
