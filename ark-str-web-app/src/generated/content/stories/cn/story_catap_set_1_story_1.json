{
  "server": "cn",
  "storyId": "story_catap_set_1_story_1",
  "groupId": "story_catap_set_1",
  "stageId": null,
  "title": "挣脱",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_catap_1_1.txt",
  "sourceHash": "7e1860086dcefe456f891fd2b63c6c9846799cb5965c851039020b4ce2975abf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "别动，快躲起来，他们来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "到里面去，里面。对，你别出声！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "这位老爷，这位老爷，别把手敲坏了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "您巡逻辛苦了，是有什么事儿啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "奉巴特老爷之命，搜查嫌犯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "（菲隆哥，你搞这套干什么？怎么还叫老爷......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "（这不是得在其他人面前做做样子嘛，拉兹老爷。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "搜查嫌犯？！那可不得了，可得要好好找找！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "不过，我这儿可没有什么嫌犯啊老爷！我们这可都是好人，您一定要明察啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（噗嗤。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（橱柜晃动的声音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "......什么声音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "你屋里还有其他人在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "怎、怎么会，我这哪还有什么其他人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "可能是老爷们听错了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "听错了？可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "好了。这么小的房子，有没有人一眼就能看得出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "而且我也没听到什么声音，不要太敏感了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "好吧......那听你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "各位老爷，您看这......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "既然这事与你无关，那就这样吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "之后如果有什么线索，记得立刻汇报给搜查队！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "哎，一定，一定。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哎呀，他们终于走了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "哎你怎么这就出来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "小声点，人还没走远呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "行了行了，菲隆哥，别这么紧张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "其实拉兹他刚刚应该都已经发现我了吧？刚才他能瞒着不说，现在也不可能回头再来戳穿我啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "放心，放心。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "那小子可能是想放你走，但他身后那些人可不一定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "敢直接炸贵族老爷私库的人这么多年我就见过你一个，更别说你还开着车把老头子的金银珠宝满地乱撒......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "我说空爆啊，你猜猜你现在值多少赏金？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "哈哈，肯定没我给你留的那些宝贝值的多~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "嘿，这倒没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "说真的，你怎么有胆子干这种事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "你炸的可是老头子最宝贝的私人金库！嚯，老头子都气疯了，真要被抓到，你皮都得给扒咯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我总得做点什么，才对得起大家给我取的这外号是不？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我忍死老头也忍够久了，现在我忍不了了......这哪是怎么有胆子的问题，这不是被逼急了嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "现在好了，我爽快了，大家也能捞点好处，不是皆大欢喜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "别说被逼急了，有的人就算被逼死了也不敢动手啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "哎，说真的，阿莱塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "哇，干嘛这么正式，突然喊我本名。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "和你说正经的。我还是觉得......这么做对你压根没好处啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "你能捞着点什么？你那些金子，那些首饰，现钞......你什么都没留，全给就这么撒在我们这群人家门口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "你图什么啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "好处。嘿，好处......这年头是不是干什么都非得要有点好处？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "......哎，我也不是这个意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "只是你看，你是老头子养的私兵，他不缺给你们的那份钱，征税也收不到你们头上，你要是想，还能自己私下再从税金里扣点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我啥时候还扣过你们的钱了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "你是没有！你要是也那么干，刚刚我就把你推出去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "反正就是这么个意思。你日子过得不差，又不像我们这群人似的，交完税有时候连饭都吃不上......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "阿莱塔，你到底是怎么想的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我要是说我就是看死老头不爽，其他的什么都没想，你信不信？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "不信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我想也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那让我想想，该给你编个什么理由哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "......喂，难得我都这么正经了，你这家伙就不能稍微严肃点？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "欸——菲隆哥你又不是不知道，我就是这个性格嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "行了，不开玩笑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我也差不多该走了，不好在你这里多呆，免得节外生枝，给菲隆哥你也惹上麻烦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "趁现在走，搞不好还能混进要出镇子的行商队伍里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "这是你提前计划好的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我也不想真的被暴怒的死老头抓到扒皮嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那就再见了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "替我转告大家伙儿，要是再有人逼得大伙活不下去，不一定还会有金库这么巧地炸开花。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "千万别再这么老实地等死了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这货车好窄......腿伸不直啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这到底是运了什么，味儿还不小......幸好我不晕车。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（......不过运气还不错，前面两个关口都很顺利。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（幸好提前留意了商队的动向，正好能搭个顺风车。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这样下去，只要能过了前面的那座桥，应该就能离开这破地方了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（等离开了这里，下一步，就先去......去......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（去哪来着，糟糕，想不出来啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（呼啊，有点困了......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "......那边............没有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "......还没有找到吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（欸？怎么都到这里了还能碰上搜查队的人？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这么紧追不舍，死老头未免也太执着了吧！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（让我看看......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赶路的工人",
      "text": "老爷们，这、这是在找什么啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "搜查嫌犯，麻烦配合一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "拉兹，那边都查过了，没发现什么可疑的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "好，你们可以过去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶路的工人",
      "text": "可算是能走了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "唉，累死了，咱们真就要这么一个一个地查下去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "这也是老爷的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "但这得查到什么时候才算个完啊？从早上开始，咱们就没停下过，挨家挨户地找，现在还得跑到这么老远的地方守着......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "要不是想着抓到人能有赏金，我可干不下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......我记得早上听说有人把老爷的金库炸了的时候，你还拍手叫好了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "那当然啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "那位炸的可是老爷的私库，还把里面的宝贝都拖出去撒给穷鬼们，啧啧，这剧情，谁看了不说一声好？哥伦比亚的电影都不敢这么拍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "那你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "一码归一码，那些钱又没撒到我手上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "况且谁会和赏金过不去？老爷这可是难得大方一回！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（哈哈，看来我确实还挺值钱的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这里没法过了，看这架势，就算躲在货箱里迟早也会被查出来......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（没办法，这种时候只能——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（嘿！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赶路的工人",
      "text": "呃！我的屁股！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶路的工人",
      "text": "咦，没受伤......不对，等等，我的钱袋呢？是谁偷了我的钱袋？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶路的工人",
      "text": "小偷......有小偷！抓小偷啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "不要喧哗！发生了什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶路的工人",
      "text": "骑士老爷......！有、有、有小偷！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（再来一次......！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（看我的！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的商人",
      "text": "哇啊！什、什么东西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的旅人",
      "text": "呀！骑士先生，有流氓摸我......说，刚刚你站在我旁边，是不是你干的？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无辜的路人",
      "text": "啊？我没有......哎你怎么直接动手，真不是我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "安静，请安静！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "各位请冷静下来......不要慌乱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赶路的工人",
      "text": "我的钱袋呢！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "都退回去！这里的检查还没结束......呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "是谁扔的石头？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的旅人",
      "text": "我受不了了！到底还要挤在这里多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路过的旅人",
      "text": "我有正式的通行手续，我要求立刻通过这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "等等，这是巴特老爷的吩咐——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无辜的路人",
      "text": "不过是个有块小属地的破落骑士贵族，充什么威风？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（哈哈哈！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（嗯嗯，时机差不多了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "总算是出来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "抱歉啊刚刚的大叔，你的钱袋我会扔在你车上的。还有那位小姐，真的很对不起，下次找机会一定让你揍我一拳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "但现在只能先对不起了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "再会了，各位~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "与其在这里道歉，不如现在就直接去和当事人说。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "制造混乱，躲在人群里趁乱逃走，差点就被你骗过去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......啊呀，是你啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "不妙，还是被抓到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我还以为能蒙混过关呢，拉兹你的眼睛还是那么尖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "说来，你什么时候换了这么一身装备？挺帅的哦，看起来真的像是个骑士了，什么时候干脆去注册个骑士资格吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "死老头不是还一直想着要养一支骑士团嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "目的地......应该是走这条路没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哎呀，前面那是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "怎么不说话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这就有点不厚道了吧，只有我在说会显得我很啰嗦欸~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "怎么，你不是来抓我回去的吗？再不动手我可就真要溜了哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......要是准备抓你，之前就该把你从菲隆那揪出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "要是真的这么做了......巴特老爷这次是真的可能会当众吊死你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "也是，哈哈哈。老头子肯定气炸了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "那你还特地追出来干什么？难不成是想送我一程？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "拉兹，拉兹老弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "不管怎么说，我现在也是老头子点名要抓的通缉犯......你这是玩忽职守啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "这话能由你来说？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "当年一起巡逻的时候，是谁直接溜号上街去喝酒——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "打住打住，不许翻旧账啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "我来是想问你，为什么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "为什么要放着好日子不过，冒险干这一票？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "这么没新意可不行~怎么每个人都要问这个问题？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "可我实话实说就是因为看老头子不爽，你们又不信！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "我信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "嘎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "按你的性格，这个理由很有说服力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你这是夸我还是骂我......菲隆哥可一点没信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "算了。都到这时候了，那我就和你说实话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "在死老头手下，只要听话我们就吃穿不愁，有点小钱，也许不少人觉得这就是好日子了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "但我实在是忍不了了。到处都是让人生气的事儿，我觉得这生活烂透了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "只是这话，在镇上那些人的面前我说不出口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "没饿过肚子，我哪有资格对着吃不上饭的人嫌弃自己过得不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "所以你还是因为那些交不上税的平民......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "哎，别说得我好像什么正义使者一样。我没那么滥好心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "我没指望自己能替其他人做点什么。炸那个死老头的金库也好，把里头的东西全撒了也好，全都只是替我自己出口气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "就这么简单~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啊呀......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "意外地是个想得很清楚的小孩哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不过，还是有一些不太谨慎......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "拉兹——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "你在这干什么呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆&巡逻骑士",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "不好，他们往这边过来了，你快躲起来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "你说得容易......这里没地方能躲啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "拉兹？你在干什么......你是在和什么人说话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（糟了，来不及了！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不好意思，是我稍微占用了这位先生一点时间。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（——谁？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（从背后走出来的......这个女人难道刚刚一直就在我身后？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "嗯？什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "你是......等等，不，您、您是？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "打扰各位了。请不要这样紧张，我只是路过这里的旅人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "刚刚是我在向这位先生问路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "是......这样吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "啊......啊，没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "......请问，您是......难道您是那位烛骑士？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啊，那确实是我的封号。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "烛骑士？！就是那个有名的莱塔尼亚人骑士......我还看过好几场比赛呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "居然能在这里见到您这样的名人！这......这，骑士小姐，能、能请您给我签个名吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "谢谢您的夸赞。如果我的签名就可以的话，非常乐意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（这女人完全把其他人的注意都引走了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（到底......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（嘘。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（她这是在朝我眨眼......？！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "这里似乎不是交谈的好地方，不介意的话，我们边走边说吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "正好我想要拜访这里的领主阁下......可以劳烦诸位带路吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "搜查队成员",
      "text": "当然......当然！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（真的把人都引走了......我这是，被救了？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "（空爆。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（什么？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "（其实我过来找你，不是为了什么别的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "（我只是想亲口对你说一句......我没有像你这样的勇气，但我佩服你。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "（这个小镇太小了，这里对你来说或许是种拘束。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡逻骑士",
      "text": "（趁现在，你快走吧。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "哎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "麻烦了。本来还想着把该算的账都算清了，能潇潇洒洒地开始新生活的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "仔细想想，这一路不是又欠了新的人情嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "算啦~在老家留几个回想起来还不错的兄弟，这种感觉也不差~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "还有那位烛骑士小姐，真是个怪人......不过确实帮了大忙，下次再有比赛，就押你全胜当作报答好了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "......这回可真的是再会了，各位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "再会了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "好了，现在该好好想想，接下来该去哪才好呢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "总之先离开卡西米尔，到外面看看吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
