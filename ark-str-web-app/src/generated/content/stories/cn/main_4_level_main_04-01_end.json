{
  "server": "cn",
  "storyId": "main_4_level_main_04-01_end",
  "groupId": "main_4",
  "stageId": "main_04-01",
  "title": "免费拥抱",
  "storyCode": "4-1",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-01_end.txt",
  "sourceHash": "62f5772ffc3c14d573a7e7e1a36042b5715d00bede11d14a740fd8aee42d15ae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十一（后）\n6:03 p.m. \\ 多云 \\ 能见度 19公里\n龙门外荒漠 \\ 14号设施"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......已经到达目标地点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "没有发现其它异常情况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "报告完毕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "霜叶......你一路上，怎么总是皱着眉头？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我只是有点在意阿米娅她们的状况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "阿米娅她们已经顺利回到罗德岛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "临光和杜宾一个星期前就已经动身前往龙门外的其他地区。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "同时出动她们两个，应该也是挺艰难的任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "黑钢和企鹅物流也有自己的事情要处理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "啊，雷蛇姐和芙兰卡姐......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "她们，她们平安就好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你可也要好好加油才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "芙兰卡把你交到我手上的时候，可是跟我说她很看好你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "真......真的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "她说，前提是你别那么怯生生的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......别突然就一副要哭出来的样子呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你不是黑钢的一员吗......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "我，我没有......没有在哭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......不管怎么说，先继续任务吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "我们接下来的任务，就是和各个侦察小队一同，侦察这座废城的各个区域。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "除了搜救幸存者之外，还需要勘察一下状况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "如果出现了感染者问题，必须速战速决。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "虽然不是什么特别危险的任务，但也得小心谨慎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "万一和整合运动有关的话，就将必要信息通知凯尔希医生并撤退。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "嗯，嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "接下来......该是我们认真工作的时候了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "6:12 p.m. \\ 多云 \\ 能见度 19公里\n罗德岛\n废弃移动城市区块-\"14号设施\"被发现后 第2天"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "啊......博士，你来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "来得刚好，Dr.{@nickname}。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我们这边的活儿也干的差不多了，得暂时离开一段时间~",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "要走了吗？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......知道了。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我会想你们的。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "雷蛇",
          "text": "很快就能再见面的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡",
          "text": "只要过一小段时间，我们就能回到罗德岛重新待命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡",
          "text": "可不用太想我哦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "能天使",
          "text": "唉唉，可惜可惜，我们这边没有那样的正经理由呢，德克萨斯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克萨斯",
          "text": "你给我等等......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "能天使",
          "text": "企鹅物流，马上要回去休假咯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "能天使",
          "text": "虽然只有宝贵的一天，但是！但是——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克萨斯",
          "text": "......抱歉。不是适合在这种场合说的东西。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "不会......休息也是必要的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克萨斯",
          "text": "......这句话，理应是我说给你听。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "能天使",
          "text": "没错没错。阿米娅，你啊，也该好好休息一下了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "罗德岛还有必须要处理的事情......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷蛇",
          "text": "我能理解，但是阿米娅，你可不能给自己太多压力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡",
          "text": "即使信念强大，一直劳累下去，身体也会承受不住的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡",
          "text": "你可不能病倒了，大家都指望着你呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我......一直受到大家的关照。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克萨斯",
          "text": "但你战斗的身姿也鼓励了大家。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克萨斯",
          "text": "不论如何，这就够了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "能天使",
          "text": "趁这个机会，我要去罗德岛做个免费的身体检查，然后再回去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡",
          "text": "我们的任务也差不多结束了。接下来......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡",
          "text": "阿米娅，{@nickname}博士。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "——？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我在听。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡&能天使",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "芙兰卡&能天使",
          "text": "加油~&Cheer up !",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "啊......啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷蛇",
          "text": "汇报结束之后，我们会立即返回。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克萨斯",
          "text": "无论如何，之后的生活，还要继续。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克萨斯",
          "text": "阿米娅，保重。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "大家......我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......好。请多保重。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "下次再见。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我得再去龙门外围的贫民区看看。应该能帮上忙。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "一个人去不要紧吗？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "会不会很危险......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "阿米娅，我陪你吧？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "没事的，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "隶属罗德岛的干员，红，正在龙门执行其他任务。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "她很厉害的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "有她在，你可以放心。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
