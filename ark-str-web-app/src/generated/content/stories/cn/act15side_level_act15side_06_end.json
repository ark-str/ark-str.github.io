{
  "server": "cn",
  "storyId": "act15side_level_act15side_06_end",
  "groupId": "act15side",
  "stageId": "act15side_06",
  "title": "传说",
  "storyCode": "IW-6",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act15side/level_act15side_06_end.txt",
  "sourceHash": "8de144f8fb135f3670068b9af444ff8a9d4becf8aaa042ab5d8365caf90293ed",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "6下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "街头青年",
      "text": "......没看到掌柜的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客栈伙计",
      "text": "没看到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "街头青年",
      "text": "咋回事，哪家店都找不到掌柜的，终于想通了，回家享清福了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客栈伙计",
      "text": "但愿吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "街头青年",
      "text": "......咋了刘二，心情不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客栈伙计",
      "text": "好，好得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客栈伙计",
      "text": "怎么不好？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "——你这身手，土石法术？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "正是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "只可惜你一身功夫，却不知善用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "你方才飞沙裹手，打裂我的扁担，这是什么鬼掌法？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "......吃我一掌，只是微微寸裂，如此扁担，反倒稀奇，有何来历？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "......我用的只是寻常青竹扁担。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "那我使的便是毫无章法之掌法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "......你叫什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "太合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "好，了不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "能在最后和你这样的高手过上两招，不亏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "你是当官的吧，告诉我，你们在做的事，这只酒盏的事，是在图谋什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "谋天下万世昌宁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "......哈哈，好大口气！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "只可惜，这东西还是不能给你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "你逃无可逃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "未必。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "——想走！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "挑山人向后跃出一步。\n十年登山，千百万步中的一步。\n风筝断线，风起而身动。"
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "......唔，你方才藏了身法？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "在山上，你追不上我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "太合，告诉那个小子，取江峰峰顶，忘水坪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "挑山人",
      "text": "莫忘了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......太合叔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "没追上？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "若舍身相追，并非难事。只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "他要以酒盏为威胁，逼郑掌柜与他相见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "峰顶忘水坪，二者相见，必死其一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......没有余地？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "方才交手，知根知底，绝无余地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......峰顶忘水坪是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "得抢占先机。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "......幸好没和那个挑山人起什么冲突，看那身手，都让我想起十几年前最后一次见到槐天裴的时候了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "你认识那两个人，对吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "......我说过，爹是领了朝廷密令，那两个人，就是朝廷的信使。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "知道身份吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "只知道那个领头的大块头，是肃政院的大官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "......我心里有数了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "虽然本不想麻烦罗德岛......但看来，还是得借他们的力量......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "唉，不过这下可麻烦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "虽然没听见他们在说什么，但看他们急匆匆离开的方向，多半是向山顶去的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "我和罗德岛约定的碰头地点，也是山顶。如此一来，究竟场面会变成什么样，就没人知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "那我们先一步埋伏在山顶？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "别了吧，都是高手，自讨苦吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "那你说怎么办——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "——等等！快，躲过来点，别抬头！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "是掌柜的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "爹怎么在这儿......？而且......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "你脸色很白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "他......他拿着的是他的刀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "不，这么多年......他从来没拿过他的刀......他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "掌柜的是个刀客？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "......以前是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "那看来现在也是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "情况不妙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜小姐",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "越往山顶，路越窄。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "就快到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "......这是最后一条路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "最后一条路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "离了这个镇子，向西走几步，能看到一条长长的阶梯山道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老船夫",
      "text": "走到顶，就是忘水坪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "......在这儿遇到，真是太碰巧了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "确实赶巧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "你们在追什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "酒盏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "在山顶？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......隐瞒也没意思了，是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "而且在一个局外人身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "......那只酒盏到底是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "告诉你了，克洛丝姐姐就会帮我们抢回它吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "你们的目的可不只是“抢回来”这么简单，你们明显要利用它做些什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "而我猜，其实你们的目的和鲤先生一样，都是要找出这只酒盏的主人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "那你们何必多此一举呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "克洛丝姐姐这是疑问，还是......质问？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "怎么会是质问呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "这只酒盏，是一位大罪人制造的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "罪人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "弥天大罪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "朝堂秘闻，莫要打探。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "而你们要利用一个弥天罪人的东西，做些和罗德岛干员有关的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "不告诉我，我怎么帮忙？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乌有",
      "text": "恩人说的没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌有",
      "text": "虽说身份有别，但托人办事，从来没有语焉不详的道理。俗话说得好，人心隔肚皮，不坦诚相待，怕是处理不好这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "我还担心你迷路了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌有",
      "text": "啊哈哈，恩人明鉴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......你还把她们当成你们的“干员”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "少年沉默不语。\n作为最年轻的司岁台秉烛人，他必须要权衡利弊，做出选择。\n这不是什么惊为天人的秘密。\n但他不希望事情出现任何差池。"
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......这只酒盏里寄宿着一匹凶兽。当然，只是他意识的部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "公子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "我自有分寸，若是之后司岁台怪罪下来，太合叔也不必念人情，依法处置便是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "寄宿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "当代巨兽学家普遍认为，除了以某种形式凝出肉身实体，行走大地之外，这些古老巨物，也有手段寄宿于一些物件之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "古籍常言，“兽与厚土行”，其实点出了这些生物的特性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "......呃，什么物件都行？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "比较常见的是兵器。无论是古代萨卡兹的刀剑，还是如今工业产物下的法杖，都有案例。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "只是具体原理，尚不明晰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "那么那只酒盏也是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "所到之处，器伥四起。虽然还不能确定，但是我们有理由怀疑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "酒盏是活的，却没有活动起来。它周围的物件是死的，却会因它而活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "这只酒盏流落许久，我们也是因为某个偶然，才定位到它的位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "所以你们要找到那个罪人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "我刚才说了，制造它的，是一位罪人。可如今它的主人，则是另一位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛丝",
      "text": "什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "一个诗人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "......梁大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "宁小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "今天风大，日落得早。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "早也不早，不知不觉就这个时辰了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "爬一座山，要多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "古时，尚蜀山峦，人力不能及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "蜀道难，难于上青天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "......如今不同了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "可再如何不同，有些事情，不变就是不变的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "三山十七峰，处处寻不得。梁大人还要再找吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "得找。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "不惜瞒天过海，骗过我，骗过所有人也得找？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "得找的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "你难道不知道，纵使有千番道理，逾矩便是逾矩，犯忌便是犯忌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "你难道不知道，此事出了一点差池，别说前程不保，论起罪责，你首当其冲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "你难道不知道......我是愿意听你说的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "......我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "所以我更不能告诉你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "......为何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "因为梁某人身为一城之知府，只考虑一城之安危性命。一砖一瓦，一炉一灶，但凡有丝毫损毁，便是我的失职。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "上峰龃龉，梁某人所能做的......唯有勉力而行而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "......早年初会尚蜀，见你虽偶尔固执古板，但毕竟刚正不阿，一身正气。我一直坚信，你我共事，定能跨过千难万阻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "可如今......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宁小姐",
      "text": "......我却难免有些失望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "......这句话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "是作为梁某人的朋友宁小姐提醒梁某人呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梁洵",
      "text": "......还是作为朝廷从二品钦差大员，礼部左侍郎宁辞秋，敲打梁某人的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
