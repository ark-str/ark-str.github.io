  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act5d0/level_act5d0_05_end.txt",
  "sourceHash": "0d7924fa4f1d61e6c87e31b07086a019b7a0e9bf3fa191dd24103aa33037d406",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "8:52 P.M.  天气/多云\n龙门贫民窟"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "啧！想活命就告诉我们，鼠王到底在哪儿！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "我、我不知道啊！什么鼠王......真的没听说过啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "敬酒不吃吃罚酒——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "喂，卡彭先生说过不要随便对平民动手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "这种下三滥的货色能算市民吗？遮遮掩掩的，说不定就是个感染者垃圾！还敢装糊涂！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "等、等等！别打了！我真的不知道啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "嘴硬！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "唔——呃，呕——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "走吧，别管这家伙了，恶心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "看名单，下一个老东西似乎就住在这里不远，是个卖鱼丸的，就在生鲜卖场对面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "嘁，浪费时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "咕，哈啊——骨头都断了，这帮——该死的——下手真重，嘎哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "必须得......告诉他们......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "那边的，站住。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": ".....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "......你们有什么事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "（等等，注意旁边那个男的，我总觉得不是什么善茬。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "（龙门当地的帮派？不用担心，按照卡彭先生的报告，都是小角色。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "我有点事情要问。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "谁也不想惹上麻烦，对吧？乖乖回答我们，我们就走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......你的拳头上有血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "不好意思，只是些不配合的垃圾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "但是像你们这样的好市民，当然会配合我们的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "这是威胁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "大家心里清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "那我拒绝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "......拒绝？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "小姑娘，你好像弄错了什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "还是说，你也想变成那边巷子里的垃圾，被打得半死不活？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "槐琥，我刚才听到的惨叫声......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "——你们刚才说了，“垃圾”，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "以防万一我多问一句，你是指这里的居民吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "我没那么多时间陪你废话，赶紧——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "敢、敢还手！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "都给我上——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "呃！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "下一个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "不，算了，反正你们也就只是一群不入流的喽啰，一起上吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "古往今来，邪不压正，你们这些滥伤无辜的下九流，何足挂齿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "什么情况！？这女人的动作——？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "那就尝尝弩弹——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......慢着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "咕！松手！你这混账！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "唉，你这种人，属于冰箱断电馊了三天的海胆，差不多那个感觉吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "你、你在说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......算了，我不该学槐琥咬文嚼字的，还是直接点好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "好、好大的劲，等！等等！要断了！要断了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "把武器放下，滚出这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "我、我知道了，你先放手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......但果然还是应该弄脱臼比较好吧。毕竟你拿着那么危险的武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "呃啊！你，你真下得去手——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮B",
      "text": "这、这两个人怎么回事？我没听说这附近有什么注意目标啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "嘁，先走，回头再说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮A",
      "text": "不管你们是哪个帮派的，都不会有好下场的！该死的龙门人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "不，都说了我不是黑社会，为什么都喜欢以貌取人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "先别管这些，救人要紧，我去那边看看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "啊，好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "——别动，我来帮你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "阿孑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "还好，都是皮外伤，别急，我这就去叫医生，他们离这不远。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "阿孑！别管我，先去找你董阿伯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贫民窟居民",
      "text": "他们下一个目标就是他！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
