{
  "server": "cn",
  "storyId": "main_13_level_main_13-03_beg",
  "groupId": "main_13",
  "stageId": "main_13-03",
  "title": "佣兵一日",
  "storyCode": "13-4",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_13-03_beg.txt",
  "sourceHash": "0c2be1e83708dc4efbeffad77c172068a36582c6e805acfe4f3ab7af56d52b61",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "将军，市长死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你的佩剑上还沾着血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "希望军事委员会的剑和佣兵的剑一样顺手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "只要是武器，都没什么区别。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "雇佣兵刚刚发来消息，参与策划刺杀摄政王的十四名议员已经被逮捕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "其他的议员什么态度？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "他们没有态度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "我原以为你的做法会更直接。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "如果军事委员会需要，我会立即处决所有议员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "对于现在的处境，这就够了，飞空艇的建造还没有完成，我们还需要一点额外的耐心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "把你的人撤下来吧，食腐者之王阁下的军团到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......军团？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "什么时候？怎么做到的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "卡兹戴尔的部队无论从什么方向进入维多利亚，都必然会穿过大公爵的领土，无论怎么隐蔽，这么大的一支部队都不可能——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "阁下已经抵达伦蒂尼姆近郊，直属于他的两支整编的王庭军已经在城外驻扎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我明白了。我会命令雇佣兵撤出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "那位莱托中校已经和摄政王殿下谈过，接下来，他和他的城防军会接管伦蒂尼姆的所有行政事务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "表面上，因为“驻军叛乱”，伦蒂尼姆会进入城防军主导的半军事管制状态。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "这恐怕瞒不住大公爵们，他们在城内的情报网很发达。在接下来的几个月里，他们一定会开始战争动员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "不会那么久，最快的一支部队很可能在二十天内出现在伦蒂尼姆的城墙之下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "但不用担心，无论最先抵达的是谁，他们都不会轻举妄动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "任何胆敢单独进军的公爵都会成为其他所有人共同的敌人，就像两年前温德米尔公爵的那次失败的奔袭一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "她的高速军舰甚至没有成功开出自己的驻防地，就被自己人拦了下来，可笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "温德米尔公爵......她是一个敏锐的人，她在摄政王刚与维多利亚有所接触时，就一直在警告议会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "邀请我们进入伦蒂尼姆的不仅仅是卡文迪许一位。所有公爵都希望摄政王殿下能作为“军事附庸”帮他们处理一些棘手的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "懂吗？这位温德米尔公爵也不例外。铁腕军人的身份背后，依然遵循着王公贵族们的游戏逻辑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "她只是最急着把我们放回工具箱的那一位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......我听说，维多利亚威名赫赫的蒸汽骑士，已经不复存在了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你很会打探消息，赫德雷。对于军人，这不是个好品质。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我是个雇佣兵，将军。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "摄政王和军事委员会的谋划很成功。匪夷所思。萨卡兹竟然真的在维多利亚的首都站稳了脚跟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "公爵们需要一支容易切割的部队来弹压异己，议会也同样急需一支“恰当”的防卫力量，以免再有人效仿那两位愚蠢公爵的军事冒险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "在他们看来，刚结束内战不久的萨卡兹就刚巧合适，开袋即食，用完即弃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "如今，我们控制了工业区，控制了议会，乃至碎片大厦也很快就能被我们掌控。摄政王真的拿下了伦蒂尼姆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "但是我们搬不走这座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我们可以挑起纷争，然后呢？跟着伦蒂尼姆一起被其他国家的联军埋葬？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "军事委员会的计划到底是什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "佣兵的问题也很多吗，赫德雷？是不是我过于优待你了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我只是需要知道任务目标是什么。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "我所认识的佣兵，更喜欢打听哪里的雇主更大方，琢磨怎么抢劫萨科塔的商队。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......只是个人习惯不同。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "“个人习惯”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你的眼睛还好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......会稍稍影响挥剑时的距离判断，我会尽快克服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "我收到了你的审讯记录，刺客是一名叫伊内丝的女人，也是雇佣兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我们确实没有预料到，伊内丝这样的萨卡兹会被议会买通，刺杀摄政王。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "伊内丝死了，你为此瞎了一只眼睛。你会获得军事委员会的嘉奖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我并不需要嘉奖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "那你会获得报酬，像个雇佣兵一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "毕竟你和伊内丝，还有个代号W的疯子，你们领导佣兵小队活动了很久，疤痕商场的老萨卡兹对你的评价很高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "杀她，你很果断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "佣兵就只会这样生活，为了活下去，我们什么都会做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "哪怕杀死同僚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "哪怕杀死同僚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "那你总有一天也会来杀掉我。是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你刚才问我，军事委员会的计划到底是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "我们的计划只制定到战争爆发，接下来的，就是......他们的计划了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "这里是仇恨的中心，这里也会被仇恨埋葬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "一如你写的那些小册子，一如我们经历的所有战争。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "您原来......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "没什么。继续写下去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "任务很重，你要承担起责任。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "记完你的笔记了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "不，我什么都没写。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我只是重新打磨了下这把剑，雇佣兵的重剑......我已经很久没用过了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你可真绝情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你如果想要的话，我可以转赠给你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "剑？效率低，没兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "唉......你居然还抽空修了修头发？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "也是，接下来你可没有时间像在伦蒂尼姆那样，每天给头发抹护理膏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "只是这样更方便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "你该留着那套衣服，说不定可以继续扮演饱受将军器重的佣兵领袖呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "军队里的人是怎么说的来着？服从是天职？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "雇佣兵的天职是拿报酬，别拿抚恤。好了，你们两个省点口水吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "这里是防线侦察范围的缺口吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在还没打起来之前，是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "至于现在嘛......他们都开始进军了。就算公爵们的关系再差，这条阵线合围也是迟早的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你确定你说的那个人会从这里走？从这个位置可还能看见碎片大厦那一炮的天灾云呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "天灾的落点是威灵顿公爵和食腐者之王交战的前线。铁公爵恐怕会收缩阵线。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "至于温德米尔，在她把她的女儿送回移动要塞之前，恐怕没有余力马上铺开自己的兵力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "那个人要从伦蒂尼姆离开，能选的路线可不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "等等。来了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "阴影的速度很快。像是......\n呃，多边形的......线团？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "多边形线团？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "形状总体呈多边形，但很不规则。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "是源石技艺，大概率用肉眼是捕捉不到的，否则她也来不了这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "确认目标。只能粗暴一点了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "W——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "唉......跟上！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......雇佣兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "很巧。非常巧。那就追上来吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "奇怪的感觉就在这附近才是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "人跑了？我就说，炸弹炸不死巫妖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "不，还在附近。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我们得追上她。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "情况不太对，我们刚才没有到过这样的区域。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "......这里的东西都没有影子，幻觉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "好像有群大个子，就在山下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......好夸张的剑，这些人怎么举得动的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）那座灰白的城市就在前面了，加把劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）那里会收留我们，土石之子们已经在哀愁之地修建起了城墙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）卡兹戴尔，每一个音节都是一段苦旅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）它在哪里？我们从梦中离开，寻觅至此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）流亡时代已经结束了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他们在说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......很古老的萨卡兹方言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "“哀愁之地”，“灰白的城墙”。别的听不太懂，只能猜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "好像还提到了卡兹戴尔？哪一座？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）谴罚氏族的炎魔霸迩萨，游侠领主奎隆都在接我们的路上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）哦，还有他也在这里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹旅人？",
      "text": "（古老的萨卡兹语）戈渎，“魔王”——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "这些影子所诉说的，是第二座足以被称作城市的卡兹戴尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "在最初的卡兹戴尔被神民和先民们摧残殆尽之后，上千年的时间里，卡兹戴尔都不过是篱笆和茅草堆积成的小小聚落。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "脆弱，易毁，在殖民者的意志下，被一次又一次蹂躏，萨卡兹们也一次又一次流亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "直至此刻，萨卡兹又一次积攒了力量，又一次重建......一座真正的城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "他们离开如今被称为哥伦比亚的那一片荒原，来到泰拉的腹地，以此为生，以此为死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "然后......是背叛。是又一次东迁。没走出多远，青色的怒焰再一次遭到背叛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "萨卡兹的历史仿佛自那时起就被诅咒了一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "历史奔腾往复，直到今天，不断毁弃和重建的城市依然在这附近兜兜转转。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "而他们口中的这些名字，是那座城最初的几位魔王。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "七千年前的，魔王们。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "你们——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "你们是怎么弄出这些东西的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "鉴于这一座卡兹戴尔的历史意义和对后世的影响，这些魔王的传说确实传唱甚广。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "但这些流浪者？就连我们也没有这么细枝末节的......呃，记载。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "这甚至不是巫术......绝不是巫术，任何源石技艺都没办法达到这样的效果。唔，也不好说，但至少得是个历史学家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "那是物理手段？利用雾气成像的投影仪？那对兄妹什么时候有这种技术了？藏私可不好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "嗯......也不太对。这些画面太接近记载的真相了，就算是技术手段，哪来的资料呀......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "那这确实是某种法术......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "但不属于已知的任何源石技艺范畴......甚至很有可能，不是源石技艺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "很奇怪——巨兽吗？维多利亚要是想驯服巨兽参战，早该动手了吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "这女人在干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "看来你们不是施术者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "你们只是单纯炸了我心爱的小方块。坐在里面很舒服的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "巫妖王庭的信使，埃芒加德女士，很抱歉用这种方式和您接触。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "......我不知道你们对巫妖是不是有什么误会，我真的没那么老。别这么毕恭毕敬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "这恐怕也并非您的法术。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "我可没这样的本事，变出一群七千年前的流浪者出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "text": "嗯......如果用法术刺激一下会怎么样呢？就用最基本的，一些小小的、通用的能量刺激......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "......这是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "这片区域我三天前确认过，那时候可没有这些东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊内丝",
      "text": "你们......喂，赫德雷，W，你们怎么了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
