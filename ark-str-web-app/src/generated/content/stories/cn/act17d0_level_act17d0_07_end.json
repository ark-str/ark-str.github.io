{
  "server": "cn",
  "storyId": "act17d0_level_act17d0_07_end",
  "groupId": "act17d0",
  "stageId": "act17d0_07",
  "title": "地堡防线",
  "storyCode": "OD-7",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act17d0/level_act17d0_07_end.txt",
  "sourceHash": "cd0c913e79c4d200801894c3d6e6be6aaec91a7d41225fdd9378f15f653b1885",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "滚开！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "真是没完没了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "他们到底造了多少这种鬼东西！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "雷蛇！小心身后！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "源石畸变体",
      "text": "噶......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "芙兰卡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "你在搞什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "领主小姐，帮我搭把手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "好，好的!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "你......快跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "你不要说话了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "我的腿......你......你，别管我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "不要说蠢话！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我背你，快上来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "它们又冲上来了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "趁现在，快跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥克芬",
      "text": "到这来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "奥克芬先生！你怎么上来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥克芬",
      "text": "我实在是做不到待在下面干等着，我可也是罗德岛干员啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "太好了！帮大忙了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "准备引爆爆炸物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "三、二、一......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "怎么样了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "只是短暂被击退，用不了多久它们还会再来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "它们......好像变少了一点？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "“迎宾踏垫”已经用完了，我也没有子弹了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "亚历山大，接下来怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "去避难所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "去避难所！带着罗德岛的干员，去避难所！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "那你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我掩护你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "掩护？那谁掩护你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我不需要掩护。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "冷静点，亚历山大！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我很冷静。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我已经受够了不停地躲藏和撤退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "撤退无法带来战争的胜利，历史无数次证明了这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "但我们不是在打仗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "对我来说，这就是在打仗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "当他们向感染者掏出武器，想要加害我所熟识之人时，这就是一场战争。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我这辈子经历的战争太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "只要我在这里多干掉一只该死的怪物，那些镇民存活下来的几率就会上升。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我就会守在这里，直到弹尽粮绝，直到天昏地暗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "战争没有结束，我为什么要撤退？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "你自己说过不要逞英雄的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "但是我不觉得这是“逞英雄”，蒂娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "我只是在做对的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "无论如何，这一切都得在今天结束。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "亚历山大！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我会留下来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "老先生，怎么你也......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "事情总归会变成这样，从你们决定留下来帮忙的时候，其实大家都预料到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我会留下来，和这位战士协助防守，如果情况太糟，我可以掩护他撤离。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "老先生......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "亚历山大，给你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "这是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "我自己试做的源石爆炸物，只剩下这两个了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "活着！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "......我不敢保证。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "你没和她说实话，你也没打算撤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "哈哈哈......你就不要戳穿我这个老头子的小算盘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "你需要有人帮你顶住那些怪物。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "这是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "据说是老领主的佩刀，我借来用了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "这把刀很好，老领主的品位很不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "漂亮的花纹钢，手工镶嵌的松绿石刀柄，不比那些现代工业生产的武器差多少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "比起冲在最前线，拿着弓箭在后方要安全得多。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我老了，动作迟钝了许多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "但是这把刀，依旧是锋利的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我还一直都不知道你的名字，战士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "亚历山大·塞纳维耶夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "叫我亚历山大就行了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我也应该告诉你我的名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "但是从鲜血涂抹山谷的那天起，我的名字也随着过去的一切掩盖在黄沙之下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "没关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "你决定留下战斗，这很重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "“巡林者”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "“当时他们都说我要死了，但是他们错了，我重生了。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "无论那些怪物有多少只。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "让它们放马过来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
