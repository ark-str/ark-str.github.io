{
  "server": "cn",
  "storyId": "main_10_level_main_10-11_end",
  "groupId": "main_10",
  "stageId": "main_10-11",
  "title": "仇怨的尽头",
  "storyCode": "10-12",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_10-11_end.txt",
  "sourceHash": "201d532412b46a3ec24c0201277da5c8f06673d385e4e0d0350b85ac38687f05",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "好奇怪，博士，我们明明甩脱了之前的萨卡兹士兵......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "但他们还在源源不断地过来。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "就好像他们知道我们的位置。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "可露希尔，我们的通讯信号有没有被追踪？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "这不可能啊，阿米娅！我特地给信号发射器做了三重处理，要是那些萨卡兹有这技术，罗德岛号早就被特雷西斯攻破一百次了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......博士，我相信可露希尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "他们一定是用了什么别的方法......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "阿米娅小姐，我们马上就到会合点了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "只要和六队会合，我们就能和地下的接应部队取得联系，等回到地下以后，萨卡兹们就没法再追着我们......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "......不，别走那条路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "啊？为什么......咦等等，推进之王小姐，你们怎么来了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "你们不是在地下......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "六队的人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "六队怎么了？你怎么会是这副表情......呃，因陀罗小姐，你的手上有血？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀罗",
          "text": "你们的战士，他们......都牺牲了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "这......这不可能！六队还在我们前面，他们为什么会遇上萨卡兹？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "我们没有时间分析原因了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "博士，六队的战士们......并不是死于我们见过的那些萨卡兹士兵的追击。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你的意思是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "六队遇上的人，有着非常恐怖的源石技艺。他们死亡的现场......就好像屠杀一样。许多战士甚至连武器都没拔出来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀罗",
          "text": "那真的是源石技艺吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀罗",
          "text": "我不敢相信！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀罗",
          "text": "我看到有红色的虫子一样的东西撕裂了战士们的胸膛。维娜，你也看见了，那是真正的怪物！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......动手的不是普通萨卡兹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我们必须换个方向。费斯特先生，有其他路可以走吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "有。但那条路没有我们的人接应，一旦遇到萨卡兹士兵......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推进之王",
          "text": "又会是一场苦战。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "找掩体！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "号角，这什么玩意儿？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "这萨卡兹朝我们丢过来的是炸弹吗？明明我们没人看见——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "......源石技艺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "注意上空！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "我......我看到了......半空中一闪而过的血红色！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "后撤！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "这跟落雷一样的玩意儿，你说它是源石技艺？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "这些可怕的魔族佬......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "还不出来？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你说的战斗不是在地上滚来滚去吧，白狼？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "天上一次性出现了五道血光？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "号角，我们根本没机会——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "源石技艺再强......他也只是一个人而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "过往的维多利亚，是如何一次次战胜萨卡兹的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "你是想......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "我们还有多少弩弹？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "掩护我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗本",
          "text": "好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "微不足道的抵抗——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "现在......就是机会。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "想借着法术轰击的余波逃走？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我不会让你如愿。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "......我说过了，只要我的士兵们还在，我就不会逃走。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你果然很不错，白狼。你竟然敢反过来冲向我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "很可惜......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "——唔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "谁跟你说过，萨卡兹仅仅依靠源石技艺作战？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "即使是只用剑——我也可以击败你们所有人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "想赢我......也许不难......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "但想让我倒下，也不会......那么简单。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你很有勇气。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "也多亏了你的勇气，我能更快地结束这场战斗——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "在长剑刺下的那一瞬间，曼弗雷德面前的士兵突然消失了。\n她就像溶解并渗透进了她背后的墙面里，连个涟漪都没留下。"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "陌生的源石技艺......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "警戒！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......凭空出现的短刀？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不，不是凭空出现......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你的反应很快。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不够快的话，我的胸口恐怕就要多上一个血洞了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "找到目标了！瞄准他！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "怎么回事？又消失了？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "太、太快了！射不中！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "举盾，快举盾，*粗口*，他是不是会瞬移？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "瞬移？怎么会有这样的源石技艺......就连施术痕迹都侦测不到！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "还是说......障眼法？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不要被他愚弄！所有人，不管瞄不瞄得准，一起进攻！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "只要敌人还在我们面前，他就别想逃脱！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "打中......了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "将军，没有尸体。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "可是地面都烂了......敌人还能躲到哪里去？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "将军，身后！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "只要你敢出来，我就能杀死你！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "是吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "曼弗雷德，你刚才的话说得很好，可惜......只说对了一半。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "一半？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "萨卡兹并不仅仅依靠源石技艺——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "——但萨卡兹也绝对不会只用刀剑战斗。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "啊啊啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "这地面软得不正常——空气会吞人！我、我的刀突然握不住了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "将军，你也在下陷？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......都不要动，也不要慌乱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "短刀是他的法杖。这是源石技艺，也仅仅只是源石技艺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你很冷静，这很好......你救了你部下的命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "但是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......唔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "地面......快到胸口了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "剑......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "以你的剑术，挡住我的攻击轻而易举。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "可你越是使劲，就越快被地面吞噬。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你想要这种结局吗......这种自取灭亡的结局？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "呃......咳咳......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "将军——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "都别过来！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "或者，你可以和你的部下一样，停止一切动作。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......你是想让我等着你捅穿我的心脏？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "要杀死你，也不容易。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "咳咳......哈......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我知道了，你并不是真的想取我的性命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "没想到，除了阿斯卡纶，罗德岛还有一位顶尖的萨卡兹刺客。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我并非刺客。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "没有必要的话，我并不想伤害任何一个萨卡兹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "但你却在帮助我们的敌人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "维多利亚人......是敌人吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我看到的是，一群伤痕累累的士兵，在自家的土地上，为了活下去而苦苦挣扎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "而你和特雷西斯，你们正在让萨卡兹变成所有人的敌人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我以前就想过，有机会的话，我想跟你们谈一谈。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "很遗憾，我们初次见面，就是在战场上——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "——罗德岛的精英干员。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "又不见了？呃，地面恢复了正常！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "差一点点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我几乎就要抓住他了。他的源石技艺很特别......他并不是在给我们的神经系统施加影响制造幻觉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "地面留下了能量转化的痕迹。难道说......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "将军，他们都不见了！我是说，那些维多利亚士兵——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "呵......他愿意配合我拖延时间，就是为了把那些重伤的士兵一个个地救出去吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "那......那我们要不要追？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你觉得我们能追上吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我说了差一点点——但对于那种程度的术师而言，差一点就等于绝对会失败。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "可恶！我们今天本来能在这里把那些反抗力量一锅端，结果又是雇佣兵反叛，又是被什么神秘术师阻拦！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "因为罗德岛......这就是罗德岛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我们错过了把敌人一网打尽的机会，但他们的损失，难道又会少？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "他们本来有藏在暗处的机会，如今却被迫一个个走到了台前。暴露力量对他们来说，已经是战术上的极大失利。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "刺客，擅长空间幻术的术师，还有那位至今未曾露面的女妖......罗德岛的底牌，还剩下多少？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "将军，你有计划了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......走吧。在对付罗德岛之前，我们先把不安分的小丑给收拾了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "先到这里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "......这是厂区外面的街道？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "您......您用匕首划开了空间？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "不要轻易相信你的感官。要误导你们的双眼，远比影响空间容易得多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "您......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "您救过我，而且不止这一次。我的眼睛或许不能告诉我最正确的答案，但我的感觉不会出错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "您到底是谁？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "Misery。我是罗德岛的Misery。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "罗德岛？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "抱歉......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "以后你会有机会从风笛那里得到完整的解释。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "风笛？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "她现在算我同事了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "而且......她还是我最好的朋友结交的最后一位朋友。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "听起来我错过了很多信息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "在我为风笛感到高兴之前，请容我再次向您与罗德岛致谢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "先离开这里。以后我们很有可能还会见面。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "曼弗雷德几乎追踪到了我的源石技艺的真相。他随时都可能追上来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "......不。我想，他此刻大概在忙着处理另一件事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "你是说深池。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "小丘郡的蔓德拉......她不可能离开这座厂房了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "你是在惋惜自己无法亲手为战友复仇吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "我......我只是觉得可悲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "无论是为了站在这里，懊悔着错过杀死她的机会的我自己......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "号角",
          "text": "还是为了早就无药可救的她。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "奇怪，你跟他们说好了吧？他们怎么没在这里接应？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "深池士兵",
          "text": "我——呃！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "怎么回事——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "深池士兵",
          "text": "萨卡兹！是萨卡兹！我们快跑——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "......我们被发现了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "不，不行，“间谍”，我们走——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "从那扇门出去，也就十米了对不对？只有十米，我们马上就能......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "好......好的，跑......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "就像过去一样，那时候是你拉着我，我们只要跑得够快，那些贵族小孩就追不上我们......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "石像！挡住，挡住他们！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "混蛋！都这时候了，怎么连你们都靠不住？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "蔓德拉......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "怎么了？不是叫你先不要说话的吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "我走不了了。你走吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "你说什么......？我做了这么多，不都是为了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "......为了救我，还是为了去找领袖邀功？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "这有区别吗？“间谍”，你说什么胡话？我们只剩下五米了，我们的人就在外面！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "他们不在了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "蔓德拉......领袖她......她早就抛弃了我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "“间谍”！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "混蛋，混蛋——石头，快去，扎穿他们，扎穿那些萨卡兹！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "“间谍”，你不会有事的，你只是挨了一箭，剩下三米，就算我扛着你——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "......你走吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "要是走得掉的话......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "不要......不要去找领袖。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "......死了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "你怎么可以就这样简单地死了......我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "基里安，基里安......你个混账东西！我不许你死在这里，你给我起来，起来啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不必着急。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你也活不了多久了，蔓德拉。你和你的塔拉老朋友，很快就能相聚。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "哈......哈哈哈哈！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "曼弗雷德，你又欠了我十一条命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "我好不容易......好不容易杀了那么多萨卡兹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......这就是为什么你必须死在这里。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "真好......你们送上门来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "我要一个不剩地，把你们全部碾成泥。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
