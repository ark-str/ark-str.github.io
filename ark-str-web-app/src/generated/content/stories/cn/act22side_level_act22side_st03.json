{
  "server": "cn",
  "storyId": "act22side_level_act22side_st03",
  "groupId": "act22side",
  "stageId": "act22side_st03",
  "title": "一声呜咽",
  "storyCode": "FC-ST-3",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act22side/level_act22side_st03.txt",
  "sourceHash": "7ff08833eeba59e9decae53bfad4ea69a62a7c2e96e921c6d628b35af92a3fe6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "电台通讯声",
      "text": "前方小雨天气，航道已确认，沿途侦测站将默认放行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "电台通讯声",
      "text": "收到道森子爵的电报，对方希望借此次放行的契机，与深池代表会面。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "又是一些倒向我们的贵族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "放心吧，领袖不打算对他们有什么表示。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "只是简单示好就想获得深池的和平保证，控制住领地内塔拉人的激昂情绪，是不是有点太吝啬了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "他们迟早要学会，怎么付出代价才算诚意十足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "领袖依然派你去交涉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "或许我更需要花一段时间，让大家先忘记我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "是个好消息。以我的标准，你失误的行动不少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "呵呵......既然你独自登舰汇报，看来，你还是没抓到拉芙希妮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "你不必明知故问。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "你阻拦了我的队伍继续搜捕，事后又把她去过的地点暗示给我的士兵，这种搭救方式于你而言，算不上高明。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "你又怎么知道，我搭救的不是你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "我记得，领袖从来没有说过自己想处死她吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "领袖允许她肆意逃窜，也同样允许我自行判断，要如何对待她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "不要怪我对你的熟人太过苛刻，阿赫茉妮。没人能放任一条德拉克在眼下的维多利亚随意行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "别在意，我想我和她的关系也没有那么好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "你瞧，我正打算去她此前藏身的那家医疗公司看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "呵呵，也说不定，先抓到她的人是我呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "......喂，等等，航道上有建筑物？能见度太低，发现得太晚了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "这一带的航道规划是谁完成的？前天的勘测组是哪一组？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "现在全舰队偏转方向已经来不及了，优先确认建筑内有无人员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "......好。砖木结构房屋，体积很小，不会对战舰履带造成任何威胁。按照原定航道继续行驶。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "......啊，又是一个小小的失误。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "战争总要忍受一些牺牲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "我明白你的意思。但是，我也有我的“自行判断”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "让拉芙希妮牺牲？代价恐怕太大了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "毕竟，那可是流着德拉克之血的战士，就算感染了矿石病，也还是很有用呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "是的，我没有将她带回来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "她没有战斗的决心，反而很擅长逃亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "另外......我们追踪到了她进入塔拉王城旧址的痕迹。遗迹内的火熄灭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "成为感染者，或许让她的源石技艺发生了变化。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "爱布拉娜",
      "text": "你似乎认为，是矿石病增强了她的力量？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爱布拉娜",
      "text": "呵呵......当然不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爱布拉娜",
      "text": "她是我的妹妹，要是连与我稍微抗衡的力量都没有，那才实在是令人失望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爱布拉娜",
      "text": "告诉我，她身边有谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "有几个流民跟在她身边，她在那些人面前坚持自称领袖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爱布拉娜",
      "text": "那么，你就不用跟着她了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爱布拉娜",
      "text": "既然她终于醒来，意识到自己作为德拉克的权能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爱布拉娜",
      "text": "那她很快就会回到我身边。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你确定能从这里搭长途货车？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "是呀，我以前逃出维多利亚的时候就坐过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......风笛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......你记不记得，我之前就问过你，你想要的真相是什么，以及，知道之后你又想做什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "其实这个结果，你早该知道。维多利亚的许多事情，最终大抵是这样的权力斗争。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "嗯，话是这样说......可是每一件事里，被卷进去的还是不一样的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "我的想法还是没有变，我必须把自己的报告书递出去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "只不过，我在想，什么时候维多利亚才会有一个地方能真正收下这份报告书？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "我到底能用自己的双手做些什么，来让维多利亚快些变成这样的地方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "经历了这么多事，你还是想要改变维多利亚？你还真是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "真什么？真傻，还是真倔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......真顽强。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "这也是为什么我们一直都是好朋友吧？认定的目标轻易不会改变，陈陈，我跟你，跟队长，都是一样的欸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "哈。从你嘴里说出来，就不像夸我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "还有，这些天其实我也一直在想......谁也不能说别人的梦想，是一定不能实现的吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "收音机",
      "text": "（无信号的嗞嗞声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你还留着维恩塞给你的这东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "啊，不奇怪吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......我来吧，这收音机已经够旧了，我真怕在你手里变成一堆废铁。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "好了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "收音机",
      "text": "......全体领民注意，维多利亚与卡兹戴尔在伦蒂尼姆周边冲突不断升级......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "收音机",
      "text": "战争......嗞嗞......爆发......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "收音机",
      "text": "威灵顿公爵......嗞嗞......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "收音机",
      "text": "请做好战争准备......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "风笛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "是，我正在驾车返回，侦察任务已经完成，没有发现异常动向。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "之前那个身份所用的办公室？返程后我会第一时间销毁所有痕迹，请放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "如果没有意外，我当然会接受公爵授予我的提拔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "这种事我并不打算隐瞒。到了那时，我个人的身份与面貌都会被抛弃掉，以现在的身份对你讲什么，都不重要吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "下车走走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "哎，先生，要木人儿吗？我从河那边的聚落带来的，奶奶的手艺可精湛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "好......请问，你是这附近的人吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "......什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "呃，感觉你看起来有点眼熟？真不好意思，我刚到这里落脚，还没认清这一带的人呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "我叫维恩，卖东西的。要是你有想买想卖的，都可以跟我说一声，我顺路给你捎上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "我住在那边，你看，昨天刚建好的屋子。离聚落是远了一点，但在大路旁边，我觉得不坏。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "欸，这是你的车啊......我认错人了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "真不好意思，打扰您散心了，那您继续——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巨大的轰鸣声让两个人同时转过头。\n庞大的影子浮现在地平线，他们脚下的地面不住颤抖。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "......那个声音是，什么东西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "不不不，那是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "......军队？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "......昨天，我在四百公里外完成了对这支部队的侦察任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "你这是在说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "我始终相信，以强硬军事手段著称的铁公爵，是我们最大的敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "在他的支持下，深池煽动民众的仇恨，将无辜的普通人拖入暴乱甚至全面战争之中。我们必须找到与他制衡的方法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "我的每一次行动，都牵扯着成百上千的普通人的性命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "可是现在......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "他发现自己无法再发出声音。\n轰隆。轰隆。\n高速战舰率领的战斗集群行驶在它既定的航道上。\n这里是开斯特公爵的领地。她默许了这一切发生，默许了战争借她的道路进发，碾过维多利亚的土地。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "......逃吧，塔拉人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "你的房子建错了地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "为、为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "这一带仍然是开斯特公爵的领地，你们还没越过那条模糊的边界。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "经过这一段时间的周旋后，特伦特侯爵终究没有倒向威灵顿公爵，并且，对塔拉人的管理会再度加压。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "就在这两天，或许你就会重新遇见那些粗暴的巡逻队，或许他们还没有忘记你这张脸曾经出现在案宗里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "他是不是猜错了公爵的意思？他会不会也成为这场战争中被牺牲的一枚棋子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "我们谁都无法回答。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲舍尔",
      "text": "......若是我们能知道答案，那孤独的小屋就不会建在错误的位置了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "呃，您在说什么呀......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "——等等，我想起来了，你、你是那个时候来抓我们的人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维恩",
      "text": "你、你要干什么......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "菲舍尔没有回答，只是转身上了车，启动了引擎。\n在他身后，砖瓦小屋崩塌的声音和乡民悲痛的一声叫喊，都被淹没在高速战舰的噪音里。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
