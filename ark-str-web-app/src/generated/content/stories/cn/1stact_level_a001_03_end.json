  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "干掉了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "大鲍勃，你没事——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "咦？你腿上的伤口......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "那里有漏网的！可能是瓦各斯克团的人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "这个我自己能处理！先击退敌人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "这小个子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "喂，喂，你那是什么眼神？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "别，别过来，不怕我在你身上开个窟窿吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你都解决了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "真厉害。这么小的个子，本事倒是不小。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "坐在那里别动。我来给你包扎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "不碍事，让我起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你看到了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你看到我身上的结晶了吧？你难道想被感染吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "感染者，本来就是我们罗德岛的救助对象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "罗德岛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "罗德岛是......？不是维多利亚......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "以前是维多利亚的骑警，不过现在，是罗德岛的干员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "离我远一点，小姑娘。我是感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "可萝尔小姐，这可能有点血腥，你稍稍回避下吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "好啦，已经止血了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你经常这么做吗，给感染者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你就不怕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "我的同事有很多都感染了矿石病，但我分不出究竟有谁感染了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "也就洗澡的时候能看得出来吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "——哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "多谢你了，没戒心的小个子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
