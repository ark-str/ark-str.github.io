{
  "server": "cn",
  "storyId": "main_10_level_main_10-13_beg",
  "groupId": "main_10",
  "stageId": "main_10-13",
  "title": "逃离炮火",
  "storyCode": "10-15",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_10-13_beg.txt",
  "sourceHash": "23669a7a52a1be81afcc47be0b8b45497ef650919c418817179e5c1451912628",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "11-beg"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "情况怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救军战士",
      "text": "——D区和E区受到严重损伤，其他区域顶层结构也有不同程度破损！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救军战士",
      "text": "轻伤十九人，暂时没人重伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救军战士",
      "text": "幸好，指挥官，我们听了您和那位博士的话，把大部分人提前转移到了安全区域——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "不，并不安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "整个地块都很危险......我们的据点完全暴露在了萨卡兹面前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "在把这里彻底炸穿，确保我们无处可躲之前，他们是不会罢手的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "我们还有多少时间？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "三十分钟，呃，说不定时间更短一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "附近的地块年纪都挺大了，以我们之前见过的城防炮的威力，再乘以一个输出极值理论倍数——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "不出三十分钟，我们头顶的全部结构层就会被轰烂！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "通知哈默，我们立刻启动列车。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "列车？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "你们应该都见过了，在我们头顶几公里处，有一个车站。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我还以为车站已经被萨卡兹占了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "那我们必须把它夺回来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "如今萨卡兹截断了我们通往其他区块的所有渠道，这是我们撤离萨迪恩区的最后希望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "海蒂，一旦我们离开萨迪恩区，你有方法帮我们避开萨卡兹的视线吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "嗯，我一直准备着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "到下一个站点，会有朋友来帮我们做好伪装和掩护，直到我们成功进入中央区。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "最大的问题还是，我们能不能安全登上列车——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "克洛维希娅，我们目前离城墙多远？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "走地下通道的话，很近。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我想试试从下面登上城墙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "阿米娅，你是想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们会为自救军的撤退争取时间。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "封锁目标地块的全部出口，盯紧车站。我不希望他们再逃进下一个阴沟里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "设置地面活动目标动态追踪。万一他们不死心，想爬到地面上，使用其他载具，那他们就必须直面更猛烈的炮火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "加强城墙内部所有节点的防御。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......还有，修改城防炮的控制口令，确保除我以外，没人能关闭它们。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "很好，足够谨慎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "将军？！您为何会来这里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特雷西斯",
      "text": "再过一会，这些恼人的虫豸就再无藏身之地。整个伦蒂尼姆的反抗势力不会再敢轻举妄动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特雷西斯",
      "text": "更关键的是，不会再有人从我们看不见的暗道里进进出出。外面的公爵部队将只能看到我们筛选过后的消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特雷西斯",
      "text": "没有人能再影响我们的工程进度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特雷西斯",
      "text": "曼弗雷德，这样值得庆祝的时刻，你不欢迎我与你一同迎接吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "请不要再同我开玩笑了，阁下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特雷西斯？",
      "text": "哦？你又进步了嘛，这次我们只说了五句话，你就发现了我们不是特雷西斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "阁下......虽然殿下不会同你计较，但如果你这副样子被赦罪师的人看见，他们一定会再次向殿下申请，限制你的行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特雷西斯？",
      "text": "好吧好吧，你说的对，军事委员会不能有两个发号施令的人——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那就让我们换一个更舒服的模样吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......难得，你愿意用王庭会议时的形象来见我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我们答应你了，不用逝者的脸，也不再吓唬你和你的战士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你回来得比预定的时间更早。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "虽然你帮我们找到了反抗军的窝点，但他们依然可能有其他我没注意到的后路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "假如你能跟说好的一样，一路跟着他们，直到最后一名反抗军落到我们手中......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你真以为那个博士能让我们藏那么久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "更何况，曼弗雷德，你别忘了，我们不归你管。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "是我冒昧了，请阁下宽恕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "也别用这种跟老红眼病说话的语气跟我们说话，早说过了，我们不吃这套。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "如你所愿，阁下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "既然你选择提前回到这里，那么，你在地下看到你想看见的了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "唔......那个“魔王”比我们想象的要更坚强一些，不过还远远算不上成熟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "她呀，她还不知道自己即将面对什么，我们想了解更多的话，至少要等她见一见那位殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......你这些话，最好别让赦罪师听见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "听见又怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "他们会以为变形者集群的王庭有......摇摆之心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你觉得我们会在乎吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "曼弗雷德，我们答应你的事已经做完了，剩下的烂摊子，你和血魔自己收拾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "对了......再有下次的话，给我们挑一个还活着的身份吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "维娜，阿米娅和博士已经出发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "第一批自救军战士正在赶往头顶的车站......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "快，快走，都跟上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "等战士们成功夺下车站，伤员们和没有战斗力的平民会最先登上列车。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "白轮先生，麻烦你和医疗干员们一起照顾下行动不便的伤员，大家留意通道两侧的信号灯，不要走散！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "大部分指挥部的人会随着伤员和平民一起转移，除了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "我们的人都进入撤退通道了吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自救军战士",
      "text": "顶部结构稳定性持续下降！指挥官，你赶紧离开这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "只要所有人都进了通道，我自然会跟上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "十二队，汇报情况！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救军战士",
      "text": "指挥官，这地下都快待不了人了，真的还会有敌人下来吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "汇报！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "维娜，我们要跟上白轮他们吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我们留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "留下？你是说陪着克洛维希娅指挥官一起？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我有一种感觉......这种感觉可能她也有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "最强大的敌人，或许此刻并不在我们头顶。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "......城防炮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗本",
      "text": "是的，号角，城防炮又启动了！这一次他们对准的是距离城墙最近的地块，目前来看，轰炸中心不在这里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "但谁都不能保证附近的安全。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆市民",
      "text": "跑啊，快跑——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆市民",
      "text": "我的女儿去了哪里......谁看见我的女儿了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "请立刻进入最坚固的建筑物避险——不，用最快的速度远离城墙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆市民",
      "text": "好......好的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "这是......伦蒂尼姆的城防炮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "照目前的情况来看，要不了多久，炮火就能贯穿地块，甚至破坏最下方的基底结构。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗本",
      "text": "该死的萨卡兹，他们是不是早就等着这一刻了？他们是准备彻底毁了这座城市吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "不。他们只启动了少量炮口，打击目标也很明确。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "他们是为了消灭我们......和我们的朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "罗本",
      "text": "号角，我们该怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "昨天跟我们回来的士兵之中，是不是有几位原本就驻守在此的城防军？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "叫上他们。拿上最好的装备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号角",
      "text": "跟他们说——是时候把我们的城墙从萨卡兹手里夺回来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "再往前一点点就到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "小心，别在这里摔倒——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "你还好吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "哈......很难说得上好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "唉，我能懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "我也犯过大错，信任了不该信任的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "在那之后，一个多月的时间，我只能逼着自己不要停下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "只要一停下来，我就......呃，觉得自己很难直视阿米娅的眼睛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "嗯，仗还没打完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "大家连喘息的时间都不够，要是我还想着哀悼或者自我怀疑的话，也太奢侈了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "费斯特先生，你需要帮助吗？我可以帮助你平复情绪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "平复情绪？这也是某种源石技艺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "差不多吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "你平时......也会为你的战士做这些心理治疗吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "如果干员自己觉得有必要的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "别误会，阿米娅是关心大家。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "阿米娅并不想把干员变成无情的战斗机器。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "费斯特先生，我让你误会了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "咳咳，倒也没有，就是觉得源石技艺真的很神奇。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "就算生在伦蒂尼姆这样的城市，我没见过的，还是很多啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "阿米娅小姐，谢谢你的好意。不过，我还不想那么快就把刚才那一幕从我的脑子里驱赶出去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "那接着干活咯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "干活吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "无人机显示，我们头顶的防御结构层......非常厚。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "能爆破吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "可能性很低。如果伦蒂尼姆的城防系统能这么轻易就被炸开......呃，我们昨天就该杀进碎片大厦了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你能找到办法。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我相信可露希尔。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "博士，谢谢你对我的信心，这可真是压榨员工的好办法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "嗯......我扫描到了升降梯，只要你们能找到一个合适的缝隙，让我把无人机塞进去，我就能黑到升降梯的控制权......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "当然，首先你们得找一个更大的缝隙，来把自己弄到上面去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "博士，你不觉得你应该发个信号，让Misery赶过来吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他有其他任务。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "好吧，看来我们没法偷懒了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "本地人先生，麻烦再给我一些灵感。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "要是能找到支柱结构，再施加一个超强外力的话，应该能开一条缝出来......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "......有人正在迅速接近我们的位置！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "萨卡兹料到了我们会想办法登墙？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "管不了那么多了，我让无人机搭载源石炸药！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "费斯特，你算好位置，我们再想个办法放大爆炸效果——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "来了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......赫德雷。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "又见面了，罗德岛的领导人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "W小姐她......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你确定要先聊她的事吗？我听说你们的时间很紧张。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我可以不问你们之间发生了什么。切尔诺伯格和Scout的事......我也同意暂且放到一边。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "但是，雇佣兵先生，如果此刻你一定要挡在我们身前，我动手的时候绝不会犹豫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "死在那位殿下的继承人手上，对一名雇佣兵来说，也算是一种荣耀了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "阿米娅，你最好快一点！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "就在刚才，我的炸弹已经开始倒计时了——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "一分钟，我们最多只有一分钟！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我来拖住赫德雷......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......不。阿米娅小姐，这个雇佣兵交给我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "费斯特先生？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我找到了支柱的位置。而且，我有个主意，虽然不知道有多牢靠......能成功的话，你和博士抓紧时间登墙。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "我认得你，年轻的战士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "我也认得你脸上的表情。你终于知道自己失去了多少，而且正在为自己决策的正当性感到迷茫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "迷茫吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "抱歉，就算有时间，我也不想跟刽子手谈心。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "看这里——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "......又是烟雾弹？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "就算少了一条能动的胳膊，你这些道具也对我起不了作用。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "来啊，萨卡兹，朝我砍过来！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "用上你的剑，你的刀，你所有的武器——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你想引开我？不算太明智的策略。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "缺乏自知之明的孤勇并不能创造奇迹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "就算你所有的手下都在这里，你们也无法战胜我。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "唔......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你逃跑的模样越来越狼狈。没有其他人帮你的话，你很快就会流血而死。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "说到底，你只是一个工匠......你和你的手下，不过是挥舞着扳手和锤子，就想扛住萨卡兹在战争中淬炼百年的刀剑？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "向那边的魔王求救吧。让她来处置我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......魔王？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "你说......什么......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "萨卡兹......是你们把战火烧到了伦蒂尼姆......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "那么，这就是我们之间的战争！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "三十秒！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅，集中能量。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，抓住我！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "费斯特先生，我需要你锁定位置——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "雇佣兵......你看到这个了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "......又是什么奇怪的障眼法道具？别挣扎了，你骗不过我的眼睛。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "对了，就是这样——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "麻烦更用力一些！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "只是......磐蟹？一个机械玩具？你又想靠小伎俩蒙混过去吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "不，它是你们从我身边带走的最重要的东西。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我从来不是孤身战斗......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "你看，老比尔又帮了我一次。雇佣兵，也多亏了你的多疑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "我的多疑？你......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你利用了我的攻击——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "哈......哈哈！你终于看明白了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "你砍向我的每一刀，都是通往你们失败的道路！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "阿米娅，结构层被赫德雷劈开了一条缝！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "快，瞄准它，炸弹就快炸了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "三，二，一——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "唔——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "撕开了——这条缝隙足够大！无人机——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "升降梯控制权到手！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，我们上！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "费斯特，你还有力气吗？拉住滑索，我们跟上去——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "别想走——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "可露希尔，还有炸药吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "可露希尔",
          "text": "有，你接住！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你们......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......谢谢你的帮助，雇佣兵。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
