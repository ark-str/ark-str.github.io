{
  "server": "cn",
  "storyId": "act34side_level_act34side_02_end",
  "groupId": "act34side",
  "stageId": "act34side_02",
  "title": "评议式迎接",
  "storyCode": "BP-2",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act34side/level_act34side_02_end.txt",
  "sourceHash": "c71c0e9b736fd9d5ac8e2a7628342f90cfceb71d5c7efa0994796a74c1cccf88",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "军团长官",
      "text": "歌蕾蒂娅执政官，您认为问题并不在于那场战役本身？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "是的。详细的作战部署此刻正投影在各位面前，如果其中存在我没能注意到的纰漏，你们每个人都有义务指出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "军团长官",
      "text": "不，我对具体的作战部署没有疑问。结合当时的认知条件，那无疑是最合理的作战部署。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "军团长官",
      "text": "但我希望知道，现在的您会如何评判当时的认知条件？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "必须承认，阿戈尔当时对海嗣的认知存在严重的缺陷......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "这些人想说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "以前还在阿戈尔的时候，你就不喜欢想太多，你还是不习惯那些人的思考方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "他们对我们没有恶意，他们只是在寻求必要的事实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "寻找所有可能的缺陷，质疑所有完美的成果。然后，真实与美，还有正确的道路，将在最激烈的争论中彰显自身。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "一切交给剑鱼吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "要是不想听，就闭着眼睛睡一会儿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "......综上，五年前那次战争设计最大的失误，就是没能为我们的认知缺陷留出余地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "在泰拉的真相被揭开之前，我们需要承认自己对海嗣的认知总会存在缺陷，我们的战争设计必须将其考虑在内。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "军团长官",
      "text": "同意。您刚刚得出的结论，应当被用于审视未来可能诞生的各项作战计划。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "军团长官",
      "text": "能与您一同反思一场已经被尘封的战役，并得出有效的结论，是我的荣幸，歌蕾蒂娅执政官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科学院研究员",
      "text": "不过，除了五年前的那场战役......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科学院研究员",
      "text": "还有更加现实的问题值得我们担心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科学院研究员",
      "text": "根据体检报告，您、斯卡蒂、劳伦缇娜，三位都发生了不容忽视的身体异变。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科学院研究员",
      "text": "我无意质疑各位对国家的忠诚，但我需要知道海嗣基因对各位的同化，会对各位接下来的行动产生怎样的影响。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科学院研究员",
      "text": "请原谅我这么发问。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科学院研究员",
      "text": "弥利亚留姆很快就要完成对所有巢穴的定位，在那之后，海嗣将在第Ⅳ级武器的作用下被驱离，航道正式开启。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科学院研究员",
      "text": "在这个时间点上，深海猎人，是否会成为阿戈尔的敌人、你们自己的敌人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "对阿戈尔来说，失控的猎人比海嗣本身更加危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "深海猎人，就像是阿戈尔的反面。他们诞生于阿戈尔最卑劣的伤口，阿戈尔怜悯他们，也畏惧他们。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "深海猎人，乌尔比安，对吧？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "按理说，你更应该在底下接受质询。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "你比我想象中要冷静很多，也知道我的身份。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "看来歌蕾蒂娅在陆地上建立的信任关系，并不只是对那位医生一人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "我没有在之前的任何一次行动中见过你。你不是伊比利亚的审判官，也不是岛民。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "那位罗德岛的医生将你带到阿戈尔，却又有意隐藏你的身份。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我只是凯尔希的同僚。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我和她同属于罗德岛。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "随你怎么定性自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "总之，你能帮到猎人们。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "有事为什么不直接找斯卡蒂？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "乌尔比安",
              "text": "斯卡蒂不太擅长这样的事情。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "有事为什么不直接找幽灵鲨？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "乌尔比安",
              "text": "你是说劳伦缇娜？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "乌尔比安",
              "text": "她不太擅长这样的事情。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "有事为什么不直接找歌蕾蒂娅？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "乌尔比安",
              "text": "现在并不是合适的时机。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你不信任猎人们？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "恰恰相反，我信任她们，而且太过了解她们。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "斯卡蒂的行动快过思考，劳伦缇娜清醒的时日尚浅，最终决定一切的人只会是歌蕾蒂娅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "此前我已经向她分享过许多情报，她应该有了警惕。她并非不清楚自己会遭遇多少限制，但仍然选择回到阿戈尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "她太急于回到熟悉的环境，殊不知自己已经被摆在了最显眼的位置，一切可信任的和不可信任的都有十足的权力来审视她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "现在并不是深海猎人返乡的最好时机，这是一场豪赌。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "既然如此，你为什么还要潜入这座城市？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "看来你还是很关心猎人们。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "歌蕾蒂娅她们的处境不容乐观。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "与我不同，她们三人虽然接受了改造，却没有参与深海猎人计划最核心的研发工作。她们很难解释清楚自己身体的异变。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "我会告诉你一些相关的信息，必要的时候，我需要你想办法为歌蕾蒂娅解围。事后，再向她传达我的提醒。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "至于更多的事情——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "或许，各位可以听我说两句。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "......布兰都斯。他也来到了这里？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "歌蕾蒂娅",
          "text": "布兰都斯？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "每次都是这样，以前在研究所的时候，你也好，乌尔比安也好，总是趁我打盹的时候和研究员们吵起来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "顾问，你的意见确实会很有参考价值。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "不胜荣幸。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "我曾是深海猎人计划的技术顾问，负责改造实验中的基因嵌合研究。换句话说......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "此时此刻，我是这座城市最了解深海猎人的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "歌蕾蒂娅、劳伦缇娜、斯卡蒂，她们在干燥的环境待了太久，其间依然频繁地进行战斗，她们的身体情况确实不容乐观。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "各位的担心很有道理。但我的答案是，\n不会——"
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "她们并不会变成海嗣。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "寂静。\n布兰都斯清了清嗓子。"
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "我尽量说得简单些。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "我们都知道，海嗣基因在寻常生物体内会展现出异常的性状控制力，不可逆地抹消该生物的本来属性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "我们在深海猎人身上尽可能地延长着这种海嗣化的过程，直到它远远长于猎人的自然寿命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "但后来，技术院的研究取得了关键性进展。在猎人们出发去斩杀“初生”前，我们为他们每人都安排了一台“自适应接点”手术。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "“自适应接点”被安置在人类基因与海嗣基因的嵌合处，它能帮助深海猎人对海嗣基因保持更密切的“监视”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "一旦海嗣基因表现出异常的性状控制力，“自适应接点”就会催使猎人的身体进行抵抗，防止海嗣基因夺取控制权。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "尽管猎人们的“自适应接点”已经在未经维护的情况下运行了五年，难免会有老化，但她们如今的异变都尚在预期范围之内。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科学院研究员",
          "text": "顾问，根据深海猎人研究所当年的记录，“自适应接点”手术曾经出现过一场手术事故。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "那场事故发生在......乌尔比安身上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "但记录应该也有说明，经过多次临床验证，我们已证明那场事故没有产生任何不良影响。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "我可以对此负责，也愿意为此接受质询。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "既然深海猎人回到了阿戈尔，那么她们的身体状况就是可控的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科学院研究员",
          "text": "听起来，您已经有了控制猎人身体异变的可行手段？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "城内就有一间闲置已久的深海猎人研究所，可以被重新启用。之后，我可以亲自为她们进行“自适应接点”的维护。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科学院研究员",
          "text": "那么，乌尔比安呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科学院研究员",
          "text": "那位至今不愿回归阿戈尔的深海猎人，我们该如何确保他不会堕落成海嗣？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科学院研究员",
          "text": "还是说，我们担心的事情已经发生了？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "话题的焦点突然转移到了你身上。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "听起来你很危险。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "哼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "他们的怀疑很合理。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "对超出掌控的事物保持十二分的警惕，是常识，也是来之不易的教训。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "怀疑你的不止场上的那些人。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我也好奇你隐藏行迹的原因。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你潜入城市，真的只是出于对猎人的关心？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "斯图提斐拉沉没之前，我曾向歌蕾蒂娅分享我的发现——海嗣中存在着不止一只类似伊莎玛拉的超级个体——“初生”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "而此时此刻，新的“初生”已经“松动”，祂，或祂们，苏醒在即。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "不确定数量，不确定时间......但是很近。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "海嗣向陆地的迁徙与之相关。这段时间，我深入了足够多的巢穴，海嗣的反应共同传递出某种......危机感。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "或许连如今的海洋都不足以供养这场觉醒？新“神”的苏醒，是另一场陆地人口中的大静谧，还是其他形式的海洋灾难？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "这场浩大的迁徙与阿戈尔的航道计划几乎同步发生，那么，弥利亚留姆在其中到底处于怎样的位置？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "乌尔比安",
          "text": "这些是否足够让我来到这座城市？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "海嗣固然能在本能的驱动下独立繁衍，但它们源于“初生”，不可能违背最基本的生物性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "换言之，即使那只“初生”的死亡没有遏止海嗣的进化，也不至于使它们爆发式地涌现出前所未见的特质。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "歌蕾蒂娅",
          "text": "您似乎忽视了我在任务书里提到的最新情报。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "“复数的初生”，这样的解释很合理，可我对乌尔比安的质疑恰恰来源于此。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "计划周详的行动以失败告终，幸存的三位猎人随着海浪来到陌生的陆地，与那位在巢穴中滞留到最后的猎人重逢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "“海中存在‘复数的初生’”，乌尔比安带来的这一情报不仅具有颠覆性，而且非常“有效”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "它恰如其分地解释了为什么明明你们完成了作战目标，却催生了海嗣更大的异动。它回应了所有人的疑问。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "歌蕾蒂娅",
          "text": "您对这一情报的疑问在于？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "这样恰到好处的解释，要么是唯一的真相，要么是针对所有疑问设计出的答案。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "是否采信乌尔比安传递给您的情报，会对我们接下来的战争设计产生重大的影响。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "技术院科研人员",
          "text": "既然乌尔比安还活着，那么确认他的行迹与状态，甚至与他当面对证，就是最直接有效的验证方式。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "歌蕾蒂娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "布兰都斯顾问，你已经沉默了许久。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "关于乌尔比安的情况，你有什么想要补充的吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "我知道你与乌尔比安师出同门，甚至你加入深海猎人计划，也是出于对乌尔比安的信任——你一开始并不赞成这项计划。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "但我同样信任你作为阿戈尔人的专业与德行，你不必刻意回避什么。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "执政官阁下，我只能说，我必须对今天在这场评议会中说过的每一句话负责。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "乌尔比安......我不会故意进行任何有利于他的假设，也不想给出任何不利于他的猜想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "布兰都斯",
          "text": "仅此而已——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "看来你和那位顾问的关系不错。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "原来再冷酷的人也有这样的朋友。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "乌尔比安没有回应你。场上的质询仍在继续，但布兰都斯不再说话，他突然抬起头看向你所在的方向，像是感应到了什么。\n隔着大半个斗智场，你对上了他那双有些疲惫的眼睛。\n他明显注意到了什么，坐在他身侧的执政官，以及相邻的几个阿戈尔人都捕捉到了那一瞬的异样，部分人的目光追了过来。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "呃......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "你侧过身，不知何时，身旁的座位已经空了。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我？我只是个旁观的陆上人而已。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "不好意思，我打扰到你们了吗？",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我也需要发表意见吗？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "通过这场评议会，我们已经得出了充足的结论。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "歌蕾蒂娅、斯卡蒂、劳伦缇娜，以及其他深海猎人，为阿戈尔付出了巨大的牺牲，也做出了伟大的贡献。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "时隔五年，我们仍有机会从她们的见闻与经验中生发出新的思考，这是阿戈尔的荣幸。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "现在，她们证明了自己的清白与安全，证明了她们在航道计划进行至此的紧要关头回归，不是威胁，而是助力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "然而，与此同时，无数疑点聚焦在另一位幸存的深海猎人，乌尔比安身上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "出于不可知的原因隐匿踪迹，并试图影响其余的深海猎人——这些行为显著违背了他身为深海猎人的责任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "根据现有的信息，我们无法确定他究竟怀着何种动机，意欲达成何种目的，甚至连他现在是否还能被称为阿戈尔人都未可知。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "乌尔比安必须尽快被找到。即使他真如同歌蕾蒂娅所说的一样不怀恶意，也必须接受质询，以洗清自己身上的重重嫌疑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "疑惑已经得到解答的各位，你们可以离场了。尚有疑问的人，质询可以继续。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克莱门莎",
          "text": "歌蕾蒂娅执政官，你还有什么想要补充的吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "斗智场中央的珊瑚状终端缓缓合拢、收缩、下沉，最终没入地面以下。水纹荡漾的场地平坦而空旷，仿佛是要容纳一场戏剧演出。\n场地中央，唯有歌蕾蒂娅一人。"
        },
        {
          "type": "dialogue",
          "speakerName": "歌蕾蒂娅",
          "text": "我已经告诉了你们我所知的一切。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "歌蕾蒂娅",
          "text": "我对评议会的结果没有意见，对乌尔比安的嫌疑，也不持任何异议。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "已经陆续有人离场，他们在出口转身，默契地向歌蕾蒂娅颔首致意。\n余下的听众仍在发问。歌蕾蒂娅应对着她知道或不知道答案的问题。\n穹顶投下的水纹与萦绕场地的光纹相交织，却没能在歌蕾蒂娅的脸上映照出任何表情。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "哪怕我是个阿戈尔人，有时候也搞不懂这种状况。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "明明上一秒还在唇枪舌剑针锋相对，下一秒又在感谢歌蕾蒂娅对阿戈尔的付出。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "他们是真诚的。科学要求人们把情感与事实分开，而他们确实做到了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "我当然知道这些人是真诚的，我只是......唉，算了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "三队长目前也只是受到怀疑，剑鱼、博士和凯尔希都会想办法的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "接下来我们去哪儿？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "等剑鱼来找我们吧。这场评议会一时半会儿还没法完全结束。唉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "你怎么也突然叹气？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "剑鱼以前常去当时那座城市的斗智场看戏剧演出，除非有战斗安排，否则一场不落。我有时候会跟着她一起去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "二队长她......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "剑鱼的艺术造诣挺高的，据说是被她母亲培养出来的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "但是和一般的观众不一样，她喜欢坐在最高最远的位子上，搞得我每次都得和她分开坐。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "为什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "在她看来，保持适当的距离，就可以尽可能地排除干扰。忽略一些场地上的细节，反而能更好地体会故事本身。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "而此刻，她自己却成了站在剧场中央的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "她习惯的距离感被完全消解，她成了被审视、剖析、讨论的对象。在那个位置，没有人可以保持从容。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "鲨鱼，我突然也明白自己刚刚因为什么叹气了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幽灵鲨",
          "text": "因为什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斯卡蒂",
          "text": "直到此刻，我才确认我们真的回到了阿戈尔。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
