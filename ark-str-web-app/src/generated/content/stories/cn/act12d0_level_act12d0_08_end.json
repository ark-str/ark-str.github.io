{
  "server": "cn",
  "storyId": "act12d0_level_act12d0_08_end",
  "groupId": "act12d0",
  "stageId": "act12d0_08",
  "title": "嘉维尔之拳",
  "storyCode": "RI-8",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act12d0/level_act12d0_08_end.txt",
  "sourceHash": "6165e12bba5413d7d0933e1781694d567be37b01bd6649aed6f759d5a61acddf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "哇啊啊啊啊啊啊！哎，不对，下次我应该换个叫声，有点腻了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "喂，他没事吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "不用担心，等一会儿他就会回来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "好吧，不过那真的是普通人吗？我没听说有这样的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "不知道，大祭司只说过他在这里生活了很久很久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "好吧，比起这个......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "呼，真是个了不得的大家伙啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "嘉维尔，你头上在流血啊，没事吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "没事没事，这点小伤，特米米，把我的医疗包拿过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "嗯？特米米这丫头人呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "text": "给，你的医疗包。至于特米米，刚才快要赢的时候我好像看到她慌慌张张地往其他地方跑去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "谢了。她不会被吓破胆了吧，算了，先包扎再说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "对了，你们去看看有没有受伤的家伙，全部带到我这来，我来给他们治疗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "噢，交给我吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "哈哈，没问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "text": "诶，好麻烦啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "text": "别抱怨啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "博士......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "大丑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "祖玛玛，抱歉啊，只能把它拆掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我检查了一下，你的引擎还能用，我会把它还给你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "是吗，太好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "嘉维尔，你不打算留下来吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "嗯，我和你一样，找到了要做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "是医生吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "做医生很开心吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "造机器很开心吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "开心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "那就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "但是，大酋长依然需要你来做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "哈？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "无论如何，大丑倒下了是事实，你赢了，嘉维尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "看，人群重新聚集了起来，大家都在看着你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "啧，博士，怎么办啊。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "由你决定。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "这不是跟没说一样吗！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "博士，别装睡了！我可是医生！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "大酋长嘉维尔万岁！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "啧，博士，我现在真想给你一拳。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嘉维尔，你没事吧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嗯？没事。你跑哪里去了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "诶？啊，那个，我刚才忽然想上厕所！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "好吧......嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "怎么了，嘉维尔，你怎么忽然看着我？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "唔......哈哈，有了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "所有人都听着！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我战胜了大丑，所以接下来由我来担任大酋长。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "在这里，我要对你们说的是——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "拳头，就是一切！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "诶，嘉维尔，你要留下来做大酋长了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "但是！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我有非常重要的事要去做，所以我还是要离开。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "不过你们不用担心！我不在的时候，会由特米米来代替我发号施令！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "把特米米当成是我就行了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "诶、诶诶诶？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "宴",
          "text": "诶，这样真的行得通吗？这里的人不是力量至上什么的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "但嘉维尔是大酋长，她已经征服了所有人，所以她说的话当然是令人信服的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哈哈，祖玛玛，机器虽然很有意思，但是对我来说，果然还是拳头更好啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "哼，别忘了，我并没有承认你，我会造出更厉害的机器，然后再来挑战你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "好啊，我等着。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哦对了，在那之前，你得跟我走一趟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "为什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "你必须先跟我去罗德岛观察一下你的矿石病。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "我可以拒绝吗，我还有大丑要......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "这次可由不得你，而且在特米米就任前，我就是大酋长，就算是绑着你我也要带你去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "好吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "......嘉维尔，你还是要走吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "是啊，等把引擎拆下来装回飞行器上，我就该走了吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "不行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "我、我不准你走！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
