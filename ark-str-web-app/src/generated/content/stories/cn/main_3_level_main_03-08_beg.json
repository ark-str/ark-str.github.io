  "title": "黄昏",
  "storyCode": "3-8",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_03-08_beg.txt",
  "sourceHash": "7f6f6489c5bbb12edc400e9af6b57b4a813095838b64a16d1db71b9f6a3c372c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "咕！他们还在反击！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "碎骨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "只要现在击退他们，我们就能胜利了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "现在......只能战斗。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "这些人......有点难缠！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "呃——！那面盾，可恶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "没错，她，她是龙门近卫局的......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "如果你们现在放下武器投降，你们还有机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "除非想白白送命的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我们怎么可能会相信你的话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "别骗人了！乌萨斯......不是没有劝降过感染者。一个接一个的，最后都被处决了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "而我趴在死尸堆里，苟延残喘，最后活了下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你们这些家伙为了消灭我们......做出来的事情有多卑鄙都不稀奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不就是要把我们感染者，赶尽杀绝吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "那就战斗到最后一刻吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "个子很大的小姐，无论你现在说什么，他们可都是听不进去的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "毕竟他们可没法分辨龙门的好人和乌萨斯的恶人啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "在那个地方——不，在很多地方......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "普通人和感染者之间，就是只有互相憎恨而已，没别的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "看来......已经无法交流了。明明出路就摆在眼前。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "出路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......我们，能做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你，又能做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不要和她废话了！碎骨！我们一起干掉他们！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "爆炸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "他打算从各个地方包围我们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "再这样被动下去侧翼会顶不住的......组织反击！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "碎骨！我掩护你！拿下他们战斗就结束了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "碎骨——————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我必须......和你们一起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我必须————！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "————————————",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我们没多少时间了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "星熊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我准备好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "谨慎行动，别在敌人面前暴露弱点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "不会给他们机会的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "小心敌人的冲锋！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "阿米娅！别接近敌人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那，那是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "博士，博士......我该怎么办......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你该做的事，阿米娅。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "可是我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "对不起，博士......我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "阿......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "阿米娅......？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "为什么............",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "会变成这样......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "阿米娅......大概这就是命运吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "阿米娅！你在做什么？快......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "啧......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "陈长官？我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "够了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "还是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "这一切该结束了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......陈长官......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "我需要告诉你一件事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "从现在开始，你最好对所有感染者一视同仁。那些都是你的敌人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "命运是不公的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "要恨，就恨我吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "text": "近卫局！进攻！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
