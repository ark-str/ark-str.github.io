{
  "server": "cn",
  "storyId": "main_3_level_main_03-01_beg",
  "groupId": "main_3",
  "stageId": "main_03-01",
  "title": "会合",
  "storyCode": "3-1",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_03-01_beg.txt",
  "sourceHash": "892310c68041f5b3fae3a7143fd2a56b8ba7ef693708aacabb3a911fca5ccd91",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十三关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "看来你们也不怎么好过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官，究竟发生了什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "整合运动的埋伏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "没有增援，火力猛烈，近卫局的队形很快被他们冲散了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那米莎......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "被一个红衣服的女人劫走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我真该——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "没什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官，米莎身上究竟有什么?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "再继续隐瞒下去，罗德岛与近卫局的合作进程只会越来越艰难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我没有告知你的义务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "但罗德岛有了解目标并做出应对策略的义务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛在行动中会听从近卫局的指挥——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不过，即便是用感染者去对抗感染者，我们也是需要情报的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "近卫局拥有信息，却不懂得如何对抗感染者才能减少损失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛有对抗感染者的能力，却不知道整合运动想要什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你刚才说的话，有点那个医生的味道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是，是嘛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这是因为，这对于我们双方来说都很重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "如果要请示魏先生的话——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我们调查了米莎相关的情报，有一条情报指出，她的父亲是切尔诺伯格的要人之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "米莎的父亲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "当然，我们也不知道，米莎究竟握有多少切尔诺伯格的资料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "可能是零，也可能是一百。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "谁都不会知道有多少——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——除了米莎本人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "而那些切尔诺伯格的信息，究竟含括哪些内容，我们也不清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "既然你们推测整合运动的下一个目标是龙门——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "那么，阻止整合运动对切尔诺伯格的利用是理所应当的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "所以，我们并不想让整合运动得到这名感染者，米莎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "包括“有这样一个感染者随着逃难的人群进入了龙门”这条情报在内——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "在你发现米莎之前，我也并不能确定这几条情报的真实性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这样的话，就不能再拖了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "必须在整合运动回到切尔诺伯格前阻止他们，救回米莎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "罗德岛，立刻进行整备！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "追缉这名感染者，是我们近卫局的任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——同时，让她落入整合运动之手，也是我们的失职。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "比起共同追缉，我们需要罗德岛清除整合运动的其他威胁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "这是命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "交给你了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不，不要！别，别打我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "进入龙门之前难道没想过自己的下场吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊呀呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "全都关起来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "不是这批感染者。该死......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "不是这批。该死......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "他们......撤退的太快了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "看来整合运动也是分层次的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "留下来殿后的这些，都是些用来拖延时间的渣滓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "一个人拖住整个增援部队......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "难道会是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "长官！那边还有残存的整合运动成员！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "跟我来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "陈长官，小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "有埋伏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "去，去死吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "别惹恼我————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "陈长官，我们还在龙门城范围内！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "周围的设施可能还有它用，请不要过度破坏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "要你说！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "至少别再把那些房间切成块了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "可，可恶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "这个女人，很难办！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——难办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "愚蠢的感染者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "龙门难道是个允许你们随便撒野的地方吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "近卫局，进攻！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
