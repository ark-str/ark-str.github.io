{
  "server": "cn",
  "storyId": "act43side_level_act43side_07_beg",
  "groupId": "act43side",
  "stageId": "act43side_07",
  "title": "“血钻”的歌声",
  "storyCode": "AD-7",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act43side/level_act43side_07_beg.txt",
  "sourceHash": "0b1e947ac1224dae9dd0a490ff1271efe8d2c32f49921ef9f9fcf936be83fff7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "这就是*蓝卡坞片场术语*格蕾塔的拍摄计划？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "都贴在源石风暴脸上了！摆明让我们送死啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "不......不......一定是凶手干的！你没听到之前的爆炸声吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "地块的驾驶室被人为炸毁了......我们现在根本没办法改变地块的移动速度和航向......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "现在地块接触的还只是天灾的最外围，真等我们撞向它的正中心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "整个地块估计连一块完整的砖都不会剩下吧......呜呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "好了别说了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "到底是谁？连着死了这么多人，还不够，现在要把所有人的命都搭上？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无线电中的声音",
      "text": "凶、凶手是道具组的莫伊拉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "什么？谁在说话？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "我说！地块上发生的三起凶案，凶手就是莫伊拉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "莫伊拉......天......就是那个不起眼的小札拉克？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "格蕾塔女士亲眼所见！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "要不是有卢西恩先生在，我们的制片人也遇害了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "......那个混蛋在哪里？我要去找她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "你自己的命都要保不住了，找一个丧心病狂的杀人犯理论还有什么用！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "难道她不用付出一点代价吗？如果有不知情的剧组成员又遇害该怎么办！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "你都能想明白的问题，难道我想不到吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "为了保命，我已经把无线电对讲机调成广播模式，真相现在应该已经传到所有人的耳朵里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "凶手绝不敢轻举妄动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "我得保住自己这条值钱的命......等回到蓝卡坞主城区，我就能用这几天收集到的重磅八卦在汐斯塔买套度假别墅了——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "不好！地块又往源石风暴的方向偏移了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "对了，陆行艇！那些陆行艇能救我们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "......没了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的工作人员",
      "text": "你说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "我去紧急逃生舱看过了，所有的陆行艇都已经被源石风暴毁坏了......所有的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "我们已经无路可逃了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "害怕的工作人员",
      "text": "......让我死在风暴里还不如从地块上跳下去呢......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "别说傻话！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摄影助理",
      "text": "快走，哪里都比拍摄区安全，先到地下动力层躲一躲！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "恐怖片的场景设计确实有很多值得参考的地方......谢谢你，蒂比。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "小意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "大致的呈现效果我需要先回去打个样，等到斯蒂芬导演修改完剧本，我们再慢慢敲定细节。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "我答应过您，一定会设计出让“杜邦夫人”留名影史的落幕场景！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "嗯，合作愉快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "（唉，怎么都这个点了？不知道莫丽有没有找到离开地块的方法——）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "什、什么情况？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "不太对劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "等等，米兰妮女士，无线电有声音......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无线电中的声音",
      "text": "......天灾......（杂音）......中控驾驶室......毁......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "信号怎么这么差？这个声音好像是阿布纳的摄影助理？他又在乱传什么八卦——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无线电中的声音",
      "text": "中控驾驶室......炸毁了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无线电中的声音",
      "text": "地块......正冲向天灾......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "无线电中的声音",
      "text": "......凶手......都是莫伊拉......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "蒂比紧握住无线电对讲机，使劲地旋动着音量钮，可是已经没有更多的信息传来了......\n一定是自己听错了，她想。\n可是，米兰妮女士为什么要这样忧郁地看着自己？"
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "不......不可能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "蒂比......没有人会在这个节骨眼开玩笑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "可......莫丽根本没有作案的时间啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "谢莉、迈克尔、玛丽昂遇害的晚上，她都在跟我一起看电影，根本没机会——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "真的没机会吗？\n蒂比在心中质问自己。\n每次看电影莫丽都会陪自己整个晚上，寸步不离吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "因为我们每次都是好几部恐怖片一起看，所以她偶尔会在换碟的时候，稍微离开一会儿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "有时候是说格蕾塔女士有事找她，有时候说要去拍摄现场拿落下的东西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "米兰妮女士，你知道的，她刚当上道具组长，压力很大，对自己的工作很上心很上心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "孩子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "不对不对，这最多只能说她具备犯案的条件，并不能直接证明她就是凶手啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "动机呢？她为什么要杀这些与她毫不相关的人？我为什么什么都不知道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "孩子，或许，你只是没那么了解自己的朋友......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "让我们把注意力放在电影身上......莫丽，你别老是分神！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "抱歉，剧组最近发生的事情太多了，我......我有点紧张......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "有我在你身边啊！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "不管我是什么身份，在这个剧组里，我都是你最好最好的朋友！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "又或许，莫丽她，从来都没把我当成是，朋友......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "她只是想，利用我......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "黎博利女孩把头垂得很低。\n她再也说不出一句话。"
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "米兰妮抱住了眼前小小的黎博利。\n几个小时前还在安慰她的女孩，现在靠在自己的肩头哭泣。\n米兰妮轻抚着女孩的后背，她没有再追问什么，也没有帮对方总结所谓成长的代价，只是抱着她......"
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "至于现在，蒂比，跟我离开这里吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "建筑内复杂的结构太多，如果地块继续靠近天灾中心，这里会变得很危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "我们得赶紧去地下避难，尽管地块不转向的话，其实也无济于事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "地下......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "越过米兰妮的肩头，蒂比看到了她们刚刚从恐怖片中整理出的资料。\n“地下”这个关键词在她的脑海中盘旋。"
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "等等，我明白了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "怎么，这么快就恢复情绪了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "不，我是想到改变地块航向的方法了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "有个剧组曾经为了省掉地块租金，偷偷潜入蓝卡坞另一个地块的地下结构拍摄实景，完成了一部很酷的恐怖片......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "我最近才又看过一遍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "那个地块和我们脚下的这个地块，是蓝卡坞出产的同一批拍摄用地块......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "也就是说，它们的规格和框架是差不多的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "如果我没有猜错......动力层的深处应该有一个备用的机械控制室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米兰妮",
      "text": "......有几成把握？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "说实话......完全没有把握。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "但我必须去做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "有些事情，胡思乱想是得不到答案的。只有等到危机解决之后......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂比",
      "text": "我才能去找她问清楚。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "（温柔的歌声♪）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "（清亮的口哨♪）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "卢西恩先生，你来了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "这是姐姐她最喜欢的歌，拍戏的间隙，她经常望着天空哼着这首歌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "我还以为，你已经清醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我确实已经清醒了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "多亏了你，让我看到了被自己视而不见的真相......它们真是，太残忍了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "那你现在，是在做什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "轰隆隆的声响自脚下传来，这座蓝卡坞地块正向着天灾加速狂奔，人们都在惊慌避险，不会再有工作人员试图来到道具间......\n可恰恰在此时，道具师做起了她的本职工作。\n她在道具间来回穿梭，摆弄着一个又一个道具人偶，为它们穿上衣服，为它们纠正姿势......专注而认真。"
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "就在刚刚，我终于想起自己是怎么认识劳拉的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "容我猜测......你遇见了一个人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "是的，一位很温柔的菲林。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "那天天气很差，我在长椅上坐了很久，我的脸上有水，应该是雨滴，或者眼泪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "明明是那个负责人疏忽导致了事故，可最后，赔光了钱还被赶出剧组的，是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我在蓝卡坞不认识什么人，这样的事情已经经历了很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我是从家乡逃出来的，爸爸妈妈死后，我已经无处可去，只剩下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "然后那个人在旁边坐了下来，我们全程没有说一句话，他只是温柔地等我平复下来......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "他离开之后，我发现自己的膝盖上多了一盘录像带。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "那个人在我看不见任何光亮的时候，将劳拉带进了我的人生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "劳拉成为了我的姐姐，她守护着我、鼓励着我，让我一点点重新振作起来......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "那个时候，劳拉早已死去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "劳拉的出身、经历，甚至长相都与你相似，那个人为你带来了身处绝境所必需的动力......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "也为你带来了愤怒、困惑、刻骨的仇恨和复仇的渴望......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "毫无疑问，那是另一种绝境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "卢西恩先生，你的眼神中闪过了一丝哀伤......不对，是怜悯？也不对......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "更像是一种了然于心，一种感同身受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "在你的身上，发生过类似的事情吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "你认识那个人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "他擅长将一段本不存在的喜怒嫁接进你的人生，就像一个恣意妄为的导演，蛮横地在一个他认为乏味的故事里添加......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "唔，用我新学会的电影术语来说——“飞页”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "他将你拉出绝境，又引导你踏进另一种绝境，由此来激发所谓戏剧的美。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "......他是我的旧识，我的老师，我所有痛苦的根源，一个本应早已死去的幽灵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "找到你，找到他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "我为此而来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "莫伊拉，很遗憾否定了你的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "不。不是这样的，卢西恩先生。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "莫伊拉摆正了最后一个人偶，回到了道具间的正中央。\n她向着卢西恩施了一个礼，轻轻扣了扣指尖。\n卢西恩在一瞬间觉察到了异样，抬眼看去，所有的人偶都“活”了过来——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我不认为你否定了我什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "在我人生最为绝望的时候，劳拉出现在了我的身边，她陪伴我度过漫长时光......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "劳拉就是我的姐姐，我就是劳拉的妹妹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我不后悔为她报仇，我不后悔背负这些罪孽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "而且，我会成为这片大地上最后一个记得她的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我哭、我笑、我愤怒、我疑惑、我憎恨、我悲哀、我怀念......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我因此拥有了，我本无法拥有的一切强烈体会——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我活着。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "人偶们移动了起来。\n卢西恩认出了人偶的原型......那是死去的道尔顿、谢莉、迈克尔和玛丽昂，以及，她自己。\n莫伊拉伸出手臂，与经过自己身边的人偶逐一相挽，错身。\n没有音乐配合，地面也在晃动，但小小的札拉克道具师此刻仿若成为了世间最忘情的舞者，她与万千个人相拥......\n诡异而优雅。"
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "其实我应该感谢你，卢西恩先生，你让我意识到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "“莫伊拉”已经什么都不剩下的时候......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我觉得自己变成了一面镜子，我可以是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "任何人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "清醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卢西恩",
      "text": "因绝望而生的满足，只是毒药。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "我的人生再也没有哪一刻比现在更清醒了，卢西恩先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "你也要，成为我的舞伴吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫伊拉",
      "text": "......像它们一样。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "莫伊拉话音落下的瞬间，她的舞伴们扑向了卢西恩——"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
