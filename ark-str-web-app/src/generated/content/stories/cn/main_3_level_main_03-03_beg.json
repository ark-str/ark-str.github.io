{
  "server": "cn",
  "storyId": "main_3_level_main_03-03_beg",
  "groupId": "main_3",
  "stageId": "main_03-03",
  "title": "回旋",
  "storyCode": "3-3",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_03-03_beg.txt",
  "sourceHash": "3be897a2bfa354f4e51599333cc6bcf977795745e4225755305e69a4f38455e5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "该死——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "敌人只有两个！都给我上啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "有什么好害怕的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我们已经损失了二十几个战士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "那两个混蛋，绝对不是什么普通人......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "小心右边！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "帮我一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "压制住她！我来最后一击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "我暂时还抽不出手对付那个扑过来的家伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "下次可要请我喝冻饮哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "没问题，快点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "那边的整合运动小哥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "这颗子弹是送给你的，请好好收下~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "子弹？子弹是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "咕......噗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哈，替你收拾掉了~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "非常感谢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "可，可恶啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "她，她那把剑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "哦，抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "——我平时，都是用两把的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "额，额啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "这下就全都解决掉啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我们的配合，还真是行云流水呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "......是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "别跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "敌人的大部队赶了过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "看来是被我们闹出的动静吸引了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊啊啊！！！可恶！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "怎么会.....你们，你们究竟，做了什么好事？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "唔，我是和你们无仇无怨啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "但是，合同就是合同哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "履行合同可是物流的基本行业规则呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "左边。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "啊，啊呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "谢，谢谢啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "那我右侧的敌人，就麻烦你解决了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "跑起来吧，该转移了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "能天使，我们快要抵达你们所在的位置了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "现在敌人注意力都在我们俩身上，你们自己看着办！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "两位，注意安全！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "芙兰卡，你们抵达预定地点了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "我ok了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "雷蛇和其余重装干员已经就位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "全体干员注意，敌人的狙击手可能利用了地形来隐蔽自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "一定要注意自己的位置，优先解决狙击手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "接下来......大家，准备突袭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......小心目标，不要太过火了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
