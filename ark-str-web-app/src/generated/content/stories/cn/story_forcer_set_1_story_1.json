{
  "server": "cn",
  "storyId": "story_forcer_set_1_story_1",
  "groupId": "story_forcer_set_1",
  "stageId": null,
  "title": "出行计划",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_forcer_1_1.txt",
  "sourceHash": "50f008611bcaa08b09c4df9c015ca88802400ce66ffc95cda5843ac706f57b2e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "好的......我都记下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "太感谢你了，红豆小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "没什么好谢的，我知道的也不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "你想了解的关于卡兹戴尔的那些问题，我都回答不了......抱歉啊，帮不上什么忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "没这回事，请不要这么说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "红豆小姐愿意教我那些萨卡兹的习俗，就已经是帮了大忙了。多亏红豆小姐，我学到了很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "这没什么......不过我说你啊，在罗德岛的时候这样也就算了，可别以为我们萨卡兹都这么好说话啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "换了卡兹戴尔，那情况就不同了。完全不同！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......嗯，我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "我看你不明白！就连那个好脾气的安德切尔，我们都是在认识了很久之后才说上话的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "但你才加入几天？你第一次接近我的时候，我还以为你是想找茬呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "呃，原来当时红豆小姐是因为这个原因，才表现得那么警惕啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "我这样都算好的了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "唉......总之，你自己多小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "像你现在这样，我真怕你们都走不到卡兹戴尔，路上就要被人宰了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "啊哈哈......为了不出现这样的情况，我会努力的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "不管怎么说，谢谢你为我们担心，红豆小姐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（关于卡兹戴尔的情报还是很不充足。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（态度比较缓和的萨卡兹干员，大多是在其他国家长大，对那里的了解不多。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（不过那里很危险这一点，倒是所有人都一致赞同。唔，只有我跟着塞茜莉亚还是不够保险，不能贸然出发......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（如果维持现在的状态，恐怕很难有更多收获......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（接下来能够接触的还有......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "让让。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "啊，好的，不好意思......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（——不对，这个人是......！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "等等！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "萨卡兹刀术师炎客......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......我在公证所的通缉令上见过你的脸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "一个萨科塔，来寻仇？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "要动手可以，换个地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "先让让，挡到我浇花了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......公证所的前辈们提醒过我，单独遭遇某些通缉令上的人物时，不建议战斗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "而且，这里是罗德岛......我会遵守这里的规矩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "是吗。随你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（这个人......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（没有任何警戒行为，肢体也很放松......他对自己的实力非常有自信。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（他的注意力集中在这里装饰的植物上，甚至完全没有在意我刚刚手已经放在铳上......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（这是一个非常危险的人物，但是......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "炎客先生......可以向你请教一些问题吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "请教？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "你指望我能回答你什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（浇花的动作没有任何停顿......他完全不在意我的说辞，毫不关心，当然，也没有发怒的迹象......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（呼......现在或许就是最好的机会。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "是一些有关卡兹戴尔的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我想要知道那里目前的现实情况，例如周边的城镇规模，进出的人员结构......如果能得到解答，我会非常感激。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "你要去卡兹戴尔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "如果想死，要去也无妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......我没有寻死的打算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我要去卡兹戴尔，我有必须要去的理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "但我很清楚，在现在这样的情况下如果我什么都不准备就出发，那确实和送死没有区别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我不会这么做。这也是我来罗德岛的原因之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "别挡着光。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......莽撞行动，将自己和他人的生命置于危险之中，这不是勇敢，只是单纯的不负责任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "如果能够在行动之前，尽可能多地了解一些当地的真实情况，我就可以据此提前制定计划，做好准备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "虽然还是免不了会有风险，但至少可以尽量想办法规避......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "没必要说这么多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "你的故事与我无关。我对你的想法不感兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "啧，水不够了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "这盆的枝叶也该修剪了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......只有一面长得特别茂盛，可能是受光不均的缘故。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "比起直接把不平衡的部位修剪掉，或许换个方向，让另外一面也晒晒太阳会更好......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "剪掉多余的枝叶，花就开得更好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "给的选项太多，只会迷失重点，植物就是这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "可是......谁能为另一个生命划定生长的重点？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "谁能？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "更强的那一个能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......我不能赞同炎客先生的想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "或许被修剪之后，从外表上看确实能够变得更加美观，长出更美丽、更符合期待的花朵，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "但是一个有自主意识的生命想要如何生长，我认为这件事本身应该是自由的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "萨卡兹刀术师好似漫不经心地发出一个单音。\n在艾泽尔提出种种问题期间，刀术师一次都没有停下手上的动作。\n水壶空了，他便暂时放下，又顺手开始修剪那些生长过盛的枝叶。\n现在，他将园艺剪随手放在被修剪过的盆栽旁边。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "随即刀光划破照射花朵的一寸阳光，艾泽尔后背狠狠撞上墙壁，尖锐的刀锋擦着他的面颊，没入身后的墙壁。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "呃——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "会说漂亮话保不住你的命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "现在呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "你还有自由吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蓉",
      "text": "小红豆，今天怎么来得这么迟？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "抱歉，稍微和人聊了几句，耽搁了一会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蓉",
      "text": "啊......是艾泽尔先生，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "是他。芙蓉你怎么猜到的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蓉",
      "text": "因为就是我推荐他去找你的呀~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蓉",
      "text": "那位萨科塔先生来问过我和小炎熔一些问题，可惜我们都帮不上什么忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎熔",
      "text": "怎么，那个拉特兰的家伙还在到处问人知不知道卡兹戴尔的情报吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎熔",
      "text": "他这么不遮不掩的......到底问了多少人啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎熔",
      "text": "该不会真的打算带着个小孩子去卡兹戴尔吧？他到底知不知道，顶着他们俩冒光的脑袋去找人是件多危险的事情！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "我也觉得这太危险了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红豆",
      "text": "希望他真的能找到什么好方法......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......你们在聊什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蓉",
      "text": "啊，泥岩小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蓉",
      "text": "我们是在聊，关于最近新加入的某位萨科塔先生......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "咳......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "请你......松开......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "为什么不朝要害射击？你的反抗就只有这种程度？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "靠那把玩具一样的铳，你就想去卡兹戴尔？你又能用你的那套理论说服谁？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（这种压迫感......他是真的会动手！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "想要情报，可以找那个血魔医生，或者凯尔希那女人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "有功夫在这问东问西，不如直接去问问你的上级，你们拉特兰有多少任务是围绕卡兹戴尔展开的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "你以为我这把刀下有多少萨科塔的亡魂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......我，咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "感谢忠告......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "但我还是希望......能从各位的口中了解最真实的卡兹戴尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "那现在你该了解了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "只不过是从刀口下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "无聊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "咳......等、等一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "你还没资格让我等，小子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "你......为什么不杀我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "不合适的养分无法令生命正确生长，植物和人都一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "滚吧，小子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "炎客",
      "text": "血不是用来浇花的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（杀气......刚刚，他是真的会杀了我......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（我说的那些......都没有用，这个人对我说的话没有反应......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "（他走时带走了水壶......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "这就是真正的，萨卡兹......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "嘶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "真的不用我替你包扎吗，见行者先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "你还在流血......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "不要紧的，只是皮外伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "那位炎客先生并没有真的对我动手......呃，至少没有直接杀掉我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "好了，这样伤口就没问题了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "接下来我还有点安排，就先告辞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "啊......等等，见行者先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "还有什么事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "虽然罗德岛理论上禁止私斗，但不是所有人都那么守规矩......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "下次遇到类似的情况，如果条件允许，还是直接联系博士或是阿米娅和凯尔希医生她们吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "好的......嗯......我尽量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "最重要的是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "过去曾有过一些经历的萨卡兹干员，在罗德岛内还有很多......对见行者先生来说，与他们碰面会非常危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "请你一定要小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......谢谢你的忠告。我知道我的行动会有很大风险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "但是罗德岛......或许已经是目前我能够接触到的，最好最合适的谈话场所了，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "如果是在其他场合遇见那位炎客先生，恐怕我现在已经没法好好站在这里说话了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "是、是这样没有错啦！可是......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "如果我现在就退缩，去卡兹戴尔这个计划就真的会变成一纸空谈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "这可不行，现在还没有到不得不放弃的那种地步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我还有一个必须要去拜访的人......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "打扰了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "请问......是泥岩小姐吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你认识我......你是特地来找我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "是的，虽然刚见面就这么说非常冒昧，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你身上带着伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "呃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "利器痕迹，伤口很新，是刚添上的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你在来的路上遇到什么人了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......是炎客先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "嗯......怪不得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "就算是在罗德岛，萨科塔也会被警告要避开一些人。一些危险的人，包括炎客，或许也有我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "博士和阿米娅没有和你说过吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "嗯......博士确实劝过我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "但你并没有听。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你在收集卡兹戴尔相关情报的事我已经听说了，还有你要带着那个女孩找人的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......是的。今天我来找泥岩小姐，也是希望得到帮助......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "我不明白......你一定要亲自去的理由是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "只有两个萨科塔，却想要去对你们来说最危险的地方......你应该清楚这很不明智。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我答应了塞茜莉亚，会带她去卡兹戴尔找她的父亲。我不能食言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......如果只是这么说，泥岩小姐肯定不会满意吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "其实算是......一种顺水推舟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我只是个最普通的萨科塔，如果没有意外发生，我大概根本就不会有离开拉特兰这样的念头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "可能就会像其他人一样，稳定地工作生活，不会有物质上的短缺，也没有太多烦恼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "等年纪大了，就申请退休，度过可能吵闹但悠闲平和的晚年时光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......听起来很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "是很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "只是，当我的目光开始落在拉特兰之外，当我开始接触与我的认知不同，可却又无法否认的观点时......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我也只是像所有普通人一样，无法再将这样的生活视为理所当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "塞茜莉亚给了我一个机会，其实是我需要感谢她才对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "去卡兹戴尔，这不仅是我对塞茜莉亚的承诺，也是我自己想要去做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你想要去做的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "很想亲眼看一看卡兹戴尔，还有那里的人的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我会来拜访泥岩小姐，也是因为这样的理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "我......想要了解一直以来和我们相对的萨卡兹，我想弄明白，我们是相同的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "如果我们本该生来相同，那是什么让我们如今生出分歧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你的计划是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "啊哈哈......虽然我很想说已经想好了配套的计划，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "实际上，现在连前期的情报收集都不顺利......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "（叹气）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "不过，虽然还称不上有计划，但我也不是完全没有考虑过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "以我和塞茜莉亚的情况来说，卡兹戴尔确实难以进入，萨科塔的身份让我们非常被动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "但是，如果是从卡兹戴尔走出来的佣兵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你的意思是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "比如说，恰好就像是泥岩小姐这样，出身卡兹戴尔的雇佣兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "在外头赚了点钱回到家乡，还抓到两个萨科塔作为阶下囚，这听起来应该非常合理吧......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "哈哈......这只是我的一点胡思乱想，泥岩小姐不用在意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "在见过炎客先生之后，我意识到我还是把事情想得太简单了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......很合理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "如果你真的下定决心，敢冒险的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你说的这个计划，是合理的，可以尝试。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "你敢试吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "......当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "如果不敢冒险，我们当初就不会离开拉特兰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "见行者",
      "text": "泥岩小姐......这件事，可以拜托你吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
