{
  "server": "cn",
  "storyId": "act20side_level_act20side_02_end",
  "groupId": "act20side",
  "stageId": "act20side_02",
  "title": "下坠",
  "storyCode": "IC-2",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act20side/level_act20side_02_end.txt",
  "sourceHash": "6f397d89d4db50234ab8054e9a7583c99063e560ab97439097f9ace04ae55a08",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "谢谢你，特米米，这份恩情回到罗德岛上我一定会还。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我、我不太擅长望风，但我会努力的！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "好，我先喝一口尝尝！\n嗯，醋栗酒的口感果然够奇怪，但是......"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "极境先生，极境！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "怎、怎么了？我那些朋友们找过来了？你和他们说我可没喝他们对家的酒——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "是斯第奇先生来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "呼，找了你们好久了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "说起来，这家伙怎么会在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "嗨，斯第奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "我们有多少年没见了？真不够意思，你是不是都没来看过我的“大水坑”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "既然你都过来了，要一起玩吗？冲浪区棒极了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "我可以帮你们偷偷把水上滑梯的限流阀打开，让你体验一把真正的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "不了，我赶时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "各位，跟我来吧，既然玩得还算开心，那接下来也该谈正事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "斯第奇，你总是匆匆忙忙，时间还有的是！我们完全可以......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "不，我的“时间”很有限。设计代表卡奇大师身体健康，精力充沛，而我是个矿石病患，可活不了几年。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "啊，抱歉，我不是那个意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "我只是觉得，我们可以好好聊一次，把当年的误会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "听好了，卡奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "如果你想找认同，际崖城的市民已经够热爱你了，不缺我一个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "如果你想找存在感，不如再建点超级大水炮之类的玩意，漆成红色也好，粉色也罢，我不拦着你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "只是别在我这浪费时间了，我永远不可能昧着良心去恭维你那些，哈，“建筑作品”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "该走了，地上人们，我会和你们讲讲我的规划......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "等等，斯第奇，听我说——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "卡奇，我对你的唯一建议就是，躲开我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我们各走各的路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "斯第奇，找机会我们一定要聊聊你刚刚提到的超级大水炮，我很感兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "不过，在此之前......你有没有听见什么声音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "肯定是那帮醉鬼又在犯蠢吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "不对......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "难道是穹顶......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "不可能，请相信我在工程结构上的水平。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "那、那是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "下坠的感觉。\n风从耳边吹过，很吵。\n听说罗德岛有些奇怪的家伙迷恋这种感觉，搞不懂他们。\n至于我？我会从高处往下跳只有一个理由，那就是跳下去才能解决问题。\n用拳头也好、用法杖也好、用斧子也好。\n面对问题，找到坏蛋，然后解决他。没什么难的，不是吗？\n不管即将看见的是什么——\n就算斧子崩了，法杖裂了，拳头再也握不紧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "总之去做就是了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "不管是阴谋也好野兽也好蘑菇也好火雨也好，还是其他什么恶心的东西也好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "我会全都揍趴下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "喂，嘉维尔，好像不太对，前面的是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "喂，我说，差不多该把我放下来了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "啊，抱歉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "......这是个啥？瀑布？滑梯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "呦吼！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "呀，嘉维尔，你怎么才到？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "欢迎来到杜林人的“大水坑”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "哈？？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "呜呜，嘉维尔，我错了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "你呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "所以说，超级怪兽不存在，也没有天上掉下的火雨和遮天蔽日的蘑菇？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "极境先生说，这是一种修辞......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "我一会儿就去揍他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "特米米说的也不算错吧，杜林人的确遇到了某种麻烦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "虽然实在是看不出来，但起码这位斯第奇先生是这么声称的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "......我当然有我的理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "所以说，你们这帮自以为是的地上人又在发什么疯！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "二话不说扛着斧头闯进际崖城，声称什么来帮杜林人的忙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "开什么玩笑，杜林人能自己解决问题，可不需要各位伟大的地上人施以援手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "更何况，你们身上属于地面的肮脏和丑恶，足以玷污这座平静的小城！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "呃，你是鲁珀吧？你不是从地上来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "我已经抛弃了地上的一切。现在的我，只是际崖城的市民罢了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "所以，我现在以际崖城市民的立场要求你们，离开这座城市！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鲁珀",
      "text": "若你们依然冥顽不灵，我不介意用其他的手段驱逐你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "喂，阿芙朵嘉，他们是我喊来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "斯第奇......原来你回来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不管你打算干什么，我以曾是他们一员的立场劝告你，放弃吧。借助地面上的力量只会害了际崖城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "际崖城的市民们从未明白什么是真正的“贪婪与阴谋”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·叙光",
      "text": "阿芙朵嘉，他们已经通过了一场市民表决......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "那我不介意再以一场市民表决否决它。这取决于杜林人的看法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "实在不行的话，要是各位打算用你们地上人最擅长的流血来解决问题，我也奉陪到底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "啧，搞不懂你，在我看来只是一点误会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "听说阿卡胡拉地下的邻居遇上了点麻烦，我们就来帮一把，就这么简单。为了他们，也为了我们自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "哈，挎着把链锯来邻居家帮忙，一定只是来好心地帮我装上桌子腿吧。说不定再用斧子为我削个水果？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "别来这一套，我亲眼见过和善的使者转瞬间就换上一副残忍的面貌，对利益的追求和对掠夺的渴望是地上人的本性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "你们或许能骗得了我善良的杜林同胞们，但你们骗不了我。我太熟悉你们的说辞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "唉，不管你信不信，这斧子只是，呃，用来防身的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "但如果你觉得只有打架才能解决问题，那我会陪你解决。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "喂，那个拿斧头的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "你也太酷了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "嗯？啊......谢谢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的杜林人",
      "text": "阿芙朵嘉，你好棒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的杜林人",
      "text": "平常总看你拿着个本子写写画画，原来你也有这一面啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我不是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "这得有多高？跳下来感觉如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的杜林人",
      "text": "怎么从来没有人想过这个主意？从瀑布的顶上跳下来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "这两人是你的朋友？你这家伙，怎么从没和我们说过你还有这样的朋友！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "她们可能很危险，我们不能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的杜林人",
      "text": "能不能拜托她带我也玩一次？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "阿芙朵嘉，你这次郊游有没有带来些什么新鲜玩意？比如上次的野果！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激动的杜林人",
      "text": "我们已经好几个小时没见了，为了我们的再会，总得喝一杯吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "等等，等等！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的杜林人",
      "text": "姐姐，你叫嘉维尔是吗？我能摸摸你的斧子吗？很重吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "呃，还好吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的杜林人",
      "text": "现在有空吗嘉维尔大姐？“大水坑”有个超好玩的秘密项目！你一定能玩出一个超酷炫的效果！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的杜林人",
      "text": "这是我在际崖城的地址，如果有空的话，明天来参加我们的超级麦酒畅饮派对吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的杜林人",
      "text": "还等什么明天，不如现在我们就开始！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的杜林人",
      "text": "好主意！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "好主意！卡奇老弟，再拿点酒来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "......杜林人怎么回事？被极境传染了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "特米米，你那是什么表情？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉维尔就是嘉维尔，走到哪里都会是人群的中心呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "......唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "在我看来，只是一群傻乎乎的人会跟在一个最傻的家伙身后而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "有的人就是拥有这样的吸引力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "原来她就是阿卡胡拉人经常念叨的那个“无敌的嘉维尔”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "她为什么会从瀑布上跳下来？你们约好的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "......不，大概只是物以类聚罢了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "特米米，我被围住了，来帮我一把！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "来了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "这里太乱了，我们还是换个地方吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "所以，你就是那个杜林人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我在阿卡胡拉的时候可是没少听到他们说起你的名字，嘉维尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "说说吧，际崖城的危机到底是什么，它会怎么影响阿卡胡拉地区？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "这个......说实话，这个话题非常复杂，涉及很多的层面，包括地理学、地质学、社会形态等等领域。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "你可以展开讲讲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "其中最麻烦的是，其实这个问题还涉及了一点点文学的领域......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "......和特米米一样，我也稍微借用了少许修辞的手法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "原来你对我们说的那一套也是夸张过的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "这怎么能算是夸张呢！我只是，呃，看法稍微历史性地宏观了一点点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "在千百万年之后，随着地壳的变化，确实有很大概率，整片雨林会沉入地下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "我可以揍这小鬼吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "请便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "等等，等等呀！但我的确需要你们的帮忙，这件事也的确和际崖城有关！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我们可以从做生意的角度来思考这个问题嘛！你们也看到了，杜林人的技术一定能给你们的雨林派上大用场！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "你的那些阿卡胡拉老乡们以后也不用再抱着几台废弃车床当宝贝了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "嗯，如果真的能派上用场的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我可以保证，以后你们阿卡胡拉人但凡有什么技术问题，我有问必答！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "（小声）哈，只要你们听得懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "你说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我，我说，就算听不懂我也一定尽量解释。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "那我们就直入正题，你到底想要做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "很简单，和我一起说服别人，把之前地震震坏的，连接城外的铁路桥重新打通修好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "这样，际崖城能在不去折腾那座该死穹顶的前提下，重新布置源石勘测装置，我也能从某个唠叨的老头那里解脱出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "还能顺便把某个挡在铁路桥行进路线上的大滑梯炸了，简直是一举两得，不，一举三得！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "斯第奇先生，为什么不能直接修穹顶而要修铁路呢？把那个滑梯炸了多可惜啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "保留那个洞并且造那个“大水坑”可是当时所有人表决通过的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "而且修穹顶牵涉到一系列非常深奥的技术问题，和你们解释也解释不明白的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "为此，我们要重新发动一场投票，来推行我们的计划！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "真不想干啊，我挺喜欢那个滑梯，居然要炸了它......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "你们杜林人的技术那么厉害，为什么还要阿卡胡拉人帮忙修那座桥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "......算了，告诉你们也无妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "我作为提出重修铁路桥这个方案的设计师，如果提案真通过了，负责人肯定也会是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "但是！你们见过铁路桥的图纸吗？那东西我以前上学的时候看到过，完全背离我极致简约的设计理念！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "那些密密麻麻的走线，那些丑陋的骨架结构！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "所以，所有有关桥梁铁道设计的课，我都是睡过去的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "......所以，你根本不会建铁路桥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "虽然很不想承认，但这算是我唯一的短板吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "于是我才请了各位对此颇有造诣的阿卡胡拉人帮忙，把这项重要的工程转包给你们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "怎么样，完美的方案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "杜林人的世界还真是宽容啊，这小鬼居然能顺利长到这么大......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·画布",
      "text": "喂，你什么意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "还好，祖玛玛也来了，修铁路桥的事情她大概能轻松解决......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "嗯？祖玛玛人呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "果然，我没看错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪的机械",
      "text": "......警戒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "......小家伙，过来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪的机械",
      "text": "可疑，危险！准备躲避！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "喂，别跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
