        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "곧 도착해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "text": "응, 박사.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "블레이즈",
          "text": "같이 싸우는 건 오랜만이네!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "샤프",
          "text": "'나쁜 녀석들'호, 복귀 중. 곧 합류하지.",
