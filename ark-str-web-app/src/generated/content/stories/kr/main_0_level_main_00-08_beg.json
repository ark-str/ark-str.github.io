  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "메피스토?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "네가 거부할 이유는 없지 않아? 어쩌다 꼬인 벌레들일 뿐인데… 그걸 왜 네가 쫓는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "네가 가진 정보는 나도 입수했어. 네 할 일은 이미 다 끝났을 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "이제 돌아가도록 해. 네 담당은 중앙의 에너지 구역과 그 바깥쪽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "쓸데없는 짓 하지 마…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "너한텐 아직 다른 할 일이 남았잖아, 안 그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "쳇, 마음대로 하시지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "네가 참패하길 기대하마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "흐음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "철수한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…적의 리더가…… 부대 일부를 데리고 퇴각하는데요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "저 녀석, 대체 무슨 속셈이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "경계를 늦추지 마라… 아직도 적의 숫자는 우리의 배 이상이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "이거 참, 크라운슬레이어가 무례하게 군 건, 내가 대신 사과할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "난, 메피스토라고 불러줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "너희 리유니온의 목적은 대체 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "딱히 없는데? 사실 너희를 놔줘도 상관은 없어. 애초에 너희는 우리 타겟이 아니었거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "우리를 노린 게 아니라면, 어째서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그게, 너희가 싸우는 방식에 흥미가 있거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "너희의 작전도, 인원 배치도, 정말 재미있단 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "…재미있다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "전장에서 벌어지는 전투가…… 재미있다고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "로도스 아일랜드… 너희 자료를 좀 봤는데 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "처음에는 평범한 제약회사라고 생각했거든?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그런데 아무리 봐도 너희 일은 시험관만 늘어놓는 게 아니더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "너희를 여기서 너무 쉽게 보내주면 시시하겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그러니까, 너희랑 게임을 하는 것도 나쁘지 않을 것 같은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "……어린아이 투정에 어울려줄 시간은 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(아미야, 태세를 갖춰라. 강행돌파를 해야 할 수도 있다.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(내가 녀석의 시선을 끌겠다…!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(네, 알겠어요!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "…그건 뭐야? 누구한테 무슨 신호를 보낸 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "네가 상관할 일이 아니다, 꼬맹이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(아미야?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "이런, 다 큰 어른이 돼서 그렇게 예의 없는 말을 쓰면 안 되지. 그런 것도 몰라?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "너 같은 놈들이 날뛰는 세상인데, 이런 말을 쓸 수밖에 없지 않겠나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(아미야, 무슨 일이지?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(도베르만 씨, 퇴로가… 적 부대에 봉쇄당했어요!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(뭐라고! 몇 분밖에 안 지났는데 벌써 놈들이……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "저런 저런, 이러면 곤란하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "성심성의껏 너희를 대접해주고 있는데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "너희는 설마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "……도망치려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "쳇!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "너희가 게임에서 이기면, 여기서 도망치게 해줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "내 친구가 너희를 갈가리 찢어놓고 싶은 모양이거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "살아남기만 하면 너희가 이기는 거야! 어때? 정말 쉽지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "에이스!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "강행 돌파 준비는 끝났다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "하지만 우선은 이 공격을 버텨야 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "왜 이러는 거죠! 재앙이 곧 닥친다고요! 빨리 몸을 피하지 않으면, 다들……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "무슨 소리를 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "재앙이 눈앞에 닥쳤을 때야말로… 축제를 열기 딱 좋은 때잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…당신은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "자, 우리 고귀한 손님들. 너희를 게임에 초대할 수 있어서 정말 영광이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "아… 아…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "주…죽인다!! 죽여버리겠어…네놈들을…!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "아미야, 조심해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "아, 그렇지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "우린 너희가 중심 구역에서 뭘 했는지도 알고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "너희가 중심 구역에서 데려간 계속 얼굴을 가리고 있던 그 녀석… 정말 놀라울 정도로 흥미롭던데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "크라운슬레이어는 너희가 뭘 하는지, 어디로 가는지 궁금한 게 많은가 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "하지만 난 아니거든. 내가 관심 있는 건…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "바로 너라고…… 넌 대체 누구야? 어디에서 온 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그래, 너. 너 말이야… 넌 우리와 뭔가 달라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그 시설에 대체 어떤 장치가 있었길래, 그 목숨을 유지할 수 있었던 걸까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "궁금해. 궁금해 미치겠단 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "나도 그렇게 차가운 사람은 아니거든……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "로도스 아일랜드의 손님들, 인사 겸 선물한다 치고 그 녀석을 나한테 선물로 넘겨줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그럼 내가 좀 손해 보는 느낌이긴 하지만… 너희를 보내줄 수도 있을 것 같거든?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "박사님……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……제 뒤로 물러서세요!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
