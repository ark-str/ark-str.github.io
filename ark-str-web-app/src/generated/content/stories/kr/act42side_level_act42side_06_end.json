{
  "server": "kr",
  "storyId": "act42side_level_act42side_06_end",
  "groupId": "act42side",
  "stageId": "act42side_06",
  "title": "고해",
  "storyCode": "MT-6",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act42side/level_act42side_06_end.txt",
  "sourceHash": "fea32ae49edfb39b20646f9d177b43f8514dbbb9d2964cf1f1269c4c00c34d1f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "허탕 친 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "방 안에 사람의 흔적은 거의 없습니다. 흔들의자, 커피포트, 사격용 과녁 등 교황이 즐겨 쓰던 물건들에는 먼지가 쌓여 있고요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "단말기에 통신 기록이나 특이한 메시지는 없군요, 아직까지 추가 증거는 발견하지 못했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "현재까지의 상황으로 판단해 보면, 교황 이반젤리스타 11세는 이미 실종된 지 보름 정도 된 듯합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "……마음의 준비도 했었고, 한 번밖에 못 만난 사람이긴 하지만, 역시 일이 생겨버리니까 아무래도 조금……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "아르투리아, 설명해 주십시오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "교황님의 행방에 대해 뭔가 알고 계신 겁니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "또 만났네, '라테라노의 사탕 할아버지'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "근데 교황청의 공동 심리는 끝났고, 교황 본인도 내 판결문에 서명했잖아. 일개 죄수가 교황님을 따로 만나서는 안 될 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "생각은 해 봤는가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "그렇게 단도직입적으로 묻는 거야? “밥 먹고 산책하다 보니 이곳까지 오게 되었군” 같은 농담이라도 할 줄 알았는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "내가 '성도'가 되고 싶은지에 대한 건, 로도스 아일랜드에 있을 때 이미 충분히 설명한 것 같은데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "물론이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "그 함선, 마음에 들더군. 함께한 시간이 너무 짧아 아쉬웠지. 그날 밤의 석양과 자네가 연주했던 '라테라노'스럽지 않은 멜로디도 아직 기억해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "그리고 더 많은 증거가 필요하다는 자네의 말도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "자네, 내가 했던 말을 기억하나? “우리가 알고 있는 그 어떤 빛도 어둠처럼 고요해지는 날이 있다.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "후훗, 그건 인상 깊은 말이었지. 흥미로운 표현이었으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "그날이 곧 올 거다…… 물론 내 예감일 뿐이지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "교황은 자신의 머리 위에 있는 광륜을 가리켰다."
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "이게 한동안 쭉 나에게 경고를 보내왔다. 그런데 내 질문엔 더 이상 아무런 대답을 하지 않더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "그게 무슨 뜻이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "다시 말해, 우리의 빛나던 율법이 갑자기 해석되지 않는다는 말이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "난 연주밖에 할 줄 몰라, 교황님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "물론, 율법의 해석은 교황의 일이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "그렇기에 지금 일에 차질이 생긴 건, 내가 방법을 찾을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "그럼 뭘 해달라는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "항상 경계해라…… 정확히 무슨 일이 일어날진 모르기 때문에, 이렇게밖에 알려주는 수밖에 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "신성한 도시 전체의 불이 꺼지거든, 자네가 생각하고 있는 '이해', '감정' 그리고 숨김없는 순수하고 정직한 '교류'를 믿어라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "그때가 되면 자네 같은 이단자는 약이 될 수도, 독이 될 수도 있겠지…… 하지만 상황에 변화를 불러올 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "거절할 이유는 없어 보이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "하지만 라테라노에 이단자는 나뿐만이 아닐 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "물론 다른 성도들과도 접촉할 생각이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이반젤리스타 11세",
      "text": "……아직 늦지 않았길 바랄 뿐.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "그래서 주변에 발생한 일에 대해 빠르게 의심할 수 있었던 거군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "꼭 그런 건 아니야, 페디.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "변주가 없는 마음이라 해도, 만약 덧붙여지거나 빠진 악장이 너무 자연스럽게 녹아들어 있으면 난 그것을 느낄 수 있어. 힐데가르트 수녀가 좋은 예지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "나는 교황이 아직 널 찾아오지도 않았는데 벌써 일이 벌어진 게 더 신경 쓰여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "상황이 너무 복잡합니다. 라테라노 전체가 이해할 수 없는 재이에 빠졌어요. 위치킹의 파빌리온에서 겪었던 일과 똑같이 심각한 상황입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "우리에겐 지원이 필요합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "첼로를 챙겨서 다행이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "선생님?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "대답하는 사람은 없었다.\n반니니가 총기 공방을 한 바퀴 돌았지만, 선생님의 모습은 보이지 않았다. 선생님의 안약이 뚜껑도 닫히지 않은 채 작업대 위에 놓여 있었다."
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "반니, 돌아왔군요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "네, 네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "아까 총기사가 와서 파가니니를 데려갔어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "총기사가 가기 전에 전해달라고 하더군요. 돌아오거든 바로 교황청으로 와서 조사에 협조해 달라고 말이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "반니, 무슨 사고라도 친 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "아무튼 얼른 교황청에 가보세요. 그 총기사, 태도가 썩 좋지는 않았어요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "선생님……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "분명 자신과 엘 언니의 일 때문일 것이다. 어쨌건 선생님을 말려들게 할 수는 없었다."
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "잠깐만, 이건?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "작업대의 구석엔 탄피들이 흩어져 있었다. 그 거침없는 제총사가 대충 던져놓은 것처럼 보였다.\n반니니는 평소처럼 장갑을 끼고 탄피를 정리하기 시작했다. 그러다 문득, 이 탄피들이 오래된 친구처럼 익숙하게 느껴졌다.\n탄피의 표면은 매끄러웠고, 얼마나 만졌는지 문양도 닳아 있었다…… 도대체 어떤 탄피길래 이렇게 될 때까지 만진 것이고, 또 어떤 사람이 평범한 탄피를 이렇게까지 소중히 여긴 걸까?\n반니니는 장갑을 벗었다. 탄피에 아직 남아있는 온기를 느낄 수 있었다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "파……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "*라테라노 비속어*…… 주여! 놀라서 안경까지 떨어뜨렸구나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "드디어 말을 하는구나! 그래, 산크타 중에 4살이나 돼서 말도 못 하고 광륜도 안 생기는 애가 어디에 있겠니?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "그렇군, 내가 꿈꾸고 있는 거였나. 아직 말을 못 하는구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "만약 우연히 널 데려온 게 아니었다면, 이딴 곳은 진작 떠났을 거다. 파트리치온 녀석과 아직도 같은 도시에 살고 있다는 생각만 하면 참을 수가 없다니까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "병원과 성당을 적지 않게 찾아갔지만, 네가 대체 무슨 문제를 달고 태어난 건지 아무도 몰랐단다. 아니면 너희 '주님'이 네게 무슨 불만이라도 있었던 건지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "3년이 지났다. 너도, 나도 광륜이 없어. 네가 무슨 생각을 하는지도 모르겠고, '꼬마 벙어리'한테 익숙해진 탓에 나까지 말수가 줄었지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "됐다. 네가 밤에 몰래 도망치지 않았으니, 여기에서 지내는 게 마음에 든다는 걸로 받아들이마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "더 말을 하진 않겠다. 해봤자 목석처럼 반응도 없으니까, 언젠가 말이 하고 싶어지거든 알아서 방법을 찾아봐라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "반니, 놔라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "갑자기 무슨 스위치라도 켜진 것처럼, 왜 끌어안고 웃다가 울다가 하는 거냐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "평소엔 말을 걸어도 아무런 반응이 없더니, 설마 지금 그동안 하지 못했던 반응을 한꺼번에 하려는 건 아니겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "그리고 네 머리 위에 갑자기 생긴 그 형광등은 또 뭐냐? 의사며 성직자며 3년 동안 온갖 치료를 해도 아무 소용 없더니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "르무엘이라는 아이와 총을 고르자마자 고쳐진 거냐?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "파…… 으음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "쯧, 말은 여전히 못 하는군. 너희 산크타는 말할 때 광륜이 생기는 거 아니었나? 왜, 광륜이 적막을 못 참겠다고 먼저 나오겠다고 했나?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "(선생님의 손을 잡고 세차게 고개를 끄덕인다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "나는 산크타가 아니기 때문에, 너와 그 아이가 수호총으로 어떻게 소통했는지, 이번 일이 네게 얼마나 큰 의미가 있는지는 알 수 없다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "어쨌든, 네가 마음이 없는 사람이 아니라는 걸 알게 되었으니 됐다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "(선생님 얼굴에 난 깃털을 꼭 움켜쥔다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "잠깐, 잠깐! 아파!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "만약 네가 나와 교류하고 싶은 거라면, 방금 같은 격한 표현이 아니더라도 교류할 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파가니니",
      "text": "책상 옆에 앉아라, 똑바로 앉아! 이 탄피들이 보이니? 알려주마……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "저, 저……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "제가 왜…… 말을 하죠? 저는……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "반니니에게 '이해'와 '표현'은 녹슨 창문 같은 것이었다. 그리고 그 창문은 자신과 타인의 모든 연결을 단절시키고 있었다.\n반니니는 말 많은 괴짜 리베리와 3년을 함께 살았지만, 상대가 언제 기쁨과 슬픔을 느끼는지 알지 못했고, 자신의 고뇌와 사랑을 표현할 줄도 몰랐다.\n그녀는 불꽃처럼 붉은 머리카락과 뜨거운 마음을 가진 산크타가 언어가 아닌 방식으로 굳게 닫힌 자신의 마음에 커다란 구멍을 낼 거라고는 생각도 못했다.\n그 뒤로, 선생님은 작은 탄피로 단어를 하나씩 맞춰 완전한 언어로 만들어주었다. 나중에 간단한 문장을 배우게 된 후에도, 그들은 계속 탄피로 소통했다.\n하지만 이제는 가장 복잡한 문장까지 구사할 수 있게 된 게 언제부터였는지, 선생님이 책상에 올려둔 탄피들을 그대로 쓰레기통에 버린 게 몇 번이나 되는지 기억나지 않았다.\n그녀는 선생님이 십여 년간 함께 사용했던 탄피를 어떤 마음으로, 얼마나 만졌을지 상상할 수 없었다. 기억 속 깊숙이 자리 잡은 그 특별한 언어를 왜 더는 이해할 수 없었는지 알 수 없었다.\n눈물이 차올라 앞이 흐려졌지만, 반니니는 그 탄피들이 전하는 메시지를 아주 오랜만에 이해할 수 있었다. 그 메시지는 경고였다!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "안 돼…… 선생님……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "참, 반니. 신경 쓰이는 게 하나 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "그 총기사가 파가니니를 교황청으로 데려가려는 것 같진 않았어요",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 이웃",
      "text": "아마…… 양육 신전으로 가던 것 같더라고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "반니니",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "르무엔 추기경님, 늦어서 죄송합니다. 총기 공방 인수 관련 자료를 정리하고 있었습니다. 워낙 양이 많다 보니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "파트리치온 님이 어째서 여기에?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "아모스 보좌관, 앉게나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "긴장하지 말게. 교황청에서 내린 새로운 명령을 전달하러 온 것뿐이니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "어떤 명령이길래 직접 이곳까지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "교황청이 르무엔 추기경의 모든 업무를 잠시 중단시키기로 했다네. 직무 심사가 끝날 때까지, 자네가 제7청 추기경직을 대행하게 될 걸세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "뭐, 뭐라고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "잘못 들은 게 아니라네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "얼마 전 정체불명의 세력이 제7청 사무실을 습격했다네. 만국 정상회담을 방해하려 했던 용의자인 르무엘이 그 틈을 타 도주했지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "르무엔 추기경은 분명 용의자를 잡을 수 있었음에도 멋대로 풀어줬고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "추가 조사 결과, 앞선 스테보누스 구역 폭발 사건과 양육 신전 피습 사건 때도 비슷한 행동을 했더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "르무엔 추기경은 제7청의 행동 수칙을 중대하게 위반했고, 율법으로 금지된 사항을 어겼어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "하지만, 어째서 저입니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "자네가 결정적인 단서를 제공하지 않았더라면 용의자를 잡지 못했을 거고, 어쩌면 탄생 의식에서 큰 사고가 일어났을지도 모른다네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "아모스, 자네도 제7청에 10년 넘게 있지 않았나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "2달만 지나면, 이제 14년째가 됩니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "자네는 이미 제7청에서 가장 오래된 직원일세. 모든 업무에 익숙한 자네보다 더 적합한 사람은 없지 않겠는가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "어쩌면 자네가 더 중요한 자리에서 능력을 뽐내지 못했던 건, 능력이 부족해서가 아니라 기회가 없어서였을지도 모르겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "젊은이, 자신감을 가지게나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "'젊은이'라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "파트리치온 님, 저는 지금까지 파트리치온 님께서 저를 별로 안 좋아하시는 줄 알았습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "처음으로 아우렐라와 함께 찾아뵀을 때, 당신은 얼굴도 비추지 않았습니다. 아마 막 학교에서 돌아온 피아메타가 저희를 맞이했던 걸로 기억합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "확실히 좋아한다고는 할 수 없었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "아우렐라는 한때 가장 아끼던 제자였네. 장갑 작전과 총기 운용에 천부적인 재능이 있었어. 하지만 성미가 강퍅하고, 일 처리 방식이 극단적이었지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "반대로 자네는 너무 약했다네…… 뭐. 자네들이 한 선택이었겠지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "다시 말하지만, 그날은 갑옷이 망가져서 급히 수리하러 갔기 때문에 집에 없었던 거라네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "게다가, 사적인 감정으로 따지자면 불만은 자네가 더 많지 않겠나? 아무래도 아우렐라를 라테라노에서 추방한 게 나였으니 말일세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "그 일은…… 저 자신을 원망할 뿐입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "파트리치온 님의 말씀이 맞습니다. 저는 너무 약하고, 쓸모없는 놈입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "저는 아우렐라와 함께였으면서도 아우렐라의 증오와 분노를 풀어주지 못했습니다. 그 바람에 아우렐라가 수도원에 수감된 살카즈들을 해치게 된 거고 동포들에게까지 총을 겨누게 된 거죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "아우렐라가 돌이킬 수 없는 큰 잘못을 저지른 뒤……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "파트리치온 님, 저는 아우렐라의 마지막 모습조차 못 봤습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "아무것도, 아무것도 하지 못했습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "그렇다면 지금이라도 자네가 할 수 있는 일이 무엇인지 생각해 보게나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "지금 말입니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "만국 정상회담은 아직 끝나지 않았고, 제7청은 앞으로 할 일이 많이 남았다네. 자네가 추기경직을 임시로 맡는 건 교황청의 결정이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "다 됐군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "무엇이 됐다는 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "인계 심사는 이미 끝났다네. 자네는 이제 추기경의 모든 권한을 사용할 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "잠깐만요. 이, 이렇게 빨리 말입니까? 저, 저는 아직……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "아모스 추기경, 재이가 코앞에 닥쳤으니 라테라노에는 효율이 필요하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "파트리치온",
      "text": "그러니 축하 디저트는 생략하도록 하지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "총기사가 떠난 후 아모스는 의자를 끌어와 앉았다. 단말기를 켜자, 파트리치온의 말대로 권한 로그가 갱신되어 있었다.\n모든 일이 순식간에 벌어진 탓에 적응할 시간이 필요했다…… 그리고 그는 순간적으로 무언가를 생각했다.\n아모스는 파일 보관함으로 들어간 뒤, 아래쪽으로 스크롤 해 화면을 내려 맨 아래에서 원하던 걸 찾았다.\n그는 파일을 열고, 서명란 위에서 손가락을 멈췄다."
    },
    {
      "type": "dialogue",
      "speakerName": "아모스",
      "text": "아우렐라, 드디어……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "제7청 소속 추기경이 된 아모스는 단말기 액정에서 자신의 얼굴에 떠오른 미소를 보았다.\n조금 우습다는 생각이 들었다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 A",
      "text": "으윽…… 여, 여긴……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 B",
      "text": "라테라노잖아. 드디어 돌아온 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 A",
      "text": "아니야, 여긴 뭔가 이상해…… 저, 저 괴상한 그림자의…… 모양을 좀 봐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 B",
      "text": "저것들이 비추고 있는 건…… 저 양육 신전인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 A",
      "text": "말도 안 돼. 라테라노가 변한 거야? 아니면 우리의 뇌가 영구적 손상을 입은 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 B",
      "text": "조심해, 뒤에!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "은총을 받은 생물",
      "text": "(기도 소리)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 A",
      "text": "광륜을 받은 생물이라고? 여기에도?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 B",
      "text": "점점 더 많아지잖아! 멈춰, 가까이 오지 마. 난 이미 광륜이 있다고, 더 필요하지 않아……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 A",
      "text": "잘 쐈어! 저 녀석들, 총알을 피할 줄은 모르는군…… 그럼 무서울 거 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 A",
      "text": "왜 가만히 있는 거야? 길을 뚫어야지…… 왜 그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 B",
      "text": "내, 내가……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산크타 A",
      "text": "너, 타락한 거야……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "우리가 깨어난 게 영향을 미쳤나 봐. 사람들이 하나둘씩 깨어나고 있어. 광륜을 달고 있는 생물도 점점 늘어나고 있고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "저 생물들이 깨어난 사람들을 괴이한 색의 그림자 속으로 끌고 갔고, 함께 사라졌습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "게다가 저 사람들은 반격도 못 했습니다. 저 생물을 쏜 산크타는…… 타락한 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "페디, 아무래도 아까의 농담이 현실이 된 것 같네. 저 녀석들도…… 산크타이자 우리의 동포가 된 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "이질적이고, 혼란스러운 소리야…… 그 속에서 뭘 들어야 하지? 나는 또 뭘 공유해야 하지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "아…… 저 녀석들도 우리의 감정을 알 수 없어 초조해하고 있어. 공유하기를 간절히 원하고 있지만, 서툴게 힘으로 밀어붙여서 실현시킬 수밖에 없는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "마치 광륜이 생기지 않은 갓난아기가 뭔가를 표현하고 싶지만, 울고 보채면서 부모님의 옷자락을 잡아당길 수밖에 없는 거랑 같아…… 저 녀석들은 우리의 동포가 맞아, 단지 너무 서투를 뿐이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "서투르긴 하지만, 압도적인 힘을 갖고 있죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "율법이 갓난아이가 말을 시작하는 시점에 광륜을 주는 이유는, 바로 언어가 이성의 계몽을 뜻하기 때문입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "그리고 이성은 산크타에게 동포와 율법을 책임질 수 있는 능력이 생겼다는 걸 의미합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "근데 율법이 어째서 계몽되지 않은 생물을 '산크타'로 규정하고, 그 생물들이 힘으로 동포들의 운명을 뒤흔들게 만든 걸까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "이상 현상은 계속 심해지고 있습니다. 현재 협력할 수 있는 상대는 박사님뿐입니다. 박사님이 라테라노에 왔다는 건, 지금의 상황을 어느 정도 이해하고 있다는 뜻입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "아르투리아, 박사님이 당신의 연주 소리를 기억할까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "로도스 아일랜드에서 연주한 건 몇 번 안 되는데, 박사는 거의 항상 그 자리에 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "박사가 연주의 대상이 아니었던 건 조금 아쉬웠지만, 항상 집중해서 들어줘서 기뻤지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "text": "첫 마디만이 유효한 정보였습니다, 아르투리아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "하하, 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "그럼 페디, 내가 연주 소리로 박사에게 길을 안내할게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "갑작스러운 통신 알림음이 두 사람의 대화를 끊었다."
    },
    {
      "type": "dialogue",
      "speakerName": "아르투리아",
      "text": "이 시간에 여기로……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "페데리코가 통신을 받았다."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "여보세요…… 들…… 리나?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "나는…… 아우렐라…… 전 시민 번호는…… LC0073458.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "이탈한 산크타들과 전쟁 난민들이…… 현재 라테라노 북부에서…… 3km 떨어진 곳에 있다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
