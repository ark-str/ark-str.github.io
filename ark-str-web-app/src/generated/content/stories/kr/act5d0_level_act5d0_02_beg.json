  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act5d0/level_act5d0_02_beg.txt",
  "sourceHash": "f839386dffa6de714708cfec9299a160453ae70f25ed62441bde2ebce014988c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "콜록, 콜록! 다들 괘안나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "어찌저찌 막아내긴 했어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "재빨랐네, 둘다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아이, 이거 참…… 다들 폭탄 너무 좋아하는 거 아니야? …음?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "————*차마 말로 표현하기 힘든 펭귄의 울부짖음*————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "(와, 와 저라노? 보스가 갑자기 이상한 소리 낸다!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(헐! 방금 그 LP판 상자, 보스가 컬럼비아 암시장에서 진짜 어렵게 구한 애장품이라 그러지 않았어?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "(그런 거 같다. 우짜노 이제… 저래 나라 잃어뿐것 같은 보스 얼굴은 오래만에 보네……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어떡하긴 뭘 어떡…… 아! 저놈들, 차에 타잖아! 저 검은 옷 입은 놈들!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "잠깐만요! 처음부터 함정을 파뒀던 거면 왜 진작에 숨지 않았던 거죠? 너무 이상해요. 우리도 먼저 구체적인 계획을 세우고 난 다음에……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "텍사스!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "타.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "……너희들, 잘 들어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "오늘 밤 나오는 벌금 고지서는 전부 내가 내준다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "저 빌어먹을 잡것들을 내 LP판이랑 함께 묻어주마!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "보인다, 저기 앞에!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "엑시아! 그거 가져와! 늘 쓰던 걸로!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "예썰!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "그건 총 아니에요?! 방아쇠를 어떻게 당기시려고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "하하! 아는 게 많구만. 도련님, 그건 우리의 총기 전문가가 설명해주지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "흐음~ 운수용 골판지 마흔두 장을 공업용 접착제로 빈틈없이 단단히 붙이고, 고품질 고무 밴드가 구동되어 격발… 음… 정말 좋은 총이란 말이지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "……그러니까, 결국 장난감이라는 말이잖아요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "사실은 새총…… 아얏! 아니, 평화의 총이지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "용문 시내에선 실탄은 못 써, 디스 이즈 룰, 오케이?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "항상 느끼는 거지만, 보스는 이럴 때만 규칙을 지킨다니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "우리까지 규칙 안 지켰으면, 용문은 진작에 하늘로 승천. 유노댓? 요 텍사스, 차 지붕 열어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "조심해. 저번처럼 신호등에 부딪히지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "내 키가 그렇게 큰 줄 알어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "여기도 저격 준비 완료야, 보스~!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "자, 잠시만요! 도로에 다른 차들도 있는데 설마 이대로……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "운전하는 마피아",
      "text": "저놈들 총을 쏘잖아! 어이, 반격해라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뒷자리의 마피아",
      "text": "무슨 소리야. 차가 이렇게 흔들리는데 어떻게 조준을 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "운전하는 마피아",
      "text": "너, 너, 총 맞았어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뒷자리의 마피아",
      "text": "피, 피다…… 어서 붕대를…… 아니, 이게 뭐야. 고무?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "운전하는 마피아",
      "text": "고작 고무라고?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뒷자리의 마피아",
      "text": "근데 고무 총알에 유리창이 뚫리고 있다고! 얼른 따돌려. 아, 아파!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "보스, 나이스 샷~!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "절대 놓치지 마, 텍사스!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "속도 올린다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "천천히요. 앞에 화물차 조심…… 우와아아아아아~~~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "꽉 잡아래이. 텍사스 언니야는 차 몰 때 인정사정 안 봐준다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "엑시아, 타이어를 터뜨려!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "오케이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "고무로 타이어를 터뜨린다고요?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "난 한다면 해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "텍사스 씨, 저 사람들 좀 말려주면 안 돼요?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "(절레절레)……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "재밌어 보이는구만 왜? 냅둬뿌라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "자 그럼, 쎄게 한 번 돌려볼까!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "운전하는 마피아",
      "text": "젠장, 핸들이 말을 안 들어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뒷자리의 마피아",
      "text": "쓸데없는 소리 말고 뛰어내려!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "잠깐만요! 속도가 너무 빨라서 우리까지 말려들게 생겼어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "별수 없지, 텍사스! 연쇄 추돌은 네게 맡길게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "쳇, 귀찮게시리.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
