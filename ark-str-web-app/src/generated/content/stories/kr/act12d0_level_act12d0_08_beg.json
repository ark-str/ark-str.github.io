{
  "server": "kr",
  "storyId": "act12d0_level_act12d0_08_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_08",
  "title": "가비알의 주먹",
  "storyCode": "RI-8",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act12d0/level_act12d0_08_beg.txt",
  "sourceHash": "bf76c2f94b91dd08a4f47156599d6542fde8db290f3b3c6a2c8639567102fda8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "text": "여기 건물은 확실히 다른 부락이랑 다르네요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케오베",
      "text": "낡았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "흐음… 여기는 건물도 장식도 다 조잡하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "근데 이상한 기계 잔해가 오만 데 다 널려있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "주마마, 네 부락의 건물은 상당히 특이하구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "다들 너처럼 기계 만지는 걸 좋아하나 봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "이건 모두 우리 부족 사람들의 걸작이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "응, 우리 부족 사람들도 기계의 매력을 느끼게 되었어, 그래서 그 열정으로 부족 건물을 이렇게 지은 거지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스A",
      "text": "봐봐. 가비알이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스B",
      "text": "대족장 말이 진짜였어. 거대하고 못생긴 걸로 가비알이랑 다시 대결하려나 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스C",
      "text": "뭐라고? 놓칠 순 없지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케오베",
      "text": "우와~ 사람 많다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "제전 후에 여기로 모인 다른 부족 사람들이 적지 않아. 이들도 우리 부족에 들어올 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "그래서 뭐, 무슨 말을 하려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "가비알, 네가 그냥 떠났다면 신경을 끄려고 했었다. 다만 이렇게 또 내 앞에 나타났으니, 난 여기서 널 쓰러뜨릴 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "왜지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "넌 너무 강하니까, 가비알.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "가비알, 그날 기억나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "그날?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "그날 이전의 나는 너처럼 내 주먹이 전부라고 굳게 믿었어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "하아압!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "으아앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스 노인",
      "text": "승자, 가비알!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "하하, 내가 또 이겼네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "흥, 다시 덤벼. 다음엔 내가 꼭 이길 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "좋아!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "어? 땅이 왜 흔들리지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "저길 좀 봐!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "저…… 저게 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "철 덩어리가 엄청 크네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스 노인",
      "text": "저건 사르곤의 이동도시인데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "사르곤이 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스 노인",
      "text": "사르곤은 우리가 속한 나라란다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "이동도시는 또 뭐고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스 노인",
      "text": "이동도시는 아주 큰~ 부락이란다. 많은 사람들이 살고 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스 노인",
      "text": "나도 젊었을 때 한 번 가본 적이 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스 노인",
      "text": "무서워하지 말거라. 이쪽으로 오지는 않을 테니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아다크리스 노인",
      "text": "저건 우리와는 평생 아무 관련도 없는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "주마마, 왜 그래? 어디 아파?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "아냐… 나 먼저 갈게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "아, 기억 난다. 사르곤의 이동도시가 마침 우리 근처를 지나갔고, 그날 이후로 네가 이상해졌어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "난 오히려 믿을 수 없었어, 가비알.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "그런 걸 보고 어떻게 놀라지 않을 수 있어? 충격적이지 않아? 내가 보잘것없이 느껴지지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "그날 '와, 정말 크다' 하고 느끼기는 했어. 근데 그게 나랑 무슨 상관인데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "넌 항상 그랬어, 가비알.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "그날 이후로 난 너랑 싸우는 것에 흥미를 잃었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "나는 이남에게 기계에 관한 책을 찾아달라고 부탁해서 사르곤어와 기계 관련 지식을 공부하기 시작했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "그러다 대제사장을 만났고, 함께 거대하고 못생긴 걸 만들기 시작한 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "그건 나도 알아. 내가 널 찾으러도 갔었잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "응? 그러고 보니, 저기 저 이상한 녀석이 네 비밀 친구야?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "그렇다네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "우왓?! 언제 내 옆으로 온 거야?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "왠지… 우리 엠퍼러 보스 같구먼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "엠퍼러? 그 펭귄을 말하는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "맞아, 어라? 우리 보스랑 아는 사이?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "그럼, 알고말고. 수십 년 동안 못 만나기는 했지만 말이야. 아니지, 수십 년인가? 수백 년인가? 에잇… 아무튼 너한테선 그 녀석의 냄새가 나는구먼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "수백 년이라니…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "아이고 마, 여기 보스 친구가 있을 줄은 꿈에도 몰랐네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "정말로 존재했구나. 난 또 주마마의 머리에 무슨 문제가 생겨서 환각을 보는 줄 알고, 로도스 아일랜드에 있을 때 유사한 증상을 연구해보기도 했었는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "허허, 가비알… 너는 모를 게다. 어릴 때 네가 주마마를 찾아왔을 때에도 난 늘 곁에서 보고 있었다…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "이렇게 말이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "사라졌어?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "허허허! 나는 평소에는 너희들 앞에 나타나지 않아. 근데 지금은 이 거대하고 못생긴 걸 조종해야 해서 말이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "그래도 젊은이들과 함께 기계를 만드는 건 정말 재밌구먼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "근데 그 거대하고 못생긴 건 조종하지 않아도 괜찮은 거야? 건물에 부딪힐 것 같은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "뭣이? 깜박했구먼! 나중에 보자구!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "우와… 정말 순식간에 조종석으로 돌아갔네, 대단한데!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "역시 우리 보스랑 똑같네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "아, 너랑 얘기하던 중인 걸 깜박할 뻔했네. 근데 솔직히 주마마, 어차피 결국 싸울 건데 그런 얘기를 할 필요가 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "이건 너한테 하는 말이기도 하지만, 나한테 하는 말이기도 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "가비알, 알아? 나에게 너는 가장 큰 장애물이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "어? 그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "정확히는 네가 아니라 너같은 사람이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "나는 많은 사람들에게 기계의 매력을 알려주려고 했지만, 대부분은 흥미를 느끼지 못했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "너처럼 강한 사람들이 그들에게 본보기가 되고 있기 때문이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "너 같은 존재들 때문에 그들은 이곳에서 싸우면 원하는 걸 얻을 수 있다고 생각하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "너의 강력함이 발전의 길을 막아버렸단 말이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "그래서 나는 사람들의 이런 생각을 깨뜨려야겠다고 결심했어. 더 강력한 힘으로 너의 힘에 대한 사람들의 맹목적인 숭배를 무너뜨릴 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "흐음… 박사, 쟤 말도 일리가 있는 것 같아. 박사 생각은 어때?",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그러네.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "박사, 대체 누구 편이야!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "크루아상",
              "text": "일리가 있긴 한데, 어딘가 좀 이상한 것 같은데……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "기계는 좋은 거지.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "블레이즈",
              "text": "그러게, 저 큰 녀석… 장난 아니게 멋있잖아!",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "근데 솔직히 나도 설득당할 뻔했어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "하지만 나도 사람들의 본보기가 되고 싶은 맘은 없었어. 나는 그저 나를 대표할 뿐이야. 난 주먹이 모든 걸 해결할 수 있다고 생각해. 다른 건 관심 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "알아, 널 탓하는 건 아냐.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "그래도 나는 널 무너뜨릴 거야, 가비알. 이 거대하고 못생긴 것의 힘으로.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "모두들 잘 들어라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "이제 이 거대하고 못생긴 게 가비알과 다시 결투를 벌일 거다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "이 결투로, 누가 진정한 대족장인지 결정 낼 것이다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "대제사장, 전투 준비!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "오! 문제없어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "가비알, 준비 됐냐! 네 동료와 함께 싸워도 상관없어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "난 이미 몸이 근질근질하다고!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "너희는 나서지 마. 이번 싸움은 내가 직접 이 큰 녀석을 물리칠 테니까!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "자, 덤벼라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "우선 정상 출력으로 가볼까!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "발사!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "흥, 두 번째도 맞아줄 거라 기대하지 마라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "호오… 역시 가비알이구먼. 반사신경이 남달라! 그래도 상관없다. 이 거대한 쇠주먹 맛을 봐라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "힘 대결? 바라던 바다!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "대단해, 가비알!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "크루아상",
          "text": "가비알 끝내주네! 혼자서 저 큰놈의 쇠주먹을 막아내삐네!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "우타게",
          "text": "신체검사할 때부터 궁금하긴 했는데, 가비알은 대체 왜 메딕 오퍼레이터인 거야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "……적이긴 해도 정말 박수를 치지 않을 수가 없구나!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "그래도 아직 끝이 아니다! 이런 상황에 대처하기 위해 이 거대 못난이에게는 아직 최대 출력 모드가 남아있다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "간다! 최대 출력 모드!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "뭐라고?!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "우타게",
          "text": "저 큰 녀석의 힘이 더 세진 것 같아!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "블레이즈",
          "text": "가비알의 힘이 밀린다고?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "아아… 이 얼마나 듣기 좋은 소리! ……응? 잠깐, 계기판이 좀 이상한 것 같은데… 에에엣?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "대제사장, 어떻게 된 거야?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "으아아! 엉덩이가 타들어 갈 것 같아!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "거대하고 못생긴 것 말이야!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "아, 말하는 김에 내 상태도 말한 것뿐이다! 엔진 출력이 너무 세서 폭주하기 시작한 것 같네!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "오오오… 짜, 짜릿하구먼!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "우선 나와!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "싸우는 거 아닌가? 이대로 싸워라! 덤벼라, 가비알! 이렇게 널 해치우…",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "대제사장!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "아, 그래. 정말 아쉽군. 전략을 바꿔야겠어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "주마마, 내 걱정은 하지 마라. 내가 최대한 진정시킬 테니, 그동안 이 거대하고 못생긴 걸 멈춰 봐라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "가비알…… 너희와는 상관없는 일이니 너희 먼저 가.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "무슨 말이야? 날 쓰러뜨리려는 거 아니었어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "그럴 거야. 하지만 이런 방법으로는 아니야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "하아, 그렇게 말하지 마. 나도 도와야지. 안 그래, 박사?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "큰 괴물을 쓰러뜨리자! 나도 도울래!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "우타게, 크루아상, 전투 준비!",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "우타게",
              "text": "에엣, 나보고 이 큰 녀석과 싸우라고? 설마…… 너무 귀찮은데.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "크루아상",
              "text": "박사, 끝나고 나면 내 추가 근무 수당 받을끼데이! 세 배로!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "블레이즈",
              "text": "박사, 보고 있지만 말고 지휘 준비해!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "결국 우리가 도와줘야 하네.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "박사의 저런 성격이 가끔 얄밉다니까!",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "어서, 지휘를 준비해줘!",
