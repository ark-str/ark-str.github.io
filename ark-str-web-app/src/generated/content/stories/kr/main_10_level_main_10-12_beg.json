  "sourceHash": "7ae19edb6e5cca340784ebb8442cc4e1a5a970a7938434442dfdd3ac243557e0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "10-beg"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "일반인 열셋, 병사 아홉이 사라진 건가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "로도스 아일랜드……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "정말로 성가신 녀석들이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 전사",
      "text": "장군님, 남은 더블린 병사의 수량도 확인했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "그들에게 다시 한번 기회를 주거라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "협력하겠다고 한다면, 용병 부대에 편입시켜.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "거부한다면…… 어떻게 처리해야 하는지 너도 알 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 전사",
      "text": "네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "훌륭한 전과라고 하긴 어렵군요, 맨프레드 장군님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "……고해신부의 전달자가 아직 떠나지 않았다니.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "저희 대장께서도 섭정왕 못지않게, 이 눈에 띄지 않는 곳의 전황을 걱정하고 계십니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "뱀파이어 생귀나르 역시 마찬가지일 것이라 믿는다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "어젯밤의 그 아낌없는 지원 덕분에 우리 쪽 부담도 많이 줄었으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "그렇군요. 마침, 생귀나르께서 전언을 보내오셨습니다. 이 근처의 공기가 너무 탁하여 오래 머무를 생각이 없다고 하셨죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "지금쯤 어느 공장주의 집을 징용하여 늦은 저녁을 즐기고 계실 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "징용?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "……생귀나르에게 '징용'된 그 집의 주인이 우리 파트너가 아니길 바란다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "중요하십니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "그런 효율이 떨어지는 공장은 우리에게 자원을 얼마 공급하지 못하죠. 오히려 내버려 두면 벌레만 생길 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "생귀나르의 인내심도 다음 날 밤이 찾아올 때까지 입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "만일 장군께서 생귀나르께 만족할 만한 연회를 열어주지 못하신다면, 그분은 자신만의 방법으로 이 더러운 거리를 '청소'하실 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "그건 생귀나르의 뜻인가, 아니면 군사위원회의 결정인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "장군께서는 늘 이런 사소한 일들을 세세하게 따지시는군요. 그 때문에 이런 좁은 곳에 묶여 있는 게 아닌가 싶습니다만, 전하께서는 장군께 더욱 큰 기대를 하고 계십니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "……생귀나르에게 전해. 어젯밤 지원에 매우 감사하며, 우리도 즉시 다음 작전을 실행할 것이라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고해신부의 직속 위병",
      "text": "다행이군요. 그럼 기대하고 있도록 하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "왕정 사람을 상대하는 게 전장보다 더 피곤한 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "여기 숨어 있었나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그렇다고 게으름 피운 게 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "그 잃을 뻔했던 팔은 내려놓도록. 말해 봐, 그 팔은 옛 지인이 터뜨린 건가, 아니면 또 다른 옛 친구에게 베인 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "글쎄, 너무 아파서 기억이 잘 나지 않네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "뭐, 그래도 다른 팔로 검을 쓸 수 있는 걸 보니, 그들이 체면을 좀 봐준 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "곧 날이 밝는다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……그러게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "벽에 그만 기대. 브레이크 타임도 끝이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "용병은 쉴 자격도 없다 이건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "가 봐. 전쟁은 아직 끝나지 않았다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "부상자는 얼마지? 당장 치료하러 데려가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "저도 도울게요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "그래, 고맙군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "하모를 불러줘. 아무래도 계획보다 빨리 철수해야 할 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "그리고…… 전달자를 도시 밖으로 내보내. 최악의 상황이 닥친다면, 대부분 인원을 도시 밖으로 내보낼 준비를 해야 하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자경단 전사",
      "text": "네, 지휘관님!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "시즈 씨……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "시즈 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "아…… 미안. 당신의 목소리를 들으면 자꾸 멍해지네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "피곤해서 그럴 거야. 우리 전사들도 많이 지쳤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "난 괜찮아. 걱정해 줘서 고마워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "시즈 씨가 가져온 정보…… 그러니까 6팀 전사들이 무시무시한 오리지늄 아츠에 죽임을 당했다는 정보는 우리한테 매우 중요해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "내가 더 일찍 가지 못했다는 게 안타깝네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "아니야. 그랬다면 당신도 위험해졌을 테지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "당신은 충분히 잘해줬어. 당신이 빠르게 움직이지 않았다면, 6팀뿐만 아니라 다른 전사들도 위험에 빠졌을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "도대체 누구일까? 살카즈 병사들이 생귀나르라고 부르던데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "……석 달 전, 런디니움 북부에서 귀족 연회가 열렸어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "연회는 떠들썩하게 시작했고, 불빛은 밤새도록 켜져 있었지. 그리고 다음 날, 청소하러 간 하인이 문을 열었을 때, 연회장에는 턴테이블에서 흘러나온 소리만 맴돌았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "다른 사람들은, 모두 죽은 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "거의 대부분 동시에 죽은 것 같아. 죽음이 찾아온 순간, 많은 사람들은 심지어 잔을 든 자세 그대로였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "죽은 사람 중에 몇은 우리와 연락하던 사이였어. 하이디도 아는 사람들이고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "하이디",
      "text": "그렇습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "하이디",
      "text": "그 연회에서 저는 옛 친구 여러 명을 잃었고, 자경단도 한 구역 전체의 정보 루트가 끊겼죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "우리가 성벽 끝으로 물러날 수밖에 없었던…… 이유가 있었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "그래도 하이디의 꾸준한 노력 덕분에 우리는 힘을 키울 수 있었어. 얼마 지나지 않으면, 살카즈와 정면으로 맞설 기회도 찾아올 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "하지만 그 전에…… 우리는 그 무시무시한 살카즈를 피해 무사히 철수할 수 있어야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "아미야, 혹시 그게 누구인지 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "제 생각이 맞다면, 지금 저희 머리 꼭대기에서 움직이고 있는 건 아마도…… 뱀파이어일 거예요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "……어렵다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "얼마나 어려운데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "솔직히, 이 조각들을 다시 붙이는 것보다 처음부터 다시 만드는 게 쉬울걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "재료가 없잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "설마?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "여기는 런디니움이야. 절대다수의 공업 부품들은 살카즈가 통제하고 있다고. 운 좋게 쓸만한 폐품을 찾는 것도 이젠 힘들고, 그걸로 전장에서 쓸모도 없는 장난감을 만든다는 건 더 무리야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "너희들 작업 환경이 너무……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "궁상맞다고? 대놓고 말해도 돼. 어차피 지휘관도 여기 없는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "……크흠, 도전 욕구를 자극한다고 말하고 싶었을 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "클로저 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "그…… 그거 알아? 아까 도전 욕구라 말할 때, 너의 두 눈이…… '물리적'으로 반짝였거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "어? 그래? 내가 너무 흥분했나 봐…… 왜, 무서웠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "아니…… 괜찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "솔직히 너를 알고 나서야…… 뭐랄까, 살카즈는 그저 싸움밖에 모르는 게 아니라는 걸 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "오…… 오, 그렇지. 물론 싸울 줄 모르는 살카즈도 있어, 예를 들면 나처럼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "뭐, 물론, 나도 뱀파이어니까 어느 정도 쓸만한 재능은 있단 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "우와! 무무무무…… 무슨 속도가 이래? 내 일주일 작업량을 하룻밤 만에 다 끝냈잖아!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "당연하지. 로도스 아일랜드 기둥이 되는 게 그리 쉬운 줄 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "내 눈을 봐. 로도스 아일랜드 함선의 모두가 뱀파이어였다면, 야간작업도 걱정할 필요 없어. 게다가 전기세도 반이나 줄일 수 있고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "뱀파이어 중에…… 엔지니어들이 많나 봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "설마 그럴 리가! 뱀파이어는…… 뱀파이어는 모두……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "왜 그래, 갑자기 떨고 있는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "다 런디니움 때문이야. 이런 사악의 소굴에 가까워진 공포는 나도 오랜만에 느껴…… 봐봐, 내 자랑스러운 손이 다 굳어버렸잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피스트",
      "text": "설마, 6팀이 만났다는 게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "그렇지 않기를 빌어야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "만약 그렇다면…… 너희들에게 매우 진지하게 경고할 수밖에 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "만약에…… 만약에 정말로 다른 뱀파이어를 만나게 된다면, 일단 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "아니다, 마주친 순간에 이미 도망칠 기회조차 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "너희들은 영원히……\n뱀파이어를 만나지 않기를 바란다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "모건, 인드라와 함께 자경단의 철수를 도와줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "나도 곧 따라갈게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "비나.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "박사?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "날…… 찾아온 거야?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "다그다에 대해 이야기 나누려고.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "다그다는…… 자신의 선택을 했을 뿐이야.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "내가…… 내가 걔네들의 리더가 될 수밖에 없다고 해도, 어떻게 해야만 가장 적절한지 계속 고민하고 있었어.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "그리고 로도스 아일랜드에서는 네가 하는 방식을 보게 됐지.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "좀 어때?",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "괜찮아…… 그냥, 다그다가 걱정될 뿐이야.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "지금 네가 날 걱정하는 것처럼 말이야. 이건 우리가 짊어져야 할 책임이잖아.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "다그다는…… 나랑 처지가 아주 비슷해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "내 곁에 있는 매 순간마다 걔는 책임에 얽매여 있지. 몇 번이나 선택하라 해도, 다그다는 다른 결과를 택하려 하지 않아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "우리에게 진정한 선택의 여지가 있어야만, 비로소 진실한 선택의 권리를 갖게 되는 거야. 그게 아니라면, 그저 형태가 바뀐 강요가 될 뿐이지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "나는 다그다가 누군가에 떠밀리면서 살아가는 걸 원치 않아. 걔가 자신의 마음을 받아들이고 스스로 장래의 길을 다졌으면 좋겠어.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "너의 선택은?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "지금처럼 평범한 전사로 남아도 돼.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "그들에게 네 신분을 밝혀도 돼.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "어떤 선택을 하든, 나와 로도스 아일랜드는 네 선택을 존중한다.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "평범한 전사가 되는 게 어쩌면 더 쉬운 일일지도 몰라.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "하지만 내 성씨는…… 너희들이 날 어떻게 불러도 내 성씨만큼은 부정할 수 없어. 이건 내가 타고난 것이니까.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "내가 털어놓을 진실에 놀라지 않기를 바란다, 박사.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "닥터 켈시가 대신해 말해줄 수 있다고 했지만, 역시 내가 직접 말하고 싶어.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "성씨가…… 빅토리아?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "그 표정…… 상당히 침착한데.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "과거를 잊어버려서일지도 몰라.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "……과거를 잊어버렸다고?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "분명 그것 때문에 네가 큰 고통을 겪고 있겠지만…… 난 가끔 과거를 기억하지 못한다면 더 편하게 살아갈 수 있지 않을까 싶어.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "현재에만 관심이 있어서일지도 몰라.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "그렇지…… 가장 중요한 건 언제나 지금이니까.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "빅토리아를 떠나기로 결심했을 때, 내가 가장 원했던 건 지금, 이 순간에도 나와 걔네들이 모두 살아 있는 것뿐이었어.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "미래를 바라보고 있어서일지도 몰라.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "미래인가……",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "나의 미래는…… 어디로 향하고 있을까?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "시즈",
              "text": "이 물음은 나밖에 대답할 수 없네. 누구도 답을 알려줄 수 없어.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "후우…… 너랑 함께 있으면 금방 이렇게 긴장이 풀린다니까……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "어쩌면…… 나의 숨겨왔던 진실을 알게 된 이 순간에도, 너는 여전히 오퍼레이터 '시즈'로 나를 바라봐서 그럴지도 모르겠네……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "빅토리아…… 가 아니라.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "런디니움에 돌아온 후로 많은 추억이 떠올랐어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "그와 동시에 런디니움이 많이 변했다는 걸 깨달았지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "내가 내린 모든 결정은, 이제 더 이상 우리 팀에만 국한된 게 아니야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "박사…… 나는 '선택'이 나를 망설이게 하는 변명이 되지 않았으면 좋겠어.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "모든 선택이 우리를 오늘까지 이끈 거다.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "모든 선택이 나아갈 방향을 정하는 거다.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "내가 갈 길을 반드시 찾을 거라고 말해준 사람이 있다.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "비나, 너에게도 이 말을 해주고 싶다.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "시즈",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "너에게는 언제나 선택할 권리가 있다.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……하이디 씨.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "아미야? 저는 지금 부상자를 돌보는 중이에요……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "하이디 씨는…… 치료도 할 줄 알아요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "간단한 간호 정도죠.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "이런 일을 하다 보면 언제 위급한 상황이 닥칠지 모르니까요. 저와 친구들의 생존 기회를 늘리기 위해서라도, 구급상자의 사용법 정도는 배워 둬야 했던 거예요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "대단하네요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "저희가 하는 일은 우리의 터전을 지키는 것뿐이죠. 하지만 켈시…… 그리고 당신, 아미야, 당신들은 더 막중한 책임을 짊어지고 있잖아요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……이번 작전에서 저희도 많은 사람을 잃었어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "저…… 저는 자경단 전사들의 고통이 느껴집니다. 지금까지 상대해 왔던 적들은 이렇게까지 두렵지는 않았지요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "그 뱀파이어 생귀나르…… 그가 여기에 온 게, 혹시 우리가 런디니움에 나타났기 때문일까요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "아미야, 당신에게 필요한 건 부정적인 답이 아니군요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "네……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "클로비시아 씨는 저와 로도스 아일랜드가 자경단을 그들과 무관한 싸움에 끌어드릴까 걱정하고 있어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "만약 협력이 그들에게 더 큰 위험을 초래한다면……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "만약, 어젯밤의 작전에 로도스 아일랜드가 없었다면 어떻게 됐을까요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "W의 지원이 없었다면, 그가 용병 대장을 막아주지 못했다면…… 그리고 맨프레드를 견제하는 다른 로도스 아일랜드의 오퍼레이터가 없었다면, 저희는 지금 이렇게 대화할 기회조차 없었을 거예요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "한 사람의 목숨으로 다른 사람의 목숨을 교환한다는 건, 물론 로도스 아일랜드에서는 성립되지 않겠지만……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "하이디",
          "text": "켈시가 이자리에 있었다 하더라도, 분명 기회는 언제나 위험이 따른다고 말했을 거예요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "알겠습니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "그게 저희가 더 많은 준비를 해야 하는 이유이기도 하죠.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "하이디 씨, 도시 내의 정보가 더 필요해요. 뱀파이어 생귀나르 말고도, 다른 왕들이 런디니움에 있나요?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "혼",
          "text": "죄송하지만, 빵 한 봉지 주세요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "런디니움 시민",
          "text": "아가씨, 돈은 필요 없어요. 이 빵을 다 가져가세요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "혼",
          "text": "네?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "런디니움 시민",
          "text": "그리고 빨리 가세요. 다시는 거리에 나타나지 않는 편이 좋아요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "혼",
          "text": "그게 무슨……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "런디니움 시민",
          "text": "당신들이 누구인지 저는 알아요. 사실, 우리는 모두 알고 있어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "런디니움 시민",
          "text": "장비를 벗고 옷을 갈아입었다고 해도, 그 눈빛과 몸짓은 속일 수 없죠.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "혼",
          "text": "……감사합니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "런디니움 시민",
          "text": "저도 얼른 집에 돌아가야겠어요. 오늘은 장사하기 힘들 것 같아요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "이 거리를 싹 다 뒤져! 이 명단에 있는 사람들을 전부 포박해!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "런디니움 시민",
          "text": "무, 무슨 짓입니까? 저는…… 저는 그저 식당을 운영할 뿐입니다. 전에 여기서 린수 튀김도 드셨잖습니까……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "그러니까 잡아가는 거다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "잘도 숨겼더구나! 낮에는 린수 튀김을 팔고, 저녁에는 저항군에게 정보를 넘겼다면서?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "데려가! 그리고 옆에 시계방 사장도 마찬가지다. 이들은 전부 저항군이야!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "혼",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "혼",
          "text": "살카즈가 왜 갑자기 사람들을 잡아들이는 거지?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "빠, 빨리 가자. 앞에 골목으로 들어가 다른 사람들에게……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "으아악!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "이 녀석도 처리했다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "너희, 골목으로 쫓아가. 다른 구역으로 도망치려는 놈들, 모조리 잡아 와.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "보고입니다. 저희가 나오자마자 살카즈를 마주쳤습니다……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "아니요, 도시를 나가는 길을 지키는 게 아니라, 갑자기 길거리에 나타났습니다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "지휘관님, 설마 저희 통신이 도청된 건가요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "조심하시기 바랍니다…… 도시 밖으로 파견한 전사들은 전부 사망했습니다…… 저도 이제 숨을 곳이 없습니다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "저는……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "빌어먹을, 어떻게 해도 따돌릴 수 없는데?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "살카즈가 갑자기 우리의 지상 행동 노선을 전부 파악한 것 같은데!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "겨우…… 겨우 하룻밤 사이에……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "도대체 어젯밤에 무슨 일이 있었던 거지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "하하, 너희들이 그걸 알아낼 기회는 없을 거다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "살카즈 용병",
          "text": "으응? 누구냐? 왜 내 칼이 부러져 있는 거지?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "자경단 전사",
          "text": "당신 그 옷차림은…… 로도스 아일랜드의 오퍼레이터군요? 감사합니다…… 또 로도스 아일랜드의 도움을 받았네요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "미저리",
          "text": "빨리 돌아가.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "미저리",
          "text": "잠깐, 박사와 아미야에게 전해. 지하도 안전하지 않아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "미저리",
          "text": "어제 우리가 마주쳤던 함정…… 그게 다가 아니다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
