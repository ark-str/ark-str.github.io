  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act15d0/level_act15d0_02_end.txt",
  "sourceHash": "f2791c1de47f795c38b3f336d2e15871c6b1029fe608ff5b66cbbb48d5fa8594",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "아야야야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "조금만 참으면, 괜찮아질 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "으아아아아아악!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "누가 소리 지르는 거야! 시끄러워 죽겠네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "다쳤으면 영안실에나 들어가 있어, 여기에서 소리 지르지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "죄송해요, 그쪽은 지금 줄이 너무 길어서요. 제가 응급 처치를 좀 해주면, 금방 나아질 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "영안실? 의무실을 말하는 거겠지? 그런데 왜 영안실이라고 부르는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "아, 여긴 의무실과 영안실이 연결되어 있거든. 게다가 의사와 장의사도 한 사람뿐이고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그 사람은 워낙 이상해 보여서, 사실 우리도 별다른 일 없으면 그쪽으론 잘 안 가려고 해. 교도관은 말할 것도 없고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "싸우다 다치면 어쩔 수 없이 그곳에서 치료를 받을 뿐이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그런 상황이 오래 지속되다 보니 영안실이라 부르게 된 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "도울 일 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "헉! 돔마 씨, 여긴 어쩐 일로?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "아, 방금 한 소리는 전부 헛소리였어요, 그게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "괜찮아, 별로 신경 쓰지 않으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "그보다, 의무실 안 와봐도 되겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "아, 아뇨. 이 아가씨가 제게 붕대를 감아주었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "응, 나한테 맡겨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "……붕대 감는 솜씨가 제법이네, 그럼 부탁할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "응.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "휴우……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "그 여자가 무서운 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "무섭다……고 할 정도는 아니야, 어쨌든 돔마 씨는 여러 사람을 구했으니까. 하지만 워낙 괴상한 사람이다 보니까, 그냥 단순히 다가가기 싫을 뿐이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "그렇구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "이제 됐어, 팔을 좀 움직여봐.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "후우…… 이제 많이 좋아졌어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "정말 신통한 방법이네, 로빈, 전엔 무슨 일을 했었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "난 예전에…… 민간 보안업체에서 일했었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "민간 보안업체? 거기 돈 많이 벌지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "게다가 넌 성격도 좋은데, 너 같은 사람이 어떤 이유로 죄를 짓고 감옥에 들어왔는지 상상조차 안 되는걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "…… 아버지께서 실직하시고 바로 쓰러지신 뒤로는 술에 절어 사셨고, 결국 간에 문제가 생겼어. 의료비가 워낙 많이 들다 보니 난 위험을 무릅쓸 수밖에 없……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그랬구나, 쯧쯧, 너도 힘들었겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "당신은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "나? 난 장사를 했었지. 그런데 마누라가 바람이 나선 내연남이랑 같이 내 재산을 꿀꺽하려고 하는 거야! 그래서 내가 때려죽였지, 그게 다야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "어쨌든, 네겐 빚을 한 번 진 셈이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "나도 여기서 썩은 지 벌써 몇 년이 됐거든, 이곳 일이라면 어느 정도 알고 있어. 궁금한 게 있으면 뭐든 물어봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "평소에 A 구역이나 B 구역에 있는 사람들 몇몇이 C 구역의 탑으로 들어가는 걸 봤는데, 어떻게 들어간 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "응? 아, 그 사람들 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그 사람들은 C 구역의 두목들 방을 청소해 주기 위해 잡혀간 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "방을 청소한다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그래, 사실 여긴 교도관을 제외하면 직원이 아주 적거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "관청 감옥이라 처우도 나쁜 편이 아니지만, 감옥에서, 그것도 종일 황야를 달리는 이런 이동 감옥에서 일하길 원하는 사람은 없으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "보통 감옥에서 뭔가를 하려면, 도시에 정박해 있는 동안 그 도시에서 사람을 고용해 일을 마무리하는 편이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "일을 다 끝내지 못하면 그들을 데리고 갔다가, 일이 끝나면 사람을 시켜 그들을 되돌려 보내거나 다음 도시에 데려다 돌려보내지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "지난번에 생 소피 시티에 정박했을 때 인테리어 공사를 한다고 사람들을 고용했었는데, 생 소피 시티를 떠난 지 벌써 보름이 지났는데 아직도 일을 다 못 끝내고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "아, 여기저기 돌아다니는 직원들은 감옥 직원이 아니었구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "맞아, 저길 봐봐.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "(속닥속닥)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(속닥속닥)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "미나 씨, 여긴 어쩐 일이시죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아, 죄송해요. 화장실을 찾다 길을 잘못 들었네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "아, 괜찮습니다. 대장님께서 중요한 장소만 아니면 마음대로 다니셔도 된다고 하셨습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "너! 볼일 없으면 방으로 돌아가! 거기 서 있지 말고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "네~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "봐, 저 사람들은 감옥의 직원은 아니지만 높은 사람대접을 받고 있어. 교도소장이 저 사람들에게 좋은 음식을 대접하라고 명령한 적이 있거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그래서 제멋대로 구는 게 익숙한 교도관들이 저 사람들을 보곤 변비 걸린 것처럼 구는 모습을 보면, 그게 또 그렇게 시원하더라고, 하하.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "쯧, 너희 둘은 왜 아직도 여기 있는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "헤헤, 교도관님, 신입 교육 중이었습니다. 좀 봐주십쇼.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "흥, 5분 더 준다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "그걸 어떻게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "헤헤, 이곳에 오래 있다 보면, 항상 뭔갈 손에 넣을 수 있게 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "네가 원한다면, 네게 좀 줄 수도 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "괜찮아, 그것보다, C 구역에 들어간 죄수는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "뭐, 어쨌든 여긴 직원이 거의 없어. 하지만 청소는 누군가는 해야 하는 일이고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "너 설마 교도관들이 직접 일을 할 거라 생각하는 건 아니지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "그래서 그 사람들이 잡혀가서 청소를 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "C 구역뿐만 아니라 다른 곳도 마찬가지야. 감옥 전체를 우리 죄수들이 청소해야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "근데 사실, 그게 또 나름 꿀 보직이거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "공장에서 일하지 않아도 되고, 이곳저곳을 구경할 수 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "심지어 교도관만 갈 수 있는 복도에서 풍경을 감상할 수 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "복도?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "아, 넌 모르겠네. 2층에 복도가 하나 있는데, 직원들만 갈 수 있어. 그곳에선 바깥 풍경 전체를 볼 수 있고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "나도 한 번 가봤는데, 정말 좋더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "근데 여기 교도관은 정말 밉상이란 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그때 날 감시하던 교도관이 죄수들을 위해 세워놓은 것이라고 말하면서, 밖에 있는 비석 하나를 가리켰거든?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그래서 “저건 누굴 위해 세운 거냐”고 물었더니, '탈옥'한 죄수들을 위해 세운 거라 그러더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "여기엔 정말 자신의 능력으로 도망친 사람도 있고, 또 어떤 사람은 고의로 타인에 의해 내쫓긴 경우도 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "왜냐하면, 그 사람들 모두 마지막엔 황야에서 죽었으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……도시에 정박해 있을 때는 탈옥할 수 없나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "봐봐, 너도 할 수 있는 생각인데, 다른 사람이라고 생각을 못 했겠어? 매번 도시에 정박할 때마다 모든 교도관은 정신을 바짝 차리게 되지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "여긴 앤소니 같은 사람도 도망갈 수 없는 곳이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "앤소니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "사실 그 사람은 전혀 도망갈 필요가 없지만 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "앤소니는 죄수지만, 이곳에선 그 사람을 존경하지 않는 사람이 없을걸, 교도관조차도 그 사람이랑 이야기할 때면 숨도 제대로 못 쉴 정돈데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "게다가 앤소니는 거칠게 난동 피는 스타일도 아니야. 순전히 실력과 위신으로 그 자리에 서게 된 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "지하에 있는 도서관도 앤소니가 교도소장한테 제안하여 세운 거란 거 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "그렇게 대단하다니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "이 이야기는 다른 데 가서 절대 하면 안 된다? 사실 우리끼리는 앤소니가 이 감옥에 계속 있다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "교도소장은 없어도 될 거라고 생각하고 있어, 그야말로 이 감옥의 주인인 셈이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "그런데 참 이상하단 말이야. 앤소니 같은 사람이 어쩌다 감옥에 들어온 걸까, 그리고 이렇게 오래 있는데도 왜 아무 일도 일어나지 않는 걸까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "너희 둘, 대화 시간이 너무 길다. 어서 각자 방으로 돌아가도록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "네, 금방 갑니다, 금방이요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "상처는 괜찮나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "네? 괜찮습니다, 괜찮아요. 로빈이 붕대를 잘 감아줘서 많이 좋아졌습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "근데 뭘 꾸물대고 있어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(방금 저 사람, 날 힐끗 쳐다본 것 같아……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "아니, 저 교도관이 내게 관심을 보이다니, 정말 귀신이 곡할 노릇이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "오늘 이야기는 여기까지 하는 거로 하자, 무슨 일 있으면 나 있는 데로 찾아오고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "알겠어, 고마워.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "아버지…… 앤소니는 듣던 것보다 더 까다로울 것 같아.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "누구?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "오늘, 큰돈을 받았지 않나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "당신이 바로 '관대한 J'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "네, 맞아요. 그 돈으로 당신 아버지를 치료하도록 하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "물론, 그 돈을 당신 인생을 바꾸는 데 사용해도 상관없습니다. 아니, 난 개인적으론 그 방법을 더 추천합니다만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……왜 나에게 돈을?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "난 아주 제너러스한, 관대한 사람이니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "하지만 당신 아버지를 치료하는 데 사용한다면, 그 돈으로는 아마 부족할 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "…… 내가 뭘 하길 바라는 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아주 똑똑하군요, 로빈 씨. 난 똑똑한 사람과 소통하는 걸 좋아한답니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그럼 나도 허심탄회하게 이야기하죠, 난 당신이 필요해요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "맨스필드 형무소에 들어가 사람 한 명을 죽여주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "맨스필드? 그, 들어가면 나올 수 없다는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "걱정하지 마세요, 당신이 일만 성사시킨다면 당신을 나오게 할 방법은 있으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "잘 생각해 보세요, 로빈 씨.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "이번 일이 아주 위험하단 걸 잘 알아, 좋지 않은 일이란 것도 알고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "하지만…… 아버지의 병을 위해 나, 최선을 다할 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
