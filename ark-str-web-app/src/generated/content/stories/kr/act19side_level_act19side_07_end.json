{
  "server": "kr",
  "storyId": "act19side_level_act19side_07_end",
  "groupId": "act19side",
  "stageId": "act19side_07",
  "title": "광기의 신호",
  "storyCode": "DV-7",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act19side/level_act19side_07_end.txt",
  "sourceHash": "9df66e87fd41705cafa83e9ffa23bc7906de09b257df0cf77b4cdf50d8f54baf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "라인 랩 연구원",
      "text": "엇, 뮤엘시스 주임? 이렇게 늦은 시간에, 뭐 두고 가신 거라도 있으세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "아…… 크흠, 응, 아직 일이 안 끝났거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라인 랩 연구원",
      "text": "참 수고가 많으시네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라인 랩 연구원",
      "text": "여기 두 분은 누구신지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사리아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "……우리의 소중한 파트너야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "너 이분을 몰라?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라인 랩 연구원",
      "text": "음…… 얼굴이 잘 안 보여서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "이분은 오리지늄 이론학자이자 광석병 전문가, 재앙 연구가로 유명한……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라인 랩 연구원",
      "text": "아, 그분이셨군요! 대단하신 과학자를 만나게 되다니 정말 영광입니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "(나를 아예 모를 텐데?)",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "(이게 된다고?)",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "우리는 급한 일이 있어서 빨리 올라가 봐야 해…… 기회 되면 다음에 같이 점심이나 먹자고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 연구원",
          "text": "물론이죠. 그럼 전 방해가 되지 않도록 이만……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 연구원",
          "text": "잠깐만요, 아까부터 어디서 많이 뵌 분 같았는데, 혹시 그 방…… 방……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "……방호 재료 분야에서 아주 유명한 전문가일세.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "파르비스……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "파르비스",
          "text": "요 몇 년간 라인 랩은 아주 빠르게 확장됐어, 안 그런가?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "파르비스",
          "text": "새로 들어온 직원들은 아직 배울 게 많을 것 같군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 연구원",
          "text": "……두 주임이 동시에? 저, 전…… 아직 일이 남아 있어서요! 먼저 가 보겠습니다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "파르비스",
          "text": "허허허.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "……내가 돌아온 걸 알리지 않을 셈인가?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "파르비스",
          "text": "내가 노안이 와서 그런데, 우리가 전에 만난 적이 있던가? 아리따운 와이번 숙녀분?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "파르비스",
          "text": "다른 일이 없으면 이만 가 보겠네. 너무 늦게까지 깨어있으면 이 늙은 몸이 견디기 힘들거든.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "파르비스",
          "text": "참, 뮤엘시스 주임, 약속한 흑두차 잊지 말게.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "휴…… 정말 그냥 지나가던 길이었을까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "지금은 새벽 4시다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "파르비스의 평소 퇴근 시간은 9시간 전에 이미 지났지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "역시…… 마지막 순간이 오기 전까진 퍼디낸드나 크리스틴 둘 중 어느 쪽에도 베팅하지 않겠다는 거네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "누구한테 더 승산이 있을지 지켜보겠다는 거지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "라인 랩이 폐허가 되어도 저 사람은 분명 살아남을걸.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "……라인 랩 본부로 들어갔네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "네비게이트 팀, 준비해.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "너무 서두르는 거 같은데.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "너는……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "사리아랑 겨루는 거 봤어. 네 장비에 관심이 생겨서 그러는데.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "좀 보여주지 않을래?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "너희들은 싸우기 전에 먼저 인사부터 하는 거야? 로도스 아일랜드의 정예 오퍼레이터 씨?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "오해하지 마. 방금 그 말은 로도스 아일랜드의 정예 오퍼레이터 신분으로 한 게 아니니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "정비사로서 나는 훌륭한 기술과 발명가라면 모두 경의를 표하는 편이거든……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "그래서 네가 가진 특별한 구조의 아츠 스태프를 빼앗기 전에, 먼저 너의 의사를 확인해 두려는 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "……아주 재미있는 사람이네, 메커니스트 씨.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "전에는 단순히 사리아를 만나러 간 거였는데, 너와 너의 상사…… 그 박사가 나한테 더 큰 서프라이즈를 줄 줄이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "내 이름을 아는구나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "너도 날 조사했을 텐데, 그렇지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "최대한 많은 정보를 파악한다…… 이게 우리 같은 인간들이 본격적으로 움직이기 전의 습관이잖아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "……라인 랩 본부의 자료실에 네 이름이 있더라고, 오올헤약.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "하지만 퍼디낸드가 자기 동료를 죽이기 위해 역사학자를 고용했다고 믿기는 좀 어렵네. 뭐, 컬럼비아에 불가능이란 없다고는 하지만, 그래도 이건 좀 심했지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "그건 그냥 부업이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "text": "부업이 역사 연구라고?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "틀렸어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "난 역사학자야. 내가 여기 있는 건 천 년 동안 전해 내려오는 예언이 이루어지는 걸 목격하기 위해서고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "물론, 미래의 방향이 몇 개의 파묻힌 역사를 밝혀낼 수 있을 거라고 믿지만……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "나도 너희처럼 진실을 탐구하는 사람이니까.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "도착했어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "어디로 가야 너의 그 빌어먹을 상사를 만날 수 있는지 알고는 있나, 연구원 씨?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "아마 감시실에 있을 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "모퉁이에 통풍구가 있어. 거기로 올라가면 최단 시간에 감시실에 도착할 수 있을 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "서둘러.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "곧 수많은 사람들이 우리를 맞이하러 올 거니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "……보안관님.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "저희와 적대하실 줄 알았습니다. 보안관님은 의지가 약해요. 저 범죄자와의 과거를 잊지 못하셨군요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "쟤는 아직 범죄자가 아니야. 죄를 결정하는 건 너희가 아니고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "……되돌릴 수 없는 길로 가시는 겁니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "이유가 뭐죠? 당신 같은 우수한 분들이 왜 자신의 앞길을 망치는 겁니까? 대체 왜…… 제 충고를 듣지 않은 거죠?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "네가 정말 묻고 싶은 사람은 내가 아니잖아. 그렇지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "그래도 내가 그 사람을 대신해서 알려줄게.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "윽……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "우리는 뭘 위해 싸우는지 알고 있거든.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "사람의 존엄성을…… 행동의 기준을 저 망할 주임 같은 놈이 짓밟지 못하도록 지키기 위해서라면, 우리는 절대 망설이지 않아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "우리는 너와 달리……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "발을 들여놓기도 전에 어느 쪽이 유리한지 판단하려 하거나……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "공격하기 전에 이유를 묻지 않아!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "으윽……!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "길은 찾았어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "아마도……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "그럼 얼른 가.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "너는?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "난 석궁이 있지만 넌 없잖아. 그러니까 난 신경 쓰지 말고 너나 잘 챙겨.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "……고마워.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "조심해.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "넌 왜 안 따라가? 그 녀석을 만나서 끝장내려고 여기까지 쫓아온 거 아니었어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "text": "……나도 무기가 있으니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "뭐?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "text": "같은 편에 서서 싸우는 건 참 오랜만이네, 메리.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "같은 편은 무슨…… 그때는 그냥 놀이었지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "text": "게다가 무슨 놀이든 다 내가 널 지켜줬잖아?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "text": "하하…… 고마워.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "text": "난 정말…… 그때가 너무 그리워.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "저 엘리베이터를 타면 총괄 사무실까지 바로 올라갈 수 있어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "뒤쪽 비상계단으로 가는 게 더 안전하다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "나도 알아. 하지만 우린 시간이 없잖아?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "바로 타고 올라가면 더 빠를뿐더러 상대해야 하는 전투원도 더 적을 거야……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "잠깐, 앞에 있는 구역으로 가지……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "엥?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "미안. 거기가 감시 구역이라는 걸 깜빡했네……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "박사, 예비 플랜으로 변경이다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "침입자 발견!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "이쪽, 이쪽이다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "침입자를 붙잡…… 잠깐, 주임님?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "안녕, 레지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "왜 돌아오셨…… 아니지, 주임님은 권한이 없어서 앞으로 더 가실 수 없습니다……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "침입자 앞에서 망설임을 드러내는 건 적에게 기회를 줄 뿐이다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "어떻게 해야 하는지 내가 다시 알려줘야 하나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "……방패를 들어라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "스턴건 준비, 목표는 전방의 침입자…… 사리아다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "이제야 좀 봐줄 만하군.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "최신 데이터는 모두 기록했나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "드론 방향에 주의해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "실험체의 움직임이 1차 데이터 채집에 영향을 주면 않도록.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "걱정 마시죠, 보스.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "당신이 원하던 1차 데이터가 제 발로 당신 앞에 찾아왔으니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "엘레나.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "무사해서…… 정말 기쁘군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "그동안 당신 밑에서 일하면서 당신의 미묘한 표정을 읽는 것도 제 일의 한 부분이었어요……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "왼쪽 눈썹이 살짝 움찔한 걸 보니 많이 놀라셨네요, 보스.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "……너는 언제나 나한테 많은 놀라움을 주는군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "네가 돌아왔으니 나도 한숨 돌릴 수 있겠네…… 멍청한 신입들은 너처럼 훌륭한 연구원한테 좀 배워야겠어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "저한테 팀장을 맡기시려고요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "아니, 팀장이 아니야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "책상 위에 있는 열쇠 보이나? 챙겨.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "너는 능력을 완전히 증명했어. 나든 도로시든…… 그 누구의 조수가 될 필요가 없지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "다음 프로젝트는 네가 최고 책임자가 될 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "이 열쇠는 내가 준비한 선물이다. 막 완성된…… 공간이 충분한 실험실이지. 너의 실험실이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "무슨 연구를 하든 나와 라인 랩이 전력으로 지원하지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "정말 좋네요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "절 에너지과 주임 후보로도 검토해 주실 건가요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "……완전히 가능성이 없는 얘기는 아니지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "너…… 별로 기뻐하는 것 같지 않군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "당신이 저의 어떤 미래를 계획했다 해도…… 제 대답은 '거절'이니까요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "……아츠 스태프를 내려놔.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "뭐가 두려운 거지? 내가 배신할까 봐? 곧 성공을 앞둔 중요한 순간에, 자신의 찬란한 미래를 보지 못하게 될까 봐?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "어쩌면 정말 내가 그럴지도 모르지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "이해가 안 가는군. 내가 너한테 얼마나 많은 걸 줬는데……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "난 너한테서 재능과 성실함 그리고 야망을 봤어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "성공을 위한 필수 자질이지. 그러한 자질 덕분에 지금의 내가 있기도 한 거고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "당신은 절대 이해할 수 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "당신이 정말 날 신임했다면…… 실험의 진실을 나에게 알려줬어야 했어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "피실험자의 안전 따위는 무시하라고…… 나에게 도로시를 감시하라고. 그리고 쓸모 없어지면 당신은 범죄 증거와 함께 나조차도 없애버릴 생각이겠지……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "……당신에게 나는 그저 말만 잘 듣는 바보였겠지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "올리비아가 그렇게 주의를 줬는데도, 난 당신이 손을 쓰는 마지막 순간에야 정신을 차렸어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "엘레나, 그건 네가 아직 준비가 되어 있지 않았기 때문이야. 네가 지금처럼 동요할까 봐……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "당신은 한 번도 날 믿은 적이 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "아니, 그 누구도 믿지 않았겠지. 퍼디낸드, 당신이 믿는 건 당신 자신뿐이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "그런데 왜 내가 당신과…… 당신의 약속을 믿어야 하지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "난 그 누구한테도 이 정도의 기회를 준 적이 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "엘레나, 그거 아나? 너는 내 자식보다도 나를 더 닮았어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "난 너한테 많은 심혈을 기울였어. 지금이라도 네가 원한다면 내 곁에 돌아오는 걸 허락하지……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "마지막 부탁이야……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "그 입 좀 다물어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "당신의 '선물'과 그 가식적인 친절을 가지고 내 눈앞에서 사라져.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "오늘부터, 엘레나 우르비카는 당신이 마음대로 쥐락펴락할 수 있는 멍청한 조수가 아니야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "퍼디낸드 클루니, 당신과 난 이제 끝이야.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "……퍼디낸드 주임님!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "저 여자를 잡아, 저 폭도를 잡으라고!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "윽……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "text": "주임님, 괜찮으세요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "난 괜찮아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "엘레나……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "다시는…… 그런…… 날 걱정하는 듯한 눈빛으로…… 쳐다보지 마.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "정말…… 역겨우니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "……내가 너를 이해하지 못한다고 했지만, 너도 나를 진정으로 이해하지는 못해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "어쩌면…… 아까 그 순간, 난 걱정하고 주저했을지도 몰라.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "하지만 그건 계획을 망칠까 봐 그런 것이 아니라, 너를 걱정해서야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "text": "난…… 네가 이렇게 되는 걸 정말 보기 싫었거든.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "그 말은……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "text": "쿨럭…… 나도 당신한테 똑같이 돌려줄게.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "후우…… 후우…… 어떡하지? 방위과 사람들이 점점 더 몰려오고 있는데……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "퍼디낸드가 정말 용의주도하네. 사리아 씨가 아무리 강하다 해도 이만큼의 인원을 상대하는 건 힘들지 않을까?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "네가 좀 도와줘, 뮤엘시스 주임.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "……나? 안 돼, 난 싸울 줄 모른단 말이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "나 숨 헐떡이는 거 안 보여, 박사?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "공격을 피하는 것만으로도 버겁다고……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "아까는 교묘하게 사리아를 도와줬잖아?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "일부러 시간만 안 끌면 될 것 같은데?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "누…… 눈치챘어?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "사리아는 감시 구역의 위치를 기억하고 있어.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "너는 계속 사리아의 시야를 방해했어.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "총괄의 위치를 알아낸 후 너는 별로 조급해하지 않았고.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "난…… 꺄악!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "……하마터면 진짜 당할 뻔했네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "오, 박사…… 날 잡아준 거야? 나…… 나를 계속 도와주는 거야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "내가 다른 마음을 품고 있을지도 모른다는 걸 알면서도……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "어떤 생각을 하든 그건 네 자유야.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "너의 입장이 어떻든 상관없어.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그래도 사리아는 도와줬으면 좋겠어.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "로도스 아일랜드와 라인 랩 공통의 이익을 위해서.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "컬럼비아와 주변 국가의 안전을 위해서.",
          "value": "2",
          "blocks": []
        },
        {
          "label": "너 자신을 위해서라도.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "……이번을 포함해 날 두 번이나 구해줬네, {@nickname} 박사.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "좋아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "보답하는 셈 치지. 적어도 이번에는 너희들 편에 서서 사리아 씨가 가고 싶은 곳으로 갈 수 있게 도울게.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "내 부름이 들리나, 물의 입자들이여!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뮤엘시스",
          "text": "눈앞에 있는 모든 생명체에게 입맞춤하고, 발밑의 먼지를 전부 쓸어가거라!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "……엘프의 마음이 바뀌었네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "참 불쌍한 생명이야…… 항상 다른 사람의 입에서 내일에 대한 승낙을 얻고 싶어 하니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "자신과 자신의 종족이 과거에만 속해있다고 기꺼이 인정할 사람은 없는 법이지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "크리스틴이 주지 못한 걸 설마 그 {@nickname} 박사가 줄 수 있을까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "컬럼비아 용병",
          "text": "오올헤약 님, 사리아가 봉쇄를 돌파했습니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "됐어, 옛 친구나 만나게 두지 뭐.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "난 해야 할 일이 있어서…… 정비사 씨와 교류하는 건 다음으로 미뤄야겠네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "text": "……그가 기동 장갑들의 포위에서 살아남을 수 있다면 말이야.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "얼마 만에 돌아온 거지?\n1497일인가.\n헤어질 땐 이미 적이 됐을지도 모른다.\n다시 만날 땐 여전히 친구일까?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "돌아왔구나, 사리아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "text": "……안녕, 크리스틴.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
