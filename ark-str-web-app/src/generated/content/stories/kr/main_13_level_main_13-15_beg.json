  "sourceHash": "31c8107ce56ec4428c6368e200f1b07c99cd4fc3e3f6d992a49c9b4717b23035",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "살카즈?",
      "text": "(고대의 살카즈어) 마왕이 죽었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈?",
      "text": "(고대의 살카즈어) 마왕이 마왕을 죽였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈?",
      "text": "(고대의 살카즈어) 어째서, 이럴 수는 없어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈?",
      "text": "(고대의 살카즈어) 우리의 도시, 카즈델이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈?",
      "text": "(고대의 살카즈어) 이건 저주야! 왕관에 새겨진 저주가 분명해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈?",
      "text": "(고대의 살카즈어) 이는…… 모든 재앙의 시작이 될 거야……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "내일 날이 밝으면 공격을 시작한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "시즈와 시즈의 '파라곤 부대'가 외곽의 견제를 맡는다. 우리와 로도스 아일랜드의 꼬마 토끼, 그리고 밴시는 기착지 깊은 곳까지 들어간다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "켈시 그 할망구는? 이렇게 위험한 작전에, 우리는 사지로 보내놓고, 자기는 강 건너 불구경이나 하겠다는 거야 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "상처가 아직 낫지 않았다. 아스카론이 켈시와 박사의 안전을 책임지기 위해 함께 후방에 머무를 예정이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "로도스 아일랜드는 얼마 전에 고해신부의 공격을 받았었다. 꼬마 토끼의 그 왕관을 빼앗고 싶은 모양이더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "흥, 왕관 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……외드레르, 빅토리아인들에게 진실을 말하지 않았잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "네 계획이 성공해서 우리가 카즈델에 돌아가면, 뭘 할 생각인 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "네 친구가 된 빅토리아인이라고 해도, '전범'과 '전쟁에 휘말린 살카즈'까지 함께 데려가는 건 받아들이지 못할 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "우리에겐 '살카즈들과 고향으로 돌아가겠다'고 맹세했으니, 부디 그 문제를 생각해 본 적이 없다고 말하진 말아 줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "설마 카즈델의 그 땅굴 속 대학에서, 전장에서 돌아온 녀석들한테 뭐, '역사에 대한 성찰' 이런 수업이라도 하나 열어 주려는 생각은 아니겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "아니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "카즈델에 가면 국어 과외 같은 거라도 하나 개설할 순 있겠지. 그럼 W 같은 까막눈이 조금이라도 줄어들 테니 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "뭐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내가 제대로 들은 거 맞아? 외드레르가 이런 진지한 주제에서도 이네스랑 어울려서 농담 따먹기를 한다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "뭐야, 맨프레드 장군한테 비위좀 맞춰봤다고 공감 능력이 늘기라도 한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "흥……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "“전쟁이 끝나면, 카즈델로 돌아간다”라니. 어이가 없네, 우리가 여기서 이런 상상이나 하고 있다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "우린 용병이야, 우리가 해야 할 일은 정해져 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "왜 이러실까, 우리 귀여운 카프리니, 이네스. 넌 라이타니엔으로 가서, 저 높은 탑 위를 거니는 귀족들의 개인 교사로라도 일할 수 있을 텐데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "가르치는 건…… 어디 보자, 전장에서도 꽃다운 미모를 유지하는 법은 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "별로야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "뭘 멍 때리고 있어? 곧 시작할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "아니, 그냥……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "네가 저번에 말했던 기억이 난다. 가게를 차리고 싶다고 했었지, 카즈델에서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "그건 그때 장물을 팔 곳이 없어서 했던 말인데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……그렇군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "과외로 벌 첫 수업료로 밑천을 대주지, 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "그걸로 얼마나 벌 수 있을지 의심이 되는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그러지 말고, 라이타니엔 귀족의 개인 교사를 납치하면 몸값을 꽤나 벌 수 있을 거야. 적어도 용병 열 명 어치는 받을 수 있을걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "진짜로 고향에 돌아가면 그때 다시 얘기해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "그런 정신 상태로 곧 있을 임무를 감당할 수 있을지 걱정이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "환상이나 마법진 같은 거에 시달리더니 바보가 된 건 아니지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "항상 센티멘털한 이 멍청이는 냅두자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "시간은 사람을 기다려주지 않아. 그 뱀파이어를 조지고, 테레시스까지 조지고 나서 카즈델로 돌아가 어떻게 사랑의 보금자리를 꾸밀지 느긋하게 토론하라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……테레시스.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "계속 생각했던 게 있다, W. 내가 말하는 걸 네가 받아들이지 못할 수도 있겠지만, 그래도 말해야겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하, 싸우기도 전에 찬물부터 끼얹으려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "바로 그거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "우린 테레시스를 죽이면 안 된다. 적어도 지금은, 살카즈의 손으로 놈을 죽여서는 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이네스 말이 맞았네, 환상을 겪다 보니 진짜 바보가 돼 버렸잖아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "놈을 죽이면, 카즈델을 다시는 되찾을 수 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "지금이든, 전쟁이 끝난 뒤든, 놈은 섭정왕으로서 꽤나 오랫동안 사람들에게 기억될 것이다…… 심지어, 누군가는 놈을 칭송하기까지 하겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……너 미친 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이딴 걸 가지고 농담하고 싶은 생각은 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "물론 이 전쟁은 멈춰져야만 해. 전에 가졌던 관점이 바뀌지는 않았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "하지만 테레시스는 이미 스스로를 살카즈의 미래를 위한 주춧돌로 만들어 버렸지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "카즈델은 다시 분열되어선 안 된다. 이 전쟁 또한…… 살카즈의 또 다른 배반과 내전의 시작으로 끝나서는 안 되고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "내가 전에 말했던 계획은 기억하나? 우린 모두가 놈의 죽음을 알기 전에, 이 전장의 살카즈들을 빅토리아로 철수시켜야만 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "살카즈의 실패가 알려지고, 테레시스의 위협이 사라진다면…… 과연, 무슨 일이 일어날까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "공작들은 빅토리아 내 살카즈들을 마음껏 학살하겠지. 보복은 결국 다른 핵심권 국가들에도 번질 것이다. 모든 문명에 정당한 핑곗거리가 생기겠지…… 살카즈들을 죽여 없애야 한다는.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그리고 연합군을 조직하겠지. 합리적이고 정의롭게, 신속하고 결단력 있게…… 테레시아와 테레시스가 남긴 모든 유산을 서로 나눠 가질 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "상상이 가지 않나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "솔직히 말하자면, 테레시스의 죽음이 무슨 결과를 가져올진 전혀 상관 없어. 난 그 자식이 죽기만 하면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "연합군? 살카즈 학살? 지금도 하고 있는 일이잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "설마 테레시스가 죽는다고 마족 놈들의 투쟁심까지 단체로 사라질까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "쳇. 난 안 그래, 그럴 거라 믿지도 않고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그 자식이 암살자를 보내서 테레시아를 죽이고 왕을 참칭한 거야, 그 자식이 모든 사람들을 이 진창에 끌어들인 거라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그 자식의 카즈델을 위해서, 우리가 그 자식한테 머리를 숙일 필요는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "자기랑 관계 없다고 생각하지 마라, W.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "아직도 스스로가 그저 용병일 뿐이라고 생각하나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "네가 얼마나 많은 사람들을 데려왔지? 리유니온에서부터 지금까지, 얼마나 많은 살카즈들을 모았지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "넌 지금 그들의 목숨을 짊어지고 있는 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그딴 거 신경도 안 써!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "신경 써야한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "설마 예전처럼, 사람 좀 죽이고 폭탄 좀 터뜨리면 될 것 같다고 생각하나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "넌 지금 저 살카즈들의 리더다, 잘 생각해 봐. 저들의 희망에 어떻게 응답할지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "잘 생각해 봐, 저 목숨들이 네게 어떤 의미인지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "테레시스뿐만이 아니야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "잊지 말라고, 테레시아도 있다는 걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그러니까, 여러 방면에서 말하자면 우리 모두는…… 그저 그들의 계승자이자, 그 이념의 연장선이 될 수밖에 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그 두 사람이야말로 살카즈가 단결할 수 있었던 이유니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그건 진짜 테레시아가 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그저 테레시스가 만들어 낸 가짜일 뿐이라고, 난 그딴 거에 속지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "W.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "너 자신과 똑바로 마주해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "니가 뭔데 나한테……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "넌 바벨의 그림자인 것에 익숙해져서, 테레시아의 죽음을 받아들일 수 없는 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "심지어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "닥쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "네 앞에서 아미야가 걷고 있다고 생각하고 있겠지. 그녀야말로 테레시아가 선택한 계승자니까, 그런 것은 '마왕'이 고민해야 할 일이라고 생각할 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "아미야를 또 다른 테레시아로 보고 있는 거겠지. 넌 그저, '마왕'을 뒤따르기만 하면 된다고 생각하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "닥치라고! 나 열받게 하려는 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……넌 스스로 무언가를 계승하기엔 부족하다고 생각하고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……개소리, 네가 나에 대해서 뭘 알아? 네가 나한테 훈수 둘 깜냥이라도 된다고 생각하는 거야, 외드레르?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "너도 용병인 주제에, 나보다 뭐가 잘났다고 무슨 계승자니 뭐니 지껄이는 건데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "퉷, 욕 나오려 하네! 그 토끼가? 거기다 뭐, 내가 따르고 있다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "걘 그냥 어쩌다가 우연히……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……테레시아에게 선택되었고, 리유니온과 탈룰라를 막았으며, 지금 이 순간에는 런디니움으로 진입해오는 로도스 아일랜드의 리더다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그럼 넌?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "W, 네게 테레시아는 어떤 의미지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그저 한때 네게 발붙일 곳을 주었던 머나먼 상징이자 혈육을 갖춘 전하일 뿐일까, 아니면…… 그녀가 상징하는 길일까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……나는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "“이 세상이…… 편안히 잠들 수 있도록.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그래서…… 그 녀석은, 가짜라고 말하는 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……이네스, 지금까지 이 녀석을 안 죽이고 어떻게 참았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "난 스스로에게 거짓말을 하진 않거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "쳇, 집어치워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "쓸데없는 걱정 하지 마, 외드레르.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "뭘 해야 하는지는 나도 알아. 전투 전에 사기를 떨어뜨렸으니 즉결처형 감이지만, 이번만 봐줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "검이나 잘 닦아둬, 내일이면 싸워야 하니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "하아…… 역시 도망치는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "정말로, W가 그럴듯한 리더가 될 수 있을 거라고 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "저 많은 용병들을 끌어모은 사람이잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "훗, 정말 '용병'이라고 할 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "W한테 그들을 고용할 돈이 있긴 하고? W가 하려는 일이 또 그들에게 얼마나 많은 돈을 벌어줄 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그럼, 그 사람들은 대체 왜 W를 따르는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "W가 뭐라고 하든 상관 없어. 테레시아를 위한 복수든, 그때의 암살에 참여한 자를 죽이는 것이든, 아무 생각 없이 그냥 뭐든 폭파하고 보는 거든……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "어찌됐건…… 이미 그 길을 걷고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……불쌍하네, W를 따라다니는 사람들이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "하지만 사실 다들 잊고 있는 부분이지만, W는 아직 젊어…… 더 발전할 여지가 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "부디 그렇기를.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그리고, 첫 수익은 개업 밑천으로 주겠다고 한 건 농담이 아니었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……나도 알아.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "'파라곤 부대'는 정비가 끝났다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "런디니움 자경단의 일부 멤버들이 자진해서 우리에게 합류했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시어러 소위",
      "text": "그래, 여기까지 오면서 수습한 공작들의 패잔병들과 전투에 참가하려는 난민들, 그리고 자경단에 있었던 민병대들을 합치면 대략 6~7개 중대 정도의 병력을 확보했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시어러 소위",
      "text": "시즈, '파라곤 부대'의 편제를 확립하고, 장교를 임명해야 한다. 그래야만 지휘 계통을……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "시어러 소위, 이 부대는 진정한 '빅토리아의 군대'가 아니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "물론, 군인들이 일부 있긴 하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "너와 델핀이 이끌던 윈더미어 공작의 잔존 부대를 제외하면, 나머지는 그저 싸울 의지가 있는 일반인에 불과해. 기술자, 농부, 상인. 물론, 부랑자들 또한 있겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "만약 우리가 그들을 강제로 특정 작전소대에 밀어넣고 무기를 쥐어준 다음 장교들의 지휘에 따르라 명령한다면, 우리가 저 공작들과 무슨 차이가 있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "'파라곤 부대'는 물론 훌륭한 명패다. 하지만 이것이 사람들에게 가져다주는 것은 순수한 희망이어야 한다고 생각해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "혹은 거기까지 갈 필요도 없이, 그저 공작들의 고속 군함으로는 가져다 줄 수 없었던, 실체가 없는 것이어야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "그러니까 내 말은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "파라곤 부대는 국검을 쥔 왕위 계승자가 이끄는 영웅 부대 같은 게 되어서 안 된다는 말이야. 난 그런 명목이 꽤나 거북하거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시어러 소위",
      "text": "하지만, 그러면 복잡한 군사 작전은 어떻게 수행해야 하지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "군사 작전이라니 드리는 말씀이지만, 저희 부대 중 대다수 사람들은 제대로 된 훈련조차도 받지 못했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "라테라노에 가면 라테라노 법을 따르라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "체틀리 카운티에서 했던 것처럼, 자경단이 런디니움에서 해 왔던 것처럼 해야할 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "서로에게 익숙한 사람들과, 각자에게 익숙한 방식으로 저 살카즈 놈들을 죽이면 돼요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "……실례했습니다, 살카즈 여러분.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "괜찮다. 신경 쓰지 않으니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "의식은 중지되었지만, 살카즈의 핏속에 잔류한 축복은 아직 완전히 소멸되지 않았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "런디니움이 있는 방향에서…… 고대의 주술이 들끓고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "우리의 숙적은 타인에게 결코 밝힐 수 없는 목적을 지니고 있지. 하지만 저들이 드러낸 급박함은 오히려 돌파에 도움이 될 수 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "더욱 주의하도록 할게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그럼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "일단 그 뼈를 되찾도록 하지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "계획은 성공적이야, 그 빅토리아인들의 공격 덕분에 이쪽 방면의 부대 일부가 재배치되었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "진입했다. 여기 있는 게 확실해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "너희는, 저번의 그 살카즈? 너희들이 어째서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "빅토리아인들이랑 같이 여길 공격하는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……미안하게 됐군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "반역자들을 죽여라! 살카즈를 배반한 놈들을 죽여!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "울술라가 직접 마중을 나오지는 않았군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "로고스의 예상이 맞았어, 바빠서 자리를 비우지는 못하는 모양인데.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하…… 저번에 같이 못 오게 해서 못 봤는데, 이거 장난 아니게 크잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "폭파해서 두 동강 내도 되려나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "안 된다, 작전대로 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "바로 척추에 올라가서, 조종하는 사람을 제압하세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네, 느껴져요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "녀석이 이곳에 있어요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
