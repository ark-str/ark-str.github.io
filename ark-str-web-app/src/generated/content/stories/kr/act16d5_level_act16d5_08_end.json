  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "시주, 소승이 폐를 끼쳤소이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "오랜 꿈에서 결국 깨어났구나…… 얼마나 지났지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "매화가 열 번 피었다가 열 번 지는 걸 보았소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "내가 만약 붓을 들지 않았다면, 그림 속 천지가 예나 지금이나 변하지 아니하니, 어찌 꽃이 피고 지겠는가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "솔직히 소승이 천악산 그림에 들어간 후부터 계속하여 시일을 따져보니, 대략 이 정도 세월이었소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "십 년이라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "내 그림에서 십 년을 머문 것인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "어슷비슷하오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "일개 객승이 이곳에서 십 년의 세월을 허비하다니. 무엇 때문에 그리 고생하는 것인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "아이고, 오랜 꿈이었지만, 먹고 마실 것도 있고, 세속에 시달릴 것도 없고, 피할 재앙도 없고, 감염도 두려워할 거 없으니 소승은 꽤 만족스러웠소이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "……그렇다고 해도, 한 꿈을 십 년씩이나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "긴 세월 동안 초심을 유지할 수 있는 사람은 매우 드물지. 어떤 사람은 자기가 누군지 잊고 그 그림 속에 영원히 남기도 하고 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "허, 그런 건 상상만 해도 정말 끔찍하구려.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "그런데 자네는 조금도 두려워하지 않는 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "시주는 좋은 분이셔서, 그 사람들의 의식이 사라질 때쯤이면 분명 깨우쳐 주실 거잖소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "오? 왜 그렇게 생각하지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "천악산 정상의 낚시꾼, 강가로 돌아가지 않은 베 짜는 노부인, 무계원의 병사, 용문 객잔의 주인…… 그리고 파산 마을의 이야기꾼까지, 시주께서는 이미 여러 번 소승을 깨우쳐 주셨소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "소승이 미련을 버리지 못한 것이오. 몇 번이나 깨어날 듯 깨지 않고 얼렁뚱땅 넘어갔구려. 이렇게 보면, 소승이 사과를 해야 마땅하오. 그림에서 산 사람을 한 명 더 키우려면 적지 않은 힘이 드는 것 아니오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "안심하게. 자네가 산에 들어갔을 때는 가을바람이 불었는데, 지금은 겨우 겨울로 접어들었을 뿐이니. 꿈은 잠시였을 뿐이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "오오! 사실 소승은 이곳에서 오랫동안 게으름을 피우다가 옛 친구들에게 꾸지람을 듣지는 않을까 하고 걱정했소만, 짧은 시간이었다니 마음이 많이 놓이는구려.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "천악에서 이미 자신의 처지를 알았고, 모든 것이 그림인 줄 뻔히 알면서, 어째서 이렇게 시간을 낭비한 것인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "석아가 달로 날아간 진실을 알고는 오랫동안 마음을 놓을 수 없었소…… 정말 혼자 힘으로 하늘로부터 사랑을 되찾으려는 미치광이가 있다니. 제정신이 아닌 것이 오히려 안타깝지도 않았소……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "호오…… 석아의 그 마음도, 내가 일부러 그린 것이니…… 역시나 거짓이네만?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "각국의 전설, 명작, 고서, 신화 중 얼마나 많은 것이 거짓이고, 얼마나 많은 것이 소박한 생활과 인연이 있겠소. 전부 '거짓'이라는 이유로 그것의 의미를 부정해야만 하는 것이오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "그것은 아니라고 생각하오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "정말 이상한 사람이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "신묘한 사람과 이상한 사람은 한 끗 차이가 아니겠소. 과찬이오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "훗……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "자네 스승님과 마찬가지로군. 나이는 많지 않지만 마음이 순결하고 맑은 사람이로군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "나와 함께 꽤나 시간을 보냈으니, 자네의 스승님 체면을 봐서라도…… 좋아. 날 만날 수 있게 허락해 드리지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "음? 만나다니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "하하, 정말 혼자 문을 열고 들어오면 꿈에서 깬 것이라고 생각한 건 아니겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "설마……! 아직 그림 속인 것이오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "너무 낙담하지 말게. 당연한 일이니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "설마 정말로 그렇게 쉽게 깨어난다면, 내 체면이 뭐가 되겠나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "이제 됐네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이야기꾼",
      "text": "깨어나게나……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "깼어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "일어나. 바닥에 누워 있는 건 꼴불견이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "아……! 소승은 대체……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "왜 그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "아니오…… 소승은…… 상상도 못 했소. 시주의 본래 모습이 이럴 줄은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "허.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "물어봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "소승…… 소승은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "소승은 본래 백여 폭의 그림을 건너면 적어도 시주의 경험을 반이라도 따라갈 줄 알았소만…… 겨우 시주의 수많은 그림 중 한 자락에 불과할 뿐이었다니, 언급할 가치조차 없구려……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "잘못을 고집하고 깨닫지 못하는 사람은, 결국 이곳에서 죽고 말지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "이해할 수 있소……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "네가 묻고 싶은 건 그게 아닐 텐데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "오, 맞소. 소승이 너무 놀라서 깜빡했소. 이해해주시오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "시주, 소승은 주지 스님의 다락방에서 그 《졸산진기도》를 본 적이 있는데, 그 속에 진의가 있다고 생각했지만, 딱히 답을 할 수가 없었소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "주지 스님께 여쭸더니 주지 스님께선 소승에게 하산하여 스스로 답을 찾으라고 하시더이다. 소승은 산에서 내려와 정처 없이 떠돌아다녔고, 무언가 깨우쳤나 싶었소만 오히려 이 세상 때문에 더 막막해졌소이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "이렇게 운이 좋아 시주 본인을 만나니, 소승……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "이미 깨달음을 얻었는데 구태여 더 물을 필요가 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "장점을 취하여 단점을 보완하고, 부족한 부분을 보충하려는 것이오…… 솔직히 소승은 그 그림 속 진의를 이해하지 못했소. 왜 폭포의 끝에서 획을 그어 몇 치의 여백을 남겼소?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "네 생각은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……졸산진기는 그림 속의 하늘과 땅이 무한하다는 의미요. 폭포 끝이 하늘로 치솟아 여백을 남겼으니, 이로 그림으로 담을 수 없는 아름다운 강산을 모사한 게 아닌가 싶소만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "어, 소승은 그저 멋대로 이야기한 것이니, 시주께서도 뜸 그만 들이시오. 소승 민망해지려고 하오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "어떻게 이해하느냐는 보는 사람에게 달렸겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그런데, 고작 그 일 때문에…… 그렇게 애를 썼단 말이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "인생이란 해답을 구하고 또 구하는 것에 불과하오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "이렇게 작은 고민으로, 소승은 운 좋게 시주의 그림에서 견문을 크게 넓혔으니, 좋은 일이 아니겠소?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그것도 그렇네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "하지만 네가 물은 그 획은, 단지 흥에서 시작되고 흥이 깨져 멈췄을 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그때 폭포까지 그리고는, 갑자기 흥이 깨졌어. 이후에 다시 보니, 무심하게 그린 것이 오히려 더 정취가 있어, 대충 이름을 지어 네 아둔한 스승에게 준 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……설마 그런 것일 줄은 생각도 못 했소!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "실망했나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그림 속에서 허송세월하다 얻은 대답이 이렇게 재미가 없어서 말이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "그럴 리가 있겠소. 그림 속의 여정에서 소승이 얻은 바도 꽤 많은데, 시주의 대답 역시 정말 재미있소!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "흥이 나서 붓을 들었는데, 흥이 깨져 붓을 멈춘다라…… 소승은 본래 모든 것에는 각각의 뜻이 있다고 여겼소. 그런데 오래되다 보니 오히려 그 속에 빠져 헤어나지 못한 것이오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "맞구려, 맞아! 구태여 그 진의를 따질 필요가 없는 것이었소…… 답이 그 하나라면, 백번 생각한들 무슨 의미가 있겠소?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "소승이 스승님께 들은 “본디 맑고 깨끗한데, 어디에 티끌이 있으리오”라는 말도 비슷한 의미인 것이오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "훗……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "사람마다 자신의 신념이 있어. 그것을 이해한다면 자만한다고 꼭 나쁜 것만은 아니지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "아, 시주의 가르침을 잘 새겨두겠소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그날 네 그 아둔한 스승에게 그림을 선물할 때, 난 분명 '졸산진'이라고 얘기해줬어. 그 다음에 붙은 '기' 자는…… 바로 네 스승의 뜻이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "보잘것없는 산의 끝이라는 '졸산진'에서, 시작을 뜻하는 '기'라는 글자를?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그때 네 스승이 뭘 봤는지 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "시주와 함께 아름다운 산천을 보시지 않으셨소?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "틀렸어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "으엇?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "다시 그림 속으로 돌아온 건가……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "아, 저게 혹시 주지 스님께서 보셨던 것인가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "저건…… 주지 스님?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "네 스승은 발이 까지고 배가 고픈 상태로 이 굶어 죽은 사람으로 가득한 황무지 사이를 사흘 밤낮 동안 걸어갔지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "네 스승은 성심껏 이천 하고도 스물네 번의 기도를 했어. 자신의 생사에 대해선 생각도 해보지 않고 말이야. 단지 슬픔과 의혹만을 느끼고 있었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "시주께서…… 주지 스님을 구해 주셨소?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "고담강에서 난 이미 그를 한 번 구한 적이 있지만, 이번에는 그를 돕지 않았지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "생각해봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그 나이에 이런 참사를 목격한 사미승이 어떻게 네 기억 속의 상냥하고 자상한 주지 스님이 될 수 있었는지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "또 어떻게 그 그림에 '기' 자를 추가했을까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "주지 스님……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "사가라는 이름은 소승이 산을 내려오기 전 주지 스님께서 소승에게 주신 것이오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "……그래.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "인간사 가혹함을 보고도 마음이 흔들리지 않았고, 천악이 무너져도 기색이 변하지 않았지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "그 사미승은…… 극동으로 돌아와 갈 곳 없는 아이들을 거두어 보살피고 초야에 절을 지어 주지 스님이 되었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "매우 드문 행보였지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "그 그림…… 그래서 주지 스님께선 '졸산진'에 '기'자를 붙여, 졸산이 아직 끝나지 않았단 의미를 더하고자 했던 거였구려.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……잘 됐구려! 소승, 주지 스님을 대신해 그 풍경을 다시 한 번 보겠소!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "아, 네 맘대로 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "이제 가슴에 뭉친 응어리가 풀렸을 테니, 지금 바로 떠나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "자, 잠깐만, 시주!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "이것은 소승 본래의 의혹일 뿐이었소. 소승 그림에서 머문 시간이 십 년, 그 속에 쌓아둔 생각을 내뱉지 않고는 마음이 편하지 않소!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "……물어봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "하지만 마지막 기회야. 난 너무 수다스러운 건 질색이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "그림 속의 사람은, 참이오, 거짓이오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "정말 재미있는 질문이네. 그림 속의 사람인 줄 뻔히 알면서 왜 진위를 묻는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "소승, 비록 무미건조한 경문을 들으면 바로 잠이 오지만, '진실을 추구하다'란 말은 얼떨결에 적어 두었소…… 그런데 소승이 시주의 그림을 몇 년 동안 돌아다니다 보니, 오히려 더 막막해졌소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "시주께 여쭙겠소. 참이란 무엇이오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "……참이라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "너는 스스로 '참'된 사람이 '거짓'된 사람을 보는 것으로 생각했겠지. '거짓'에도 생로병사가 있다는 것을 웃어넘기면서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "만약 우리도 그림 속의 사람일 뿐이고, 어느 날 갑자기 연기처럼 사라져 버린다면, 너도 이렇게 태연하게 있을 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "사람은 결국 죽게 되는데, 구태여 이 때문에 고심할 필요가 있겠소? 지금으로선 소승이 본심을 따른 것이니 당연한 것이고, 자유로운 것이니, 조금도 두렵지 않소.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "사람이라고 꼭 자유롭지만은 않지. 내가 그린 참이나 거짓은, 모두 내 자아에 대한 질문이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "인생은 마땅히 자유로워야 하는 법이요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "아니, 너와 나, 모두가 화중인, 그림 속 사람이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "스스로 만족하나 자신을 알지 못한다면, 그것이 '참'이라 할 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "과연 무엇이 '참'이고, 무엇이 '거짓'인지, 넌 정말 확실하게 구분할 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "구태여 그 진위까지 따질 필요가 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "설마…… 지금 이 순간에도 소승이 여전히 그림 속에 있단 말씀이오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "……넌 확실히 내 그림을 떠났어. 이건 거짓이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "다만 지금 이 땅이 또 다른 재미없는 그림 속이 아니란 걸 넌 또 어떻게 증명할 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "네가 지나온 길, 만나본 사람, 생로병사, 기구한 운명, 어쩌면 모두 누군가의 갑작스러운 흥일 뿐, 아무런 뜻이 없을지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "너희들이 평생을 바쳐 추구하는 '진실'도, 사실은 나인 듯 내가 아닌 집념에 불과하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "우리가 이 그림 속을 거닐고 있을 때, 구경꾼들은 구경을 하고 그냥 지나쳤지. 갈채를 두어 번 보냈거나 침을 뱉었을 수도 있고. 그저 그랬을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "삶이란 몽환적인 것이고, 이슬처럼, 번개처럼 종적도 없이 거품처럼 사라져.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "충분히 이야기한 것 같네…… 네가 이곳에서 허송세월 보내는 거, 되게 거슬린다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "다른 사람은 내가 기회를 봐서 쫓아낼 테니, 넌 먼저 나가 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "라바 시주님께서는 선생님을 만나기 위해 만 리 길도 마다치 않고 오셨는데…… 선생님께서는 왜 이렇게 체면을 봐주지 않는 것이오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "너랑 상관없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "넌 그 녀석들이 무엇 때문에 왔는지 전혀 모르니, 참견하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "허나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "……세 번은 없어, 사가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "여기에서 한마디만 더 한다면, 잘못을 반성해야 할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "text": "하지만 소승은 라바 시주께 약속했으니, 적어도 이 물건은 시주께 전달해 드려야 하오.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시",
      "text": "너…… 이건……?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "니엔",
      "text": "……찾았다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
