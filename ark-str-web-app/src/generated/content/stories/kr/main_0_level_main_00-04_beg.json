{
  "server": "kr",
  "storyId": "main_0_level_main_00-04_beg",
  "groupId": "main_0",
  "stageId": "main_00-04",
  "title": "혼전",
  "storyCode": "0-4",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_00-04_beg.txt",
  "sourceHash": "35707488d9d2f7ab7256308484c09f45b73e7c2b5d88c3b03f21886bc7e89488",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "에이스!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "모두 무사한 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "합류 지점에는 아직 도달하지 못했을 텐데… 왜 너 혼자 여기 있는 거지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "중심 구역에서 도망친 놈들이다! 놓치지 마라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "큭, 대체 어디까지 쫓아올 셈이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "E2 팀, 공격…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "도베르만! 전투에 집착하지 마라! 퇴각이 우선이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "아미야, {@nickname} 박사! 서둘러라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "여기도 안전하다고는 못 하겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "그래, 계속해서 합류 지점으로 이동해야 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "그보다 너희 팀원들은 어떻게 된 거지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "어디 숨었나? 반드시 찾아내라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "또 추격자들인가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "{@nickname} 박사, 명령을 내려줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "예전에 그랬던 것처럼 말이다.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "아, 에이스 씨…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "상황이 조금, 변해서요…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "박사님께선… 기억을 잃어버리셨어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "…그랬군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "죄송해요 에이스 씨, 많은 게… 변해버렸어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "그런가, 그래도 네가 사과할 필요는 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "혹시 기억 상실 때문에 박사의 지휘 능력에 문제가 생긴 건가?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "…아뇨, 지휘 능력에는 변함이 없으세요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "박사님의 지휘는 예전과 마찬가지로 큰 도움이 됩니다. 그건 제가 보증할게요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "그렇다면 문제없어. 박사의 지시에 따르겠다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "잃어버린 건 되찾으면 그만이다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "그보다 눈앞에 있는 문제를 해결하는 게 우선이겠지.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "놈들이 여기 있다! 공격! 지금 당장 공격해!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "언제까지 이야기만 할 셈이지? 전투는 이미 시작됐다고!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "그럼 {@nickname} 박사, 명령을 내려줘.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "좋아, 짐승들을 풀어라! 놈들에게 물려 뜯기는 고통을 가르쳐 줘라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "박사! 에이스! 적이 몰려온다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "——",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "전원, 전투 준비!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "…알겠다.",
          "value": "2",
          "blocks": []
        },
        {
          "label": "이 틈을 타서 적의 계획을 무너뜨리자.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "알겠다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "E3 팀! 도베르만을 엄호하라!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "복병이 있었나?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "E3 팀… 팀원들이 보이지 않았던 건 우리와 협력하여 적을 양쪽에서 습격하기 위해 숨어있었던 거군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "통신 방해가 발생한 경우, 팀원들은 합류 지점 부근에 배치할 필요가 있었지. 그러면 나나 정찰팀원에게 무슨 일이 생겨도……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "후퇴 작전은 차질없이 진행할 수 있거든. 내가 내린 판단이다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "그렇다면 넌 팀원들을 합류 지점 부근에 대기시키고, 너 혼자서…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "합류 지점 주변에 있는 위험 요소를 제거하는 게 우리의 주요 임무니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "너희 상황을 확인하겠다고 임무 범위를 벗어나서 움직이는 건 너무 위험하지. 그렇다고 팀원 모두를 움직일 수도 없는 노릇이고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "우리 팀의 목적은 기본적으로 전황을 유리하게 끌고 나가는 것이지, 모두의 발목을 잡는 게 아니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "흥. 네 수업은 적을 전부 처리하고 마저 듣기로 하지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "아미야, 부탁한다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "알겠습니다! 전 박사님을 보조하면서 아츠를 이용한 지원 공격을 맡을게요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "드디어…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "에이스",
          "text": "{@nickname} 박사, 로도스 아일랜드의 지휘를 부탁한다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
