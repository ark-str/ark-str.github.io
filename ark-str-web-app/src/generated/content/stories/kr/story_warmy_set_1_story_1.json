{
  "server": "kr",
  "storyId": "story_warmy_set_1_story_1",
  "groupId": "story_warmy_set_1",
  "stageId": null,
  "title": "끝나지 않은 결말",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_warmy_1_1.txt",
  "sourceHash": "6a99e88aef63004adc57d9b921a0e9c3e07d53c08371fb4d80d7054c2790d236",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "읏…… 차!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "후…… 이제 됐다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "괜찮아, 워미?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "헤헤, 괜찮아요! 다행히 접시와 그릇 모두 다 받아냈어요, 하나도 안 깨졌어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "죄송해요, 래디시리프 아주머니. 아츠 스태프를 받은 지 얼마 안 되어서, 익숙지 않네요. 자꾸 높은 곳에 있는 걸 쓰러뜨리고……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "여자아이는 조심스럽게 발돋움을 하고는, 떨어졌던 접시와 그릇을 다시 원래 자리에 놓았다."
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "허허, 너란 아이는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "기억나니? 예전 네가 우리 집에 와서 치스티밀크 칩을 먹을 때는 항상 작은 의자를 밟고 올라가야만, 주방의 전용 그릇을 꺼낼 수 있었잖니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "이리 와보렴, 어디 보자. 음, 정말 많이 컸구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "헤헤, 워미도 그렇게 생각해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "……이거 보렴, 옷깃이 다 터졌구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "정말이네요…… 그렇게 오래 여행했는데도, 지금까지 전혀 몰랐어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "가서 다른 옷으로 갈아입고 오렴, 아줌마가 빨리 수선해 줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아니에요, 괜찮아요 아주머니. 제가 할 수 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "보세요, 개인 반짇고리도 있는 걸요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "어휴, 너 참 많이 힘들었겠구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……음?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "왜 그러니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "예전에 아주머니께서 보내신 편지에, 제가 살던 방엔 이미 다른 사람이 이사를 왔다고 하지 않으셨나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "그런데 느낌이…… 방 안의 배치가 크게 변하지 않은 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "네가 떠난 후에 몇몇 젊은이들이 이곳에 들어와 살긴 했단다. 하지만 몇 주 전에 이웃 마을에서 자원이 풍부한 새로운 광맥이 발견됐잖니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "그래서 여기 살던 그 아이도 너처럼 짧은 편지 하나만 남겨놓곤 급히 떠났단다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "오늘은 여기서 자겠다고 아이언 헤드 아저씨에게 이야기한거니 ? 잠깐 기다리렴, 아줌마가 금방 방을 정리해줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아니에요, 아주머니. 저 곧 다시 떠나야 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "이번엔 그냥 아저씨랑 아주머니 그리고 아빠를 보고 싶어서 잠깐 돌아온 거예요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "단추 가게 재봉사",
      "text": "그러고 보니 최근 너희 아버지 소식을 통 듣지 못했구나. 근처를 좀 돌아다녀 보면, 다른 사람들은 뭔가 알고 있을지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "네, 괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "그보다 아주 중요한 일이 하나 더 있는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "오늘 저녁에, 폐공장 공터에서 야외 영화를 상영할 거거든요..",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아주머니도 오세요! 제가 모두를 초대하는 거예요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "에이! 왜 웃으세요, 허풍 떠는 거 아니에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "우린 정말로 많은 난관을 헤쳐나갔고, 미지의 샌드비스트 낙원을 지나 베헤모스의 둥지를 찾아냈다구요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "거기에는 엄청나게 큰 오리지늄 결정들이 아주아주 많이 쌓여있었어요…… 이 철탑 크레인과 강철 용광로보다도 훨씬 더 높을 정도로요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "그래, 그래! 이 아저씨는 널 믿는단다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "내가 다른 동료 아저씨 아줌마한테 똑똑히 말해둘게. 우리 워미가 아주 먼 곳에 있는 클리닝 밸리를 다녀왔다고 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……그리닝 밸리예요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "어이쿠, 그래, 그리닝 밸리!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "밖에서 그렇게 오랫동안 바삐 돌아다녔으니, 우리 워미도 분명 대단한 실력을 키웠을 테지",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "하지만 이 아저씨는 말이다, 그 무엇보다도 네가 무사하기만 하면 그걸로 충분하단다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "앞으로도 자주 들르거라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "윽, 하지만 전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "이 녀석, 봐라. 내가 방금 뭐라고 했었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "이야기 두어 개 정도 할 시간이면, 새것처럼 고칠 수 있다고 했지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "어서 이 접이식 의자를 래디시리프 아주머니에게 가져다주렴! 그 위에서 탭댄스를 춰도 절대 부서지지 않을 거라고도 전해주고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "네! 고마워요! 머스테치 아저씨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "그리고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "음? 또 무슨 일 있니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "야외 영화…… 저녁에 같이 야외 영화 봐요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "야외 영화?…… 하하, 어쩐지, 그거 때문에 아줌마가 이 의자를 고치려고 했구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "좋다! 아저씨가 약속하마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "그런데 아저씨는 영화 같은걸 안 본지 한참 됐단다. 요즘 상영하는 건 전부 모험 영화라던데, 너희 젊은이들은 그런 걸 그리 좋아한다며?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "느릿한 전개의 가족 영화를 좋아하는 우리 나이대 사람들과는 다르게 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아니에요, 저도 가족 영화를 아주 좋아하는걸요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……예전에, 아빠가 자주 같이 보자고 했었거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아직도 생생히 기억해요, 이야기의 마지막에 가족들이 주인공에게 웃으며 작별 인사를 할 때, 아빠는 항상 눈물을 흘리곤 했죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아빠는 이미 어른이면서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "네 아빠는…… 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "네 아빠는 퍽 감성적인 사람이었단다. 우린 다 알지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "예전에 우리 집 볼트 녀석이 몇 년 동안 도시의 공과대학에 다닌 적이 있었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "나는 가게 일 때문에 자주 자리를 비울 수 없으니, 네 아빠가 대신 그 녀석이 학교에 갈 때마다 데려다 주곤 했었는데…… 기억나니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "네, 저도 기억나요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "어렸을 때 아빠가 매번 일하러 나갈 때마다, 저보고 아저씨 가게에서 얌전히 있으라 하셨죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "분명히 아빠가 광산에 간다고 말해줬는데도, 저는 항상 아저씨한테 아빠는 어디 갔냐고 물어봤었고요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "하하, 맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "어릴 때부터 아빠와 사이가 그렇게 좋았는데, 에휴…… 아저씨는 안단다, 아직도 많이 그리울 거야, 그렇지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "볼트 오빠는 무난히 대학교 졸업한 뒤에 대도시에 남아서 좋은 직장을 구했다고 들었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……저도 정말 기뻐요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "만약 아빠도 이 소식을 들으셨다면…… 분명히 아주 기뻐하셨을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "……착한 아이구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "그래, 맞아…… 맞아, 네 아빠도 알 거다. 말이 많지는 않았지만, 언제나 소식은 참 빨랐으니까 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "네 아빠는 지금 분명 어느 광산에서 중요한 일을 하고 있을 거야…… 아무렴! 다만 그쪽 카드놀이 규칙이 우리랑 다르지 않기를 바랄 뿐이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "네 아빠가 나중에 우리 워미랑 다시 만나게 된다면, 정말 흐뭇해하실 게다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "맞다, 그나저나 네가 타고 갈 그 멋지고 커다란 채굴선은 어디로 가는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "음…… 실은 저도 잘 몰라요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "라나 언니와 새비지 언니 말로는 제가 로도스 아일랜드에 가는 이유가 치료…… 아니, 그거 때문만은 아니고, 전 여러 대단한 능력을 배우러 가는 거예요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "좋아. 아저씨랑 하나만 약속하렴, 네 건강은 스스로 잘 챙기겠다고, 알겠니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……네, 그럴게요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "공사팀 일꾼",
      "text": "이봐, 머스테치. 확성기 돌려줄게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "그래, 잘 받았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……확성기?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "하하하…… 워미는 이렇게 이상하게 생긴 확성기를 본 적이 없지? 이게 바로 볼트 녀석 회사에서 개발한 신제품이란다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "그 녀석 말로는, 소리를 더 멀리까지 전달하기 위해 이렇게 가늘고 구부러진 구조로 만들었다는구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "비록 공장 직원들이 그저 비계발판 위에서 떨어져서 잡담하는 데 사용하지만…… 그래도 나쁘지 않지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "머스테치 아저씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "수리점 조립공",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "혹시 제게 그 확성기 좀 빌려주실 수 있나요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아저씨 아줌마들! ……에?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 아저씨 아줌마들!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "와아…… 소리 엄청 크네……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "각각의 유니폼을 입은 공장 직원들이 큰 소리에 문쪽을 바라보았다.\n곧이어 녹슨 철문이 작게 열리며 그 틈으로 한 소녀가 확성기를 들고 머리를 내밀었다."
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 아저씨 아줌마들! ……오늘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 오늘 저녁에, 같이 야외 영화를 봐요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 장소는 늘 같은 곳, 폐공장 공터에서요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 그, 그리고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 저녁밥은 너무 많이 드시지 마세요, 제가 간식을 준비할 거니까요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "공장 조사원",
      "text": "어, 오늘 야외 영화를 상영한다고? 거기에 간식까지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "공장 검사원",
      "text": "너무 좋다. 마침 방금 밤새 한 철강 검사가 끝난 참이었는데, 딱 쉬면서 축하할 수 있겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "공장 검사원",
      "text": "이봐, 브로. 매점에 가서 탄산음료 몇 상자 가져오는 거 잊지 마!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "공장 구매원",
      "text": "맞다, 방금 어느 집 아이길래, 목소리가 그렇게 우렁차?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "공장 회계사",
      "text": "내가 기억하기로는 저 아이는…… 모습을 보니, 분명히 아빠를 찾은 거겠지? 정말 잘 됐다, 잘 됐어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "공장 운반원",
      "text": "아, 그 아이였구나…… 이곳을 떠난 지 얼마나 됐었지? 2년 넘었던가? 벌써 2년이 넘었구나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "공장 운반원",
      "text": "……그래, 2년이 넘었어, 눈 깜짝할 사이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "공장 기술공",
      "text": "하, 우리에겐 정말 눈 깜짝할 사이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "공장 기술공",
      "text": "하지만 그 아이에게, 2년이란 시간은 분명히 아주 길었겠지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "공장 직원들이 하나둘씩 폐공장 공터에 모이기 시작했다."
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 여러분! 야외 영화가 곧 시작해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(확성기) 높은 의자는 눕히고, 낮은 의자는 앞으로 당겨주세요! 그래야 뒤에 있는 사람들을 가리지 않아요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "의자가 줄줄이 놓여 있어 대부분의 사람들은 이미 자리에 앉았고, 일부 사람들만이 조금이라도 더 마음에 드는 자리를 고르기 위해 오가고 있었다.\n누군가는 지붕 위로 올라가고, 누군가는 크레인으로 자길 들어 올렸으며, 다른 누군가는 결국 스크린 뒤로 달려갔다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "(확성기) 냄비 뚜껑……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "어라, 라나 언니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "이런! 아직 확성기가 켜져 있는데!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "어? 확성기?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "그럼 이제 너희 마을 사람들도 내가 네게 지어준 이 멋진 별명을 다 들었겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "뭐 어때, 마을 사람들도 그 별명이 아주 멋지다고 생각하겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "여보세요? 여보세요? 들려?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……더는 라나 언니랑 안 놀 거예요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "알았어, 알았어, 내가 미안해! …… 난 그냥 네가 걱정돼서 그런 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "약속했잖아, 고향 사람들과 인사하고 나서 나한테 연락 주기로?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……그랬죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "바쁘다 보니 잊어버렸어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "너란 아이는 정말…… 됐다, 어쨌거나 사람들을 만나니까 좋지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "맞아요, 엄청 좋아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……엄청 엄청 좋아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "하하, 좋아. 그럼 된거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "워미야, 곧 영화 시작해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아, 갈게요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "얼른 가봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알라나",
      "text": "그동안 쌓아온 이야기들을 맘껏 풀고 와, 내일 마을 정류장으로 데리러 갈게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "라나 언니, 저 오늘 밤에 바로 떠날 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "그러니…… 오늘 밤 거기로 저를 데리러 와줄 수 있나요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "공장 직원들은 뚫어지게 스크린을 바라보고 있었다. 각자의 귀에 영화 주인공의 독백이 울려 퍼졌다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "어……? 영화가 여기서 끝이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "하지만, 이야기는 아직 끝나지 않은 거 같은데…… 주인공이 마지막에 한 말은 도대체 무슨 뜻이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "워미는 잘 모르겠지만…… 그래도, 다들 즐겁게 본 것 같아……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "아, 정말 좋은 영화였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "정말 부럽다…… 하나의 생각만으로 평생을 이렇게 달려갈 수 있다니, 정말 대단한 용기야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가구 공장 목공",
      "text": "아서라, 영화니까 그렇지, 현실에 그렇게 비현실적인 사람이 어디 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가구 공장 목공",
      "text": "너는 왜 감독이 주인공의 결말을 명확히 끝맺음 짓지 않았다고 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가구 공장 목공",
      "text": "누구나 마음속으로는 어렴풋이 알고 있잖아, 혼자 깊은 산으로, 깊은 계곡으로, 대지의 끝으로 간다는 건…… 그건 죽으러 가는 거잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "……죽으러 간다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "야, 너 이 자식, 어떻게 그런 말을 할 수가 있어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(음…… 예전부터 생각한 건데, 이 두 아저씨는 항상 싸우는 것 같아……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(어째 지금 분위기도 뭔가 이상한 것 같은데……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "결말을 이렇게 만든 건 관객인 우리에게 상상할 여지를 주기 위한 거잖아? 이걸 이해 못 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "네 삶의 경험에 비추어 봤을 때 주인공이 죽으러 가는 걸로만 보인다면, 나로선 네가 안타깝다는 생각만 드네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가구 공장 목공",
      "text": "흥, 나에겐 주인공의 무책임함만 보였어. 마치 너처럼 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가구 공장 목공",
      "text": "만약 내 아들이 커서 저렇게 된다면, 나는 이 광산에서 못 나가게 혼내줄 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "너……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가구 공장 목공",
      "text": "뭐, 싸우자고? 좋아, 덤벼!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "이, 이젠 또 갑자기 싸운다고요?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "(심호흡)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "싸우지 마세요~~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주위의 직원",
      "text": "와! 오늘 야외 영화 끝나고 레슬링 경기까지 있었네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주위의 직원",
      "text": "좋아, 반격 못하게 눌러버려!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주위의 직원",
      "text": "자, 빨리 내가 준비한 탄산음료를 모두에게 나눠줘, 다함께 축제를 즐기자고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "잠시만…… 이게 아닌데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "원래 영화를 다 본 후에는.....",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "여기서 소란피우지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "하압!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "방송국 사무원",
      "text": "아이고…… 내 팔……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가구 공장 목공",
      "text": "스읍…… 내 허리……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……대단해요, 아저씨. 한 번에 두 명을 쓰러뜨리다니!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "에휴, 모처럼 네가 돌아왔는데, 이 사람들은 전혀 나아진 게 없구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……괜찮아요, 제 기억 속 모두 항상 시끌벅적했으니까요…… 오늘 유난히 더 시끄러운 것 같긴 하지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "다행히 아이언 헤드 아저씨가 계신 덕분에, 한 번에 해결되었네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "내가 아니라 네가 준비한 디저트 덕분이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "워미야, 와서 비디오 테이프 좀 저기 벽 쪽 캐비닛에 다시 넣어주렴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아! 네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "왜 그러니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아, 아니에요! 그냥 상자에 적힌 영화 상영시간 정보를 보고 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "오늘 상영한 이 영화, 설마 했는데 진짜로 완전판이었네요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "하하, 워미도 영화 결말이 마음에 안 드나 보구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아, 아니에요. 저는 좋았어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "결말에서 확실하게 보여주진 않았어도…… 주인공으로서는 이미 종착점에 도달했고, 새로운 여정을 시작할 수 있지 않을까라고 생각해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아! 이건 그냥 제 생각일 뿐이에요…… 비록 다들 의견이 분분하긴 하지만, 저는 모두의 생각이 일리가 있다고 생각해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "바보 같긴…… 다른 사람들이 어떻게 생각하는지는 중요하지 않아, 중요한 건 네가 어떻게 생각하느냐란다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "워미는 왜 모두에게 야외 영화를 보여주고 싶어한 거니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "저는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "저는 그저 모두를 한자리에 모으고 싶었어요, 아빠가 예전에 그랬던 것처럼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아빠는 먼 길을 떠나기 전에 항상 모두와 함께 영화를 보곤 했었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아빠는 그렇게 하면 모두가 행복해질 거라고 했어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "……우리 워미가 정말로 다 컸구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "아저씨는 알고 있단다. 네가 모두와 제대로 된 작별 인사를 하고 싶어 한다는 걸, 그렇지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "하지만 결국 너무 난장판이라서, 말할 기회가 없었어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "아냐, 사실 워미는 이미 모두에게 말했단다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "에?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "네가 모두를 한자리에 모으면서, 우리에게 지난 2년간의 경험을 이야기해줬잖니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "네가 스스로를 잘 챙기고, 새로운 친구들도 사귀는 걸 보면서…… 우리도 워미, 네가 저 영화의 주인공처럼 이제 새로운 여정을 떠날 거라는 걸 모두 눈치챘단다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "가장 중요한 것은, 너는 아직 어리니까 그만큼 네 미래에는 수많은 가능성이 있다는 거야. 하고 싶은 일이 있다면, 그냥 해보렴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "네가 이 마을에 남든, 아빠를 계속 찾든, 아니면 다른 계획이 있든……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "아저씨 아줌마들은, 모두 너를 항상 응원한단다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아이언 헤드 아저씨……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……고마워요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "바보 같기는, 뭐가 고맙다는 거냐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 상영사",
      "text": "나중에 네가 다시 돌아오면, 다 같이 다시 야외 영화를 보자꾸나, 좋지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "광물 운반원",
      "text": "도착했다, 꼬마야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "광물 운반원",
      "text": "저기 수송차 정류장 보여? 얼마 전에 이곳으로 오는 마지막 노선이 막 운행을 중단했다고 들었다만, 그래도 다행히 플랫폼이 아직 철거되지 않고 남아서 불도 켜져 있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "광물 운반원",
      "text": "나는 아직 배달할 물건이 남아서 더 이상은 같이 가주지 못해, 조심하거라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "여기까지 데려다 줘서 고마워요 아저씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "광물 운반원",
      "text": "별일 아닌데 뭐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "광물 운반원",
      "text": "길에 돌이 많으니까 걸을 때 잘 봐, 넘어지지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……아, 네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "괜찮아요, 이 길은 저도 여러 번 와본 길인걸요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……이제는 더 이상 넘어지지 않을 거예요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "여자 아이는 발걸음을 멈췄다.\n헤아릴 수 없는 깊은 어둠이 버려진 철로를 삼키고 있었다. 잊혀진 광부의 헬멧에는 움푹 들어간 자국이 선명했고, 뒤틀리고 변형된 밸브 손잡이는 버려진 채 땅에 흩어져 있었다.\n쓰러진 광산 램프 하나가 깜박거리다 이내 그 빛을 잃었다."
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "저……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……정말 보고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "하지만…… 전 아주 먼 곳으로 가야 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "우리가 앞으로 가야 할 곳은 운송차의 종점보다도 더 멀고, 그리닝 밸리보다도 더 멀다고 라나 언니가 그랬어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "그, 그래도, 저를 걱정하지 않으셔도 돼요... 모두가 저를 기다려줄 테니.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "소녀는 느슨해진 경계선을 넘어서 마침내 폐허로 걸어갔다.\n그녀는 침묵한 채 차가운 돌덩어리들을 쓰다듬었다. 마치 그녀가 놓고 싶지 않았던, 기억 속의 두껍고 거친 손을 쓰다듬듯이."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "아빠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "워미",
      "text": "……안녕.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
