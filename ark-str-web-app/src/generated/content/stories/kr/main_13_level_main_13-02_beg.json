{
  "server": "kr",
  "storyId": "main_13_level_main_13-02_beg",
  "groupId": "main_13",
  "stageId": "main_13-02",
  "title": "쉴 새 없이",
  "storyCode": "13-3",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_13-02_beg.txt",
  "sourceHash": "49b62ec74eb4bdf2dd49f8b14fcd70904c2005256aa856cee40567c6d4b9ffca",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "델핀, 뭘 멍하니 보고 있어?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "아무것도 아니에요, 어머니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "전 그냥……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "이런 시점에서 런디니움을 바라보는 게 어색해서요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "그런 정신이 딴 데 가 있는 듯한 모습은 질리도록 봤었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "후방에서 들려오는 어수선한 보고에 싫증이라도 난 것이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "아니요. 전 그저…… 노포트 구에서 있었던 일을 생각하던 중이었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "미안하다. 런디니움의 형세가 이토록 짧은 시간 내에 심각해질 줄은 예상하지 못했구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "내가 조금 더 일찍 너희들을 철수시켰어야 했는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "런디니움 시내에서 벌어진 크고 작은 일들을 모두 분석하고 보고서를 작성했지만…… 저희는 실패했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "사과를 해야 하는 건 오히려 저희 쪽이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "괜찮다. 그런 크고 작은 풍파 따위로는 우릴 넘어뜨릴 수 없으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "아마 그것들의 대부분은 캐스터 공작이 책임을 지게 될 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "그건 나도 알고 있어. 난 그저 내 전달자가 그녀를 곤란하게 만들지 않길 바랄 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "하지만…… 그 정보들은 앞으로 있을 작전에 있어, 상당한 가치를 지니고 있을 텐데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "그 정보들이 너보다 가치 있진 않다, 델핀. 마음 편하게 먹어라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "난 이미 도착했고, '갈라바에 철 방패'도 이 근처에 있다. 우리가 그 도시로 돌아가면 모든 게 제자리를 찾을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "난 모든 걸 원래대로 돌려놓을 거다, 델핀. 런디니움도, 빅토리아도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "물론이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "어머니, 전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "제가 여기서 죽을 줄 알았어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "넌 내 딸이야. 그런 일이 벌어지도록 내버려 두지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "그동안 정말 잘해줬다. 세심함과 인내심에 있어서는, 정말 네 아버지와 똑 닮은 것 같구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "하지만 그 일들을 꼭 네가 해야 할 필요는 없다. 넌 내 계승자이니 더더욱 린카딘에 머물러야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "우리와 라이타니엔 사이의 대립을 겪다 보면, 그 과정에서 얻어지는 경험은 상당하지. 넌 이런 일에 익숙해질 필요가 있다…… 나도 마침 말동무가 필요하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "그땐 저도 더 잘할 수 있을 거라고 생각했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "……죄송해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "'윈더미어 공작'이라면, 자신을 강철처럼 단단하게 만들기 위해서 많은 걸 고민해야만 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "하지만 그걸 네가 감당할 필요는 없어, 적어도 지금은.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "엄마가 나이가 들어 제대로 걷지 못하기 전까진, 언제든 의지해도 좋다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "네…… 감사합니다, 어머니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "앞으로 네다섯 시간만 지나면 집으로 돌아갈 수 있다. 영지에 있었던 네 물건들을 시녀가 전부 가져올 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "네가 쓰던 잠옷, 베개, 침대, 욕조까지 전부.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "그건 전부 제가 런디니움에 오기 전에 썼던 물건이잖아요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "그때보다 키도 크게 차이나지 않으니, 멀쩡하게 잘 쓸 수 있을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "그리고 널 위해 좋은 물건을 하나 더 준비했지만, 지금은 비밀이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "집에 돌아가면 우선 잠이나 한숨 푹 자 두도록 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "그렇다고 너무 풀어지진 말고. 아직 우리에겐 해야 할 일들이 산더미처럼 쌓여 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "무슨 일이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "어머니, 전 런디니움에서 정말 오랫동안 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "과거엔 저도 많은 동료들이 있었죠. 모두들 제가 보고 배울 정도로 정말 우수한 친구들이었고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "저희는 그 혼란스러운 도시에서 원래의 생활을 버려가며 살아갔어요. 그때만 해도 저희 모두 이 일에 대한 믿음이 있었고, 정말 자랑스러워했었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "하지만 나중엔…… 상황이 변하고 말았어요. 정보원들은 하나둘씩 사라지고, 살카즈들은 대놓고 도시를 앗아갔고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "전 도움 청할 곳 하나 없었어요. 그래서…… 조금 더 평범한 사람들이랑 생활할 수밖에 없었죠. 그때 전 처음으로 그 사람들이 어떤 생활을 하고 있는지 알았어요. 또 그들이 어떤 눈으로 빅토리아의 방식을 생각하고 있는지에 대해서도요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "하지만…… 시간이 지나고, 그들 대부분이 죽었어요. 살아남은 일부도 지금 이 함선 아래 부분에 모여 어머니의 처분만을 기다리고 있고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "바로 제 잠옷, 침대, 욕조 100미터 아래에서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "……음.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "전 진심으로 어머니께 감사드려요, 정말이에요. 하지만 그것들 전부……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "딸아, 넌 정말 잘해줬다. 내 상상을 아득히 뛰어넘을 정도로 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "이제 아래에 있는 부대를 만나러 가 보렴. 넌 확실히 그 사람들이랑 더 가까워져야 해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "어머니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "윈더미어 공작",
      "text": "할 얘기가 더 있으면 나중에 해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "여기에 직접 오셔선 안 됐어요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "이건…… 리스크가 너무 커요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "라이타니엔인을 그렇게 쉽게 믿어선 안 돼요! 살카즈들의 다음 계획도 모르잖아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "게다가 우린 정보에서 뒤처진 상태인데……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "챙긴 식량으로 얼마나 더 버틸 수 있을 것 같아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "보아하니 이 군함은 이렇게 많은 난민들을 수용할 준비가 안 된 모양이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "인드라",
      "text": "그럼 이렇게 가만히 있을 순 없잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "인드라",
      "text": "방금 에밀 할머니께서 내 손을 잡아 주셨어. 아무 말씀도 없이 그저 바라만 보시더라고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "인드라",
      "text": "이런 건…… 더는 못 참아. 델핀을 찾아가자!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "다그다",
      "text": "한나, 진정해. 우린 지금 남의 전함에 있는 거라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "인드라",
      "text": "난 그냥……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모건",
      "text": "좀 이따 그 사람들이랑 얘기 좀 나누고 올게. 어르신들도 아는 사람 얼굴을 보면 기분이 조금은 나아지시겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "나도 같이 갈게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "오래 기다렸지. 방금 내가 보급 장교랑 이야기를 나눠봤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "일부 식량들은 가장 필요한 사람한테 갈 예정이라…… 이게 내가 할 수 있는 최선이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "……고마워, 델핀. 그리고 윈더미어 공작도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "마음 같아서는 나도 어머니께서 이 불쌍한 사람들을 진심으로 도와주셨으면 좋겠지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "나도 이해해. 이건 나, 혹은 내 신분 때문에 그런 것도 있겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "우린 우리랑 같이 탈출한 사람들을 도울 수 있다면 그것만으로도 만족해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "적응이 상당히 빠르네, 비나 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "나도 지금은 우리 마음대로 할 수 없다는 걸 잘 알고 있어, 델핀.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "이 배에선 아직 많은 사람들이 날 믿고 있어. 비나로서, 또는 시즈로서 나는 그들을…… 책임져야만 해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
