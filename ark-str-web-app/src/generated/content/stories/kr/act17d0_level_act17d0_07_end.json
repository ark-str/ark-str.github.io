{
  "server": "kr",
  "storyId": "act17d0_level_act17d0_07_end",
  "groupId": "act17d0",
  "stageId": "act17d0_07",
  "title": "벙커 방어선",
  "storyCode": "OD-7",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act17d0/level_act17d0_07_end.txt",
  "sourceHash": "5c03325d727b8cce3f392fedb759e4e19c50baf3fb9019f3c7cfb5529f9fcdf7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "피케일",
      "text": "물러서!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피케일",
      "text": "끝이 없군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "대체 이놈들을 얼마나 많이 만든 거야?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "리스캄! 자네 뒤에!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오리지뉴턴트",
      "text": "크르르르르……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "조심해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "프란카!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "대체 뭐 하는 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "거기 아미르 아가씨, 여기 좀 도와줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피케일",
      "text": "아, 알았다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "나머지는…… 도망쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "말하지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "내 다리가…… 너, 넌…… 도망쳐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "헛소리 집어치워!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "나한테 업혀!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "피케일",
      "text": "놈들이 다시 온다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "자! 어서 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오크픈",
      "text": "이쪽입니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "오크픈! 여기서 뭐 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오크픈",
      "text": "제가 어떻게 아래에서 가만히 기다리기만 하겠습니까? 이래 봬도 저, 로도스 아일랜드 오퍼레이터라고요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "말 한번 잘했네! 덕분에 살았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "이제 엔진을 터트리겠네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "셋, 둘, 하나……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "일단 물러난 것 같네. 하지만 머지않아 다시 올 걸세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "아직도…… 수가 너무 많아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "'전술 함정'이 다 떨어졌어. 탄약도 마찬가지야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "이제 어떻게 하지, 알렉산드르?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "대피소로 가라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "뭐라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "대피소로 가! 로도스 아일랜드 오퍼레이터를 모두 데리고 대피소로 가라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "너는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "널 엄호하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "엄호? 그러는 넌 누가 엄호하는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "난 엄호 따위 필요 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "잠깐! 정신 차려 알렉산드르!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "난 아주 멀쩡하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그리고 숨는 것도, 도망치는 것도 이젠 질렸다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "도망만 쳐서는 전쟁에서 못 이겨. 역사에서도 수없이 증명됐지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "이건 전쟁이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "내게는 전쟁이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "놈들이 감염자를 향해 무기를 들이밀고 죽이려 한 순간부터, 이건 전쟁이 됐지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "난 살면서 많은 전쟁을 겪었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "괴물을 한 마리만 더 죽여도 마을 주민들이 살 확률이 높아져.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그러니 탄약이 다 떨어질 때까지 여기 있겠다. 최후의 최후까지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "전투가 아직 끝나지 않았는데, 후퇴란 있을 수 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "영웅 흉내 내지 말라 그러고 다녔던 건 너잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "난 영웅 흉내 내려는 게 아니야, 티나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그저 옳은 일을 하려는 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "무슨 일이 일어나든, 오늘 이 자리에서 결판을 낸다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "알렉산드르!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "나도 남지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "어째서……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "결국 이렇게 될 일이었네. 자네들이 남아서 싸우기로 한 순간부터 우리 모두 알고 있었잖나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "나도 함께 남아 저들을 저지하겠네. 무슨 일이 벌어지면, 내가 그를 엄호하며 후퇴하겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "레인저 영감님……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "알렉산드르, 받아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "이건 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "안전가옥에 있던 오리지늄 폭탄이야. 두 개 남았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……고맙다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "죽지 마!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……장담은 못 해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "거짓말을 하셨군요. 후퇴하지 않을 거잖습니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "허허허…… 이 노인네의 계획을 망치진 말아주게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "저 괴물들을 상대하려면 도움이 필요할 걸세.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "선대 아미르의 칼이라고 하더군, 잠깐 빌려왔네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "정말 멋진 칼이군. 선대 아미르의 식견이 나쁘지 않군그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "아름답게 장식된 칼날에 손수 조각해 만든 터키석 손잡이. 현대 기술로 생산된 무기와 견주어도 손색이 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "최전방에서 싸우는 것보단, 활과 화살을 들고 뒤에 서 있는 게 훨씬 안전하겠네만.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "옛날보다 훨씬 늙고, 느려졌군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "하지만 그 칼날은 여전히 날카로워 보입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "아직 자네 이름을 듣지 못했구먼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "알렉산드르 세나비예프.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "알렉산드르라고 부르십쇼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "나도 이름을 알려줘야 할 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "하지만 나와 내 동지들이 계곡을 피로 물들였던 그날, 내 이름은 과거와 함께 모래에 묻혀버렸다네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "괜찮습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "남아서 싸우기로 했잖습니까. 지금 중요한 건 그것뿐입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "'레인저' 어르신.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그들은 내가 죽었었다고 말한다. 틀렸다. 난 다시 태어난 것이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "괴물의 수가 몇이든 상관없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "모두 덤벼라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
