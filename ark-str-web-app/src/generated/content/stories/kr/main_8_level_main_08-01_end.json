{
  "server": "kr",
  "storyId": "main_8_level_main_08-01_end",
  "groupId": "main_8",
  "stageId": "main_08-01",
  "title": "어제, 이삭이 갈라져 버린",
  "storyCode": "R8-1",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_08-01_end.txt",
  "sourceHash": "3757dfa6345188225ba5bb3399db60aac609d359c98f49a2edc380fc3bb798d8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "감염자 감시팀",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "손목을 자르진 않았으니 어서 일어나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 감시팀",
      "text": "……이대로 당할 줄 알고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "흐응, 그 놈의 혀부터 잘라줘야 할 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 감시팀",
      "text": "윽!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "……도망쳤군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "할아버지, 괜찮으세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "탈룰라, 대체 무슨 짓을 한 거냐! 네가 무슨 짓을 저질렀는지 알아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "며칠 뒤면 다른 마을로 갈 수 있었는데 이런 짓을 저질렀으니……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "놈들을 건드렸으니 큰 사달이 나고 말겠군!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "그렇다고 계속 이렇게 당할 수만은 없잖아요. 놈이 도망쳤으니 이미 늦었어요. 지금 가서 놈을 해치울게요, 다른 사람이 저자의 흔적을 발견했을 때 우린 이미 이곳에 없을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "그렇다고 이렇게 도망치는 게 능사는 아니에요. 놈들이 일단 집결하면 우리를 찾아내는 건 물론, 복수하려 들지도 몰라요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "그걸 알면서 그런 짓을 했으니…… 이제 어쩌면 좋단 말이냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "걱정하지 마세요. 저들이 찾는 건 감염자예요, 그리고 아직 저들이 모르는 게 있죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "뭘 말이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "이제부터 제가 뭘 할지를요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "탈룰라……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "괜찮을 거예요. 할아버지, 제가 모셔다 드릴게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "할아버지, 다리…… 아무래도 치료받으셔야 할 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "하아, 네게 부축받을 날이 올 줄이야. 평생 사지 멀쩡하게 살 줄 알았는데, 세월 앞에 장사 없구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "탈룰라, 네가 꼭 들어야 할 이야기가 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "그게 뭔데요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "할아버지",
      "text": "아, 그게 뭐였더라? 으음, 하하…… 미안하구나, 잊어버렸지 뭐냐. 나이를 먹으니 기억이 가물가물해서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "아무래도 병원에 좀 가보셔야 할 것 같네요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
