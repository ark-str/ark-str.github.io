{
  "server": "kr",
  "storyId": "act18d3_level_act18d3_06_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_06",
  "title": "식욕 부진",
  "storyCode": "SV-6",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act18d3/level_act18d3_06_beg.txt",
  "sourceHash": "e66f76a841c9480b3458338d277b64e2303ae9534c7f0de4caaeee552b70eef7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "끝이 없다…… 안개가 자욱해……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "흐응~ 흥……♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님, 깨어나셨네요! 좋은 아침이에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "누가 노랠 부르는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "이, 이게 노랜가요? 전 노랠 부를 줄 몰라요. 당신이 잠들었을 때, 계속 이렇게 흥얼거리시더라고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내가……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "아야! 가수님…… 너무 세게 잡진 말아 주세요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "너……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "엄마……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "괴물……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "괴물이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "괴물!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "콜록콜록…… 가수님, 당신 가방이…… 제 가슴을 눌러서 너무 아파요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내가……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "소, 손을 놓았네요? 방금 깜짝 놀랐어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님이 절 죽이려고 하는 줄 알았어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난 널 죽일 수 있어. 그것도 아주 간단하게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "하지만 절 죽일 생각 없잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "알고 있었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "알아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "하지만, 난 모르겠어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "또, 또? 갑자기 뛰쳐나가다니…… 가수님, 어디 가시는 거예요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "……장관님, 곧 밀물 때가 돼요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "바다 빛이…… 저곳의 색이 변했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "물속에 뭐가 있는 걸까요…… 조, 조개껍데기와 '핀'류일까요? 왜 갑자기 바닷물에 이런 것들이 나타난 거죠? 게다가 해안으로 계속 다가오고 있는데요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "존재해서는 안 될 해류를 따라 더 깊은 곳에서 흘러왔지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "네?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "전 또…… 저들이 바다에 가면 먹을 것을 교환할 수 있다고 한 게 터무니없는 미신인 줄 알았어요. 전 저들이 절망 속에서 누군가에게 매혹되어 망언을 일삼는 줄 알았거든요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "저, 저들이 정말 바다와 거래를 한 걸까요? 자신을 미끼로 바다의 괴물을 사육하고, 그 괴물로 자신들을 사육하는 걸까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "이 끔찍하고 기형적인 공생관계라니…… 여기에 시테러가 이렇게 많은 이유가 있었네요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "그런데 어제는…… 어젠 제가 그들을 막았다고 생각했어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "모든 시정 행위가 다 결과가 있는 것은 아니다. 넌 그걸 배워야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "제가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "제가 잘못한 건가요, 장관님? 전 단지 저들을 구하고 싶었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "잘못을 바로잡으려면, 잘못된 걸 바른길로 되돌리던가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "하지만…… 저들에겐 무엇이 바른길이죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "살비엔토…… 이 땅과 해안은 이제 어떤 음식도 키울 수 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "결말은 이미 수십 년 전에 정해져 있어, 발버둥을 쳐봤자 모두 헛수고였어요. 이동도시, 문명과 이곳 사람들은 모두 죽음의 길을 천천히 걷고 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "저들이 제게 물었어요. 만약…… 더는 갈 길이 없어진다면 잘잘못을 어떻게 가릴 수 있냐고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "……혹은 잘못을 저지르는 자가 존재하지 않거나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "장관님……! 그 말씀은 제가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "넌 의심하고 있군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "전…… 아닙니다, 제가 어찌 감히. 전 그저……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "저들이 지금은…… 저렇게 변해버렸지만, 저들도 한때는 이베리아 주민이었어요. 전 저들을 보호하고 싶습니다. 제가 이곳의 사람들을…… 그리고 이 나라를 바꿀 수 있길 바랍니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "넌 의심해야 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "판결을 내리려면 네 자신에게 의지해야 하니 말이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "네, 장관님……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "저 바다를 봐봐. 넌 무엇이 보이느냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "위…… 위협이 보입니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "답안을 외우진 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "네, 장관님!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "바닷물이…… 흐르고 있습니다. 끊임없이 변화하면서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "네가 본 모든 것을 기억하거라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "변화는 이미 일어났고, 지금도 일어나고 있으며, 또 일어날 것이다. 만약 확실하게 볼 수 없다면, 너는 망설일 것이다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "장관님, 발아래에?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "무엇인 것 같나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "시테러 한 마리…… 어젯밤 거리를 공격했다 살아남은?! 아, 아닌 것 같아요…… 바닷가를 배회하는…… 아주 먼 길을 기어 온…… 것도 같지 않아요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "음…… 윽, 제가 알아야 하는데……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관",
      "text": "정화해야 할 악이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "……알겠습니다. 전 똑똑히 봤습니다…… 거래의 전모를요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "바닷속으로 들어간 사람은 이렇게 되는 거였군요…… 이곳은 단순히 괴물의 소굴이 아니라 침대이기도 하네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "그렇다면, 여기 있는 사람 모두 괴물로 변하겠네요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "(칼집을 꽉 쥔다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "장관님, 도시에 다시 한번 다녀오겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "헉…… 헉헉…… 가, 가수님…… 너무 빨라요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그렇게 빠른 것 같진 않은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "또 쫓아왔군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "하…… 하하…… 가수님, 여긴 저희 집이에요…… 이곳은 제가 가수님보다 더 익숙해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난 가봐야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가다뇨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "여길 떠나야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "흠, 당신은 동료를 찾으려면 어디로 가야 하는지 아시나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……어쨌든, 너희들에게서 멀리 떨어져야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네? 왜요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그 재판관이 한 가지 맞는 말을 했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "재판관님이 말을 너무 많이 해서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "너희들에게 난 너무 위험해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "어젯밤 일 때문에요? 우릴 구해 주셨잖아요. 가수님, 우린 모두 당신께 감사하고 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "너희들을 살려줬다고? 넌 그렇게 생각하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "만약 그 시테러 중 한 마리라도 내 손에서 도망쳤더라면, 그것들이 가는 길에 널 갈아버렸을지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌 그것들에게 죽임을 당했을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그것들은 내가 끌고 온 것이니, 넌 결국 나 때문에 죽게 되는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "아니요, 그게 아니에요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "왜 아니란 거야? 이런 일이 일어나지 않았던 것도 아니고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그들은 나 때문에 죽었어. 그들은 날 미워하고, 두려워하고, 원망하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "그건…… 그들이 잘못된 거예요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님이 고의로 그런 것도 아니잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난 정말 고의가 아니었을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난 모르겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그날 이후로는…… 나도 모르겠어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난, 그것을 죽이면 답이 있을 거라 생각했어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님…… 안색이 안 좋아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "얼마 전에 부상을 당한 데다 그렇게 많은 체력을 소모했으니, 아직 완전히 회복되지 않은 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "저랑 같이 돌아가 푹 쉬어요. 잠을 좀 더 자면 괜찮아질 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌 왜 날 무서워하지 않지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "네 할머니는 날 괴물이라고 부르고, 네 동료가 날 보는 눈빛은 적개심으로 가득 차 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "어딜 가든…… 모두 그런 눈빛이었어. 그런 눈빛에는 이미 익숙해졌지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌? 네 눈엔 내가 뭐로 보이니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "당신…… 당신은 가수잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "가수라. 내가 말하는 걸 넌 다 믿는군. 그 재판관은 믿지 않았는데. 지금 내가 괴물이라고 말해도 넌 믿을 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "……믿지 않아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌 도대체 왜 계속 날 따라다니는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내가 줄 수 있는 건 네게 다 줄 수 있어. 그런데도 넌 싫다고 하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그렇다고 날 죽이려는 것도 아니고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "주, 죽여요? 아니요, 가수님. 제가 어떻게 그런 생각을 하겠어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내가 일을 해 주면 상대는 보수를 줘. 혹은 그 반대로 말이야. 육지 사람들은 다 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "거래는 곧 약속이야. 약속이 있어야 믿음이 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "약속이요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌 약속이 뭔지 모르는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "(고개를 젓는다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "잘 들어. 네가 날 도와주면, 내가 너한테 네가 원하는 것을 주는 것, 그게 바로 약속이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "……전 아무것도 필요 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "거짓말.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "헌터…… 내 코는 눈만큼이나 예민해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "네가 말했지. 여긴 네 집이라서, 네가 금방 이곳을 찾을 수 있었다고. 너도 거짓말을 하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "네가 사실대로 말하지 않으면, 난 널 믿지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "안 돼요. 가수님, 가지 마세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "전 거짓말을 하지 않았어요. 단지…… 모르겠어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님, 당신은 우리에게…… 저에게는 하나의 수수께끼 같아요. 당신은 밖에서 온 사람이고, 전 당신 같은 사람을 본 적이 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "제가 어떻게 당신이 여기 있는 걸 예측했는지 알고 싶으시군요. 진실을 숨기려고 했던 건 아니에요, 전…… 죄송해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "여긴…… 변경 지역이에요. 시내에서 가장 멀어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "전 당신이 우릴 피하고 있단 걸 알았어요. 그래서 떠난다면, 당신도 이곳에 왔을 거라 생각했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "당신도?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "저도 이곳에 몰래 자주 오거든요. 물론 철판이랑 그 친구들에겐 비밀로 하고요. 그 녀석들은 제가 이렇게 멀리까지 다니는 걸 알면 싫어할 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "저기 좀 보세요. 정말 높죠. 전 가끔씩 저길 올라가요. 바람이 더 강하게 불어서 더 멀리 볼 수 있거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌 바깥세상이 궁금한 거로군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "모르겠어요. 전…… 가끔 바깥은 어떤 모습일까 생각해요. 이건 매우 무의미한 일이란 걸, 저도 알아요. 모두들 그렇게 말해요, 그래서 전 혼자 몰래 생각할 수밖에 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "전 물건을 주우러 제일 멀리 나갈 때, 여기까지 걸어와요. 더 바깥으로 가면…… 바깥에는 별로 쓸모 있는 게 없겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "궁금하면, 더 멀리 가보면 알 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "예전에는 제가 서쪽 끝으로 가려고 하면 철판이 절 위협했어요. 바깥에는 모두 괴물뿐이라 우린 나가는 즉시 죽을 거라면서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님은 밖에서 오셨죠. 제가 가수님을 따라다니는 건, 사실 제가 궁금한 게 엄청 엄청 많기 때문이에요…… 전 알고 싶어요. 철판이 말한 게 사실인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그럴지도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "바깥에 나가면, 넌 죽게 될 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "후우…… 진짜였군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그다지 실망한 것 같지 않은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님. 전, 기회가 되면 가보고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "괴물이 있든 없든…… 전 그다지 무섭진 않은 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "재판관님 말씀으론, 제가 괴물을 두려워하지 않는 건, 괴물이 제게 뭘 할지 모르기 때문이래요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "그분 말씀이 맞는 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "허튼소리야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "콜록콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "나도 안 무서워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "하하…… 그거야, 가수님 앞에서는 괴물이 아무것도 할 수 없단 걸 가수님은 잘 아니까 그런 거죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "전 달라요. 어젯밤에야 처음으로 괴물을 똑똑히 봤어요. 어떻게 된 건지 모르겠지만, 제 심장이 그렇게 격렬하게 뛰는 건 처음이었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "그리고 오늘 아침에 깨어났을 때 전, 놀랍게도 생전 처음으로, 날씨가 이렇게 아름다울 수도 있구나… 하고 느꼈어요. 바람이 부는 것을 느낄 수 있었고, 파도가 다가오는 것을 보았죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "이런 하루는, 날이 밝으면 금방 해가 졌던 지난날들과는 달랐어요. 그건, 제게 무슨 일이 일어날지 모르기 때문이었겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "너무 흥분했는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "이게 너무 흥분한 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "두려움과 흥분은 별반 차이가 없어. 모두 심장이 빠르게 뛰고 피가 뜨거워지게 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "병에 걸린 걸까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그건 병이 아니야. 어떤 사람에게는 그게 바로 살아있다는 증거가 되기도 하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "살아 있는 느낌이 이렇게 좋은 거였군요. 바깥 세상에선, 매일 이렇게 사는 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "어쨌든 여기보단 낫겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "……저 정말 밖에 나가도 될까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "제 상자…… 제 상자가 다 차면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "저…… 식량을 많이 모아야겠어요. 먼저 페트라 할머니를 편안하게 모셔야 하거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "전…… 으앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그렇게 조심하지 않다간 괴물에게 잡아먹힐 수도 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님…… 절 또 구해 주셨네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……네가 이렇게 따라오지 않았다면, 이런 일도 일어나지 않았겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "하하…… 죄, 죄송해요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "어? 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "제 다리를…… 뭔가가 제 다릴 붙잡고 있는 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "미, 미끈거리고…… 너무 무거워요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……또 왔네. 여기저기에 성가신 것들 투성이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "으으…… 가수님, 저, 저 가수님을 놓칠 것 같아요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "눈을 감아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그리고 손을 놓아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "……그래도 돼요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "날 믿을지 말지는 너한테 달렸어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
