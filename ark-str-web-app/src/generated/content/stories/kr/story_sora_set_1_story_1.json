{
  "server": "kr",
  "storyId": "story_sora_set_1_story_1",
  "groupId": "story_sora_set_1",
  "stageId": null,
  "title": "거리",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_sora_1_1.txt",
  "sourceHash": "602756ad702490bfd47b5d0275e3eda5b1acb88253db22af06629fe9813e713c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "空"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "당황한 용문 시민",
      "text": "무슨 일이야!? 저 사람들은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "당황한 용문 시민",
      "text": "저 사람들은…… 리유니온이잖아. 왜 이곳을 공격하는 거야?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "하아…… 하아…… 이게 대체 무슨 일이야?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "당황한 용문 시민",
      "text": "너희들…… 너희들 뭐 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "당황한 용문 시민",
      "text": "그만해! 여긴 우리 동네라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "젠장, 귀찮은 일에 휘말리고 싶은 게 아니라면 비켜라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "윽……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "너희들…… 이러면 안 돼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "뭔 헛소리야, 안 되는 게 어딨어? 너희들은 자기가 이미 썩어빠진 삶을 살고 있다는 걸 알기나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "멈춰……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "……누구냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "이 목소리는…… 설마……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "늦지는 않았네…… 하아…… 하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "이곳의 주민들에게 폭력을 사용하지 마. 이들은 무고한 사람들이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "여러 곳의 거리와 상점이 모두 파괴됐어. 지금은 심지어 무고한 주민들이 사는 공동 주택까지…… 여기 사는 사람들은 앞으로 어떻게 살아가라는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "그래서 뭐 어쩌라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "그건 우리가 신경 쓸 바 아니야. 안 비켜? 너부터 해치운다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그럴 순 없어. 모두에게 기쁨을 주고 긍정적으로 살도록 격려하는 게…… 내가 줄곧 하고 싶은 일이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그러니까 너희들이 타인의 삶을 파괴한다면…… 난 그들을 보호하겠어. 난 그들을 보호할 수 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "게다가 지금은 혼자도 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "어디서 헛소리를……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(휘파람 소리)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "너희들은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "소라야, 미안타, 우리가 한발 늦었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "크루아상, 엑시아 그리고…… 텍사스 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "아직까지도 자기 잘못을 인정하지 않을 줄이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이렇게 된 이상, 정의의 펭귄 로지스틱스가 등장해야지, 두둥! 너희들을 순식간에 처리해버린다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "……'펭귄 로지스틱스'? 하, 간섭하려는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "사태가 급박해서 보고할 시간이 없어. 하지만 보스도 난동을 부리는 녀석들을 내버려 두진 않겠지~ 뭐니 뭐니 해도 여긴 우리의 상권이니까 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "조심해. 저 사람들은 언제든지 위험한 행동을 할 수 있어. 내가 시간을 끌어 볼게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "알겠어. 그럼 나랑 엑시아가 저 녀석들을 처리할게. 크루아상, 너는 사람들을 안전하게 대피시켜줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "알았다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "일단 동쪽 길부터 뚫고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "흐아앗……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "……어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "왜…… 우…… 움직일 수가 없지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "흥, 받아라……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 대원",
      "text": "크, 크윽…… 노래 부르는 녀석의 오리지늄 아츠야…… 노래를 계속 부르게 해선 안 돼! 일단 저 여자를 처리해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "하아, 하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "사람들이…… 멈췄어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "쳇…… 기습을 하려고 들어? 그럼 과부하 모드를 켜야겠네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "지금이야, 어서 가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 캐스터",
      "text": "간다고? 가긴 어딜 가…… 이거나…… 받아라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 캐스터",
      "text": "이런…… 내 아츠마저 시전할 수 없다고……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "헤헤, 소라의 실력은 거기서 끝이 아니야! 소라, 좀 더 신나게 해줘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "응, 알았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "소라 씨…… 정말 당신이야? 하지만 당신이 어떻게 여기에 나타날 수가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "지금이야! 간다앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "당황한 용문 시민",
      "text": "당신들, 도대체……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "빨리 이곳에서 떠나!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "뭘 또 고민하고 있노…… 빨리 가라! 뛰라! 계속 뛰라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "♪~♪~♪~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "(어라? 저 사람은……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "곤경에 빠진 용문 시민",
      "text": "(아…… 안 돼. 지금 이런 모습을 보여줘선 안 돼……!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "텍사스 언니야, 근위국 애들이 인제 막 도착할 기다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "알았어. 엑시아, 소라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "아, 네……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이때를 틈타서 후퇴하자! 바이바이!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……저 사람.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "아마도…… 아니, 분명히 만난 적 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……그 사람인가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "용문에서의 첫 팬 미팅 때 처음으로 편지를 줬던 사람.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "편지 한 통 이후로 갑자기 어떤 활동에도 참여하지 않던 여자아이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "내가 첫 번째 팬의 얼굴을 잘못 기억하고 있을 리가 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "하지만, 왜…… 슬럼가에 있는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그리고 팔에 보이는 오리지늄 결정은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그 아이…… 감염자가 된 건가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "며칠 뒤\n펭귄 로지스틱스 사무실"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "흐아암…… 졸려 죽겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어, 소라, 너 여기 있었네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "앗…… 엑시아, 크루아상이네. 오늘 연습은 이미 끝났어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그래, 그럼 우리 같이 외출하지 않을래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "엊그제 근위국을 좀 도와줬잖아. 근위국에 가서 '용문의 친절한 조직' 상장을 받으라는 통지를 보스가 받았나 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "근위국 정문 앞에서 폼나게 사진 한 장 딱 찍으면, 앞으로 누구도 내 차를 막을 수 없을걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "아이다. 그래도 엑시아 언니야 차를 막아 세울걸…… 근데 사진 있으면 내 사업자등록증을 볼라고 하진 않겠다야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "네 개인 사업도 조사당할 때가 됐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "헤헤, 쪼마난 가게다. 쪼마난 거.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "소라 니 뭐하노? 어, 이건…… 편지 아이가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "응. 이건…… 팬이 쓴 편지야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "맞다. 니 처음 왔을 때 펭귄 로지스틱스 문 앞에 선물이 억수로 쌓여 문 열기도 힘들었다 안카나. 우편함도 편지가 미어터질 지경으로 가득 찼고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "하하…… 너희들 먼저 가. 나는 텍사스 씨를 기다렸다가 같이 갈게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그래. 그럼 차 키는 남겨둘게. 난 크루아상 차 타고 먼저 간다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "개안타, 엑시아 언니야를 내가 제시간에 안전하게 데꼬 갈 기다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "겨우 얻은 명예시민이 될 기회니까 늦으면 안 돼!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그래…… 후우.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "(……이 사람일 거야.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "(이 편지의 필적과 문체…… 똑똑히 기억하고 있어.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "(그때…… 팬 미팅 때도 있었던…… 내 첫 번째 팬……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "아…… 날 기다린 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "소라?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "네? 아, 죄송해요, 텍사스 씨. 제가 잠깐 딴생각을 했네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "괜찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……무슨 일 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "아, 아니요…… 별일 아니에요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "텍사스 씨…… 며칠 전에 저희가 슬럼가에 가서 도와줬던 사람들은…… 모두 감염자인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "아직도 신경 쓰여?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "혹시 거기 아는 사람이라도 있었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "확실하진 않은데 그냥…… 아마도 한 번 만난 적이 있을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "진짜 걔라면 거기에 있을 이유는 그거 하나밖에 없잖아요. 걔는 원래…… 그런 데서 사는 애가 아니거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "편지는 봤어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "편지요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "오늘 오전 중에, 근위국 통지와 함께 온 거야. 며칠 전 우리가 구출해낸 시민들이 보낸 감사 편지 같았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그 감사 편지들 때문에 우리가 이번에 용문에서 수여하는 상장을 받을 수 있게 된 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "손에 들고 있는 거, 그 감사 편지 아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "아, 이건…… 예전에 팬이 쓴 편지예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "팬레터야? 그걸 지금 꺼내 본다는 건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "어…… 아무것도 아니에요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "텍사스 씨, 정말로 아무런 특별한 일도 없었어요. 그냥 갑자기 보고 싶었을 뿐이에요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "같이 근위국에 갈까? 운전은 내가 할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "네…… 같이 가요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그럼 가자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……텍사스 씨, 만약에, 진짜 만약에 말인데요. 감염자가 된 용문 시민에게는 다른 삶의 방식이 있을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "생각나는 건 두 가지 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "용문을 떠나거나, 아니면 슬럼가에 가거나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……네. 그 외에 다른 방법이 없다는 건 저도 알고 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "텍사스 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "제가…… 앞으로 혼자서 택배를 배달할 수 있을까요? 다른 사람을 귀찮게 하고 싶진 않아요…… 펭귄 로지스틱스의 일원으로서 저도 모두와 같은 일을 하고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "자신을 지킬 수 있겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "지, 지킬 수 있어요……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그걸 증명해 낸다면 막지는 않을게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "네. 고마워요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……전 언제나 텍사스 씨에게 고맙다는 말만 하네요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "일주일 후\n용문 슬럼가 모처"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "안녕하세요. 누구 없어요? 택배 왔습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "……누구?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "안녕하세요. 펭귄 로지스틱스 사이트에서 주문하신 물건 배송하러 왔습니다. 수령 부탁드려요~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "택배는…… 그냥 문 앞에 두면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……어, 죄송하지만 서명 좀 해주실 수 있을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "내, 내가 나가기가 좀 그래……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "네? 혹 도움이 필요하신 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "그게 아니라…… 별로 나가고 싶지 않아…… 다, 당신은 일반적인 택배원이잖아…… 하지만 난…… 광석병 환자라서…… 당신에게 전염시킬 수도 있어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "펭귄 로지스틱스에서 물건을 주문할 기회를 줘서 너무 고마워. 하지만 전염될 수도 있으니 빨리 가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "저…… 선생님? 진정하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "저희는 감염자 고객님들과 오랫동안 안정적인 관계를 유지하고 있고, 광석병은 간단한 신체 접촉만으로는 전염되지 않아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "안심하세요. 펭귄 로지스틱스의 직원들은 전문적인 광석병 예방 훈련을 받았으니, 손님이 저에게 피해를 입히는 일은 없을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그리고 도움이 필요하시다면 저희가 바로 서비스를 제공해 드릴 수도 있어요. 저희는 전문적인 의약 회사와 협력 프로젝트를 진행한 적도 있어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "선생님, 괜찮으신가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "당신…… 정말로 내가 무섭지 않은 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "물론이죠. 펭귄 로지스틱스는 모든 고객님에게 따뜻한 서비스를 제공해드리는걸요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "……그래도 됐어. 그냥 문 앞에 두고 가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "잠깐, 나중에 시가지로 보내는 편지 배송을 부탁할 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "물론 가능하죠! 펭귄 로지스틱스에는 우편 배송 서비스도 있거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "하아…… 그래. 몇몇 사람들에게 내 근황을 알려야 하거든. 그 사람들이 나에게 답장을 하길 원한다면 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……선생님, 괜찮으시다면 제가 대신 연락해 드릴 수도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "아니야. 역시 됐어. 그냥 나랑 멀리 떨어져 줘. 지금 머리가 너무 복잡해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가 주민",
      "text": "잘 가. 다음에도 잘 부탁할게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……걔가 아니었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "오늘도 못 만났네…… 어쩌면 이미 용문을 떠나버렸을 수도 있고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "아니면 내가 잘못 봤을 수도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "하지만 펭귄 로지스틱스에 보내준 감사 편지랑 팬으로서 보내준 편지의 필적이 똑같았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "상세한 주소도, 이름도 남기지 않았었지. 그저 간단한 감사 편지였을 뿐이지만, 난 그게 너라는 걸 알아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……보고 싶어. 단 한 번만이라도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "너도 날 보고 싶어 할까? 난…… 지금 너를 만나도 되는 걸까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "나에겐 꼭 하고 싶은 말이 있고, 그걸 너에게 직접 말해주고 싶어. 꼭 힘내고 희망을 가지라고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……내일, 내일도 오자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "15일 뒤\n용문 슬럼가, 배달 도중"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "택배 왔습니다! 집에 계신가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "안녕하세요. 펭귄 로지스틱스 사이트에서 주문하신 물건 배송하러 왔습니다. 서명 좀 해주세요~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "저기요, 아무도 안 계신가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(이를 악문다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "음, 고객님이 적어주신 배달 시간은 지금인데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "안녕하세요. 정말 아무도 안 계신가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(부들부들)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……소라의 목소리야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "(이 집이 맞을 텐데…… 집에 안 계신 건가?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "일단 문 앞에 두고, 배송 정보 확인…… 됐다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "소라는 무심코 주머니에 손을 넣어, 천천히 편지 봉투를 꺼내 들었다.\n접었던 흔적이 잔뜩 남아있는 오래된 편지 봉투에는 '소라 씨에게'라고 적혀 있었다.\n편지 봉투 안에는 몇 번이나 비교했던 편지와 소라가 이미 마음에 새겨둔 글자들이 들어있었다.\n그건 소라에게 감사를 표하는, 소라를 안심시키는, 그러면서도 그리움이 묻어나는 글자들이었다."
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "도저히 찾을 수가 없네. 분명히 전에 이 근처에서 널 봤었는데…… 지금은 정말 여기에 살지 않는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "나는 여전히…… 네가 보고 싶어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "방 안에 있는 사람은 손을 꼭 쥐었다.\n그러나 문은 여전히 열리지 않았다."
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……하지만, 상관없어. 언젠가는 만나게 될 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "후, 됐다. 다음 배송지는……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……이젠, 갔겠지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "(허리를 굽힌다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "(택배를 집어 든다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "……고마워, 소라 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "그 편지도 받았나 보네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "……정말 다시 한번 보고 싶어. 하지만 지금 내가, 내 몸이, 내 병이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "언젠가 내가 다시 나 자신과 마주할 수 있게 된다면, 소라 씨도 분명 기뻐해 주겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "나…… 꼭 다시 소라 씨의 콘서트도, 팬 미팅도 참석할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬럼가의 감염자",
      "text": "언젠가는.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
