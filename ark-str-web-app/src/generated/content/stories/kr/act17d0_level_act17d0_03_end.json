{
  "server": "kr",
  "storyId": "act17d0_level_act17d0_03_end",
  "groupId": "act17d0",
  "stageId": "act17d0_03",
  "title": "안전가옥 공방전",
  "storyCode": "OD-3",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act17d0/level_act17d0_03_end.txt",
  "sourceHash": "447a5db90449d0fdc104b2a04960210220d1f16a2c5fe4cf1ba5dce2b8310ec3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "천둥이여, 울려라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "용병",
      "text": "아아아악……! 내 눈!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "캐스터는 어디 있지?! 저 와이번을 처치해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "어림없는 소릴.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "한 놈이 아니었나?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "어떻게 된 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "상황이 좋지 않군. 저들의 화력이 예상을 뛰어넘었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "손실을 줄인다. 후퇴하라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "……거기 있었군……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "아악!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "저격수다!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "제길, 어디지?!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "놔둬! 그냥 물러나라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "……놓치지 않는다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "text": "으윽……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "용병",
      "text": "후퇴해라! 어서! 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "놈들이 물러난다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "상황 보고해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "알렉산드르, 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그래, 살짝 긁힌 것뿐이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "저놈들, 점점 교묘해지고 있군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "아직 경계를 늦추지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "손님이 왔다. 그것도 처음 보는 손님이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……충분히 가까이 온 거 같은데, 손님들?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "도와준 건 고맙지만 각자 무슨 사정인지 알기 전까지는, 그쪽이나 우리나 거리를 유지하는 게 좋지 않겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "워워~ 진정해. 그쪽을 공격하려 온 건 아니니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "우린 로도스 아일랜드 현장팀이야! 그리고 너희는 지금 로도스 아일랜드 안전가옥을 무단 점거하고 있고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "우린 구조 요청을 듣고 온 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그러니, 너희도 신원을 밝혀줘야겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "우린 도와주러 온 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "로도스 아일랜드 사람들인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "이야, 지원이 정말로 왔네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "오크픈 데려와.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "라져.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "오크픈",
      "text": "로도스 아일랜드 오퍼레이터? 만세! 살았다! 우린 살았어!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "오크픈",
      "text": "간단히 말하자면, 그렇습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "이 임시 방어 진지를 구축한 자들이 거기 있는 네 명의 용병인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오크픈",
      "text": "정말 죄송합니다. 놈들이 통신기를 부쉈고, 전 안전가옥을 지킨다는 제 의무도 다하지 못했습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오크픈",
      "text": "이 자리에서 당장 해고되어도 뭐라 변명할 여지가 없습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "걱정하지 말게. 이 늙은이는 누굴 해고하고 말고 할 권한 자체가 없으니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "거기다 이렇게까지 홀로 오래 버텼다니, 오히려 존경받아야 마땅해 보이네만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "자네가 없었더라면 감염자들은 더욱 암울한 처지에 놓였을 테니 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "그래서, 감염자는 모두 얼마나 되나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "밖에 있는 의사를 포함해서 43명이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그리고 저 네 명의 용병이 지금까지 계속 지켜줬던 거고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "오로지 감염자를 지켜주기 위해 싸우는 용병이라. 정말 보기 드문 이들이구먼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "거기다 감염자를 깔보지도 않고 오히려 적극적으로 도와준다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "나만 이렇게 느끼는지 모르겠지만, 어디 무슨 성자들이 갑자기 나타난 줄 알았다니까요? 무슨 동화 속 이야기도 아니고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "그들은 우리와 시각이 아예 다른 것 같았네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "얘기를 들어보니 자신들은 그저 무고한 마을 사람들을, 평범한 민간인을 구했다고 여기는 것 같더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "감염자라고 차별하지 않는다기보단……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "광석병 자체를 신경 쓰지 않는 것 같네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "하지만 감염자가 아닌 거 같던데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "저런 용병은 처음 봅니다. '레인보우 팀'에 관한 이야기 또한 들어본 적이 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "총을 갖고 있지만 그 누구도 산크타처럼은 안 보였고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "산크타가 빛나는 형광등을 숨기는 법을 알아낸 게 아니라면 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "산크타도 아닌 용병 무리가 커다란 총기로 완전히 무장한 채 돌아다닌다는 소식이 알려지면 어떻게 될지 상상해 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "블랙스틸 연구개발팀에서 들으면 아주 뒤집어지겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "……당사자들 뒤에서 수군대는 건 이쯤 하도록 하죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "게다가 그들은 로도스 아일랜드 오퍼레이터를 구하고 수많은 감염자를 지켜주지 않았나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "이에 반하는 증거가 나오지 않는 이상, 그들의 동기는 의심하지 않도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "현재 우리의 최우선 과제는 이 상황을 해결할 방법을 찾는 것이니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "저들과 한번 이야기를 나눠 보도록 하세.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "오래 걸리는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "로도스 아일랜드라…… 어떤 것 같아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "나도 계속 궁금했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "대체 어떤 제약회사길래 일반 거주지 가장자리에 군용 장비를 가득 채운 안전가옥을 세우지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "그것도 소대 전체를 무장시키고도 남을 무기랑 폭발물을 보관하기까지 하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "게다가 '제약회사' 직원이라면서, 다 무슨 특수부대원 같잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "이 세계에서 의사가 되려면 이 정도까지 무장을 해야 하거나, 이름만 제약회사인 거겠지. 내 생각엔 둘 다인 거 같지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "저자들은 무장했지만 잘 훈련된 것 같고, 대화도 통해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "전에 우리가 만났던 강도와는 천지 차이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "그리고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "나만 그런지 몰라도, 저자들이 왠지 친숙하게 느껴져.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "실은 나도 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "이성적이고, 교양도 있어. 지금까지 난 이 세상이 무법자와 도적으로 가득한 포스트 아포칼립스 지옥인 줄 알았는데 말이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "처치 다 끝났어요, 알렉산드르 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "고맙다, 의사 선생.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "미아로우, 로도스 아일랜드라는 조직을 잘 아나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "……상단 사람들이 하는 얘기를 들어본 적은 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "로도스 아일랜드는 감염자 치료와 광석병 연구가 전문인 회사예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "하지만 광석병은 불치병이라며?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "한때 광석병을 치료할 수 있다고 주장하는 사람들이 많이 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "대부분은 사기인 게 들통 나 망해버렸지만요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "거기다 실제로 좀 듣는다 싶은 의약품도 거의 다 증상을 일시적으로 억제할 뿐인 효과를 과장했던 거였어요. 그리고 그런 억제제의 경우에도 매우 비싸죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그럼 그렇지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "들은 얘긴데, 어느 아미르의 딸이 광석병에 걸리자, 아미르는 딸을 살리기 위해 어마어마한 액수를 지불하고 컬럼비아에서 증상 억제제를 구매했다고 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "수년 후에, 아미르의 돈이 바닥나자 딸은 광석병으로 인해 괴로워하며 죽었고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "하지만 보세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "이건 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "이건 안전가옥에 배치되어 있던 광석병 억제제예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "요 며칠 동안 병세가 위중한 사람들에게 이런 약을 주사했더니 확실히 억제 효과가 있었어요. 게다가 약효도 제가 여태까지 봐 왔던 제품보다 더 뛰어나고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "이 약은…… 분명 엄청나게 비싸겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "하지만 오크픈 씨는 전혀 개의치 않았어요. 상태가 심각한 환자가 있다고 말했더니 선뜻 약 상자를 내어줬죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미아로우",
      "text": "이 세상에 선한 사람들이 한 명도 없다고 믿는 건 아니지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "헤이, 우리 앞에 두고 그런 말 하기 있어 없어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "너무 깊게 생각하지 마. 의심하면 오히려 손해야. 대놓고 의심하든 숨기든, 의심을 가지면 거래에 도움이 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "저들의 목적이 우리와 같을 가능성이 높으니, 궁금한 점과 원하는 것만 협상 테이블에 올려놓고 논의하면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그렇게 말한다면야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "오, 드디어 왔군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "기다리게 해서 미안하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "겉치레는 생략하도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "오크픈을 구해줘서 고맙네. 자네들이 아니었다면 로도스 아일랜드가 충직한 오퍼레이터를 잃었을 걸세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "임무가 마무리되면 이에 관해 보고서를 작성할 테니, 로도스 아일랜드에서 자네들에게 적절한 보수를 제공하고 이 임무로 입은 손해를 배상할 걸세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "보수라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "보수 좋지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "게다가 자네들은 감염자를 위해 목숨을 걸었지 않나. 이 늙은이는 그 점에 진심으로 경의를 표하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "마을 사람들은 우리가 머무는 동안 많은 도움을 주었습니다. 그런 이들을 죽게 내버려 둘 수는 없었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "그럼 너희들은 용병인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "아니…… 우리는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "그래 맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "우린 용병이야. 그것도 몸값이 아주 비싼 용병이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "소속 회사 이름은? 너희 같은 용병은 흔치 않거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "어…… 우린…… 음……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "(러시아어) 이름 좀 생각해 봐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "(러시아어) 폴라베어 로지스틱스?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "대답할 권한이 없다고 해도 이해할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "우린…… 우린 그러니까, 머나먼…… 남쪽 나라 출신이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "그래! 저 아래 남쪽 출신이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "남쪽? 사르곤 남쪽 말인가??",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "푄 고온지대 너머라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "……푄? 어, 남쪽. 남쪽 맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "푄 고온지대 너머에 나라가 있다고??",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "정말…… 놀랍군. 내 살면서 그 아래에 사람이 산다는 이야기는 처음 들었네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "역대 아미르의 기록에서도 고온지대를 넘어온 자에 관한 이야기는 단 한 번도 보지 못했고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "(러시아어) 좀 더 그럴싸하게 지어내지 그랬어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "(러시아어) 폴라베어 로지스틱스는 그럴싸하고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "어찌 되었건, 우르수스어와 빅토리아어 억양을 쓰는 전사들이여, 출신은 중요치 않다네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "자네들은 감염자를 위해 기꺼이 싸우고자 하지. 그 점은 우리도 마찬가지라네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "지금으로서는 서로 협력하며 현 상황에 대처하는 게 어떻겠나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "저도 동의합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "그럼, 이 마을에서 정확히 무슨 일이 있었는지 전부 말해주게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "살카즈 용병들……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "괴물을 조종하는 자들은 분명 캐스터일 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "살카즈 용병은 조직적으로 움직이며 단련된 이들입니다. 그리고 무엇보다도 더 큰 피해를 막으려면 언제 물러서야 할지 잘 알죠. 단순히 약탈을 벌이러 온 게 아닐 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "쟤넨 다 컬럼비아산 장비로 완전 무장했네. 전에 안전가옥을 덮쳤을 땐 꽤 잘 싸우는 녀석들도 몇 명 있었는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "저 장비와 전술, '레드마크 컨트랙츠'의 전문 용병들이겠군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "아무래도 이 지역 아미르를 상대로 반란을 일으킨 것 같구먼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "하지만 왜 민간인을 공격하는 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "놈들은 마을 감염자 구역에서부터 여기까지 우릴 추격해왔습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "그 용병들의 진짜 목적은 뭐죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "너희 입을 다물게 하려는 거겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "그뿐만은 아닌 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "그렇다면?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "어제 놈들이 감염자 구역을 공격했을 때, 분명 감염된 마을 사람들을 노리고 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "감염자들을 모두 잡아가려고 했다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "그게 놈들의 진짜 목적이 분명해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "감염자를…… 납치한다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그건 말이 안 되는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "아직 적의 진정한 목적이 무엇인지 알 수 없네만, 지금 우리가 집중해야 하는 건 그게 아닐세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "지금으로서는 기다리는 게 최선의 방법이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "기다린다고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "당장은 현재 일어난 일, 즉 사실만 두고 판단해야 한다는 걸세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "우린 완전히 무장한 상태로 아미르의 허가도 없이 그의 영토에 발을 들였다네. 이는 아미르의 계명과 이 지역 법률을 어긴 것이지. 사르곤의 주요 금기를 어긴 셈이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "비록 이 지역의 아미르 가문이 현재 분쟁을 겪고 있긴 해도, 엄연히 이곳의 지배자일세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "이곳저곳 들쑤시고 다니면 상황이 더욱 나빠질 뿐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "다만, 이 지역 아미르는 감염자 구역을 만들었지. 이는 곧 무자비한 폭군은 아니라는 뜻일 터.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "게다가 로도스 아일랜드가 이곳에 안전가옥을 건설하도록 허가하기도 했어. 고립주의자도 아니라는 의미겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "분명 우리를 공정하게 대해줄 걸세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "국법…… 지역 정부…… 알겠습니다. 그게 현재 우리가 바랄 수 있는 최선이겠군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "상황이 변하기 전까지는 이 안전가옥에 머물며 난동이 가라앉기를 기다립세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "자네도 우리와 뜻을 같이해주었으면 좋겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "문제없습니다. 우리도 로도스 아일랜드의 전문 지식이 필요합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레인저",
      "text": "잘 됐군. 자네들 네 사람과 합을 맞추는 날이 기대되는구먼.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
