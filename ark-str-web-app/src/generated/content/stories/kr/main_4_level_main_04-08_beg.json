  "sourceHash": "2bc22b1177fd4b00499a917cc4f4b126733a9085468f632344217e11f1bef9a2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "어라?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "여기는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프로스트리프 씨가 보내주신 좌표에 거의 다 온 것 같아요. 그런데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "기분 나쁜 냄새가 나네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "뭔가 그을린 냄새 같은데…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "리유니온은 대체 우리를 어디로 유도하려는 걸까요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…! 피하세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "크읏!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 캐스터",
      "text": "비, 빗나갔나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "괜찮아, 어쨌든 여기는 안전하니까!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 캐스터",
      "text": "으윽…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "이, 이봐. 왜 그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 캐스터",
      "text": "으, 으윽… 으악…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "이제 대답할 수 없을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "뭐, 뭐지!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저 건물 안에서 소리가 났어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "잠시만… 저건 설마…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프로스트리프 씨! 프로스트리프 씨 맞죠?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그래, 나다. 적은 처리했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "걱정을 끼쳤네, 아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "크윽…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "상처를 입으신 건가요?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "메딕 오퍼레이터, 빨리 치료해주세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…무슨 일이 있었죠? 프로스트리프 씨도 동상에 걸리셨네요? 다른 분들은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "괜찮아, 살짝 스친 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "메테오라이트와 제시카는 아직 광장에 있을 거다…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "지금은 괜찮지만, 길게 끌면 끌수록 문제가 심각해지겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "내가 적의 시선을 끌어 두었으니 아직 메테오라이트와 제시카가 어디 있는지는 눈치채지 못했을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그렇다면 적은 지금 어디에 있죠…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "우리는 발견되기 어려운 곳에 있으니 걱정할 필요는 없지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "슬슬 녀석들이 이 주위로 들이닥치겠지…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "꼬마 여우야, 어디 숨었니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "빨리 나오렴~ 술래잡기는 끝났다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "나오는 시간이 1분씩 늦어질 때마다, 네 친구 손가락을 하나씩 꺾어 버릴 거야~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그래도 계속 도망칠 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(메피스토…!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "(허세 부리는 거다, 진정해.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(저 사람은 대체 무슨 짓을…)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "리유니온은 사라졌나 보군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "메피스토…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "우선 메테오라이트 씨 일행에게 연락을…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "오염 지대에서 벗어났을 텐데, 왜 통신이 안 되죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "이걸 한번 봐라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이게 프로스트리프 씨의 통신기인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "왜 얼어붙어 있죠? 혹시… 그래서 고장이 난 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "메피스토는 들러리 같은 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "이 버려진 도시에는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그보다 훨씬 무서운 존재가 돌아다니고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "무서운 존재요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "눈의 악마들 말이야. 녀석들과 마주치게 되면 위험해질 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "눈의 악마? 설마 그 눈의 악마 소대 말씀이세요? 대체 그들이 누군데요…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "설명하자면 길다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "하지만 모든 구역에 걸친 기온 하강, 동료들이 입은 피해… 모두 그놈들 짓이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그 리유니온 부대가 버려진 도시를 자기 세력권에 넣으려는 모양이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "하늘이 어두워졌어요. 어쩌면 기회가 온 걸지도…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "더 철저하게 몸을 숨기고, 일단 이곳을 벗어나도록 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "가요, 서둘러서 메테오라이트 씨네 팀을 구해야죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "길 안내는 내가 맡겠다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "광장에 있는 저건… 뭐죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "무슨… 조각상 같은 건가요? 모양이 이상하네요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "냄새 때문에 토할 것 같아요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "이쪽이야, 딱 붙어서 오라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "저건…… 안 보는 게 나아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…적이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "소리 내지 말고 조용히 처리하자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
