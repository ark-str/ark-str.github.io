  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "실론",
      "text": "서둘러요! 해변 쪽으로 도망치죠!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "실론",
      "text": "해변에는 관광객들이 몰려있으니 인파 속에 숨으면 쫓아올 수 없을 거예요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "경호원",
      "text": "거기 서십시오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "실론",
      "text": "순순히 잡혀주진 않겠어요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "슈바르츠",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "어, 너는……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "실론",
          "text": "슈바르츠! 다행이야. 와줬구나!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "실론",
          "text": "네가 있어서 다행이야. 크로닌 씨는 대체 왜 저러는 거지!?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "실론",
          "text": "박사, 이쪽이 바로 제가 전에 말했던…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "슈바르츠",
          "text": "아가씨, 주인님께서 여기 안 계신 동안은, 크로닌 님의 말을 들어야 합니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "실론",
          "text": "슈바르츠, 무슨 소리야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "슈바르츠",
          "text": "저와 함께 크로닌 님께서 계신 곳으로 돌아가시죠. 저 사람들도 크로닌 님께 넘기시고요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "슈바르츠",
          "text": "아가씨에게까지 손을 대고 싶진 않습니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "실론",
          "text": "……슈바르츠?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
