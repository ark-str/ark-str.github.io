{
  "server": "kr",
  "storyId": "story_ethan_set_1_story_1",
  "groupId": "story_ethan_set_1",
  "stageId": null,
  "title": "타향의 옛 친구",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_ethan_1_1.txt",
  "sourceHash": "2861c9aa9003322cb1f5037dd1c12cac267c57ba3d60eedcfa536311a99cc893",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 伊桑"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그래, 왔어?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "기다리게 해서 미안, 오니 누님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "언제 도착한 거지? 어제?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "응…… 전달자의 수송 부대와 함께 왔지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "로도스 아일랜드의 전달자는 네가 지난달에 출발했다고 하던데, 어째서 오늘 도착한 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "길에서 감염 생물을 만나는 작은 소동이 있었거든. 그래도 운이 좋아 잘 해결했지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "무사하다니 다행이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그래서 네가 먼 길을 달려온 이유가 이것 때문이라는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "자, 네가 찾던 자다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "늘씬한 체구의 경관이 왜소한 체격의 사브라에게 두툼한 서류를 건넸다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "앗, 고마워. 어디 보자……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이자가 확실한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……응, 틀림없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "여러 사람을 찾는 것 같던데, 리 탐정사무소에도 의뢰한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "네게 그자는 어떤 사람이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "친한 친구랄까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "다시 한 번 확인해, 정말 그자가 맞아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "몇 번을 묻는 거야. 맞다니깐 그러네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너, 문제의 심각성을 아직 모르는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그자가 네가 말한 '케빈'이라면, 이번 일이 얼마나 골치 아플지 너도 모르진 않을 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "알지 물론, 모를 리가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "하아…… 첸도 하여간…… 늘 날 가만 놔두지 않는다니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "용문에서 로도스 아일랜드의 입장이라는 게 꽤 미묘하지. 네가 찾으려는 그자의 정체 역시 한 마디로 설명하긴 어려워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "민간 사무소의 사건이라고 하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "만일 무슨 문제라도 생기면 내가 많은 책임을 져야 해. 그건 알고 있겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "알다마다요, 오니 누님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "이 일은 개인적인 의뢰야, 로도스 아일랜드와는 상관없어. 그러니 안심하라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "캄!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "네, 호시구마 경감님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이쪽은 캄 경관, 오늘 널 도와줄 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "잘 부탁해, 캄 경관님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "(고개를 끄덕인다.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "무슨 일이 있거든 즉시 보고해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "고마워, 누님. 신세 좀 질게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "신중하게 행동해, 사고 치지 말고. 일만 보고 최대한 빨리 나오도록 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "네~ 네~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "로도스 아일랜드의 첩보원이라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "그러고 보니 첸 팀장님은 잘 계시나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "말하기 곤란하면 대답하지 않아도 돼, 그냥 안부를 묻는 것뿐이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……아, 그 첸 씨랑은 잘 아는 사이가 아니라서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "로도스 아일랜드에서 바쁜 것 같던데, 별다른 문제는 없어 보이고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "그렇다니 다행이로군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "여기다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "왜소한 체구의 사브라가 거리를 쓱 둘러보았다.\n그곳엔 습격과 전쟁의 흔적이 아직도 도시 곳곳에 남아 있었고, 포화로 생긴 건물의 구멍을 한창 메우고 있는 중이었다. 파괴된 도로 위를 뒤덮은 시멘트는 채 마르지도 않은 상태였다.\n이른 아침의 거리는 여전히 시끌벅적했다. 낮은 건물 사이를 오가는 슬럼가 사람들, 장사꾼의 호객 소리와 길가의 공사하는 소리들이 이리저리 뒤섞여 있었다.\n이곳은 서서히 복구 중이다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "염국 공용어나 용문 사투리를 할 줄 아나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "알아. 조금 배운 적 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "일단 안에 들어가면 쓸데없는 말은 하지 않는 게 좋을 거야, 내 말대로 행동하도록 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "이곳 주민들은 외부인에게 그다지 상냥하지 않거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "그리고 함부로 돌아다녀서도 안 돼. 아무 골목에 들어가 제멋대로 돌아다니는 것도 곤란하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "도로도 아직 보수 중이고, 피해가 심한 건물들 역시 아직 철거도 못 한 상태야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "알겠으니 걱정 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "한 병에 3 용문폐! 단돈 3 용문폐! 시원~한 탄산음료 팝니다! 용문 최저가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "짐꾼",
      "text": "아호이, 한 병 줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "예, 여기 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "저자로군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "음료수를 파는 아호이, 여기서 저자를 부르는 이름이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……음료수를 판다고? 저 녀석이 장사까지 할 줄은 몰랐는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "길목 입구에서 기다리고 있으마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "이건 통신기다, 위험한 상황이 생기면 이걸로 호출하면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "꽤 비싼 거니까 조심히 다루도록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "오래 알고 지낸 사이니…… 그런 일은 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "그래도 조심해, 경거망동하지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "서우인이 얼마 남지 않아서 경찰들도 모두 바빠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "넌 이곳 사람이 아닌 데다 감염자 구역의 상황이 꽤 복잡하니 눈에 띄어 봤자 좋을 게 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "무슨 상황이 생겨도 주변의 경찰들한테서 즉시 도움을 받지 못할 수도 있다는 걸 명심해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "알았어, 알았다고. 절대 사고 안 칠 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "……휴…… 어쨌든 조심하는 게 좋을 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "시원~한 탄산음료가 한 병에 3 용문폐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……여어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "장사는 잘 돼?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "……너구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그래, 나야. 우리가 다시 만날 줄은 몰랐는걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "결국 찾아왔구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음료수 가게 주인",
      "text": "언젠가 이런 날이 올 줄 알았는데, 이렇게 빠를 줄 몰랐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "뭐야 그런 반응…… 의외인데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "오랜만이야, 케빈.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "네가 체르노보그로 간 뒤로 한 3년 못 봤던 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "예전에 무슨 일이 있었는지 모르겠지만,",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "꽤 잘 지내는 것처럼 보이는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……그럭저럭.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그럼 됐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "무슨 말이라도 해 봐, 지금 되게 뻘쭘한 거 알지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "우리, 예전엔 꽤 친했잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……유언 같은 건 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "뭐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산책 중인 노인",
      "text": "에헴……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "산책 중인 노인",
      "text": "내가 방해한 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……아, 아닙니다. 어르신, 간밤에 잘 주무셨나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님?",
      "text": "흐음, 목이 마르군. 시원한 걸로 한 병 주게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "아 네, 3 용문폐 받았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님?",
      "text": "나이가 드니 다리에 힘이 하나도 없구먼, 괜찮다면 여기에 좀 앉아도 되겠나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "괜찮습니다, 여기 앉으세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "푸흡!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "뭐야, 왜 웃는 건데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아니야, 너 이런 모습은 처음 본 것 같아서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "함께 떠돌아다니던 그땐, 넌 언제나 부랑자들과 한바탕 붙곤 했었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "예전의 너는 그다지 상냥한 타입은 아니었으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "그래서 날 비웃으러 온 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아니, 그런 뜻이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "여기 이 판잣집에서 지내는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "여긴 용문 슬럼가야, 대부분의 사람들이 이런 곳에서 살아가지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "예전의 떠돌이 생활에 비하면 그래도 비바람을 피할 곳은 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그래, 나쁘지 않은 것 같다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "걱정 없이 살아갈 수 있다는 것만으로도 우리 같은 놈들한테는 과분하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "저기……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "너 혼자야? 다른 사람들은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그때 그 일이 있고 나서, 무슨 일이 있었던 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "정말 알고 싶어? 아직도 궁금해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "다른 사람들은…… 다들 어떻게 됐어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "다 죽었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "이상해? 감염자는 결국 모두 죽게 되지. 전장에서 운 좋게 살아남더라도, 결국엔 어느 구석에 처박혀 죽기 마련이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "그래도 알고 싶다면 알려줄게. 모두 다 죽었어, 그것도 엄청 비참하게. 이제 됐어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "나, 난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "하고 싶은 말 다 한 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "뭐라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……한 판 붙을 거면 자리 바꿔. 여긴 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "붙다니? 그게 무슨 뜻이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "이곳 사람들은 모두 어렵게 살아가고 있어. 네가 여기서 날 죽이면 근위국 놈들이 또다시 길을 봉쇄하겠지. 다른 사람들한테 폐 끼치고 싶진 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……잠깐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "무슨 말인지 모르겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "날 죽이러 온 거 아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아니야, 잠깐만!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "내가 왜 널 죽이려 한다는 거지? 대체 무슨 말을 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "이럴 필요 없어, 이미 다 알고 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "넌 리유니온을 떠나 다른 곳으로 갔지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "제법 멋져 보이는 차림새를 보니 분명 괜찮은 곳에 간 거겠지. 안 그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "요즘 같은 때에 감염자가 풍족하게 지내기란 좀처럼 쉽지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "네가 지금과 같은 삶을 유지하려면 한 가지 걸림돌이 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "바로 우리 같은 사람들이겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "난 네 정체도, 네가 예전에 리유니온의 일원이었다는 것도 알고 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "내가 죽으면 네가 우리와 함께 나쁜 짓을 저질렀다는 걸 아는 사람은 없어질 테지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "(입을 굳게 다문다.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "언젠가 이런 날이 올 거라곤 예전부터 짐작하고 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "3년 전, 네가 리유니온을 떠날 생각이라고 말한 순간부터, 이런 날이 올 줄 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "어쨌든 감염자들은 오래 살지 못해. 다들 죽었다고. 난 내가 마음 편히 살아갈 수 있을 거란 생각은 꿈꿔 본 적도 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "(입을 굳게 다문다.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "왜 말이 없는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……1년 전.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "1년 전, 일부 리유니온 사람들이 용문에 남았다고 들었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그래서 지난 1년 동안, 난 있는 돈 없는 돈 다 써가면서 너희를 찾았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "너희들이 모두 무사하기를, 끝까지 버티기를 바라면서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아무래도 내가 쓸데없는 생각을 한 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "기다려, 날 죽이러 온 게 아니라는 게 정말 사실이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "대체 내가 왜……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "지난 몇 년 동안 네게 무슨 일이 있었는지는 잘 몰라. 하지만 난 널 줄곧 내 형이라고 생각했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "카시미어에서 굶고 있던 우리를 위해 네가 통조림을 훔쳐다 줬지. 결국 들켜서 두들겨 맞았지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "죽음의 황무지를 돌아다닐 때, 네가 팍키랑 같이 도적패를 상대해 준 덕분에 목숨을 건지기도 했고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "네겐 정말 감사하고 있어. 네가 아니었다면 난 이미 죽은 목숨이었을 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그게 바로 널 찾아온 이유이기도 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "근데, 지금은 좀 후회되네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "오는 게 아니었는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "이렇게 하자. 넌 계속 이렇게 지내도록 해, 그것만으로도 난 마음이 놓이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그리고 이거.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "이건 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "광석병 억제제, 위에 적힌 대로 먹으면 될 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "뭐라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그만 갈게, 잘 지내.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "잠깐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "기다리라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "미안하다, 내가 오해했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "사과할게, 내가 잘못했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "일부러 그런 게 아니라, 난 그냥……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "지난 몇 년 동안 많은 일을 겪으면서, 나도 모르게 의심부터 하는 버릇이 생긴 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지나가던 행인",
      "text": "아호이, 여기 시원한 놈으로 하나 줘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "예~ 갑니다 가요! 3 용문폐 받겠습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "케빈은 낡은 공업용 시술 장갑을 낀 채로, 등 뒤의 방에서 연노란색 음료수를 몇 개 꺼내왔다. 유리병을 꽉 움켜잡자, 유리병 표면에 순식간에 서리가 맺혔다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……오리지늄 아츠 다루는 법은 언제 배운 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "북쪽 땅에서 왔던 전사들 기억나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "걔네? 누구였더라…… 눈의 악마 소대?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "네가 떠나고, 난 사람들과 함께 공수부대병에 들어갔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "꽤 오랫동안 눈의 악마 소대원들이랑 함께 행동했지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "이것도 그 사람들한테 배운 거야. 오리지늄 아츠를 다루는 재능 같은 건 없어서 음료수를 얼리는 게 고작이지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "모두 좋은 녀석들이었지. 프로스트노바 누님도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "하지만 모두들 결국엔 죽고 말았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그러니까 다른 사람들은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "팍키는 용문으로 오다가 목숨을 잃었어. 알다시피 광석병 증세가 제일 심했으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "왈츠는…… 다른 사람을 지키다가 용문 부대원의 손에 목숨을 잃었고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "내가 살아있는 건, 순전히 운이 좋아서였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "제트팩이 고장 나는 바람에 시가지 전투에서 쓰레기 회수구로 떨어졌지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "정신을 차려보니 전투가 끝났더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "가장 우스운 게 뭔지 알아? 나를 구한 게 용문 슬럼가의 부랑자였다는 거야. 쓰레기를 뒤지다가 날 찾아낸 덕분에 살 수 있었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지나가던 소녀",
      "text": "아호이 오빠, 음료수 한 병 주세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "자~ 여기 있다, 한 병에 3 용문폐란다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "케빈이 몸을 돌리더니 음료수 몇 병을 더 꺼냈다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "사람들을 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "모두 평범한 사람들이야. 감염자도 여기에 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "모두들 저만의 삶을 살고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "하지만 그때의 나는 이런 사실은 생각해 보지도 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "무기를 들 때면 감염자를 위해 싸우고 있다고 생각했지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "지금 돌이켜 보면 난 그저 무기나 휘두르는 폭도에 지나지 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "결국에는 그동안 내가 뭘 해 왔는지 나 자신도 모르겠더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "지금 보니, 너야말로 모든 것을 깨달은 사람이었더라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "사실 나도 다 아는 건 아냐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "내겐, 웅대한 포부나 꿈같은 건 없다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그저 배부르게 먹고, 편히 쉴 수 있는 곳이 있는 그런 삶이 내가 원하는 전부일 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "하지만 난 다른 사람 집에 쳐들어가서 사람들을 억지로 끌어낸 것도 모자라, 그 사람들한테 폭력을 휘둘렀지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아무리 내가 감염자라고 해도, 생존을 위해서라지만…… 그 일은 받아들일 수 없었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그럴듯한 말 따윈 할 줄 몰라, 하지만 그게 잘못됐다는 것만은 똑똑히 알고 있었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그래서 리유니온을 떠난 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "하지만 아까 말한 대로, 네가 아직까지 살아 있어서 정말 다행이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "이만 가 봐야겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "가려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "응…… 사실 나도 일하는 도중에 몰래 빠져나온 거라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "네가 준 약……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "이거…… 다 합치면 얼마나 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "신경 쓰지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "시중에서 파는 게 아니니까, 다른 사람 몰래 너만 먹어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "……잠깐만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "자, 가져가. 다 내가 직접 만든 음료수야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "정말 고맙다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "앞으로 다시 보긴 어렵겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케빈",
      "text": "잘 지내.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "너도…… 잘 살아라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "빨리 돌아왔군, 이야기는 다 한 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "뭐…… 그렇다 할 수 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "그렇군, 경감님께 자세히 보고하도록 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님",
      "text": "으음? 캄 경관 아닌가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "……안녕하세요, 어르신.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님",
      "text": "아침 일찍부터 근무하느라 수고가 많구먼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님",
      "text": "자넨 아호이를 찾던 그 청년 아닌가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아, 네 뭐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님",
      "text": "무슨 일인지 모르겠지만, 아호이는 좋은 녀석이니 괜히 괴롭히지 말게나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 영감님",
      "text": "다들 바쁜 것 같으니 늙은이는 그만 가도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "……살펴 가십시오, 어르신.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "저분은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "쓸데없는 거 묻지 말고 그만 가지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "왜소한 체구의 사브라가 고개를 돌려, 마지막으로 한 번 더 거리를 쓱 둘러보았다.\n전쟁과 충돌이 이곳에 남긴 상처는 조금씩 아물고 있었다.\n시간이 흘러 그 흔적 역시 용문의 일부가 될 것이다. 좀 더 아득한 역사처럼.\n파괴된 길가에서, 사람들은 살아가기 위해 발버둥 친다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "끝난 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "다 끝났어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "별문제 없어, 리유니온과도 더는 관련 없어 보였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "리유니온의 케빈이 아니라, 지금은 음료수를 파는 아호이라는 이름으로 살고 있더라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그래, 괜히 복잡한 것보단 단순한 편이 좋지. 이 일은 이렇게 마무리하도록 하자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "캄!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "네, 호시구마 경감님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 사건은 여기서 종료한다. 서류 보고를 부탁하마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "그러니까 사건의 결론은……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "일반 감염자일 뿐 특이한 점은 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "다른 파일에 기록해 둘까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아니, 괜히 긁어 부스럼 만들지 않는 게 좋아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "캄 경관",
      "text": "……알겠습니다. 그렇게 진행하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그리고 이거, 가져가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "이건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너에 관한 조사 보고서다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "근위국에서 날 조사한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "내가 용문근위국의 경감인 이상 본업은 성실히 해야겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "용문의 평화는 어렵게 이뤄졌어. 그래서 이 사건은 철저히 조사해야 했다. 그것이 로도스 아일랜드라고 해도 마찬가지야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "하지만 이건 내 개인행동일 뿐 근위국과는 아무런 관계도 없다. 이 보고서에 담긴 내용은 존재하지 않는 것이라 여길 생각이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그 사람은 용문의 시민 아호이, 넌 로도스 아일랜드의 오퍼레이터 에단일 뿐이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그게 다다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……고마워, 오니 누님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아니 근데 왜 날 그렇게 부르는 거야? 나랑 그렇게 친한 사이도 아니잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아, 미안 미안…… 고마워, 호시구마 경관.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아, 아니…… 경감.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "참, 로도스 아일랜드에 돌아갈 방법은 있는 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "어. 다음 주에 사무실 차 타고 돌아갈 건데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그렇군, 그렇다면 배웅은 안 한다. 박사님이랑 첸한테는 대신 안부 좀 전해주고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "알았어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "2주 뒤……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "흐음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "(여기에 두자.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미드나이트",
      "text": "흠? 이게 뭐지? 탄산음료?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미드나이트",
      "text": "오늘 메뉴에 탄산음료가 있었던가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "아, 그거 내가 가져온 거니까 마셔도 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미드나이트",
      "text": "좋아, 그렇다면 사양 않고 마시도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스팟",
      "text": "예의란 걸 밥 말아 먹었나…… 한 번쯤은 거절이란 걸 하라고 쫌.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "괜찮아 괜찮아, 이거, 친구한테 받은 거거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "그냥 평범한 친구한테서 받은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에단",
      "text": "……음료수일 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
