  "sourceHash": "4dc290953d29fdb36720d237af6b6983962d9e6c5a1058034d717735fd5018f2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "5下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "정오차 한 잔.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "알았어. 편히 쉬고 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "그런데 오늘은 왜 이렇게 늦었나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "올라오면서 오래된 친구를 만났으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "친구라니, 누구요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "……당신이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "아하, 이렇게 또 뵐지는 몰랐네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "왜, 아직도 그 정자를 찾고 있는가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "당신이 범위를 좁혀준 덕에 훨씬 수월했습니다. 그러나, 제가 찾는 건 정자가 아니라 사람이니 좀 더 어려운 거지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "저기 앉아 있는 여자가 당신 애인인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……뭐!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "쿨럭, 제겐 그럴 배짱이 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "그럼, 딸인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "아니, 제가 어딜 봐서 애 아빠처럼 보이는 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "그렇긴 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "어이, 당신 방금 뭐라 그랬어? 내가 저 용문 사기꾼이랑 뭐가 어쩌고 어째?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "초봄 이 시간에 등산하는 남녀라면, 대개는 한가해서 할 일 없는 녀석들이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "상 씨, 정오차 나왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "정오차요? 아직 정오는 아니잖아요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "상촉의 산을 누비는 지게꾼이라면 누구나 산 중턱에 있는 찻집에서 차 두 끼를 공짜로 마실 수 있지. 오전에는 정오차, 오후에는 일몰차. 게다가 소소한 간식거리도 제공되고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "공짜로 마시는 차라면 맛이 좋겠네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "그냥 차야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그래도 산에서 마시는 차는 좀 비싸지 않나요? 공짜로 마시는 거면 땡잡은 거나 마찬가지죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "계산을 할 줄 아는 사람이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그런데 가게마다 다 그렇게 친절한가요? 무슨 자선사업 하는 것도 아니고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "관청에서 보조해주는 게 뻔하잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "……뭘 아나 보네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "당연히 알고 있지. 우리 집도 요식업을 하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "……음.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "상촉 관청이 이렇게 잘해준다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "양대인이 부임한 뒤론 줄곧 이랬어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "전임 관리들은 토목 건설에 산림까지 개발해서 도시를 부흥시켰을 뿐만 아니라, 더욱 활기차게 만들었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "양대인이 부임하고부터는 상촉이 이미 참신한 모습으로 일신되었다고 생각했는지, 주로 민심을 어루만지는 데 집중했어…… 이런 차를 제공하는 건 그중에서도 가장 사소한 정책이거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "……젊은데 아는 것도 많네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "아빠가 장사를 하다 보니 귀동냥으로 알게 된 것뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "좋은 아빠를 뒀군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "잘 마셨어, 이만 가봐야겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "다음에 또 뵙죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지게꾼",
      "text": "그럼.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……야! 리 씨, 그런데 왜 저 사람이 술잔을 갖고 있어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "저도 잘 모르겠습니다만, 저 사람은 전혀 숨길 기미도 없이 저렇게 당당하게 허리춤에 차고 다니시네요. 마치……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "일부러 사람들이 찾아오게 하려고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……뭐, 괜찮겠죠? 우리도 차나 마시면서 지켜봅시다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "여기요! 차 두 주전자랑 고기국수 두 그릇이요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "난 안 먹어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그럼 제가 다 먹을게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "손님, 차 두 주전자 나왔습니다. 그런데 국수는 좀 기다려서야 합니다. 오늘 손님이 좀 많아서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "고맙습니다……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크오오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "왜 여기까지 따라왔지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크…… 오오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "있잖아, 리 씨, 뭐 물어볼 게 있는데 너 웃으면 안 된다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "혹시 저 주전자가 저절로 움직이는 것 같지 않아……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "주문하신 고기국수 나왔습니다……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "깜짝이야, 하마터면 넘어질 뻔했잖아요! 손님, 좀 조심하세요. 저 지금 국수를 들고 있잖아요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크오오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "……뭐야 이건?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "조심해요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "뭐?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "으윽!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……야, 너 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "저 냄비 그릇들, 그리고 간판 그림들…… 죄다 집안에서…… 뛰쳐나왔네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "놀란 손님",
      "text": "꺄아아악……! 이게 다 뭐야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "찻집 점원",
      "text": "부! 불이다! 저 괴물에 불이 붙었어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "우릴…… 향해 오고 있는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "야, 리 씨, 이게 대체 어떻게 된 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "술잔의 전설이 다 사실이었네…… 여긴 사람이 많으니, 먼저 나갑시다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "리에게 어떻게 연락하냐고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "……편지에는 우리가 합류한 후, 취강봉 정상에 가서 그를 찾으라고 했어. 만약 그가 없으면 해가 질 때까지 기다리래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "……알겠습니다. 그럼 저희도 서두를까요? 술잔이 다른 사람 손에 들어가면 안 되니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "은인님, 전에 그 묵량과 비슷하게 생긴 괴물들은 어떡하면 좋죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "아마 그 술잔 때문일 거야…… 일단 미스터 리부터 만나러 가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "윽!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크오오……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "은인님, 저것들이, 더 많아진 게 아닌가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "……? 이건 무슨 짐승이죠? 요 며칠 자주 보이던데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "우리 포위됐어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크오오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "읍, 사납기도 해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "……어쩔 수 없습니다! 은인님! 먼저 신 사공과 함께 가세요. 제가 녀석들을 상대할게요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "……너 괜찮겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "묵량과 대개 비슷한 것 같은데, 이 정도면 상대할 수 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "신 사공~! 이쪽이야~!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "영 소저",
      "text": "무슨 일이세요? 안절부절못하시는 모양이군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "……아무것도 아닙니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "영 소저",
      "text": "양대인께선 누굴 걱정할 때 늘 이맛살을 찌푸리거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "제가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "영 소저",
      "text": "네, 어떤 사람이길래 양대인을 이렇게 마음 쓰이게 하나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "……제 그 친구가 걱정돼서 그럽니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "영 소저",
      "text": "그 친구가 왜요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "그가 어떤 사건에 말려들었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "영 소저",
      "text": "대인께서 그분을 끌어들였나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "……네, 그렇습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "영 소저",
      "text": "그래서 지금 후회하고 계신가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "……그래도 저는 이게 최상의 선택이라고 생각합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "단지 확실치가 않을 뿐이죠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "영 소저",
      "text": "당신은 아주 총명하십니다, 양대인.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "그렇지 않습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "text": "바보 같은 방법을 선택했을 뿐입니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "블랙나이트",
      "text": "……염국 야수들은 다 이런 느낌인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "블랙나이트",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "……크오오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "블랙나이트",
      "text": "……응? 라이트? 아, 긴장하지 마…… 음, 너희들만 같이 있어 주면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "블랙나이트",
      "text": "다만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "……!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "블랙나이트",
      "text": "드릴! 바로 그렇게 저 녀석을 붙잡고 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "블랙나이트",
      "text": "처음 보는 염국 야수들인데…… 생각지도 못한 함정으로 쓸 수 있을지도 몰라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "아이고! 이게 웬일이냐! 내가 요즘 귀신이라도 씌었나? 왜 종일 이 괴상한 생물들과 싸워야 하지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "……우오오오?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크오오오!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "……자세히 보니 이것들……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크우우……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "(아차……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "…… 큰일 날 뻔했네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "선생님, 다친 데는 없으십니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "당신은, 그날의……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "text": "닥쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "태합 아저씨, 너무 차갑게 대하지 마시고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "……이 물체들의 내력을 아십니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "저 술잔이 지나가는 곳엔 곳곳에 치창이라는 물체가 나타나죠. 오히려 사세대의 추측이 옳았다는 증거입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "그 말인즉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "text": "공자님, 신중해야 합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "……태합 아저씨의 훈계가 일리 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크오오……오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "(이 괴물들이, 아니, 치창들이…… 설마 이 두 사람을 무서워하는 건가? 아니야, 이 소년을 무서워하는 것 같은데……?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "……하아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "이 치창들을 보십시오. 이런 일이 몇 번 발생했었나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "text": "10년 전에 한 번, 25년 전에 한 번, 그리고 육십갑자 전에도 여러 번 발생했었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "가끔 오리지늄 아츠를 사용하는 악당들이 소란을 피우긴 했어도, 상황이 지금보다 좋진 않았죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "그러나, 쉐이는 결국 쉐이고, 짐승은 결국 짐승일 뿐. 당신들이 진정 이 세상을 해칠 생각이라면, 얼마나 큰 재해를 불러올지 알고는 있나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "치창",
      "text": "……크오오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "사세대는 이런 일이 발생하는 걸 원치 않습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "이제 천 년 동안 꼬이다 못해 엉망진창이 된 이 일을 결판지을 때가 된 거죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "치창",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "……잔재일 뿐입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "저것들이…… 일반 기물로 다시 변했네요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "우요우 선생님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "……네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "크루스 씨에게 저희의 제안을 다시 한번 생각해보라고 전해주시겠습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "거래가 성사되지 않더라도 의리는 남았으면 좋겠습니다. 하다못해 크루스 씨만의 생각이 있더라도요. 제 쪽에도 마침 신분과 상관없이 로도스 아일랜드에 의뢰하고 싶은 일이 있으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "전하는 건 문제는 없습니다만, 그때 왜 은인님께 직접 말하지 않으셨어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "……하하, 그때는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "좀 긴장해서 말을 다 못했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "text": "공자님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "text": "그럼…… 저희도 이만 가 봐야 할 것 같습니다. 실례하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "……긴장?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "부감찰어사를 데리고 다니는 도련님도 긴장이라는 걸 한다고?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
