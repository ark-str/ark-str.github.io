{
  "server": "kr",
  "storyId": "act12d0_level_act12d0_03_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_03",
  "title": "옛날",
  "storyCode": "RI-3",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act12d0/level_act12d0_03_beg.txt",
  "sourceHash": "4efeeef496523765054ca2504411c5c7651b692396cab20a939020d7f20663bc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "박사, 방금 한 바퀴 돌아봤는데, 다른 사람들은 못 봤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "아무래도 제전이 끝난 다음에 열대우림으로 가서 다시 찾아봐야 할 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "페타",
      "text": "우오오오오오오!!!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "text": "아, 페타가 이겼네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "페타라는 녀석, 꽤 하는데? 나도 한번 붙어보고 싶네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "text": "네, 페타는 저희 부족의 용사예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "text": "하지만 가비알 씨보다 뛰어나진 않을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "하하, 그건 모르는 일이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "text": "가비알 씨는 어렸을 때도 대족장의 자리를 차지할 뻔했잖아요! 페타에게 질 리 없어요!",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "어렸을 때?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "어? 아, 그때 말이구나.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "사실 아주 어렸을 때, 꽤 재미있어 보여서 제전에 참가한 적이 있었거든.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "네, 그때의 가비알 씨는 이미 엄청났었다구요!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 용사",
          "text": "크헉…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 챔피온",
          "text": "황야의 의지 부족에서 가장 강한 녀석도 고작 이 정도인가!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "가, 강하다……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스A",
          "text": "칫, 우리 부족의 용사가 이렇게 쉽게 패하다니.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스B",
          "text": "다같이 덤비자!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스A",
          "text": "안 돼, 인원수로 따지면 우리가 훨씬 밀린다고…… 이번엔 포기해야만 하는 건가……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 챔피온",
          "text": "누가 도전할 테냐! 없으면 내가 대족장에 도전하겠다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "내가 상대해주지!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 챔피온",
          "text": "넌…… 황야의 의지 부족의 고아 가비알?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 챔피온",
          "text": "어린애들 중에선 그나마 네가 꽤 한다고 들었다만, 꼬맹이에겐 제전에 참가할 자격이 없다. 집으로 꺼져서 우유나 몇 년 더 먹고 와라.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "흥, 날 이긴 다음에 다시 지껄이시지!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 챔피온",
          "text": "허! 역시 고아 아니랄까 봐, 죽는 게 두렵지도 않은가 보군!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "부족 사람들 모두가 다 내 가족이야! 헛소리 집어치우고, 싸울 거냐 말 거냐!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 챔피온",
          "text": "흥, 애송이가! 죽고 싶은가 보군!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스 챔피온",
          "text": "이, 이럴 수가…… 주먹 두 방에……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "가비알 씨, 정말 굉장해요……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "흥, 별것도 아니었잖아!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "도전할 사람 더 없어?!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "가비알이 고아였다고?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "가비알 씨가 얘기 안 했나요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "내가 말 안 했나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "아… 진짜 얘기 안 해줬나 보네. 뭐 어차피 딱히 중요한 일도 아니고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "난 부모님이 누군지 몰라. 그래도 이게 여기서 드문 일은 아니지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "박사, 넌 아마 상상도 못하겠지만, 여기선 사람 죽는 게 일상다반사야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "심지어 재앙도 필요 없지…… 사실 이곳 사람들은 재앙이 뭔지도 몰라. 감기 한 번에, 악천후 한 번에 많은 사람들이 죽을 수도 있으니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "우리 부모님도 아마 그렇게 돌아가셨지 않을까 싶어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "에잇… 이 얘기는 그만하자. 어쨌든, 내가 어릴 때부터 부족 사람들 손에 길러졌다는 것만 알면 돼.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "가비알 씨……",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "고생이 많았겠네.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "그러지 마, 박사. 무슨 내가 엄청 불쌍한 사람이라도 된 것 마냥……",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "나만 그런 게 아니야. 여기선 여러 집에서 고아 몇 명을 함께 키우는 일이 흔해.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "박사, 그렇게 신경 쓸 필요 없어.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "나도 여길 떠나고 나서야 이런 상황이 정상이 아니란 걸 알았으니까.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "덕분에 의학을 하겠다는 생각이 더욱 확고해졌지.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "그래도 지금의 넌 지금 누구보다도 건강하잖아.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "하하, 맞아.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그래서 그때 제전의 결과는 어땠어?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그때 말이지……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "찾았다! 이 나쁜 바운티 헌터 녀석!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "페타",
          "text": "누구냐?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "음? 이 목소리는……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "박사를 돌려줘!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "페타",
          "text": "뭐라는 거야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "케오?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "토미미, 네 부하들이 묶어서 마을로 데려가게 한 거 아니었나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "어라, 그랬었는데…?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "이 녀석, 힘이 꽤 세거든. 직접 풀고 나온 거 같네……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "바운티 헌터! 박사를 내놔!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "안 그럼 땅끝까지라도 쫓아갈 거야! 가만 안 둬!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "쳇… 이 바보 녀석이, 아직도 정신을 못 차렸나 보네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "페타",
          "text": "크아악!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "페타를 날려버렸네요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스A",
          "text": "저 녀석이 페타를 쓰러뜨렸어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스B",
          "text": "엄청 강해 보이는데……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스C",
          "text": "어디서 온 괴물이지?! 어디 부족이래?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스A",
          "text": "몰라, 무슨 말을 하는지도 모르겠는걸!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아다크리스B",
          "text": "뭔 상관이야! 아무튼 저 녀석한테 이기기만 하면 되는 거잖아?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "맙소사… 사람들이 케오를 새로운 도전자로 생각하고 있나 보네……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "가비알 씨, 가서 도와줄 거예요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "일단 지켜보자고. 저 바보 녀석이 그래도 전투력은 강하니까 아마 잘 대처할 수 있을 거야. 지금 올라갔다가 괜히 맞을 수도 있어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그래도 예기치 못한 사태가 발생할 수도 있으니까, 박사가 토미미의 부하들을 지휘해서 상황을 통제해줘.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
