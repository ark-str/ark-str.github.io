{
  "server": "kr",
  "storyId": "act36side_level_act36side_05_beg",
  "groupId": "act36side",
  "stageId": "act36side_05",
  "title": "회음도",
  "storyCode": "DT-5",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act36side/level_act36side_05_beg.txt",
  "sourceHash": "3647495d685694ef2940862446d77ae19a853994f9a93134d4e34c3a4ca2aee6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "5, 4, 3, 2, 1……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "좋아, 종이 울렸어. 시작한다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카앗!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "마르실, 왼쪽!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "얍!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "라이오스, 앞! 그리고 오른쪽!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "헛! 하앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "센시, 뒤다! 왼쪽이랑…… 앞에도!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "센시",
      "text": "흡! 으랏!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "앞, 뒤, 앞, 오른쪽, 왼쪽, 왼쪽, 뒤!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "하아아앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "앞, 뒤, 왼쪽, 앞, 오른쪽, 왼쪽, 뒤!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "이야아앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "후우, 하아…… 이 언저리에 있는 묵량은 다 해치운 것 같네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "고생하셨어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "아냐! 마을 사람들이 우릴 환영해 줬으니까, 문제 해결을 돕는 정도는 해야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "센시",
      "text": "그러면, 나는 아직 밭일 도울 것이 남아 있으니 먼저 가 보겠네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "센시 저 녀석, 완전히 이 마을 사람 다 됐네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "칠책님도 마찬가지 아닐까요. 찬 아저씨가 묵량을 처리하고 나면 술 마시러 오라고 전해달래요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "칠책",
      "text": "그쪽도 빨리 패배를 인정하면 좋을 텐데 말이지. 잘 마시지도 못하는 주제에 몇 번을 도전하겠다는 건지……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "라이, 오늘 차 한 잔 하러 가도 될까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "마르실이 시간만 괜찮다면 물론 좋죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "오늘은 당신의 모험담을 들을 차례였죠. 정말 기대돼요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "그런데……분명 처음 왔을 때, 라이오스 씨의 여동생을 구해야 한다고 했었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "아직 출발 안 해도 되나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "……응. 파린을 구하러 가야 하는 건 사실이긴 한데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "그래도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "서두른다고 여기서 나갈 방법을 찾을 수 있는 건 아니니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "그것도 그렇고, 여기가 너무 편안해서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "그때가 오면 다시 생각해 보자. 어때? 라이오스.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "엉? 무슨 얘기?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "너 또! 내 얘기 제대로 안 들었지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "……후훗. 라이오스 씨의 묵량 사랑은 이제 이 마을에서도 유명하니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "그나저나, 이 묵량이라는 슬라임은 정말 흥미롭네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "개체마다 정해진 형태를 가지고 있어서, 머리와 몸, 팔과 다리 같은 부위를 구별할 수 있어. 공격 방식도 상대의 머리를 감싸는 게 아니고 짐승이 사람을 공격하는 방식에 가깝지. 게다가 짖을 줄도 알고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "가장 특이한 건, 일반 몬스터는 죽이면 시체가 남는데 묵량은 검은 물웅덩이 외엔 아무것도 남지 않는다는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "어제 묵량의 약점을 마을 사람들에게 알려줬는데, 딱히 다들 관심이 없더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "이런 거에 관심 가질 만한 사람은 라이오스정도밖에 없으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "……그런가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "그런데, 칠책조차도 맞서 싸우는 방법을 익혔는데 이 마을 사람들은 여전히 그걸 배울 생각이 없어. 묵량을 상대하는 걸 봐도, 매번 어떻게 해야 할지 모르는 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카각!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "묵량들은 인간의 말을 알아듣는 것 같은 느낌이란 말이지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "정말 신기한 일이야. 센시 말처럼, 슬라임과는 달리 몸의 기관이 뚜렷하게 구분돼 있고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "알았어, 알았으니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "……어? 혹시 놓친 게 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카아……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "응? 저기 얼굴에 점 달린 개체는…… 전에 어디서 본 것 같은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "맞아, 며칠 전에 해치웠었어. 왜 다시 나타난 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "……어떻게 된 거지? 혹시 이 놈들, 부활하는 건가? ……쫓아가 보자!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "저녁 먹기 전엔 와야 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "……하아. 하나도 안 듣고 있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "미안. 라이오스가 원래 좀 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "text": "그보다…… 마르실, 우리가 파산 마을에 온 뒤 얼마나 지났는지 기억하나요?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "당연히……\n어라?"
    },
    {
      "type": "dialogue",
      "speakerName": "마르실",
      "text": "우리 언제부터 여기 있었더라?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "자, 잠깐…… 너무 많은데?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "묵량들",
      "text": "캬오……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "여기에 온 지도 꽤 오래됐어. 매일 그렇게나 많은 묵량을 쓰러뜨렸는데 아직도 이렇게 많이 남아 있다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "그리고 이렇게 많은 개체가 한 곳에 모여 있는데, 무리 내에서 싸우는 일도 없는 것 같고…… 같은 종끼리 있으면 온건하게 지낼 수 있는 생명체인가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "묵량들",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "그런데 새끼 같은 건 보이지 않네.……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "생각해 보니까 외관으로는 암수의 구분도 안 되고. 여기 있는 것들은 모두 성체인데 나이가 든 개체는 또 안 보여. 마물들이 사는 집단이라고 보기 힘든 광경인데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "어라? 아까 그 점 달린 놈은 어디로 갔지……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "……이런, 들켰나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "여기서 저 녀석이 동료를 불러 모으게 하면 안 돼…… 혹시 그렇게 되면 혼자선 감당 못 한다고!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "안 돼, 지원을 부르려고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "오 그래, 이 과일을 입에 가득 채워버리자!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카오……우우? 우, 우걱우걱……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "우걱우걱우걱……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카오……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "설마 더 먹겠다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "가오오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "좋아. 큰 소리만 안 낸다면야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "자, 이건 간식용으로 남겨뒀던 거야…… 조용히 먹고, 다 먹으면 따라와. 같이 벽 뒤로 가자……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "……이렇게나 얌전하다니. 뭐지……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "(벽 뒤로 몰래 기어간다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "(땅에 떨어진 살구를 겨냥한다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "(살구를 맛있게 먹는다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "아까까지 마을을 습격하던 녀석이 지금은 과일 몇 개에 이렇게 순해지다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "우걱우걱……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "(라이오스의 주머니를 문다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "……응? 뭐 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "마을 사람들을 먼저 공격한 것 치고는 이기고 나서 기뻐하는 기색도 없고, 지고서 도망친 줄 알았더니 이런 데 숨어서 살구나 먹고 있고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "음…… 먹을 걸 두고 싸우기는 하는 것 같은데, 식량이 목적이라면 마을보다는 산이 과일이 더 많을 테고. 애초에 과일 조금 먹자고 이 정도로 자주 마을을 습격할 일이 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "마을 사람들이 녀석들의 새끼를 잡거나 영역을 침범한 것도 아닌 것 같은데. 묵량의 적대심은 어디서 나오는 거지……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "어라, 저 녀석은 아까 그 점 달린 놈인데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "읏차!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "라이오스가 살구를 던지자, 퐁 하는 소리와 함께 점 달린 묵량의 머리에 명중했다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "묵량은 잠시 비틀거렸지만, 곧바로 자세를 바로잡은 뒤 짧은 앞발로 머리를 감쌌다.\n그리고 곧바로, 살구의 달콤한 향기를 맡은 듯했다."
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카앗!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "너도 살구가 목적이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "이얍!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "가악! 카오오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "우걱우걱……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "어디 보자…… 점이 있고, 머리가 조금 크고, 가느다란 꼬리가 두 갈래로 나뉘어 있고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "확실히 예전에 본 개체야! 그때도 뭔가 이상하긴 했었어. 배가 터질 때까지 먹고 움직이지도 못하는 걸 보면 아무리 생각해 봐도 마을을 공격할 목적으로 온 것 같지는 않았으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카오……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "그렇다는 건, 정말로 살아 돌아온 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "즉, 너희는 여기에서 죽었다 살았다를 계속 반복하고 있다?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "그렇게 보면 미궁에서의 우리 생활과도 비슷한 점이 있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "묵량",
      "text": "카오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "이상하네. 이런 습성을 가지고 있는데 왜 마을을 공격하는 거지……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "다들 살구가 먹고 싶은가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라이오스",
      "text": "좋아. 조금 남아있기는 하니까……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
