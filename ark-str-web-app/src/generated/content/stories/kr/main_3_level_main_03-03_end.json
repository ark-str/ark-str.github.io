  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "잘 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "응…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "이게 방아쇠야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "탄환은 이렇게 넣고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "조준을 한 다음에 방아쇠를 당겨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그럼 탄환이 발사된다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그리고 손잡이를 잡은 다음에.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "정신을 집중해서… 아츠를 쓰는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그럼 탄약을 폭발시킬 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "내가 할 수 있을까…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "할 수 있을 거야, 반드시.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너한테선 나랑 비슷한 무언가가 느껴지거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "상상하는 거야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "자, 이 오리지늄을 잡고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "으으……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "정신을 집중해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "손바닥이 조금… 뜨거워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "역시, 내 눈은 틀림없어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "미샤, 넌 틀림없이, 분명… 하하, 하하…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "넌 틀림없이 내…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…가자! 스컬슈레더, 퇴각이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "이 광산을 빠져나가야 한다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "무슨 일이지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "로도스 아일랜드가 여길 기습했다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그 쓰레기 녀석들이…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "허둥대지 마라, 전원 반격 준비!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "스컬슈레더…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "로도스 아일랜드라면… 우리를…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…뭐하자는 거야. 로도스 아일랜드랑 이야기라도 해보라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그 사람들이라면 분명 감염자들을 도와줄 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "로도스 아일랜드는 내 동포를 수도 없이 죽였다…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그런데도 넌 내게 녀석들과 대화를 해 보라는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "내 동포들은 모두 감염자였어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "감염자를 구하겠다고 하던 로도스 아일랜드가, 내 동포들을 구해줬던가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "대체 뭐가 네 판단을 어지럽히고 있는 거지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "모, 모르겠어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…미안하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너무 흥분했군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "하지만 확실한 건…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "드디어 감염자들이 희망을 손에 넣었다는 거야, 리유니온이라는 희망을.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "하지만 로도스 아일랜드는 우리와 마찬가지로 감염자면서… 우리를 공격하고, 죽이려 하고 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "이런 자들은 배신자라 불려야 마땅하지 않나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "배신자들과 무슨 이야기를 할 수 있겠냐고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "정말로 감염자들은 서로를 죽이고, 서로의 손에 죽는 길밖에 없는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그럼 나보고 어쩌란 말이냐…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "동포의 죽음을 가만히 보고만 있으라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "걱정하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "우리가 널 지켜줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너도 네 몸을 잘 지키고 있어라…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "전투에 말려들지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "절대로…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "너도… 꼭 돌아와야 해…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "나도 이제야 겨우…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그래, 반드시 네 곁으로 다시 돌아올게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그리고 같이 집으로 돌아가자…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "응…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "안녕.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "역시 내 도움이 필요한가 보네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "상황이… 탈룰라가 말한 거와는 좀 다르게 돌아가는 것 같더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "생각보다 적이 강하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그러니, 넌 무슨 일이 있어도 미샤를 지켜라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "난 그럴 의무가 없는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "알았어, 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그런데, 미샤를 지키기만 해선 뭔가 부족하지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "만약 너희들이 실패하면 녀석들이 추격해올 텐데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "무슨 방법이라도 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "스컬슈레더, 전에 내가 알려준 거 기억해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…기억하고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…그 목표물만 처리한다면 전세가 역전될 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "{@nickname} 박사…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그래, 적의 지휘관을 처치하는 거야. 간단한 일이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "토끼한테 딱 붙어 있는 후드 쓴 녀석 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "로도스 아일랜드의 모든 전투를 그 녀석이 지휘하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그 녀석만 죽이면, 똑! 하고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "로도스 아일랜드 놈들의 머리가 떨어지는 셈이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그럼 모든 게 다 일사천리라 이 말씀~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "우린 지금 규모도 크지 않은 데다 쓸 수 있는 전술도 적어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "광산 근처가 매복하기에 적합한 지형이었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "우리 캐스터들이 엄호해 줄 테니… 네가 뭘 해야 할지는 잘 알겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내 부하들이 녀석들을 유인해 줄 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이 기회를 놓치지 말라고~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "알겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…미샤를 부탁하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "안심해~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "후우, 그럼… 무운을 빌게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
