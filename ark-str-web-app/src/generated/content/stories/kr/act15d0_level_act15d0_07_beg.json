{
  "server": "kr",
  "storyId": "act15d0_level_act15d0_07_beg",
  "groupId": "act15d0",
  "stageId": "act15d0_07",
  "title": "배반",
  "storyCode": "MB-7",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act15d0/level_act15d0_07_beg.txt",
  "sourceHash": "77e636eb8135ae14664dc77dde6a1f7d09daacedfb5938cd568191a6c81d9357",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "아, 드디어 탈옥을 실행할 단계인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "과정에서 일부가 생략되긴 했지만, 내가 상상했던 것보다 훨씬 복잡한 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "휴우……살짝 졸립다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메이어",
      "text": "나도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메이어",
      "text": "아, 내가 커피 한 잔 타 줄게~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사일런스",
      "text": "조금 있으면 끝나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "네~ 네~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "그런데 앞으로 어떤 일이 일어날지 짐작도 안 간다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "모든 준비가 끝났으니, 탈옥을 실행할 그날만을 기다리고 있었겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "그런데 막상 실행하려던 날, 누군가가 갑자기 사라진 거야, 맞지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사일런스",
      "text": "맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사일런스",
      "text": "그들은 감옥이 뉴라이트버그에 정박해 있는 기간에 C 구역에 청소하러 가는 기회를 틈타 탈옥을 시도하기로 했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사일런스",
      "text": "그런데 그날 약속한 시각에 로빈이 나타나지 않은 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사일런스",
      "text": "왜냐하면, 그들은 몰랐거든. 그들의 계획이 진작에 제셀톤에 의해 완전히 파악되었다는 걸 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "사일런스",
      "text": "로빈은, 그들이 반드시 지나쳐야 하는 길목에서 일찍부터 그들을 기다리고 있었어……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "상황이 조금 혼란스럽긴 하지만, 잠깐 너랑 계획을 확인해봐야겠어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "우린 지금처럼 감방을 청소할 기회를 틈타 들어와 너를 도와 죄수들과 교도관을 때려눕힌다……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그런 다음 우리 두 사람은 저쪽을 감시하던 교도관이 허술한 틈을 타 바로 꼭대기 층으로 가서 탑을 가라앉게 한 뒤, 감옥의 전기를 끊는다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그리고 이미 지하에서 기다리고 있는 돔마와 합류한 뒤, 함께 미리 파놓은 땅굴로 들어간다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "마지막으로 미나가 우릴 위해 몰래 챙겨놓은 작업복으로 갈아입고 나가면 끝.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "전 계속 의구심이 드는군요, 정말 제 체격에 맞는 작업복이 있을까요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "안심해, 돔마가 특별히 너를 위해 다시 바느질을 해뒀으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "하나로 부족하면 두 개를 이어 붙이면 되지, 아주 커 보이던걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "나중에 꼭 돔마한테 고맙다고 해야 된다?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "물론이죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "윽!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "안! 녕!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "카프카 씨, 매우 흥분한 것 같군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "헤헤, 탈옥이 이렇게 재밌는데, 흥분되는 게 당연하지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그런데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그러고 보니, 왜 로빈 씨가 보이지 않는 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "이번 청소 담당은 모두 익숙한 얼굴이군, 그럼 설명은 필요 없겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "네~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "교도관님, 만약 우리 중에 또 앤소니 형님을 암살하려는 놈이 있으면 어쩌죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "바보냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "방금 몸수색을 왜 했는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "너희들이 맨손으로 앤소니 씨를 이길 수 있을 거 같아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "하! 교도관님도 앤소니 씨랑 한번 붙어 보고 싶은 거 아닙니까? 만약 싸우게 되면 저 부르십쇼, 응원은 해드릴 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 A",
      "text": "꺼져, 너한테 말 안 걸었어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "(어떻게 된 거지, 로빈은 왜 안 오는 거야?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "저기 저기 A 구역 형님, 로빈은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 B",
      "text": "B 구역 놈은 나한테 말 걸지 마…… 아, 카프카였구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수 B",
      "text": "몰라, 지금도 로빈을 못 찾아서 내가 대신 온 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "됐어, 쓸데없는 소리 그만하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "A 구역은 저길 따라가고, B 구역은 날 따라와.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "쳇, 시간이 없는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "로빈, 미안. 탓하려면 이렇게 긴박한 순간에 없었던 너 자신을 탓해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "이제 와서 되돌아갈 수는 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "나중에 그녀를 다시 만나게 된다면 그때 사과하기로 하고, 일단은 가시죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "응.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "여기가 메인 관제실……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "우와, 먼지 쌓인 거 봐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "조심하십시오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "앗?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "로빈? 네가 어떻게 여기에?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "나한테 예비용 카드가 있었거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "예비용? 그런 건 언제……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "물러서십시오.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "지금은 한시가 바쁘다 보니…… 이야기할 시간이 없습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "속전속결로 끝내도록 하죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
