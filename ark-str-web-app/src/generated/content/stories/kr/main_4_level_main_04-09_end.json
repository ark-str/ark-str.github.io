  "storyId": "main_4_level_main_04-09_end",
  "groupId": "main_4",
  "stageId": "main_04-09",
  "title": "뼈에 사무치는",
  "storyCode": "4-9",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_04-09_end.txt",
  "sourceHash": "56b70ff73dce462fb0949aa565c4e02f88a7014fe3319692ff18a13f3f444726",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "프로스트리프, 조심해! 너무 앞으로 나가면 안 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "내 능력은 내가 제일 잘 안다…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으, 으아아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "냉기로 방패를 베어내다니?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "뭐, 뭐지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "비켜!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "아미야! 프로스트리프가 적을 교란하면서 적 지휘관을 향해 움직이고 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "스나이퍼, 캐스터, 프로스트리프 씨를 엄호해 주세요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "이런…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "무슨 꿍꿍이야, 꼬마 여우?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "네놈이 죄를 뉘우치게 하고, 눈물이 멈추지 않을 고통을 주고서…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…네놈의 목숨을 앗아가겠다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "방해하지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으악!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "거, 검은 아츠…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "빠, 빨리 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "메피스토의 부하들처럼 되고 싶지 않아…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "메피스토, 이제 도망칠 곳은 없어요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "이런, 이 녀석들로 로도스 아일랜드를 막는 건 무리였나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "여태까지 해온 악행의 죗값을 치르세요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "도망칠 곳은 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "꼬마 여우, 나한테 너무 가까이 온 거 아냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그건 내가 네 목숨을 앗아갈 자이기 때문이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "사람의 목숨을 모욕하는 놈은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "목숨을 부지할 자격이 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "헤에~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "그렇구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "뭐지, 다리가…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "아미야! 각 방향에서 리유니온 부대가 나타났어! 수가 많지는 않지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "위험해. 저건 눈의 악마 소대…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "눈의 악마 소대까지… 불러모으다니!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "좋아, 너희한테도 새로운 친구를 소개해줘야겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "후후, 이번 무대의 진정한 주인공에게 박수 부탁해~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "북서쪽 얼음 평원의 악몽, 눈의 악마들의 공주…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "프로스트~노바~!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "너희들의 피와 살을, 조금씩, 아주 조금씩…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "얼리고, 깎아서, 가루로 만들어 버릴 거야~!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…위험해요…!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트노바",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트노바",
      "text": "메피스토……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트노바",
      "text": "제일 먼저, 짐승만도 못한 살인광인 네놈을, 설원에 던져 놓고 얼려 죽여야겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "우와~ 무서워라~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "하지만 지금 네 상대인 로도스 아일랜드는 저쪽에 있다고?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프로스트리프 씨…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "물러나 주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "아미야, 사람들을 데리고 도망쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "안 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저건… 저건…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "놈이… 이곳으로 다가오고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "승산은 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "훗… 아직 충분히 살았다고는 못하겠지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "너희를 만난 건 정말 행운이었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "가라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프로스트리프 씨?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "가라고!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트노바",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트노바",
      "text": "안심해라, 로도스 아일랜드.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트노바",
      "text": "일말의 고통도 없이 죽여줄 테니.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
