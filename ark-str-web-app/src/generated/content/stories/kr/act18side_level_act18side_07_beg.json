{
  "server": "kr",
  "storyId": "act18side_level_act18side_07_beg",
  "groupId": "act18side",
  "stageId": "act18side_07",
  "title": "정화된 밤",
  "storyCode": "LE-7",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act18side/level_act18side_07_beg.txt",
  "sourceHash": "00c207376728cab94b8048627f65358f9a10605005f7f72e3dd484433c433f76",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "없어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르술라",
      "text": "체르니 선생님은 얼마 전에 나가셨어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "나갔다고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르술라",
      "text": "중독된 감염자의 치료 문제 때문에, 애프터글로 밖의 병원에 교섭을 하러 갔을 거야……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우르술라",
      "text": "체르니 선생님, 그 병원들은 어땠나요……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "겨우 규모가 제일 큰 두 곳과 계약을 체결했고, 나머진…… 설득하지 못했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "하지만, 그들은 로도스 아일랜드와 계약을 체결했는데요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "당신도 있었군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "소용없습니다. 로도스 아일랜드와 그 병원들이 체결한 계약서엔 광석병으로 인한 증상만 치료한다고 제한되어 있어서, 그들에겐 중독으로 쓰러진 감염자들은 받을 이유가 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르술라",
      "text": "어쨌든 두 곳이나 계약했으니, 충분하지 않을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "훗, 충분하겠죠, 당연히 충분합니다! 제가 저의 모든 저작권을 담보로 했으니, 그들 배후에 있는 재단은 충분하다고 생각할 겁니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "설마…… 저작권마저 전부 양도한 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "맞아요. 그동안의 저작권뿐만 아니라, 내일 열릴 음악회의 녹음 판권도 다 그들에게 팔아넘겼습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "이제 저는 다시 빈손으로 시작해야…… 콜록, 콜록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "콜록…… 커헉!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우르술라",
      "text": "선생님, 체르니 선생님?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "정신이 드세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "으음…… 네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "체르니 씨, 밖에 나가면서 아무런 방호 조치도 안 하셨죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "원석충에서 나는 그 악취 말입니까? 1초라도 빨리 계약을 체결해야 하니까, 그것까지는 미처 생각하지 못했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "오늘과 같은 무모한 행동은 앞으로 절대 하지 마세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "'앞으로'? 그 말인즉, 제가 아직 살 시간이 있다는 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "……제가 있으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "하아, 몸이 망가지니 드디어 의사를 보는 마음이 한결 편해지는군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "감사합니다, 히비스커스 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "제가 마땅히 해야 할 일이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "그런데, 에벤홀츠 씨는 왜 아무 말도 하지 않는 겁니까? 지금의 애프터글로가 너무 위험해서 음악회에서 빠지고 싶은 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "확실하게 말해 둘게요. 일이 이 지경에 이른 이상, 음악회는 무슨 일이 있어도 성공시킬 것입니다. 그러니까 막판에 빠질 생각은 하지 마세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "막판에 빠질 생각은 하지 말라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "(작은 목소리로) 체르니가 버틸 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "(작은 목소리로) 좀 더 지켜봐야죠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "아무래도 음악회에서 빠질 생각은 아닌 것 같군요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "아니, 빠지려는 게 아니라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "에벤홀츠 씨, 당신은 긴장하면 다른 사람의 말을 반복하는 버릇이 있습니다. 저는 처음부터 그걸 알아봤죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "할 말 있으면 하세요. 이 꼴이 된 이상 제가 못 받아들일 게 뭐가 있겠습니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "콜…… 콜록콜록!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "체르니 씨, 물! 물!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "콜록콜록, 게르트루트 이…… 이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "그리고 당신, 당신은 대체 무슨 생각으로 그런 계획에 가담한 겁니까? 그래도 당신은 가망이 있다고 생각했는데, 음악으로 표현하고 싶다는 게 고작 이겁니까? 음모라는 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "그거랑 달라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "어떻게 다르다는 거죠? 애초에 당신은 순순히 그 미친 여자의 제안을 받아들였잖아요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "설령 뼈에 사무치는 증오라 할지라도, 적절한 기법으로 표현해낼 수 있다면 그 자체만으로도 의미가 있다고 당신이 말했던 적이 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "맞습니다. 그래서요? 당신은 뭘 표현하고 싶은데요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "……솔직히, 나도 그때의 자신이 바보 같다고 생각해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "하지만 내가 원하는 건 그저 자유였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "……자유라, 자유에 대한 갈망인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "그걸 음악으로 표현하려면, 당신은 아직 멀었어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "나도 그 점을 깊이 깨달았어. 그렇지 않다면, 당신을 찾아오지도 않았을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "……흥.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "갑시다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "네? 어딜 가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "어디겠어요, 당연히 음악 홀이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "전에 게르트루트가 수작을 부리면서까지 저를 휴게실에 못 들어가게 막은 적이 있었죠. 도대체 무슨 꿍꿍이를 꾸미고 있는지 똑똑히 확인해 봐야겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "하지만, 당신은 몸 상태가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "여기서 에벤홀츠 씨와 그 여자 때문에 화가 나서 죽느니, 차라리 그 여자가 무슨 짓을 꾸미는지 확인하는 게 더 낫겠어요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "에벤홀츠 씨, 게르트루트 씨가 휴게실 어디에다 손을 댔는지는 말을 안 하던가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "아니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "물어볼 것도 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "알아냈나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "이게 어딜 봐서 손을 댄 수준입니까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "저 스피커는 분명 뜯었던 흔적이 있습니다. 그리고 저쪽에 있는 레코드플레이어는 나사도 제대로 조이지 않았군요…… 쯧쯧, 드라이버조차 치우지 않았네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "역시 귀족들은 웃음이 날 정도로 일 처리가 엉망이군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "히비스커스 씨, 저 레코드플레이어를 가져다주세요. 톤암 외에 또 뭘 건드렸는지 살펴보죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "보세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "레코드플레이어 안에 픽업을 설치해놨군요? 이렇게 하면 회로 간의 간섭만 일으킬 뿐인데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "게다가 레코드 바늘마저 뽑아버려서, 이건 그저 확성기에 불과합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "이 스피커도 그래요. 입력 회로 전체를 뜯어버려서 이것도 확성기가 되어 버렸죠…… 무엇 때문에 휴게실에 이렇게 많은 확성기를 설치했을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "그건 그 여자가 말하지 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "그럼 테스트해보면 되겠네요. 무대에 올라가서 아무 곡이나 연주해 보세요. 답을 찾으려면 이게 가장 빠른 방법이니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "text": "아무런 이상이 없는 것 같네요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "저도 딱히 이상을 못 느끼겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "에벤홀츠 씨에게 아츠를 조금 사용해 보라고 전해주세요…… 졸음이 가실 정도로만, 가장 약한 레벨에 고정하라고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "콜록…… 콜록콜록……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에벤홀츠",
      "text": "체르니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "콜, 콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "text": "괜찮습니다…… 다만, 심장박동이 조금 빨라졌을 뿐……",
      "portraitKey": null
    },
    {
