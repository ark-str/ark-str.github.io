  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "이번에는 배에 구멍이 난 거지? 그 포스 쩔던 노인네한테?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "맞아, 맞아. 내가 가장 앞자리에서 두 눈으로 똑똑히 봤다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "네 생각에는 뭐인 것 같아? 스턴트맨? 아니면 특수효과?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아냐, 아냐, 말도 안 돼, 아예 불가능해. 직접 영상 보면 알 거야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "음, 이거 정말 진짜 같은데!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "게다가, 엠퍼러의 스턴트맨? 그럴 수도 있다고 치자. 근데 그게 몇 번이나 가능하다고 봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "지난번에는? 내 기억엔 그 사람 혼자 쇼핑하다, 갑자기 나타난 폭도가 쏜 총에 머리를 관통당했었어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그건 리허설도 못 하잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그리고 시에스타에서 열렸던 뮤직 페스티벌에서도 어떤 놈들이 찾아가서 깽판 쳤었잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그때 나도 있었어. 혹시라도 운 좋게 마주치진 않을까 해서 일부러 맞은편 호텔을 예약했었지. 아주 시끌벅적했다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……그 사람 가수 아니야? 아무리 돈이 좀 있다 해도, 어떻게 그렇게 미움을 사고 다니지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "네가 그 사람 행동거지를 몰라서 그래. 일단 말해두자면… 음악 쪽으론 진짜 리스펙하긴 하는데, 적을 만드는 데 있어선 아마 테라에서 몇 안 되는 천재일걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "어젯밤엔 펭귄 로지스틱스 창고에서 사고가 났었대. 그 사람이 불구덩이 속에서 뛰쳐나왔는데, 하나도 다친 사람 같지 않았다나 뭐라나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "예전엔 그 사람이 슬럼가에서 수류탄인가 폭탄 같은 물건에 명중 당했는데, 다음날 멀쩡하게 지하 술집에 나타난 걸 본 사람도 있대.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그 정도는 별거 아니잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아, 수류탄에 머리가 박살 났댔는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……그거 정말 수류탄이었을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그러고 보니, 컬럼비아의 음악계가 가장 출렁였을 시기에, 그 사람이 거리에서 총살당했다는 소문이 돌면서 엄청난 파문이 일었었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "독살 아니었냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아! 그때 나도 컬럼비아에서 여행 중이었어…… 두 번 다시는 내 우상을 만나지 못할 거라 생각했는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그런데도 살아남았다?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "살아만 남은 게 아니야, 혈혈단신으로 그 젊은 놈들한테 복수한다고 막 난리 부렸었잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "어떻게 된 거야? 불사신이라도 되는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "가짜 뉴스도 많겠지? 매스컴을 완전히 믿을 수는 없잖냐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그래도 목숨이 질긴 건 사실이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "진짜 모르겠다, 화산 입구에 묶어놓고 재앙 정도는 일으켜야 영향이 있으려나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아…… 왠지 그렇게 해도 살아남을 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그러게…… 심지어 용암이 펑펑 터지는 화산에 대고 욕하는 모습까지 상상이 가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "라임까지 맞춰가면서 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……관두자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "엠퍼러잖아, 괜히 황제라고 불리겠어?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
