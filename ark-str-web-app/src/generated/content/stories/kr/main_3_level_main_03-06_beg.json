  "sourceHash": "bf2855b385c69f0631524def20757f31802455ca41602c079cf470452c18bc32",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十八关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "전장에서 넋을 놓고 있으면 위험해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…죄송합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그냥… 마음이 정리되질 않아서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "리유니온은 퇴각하면서 광산 한 곳에 틀어박힌 것 같다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그 여자, W도 그쪽으로 도망쳤고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "만약 잠시 여기 머물 생각이라면 그렇게 해도 상관은 없다만,",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "근위국은 시간을 더 낭비할 수는 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마, 다른 인원들을 소집해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(미샤 씨…)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "한 가지 걱정되는 게 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "걱정?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "W는 폭발물을 다루는 데 능해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그러니 전장에 폭발물을 이용한 함정을 설치해 두었을 가능성이 높습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "정면으로 진격하면 큰 피해를 볼지도 몰라요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그래서, 한 가지 제안을 드릴까 해요. 로도스 아일랜드의 오퍼레이터가 먼저 광산에 잠입하고, 근위국이 주변에 포위망을 펴는 것은 어떨까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "도망치는 리유니온 병력은 근위국이 즉시 체포하고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "강하게 저항하는 리유니온은 저희가 처리하도록 하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "만에 하나 그 여자를 만나더라도 승산이 있다고 보나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "잘 모르겠어요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…하지만 그만한 위험은 각오하고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저희는 그녀와 이미 몇 번 교전한 경험이 있어요. 그녀의 전투 스타일에 대해서는 어느 정도 알고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그녀와 싸운다는 위험 부담은 근위국이 안고 가기 어렵겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "…작전 목표를 잃어버리는 것 역시 근위국에겐 위험한 일이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "PC94172, 근위국 부대를 이끌고 광산을 포위하라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마, 인원을 몇 명 선발해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "우리는 각자 한 팀씩 이끌고 로도스 아일랜드와 협력한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마와 로도스 아일랜드는 둘로 나뉘어 적 진지와 방어선을 무너뜨려라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "난 적의 거점을 처리하겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "용문을 위해서라도, 반드시 미샤를…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "…되찾아 오겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그럼, 저도 로도스 아일랜드의 오퍼레이터를 소집하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "첸, 광산 주변에… 밖으로 이동하는 리유니온 집단을 확인했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "…꽤 빠르게 움직이고 있군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "늦기 전에 내가 먼저 가도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "어서 가라. 한 명도 놓쳐선 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아, 호시구마 씨. 기다려주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "로도스 아일랜드가 적의 습격을 받았을 때, 적 중에는 캐스터도 함께 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "여기 프란카 씨와 리스캄 씨를 데려가 주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이 두 분은 캐스터와의 전투 경험이 풍부하거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그러지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "잘 부탁해~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "그럼 아미야, 넌 어떻게 할 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "켈시 선생님이 우리한테 거듭 당부했던 건…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "여기는 펭귄 로지스틱스에서 지원을 해주니 괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그럼 정해진 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "절대 무리하지 마라. 위험하다 싶으면 퇴각하도록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "아미야, 너도 마찬가지다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "알고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "남은 시간이 그리 많지 않아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "체르노보그 때와는 다릅니다. 이젠 저희가 리유니온을 막을 차례예요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
