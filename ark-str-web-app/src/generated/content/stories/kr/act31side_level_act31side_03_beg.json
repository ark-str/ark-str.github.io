    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "화려한 옷차림의 남자",
      "text": "벼농사가 풍년인 꿈을 꾸고 있었는데, 갑작스러운 재앙이 그 아름다운 꿈을 산산이 부숴버렸군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소만",
      "text": "으악! 왜 논밭에서 잠을 자는 거야? 밟히면 어쩌려고?",
