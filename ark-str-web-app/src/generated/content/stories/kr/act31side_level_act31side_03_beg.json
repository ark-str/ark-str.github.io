      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "토목천사",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "토목천사",
      "text": "지금 때리신 건가요?",
