{
  "server": "kr",
  "storyId": "main_11_level_main_11-12_beg",
  "groupId": "main_11",
  "stageId": "main_11-12",
  "title": "대면",
  "storyCode": "11-14",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_11-12_beg.txt",
  "sourceHash": "850b82ccd0fc0147bc07e40d7fca2b73db324c5ebe378f92db4ed16c9a6db448",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "4년 전"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "살카즈에 비해 시간은 늘 너희 개인과 국가에서 빠르게 흐르는 것 같다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "가울이라는 거인이 쓰러진 후 빅토리아와 라이타니엔은 미친 듯이 그 유해를 흡수했지. 불과 몇십 년 만에 가울의 시대가 끝나버렸으니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "너는 코르시카 1세의 전함과 대포를 본 적이 없고, 너는 링고네스의 번영과 오만함을 본 적도 없을 것이다. 하지만 네 아버지의 영지는 이미 빅토리아 변경 귀족의 관할지로 전락하지 않았는가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "그런데도 너는 지금 빅토리아 고급 장교의 제복을 입고, 몸에는 빅토리아가 수여한 훈장을 잔뜩 달고 있군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "너는 런디니움의 귀족들이 흔히 쓰는 표준 빅토리아어를 사용하고 있다. 심지어 가울 억양도 전혀 없이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "네가 살카즈와 협상하겠다며 내 앞에 나섰을 때, 너는 과연 스스로 '가울인'이라 칭할 자격이나 있느냐?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "……섭정왕 전하, 이제 가울이라는 나라에 속하는 도시는 하나도 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "당신 앞에 서 있는 사람은 가울 사람이 아닌, 가울의 유민입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "혹자는 빅토리아, 컬럼비아, 또는 라이타니엔에 모두 흩어져 있습니다. 우리가 떠돌이 생활을 선택한 게 아니라, 우리는 애초에 고향이라고 부를 만한 곳을 잃었기 때문입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "너희는 가울을 재건하고 싶은 것인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "그렇습니다. 당신과 다른 살카즈들이 카즈델을 재건하고 싶은 것처럼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "200년 전, 가울 제국의 포병단이 카즈델의 성벽을 둘러싼 적이 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "그런데 지금 너는 자신을 살카즈와 함께 논하다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "당시 카즈델을 향한 전쟁에는 빅토리아도 참가했습니다. 그리고 당신과 군사위원회가 런디니움에 들어갈 수 있었던 건 캐번디시 공작의 초대가 있었기 때문이라고 들었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "그렇다면 너도 그놈의 최후가 어떤지 알고 있겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "10일 전, 스태포드 공작이 런디니움에서 반란을 일으켰고, 캐번디시 공작은 스태포드 공작의 음모를 막기 위해 일어났죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "런디니움 도시방위군도 그 전투에 참여했지만, 안타깝게도 두 공작은 서로를 향한 포격에서 살아남지 못했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "물론 당신도 잘 알고 계실 겁니다. 당신의 런디니움에서의 일거수일투족을 다른 공작들이 무척 관심 있어 합니다. 앞으로 이 도시에 무엇을 하든지 간에 당신은 새로운 조력자가 필요할 것입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "이게 네가 살카즈와 협력하는 방식인가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "맞습니다. 보시다시피, 가울 유민회는 카즈델 군사위원회가 런디니움에서 진행하는 모든 행동을 전력으로 지원할 것입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "그리고 우리가 원하는 것은 앞으로 있을 빅토리아의 혼란 속에서, 원래 가울에 속했던 몇몇 도시를 다시 가울에 되돌려 주셨으면 하는 것뿐입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "text": "약속한다고 달라질까? 국가의 흥망은 보유한 도시 수량과는 아무런 관계가 없는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "알고 있습니다, 섭정왕 전하.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "하지만…… 저희는 이것보다 더 좋은 기회를 놓칠 수 없습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "제가 영 가디언 한 명을 알고 있는데, 그는 과거 가울 황제 본인의 제국 근위대 소속이었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "제가 그를 알게 됐을 때 이미 60세가 넘었지만, 제국 근위대는 사황 전쟁 때 이미 자취도 없이 사라진 바람에, 그는 평생 올드 가디언이 될 수 없었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "그는 저에게 혈기 왕성했던 황제, 무적의 함대, 행군 길에 있었던 우스갯소리를 들려줬습니다. 수십 년 동안 그는 고집스럽게 가울어로 그 이야기를 계속 들려줬습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "그는 지금 런디니움 쳅 자치구의 한 비좁은 요양원에 누워 있습니다. 최근에 그를 만나러 갔을 때 말도 제대로 못 할 정도였죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "그런데도 매일 TV에 나오는 제정 양식의 건물을 보면 흐릿하던 눈빛에 생기가 돌아오고, 경련을 일으킨 두 손으로 손뼉을 치곤 합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "아마도 길어 봐야 5년을 못 넘길 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "가울을 직접 경험했던 마지막 세대가 점점 줄어들고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "섭정왕 전하, 당신의 말이 맞습니다. 살카즈에 비해 우리의 수명은 너무나 짧습니다. 우리의 기억도 …… 피를 통해 전승되지 않습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "그 시대를 겪은 마지막 이가 죽으면 가울에 대한 우리 기억은 제국처럼 바람과 함께 사라지고 말 겁니다. 그때가 되면, 가울이 진정으로 소멸하게 됩니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "그래서 우리가 유일하게 할 수 있는 건 꺼져가는 잿불이라도 잡는 겁니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 병사",
      "text": "발리스타 발사!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 병사",
      "text": "봉쇄층을 지켜라, 놈들이 접근하지 못하게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "락락",
      "text": "방위군 병사들의 투지가 매우 완강하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "놈들의 지휘관이 위에 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "병사들이…… 확실히 그 지휘관을 존경하나 봐.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "자경단 전사",
      "text": "지휘관님, 살카즈가 왔습니다! 로도스 아일랜드의 오퍼레이터들이 지금 그들과 교전 중입니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로비시아",
      "text": "로도스 아일랜드를 지원해. 정면으로 최대한 적의 주의를 끌어서 박사에게 시간을 벌어줘야 해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "하이버리 구의 용병들은 대게 다 네 손에 죽은 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "전쟁이 코앞이다. 우리 모두 잘 알고 있을 테지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아스카론",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "아스카론, 너는 카즈델에서 태어났고 카즈델에서 자랐어. 장군님은 널 시체 더미에서 안아 왔고, 전하는 네게 무기를 쥐여주어 자신과 고향을 지키는 방법을 가르쳤다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "그런데, 살카즈가 가장 단결해야 할 시기에 너는 로도스 아일랜드의 살카즈들과 함께 대체 무슨 짓을 하려는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "우리 정보를 빅토리아에 넘길 셈이냐? 과거…… 카즈델을 짓밟았던 이종족에게?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "너는 너의 약속을 배신했고, 카즈델을 배신했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아스카론",
      "text": "……카즈델은 여기서 수천 킬로미터 밖에 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "내전 당시 네가 바벨의 자객이 되겠다고 했을 때, 나는 너를 막을 수 없었다. 막을 이유도 없었고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "그땐 네가 테레시아 전하에게, 살카즈의 유일한 군주에게 충성했으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "하지만 지금은? 아스카론, 지금 너는 무엇에 충성하고 있지…… 과거의 환영인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "분명 내전은 이미 끝났고, 테레시아 전하도 우리 곁에 돌아오셨다……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아스카론",
      "text": "……4년 전, 너희는 전하를 죽였다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아스카론",
      "text": "그리고 지금, 너희는 그런 불명예스러운 방식으로 전하의 죽음을 더럽히고 있다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아스카론",
      "text": "진짜 배신자, 과연 누굴까?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "……윽!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "아스카론의 공격이 맨프레드의 아츠를 찢어버렸다.\n두 사람은 어려서부터 달랐다.\n맨프레드는 장군에게서 검술, 군사 이론, 정치 수완을 포함한 많은 것들을 배웠다. 하지만, 아스카론은 손에 든 무기처럼 순수했다.\n전장에서 아스카론은 그 어떤 말에도 흔들리지 않았고, 눈에는 늘 우선순위가 가장 높은 목표뿐이었다."
    },
    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "text": "레토……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아스카론",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아스카론",
      "text": "이 피는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토 중령",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "끈적한 선홍빛이 바닥에서 빠르게 스며 나오더니, 이내 벽보다도 더 튼튼한 장벽으로 변해 레토와 아스카론을 갈라놓았다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "박사, 드론이 또 다른 살카즈 병사가 접근하는 걸 탐지했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로저",
      "text": "아니다. 저 꿈틀대는 빨간 것은……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "뱀파이어다.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "자경단과 일반 오퍼레이터들은 멀리 떨어져.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "아미야와 로고스한테 알려.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "클로저",
          "text": "알았어, 박사.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "클로저",
          "text": "네가 예상했던 거랑 비슷해. 저 녀석이 바로 사령탑 위로 올라갔어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "클로저",
          "text": "뒤틀린 집착 덕분에 녀석의 행동은 읽기 쉬운데…… 내가 저 녀석의 영향을 받는 건 아니겠지?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "드론의 진척은?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "우리도 서둘러야 해.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "클로저",
          "text": "굿 뉴스야, 이 사령탑이 방벽 쪽이랑 구조가 확실히 매우 비슷해. 이미 통제 구역으로 향하는 최적의 경로를 찾았어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "클로저",
          "text": "방위군의 현대화 통신 수단이 살카즈가 사용하는 통신 주술보다 이용하기 더 쉬워. 원격 신호가 차단되지 않게 내가 드론의 식별 코드를 위장해놨거든.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "클로저",
          "text": "하지만…… 드론 자체가 너무 취약해서, 공격이라도 받으면 우리의 노력이 모두 수포가 될 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "클로저",
          "text": "아미야 일행이 위층에서 위험한 놈들을 막아줬으면 좋겠는데……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "나약하고 어리석은 리베리여.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "살카즈 앞에서 자신의 목숨이 실오라기보다 더 취약하다는 걸 알면서도, 아직 도망치지 않았습니까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "레토 중령",
          "text": "저는 지휘관이고……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "레토 중령",
          "text": "여긴 제 사령탑입니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "레토 중령",
          "text": "저의 병사들도…… 아직 살아있습니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "……아무래도 그 병사들을 먼저 정리할 걸 그랬나 봐요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "음? 이 아츠, 이 냄새는……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "아하…… 그런 거였군요. 어리석은 대체자가 왔군요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "처음 뵙겠습니다, '마왕'.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "저는 당신을 몇 번 본 적이 있어요, 뱀파이어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "수많은 자경단 전사들이 당신의 손에 희생됐어요. 저는 그들의 이름을 모두 기억하고 있습니다. 그들의 목숨은 결코 당신의 경멸로 인해 본연의 무게를 잃어서는 안 됩니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "그래서 어떻게 할 생각입니까, '마왕'?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "당신의 그…… 칠흑 같은 칼과 도끼로 저를 처단할 겁니까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "캐스터 소대, 스나이퍼 소대, 저랑 함께 이 피의 방어선을 찢어주세요! 시간이 없으니 목표만을 노리세요!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "검은 선이 화살과 함께 짙은 핏빛 속으로 날아 들어갔다.\n하지만 아무런 변화도 없었다."
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "당신에게는 너무 실망했습니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "카우투스, 당신은 전사로서의 자세만 가졌을 뿐, 통치를 위한 살육의 필요성을 전혀 인정하려 하지 않군요. 당신은 테레시아보다도 연약합니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "황당한 테레시아가…… 어리석게도 살카즈를 데리고 빅토리아를 비롯한 침략자들에게 고개를 숙이려고 하다니요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "게다가 그녀의 가장 어리석은 결정은 당신을 후계자로 선택한 것이 틀림없습니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……계속 공격하세요!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "쓸데없는 발악입니다……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "비켜.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "어?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "피로 이루어진 파도가 아미야를 덮치려는 순간, 그것은 갑자기 가지런히도 갈라졌다."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "그렇군요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "선봉 역할을 하는 자객 외에도 신하 한 명을 더 데려왔군요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "……우리가 아미야의 부하이지, 신하는 아니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "밴시.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "겁먹은 겁니까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "뱀파이어 생귀나르",
          "text": "당신이…… 로도스 아일랜드란 이름의 껍데기 속에 숨어 있는다고, 이 모조품과의 관계를 부정하고, 반역자에 대한 카즈델의 심판에서 벗어날 수 있다고 생각합니까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "너의 말은 항상 궤변으로 가득하구나, 뱀파이어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "런디니움에 오기로 결심한 순간부터 나는 로도스 아일랜드 정예 오퍼레이터의 제복을 잠시 벗었다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "나는 밴시의 주인이다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "내 말이 곧 죽음의 왕궁이다.",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "젊은 밴시가 손을 들었다.\n짙은 색의 로브에서 주문이 가볍게 뛰어올랐다. 마치 아침 햇살을 맞으며 굴러떨어지는 이슬처럼."
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "내가 따르는 건 마왕의 왕관 따위가 아니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "나를 여기까지 오게 한 것은 테레시아 전하의 이상이다. 너희들이 그녀의 목숨을 앗아가고, 그녀의 죽음을 모독한다 할지라도 그녀가 우리 눈앞에서 밝힌 희망의 횃불은 끄지 못할 것이다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "로고스",
          "text": "여명의 찬란한 빛을 본 자가 어찌 영원한 밤 속으로 돌아가리.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
