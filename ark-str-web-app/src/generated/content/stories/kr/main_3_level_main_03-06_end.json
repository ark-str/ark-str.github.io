  "sourceHash": "bb401f5dd6c1f8331a6fcfe087365278b0498b4f36f2e6ef1d010d5ec78beeef",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十八关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "젠장…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "말도 안 돼! 이럴 수가…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "어, 어떻게 이런 일이… 스컬슈레더!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "미, 미샤가 보지 못하도록 해. 이건…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "응급 처치를 할 수 있는 녀석들을 불러!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "제기랄, 메피스토는 왜 안 오는 거냐. 그 녀석은 대체 뭘 하는 거냐고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "다른 계획이 있다고 했는데… 대체 뭘 하고 있는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그 녀석이 있었다면, 더 많은 동료를 구할 수 있었다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그렇게 정이라곤 없고, 동료를 생각할 줄도 모르는 녀석에게 기대를 품는 건 현실적으로 무리지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어떻게 해볼 수 없는 일을 갖고 너희 자신을 너무 몰아붙이진 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "우릴 지켜줘서 고맙다, W…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "적어도, 스컬슈레더를 데리고 돌아갈 순 있겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "감사의 마음은 행동으로 표현해 달라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "물론이지. 네가 후퇴할 때 엄호는 우리가 맡겠다… 대신 부탁이 하나 있는데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "반드시 미샤를 지켜줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "당연하지. 왜냐면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아직 이용 가치가 남아 있으니까. 그렇지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…우리는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "…나와 스컬슈레더, 잠시 둘이서만 있게 해줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "내게… 맡겨줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그렇지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…알았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "W, 부탁한다. 어떻게든 미샤를 지켜다오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "알았어, 알았어~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "스컬슈레더와 둘이서만 있게 해달라고 말했을 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "근데 이제 가야 할 시간인걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이제 슬슬 용문과 로도스 아일랜드가 쳐들어올 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "적의 발을 묶기로 한 리유니온 동료들도 이제 죽는 일만 남았지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아이참~ 번거롭다니까~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "미샤, 너 하나 때문에 이렇~게 많은 사람이 죽잖아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "안타깝기도 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "널 보면 소름이 끼쳐, W.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "나한테서 뭘 얻을 생각은 절대 하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "와~ 무서우셔라~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그 토끼, 아직도 널 걱정하고 있었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하지만 그 용문의 첸이라는 녀석은 달라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "상대가 누구든 절대 사정을 봐주지 않거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어쩌면 널 이용하기 위해 살려둘지도 모르지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이용한 다음에는 어떨까? 우르수스에서 신물이 날 만큼 봐 왔잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "지금 나랑 떠나자. 아직 늦지 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "여기 리유니온 애들은 이대로 내버려 둘 수밖에 없어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "걔네 마지막은 이미 정해진 거나 다름없다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "뭐~ 정말 딱하긴 하지만 말야~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아, 그렇지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "너도 다 봐서 알겠지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이거 미안해서 어쩌지? 스컬슈레더를 체르노보그로 데려갈 만한 힘은 남아있지 않아서 말이야~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "닥쳐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "난 사실을 말했을 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어차피 이제 여기엔 희망이 없는걸~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "생각 바뀌면 바로 연락해야 한다?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "난 반드시…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "스컬슈레더를 살려낼 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "스컬슈레더는 죽지 않아… 절대로 죽지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "이 아이라면 모두를 지켜낼 거야… 모든 사람을 지킬 수 있을 거라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "이 아이라면 반드시 해낼 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "모두 나와 마찬가지야, 다들 감염자야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "나도… 감염자야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "우린 이미 갈 곳을 잃었어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "모두가… 보호받아야 할 사람들이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "스컬슈레더에게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "반드시……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
