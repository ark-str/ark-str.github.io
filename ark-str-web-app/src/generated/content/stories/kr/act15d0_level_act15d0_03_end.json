  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "흥!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수",
      "text": "으악……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(이 죄수는 너무 강해! 다른 죄수들이 모두 이 죄수의 공격 몇 번에 쓰러졌어.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "……죽어라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(이 교도관도 정말 대단한 것 같은데, 어째서인지 방어만 하는 것 같아……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "하앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(큰일이야, 교도관이 쓰러졌어……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(이제 나밖에 안 남았어. 하지만 내가 여기에서 저 사람과 싸우면, 나중에 어떻게 설명해야 하지.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "……다음은 너다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(어떡하지, 싸울 수밖에 없는 건가.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "흥.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "……진짜 빠른데.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(앤소니가 날 구한 건가?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "너희들이 누구인진 모르겠지만, 그렇게 해서는 안 됐다. 내 눈앞에서…… 그런 짓을 해선 안 됐어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "헤헤, 죽기 직전까지도 다른 사람을 걱정하다니, 정말 신사답군, 앤소니 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(아니?! 도대체 언제?!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "헤헤, 꼬마 아가씨, 날 탓하진 마. 탓하려면 재수 없는 본인을 탓하라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "안심해, 앤소니 말고 다른 사람은 죽일 생각 없으니까. 넌 여기에서 좀 자고 있으라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(큰일이다!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "크윽……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(당했다……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "(의식이 흐려지기 시작했어……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "…… 우리가…… 상대해 주지…… 앤소니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "…… 죽어……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "메이어 씨가 요리를 이 정도로 잘하실 줄은 몰랐는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메이어",
      "text": "에헴~ 뜻밖이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "그건 그렇고, 다른 킬러의 암살에 휘말려 의식을 잃다니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "운도 나쁘지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메이어",
      "text": "맞아, 정말 재수가 없었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "그럼 그 암살 사건은 어떻게 결말이 난 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "앤소니 씨가 분명 이겼겠지만, 어쨌든 감옥에서 발생한 암살 사건이니 대충 넘어가진 않았을 거 아냐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메이어",
      "text": "응, 하지만 그 당시 로빈은 의식이 없었던 관계로, 이번에는 카프카의 관점에서 이야기해야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "어, 카프카 씨도 그 죄수 때문에 기절한 것 아니었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메이어",
      "text": "아, 카프카 말로는 기절한 척했다고 하더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "text": "아…… 그런 거였구나. 하긴, 지금까지 했던 얘기만 들어보면, 충분히 그럴 수도 있겠네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "말해라, 누가 보낸 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "헤…… 에헤헤…… 넌…… 알 수 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……기절했군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "이 녀석들 설마……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……됐다, 지금 이런 생각은 아무런 의미가 없어. 우선 죄수들 상황을 살펴봐야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "죄수들",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로빈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "정말 죽이려고 했던 건 아닌가 보군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그리고 이 꼬마 아가씨는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "누군진 모르겠지만, 방금 날 도와준 것 같은데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "고맙습니다, 이름 모를 꼬마 아가씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카라 불러.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "응? 기절한 게 아니었습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "잠깐, 움직이지 말고 몸을 오른쪽으로 살짝 옮겨서, 카메라 좀 가려줘.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "이렇게 말입니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "좋아, 그렇게 하면 카메라로 카프카를 볼 수 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카가 청소할 때 미리 봐둬서 다행이지 뭐람.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "당신은 누구죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "말했잖아, 카프카라고 불러. 카프카는 널 도우러 왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그런데 정말 재수가 없네. 원래는 기회를 봐서 너에게 쪽지를 남기면 끝이라고 생각했는데, 저 사람들의 공격을 받을 줄은 생각도 못했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "도대체 어떻게 된 일이죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "여긴 이야길 나눌 수 있는 곳이 아닌 거 같은데, 어디 괜찮은 곳 없어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……교도관들이 소리를 듣고 몰려들 테니 의무실로 가죠, 거긴 괜찮을 겁니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "어떻게 된 거야! 앤소니, 무슨 짓을 한 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그건 제가 묻고 싶군요, 발톤 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "이 죄수들 사이에 절 암살하려는 사람이 섞여 있었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "무슨 꿍꿍이입니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "뭐라고?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "정말입니다, 발톤 대장님. 그 죄수 두 명이 앤소니 씨를 둘러싸고 있는 걸 봤습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "뭐라고? 너희들 그 녀석들을 지켜보고 있었던 게 아니었나?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "죄수 두 놈에게 맞아 쓰러졌습니다, 그놈들이 너무 강해서 그만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "쯧쯧, 쓸모없는 놈들.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "이런 일을 나보고 어떻게 교도소장에게 보고하라는 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "현재 상황부터 해결해 주시죠, 발톤 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "이 두 사람 모두 자객이니 당신들이 처리하도록 하십시오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "크흠, 하지만 앤소니, 보게, 이번 일은 자네 이야기만 듣고는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "저도 압니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "저는 상처를 좀 입어서 먼저 의무실에 다녀와야겠습니다. 다른 사람들도 저들 때문에 기절했으니 의무실에 보내 보는 것이 좋겠군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "의무실에 다녀와서, 이 일에 대해 자세히 이야기해 드리죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "알겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "너희들 몇 명은 뭘 멍하니 있는 거야! 여기 시체 두 구는 영안실에 버리고, 이 녀석들도 모두 끌고 나가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "아, 네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관",
      "text": "네!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "교도관들은 모두 갔어, 앤소니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "무슨 일 있었어? 다들 굉장히 당황한 모습이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "저도 알고 싶습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "자, 여기는 안전합니다. 카프카 꼬마 아가씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "돔마 씨는 제 친구입니다. 이 감옥에서 믿을 만한 사람이라면 돔마 씨뿐이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카를 꼬마 아가씨라고 부르지 마, 단지 키가 작은 것뿐이라구.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "미안합니다, 카프카 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "……너는 죄수면서 바깥사람보다 더 예의 바르게 행동하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "앤소니는 원래 그래, 누구에게나 예의 바르게 행동하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그렇구나. 싸움도 잘하면서 예의까지 바르다니. 여기 사람들 모두 너를 대단하다고 여기는 이유가 있었네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "과찬이십니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그럼, 이제 제가 질문할 차례군요. 절 도우려고 온 것 같은데, 당신은 절 암살하러 온 사람들의 정체를 알고 있습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "흠…… 그 전에, 카프카가 먼저 질문 하나 할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "너는 네 집, 또는 네 아버지의 성을 딴 사이몬 컴퍼니에 어떤 일이 일어났는지 알고 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "만약 알고 있다면, 복잡하게 설명하지 않을게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……아버지께서 십여 가지의 고발을 당하셨고, 그 배후에 결코 만만치 않은 상대가 있단 것만 알 뿐, 구체적인 상황은 파악할 시간이 없었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "알고 있다면 얘기가 빠르겠네. 사이몬 컴퍼니는 불…… 불 뭐였지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "불법이라고 말하고 싶은 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "맞아! 오리지늄 제품 불법 밀수죄! 어차피 회사는 압류당했고, 핵심 멤버는 모두 감옥에 들어갔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "네 가족은 모두 벙커힐 시티의 감옥에 복역 중이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "앤소니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……전 괜찮습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "마음의 준비는 계속하고 있었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "가족들이 죽지 않은 것만으로도 기쁩니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그럼, 그게 도대체 누구죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "하이드브로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "하이드브로, 역시 네놈들이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "잠시만, 사일런스가 뭐라고 했더라…… 맞아, 너네 가문, 사이몬 가문은 본래 일부 영역에서 그들과 경쟁 관계였지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "너희는 서로 50%의 이익을 차지한 채 마찰을 빚기도 하다가, 그놈들이 너희들 몫까지 차지하려 했던 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그리고 그놈들은 그렇게 한 거고, 아주 간단하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……하이드브로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "아버지께서 자주 거론하셨던 이름입니다. 심지어 그들 회사에 손님으로 간 적도 있었는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "고작 사리사욕을 위해 이런 일을 벌이다니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "저도 비슷한 일을 들은 적은 있지만, 내게 정말 일어날 줄은 몰랐습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "앤소니, 괜찮아. 내가 아츠로 정신을 좀 편안하게 해줄까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "아뇨, 고맙습니다, 돔마 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "마음의 준비는 되어 있었다고 말씀드렸습니다만, 이렇게 갑작스럽게 오리라고는 생각하지 못했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "난 당신을 믿습니다, 카프카 씨. 당신에겐 이 일로 절 속일 이유가 전혀 없으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그렇다면, 그 자객들은 분명 하이드브로가 보낸 것일 텐데, 그들은 왜 이제야 온 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그건 카프카도 정말 모르겠어. 다만 카프카 경험에 비추어 볼 때, 좀 전에 그 사람들이 다는 아닐 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그들은 분명 너를 암살하려고 몇 개의 팀을 보냈을 거야. 다시 말해, 이제 막 시작했다고 보는 게 좋겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그렇다면 당신은요, 단지 날 위해 이 킬러들을 막아주러 온 건 아니겠죠? 당신의 목적은 무엇이죠, 카프카 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카? 흠…… 당장은 설명하기 힘드네. 어쨌든 카프카는 다른 사람의 부탁을 받고 네 탈옥을 도우러 온 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "나가서 복수하고 싶지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "너는 종신형인 데다 가석방도 불가능하잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "네가 여길 나가고 싶다면, 선택은…… 탈옥 하나뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그리고 카프카가 너를 도우러 온 거고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "아, 물론 네가 나가길 원치 않고 평생 여기에 있고 싶다면, 카프카도 억지로 끌고 나가지는 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "탈옥이라…… 하지만 이 감옥에서 무사히 탈출한 사람은 아직 아무도 없는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그렇다곤 하지만, 그래도 시도는 해봐야지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……이 감옥에 온 지 시간이 좀 됐겠군요, 카프카 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "응? 어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "그럼 저에 대한 이야기도 들었겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "흠, 다들 네가 가장 강한 죄수이자 가장 자유로운 죄수라고 말했어. 대부분의 죄수들이 모두 너를 대단하다고 여긴다며.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카도 네가 정말 대단하다 생각해, 지금 이런 순간에도 냉정함을 유지할 수 있다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "하지만…… 사실은 그렇지 않습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "아무리 인간적인 매력이 있다고 해도, 죄수로서 교도관과 교도소장을 굴복시키는 것은 불가능해요. 애초에 이런 평판을 얻지 말았어야 했는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "아, 그건 맞지. 하지만 이미 일어난 일인걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "사실, 전 교도관들의 특혜를 받았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "교도소장이 직접 그들에게, 절 잘 대해달라 했던 걸로 알고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "최근 몇 년 동안 계속 의심했었죠. 제가 아이언포지 시티에서 체포되어 이 감옥에 온 것이 처음부터 제 아버지가 계획한 것이 아닐까 하고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "아버지는 무언갈 예견하고, 절 이곳으로 보낸 건 아닐까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "……전 항상 이런 생각을 합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "아, 사일런스도 그렇게 말했어. 하지만, 그건 그냥 가능성일 뿐이래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "사일런스라면, 당신 배후에 있는 사람의 이름인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "아…… 됐다 그냥. 응, 맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "일이 다 끝나면 그 친구분에게 감사 인사를 해야겠군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "어쨌든, 당신 말대로 이것도 하나의 가능성일 뿐이겠죠. 원인을 알려면, 전 반드시 밖으로 나가야 합니다. 이 일은 제 자신만이 정확히 할 수 있으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "돔마",
      "text": "앤소니, 그 여자에게 알려도 정말 괜찮을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "상관없습니다. 전 잠시 당신을 믿도록 하죠, 카프카 씨. 당신에겐 허심탄회하게 이야기하고 싶군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "당신이 오지 않았더라도, 제가 아무리 이 감옥 생활에 익숙해졌다 해도, 전 늘 이곳을 떠나고 싶어 했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "전 이곳에서 제가 원하는 것을 대부분 얻을 수 있지만, 어떻게 이곳에서 빠져나갈 수 있을지에 대해서는 갈피를 잡지 못하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "사실 당신에게 부탁을 해야 하는 건 접니다, 카프카 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "제가 탈옥할 수 있게 도와주십시오.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
