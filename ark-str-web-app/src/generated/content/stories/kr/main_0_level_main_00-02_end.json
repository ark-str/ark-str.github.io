  "title": "방어",
  "storyCode": "0-2",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_00-02_end.txt",
  "sourceHash": "55a06a1e7154308380a48b8cdb972a5d6a51e171c99ded663b829d35c6d38864",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "하아, 하아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "리유니온 놈들… 말도 안 되게 강하군!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "너희는 뭐 하는 놈들이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "왜 이런 시기에 체르노보그에 나타난 거지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "아니? 무, 무슨 짓을…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "스파이냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(만약 우르수스 당국이 우리의 정체를 알게 되면 일이 복잡해진다!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(그렇다면…!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저기요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "…여자아이잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "너… 감염자냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "움직이지 마라! 무기를 버려라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(방어할 준비를 하도록. 저쪽에서 공격할 낌새가 보이면…)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(연기잖아? 어디서 피운 거지…)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "우리에게 적의를 드러낸 존재가 누구인지, 당신이라면 분명 잘 알고 있을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "도베르만 씨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "디펜더 오퍼레이터! 습격이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "뭐, 뭐지?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…리유니온.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "아미야, 조심해라…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "저 녀석은 단순한 감염자 폭도가 아닌 것 같다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "흠, 도망쳤나…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "하지만 이제 도망칠 곳이 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "가라, 놈들을 찢어버려.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "저 녀석의 부하들도 꽤 훈련을 받은 모양이군…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "설마 리유니온의 리더인 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "안개가 더 짙어졌어요… 안갯속에서 기습하려는 걸까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "헌병 여러분, 어서 이곳을 벗어나야 해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "만약 퇴로가 막혀버리면 우리는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "너희 감염자 놈들은 빨리 꺼져.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "우리는 이 거리를 사수하라는 명령을 받았다. 이곳을 떠날 수는 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "감염자 아가씨, 너희가 무슨 목적으로 여기 왔는지, 뭘 하러 왔는지는 관심 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "하지만 만약 우리 도시를 파괴하러 온 거라면, 반드시 너희를 벌할 거다. 우르수스의 분노는 죽을 때까지 멈추지 않으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "그게 아니라면… 여기서 일어나는 일들은 너희와는 아무 관계 없는 걸로 알겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "우르수스인은 결코 적에게 등을 보이지 않는다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "빨리 사라져! 너희한테 신경 쓸 시간은 없다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "감사합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "도베르만 씨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "가자! 첫 번째 합류 지점으로 간다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "각 팀! 서둘러라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "덤벼라! 감염자 놈들!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병대장",
      "text": "거기서 멍청하게 서 있기만 할 셈이냐?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "체르노보그인……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "죽어라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
