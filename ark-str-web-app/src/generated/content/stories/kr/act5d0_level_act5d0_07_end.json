  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act5d0/level_act5d0_07_end.txt",
  "sourceHash": "ddf543e3537ee26d3ecb2b96963435b920304e07f6c490128e7b743d6a5bb635",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "하아, 하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카포네",
      "text": "아직이다, 계속 덤벼라, 펭귄 로지스틱스!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "너희들, 사이 좋았던 거 아니었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카포네",
      "text": "쳇!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "왜 내한테 달려오노?! 망치 나가신다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "윽! 넌 대체 누구 편이냐!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "제, 제가 한 게 아닙니다! 저 천사가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "에헤, 빗나갔네. 뭐 상관없지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아A",
      "text": "이 틈을 타서……! 위험해! 왜 내 쪽을 공격하는 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아B",
      "text": "미안. 역시 보스를 따라야겠어!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아A",
      "text": "나도 보스를 따르겠다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아B",
      "text": "뭐라고?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "다 누워서 뭘 하는 거야? 안 죽은 놈들은 다 일어나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "네, 네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그렇게 다그치면 부하들이 고생이라고. 의료비 청구는 해주는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……혼란스럽네. 아무튼 검은 옷 입은 놈들을 다 때려눕히면 되는 거지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "뭐야 여기… 완전 난장판이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "그렇네요…… 에?! 모스티마 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "다들 건강해 보여서 다행이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……여긴 어떻게 온 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "보스가 가보라고 해서 말이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카포네",
      "text": "칫. 그 이상한 산크타인인가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "꺼져!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "자자, 진정해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "여기서 이긴다고 뭐 달라져? 일단 다들 물러나라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아A",
      "text": "저 여자, 보스의 공격을 막았어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아B",
      "text": "아니! 아츠 스태프다! 보스, 조심하십시오! 캐스터입니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카포네",
      "text": "……정면 승부를 피한 건 잘한 일이었군…… 어이, 저 녀석한테 가까이 다가가지 마라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "……너 같은 산크타는 본 적이 없는데. 아니, 살카즈인가? 넌 대체 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "평범한 전달자지 뭐겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "헛소리 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "뒈져버려……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "아 잠깐 타임…… 이라 해도 들어줄 리 없나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "감히 날 얕봐?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "다들 잘 지냈어? 지난번에 만나고 얼마 만이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "어디를 보고 있는 거냐?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "몇 년이었나? 아닌가? 몇 달 만인가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "크윽!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "너무 열심히 살아서, 시간 가는 줄도 몰랐는걸.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……거의 4년 3개월이야, 모스티마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "응, 정말 오래간만이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "그런 표정 짓지 마. 넌 진지한 표정 지으면 꼭 어디 아픈 것 같다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아 쫌! 감동적인 재회 아니었어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "감동적인지 아닌지는 이따가 얘기하자. 지금은 그럴 때가 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "정말 여기서 할 셈인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "뭐, 운동 삼아 적당히.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……알겠다. 힘 조절 꼭 해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "걱정 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "그리고, 기다리고 있는 손님이 한 사람 더 있거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "몇 번을 봤지만, 모스티마 씨가 휘두르는 아츠 스태프는 정말 엄청난 거 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "마피아 놈들, 놀라 뒤집어져삣네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "영차. 이 틈에 한둘 더 잡아둬야 하는 거 아냐?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "왜 그래? 더 못 하겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "……실력은 있을지 몰라도, 맹세컨데 여길 쉽게 빠져나갈 수는 없을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "그렇게 무섭게 말하지 말고 식후 운동쯤으로 생각하자고…… 음.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "무, 무슨 일이지? 방금 저 불길이 굳어진 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "……아무래도 이스가 이 근처를 지나가는 모양이네. 역시 속전속결로 끝내자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "뭘 혼자 지껄이는 거냐!? 네 상대는 나다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "한 조직의 리더란 사람이 그렇게 성격이 급해서야, 밑 사람들 제대로 관리할 수 있겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "이 자식이! 여유있는 척하기는!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "아츠다! 피해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "도와주러 갈 필요 없어. 우리는 펭귄 로지스틱스만 상대하면 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……얕보인 모양이군. 한번 보여주자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "오케이! 하앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "이게 전달자, 모스티마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "전달자…… 다른 회사의 전달자들은 모두 이런 건가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "……바람이 불고 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "……바람?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "텍사스! 철수해, 어서!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……알겠다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "어이! 왜 갑자기 땅이 흔들리는 거지?! 저 캐스터가 뭘 한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "나이도 먹을 만큼 먹은 사람이 참, 성질도 급하지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "도망칠 생각은 마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "으윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카포네",
      "text": "쳇, 아츠다. 일단 피해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "이런 곳에 왜 모래 폭풍이?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "이거, 상황이 안 좋은 거 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "텍사스 씨! 출구는 이쪽이에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "바이슨과 모스티마는? 윽!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "모래 폭풍 때문에 갈라졌어. 갔다 올게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "잠깐, 엑시아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "정말이지, 모스티마와 관련된 일이라면 늘 저렇게 열을 올린다니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "텍사스 씨! 모스티마 씨! 어디 계세요?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "윽, 눈에 모래가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "당황하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "모스티마 씨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "모래바람을 막으면서 나를 따라오면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "모스티마",
      "text": "……이렇게 가까이서 느껴보니 이 할아버지, 확실히 함부로 건드리면 안 되겠네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마피아A",
      "text": "땅, 땅이 무너진다! 모래에 휩쓸리면 안 된다. 물러나! 말려들면 안 돼!",
      "portraitKey": null
