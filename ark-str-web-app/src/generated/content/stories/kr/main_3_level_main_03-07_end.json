  "storyId": "main_3_level_main_03-07_end",
  "groupId": "main_3",
  "stageId": "main_03-07",
  "title": "굉음",
  "storyCode": "3-7",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_03-07_end.txt",
  "sourceHash": "ef4d32d0a46b9181d27525d332fc3cad020bc326c1aca87a5e58da69147a7f0b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十九关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "못 지나가게 막아라!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "W는 미샤를 데리고 퇴각했을 거다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "녀석들을 막아라!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "……죽기 싫으면 길을 열어라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으, 으악!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "우, 우와… 이런 난폭한 싸움법을 보니, 로도스 아일랜드의 그 녀석이 떠오르네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그 녀석이랑 호시구마가 만나면 서로 잘 맞지 않을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "멍하니 서 있지 마라, 프란카!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "어서 움직여!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "알았어, 알았다고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "하핫, 용문 경찰의 전설은 사실이었나 보네…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "집중해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "구경만 하고 있던 건 아니야~!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "저쪽을 관찰하고 있던 거라고! 빵~!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 캐스터",
      "text": "으아악!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "폐허 2층의 공격 부대, 내가 눈치 못 챈 줄 알았지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "잘했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "헤헷.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "…가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "의뢰인이 혼자 힘들게 싸우게 내버려 둘 순 없지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프란카 씨, 미샤 씨는 찾으셨나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "어디에도 흔적이 안 보여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "W가 이미 그 아이를 데려간 걸지도…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "쳇, 그렇다면 말도 안 되게 빨리 대응했다는 건데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "폭발…? 어디지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프란카 씨, 각 팀을 집결시켜 주세요. 근위국을 지원해야 해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "로도스 아일랜드 여러분, 조심하십시오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "이 적은, 이 녀석은, 설마…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "이 녀석은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…무슨 일인가요? 왜 말씀을 멈추신 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "적이…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저건…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "어, 어째서…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "쳇, 이건 또 무슨 말도 안 되는…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "기적, 기적이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "어…어떻게…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "멍하니 있지 말고 엄폐물을 찾아라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "기적이 일어났다!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…너… 정말 너 맞는 거지!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…스컬슈레더다!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "사, 살아있었구나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더가 돌아왔다!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더! 진짜로 스컬슈레더야!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "만세!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……설마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……아니야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "리유니온… 리더가 부활해서 사기가 오른 건가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "더 성가셔지겠군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…전황은 여전히 좋지 않다, 스컬슈레더.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "하지만 그래도… 넌 우리에게 돌아와 줬다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…다행이야… 정말… 다행이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "미샤도 지금쯤 무사히 빠져나갔겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그렇다면 우리도 이제 죽을 각오로 싸울 수 있겠어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…내가 여기서 적을 막겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너희는 어서 여길 떠나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너희를 지켜주겠어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더, 무슨 소리야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "말했잖아, 함께 우르수스로 돌아가자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너희들 자신을 제일 먼저 생각해. 죽지 마라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "말도 안 돼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그렇게 멍하니 서 있을 때가 아니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마, 지금 즉시 포위망을 치고 있는 근위국 대원에게 알려라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "함정과 복병은 이미 제거했지만, 적의 리더인 W와 임무 목표는 여전히 발견하지 못했다고 알려!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "지금 즉시 작전을 변경한다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이제부턴 포위망을 풀고, 리유니온을 협공한다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "어째서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……왜 이런 짓을……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "안 돼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
