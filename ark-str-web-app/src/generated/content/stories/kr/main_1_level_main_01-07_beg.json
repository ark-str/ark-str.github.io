  "storyId": "main_1_level_main_01-07_beg",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "폭군",
  "storyCode": "1-7",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_01-07_beg.txt",
  "sourceHash": "2561c160c982ae1110452865ffa4574e140a91b02bfe546412b7d4ec0f2ac436",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "충격에 대비하라!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "모두 흩어져!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "규모가 너무 커… 이대로는 이 구역에 있는 건물과 함께 먼지가 되고 말 거다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "제길, 큰일이군!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "——!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "어서 퇴각하라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "버텨라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "아…!! 떠, 떨어진다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "하늘이… 무너진다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "시, 싫어… 아파…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "손이, 손이! 내 손 어디로 간 거야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "뭐, 뭐야! 뭐냐고!! 죽고 싶지 않아…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으아아악!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "디펜더!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "아군 캐스터를 보호하라!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "……!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "이건 무슨 소리지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "거대한 운석이 주변 건물에 떨어졌어! 무너진다!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "아…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…저 위치는… 메딕! 위험해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "젠장, 어서 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "앗!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "…으으, 바, 박사님?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "박사님이 메딕을 밀어서 구해내셨다고?! 하지만… 그렇다면 박사님은…!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "박사님이 위험해!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "{@nickname} 박사!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "아니?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "니, 니어 씨!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "박사, 엎드려!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "후우…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "늦지 않았군!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "니어 씨가… 박사님을 구했다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "크헉…!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "니어 씨! 박사님! 어서 이쪽으로!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "문제없다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "내 방패는 아직 버틸 수 있어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "뛰어, 박사!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "뛰는 거다!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "박사님, 박사님…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "괘, 괜찮으세요?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "괜찮아. 별일 아니다!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "고마워, 니어 씨.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "혼자서…… 그런 위험한 짓을 하다니!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "앞으로는 적어도 날 데리고 가라. 내가 박사를 지킬 테니!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "무슨 일이 있어도 박사가 다치는 것은 용납할 수 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "내 눈앞에서 그런 일이 벌어지는 건 더더욱 안 된다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "모두 무사해서 다행이에요…!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "하지만 우린……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "(앞으로 얼마나 버틸 수 있을까요?)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "(살아남을 수는 있는 걸까요?)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "…으으…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "운석의 양이 줄어들고 있는데요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "재앙의 첫 단계를 겨우 넘겼나 봐요…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "아직 안심하기엔 이르다. 이번 재앙이 언제까지 계속될지는 아직 알 수 없으니.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "하지만 일단은… 재앙의 중심에 있는 건 우리가 아닌 것 같군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "무사히 빠져나온 것 같다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "네…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "여러분, 괜찮으세요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "오퍼레이터 전원, 무사합니다…!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "일부 다친 사람들이 있지만, 경미한 부상입니다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가드 오퍼레이터",
          "text": "우린… 살아남은 겁니다!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "아……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "리유니온도 아직…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "…어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "어… 어!! 로도스 아일랜드!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "…뭐지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "아…!!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "아직도 우리를 공격할 생각인 걸까요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "로도스 아일랜드!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "이 녀석들이!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "놓치지 마라…!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "미쳤군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "니어",
          "text": "목숨이 아깝지 않은 거냐?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "도베르만 씨…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "어쩔 수 없지…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "철저히 쓰러뜨리고, 바로 이동한다!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
