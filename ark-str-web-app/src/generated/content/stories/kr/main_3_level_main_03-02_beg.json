  "sourceHash": "3e4d55596859add4782450aedbd82abbc57fa93c12b0a98001ed5cf0cc06a710",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이제야 왔나, 호시구마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "미안하군. 아까 그 적한테 시간을 너무 많이 빼앗겼다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "다친 데는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "멀쩡하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "하지만, 그 감염자의 실력은 정말 놀라울 정도였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "특별감찰팀은 용문 중심 지역 방위에 할당할 전력을 최근에 보강한 상황이었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "거기에 내가 쓸 수 있는 팀원을 모두 이끌고 나왔는데도 애를 먹었으니, 놀랄 수밖에.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "…특별감찰팀이 정말 단 한 명한테 쩔쩔맸다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "나도 직접 보기 전까지는 안 믿었지만,",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "녀석은 분명 그 정도의 힘을 갖고 있었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "게다가, 그렇게 엄청난 힘을 가졌으면서도… 마치 마음이 딴 데 가있는 것 같더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그러고 보니 옆에 있는 건…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "로도스 아일랜드?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님, 이분은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "특별감찰팀의 정예, 호시구마다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너희가 로도스 아일랜드인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "호오, 이렇게 작은 소녀도 로도스 아일랜드 소속이라 이건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그 작은 소녀가 로도스 아일랜드의 리더다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "체, 첸 팀장님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "호오……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "한 가지만 확인하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너희들의 작전 방침은 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "두 명의 특별작전팀원이 미샤 씨를 습격한 적의 동향을 파악했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그래서 현재 추격 중이며, 언제든 지시를 내릴 수 있는 상황입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "괜찮네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "첸, 네가 칭찬을 한 이유가 있었군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "다들 실력이 출중해 보여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님께서… 칭찬을 하셨다고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "흥.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마, 근위국 전 부대를 소집해. 작전을 시작한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "로도스 아일랜드, 길을 안내해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…알겠습니다. 그런데, 리유니온에서 저희를 저지할 병력을 남겨둔 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저희의 진행 경로 쪽에 복병을 매복시킨 것 같습니다…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그 정도는 문제없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네, 주의 깊게 행동하면 놈들의 흔적을 찾아 선제공격을 가할 수 있을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "좋아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "로도스 아일랜드가 전투의 프로인지 아닌지, 판단해 보도록 하지!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
