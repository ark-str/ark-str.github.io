  "sourceHash": "0f3785b1e9959eb4515bd0a67da7bc1b731254c74d12446090535e3f795a8ea5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "혼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "백파이프",
      "text": "……아, 다, 당신은……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "후우…… 하아…… 이제 괜찮아졌습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "사람은 나이를 먹을수록 밝고 따뜻한 곳을 선호하게 되는 법이지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "이 냄새는…… 콩인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "백파이프",
      "text": "아, 맞다. 방금 저녁으로 먹으려고 콩을 좀 삶았거든. 통조림이기는 하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "백파이프",
      "text": "쪼매 줄까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "그럼 사양하지 않도록 하죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "음…… 고향의 조미료가 조금 부족하군요. 여기에다가 염장 고기를 추가하면 더 맛있어지겠어요.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "그렇지! 나도 그렇게 생각한다니! 고도딘 사람이라면 응당……\n윽……"
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "왜 그러십니까, 아가씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "백파이프",
      "text": "아무것도 아이야. 그나저나 신문에서 보던 꼬라지랑은 마이 다르네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "후훗, 그쪽 대장한테서 더 많은 이야기를 들을 수 있을 겁니다. 어렸을 때 제가 업어 키웠거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "리타가 어렸을 때 제게 그랬죠. 공작님은 매끈한 뿔이 나있는데, 왜 아빠한테는 없냐고 말이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "혼",
      "text": "……무례를 용서하시길, 공작님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "감히 내 뿔을 건드린 사람은 그리 많지 않아요. 스카만드로스 중위, 자네는 어렸을 적부터 타고난 용맹함을 증명한 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "혼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "뭐랄까…… 여기 있는 모두가 우리 빅토리아에서 가장 뛰어난 전사들이라고 할 수 있지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "체틀리 카운티 방어전에서 감탄이 나올 만큼 훌륭한 활약을 펼쳐줬습니다. 그 후 브렌트우드 마을에서도 마찬가지로 뛰어난 활약을 보여줬고 말이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "파라곤 부대…… 라고 했지요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "진작부터 우리의 영웅들을 직접 만나고 싶었습니다. 유감스럽게도 당신들의 리더는 저와 마주치고 싶지 않았던 모양이지만요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "공작님, 제가 생각하기에 공작께서 갑자기 이곳을 방문한 걸…… 선의라 생각하는 사람은 거의 없을 것 같군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "윈더미어 양, 물론 저도 잘 알고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "이런 특별한 시기에는…… 특히나 더 그렇지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "이미 사람을 '갈라바에 철 방패'에 보내 놓았습니다. 주행속도는 훌륭했지만, 시간이 걸려서 겨우 암펠리스에 꽃 한 송이를 바칠 수 있었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "……호의에 감사드립니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "공작님께선 우리에게 훈장이나 주려고 직접 이곳에 온 게 아닐 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "만약 ……그렇다고 한다면?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "좀 더 직설적으로 얘기해 주겠어? 우리 대부분은 귀족이 아닌 데다가, 고등 교육을 받은 적도 없어서 말속에 숨은 뜻을 찾는 데엔 익숙지 않거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "알렉산드리나 전하, 듣던 대로…… 솔직 담백하시군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "아니면 동료들이 부르듯이 시즈라고 부르는 게 좋을까요? 그게 전하께서도 좀 더 편하지 않으시겠습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "시즈 씨, 사실 저는 '파라곤 부대'가 공작 부대를 피하는 이유를 잘 알고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "당신께서는 파라곤 부대가 공작들 간의 정치 싸움에 말려드는 것을 원하지 않는 것이겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "파라곤 부대가 그 전설의 부대처럼, 오직 빅토리아와 빅토리아의 백성들을 위해 싸우기를 원하는 것일 테죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "그렇기에 저는 지금, 고도딘 공작으로서 이곳에 온 것이 아닙니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "저, 빅토리아 의회의 일원인 숀 고도딘이, 의회 직속 부대 폭풍돌격대 및 파라곤 부대 여러분을 초대하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "과거의 식별코드 상자는 내려놓으시죠. 저는 여러분께서 의회의 이름으로 이 전쟁에 개입하기를 원합니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "……광부들의 캠프가 완전히 파괴됐다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "살카즈 병사의 흔적은 찾지 못했어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "미저리는 조금 추위를 느꼈다. 불에 타 재만 남은 캠프에서 열기는 거의 느껴지지 않았다.\n미저리는 무너진 목재를 헤치고 형체를 알아볼 수 없는 시체들을 발견했다."
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "광부군. 감염자의 시체다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "……저기도 마찬가지야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "무슨 소리지……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "땅속에 '영장'이 숨어있었나.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "깁스넘 서북쪽 외곽에서 나흐체러르를 발견했다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "……통신 범위를 벗어났나.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "'영장'",
      "text": "죽음이, 너를 붙잡으리라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "각인이 새겨진 여러 개의 검이 미저리의 발밑에서 튀어나왔지만, 미저리는 이미 자리를 이탈한 뒤였다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "비수가 공간을 베었지만, 미저리는 이미 공격 범위 밖으로 물러난 상태였다. 무너져 쓰러진 폐허는 순식간에 그들을 옥죄는 감옥이 되었고, 나흐체러르의 메마른 신체를 가두었다."
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "시끄럽기는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미저리",
      "text": "나도 너희를 붙잡았다고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "……공작님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "빅토리아 의회는, 아주 오랫동안 정상적으로 운영되지 않고 있는 걸로 알고 있는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "런디니움에서 탈출한 사람들이 말하길, 이 기간 동안 성왕궁 서쪽 회당에서 명령을 내린 것은 살카즈라고 하더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "물론, 현 상태를 부인할 마음은 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "하지만 전투가 끝난 후의 미래를 바라보는 것도 괜찮겠지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "흥, 미래? 그게 협박이든 달콤한 유혹이든, '거래'를 하기에는 아직 너무 이르지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "제 의도를 오해하셨군요. 고도딘은 캐스터와 다릅니다. 협상보다는 난롯가에 앉아 친구들과 함께 술을 마시고 카드놀이를 하는 걸 좋아하지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "정말이지, 여름이 지나니 날씨가 갑자기 추워지는군요. 부하에게 장작을 더 넣게 해도 되겠습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "벌써 문밖에 대기하고 있겠지. 들어오게 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "감사합니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "휴우…… 이제 좀 편해지는군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "아까 어디까지 얘기했었죠? 아, '미래'였죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "저희 모두 전쟁이 빅토리아의 승리로 끝날 것이라는 걸 알고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "게다가 이 전쟁은 틀림없이…… 아니, 이미 우리에게 돌이킬 수 없는 영향을 끼쳤죠. 이십 년 동안 교착 상태에 빠졌던 국면이 마침내 변화를 맞이한 것입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "이 방 안에 성안의 빈 왕좌에 관심을 가지고 있는 사람이 있다면, 분명 난 아닐 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "하하, 좋습니다. 적어도 공감대가 하나는 생겨났군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "솔직히 말씀드리죠. 얼마 전에 자그마한 연회 자리를 마련해 철의 공작을 만나 보았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "철의 공작을 만날 때마다 '가스트렐'호를 처음 보았을 때가 생각나더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "저는 '제국의 조종' 전설을 듣고 자란 많은 아이들과 마찬가지로, 링고네스에서 유해의 그림자를 찾으려고 부단히 노력해 왔습니다만…… 결국 그 그림자에서 가울을 찾을 수는 없다는 것을 깨달았죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "제가 본 것은 그저 이 시대의 가장 강성한 나라의 빛이었습니다. 마치 제 눈이 멀어버릴 듯한 그런 빛이었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "그러니까 당신은 고도딘 영지의 이익보다…… 빅토리아 전체의 이익을 생각한다고 우리가 믿게 만들려는 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "일종의 '고상한' 애국심 같은 것을 말하는 거라면, 솔직히 말하죠. 제게 그런 것은 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "저는 공작으로서 어떤 상황에서도 자신의 영지를 우선시할 수밖에 없었습니다. 이건 이익의 문제뿐만이 아니라, 일종의 책임이기도 하죠. 그러니 부디 절 믿어주시길 바랍니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "저는 고도딘과 웰링턴에 큰 차이가 있다고 생각합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "빅토리아가 없어도 웰링턴은 여전히 웰링턴이죠. 하지만 빛이 어두워지거나 꺼진다면 고도딘은…… 어떻게 될까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "최악은 피할 수 있을지도 모르겠습니다만, 더 좋아지지는 않을 거라는 건 확실하지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "진심으로 대공작들이 분열하는 것을 보고 싶지 않다는 건가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "저만 그런 게 아닙니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "이런 생각을 가진 것이…… 저뿐만이 아니라는 것은 당신께서도 잘 아실 거라고 생각합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "빅토리아는 강력하지만 적수가 없는 것은 아닙니다. 우르수스, 라이타니엔, 컬럼비아, 심지어 사르곤까지, 야심을 품은 모든 나라가 우리를 주시하고 있죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "이 전쟁이 끝나면, 우리는 빅토리아를 빠르게 안정시키기 위해 통일된 하나의 목소리가 필요합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "그게 바로 의회가 존재하는 이유죠. 윈더미어령을 포함한…… 모든 공작령이 가장 적합한 대리인을 선출할 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "이것이 전쟁 영웅인 당신들 '파라곤 부대'가 가지는 의미입니다. 빅토리아를 위해 기꺼이 분투한 병사들은 두 번 다시 배신당하지 않을 것입니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "혼 & 백파이프",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "알렉산드리나 전하, 빅토리아 의회가 설립된 이래로 의장은 항상 국왕이 담당해 왔습니다. 하지만 그렇다고 의장이 반드시 왕좌에 앉아야 한다는 의미는 아닙니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "만약 당신께서 원하시기만 한다면, 그 사실은 우리 모두에게 큰 의미를 가져다줄 수도 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "삽시간에 정적이 흘렀다.\n오직 고도딘이 피운 불이 내는 소리만 들릴 뿐이었다."
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "공작님, 하나만 묻지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "지금까지 한 이야기들은 전부, 이 전쟁이 끝나고 나서 들려줘도 상관없는 내용뿐이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시즈",
      "text": "그렇다면 내가 지금 “아니요”라고 말한다면, 나와 동료들은 왕의 숨결을 가진 채 이곳을 떠날 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고도딘 공작",
      "text": "하하.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "혼",
      "text": "시즈 씨, 조심하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "백파이프",
      "text": "대빵, 석궁병이 나타났사!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "델핀",
      "text": "포위됐어. 아니, 애초에 공작이 나타났을 때부터 이미……",
