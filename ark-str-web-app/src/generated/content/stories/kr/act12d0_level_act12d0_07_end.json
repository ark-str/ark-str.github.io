{
  "server": "kr",
  "storyId": "act12d0_level_act12d0_07_end",
  "groupId": "act12d0",
  "stageId": "act12d0_07",
  "title": "먼저 온 손님",
  "storyCode": "RI-7",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act12d0/level_act12d0_07_end.txt",
  "sourceHash": "0ad51ac7e904df68f74e985b247efe231d768b15fa20907470d7a0f238261faa",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "케오베",
      "text": "이렇게 강한 리유니온이 있다니… 흥, 그래도 케오는 지지 않을 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "뭐래 이 멍청이가…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "정신 차려!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "케오베",
      "text": "어라라? 여긴 어디?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케오베",
      "text": "아, 가비알! 다들 왔구나!",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "좋은 아침.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "케오베",
              "text": "에헤헤~ 박사도 좋은 아침~",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "케오베",
              "text": "으으, 박사 얼굴이 좀 무서워. 나 뭐 잘못했어?",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "케오베",
              "text": "박사, 화내지 마……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "(꿀밤을 한 대 먹인다)",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "케오베",
              "text": "아야야… 아파! 박사.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "케오베",
              "text": "왜 갑자기 머리를 때리는 거야……",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "정신이 좀 돌아왔나 보네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "케오, 어떻게 여기에 왔는지 기억나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "음…… 까먹었어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그래.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "자, 우선 누워. 몸 상태가 괜찮은지 봐줄게. 다음엔 맘대로 돌아다니지 마.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "응~ 어라? 근데 여긴 어디야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "여기는…… 쳇, 어떻게 설명해야 할지 모르겠네. 아무튼 누워 있어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "응~",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "가비알, 무슨 짓이야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "너한테 설명하는 것도 번거로운데. 일단 기다려 봐.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "10분 후"
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "좋아, 별문제는 없네. 함부로 돌아다니지 말고, 박사 옆에 가만히 있어. 또 맘대로 나다니면 벌꿀 쿠키 안 줄 거야!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "케오베",
          "text": "앗! 벌꿀 쿠키!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "이제 됐어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "그럼 가비알, 지금 뭐 하자는 거야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "후, 말하자면 좀 복잡한데, 아무튼 난 널 찾아온 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "엔진은 돌려주지 않을 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "엔진도 엔진이지만, 다른 일로 왔어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "다른 일?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "너, 혹시 부하들한테 철광석 채굴하라고 시켰어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "그랬지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "……쳇.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "가비알, 네가 이렇게 패배를 인정하지 못 하는 사람인 줄은 몰랐는데.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "거대하고 못생긴 것에게 진 게 그렇게 납득이 안 되나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "아냐, 그 거대하고 못생긴 건 정말 대단해. 결과에 승복해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "단지 네가 부하들을 광석병에 걸리게 하면서까지 채굴을 시킨다면, 난 의사로서 반드시 널 막아야 해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "응? 광석병? 아, 돌멩이병 얘기하는 거구나.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "난 그런 적 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "뭐?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "광산 깊은 곳으로는 가지 말라고 수차례 당부했어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "근데 네 부하는 광석병에 감염됐잖아!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "말 안 듣는 녀석이 기어코 들어가는 걸 내가 막을 순 없잖아. 안 그래? 요기.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "요기",
          "text": "맞아, 형은 대족장에게 광석을 더 많이 캐주려고, 위험을 무릅쓰고 깊은 곳으로 들어간 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "뭐어? 그럼 진작에 그렇게 말했어야지!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "요기",
          "text": "묻지도 않았잖아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그렇게 중요한 걸…!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "네가 그랬잖아. 여기서는 광석병을 심각하게 여기지 않는다며.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "쳇, 알겠어.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "박사, 설마 내가 정말로 안 물어봤던가?",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "네가 안 묻긴 했지.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "쳇, 박사까지 나한테 왜 그래?!",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "게다가……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "어이, 왜 갑자기 옷을 벗고 그래!?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "응? 너, 몸이……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "난 어렸을 때부터 광산 안을 돌아다녔으니 돌멩이병에 걸리는 것도 당연하지만,",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "그래도 광산에서 병에 걸리게 하는 광석이 어디에 있는지 나보다 더 잘 아는 사람은 없다고 장담해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그렇구나.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그래, 내가 괜히 널 오해했네. 미안해, 주마마.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "괜찮아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "우타게",
          "text": "엥, 그냥 이렇게 화해하는 거야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "우타게",
          "text": "이런 상황이면 보통 서로 양보하지 않다가 대판 싸우고 그러지 않나?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "크루아상",
          "text": "그런 건 기대하지 마래이!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "가비알은 그런 사람이 아니야!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "아쉽네.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그럼 다른 이야기를 하지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "우리 엔진은 네가 가지고 있지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "응.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "우리한테 돌려주면 안 돼? 그게 없으면 우리는 돌아갈 수가 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "안 돼.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "돌아가고 싶으면 내가 사람을 시켜서 널 데려다 줄 수 있어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그건 안 돼. 켈시가 화낼 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "어떻게 좀 안 될까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "어떻게 해도 안 돼.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "우타게",
          "text": "오오, 싸우겠다 싸우겠다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "아무래도 손을 써야겠네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "난 애초부터 그럴 생각이었어.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "훗, 이 녀석들과 싸우면 되는 건가? 재밌군!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "모두들 안녕하신가!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "대제사장…… 왜 거대하고 못생긴 걸 끌고 온 거지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "왜, 가비알과 싸우려던 거 아니었나? 필요 없어? 그럼 난 돌아가마. 엔진 테스트를 하긴 해야 하거든.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "……필요하긴 한데, 지금은 아니야. 해야 할 얘기가 있어서.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "대제사장",
          "text": "허허허 그래. 그럼 하던 얘기 마저 하고, 싸울 때 다시 불러라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "알았어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "야 잠깐, 방금 엔진 어쩌구 하지 않았어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "맞아, 거대하고 못생긴 것에 네 엔진을 장착했어. 원한다면 힘으로 빼앗아 봐라.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "훗, 그럼 덤벼라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "따라와. 광장에서 결판을 내자!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
