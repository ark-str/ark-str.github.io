  "title": "두려워하지 마",
  "storyCode": "4-4",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_04-04_end.txt",
  "sourceHash": "642994a0eb10dd03f19067a6c69903fbe99659517d9180cce93615ae59a58a34",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "하아, 하아… 제길…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "어떻게… 해결하긴 했네요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…아니, 아직 멀었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "저기 떨어지는 분진은… 대체 뭘까요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으, 으윽…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으, 으아아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "아파… 아파…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "아아… 으아악! 가려워, 가려워!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "어어?!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "로… 로도스 아일랜드!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "저… 적이다!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "아니…! 대체 어떻게 된 거죠…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "쓰러뜨린 적들이 다시 일어서고 있는데요…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "왜 그래? 벌써 항복하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "저 녀석의 지팡이에서 빛이 나는데…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "아직 나는 손도 안 썼는데 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "게다가… 더 많은 증원군이…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "쳇…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "이렇게 된 이상, 이 한 발로 적의 리더를 쓰러뜨릴 수밖에…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그만둬.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "하하… 이런 상황에서 그런 말을 할 여유가 있나봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "자신감이 넘치나 보네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "흥, 이 수류탄으로 한 수 가르쳐 주지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그만둬, 메테오라이트. 소용없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "크윽…! 왜 그래!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "바로 퇴각해야 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "느껴진다고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "녀석들이, 그 녀석들이 왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "어? 안 쏴?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "아깝게 됐네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "이번 기회를 놓치면 다음은 없을 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "저 녀석도 퇴각하려는 건가? 그보다…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "메테오라이트! 서쪽에 있는 높은 건물을 쏴 버려! 어서! 적어도 적의 주의는 끌 수 있을 거다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…그게 정답인 것 같네! 내게 맡겨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "제시카, 뛰자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…악마들이 온다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "잠시만요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "추, 추워요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "지금 당장.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…제시카.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "프로스트리프의 말이 맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "어서 가야 해…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "아미야, 들리나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "대답해라, 제발 대답해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "빨리 가자! 내가 엄호할게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "잘 들어라, 아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…이곳에 와선 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "이 버려진 도시는…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
