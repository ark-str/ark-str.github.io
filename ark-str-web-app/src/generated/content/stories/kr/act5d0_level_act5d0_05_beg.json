  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "야호~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "길 똑바로 안 보나! 언니야, 핸들은 두 손으로 단디 잡아라 쫌! 한 손 띄지 말고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "어쨌든 따라잡았군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "텍사스 씨…… 다음번엔…… 제발 천천히 좀……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "음? 미안. 최대한 노력한 건데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어쨌든 다 모였으니, 이제부터 보스를 찾으러 가볼까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어라~? 잠깐, 뭔가 빠뜨린 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……바이슨은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "에엥? 그쪽에서 데리고 오는 거 아니었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……설마 우리, 아까 거기에 두고 온 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……늘 우리 하던 대로 하다 보니, 한 사람이 늘어난 걸 까맣게 잊고 있었군……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……지금 당장 돌아가서 도와줘야 하지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "모스티마가 그 근처에 있을 테니까 괜찮지 않을까?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "어~~~~이!!!! 저기요……!!!! 잠, 잠시만요! 하아… 하아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……자전거?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "오오! 설마 자전거로 오토바이를 쫓아 온 기가? 바이슨 니 억수로 대단하네!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "어이! 그 자식, 어느 골목으로 들어갔어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마피아",
      "text": "저쪽이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "뒤에 사람을 주렁주렁 많이도 달고 왔네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "너무 뭐라 하지 마. 자전거 타고 저렇게 많은 마피아들을 다 떼어내는 건, 확실히 무리라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "상황이 좋지 않게 돌아가는군…… 엑시아! 복병이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아무래도 조금 늦은 것 같은데~!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "우와아아아아아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "드, 드디어 따라잡았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "그래. 길 안내하느라 수고 많았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "누구……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "조금 자고 있으라고. 꼬마 도련님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이슨",
      "text": "큭!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "쳇. 한발 늦었나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "너네 펭귄 로지스틱스 맞지? 나는 감비노 리치, 이 패밀리의 보스다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "미안하지만, 이 꼬맹이는 우리가 인질로 삼아야겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "뭐, 너네도 이런 사소한 일로 당황하진 않겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "사실은 우리가 그냥 까먹고 온 건데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "그, 그렇긴 하지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "어이, 뭘 어쩔 셈이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "훗…… 너네랑 숨바꼭질하는 건 이제 질려버려서 말이야. 소란이 커져 봤자 서로 간에 좋은 건 없지 않겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "이 꼬마 도련님은 확실히 쓸모가 있다. 우리한텐 인질이 있으니, 너희에게 남은 선택지는 이제 정면 승부 하나밖에 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "이러면 서로 덜 귀찮아지고 얼마나 좋아. 이 바닥에 오래 있다 보니까 말이야, 주먹만큼 좋은 해결 방법이 없더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "펭귄 로지스틱스, 이제 도망갈 곳은 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그렇군. 잘 됐네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "감비노",
      "text": "……뭐라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "우리도 그렇게 생각했거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "크루아상, 소라. 진형을 유지해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "엑시아는 엄호.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "바이슨을 되찾아오자고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
