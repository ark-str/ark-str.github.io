{
  "server": "kr",
  "storyId": "story_phatom_set_1_story_1",
  "groupId": "story_phatom_set_1",
  "stageId": null,
  "title": "협력",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_phatom_1_1.txt",
  "sourceHash": "36ccbaf0a28f681d14e463a1cb1ad9b5b9b56c7b1e9e058f219ec6f8a51ae9fc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "로도스 아일랜드 본함\n어느 외진 구석"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "이물질을 제거하고 상처를 봉합했어요. 그리고 혈흔도 닦았어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "제가 할 수 있는 건 이 정도예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "이 이상의 치료는 의료부 전문 의사의 도움을 받아야 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "이 정도면 충분해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "고마워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "어디로 가시나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "내가 가야 할 곳으로 돌아가야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "가야 할 곳이요……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "혼자 사는 곳 말인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "팀원들과 같이 축하하러 안 가세요? 이번 임무는 아주 중요했잖아요. 다들 아주 기뻐하던데. 당신도 같이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "필요 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "축하할 때는 내가 없어도 돼. 정오의 햇빛 아래에는 그림자가 필요 없잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "어쩌면 축하 파티에 갈 사람은 너일지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "전…… 아니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "마음대로 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "그럼 이만.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……잠깐만요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "드디어 찾았습니다. 오퍼레이터 팬텀!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "닥터 위스퍼레인, 당신이 상처를 치료해 준 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "아…… 네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "당신은 정식 의료부 닥터는 아니지만, 저로서는 당신에게 충고해 둘 책임이 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "《로도스 아일랜드 부상자 관리 및 치료 조례》 규정에 따르면, 모든 부상 오퍼레이터는 로도스 아일랜드 의료부에 등록해야 합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "당신처럼 개인적으로 오퍼레이터 상처를 치료해 주는 것에 대해 작은 상처나 작은 병은 괜찮을지 몰라도, 만약 팬텀 오퍼레이터가 당신의 불완전한 치료로 합병증을 얻거나 상처가 악화하면 의료부는 아주 골치가 아플 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "정말 죄송합니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "위스퍼레인에게 치료를 부탁한 건 나다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "그녀를 비난할 필요는 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "저는 그저 사실을 말했을 뿐입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그리고, 오퍼레이터 팬텀, 당신의 문제는 더 심각합니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "다쳤는데 왜 의료부에 보고하지 않은 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "당신과 함께 외근 임무에 참여한 블루포이즌 씨가 치료를 받을 때 저한테 당신 상황을 보고하지 않았다면, 당신은 이 몸으로 다음 전투에 나갈 생각이었습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이건 로도스 아일랜드뿐만 아니라 당신 스스로에게도 무책임한 일이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이 점을 알아줬으면 좋겠군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "내 잘못이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "미안하게 됐다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "좋아요. 당신의 사과를 받아들이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이제 당신 몸 상태를 전반적으로 확인하기 위한 진찰을 할 거예요. 괜찮죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그런 표정 짓지 마세요. 잠깐, 입 열지 마세요. 그리고, 오리지늄 아츠를 이용해 도망칠 생각도 하지 마시구요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "다시는 안 속아요. 조금이라도 이상하다 생각되면 바로 이 경보 버튼을 누를 겁니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "벽에 이런 버튼도 있었군요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "긴장하지 마세요. 전 당신을 데리고 로비를 지나 의료부 쪽으로 갈 생각은 없으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "블루포이즌 씨가 당신은 사람 많은 곳을 안 좋아한다고 말하더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그래서 기기도 가져왔다고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "당신의 의료 정보를 확인하고 정리한 후에, 닥터 위스퍼레인과 함께 당신의 상처를 치료하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "괜찮죠? 닥터 위스퍼레인.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "물론이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그럼 당신은 동의하십니까? 오퍼레이터 팬텀 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(말없이 고개를 끄덕인다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그럼 진료를 시작하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "괜찮다면 상처 위치와 대략적인 상황을 설명해 줄 수 있나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "왜 말을 안 하시죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(오므린 입을 가리킨다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "방금 폴리닉 씨가 입을 열지 말라고 하셔서 그런 것 같네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "(찌릿)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이제 괜찮으니깐 말하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……화살이 어깨를 뚫었고, 칼날이 손바닥을 스쳤다. 두 다리는 꽁꽁 얼었고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "어깨, 관통상. 무기로 인한 손바닥 베인 상처. 저체온……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "오른쪽 다리는 괜찮지만, 왼쪽 종아리는 완전히 회복되지 않았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "좋아요. 하나씩 보죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "어깨 관통상.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "방금 상처를 봉합했어요. 별문제 없을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "음…… 일반 금속 화살이라면 그나마 괜찮을 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "창상 절제는 하셨나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "이미 처리했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "상처가 아무는 걸 보니 중독이나 감염 가능성은 없는 것 같네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "좋아요. 다음 위치.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "손바닥 베인 상처.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "음. 아주 잘 아물었네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "하지만 몸에 두 군데나 외상이 있어, 상처 감염 가능성도 크게 높아질 거예요. 이따가 예방주사를 놓아줄게요. 그럼 감염 문제는 걱정 안 하셔도 될 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "마지막으로 왼쪽 종아리 동상.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "괜찮아요. 이대로 움직이지 마세요. 전문 검사 기기를 가져왔어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "살짝 아플 수 있어요. 참으세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "샘플 채집 완료\n분석 시작……"
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "됐어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "데이터가 나오면 제가 최종 진단을 내릴 수 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "또 다른 불편하거나 다친 부위는 없나요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(응?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(미스 크리스틴? 뭔가 입에 물고 있는 것 같은데……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "……제 말을 듣고 계신가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "어……? 어, 다른 곳은 괜찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "좋아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "오퍼레이터 팬텀 씨는 확실히 회복 능력이 뛰어나군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "제가 지나치게 걱정했나 봐요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "오퍼…… 팬텀 씨는 스페셜리스트 오퍼레이터죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "다들 그렇게 부르더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "하지만 당신 몸의 이런 상처 유형은 뱅가드와 디펜더 오퍼레이터에게서 더 많이 봤어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이번 임무가 아주 힘들었다고 들었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그 사람의 지원 덕분에 우리가 살아서 돌아올 수 있었다고, 이미 여러 사람에게서 그런 말을 들었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "하지만 그들 대부분은 당신의 코드네임을 모르더군요. 심지어 당신 모습을 본 적도 없고, 전장에서 스쳐 지나간 그림자가 그들을 도와줬다는 것만 알더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "나를 기억해봤자 그들에게 좋을 게 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그 말은 지겹게 들었어요. 제가 치료한 일부 오퍼레이터들은 항상 이 점을 강조하더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이 얘기는 그만하시죠. 이곳 사람들은 대부분 그렇게 순진하지 않습니다. 언젠가는 제 갈 길을 갈 거예요. 어쩌면 전장에서 적으로 다시 만날 수도 있죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "하지만 팬텀 씨, 오지랖일 수도 있지만…… 이것만은 알려줘야겠어요. 적어도 지금은 그들이 자신의 고마움을 표현하고 싶을 뿐이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "어떤 말은 그때 말하지 않으면 나중에 다시는 기회가 없을 수도 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "(작은 목소리로) ……저처럼 멍청하게 모든 일을 가슴에 담아두지 마세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "당신이 대신 화살을 막아줬다고 블루포이즌 씨가 말하더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "감사의 마음을 전하고 싶었지만, 당신을 찾을 수 없으니 기회가 되면 전해달라고 부탁했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이 브로치는 블루포이즌 씨가 당신에게 주는 선물이에요. 받으세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "이건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "받으세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……고맙군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "나중에 블루포이즌에게 직접 감사 인사를 전하도록 하지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "분석 종료\n분석 보고 출력 중……"
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "흠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "상황이 좋지 않아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "팬텀 씨, 움직여 보시겠어요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(약간 부자연스럽게 걷는다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "좋아요. 일단 앉으세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "오리지늄 아츠가 온도를 급하게 떨어뜨려서 생긴 동상이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "심각하지는 않지만, 이미 당신의 행동에 영향을 끼쳤어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "작은 부상일 뿐이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "통증 감별은 전문 닥터의 의견을 참고해주시면 감사하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "팬텀 씨는 당분간 안정을 취하는 게 좋아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "이건 제 의견이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "저도 닥터 위스퍼레인의 의견에 동의합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "동상으로 보이지만, 사실 오리지늄 아츠로 인한 상처예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "당신의 감염 상태는 그리 낙관적이지 않아요. 감염이 더 심각해질 수 있는 모든 상황을 최대한 피해야 합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "충분한 휴식, 건강한 식습관, 적당한 재활 운동. 당신이 지금 할 일은 이것들이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "물론 가장 중요한 것은 정기적으로 의료부를 찾아와 치료를 받는 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "치료 기간은 그렇게 길지 않아요. 한 달이면 다시 임무에 참여할 수 있을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "의료부에 오기 싫다면, 제가 다른 사람과의 접촉을 줄일 수 있는 순회 진료 쪽으로 알아봐 드릴게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "동의한다면, 이 고지서 맨 밑에 사인하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(서명으로 본인의 코드네임을 적는다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "좋아요. 협조해 줘서 고마워요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이제 주사를 놔드릴게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이건 신식 주사기라 많이 아프지 않을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "손을 내밀어 보세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "(주사기를 사용한다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "자, 이제 초반 예방 치료는 끝났어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "전 오후에 회의가 있어서 더 이상 귀찮게 하지 않을게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "한 달 휴가를 충분히 즐겨주세요. 팬텀 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "그럼.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "드디어 갔네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "후…… 전 아직도 폴리닉 아가씨한테 말을 잘 못 붙이겠어요. 늘 긴장이 되어서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "좀 괜찮나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "괜찮다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미스 크리스틴",
      "text": "야옹.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "미스 크리스틴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미스 크리스틴",
      "text": "(팬텀한테 비비적거린다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "앞으로 남은 휴가 동안 팬텀 씨는 푹 쉬어 주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "휴가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "한 번도 생각해 본 적이 없어. 휴가 기간에는 뭘 해야 할지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "음, 예를 들면…… 영화 관람?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "저라면, 영화를 보러 가서, 그때의 기분을 기록할 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "전 영화를 볼 때마다 영화 속 인물의 삶을 꿈꿔요. 동시에 스크린 밖에서 호흡하는 모순된 나 자신을 느끼게 되죠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……조심하는 편이 좋을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "남의 삶을 꿈꾸는 건 좋은 일이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "저도 알아요. 하지만 전 이런 방식으로 기분전환을 하거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "그리고…… 부끄럽지만, 제가 쓴 글을 좋아하는 오퍼레이터도 몇 있어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "제가 아주 잘 쓴다고 생각하진 않지만, 다들 좋아해 준 것만으로도 만족해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "그렇군……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미스 크리스틴",
      "text": "야옹……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "미스 크리스틴?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "간지러. 이러지 마…… 음? 이건 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "당신한테 이 전단지를 보여주고 싶었나 보네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "“멀티미디어 밀실 프로젝트 스태프 모집……”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "“밀실에서 으스스하고 스릴 있는 탐험 분위기를 연출할 수 있는 스태프 모집 중.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "“밀실의 수수께끼나 트릭을 설계할 수 있는 스태프 모집 중.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "“연기를 할 수 있는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "……스태프 모집 중.”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "“기획 및 운영 기간 1개월. 참가 기간 중 보수 지급, 1일 3식 제공.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "“관심 있는 오퍼레이터 및 로도스 아일랜드 상주 인원은 인사부에 가서 더 자세한 상담을 받아보시기 바랍니다.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "멀티미디어 밀실이라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "감각기관 자극과 침투식 체험을 강조하는 신형 오락 방식이라고 들었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "대부분…… 밀실 테마는 공포와 미스터리가 주요 소재인 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "전에도 한 번 있었는데, 당시 테마는 미노스의 지하 미궁이었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "사실 전 너무 가보고 싶었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "그날 A1 팀의 오퍼레이터들이 다녀와선 저에게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "“놀라 죽는 줄 알았어!!”라고 말하더라고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "그래도 다들 너무 즐거워 보였어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(공포스러운데 즐겁다?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "(음…… 놀라는 걸 좋아하나?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "그때는 갈 엄두가 안 났는데, 지금 생각해 보니 살짝 후회되네요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "이번엔…… 음, 위디 씨에게 한 번 물어봐야겠네요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "미스 크리스틴, 이걸 보여주려고 한 거였어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미스 크리스틴",
      "text": "야옹!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "무슨 뜻인지 알겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "위스퍼레인",
      "text": "가려고요? 그럼, 휴가 갈 곳은 결정했나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "잠깐 고민해 봤다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "적당한 공포심이 남에게 즐거움을 가져다준다면,",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "팬텀",
      "text": "어쩌면…… 나도 해볼 수 있겠지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
