  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "팀장님…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "리유니온의 주요 부대들이 퇴각하는 것으로 보입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님, 저희도 마무리되었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……쳇!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "며칠 전 붙잡았던 리유니온과의 관계가 의심스러운 녀석들 말인데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "심문관에게 뭐라 말은 하던가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 용의자",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "이 석궁을 본 적이 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 용의자",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "사용법은 알고 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "발사체의 구조는 어떻게 되어 있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "슬럼가에서는 무얼 하고 있었나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "용문에 와서 대체 뭘 할 계획이었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 용의자",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "…아뇨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "입도 뻥끗할 것 같지 않았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "어쩌면…… 정말 아무것도 모르는 걸지도 모르죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "아까 처리했던 리유니온들처럼 단순한 꼭두각시 같습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "…녀석들이 자백하게 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "어떤 방법을 써도 상관없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "소대의 정보, 지휘 방침, 출신, 전술 분포까지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "얻어낼 수 있는 정보는 모두 얻어내라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그리고 입수한 정보는 모두 나에게 공유하도록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "어떤 정보라도 좋다. 새로운 정보는 곧장 내게 알리도록 해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "예!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "근위국이 전에도 이렇게 리유니온 멤버를 체포한 적이 있나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "아니, 녀석들의 신분이 명확하지 않았었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "어떻게 추론을 해도, 의혹에 지나지 않았던 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마한테 연락해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "특별감찰팀은 뭘 하고 있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "아직도 감염자 한 명한테…… 쩔쩔매고 있는 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "저쪽 리유니온은 이미 퇴각한 모양입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "위장 전술일 가능성을 고려해서, 호시구마 감찰관이 현재 조사 진행 중입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "쳇, 적 한 명에게…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "공격도 퇴각도 자유자재라 이건가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "다음 임무는 아미야, 너도 잘 알고 있겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "미샤 씨를 되찾아오는 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그렇다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그리고 이 작전은 합동 작전으로 진행한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "근위국은 공격을, 로도스 아일랜드는 탐색과 습격을 담당한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "너희는 리유니온의 퇴각을 저지해주기만 하면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "적을 탐색한다고 하면… 우리도 발각될 가능성이 있다는 얘기잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "이쪽 정찰팀도 지원이 부족한 상황인데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "우리만으로는 감당이 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "전문적인 업무는 전문가에게 맡기도록 하죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프란카 씨, 펭귄 로지스틱스에 연락해주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "또 한 번 엑시아 씨와 텍사스 씨의 도움을 받아야겠네요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
