  "sourceHash": "667bf19a6b9298074c6d5390c5289a9563294b95ab4155415bf2b8280748d9d8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "리유니온을 모두 처치했어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "큭, 장애물치곤 흉폭한 녀석들이었다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "첸은 그림자도 안 보이는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이대로는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "통신도 받지 않는다. 칫, 여전하군그래!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "근위국 전원! 나와 함께 돌입할 준비를…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아니에요, 호시구마 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저희에게 맡겨주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이 앞은 재앙 때문에 생겨난 오리지늄이 뿌리내린 곳이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "건강한 사람이 더 깊이 들어가면 광석병에 감염될 위험이 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그렇게 되면 심각한 결과를 초래할 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "게다가 저희 감염자들은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "훗, 그 작은 몸으로 열심히 우리를 설득하는 모습, 꽤 귀엽군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "에, 에에?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "후후후, 마음에 담아두지 마라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그렇게 설득하려 들지 않아도, 네가 무슨 생각인지는 잘 알았으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "근위국! 우리는 로도스 아일랜드의 방패 역할을 맡는다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "입구를 사수해라! 단 한 명의 적도 들여보내선 안 된다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "감염자 문제는 감염자 전문가들에게 맡긴다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "호시구마 씨…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아, 그리고 이젠 그냥 편하게 호시구마라 불러.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "어서 가라, 첸은 너희에게 맡길 테니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "꼭 첸을 무사히 데려와 줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "알겠어요, 호시구마…! 첸 팀장님을 꼭 무사히 모셔오겠습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너희들도 조심하도록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "박사님, 저를 따라오세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "로도스 아일랜드, 출발합니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(첸 팀장님, 기다려주세요…)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(프로스트리프 씨, 메테오라이트 씨, 제시카 씨…)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(제발 버텨 주세요!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "마지막에 연락이 닿았던 정찰팀을 전원 구조했습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "그런데 상황이… 좋지 않습니다…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "피부가 빨갛게 붓고 체온도 떨어진 데다가, 신체 조직이 괴사했다니…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "어떻게 된 일이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "중상을 입은 오퍼레이터",
      "text": "으윽…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "전부… 동상을 입은 건가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
