{
  "server": "tw",
  "storyId": "act23side_level_act23side_03_end",
  "groupId": "act23side",
  "stageId": "act23side_03",
  "title": "樹猶如此",
  "storyCode": "WB-3",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act23side/level_act23side_03_end.txt",
  "sourceHash": "9e0485615947cc6404e3e0de7c9f81c2dbd7785c1228aaeb388cbe4ab1539196",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "事沒有成？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰鷙的山海眾成員",
      "text": "兩邊都有意料之外的高人跟著，沒機會下手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "那個年輕秉燭人由他去查，於我們的計劃無礙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "從龍門來的那個女人不在原本的計劃之內，但偏偏找準了方向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "她很麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰鷙的山海眾成員",
      "text": "我們會繼續盯著，再找機會動手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "不，經過兩次衝突，官府的人想必也會提高警惕，現在開始我們要謹慎行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "讓那個女人多活兩日尚可接受，可暴露組織的蹤跡，則萬萬不能允許。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰鷙的山海眾成員",
      "text": "是......那接下來，怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "等。先生下一步指令不會太久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "“山海八荒，盡歸其主。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "身為大地的竊賊而不自知......這裡的人們終究會為自己的傲慢付出代價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "時間很近了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "你們是在等誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "刺殺朝廷命官，驚擾百姓安生，汝等所作所為，皆視大炎律法如無物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "兩個選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "放下兵器，跟我走；要嘛，我抓你們回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "你被跟蹤了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰鷙的山海眾成員",
      "text": "是剛剛那個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "他反過來跟蹤了你。這人武功很高，你無能為力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "但終歸是你將這人引到這裡的，明白嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰鷙的山海眾成員",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "好，那先解決他，再談對你的處置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "狂徒，還敢造次？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "夜深了，還沒有休息？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "以防再發生昨天那樣的變故，還是應該多留意點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "宗師這麼晚約見我，應該不是為了看風景吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "最後這段時間，難得魏公在，本來確實該好好在這玉門城裡走走，看看玉門的風景。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "平祟侯的決定，自然有他的考量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "這話或許不該我來說，平祟侯背負的，遠遠不止玉門這一座城的安危。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "一件事出錯的後果足夠嚴重，“信任”二字就擔不起什麼份量了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "的確如此。左將軍與我共事幾十載，靠的也不是“信任”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "望重岳兄體諒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "我又何曾抱怨過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "說起來，還沒有和重岳兄好好敘舊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "我上次來玉門，還是五年前，再上一次，是十年前，但都很匆忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "而我們上一次見面，還要再往前數......是在京城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "嗯，魏公離京那年，我回去述職，正好在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "沒想到重岳兄還記得那麼久遠的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "魏公不也記得？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "具體是哪一年，我倒真想不起來了。印象裡當時也是春天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "晚春。比現在的時節稍微遲一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "當時魏公還是用劍的......不，當時你也還不姓“魏”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "好景千萬，武功無數，日子一長，真能留下印象的，也沒幾個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "但即使現在品評各式武學的時候，也時常會想到赤霄劍法的最後一式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "......能在武學上得宗師一句讚揚，我應該榮幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "那天晚上看著是要下雨的，悶熱，雲壓得很低。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "我在城樓上，隔得很遠，但仍然看到了驛館方向的劍光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "一劍之寒，天光乍破。何其凌厲、何其果決的招式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "“雲裂之劍，當立則立。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "之後，魏公就出城了吧。那場雨，最後也沒有落下來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "這倒真是一段久遠的陳年舊事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "就是不知宗師現在提起這事......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "城樓憑高處，兩人的衣袂揚起。\n這本是個無風的晚上。\n目之所及，玉門的房屋和哨樓在夜色中綿延，不見盡頭。也只有透過高處的風，才能清楚感知到這座城市正在高速移動。"
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "朝堂詭譎，人心難測，沒有人比魏公更懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "但我也相信，一個心中只有權謀伎倆的人，萬萬使不出那樣的劍法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "有一件事，想請魏公幫忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "宗師親自開口，不敢不聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "我想請魏公相信玉門一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "魏公和平祟侯一樣，肩負的都是炎國一方安寧。要關心操勞的事很多......可是玉門畢竟不同於龍門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "玉門以軍事建城，這裡的百姓也大都是江湖性情中人。心中多的是熱血，少的是籌謀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "可無論如何，大家為國為民，疾惡如仇的心思是不會有錯的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "我只怕心思單純的人，遭奸人利用而不自知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "左將軍答應的時限，是三日。三日內，定會給魏公一個答覆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "在那之前，希望魏公擱置和平祟侯的異見，先不要出手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "客隨主便，平祟侯讓我在這座軍營安心等待，我就是有心為他分憂，也實在是無能為力啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "我想起，幾日前從龍門來的那位林特使的確算得上精明能幹，短短幾天的工夫就乾淨俐落地解決了好幾件案子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "想來魏公手下這樣的人才一定不在少數。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "......宗師應該是多慮了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "太傅也好，平祟侯也好，魏彥吾也好。所謀都不過是為了百姓安生，國家昌盛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "我們之間不該有矛盾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "但回首過去，千百年來，人們明明為著同一個目標，最終卻鬧得不歡而散甚至反目成仇的例子，還少嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "宗師的確有資格說這句話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "好，看在宗師的面子上......我答應。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "多謝魏公。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "天晚了，宗師早些休息吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "......對了，還有件事，好像沒和重岳兄提起過。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "雲裂之劍，並不是赤霄劍法的最後一式。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "（壓抑的喘息）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "現在，你還可以選擇束手就擒。不然下一招，你會再也站不起身。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陰鷙的山海眾成員",
      "text": "（痛苦的呻吟）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "現在只是到腰，再動一下，土塊就會埋到你的肩膀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "左邊巷子裡還藏著三人，右邊屋簷上還有兩人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "你們兩個方才所有行動都是想引出我的破綻，為伏兵創造一個出手的機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "但你們不會有機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "我承認，低估了你的實力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "很少見到......源石技藝和武功都這樣厲害的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "你不配點評我的武藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "......哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "昨日在近衛局林特使回城時出手襲擊，今日又跟在她身後意圖不軌，早些時候司歲台秉燭人鬧市遇刺，多半也是你們所為吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "截殺天災信使，搶奪數據，山海眾究竟在玉門準備著什麼陰謀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "你們背後的人又是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "你還是先看看自己背後的人是誰吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "什——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陰鷙的山海眾成員",
      "text": "多......多謝先生救命......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "給先生添麻煩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾首領？",
      "text": "你們不該把時間浪費在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "那個龍門來的女人，已經查到了鑄劍坊倉庫，是個麻煩......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾首領",
      "text": "既然擔心麻煩，為什麼不去直接解決那個唯一還能左右全局的變數？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "......鑄劍坊的老傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾首領",
      "text": "去找到他，最好讓那份天災數據和他一起消失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "我明白了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "先生當心——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾首領",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾首領",
      "text": "你不應該還能站起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太合",
      "text": "休......走......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "地面驟然凹陷，像是有生命般地蓄滿力氣，隆起的土石頃刻間包圍了所有人。"
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾頭目",
      "text": "先生，這個人不可小覷——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "寒芒乍現即收。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "人倒地，土石仍是土石。\n街市靜寂。"
    },
    {
      "type": "dialogue",
      "speakerName": "山海眾首領",
      "text": "浪費時間，無聊至極。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "雨霞姐，你怎麼去了那麼久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "碰巧遇見熟人，打個招呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "你一個龍門人，在玉門的熟人還真不少......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "別閒聊了，我們把各自查到的資訊匯總，看能不能發現一些線索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "下午在街邊話沒說完，你那邊有什麼進展？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "杜小姐，城南鑄劍坊的坊主，是個什麼樣的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "你是說孟叔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "孟叔是爹當年還在走鏢時認識的朋友，武功極高，但是很好說話，整個玉門武行的人都很信任他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "我在玉門人生地不熟，行裕物流能開張也是受了他不少關照......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "這件事和孟叔有什麼關係嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "隨便問問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "你有話直說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我一直懷疑現在城裡作亂的這夥賊人，是趁著物資跨城補給，從龍門偷渡進的玉門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "直到今天，我順著走私犯的線索，查到了鑄劍坊的倉庫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "所以呢，有什麼發現？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "倉庫裡只有鐵坯和鍛造用的燃料，那的確是鑄劍坊用來囤貨的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "蹊蹺的是那個看守。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "他的脖子上有一圈很奇怪的曬傷。那應該是佩戴特製的防護裝備才會留下的痕跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "據我所知，欽天監派出的天災勘測隊伍，長期在荒漠裡跋涉，為了防風防曬，通常戴著制式面罩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "那人的曬傷是新傷。而最近玉門欽天監派出的隊伍，只有那一支。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "你是想說信使團隊在城外的事故有蹊蹺，還和孟叔有關聯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我只是如實向你同步我查到的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "玉門城剛從大漠深處開回來，這裡光照劇烈，城中居民曬傷的情況也很常見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "難道憑這點事就要去懷疑......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "你們認識這個物件嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "（聲音顫抖）......你從哪裡找到的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "鑄劍坊的倉庫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "是我進去查探的時候，在角落撿到的。看起來造型特殊，在一堆燃料鐵坯中很顯眼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "這是“行裕物流”的袖標，是我親自設計的......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "紅底的袖箍嵌著金邊，還用尚蜀特色的繡工繡著兩條流線穿過五芒星的紋樣，象徵著吉星高照，商路暢通。\n寓意吉祥平安的圖案染上了令人不安的赭紅，沾染的黃沙也讓它看上去斑駁陳舊。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "從尚蜀跟著我來玉門創業的年輕人，才會有這個。大小齊出城的時候也......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "如果信使隊伍在城外出了事，那這件東西根本不該出現在城內！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "大小齊還活著？！那他們為什麼要藏起來？不對，是誰挾持了他們不讓他們露面？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "孟叔？他不是也有四個兄弟在隊伍裡面......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "怎麼回事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "杜小姐，別急，我們冷靜分析......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "text": "想不清楚的就別想。我要去鑄劍坊問個清楚！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "杜小姐！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "雨霞姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我剛剛在樓下看到了一個遊客打扮的龍門人，是雨霞姐的手下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "他來給你送了東西吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "那個袖標，是當時在城外信使被截殺的現場帶回來的證物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "你在利用杜小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "眼下許多線索都指向鑄劍坊，試探一下，很有必要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "如果那人沒有問題，排除一個不太好的可能性，她也安心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "如果鑄劍坊真有問題，你這樣豈不是將她置於險境？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "如今城內，身處險境的不止她一人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "......雨霞姐，我知道你有你的職責，或許一貫如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我不願意在這和你爭辯對錯，我堅決不能認同你的做法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我得去幫她。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守軍",
      "text": "公子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "怎麼回事？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "高大的豐蹄男性躺在病床上，面無血色，健碩的胸膛幾乎看不見起伏。\n在左樂的記憶裡，太合像是一座山。\n這座山站立在父親和自己的身旁，不可撼動。\n有什麼力量會將山摧折？左樂從未想像過。"
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守軍",
      "text": "就在剛才，太合御史被兩名百姓送來軍營......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "先告訴我太合叔的情況！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守軍",
      "text": "軍、軍醫說，性命算是保住了......但也只是保住了性命......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守軍",
      "text": "太合御史身上有多處外傷，更嚴重的是臟器受損，內部大量出血。要是普通人，只怕早就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "太合叔本不該來插手這件事，他是在暗中幫我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "父親呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守軍",
      "text": "將軍正在外城樓鎮守。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守軍",
      "text": "剛才也通知了將軍，將軍只回了四個字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守軍",
      "text": "“堅守崗位。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "......送太合叔回來的人在哪？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "如實說來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的路人",
      "text": "我們看見那位穿著官服的豐蹄老爺倒在路邊，我們也不知道發生了什麼事，就想著先送到這裡來......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "城內戒嚴，你們深夜出遊是出於什麼目的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的路人",
      "text": "只是睡不著覺，出來走走而已......誰知道一出門就看到有人倒在路邊，我們也嚇了一跳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "你們住在附近，就沒有聽到什麼異動？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的路人",
      "text": "沒有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "是在哪裡發現的傷者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的路人",
      "text": "就在城南邊，靠近鑄劍坊的小巷裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "鑄劍坊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的路人",
      "text": "請問......我可以回去了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "不准。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "你的證言有不詳之處，作為證人，還不能離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的路人",
      "text": "啊，這這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "千夫長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千夫長",
      "text": "在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左樂",
      "text": "我先行前往，你立刻集結隊伍。",
