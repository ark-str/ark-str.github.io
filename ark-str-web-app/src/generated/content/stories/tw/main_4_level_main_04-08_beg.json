  "storyId": "main_4_level_main_04-08_beg",
  "groupId": "main_4",
  "stageId": "main_04-08",
  "title": "應激反應",
  "storyCode": "4-8",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-08_beg.txt",
  "sourceHash": "71aeeff5683bbbcc25094644bb276d24d5f709f7c1f007f62b003d9375624fec",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這裡是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們已經很接近霜葉給出的座標了，但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這股味道有些噁心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "難道是焦臭味......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "整合運動把我們引到了什麼地方？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嘖！小心偷襲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可惡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "沒，沒打中嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "沒關係，我們這裡是安全的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "你，你怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "咕，咕......啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "他沒機會回答你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "什，什麼！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是在那座建築裡嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "等等......那個難道是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "霜葉！霜葉，是你嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "是我。敵人我解決掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "抱歉讓你擔心了，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你受傷了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "醫生，快來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......怎麼會？你身上的，也是凍傷？你們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "沒關係，是小傷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "隕星和潔西卡還在廣場那......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "暫時還不要緊，但繼續拖下去就很難說了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我把敵人引了出來，整合運動還沒發現她們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "敵人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我們現在的位置還比較隱蔽，不用太擔心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "但他們馬上就要來了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "小狐狸，你躲到那裡去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "快出來吧，捉迷藏要結束了哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你每多藏一分鐘，我就會折斷你同伴一根手指——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "就算這樣，你也還是要逃跑嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "（梅菲斯特——！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "（他在虛張聲勢。別激動。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "（他在做什麼......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "整合運動轉移了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那個傢伙......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們需要先聯繫隕星她們——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們明明已經跨過了污染地帶，為什麼通訊依然接不通？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "看看這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這是你的通訊器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "怎麼會結冰了？難道是被......凍壞了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "梅菲斯特只是個添頭而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "這座廢城裡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "徘徊著更可怕的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可怕的東西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "雪怪們。撞上他們，事情就難辦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "雪怪，是說那個雪怪小隊嗎？他們究竟是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "這點時間，很難講的清。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "但整個區域的低溫，以及各個小隊的遭遇......都是這些傢伙的傑作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "整合運動的這支隊伍，似乎在廢城中劃下了自己的地盤呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "天色暗下來了，這是個好機會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們可以更加隱蔽的通過這片開闊地帶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "走吧，先去救出隕星她們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我來帶路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "廣場上這些......看不太清。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是什麼......雕塑嗎？好奇怪的樣子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這股味道也令人作嘔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "這邊，別走散了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "那些東西......別去看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "——有敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "悄無聲息的幹掉吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
