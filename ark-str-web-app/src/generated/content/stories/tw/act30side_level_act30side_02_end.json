{
  "server": "tw",
  "storyId": "act30side_level_act30side_02_end",
  "groupId": "act30side",
  "stageId": "act30side_02",
  "title": "同車異圖",
  "storyCode": "RS-2",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act30side/level_act30side_02_end.txt",
  "sourceHash": "ded933712b1d2e7a765aacfab5dab9c8823313d9bbc1fb5530342e090e6d21af",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "快看，外面看得到雪山！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "天啊這也太近了吧，這是不是謝拉格的聖山？不管是不是，這景色都太美了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "我、我說啊，能不能先把窗戶關上……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "風、風有點大，吹得我說話都、都有點不太流利了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "也不至於這麼誇張吧，我覺得也不是不能忍忍……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "真的假的，你真的不冷嗎？我看你甚至沒穿褲子——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "建議你好好想一下用詞，再這麼說下去我就要告你亂調侃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "我穿的這是保暖褲襪，最厚的那一種！比你那身暖和多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "哎喲……好好好，你說是，那就是吧……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "哼。快，你再站過來點，我要拍照了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "……嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "哎，你有沒有聽到什麼聲音……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "女士們先生們，日安，日安",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "很抱歉打擾各位的觀光休閒！麻煩各位暫時回到坐席稍作避讓，我們——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "好了這種時候了就別廢話了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "對不起各位，借過一下，麻煩都借過！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "羅莎琳！這樣有點太失禮了……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哎，哎，羅莎琳，輕一點拉，我的袖子要被你拉下來了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "呃，這是什麼謝拉格風俗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "我們也要這樣在列車裡跑跑看嗎……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "不可能有這種風俗吧？感覺好蠢，我才不要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "不管了，還是先把合照拍了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "看鏡頭！三……二……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "一……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "我不討厭這種追逐遊戲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "我談不上喜歡。我們不能坐下來好好談嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "是你們自己坐賊心虛，一直在跑啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "最好繼續跑，別停下來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "哦，順便一說，再等五分鐘才是外面風景最好的路段，合照可以之後再拍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "玩得開心一點。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "剛剛那又是什麼人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "不知道……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "不過你剛剛說得可能有道理，謝拉格搞不好確實有什麼要在列車上疾跑一圈的風俗……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "我們，呃，要不然還是入境隨俗……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "你怎麼了，從剛剛起在發什麼呆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "我的照片，我的照片！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發抖的遊客",
      "text": "照片怎麼了？剛剛那人說再過五分鐘風景更好，我看我們還是再等等看……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "不是說這個！你看這張照片！我正好拍到剛剛那位姐姐的正臉了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "我總覺得她看起來有點眼熟，好像在哪見過……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "算了不重要！重點是她、她這身正裝，未免也太帥了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "精神很好的遊客",
      "text": "我要珍藏這張照片！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好客的老鄉",
      "text": "我來跟大家介紹一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好客的老鄉",
      "text": "這就是我們謝拉格最有名的乳酪鍋，用的是我們當地特產的好乳酪，風味醇厚，保管謝拉格之外的地方都沒有這樣的滋味！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的遊客",
      "text": "真有這麼好？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "快快，再快點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "等、等等，羅莎琳……呃咳咳咳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "失禮了女士們先生們，乳酪鍋的味道確實不錯，我推薦加點胡椒風味更濃——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好客的老鄉",
      "text": "什、什麼人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好客的老鄉",
      "text": "怎麼還來？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的遊客",
      "text": "……這就是謝拉格的列車旅行嗎，果然如我的朋友們說的那樣，別有特色。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的遊客",
      "text": "啊，加了胡椒果然不錯，我喜歡這個味道！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格老鄉",
      "text": "哎，齊了，抓齊了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格老鄉",
      "text": "托各位的福，羽獸一隻都沒少。勞動各位幫忙，真不知道怎麼感謝才好……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列車員",
      "text": "老先生，您可把袋子綁緊囉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列車員",
      "text": "這次……這次就算了，但您千萬記好，我們的列車上是禁止帶活物的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列車員",
      "text": "下次記得一定不能再這樣了啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格老鄉",
      "text": "一定的，一定的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格老鄉",
      "text": "哦、哦喲，小年輕，什麼事情這麼緊急啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "列車員",
      "text": "客、客人！列車上請不要這樣奔跑！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格老鄉",
      "text": "欸！那個戴帽子的傢伙！你仔細點……你，哎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格老鄉",
      "text": "要命了，我的羽獸！我的羽獸又跑啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煩惱的遊客",
      "text": "這個盲盒怎麼一直抽不到隱藏限量款！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煩惱的遊客",
      "text": "最後一次，最後再試一次……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煩惱的遊客",
      "text": "嘿！走路注意點！萬一撞壞了我的盲盒……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煩惱的遊客",
      "text": "啊！是、是限量款！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "終點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "最後一節車廂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "追逐遊戲結束？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "女士，您贏得了遊戲，這看起來已經沒有懸念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "我希望我們能……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "真吵。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "我的時間不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "“灰禮帽”，別著急，我會記得你有這份懇談的意願。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "回頭我再單獨和你“談談”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "現在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "自己出來，別讓我動手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "咳、咳咳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "這位大姐，姐！我在這呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "咳咳，呸，地上還挺多灰……美女姐姐，你找我有事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "我找的不是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "可是這除了我沒別人……\n哎喲！"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "（你別亂動！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "……你們在演什麼戲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "什、什麼演戲？沒沒沒有的事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "（欸大叔你安靜點！我這不是正在幫你遮掩嘛！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（別、別扯我的頭髮！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "你是羅德島的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "啊？我確實是……你知道羅德島？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "欸，美女姐姐，難道你是博士上次來認識的熟人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "熟人？我不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "好了，我沒有太多時間閒聊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "在我耐心耗盡之前，出來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（小祖宗，算了算了，快放我出來吧！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哈啊……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "你能這樣幫我確實令我感動，但羅莎琳你下手也太重了點……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "嘶……我的頭髮，我的鬍子啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "終於找到你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "怎麼，原來你們認識？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "咳，咳嗯。\n不敢說相識，不過也曾有過幾面之緣。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "鐧女士，許久不見，讓您見笑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "寒暄就不必了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "克雷加文，山上的老雷昂急著找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "……老雷昂？找我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "等會，是老雷昂找我，而不是鐧女士您要找我……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "我受他所託，來找你。就這麼一回事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "他如此著急找我，是有何要事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "這麼說來，我好像確實忘了點什麼……是什麼來著……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "你忘了莉莉還在等你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "……對了，是莉莉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "什麼莉莉……不是吧，大叔，你把你對象忘了？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "相好——？！\n不是，咳咳，咳——"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "……子爵閣下，您如此行事，恐怕有損維多利亞的形象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "尊夫人和令千金如果知道此事……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗚哇，人渣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "慢著！咳咳，該死的灰，不是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "莉莉是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "各位乘客，本次列車即將抵達終點站——\n銀心湖站。\n請各位乘客收拾好隨身的行李物品，從各自車廂前後車門排隊下車。\n感謝您搭乘本次列車。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "時間耽擱得還不算久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "下車後你最好盡快上山去找老雷昂，他很急。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我們還是分道揚鑣吧，不然我媽會不高興的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "不，咳咳，莉莉——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "——她根本就不是人啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "你還要罵人家不是人？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "不不不不。噗，好了，把我自己氣笑了。岔氣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "莉莉是馱獸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "馱獸……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "原來如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "……我沒說嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "“灰禮帽”！你裝什麼裝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我不信你手下的探子沒把我在謝拉格的行動匯報給你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "很抱歉，您治癒的馱獸叫什麼名字，並不在需要我記憶的重點情報之中，閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "……所以，其實大叔不是人渣，也不會有什麼危險？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "又追又跑的，我以為是什麼性命攸關的大事呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我……唉！羅莎琳，這確實是事關我名譽的大事啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "你們想磨蹭多久？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "別傻站著，擋路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "text": "車到站了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
