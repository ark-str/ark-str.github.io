{
  "server": "tw",
  "storyId": "main_10_level_main_10-11_end",
  "groupId": "main_10",
  "stageId": "main_10-11",
  "title": "仇怨的盡頭",
  "storyCode": "10-12",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_10-11_end.txt",
  "sourceHash": "013111ae509a7568f17c9dd618af7392af0afd6f3a8a598c600e5586c8b7aed7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好奇怪，博士，我們明明甩脫了之前的薩卡茲士兵......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "但他們還在源源不斷地過來。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "就好像他們知道我們的位置。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可露希爾，我們的通訊信號有沒有被追蹤？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希爾",
          "text": "這不可能啊，阿米婭！我特地給信號發射器做了三重處理，要是那些薩卡茲有這技術，羅德島號早就被特雷西斯攻破一百次了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......博士，我相信可露希爾。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "他們一定是用了什麼別的方法......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "阿米婭小姐，我們馬上就到會合點了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "只要和六隊會合，我們就能和地下的接應部隊取得聯繫，等回到地下以後，薩卡茲們就沒法再追著我們......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......不，別走那條路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "啊？為什麼......咦等等，推進之王小姐，你們怎麼來了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "你們不是在地下......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "六隊的人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "六隊怎麼了？你怎麼會是這副表情......呃，因陀羅小姐，你的手上有血？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "你們的戰士，他們......都犧牲了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "這......這不可能！六隊還在我們前面，他們為什麼會遇上薩卡茲？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我們沒有時間分析原因了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "博士，六隊的戰士們......並不是死於我們見過的那些薩卡茲士兵的追擊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你的意思是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "六隊遇上的人，有著非常恐怖的源石技藝。他們死亡的現場......就好像屠殺一樣。許多戰士甚至連武器都沒拔出來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "那真的是源石技藝嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "我不敢相信！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "我看到有紅色的蟲子一樣的東西撕裂了戰士們的胸膛。維娜，你也看見了，那是真正的怪物！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......動手的不是普通薩卡茲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們必須換個方向。費斯特先生，有其他路可以走嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "有。但那條路沒有我們的人接應，一旦遇到薩卡茲士兵......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "又會是一場苦戰。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "找掩體！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "號角，這什麼玩意兒？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "這薩卡茲朝我們丟過來的是炸彈嗎？明明我們沒人看見——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "......源石技藝。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "注意上空！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "我......我看到了......半空中一閃而過的血紅色！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "後撤！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "這跟落雷一樣的玩意兒，你說它是源石技藝？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "這些可怕的魔族佬......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "還不出來？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你說的戰鬥不是在地上滾來滾去吧，白狼？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "天上一次性出現了五道血光？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "號角，我們根本沒機會——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "源石技藝再強......他也只是一個人而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "過往的維多利亞，是如何一次次戰勝薩卡茲的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "你是想......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "我們還有多少弩彈？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "掩護我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅本",
          "text": "好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "微不足道的抵抗——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "現在......就是機會。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "想借著法術轟擊的餘波逃走？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我不會讓你如願。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "......我說過了，只要我的士兵們還在，我就不會逃走。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你果然很不錯，白狼。你竟然敢反過來衝向我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "很可惜......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "——唔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "誰跟你說過，薩卡茲僅僅依靠源石技藝作戰？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "即使是只用劍——我也可以擊敗你們所有人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "想贏我......也許不難......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "但想讓我倒下，也不會......那麼簡單。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你很有勇氣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "也多虧了你的勇氣，我能更快地結束這場戰鬥——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "在長劍刺下的那一瞬間，曼弗雷德面前的士兵突然消失了。\n她就像溶解並滲透進了她背後的牆面裡，連個漣漪都沒留下。"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "陌生的源石技藝......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "警戒！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......憑空出現的短刀？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不，不是憑空出現......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你的反應很快。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不夠快的話，我的胸口恐怕就要多上一個血洞了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "找到目標了！瞄準他！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "怎麼回事？又消失了？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "太、太快了！射不中！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "舉盾，快舉盾，*粗口*，他是不是會瞬移？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "瞬移？怎麼會有這樣的源石技藝......就連施術痕跡都偵測不到！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "還是說......障眼法？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不要被他愚弄！所有人，不管瞄不瞄得準，一起進攻！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "只要敵人還在我們面前，他就別想逃脫！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "打中......了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "將軍，沒有屍體。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "可是地面都爛了......敵人還能躲到哪裡去？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "將軍，身後！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "只要你敢出來，我就能殺死你！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "是嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "曼弗雷德，你剛才的話說得很好，可惜......只說對了一半。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "一半？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "薩卡茲並不僅僅依靠源石技藝——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "——但薩卡茲也絕對不會只用刀劍戰鬥。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "啊啊啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "這地面軟得不正常——空氣會吞人！我、我的刀突然握不住了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "將軍，你也在下陷？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......都不要動，也不要慌亂。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "短刀是他的法杖。這是源石技藝，也僅僅只是源石技藝。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你很冷靜，這很好......你救了你部下的命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "但是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......唔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "地面......快到胸口了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "劍......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "以你的劍術，擋住我的攻擊輕而易舉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "可你越是使勁，就越快被地面吞噬。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你想要這種結局嗎......這種自取滅亡的結局？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "呃......咳咳......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "將軍——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "都別過來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "或者，你可以和你的部下一樣，停止一切動作。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......你是想讓我等著你捅穿我的心臟？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "要殺死你，也不容易。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "咳咳......哈......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我知道了，你並不是真的想取我的性命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "沒想到，除了阿斯卡綸，羅德島還有一位頂尖的薩卡茲刺客。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我並非刺客。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "沒有必要的話，我並不想傷害任何一個薩卡茲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "但你卻在幫助我們的敵人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "維多利亞人......是敵人嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我看到的是，一群傷痕累累的士兵，在自家的土地上，為了活下去而苦苦掙扎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "而你和特雷西斯，你們正在讓薩卡茲變成所有人的敵人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我以前就想過，有機會的話，我想跟你們談一談。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "很遺憾，我們初次見面，就是在戰場上——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "——羅德島的精英幹員。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "又不見了？呃，地面恢復了正常！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "差一點點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我幾乎就要抓住他了。他的源石技藝很特別......他並不是在給我們的神經系統施加影響製造幻覺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "地面留下了能量轉化的痕跡。難道說......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "將軍，他們都不見了！我是說，那些維多利亞士兵——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "呵......他願意配合我拖延時間，就是為了把那些重傷的士兵一個個地救出去嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "那......那我們要不要追？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你覺得我們能追上嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我說了差一點點——但對於那種程度的術師而言，差一點就等於絕對會失敗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "可惡！我們今天本來能在這裡把那些反抗力量一鍋端，結果又是雇傭兵反叛，又是被什麼神秘術師阻攔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "因為羅德島......這就是羅德島。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我們錯過了把敵人一網打盡的機會，但他們的損失，難道又會少？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "他們本來有藏在暗處的機會，如今卻被迫一個個走到了台前。暴露力量對他們來說，已經是戰術上的極大失利。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "刺客，擅長空間幻術的術師，還有那位至今未曾露面的女妖......羅德島的底牌，還剩下多少？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "將軍，你有計劃了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......走吧。在對付羅德島之前，我們先把不安分的小丑給收拾了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "先到這裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "......這是廠區外面的街道？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "您......您用匕首劃開了空間？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "不要輕易相信你的感官。要誤導你們的雙眼，遠比影響空間容易得多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "您......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "您救過我，而且不止這一次。我的眼睛或許不能告訴我最正確的答案，但我的感覺不會出錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "您到底是誰？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "Misery。我是羅德島的Misery。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "羅德島？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "抱歉......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "以後你會有機會從風笛那裡得到完整的解釋。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "風笛？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "她現在算我同事了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "而且......她還是我最好的朋友結交的最後一位朋友。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "聽起來我錯過了很多資訊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "在我為風笛感到高興之前，請容我再次向您與羅德島致謝。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "先離開這裡。以後我們很有可能還會見面。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "曼弗雷德幾乎追蹤到了我的源石技藝的真相。他隨時都可能追上來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "......不。我想，他此刻大概在忙著處理另一件事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "你是說深池。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "小丘郡的蔓德拉......她不可能離開這座廠房了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "你是在惋惜自己無法親手為戰友復仇嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "我......我只是覺得可悲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "無論是為了站在這裡，懊悔著錯過殺死她的機會的我自己......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "號角",
          "text": "還是為了早就無藥可救的她。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "奇怪，你跟他們說好了吧？他們怎麼沒在這裡接應？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "深池士兵",
          "text": "我——呃！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "怎麼回事——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "深池士兵",
          "text": "薩卡茲！是薩卡茲！我們快跑——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "......我們被發現了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "不，不行，“間諜”，我們走——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "從那扇門出去，也就十米了對不對？只有十米，我們馬上就能......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "好......好的，跑......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "就像過去一樣，那時候是你拉著我，我們只要跑得夠快，那些貴族小孩就追不上我們......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "石像！擋住，擋住他們！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "混蛋！都這時候了，怎麼連你們都靠不住？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "蔓德拉......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "怎麼了？不是叫你先不要說話的嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "我走不了了。你走吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "你說什麼......？我做了這麼多，不都是為了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "......為了救我，還是為了去找領袖邀功？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "這有區別嗎？“間諜”，你說什麼傻話？我們只剩下五米了，我們的人就在外面！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "他們不在了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "蔓德拉......領袖她......她早就拋棄了我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "“間諜”！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "混蛋，混蛋——石頭，快去，扎穿他們，扎穿那些薩卡茲！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "“間諜”，你不會有事的，你只是挨了一箭，剩下三米，就算我扛著你——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "......你走吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "要是走得掉的話......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔拉密探",
          "text": "不要......不要去找領袖。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "......死了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "你怎麼可以就這樣簡單地死了......我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "基里安，基里安......你個混帳東西！我不許你死在這裡，你給我起來，起來啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不必著急。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你也活不了多久了，蔓德拉。你和你的塔拉老朋友，很快就能相聚。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "哈......哈哈哈哈！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "曼弗雷德，你又欠了我十一條命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "我好不容易......好不容易殺了那麼多薩卡茲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......這就是為什麼你必須死在這裡。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "真好......你們送上門來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "蔓德拉",
          "text": "我要一個不剩地，把你們全部碾成泥。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
