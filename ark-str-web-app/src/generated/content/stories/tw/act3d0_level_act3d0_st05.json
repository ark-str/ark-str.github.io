{
  "server": "tw",
  "storyId": "act3d0_level_act3d0_st05",
  "groupId": "act3d0",
  "stageId": "a003_st05",
  "title": "此生摯愛",
  "storyCode": "OF-ST5",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act3d0/level_act3d0_st05.txt",
  "sourceHash": "cae5ec1ca7479f0027e1f961a9521f5b962fe4373e12f6aa51176a379a7a8930",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士，這次我可要批評你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "大家身上都多多少少有些輕傷，作為領隊你也有責任的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "雖然古米已經給他們處理過了，但是下水的話，還是會影響到傷口的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "真是的，帶隊玩耍也別太過火呀......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "抱歉。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "唔，我也不是想破壞博士的好心情......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "這身泳裝很適合你，阿米婭。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "是、是這樣嗎？是暴行姐姐給我挑的這件泳裝，我還在害怕博士會不會不喜歡——",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "等等！不要想著岔開話題，Dr.{@nickname}！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我們這次可能確實做得有些過火......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "真是的，我也要好好說說赫拉格先生了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "明明讓他監督你的，結果他也對你們睜一隻眼閉一隻眼......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "在沒有簽訂合約前，羅德島不能插手任何獨立城邦的內部問題。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "要是被捲進城邦本地的麻煩，羅德島的處境會變得非常艱難，甚至難以脫身。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "其實，我們已經......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是啊，我知道的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士可真是做了件很危險的事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "——和狂熱的歌迷起衝突什麼的！博士好歹要有些大人樣子呀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "再怎麼喜歡一支樂隊，也要和其他觀眾和平相處哦，更別說參與鬥毆什麼的了！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......？可我們是......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（噓！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "總之不要再問啦！整件事就是這樣了！嗯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "下次可要好好注意哦？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我知道了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士，快來吧，我在礁石另一邊發現了很多好看的貝殼！海灘什麼的，好有趣呀！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "水不涼，嗯......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（跟著阿米婭走）",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "來，博士，這裡走！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "（向阿米婭潑水）",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "哎！博士！別這樣！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "可惡！看招！哈哈哈哈......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "（拉住阿米婭的手）",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "嘿嘿......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "Dr.{@nickname}，你來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我聽錫蘭說了你們羅德島的事情，我很想跟你聊聊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "如何，就陪我出去走走吧。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......好的。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "感謝你，羅德島的博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "這次如果沒有你的幫助，小女的魯莽行動恐怕只會慘澹收場。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那不是魯莽。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我並沒有做太多的事情。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你應該感謝的人是錫蘭才對。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "克洛寧是我一手栽培起來的，他有野心，但也有這個能力，所以我這些年對他的一些小動作總是睜一隻眼閉一隻眼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "但是，這幾年，他有些走偏了，我對他並不放心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "這一次，借著前往新開發區的機會，我留下黑，也是想讓她看看這小子還能不能用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "結果很遺憾。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "為什麼和我說這些？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "......我很喜歡沿著這片海灘散步。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "因為，芭芭拉——我的妻子，她就沉睡在這片海裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我還記得那一天，天氣有點熱，夕陽很好，就在這裡，她和我說，“要是我們能永遠生活在這裡就好了”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "轉眼，就只留下了我一個人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "博士，回頭看看。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "你能明白嗎？這座城市是我為她打造的天堂。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "而我為什麼要告訴你這些......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "因為我看得出，你和我是同一種人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "這個世界上，有些事不是靠好的那些東西就能解決的，有時候，必須借助一些所謂不好的東西。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我是。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我不是。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "誰知道呢。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "對我來說，善良與否在很久以前就沒有任何意義了，有的只有結果，有的只有這座城市。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "為什麼不告訴錫蘭？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我不是來尋求理解的，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我如果需要我女兒的理解，我和她就不會是現在這個樣子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "而且，告訴了她她就會理解嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "不會的，她還要很長時間才會理解，這個世界不是她想的那樣條理有序。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "黑希望她永遠不會理解，而我......很遺憾，我失去了選擇的機會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "博士，錫蘭她想要加入你們，我讓黑和她一起去，這些我都允許。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "因為這座汐斯塔已經不再是她的天堂了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我已經看過新的地質報表了。照這樣下去，汐斯塔遲早會在迸發的岩漿中落下帷幕。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我們推遲了那一天的到來。對你們今天的努力，我表示感激。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "這些年來我一直在尋找徹底解決這件事的辦法。我找到了，但代價也很一樣巨大。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我一直投入精力的高新區，那將會是一座全新的移動城市，現在看來，那將會成為新的汐斯塔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "我對這裡的執著很深，但這並不意味著我會對身旁淺睡的火山熟視無睹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "這次黑曜石節結束後，我們將遷進移動城市；現在的汐斯塔城將會被我們拋棄，遲早淹沒在滾熱的岩漿中。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那黑曜石節......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "據說這片海洋有著它的邊界。也有人對我說過，這裡不是真正的大海，它的邊界也許寬廣，卻有盡頭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "那麼我們會環著這片海走下去。或許有一天，我們會真正回到起點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "只是，這座有著美麗海灘和盛大的黑曜石節，以及這座能感受到火山氣息的海濱城市本身——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "這座有著無數汐斯塔人回憶的汐斯塔，終究是不復存在了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "也許有一天，你可以把我說的這些告訴她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "你也可以永遠都不告訴她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "而有一天，當她需要一些幫助時，你可以來找我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "無論汐斯塔在哪裡，變換成何種模樣，這座城市，永遠會是她的後盾。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "不——該這麼說。只要汐斯塔人還在，汐斯塔就永遠在。她們這些年輕人才是真正的汐斯塔。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "趁現在，好好享受這次的黑曜石節吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "至少在找到新的理想場地之前，我們只能擱置和塞壬唱片之間的合作啦。我該去和他們好好談談了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "黑似乎也有話想跟你說，她在那邊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "如果我說太多，她就更沒話可說了。讓她自己和你說吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "......老爺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫爾曼",
          "text": "別介意。之後是你們年輕人的事情了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "你好。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你的目的是什麼？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "黑",
              "text": "不用緊張，我已經不是你的敵人了。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "你好，陌生人？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "黑",
              "text": "呵，你好，陌生人。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "要不要喝一杯？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "黑",
              "text": "現在就免了。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "其實，也沒有什麼特別的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "原本我是想教訓你一頓的。小姐不該遇到這種危險。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "但我也要謝謝你。沒有你，我和小姐也許永遠沒法解開誤會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "我一廂情願地不想讓她觸碰這些事情，但也許你才是對的，她有自己的想法，也有自己的責任。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你不該替她做決定。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "時光無法倒流，她已經是現在這樣。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "那真是對不起囉？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "......謝謝你。如果不是你，我所珍視的一切都會被這座火山吞沒。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "我欠了你很多。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "咦，黑也在這兒嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "......小姐？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "正好，我有一件重要的事要向你們宣佈！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "我啊，準備向羅德島投一份簡歷。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "？！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "之前我也說過吧，我本來就對你們公司有意向。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "要加入我們可不輕鬆。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "嗯哼，我已經問過艾雅法拉小姐和天火小姐了，她們表示以我的能力絕對沒有問題的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "這次事情也讓我看到了你們的實力，所以經過深思熟慮，做出了這個決定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "但是羅德島不是一家單純的製藥公司......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "所以我要你跟我一起去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "順便一提，爸爸那邊也已經同意了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "......我知道了，如你所願，小姐。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "所以說呢，博士，從今往後，可就要請多關照啦。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "博士，快過來！實驗要開始了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "哎，算了，黑，快去把博士扛過來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": ".....我想博士也不至於聽不到你這能夠把天花板震翻的嗓音，小姐。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "......博士，雖然不知道你還在等什麼，不過現在這種狀況，小姐是不會在乎你我在想什麼的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "還是麻煩你自己走過去吧。如果真要我扛著你去的話，可能會不太雅觀。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這就來！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我會好好盯著她的，放心吧。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "小姐請等等，我們這就來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "走吧，博士。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
