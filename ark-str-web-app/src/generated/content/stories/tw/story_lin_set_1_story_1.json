{
  "server": "tw",
  "storyId": "story_lin_set_1_story_1",
  "groupId": "story_lin_set_1",
  "stageId": null,
  "title": "新潮舊浪",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_lin_1_1.txt",
  "sourceHash": "5d7c6ed1ca7c3e38732b6fbfd0f7040cb950619eff93b146ac1bd9d840d27dac",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "局長，按照您的指示，我們的人已經把貧民窟大大小小的出入口都盯住了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "很好。輪好班，今天別讓一隻鼷獸溜進去，也別讓一隻鼷獸溜出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "局長，這麼興師動眾，會不會起反效果？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "鼠王宣布讓林小姐繼承衣缽以來，已經過了半個月了，貧民窟沒發生什麼事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "但是，那隻臭老鼠也失蹤了半個月了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "貧民窟的話事人新舊交替，什麼都沒發生，你信嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "瘦子張、師爺李、鬼眼……這些被鼠王壓了這麼多年的老滑頭們什麼都不做，你信嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "今天，瘦子張把臭老鼠手下的人帶走了，她不可能不行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "……林小姐應該能擺平。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "但我不需要她來擺平。貧民窟是龍門的一部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "也對，這點我支持你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "盯好你那邊的人，那邊肯定也會有動作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "放心。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "給我等著，死老鼠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "大家呢，都喜歡在酒吧裡喝酒跳舞，但我是個俗人，偏愛在酒吧裡吃火鍋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "以前，我林大哥也時常光顧這裡，和我們兄弟幾個吃香喝辣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "可惜啊，下週這家酒吧就要拆了，今天在這裡吃最後一頓，也算為這裡送行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "來，吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "膽怯的商人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "汪老弟怎麼不動筷子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "汪老弟在我的地盤上建醫院都敢不跟我說一聲，怎麼吃一頓火鍋反而不敢了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "膽怯的商人",
      "text": "蓋醫院……是林姐的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "你看看，我就說啊，現在的年輕人不會做事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "你林姐是什麼人？鼠王的接班人，日理萬機！這樣的人物，忘了一兩件小事有什麼問題？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "我們做小弟的，最重要的不就是要為老大分憂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "嗯？汪老弟，你說說，究竟是你忘了，還是我林侄女忘了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "膽怯的商人",
      "text": "是、是我忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "那不就對了，你林姐見了我，也要叫我一聲叔叔，她怎麼會不和我打聲招呼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "都是誤會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "汪老弟，我看你一直在抖，身子骨有點虛啊，而且你的記憶力也不太好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "這樣，你把這鍋火鍋湯趁熱喝了，補補身體，然後去跟我侄女報個信，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "膽怯的商人",
      "text": "這……我……張先生，您放過我吧……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "商人顫抖著想要站起來向瘦子張下跪，但一隻手按住了他的肩膀。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "看看是誰來了？我的林侄女！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "侄女，不是張叔要說你，手下的人這麼畏畏縮縮，怎麼能做大事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "當年張叔為了不讓你爸丟臉，可是當著好幾個大哥的面，把盤子咬碎了嚥下去的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "現在不比張叔當年，如今做生意講究的是和氣生財。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小汪妻子要生產了，讓他回去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔既然想找的是我，我來陪你吃火鍋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "那怎麼好意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小汪，回去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "膽怯的商人",
      "text": "抱歉，林姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "不怪你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "來，侄女，吃菜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔，你是長輩，有什麼話，你大可以直接告訴我，何必多此一舉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "這些年，你的能力大家都看在眼裡，林大哥如今把話事人的位子交給你，我支持。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "江湖上最講究“規矩”兩個字，既然你是話事人，張叔當然不能用對晚輩的態度對你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔對我的態度，倒也不像是對話事人，而像是對敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "欸，侄女這話就過了。混江湖，沒有規矩，不成方圓，但不講情義，又何來立足之地？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "侄女不聲不響地在我的地盤上大興土木，這是擺明了要拆我的台。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "我也只是想提醒一下侄女，有些事，不要搞得大家臉上都不好看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "如果我說，我是特意沒有通知張叔的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "看看，誰說我侄女不會開玩笑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔誤會了，我沒在開玩笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……侄女該不會是以為，坐上話事人的位置，就可以為所欲為了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我坐上話事人的位置，是為了不讓某些人為所欲為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "這件事，我林大哥知道嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔剛才也說了，現在我才是話事人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "看來，今天我得替我林大哥好好管教一下女兒了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "胖坤，來跟我林侄女一起吃頓火鍋。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "叫上弟兄們，都帶上傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "坤哥，我們真的要對那位林小姐下手？她不是新話事人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "哼，當話事人也要下面的人支持才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "她剛上位就敢越過張哥在這裡搞事，真當貧民窟是她林家的地盤了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "但、但她畢竟是鼠王的女兒，這背後難保沒有鼠王的意思……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "以鼠王他老人家的脾氣，他要動張哥，還用得著借他女兒的手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "這……難道鼠王就任由他女兒亂來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "林小姐做事的風格跟鼠王不一樣，這點大家都知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "她喜歡跟白道上的傢伙們打交道，這點大家也都看在眼裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "只是沒想到，她會做得這麼絕。一上位，直接把貧民窟幾十年來的規矩一腳踢開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "我看啊，連鼠王也未必料得到，自己的女兒敢做這麼忘本的事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "你聽好了，我們不是要對林小姐動手，我們是要替鼠王教育教育他的女兒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "坤哥教訓的是，我這下明白了！我這就召集兄弟們！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "看來張叔早有準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "放心，就是讓下面的人也來吃一頓，熱鬧熱鬧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "張叔也是要給林大哥交代的，不會對你做什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔還是不明白，我爸已經不管事了，你想對他有什麼交代？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "林大哥說不管事，就真能不管了？貧民窟上上下下有多少人還是只聽他的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "侄女真以為，沒有那些人的支持，你能當這個話事人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我有自己的人脈，也有自己的生意，這些和我爸都沒有關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "哎呀，侄女，聽張叔一句勸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "年輕人想撇下我們這些老東西，覺得我們跟不上時代，我懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "但是，有些東西，不是你想撇下，就能撇下的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "退一步說，你今天讓張叔下不了台，明天林大哥想和老兄弟敘敘舊，還怎麼敘？後天，你王姨想和你母親一起去逛街，這街還逛不逛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "你這孩子平常做事滴水不漏，到這一點上怎麼就不知變通了呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "是張叔太把人情當回事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "你這孩子……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "罷了罷了，本來張叔也不想做得這麼絕，不過，看來是得給你下一劑猛藥清醒清醒了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "喂，老李啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "醫院的事，處理一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "王局長，還記得我嗎？我是瑞翔建築的李敏恆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "記得，怎麼不記得。託李總的福，我才知道大地上還有那等美食。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "哈哈，知道王局長對美食有講究，我才特地託人從雷姆必拓送了一些山珍過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "可以可以，我就知道，你這個朋友交得值得。以後有什麼需要我幫忙的，儘管說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "哈哈，不瞞您說，貧民窟的醫院，您知道吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "當然，這事可不小，老百姓都很關注啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "不過，它的競標已經結束了吧？我記得，是貧民窟的一家公司得標了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "唉，您也知道，我們小本生意，想做出頭不容易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "這項工程，我們原本勢在必得，誰知道被貧民窟的人搶了頭籌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "話雖如此，老李，那家公司是合法競標、合法得標的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "我知道，但您可能沒發現，他們提交的資料裡，有點紕漏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "你確定？只是一點小問題的話，可沒辦法改變結果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "但是，它也有可能影響結果，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "我只是想先和您打一聲招呼，之後我們投訴的時候，您只需要點個頭就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "其他的事，絕不會煩擾到您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "我從玻利瓦爾又弄來了一些好貨，下個月送到，到時請您來嚐嚐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "……哈哈，好好，沒問題！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "好了，現在，侄女可以安心吃火鍋了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "……不急。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我有些問題想先問問張叔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "你問，只要是張叔知道的，都可以告訴你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "龍門常會接收一些荒野上的流民，這些流民大多被安置在貧民窟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "為了防止流民數量過於臃腫，魏總督受命和其他國家洽談，簽訂了一系列的援助合約，旨在讓背井離鄉的人能夠回到家鄉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但是每到這種時候，總會發生一些失蹤案件，有的是人到了地方卻消失了，有的則是人明明不在援助名單上，卻從貧民窟消失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我一開始以為只是巧合，但隨著調查的展開，我發現是有人藉著援助的名義，在做人口販賣的勾當。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔確實好算計，每次都會聯絡不同的買家，賣出去的人也都會有意地打散，把他們送去不同的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我花了幾年，終於找到一點線索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔還認得這些照片上的人嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "林雨霞從隨身的提包中取出幾張照片，照片中是幾個瘦弱的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "不記得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我猜也是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "都準備好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "是，弟兄們都過來了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "是誰？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "咕……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "誰敢在張哥的地盤撒野！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "咕哈……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "你、你到底是什麼人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "出來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "是他嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憤怒的男性",
      "text": "……沒錯，是他，我永遠記得他的嗓音……就是他害死我爸的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐懼的女性",
      "text": "我也記得！是他，是他害我在烏薩斯的礦場待了十幾年！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的老人",
      "text": "沒錯……沒錯……化成灰我都記得他身上的紋身……是他沒錯，是他把我賣到了雷姆必拓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "他現在動不了了，林小姐說了，你們想怎麼樣都行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "這些人見到胖坤，臉上又驚又怒，聽到林雨霞的手下這麼說後，其中幾人壯著膽子上去給了胖坤幾腳。\n但大多數人，還是畏縮地站在後面。\n他們臉上更多的，還是這些年在外擔驚受怕的恐懼。"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "各位，林小姐讓我向你們保證，從今往後，你們夜裡再也不會做惡夢了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "因為——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "都不准動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "附近有鬥毆聲，怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "你們看，龍門近衛局會為你們主持公道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "……你是臭老鼠的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "詩懷雅局長，我在這裡代替林小姐向您檢舉，張文浩手下的胖坤一行人，這些年來一直都在進行買賣人口的違法勾當。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "人證就在這裡，物證……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "也在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "相信您會還這些人一片朗朗乾坤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "……*龍門粗口*，臭老鼠，算計好了是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "林小姐只是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "好了。把胖坤這夥人帶走，然後把這些證人保護起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "臭老鼠的人也別想跑，帶回去做個筆錄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "局長，您要去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "……吃個火鍋。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "侄女有所不知，當初有多個國外的黑幫想要在貧民窟扎根。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "林大哥雖然厲害，卻也雙拳難敵四手，若非我扛下了這部分壓力，林大哥未必能在貧民窟站穩腳跟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "侄女，你當時還未出生，不知道其中的險惡，我不怪你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "爸常說，若不是你當年主動站出來，貧民窟難免又是一場腥風血雨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但爸不知道，他感激的人，暗中卻和這些黑幫達成了合作，協助他們買賣人口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "當時是形勢所迫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "總有辦法。就算當時沒有辦法，後來也該有辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔，時至今日，到底有多少是形勢所迫，有多少是掩耳盜鈴，又有多少……是無法自拔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "侄女，你沒經歷過當年的事，就別拿一副什麼都懂的語氣來說這些話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我確實沒經歷過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但有些事，我寧可沒有親身經歷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔，你去找過這些人嗎？幫助過他們嗎？為他們做過什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "你見過他們在物是人非的舊宅前失落的樣子嗎？見過他們在親人的墳前哭嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……侄女，省省吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "你難道以為，說這些話就能讓我動搖嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔知道的，我沒有這麼天真。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "只是跟張叔提個醒，怕張叔忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "不過，這張照片上的人，張叔肯定記得。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "林雨霞又從包中取出另一張照片。\n照片上，是瘦子張、李總裁和王局長在酒席上歡聲笑語的場面。\n瘦子張的臉色瞬間陰沉了下來。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "長官，姓李的離開王局長辦公室了，怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你們去盯著姓李的，我去和王局長談談。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "呼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "……請進。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "王局長，我是近衛局的督察星熊，有些話想和你聊一聊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "近衛局的長官，您來得正好，我要向您檢舉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "不，是自首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "……什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "我自首，我在過去包庇了部分企業的違法競標行為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "同時，我檢舉，瑞翔建築的李敏恆，想要非法改變貧民窟醫院的得標結果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "他剛才來找過我，我把我們的對話全部錄音了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "還有，他背後的首惡，貧民窟的張文浩，這些年來多次用賄賂和暴力手段暗中控制商業招標競標活動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "我手上有充足的證據。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "……是誰讓你這麼做的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局長",
      "text": "……沒有人，長官，這都是我自願的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "……林小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "真是了不起。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "“李敏恆”……對許多貧民窟的人來說，這個名字不算陌生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "許多貧民窟的基建都是他的公司承辦的，說他是貧民窟的大善人也不為過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我始終記得，小時候爸告訴我，貧民窟的這些樓、那些廳是張叔的朋友李先生建的時，心中對他的感激。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "甚至可以說，我想要為貧民窟建第一所公立醫院的契機，就來自他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但是，當我自己學習這些知識，踏上這條道路後，我才知道他和政府官員勾結，騙取了多少投資和補助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "那些我曾經引以為傲的建築，實際上都是用便宜的材料濫竽充數建的。他從建築款中榨取的利潤，多到難以想像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "而唆使他走上這條道路的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "也就是你，張叔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……是他先找到我的，是他先跟我說，這裡面大有可為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "是你先，還是他先，有什麼區別呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "最終，是你們共同攫取了貧民窟萬千窮苦人家應得的利益，化作自己享樂的資本。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "這些年，有些事，張叔確實瞞了你爸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "有些是身不由己，有些是一念之差。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "想到這些事，心中對林大哥總是愧疚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "被侄女點出來，這麼一承認，心裡反而釋然了一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "只不過，這樣的話，張叔今天就更不能讓你走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "抱歉，侄女，你得跟張叔走一趟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "等到我安全——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "老李，怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "老張，救我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "近衛局的人忽然找到我，要把我抓去關了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "你說什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李總裁",
      "text": "喂，老張，別掛——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……嘖。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "胖坤也在局子裡了，想見自己去局子裡見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "通訊聲還沒響兩下，詩懷雅就從酒吧門口走了進來，隨手把胖坤的通訊終端丟在瘦子張的面前。"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔還要打電話嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我可以替你打，師爺李、鬼眼、王經理、陳部長……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "林雨霞說著，從包中掏出通訊終端，盯住瘦子張。\n瘦子張沒有理會林雨霞，手握著通訊終端，靠在椅子上，臉色不斷變化。\n大勢已去。\n最終，他閉上眼，深深呼出一口氣。\n一瞬間，他彷彿老了十歲。"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "張叔，出來混，早晚都是要還的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……你王姨怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我會親自去向王姨說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小張哥的學業也不會受到影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "當年，我也和你一樣，以為自己能守住原則。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "結果一步錯，步步錯啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "替我跟林大哥說一聲，就說……張文浩對不起他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我會的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子張",
      "text": "詩懷雅局長，帶我去見胖坤和老李吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "警車就在外面，還要我送你嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小時候，張叔對我很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我還記得八歲的時候，有一次，他為了逗我開心，把他新買的高級手錶丟進了井裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "那你還真是一隻沒心沒肺的死老鼠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我就是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "別以為我會領你的情，近衛局本來就快抓到瘦子張的把柄了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我只是在解決家裡的頑垢而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "喔，那還真了不起啊，我們的林女俠，剛從玉門回來，就幫近衛局除掉了一根眼中釘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "不僅能神不知鬼不覺地把人帶進貧民窟，就連政府財務部門的人也能影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "要不然我去和魏總督說一聲，你來當這個局長，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "有些事，現在只能這麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "貧民窟跟龍門之間隔著的那堵牆，要慢慢拆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "如果我不知道，我還會好聲好氣地在這裡跟你說話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "你猜我把貧民窟圍起來，是為了抓你，還是為了保你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "你沒蠢到非要今天抓我不可，也沒好心到如果我露出破綻，還會放我離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "知道就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "在你父親的時代，龍門需要貧民窟。但這不代表，龍門永遠需要貧民窟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "別告訴我，你忘了我們中學時說過的話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "“沒有人生來就該在貧民窟裡過日子，總有一天，貧民窟裡的人，也可以生活在陽光下。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我沒忘，但我怕某個當初爽約的人忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "小心眼的女人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "這件事你還打算念幾年？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我是沒心沒肺的死老鼠，能有一件事拿來損你，當然會念到你死為止。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "嘖，跟你聊天真是氣人，我早晚得讓星熊幫我常備降壓藥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "算了，反正，只要你還記得這句話，你還知道自己是在為誰謀福祉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "近衛局不會是你的阻礙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "這算是近衛局局長為我這個普通市民頒發的免死金牌嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "為什麼不理解成是近衛局局長為你這個普通市民上的鐐銬呢？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "詩懷雅說著，從懷中掏出一副手銬。\n一邊銬在林雨霞的手上，另一邊，銬在自己手上。\n林雨霞並沒有反抗。"
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "不管怎麼說，你得跟我回去做個筆錄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "今天的事，給我一個交代。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "……呼，在貧民窟裡跑了半天，我肚子都餓扁了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "先吃點火鍋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "臭老鼠，快下點菜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "為什麼非得我來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "我這隻手銬住了，動起來不方便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "唉……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "一把年紀了，又受了傷，一個人爬這麼高也不怕摔到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "老朋友走了，腿腳不便，澆一碗酒，就當送別了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "是腿腳不便，還是沒有臉面？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "……老友，你還記得當年那個拍著胸脯跟你說，只要有他在，就絕不會讓你我少一根汗毛的傻小子嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "記得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "他為我做事三十年，我也讓他享了三十年的福。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "只是，我也沒想到，他瞞了我那麼多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "我沒什麼對不起他的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "但你下不了手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "你也沒想到你女兒會如此果斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "堂堂貧民窟的鼠王，躲在這裡不想見女兒，說出去也不怕遭人取笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "此言差矣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "如今我已不是鼠王，只是一個喜歡逛街弄羽的糟老頭子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "女兒的成長超乎想像，我這個糟老頭子高興還來不及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "你倒想得開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "我當然想得開，畢竟就算現在不想見，等一下也要在一張桌子上吃飯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "反倒是我們的大少爺你，怕是想見也見不到啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "……哪壺不開提哪壺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "我依然是那句話，她若是打算回來，龍門會是她最好的後盾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "老友，我們都老了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "但龍門的未來，交給這些後生，我還算放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彥吾",
      "text": "你再這麼說下去，老得更快。",
      "portraitKey": null
