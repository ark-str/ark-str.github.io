{
  "server": "tw",
  "storyId": "story_susuro_set_1_story_1",
  "groupId": "story_susuro_set_1",
  "stageId": null,
  "title": "專業醫師",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_susuro_1_1.txt",
  "sourceHash": "b3ae8c7a94ccea1ba0b74946b0d8005dafd273aa7b87cf90c0036b5fb6e2823f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "幾點了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "四點，你都問了幾遍了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "我急啊！你不急嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "冷靜點。急有什麼用啊，他們從本艦趕過來的，能平安到達都謝天謝地了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "說真的，三天怎麼從本艦趕過來？有點厲害啊，本艦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "你沒去過羅德島本艦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "沒去過，這一趟車費可不便宜，再說還有一堆事情要做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "本艦有一種大型浮空交通工具，移動速度特別快，沒見過吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "浮空的？車？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "那肯定不是車......具體的我也叫不上來名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "哦哦，是高塔的術師老爺們用的那種高級貨，天上飄的那種？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "也不是那個！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "哎呀你別猜了，我見得不多，也講不太清，回頭看到就懂了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "你這麼閒，再檢查一下車，回去的時間可就很緊了，別出差錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "行行行......你是老大，你說了算。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "說起來，這次本艦來的是什麼人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "你都沒去過本艦，說了名字你也不認識。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "我們這邊遞交的是緊急申請，無論來的是誰，肯定是醫療部門的精銳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "這次事情可不小啊，這來的得是什麼樣的精銳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "這你就別操心了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "哦，他們來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "這載具......有點厲害啊，本艦還有這種東西，長見識了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "行了，準備接人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "歡迎來到萊塔尼亞，我是本地辦事處的負責人菲勒加斯，叫我菲勒就行了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "你好，我是本艦醫療幹員蘇蘇洛，這幾位是我的助手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "（點頭）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員B",
      "text": "你愣著幹什麼，打個招呼啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "哦！哦！對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辦事處幹員A",
      "text": "我是辦事處的......司機......不對，我是本地辦事處的幹員，代號活塞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "情況很複雜，我們時間緊急，各位先上車吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "關於這次突發事件的詳細情況，我們列印了全套資料，就先在車上看吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "好的，麻煩您了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "我們還攜帶了一些設備，也麻煩您搬到車上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "好......好的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "兩個小時後"
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "讓我看看第二份文件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "你檢查一下這份報告，確定一下有沒有需要額外準備的器材。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "（喂！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "怎麼了，說話鬼鬼祟祟的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "你小聲點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "不是說派來的都是精銳嗎，怎麼領隊的是這麼個小姑娘？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "你小子說話注意點，小心我扣你獎金。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "什麼時候養成的以貌取人的爛毛病？員工手冊白看了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "不懂就管住嘴，這位是真的本艦醫療部門精銳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "好好好......我的錯，我的錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "菲勒先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "文件我看完了，我有幾個問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "根據描述，這次險情中大部分需要醫療救助的人都不是礦石病感染者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "是這樣的，雖然萊塔尼亞官方通報的說法是天災導致城市破壞與傷亡，但是實際情況比這要複雜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "是天災信使的工作失誤嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "目前來看......並不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "這次針對天災的撤離行動本來是沒有任何問題的，至少從流程上沒有遇到任何問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "唯一的問題是......誰都沒想到天災颶風的路徑下有至少十片針蚤的大型巢穴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "那個村子雖然提前開始了移動，但是上百隻逃離天災的針蚤直接衝到了遷徙的隊伍裡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "針蚤？就是那種一米多長的食肉蟲子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "上百隻？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "......我明白了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "目前有傷亡數字嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "萊塔尼亞官方信源還沒有給出明確的數字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "已經兩天了，還沒有得出結論......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "說明傷亡人數暫時無法統計。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "領地衛兵把很多傷者送到了附近的城鎮，我們還沒來得及一一查看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "辦事處儲備的醫療物資還充足嗎？處理針蚤毒素的解毒劑儲量呢？手術設備保養狀況如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "當地其他醫療救護隊的調動情況呢？我需要這些文件上沒有收錄的資訊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "醫療物資方面，暫且還算充沛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "本地的掌權者第一時間就開始了救援工作，羅德島辦事處在接到委託之後也得到了充足的應急救難物資補給。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "醫療設備狀況都不錯，但它們不會自己動起來，我們的人手嚴重不足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "鎮子裡的醫生算得上訓練有素，但缺乏緊急情況下的應對經驗，很多人一輩子沒見過這種大災大難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "辦事處駐紮的城鎮人口不多，因此，全鎮加起來也只有三個小診所，能做手術的醫生就更少了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "很多傷患沒能撐到手術台上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "辦事處現在容納了很多難民，情況非常不樂觀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "而且，在這樣混亂的情況下，我們無法第一時間對人群進行區分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "送來的病人裡是有感染者的......而感染者逝世之後的情況......你明白我的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "......我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "還有一段路程，你們先休息一下吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "我們到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "這邊已經有不少人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "傷患應該都轉移到辦事處附近了，辦事處的其他工作人員應該正在處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "活塞你在這裡等著，一會兒會有其他網站的補給車過來，你在這裡接應。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "我在這裡乾等著？合適嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "這是你第一次參加這種任務，現場情況比你想的要殘酷得多，老老實實在這裡接收和分派醫療物資吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "開玩笑，那幾個小姑娘都能去，我一個大老爺們怕什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "......臭小子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "行，沒問題，回頭可別說我沒提醒你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "面目全非的傷患",
      "text": "水......給我水......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小孩",
      "text": "爸爸！爸爸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血肉模糊的傷患",
      "text": "咳......咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "本地醫生",
      "text": "過來一個人！這個感染者快不行了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普通傷患",
      "text": "感染者！別，別過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "本地醫生",
      "text": "你怎麼在這？快回到收治區去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "本地醫生",
      "text": "衛兵！衛兵！人呢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "......我的媽啊......這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "這比我想的還要慘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "我前天來的時候，那邊的大院子還是本地商會的貨運站，現在已經被徵用作為普通病患的收治區了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "醫生人手太過有限，只有傷勢最重的人能優先在醫療室得到搶救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "這些躺在地上的人......是什麼情況？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "這些應該都是感染者，這座鎮子比較小，沒有感染者收容區，他們不能把感染者和普通人安置在一個地方......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "那也不能把他們就這麼丟在廣場上，菲勒幹員，辦事處的倉庫能騰出多少空間？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "我現在就安排把東西全搬出來，問題不大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "我們還需要一個單獨的空間容納傷重的感染者，最好是能單獨隔開......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲勒加斯",
      "text": "那就只能把員工宿舍空出來了，這需要一點時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "交給您了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "一組去庫房，檢查感染者的情況。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "二組，三組和我來，把設備都搬到手術室裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "對傷患的分類和對應的安置就麻煩您了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "本地醫生",
      "text": "好，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活塞",
      "text": "我，我也來幫忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "本地醫生",
      "text": "好，你來搭把手，幫我把這幾個人抬到屋裡去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "使用源石技藝加速傷口癒合之前，一定要確定毒素已經清理乾淨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蘇蘇洛",
      "text": "如果傷口不嚴重，就盡可能不要動用源石技藝，醫生的體力是現在最寶貴的資源，合理調配才能保住更多性命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "本地醫生",
      "text": "先處理這一床！這裡有個危急病人！",
