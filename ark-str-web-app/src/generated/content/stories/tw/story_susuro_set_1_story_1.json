      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "本地醫生",
      "text": "他為了保護家裡人，被針蚤咬掉了胳膊，送過來的時候已經失去意識了。",
      "portraitKey": null
    },
