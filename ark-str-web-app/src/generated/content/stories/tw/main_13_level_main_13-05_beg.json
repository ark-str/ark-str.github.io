    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "呼——他們隨時都可能開炮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "被那鬼東西盯上可真不好受。",
