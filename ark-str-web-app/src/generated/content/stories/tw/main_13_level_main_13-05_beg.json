    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "唔……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "維娜！維娜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那些移動祭壇還在連環爆炸，小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "她暈倒了！該死，濺出來的金屬碎片扎進她胸口了！誰來幫我一把！",
