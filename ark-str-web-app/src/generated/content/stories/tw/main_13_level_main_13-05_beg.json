    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "嘿，舉手之勞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "大伙兒，聽著，我想徹底幹掉那些移動祭壇，我還需要你們幫我一個忙。",
