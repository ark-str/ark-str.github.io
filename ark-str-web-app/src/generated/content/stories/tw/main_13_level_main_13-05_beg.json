    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "摩根，你剛才受的傷還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "還是不能握刀，但是指揮物資調配問題不大。",
