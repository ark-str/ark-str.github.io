{
  "server": "tw",
  "storyId": "1stact_level_a001_03_beg",
  "groupId": "1stact",
  "stageId": "a001_03",
  "title": "意外之旅",
  "storyCode": "GT-3",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/a001/level_a001_03_beg.txt",
  "sourceHash": "dc3559d6da8cb4a487ffa864dcf2689414d8c0b8ebda494099c0b33bb4ad45f8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "咕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "你，你把我的同伴，全幹掉了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "......別、別過來啊！求你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "我、我把金幣都給你！我把我的武器給你！你要什麼我都——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那個女孩子在哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "你在說什麼——？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "別靠近我——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "你這個——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "晴 \\ 能見度 14公里\n塔拉特山前森林"
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "......這塊石頭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你們兩個，跟上。小心腳底，跟著我的腳印走，手也不要到處摸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "這片森林，恐怕比你我想的還要危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "石頭上是不是刻了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "這是賞金獵人留下的符號。不按照符號指示行動的話，就會踩進設置好的陷阱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "我們要直接躲開陷阱嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "看我的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "——絆索加捕獸夾，老土的小把戲。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "樹叢恰好擋住了擺錘，一旦貿然前進就會被擊中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "那裡，可蘿爾小姐，小心點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "嗯，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你再向前走一步，大概就會掉進滿是尖頭的深坑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不愧是賞金獵人，很擅長這些嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "那當然，畢竟我以前——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "想要繞開陷阱是不現實的。果然，還是要全部解除掉才方便行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "畢竟他們最危險的道路，馬上就會變成對我們來說最安全的那種了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "停下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "不太對勁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "是陷阱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "沾血的符號......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "“——怪物？”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "這什麼意思？這麼多年來，我都沒見過有人用過這個符號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "......啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不會吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "怪物，怪物！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "別，別過來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "真的是你啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "斯卡蒂，你是斯卡蒂，沒錯吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "——原來滴水村村長是和你在一起？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "啊，什麼？你認識可蘿爾.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "把她交給我。現在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "格拉尼，她的眼神，不太對啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "那可不行，我們應該談——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "欸，欸？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "嗚啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "這只是警告。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不，可蘿爾小姐，鮑勃大叔.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "她，她怎麼會攻擊你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你不是認識她，她怎麼就——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "別問那麼多了！快，快跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "哈，哈，她還在追著我們跑嗎？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "格，格拉尼，我，我跑不動了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "那個女人，真的，是怪物吧？她甚至，都沒在喘氣啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "為什麼我要陪你們浪費時間？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "她真的要砍了我，啊不，她要拿可蘿爾小姐幹什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "她的眼睛，好，好紅.....格，格拉尼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不行了不行了，為什麼還會有這種事啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "停！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "埋伏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "就是現在！放箭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "就是她，那個突襲我們的災星！快，快射她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "你們給我住手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "你小子想幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "雖然不知道為什麼她要追我，但好歹也是我的同事！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "為、為什麼要壞我的事！混帳——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "趁現在，快點走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "——向東突圍！走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "別想逃出去！受死吧怪物！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "（阿戈爾語）滾開!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
