{
  "server": "tw",
  "storyId": "main_8_level_st_08-03",
  "groupId": "main_8",
  "stageId": "st_08-03",
  "title": "死亡，召之即來",
  "storyCode": "M8-3",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_st_08-03.txt",
  "sourceHash": "7832f2dc21542bf98e33cf9a60e291bf6ceffb2a34629256d2cc98ddccb239b7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "中央區"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "救，救命......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "我們也是整合運動，為什麼要這麼做？你們薩卡茲就這麼恩將仇報嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "據守街壘的薩卡茲人正在屠殺整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "隊長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "幫助受害者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "隊長你去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "嗯，我去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "嗚......呃......為什麼，為什麼！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "整合運動怎麼變成這樣......怎麼變成這樣！不是說要團結嗎？不是說我們......我們是一家人，是親人嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "再見——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "停下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "重型武器投擲手，小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "漂浮在空中的巨型武器......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "是你，菲林，是你幹的？你，術師？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "放下武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "沒事了，快走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "去，去哪？我們已經，我的隊友，同鄉，他們都......他們都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "阿沁，幫他一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沁",
      "text": "知道。過來吧，兄弟。那些薩卡茲不長眼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "我再說一遍，薩卡茲。放下武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你以為你拿著武器，我們就要停止反抗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我們不這麼以為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "那你是想被殺死？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我們沒什麼好選的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "攻擊自己的同伴，傷害自己的同胞——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "感染者什麼時候是我們的同胞？我們的同胞只有薩卡茲人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "你們加入整合運動的時候一定不是這麼說的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "背叛，傷害親人，欺騙別人的情感......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "可惡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "當心那些武器！閃開！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "停下，迷迭香......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "啊，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "Raidian剛才發報，凱爾希醫生發給我們最後的消息，是讓我們當心特殊感染者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "它們可能是龍門那些特殊感染者的變體，我們不知道他們會不會進一步傳染其他人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "薩卡茲戰士們，聽我說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "有一些......深度感染了的薩卡茲人，他們正在催化其他感染者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們必須讓其他感染者撤出他們所在的區域......你們的這個街區還有其他倖存的感染者，他們完全是非戰鬥人員！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "即使我們不從這裡通行，我也希望各位分派人手，保證其他感染者的安全！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "不可能的。他們不會這麼做。沒有良心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我們......我們看到了。我們是自己走出來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我們不能退後。如果他們往這裡來......我們得做掉他們。不能讓更多薩卡茲人感染。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "你也可能會被感染。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "無所謂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "你也想變成那樣？那些被法術操控的怪物，你變成那樣也無所謂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "被當做怪物的時候，還少嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......唔，嗯......啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "這座城市已經完了。我們遲早也會變成那個樣子。但是，如果我們消滅了他們，那一切好說，還有人能活下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "只要塔露拉不死，這個城市就會被毀滅的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "如果W殺不掉她，你們就也殺不掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "不站在贏的人這裡，就贏不了；打仗，贏不了就死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "可你要是再傷害別的感染者的話，你在這裡就會死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "死了又怎麼樣呢？變成梅菲斯特的牧群那樣又怎麼樣呢......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "梅菲斯特也是隻怪物。我們殺其他的感染者，是因為我們都是怪物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我們只是不想薩卡茲受更多苦，但說到底，受苦又怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你離開這裡，走到哪，他們會正眼看你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你是感染者，你會不知道你的下場？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你當然知道。你只要走出你這個小小的隊伍，你就會死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你會被人鄙夷，會被人掐著脖子，用皮鞭抽打，被吊死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "或者你被趕出城市，流浪，然後餓死，被野獸咬死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你活不下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "以及，你沒有尊嚴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......你懂什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "戰士......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "告訴我，你不是在為了塔露拉而戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "她......很強。跟著她，更多人活下來的機率更大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我們不介意再多殺幾個。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "滾開。下一次就把你切開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "菲林，如果想從這裡過去，那就殺了我們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我們也不想看著同胞變成那副樣子。你殺得掉我們的話。哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "你們真是最沒救的人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "什麼......什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "那是......什麼聲音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "糟糕......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們所在的街區已經靠近指揮塔用以關閉各個入口的封閉區塊了......指揮塔裡的整合運動可能想要升起整個封閉層，封堵住進入指揮塔的入口！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "時間快來不及了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "薩卡茲。再給你們最後一次機會，不想殘廢的話，就撤走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "......嘻，哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我來吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "卡特斯。哈。你能做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "黑色的線條......？那是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "哈，哈。唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "情況......怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "已經鎮壓了所有失去意識的薩卡茲雇傭兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那，那就好，嗯......有其他感染者......嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "也不知道是好消息還是壞消息。偵察幹員稍微看了一下。這個街區到處都是。而且大多......很慘。應該是被集中關押的被動感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "前往封閉層的......通道......呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "這裡是通向工程通道的，應該能直接進入結構性操控區域，把他們遠端面板駭了，他們一點辦法也沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "另外的那些正面通道，偵察幹員已經發現了至少四處戰場，都是遊擊隊和其他整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "看來戰況很激烈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "遊擊隊雖然強，但那些塔露拉派的整合運動有地利優勢，背後又還有薩卡茲雇傭兵。一時半會打不進去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "沒事，阿米婭。隊長，我們工程小組偷偷摸進去，把整個封閉層的能源供給給切了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "能做到嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "一定能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這太冒險了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "進核心城本來就很冒險了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "這樣沒問題嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "我們去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "那個，那個！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "要當心。嗯......要當心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "我們可是精英幹員迷迭香的隊員。放一萬個心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......把自己的安全放在第一位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "要是真的，阿米婭你就不會用剛才那個法術了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "工程小組，出發，動作快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......他們走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "唔。阿米婭。你不該把體力花在這裡的。那邊應該我來處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......這樣可以少讓迷迭香去造成傷害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "羅德島不希望我這麼做嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不。只是......如果可以的話，我們當然不想這麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "而且我花費的只是體力，迷迭香花費的卻是......意識。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "我無所謂的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可是......我們有所謂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沁",
      "text": "阿米婭！這個小哥想和你說兩句話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......整合運動的，感染者朋友。可以這麼叫你嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "隨便吧。都隨便了。我們......都完了。我是想問你要去哪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "我們......能不能跟你去。我們沒地方可去了。薩卡茲會殺我們，我們也不想再和同胞戰鬥了，遊擊隊也一定會殺了我們的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "為什麼你們會這麼覺得？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "他們難道不是什麼人都可以殺嗎？我聽到他們有時候會說，要殺了其他感染者，就因為他們做錯了些什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......我不清楚。也許他們會這麼做，也許他們不會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我想，要看他們真正的作為，才會得到事實，而不是道聽塗説。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不過我們也不會趕你們去他們那裡的。你們害怕他們，他們做的事情就不會適合你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "所以我想問......想問你們要去哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——我們要去核心指揮塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......你們瘋了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "當我們要阻止這場動亂，就一定要去指揮塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "能麻煩你一件事嗎，感染者朋友？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "殺人就，就免了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不是的。我希望你們......能夠保護這個街區的被動感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "當心，他們可能會恨你們......恨你們那身制服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "那我們怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我覺得有兩種選擇，一是，脫下制服，不再當整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "另一種是，穿著制服，但做該做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "一種簡單，一種很難，不過我想......這應該是你們自己來選的事情。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "指揮塔入口"
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "可恨！這些懦夫打算封閉指揮塔的入口，啟動封閉層！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "還沒打進去嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "薩卡茲雇傭兵正在固守整個封閉區塊的入口！我們不斷遭到其他感染者的騷擾，沒辦法集中注意力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "你再說一遍，你叫我和羅德島合作？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "沒錯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "如果羅德島不值得相信，那麼這座城市裡的任何人你都不用再考慮了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "哪怕是陳腐的規則，他們也會遵守。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "就算他們還欠著大尉的命？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "如果我們都死在這裡，誰來繼承愛國者的精神？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "我們有力量，而羅德島有知識，至少凱爾希非常擅長這些，我認為應該和大尉差不多，你也看到了，連大尉也認同她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "封閉層正在逐漸升抬。做決定吧，我們的時間不多！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "大概就是這樣。我已經和他們這麼說了，所以，阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "我也不是想讓你同意這件事。我只是想這可能會好一些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "讓所有人的損傷都小一些......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "......我不太理解。我只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "沒關係，Guard，你的提議是合理的。只是我們......我們不會像盾衛一樣行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們對感染者沒有處理權，也不會採取那些......懲戒性的手段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "他們是不是快到了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "應該吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島近衛幹員？",
      "text": "......阿米婭，我越來越想不清楚了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "——菲林。我找你們的領袖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "想要報復的話，是該現在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "別以為自己會點法術就可以嘗試激怒我，白毛貓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "我不喜歡你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "因為你發現，比起一個商人的手下，你的行為更像一個感染者的英勇戰士嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "你說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......遊擊隊戰士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你不能威逼我的雇員，你沒有這個權力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "......君王。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "你能號令那些薩卡茲嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......不能，也不可能。不要這麼叫我。我只是羅德島的一份子，和種族，和任意形式的力量，都沒有關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "那簡單了，你和他們也沒有親緣關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "要來我們這裡，和我們一同去摧毀指揮塔嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "為什麼擺出那副警惕的表情？明明是我們做出了讓步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "其他遊擊隊的戰士尚且不知道我的作為，但我相信你必定和他們一樣，也希望解放這座城市裡遭到塔露拉和她醜惡計畫奴役的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "為了重拾感染者的希望，我們給這座城市再添一把火！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "如果你真的是為感染者而戰，你一定會答應。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾衛",
      "text": "回答吧，羅德島！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
