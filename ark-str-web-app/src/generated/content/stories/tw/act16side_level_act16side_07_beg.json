{
  "server": "tw",
  "storyId": "act16side_level_act16side_07_beg",
  "groupId": "act16side",
  "stageId": "act16side_07",
  "title": "光與影",
  "storyCode": "GA-7",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act16side/level_act16side_07_beg.txt",
  "sourceHash": "bcc095aea6579cde69680f487074f71febe5e83554b76387e1604c2fce3499a1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "喜悅的拉特蘭市民",
      "text": "感覺城裡好熱鬧啊，是因為會議要開幕了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠哉的拉特蘭市民",
      "text": "可能是吧，好多地方都在爆炸，看來大家都很興奮嘛。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喜悅的拉特蘭市民",
      "text": "誰啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悠哉的拉特蘭市民",
      "text": "那是......一個執行者，一個萬國信使？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜悅的拉特蘭市民",
      "text": "這是在幹啥，跑酷比賽？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悠哉的拉特蘭市民",
      "text": "這麼熱鬧？你玩不玩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜悅的拉特蘭市民",
      "text": "走唄！看看追不追得上！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "到這裡應該......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "唉，真是難纏啊，費德里科。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你也很難纏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我調查過，你現在應該沒有任務在身......你根本就休假了啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我真是搞不懂了，你咬著我不放做什麼？我什麼時候得罪你了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我的上一項任務，是前往敘拉古將一位當地薩科塔的遺物送回拉特蘭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "他的遺物中有一本筆記，記載了他曾經目睹一名女性薩科塔與薩卡茲接觸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "行吧，那你要查也正常。但是關我什麼事？我是男的哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我追溯各種線索，最終找到這名女性的住址是拉特蘭城司提望區瑟法斯街7-265號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "你到達那裡時，發現她已經去世了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "......你只好繼續調查她的行蹤記錄，然後發現她有一些可疑的出行，而每一次這種可疑的出行之前，她都和我這個萬國信使有過聯絡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "哈哈哈哈哈！有意思，太有意思了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我還想是我在維多利亞露了馬腳？或者哪一次和安多恩聯絡留了痕跡？沒想到竟然是因為好心幫費莉亞的這一點小忙......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "也可謂是命運的一種了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "感慨完了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "唉，費德里科，如果我沒猜錯，你現在應該無法感知我的情緒吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "不能，我也不在乎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "緝捕對象的情緒與我無關。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "不是你緝捕對象的人，他們的情緒你就在乎嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "你和我一樣，我們都多少拒絕了共感......依我看，我們大可以交個朋友啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "其實我覺得，拉特蘭是應該多一點你這樣的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "不要那麼同情心氾濫，單純以法規為準則行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我不反對這個觀點。或許等你的審判結束後，我可以到監獄裡和你交流。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "所以，這就是你的理由，奧倫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "......最麻煩的傢伙出現了。我這樣日行一善的人為什麼會倒楣成這樣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "樞機薇爾麗芙，你好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "你好，執行者費德里科。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "叛徒奧倫的處置接下來移交第七廳，公證所方面可以轉項結案了，你關於此事的報告麻煩抄送第七廳、第一廳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "這是我的認證碼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "確認完畢，程序合規。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "然後，你想繼續休假還是臨時參與迷途者緝捕行動？隨你高興。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "薇爾，你說，有人聽過費德里科說再見嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "別套近乎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "你不是來幫我的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "如果你想把我繩之以法，只要等費德里科幹完他的活兒就行了，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "當然啦，也有可能費德里科確實敵不過我......但你也沒必要把他打發走，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "我只是發現你比我以為的有用一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "費德里科上報之後，我本以為你只是安多恩的幫手......但現在看來，你還不算太廢物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "倍感榮幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "塞茜莉亞的存在對拉特蘭是天然的威脅，你不希望這個威脅被抹去......不是因為你想實踐這個威脅，而是你想用這個威脅做交易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "天上掉下來的一筆錢，大家都不想用，讓我很痛心哪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "其實我對拉特蘭是第一等的忠心，薇爾麗芙你是知道我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我可是最支持教宗閣下理想的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "但你不認同閣下的方式，對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "就比如這場會議，你從心底裡覺得它不會有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "難道你覺得會有用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "薇爾麗芙，你對維多利亞的現狀瞭解多少？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "你不會不明白，我們距離一場戰爭有多麼的近。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "閣下在這個時期，動用佈局數十年的力量，即使撬動了大部分國家，但來的人還是......分量太輕了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "在更平和的年代，或許我們確實可以以此為基礎，慢慢佈局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "但情況並非如此。如果要實現閣下的理想，沒有那麼多時間讓我們溫吞吞地做事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我在維多利亞親眼見證了無數更骯髒的手段，我不會說那是正確的，但如果正確不能達成目的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "告訴我，薇爾麗芙，你寧願成為一個高尚的人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "奧倫，在這種時候，你的話通常沒有這麼多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "你在等什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "其實剛才我改變了主意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "在外走動這麼多年，我越來越不相信薩科塔有多麼獨特。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我們只是能夠互相分享情感，僅此而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "但就在剛才，即便是我，也不得不承認......我感受到了某種古老的、悠久的東西，它真正來自我的內心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "並且，我們獲得了一張牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "各國使者聚首拉特蘭之日，拉特蘭降下神跡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "這意味著什麼，這能夠意味著什麼，我們有很多事可以做，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "有一點，你可能想錯了。你覺得萬國峰會不該誕生在多事之秋......我建議你，不如反過來考慮一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "不過呢，你也有想得不錯的地方。教宗閣下也許有不方便做的事。但於我而言，做兩手準備沒有壞處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "你很好運，奧倫，因為我確實用得著你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "出來吧，帕蒂亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "算你們還有點理智，沒有讓你們的薩卡茲同伴們參與到城內的騷亂活動中......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "如果使節們真的在拉特蘭城裡親眼目睹了“前來破壞萬國峰會的薩卡茲”......這件事情可就沒那麼好收場了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "......你想說什麼，菲亞梅塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "安多恩已經在去往大教堂的路上了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "你知道了什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "沒必要和你彙報，帕蒂亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "但在去找他算帳之前，我得讓你先停下來，別再繼續這些愚蠢又煩人的小動作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "雖然你們可能是還有那麼一絲理智，並不真的要對萬國峰會動手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "但我勸你們不要冒險，事情未必總如我們所願。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "哦......？現在輪到你來“說服”我了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "只是給你一個小小的忠告，如果你不高興聽，我當然不介意......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "菲亞梅塔，告訴我你是怎麼想的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "什麼怎麼想的？我做我的工作......了結我要清算的帳，有什麼複雜的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "......八年前，你為什麼離開戍衛隊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......戍衛隊不能外派，要掛靠到公證所才行。這有什麼好問的？你關心這個？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "帕蒂亞，我不明白你在耿耿於懷些什麼。也許你在我身上寄託了些什麼，我不知道，關於你那些黎博利就應當如何如何的大道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我一點都不在乎，帕蒂亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我信任的隊友背叛了同伴，我的朋友因此受傷、因此被流放，甚至可能從此被叛徒盯上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我已經錯失了一次......我不能讓這件事再度發生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我要保護她們，就這麼簡單。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "如果這不符合你的什麼幻想，我也不會說抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "......噗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......別得意，莫斯提馬。換了你，難道你不會這麼做？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你說得對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "......你說得對，是我的幻想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "幻想又怎樣？幻想也好，理想也罷，如果不是追尋曾經相信的東西，我又怎麼走到今天？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "也許把理想寄託在別人身上是我的天真，但我不後悔，菲亞梅塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "搞不懂你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "所以現在，我也不會後退。就算我做的這些......在你看來只是“愚蠢又煩人”的把戲。這是我的任務，我就會完成到底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "要我停下，就來打倒我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "這樣很好，帕蒂亞。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
