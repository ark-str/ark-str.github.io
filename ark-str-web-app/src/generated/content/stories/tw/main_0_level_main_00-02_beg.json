{
  "server": "tw",
  "storyId": "main_0_level_main_00-02_beg",
  "groupId": "main_0",
  "stageId": "main_00-02",
  "title": "守衛",
  "storyCode": "0-2",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_00-02_beg.txt",
  "sourceHash": "7334ae23dc59a1c3b8b53c6704c2787b7a76c1bab7f4a6668dfb3dd3e45a53a5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......這終歸還是，太超乎我的想像了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "爆炸，騷亂，火光，巷戰......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "難道整個切爾諾伯格，都陷入了這種混亂嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視主持人",
      "text": "在切爾諾伯格軍警的團隊合作與迅速反應之下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視主持人",
      "text": "......情況已經被控制，大部分區域的意外事件已經被鎮壓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視主持人",
      "text": "目前，切爾諾伯格軍警已經包圍了盤踞在瓦舒克大道上的暴徒......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視主持人",
      "text": "可見，這一次無謀的襲擊，將很快結束。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視主持人",
      "text": "請各位不要驚慌，待在屋中，等待切爾諾伯格的又一場勝利......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視主持人",
      "text": "烏薩斯的榮光保佑著陛下和他的人民！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警",
      "text": "可惡，他們，他們......那些武器和裝備，究竟是哪裡來的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "不要畏縮！就算穿上護甲，懦夫依舊是懦夫！不過是些缺乏訓練的暴徒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警",
      "text": "可是，可是他們的數量......！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "我們已經幹掉了我們數量三倍之多的敵人！再幹掉三倍的敵人，戰鬥就結束了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "少口出狂言了，切爾諾伯格的混蛋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "感染者渣滓，也配和我們為敵？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "逮捕你們和你們骯髒的爹媽時就該把你們全部當場處死，而不是流放和苦役！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "你們這些傢伙......！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警",
      "text": "呃......！他們在衝擊防線，前衛沒法再支撐多長時間了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "為了陛下！給我頂住！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警",
      "text": "我，我要......堅持不住了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "退後的人，統統處死！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警",
      "text": "咳......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "我們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "待在這裡別動！我們還不能暴露！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "烏薩斯的軍警隊伍......居然被整合運動壓制住了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "哼......電視上播放的內容，和現實完全不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "切爾諾伯格當局，到了這個時候，還在耍這種手段嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "不過，對於我們來說，事情也同樣在變糟。指望透過更加隱秘的手段離開，已經不現實了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "糟糕的路況和敵人的封鎖......我們已經沒辦法再利用載具分別行動了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "是的，救援小隊只有在具備一定規模時，才能有效消滅盤踞在要道上的整合運動敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "再切分小隊，只會是自取滅亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "這些烏薩斯軍警......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "即使他們的裝備很精良，看起來也很有實力，但整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "無論是人數還是士氣，都占壓倒性的優勢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "和我們對切爾諾伯格進行初步偵察時完全不同......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "在我們潛入時，切爾諾伯格軍警與駐紮部隊的數量、分佈，以及狀態，處在一個非常古怪的狀態。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "只是在那個時候，我們沒辦法確定原因而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "難道整合運動，已經秘密地消滅了切爾諾伯格的大部分防衛力量嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "沒有任何證據可以證明，整合運動的力量真的龐大到如此地步，還能夠謀劃這麼大規模的戰略......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "現在，我怕是只能慶幸，被包圍的是那些軍警，而不是我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "當然，我們也必須提防四周的情況，等到陷入危機，就已經晚了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......博士，快召集各小隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "偵查幹員發現了整合運動，他們馬上就要和我們的救援隊伍接觸了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "——至少，我們現在的優勢，也就只有謹小慎微這一點了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "這，這裡也有武裝力量？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "各小隊，作戰準備！不要給他們反擊的機會！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
