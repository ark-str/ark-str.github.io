{
  "server": "tw",
  "storyId": "act12d0_level_act12d0_07_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_07",
  "title": "有客先來",
  "storyCode": "RI-7",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act12d0/level_act12d0_07_beg.txt",
  "sourceHash": "01b377c5d13a6db8cabdbc53e472ece94a90137548897063b3538b95ce6568f2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "哇啊啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "嘖，又失敗了，不過這次飛的弧度不錯啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "飛哪兒去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "不知道，反正待會兒就跑回來了吧，我們繼續。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "那麼，這根管子該接哪裡呢——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "哈哈，這個接口長的很正點啊，就插你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "喂，能發動嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "不行啊，你到底會不會啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "叫什麼叫，這個引擎我從來沒見過，讓我多試試！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "讓我來試試！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "照我看，這根管子應該插這裡，然後這個按鈕是啥？算了，按了就對了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "你這傢伙才是在亂搞啊！明明應該這樣插才對！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人C",
      "text": "你們兩個蠢貨在幹什麼，油管都沒插上，還是得我來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人C",
      "text": "油管該插哪來著，算了，這個口比較大，就你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人C",
      "text": "喂， 誰來啟動一下試試！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "我回來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "現在的年輕人真是不懂尊敬老人，我被炸出去了也沒有人來找我一下嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "可是大祭司大人你每次都會像現在這樣好好地跑回來啊，大家都習慣了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "哎呀，別廢話了，趕緊啟動試試！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "好好好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大醜",
      "text": "————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "大醜，我的好孩子，該起床了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "噢！大酋長，它終於動了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "這美妙的引擎聲！我從來沒聽過這麼動聽的聲音！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人C",
      "text": "哈哈，我就說還是得我來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "你們是怎麼做到的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "就像你看到的一樣啊，大酋長，它就是這樣動了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "把這根管子插在這裡，然後把那根管子插在那裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人C",
      "text": "就像我們怎麼造出大醜一樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "啊，曾經是一坨廢鐵的大醜，今天居然已經變得這麼像樣了，啊，此情此景，真是讓我想高歌一曲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "但你唱歌很難聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "什麼？！好吧，我還覺得我挺有歌唱天賦的......真遺憾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "哦，對，或許是唱法的問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "嗯，沒錯，一定是這樣，下次我要試試美聲的唱法！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人",
      "text": "大酋長，有人衝進來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "是嘉維爾嗎？我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人",
      "text": "不是！是一個帶著很多武器的怪胎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "前面應該就是祖瑪瑪的部族了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "這傢伙，居然把自己的部族都改造成這樣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "看起來挺厲害啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "咦，裡面怎麼好像很熱鬧的樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "嗯？怎麼就打起來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "可惡的整合運動，居然想要搶走小刻的名字，這可是比蜜餅還要珍貴的東西，小刻絕不原諒你們！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人A",
      "text": "嘎啊啊啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人B",
      "text": "這個怪胎是哪裡來的，好厲害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿達克利斯人C",
      "text": "雖然聽得懂她說的是什麼，但是整合運動是什麼啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "text": "咦，那不是小刻嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "聽動靜，小刻應該已經在裡面鬧起來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "總之，先讓她冷靜下來吧！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "小刻快停手！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
