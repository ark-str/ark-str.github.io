  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "嘶——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "你們是更像我......還是更像他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "Gla-dia。 你很強壯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "情緒。會有我們血親學習的。我們也在傳達許多，我們會試著傳達給你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "Ishar-mla。活著吧。活著會很好。下一次會有其他血親找到你......向你詢問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "我們不太會問問題。我們會學會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "——死了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "你們這些孽種。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "是，上前來。現在輪到你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "這隻垃圾孑然一身。外面那些恐魚也不是它這族的。那麼，只會是你的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "我來把你們撕碎。我來讓你們褻瀆的行徑受罰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "我自己來。是得在這裡把你們這些雜種都解決掉。生命可貴，但留你們的命是浪費資源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "一個重傷的孽種。一個動彈不得的孽種。我會把你們的殘渣抛灑在大地上，讓最低賤的陸地生物吃掉你們的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "殺死你們兩個，輕而易舉——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "不用再裝了。比起海嗣這些垃圾，還是你們這種曾經是人，現在又偽裝成人的最讓人反胃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "（嘶吼）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "你們會死在這裡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是不是把我忘了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
