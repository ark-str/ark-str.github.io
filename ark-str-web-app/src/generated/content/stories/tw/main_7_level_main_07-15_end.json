{
  "server": "tw",
  "storyId": "main_7_level_main_07-15_end",
  "groupId": "main_7",
  "stageId": "main_07-15",
  "title": "感染者之盾-2",
  "storyCode": "7-17",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_07-15_end.txt",
  "sourceHash": "0ec43adf286a683340e51d5d7eb6204b8df9a7a336af1992b9dc402faa287f73",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "第三傳令兵，解除！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "第七傳令兵，成功摧毀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "第八傳令兵，截獲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "Raidian，立刻展開佯攻！用你的法術擴大影響範圍，直接種進他們神經系統裡也可以！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "把所有敵人都拉出去！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "哈，哈......太艱難了。各位都還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "現在還算沒問題......但......真的太激烈了。我再怎麼也沒搞過這種規模的戰鬥......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "這回要是能回得去，我想放假！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好。我一定批准。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但首先......先把這支小隊吃下來！在這之後，提薪、長假、特派，都可以！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "有敵軍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "別被擾亂步調！重整隊形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "東面出口正在激烈交火？別輕舉妄動。我們緩步推過去，不要讓敵人有可乘之機！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "這戰術不像烏薩斯，也不像炎。怎麼回事？這次是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "長年伏擊烏薩斯軍，現在輪到我們被設計？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "沒有發生實質上的戰鬥？......孬種！小看遊擊隊要付出代價！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "小心祭壇！大尉給我們塗上的保護只能減輕影響。他叮囑多次，如果不是必要，別走那裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "傳令兵，快通知其他隊伍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "......沒回音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "迫擊炮手們呢？魔族佬呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊擊隊戰士",
      "text": "等一會兒。這裡有事情不對勁。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "第十二組傳令兵，摧毀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "遊擊隊戰士開始收緊隊伍了！現在是我們通過的最好機會！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不！可能是陷阱！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......嗯......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "明白。迷迭香，我們用法術搜索附近！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我勾不到。敵人......有東西擋住了我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "薩卡茲術師。只有他們有針對迷迭香這類法術的反制手段。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那交給我......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Raidian，還能支撐多久？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......我們會提速。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我......我找到了。是的。在他們依靠的建築物內部，藏有許多狙擊手和術師。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "他們很平靜......有一些激昂。但一點也不狂熱。他們......堅守著據點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......職責。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士說得對，那確實是陷阱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我在你的位置附近了。我來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "能做到嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "能。我不粉碎整棟樓，我只破壞他們在的那層的地形，不然他們會打擾我們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "阿米婭，我可以的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯，迷迭香......我知道你能做到。一定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......阿米婭會佩服我嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "呃，什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我聽煌說，很少能有人讓阿米婭佩服呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "佩服？啊......好像是說尊敬？不，我還不太會炎國的語言。應該是一個意思吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我不知道呀，阿米婭......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......沒事。因為我從一開始就很“佩服”迷迭香了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "迷迭香真的很厲害。我的話，我克制不住......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "失去和孤獨。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不可能像迷迭香這樣能忍受這些。我忍受不了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "阿米婭騙人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "不過我沒什麼關係。阿米婭就算騙人，也是阿米婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "佩服我......我這樣的人，也行嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "就像你說的，迷迭香。就因為迷迭香是迷迭香，我很尊敬你。無論是作為精英幹員的你還是作為朋友的你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "迷迭香，加油。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "嗯，加油。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "還沒出現？他們在等什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "不，不行！絕不允許離開這片區域！只要他們出現，我們就立刻反擊！不能再失去更多聯絡人了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "等等。對面建築物頂端站著的，是敵人？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "......貓？是隻小菲林......？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "傳令兵！快通知術師！敵人在街道另一側的建築物上佈置了術師！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "一定要摧毀她！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "——劍？武器？她從空中......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "啊？漂浮在空中的武器？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "從這裡，劃到那裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "用手......抓住。用劍，劃開。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......就像橫切馬鈴薯。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "就像橫切馬鈴薯。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "博士！到我身邊來！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "整棟樓被......攔腰劃開？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "迷迭香在摧毀遊擊隊的伏擊點。當心落石！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......那究竟是什麼？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我假設你問的是迷迭香的法術。你看了這麼多次，也許現在好向你解釋一些了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "那是被她自己塑造成型的精神狀態。你可以理解成迷迭香擁有“無法被觀察、無法被施加作用的巨大形體”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "無形延伸了她的觸感。她能抓握，擠壓，拈起，以及甩開。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "但相對於她的精神主觀，這種法術實際上缺乏客觀體現。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我們會被它施力，卻不能對它施加力，也只能透過特殊的源石技藝析出“它確實存在”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "難理解也無所謂，這可能不是你的領域。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "在被交予武器之前，迷迭香會造成更大程度的破壞。被移動城邦碾過般的光景，除了廢墟，就只留下廢墟中跪地大哭的幼年女性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "那種情況無論如何都不該再發生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......博士。走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我看到了。指揮部隊馬上就會出現......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "公園廢墟的噴泉。底下應該建有水道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "竟藏身在那樣毫不起眼的地方。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......棲身灰鬃峰七天七夜，連最強盛時的征戰騎士都被他欺騙的那場伏擊戰，或許也是真的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "就是現在，我們走。Dr.{@nickname}，事不宜遲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Raidian，停止交火。找好隱蔽，現在我需要你專注提供通訊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Mantra-2，記錄好我們所有的交談。一字不落。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "第十四組傳令兵，成功截獲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "阿米婭，凱爾希醫生。我準備好了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "（你沒事吧......張嘴！看我！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "（好，你醒著。我還好。沒關係。你藏好，別被找到......我們要靠你重新組織隊伍。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "（我知道。我們來對抗敵人。你別出聲！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "（沒事，我沒受傷。這點小石子，比起烏薩斯人的破城矛，小意思。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "（別驚慌！我能攔下來，你得找機會！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你們！還在看什麼！不敢進攻嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "不管你們是哪國的部隊，怎麼現在不敢強攻了？害怕愛國者的血統和他的巫術嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "有沒有讓你們想起和薩卡茲打仗的時候？比薩卡茲多那麼多人，明明還打得贏，最後卻必定會死傷無數！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "但我們不止這點力氣！你連我們的盾、我們的鎧甲都打不穿！你在永不倒下的愛國者面前，什麼都不是！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "烏薩斯最偉大的戰士......不用槍也不用盾牌，光是踩踏，就能讓你們粉身碎骨。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你們......一文不值！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "我們的戰士很快就會重新聚集在這裡！你們一個都別想跑。整合運動會讓你們吃盡苦頭！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你們這些壓迫者......奴役我們感染者的人！你們必定會被整合運動吞沒的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "整合運動——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......整合運動也許已經背離你們了，先生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "——小女孩？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "......兩個......感染者小女孩？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你們幹什麼？！你們玩什麼把戲！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "讓一讓。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "你身後的那個，我要破壞他背後的裝置。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你以為就因為你長這樣，我就會對你手下留情？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "不要小看愛國者的盾衛！我們是感染者的盾......我站在這裡，就是為了擋住你的攻擊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你敢攻擊感染者，我就會掐死你！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "那我只能用武器說話了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你......你就是剛才那隻貓。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "你的劍......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "傳令兵",
          "text": "（衛士，你快走！去通知其他人！我沒關係！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "（那是你的職責，不是我的！！你必須活下來！！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊擊隊戰士",
          "text": "來啊，你打得穿這面盾嗎？你捅得穿我的護甲嗎？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "阿米婭。我沒辦法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我不會讓他死。但他可能再也站不起來。",
          "portraitKey": null
        }
      ]
