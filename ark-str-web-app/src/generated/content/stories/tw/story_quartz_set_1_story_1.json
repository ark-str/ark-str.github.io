    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾維",
      "text": "爸爸，鎮長怎麼把所有人都叫到這裡來了啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾維",
      "text": "他又想做什麼？！",
