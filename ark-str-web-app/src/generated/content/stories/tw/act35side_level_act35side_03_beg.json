{
  "server": "tw",
  "storyId": "act35side_level_act35side_03_beg",
  "groupId": "act35side",
  "stageId": "act35side_03",
  "title": "相約大巴扎",
  "storyCode": "AS-3",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act35side/level_act35side_03_beg.txt",
  "sourceHash": "0b5e58ca9efc596db7f317c63bf52bbb415cf4e606c3b412afb860286d64ca2c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "緹緹……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "去，撿回來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寶石構裝體",
      "text": "（飛速接球）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寶石構裝體",
      "text": "（飛速撿回）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "嘿嘿嘿，誰是最乖的小可愛啊！嘿嘿，是你啊，小東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "緹緹，別玩了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "以前家裡不准養寵物，我一直都很想養一隻的，看，牠好乖！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "那不是寵物，是博物館裡的文物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你怎麼不管佩佩？你看，她甚至在向博物館的文物發火！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你再給我說一遍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "很抱歉……佩佩小姐，我無法回答，搜尋過記憶後，寶庫的位置仍是模糊一片。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "真的不要攔一下她嗎？感覺那具古屍縮在那裡的樣子有點可憐……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不行，再冥思苦想一下！說不定就回憶起來了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "那都只是無用功……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "為了確保祕密不被輕易透露，分割我記憶的人將有關寶庫位置的資訊打亂，均勻散布在每一顆寶石中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "這樣的寶石有五顆，或許你需要將它們收集齊全，我才能告訴你答案。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "那其餘寶石的位置在哪裡？！這個你總知道吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "（搖頭）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你不知道！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "那支將我擊敗的軍隊，由許多帕夏和王酋集結……他們離去時，寶石也被他們帶走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "找到它們的機會聽起來非常渺茫……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不，也許還有其他的辦法！給我再用你的黃金腦袋想想！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "面對佩佩的步步逼問，高大的祖拜爾慢慢退至牆角。\n從面前這個不及自己胸口高的女孩身上，他感受到莫大的威壓，甚至那副堅硬的金屬膝蓋都只能勉強支撐身體。"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "請不要著急……女士……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "那你就說點有用的啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "寶石之間存在微弱的引力，只要它們在我附近，我就能感知到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你在開什麼玩笑！難道我要帶著你走遍薩爾貢嗎？單這座城市中的寶石數量就是以千萬計的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我剛才好像隱約感知到了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "那還等什麼，現在就走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你看，阿娜特，她甚至想把博物館的文物帶出去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "佩佩，祖拜爾先生是博物館的珍貴文物，我們必須確保他一直處在適宜的儲存環境中，外界環境複雜，不能讓他直接接觸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "你得打消這個念頭，留在這裡研究，千萬不要出去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "明年追加百分之四十的投資？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "加一倍？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "我會讓員工一直盯著你們的，晚點見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "她現在怎麼油鹽不進的……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "祖拜爾先生，雖然討要別人的陪葬品不是什麼禮貌之舉，但我還是想問一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你可以把它借我玩兩天嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寶石構裝體",
      "text": "（飛速轉圈）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "當然可以，女士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "好了，快出來，祖拜爾先生，沒人了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "為什麼你這麼大的個子鑽這麼矮的洞卻絲毫不費力？就好像是液體一樣流出來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我的身體彈性極大，可以輕鬆通過狹窄的縫隙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我還想，要是你鑽不出來，就只好拆牆了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "並不需要這麼麻煩。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "祖拜爾合上眼，搖晃著手中的叉鈴。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "隨著悅耳的陣陣鈴聲響起，女孩眼前的厚重圍牆逐漸瓦解為沙土，落在地上，直至露出一個大洞。\n佩佩睜大眼睛，從洞中來回穿行幾次，又抓起一把地上的沙子。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "有這樣的源石技藝你為什麼不早用？我剛剛鑽洞差點撞到腦袋啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "你沒有提出請求。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "呃……那你趕快把牆補上吧，等一下別人路過看見就不好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "如你所願，女士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鈴聲再度響起，黃沙倒流向空中，片刻後，圍牆上的洞消失了。"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "幾百年前，此處只是一片黃沙……如今高樓林立，一派繁華景象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "城中河流緩緩流淌，一旁還有燈火映襯，讓我回憶起那座建於綠洲中的清泉之城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "清泉之城？我以為那只是一個美麗的傳說，幾百年了，從沒人到達那裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "不，它確實存在，那裡的帕夏暴虐專橫，曾數次挑戰沙阿的威嚴，我只能親自去見見他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "然後呢……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "它便不復存在了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……只是一位帕夏的過錯，沒必要遷怒一整座城市吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "除了將那位帕夏斬首於泉池之中，我什麼也沒做。是被囚禁在那裡的奴隸將整座城市付之一炬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "更何況，如果你親臨當地，必定會為城內的髒污與惡臭瞠目結舌，他們喜歡在水中獻祭活物，但城裡的淨水設施……又不是那麼先進。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "快停下……我腦子裡面有味道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "是啊。我們現在能去看看這裡的河畔風光嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不，別往那邊去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "現在還早，河道那邊還燈火通明，如果讓人發現博物館的文物走上了街，阿娜特一定不會放過我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我知道一個地方，跟我來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "阿娜特館長，我們清點完博物館展品了，請您確認……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "……呃，不好意思，梅捷緹克緹小姐，怎麼是您在這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "阿娜特臨時去接待客人了，我來幫她處理一些文件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "“帕夏石像並非事故損壞，它的寶石眼珠本來就少了一顆！到底誰記的？”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "噗……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "我學得很像吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "不過你們確實把石像記錄錯了。以後做事細心一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "是、是嗎？！讓我看看經手人是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "是吉雅阿和妮雅阿，我記得她們好像是副館長您的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "咳咳……這邊暗闌時代的展覽品被統計了兩次，到時候記得再對一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "這裡是……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "是這座城市裡我最喜歡的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "你喜歡空無一人的街道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "它白天不是這樣的，這裡是米納特哈瑪儀所有商品的集散中心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不僅全國各地的商人會來此交易寶石、毛皮、香料、工藝品……其他國家的人也會出現在這裡，進行大宗貨物貿易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "要問城內什麼地方寶石的數量最多，一定就是這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "在大巴扎最深處，有一間專為寶石而建的交易所，幾乎全城的寶石都會在那裡流通。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "怎麼樣，你感覺到附近有我們要找的寶石了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你有在聽我說話嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "抱歉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我只是對這裡販賣的工藝品感到好奇，在我的記憶中，這種造型的動物雕塑一般用來守衛墳墓，陪伴亡者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "但它們現在似乎被當成工藝品大肆販賣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "還真是……觀賞性陶瓷雕塑，可用作裝飾，裝潢家居，一對二十五第納爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "不論是牆壁上的彩繪，還是刻在各處的象形文字……很多事物都讓我覺得熟悉，但同時卻有著濃濃的異樣感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "或許……再去看看其他地方？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "對了，梅捷緹克緹女士，各個家族都已經派人來問了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "我想請教一下您，我們要怎麼在信函裡向那些在意薩爾貢歷史莊重性的帕夏們解釋這次事故？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "喔，就說是臨時員工的疏忽，我們已經嚴肅處理了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "……處理誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "比如代理館長之類的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "……啊？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "真的嗎，緹緹？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "鑒於你的通行證在昨晚和今早都留下了不該有的訪問紀錄……萬一有人來調查呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "胡說，我的紀錄明明抹得乾乾淨淨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "嗯……你終於承認了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "我不是……不是，我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "放心好了，這些小事我會想辦法遮掩過去，但……在漫灌節前夕發生古屍異變這樣的意外可沒有那麼好糊弄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你打算怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "我想關閉博物館直到風波平息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "這怎麼可以！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "喔，看那座風塔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "這不就是最常見的高塔建築嗎？將高處循環的涼風向下引導，使其通過帶有斜邊的垂直開口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "然後涼爽的空氣便能進入底下的空間，而底下原本炎熱的空氣便能從對邊的開口被推出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我不知道你還了解建築學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "不甚了解，我只是見過發明這種結構的建築師，那是位才華橫溢的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你還是沒有感受到寶石嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "很抱歉……它們並不在附近，或許我可以講一些其他事情給你聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "你難道不好奇那些寶石為何能夠保存人的記憶與意識嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "好吧……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你還真的問到我心坎上了，我之前一直猜想是與長生軍相關的古老薩卡茲巫術。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "在我所生活的那個時代，人們會將人的生命分為“軀”、“名”、“格”三個部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "“軀”即為現實的軀體，“名”即被他人知曉的身分，而“格”則意味著人格閱歷、喜怒哀樂，“格”是一個人的本源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "若想生命不朽，便要將這三個部分一同保存。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "“軀”可以更換為更為堅硬的物質，“名”只要能一直被後人傳頌，便可永保活力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我知道，這便是薩爾貢貴族頭銜的傳承起源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "但只有“格”……它是其中最脆弱的部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "在暗闌時代，人們發現使用特殊的源石迴路將其鐫刻在純淨的寶石上，透過特殊的方法，可以“保存”一部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "正如你胸膛中的寶石……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我只在一些古籍和銘文中見過這樣的稱謂……歷史研究者們認為這只是古人對生命有限的蒙昧認知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "不，那只是曲解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "可能……它真正的奧祕——印刻生命歷程的方式，早已失落在時光之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "或許，還是保存了一些……在這座城市中，依然能找到嵌刻了源石迴路的寶石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "去年有顆寶石，其中的源石迴路只是因為能夠小範圍改變環境溫度便被拍出難以想像的高價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "啊，時光或許會保留下一些東西，但往往是以面目全非的方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……太陽馬上就要升起來了，我們得在博物館開門前回去，走吧，祖拜爾。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "博物館就在前面了，這次我可不想再鑽洞了，用你的源石技藝抄近路好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "慢著，佩佩……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你感受到寶石在附近了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "不……不是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我想看一眼太陽升起的樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我想看一眼就算是時間，也無力改變的事物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "好吧，就一小會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "真是幸運，它依舊明亮，燦爛……光芒四射。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "依舊帶給我溫暖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我問候你，哈拉赫特。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "祖拜爾曾深埋於黃沙之下，與黑暗相伴，沉睡了幾百年。\n面對城市東方升起的太陽，他將眼睛縮成一條窄縫，直視那光焰萬丈的巨輪。\n久違的日光灑在他身上，與他黃金的軀殼相映生輝。\n奪目的光芒讓佩佩覺得有些睜不開眼。"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我們該回去了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你要是喜歡曬太陽，可以再待一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我們還有一些時間，一點點。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "太陽又升起來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "四天，不對，這是第五天了……娜仁圖亞已經失聯五天了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "別走神，阿雅吉！這是精密工作！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "你沒記錯吧？當時我們從博物館出來，通訊器就是掉進這個排水口了，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "我肯定沒記錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "那就怪了，我們每天都來撈，怎麼一直沒撈到？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "撈不到就聯絡不到娜仁圖亞，聯絡不到娜仁圖亞，我們……我們該幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "……我記得娜仁圖亞囑託過，她不在的時候，我們應該自己想辦法搞錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "你說得對，阿雅妮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "我們要搞筆大的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "這樣我們才買得起新通訊器，才能聯絡上老大！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "走吧，我們回博物館繼續打工。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "好……\n欸？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "等等，阿雅吉，好像鉤住東西了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "……怎麼樣，拉恕爾大人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "您看這深邃如夜空的色澤，還有這表面浮現出的層層曲紋，就像岩漿在上面緩緩淌過一樣……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "聽說這是幾十年前從深層黑曜石礦脈中挖出來的，您也知道汐斯塔火山現在的情況，這東西可是稀世之寶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "城內的寶石商人都不敢隨意為它估價，這幾天您又不在寶石交易所，我一直在等您回來……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "很抱歉，這塊寶石上並沒有源石迴路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "恐怕我無法給出很高的收購價格。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "原本停落在監管人手杖上的藍色羽獸飛起來，銜走了那顆黑曜石，輕輕放在了秤上。\n短暫晃動後，秤盤歸於靜止，年輕的監管人看向秤上刻痕的示數。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "三百七十第納爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "怎、怎麼會？有位汐斯塔收藏家出了很高的價格，換算過來大概有三萬七千第納爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "……拉恕爾大人，您會不會看錯了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "如果不信任我，你可以去找那位收藏家交易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "不，不是的，拉恕爾大人，您別誤會……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿懷期待的女人",
      "text": "我不是不信任“監管人的眼睛”與“監管人的秤”，只是在倫蒂尼姆、龍門或者汐斯塔——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "這裡是米納特哈瑪儀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "這裡的璀璨瑰美之物不可勝數。你隨手掬起的沙土，可能都曾是一顆顆燦若星辰的寶石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "正因如此，比起作為裝飾品的價值，我們更看重寶石本身所具備的特殊能力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "一顆沒有源石迴路的黑曜石絕不會有特別的功能，三百七十第納爾是我能給的最高報價了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "從下水道裡撿來的石頭真的會值錢嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "這可是用寶石鋪路的城市。你把它放在陽光下看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "我應該看出來什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "……沒什麼。有點像我牙刷的塑膠握把。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "別難過，阿雅妮。就算不值錢，也能幫上娜仁圖亞的大事業。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "比如，等她回來之後，讓她能連喝一週加了檸檬片與椰棗乾的冰水。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "喂，服務台後面的先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……你在叫我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "嗯嗯，你是這裡的接待員吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "接待員？不——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "哎呀，我們第一次來這地方，來這地方……要做什麼啊？阿雅吉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "來做寶石鑑定，然後把寶石賣個好價錢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "對，就是這樣。請問接待員先生你知道鑑定寶石要去哪裡排隊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……把寶石給我吧，我可以鑑定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "噢，這就是寶石交易所嗎？真厲害，竟然連前台接待員也會鑑定寶石……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "初步看來，這是一顆低淨度的粉藍寶石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "低淨度？聽起來不夠往冰水裡加椰棗乾了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "……別急啊，檸檬片還是有機會的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "能看到清晰的源石迴路。嗯？這……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "怎麼了？源石迴路有什麼問題？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "好了阿雅吉，看他的反應，這顆寶石大概什麼功能也沒有。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……不，有的。它這種源石迴路的結構，應該會讓一些小型動物感到興奮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "讓小型動物感到興奮……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "阿雅妮？你去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "當然是回博物館打工！多搬一個小時箱子就能多拿不少錢呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "忘掉那塊粉藍色的牙刷握把吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉",
      "text": "啊，那我也……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "等等，你們的寶石——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……我本想說我可以出五萬第納爾購買它。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "喵……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "米奧？你怎麼這麼早就回來啦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "（低落）喵嗷……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……是嗎？好吧，沒關係，你已經很努力了。看來想要與他見一面，真不容易啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "對了，米奧，試試這個。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "（用爪子碰了碰粉藍色的寶石）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "（輕嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "（興奮地打呼嚕）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "（陶醉地翻滾）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "哈哈，你喜歡就好……嗯？又有動力了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "好啊，米奧。那你就先去和沃奧一起，找到寶石的位置吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "它們終於都匯聚在這座城市裡了，對嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
