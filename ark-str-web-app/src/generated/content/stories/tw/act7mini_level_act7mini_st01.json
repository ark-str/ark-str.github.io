{
  "server": "tw",
  "storyId": "act7mini_level_act7mini_st01",
  "groupId": "act7mini",
  "stageId": null,
  "title": "粉碎大地",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act7mini/level_act7mini_st01.txt",
  "sourceHash": "2d1c7684acb838830991778a4f3e52026d490a5e9eb3efece75148d15dd297e9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "小心點，慢點走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "沒事......不用扶我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "節省體力，我們還得翻過這個山頭才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我們離開烏薩斯......多遠了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "沒多遠，我們還不算深入荒地......還不夠深入。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "讓我稍微歇一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "沒事，我等你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "東北那座山，翻過去是哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "從那邊過去，應該是卡西米爾人的土地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "不過我們不去那邊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "......這是我第一次離開烏薩斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你會習慣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "烏薩斯已經沒什麼值得留戀的了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "呼......這個地方看起來還行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "天快黑了，就在這裡紮營吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "嗯......我們還剩下多少乾糧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "從倉庫裡帶出來的已經吃掉了一大半，算上流民聚落那裡換來的，大概還有四天左右的分量......不算多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你看著行李，我去找找柴火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這個地方......真是安靜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "安靜不是壞事，其他行人反而值得警惕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "別看我們一路上都沒遇到什麼麻煩，這單純只是運氣好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "強盜團體和土匪，成群的野獸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "荒地對大部分人來說都是個危險致命的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我們真的能找到那個叫“鏽錘”的組織嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "流民聚落的人沒必要騙我們，欺騙我們也沒什麼意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "鏽錘的人在附近有活動，很多人都知道這事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "......他們會接納我們嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "不確定，但是得試試。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "以前在村子裡的時候......當兵的都說“鏽錘”是一群殘暴野蠻，以殺戮為樂的荒地暴徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "人們都這麼說，後來在隊伍裡也有人講過他們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "流言不一定是真的，你忘記了那些貴族老爺是怎麼說我們的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "“貪婪，殘忍的整合運動強盜。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "對於烏薩斯的老爺們來說，只要隨便杜撰幾句謠言，就足以讓他們不喜歡的東西在普通人眼裡變成吃人的妖魔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這都是慣用伎倆了，至少我看到的情況肯定不是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "你以前見過他們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "見過，那還是我當兵時候的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "那年，就是傳說邊境守軍進入卡西米爾境內劫掠村莊那次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "啊......我聽村子裡的人說過這件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "老隊長也說過這件事，好像後來他們都死了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "老隊長還給你講了這些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "他們可是烏薩斯正規軍。一支全副武裝的正規軍小隊，帶著全套戰鬥設備穿過邊境，這事不可能完全掩人耳目。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "劫掠只是高級軍官推卸責任的說辭，說不定那些士兵是真的想挑起一場戰爭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "但是很遺憾，事情沒能如他們所願。我不知在卡西米爾的山林裡發生了什麼......但是他們沒有一個人回來，大概是全軍覆沒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "至於他們越過邊境的真相......人都死了，誰還在乎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "但是他們會死，不完全是因為卡西米爾人......我很清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "所以發生了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "就在那些士兵越過邊境的第四天......有哨兵報告說，一大群荒地人進入了烏薩斯的邊境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "荒地人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "那個時候，我正在邊境守備區的補給站駐紮，當哨兵報告了入侵情況後，軍營裡沒人把這件事當回事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "一大群走投無路的荒地流民雖然不常見，但也不新鮮，尤其是在烏薩斯邊境上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "他們派出一支小隊，準備攔截這群倒楣蛋，給轄區裡的勞工礦場再增加一點勞動力，和他們往常做的事情沒什麼區別。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......然而......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我猜猜，那支小隊沒有回來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "第二天早上，一個滿臉是血的衛兵跑到了我們的營區，不止是小隊全軍覆沒，隔壁的三個哨站也全部失守，只有他活著跑了回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "那時的駐地軍官還沒有現在這麼蠢，他判斷是卡西米爾軍人偽裝成荒地流民襲擊了哨站，於是立刻向上級彙報要求增援。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "直到這個時候我們才發現，源石通訊器的覆蓋範圍內已經沒有能收到求援信號的友軍了，我們孤立無援。然後，就在那天晚上......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "太陽落山之後，周圍的山谷裡傳來了金屬敲打的聲音，刺耳可怖，像是原始的戰鼓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "然後就是人，很多人......上百人......或許是上千人，他們拿著粗製濫造的武器，呼喊著我們根本聽不懂的口號，瘋狂地衝擊我們的營地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "他們看起來是人，但是你感受不到他們作為“人”的部分，我以為他們瘋了，因為就算是身邊的同伴被炮彈炸飛，他們衝鋒的腳步也沒有停下來半分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "那應該是我經歷過最恐怖的衝突，哪怕是後來在整合運動的無數次戰鬥，都比不上那個瘋狂的夜晚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "直到山谷裡出現了第一縷陽光，他們才撤退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "無數屍體堆積在營地周圍，到處都是血跡和源石法術轟炸的痕跡......整整一天，空氣裡都彌漫著令人作嘔的鐵鏽味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "......這也太離譜了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "為什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "如此不計代價地襲擊烏薩斯軍隊？目的是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這就是重點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "幾天後，支援部隊趕到了。那時候我們才知道，附近的兩個感染者礦場被洗劫一空，他們放走了礦場裡的所有人，燒掉了周圍五個倉庫的軍用補給。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "他們把抓到的軍官與礦場負責人大卸八塊，把所有能找到的烏薩斯旗幟和地標撕成碎片......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "鏽錘洗去了烏薩斯的痕跡，他們留下的廢墟裡標識全無。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "最重要的是，那些率先進入卡西米爾境內的倒楣蛋幾乎失去了後方的所有增援。等到烏薩斯軍隊反應過來，已經太晚了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "時至今日，我還是不能理解他們瘋狂的行徑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "但是“以殺戮為樂的荒地惡棍”是不可能為了礦場的可憐人去襲擊烏薩斯軍隊的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "他們不是普通的暴徒，我很確定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "......這個故事真是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "難以置信，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我還是沒辦法判斷......加入他們是不是一個正確的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "連愛國者先生那樣的人都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "別想了，早點睡吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "總會有辦法的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "也許吧......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "到了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這就是那個，我們要找的......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "“第二個山頭繼續向北，在一塊豎立的巨大岩石上。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "沒想到真的在這裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一把鏽跡斑斑的鐵錘倒插在山頂的岩石上，捆束在錘柄上的黑色破布如同旗幟般在風中胡亂飄動。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "“想要加入他們，就去尋找撕裂岩石的鏽錘”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這群人還挺喜歡戲劇性的表達。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "這不是戲劇性，這是一種象徵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "想要活在荒地之上，你就得像這把錘子一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "你不需要尖銳，但是需要堅忍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "看你們這個德行......不像是“普通的過路人”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "我認得你們衣服上的標誌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "“整合運動”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "說吧，為什麼找我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你......你看起來不是感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "我以為......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我們，我們是來加入鏽錘的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "加入？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "孱弱、膽怯、恐懼、無助......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "你們在荒地上畏手畏腳，瑟瑟發抖，像是待宰的畜獸。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "給，撿起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這......這是什麼，鏟子和鎬子......還有捕獸夾？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這是什麼意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "為什麼把這些工具給我們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "你們想加入鏽錘？那就證明你自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "證明你們屬於荒地，證明你們不是離開了柵欄就活不下去的畜獸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "我們都是戰士，我們是荒地的征服者，我們互相照應，我們分享我們的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "但是我們不會照顧孱弱不堪的廢物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "看到那邊的峽谷了嗎？那可是個好地方，是這裡最好的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "峽谷裡有你們需要的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "在這裡存活一個月。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "如果這都做不到，你們還是趁早滾回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "生存？一個月？在這種地方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你*粗口*開什麼玩笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "靠著這些東西能在荒地上活下來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "如果你只是想看著我們死，何必這麼麻煩？直接動手不是更簡單？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "就這麼嘲笑著，看著我們死在荒地上，這是你們的惡趣味嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "還是說，迫害感染者也是你們的樂趣之一？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "我本來以為你們和那些土匪不一樣......你們這群......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "......哈哈哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "感染者？感染者？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "哈哈哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "迫害感染者？哈哈哈哈哈哈哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "布恩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "過來，來看看這個蠢貨。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在鏽錘大漢狂野的笑聲中，一個身形佝僂的男人從山岩後走出，他身上的源石結晶醜陋可怖，男人凌厲的目光透過鬆散的蓬髮，打量著眼前的人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "來來來，布恩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "看到了沒，他們可是你的“感染者同伴”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員布恩",
      "text": "放屁，我沒有這麼弱的同伴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你，你也是整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "在這裡，沒人在乎你是不是感染者，沒人在乎你有什麼特殊的身份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "沒人*粗口*在乎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "男人、女人、老人、孩子、薩卡茲......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "整合運動？落魄貴族？只要你擁抱荒野，隔斷文明的毒血，我們一視同仁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "只要一個月，是嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "依拉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "是的，如果你們能堅持一個月，就代表你們屬於荒原，你們脫離了文明的枷鎖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "屆時，你們就是荒地的一部分，鏽錘的兄弟姐妹們會歡迎你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "好......一言為定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "你的態度不錯，我對你很有信心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "祝你好運，姑娘。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "依拉，你認真的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我們......沒有什麼選擇，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "不，我們還有乾糧，我們可以回去，回去那個遊民聚落，再想想其他辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "不要騙我了！我們根本沒有那麼多補給，你這兩天都沒有吃飯，我都看到了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我們是戰友不是嗎？戰友是要互相照應的，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這些鏽錘的人......他們能夠在這裡活下去......我們說不定也可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "幫個忙，我們先找個地方紮營。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "十五天後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "......它怎麼不動了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "噓！別出聲，它上鉤了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "可我覺得它要跑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "冷靜......等著......等......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "它動了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "還有一點......還有一點......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "抓住了！抓住了！哈哈哈哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "好啊！好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "哈哈哈哈，好啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "依拉，刀子給我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "給，在這裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這裡還真的有馱獸，我這是第一次見到野生的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這一堆肉，回去熏一下，晾在山洞裡，可以保存一段時間......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "至少接下來的很長一段時間可以不用吃風乾沙蟲了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "不知道那個流民聚落還在不在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "怎麼突然想起來這個？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這些肉就算是熏了我們也吃不完，說不定能和那些荒地流民交換一些物資。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "比如換點種子什麼的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "那些苔麥有什麼動靜嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "你啊，你這輩子沒種過地吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......沒有，我出生在城市裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "哼哼，城裡來的小朋友，糧食可是沒那麼容易種出來的，你可要好好學學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "什麼小朋友......你才比我大幾歲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "算了，不說這個了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "那些流民很少停留在一個地方，不過東邊的山底下應該還有幾個聚落，有機會可以找找看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "來吧，把這些帶回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "十三、十四、十五......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "還有半個月......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "希望那些鏽錘人說話算話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "不過現在感覺，有沒有他們都無所謂了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "我越發地覺得，我們能活下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "其實我一直很好奇......為什麼這個峽谷裡會有這樣的山洞，看起來也不像是天然形成的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這裡，應該是一個古老的礦洞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "礦洞？在這種荒無人煙的地方？卡西米爾人挖的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "不一定是卡西米爾人，也不一定是烏薩斯人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "甚至不一定是我們熟悉的任何一個國家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "以前在軍隊裡，有人講過很多古代的故事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "他們說啊，幾百年前，上千年前，那時候烏薩斯還不是烏薩斯，卡西米爾也還不是卡西米爾，很多國家在這片大地上各自崛起、發展、強大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "最終又因為戰爭、天災或者其他什麼原因而覆滅 ，分崩離析。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "天災反覆掃過大地，這些國家存在過的痕跡被一掃而空，能找到的都遺留在地下，就比如這個礦洞，據說很多地方都有類似的古代遺跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "也就是說......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這些地方以前都不是荒地，而是有人居住的城鎮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "也許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "如果......如果我們繼續在這裡生活，像我們這樣的人越來越多，說不定也能組建一個小城鎮什麼的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這個峽谷從南到北，能容納不少人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "到時候我就是鎮長依拉！而你就是副鎮長加勒斯啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "好了，別做白日夢了，來幫我把肉掛起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "好的~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二十九天後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "加勒斯！加勒斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "怎麼了......大清早的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "快看，那些苔麥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這......這是發芽了?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "是啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "好啊！好啊！太好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這地方果然是能種出糧食的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我猜是馱獸骨頭磨成的粉起作用了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "好，我看看......最重要的是什麼來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "是水！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "依靠山溪的那點水是不夠的，我們得想點其他辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "但是這附近......也沒有其他水源了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "只能去東邊山腳下的樹林裡碰碰運氣，那邊有樹，說明有水源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "但是這也太遠了，每天要把水運過來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "遠，但是值得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "如果這些苔麥能正常生長，怎麼都是值得的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "收拾一下東西，我們去林子裡看看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "明明看上去挺近的......沒想到這麼遠......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "回頭得想想辦法，弄個更大的容器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "光靠水袋運水不現實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "等一下......這是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這是腳印嗎？這附近有其他人啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "腳印？什麼腳印？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......不對......這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這是軍靴的腳印！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這個鞋底的痕跡，我不會認錯的，這是烏薩斯軍靴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "為什麼......為什麼烏薩斯的士兵會出現在這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "怎麼辦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......快點回去，收拾一下東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "我們得離開這，這些痕跡......他們沒走多遠，而且這個腳印，至少有二十個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "等等！還有其他辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "如果不生火......他們不一定能發現峽谷裡的山洞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "我們遲早會被發現的，就算不生火，天天躲在山洞裡又能怎麼樣，我們甚至不知道他們會不會離開！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "他們是衝我來的，我知道上校不會這麼輕易放過我的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "不，我不走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "依拉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "逃又能逃到哪去，我已經不想逃跑了，我加入整合運動，就是為了能活得有點自尊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "過去這一個月......過去這一個月的生活確實很艱難，但是艱難又怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "沒有稅官，沒有貴族，林中的獵物，地裡的苔麥，都是我自己的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "這一個月，我活得像個人！而不是個苟且偷生的禽獸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "依拉，你冷靜點，聽我說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "只要我們還活著，我們總是能找到一片屬於我們的地方，如果我們死了就什麼都沒有了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "每一次逃跑......難道每一次逃跑我們都要放棄已經擁有的一切？憑什麼讓那些混帳東西一次又一次地毀掉我的生活！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "最開始是村子裡的人......妹妹......後來是夏拉......老隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "今天，我哪裡都不會去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我今天就是死，也要死在這個峽谷裡，這裡的所有東西，都是我們的心血。這裡就是我的新家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我哪裡都不去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......依拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "留下來，加勒斯，和他們戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "我們是整合運動的戰士，我們不是懦夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你說得對！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "這群天殺的*粗口*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "混帳貴族，洛蒙諾上校......他們都該死......他們都該死！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "好！很好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "你們終於像那麼回事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......是你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "你為什麼......你一直都在附近？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "你們要在荒地上存活一個月，我只是每天來看看你們還有沒有氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "別說這些了，這附近有烏薩斯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "不要那麼激動，聽起來都是些無足輕重的小事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "那......我們合格了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "合格？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "你已經是鏽錘的一員了，姐妹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "還有你，雖然差一點意志崩潰，但是我很高興看到你選擇了正確的路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "妥協和逃跑永無止境，記住這一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "歡迎你，兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘成員",
      "text": "以及，一群愚蠢的獵物正在走向捕獸夾，你們不該錯過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "獵物？什麼獵物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "他們來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "我就知道這個峽谷裡肯定有人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "你可真是讓我們費了不少力氣啊，加勒斯下士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "加勒斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "你這個可恥的逃兵，居然還敢混到軍隊倉庫裡偷竊糧食補給。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "你真的以為在踐踏了烏薩斯軍隊的尊嚴之後，還能這麼大搖大擺地逃走？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "洛蒙諾上校很生氣，他非常生氣，只有把你的腦袋砍下來，才能緩解他的怒火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "準備為你的罪行付出代價，你這個感染者敗類......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "黑衣服的烏薩斯畜生......有二十四頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "呵，你和這些茹毛飲血的野人關係不錯嘛，你該不會覺得幾個荒地土人能拯救你卑賤的性命吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "現在跪下自裁，我保證你死得完整一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "狙擊手，準備......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "蒙面的鏽錘戰士用手中的武器敲打著地面。\n一聲\n兩聲\n三聲\n下一秒，整個峽谷響起刺耳的敲擊聲，凌亂但是響亮。\n戰吼聲，咆哮聲，伴隨著穿過峽谷的寒風，像是這片大地發出的最原始的嘶嚎。\n就在這一刻，加勒斯看到了。\n峽谷兩邊的懸崖上，密密麻麻地站滿了狂野的戰士。\n他們衣衫襤褸，穿戴著廢舊的金屬打造成的粗糙盔甲。\n他們體態扭曲，手持簡陋但是外形可怖的武器。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "隊......隊長！這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "這......這有多少人？？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "怎，怎麼可能！哨兵呢？哨兵去哪了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "你要找的“哨兵”，在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "這......頭盔......武器，你們怎麼可能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "我的兄弟和姐妹，歡迎來到荒地，這是你們加入鏽錘的第一次狩獵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依拉",
      "text": "很高興能和你們一起戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "戰鬥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "姐妹，我們從不“戰鬥”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "隨著越來越多的鏽錘戰士出現，烏薩斯士兵不敢輕舉妄動。當他們開始講話時，這二十四人只得靜待。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "他們——所謂的“國家”和“文明”——從根本上就透著邪惡，那些巨大的移動城市，那些醜陋的鋼鐵造物，那些以惡意鑄造的金屬枷鎖與監牢，就是他們邪惡的罪證。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "他們搶走了一切，他們掠奪了大地的礦物，掠奪了水與土地，將其全部據為己有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "他們宣稱，只有信奉“文明”才能得救，不在他們枷鎖之內的一切都被打上野蠻的印章，他們懼怕真相，而我們把真相還給大地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "他們用力量讓你們恐懼，他們用文明讓你們軟弱，讓你們不得不依賴他們憑空發明出的“秩序”，不得不將自己困在囚籠之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "他們以此來奴役本應自由的你們，以此來吞噬你們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "這片大地理應屬於每一個人，每個人都該像你我一樣，憑藉自己的雙手在荒原中擁有一席之地！荒原自然會淘汰弱者，但追根溯源，又是誰讓世人軟弱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "你們要成為他們的噩夢，成為他們的災難，成為摧毀他們的力量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "有誰能為颶風與地震套上桎梏與絆索？又有誰能將霹靂與閃電囚禁在牢籠之中！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "我們從不戰鬥！我們摧毀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "我們砸碎牢籠，我們摧毀枷鎖，我們把那些被奪走的，重新搶奪回來，那些願意拋棄軟弱的人，都會成為鏽錘的兄弟姐妹。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "——摧毀！摧毀！摧毀！摧毀！摧毀！——\n凌亂但是響亮的金屬敲擊聲蔓延在整個峽谷裡。\n他們嘶吼著，用武器的柄端敲打著大地，金屬與岩石的碰撞如同暗響的雷鳴。\n——摧毀！摧毀！摧毀！摧毀！摧毀！——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "不要怕！不過是一群瘋子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯士兵",
      "text": "擺好陣型！準......準備戰鬥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "他們在顫抖，他們在恐懼我們，我們摧毀，我們狩獵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "拋下文明的枷鎖，我們不再軟弱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士",
      "text": "天災掃過荒原......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽錘戰士們",
      "text": "鏽錘砸向大地！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
