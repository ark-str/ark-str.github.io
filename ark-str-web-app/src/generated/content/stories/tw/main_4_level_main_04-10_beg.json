  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "溫度......急劇下降？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "地面結霜了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "好冷......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "怎麼會......就連那個整合運動的標誌都被......怎麼會......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "火焰熄滅了......烏雲覆蓋住了天空......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "啊啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "別慌張！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "黑鋼幹員潔西卡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "保持陣形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "你在做什麼，霜葉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "她......正在剝奪這片區域的熱量！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "居然能有這麼廣的範圍嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......哈，雪怪們的公主......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "頭一次見到......比我體溫還低的人呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "霜葉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "隕星......其實我......也想要......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "透過迂回來......來給你們創造空間......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "可是......我的身體......已經凍僵了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我的腳......動不了了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "霜葉！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "阿米婭，帶她們突破包圍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "再過不到一分鐘，敵人的指揮官......可能會凍上整個廣場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我的命，可別浪費了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "阿米婭......我們不能......我不能！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我不會丟下霜葉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我是不會——丟下任何人的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我來封鎖敵方小隊的行動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "隕星——去把霜葉救回來！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士！拜託你指揮各個小隊！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不用你說！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（點頭）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "好的！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "想了想，這法術......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "我只用過一次呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "——“凡有血氣......”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "想用冰對抗冰......嗎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "唔......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "舌頭，是不是不聽使喚了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "你......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "雪怪小隊，各自散開就位。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "我的兄弟們......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "去摧毀他們的掩體，凍結他們的血液吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "明白。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "“——我知道你在想什麼。”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "咒語？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "羅德島的兔子......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "黑色的......線？......那是什麼東西？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "是，是什麼法術——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "等，等等，那東西躍過了......掩體？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "別——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "——啊啊啊啊！！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "我，我的身體！好燙......！好燙！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "隕星！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "我知道！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "就拜託你，繼續製造空隙了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "不不......不......好冷......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "呃啊......好疼，好疼呀！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "......喀......別，別再......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "快點！別再讓普通的整合運動同胞們受傷！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "瞭解！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "這種源石技藝......很強大。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "唔......啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "你這傢伙......別想......再前進了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "呃......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜葉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "不會讓你有釋放法術的機會的，小妹妹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "就這樣，稍微睡一會兒吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "等一下再來結束你的痛苦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "可，可惡......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "那麼，你就是阿米婭吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "你的眼神，很棒。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "確實是屬於戰士的眼神。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......抱歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你......為什麼......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......♬",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——♪——♬——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "怎麼回事？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——♬——♬——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......下雪了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "“沉睡啊，沉睡吧，",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "刺蝟玩偶與小熊們”......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "這個怪異的旋律......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "——她在施術！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "“沉進靜靜的黑色......♩",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......我，破爛的人偶與娃娃♬”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "憑空誕生的黑色冰晶，數量又增多了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "潔西卡",
          "text": "冰晶緩緩降落在地面上了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "糟糕，冰晶與地面的接觸面......結冰了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "黑色的冰面......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "隕星",
          "text": "居然......在蔓延？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "冰晶正在迅速侵蝕周邊的地形！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "別讓她唱完！！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "羅德島，全力進攻！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
