        {
          "type": "dialogue",
          "speakerName": "梅爾",
          "text": "這麼說的話......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希爾",
          "text": "讓Thermal-EX突破極限的，不是我們倆身為設計者的意志，也不是技術，而是它自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "我還記得可露希爾小姐對我說的第一句話哦！“你是Thermal-EX，你要有力量！”",
