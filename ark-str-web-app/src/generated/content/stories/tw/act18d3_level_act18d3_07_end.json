{
  "server": "tw",
  "storyId": "act18d3_level_act18d3_07_end",
  "groupId": "act18d3",
  "stageId": "act18d3_07",
  "title": "守護者",
  "storyCode": "SV-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act18d3/level_act18d3_07_end.txt",
  "sourceHash": "1edd541e59bc2d70d4e4c0e7f3e5bc940004292e74f454eea4c3c6fcc328ef96",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "今天拿的夠多了吧？除了我、佩特拉奶奶、長凳的份......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "唔，還有歌手，歌手還會回來的吧？也不能讓她餓肚子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "剩下的......還有多。可以存盒子裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "呃，壁爐叔，你想要嗎？那、那我還是先給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "哇哇，你胳膊上纏著的這些好像是海藻欸！給我吧，我要試試做歌手教我的......呃，海藻酒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "咦，長凳呢？一晃眼又跑哪裡去了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "text": "咿呀......啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "text": "啊......歌......啊啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......別抓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "這個給你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "text": "嗚哇......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......別啃。不能吃。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "text": "木框，木框......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......別叫她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "嗯，你幫我把琴帶給她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "告訴她......不，你沒法告訴她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "這還不是再見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我去問問題。然後，我會自己說。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "長官，我們現在就要在山體上安置爆破物嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "另一方面，我看見一個人進了教堂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "她看起來和我們之前遇見過的那個外來人......很像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "那，長官，她到底是什麼人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "阿戈爾人。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "我聽說了，她和恐魚戰鬥了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......除了我們之外，竟然還有人知道這些怪物，專門和這些怪物戰鬥......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "如果我們炸毀教堂......她會受到波及嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "不解決首惡，將這裡毀滅也無用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "這樣嗎？所以還是得知道，是誰在這裡引起了異象......長官也不能確定嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "你不可問你任務之外的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "另外，雖然我知道長官你不在意，但我還是想說說......這個區塊的承重結構，承受不住我們設計的爆炸的威力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "南半側的城市隨時都可能塌陷，這裡的居民卻還不知道這個消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "繼續說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "我想去疏散他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "哪怕他們在長官你看來是古怪的，有問題的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......應該被淨化的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "判官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "呃......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "說出你的職責！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "“我是為了伊比利亞的存續，為了同伊比利亞的敵人而戰，為了守衛伊比利亞的潔淨與德行，提起了劍與燈！”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "那麼你必須對他們做出判決！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "判決？判處他們......死刑嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "長官，你上一次聽到過去的歌聲，是什麼時候？那些唱片，都已經壞了吧？你的機器也落灰很久了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "我聽見那首歌。我聽見了這個阿戈爾人給他們唱的歌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "那樣的歌，是伊比利亞原本該有的歌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "在殺死他們以前，我想知道真相。就像長官你想揪出幕後主使者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "也許他們還是會變異，到那時候，我一定會親手淨化他們，但現在我想讓他們先去避難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "長官，如果你同意，我立刻就會去進行疏散！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "這就是你的判決？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "長官，我不知道！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "艾麗妮，你不止在對面前的人下判決。你也在對其他人下判決！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "你判決怪物生，就是判決人民死！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "我明白！這樣的判決，我已經下過許多次！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "你的判決，既可能阻絕災難，也可能帶來噩兆！你可能救一人而殺百人，也可能殺百人而救一人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......我明白，長官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "這裡面的利害關係，道德和經文的衝突......我都明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "我問你這個了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "我問你的是，艾麗妮，這種責任是你能承擔得了的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "如果你會帶來痛苦，你就必須也遭受痛苦，而且要比你施加給別人的那些罪惡加起來還要多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "你有這種膽識嗎？你的信仰會在你遭受內心折磨時動搖嗎？如果你失敗了，你造成了惡果，你會因此一蹶不振嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......我能承擔。我不會動搖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "在我加入審判庭的時候，我就已經這麼做了。我能。如果我做錯了，那麼就讓我遭受責罰。我必須做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "長官！我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "可以了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "可以了。現在去履行你的職責，判官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "——是，長官！我立刻就去疏散當地居民！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "還有，長官......經匣裡剩下的爆破物應該夠炸毀整座鹽風城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "所以......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "如有必要，你的判決將被我廢除。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "......是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審判官艾麗妮",
      "text": "那我去了，老師。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "text": "誰？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "您好，大審判官閣下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "啊，看看是誰來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "歡迎你，吟遊歌手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
