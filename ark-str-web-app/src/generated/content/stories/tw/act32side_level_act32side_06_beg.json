{
  "server": "tw",
  "storyId": "act32side_level_act32side_06_beg",
  "groupId": "act32side",
  "stageId": "act32side_06",
  "title": "反藝術運動",
  "storyCode": "CR-6",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act32side/level_act32side_06_beg.txt",
  "sourceHash": "2605897b1cbd293ee5f8eb011d0b4108045924c69b9aaf14bbc8bdc8a2f0ca91",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "社區守衛",
      "text": "特克諾，老爹，外面來了很多士兵，架起了一道鐵絲網，氣勢洶洶地堵在樓底下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "士兵？他們來幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "社區守衛",
      "text": "他們帶著授權文件來，說是要徹查這裡的消防隱患。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "什麼？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "啊……這是士兵該管的嗎？不應該是那些傻頭傻腦的政府機關人員來幹這事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "特克諾，你帶著社區裡的老人和小孩離開這裡，到羅德島的辦公室找埃內斯托。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "其他人抄上傢伙和我走，今天我們也別想睡好覺了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "我、我要留在這裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "你的源石技藝是我們中最好的，把他們交給你我才放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "可是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "特克諾，記住我交代給你的任務，保護好那些人，無論發生什麼，都以這件事為重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "……好，老爹。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "諸位來到這裡到底是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "迪亞茲·岡薩雷斯，我記得你，從辛嘉斯的軍隊退伍後，你來到多索雷斯成為市消防局的一員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "在消防局待了五年，無數次在火場出入，換來的榮譽數都數不清。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "怎麼你現在卻淪落到了這個破爛的地方呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "我是消防員，不論待在哪裡，做的都是防火救災的工作，豪華飯店的火是火，街頭巷尾的火也是火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "只要是火，我都能救，我都會救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "呵……迪亞茲你是內行人，一定會積極配合我們的工作，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "少來這一套，你們打的主意我一清二楚，明面上說是消防檢查，實際上只是為了趕人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "我們也是為了這裡的安全著想，你也不想幾年前的火災重演吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "滾出去，這裡的事情我會操心，輪不到你們來指手畫腳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "唉，不行啊，迪亞茲，這場藝術節表演已經吸引了全市的目光，這裡的事已經不光是你們的事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "我們來這裡，就是為了確保你們的表演不會對大家的生活造成不好的影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "我說了，滾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "哎，老兄你還是不明白形勢啊，既然要檢查，我們怎麼能不做準備呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "辛苦諸位好好查一查了，每一個危險源頭都不要放過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "如果有人敢阻止我們的檢查，就是危害公共安全，直接動手吧，我們不用客氣。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "軍官的手下",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "這群混帳……這群該死的混帳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稚嫩的孩子",
      "text": "特克諾姐姐，我怕……我們到底要去哪裡啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "有壞人進到社區裡來了，這裡不安全，我送你們去埃內斯托先生那裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年邁的老人",
      "text": "那其他人呢……我們就把他們丟在這裡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "……老爹只說讓我看顧好你們……其他的……他會留下來安排。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "他們正在往這邊來，我們得趕緊離開了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "社區電工",
      "text": "你們這是做什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴躁的軍官",
      "text": "排查木偶的每條供電線路，只要有隱患，就統統給我拆個乾淨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "社區電工",
      "text": "我好不容易搭設好的電路啊，你們給我停手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴躁的軍官",
      "text": "滾開吧你，真礙眼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "社區電工",
      "text": "這位軍大人，別這樣，有話我們好好商量，我半年的心血啊……別拆了，求求你們別拆了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴躁的軍官",
      "text": "我管你搭了幾個月，就你這種故意破壞用電安全與擾亂供電秩序的行為，把你送去監獄都不過分。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "社區電工",
      "text": "停手啊——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "社區電工",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "社區電工",
      "text": "別……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍官的手下",
      "text": "*粗口*，哭哭啼啼煩死了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "社區電工",
      "text": "嗚……別……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "惡劣的軍官",
      "text": "這是什麼地方？這些傢伙的老巢？想不到這麼乾淨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍官的手下",
      "text": "報告，那兩尊木偶就在窗外，一開窗戶就能碰到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "惡劣的軍官",
      "text": "看看這兩尊大傢伙，裡面填充了多少保麗龍和木材，這要是著起火來可怎麼得了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "惡劣的軍官",
      "text": "拆，給我拆掉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "作業人員",
      "text": "你們這些混帳，不得好死！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "指揮人員",
      "text": "真是……一群到處撒野的東西……沒有教養……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "指揮人員",
      "text": "呃……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "作業人員",
      "text": "領隊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "惡劣的軍官",
      "text": "都是怎麼做事的？！不是都叫你們把這些傢伙統統帶到外面的空地上去嗎？在那邊拖拖拉拉搞屁啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍官的手下",
      "text": "他帶著這群人一直掙扎個不停，我們很難控制住他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "惡劣的軍官",
      "text": "像剛才那樣狠狠朝他腦袋上來一下啊，你個蠢豬！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "指揮人員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "惡劣的軍官",
      "text": "你看，他現在多老實，對吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "作業人員",
      "text": "畜生，你們這些畜生……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "惡劣的軍官",
      "text": "還不趕快把他們弄走，這麼大兩個木偶，拆起來可得費一番功夫了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "前方不遠處就是出口了，那些傢伙應該不會想到這裡來……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "老人家，這裡地上滑，我扶著你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年邁的老人",
      "text": "唉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稚嫩的孩子",
      "text": "特克諾，我們之後還會回來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "當然，這裡是我們的家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稚嫩的孩子",
      "text": "但那些人來了，又是砸又是拆……等我們回來，又得花好長的時間把家裡復原好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "他們會為此付出代價的，我發誓……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "等回來的時候，我會幫大家把壞掉的東西都復原好，我保證……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年邁的老人",
      "text": "快走吧，離辦事處還有好長一段路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "稚嫩的孩子",
      "text": "奶奶，我也來扶著你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "大家跟好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "眾人",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "特克諾？艾尼？快進來！你們怎麼過來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "埃內斯托在哪裡？我有事情找他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "他之前說有私事，一個人出去了，到現在還沒有回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "只有我和ELA小姐他們在這裡，他們剛幫忙整理好要帶去社區的物資，到底發生什麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "聯合政府的人將社區圍起來了，藉著消防檢查的名義來破壞我們的藝術節表演……老爹叫我帶著他們來這裡先躲躲。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "特克諾……那現在是什麼情況？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "ELA小姐，我……我也不知道，來的路上到處都是他們打砸東西的聲音……很多人都在哭，我不知道他們有沒有受傷……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "IANA",
      "text": "這些混蛋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "我、我現在得趕快回去，我不放心老爹，他嘴上逞強說是要我先走，他來對付那些人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "但……他身體沒有以前好了……年紀大了，嘴巴還不饒人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "我得走了，ELA小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "別哭，特克諾，我們和你一起去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FUZE",
      "text": "我們會幫你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "DOC會留下來幫忙照顧那些老人和孩子，你可以放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "ELA，特克諾帶來的人沒什麼大礙，這裡用不到我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "現在更需要我幫忙的，應該是社區裡的人，我也一起去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "這條通風管道未免也太長了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "IANA",
      "text": "身上全是灰，咳咳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "怎麼樣，DOC，你能下來嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "我的臀部有些寬……好像有些卡住了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "手給我，我拉你下來。\n呃——！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "這些通風管道你們爬很適合，我光進去就很艱難了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "現在這裡被圍得水泄不通，原先逃跑的出路也有人看守，除了和我一起爬管子，再沒有能進來的辦法了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "FUZE，部署情況如何？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FUZE",
      "text": "情況比想像的複雜，在社區外有大量兵力守衛，我無法繼續跟進，但炸彈已經設定完畢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FUZE",
      "text": "隨時可以啟動。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "呼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "窗外是什麼狀況？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "來的士兵人數遠超我想像……大家都被他們帶到外面了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "有人受傷嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "有……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "那有人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "沒有，放心，沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "呼……那就好，那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "IANA",
      "text": "ELA，樓上有狙擊手，我們得先去解決他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ELA",
      "text": "DOC，你和特克諾留在這裡，等我們的訊號再行動。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "你在找什麼，特克諾？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "存儲器，大家的設計原稿都存在裡面了，他們毀了我們的木偶，但只要存儲器還在，遲早有天還能復現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "我來幫你找。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偷懶的軍官",
      "text": "喲，原本我想著上來偷懶抽根煙，沒想到撞上了幾隻偷偷摸摸的鼷獸。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "……他交給我來收拾，你去拿存儲器，就在那邊的櫃子頂層。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偷懶的軍官",
      "text": "小朋友，你還是讓你朋友來吧，就憑你個小身板，怕是連我的汗毛都碰不著！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "唉……你何必惹她呢……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "你媽媽沒有教過你不要小看別人嗎？我非得狠狠揍你一頓不可！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偷懶的軍官",
      "text": "啊，我的腳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "什麼小朋友？個子矮就是小朋友嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偷懶的軍官",
      "text": "我的鼻子！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "小朋友，小你X的朋友！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偷懶的軍官",
      "text": "呃——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "人我收拾掉了，存儲器找到了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "壞消息，櫃子頂層什麼都沒有，存儲器被人拿走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "那……到底是誰？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "別瞪著我了，迪亞茲先生，早說過讓你們配合點，現在這麼多人受傷，多不好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "呸，事到如今你還擺著這副嘴臉給誰看？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "給我把他按住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "嘶……你這傢伙，下手還真狠，要不是帶的人夠多，搞不好今天就得損在你的斧頭下了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "唔……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "告訴你一個壞消息，這次檢查我們發現了多處隱患，尤其是這對木偶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "要是開啟它們，會嚴重影響整個社區的供電，甚至周邊街區也有可能被波及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "所以我特意讓大家都集中在了這裡，給所有人一個警示。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "誰……到底是誰讓你們來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "惦記這裡的人不少……想把我們趕走的人也不少……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "但那些人只會衝著我們來……我們在做什麼，他們根本不會在乎。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "馬特奧",
      "text": "你們去之後，首要的目標是毀掉那兩個木娃娃，記住，一定要當著所有人的面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "馬特奧",
      "text": "斷水、斷電、驅趕，那都是後面要做的事情，現在，我們得惹毛他們，激怒他們，然後……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "馬特奧",
      "text": "讓他們的怒火順著引線燒到該去的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "馬特奧",
      "text": "我會在那裡等你們的好消息。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "除了那個人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "除了那個傢伙……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "既然你心中都有了答案，迪亞茲先生，何必再多問一句呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "人都到齊了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "動手吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "隨著軍官一聲令下，等候在旁的士兵一擁而上，木偶的身體很快被拆解乾淨，製作材料與內部線路散落一地，只剩兩顆頭顱靠在一起。\n她們曾經靈動的眼珠從眼眶中脫落，露出裡面斷裂的線路。\n人群靜默無聲，很多人別開目光，不敢去看。\n只有迪亞茲，他從未偏過頭，眼也不眨地看著眼前的暴行，眼中充滿怒火。"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "哦，對了，我在一個櫃子裡找到了這個……存儲器，我找人看過了，你們的設計原稿在裡面，還有些其他雜七雜八的東西。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迪亞茲",
      "text": "你們今天毀掉的東西已經夠多了，連最後一點都不打算放過嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "我們得杜絕一切隱患，迪亞茲先生。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "靜默的人群中傳出一聲細不可聞的啜泣，倔強如迪亞茲也忍不住垂下眼皮。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "混帳，把東西還給我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "什麼人？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "滾開！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "可惡，竟然被搶走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "你們幹什麼吃的？誰把這丫頭放過來的？把他給我抓住。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "你們……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "老實點，把東西交出來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "放開我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "還想施術？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "嗚……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "把東西給我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "呸，想都不要想。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "還敢踹我？！*粗口*！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "被特克諾一腳踹在臉上，軍官氣急敗壞地將她推倒在地，試圖強行搶奪，但杜林人始終沒有鬆開握緊存儲器的那隻手。\n幾次嘗試無果後，軍官放棄了，他面無表情地站起身，然後抬腳重重踩在特克諾緊握的手上。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一腳又一腳，直到腳下一片血肉模糊。"
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "放不放手？啊，放不放手？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "不……不放……有、有本事……你就、就來拿啊……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "就在軍官再次抬起膝蓋時，一束紅光從樓上遙遙射出，照在他的額間，匯成一個小小的紅點。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "你再踩一下試試？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "如果你想感受三顆不同的子彈同時擊入你的身體，那就再踩一下試試。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "你……你怎麼跑得那麼慢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "因為我從四樓直接跳下來真的會摔死啊，特克諾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特克諾",
      "text": "……哼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "DOC",
      "text": "帶著你的人離開這裡，先生，不然招呼你的就不僅僅是子彈了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "算了，該做的事情也都完成了……沒必要和你們在這裡耗著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帶隊的軍官",
      "text": "通知其他人，我們是時候撤離了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
