{
  "server": "tw",
  "storyId": "main_0_level_main_00-10_beg",
  "groupId": "main_0",
  "stageId": "main_00-10",
  "title": "困境",
  "storyCode": "0-10",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_00-10_beg.txt",
  "sourceHash": "8a02c74ea83b7f9d642344015cd74bbc9935bb0f6aa68d69d8ce2d0b488b433f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "這女人......怎麼回事......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "————你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "壓制切爾諾伯格軍事據點的整合運動像機器一樣高效——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "而你領著的這批各個都像神經錯亂的暴徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "屠殺，縱火，圍獵......只不過是為了滿足你自己殘忍的趣味而已吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "會在這時煽動如此不堪之事的人，不可能策劃出足以擊潰整座城市的方案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "你的指揮官大概是命令你製造混亂，而你，順應著自己低劣的品味肆意妄為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——浮士德。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "把她那張嘴給我打穿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "臨光！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "敵人的狙擊手......很強！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "臨光再被擊中的話，一定會失去防禦能力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "臨光，快退後！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "不行......威力太大了。如果擊中我方小隊，後果不堪設想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "我必須防住他的炮火！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "擋開了浮士德的弩炮？憑盾牌——？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "不可能......不可能！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "再來！！把她......打成碎渣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "居然......右側？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "糟了！快閃開————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "不會讓你得逞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "Ace！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "狙擊幹員，準備！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——目標，南側高台，齊射！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "什麼！你們居然敢，居然敢......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "打中了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "沒那麼容易，這只能......稍稍壓制他而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "沒時間再去瞭解敵人的構成了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "兼具機動性和威力，越拖下去，我們安全擋下他弩彈的機率就越小！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "別給他喘息的機會......！趁著E3小隊狙擊幹員干擾他們的時候，阿米婭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "瞭解！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "E1小隊射手，和我一起，壓制整合運動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "E2小隊，用最大火力，撕開整合運動的防線！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你們這些傢伙......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "為什麼不肯老老實實地去死？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你們的命運，為什麼就不能在這裡落下帷幕？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——————我要把你們，通通————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "臨光，趁現在，快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "E4全體，隨我衝擊敵方陣形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "一次性擊潰前方的阻擋目標！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "狂奔起來！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "射擊！射擊！別讓她靠近......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "啊......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "啊？？她剛剛不是還在二十米之外......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "咕咳——唔啊啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "想要對抗卡西米爾騎士——再去訓練個幾十年再說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "杜賓！跟上我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "瞭解！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
