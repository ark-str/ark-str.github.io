{
  "server": "tw",
  "storyId": "main_4_level_main_04-10_end",
  "groupId": "main_4",
  "stageId": "main_04-10",
  "title": "燈火將熄",
  "storyCode": "4-10",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-10_end.txt",
  "sourceHash": "65a5d403346dc7ee4a04c49e14259c98cd6948340cbdca0473435caa52fe96bc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "隕星！我們擊退了雪怪小隊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "確實，我有點低估你們羅德島了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "下手是不是，還是太輕了些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "（手指已經沒有知覺了......可惡......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......怎麼回事.....？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "寒流......還在凝聚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "這一次......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "你們就不會那麼好運了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不好.......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "她是想吸收整片區域內的寒氣，一口氣爆發出來嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——♩——♬——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——那種法術，會抽乾我們所有人的熱量！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這種規模，比起她剛才所使用的法術，龐大太多了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "就這樣結束吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "就讓純粹無瑕的冰霜，埋葬你們的憤怒吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......唔......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......♩......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "有什麼，阻止了寒冷繼續彙集......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......咕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "是你做的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我不是說過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "不允許你......再前進了嗎......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——拼盡全力用自己的法術，停滯了寒潮的聚流嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......真是個好孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "霜葉用冰刃，分割了氣流嗎......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但是，但是她......支撐不了多久！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "冰刃已經......快要碎裂了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "......已經，夠了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "這是最後的機會了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "阿米婭......就是現在！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "掩護我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "務必小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "立即開火，壓制整合運動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "隕星，去吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "我去了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "什麼？敵人朝著我們......衝過來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "不，她......她是衝向了雪怪小隊的霜星？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "別，別想過去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "射擊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "呃......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "隕星！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "不是直接命中，沒什麼關係！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "還，還能跑嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "可惡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "都說了！你憑什麼靠近雪怪們啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "繼續射擊！不要給她機會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "——糟了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "喀......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "不！！她被......她被擊中了，不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "......小傷而已！這樣就想擋住我，還太早了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這還不夠，我必須......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "（寒氣......顫動了一下？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "等等，寒氣的盡頭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我抓住這種感覺了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "難道說......？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不管怎麼樣，只能試一把了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "擊中它吧——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "大家可都......相信著我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "————？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "羅德島的領袖......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "她的法術，擊碎了我們埋設的源石？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "——起霧了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "果然！那個霜星是靠小隊埋設的源石來創造寒潮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "隕星！！趁現在——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "霜葉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "我......一定......會救你！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "所以，等我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "等我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "醒醒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "呃......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我抓到你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "誰......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "上來！快！抱穩我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......隕......星？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "你逞什麼英雄！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "我有蠢到，會眼睜睜的看著你送命嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "放我下來......我又不是什麼......小動物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "我可是不會鬆手的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "阿米婭！潔西卡！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "大家！快撤退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "隕星，帶霜葉先走，我掩護你們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "我明白了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......咕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "哈，哈......咳哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "霜葉......撐下去......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "別死......可別死了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "別擔心......我的命......還挺硬的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "你也是......阿米婭也是！怎麼一個兩個都是這樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "再怎麼逞強......你們也只是孩子而已啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "還把我當孩子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......那我要是死了，救了你們幾個，不也蠻值得的嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "你——你給我記住了！下次你再這麼做......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "再這麼做......我就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "哈......對不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "跑起來吧，隕星。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "別......回頭......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "走！快走！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "撤出當前區域！優先保護傷患和醫療幹員！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "狙擊小隊......！瞄準整合運動符號，射擊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "破壞它的結構！解體整棟大樓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "爆炸引起的霧氣更濃了——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "趁現在！動作快！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "全員撤出廣場區域！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "逃掉了——嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "你看了多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "幾分鐘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "這些戰士值得稱讚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你的身體狀況不理想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——用不著你來提醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "做你該做的事吧，老頑固。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "我要去追擊羅德島了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "在清剿他們之後，我們才能.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "去......龍門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "呼............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "馬上，就能到達撤退點了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士，我們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "......阿米婭！！和近衛局的通訊，已經連上了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "緊急通訊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "陳長官！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......聽......好......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "陳長官？你聽得清楚嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......龍門...........",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——————什麼？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "——我已經安全了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......整合運動已經攻佔了近衛局的一處重要設施，正在強行打開貧民區與外城的通路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "龍門......危險了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "............"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "W成功吸引了龍門和羅德島的注意，把他們誘進了圈套。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是的。他們逃不回去。浮士德和弑君者已經破壞了一處防禦——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "按照你說的，這會是我們進入龍門的突破口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我們將在每一處要害都設下埋伏，用他們的鮮血染紅從這裡到龍門的整條道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是的，愛國者也快回到切爾諾伯格了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "這樣就萬無一失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "還有什麼吩咐嗎，塔露拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "是時候了————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "讓這腐敗的城市，化為灰燼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
