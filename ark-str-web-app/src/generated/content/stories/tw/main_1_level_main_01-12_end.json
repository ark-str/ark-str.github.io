  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_01-12_end.txt",
  "sourceHash": "51b553b1902f51eeda9dab37ad8d49b8711ed83c76f8e3fccd0aa1490e4e9c57",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "這個感覺......真是讓人感到，十分熟悉啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "阿米婭，是嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "啊，啊，哈哈......是這樣......原來是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我記住了，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我已經得到我想要的了。你們可以走了，快走哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "W......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——你們，要留下來送死？我沒問題哦，你們愛怎麼樣就怎麼樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......撤回下城區。放他們走。塔露拉的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "算了，事情再拖下去，就要變得沒趣了。我很討厭無聊的，就這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我還是挺期待下次再會的哦，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "還有——那個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "什麼——？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "下次，我會從你身上得到真相的，{@Nickname}。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "再見~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......為什麼......她在......做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "整合運動......撤退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "————已經超出了預定時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "立刻......撤回羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......我來......護送後方幹員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "......好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "去吧，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": ".........",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "...............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......頭兒......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "其他人呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "臨光杜賓她們，已經帶著阿米婭和Dr.{@nickname}突破了封鎖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "而留下來斷後的小隊的幹員們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "......都陣亡了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "你我是最後兩個活著的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......我想起來了......那個......那個怪物塔露拉......僅僅一個人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "近衛們竟然眨眼間就像棋子一樣七零八落.......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "那個怪物像捏螞蟻一樣捏碎了重裝幹員......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "別出聲。你傷得很重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "天災......！她就是天災的化身......否則，否則火力小組怎麼可能一瞬間被焚燒成灰......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "明明見識過她的法術，我卻......我不能相信......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "慘叫......唔......嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "少說點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......抱歉......我......我沒法......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "冷靜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "我幫你應急處理了一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......頭兒......你的手......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "至少還有一隻是能用的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......頭兒，逃吧。你的話，一定能夠殺出去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "我們只拖了那個怪物幾分鐘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Dr.{@nickname}和阿米婭安全之前，我不能走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "我得先阻止那個怪物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "頭兒......我也......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "你的命是我廢了一隻手換回來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "哪怕你只能再活一分鐘，我也希望這隻手，至少也值一分鐘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "我去去就回。照顧好自己。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "頭兒......我真......不爭氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "你們一定能實現......大家的願望......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "他們......我......嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "........阿米婭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "............阿米婭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "你怎麼了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......沒，沒什麼。只是剛才突然有些......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......難受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "嗚......嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "難受......嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......別哭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "至少現在......先忍一忍吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "以前有個人這麼對我說過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "眼淚......要留到戰爭結束之後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "現在......還不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "嗯......嗚......嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "走吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......我們回家。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
