{
  "server": "tw",
  "storyId": "story_heidi_set_1_story_1",
  "groupId": "story_heidi_set_1",
  "stageId": null,
  "title": "第一封信",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_heidi_1_1.txt",
  "sourceHash": "b33bfb9c39091d7ef6b09c84bf0a6881c675e7a05535334fc4d9a50f4f9a90d1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "唉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "堅持住，先生……眼下我的急救方法只有這些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "一開始會有點難熬，但還是能勉強走路的，如果薩卡茲再追上來，您也能逃掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "哈哈，謝謝您，女士……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "我不知道您究竟是誰，但我似乎見過您，想必您是戈爾丁女士志同道合的朋友吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "您是想去學校見她嗎？可她已經不在了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我知道。嗯，我早已知道這個消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "請您先保存體力，我們盡快離開這裡。那一隊薩卡茲恐怕很快就會回頭往這個方向搜查。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "現在逃掉了，然後呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……您還記得有一次您替戈爾丁送信，聯繫過一個製醇廠工人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "如果您實在無路可走了，就去找他，順著他那裡的線索往城外逃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……我不能保證您的安全，這條情報線路本身已經失效了。但如果您真的在萬不得已的時候選了這條路，也許最後能找到一部分自救軍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不，您也許會找到一些……類似於醫生的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "原本我想以她的信為契機，讓她見見博士，見見凱爾希……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……總之，快走吧，留在這裡的每分每秒都很危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "那您呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "這一點不必擔心，我有藏身的辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "畢竟，我們雄偉的倫蒂尼姆裡，如今薩卡茲沒有興致清掃的廢墟與瓦礫堆可不少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "自救軍還會回來的，總要有人留在這裡繼續為他們做準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "那真是太好啦，您知道自己前面該往哪裡走，就別再冒著危險照顧我啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "您這是——請別這麼說，先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "我知道，城外是怪物的軍隊，從這裡到城外是無數條可能遭遇薩卡茲的地下通道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "而您剛剛將我救走的地方，那一堆磚瓦，是我的家……哈哈，我也只是想去看看已經不在的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "現在還沒到灰心的時候呢。除了自救軍，我還得到了一些消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "城外雖然有薩卡茲的軍隊，但公爵們也正將兵力正式投入戰場。障礙很快就會被掃清，被薩卡茲封鎖的入城通道也會洞開……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "謝謝您。只是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "您應該很了解戈爾丁女士吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "我只見過她幾次，但我記得每次從她手中拿信的時候，她都會溫和地鼓勵我，就像您剛剛那樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "所以，這些日子我時不時就會想……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "她那樣的人，為什麼會選擇放棄自己的生命？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "女士，為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆市民",
      "text": "我拖著傷腿，已經走得有些累了。您能代替我去那所學校找出一個答案嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "安靜點，里奧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "就算有那位中校先生的偏袒，學校也不再安全了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "——呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "聽到外面的聲音了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "就算只是一塊落石砸下來，這間小小的教室也是抵擋不住的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "可是我不怕！轟隆隆，轟隆隆……我不怕他們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "住嘴，別再說了！戈爾丁女士她——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "啊，您是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "你好，茉莉，我是戈爾丁的朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "我記得您，海蒂女士……但是，抱歉，請您出去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "等等，為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "如果您是想找戈爾丁女士，她最近並不在學校，我也不清楚她現在去了哪裡避難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "我並不是針對您，只是，如您所見，現在人人自危，我不希望任何人給學校的孩子們帶來危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……我嚇到你了嗎？你的樣子很奇怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "啊，有嗎？……不，嚇到我的不是您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "最近發生了這麼多事，怎麼能讓人不擔驚受怕呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "我實在不知道，只有我一個人在，該如何保護這些孩子……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……抱歉，茉莉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "如果薩卡茲真的找上門來，你就直接告訴他們我在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "您真的被盯上了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "請讓我進去躲一會，可以嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "我不知道……您遇到了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我畢竟是戈爾丁的朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "……我想這所學校裡是有地方可以藏身的。戈爾丁女士不希望我隨便告訴外人，但您應該不算外人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "里奧，帶海蒂女士去地下的“倉庫”，好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "我留在這裡等著，如果真有薩卡茲士兵衝進來，我……我會想辦法應付。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……里奧，我可以問你幾個問題嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "你說吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "地下的“倉庫”，是個什麼地方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "你去看了就知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "是與下水道連通的避難所嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "……你到底是什麼人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "教師戈爾丁的一位文學界的朋友，僅此而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不用太驚訝。畢竟，關於這所學校和她教的孩子們，我可是聽她說了不少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不過……茉莉真的沒有告訴過你們，那裡已經不安全了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "從沒聽說。我家，還有好幾家人，都躲在那裡呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（茉莉是真的對自救軍的撤退不知情，還是……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "那麼，最近這段時間，茉莉小姐的表現有沒有什麼奇怪之處？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "奇怪？才沒有，不許你說她壞話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "不過，她是有些我們搞不懂的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "她明明每天都在管東管西，一刻不停地嘮叨，有天卻突然跑過來說什麼自己被薩卡茲抓起來關了好幾天，還好我們沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "那之後她就一直緊張兮兮的，就像做了個噩夢，被嚇壞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（變形者。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（原本我只是推測出，這裡是自救軍情報網洩露的節點之一，因此懷疑茉莉背叛，但現在……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（如果變形者已經找上這裡，那是否就連眼前的男孩，也可能是他的化身？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（不，就算這裡沒有變形者的足跡，我也……還是會懷疑他們所有人。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "喂！你要去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "你沒聽到茉莉小姐是怎麼說的嗎？去地下室，往樓下走。你走錯了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "拜託你，里奧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "可以幫我個忙，讓我一個人在學校裡走走嗎？你就回去告訴茉莉女士，我已經躲好了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "說完，海蒂謹慎地觀察著對方的反應。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "我不相信你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "……除非，你也幫我一個忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "你想做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "我要打倒一個混蛋薩卡茲，但大家都不讓我去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "哼，他憑什麼那麼兇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "那邊巷子裡好心的傑克叔叔，被那個薩卡茲打了，還被關起來了，關了好多天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "我都從窗戶縫裡看到了，傑克叔叔的手腳被擺成了這樣。一直這麼扭著肯定很難受，我要把他放出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "孩子的眼神如此清澈誠懇，海蒂明白，如果他真的是變形者，沒有必要對自己撒下這個謊。\n但她有一瞬間寧可對方不是真正的、戈爾丁的學生，十一歲的男孩。"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不行。去襲擊一個薩卡茲，也只會招來後續一系列的麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "而且……你說的那個傑克叔叔，應該是被打斷了手腳放在那裡，早就……斷氣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我可以向你解釋，薩卡茲究竟對平民犯下了怎樣的暴行，我們又為什麼要忍耐並保全自身，只是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "沒意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "你不去，那就算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……是的，這些解釋沒有意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "我又不傻，我早就猜到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "我只是心裡好難受。傑克叔叔的樣子，我忘不掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（如果戈爾丁在，她一定會為孩子們不得不看到這些而痛心。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（但……她至少教會了孩子們在接觸慘劇時保有痛覺。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……里奧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我其實是來……看看戈爾丁以前生活的地方的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不用掩飾，我已經收到了她的死訊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "她不給你們上課的時候，會待在哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "呃，書店，有陽光的走廊……對了，她有一間辦公室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "不過她不常待在辦公室裡，而且那間辦公室總是鎖著的，她在不在都會上鎖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "嗯……是那邊的那間嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "她告訴過你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "她描述過很多次，透過闔上的百葉窗縫隙能看到的景象。她說窗口有一根折斷的燈柱，之前被薩卡茲毀掉的，沒人敢去挪動它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "好吧。反正上了鎖——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "——有煙霧？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "這是哪裡著火了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "不，不是，是訊號。有薩卡茲跑到“倉庫”附近了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "那是……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "是的，這所學校底下一直是這樣，萊托中校早就知道這一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "有人？不，不可能，誰會到這種地方來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "只是很久以前，學校裡學生很多的時候，我們會把無處堆放的雜物扔到地下。雜物自燃的情況，在學校歷史上也出現過好幾次了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "您聞到的煙味就是這麼來的，我也是覺得空氣有點不對，所以下來看看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（她……在發抖。但她還是獨自擋在了學生面前。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（或許是我多慮了，她的確是無辜的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（……那些薩卡茲不太服從萊托中校，也不相信她說的話。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "（她剛剛偷瞄了一眼那邊。其他人應該是躲在那個方向了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "里奧，你現在能相信我嗎？你想試試換一種方式打倒薩卡茲嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑皮的孩子",
      "text": "……你說吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我們試試把那些薩卡茲引開。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "呼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "多謝您救了大家！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "欸，您受傷了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "沒關係，只是為了從瓦礫和廢鐵裡快速爬過去，流了點血而已。還好，里奧沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "……海蒂女士？！您為什麼要舉起手杖指著我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不用太緊張，我只想問你一個簡單的問題。如果你答對了，我就認為你是值得信任的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "克洛維希婭對你說的第一句話是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "欸？……您說的這個名字，我想不起來，抱歉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "沒事了，茉莉，謝謝你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "抱歉，之前我說自己被盯梢，只是個試探你的謊言……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "現在我相信，你依然如此真誠地愛著學校裡的每一個孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "以及，你的確對這段時間發生的變化毫不知情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "這段時間……您說得對，我的確錯過了很多事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "聽我說。過去在倫蒂尼姆地下活動的那些維多利亞人受到了重創，市民自救軍的網路已經無法觸及任何人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "而且，我來時沒有發現有人盯梢，可是，這裡真的出現了薩卡茲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "恐怕他們對這裡懷疑已久，而萊托中校……話語不再那麼有效力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "這裡已經不再安全了，大家必須想辦法轉移到別的地方去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "可是我們要去哪裡呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "她徒勞地抬起頭，向地下通道漆黑的混凝土壁頂望了一眼。\n她同眼下困在城中的每一個倫蒂尼姆市民一樣，同海蒂自己一樣，舉目茫然。"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……請再堅持一會，茉莉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "有人對我說過，維多利亞人必須保衛自己的家園。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我相信她。相信我們這些人共同努力，也一定能築造和平。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……哈哈，這麼淺薄的說詞，戈爾丁聽到的話，又該嘲笑我了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "她知道自己沒有說服任何人。在一陣戰車碾過街道的隆隆聲裡，二人都深深地低下頭。"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……我原本只是想來看看她生活過的地方，以及，拿走她那裡保存的，一些信件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "您已經知道她……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "戰爭的雜音淹沒了所有言語。\n茉莉走上來，微微踮起腳，給了她一個緊緊的擁抱，輕輕拍了拍她的後背。"
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "您去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "現在要繞過薩卡茲與公爵們的眼線傳遞情報，越來越危險了，是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "你的上一封回信還沒有寄到我手上，你卻先到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "哈哈，是啊……你還是這麼敏銳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "就好像我那封信裡的內容都不必寫了，你本人我也不必見了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "那我會失望的，海蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "除了告訴我外面的動向，各區自救軍及支持者的狀況……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "除了這個時代無法逃避的虛榮與陰謀、威權與暴力，我們已經看不到別的東西了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……怎麼會呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "那就稍微緩口氣，休息一會吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "孩子們正在街道上玩耍，這個時間，不會有人進到教室裡找麻煩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我按照你提供的線索去找了，但還是沒有羅絲的消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "薩迪恩區的局勢更緊張了，之後我必須回到那裡。“羅德島”，這個名字你還記得嗎？他們就快抵達倫蒂尼姆了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……抱歉，我只是下意識就想到了這些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "沒事，你說吧，我明白你肩負的責任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "你曾經說，如果你出了事，也許需要我替你處理一部分情報，我甚至到現在都不確定自己能不能……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不，不，戈爾丁，說些別的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "比如，你想去劇院嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "這個時候？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "以後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "等……這一切都結束，維多利亞迎來和平的時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我們既不是這虛假生活的演員，也不是費盡心思在夾縫中傳遞訊息的作者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我們只是普通的觀眾，只為戲劇本身的起承轉合而動容，不必為舞台外的風聲提心弔膽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "和以前一樣，帶上與劇中人相同的花束——我一直覺得，那些花束都跟你很搭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "……好啊，當然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "只是，這一切都結束，是什麼時候呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "……你為什麼一直都在等待，又為什麼能一直忍受等待呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……戈爾丁。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一封沒有寄出的信，還放在落灰的桌上。\n“海蒂，我要如何讓孩子們擺脫這個暴力的時代？我自己又要如何擺脫這個暴力的時代？”\n“我們這些無力的、手無寸鐵的讀書人啊。”\n“在這理性與人性崩塌的時代，我該做誰的追隨者？”\n以往喜歡開玩笑般用紅筆寫信的教師，在她的最後一封信裡，平靜地用樸素的黑墨水書寫著她的絕望。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "海蒂，有些時候，你的目光是那麼長遠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "我並非不相信你。我相信和平終會到來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "只是，當我也試著看向更長遠的方向，我只會看到下一場戰爭將和平的假象碾碎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "你卻好像總是能看見一顆遙遠的星辰，一個絕不動搖的信念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……你總是這麼一針見血，戈爾丁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我只是……追隨著那位令人尊敬的修士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "是她給了我勇氣。她就像是看過無數場戰爭，無數次毀滅……就像是確信這一切苦難都能被跨越。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "嗯，你一直都是她的追隨者。你能看見她的光芒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "但我看不見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "所以我想，我只好看著眼前，相信此刻。大多數人都是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "相信我們的一堂課和一齣戲劇能教育那些孩子，相信為自救軍所做的小小善行，總好過冷漠自私、無所作為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "我……想要相信當下的生活仍有價值，就像相信你一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……你可以相信我，戈爾丁。你可以把這些寫在信裡，讓我替你記住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈爾丁",
      "text": "那，如果有一天我忘記了，你一定要趕來提醒我，好嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "她早就……託信使給了我一把辦公室的鑰匙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我沒能趕上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "桌邊的手提箱裡還放著許多剪報與信件，只是剩餘的那些，海蒂無需閱讀，因為都是由自己寄出的。\n她來這裡，是為了找回自己過去數年流露的真實心聲。\n她也曾對戈爾丁說過同樣的話：如果我忘記了自己在信中寫下的慟哭與怒吼，請你提醒我。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士A",
      "text": "今天那幾個，抓到了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士B",
      "text": "放過了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士B",
      "text": "反正過不了多久，他們誰都逃不了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士A",
      "text": "哈，你說得對，誰都逃不了。這些可憐蟲根本沒見過什麼叫戰爭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士A",
      "text": "——那是什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "負責夜間巡邏的兩名薩卡茲戰士抬起頭。\n從已成廢墟的高樓頂上，紙片飄搖落下。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士B",
      "text": "寫了不少字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士A",
      "text": "每一張上面的字一樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士B",
      "text": "不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲巡邏戰士A",
      "text": "那就無所謂。有人在扔廢紙罷了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薩卡茲將手中的信紙扔下，隨意踩了兩腳。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "您把這些信都扔掉，多可惜啊……多危險啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "沒關係，我們通訊一向不留落款。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "而且，那只是我寫給戈爾丁的信……一些隨筆而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "她總是開玩笑地跟我說，既然我這一生都要用三流小說家的身份，來掩護自己收集情報的工作……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "那我想要得到自己應有的名聲，恐怕就要等到死後，這些私人信件得以公開的時候了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "現在這樣……又怎麼不是一種公開呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我理解她的選擇，理解她無法承受的這個時代，是如何充斥著失望、背離與仇恨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "不願再起身的受傷戰友，不得不彼此猜忌的朋友，在人生裡最先品嚐到痛苦與敵意的孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "這樣的故事是如何無處不在，又無法言說。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "惆悵，悲哀，憤怒，厭恨，尖銳的批判與諷刺，滿懷眷戀的描繪與追憶。\n她忍耐的一切，她等待的一切。\n信紙鋪陳在黑暗的街道上。\n她無聲地對這座城市發出怒吼。\n但她自己也很清楚，沒有人會從滿是機油的街道上拾起它們，分辨字跡。\n四下一片寂靜，倫蒂尼姆給予她的唯一回聲，是不遠處軍工廠日夜不息的轟鳴。"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……而我所搬弄的文字，又是多麼無力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "再也不會有回信了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "可是，我還是感到有些可惜……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "戈爾丁女士為孩子們排演戲劇的時候，常常提到您在信中對劇本提出的建議，它們都很切中要害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "海蒂女士，您……以後還會寫下這樣屬於您自己的思緒嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "所有的紙片都落回地面。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
