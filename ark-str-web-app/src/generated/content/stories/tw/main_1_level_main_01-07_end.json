{
  "server": "tw",
  "storyId": "main_1_level_main_01-07_end",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "暴君",
  "storyCode": "1-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_01-07_end.txt",
  "sourceHash": "c6c7ccf2cc71c23fa384c29174cb78115f431be5b4dbb4e36f8f2f758ff3497a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "哈，哈，哈.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "成功了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "我們不僅擊退了整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "災勢也在以肉眼可見的程度衰弱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "情況太糟糕了......各位還是要多加小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "天災......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "原本的街道都被倒塌的廢墟掩蓋，被摧毀的建築，形成了障礙物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "源石，已經開始瘋長了嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "明明到了最後關頭，所有事情卻都在阻撓我們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "如果我們能——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "什麼來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "整合運動？他們追上來了？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "那麼多的......整合運動......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "他們......不是追上來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "他們是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "——從各個地方湧了出來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "廣場，坡道，建築......四處的廢墟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這個數量，呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "難怪除了那些真的要被砸成泥漿的人以外，他們一點都不懼怕天災。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "哪怕天災，說多些.......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "已經消滅了他們一半人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "剩下的也夠把我們在這裡淹死十幾次了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "別停下腳步！繼續順著撤退路線行動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "在開闊地帶停下等於找死！至少到達廣場出口處之後再整頓隊形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "臨光......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "必須戰鬥。破開突圍口以後，趁對方隊伍混亂立刻脫離。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "能行嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "希望渺茫，但我們沒有別的辦法。只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "即使是數十倍於自己數量的敵人，如果只是些暴徒，羅德島依然有機會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "無需驚慌！備戰姿態！防禦陣形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這樣的數量，如果要拿下切爾諾伯格，也許......真的有可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "實在......太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "整合運動究竟......是從哪裡糾集起這麼多感染者的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這種包圍網......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "整合運動是真的，很看得起我們啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "大，大群整合運動敵人......包圍了廣場！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "敵人停止了行動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "有敵人一名，正在靠近羅德島的陣線！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "為什麼，那個人會一個人，走向我們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "難道敵人派出了使者？不可能......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "她......她是資料上，整合運動的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "她身上，有某種氣味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......臨光......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "我不清楚，但是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "那是......鋼鐵和硫磺的味道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "有什麼東西在焚燒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "如果是火焰的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "羅德島的各位幹員......最高警戒狀態。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......她就是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "整合運動的暴君......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......塔露拉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "大概......是能燒盡整片大地的火焰吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
