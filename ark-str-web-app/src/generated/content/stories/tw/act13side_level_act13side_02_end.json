{
  "server": "tw",
  "storyId": "act13side_level_act13side_02_end",
  "groupId": "act13side",
  "stageId": "act13side_02",
  "title": "垂死的刺",
  "storyCode": "NL-2",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act13side/level_act13side_02_end.txt",
  "sourceHash": "8cf0c3488733127d886768ca855dcbb100cacd146fd91467778cd69a951c6be5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 2-2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......艾沃娜，你回來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "你臉色很差......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......當然的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "沒能把那些該死騎士的甲胄全部打爛......嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......不是你的錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "他沒有把身體情況告訴我們任何人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "如果是這種程度的感染，幾個月前他就不該再繼續活動了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "他該想辦法離開卡西米爾，按自己的想法，安排好自己最後的時日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "奧爾默·英格拉......這就是卡瓦萊利亞基的騎士貴族，暴虐、無知、草菅人命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "我就應該在賽場上打斷他的四肢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......也不是你的錯，灰毫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "嘁，明明有我跟著......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......他最後......說了什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你不會想知道的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我希望知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......好吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "感染者死不瞑目......並不是一件稀罕事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "我們會記住他的憤怒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "索娜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......他叫傑米。是先成為競技騎士，再因為意外變成感染者的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "離過婚，有個可愛的小女兒。瞞報病情多半是為了能繼續作為騎士參賽吧......他需要錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "但為了瞞報病情......他要給騎士協會更多的錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "我在他的房間裡發現了他與協會成員的信件，那是個無底洞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "他是個很樂觀的人，樂觀到我們甚至察覺不到他在背負這樣的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "就算是感染了礦石病，和妻子孩子都分道揚鑣，他也在幫助別人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你們還記得嗎？他每個清晨都會去幫忙照顧那些孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "他不該這麼毫無尊嚴地死去，這和我們建立騎士團的初衷相悖，可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "可是我在想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "這樣一個對生活滿懷熱情的人，在最後的最後袒露的是刻骨銘心的仇恨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "如果是這樣——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......索娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "你最近想的事情太多了，別這麼一根筋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......這些彎彎繞繞的思考工作就交給你們了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "我要變得更強，強到可以捏碎那些道貌岸然的傢伙，強到可以靠自己開闢出一條路來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "血騎士是個不錯的榜樣，既然卡西米爾如今還願意認同“騎士”......我們就該這麼走下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "別想太多，索娜，那只會讓你的速度變慢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......索娜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "好啦好啦，我知道，我們得加緊和瑟奇亞克確定——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "風......風的響動有變化，雖然只是一瞬間......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "有什麼人在盯著這裡，而且......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......無胄盟？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "氣息隱藏得很好......但如果是敵人的話早就該襲擊我們了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "——出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "這裡是感染者的地盤，普通人可不會隨便跑到這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "否則的話——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "托蘭",
      "text": "好，好，好，別那麼大聲，唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "托蘭",
      "text": "感染者騎士，真是沒想過的一道風景。十幾年沒有靠近過卡瓦萊利亞基，騎士老爺和商人們也真是異想天開......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......你是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "托蘭",
      "text": "別誤會，我只是找某些人，湊巧路過這裡，不過嘛，相逢即是緣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "托蘭",
      "text": "......我想我們應該有些共同話題，各位感染者，例如......無胄盟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "很遺憾，今天我們遭遇了一些不幸的事情，如果真想聊天的話，改日再說吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "托蘭",
      "text": "是嗎？這還真是不湊巧，令人遺憾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "托蘭",
      "text": "那我只好去別的地方再試試運氣啦，畢竟難得來一趟大騎士領。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "托蘭",
      "text": "那麼就不打擾各位啦......但也許我們很快就會再見的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我找到那些帶走瑟奇亞克的騎士了......逃走的遠牙騎士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "和紅松騎士團廝混在一起，當然，感染者騎士具有先天的凝聚力——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "——你那邊是什麼聲音？又在酒吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好，調查夢魘的背景，不錯的藉口。關於感染者的命令什麼時候下達？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "瑟奇亞克的事情不就是因為“上面還在開會決定”才變成這樣的嗎？都派過無人機轟炸了，還有什麼意義......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "哎呀......就算你和我說，但現在怎麼說也是在特錦賽期間，總不能這麼輕率地決定吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "嗯，嗯嗯，我真的不是在偷懶，信我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "真的——啊，老闆 ，有炸薯條嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "稍等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "好，喂？莫妮克，你還在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "......哎呀，掛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "炸薯條，先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "啊，好，多謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "嗯......！是誰想出切片土豆再油炸這種天才般的想法的。現代社會因他而美麗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "說起來，好像之前嶄露頭角的那位瑪莉婭·臨光，還有鞭刃騎士也會經常光臨這裡，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "如果你是想來要個簽名，那可能要碰碰運氣了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "畢竟，這家酒吧只能見到一些退役的老傢伙罷了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "那傢伙是誰啊，難道是無胄盟的探子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "天知道，他沒動手，我們總不能上去搜身......喂，他是不是在打量你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "唔......別管他得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "昨晚開始我眼皮就跳得厲害......總感覺有什麼大事要發生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "你終於也到了失眠的年紀啦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "啊？我精神得很，你懂什麼！當年我就是靠眼皮跳預知到了炮兵師的襲擊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "你能有什麼大事？早上擠牙膏擠成橄欖油了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "——唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "馬丁。我現在都能感覺到那股氣場......是個大人物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "我可從來沒有過這麼奇怪的預感......但願不是來惹事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "（這就來了，速度還挺快......嗯，靜觀其變好了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "——\n——（古老的語言）年輕的獵人，踏上天途♪\n——（古老的語言）從夢裡出發，去往黃金的彼岸♪"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "（這個語言......！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "......怎麼回事，現在人來趟酒吧都要自己唱登場曲？那還要點唱機做什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "難道我這個偏僻酒吧真的沾了臨光家的光？但我可沒有見過你這樣的騎士......老弗？你怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "我......我不知道，就是突然心臟有點......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（古老的語言）......巴特巴雅爾，同胞，末裔之人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（古老的語言）你為什麼在這種地方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "你......！你知道這個名字？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沉默的騎士環顧四周，視線所及，燈光都在試圖避讓。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "回答我，你為什麼知道那個名字......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "喂老弗，這是你熟人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "要喝點什麼嗎？客人？如果沒什麼事的話，這裡可能不太歡迎手提兵器的騎士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（古老的語言）......遺憾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "等等，別急著走——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "科瓦爾，瑪莉婭要繼續借用你的工坊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "——呃。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "佐、佐菲婭姐姐，慢點......呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "怎麼突、突然停下，怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......你是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "......逐魘騎士？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "嶄露頭角的本屆新星來這裡做什麼？是來打探瑪莉婭和瑪嘉烈的情報的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "如果是這樣——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "聒噪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "你......你突然做什麼！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......天馬......軟弱的種族。只有流淌著黃金之血的天馬才配稱得上對手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "但在天馬退位之後，這所謂的“騎士之國”......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "草原在衰弱，你們難道都視而不見嗎，庫蘭塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "現在的卡西米爾，你們這些人，都被稱為騎士嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "都會在那座......浮誇的競技場上，比拼武藝嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "我很難在你做出剛才的行為後，還老老實實和你對話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "別動......小子，我還有話問你，我可不想現在射穿你的腦袋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "不錯......還有戰鬥的意志。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "那麼，你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "欸，我、我？我就是個路過的騎士粉絲，您高抬貴手，當我不存在就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "我也什麼都不會做，什麼都不會，嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "（顫鐵馬丁，善用戰錘，弗格瓦爾德，征戰騎士的射手，鞭刃騎士，受了傷之後不算什麼威脅......瑪莉婭，暫時沒有關注的必要。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "（但這些其實不關鍵......嗯......夢魘果然是來找弗格瓦爾德的......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅伊",
      "text": "（好了......接下來......該怎麼做呢。耀騎士會來嗎？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......這裡不值得停留，與你們為伍，令人坐立難安。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "你小子，看不起誰呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）巴特巴雅爾，你曾征戰沙場，親臨戰爭，卻只是勉強衛護了家園。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "（他在說啥！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "戰爭......你是征戰騎士？你認識我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）不，我並不是“騎士”，這太過可笑，只不過，戰爭是你唯一不曾令先祖蒙羞的行徑，末裔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）即使是在這裡......鋼筋水泥的城市，陰雨穿過霓虹，末裔，我希望你還記得草原的呼吸與可汗許下的誓言......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "......可汗？啊......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "你在說什麼陳芝麻爛穀子的事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）本想......在再次啟程之前，在這所謂的騎士之國尋找殘存的同胞，如今看來，是我異想天開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）無妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）卡西米爾的懦弱是對可汗功績的不敬，這種行為必須有人去糾正。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "站住！你還沒有回答我的問題！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......嗯，雖然如今已泯然眾人，但至少也算半個同胞......我該回答你的問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......你的名字是一個老兵告訴我的，而他，已經年老體衰，甚至無法奔跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "我尋找著卡西米爾內的每一個同胞，無論關係多麼微弱，只是在尋找同胞而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "哈？同胞？在卡西米爾嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......已經與你無關了，卡西米爾人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "站住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "逐魘騎士......早聽說是個行事乖張的新人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "可是被你這麼刀劍相向，我們怎麼可能會輕易放你走啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "把頭盔摘下來談話如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......“逐魘”......？啊，是那群城市的奴隸為我擅自頒發的名號嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "可笑......騎士需要如此在乎名號嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "只因其與生俱來的信仰和對掌握命運的渴望，才催促著騎士踏上旅途。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "你這樣尋釁滋事，騎士協會可不會善罷甘休，你想被剝奪特錦賽資格嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "......如果......卡西米爾只剩下你這樣無趣的騎士......那我確實在白費力氣，無用的資格被剝奪又何妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "不過，你身邊這匹天馬......似乎，和我想找的某個人很像......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......！你是說......姐姐......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "——你找耀騎士想做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "做什麼......？被卡西米爾奉為大騎士的各位冠軍——如果說當今的卡西米爾還能有什麼值得征服的對手，恐怕就在他們之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "當然......也可能，他們全都令人失望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "......瘋了吧你，你是來找架打的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）瘋了......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）對......選擇活在當下的卡西米爾人，時常這麼和我說......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "（古老的語言）......所以我們不再是同胞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "站住！你想就這麼若無其事地離開嗎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "既然此行無果，那也不必久留......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逐魘騎士",
      "text": "再會，末裔。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "......嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "這傢伙是怎麼回事，神神叨叨的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "但願瑪嘉烈別在賽場上見到他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "看上去，他就是來看你一眼的？是你老鄉嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "他......是夢魘？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "......啊？現在還有活著的夢魘嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "我以為這些人要嘛活在傳說裡，要嘛躲在薩爾貢之類的地方......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "所以呢？你爺爺的爺爺的血親突然來找你有什麼意義？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "............是他在呼喚我們。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "......嘖。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "哦！哦！眼前這幅光景，似乎不是第一次出現！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "“左手”泰特斯·白楊，這次能不能帶領鋒盔騎士團殺出重圍，重新回到十六豪強之位！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "此乃復仇之戰！觀眾們！熱血沸騰吧！曾多次止步十六強的“左手”泰特斯·白楊，是否能在今天超越自我！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "只因為——他的對手！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "在白楊家族漫長的騎士歷史上，只那一次！只那一人！帶給了他巨大的恥辱！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "該死......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "......這些年，你到底在做什麼......！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "（為什麼......見鬼......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "（接下來要怎麼打？拉開距離？不，她......嘁......她為什麼會用劍槍這類東西......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "（最重要的是......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "（......她竟然......讓我感到......壓迫？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "泰特斯·白楊閉起了眼。\n他本以為這是一場激昂的復仇，一場醞釀許久的，證明價值的機會。\n但所有的惱怒、願景與激情，此刻已經煙消雲散。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "他不得不承認，這不是一場對抗。\n只是一次挑戰。\n邁向巔峰的挑戰。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "（在成為鋒盔騎士團的門面之後，我有多久沒有這種感覺了......？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "挑戰，前進，攀上更高的領域。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "哈......呵呵，我都想笑了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "耀騎士......你真是當年那個你嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "把我逼到這個地步......你卻一點不感到自豪，一點也不雀躍？當年那個意氣風發的你去哪了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "看你現在，你平靜得令人作嘔——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "我沒有小看你的意思，泰特斯，從來沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "但是你已經迷失了方向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "在那場混亂的圍獵中，至少，站到最後的你，和當初只靠一隻手臂殺出重圍的你，只是純粹地想要獲勝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "哈哈......現在你都學會說教了嗎......？難道流放之後的日子，讓你變得好為人師了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......泰特斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "為什麼要讓那些商標束縛住你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "——耀騎士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "你不是總把那些腐朽的傳統掛在嘴邊嗎......讓我們，用最古老的方式來決一勝負......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "一次衝刺，一次交鋒，一次全力以赴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左手騎士",
      "text": "我要......踐踏你的一切！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "左手騎士擺好了架勢！是打算用最後的殺招定勝負嗎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "耀騎士這邊——耀騎士這邊也緩緩舉起了那柄奇特的武器——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "究竟在碰撞之後誰才是站到最後的勝利者，還在等什麼，觀眾們！用你們的行動證明你們對騎士的支持吧——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的遊客A",
      "text": "燭騎士德羅斯特小姐？她來這裡幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的遊客B",
      "text": "不會是在等什麼人吧......別愣著啦，快偷偷拍一張......說不定能撞見什麼重大緋聞呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "競技場員工",
      "text": "燭騎士閣下，很抱歉，有失遠迎，您是來找誰的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "沒關係，是我突然冒昧行動，沒有知會你們......我只是想看一看耀騎士的身姿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "比賽，快結束了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "競技場員工",
      "text": "......是的，左手騎士泰特斯·白楊閣下，在十分鐘前輸給了耀騎士。雖然泰特斯閣下實力強勁，不過首輪跌入敗者組，還是不太樂觀......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "競技場員工",
      "text": "......您真就只是來見耀騎士一面的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "我想看看，想看看現在的她，和騎士們口口相傳的那個她，究竟有多大差別。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "人流全部湧過去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "競技場員工",
      "text": "是、是的，其實耀騎士正式回歸賽場之後，很少會配合我們的營運活動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "競技場員工",
      "text": "她經常一言不發地就離開競技場，安排好的會面和各種宣傳事項也會被拒絕，真令人頭疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "競技場員工",
      "text": "不過，今天好像圍繞著耀騎士的記者更多了，這是怎麼了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "啊......抱歉，請讓一讓......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激動的記者",
      "text": "請問瑪嘉烈小姐，您如何看待感染者騎士在賽場上身亡的事件？您會因此受到影響嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搶先的記者",
      "text": "耀騎士閣下，關於騎士協會最近的舉措，您有什麼要說的嗎？感染與否真的會成為不公平的因素？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激動的記者",
      "text": "啊，瑪嘉烈小姐，方便透露一下您的感染情況嗎？騎士協會對此採取保密措施，是否是對觀眾與其他騎士的不負責任呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激動的記者",
      "text": "還有人目睹您似乎與幾位薩卡茲來往密切，她們是您的什麼人？請您做出解釋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搶先的記者",
      "text": "耀騎士閣下！請您回應——您是否有意成為感染者騎士的精神領袖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搶先的記者",
      "text": "——您是否會成為第二個血騎士——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......我不會回答你們的問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激動的記者",
      "text": "您是默認了嗎？那您和那些薩卡茲的關係——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "幸會，臨光閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......您是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激動的記者",
      "text": "......燭騎士德羅斯特！燭騎士在賽場外等著耀騎士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "搶先的記者",
      "text": "快把賽程表給我......沒錯，她們之後會在賽場上相遇......喂，快拍下來！拍下來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "我們，能借一步聊聊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "（您也不想被媒體繼續糾纏了吧？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "啊......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......我明白了，我們換個地方吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "競技場員工",
      "text": "啊，抱歉，請不要靠太近——媒體問答會在之後另尋時間，請各位稍安勿躁！稍安勿躁！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......那個......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "真辛苦啊，卡西米爾的傳奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "因為您的流放，反而為“耀騎士”蒙上了許多神秘色彩......聖光環繞的騎士，威嚴的金色天馬，如流星般歸來的英雄......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "今天靠近一看，您還很年輕，也會為突如其來的狀況困擾......瑪嘉烈·臨光，是這樣一個活生生的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......無論如何，都感謝您剛才的幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "您是一名騎士吧，不知道您是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......已經挺久沒有人問我是誰了，比起我是誰，他們更在意的是他們希望我是誰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "呃，很抱歉，我回到卡西米爾的時間不長......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......呵呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "您覺得......我會因為您不認識我，而惱羞成怒嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "看得出，您與眾不同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "哎呀，感謝您的誇獎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "我也很高興認識這樣的耀騎士，我的名字是薇薇安娜·德羅斯特。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "或者，您也可以稱呼我為燭騎士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "燭騎士......不，德羅斯特小姐，再次感謝您今天的幫助，您找我是有什麼事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "我們不久後會在賽場上相見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "您是一名感染者，是一名一度遭到流放的人......別誤會，我不是個經常喜歡在賽前與對手溝通的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "我來自萊塔尼亞，在異國他鄉，以一個從未想過的身份，活在這座繁華的城市裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "您已經得到了卡西米爾的認可，德羅斯特小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "我聽說，耀騎士從未認可過如今的騎士制度，也因此，您遭到了流放......您如今還是這麼想嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "卡西米爾的騎士正在遺忘他們的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "您去過卡西米爾最貧苦的地方嗎？戰爭、饑荒、感染者......百姓遭受著巨大的苦難，騎士們躲在自己的城市裡歌舞昇平。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "騎士的精神，已經消失殆盡，成為了資本肆意操弄的遺產。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "這難道不是一種恥辱嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......原來如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "看起來，您才是一名真正的騎士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "但您......仍只是一名騎士而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "您的妹妹呢？先前一段時間，是她活躍在賽場上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "她放棄了......騎士之路嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "發言人麥基",
      "text": "德羅斯特小姐......還有瑪嘉烈小姐，晚上好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "晚上好，麥基先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "剛才的騷動勞您費神了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人麥基",
      "text": "......唉。原來您有這個自覺......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人麥基",
      "text": "像二位這樣的大騎士，一舉一動都會成為群眾熱衷的話題，何況，你們還當著媒體的面......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人麥基",
      "text": "不過這都算了，總是有辦法處理的，德羅斯特小姐，您該為明天與萊塔尼亞貴族的會面做準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人麥基",
      "text": "可以的話，這段時間還是不要製造太多不確定因素的好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "比如，和一位感染者騎士見面？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人麥基",
      "text": "......那位貴族幾乎可以說是為您而來，德羅斯特小姐。您在萊塔尼亞人之間也人氣斐然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人麥基",
      "text": "梅什科工業很樂意幫助對方在萊塔尼亞的建設計畫，但最終推行貿易合約的人，是您，德羅斯特小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "當然......我的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "看來很遺憾，耀騎士閣下，今夜沒法和您繼續交談了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "沒關係，您......讓人很意外，如今的卡西米爾還有您這樣的騎士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "下回見，就是在賽場上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "我等待著那一天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "......最後一句忠告，耀騎士閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "風雨欲來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "這段時日的星空，星火格外閃耀。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
