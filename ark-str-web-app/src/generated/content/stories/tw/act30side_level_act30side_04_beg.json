{
  "server": "tw",
  "storyId": "act30side_level_act30side_04_beg",
  "groupId": "act30side",
  "stageId": "act30side_04",
  "title": "重回正軌",
  "storyCode": "RS-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act30side/level_act30side_04_beg.txt",
  "sourceHash": "cc12dd927bd447e23a7b5c77fce95a38cb06847f70a027fcef6c7da05843f483",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "葫蘆！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "同花順！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "*維多利亞粗口*，你這小子是不是藏牌了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "對付你還用得著藏牌？別鬧了，搞笑——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的士兵",
      "text": "皇家同花順。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "*維多利亞俚語*，怎麼可能？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的士兵",
      "text": "杰克，你的袖子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "啊？我——你怎麼發現的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "杰克，你這*維多利亞名詞*，你騙我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "你沒發現，那就是你的問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "*維多利亞問候語*。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的士兵",
      "text": "洗牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "好了，洗牌洗牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "嘖，老子真是倒了楣，今天跟你一起輪班。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "跟誰輪班還不都是打牌，弟兄們有幾個打牌不會出千，你數數吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "不過，這日子過得倒還真是悠哉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "不說還好，老大當時說要帶我們來觀光的時候，我是真不信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "結果來了一個月，我現在信了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的士兵",
      "text": "吃得也好，喝得也好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "可不是，我感覺我的胃口都回到剛入伍那時候了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "嘶——啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "查理斯，你鬼叫什麼呢，嚇我一跳！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "*維多利亞俚語*，我又做了惡夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "夢見我被薩卡茲一劍砍成兩半。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "嘁，我還以為多大事呢。我前天還夢到自己偵察的時候被源石炸藥炸得粉碎呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "我現在就想找塊炸藥塞你嘴裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "你趕快去啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "一個上了戰場比*維多利亞粗口*血魔還瘋的傢伙，下了戰場比誰都矯情。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "我有什麼辦法，我又不能控制做不做惡夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "往好了想，你上次說你是被砍成絞肉，這次只是被砍成兩半。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "說不定是好兆頭呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "……*維多利亞粗口*，還挺有道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "得了，喝一口起來打牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "哦，你醒了正好，來替我打幾局。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "怎麼，有事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "……沒什麼，山下有個農民家裡缺幹農活的，我去幫個忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "農民？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的士兵",
      "text": "經常送奶給我們的那一戶，老圖里爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "哦，我記起來了，那戶人家的女兒挺漂亮的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "嘖嘖，看不出來啊，里斯本。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "……只是去幫個忙，別想多了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "幹什麼呢，隔幾百公尺都能聽到你們一群老油條吵鬧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "挺有本事啊你們幾個，軍營都要成你們的棋牌室了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "這不是您老人家一開始就跟我們說是來觀光的嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "我們這叫遵守命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我還叫你們去跟當地人做做友善交流，免得別人覺得我們是一群壞蛋，你們去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "里斯本這不是剛要去嗎，我看他別說去了，都想在這裡成家了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "老大，別聽他在放屁，就是去幫個忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "畢竟我們終究是來……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "別廢話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "滾吧，什麼時候輪到你操心了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "你這小子要真的能成家，還算你有本事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "老大，你身上的味道好重喔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "又去鍛鍊你那獸醫技術了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "別提了，老雷昂家的莉莉早產了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我沒趕上，只能去幫忙做一些產後護理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "唉，還遇到個晦氣的傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "晦氣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "老鄉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "老鄉？我這一個月見到的來觀光的維多利亞人沒有一千也有八百了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "好了，就你最愛上街閒晃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "發牌發牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的士兵",
      "text": "我來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的士兵",
      "text": "老大，查理斯剛才又做惡夢了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "小事，哪裡需要麻煩您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "你們死了，誰來幫我打仗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "……還會打嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "先閉嘴，忍一忍。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "嘶——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "嗯……確實沒有惡化。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "現在還像過去那麼痛嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "自從來了謝拉格，比過去好多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哼，這可是我花了大錢打點關係才搞來的機會，要是對你們的身體沒好處，那我不就白花錢了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "不過，在這裡最多也只是療養就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "嘿嘿，我知道，老大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "我這條手臂早就廢了，也就您還會幫我照看兩下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的士兵",
      "text": "不過就算我兩隻手臂都廢了，只剩下一張嘴，我也能咬著武器上戰場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "一個沒有手的士兵能做到什麼事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "逞強沒有意義，你們只需要記住，你們是來——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "容我再次提醒您，子爵閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "請記住您身負的職責，不要辜負公爵閣下的期望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "這並非一場觀光。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "喂，老大，老大？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "終於老年癡呆了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我跟你們這群根本不愛惜自己身體的蠢貨可不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "等你們老年癡呆了我都不會老年癡呆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "嘿，我們可活不到那個時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "罷了罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "為了我的養老計劃，只能把這張老臉豁出去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "老大，你說什麼胡話呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "按謝拉格人的審美，他們可不會喜歡你這種油膩貴族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "但是沒有人會拒絕一場盛大的宴會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "你們打吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "該不會是牌太爛了才找了個藉口開溜吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "讓我看看……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "油滑的士兵",
      "text": "四張J，不好不壞。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "哈！好酒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "這就是恩希歐迪斯特地送過來，說要在儀式前夜的營火晚會上做宣傳的，那什麼、什麼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "老爺，是“聖山莊園·雪境之春”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "這段時間電視裡天天放，搞得我都記住了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "譁眾取寵！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "嗯，但這酒滋味確實不差，夠帶勁，算是他恩希歐迪斯難得做了件好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "不過，我們自家的陳年酒也不比這酒差！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "老爺，那我們還繼續喝嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "算上布朗陶家弄來的，後面還有三種酒水備選呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "當然繼續！不親自試試，怎麼知道哪種最好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "聖女大人既然把這次晚會交給我佩爾羅契家籌辦，那我就得負起責任來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "酒水是重中之重，我得選出我們謝拉格最好的酒水宴客，務必不讓聖女大人失望！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "去，把剩下的幾種酒水也一起抬上來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "來人！跟我去搬酒！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "將軍，我有個問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "雖然老爺剛才說了是為慶典做準備，但最近運來的酒是不是太多了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "弟兄們都要累癱了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "想那麼多幹什麼，耶拉岡德像落成這麼大的事，多少酒都不夠用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "讓弟兄們忍一忍，等忙完了我請你們吃頓好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "好啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（佩爾羅契家的人或許多留些心眼會好一些。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（連我自己都沒想到，混進來會這麼簡單。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（那位老家主已經帶著羅莎琳小姐往這邊來了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（接下來就讓我看看，佩爾羅契家的葫蘆裡，究竟賣的什麼藥吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（而且——大量的酒……可阿克托斯的架勢，真的是用來開宴會的？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（也是一條線索。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "拖拖拉拉的在幹什麼呢，快過來幫忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（不過，如果佩爾羅契家真的有什麼不可告人的秘密，那麼這個秘密也一定與羅莎琳小姐脫不了關係。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "（先以她那邊為優先吧。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我們到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "老伯，這是你家？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "好大的房子，看不出來，原來你這麼有錢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "不至於，只是略有家底罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "咳嗯，小妹妹，你看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "這房子依山而建，明日你要上山，便可走這屋宅後方的近道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "多謝你啊，老伯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "小妹妹，我要先跟你道歉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗯？怎麼了，這麼突然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我邀請你來做客，是存了一份私心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "耶拉岡德在上，此事、此事我不該瞞你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "……什麼事這麼嚴肅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "你說吧，老伯，我聽著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "好孩子，好孩子……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "有一個人，我想讓你見一見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "他……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "大老爺？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "那邊有個大個子在喊你呢，老伯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "那是你兒子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我可沒這樣的兒子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "小妹妹，你等我片刻。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "大老爺，您怎麼忽然回來了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "……怎麼，我不能回來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "我不是那個意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "只是，唉，您這來的時間不巧……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "有什麼巧不巧的，我想什麼時候回來，還輪不到你小子來多嘴！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "你們老爺人呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "老爺他、他……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "吞吞吐吐像什麼樣子！說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "老爺他正在為明天的營火晚會做準備！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "別光挑好聽的說，還有呢？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "……老爺他，一定要親自為明日的酒水把關，正在品嚐各地送來的酒……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "這臭小子……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "他上個月才說戒酒，如今就這般，簡直荒唐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "如此朝令夕改，往後哪裡還有半點威信可言？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "老爺這也是為了國事著想，是對聖女大人一片忠心……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "哼！我看他就是管不住自己的嘴！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "哈哈……對了，這位女孩是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "古羅小子，不得無禮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "小女孩叫羅莎琳，是我的客人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "羅莎琳小姐，歡迎歡迎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "（大老爺，這位羅莎琳小姐究竟是什麼人？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "（怎麼看著，這麼像老——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "（住口！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "（……這事還沒個定數，你先別多問。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "古羅，你帶這女孩先進去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "去……阿克托斯那混帳在哪，就帶她去哪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "還有，吩咐下面的人備好客房和飯食，一定要好生招待。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "……是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "讓你久等了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "你們聊完了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "剛剛這個大個子出來之前，老伯你想跟我說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "你想讓我見誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "……我希望你見的人，便在屋內。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "先和這大個子一起進去吧，羅莎琳，待那人見到你，就什麼都明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "那你呢，老伯，你不跟我們一起嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我們很快會再見的，孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "很快……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "請吧，羅莎琳小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哎這位大哥，你叫古羅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "你們家這老爺子剛剛和你嘀嘀咕咕的，你們都聊了點什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "是什麼不能告訴我的內容？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "兄弟，說句話吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "（雙手食指比叉）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "真不能說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "（反覆比叉）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗯……好吧，不為難你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "反正一會見到人就知道了，對吧？我也怪好奇的，到底是什麼原因，讓你們一個兩個都只顧盯著我的臉看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "怎麼，是我長得像誰，還是誰長得像我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "該不會，老伯說想要我見的人就是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "這、不是，沒有……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "切，好了，你這個人一看就不會說謊話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "說真的，你們的眼神真的蠻怪的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "要不是知道你們沒壞心思，我都要忍不住動手了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "不是要進去嗎，那就走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古羅",
      "text": "哎！羅莎琳小姐！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老爺，大老爺他帶了客人回來……\n老爺？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "哇哈哈哈！好酒，好酒啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "來，一起乾了這杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "哈哈哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "這就是老伯想讓我見的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "一個……大鬍子醉鬼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "哪裡來的小丫頭，亂說什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我佩爾羅契家家主阿克托斯，怎麼可能因為這點酒就醉了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "醉鬼一般都這麼說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我本來還以為……但不應該啊，我爸應該很帥才對……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "你是父親的客人，嗝，我不跟你計較。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "不過……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "小丫頭，你站過來一點，讓我仔細看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "你、你要幹嘛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我……我應該認得你的臉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "你是……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "咳、咳咳……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人步入室內，驚起厚重的灰塵。\n門扉搖搖欲墜，地板嘎吱作響。\n在他自己的命令下，這間房子已經太久沒有迎來任何一位客人了。\n無人居住的房屋，與無人牽掛的人一樣，都在不知不覺間衰老。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我把它放在哪裡了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我把它放在……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "……沒錯，是在這。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人摸索著打開角落中的木櫃，從中取出某樣物件。\n那是一塊無華的石塊，被精心磨平所有棱角，打磨至圓潤無缺。\n在石塊上，刻著代表耶拉岡德祝福的圖案。\n老人將這塊他親自求來的石塊握在掌心。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "還好，還好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我收著它，卻沒想到能有今天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "塔季揚娜，羅莎琳是個好孩子……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人記得，那也是個冬天。\n他便是透過這扇窗戶，注視著窗外壓抑無聲的別離。\n他看著那年輕的、來自異國、沒有犯任何過錯的女人，帶著能點燃冰雪的憤怒與失望離去。\n他看著那年幼懵懂的稚童，被女人抱在懷中，尚不理解母親怒容的來由。\n老人看了許久許久。\n直到兩人的背影在風雪中逐漸淡去。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "這麼多年，時間就這麼過去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "當年我本想將它送給羅莎琳，卻不料……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "當年阿克托斯不願看你們受非難，是我強行將他關入柴房，令他不得為你說話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "而後，也是我，是我為佩爾羅契家，放逐了你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "塔季揚娜，你若有怨，便怨我好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "如今，佩爾羅契家已交付到阿克托斯手上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "謝拉格也與曾經大不相同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "我立下誓言，如今便做尋常修士，只要在世一日，便為耶拉岡德清掃路面一日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "若那時便能如此……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "竟做起這種夢，我也真是老了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "耶拉岡德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修士",
      "text": "耶拉岡德在上……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
