{
  "server": "tw",
  "storyId": "act9mini_level_act9mini_st02",
  "groupId": "act9mini",
  "stageId": null,
  "title": "落灰",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act9mini/level_act9mini_st02.txt",
  "sourceHash": "76f4dcabc684aa09638e0f5d3793263656c3106ee4f74b6cc3290895b1371b13",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔1.5-灰松鼠"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶，我們要去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "還沒到你提問的時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "拿穩小炮，跟緊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "是的奶奶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "快到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "那邊是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "競技場，從大騎士領來的傢伙們建的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "我們是要去看比賽嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "比賽？不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "我要帶你去參加訓練。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "還記得我教你的東西嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "是的，奶奶，我記得很清楚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "架盾、起炮、轟擊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "盯緊敵人、注意彈藥、炮不離手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "還有，嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "炮聲轟鳴，勝利已在眼前！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "你比你的父親要可靠得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "至少在我閉上眼前，還有人能夠記得這些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶，請別說這樣的喪氣話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "呵，古木哪有不爛的道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "與其就這麼腐朽掉，不如做新芽的肥料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "不必，只是咳嗽一下，沒什麼好擔心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "你父親那一輩，甚至我的幾位兄弟，早都忘了卡利斯卡是怎麼繁榮的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "林業？那片林子是我們靠功勳、靠火炮換回來的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "“炮聲轟鳴，勝利已在眼前”......那幫見錢眼開的傢伙連格言都記不住了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶，請您別生氣了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "哼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "格蕾納蒂，你是棵好苗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "可別長歪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "是，我不會讓您失望的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "沸血騎士團——競技場屠夫——養好傷後再度歸來——一如既往的殘暴！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "而另一邊——另一邊是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "威嚴的祖母",
      "text": "咳，咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "曾經的南方林業鉅子——卡利斯卡集團的一員——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "如今則是一位感染者——隸屬於紅松騎士團——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "讓我們歡迎——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "奶奶？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "（呼......放輕鬆，奶奶已經教會我了，我可以的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "（我準備好了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "灰毫騎士，格蕾納蒂·卡利斯卡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哎呀，小灰終於進場了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "格蕾納蒂進場總是慢悠悠的，也不和觀眾表示一下，一點都不痛快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "這就是賣點嘛，有人可喜歡這一套了，你看那。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激動的粉絲",
      "text": "格蕾納蒂！格蕾納蒂看我一眼呀！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "嗯......行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "歡呼聲作不了假。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "而且那個持炮的姿勢，還挺像貴族的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "當然我最期待的還是她開炮轟人的時候啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那是肯定有的啦，聽到轟隆隆的響聲觀眾可興奮了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "要是有更過癮的就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "怎麼，你還想看她用炮筒砸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "哈哈，有機會還真想見識一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "巨斧對堅盾！究竟誰才是最後的贏家，讓我們拭目以待！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "點開您的終端，做出您的選擇，支持您的選手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "當然更重要的是，給自己一個填滿錢包的機會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "比賽——開始——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "你手上那塊塑膠最好能多撐一會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "礦石病垃圾。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "真沒勁，上了賽場就話都不多說一句。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你又不是第一次看小灰比賽，那叫認真，認真懂不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "可這樣很無聊啊......不發洩一下情緒，怎麼在氣勢上壓過對手哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "騎士競技又不是誰嗓門大誰贏呀，主要是對抗得好看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "看嘛，就是這樣的。鏽銅被逼退了，大家也都很高興，對不對？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "可是今天這場，是不是太穩了？連主動攻擊都很少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "這也得挑對手嘛，遇上鏽銅這種偏重進攻的騎士，組織好防禦才是最佳策略。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "而且小灰又能用她最愛的技巧了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "盾擊擋開接一炮，百試不爽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "（小灰這一場進攻欲望是不太強，她到底在想什麼啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "令人驚訝，屠夫的切肉斧在灰毫騎士面前居然毫無辦法！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "每一次格擋，每一發炮擊都讓英格拉無功而返！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫騎士的防禦完美無缺，她正在一點點推進，壓縮屬於屠夫的活動空間！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "毫無疑問，這將是一場拉鋸戰，不到最後一刻，誰都不知道勝利的桂冠花落誰家！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "趕緊拿起終端為您支援的選手下注吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "抑或是即刻訂購一瓶印有選手logo的賽場特供冰鎮礦泉水，讓身旁的觀眾知道您到底支持哪一方！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "現在下單，立刻有專人為您送至座位！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "還有這種東西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "真的有，只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "這價格......我為什麼不去賽場外面買十瓶回來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你不會下單了吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "就買一瓶嘗嘗鮮，嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "你就只會縮在那塑膠板後面嗎，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "喝，等我敲碎它，你有的是時間尖叫，石頭老鼠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "卡利斯卡這樣的小企業是不會給你收屍的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（扣下扳機）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嗚哇，小灰生氣了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "英格拉也太毒了吧，揪著人痛點不放幹嘛呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "卡利斯卡林業以前還是挺有名氣的，最近倒是聽不到什麼新聞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "不會真的和格蕾納蒂有關吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "要真讓小灰來經營，他們家的公司說不定現在還能做大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "自己經營不善，就把氣撒在別人頭上，這樣的公司肯定做不好啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "聽說小灰是在一桌子叔父叔母面前被全體表決逐出家族的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "全票通過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "那她父母......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "聽說也被要脅著把自己的女兒投出家族了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "雖然回家以後還是給小灰準備了來大騎士領的資金。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但你也應該知道吧，本應該支持自己的父母都舉起了手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "太痛苦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "還好小灰夠堅強。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "特別堅強。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "呃......她不會真生氣了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我看看——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "還好還好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "這種時候生氣不是很正常的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "要是我肯定先把鏽銅捅個對穿再考慮其他問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰的打法太耗腦子了，彈藥數量又有限，賭氣多打一發彈藥可能就輸了呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "現在應該還在讓鏽銅以為自己生氣了的階段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "畢竟，誤導對手也是很重要的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "令人震驚，英格拉的肩甲居然被轟碎了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫騎士仍舊在步步緊逼，難道勝負馬上就要揭曉了嗎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "又是一聲炮響，看來灰毫騎士已經準備好親手拉響勝利的禮炮了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "發生什麼事了？！各位觀眾看到了嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "剛剛鏽銅居然用斧頭劈開了一枚炮彈！感謝兩位選手，為我們上演了一出在電視劇集中才能見到的場面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "是的，我說的正是斯沃瑪影片投資拍攝的都市懸疑電視劇《大騎士領二十四夜》中的經典場景，有興趣的觀眾可以立即下單購買光碟！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "前三十名購入者可以獲得男女主角簽名海報一張，先到先得，逾時不候！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "咕咚咕咚——呼，這水和路邊便利店買的也沒什麼區別嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "我不是早提醒過你了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嘻嘻，算啦，就當付了筆代購費吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "話說回來，莫布還真是不放過每一個能做廣告的機會啊，真煩人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "這就是他的工作嘛，理解一下啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "不過誰能想到鏽銅會斧劈炮彈呢，硬生生給了莫布一個插廣告的機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "要不是那一下小灰心軟了，想著把鏽銅轟倒，就沒瞄準腦袋......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "比賽現在就結束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "她彈匣裡炮彈不多了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "應該只剩一發。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "該換彈匣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "希望英格拉別在這時候給我們家小灰添什麼麻煩。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（還有一發嗎。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（把他轟退的同時借力後撤，爭取到的時間應該足夠。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（以英格拉的競賽風格，應該不會有後手。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（時機差不多了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "你就這點本事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（變快了？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（不好！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "鏽銅鞋子上那是，推進器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "這一下可麻煩了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "加油啊小灰！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "沒了炮彈，你還能做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰，你還有彈藥嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "沒有，備用彈匣剛剛用來擋弩箭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那怎麼辦，用炮筒砸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "有需要的話我可以分心幫你對付幾個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "然後像之前那樣乘機拿走我的分數？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "別再惦記那件事啦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "當初大家初次見面，沒有提防才有問題啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "以後不會了，我們約定過的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我能相信格蕾納蒂不會為了自己的利益犧牲其他感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "格蕾納蒂也相信索娜不會背後捅她刀子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "對不對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......哼，算是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那你準備怎麼對付面前的騎士？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我真的能騰出空來幫一把的，有需要就趕緊說哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "我有我的辦法。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "剛剛還佔據優勢的灰毫騎士在換彈時被抓住破綻，鏽銅開始了復仇，難道屠夫的切肉斧終究還是要見血了嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫騎士究竟會如何反擊呢，我們看到她——她拆下空彈匣甩向鏽銅，然而沒有任何——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "哦不對，她甚至丟下了炮衝向鏽銅，她到底要做什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "英格拉舉起了武器，灰毫騎士卻只剩一面盾牌！灰毫——灰毫格開了戰斧，然後——喔！！一擊頭槌，連我這裡都聽得到響聲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "喔！一套連貫的徒手打擊，英格拉後退了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "格蕾納蒂一個翻滾回到了她的武器旁，換彈，上膛，一氣呵成！英格拉又要再次被炮火支配了嗎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "啊哈，我們又一次聽到了炮響，灰毫騎士重新掌握了局面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "雖然難看了點......這脫身方法還挺實用的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "不過我真的沒想到她丟下那門炮之後速度會那麼快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰也是札拉克嘛，靈活一點很正常的啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "那她為什麼不和你一樣用輕巧點的武器呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "個人愛好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我是建議過她換件更適合在賽場上使用的遠程武器，標槍啊、弩啦、投石索之類的，她都不喜歡，就是愛用那門從老家帶來的炮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "有時候根本施展不開，維護還費時費力的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "真是固執。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "習慣就好啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "她剩下的彈藥就只有最後八發了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "如果打完了會發生什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "不知道欸，會發生什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我是從來沒見過小灰把備彈全部打完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "......呼，呼，你是在羞辱我嗎，灰毫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "說話啊，你這個，石頭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（扣下扳機）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "你準備裝啞巴到什麼時候！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "受夠了，我受夠了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "喝啊！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰真的太壞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "她不會從一開始就準備和英格拉玩拉鋸戰的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "又不回話又打不倒，換我我也氣。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "唷，你來啦查絲汀娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "灰毫她為什麼要羞辱鏽銅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "這個，說來話就長啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "我碰見小灰的時候，她就對觀眾席上面的騎士老爺們一肚子怒火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "其他的感染者騎士都覺得她只是單純地對騎士老爺不滿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但是她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "如果沒有感染的話，她也是騎士貴族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......我聽說過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "在受到感染後，她騎士家族的長輩同輩沒有一個人對她表示過同情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "所有人都將家族的逐漸衰落歸咎在她身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "正常人都知道這和得病沒關係啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但他們就這樣做了，她的家族，卡利斯卡的札拉克們一致同意剝奪小灰的地位，把她踢出家族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "小灰曾經是那麼信賴這些親屬，願意與他們分享趣事，願意同他們切磋武藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "但最後，小灰以為的至親好友，一位都沒伸出援手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "聽說還有人恨不得讓她徹底從大地上消失——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "這，不至於吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那天我也在，幫小灰擋了一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你們應該能理解小灰為什麼對騎士老爺們深惡痛絕了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "至於鏽銅英格拉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "他所做的每一件事，都在深深刺痛小灰的心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "也就是這個原因，小灰才準備在拉鋸戰中對抗到最後吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "為了將一位高高在上的騎士老爺徹底打倒在地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "也為了......平息她自己的憤怒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哎，查絲汀娜，幫我看看小灰彈匣裡還有幾發炮彈？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......四發。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "噢哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "快要結束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "一陣猛烈的攻勢並沒有擊倒灰毫騎士，鏽銅卻開始體力不支了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "我們能看到他正準備發起最後的衝鋒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "漫長的拉鋸戰馬上就能見分曉了嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "請各位觀眾注意您的投注號碼，說不定在勝負見分曉的同時，還能獲得一份意外大禮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "本場賽後幸運抽獎由呼嘯守衛贊助，機率竟然是驚人的百分之零點五！還沒有下注的觀眾，請抓住這最後的機會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "英格拉舉起了他的屠刀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "格蕾納蒂也擺出了一個防禦姿態！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "勝負馬上就要見分曉了嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "哎呀，小灰她什麼時候偷學我的招！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "鏽銅在衝鋒，鏽銅還在衝鋒，灰毫也舉起盾牌，卻把炮口對準了身後！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "難道她要硬接下鏽銅一擊嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "雙方越來越近，越來越近了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "借著炮擊的加速度，灰毫居然從鏽銅的斧旁躥了過去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "太快了太快了！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "她捨棄了盾牌，把炮口按在英格拉後背上扣動了扳機！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "鏽銅騎士倒下了！灰毫騎士獲得了勝利！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "等等，灰毫騎士又一次把炮口對準了鏽銅，難道，殘虐的英格拉也有被欺凌的一天嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "......呵，縮在殼裡的札拉克。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "灰毫......格蕾納蒂......我記住......你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "等我養好傷......你......你們感染者，一個都逃不掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（扣住扳機）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "（將炮口對準天空）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "這一枚炮彈是獻給觀眾的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "你不配。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鏽銅騎士",
      "text": "你......嗚......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "灰毫騎士最終沒有攻擊倒下的英格拉，在打出最後一發炮彈後，她獨自一人走向了出口！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激動的粉絲",
      "text": "格蕾納蒂！格蕾納蒂——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "本次比賽——抽獎——獎金——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "這一次感覺怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "不是很好，父親，火炮拿久了手還是會抖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "要不要換一件更輕便的武器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "不用，火炮很適合我，它的威力能夠補足靈活性上的不足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "而且，或許某一天，我將不在賽場，而是到更廣闊的地方作戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "就像祖母那樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "到那個時候，這件武器一定會變得更加實用的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "好吧......聽你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "小堅果啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "父親，我不是小孩子了，您沒有必要這樣稱呼我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "格蕾納蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "這次訓練做得不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "奶奶如果看到你現在的成果，一定會開心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "奶奶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "奶奶走之前和幾位大伯做過約定，只要你想學，他們就會繼續資助你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "所以不用擔心錢的問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "無論你最終成為騎士還是繼承家業。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "繼續練習下去，總有一天，你會成為卡西米爾知名的火炮手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "唉，卡利斯卡家已經多少代沒有出過一名真正的火炮手了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "想必各位長輩和祖輩都會為你而驕傲吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的父親",
      "text": "可不要讓他們失望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "是的，父親。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長的女孩",
      "text": "我會的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嘿，小灰，小灰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "嗯，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "怎麼了嘛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你怎麼突然開始發呆了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "沒什麼，在想些事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "英格拉可真慘，剛從醫院出來就又被你送回去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "他罪有應得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "那最後一發還往天上打？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "比賽已經結束了，就算我再看不起英格拉，也不能再對他下手了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "不然我和他又有什麼區別？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "可惜了，本來還想在報紙上看到“屠夫慘遭屠戮”之類的標題來著......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "英格拉家族讓這則新聞上不了報紙的可能性比較大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "索娜，其實我從剛才就想問你個問題......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "嗯，怎麼了小灰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "你手上拿著的，是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "你的應援水瓶啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "索娜你怎麼又買這種無聊的東西了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "還好啦，主要是那時候有點口渴又懶得出去買水。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "唷，我們的騎士凱旋啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......我也要向灰毫學習，變得更強。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "查絲汀娜，“那件事”怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "查絲汀娜",
      "text": "......完成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "好，辛苦辛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "這次的獎金一到帳我就會匯去“那個帳號”，聽說銀行那邊已經開始關注最近的頻繁轉帳問題了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索娜",
      "text": "還能用個人消費糊弄一下嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾納蒂",
      "text": "......你覺得呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
