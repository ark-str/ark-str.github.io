  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "Ace！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "看來，你們都平安無事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這裡還沒到會合點......怎麼只有你一個人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "他們就是那些從核心區出逃的人！別放他們走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "呿，窮追不捨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "E2小隊，應敵——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "杜賓，不要戀戰，優先後撤！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "阿米婭，Dr.{@nickname}！快！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這裡也不安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "是的，我們還要繼續向下一個會合點移動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "你的小隊呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "藏到哪去了？把他們找出來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "又來了嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Dr.{@nickname}，請下命令吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "就像以前那樣。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊，Ace......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "其實有些，小小的變故。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士......意外失去了記憶。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "......原來如此。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "抱歉，Ace......事情和以前相比，有不小的區別。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "是嗎。你沒必要向我道歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "博士的指揮能力，有沒有因為失憶受到影響？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......和以前一樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士的決策依舊十分可靠，我保證。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "那就好。我聽從博士的指揮。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "失去了的東西是可以找回來的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "眼下有更棘手的問題等著我們去解決。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "他們在這兒！快，快攻擊！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "聊天還沒結束？我已經開始戰鬥了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "Dr.{@nickname}，請下命令吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "放，把那些畜生放出來，讓他們嘗嘗被撕咬的滋味！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "博士！Ace！敵人近在眼前了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "——",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "立刻出動！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......好的。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "趁現在，破壞敵人的計畫吧。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "E3小隊！支援杜賓！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "埋伏？！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "E3小隊......一直隱藏著行蹤，就是等著和我們配合，夾擊敵人嗎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "在通訊受到干擾的情況下，小隊應該在會合點附近行動，這樣，即使是我或者偵查幹員發生了意外......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "整體的撤退計畫，依然能夠正常實施。這是我的判斷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "也就是說，Ace你把小隊留在會合點，一個人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "畢竟最重要的，是去除會合點周圍的威脅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "優先確認你們的狀況是一種冒險。我不能帶上整個小隊一起。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "小隊存在的目的，本來就是為了讓戰術更有效，而不是固步自封，成為拖累。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "哈。接下來，用實戰去解決了整合運動再說吧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "阿米婭，拜託你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "知道了！我會輔佐博士，透過法術支援你們的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "終於......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "Dr.{@nickname}，請你，指揮羅德島。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
