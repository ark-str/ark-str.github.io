{
  "server": "tw",
  "storyId": "main_0_level_main_00-04_beg",
  "groupId": "main_0",
  "stageId": "main_00-04",
  "title": "混戰",
  "storyCode": "0-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_00-04_beg.txt",
