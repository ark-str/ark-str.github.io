{
  "server": "tw",
  "storyId": "main_6_level_main_06-11_beg",
  "groupId": "main_6",
  "stageId": "main_06-11",
  "title": "冰原之雪",
  "storyCode": "6-12",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_06-11_beg.txt",
  "sourceHash": "ba0c334e5f81b7a1bb7c7e0f149b374336f1a8d6f33446b8b60457152ff4cf3e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "我確認過了，所有能聯繫上的整合運動隊伍已經全部撤出了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "人真多啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "浩浩蕩蕩的......就像河水一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大熊",
      "text": "荒原上會出現一條河流......一條逃難者的河流。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大熊",
      "text": "既有烏薩斯人，也有龍門人。既有感染者，也有普通人。來時他們或貧或富，去時他們兩手空空。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大熊",
      "text": "原本他們認定有一個地方可以接受自己，現在他們知道自己總歸無處可去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大熊",
      "text": "這條河流，最終會從這荒原上消逝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "（他的語氣好悲傷。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "（從大爹那學的吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "（也難怪。這個時候了，人難免有些感傷的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "如果大爹在這，我們一定打得贏，也不用走到這個地步吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "運氣好壞這種事，你再怎麼考慮另一種結局都沒用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "......準備一下。我去和幻影弩手們商量下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "別催我呀，我又不是不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "趕緊去，別拖拖拉拉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "我也挺感傷的啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "確定了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "是雪怪小隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "阿米婭他們呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "已經趕赴現場了。阿米婭要我囑託你，“別衝動”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "這話和沒說一樣。她知道的......要說衝動，我在羅德島算得上是第一名了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "煌！你去哪！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "去救人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "弩手們！請稍等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "雪怪......等等，你這是做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "......霜星大姊她的身體，已經支撐不了多久了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "她剛剛為了擊退龍門的部隊，已經耗盡了氣力。可能一時半會還醒不過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "你的意思是要我們再帶上她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "可我們本不準備回切爾諾伯格。浮士德也不希望梅菲斯特......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "我們懇求你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "我們都希望大姊最後，最後能和愛國者一起度過！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "雖然他們的關係現在有點不好，但我們知道的......他們之間的親情比血還濃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "我們......懇求你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "你們呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "我們給你們殿後。如果不給你們拖一段時間，你們很快就會被龍門追上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "等你們和其他人走遠了，對龍門沒有威脅了，他們也不好再追緝你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "可那樣的話，你們就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "只要戰鬥，就總會戰死的。戰死在這裡，我們都覺得不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "霜星大姊她說的未來，有一點遠。但我們其實也不必親眼看見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "又欠了你們一條命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "你們也幫我們帶上了大姊。這不算什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......我們一定完成你們的託付。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "這個，護臂和防護裝，你穿上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "這是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "大姊的溫度會冷到你受不了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......她好輕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "法術掏空了她的身體。輕點，再輕點......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "別弄醒她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "你看她......看她睡得多熟啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "再見了，大姊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "我們會等你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......就這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "我們......先走一步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "是我們先走一步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "總會再見面的，雪怪們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "希望這一天來得遲些。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員D",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員D",
      "text": "我們要死了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "*烏薩斯粗口*，你怎麼就流眼淚了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "你這樣也算雪怪嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員D",
      "text": "你不也在哭？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "我哭什麼了我！......你忘了大姐怎麼說的嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩特洛娃",
      "text": "她說別哭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "對！她說別哭......十多年前，她說別哭！別掉眼淚！我們不配......因為我們還沒打贏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員D",
      "text": "等我們贏了，等我們自由了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "我們自由了，我們會放聲大哭，在荒野裡在雪地裡，在堆得滿滿的麥垛裡放聲大哭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩特洛娃",
      "text": "明明大姊也一邊說一邊哭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "那時她才九歲啊。我們都比她要大好幾歲啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩特洛娃",
      "text": "沒有大姊，我們已經死在那座礦場了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩特洛娃",
      "text": "你帶了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "帶什麼......等等，不是不准帶嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩特洛娃",
      "text": "是不准行軍的時候喝。但你帶身上的，我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員D",
      "text": "我也想喝......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "不行，你年齡沒到啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員D",
      "text": "可，可我以前沒有喝過啊，我不想味道都沒嘗過就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩特洛娃",
      "text": "給他一點吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "佩特洛娃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "行啊。喝一點吧。可別喝太多，其他人也要的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "兄弟們，都喝一點吧，暖暖身子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩特洛娃",
      "text": "敬大姊和大老爹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊全體",
      "text": "敬霜星和愛國者！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你認識這些感染者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是的，陳長官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "但這最後一場戰鬥必須現在打響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們有得選嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們可能別無選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "看看你的身後。現在的他們甚至沒有刻意隱藏自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......黑色雨披。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "所以，我們必須要和他們戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "這是我們必須要做的。不這麼做，我們就會落下把柄，把特殊部隊強行拉來壓制雪怪小隊的行為也會變得毫無說服力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "不過，你有沒有可能勸服他們投降？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "只要他們的身後還有感染者......他們就不會投降。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我不會逼你們參與戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "抱歉，陳長官。但是......但是我們會見證。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "近衛局英勇堅決地戰鬥了，沒人能否認。你們在為了龍門而戰，你們抗擊了侵略者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這是我們幫助你們對抗那些特殊部隊的方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "而對於我們自己來說......我們要記下每一場感染者的戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "每一場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "陳長官？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "戰鬥結束以後，我們一起去吃個飯吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可，可我是感染者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "不用在意。那個聲音很大的，個子很高的，這兩個人也不會在意的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "這場戰鬥......無論是誰都損失太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "對於我們來說是戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "對於龍門來說，這確確實實是一場戰爭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "戰爭就是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "但是那個策劃了這一切的人，並不在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我想，我有必須要告知你們的事情——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "——但不是現在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "沒錯，不是現在，陳警官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不想看嗎？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我.......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "但就像在切城廢城時那樣......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "對。我已經下定決心了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我必須要......親眼去看。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我們一起。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們一起。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員D",
          "text": "原來叫大姊......不是因為年齡才這麼叫？我為什麼現在才知道？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "得了，你必須這麼叫。那年你才三歲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員D",
          "text": "嘁！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "嘿，態度這麼差，沒兩口就醉了？你喊餓的時候，我是少分你麵包了還是沒把湯分給你了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員D",
          "text": "這個是這個，那個是......那個！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "說來，有些好笑。我突然在想羅德島那些人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "想他們幹嘛？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "那個渾身冒熱氣的貓，說要和我們一起喝點那隻。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "有些遺憾。她看上去量不錯，胡鬧起來也一定很帶勁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "但那隻小兔子，怎麼也沒到這個歲數吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "她多大？十六？十七？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "也就十四左右吧。只是逼著自己說些大人會說的話而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "和大姊那時候......一樣啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "這最後一點就敬他們吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員A",
          "text": "祝他們說到做到！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大熊",
          "text": "說到做到！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員D",
          "text": "唔，呃......說到做到！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "九",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "九",
          "text": "龍門人理應比他們還要齊心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "快走吧，別看了。雪怪也只能拖一時。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "九",
          "text": "你不覺得他們的行為很可貴？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "如果我們沒命了，那他們豈不是白幹？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "按幻影弩手的說法，切爾諾伯格我們確實是回不去了。我們要往新的據點去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "九",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "你不關心新據點是哪？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "九",
          "text": "不管是哪裡，我會和你們一起走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "哎。你們龍門人，和我們也沒區別啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "本來還想他們會待你們好一點呢，沒想到和烏薩斯差不多一回事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "九",
          "text": "感染者在哪都一樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "你剛來的時候可不是這麼說的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "九",
          "text": "人是會變的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "是雪怪嗎？那些是雪怪嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "是雪怪！是......是雪怪沒錯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "雪怪......雪怪！這群雪怪怎麼這麼倔？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "可惡，可惡！別死！別送死啊！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "等我過來，我能救你們，我帶你們走......帶你們走！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "為什麼像你們這樣的感染者也要死在這裡？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "特殊部隊停止進攻了？不，他們好像撤退了......？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "似乎......是把主動權交給我們了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "這是要凸顯下龍門的執法力量？*龍門粗口*，還真是被徹底看低了啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "......算了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "各位，最後一波進攻了。別辜負市民和陳sir的期望。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "讓他們看看吧，讓這些整合運動明白龍門的實力！讓所有感染者都再也不敢冒犯龍門！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "哈......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "幻影弩手們，可別讓我們失望啊。一定要把大姊送回老爺子身邊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "......她沒多少時間了。最後的時間裡和老爺子一起過吧，大姊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員B",
          "text": "我們也沒多少時間了吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "安排完了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員B",
          "text": "全部都做好了。讓我們把這條命還了吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雪怪小隊成員B",
          "text": "讓他們見識一下，由烏薩斯最偉大的戰士博卓卡斯替訓練，由烏薩斯最冷的夢魘帶領的小隊，究竟是什麼樣子！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "大姊最後殘留的一點源石技藝......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "霜凍源石，準備釋放！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩特洛娃",
          "text": "大熊！我們上了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "雪怪！！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
