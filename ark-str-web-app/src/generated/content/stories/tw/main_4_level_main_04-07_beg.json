{
  "server": "tw",
  "storyId": "main_4_level_main_04-07_beg",
  "groupId": "main_4",
  "stageId": "main_04-07",
  "title": "各取所需",
  "storyCode": "4-7",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-07_beg.txt",
  "sourceHash": "c87bfe9929e1115f6cec2a7d038c7ee72d3d7f3774701a6bea7a0836ba4122a8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這裡......倒下的都是些整合運動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......這個，傷口流出的血液凍成了冰渣，其他部分卻很完好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "確實是霜葉的技巧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——那邊的廢墟，應該是爆炸導致的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "應該是隕星炸出來的沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "（霜葉......潔西卡......隕星......她們，一定還......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "阿米婭，各救援小隊都已抵達羅德島、",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我們救出了除了隕星她們以外的所有偵查小隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "沒有幹員在任務中犧牲。但相應的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "所有人都有不同程度的凍傷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你要重視這點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......凍傷？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "所有偵查小隊都指出，分城中徘徊著一些特殊的整合運動成員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "他們有著特殊的作戰方式，完全不像一般的整合運動成員那樣盲目。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "多加小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我......我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "Dr.{@nickname}，你也明白吧？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "明白",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "那就好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我也要去做一些事情了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "阿米婭，就算Dr.{@nickname}很有用，也別太過依靠一個人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "還有，注意戒指。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我知道。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "其實凱爾希醫生也很擔心你的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不知不覺中——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "危險的野獸露出他們的利爪了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "整合運動在我們的背後。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我們的退路......被切斷了。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "這些感染者暴徒，似乎對我們有些想法呢。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯......他們非常想要阻止我們撤退呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "然而，我們來到這裡的目的，從來都不是逃跑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "羅德島，衝破他們的防線。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "讓我們把隕星她們救回來！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "紅，聽得見嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "啊啊，對。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "沒錯。在貧民區東入口處會合。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "嗯。就我們兩個。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "沒問題的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "對付整合運動，我們兩個已經足夠了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
