{
  "server": "tw",
  "storyId": "story_sidero_set_1_story_1",
  "groupId": "story_sidero_set_1",
  "stageId": null,
  "title": "勤勉之人",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_sidero_1_1.txt",
  "sourceHash": "569b8e6a435670204500afdd0e3b6fe419505cfb75707794da212675ac389292",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 铸铁"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "喂，喂，聽得見嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好久不見，會長小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "聽說您來訪了，就冒昧向您發起通訊，希望沒打擾到您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "是，是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "父母那邊的生意多虧有您照顧，沒有虧損。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您知道的，科林尼亞人就看重這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "托您的福，我在這裡過得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您看什麼時候能見個面吃頓飯呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "後天嗎，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我隨時都有時間！好不容易能和會長小姐吃頓飯，高興還來不及呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好的，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "普通一點嗎，那就食堂吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "食堂的菜不合您胃口嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "包廂？會不會太昂貴了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "是我欠考慮了，抱歉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好，好的，我會準時到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "謝謝您，會長小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "再見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "認識了會長小姐那麼久，她還真是一點變化都沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我倒是雜七雜八的東西學了一堆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那邊，發生什麼了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "堅雷小姐？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "放開我，放——開——我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你不動我就放開你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您不是應該和杜賓小姐出任務了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "這個嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "因為一些個人原因......沒能去成，嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那能請您幫助我訓練一下嗎，最近——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "抱歉啊，我還有事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "放開放開放開放開！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "有事的話，請帶上我吧，我一定能幫上您的。在那之後——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "是非常私人的事！嗯，很私人，就不麻煩你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哇————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "泡泡，你還想在博士那本子上多一筆嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "有什麼我能幫忙的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你說她嗎——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "豐蹄姐姐，教官欺負我唔唔唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "她訓練的時候跑著跑著人就跑出來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "訓練？有訓練嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "是玩遊戲，對，玩遊戲的時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你應該知道，泡泡一來勁就喜歡亂跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "剛剛要是沒拉住她，旁邊這堵隔牆馬上就消失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唔唔唔唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "對了鑄鐵小姐，我這有個請求，不知道你能不能聽聽呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你看，泡泡這麼有精神，正巧需要消耗一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "而鑄鐵小姐也需要陪練吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "話是沒錯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "如果是力量訓練的話，泡泡絕對是最佳的對手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "單純比力量，教官團都不是她的對手啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "就是就是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "恰好鑄鐵小姐身手不錯，和泡泡練練吧，可以的話也教她一點技巧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我才不要教。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那就麻煩堅雷小姐安排訓練室了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "第六訓練室，已經打過招呼了，直接用就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "那麼，泡泡今天就交給你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "盡情地訓練去吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "你好泡泡，我們一起去鍛煉吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哇嗷——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "別跑，訓練室在那邊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "祝你們訓練愉快啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "呼，一口氣處理了兩個大麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "鑄鐵對泡泡，效果到底怎麼樣呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三刻鐘後\n第六訓練室"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "豐蹄姐姐你怎麼這麼能跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "你也不錯啊，體力很充沛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哼哼，薩爾貢哪裡我沒有跑過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "是這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡泡可是超強的，怎麼會跑幾步就不行了呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那可太好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我們來近身對抗吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那是啥，聽上去就不好玩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "拿出所有的力量撞過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "豐蹄姐姐你會飛出去的哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "試試看，我應該擋得住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我來——嘍——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "咚！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "喝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "不愧是，塞拉托。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "呵呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "等等，停停停！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "怎麼了，受傷了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "這次不算！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我剛剛沒有使出全力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那再來一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "這裡應該差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "再遠一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "再——遠一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "豐蹄姐姐一會被撞到不要哭哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那我要進攻了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哈啊——哇啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "轟！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "唔呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "論力量泡泡是不會輸的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "是這樣——嗎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "呀！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "喝啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不可能！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡泡不會輸的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嘿呀！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嘿——啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "啊，哈......哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "教官說的沒錯，力量對抗上，泡泡的確是個可敬的對手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "輸掉了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "豐蹄姐姐你怎麼力氣那麼大！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "因為經常鍛煉啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "身體多活動，總能看到成果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "姐姐你說謊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我也一直跑來跑去，力氣怎麼就沒有變大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "可能是方法不對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "姐姐有沒有小刻的火神大姐強？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "火神......應該沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "在米諾斯，沒人會願意和鐵匠為敵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "但姐姐也很強了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我還需要磨練，還要變得更強。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我也要變得更強，把小刻打翻在地！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "刻俄柏，嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "小刻力氣不大，但就是很能打。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "總有一天，我要把她打翻在地，哇嗷！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "呵呵，好像還挺有意思的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "所以我要特訓，特訓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "再來豐蹄姐姐，我就不信打不過你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好！既然你這麼有精神，我也要和你一起，堅持到最後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "特訓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "特訓！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "兩小時後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "豐蹄姐姐，我，我沒有力氣了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "你在說什麼呢，越是這種時候，越能鍛煉自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "現在才是展現意志的時候！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "再來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "還要，還要再來嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "偉大的戰士可不會在訓練場裡倒下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那，我來了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嘿......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "啪嗒"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "真的，動不了了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "真是遺憾，看來你在耐力上還需要更多的鍛煉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好累，我要回宿舍睡覺......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "不可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唉......為什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "堅雷小姐讓我看管你一整天，我有這個責任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "現在就睡覺的話，剛剛的練習就全白費了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "現在的你應該會需要些康復性運動，緩解一下酸痛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "還要動啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唉——不要——我不幹了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嗚哇啊啊啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "有時間哭，不如來多對抗一下吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嗚嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我要回家睡覺！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "哦——這不是還有力氣嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "別再跑了，請回來把力氣用在正確的地方！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "監控攝影機",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "跟丟了啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "從體力和耐力上來說，我應該是有優勢的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "為什麼總是會跟丟呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "看來三十節相關課程還是不夠，要找教官們再著重訓練一下追蹤這方面的技術。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "鈴蘭小姐，您好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "您，您好，鑄鐵姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（就靠你，和你的大尾巴了，鈴蘭！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（一定要把我遮住啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "（不要再抖了泡泡，會露餡的！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您剛剛有見到過泡泡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "沒，沒有呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "奇怪，這裡是牆角，怎麼會突然消失呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "也許是，爬通風管道走掉了吧，哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "從體型上來說，的確有可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（為什麼鈴蘭有一根尾巴一直在晃？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（爸爸說有些人說謊的時候尾巴就會甩來甩去，原來是真的啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（鈴蘭你真好！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（但是可不可以不要在我鼻子前面晃，好癢哦。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（糟糕！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（啊，啊——）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "啊嚏"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "呀啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "（不要抓尾巴啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "抱歉鑄鐵姐姐，我有點感冒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "啊嚏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "感冒可是大問題，看醫生了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "還，還沒有，麻煩別人可不太好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "我準備再休息一會，然後自己過去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那可不行，我現在就帶你去見醫生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "沒事的，鑄鐵姐姐，只是小毛病，真的只是小毛病，我自己可以的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "（拿出手絹擦了擦鼻子）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "你，是想省錢嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "唉，唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "沒有的事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "果然是這樣啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（是什麼啊，她看到我了嗎！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "（她是不是誤解了什麼啊......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我理解你的心情，我老家那裡想給自己省一點小錢不去看醫生結果病死的人實在是太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "你那麼小，不應該受這種罪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "要是付不起，我來幫你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（她在說什麼？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "真的，沒有事情，而且羅德島對幹員的初步問診是免費的......咿呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（呀，完了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（看不見我看不見我看不見我。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "不用說了，我都明白的，現在就送你去醫療部。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "唉，唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "您真的搞錯了鑄鐵姐姐！爸爸媽媽每個月都會給我寄生活費的，還會給我寫信寄照片——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "您聽，聽我說呀——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "呼，呼呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "差一點就被發現了，多虧了鈴蘭的大尾巴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你受苦了鈴蘭，我會報答你的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "夜晚\n訓練中心入口"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "所以泡泡最後，消失了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "是的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "把鈴蘭小姐送到醫務室去以後怎麼找都沒找到她，只好來找您了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "都是我的錯，是我沒有看住她，抱歉，堅雷教官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "請您懲罰我吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "不，不至於......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "泡泡的話，現在應該在宿舍裡休息吧，我和宿管確認過了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "宿管說難得看到這樣乖巧的泡泡，這裡也有你一份功勞，辛苦辛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "謝謝你今天的付出，要是沒事的話，你也趕緊回去休息吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "教官，其實我還有一點疑惑的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "嗯，請說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您覺得我的偵查和追蹤課程上得如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你很優秀，非常優秀，有什麼問題嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我覺得自己這一方面特別欠缺，在追蹤其他人的時候總是失手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我是不是，做得還不夠好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "那些只是，例外。對，例外。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "畢竟現實生活環境和戰場還是有區別的，我想你在戰場上的追蹤能力絕——對沒有問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "是這樣啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "是這樣，沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "既然教官這樣說，我就安心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "嗯嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那我可不可以申請現實生活環境下的偵查追蹤課程呢，我想，對這一方面的學習也是很重要的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "嗯——嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "啊，關，關於這一點嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "今天時間不早了，你就回去休息吧。我這兩天和教官團的其他同事們商量一下，想必能給你一個滿意的答覆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "好的教官，謝謝教官，那我就先回去了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "嗯，一路走好！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "關於這件事，你怎麼看，杜賓教官？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "她好像已經發現一點徵兆了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "我們這邊的案例拼湊一下應該還能應付。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "下一次可就沒有那麼好運了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "相信在下一次之前我們能夠找到解決方法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "只要不讓她學到最具破壞性的追蹤手法，其他都很好安排。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "她要學到了，別說博士，我們也逃不掉了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "至於泡泡那塊，有什麼成效嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "我看過攝影記錄了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你真應該自己去看看監控。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "宿管說，泡泡回去除了洗澡一直窩在宿舍裡，連飯都是請室友帶的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "這一段時間內想必她聽到“鑄鐵”這兩個字就要打冷顫吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "教官您是在叫我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷/杜賓",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你怎麼回來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "杜賓教官您也在啊，外勤任務這麼快就結束了嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "嗯......只是到主艦周邊物色合適的場地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "那可太好了，其實我是想詢問一下，課程可不可以從明天就開始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "關於這件事——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "我和杜賓教官先商量一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（小聲）你辦法多，先想辦法搪塞過去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（小聲）堅雷？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）其實，我和一個深入瞭解鑄鐵的人談了一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）她雖然很驚訝鑄鐵現在的狀態，但給了我一些建設性的建議。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）一會聽我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（小聲）好，拜託了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "鑄鐵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "其實是這樣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "我呢，剛剛和杜賓教官簡單商量了一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "覺得訓練可能不能滿足你的要求了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（小聲）喂，你知不知道自己在說什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）就這一次，信我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您的意思......是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "我知道你有時會擔任博士的護衛，博士也時常會從你身邊溜走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "這是我護衛失職，抱歉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "所以我才更需——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "所以你才更需要從其他方面為博士分憂解難，我說的對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "您是說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你不覺得，博士最近身體不太好嗎？睡眠不是很充足，飲食也不規律，好像還有些輕——微的慢性病症。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "與其繼續精進戰鬥方面的技巧，讓博士健康起來，難道不是一種更好的選擇嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你可以好好思考一下我的建議，晚安，鑄鐵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "晚安......教官......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（小聲）你們哥倫比亞人肚子裡都有那麼多壞水嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）只是些小聰明。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）別愣著了，快走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（小聲）那，真的有效果嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）至少她在思考這件事了，先走吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "（小聲）萬一她又提訓練我們就沒好覺睡了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "教官說得對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我以為博士只需要一個，護衛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "不，是我理解錯了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我以為護衛只需要保證雇主的人身安全就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我能做到更多的，可我卻連想都沒想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "會長小姐原來是這個意思嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我雖然對吃沒什麼要求，但吃得好一些的確會讓生活品質提高許多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "會長小姐好不容易來羅德島一趟，我卻只想著請她吃食堂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "真不應該。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "博士，也是這樣想的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "只是不好意思和愚鈍的我說而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我決定了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鑄鐵",
      "text": "我要拯救博士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
