  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十九关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "嗚唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "她......怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這，這是礦石病發作的徵兆！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嘖，才一星期就......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "礦石病也有急性的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "芙蘭卡，你是哪種？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "怎麼，關心我了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "阿米婭，如果芙蘭卡病逝了，我希望能在羅德島火化她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "喂！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "你很過分哦，雷蛇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "平時老說要傳染我的不是你嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "哈，哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "急性和慢性之分，具體回答起來有些複雜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但至少，米莎她的情況，非常危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這樣下去，在很短的時間內，礦石病就有可能威脅到她的生命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "只能先應急處理一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但對米莎的病情進行控制這件事，刻不容緩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "必須向龍門聲明這一點。事件平息之後，我們必須把米莎接回羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這是我們對任務目標的責任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "她是不是......快爆了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "唉！疼！為什麼要打我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "說話注意點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "如果有一天我快爆了，我一定會努力爬到你身邊的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "對不起！芙蘭卡小姐！以前多有得罪請原諒我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "噗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "先把目標轉移到安全的地區吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "順便，我們後方，發生了些情況。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "你們要幹什麼！！滾出去！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "大家都是感染者，我們不想動粗！別擋路！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "你已經毀了我們的家，現在還要把近衛局引過來嗎！別想過去！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "你......！不識時務的傢伙，快滾開！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "嗚啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "別逼我們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "（要動手嗎？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "（看來他們是跟丟了。現在動手的話，羅德島會暴露行蹤。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "（會不會干擾到任務進程？如果會，後果有多嚴重？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "（有一定影響，但——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "（沒有那麼嚴重吧？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那就幹吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "如果條件允許，救助感染者是羅德島理所當然的任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "哼哼，好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "果然當初選擇跟著你是正確的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那是什麼意思......芙蘭卡小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "沒什麼沒什麼，就是誇誇你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "大概意思是，性格和你很合得來吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "你為什麼那麼懂我呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "大概是因為，你可真煩人吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "該教訓一下這幫為非作歹的傢伙了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "小心那些會在各個建築物間跳來跳去的整合運動感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "除此之外，還要記得保全龍門本地的感染者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "難度不小。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "——但，沒問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "那就，上吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "Dr.{@nickname}，要好好指揮我和德克薩斯哦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
