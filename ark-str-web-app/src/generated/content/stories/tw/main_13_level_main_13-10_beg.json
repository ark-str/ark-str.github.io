{
  "server": "tw",
  "storyId": "main_13_level_main_13-10_beg",
  "groupId": "main_13",
  "stageId": "main_13-10",
  "title": "破碎溫室",
  "storyCode": "13-12",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_13-10_beg.txt",
  "sourceHash": "86e2de358937e8eeab2d151020ed3ba7a756e083d74136dd9a662ce24089404d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "下午好，瑪格達爾。你捧著花的樣子還是那麼漂亮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "謝謝你，漢克。你見到威爾了嗎？我在找他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "他一早訂了花，可是都下午了還沒有來拿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "威爾訂的花？哦，是為了芙蕾達的生日吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "中午他就翹班溜走了，大概是為芙蕾達準備驚喜去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "別擔心，等他被芙蕾達教訓的時候，他會記起來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "你們看上去很憔悴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "我最近晚上都聽到工地這邊有聲響，你們一直沒有休息？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "最近那些魔族佬像是要給誰展示功績，死了命地催大伙日夜趕工，可也沒看到有啥大人物來呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "你運氣真好，被人分配了個好差事，不用受這些罪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "沒想到大伙咬咬牙，居然只用了不到一個月就建成了這些奇蹟！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "我打賭，這東西要是放以前，準會被那些倫蒂尼姆的貴族老爺們全搬進博物館！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "漢克，你明明之前很討厭這份工作……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "……瑪格達爾，世道變了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲憊的市民",
      "text": "（你也得學著討好那個薩卡茲軍官，這對你沒有壞處，孩子。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……謝謝你的建議，漢克，我會考慮的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煩躁的市民",
      "text": "又來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煩躁的市民",
      "text": "最近這些炮聲怎麼越來越近了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煩躁的市民",
      "text": "我聽說不止一伙人想要佔領我們布倫特伍德鎮，可萬一真打起來又是烏煙瘴氣，唉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煩躁的市民",
      "text": "現在這樣大家都和和氣氣不好嗎？只求別影響了我們的工期！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞少年",
      "text": "瑪格達爾姐姐，總算找到你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞少年",
      "text": "那個經常去你家的魔族佬在帶人砸你的溫室！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "什麼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "夠了嗎？我說過這裡不可能藏著那些維多利亞人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "現在可不是你說了算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "這間毫無用處的屋子是你當初力保才留下的，誰知道你藏了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "嘖，我們都該為殿下死戰到底，你的軟弱讓我們一次又一次喪失好機會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "注意你的口氣，僱傭兵，我現在還是王庭軍的成員，這裡的指揮官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "放心，要是我在這裡找到藏著的游擊隊，我馬上宰了你領功，也申請加入王庭軍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "收好那些讓我反胃的厭戰情緒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "那些人的行動已經嚴重干擾了軍事委員會在這裡的安排。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "如果不是你在前線的失利，讓那些人越來越猖狂，頭領也不至於決定倉促完成任務提前交差。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "所以，閉上你的嘴。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "我的溫室……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "不要——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "（噓——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "（不要動，安靜看著。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "唔，唔——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "放鬆，你的手指在流血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "不要試圖掙脫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "（我在救你的命，“園丁”。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "放她過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "她最好真的想對我動手，那樣我砍了她就完事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你對這座鎮子太客氣了，“指揮官”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "靠瞪眼可殺不死我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "嘖，掃興。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "花草對這場戰爭毫無意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "兵工廠，炸藥房，焚燒爐，它們才是你們真正需要的東西。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "放開我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "我很冷靜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "你們找到想要的東西了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你運氣很好，沒有讓我們搜出來什麼東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "那請你們離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "嚯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我還以為你會比工地那些蠢貨更有膽子一點呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "嘖，維多利亞人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "別動，你的手指需要包紮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "我攔不下他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "我在前線……發生了些事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "馬上會有另一個人來接替我的職位，他對小鎮，呃，另有安排。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "布倫特伍德入口西邊兩百米左右的水泥工事有一處缺口，是那些附近遊蕩的游擊隊剛炸出來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "他們不會放棄這個機會，所以我們要在明天早上五點修復那個缺口。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "這些玫瑰還有救，想辦法重新栽好這些可憐的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "如果你對那個缺口好奇，今晚帶上這些玫瑰穿過我們的營地，這是最安全的路徑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "要是有人攔你，就說你在替我送訂單。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "當然，如果能順道放一束花在我的營帳，我會很開心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "有些東西不該被摧毀，“園丁”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "“園丁”不是我的名字，薩卡茲，我的名字是瑪格達爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "呵，那就重新認識一下，我的名字是“鍬子”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……“鍬子”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "記住，瑪格達爾，時間不等人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "他的營帳應該是這個方向……得趕緊把花送過去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "那是？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "你怎麼在這？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "瑪格達爾！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "……宵禁時間你拿著花要去哪？\n這邊是軍營方向，快離開！"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "我……沒事，只是想出來走走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "對了，聽漢克說今天是你的生日，生日快樂！威爾在我這為你訂了花，但一直沒有來拿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "如果你見到威爾，記得提醒他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "芙蕾達？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "你怎麼不說話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "跟我來，這邊不安全。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "啊……這些花？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "……是威爾放這悼念我父親的。這間倉庫我一直鎖著，只有威爾想偷偷喝酒的時候我才會把鑰匙借他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "這門禮炮，這是韋斯特先生為農事節特意準備的？真是壯觀……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "……我對不起威爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "威爾出什麼事了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "剛剛在薩卡茲的軍營裡，威爾被那些魔族佬留下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "他今天提前找到我想準備驚喜。但知道我要進軍營匯報施工進度後，他不放心，就自告奮勇護送我去軍營……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "可那些薩卡茲沒有道理留下威爾……他們從來沒這麼幹過……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "我不知道……我很害怕，我不敢拒絕他們扣下威爾的要求……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "明明我什麼都聽他們的了。我完成了他們交代的所有要求，為什麼還要留下威爾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "為什麼……瑪格達爾，我真的做錯了嗎……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "芙蕾達，也許，也許他們只是留下威爾想問些什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "往好的地方想想，他們還需要威爾繼續為他們賣力呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "是的……那些鬼東西還差一點才建完，他們一定也需要威爾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "我要守在軍營門口，等著威爾出來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪格達爾",
      "text": "芙蕾達……你看到了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蕾達",
      "text": "它剛才……在看著我們？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
