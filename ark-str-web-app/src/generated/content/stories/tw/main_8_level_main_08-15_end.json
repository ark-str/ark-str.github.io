  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "烏薩斯農民",
      "text": "啊啊啊啊啊啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯農民",
      "text": "火！火！燙啊啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯農民",
      "text": "救命！！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孩子",
      "text": "爸爸！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哨兵",
      "text": "怎麼回事！快走，快跑啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "text": "兒子，我的兒子！你這畜生......感染的牲口！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "text": "啊！！火太大了，火太大了！咳，咳，唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "text": "混蛋！！！我死也不會......我詛咒你！！我詛咒你！！！皇帝在上，懲罰這些該死的感染者吧！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "啊......啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "已經不能再回頭了。\n至此，這裡發生的事，除了塔露拉外，無人知曉。\n之後的事情，眾所皆知。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿米婭睜開眼睛。\n她的眼淚還沒乾。但她已經看過了一切。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "怎麼這裡會有隻卡特斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "阿米婭！！當心！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
