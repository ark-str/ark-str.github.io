{
  "server": "tw",
  "storyId": "main_12_level_main_12-07_end",
  "groupId": "main_12",
  "stageId": "main_12-07",
  "title": "火線重逢",
  "storyCode": "12-8",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_12-07_end.txt",
  "sourceHash": "9c9064f7a75f5c5aafa2815de53531247751ea79d7137c1cb32422b24eb6feb1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "這裡變了很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "廢墟，屍體，還有死人身上飄來的源石粉塵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "想必，作為礦石病專家的羅德島，不需要我為各位操心防護問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這場戰爭在不斷催生新的感染者......他們在這種處境下只會更加艱難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "他們突然被丟入了這片混亂之中，對這種殘忍的墜落恍若未覺，無論是疾病的苦痛，還是戰爭的傷痕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "但他們很快就會瞭解這些，加倍瞭解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "我們都能想像得到它會怎樣感染潰爛，人們會在迷茫中死去，或者因憤恨而集結。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "這種憤恨的歸宿，你曾經見過，博士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "整合運動。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "伊內絲",
          "text": "戰爭給了人們例外的藉口，沒有了生活的遮掩，結果也許會更糟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不論是出於何種原因，我們都必須阻止特雷西斯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......還有特蕾西婭。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "......收到。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "看來，我們的同行要暫時結束了，工作就是這樣，總有數不清的瑣事需要你去忙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "那麼，我需要稍稍告辭一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "各位，別偷懶。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "他讓我感覺......毛骨悚然。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "我連當年見到惠特曼警長都沒有這麼覺得噁心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "好啦，各位，都高興點，歡迎來到我們格拉斯哥幫的地盤，起碼是曾經的地盤。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "真不知道我們走後，貝爾德把拳館打理得怎麼樣......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "推進之王，摩根，你們怎麼都不說話？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "因陀羅......我好像踩到什麼東西了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "啊？難道不是哪家養的寵物，又在大街上......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "那是什麼......一隻......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭，別看。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我已經看見了，博士。我在那些來自過去的幻影中，看到過比這裡還要悲慘得多的境遇。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們正是為事態不至於發展到那一步而來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那位戴著禮帽的先生把我們帶到這裡，准許我們在那項交易之外按照自己的意願行動，我們都清楚他的目的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "他知道我們不會坐視不管，他希望這裡的人把我們的行動歸功於他服務的公爵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但是我不在乎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不在乎她想怎麼利用我們，我不在乎她希望積累什麼樣的名望。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不在乎這會不會影響其他哪位公爵對人心的爭奪，又會迫使他們對我們採取什麼行動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我只是不能坐視不管。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這不是與我們無關的某個國家，某個城市，某個街區的災難。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這發生在每一個活生生的人身上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "信任向來是脆弱的，一旦崩塌，想要重建便更難。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "快點，博士，我隨身帶了些藥品，雖然不多，但我們仍需盡己所能。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "好，這樣應該就可以了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "對不起，我不是個專業的醫生，這只是些最基本的應急處理。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "穩定你的礦石病感染症狀，防止傷口進一步惡化，現在能做的，也就這些了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你需要休息與加強營養，剩下的就得看運氣了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "需要我們送你回家嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "不，不，不要！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "我只是餓昏了頭，在路邊睡了一會而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "你們......你們想要什麼？我沒別的東西了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......什麼也不需要。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "什......什麼也不需要？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "回去吧，先生。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（這是些吃的，藏好，別被其他人發現。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "你，你們......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "好的，好的，我得離開這裡......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（你餓得太久了，別吃得太急，要先慢慢讓身體機能恢復。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "我知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "重傷的市民",
          "text": "......謝謝。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伊內絲",
          "text": "阿米婭，在盯著我們的人有很多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊內絲",
          "text": "他們之中，大部分不懷好意。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊內絲",
          "text": "有兩組人已經在籌劃行動，他們在準備燃燒瓶。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但同時，那些絕望的人也發現了我們，那些躲藏在黑暗中的，已經病得奄奄一息的人們也發現了我們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "僅僅是我們在這裡，或許已經足夠讓他們重新燃起一點點希望。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "劇烈的崩塌之後，任何的重建都必須小心翼翼。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是的，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們需要的不是人們對我們的信任，我們需要他們......重新建立對彼此的信任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這才是一個社會重新運轉的基石。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伊內絲",
          "text": "有人正在接近。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "沒關係，我站在這裡，我會站在你們身前。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "這是屬於我們的街道，我們要把她從混亂與仇恨中奪回來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "無論是誰，讓他們放馬過來。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "小心，要來了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "等等！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "你是——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "（別這麼大驚小怪的，漢娜，小心我真的揍你一頓。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "（你們太招搖了，你們想成為所有人的目標嗎？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "（快，跟我來。）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "饑餓的暴徒",
          "text": "他們要跑了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "憤怒的暴徒",
          "text": "該死，格拉斯哥幫的人搶了先！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "饑餓的暴徒",
          "text": "圍住他們！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伊內絲",
          "text": "別擋路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "伊內絲女士，別對他們動手，暫時不要。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "他們其中的不少人......我都認識。他們只是被恐懼折磨得發了瘋。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "這還不至於讓他們以生命做代價。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "（走我們以前溜去打桌球的那條小路，門板還在原來的位置。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "（好的。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "（貝爾德，我們......回家再見。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "跟我來！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "憤怒的暴徒",
          "text": "快！快點，別跟丟了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "饑餓的暴徒",
          "text": "我......我已經好幾天沒吃飯了，我沒辦法跑......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "憤怒的暴徒",
          "text": "那就*維多利亞俚語*滾開，有膽子就去吃死人肉吧，別拖累我！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "雷德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "憤怒的暴徒",
          "text": "想找麻煩嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷德",
          "text": "那些人是誰？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "憤怒的暴徒",
          "text": "啊？還能是誰，格拉斯哥幫的那些混蛋！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷德",
          "text": "格拉斯哥幫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "憤怒的暴徒",
          "text": "你是想一起幹，還是讓我幹掉你？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "雷德",
          "text": "不，我應當見過他們，那個穿制服的人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷德",
          "text": "看來這裡的情況比我預想的更複雜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雷德",
          "text": "必須加快行動了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "今天裡面是不是比以前還要吵一點？又有哪裡起火了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "需要我去看看嗎，長官？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "如果火勢蔓延起來......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "那也不關你的事，丫頭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "幹好自己的活，別讓我抓住把柄。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "在這裡可沒人護著你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "將......將軍！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "將軍！您怎麼親自來了這裡？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "沒有什麼需要您擔心的事情，一切都在掌握中！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "曼弗雷德並沒有理會薩卡茲士兵的報告，他只是走到封鎖區的高牆下，遠遠望著封鎖區裡的建築。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "有......有什麼異常嗎，將軍？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "戰爭仍在順利進行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "明椒，這些天，你看到了什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "這些人，一直在自相殘殺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "不，說不上真正的自相殘殺......他們只是......很害怕。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "恐懼和懷疑會分化人們，契約、習俗與道德在極端的環境下很快就會瓦解。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "曾經的卡茲戴爾，就如同這樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "卡茲戴爾......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "所以那兩位站了出來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "您是指......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "那你覺得，用什麼能夠團結人們？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "也許是......耐心？我們可以試著勸說，或者用自己的善意來打動他人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我覺得，只要有足夠的時間......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "她失敗了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "這些東西能構築的紐帶都太脆弱了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "而他告訴我，最有效率的......是仇恨。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "曼弗雷德淡淡瞥了一眼年輕的雇傭兵女孩，她緊張得大氣都不敢喘，只敢緊緊盯著自己的腳尖。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "你一直在把自己的物資分給封鎖區裡的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "不，不是的！那是個薩卡茲！我以為......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "什麼！你怎麼敢——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "服務於維多利亞的薩卡茲更該死！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "將軍，您放心，我馬上就......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "繼續吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲士兵",
          "text": "......將軍？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我們現在還不能讓裡面的所有人都餓死。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "他們......還能為軍事委員會派上更大的用場。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "這裡......和以前沒什麼不同。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "摩根的那些塗鴉也還在。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "現在看起來，當年我的水準真是糟糕。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "現在也沒有好多少吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "漢娜，找架打嗎！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "貝爾德和推進之王看著眼前吵鬧的兩人，對視一眼，一起笑著搖了搖頭。\n如果不去理會被封上的大門，釘上木條的窗戶和他們神色中的疲倦，這一切簡直和當年沒什麼變化。\n然而，每個人心裡都清楚，“大家都沒變”不過是一種自我安慰，一種錯覺。\n已經過去的每一分每一秒都無可置疑地在他們身上留下了痕跡。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "貝爾德，好久不見。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "是啊，維娜，好久不見。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "知道你還能活蹦亂跳，算是我這些日子收到的最好的消息了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "我的命一向很硬。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "那倒確實。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "維娜，能看到你回到這裡，我也......很高興，比你能想到的要高興得多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "我一直相信你們會回來，畢竟，當年“揍歪下巴”的招牌是我們一起掛上去的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "只是，如今的處境讓我很難露出笑容。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "我也知道，你不光是為我們而來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "五年前你們離開得很匆忙，諾伯特區當時已經成了一座獵場，那些雜種時刻想要了你的命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "當時......我還沒有做好準備。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我不想連累其他人，我只能離開。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "所以，現在你既然再次站在了屬於我們的街道之上，你一定做好準備了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......我是這麼希望的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "羅德島的幾位需要在這裡找到那架薩卡茲的飛空艇，我作為羅德島的幹員也會協助他們的行動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "但我也依然是格拉斯哥幫的一員。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我會帶你們走出困境，一如以往，這是我對你們的責任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "哈，你真的還是老樣子，維娜，一點也沒變。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......哈，一如既往嗎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "只是，我不知道......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "貝爾德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "卡鐸爾",
          "text": "貝爾德，我們的補給並不充足。更何況你一次帶來了這麼多人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "卡鐸爾",
          "text": "你是想吃完這頓飯大家就散夥嗎？還是指望我去搶了哪個防衛森嚴的碉堡？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴菲恩",
          "text": "別這麼說，卡鐸爾。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戴菲恩",
          "text": "只是，我們的儲備確實......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "請放心，我們攜帶了一批口糧，甚至還有些富餘。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "戴菲恩",
          "text": "嗯，這個數量......說不上多，但能解我們的燃眉之急。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們可以一起改變這個區塊的現狀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "只要我們能團結起地塊上的大家......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "卡鐸爾",
          "text": "哼，團結？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "卡鐸爾",
          "text": "小卡特斯，“團結”沒那麼簡單，但你們大可以試試。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "卡鐸爾",
          "text": "但願......你們確實是那個契機。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
