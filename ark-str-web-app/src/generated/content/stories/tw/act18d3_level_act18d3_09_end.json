{
  "server": "tw",
  "storyId": "act18d3_level_act18d3_09_end",
  "groupId": "act18d3",
  "stageId": "act18d3_09",
  "title": "篤信者",
  "storyCode": "SV-9",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act18d3/level_act18d3_09_end.txt",
  "sourceHash": "825f55da41e37106a4ae30b7a26a51d97e831180a83aa9cd157c89f3a092b872",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "四處都在漏水。了結它，我們得走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "為什麼你們這種瞎了眼睛的庸人能苟活？為什麼我這樣為事業投入了生命，專注於偉大目標的人......會失敗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "盲目、停止流動的阿戈爾拴著的寵物......你們對科學和未來......毫無助益！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "我已......幾近真理！為什麼我要死在這裡？！而你們......卻能逃脫你們應得的酷刑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "我走了這麼遠，我的意志和肉體，都快要撕碎人類軀殼的束縛了！為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "為什麼？為什麼？！為什麼！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "閉嘴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "阿戈爾......必定毀滅。你們什麼都不剩......什麼都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "蠢材。我活著，我就是阿戈爾，我活著，阿戈爾就活著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "......你......但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "諷刺......諷刺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "你是不一樣的。呼......你註定不同......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "你很清楚。你的命運已定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "不要再廢話連篇了。請你乖乖死掉，對你我只剩下這個請求。我很真誠的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "我詛咒你們......我要詛咒你們......直到陸地被淹沒......你們會像鹽粒一樣，逃出大海......最後還是被大海溶解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教？",
      "text": "在你們屍骨堆砌的貧瘠荒原上，我們鼓動不歇的潮聲會在蒼白夜空下浸沒大陸！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "總算死了。這事情也算是結束了......我親手殺了它。沒我想像裡那樣令人高興。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "比起他們對我做的這些，真是太輕了。殺了一個，還有兩個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "呃，頭又有點暈了。我是怎麼過來的？簡直就像一直在做夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "鯊魚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "畢竟......沒法一直醒著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我們抓到了他們的觸手，現在順著摸過去，把他們連根拔起，一定能找到治好你的辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "沒事。現在它們控制不了我，我感覺很好。自由的感覺......竟然是在這時候。我快飄起來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "但是，隊長，你們說的我都聽到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "它是說我們也會變成海嗣？隊長，你會變成特別厲害的那種？還挺強的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "不會的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你和它們可太不一樣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "希望我沒有因為自己的獨斷專行而害了你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "回答我幾個問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我有問必答。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我們體內流著海嗣的血？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你來這裡是為了確認幽靈鯊身體問題的原因。你之所以要吃那一下是為了知道為什麼海嗣想找我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你早就知道這裡不止主教一隻海嗣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你知道我們那場自殺一樣的決戰的最後，我做了什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我們贏了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我也不知道。我與阿戈爾失去了聯繫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......我們是不是阿戈爾的棄子？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "行了。走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "真爽快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "沒什麼好磨蹭的。我畢竟是個深海獵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......難道二隊的人不這樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "深海獵人都這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "這裡快塌了，而且......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "嘁，太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "斯卡蒂！拿出點力氣來！這裡就只剩你胳膊腿都沒破皮了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "還要怎樣......我手都撕麻了。你上次用手伸進它們的嘴把它們撕成兩半是什麼時候？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "三秒前。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "剛剛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "不行。只要那具身體還在那......恐魚就不會停。它在呼喚它們。那是個錨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "得毀掉那具屍體才行......填埋可不夠......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "就憑你這破了個大洞的身子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "你們可以——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "獵人們，快走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "怎麼是你？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "之後再說！Mon3tr，去！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
