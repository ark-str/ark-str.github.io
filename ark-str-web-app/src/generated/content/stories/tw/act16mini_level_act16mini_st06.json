{
  "server": "tw",
  "storyId": "act16mini_level_act16mini_st06",
  "groupId": "act16mini",
  "stageId": null,
  "title": "被踩住的影子",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act16mini/level_act16mini_st06.txt",
  "sourceHash": "6265c5c0d532b39ee3a031dd07ba15240e9371a441fb5ac1f97c07a1beb97de2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "廣播喇叭",
      "text": "……豎起長耳朵和短耳朵的司機朋友們，以上是六小時內的發車指導消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播喇叭",
      "text": "看好天災預報，注意行車安全，不追野生動物，早早收車回家……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "看起來還不錯嘛，老傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "你該慶幸你的最後一程是在我手裡度過的，換了別人，可能就沒這個本事把你修補好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "你就得帶著反裝甲砲轟出來的洞，在荒野裡破破爛爛地躺著，等工程隊過來進行切割，把有用的模組拖回廠裡重新組裝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "而我呢，就會因為該交的車沒交上，把事情搞砸了，被人笑話一輩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "……我本來也該被人笑話一輩子。要是她被人打死的時候，有人發現我就躲在這輛車底下的話……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "嘖，那種事不會再有了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "好了，現在就剩下一個問題了，鋼鐵蘿蔔城這邊熟人有點少，我得找個人教我填事故報告書……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "哎，別按鈴了別按鈴了，這輛車不發車，你走錯了——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "——膽小鬼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "呃……嘿嘿。看來我沒認錯車。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "雖然沒了那些花俏的裝飾，還有那種車廂裡像打過一仗的感覺，反而有點陌生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "總之，看到這輛車沒事就好！我覺得，這應該也說明萊伊小姐和溫米妹妹沒出事吧……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "哈，算是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "那、那個，那我打聽一下……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "萊伊小姐最後找到她說的那個東西了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "當然沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "真對不起！我不是故意要提起你們的傷心事的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "沒事，要傷心也輪不到我傷心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "不過，劫車的也確實不怎麼傷心就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "說起來真是見了鬼……她半路上莫名其妙失蹤了，又莫名其妙出現在了我們停車避難、等待小型天災過去的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "就像天災裡被狂風捲走幾千公里，暈頭轉向的傻羽獸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "呃，那她……不會把自己要找的東西忘了吧？我知道有人跟別人比賽原地轉圈，結果把自己轉暈，摔壞了腦袋……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "比一般的摔壞腦袋還可怕。她說自己已經看過巨獸了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "呃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "還說見到的不是自己要找的那隻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "最後還說，巨獸已經告訴她了，她要找的東西真的不存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "我……我真替她傷心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "是嗎？我一般管這個叫“想通了”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "不過，後來我們確實繼續往咧嘴谷開了。好不容易跑了那麼遠，怎麼可能憑劫車的一句話我就回頭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "……然後呢？你們看到什麼啦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "……超級酷！可惜那裡太危險，你這個膽小鬼一輩子都別想看到啦，哈哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "真的，勸你千萬不要去。要不是我技術高超，緊急能力又強，這輛車根本不可能從那裡開出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "往這裡來的路上，我們開一兩個小時就得停下來休息，等這老傢伙散熱……工會說它該“規範化”了，確實有點道理。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "唉，二十年了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "你……開車二十年了？真看不出來……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "多謝你對我技術的“認可”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "不過我說的只是……認識這輛車二十年了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "對了，膽小鬼——我的婚禮請帖呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "欸？呃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "那個，你們可能已經錯過婚禮了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "……咳，其實我正在蜜月旅行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "……其實本來蜜月旅行已經結束了，就在十分鐘之前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "原本鋼鐵蘿蔔城是我們的終點站，但是進入關口之後，我看到了你的運載車，突然就……想繼續旅行一段時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "喔……你們開的是那輛剛停在不遠處的小貨車？我還以為是哪個冒失司機送貨結果停錯了層，沒進物流通道呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "不過，真奇怪……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "哈哈，我們開的確實是送貨車沒錯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "其實那天從關口出來，我們找到了她自己的小貨車，本來是想回頭繼續辦訂婚儀式……結果不知怎麼就把車開去了登記處……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "然後開去露天廣場就地辦了個儀式，再然後就開上了蜜月旅行的路……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "*雷姆必拓粗口*，我總算想起來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "怎怎怎怎麼了……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "那天那個跟著你一起跑的人，我想起來在哪裡看過她的臉了！就是這個運貨車上的商標！就是這張大臉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "我就記得哪家五金行本來應該有賣舊型號安全閥的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "噢，她之前確實想讓自己失蹤……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "你猜為什麼我們得開一段停一段？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰里",
      "text": "對對對對不起！我、我替我家那位向您誠摯道歉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "啊，我開玩笑的，其實不能怪你們。這車本來就該升級啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "不過，現在把最後一個零件補上，事故報告倒是可以少編十幾行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "快點，你們這運貨車上有貨嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "小溫米，還沒好嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "它……還在冒火花……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "……我很快就能掌握用法，再給我一點時間！等學會了怎麼用法杖，我就從這個小房間裡出來！……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "你要是實在掌握不了，也可以出來讓那邊的術師大叔再教一遍哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "可是，蘭娜姐教我修車，還有爸爸教我做菜的時候，我都學得很快……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "……我還以為阿蘭娜去還車，你會跟她一起去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "不行哦，暴行姐，你不是說要趕在今天中午十二點之前辦完別的事，才來得及上你們的大礦船嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "哎呀，我也可以騎著我的摩托車，送你們去下一個停靠點嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "謝謝你，暴行姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "可是，我總是要下車的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "哇啊——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "哇，暴行姐，妳怎麼靠在門上？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "這個嘛，簡單來說，身為安保人員，有時候要頂著門嚇唬人，習慣了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "……風怎麼這麼熱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "嘿嘿，我稍微掌握一點點法杖的用法啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "真的學會了？真厲害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "……不過示範到這裡就可以了，再加熱下去，我就要著火了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "我們就坐在這裡等阿蘭娜吧。她到了之後，我帶你們去羅德島本艦，給你的礦石病想想辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "坐在座位上等人的感覺，好熟悉啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "車站等候區裡也是這種鐵皮椅子，冰冰的，怎麼也摀不熱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "要是我以前就會源石技藝的話，就可以偷偷地把椅子變得暖暖的，讓爸爸的骨頭不那麼痛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "……以後還會有機會的，小溫米。在找到你爸爸之前，你還有時間來好好練習怎麼使用法杖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "到時候，你就能按照自己的心意，控制自己的力量了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "是嗎……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "可是萊伊姐最後也沒找到巨獸，我們最後也沒真的開到咧嘴谷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "溫米等爸爸等了這麼久，最後應該也……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "……這趟旅途，真的好長好長啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "呼，總算是趕上了。多虧那個膽小鬼，寫文書報告真有一套。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "——哎呀，這根法杖真漂亮，不愧是我挑的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "怎麼樣，小鍋蓋，準備好了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "蘭娜姐！我表演給你看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "好——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "這一下子也太熱了吧？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "暴行，她這麼用源石技藝，真的沒事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴行",
      "text": "嗯，沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "那就好。哼哼，我早就看中這柄充滿雷姆必拓工業美的法杖了，就知道它適合我們的小鍋蓋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "怎麼樣，還不誇誇我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "蘭娜姐真好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "蘭娜姐……真好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "只是，就算早早給你買回來，也沒人能教你用。再說，我也不能把訂單收貨地址寫成“運載車上”，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "走吧，接下來去幫你治病。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "讓你老爸到時候看到一個超級健康，源石技藝還超級厲害的小鍋蓋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "蘭娜姐，我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小鍋蓋",
      "text": "我……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "哎，你怎麼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "……算了，哭吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "抓著我的衣服哭，我也不計較了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "text": "至少這趟旅程走到最後，你不是兩手空空啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "採購幹員",
      "text": "確認一下啟程前的物資補充清單，把源石燃料劃掉。燃料儲備量已經非常充足了，都快爆倉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採購幹員",
      "text": "幹員個人訂單走這邊……誰又託信使送了這麼多胡蘿蔔？最近廚房裡這股甜味簡直是揮之不去，我真的受夠了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採購幹員",
      "text": "這一箱是工程部訂購的精煉溶劑，這一箱是可露希爾為新業務準備的實驗材料，你好阿米婭，你好博士，這一箱是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採購幹員",
      "text": "等等，阿米婭小姐？博士？你們怎麼站在這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊，不好意思，我們妨礙到採購部的工作了嗎……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採購幹員",
      "text": "不，沒事，只是覺得……你們想看風景的話，還是甲板上視野比較好，物流通道附近太吵了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊，其實這段時間習慣了充滿噪音的環境，反而覺得這樣吵吵鬧鬧的格外親切……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士，我們稍微再往角落裡走一點吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你的檢查結果怎麼樣，阿米婭？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "請不要擔心，博士。我的身體指標沒有什麼變化。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "畢竟，我們和那些活性源石晶簇保持了安全距離，防護措施是足夠有效的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不過，看著活性源石就在眼前生長，將大地的裂痕撐開……的確會感到非常恐怖。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "給那種地方取名“咧嘴谷”，確實很雷姆必拓。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "現在聽到這個地名，感覺已經很難笑出來了……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不過，也有可能大家給它取名“咧嘴谷”的時候，那一帶還沒有被活性源石覆蓋，只是有一道天然裂谷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "畢竟，萊伊小姐很篤定，自己小時候一定到過那裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但是十幾年裡，快速生長的源石把那一帶變得面目全非，連萊伊小姐也完全認不出來了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "覺得遺憾嗎？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "嗯，沒能真正開到咧嘴谷，只是遠遠看了一眼，就不得不掉頭返回，有種……",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "……準備去郊遊結果當天下起了暴雨的感覺……",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "……博士，不要笑啊！",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        },
        {
          "label": "覺得害怕嗎？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "嗯，如果我們不是碰巧從高地接近咧嘴谷，碰巧那天能見度很高……也許我們真的會被源石晶簇追上，或者誤入其中。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "有時候我會想起……",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "它們在感染者身體內部，也是這樣不斷繁殖的。這片大地上那麼多的感染者，其實早就被它追上了。",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "對了，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "萊伊小姐所說的“巨獸”……您覺得是真的嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "據我所知，巨獸是真實存在的。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "她能躲過那場小型天災，總得有個原因。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那樣就太好了……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "雖然我們沒能開到目的地，但是，萊伊小姐並不是只做了一場夢而已。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "採購幹員",
          "text": "博士，這是您的物品。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我的？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我不記得自己最近有從羅德島發出過採購訂單。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊，這是我悄悄為您準備的，博士。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "好重……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "呃，是一個小型生態箱……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那天我經過市場的時候突然想起，當年博士似乎對雷姆必拓各式各樣的生命都很感興趣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士帶著我回到這艘艦船上的時候，回頭望向荒野的神情……非常孤獨。雖然那時我還很小，可我能明白，那種感覺是孤獨。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "所以我很想把雷姆必拓的一切縮小，保存起來，送給博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "至少當時的我認為，博士會覺得孤獨，是因為這艘艦船有點冷清。也許多一些小生物，博士會更開心一點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……當然，現在羅德島建好了植物園，資料庫裡的生物檔案也很充實。對於博士來說，這個小小的生態箱應該派不上什麼用場了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不過，我還是想滿足自己小時候的願望。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "謝謝你，阿米婭。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那時我的狀態，是不是就跟現在的你差不多？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "欸？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不、不太一樣吧……我可一點都不孤單啊，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "只是回到這裡之後，思緒一下子就沉重了起來。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們要繼續為前往維多利亞做準備了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "戰鬥，治療，阻止災難，拯救生命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "許多精英幹員需要了斷的回憶，還有……凱爾希醫生不許我用來稱呼自己的那個頭銜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……有人曾經對我說過。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這條路不是一個人能走完的，也並不是為了一個結果、一個答案而走下去的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "有我在呢。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "這麼悲觀可不像你。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊，請不要擔心，博士，我沒關係的。我也沒有有為自己傷感的意思。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "只是，也許正因為這條路沒有終點，人們才會在一些時候，想要抓住別人的手，或是向別人伸出手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "因此，生命有限，生命存續。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "走吧，博士，我幫您把生態箱搬去辦公室。整理思緒的時間已經足夠了，需要我去理解和學習的東西還有很多很多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "而且，還有一位剛剛通過測試的新幹員，我想去祝賀她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "雖然，如果按照她問我的問題來說……羅德島是不需要一名探井人的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "沙地獸",
          "text": "（嗅嗅）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "盯著生態箱的這個東西是……萊伊的沙地獸？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯，長得很像她從天災之後，一直抱在懷裡的那隻。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……等等，生態箱裡的小鼷獸，難道是沙地獸喜歡吃的東西？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "快回來，沙地獸。不能吃博士的東西……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "……你們好，阿米婭，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你好，萊伊小姐。我聽說入職測試非常順利，恭喜你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "謝謝。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "我拿到羅德島的身分牌了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "上面有編號。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是的。萊伊小姐，有什麼顧慮嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "沒有。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "礦工們進入礦井的時候，也會拿上自己的號碼牌。這樣，很容易數清楚誰沒有回來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "不過，探井人是臨時找來的，沒有號碼牌。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "這張身分牌，我很喜歡。謝謝你們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊，不用謝……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這其實是一家企業該做的事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "而且……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……如果你希望的話，羅德島日後也可以成為你的家。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "你看見萊伊驀地抬起頭，靜靜地注視著阿米婭。\n就像幾天前你們在街道上與她擦肩而過時，阿米婭感受到的那道視線一樣。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "對了，萊伊小姐，你為什麼突然想要來羅德島……當探井人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "你們幫了小鍋蓋。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "我覺得，我也應該幫她。我總是忘不了那天的事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "以及……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "我想要一個答案。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "當困在黑暗中幾百年的巨獸起身，問我究竟想要什麼的時候，我……只拜託它把我和沙地獸們送去安全的地表。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "在那一刻，我突然不覺得遺憾了，好像見到它本身就已經足夠了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "但是，我還是想知道，那個時候，為什麼我會那麼嚮往那道亮光。它對我來說，究竟意味著什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那個時候？萊伊小姐，你說的是……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……萊伊小姐，你是在對我發問嗎？為什麼？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "你很快意識到，萊伊在看著的並不是阿米婭。不完全是。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "“巨獸”。我的幻覺。十幾年前，我在咧嘴谷遇到了它。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "當時我正跟著一支獵人的隊伍。風沙很大，天很黑，我們迷路很久了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "我還沒有長高，只夠看到周圍的人，很多把獵獸弩。後來，我走不動了，也什麼都看不清了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "最後，我只記得自己看到一個巨大的影子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "還有……一道純白的光束。纖細，但是穿透了沙塵的光束。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "我聽到溫柔的低語，越過了吼叫著的風。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "突然之間，我就不再害怕了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "……也許只是我做的一個夢吧。之後我記得的事情，就是在一頂陌生的帳篷裡醒來。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊伊",
          "text": "但即使是夢也好，我想再次見到那個一直陪伴我生活的幻覺……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……阿米婭。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士，我……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "萊伊小姐已經走了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "抱歉，我剛剛……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……我看見了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "看見什麼？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……我看見，剛剛被挖掘出來，用帆布蒙著的羅德島。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "巨大的影子，在雷姆必拓長滿源石的荒野間緩緩移動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "薩卡茲的工程隊，纏角覆面，掩藏身分。工程車亦載著火砲，築城的法術亦鑄成刀劍。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "風沙很大，前路昏暗，長隊跟隨著羅德島的轍痕前進。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這條路會走很久很久。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可是……為了挽救眾人於苦難，為避免殘酷的未來，這是我們最大的希望。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "在沙塵裡……工程隊與雷姆必拓當地的一隊獵人擦肩而過……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看見……她向受困的陌生獵人們，伸出了援手……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "等一等，阿米婭……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你在……透過誰的眼睛看這一切？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "“因為啊，我想，如果人人都可以回到自己的家就好了……”",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……博士，我能做到嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "您願意相信我嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
