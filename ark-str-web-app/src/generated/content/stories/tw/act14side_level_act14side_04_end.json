{
  "server": "tw",
  "storyId": "act14side_level_act14side_04_end",
  "groupId": "act14side",
  "stageId": "act14side_04",
  "title": "立雪求道",
  "storyCode": "BI-4",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act14side/level_act14side_04_end.txt",
  "sourceHash": "9ac64d4341b78cc01a2b1630ad0be3a0698a18aade5d1e7b9f125f68f34b9b8e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "老爺，喝口熱水吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "從昨天開始您就滴水未進，走了這一路，之後還要參加狩獵，這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "不必了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "這是我的決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "不要讓我說第二次，角峰。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "別再說了，角峰大哥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "老爺的脾氣你應該最清楚，明知老爺肯定不會接受，又何必這樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......至少我得試試。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "老爺他......太冒險了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "風險與機遇並存，一直不都是這麼過來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "我們只需要聽老爺的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏斯",
      "text": "真冷。這雪是不是越來越大了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "真慢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "要我們兩家一起等著他，好大的排場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "他一路步行而來，這倒確實不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "真稀奇，你竟也會誇他？聽說這一路上，恩希歐迪斯是被交口稱讚，受歡迎得很啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "阿克托斯，你可要小心點，說不定再過幾天，耶拉岡德最虔誠的信徒就要從你阿克托斯變成他恩希歐迪斯了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "風涼話就免了，菈塔托絲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我雖不信任恩希歐迪斯，但他若做得對，我便說對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "如果你把我喊過來就是為了說這些，那就恕我不奉陪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "我也沒有那麼閒，阿克托斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "我只是要提醒你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "提醒？有什麼事是需要你菈塔托絲來提醒我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "你認為沒有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "阿克托斯，逞口舌之快對我們都沒有好處。在當下，我們兩家之間才是最牢固的盟友關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "逞口舌之快的恐怕不是我，菈塔托絲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我不喜歡你和恩希歐迪斯的那種彎彎繞繞，我一向只看行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "你只看行動，那正好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "那我們就談談兩天前的那場爆炸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "怎麼，難道菈塔托絲你要承認那是你布朗陶家所為？哼，我可不信，這事不是你的風格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "還是說，你知道主謀是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "......我要是說我知道呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "——此話當真？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "絕無虛言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "阿克托斯，你要不要猜猜，我們的這位援兵究竟會是什麼人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "莫希，莫希！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "人呢，跑哪兒去了......？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "夫人。您找我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "我找沒找你，這還用問嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "平時你不是挺機靈的，怎麼偏偏在這種時候瞎跑！我明明說了這次狩獵一定要好好準備......算了，你準備得怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "我可實話和你說了，莫希，你是我手下最可靠的戰士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "這次我能不能給布朗陶家爭光，讓菈塔托絲那個臭女人沒話可說，可全都看你的表現了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "夫人，恕我直言......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "你有什麼想說的就說，別扭扭捏捏的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "屬下認為，夫人若是真的有心在這次儀式上有所表現，令菈塔托絲夫人對您刮目相看，只將目光放在狩獵上，或許還有所不足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "這我也知道......但除此之外還能怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "菈塔托絲那女人總會把一切都想好，半點空間也不給我留。哼，就算我承認她比我聰明一點點好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "但我也......我也不是個廢物！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "所以這次不管怎麼樣，你都一定要給我大出風頭，莫希！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "讓我們一起壓一壓菈塔托絲那個臭女人的氣焰，我一定要讓她好好瞧瞧我的厲害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......我明白您對布朗陶家的心意，夫人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "既然如此，您就更不能只盯著狩獵本身來考慮這次的行動了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "那你說說，我們還能幹點什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "如果夫人相信我的判斷——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "你這說的什麼廢話，我不信你還能信誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "感謝您的信任，夫人。那麼就請將此事交給我吧，我有一些想法......但需要見機行事，目前我還不能妄下結論。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "以及夫人，為了行動能夠順利，此事最好也不要對尤卡坦老爺提及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "連尤卡坦也不行？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "也對，那傢伙總是當我是個小姑娘一樣攔著我做事，還和菈塔托絲告密，別以為我不知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "那就全都交給你了，莫希！一定不要讓我失望！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "當然，請您放心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......屆時，屬下一定會讓您大出風頭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "“響鈴之音來自祂最澄澈的心靈，愛祂的人無不垂首聆聽，而耶拉岡德注視著所有虔誠的子民。”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "——聽。整點的鈴聲剛剛響起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "您險些就來遲了，恩希歐迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "請您原諒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "通向真知的路總不好走，這一定也是耶拉岡德給予希瓦艾什的考驗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "從圖里卡姆出發，步行來到喀蘭聖山，確實是辛苦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "但......希望您真的能夠找到正確的道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "有聖女大人的這句祝福，前路已然明朗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "正如此刻，我正朝耶拉岡德的教誨而去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "您的口才當真出眾，恩希歐迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "過譽了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "這次竟勞聖女大人親自接見，誠惶誠恐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "恩希歐迪斯大人擺出如此陣仗，我又怎麼敢駁了您的面子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "大長老現在何處？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "大長老在做祭拜的準備，我就出來迎接您了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "這次聖獵，我將遵循耶拉岡德的旨意，與各位共進退，完成這場儀式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "您是說......您要親自進入獵場？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "怎麼，恩希歐迪斯大人也認為我的決定過於輕率嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "......絕無此意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "我只是感慨——看來聖女大人已逐漸有了身為三大家族統領者的自覺。這是謝拉格之幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "只是做我分內之事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "侍女",
      "text": "聖女大人，恩希歐迪斯大人，聖獵即將開始，請儘快移步......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......時候是差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "請隨我來吧，恩希歐迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "聖女大人請。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "恩希歐迪斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "有何吩咐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不論您的路是否走對，謝拉格總有它自己的方向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "沒有人能夠替所有耶拉岡德的子民做決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "您所言......亦正是我所想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "功過是非自有他人評判。事到如今，義理俱成，我斷無退卻之理。我之所為......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "——不過盡人事罷了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "耶拉岡德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "本代聖女在此宣誓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我將帶領謝拉格最優秀的戰士，揪出躲藏在群山之中的山雪鬼，將其消滅，為謝拉格帶來安寧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "耶拉岡德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我阿克托斯，將一如既往，帶領我佩爾羅契家的戰士，跟隨聖女揪出躲藏在這群山之中的山雪鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "並且帶回最豐盛的獵物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "耶拉岡德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "我菈塔托絲，將一如既往，帶領布朗陶家的戰士，跟隨聖女追擊躲藏在這群山之中的山雪鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "並且帶回最精美的獵物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "耶拉岡德在上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "我恩希歐迪斯，將一如既往，帶領希瓦艾什家的戰士，跟隨聖女圍剿躲藏在這群山之中的山雪鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "並且帶回最猙猛的獵物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "願信仰歸於耶拉岡德，繁榮歸於謝拉格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大長老",
      "text": "......願信仰歸於耶拉岡德，繁榮歸於謝拉格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三家家主",
      "text": "願信仰歸於耶拉岡德，繁榮歸於謝拉格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "在場所有人",
      "text": "——願信仰歸於耶拉岡德，繁榮歸於謝拉格！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "各位，清點行裝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我們出發！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
