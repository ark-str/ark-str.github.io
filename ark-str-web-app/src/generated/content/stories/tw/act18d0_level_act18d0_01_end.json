  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act18d0/level_act18d0_01_end.txt",
  "sourceHash": "c7c602432fad4dff135ec72f05f8db9d0ce61ae1f93b02ad5d71b7b4923cd0ac",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "1下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二十二年前\n3:09 P.M.  天氣/晴\n薩爾貢中部，伊巴特地區"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "確認回收目標，在其他小隊聯手堵截我們之前，離開這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "......明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "這裡是行動隊，高級行動顧問已經回收了“沙卒”小隊的倖存者及目標物品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "......收到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "顧問，偵查隊已經確保路線安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "那麼，出發吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "唔，艾利奧特先生，請把那個箱子給我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少年抱緊了手裡的箱子。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "......顧問？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "隨他去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "恕我直言，我們應當確認目標物品是否完好，並且保證“無論什麼情況下”，它都在我們的掌控之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你覺得他會逃跑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "不，當然......好吧......聽您的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵A",
      "text": "唔，為什麼停下了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵B",
      "text": "好像拋錨了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "怎麼回事？術師呢，來檢查一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "不會是沒燃料了吧......離開據點的時候沒有人檢查？誰負責的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "是頑錘小隊的J5負責檢查載具的，不過他們全隊都去偵查隊了，怎麼搞？要不要聯絡他們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......艾利奧特。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "保護好那個箱子，低下頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "什麼東西爆炸了——唔啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "偵查隊！？喂，聽得到嗎？讓你們的術師停止施法！是我們，是我們啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "Mon3tr。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "你、你手裡那東西——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（歡快地抖擻身體）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "不，不要著急。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "保護好這個孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（回應）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "嘶——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "到底、到底怎麼了！他們不是和你一起的嗎！？不是來幫我們的嗎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "小心些，Mon3tr。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（不滿）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "該死！分頭行動就他媽是個幌子......！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "河刃小隊注意，河刃小隊全員注意！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "偵查隊已經在明確我方身份的情況下襲擊了我們，違反了合約——的每一條！術師組預備，狙擊手確認方向，準備反擊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "都聽到了吧！頑錘小隊背叛了，反擊，開火！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "在這片荒漠上徒步逃離一支武裝車隊，不是什麼明智的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "留在這裡，這是最安全的選項。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......這也是你的計畫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "不，戰爭會為哥倫比亞帶去很多好處，但誰都不願意這份好處落在別人的口袋裡。利益的劃分事無巨細，很難讓所有人滿意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "作為他們的高級行動顧問，我已經給過足夠多的忠告了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "包括所有“背叛”的可能性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......現在，外面就在發生一場戰爭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "而你，卻坐在這裡，無動於衷？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我有必要提醒你一下，艾利奧特，你也坐在這裡，還受著我的保護。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "不......是這個箱子，他們不敢攻擊我們，是我在保護你，“顧問”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（不滿地凝視著遠處）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我無意反駁。他們的確不敢摧毀一份可能造成薩爾貢半數雨林地形化作荒漠的法術技術原型。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "儘管它被偽裝成了......一種全新的能源引擎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......你、你在說什麼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "顧問！我們恐怕支撐不了太久，必須立刻撤離，更換路線！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "請您帶著倖存者跟我們走！我們會保證你們的安全！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......明白了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......有多少人撤離了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "不到二十個，損失慘重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "我再重複一遍，隊長，死了幾十個弟兄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "他們竟然敢在行動中公然跳反，*哥倫比亞粗口*！公司那邊一定會派人把他們殺得一乾二淨！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "我......不確定。頑錘小隊如果早有預謀，恐怕公司的手是碰不到薩爾貢的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "也許他們和某個王酋達成了交易，又或者，他們根本就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "唔......顧問和那個小孩呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "就在那邊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "讓我......讓我和他們單獨談談。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "在進入薩爾貢之前，我就提醒過你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "軍方需要在薩爾貢點上一把火，然後等著戰爭為他們帶去財富。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "工廠、礦井、軍火貿易，哥倫比亞無時不刻不在蠶食這個古老的國度，以壯大自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "所以軍方動用手段，促使了“沙卒”小隊的誕生，讓他們帶著科研人員來到薩爾貢......進行“技術援助”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "——但管理局並不這麼想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "準確來說，是煙酒施術單元以及源石製品管理局及其背後的某些意願不這麼想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "也許薩爾貢在某些人眼裡是個落後且腐敗的國度，但他的古老強盛仍舊足以勒令漫天黃沙臣服在帝國的睥睨下，化作沙漠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我得說，管理局的觀點是對的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "哥倫比亞一部分人膨脹的財富和力量讓他們變得更加狹隘，讓他們誤以為可以肆意傾軋薩爾貢而無需付出代價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "任何一位帕夏的舉動都足以影響那些哥倫比亞的企業家們在證券交易所的數字，他們卻對薩爾貢的強大力量視而不見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "決策者可以無知，判斷失誤也損害不到他們的核心利益，但你們需要知道自己到底在做些什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "至少，你應該知道，這與你們的存亡息息相關。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......帕夏，薩爾貢帝國中心用以管控王酋的大總督們，他們......會和公司的事情有關嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你知道公司想要做什麼，對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "軍方的某位高層挾持了布萊恩創生科技的主要股東，用非官方的形式將這些東西輸出到了薩爾貢，以達成他與某位王酋的交易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "而他們真正想要的，是用這種簡單粗暴的方式掀起伊巴特的內鬥。因為這有利可圖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "可管理局認為，但凡戰火彌漫到了隱藏在風沙之中的古老帝國中心，他們拿來“賺錢”的一切就會化作飛灰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "所以，管理局讓我們來回收目標，為了制止軍方的某些高層在薩爾貢的越界行為。這我都清楚，但是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "但是軍方也不傻，軍方在公司裡的間諜——你也許猜得到是誰——也買通了頑錘小隊，確保圖紙留在薩爾貢，然後等著某個王酋掀起戰爭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......他們膽敢！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "除我以外的行動顧問，全都默認了發生在公司內的這一系列動作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "業務總管並不打算站在任何一邊，任由雙方互相掣肘，反而能創造更多的灰色收入。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "這裡沒有孩子的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "艾利奧特·格羅夫，年僅十三歲就跳級畢業，隨後進入當地科學院進修源石技術學科。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "三年後，這個年輕的天才被索恩教授相中，當作貼身助手培養。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "艾利奧特是“沙卒”的一員，這支被冠上了士兵代號的科研團隊甚至完全不知道在薩爾貢等待他們的是什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "他們一無所知地慘死在沙暴中，我們誰都不能剝奪最後一名倖存者瞭解全貌的機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......好，我明白了，我無所謂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "剛說到哪了？哦，是的，在哥倫比亞有管理局和軍方的人對公司施加壓力，然後在薩爾貢，王酋們又打成一片......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......呵呵，從一開始我們就被背叛了，而且毫無自覺地跳進這場紛爭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "他們怎麼敢做出這種事情......把我們像垃圾一樣扔進沙漠裡，那還有誰能保證事態會按照他們的想法前進......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "公司根本不在乎這件東西到底送到了誰手上。無論你們哪一方存活下來完成任務，他們都能拿到報酬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "準確來說，就算你們全都死在這裡，也不影響落入他們口袋裡的哪怕一枚硬幣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "因為虎視眈眈的王酋和帕夏會幫你們解決後續的問題，他們自然會帶來混亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "從你們被那巨額報酬吸引來到薩爾貢開始，你們就已經無路可退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......抱歉，顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "您好心警告了我們，也為我們的行動盡了一份力，我對您的尊重遠勝於會議桌上那幾個雪茄成癮佬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "但也許......我們還有另一條路。現在，拿出武器，顧問，我希望這場決鬥還保有些許尊嚴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "你要殺她......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "為什麼不呢，這其實才是我們的本職工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "不要被沖昏頭腦，雇傭兵。我知道你接受了業務總管的另一道密令，但我相信你也明白，現在還循規蹈矩只會自斷活路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "是的，您常給我一種無所不知的印象......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "公司出賣了我們，管理局把我們當作棄子，王酋、帕夏和哥倫比亞軍方都覺得該殺了我們把東西搶過去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "——但我們是雇傭兵，這都是家常便飯，只要還能拿到錢，我就無所謂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "很可惜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "我只不過是這場風波中最微不足道的一員，但不管是出於管理局還是軍方的利益——隨便吧，我都要繞暈了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "公司都覺得您不該繼續待在這個位置上了，顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "這是個好機會，讓一位高級顧問無聲無息地消失在薩爾貢的好機會。有人付了我很多錢，呵，說不定和買通頑錘的是同一個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "但這都無所謂，只是我想最後問您一次......您......您做這麼多，究竟是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......哥倫比亞，薩爾貢，也許還有維多利亞，數不清的勢力捲在這其中，而即使是短視的結果，他們的種種陰謀詭計也都指向一個終局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "——戰爭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "而戰爭會帶來毀滅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我只是在試著阻止這一切，儘管我勢單力薄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "我......我不知道該不該相信您......也許只要完成了業務總管的命令，殺了你，公司就會重新接納我們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "誰會相信如今被迫躲在洞穴裡的十六位雇傭兵，一位年輕的科學家助手，一個雇傭兵公司的行動顧問，會坐在一起談論數百萬條生命的去向？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "最後提醒你一遍，即使你讓業務總管順心如意，讓一個礙事的行動顧問消失在薩爾貢，這也並不代表你能安全回家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "這片黃沙之中的每一批殺手都認為是你們帶走了“沙卒”最後的遺產......而他們一定會選擇殲滅一群壞了王酋好事的哥倫比亞人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你想殺了我之後，把艾利奧特當做籌碼，但你會有和平對話的空間嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "——不，您說得對，我可沒辦法和剛才還在殺我兄弟的人做“交易”，我不是那種能“大局為重”的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "好吧，您說服我了，顧問。我放下弩，您也讓那個......呃，您的寵物稍微收斂一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（威脅似的低鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......你打算怎麼做？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "如果我們繼續同行，您能保證我們回到哥倫比亞嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "恰恰相反，如果我真的與你們同行，只會徒增你們的風險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "但至少，我可以為你們謀劃一條路線，幫助你們偷渡去米諾斯。這是最安全的路線。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "“最安全的路線”，您卻不和我們一起走？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我的目的地另在別處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "那您總不會說，這條路線是您專門為我們準備的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "別誤會，這只是為還能夠活著離開的人準備的一條路，無論生者是誰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "聽上去有點救贖的味道，哼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "這個詞略顯傲慢，如果你心有疑慮，就當這是一筆交易吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......好吧，好吧，上次我沒敢相信您，結果給自己招來了殺身之禍，也許這次我該放聰明點......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "這是一筆交易，顧問。我要用你們兩位的命，買我和我剩下這些兄弟們的命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "十六比二，很划算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "確實，很划算。哈，您其實早就算到這一天了，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......我們，要往哪去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "我們......我......我想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "伊巴特地區有一處黑市，當地的軍火商和地下源石製品商人都叫它“沁礁黑市”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "找到那座黑市，那裡的偷渡客可以幫上我們的忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你在想什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "我在想......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "我竟然......竟然把老師的遺體......就那麼草率地......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "我該......我......那些血，那些慘叫......嗚，嘔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "咳、咳咳咳——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "......顧問已經離開了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "接下來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "這是顧問交給我的路線圖，不止有各個城鎮的名字，甚至還有可用的信使網站，你猜猜光這份地圖能值多少錢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "......那個顧問到底是何方神聖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "天知道！但現在，只有她是我們的救命稻草。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "撕下所有的標誌，這些哥倫比亞車也不能用了，我們徒步去最近的城鎮，大概三十公里，重新租一輛車，離開這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵",
      "text": "......我們就這麼逃了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "我知道你在想什麼......但我們還沒做好報復回去的準備。蟄伏一段時間，然後我們回去好好解決我們和那些公司叛徒之間的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "——誰！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "......嚯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "居然把“沙卒”放跑了......這倒是出乎預料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "河刃小隊傭兵隊長",
      "text": "——敵襲！狙擊手，準——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "留三個活口，讓咒術師做好拷問準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "其他人全部解決掉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "冷靜些了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "算上科研人員，“沙卒”小隊在離開提卡倫多時至少有百人規模。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你剛剛經歷了一場屠殺。也許這很困難，但你需要儘快找回狀態。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......你到底......打算做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "回收你懷裡的法術原型圖紙。不出意外的話，可能還有一枚源石晶體樣本。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "唔......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "這樣只能延緩戰爭爆發的進程，但拖延足夠多的時間，足以讓一些我在哥倫比亞的同僚試著去改變這件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你根本不知道這個箱子裡的東西能做到什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "你不能......！開什麼玩笑！這是研究所的心血......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "無論你相信與否，但我深知用無數性命換來的結果，對一介理論科學家而言有多麼重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "但我也知道，這個所謂的“高新源石能源法術轉換裝置”如果以另一種模式被應用，可以造成多大的損害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "很多人都能意識到這件事。自然，也包括你的老師。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......你！你是說老師知道我們在做一件壞事！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "你怎麼敢這麼說——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "......這裡就是薩爾貢！啊，古老迷人的國家......看看這裡，荒蕪戈壁的中心，不依賴移動城市，卻依舊如此生機勃勃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "是的，老師。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "......嗯？艾利奧特，你看你多粗心，過來，我幫你把頭上的砂礫撢掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "啊......謝、謝謝，老師。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "老師，您要是對那些追求您的女性也這麼用心，我想您也不至於被家裡人催婚的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "哈哈。別戳老師痛處，不然下個月你的實驗項目翻倍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "欸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "老師？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "啊，沒什麼，只是突然想到，荒漠那頭的山脈，山脈另一邊的雨林，那一定也是一片生機勃勃，與這塊荒漠截然不同的生機勃勃吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "那片雨林裡......會生活著與這裡截然不同的居民嗎？他們靠什麼活著？生活水準怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "雨林？老師怎麼突然在意這些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "艾利奧特。我們相信我們的事業是為了造福更多尚不能被源石科技恩澤的人類。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "但有時候，科研的結果未必會貫徹初衷，也許我們一開始就選了一條錯到離譜的道路，而我們在意識到的時候，已經無力挽回。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "唔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "哈哈。只是個假如而已，倘若真有那一天——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索恩教授",
      "text": "——我們要試著阻止這一切。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "索恩......老師他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "我......不，不可能，他是被騙了的......他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "索恩的研究一開始就是被人操縱的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "資本轉折了幾層到了他的手上，偽裝成了一個對新能源市場滿懷憧憬的商人，市儈得恰到好處，讓人不會生疑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我曾提醒過他。但也許實驗的成功和推進讓他放下了自己的顧慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "人無完人，艾利奧特，但你們奉獻的一切絕不會變成戰爭和死亡的開端。我為此而來到這裡，我需要你的幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "唔。你還有五分鐘時間收拾好思緒，然後我們準備出發。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......呃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "你要我跟你走？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "否則你只會死在這片荒漠上。我不否認你在數學和源石應用領域的天賦，但你甚至連哪種植物可以安全地提供水分都不清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我不希望最後一個知道實情的年輕人無緣無故地死在我的面前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "當然，如果你自己覺得使命盡了，無需前行，我也可以把你安排到薩爾貢的某個鄉下避難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾利奧特",
      "text": "......你......你到底是什麼人？你為什麼把這一切都說得這麼......輕描淡寫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "現在是哥倫比亞威斯丁安保公司高級行動顧問兼術師教練......如果我有必要再向你重複一遍的話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我是凱爾希。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“沙卒”",
      "text": "凱爾希。凱爾希。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“沙卒”",
      "text": "嗯......看看這份合約......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“沙卒”",
      "text": "多漂亮的簽名啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
