{
  "server": "tw",
  "storyId": "act11d0_level_act11d0_05_end",
  "groupId": "act11d0",
  "stageId": "act11d0_05",
  "title": "冬靈輓歌",
  "storyCode": "TW-5",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act11d0/level_act11d0_05_end.txt",
  "sourceHash": "92cb3b2b9ed9bd1d26acf48f1c4d9356bc41de8782a9f04a457257e0fc1bb208",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 5下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "快！這邊走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "謝謝、謝謝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "亞葉姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "麗薩！你帶著平民先走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "呃——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "這群暴徒......他們在無差別攻擊街道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者A",
      "text": "喂！我們好不容易才搶下這玩意，你倒是射準一點啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者B",
      "text": "閉嘴！要操縱這玩意兒哪有那麼簡單！得虧我以前在音樂學院學習過——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者A",
      "text": "哪門子學院！？喂，憲兵！不要輕舉妄動，我們有人質的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者B",
      "text": "人質在哪兒呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者A",
      "text": "*萊塔尼亞粗口*！街上在跑的不都是嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "嘖！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "亞葉小姐！不能讓他們繼續破壞下去了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "這附近的房屋都是木質結構，這樣下去整片街道都會化為火海——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "火！快滅火！其他人趕緊離開這裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "還有很多來不及撤離的平民，我們得幫他們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "但這不是完全沒法靠近嗎——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——呃，這火力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "亞葉小姐！麻煩你照顧傷患！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "喂！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固的鎮民",
      "text": "你們這些冬靈人！感染者！蛀蟲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固的鎮民",
      "text": "為什麼要燒了我的家！為什麼！明明是我們養著你們的——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "小心頭頂！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固的鎮民",
      "text": "呃？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "頑固的鎮民",
      "text": "唔......呃，塔佳娜？你、你還好嗎！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "嗚......我還好，他們控制不住那些自律施術單元，這裡很危險！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固的鎮民",
      "text": "我們一起反抗！把他們趕出去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "現在——還不是時候——！呃——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固的鎮民",
      "text": "你的腳——！好、好吧，我聽你的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "離開這裡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（腳踝的刺痛......是骨折了嗎？真糟糕......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（得快點和其他人會合......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "你這，貴族的爪牙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......全部撤離了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "是、是的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "塞弗林長官，受傷的人很多，這裡人手不夠......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "醫生們，聽這位沃爾珀小姐的話，沒受傷的年輕人也都去幫忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "知道了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "如果亞葉姐姐在的話......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "等等......她們沒有回來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "喂！亞葉和塔佳娜呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "她們、她們好像還在十二音街道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——我剛才問的不是“全部撤離”嗎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "噫！對、對不起！但是，亞葉和塔佳娜應該不會有事的，他們救下了那麼多人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "叛亂者搶佔了城防設施，沒有正規武裝力量的她們怎麼才能沒事——咳咳，咳咳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——咳，找幾個身強力壯的，和我去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "但是他們有火力優勢，說不定已經有了人質，我們不應該再去刺激他們了，我們應該等著談判的機會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "機會！等著敵人給我們機會！你上過戰場嗎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "對、對不起！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "但他的擔憂不無道理。大裂谷留下的活性源石極有可能殘留在沃倫姆德的地基內，任由他們破壞，後果不堪設想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "你們從哪裡進來的！無關人士趕緊離開這裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "沒有憲兵隊的我們倒更像無關人士......我見過你一面，羅德島的幹員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "感謝理解，斷崖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......簡單的現場判斷，如果他們繼續用那種裝置轟炸街道，十分鐘到半小時沃倫姆德就會擱淺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "最好的處理方法是切斷這片街道與城區的連結，但沃倫姆德不比移動城邦，街道缺乏自主移動的動力源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "其實拖拉機可以做得到......前提是，街道上沒有那麼多叛軍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "武裝介入城鎮事務需要申請手續嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......請便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "也請二位......務必救出塔佳娜和亞葉小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "塞弗林長官——這裡還需要——啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......麗薩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "是......是灰喉前輩？這位是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "幹員斷崖，天災信使萊恩哈特的護衛，他本人有別的任務，我就被拖來這裡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "麗薩，安托和亞葉呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "亞葉姐姐還在裡面！安托......安托姐姐，那個......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "不用勉強，我明白了，只是確認一下......一會再說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "......嗚嗚......有、有羅德島的前輩們來幫忙真是太好了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "——不、不行，現在還不能鬆懈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "我會照顧好傷患的，請一定要把亞葉姐姐救回來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "嗯，我會的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "那麼小的孩子......也是幹員？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "阿米婭比麗薩大不了幾歲，別忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......原來如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "這場營救完全在計畫之外，沒有任何防護設備，你沒問題嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "——真意外，傳聞中的灰喉小姐並不是個能熱情地迎接源石的人，我還擔心過來著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......我只是不想慘劇發生太多次，救人要緊，閒話少說吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "怎麼回事，怎麼還有人敢衝進來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "這兩個人動作好快！快、快解決他們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "有不少本地人，沒關係嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "儘量避開要害，動手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
