{
  "server": "tw",
  "storyId": "act21side_level_act21side_06_end",
  "groupId": "act21side",
  "stageId": "act21side_06",
  "title": "舊日碾軋",
  "storyCode": "IS-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act21side/level_act21side_06_end.txt",
  "sourceHash": "1f3d2124da460ab84cf1d091f8b87ffde0e22f529b0fc3753b20cdad8b5c76f8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "撤退，這傢伙很棘手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "不要和她硬來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "守住通往首領的包廂的走道和樓梯口！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "嘖嘖，羅塞蒂的人還挺能幹嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "想要強行突破看起來不太現實啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哈哈，德克薩斯這傢伙，明明是在貝斯裡裝了錄音器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "彈得還挺像那麼一回事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "啊哈，有了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "正面突破不行的話......那就造一條路出來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "別慌張！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "守住這裡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "嘖，這些傢伙，不怕死嗎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "咕......啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "其他人的情況如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "通往喬萬娜包廂的各個走道和樓梯口都被守住了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "他們的準備很充分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "不愧是羅塞蒂......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "不過，我們從一開始就沒有小看喬萬娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "繼續投入人力，今天，喬萬娜必須留在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "你們或許沒有小看喬萬娜，但是不是有點太小看我了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "什——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "你是......瓦拉赫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "哼，早知道今天演的是這樣一齣好戲，我就不費勁去給首領拿酒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "喬萬娜小姐要是對酒感興趣，我這裡倒也有一些好貨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "免了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "首領喜歡敘拉古的許多東西，但唯獨敘拉古的酒，總是喝不慣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "敘拉古的酒，太軟，就和你們揮動武器的力道一樣，讓人提不起勁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "那或許是你們還沒有喝過敘拉古真正的好酒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "所以，這不就是最好的機會嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "你們知道我等這個機會等很久了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "貝洛內和薩盧佐，讓我嘗嘗吧，敘拉古的好酒，到底是什麼味道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "想從這裡上去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "攔住她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "誰告訴你，我要上去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "什麼，炸藥？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "散開！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗚哇，那邊的看台塌下來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "那是——拉普蘭德？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚恐的觀眾",
      "text": "你看那邊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "咕......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "驚恐的觀眾",
      "text": "難、難道說是家族仇殺......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "讓開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "她、她竟然把武器藏在樂器裡？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "德克薩斯！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "德克薩斯沒有說話，只是看了她一眼，張了張嘴，然後就向樓上衝去。\n空辨認出了她的口型。\n她說：等我。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌亂的觀眾",
      "text": "噫——快、快跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "怎麼辦，能天使，空會有危險的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "但是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "驚恐的觀眾",
      "text": "救、救命——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "趴下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哇哦，老爺爺你好厲害啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我看起來很老嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嗯......倒也沒到那個地步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "看來，今天上演的，並不是《德克薩斯之死》，而是《羅塞蒂之殤》。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "孩子，去避難吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "......雖然我們也想這麼做，但是，我們的朋友還在舞台上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "可舞台周圍已經亂成一團了，我們直接衝過去太危險了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "那就走後台！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘖，別攔路！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "去吧，勇敢的孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "謝謝你，老爺爺！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "之後請你吃披薩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "謝謝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "呵呵，年輕人總是充滿了活力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "接下來，你打算怎麼做呢，喬萬娜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "首領，各個路口現在都在我們的掌控中，您趁現在離開這裡吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "難得有個能好好觀賞這場好戲的地方，我自然要盡興才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "空，你果然是她的朋友嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "要從那裡上來嗎，切利尼娜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "不過，就算有了捷徑，想要到我這裡來，也不會那麼輕鬆的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "但是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "難道你認為，我現在逃跑之後，貝洛內和薩盧佐就會放過我們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "這是開戰，親愛的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "貝洛內和薩盧佐無視了西西里夫人的禁令，選擇了對另外一個家族全面開戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "傳話下去，我們能做的，只有——和他們對抗到底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "......呃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "看來，敘拉古的好酒，也不過如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "哥倫比亞雜碎......少得意了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "什——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "是，我知道，在你們敘拉古人眼裡，我們這些哥倫比亞家族全都是沒有累積沉澱的暴發戶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "哥倫比亞那邊這樣的蠢貨確實有許多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "但是你們呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "在所謂的“銃與秩序”之下，你們的血性又剩下多少呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "我從來沒有小看過敘拉古。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "但現在看來，至少你們這些人，沒有什麼值得我看重的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "瓦拉赫，劇院那邊出狀況了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "有人把看台炸了下來，切利尼娜直接去三樓了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "給你五秒鐘說遺言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "遺言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "呵，哪有什麼遺言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "你真有這個工夫，幫我和萊昂圖索說一聲抱歉吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "什——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "萊昂？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "我會用我的方式顧全大局，德米特。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "萊昂圖索大少爺，我還以為，我們之間能夠愉快相處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "從現在開始也不是沒有機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "瞧瞧，大家族出來的人氣度就是不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "騎到我的頭上來了，還告訴我，還有機會挽回。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "事已至此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "來打個賭吧，瓦拉赫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "打賭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "哈哈哈哈哈，我的萊昂大少爺，這裡不是宴會場，也不是辦公室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "這裡是戰場，我們在這裡只有你死我活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "相信我，這是個你會喜歡的賭約。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "嘖，羅塞蒂家族的人，真是難纏。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "法官閣下？我們沒有收到你會參與這次行動的消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "而且，這不是你能夠介入的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......我不想妨礙你們，現在，我也沒有那個興趣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我在找人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "找人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "現在劇院裡很亂，恐怕沒有你要找的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "你們只要別來妨礙我就可以了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我死在這裡，也和貝洛內家族無關。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝洛內家族成員",
      "text": "......請便。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "找到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "站住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "我是這裡的工作人員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "工作人員？工作人員早就被我們趕走了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "嘖，為什麼他會在那裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "當心，丹——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "血液飛濺，有幾滴灑到了拉維妮婭臉上。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "拉維妮婭小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "......你怎麼會在這裡？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "拉普蘭德開闢的“道路”十分有效，還有一小段路，她就可以見到她的老朋友。\n她微微呼出一口氣。\n場面一片混亂，但她知道自己想做什麼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "你果然來了，切利尼娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "你現在的眼神很好，讓我感覺我像一個獵物。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "讓我見識見識你有多大的能耐吧，最後的德克薩斯！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "這......總監閣下，這場混亂......也是演出的一環嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "混亂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "在我看來，一切都井然有序，盧比奧部長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "而接下來，正要漸入佳境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "......我懂了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "您領導的不愧是沃爾西尼最負盛名的劇團之一，這樣別開生面的劇目我是頭一次見到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "不過，接下來，是中場休息時間，現在，你可以說一說，你想從我這裡獲得什麼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "我想要的東西......不複雜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "卡拉奇死後，建設部部長的人選一直懸而未決。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "想必您也一直在挑選合適的人選。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "你想說，你就是那個人選？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "事實上，我認為沒有比我更合適的人了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "咳咳，咳，嘔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "這種時候還有力氣手下留情......真是了不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "不動手嗎，薩盧佐家的瘋子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "我可不想和一個從一開始就沒打算用全力的傢伙進行無意義的廝殺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "......呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你在等什麼，你在期待什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "我和人打了一個賭，我希望我賭輸了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "瓦拉赫看向德克薩斯離去的方向，沒有人能阻礙德克薩斯刺殺喬萬娜。\n除了喬萬娜自己。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "房間內空無一人。\n德克薩斯立刻意識到發生了什麼，然而為時已晚，一把刀架在了她的脖子上。"
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "自從來到敘拉古之後，我設想過無數種被人刺殺的方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "唯獨沒有想過，會是你走到我的面前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "而你，居然在這個時候放鬆了警惕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "你難道以為——只要見到我，我就會抱抱你，說，“切利尼娜，太好了，你真的沒死”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "然後我們可以坐下喝一杯，聊一聊過去幾年發生的事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "我是來殺你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "這麼說著，喬萬娜卻放下了手中的刀。\n她的臉上笑意盈盈，神情中滿懷思念，像是剛才的殺意只是一個小小的玩笑。"
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "好久不見，切利尼娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "好久不見，喬萬娜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
