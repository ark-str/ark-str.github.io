{
  "server": "tw",
  "storyId": "act42side_level_act42side_04_beg",
  "groupId": "act42side",
  "stageId": "act42side_04",
  "title": "求道",
  "storyCode": "MT-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act42side/level_act42side_04_beg.txt",
  "sourceHash": "a557afdd122d8c578f93a0762cbdf6c99a7c611f1697093403b288addbbd14ba",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "您為什麼要用這樣彆扭的姿勢靠牆站著？我還以為自己看見了一尊雕像……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你要是早一點進來，就能聽見我的關節發出喀喀的聲音了，哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "看來得抽空去找一下工匠師傅，看能不能在腰間加裝一塊護枕……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "銃騎裝甲的設計師大概不會考慮這種關愛老年人的特殊設計……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "這主要是為了緩衝巨銃後座力嘛，年輕的銃騎也需要！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "明天降生儀式就要開始了，育嬰聖堂那邊準備得怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "那位母親的狀態很穩定，安多恩將她照顧得相當好，相信明天她會誕下一位健康且美麗的新生兒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "維什戴爾議長和卡茲戴爾使節團、雙子女皇和萊塔尼亞使節團、阿戈爾發展規劃所執政官代表團、炎國宣禮使帶領的天師團……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "明天，所有到訪聖城的客人都會受邀前往育嬰聖堂，共同見證那個新生命的降生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "不過，既然一切正常，你今天找我是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "我們的新人樞機……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "蕾繆安？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "她專程去見了一趟牧首。我想——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "她應該不是在調查爆炸事件時“偶然”經過，“順便”看看，再“心血來潮”地提出以第七廳的名義為育嬰聖堂提供幫助吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "我起初以為她是為安多恩遇襲的事來的。但她見過牧首之後的表現……很明顯她還有更多疑慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我還以為我已經打消了她的疑慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "蕾繆安的敏銳很多時候無人能及，尤其在她注意某件事的時候。我很想說，她確實就是最適合成為七廳樞機的那個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "但她同時也是不適合的。畢竟，她的注意力在哪，似乎大部分時候只取決於她自己的私人判斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "哈哈。那你覺得有必要對她加以防範嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "……您這個語氣，搞得好像我們是什麼反派，正在醞釀顛覆拉特蘭的大陰謀一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "難說喲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "對於有些人來說，我們將要迎接的那個未來，恐怕確實會顛覆他們所知的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我們的共感，我們的同胞與親族，甚至“薩科塔”這個概念本身……都將拋卻舊有的局限。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "這本來是拉特蘭所行之道既定的終點，但這道路畢竟綿延了太長、太久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "或許有些人反倒將過程中伴生的一些微不足道的意外現象當作了常態，以至於無法接受原本既定的終點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "說得也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "我們還是應該早點做好準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "蕾繆安的事情，我會處理。你就回到育嬰聖堂，專心準備明天的儀式吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "願主繼續賜福這座城。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "頭髮火紅的薩科塔在蒼白與幽藍交織的叢林中東奔西走，像一撮小小的火苗在雨中搖曳。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "那個安撫鈴上的雲朵都快比可頌的麵包車大了……還有那個能塞下兩個貨櫃的搖籃……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "安撫鈴上懸掛的雲朵彷彿能遮蔽天光，托舉搖籃的雙手似乎又要聳入雲霄。\n在這座聖堂之中，一切活物都顯得渺小。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "怎麼會……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "看起來空蕩蕩的，安靜得要死，但這些育嬰室，起碼有一半以上都住了人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "小孩子、異族人甚至還有墮天使……保育員忙來忙去，看樣子他們應該已經住進來很久了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "那群人不是說這裡大部分的設施都還不能使用，要等到那個什麼儀式辦完之後才開放嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "完全不是這麼回事！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不行……得拆掉這些炸彈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "本來以為先把場地炸掉，儀式就無法順利舉辦了，結果這裡面全都是人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "真要命啊，好不容易才躲開那些守衛安裝好的……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "……要是她們在就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "可以拜託德克薩斯把守衛全部打暈拖到外面去，或者讓可頌撞開那些房間，把裡面的人統統打包帶走……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "實在不行，這群人舉辦儀式的時候，就讓老闆在對面開一個粉絲見面會之類的，把注意力都吸引過去……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "算了，繼續，沒剩多少時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "拆掉這些炸彈，再想別的辦法——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "先剪掉那根藍色的線，拆起來會比較快哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "唔啊……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "你什麼時候回來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "小樂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "這棟住宅很普通，唯一的特點是天台的視野——剛好可以看清育嬰聖堂前的廣場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "阿爾圖羅，這是你選擇躲藏在此的原因？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "又見面了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你找了過來，而且速度比想像中快了很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你並沒有想要隱藏自己的行跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你用紙蜻蜓脫身，留下了太過明顯的線索。在崔林特爾梅的時候，我不只一次見過你使用類似的音樂術式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "嗯，雖然很不願意承認……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "但你真的掌握了我的許多秘密，費迪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "等等，你們……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "席德佳修女，難道我們的執行者先生沒有告訴你，我是他的姐姐嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你我的遠親關係，並不妨礙我作為執行者對你實施監視與管控。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "阿爾圖羅，將你帶回拉特蘭之前，在崔林特爾梅的城外，我曾向你提出警告——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我會對你保持更高的警惕，審慎判斷你行為的主觀動機與可能導致的客觀結果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "如果發現任何可疑的地方，我會擊斃你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "我還記得那天的晚霞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "席德佳修女，他真的是一個刻板到有趣的人，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "阿爾圖羅小姐，一直以來，您都非常配合我們的安排。所以受監管期間，蘭登修道院並沒有太為難您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "您欺騙了我們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "我深表歉意，席德佳修女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "希望我的無禮行為不會給你、給蘭登修道院帶來不好的影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "阿爾圖羅，交代你擅自離開蘭登修道院的目的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "看看這座聖堂，費迪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "多麼雄偉且富有生命力的建築，它聳入雲端，高度甚至遠遠超過了萊塔尼亞人引以為傲的女皇雙塔……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "這是拉特蘭試圖為自己打造的“恩典”與“權威”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "看看那些正被引入其中的、沒有光環的異族人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "拉特蘭需要他們做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "阿爾圖羅，你究竟發現了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "回到拉特蘭前，我們曾在羅德島短暫停留，還記得嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "我在那裡見到了一位神秘的客人。他告訴我，或許終有一日，拉特蘭將不再是專屬於薩科塔們的溫馨小屋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "費迪，還有席德佳修女，看看眼前的景象，你們難道不曾懷疑，這一天已經到來了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "我們引以為傲的聖城，為何變了模樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "這是，什、什麼意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "費迪，從來都清醒的你，顯然也察覺到了什麼，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "否則，在見到我的第一秒，你就已經舉起了銃。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "那些是，炸彈？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "看起來威力還不小。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "老姐，你的腿已經完全恢復了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "嗯啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "太好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "小樂，我那天在約維塔街看到的，以及阿摩斯輔佐官在銃械工坊外看到的，都是你嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "教皇廳已經對爆炸物進行了相當嚴苛的管控，竟然還能做出這麼多炸彈……小樂，你這方面的本事還是那麼好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "那麼，小樂，你的目的是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "炸毀這座聖堂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "阻止降生儀式？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "還是，破壞整個萬國峰會？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "別過來，老姐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巨型立柱切割開了光影，蕾繆安停下腳步，沒有繼續走向能天使。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "老姐，你這一套是樞機的制服吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "好看嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "很合身！超級帥氣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "其實稍微有一點大，上任前一天剛領到，我還連夜自己動手改了一下腰線呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "唉，真不希望久別重逢是在穿著這套制服的場合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "小樂是一個人回來的嗎？還是說有其他朋友陪著你，他們也在附近？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哈哈，老姐你在套我的話耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "小樂是個想法單純的孩子嘛。這不是學校，也不是畢業典禮，小樂真的只是心血來潮想要用這樣的方式助興嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "是誰在你身後，又為什麼將你推到這個位置？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘿——口令，“美乃滋蘋果派”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "口令，“烤一塊吃一塊”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "啊！小時候的事情，老姐你竟然還記得！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "只要遇到吵不出結果的架，不願意說的秘密，就快點喊口令暫停，把矛盾存起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "小樂，姐姐能感受到你的情緒，糾結、急切、焦慮，甚至不知道該從哪裡開始解釋……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "但將試圖破壞萬國峰會的危險分子捉拿歸案，這是姐姐的職責所在。我也會向教皇廳申請親自負責本案的後續審理。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薩科塔姐妹對峙著，兩個人沒有挪動腳步，也沒有再說一句話。終於，蕾繆安忍不住打破了沉默，她長長地嘆了一口氣。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "唉~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "幾乎是在同一個瞬間，能天使撲了過來，將她抱緊。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "……這才是你每次闖禍後的第一反應啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "真想你啊，老姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "這麼久沒見，你好像長高了一點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哈哈哈哈哪有！我離開拉特蘭的時候都快成年了好嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "老姐你這個口吻，就像那種很愛操心的家長的標準語氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "哈哈哈，是這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "這個辮子是你自己綁的嗎？都鬆掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "我幫你重新綁一下……你還是這樣馬馬虎虎的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我的手藝當然沒有你的好嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "老姐，你今天為什麼會來到這裡？總不可能是因為你知道我會出現吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "只是來確認聖堂的安防……本來以為見到牧首為一位薩卡茲孕婦祈禱就已經夠特別了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "沒想到又碰見了你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "（牧首……薩卡茲孕婦……祈禱……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "（難道說，降生儀式就是……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哈哈，老姐，原來你也不是很清楚這座聖堂裡有什麼嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "小樂，你不會打算反過來套我的話吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "這又是誰教你的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "老姐——我真的沒有跟人學壞啦。現在支持我做這些事的人——我向你保證——是很可靠的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我沒有孤軍奮戰，也沒有被人利用哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "一切都很不對勁，但更詳細的我很難向你說明……我還需要一點時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "做完該做的事情，我會回家的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "蕾繆安綁好了髮圈的最後一圈，又往上綁緊一點，讓妹妹頭側邊的那束頭髮不至於那麼容易鬆。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "但下一個瞬間，她的懷抱已經空了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "剩下的這些炸彈，就麻煩樞機大人幫我拆掉囉！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "炸彈的倒數計時聲在多處同時響起，蕾繆安看著妹妹消失的方向，卻無法繼續追上去。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "text": "……真沒辦法啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
