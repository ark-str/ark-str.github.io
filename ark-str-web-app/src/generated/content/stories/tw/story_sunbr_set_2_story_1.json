{
  "server": "tw",
  "storyId": "story_sunbr_set_2_story_1",
  "groupId": "story_sunbr_set_2",
  "stageId": null,
  "title": "成長",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_sunbr_2_1.txt",
  "sourceHash": "095c98ed03a76d2b0656f6563d37919fc5ee09f6bd3b349d81bd7571c16cdd91",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "古米有很多回憶。\n好的，壞的。\n快樂的，悲傷的。\n還有不管怎麼樣都忘不掉的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "她們在這裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "快點過來，她們逃不了了......她們有食物！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安娜",
      "text": "拉達，小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "嘖，一群臭蟲！安娜，拉達，到我身後來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "好啊，你們膽子不小，來啊，我看誰敢上前！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅莎琳",
      "text": "好痛啊，怎麼又來了，我胳膊還沒好全呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅莎琳",
      "text": "喂，索尼婭，我們要不要比比看，誰能解決掉更多人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "少說廢話......小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜塔莉婭",
      "text": "哎呀，在這種時候走神可不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜塔莉婭",
      "text": "兩位將軍，要專心啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安娜",
      "text": "呼......好險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安娜",
      "text": "索尼婭，羅莎琳，小心身後。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "謝了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅莎琳",
      "text": "敢偷襲我，看來你們是做好準備了吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女學生",
      "text": "不、不要慌，別被她們嚇到，她們只有這麼點人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "對，她們只有這麼點人！別給她們機會喊救援，我們一起上，一定沒問題！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜塔莉婭",
      "text": "（怎麼辦？對面說得對，我們人數不佔優勢。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安娜",
      "text": "（......只能想辦法衝出去了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女學生",
      "text": "對不起啊，但是......我們也沒有辦法，我們必須要拿到食物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女學生",
      "text": "我不想挨餓......我不想在這種地方餓死啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "別給她們逃走的機會，把門堵住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "我們上！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "咳、咳咳，這群混帳，沒完沒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅莎琳",
      "text": "你該不會撐不住了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅莎琳",
      "text": "呸。哎，我好像掉了一顆牙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜塔莉婭",
      "text": "等等，他們人數不對！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安娜",
      "text": "索尼婭，小心！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "索尼婭",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "把食物交出來！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "呃啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "咳......呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "（倒地抽搐）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安娜",
      "text": "拉達......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "不許對索尼婭姐動手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "不許......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女學生",
      "text": "啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女學生",
      "text": "她瘋了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男學生",
      "text": "她把安德列的脖子砸斷了！小心，小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "拉達......拉達要保護大家......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "不許你們傷害姐姐們！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "古米有很多回憶。\n好的，壞的。\n快樂的，悲傷的。\n還有不管怎麼樣都不願意再想起的。\n古米傷害了別人。\n到底是為了保護姐姐們，還是為了自己不受傷呢？\n古米分不清。\n但古米......古米已經不想再傷害任何人了。\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "古米？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "怎麼在這種地方睡著了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "醒一醒，古米。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "唔......呼啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "醒一醒，古米。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "怎麼臉色這麼差，傷口還痛嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好像做了個噩夢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "傷口已經一點都不痛了，真理姐別擔心，古米沒事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "唔？真理姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "怎麼不說話，是要出發了嗎？古米隨時都可以走，凜冬姐和烈夏姐呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "不是，還沒到出發時間，還可以再休息一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "其他人出去探路，應該過一會就回來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "那古米也去幫忙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "哎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "等一下，古米，你別亂動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "你的傷沒有你說的那麼輕巧吧。別亂動，我給你重新上一次藥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "其實真的沒有很嚴重啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "真的！古米保證！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "只是，只是稍微有一點點痛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "乖乖別動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好的真理姐！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......好多傷口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "之前的傷，疤痕已經有點淡了。今天這一道傷口不知道會不會留下印記。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "希望不要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "醫療部的姐姐們會給古米超級好用的藥膏，每天塗一塗，一定能把不好看的傷疤都消除掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "是啊，身上的傷這一年多來都治得差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "但是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "古米，剛剛我們被那群賞金獵人襲擊的時候，其實你是可以不受傷的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "為什麼沒有繼續追擊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "最後一擊的時候，你的手頓住了，你在猶豫......這很危險，古米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "可是，可是古米......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米沒有辦法......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......古米......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "其實堅雷教官也和我提過你的習慣問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "教官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "你在害怕，對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米很害怕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "第三下，古米控制不住自己......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米會想起、想起在學校的時候，晚上會做噩夢，就算開著小夜燈也沒有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "我......知道，你睡不著，就會不斷翻身。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "我知道，凜冬也知道，這件事只能靠你自己克服，所以我們不會多說什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "但是古米，我們都很擔心你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米在努力......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "嗯，你很努力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "你是我們之中最堅強的那一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "古米現在已經不需要小夜燈，也可以睡著了，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "雖然有的時候還是會跑來找我和凜冬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米要努力長大，努力把不好的習慣都改掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米問了阿米婭和凱爾希醫生，醫生說，古米的爸爸媽媽在做很危險的工作，想要見到爸爸媽媽會很難很難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "你想去找他們嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "想。但是現在還不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米不希望爸爸媽媽看到古米現在的樣子。見面的時候，不希望爸爸媽媽覺得古米是個壞孩子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "所以現在還不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......你不是壞孩子，古米。你是在保護我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "但是、但是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米還是做不到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米控制不住自己，會傷害到別人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "真理姐，古米到底該怎麼做？",
      "portraitKey": null
    },
    {
