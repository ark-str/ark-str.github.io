{
  "server": "tw",
  "storyId": "main_13_level_main_13-08_end",
  "groupId": "main_13",
  "stageId": "main_13-08",
  "title": "幻境遷流",
  "storyCode": "13-10",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_13-08_end.txt",
  "sourceHash": "1bd59d73f2afee42807330d6423a2efcb7d76855ddab654db20937f83388c694",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這裡是，一片戰場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我的戰場，“魔王”的戰場。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "我們會為您拿下最後一座城市。他們的抵抗已經行至終點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你是……食腐者王庭之主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你叫什麼名字？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "我沒有名字，我只是您的屬臣，“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "這是您的命運，您為我們帶來了救贖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "我們始終渴望的，我們終於達成的……救贖。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "您的意志，就是我們的意志。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "您已回應預言，預言便會降下它的賞賜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "食腐者之王",
      "text": "請交給我們，這場戰役不會拖延得太久。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "這些天，你看起來很疲倦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "阿米婭，這樣可不行，你需要休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……特蕾西婭小姐？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這些……都是我做的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "這些都是你必須要去做的，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "你已經來到了這一切的起點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "這也是我們命定的終點。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "別這樣，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "“魔王”，我把這頂冠冕親自加諸你身，我為你帶來了這些痛苦……與光榮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "我們會一起面對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "這是……眾魂的結論，我們不能違抗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭",
      "text": "你越拒絕，你就越痛苦；你越反抗，你就越無力。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "我們曾見過如此之多命運的反抗者，預言早早在他們的面前彰顯，他們早已明晰，自己將倒斃於何處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "我們感懷於那些無謂的挑戰，這也許會織就英雄的史詩，但英雄本人，卻注定沉淪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "你越拒絕，你就越痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "因為你明白，所有的選擇，所有的掙扎，所有的精疲力盡，嚥下的悲哀，皆無意義。拒絕只會讓命運的甘霖變得苦澀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "你越反抗，你就越無力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "因為你發現，所有的鬥爭，所有的不屈，所有你我的血跡，枯槁的話語，皆無所去。反抗只會讓注定的歸宿填滿荊棘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "你又何必……你又何必。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "我們只是想，讓你安眠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "閉上眼睛吧，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "“我見你，頭頂黑冠，將千萬生靈，熬成回憶。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "“我見魔王，將所有種群，盡數奴役。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "你會後悔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "你會像我一樣後悔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "最後的終點……仍是這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "等到死亡來臨，你會發現，所有預言，全部實現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "我……是大地上最可怕的災難。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那麼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那麼，我會殺死你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "哪怕，你就是我，你就是“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "我曾……和你做過相同的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "我曾以為我已經足夠強大，強大到足以掙脫命運的束縛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "你做不到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭？",
      "text": "阿米婭……你做不到的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "也許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你也許嘗試過，你也許經歷了一切的苦澀，終究還是發現自己落入相同的深淵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但我還沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我還沒有走過，你們說的，“注定的道路”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我決定向你們挑戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我會向你們挑戰，以我，魔王之名，“阿米婭”之名。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "如果一切的結局，早就被你們藉預言的口吻編訂成冊，如果我們生命的全部意義，都只是證明你們的結論不可違逆……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那我們為何還要活？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那我們為何還要存在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那愛國者先生終其一生的抗爭，凱爾希醫生殫精竭慮的選擇，Dr.{@nickname}每一次牽起我的手，堅定地與我同行——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這一切只成了命運的註腳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我絕不承認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "阿米婭，這只會為你帶來痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "這只會是，無盡的折磨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "薩卡茲的眾魂，我質問你，特蕾西婭小姐是否打破了她的命運？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "哪怕是特雷西斯，他是否也曾向你們迎頭痛擊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特蕾西婭？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "特蕾西婭小姐……她為此，把這頂王冠，交給了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "她不相信你們描繪的，注定可悲的未來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲眾魂？",
      "text": "所以她現在飽受折磨……所以她現在無時無刻不在聆聽我們的聲音！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲眾魂？",
      "text": "哪怕是為了免除她的痛苦，“魔王”，你也應該——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "特蕾西婭小姐從不需要任何拯救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "“魔王”也不會是征服和復仇的象徵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……也許，才需要是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲眾魂？",
      "text": "多麼自大，多麼狂妄——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不，正因為我已戴起黑冠，我才會向你們揮劍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲眾魂？",
      "text": "你無法逃過命運的選擇。你越逃，就只會越快讓它來到——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我不會逃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我就等在這裡，“命運”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "等到你們的一切籌謀消散，等到你們的一切嘲弄落空。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我會讓你們看見——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們……這片大地上的人們，可以為自己選定結局。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "唔——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿米婭，你醒了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "身體上有什麼不舒服的嗎？\n你被赦罪師的巫術影響，你做噩夢了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……已經沒事了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士，這份力量不會是詛咒，不會是帶來災難的禁忌巫術。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "特蕾西婭小姐把它交給我，是為了……我們能用它找到自己的路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我相信你。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "你醒了，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "沒關係……Logos先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "無論是不是赦罪師的巫術影響，我也許都遲早要面對這些……詰問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "在夢裡，那些聲音再度向我宣告了預言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "預言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是的……愛國者先生死前說出的那個預言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "無論是什麼聲音，都是赦罪師的無聊把戲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "不必當真。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這究竟是赦罪師的拷問手法，還是眾魂依然在連接著我的內心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "也許是我自己……一直把那個可怕的預言記在心底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但這不重要，我已經拒絕了他們的邀請。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "又一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "……好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "但我仍希望你接受凱爾希醫生的全面檢查。你的戒指……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "呃，不過Logos先生，我們這是在……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Logos徵用了這支薩卡茲運輸小隊的車輛。用女妖之主的身份。\n我們需要躲過赦罪師的追蹤。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "昨天，可露希爾的無人機找到了我們，他們之前停留的W的安全屋也遭到了赦罪師的襲擊，夜鶯被赦罪師帶走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……赦罪師。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "我們對這支以赦罪師為名的薩卡茲疏於防範。特雷西斯的計劃也為他們提供了行動的空間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "但他們終於走出了躲藏的陰影。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "博士，明椒他們正把你需要的源石樣品裝車，他們已經起了疑心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "他們現在只是畏懼我，才繼續勉強執行我的命令，但恐怕很快，我就需要真正以咒術脅迫他們了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "五批結晶的樣本，已經夠了。阿米婭的狀態也已經好轉。"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "那麼，接下來，我們去布倫特伍德，與凱爾希醫生會合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士，你看起來有些心神不寧……你在擔心什麼？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "我在擔心特雷西斯想要的，根本不是什麼血魔巫術裝置。\n他想獲得……更加讓人不安的力量。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
