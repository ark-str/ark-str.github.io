      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "菈塔托絲",
          "text": "不用你強調我也知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "菈塔托絲",
          "text": "民心現在站在了恩希歐迪斯那邊，他在大典結束後，甚至只宣佈我和阿克托斯的“罪行”而沒有對我們兩家的領地有進一步動作。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "菈塔托絲",
          "text": "在他看來，謝拉格已經是他的囊中之物了。",
