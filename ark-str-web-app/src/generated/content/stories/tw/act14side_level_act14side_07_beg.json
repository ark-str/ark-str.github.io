        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "我並不是在說，恩雅·希瓦艾什有什麼不好。",
