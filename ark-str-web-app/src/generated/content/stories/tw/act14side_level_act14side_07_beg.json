        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "所以他一定會來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "......真是諷刺，在他們看來，我們希瓦艾什家，居然成為了挾持自己大小姐的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "難道不是嗎？恩雅·希瓦艾什，現在是我們的人質。",
