        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "我在幫你們認清現實。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "還是說，你們其實不知道，恩希歐迪斯最終要做的，絕不是什麼還政。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "將這個國家交給宗教，從一開始就不在他的計畫內。",
