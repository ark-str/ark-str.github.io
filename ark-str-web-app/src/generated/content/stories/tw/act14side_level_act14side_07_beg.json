        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "如果你不喜歡這種說法，我可以換一種，聖女成為了我們重要的籌碼。",
