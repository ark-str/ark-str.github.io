        },
        {
          "type": "dialogue",
          "speakerName": "菈塔托絲",
          "text": "而實際上也確實是這樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿克托斯",
          "text": "博士，以你的智慧看，還有什麼可做的事情？",
