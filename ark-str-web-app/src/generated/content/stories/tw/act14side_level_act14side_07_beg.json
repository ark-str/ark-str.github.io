      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "營救聖女？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "恩希歐迪斯沒有立刻去攻打另外兩家有兩個原因。",
