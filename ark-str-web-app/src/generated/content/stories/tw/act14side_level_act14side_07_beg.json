        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "但她成為了聖女，並且她做得很好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "那她就必然會成為恩希歐迪斯的阻礙，僅此而已。事已至此，不允許舞台上存在做得比希瓦艾什家家主更好的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "......我知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "我當然知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
