        {
          "type": "dialogue",
          "speakerName": "菈塔托絲",
          "text": "表面急行軍實施破壞，看起來是為了營救尤卡坦，並且吸引對方注意，讓對方對你的目的產生誤解。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "菈塔托絲",
          "text": "你讓正面大部隊負責落實這種誤解。",
