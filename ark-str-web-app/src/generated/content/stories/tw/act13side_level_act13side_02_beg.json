    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "......嘿......不太好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "失血......已經是小事了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "感染的地方在作痛......它們在蔓延......好痛......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "各位尊敬的觀眾，因賽場突發事件，請隨工作人員安排，及時疏散，頒獎典禮將推遲至兩小時後舉行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "重複一遍——各位尊敬的觀眾......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "......野鬃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "......求你......幫我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "......索娜會找到你的妻子和女兒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "放心吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安保人員",
      "text": "......！源石在他的體表蔓延！不能再拖了，立刻裝進封閉箱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾沃娜",
      "text": "你們要做什麼！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安保人員",
      "text": "阻絕感染。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "......你們......該死的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "艾沃娜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "要記住他們每一個人的臉......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "記住......那些騎士......那些卡西米爾人......這些陰狠的兇手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "別放過，他們任何一個......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "輪到你了，快出牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "急什麼，讓我考慮考慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "你就剩幾張牌了你考慮什麼啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視裡的聲音",
      "text": "下面播報一則緊急新聞——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視裡的聲音",
      "text": "於今日進行的特錦賽花樣競技單元的奪旗戰項目，發生了一起意外——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視裡的聲音",
      "text": "由於一位感染者騎士在比賽前瞞報身體情況，並在比賽中負傷後，堅持使用源石技藝——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視裡的聲音",
      "text": "——在比賽中途當場休克，經搶救無效死亡——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "......感染者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "......死亡？死了？死在賽場上？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視裡的聲音",
      "text": "據悉，相關醫療部門已經完成了賽場清理，競技場將於翌日消毒後重新投入使用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電視裡的聲音",
      "text": "截止至事件發生後三個小時，國民院已經接到多條投訴，希望重改感染者騎士法案——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "......重改法案？裝模作樣，他們就是不敢打自己的臉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老工匠",
      "text": "血騎士那個時候，他們迫於壓力承認了感染者的合法性，要是現在改回去，面子上哪掛得住？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "感染者問題可不是兒戲......“面子”還能影響決策？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "幾十年前，騎士貴族們的“面子”，小過嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "時代不同了，雖然我不太懂他們在想什麼，但無論在任何地方，保護運作規則本身，比客觀的結果還優先。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "光頭馬丁",
      "text": "我們都吃過苦頭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "電視裡的聲音",
      "text": "目前，現場已清理完畢，出於安全考慮，所有參賽騎士將在三日內接受醫療檢查——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "對於此次事件，騎士協會同樣給予了高度關注。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "現在，多個騎士團聯名向騎士協會建議，感染者的意外死亡，不可控的源石技藝，以及在特錦賽期間存在造成大規模感染的風險——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "喝——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "沒問題，瑪莉婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "武器的重心調整很完美，我已經很久沒有使用過如此得心應手的武器了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "啊......嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "畢竟是根據姐姐先前的戰鬥特意調整的嘛，嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "......既然從資料上講已經初步調整好了，接下來，該稍微實戰一下試試手了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "瑪莉婭，靠邊站點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "啊......好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "兩位都不要勉強啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "......呵，不錯的眼神，瑪嘉烈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "就該這麼認真，瑪嘉烈，你要是敢放水，我的自尊心可是會受傷的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "當然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "那麼——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "——對此，我們請到了多位騎士競技專家發表了自己的看法，請連線騎士協會負責人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "啊，各位卡西米爾的市民，上午好——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "——感染者可以不依賴施術單元而施法，這在醫療領域已經有了淺顯的結論——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "但是放在賽場上，這是“極不公平”的——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "（......公平。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......公平嗎。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪恩納",
      "text": "想在規則中戰勝規則的主人？癡人說夢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "唔......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "沒事吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "呃......好、好啦，快鬆手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "抱歉，很久沒有用過長柄武器了，火候還不到家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "——瑪、莉、婭？你在笑什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "欸，啊，對不起，抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "......瑪嘉烈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "你真的變了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "唔？有嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "......不是說外表啦，頭髮又亂了，過來，我幫你梳理一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "瑪莉婭，把梳子拿過來。在你的工作台後面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "啊，好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "......坐吧，休息一會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "嗯，麻煩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "真是......感覺離你上次離開，也就是一眨眼的功夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "（一眨眼的功夫......你又離我們更遠了......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "——據悉，死亡的感染者似乎與非法感染者事件有所牽連，相關情況仍在調查中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播裡的聲音",
      "text": "騎士協會承諾，絕不會因為一些小小的風波，導致特錦賽賽程受到影響——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "姐姐......那個......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "又是英格拉嗎......在賽場上殺死對手，這種事情......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪嘉烈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "螢幕裡的聲音",
      "text": "——現在，參與感染者騎士相關賽事的觀眾，紛紛要求騎士協會作出處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "螢幕裡的聲音",
      "text": "與此同時，本次事件的直接參與人，“鏽銅”奧爾默·英格拉等數位騎士也接受了採訪——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "您在聽嗎？馬克維茨先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "啊，抱歉，朱維爾，你接著說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "是。其實是來自騎士協會的一份表單，裡面記錄了本次比賽所有大騎士的個人資料和注意事項。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "聯合會也不希望和這些大明星們搞壞了關係，所以希望我們多加注意吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "我看看......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "（都是些老牌選手......唔，果然耀騎士也在其中嗎......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "這位“逐魘騎士”也沒有騎士團所屬？我本以為打入特錦賽還不屬於任何騎士團的特例只有耀騎士一人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "而且，“逐魘騎士”......一般來說大騎士的封號都是言簡意賅的單字封號吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "他還不是大騎士？那他有什麼特別之處嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "啊，這位啊......哈哈。這位可讓騎士協會頭疼了許久，雖然我不太明白......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "他本人對騎士封號一類的事情完全不在意，對於聯合會的安排也是置之不理，但是也不會刻意違抗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "是個怪人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "怪人嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "是，不過他的實力毋庸置疑，而且不知為何，似乎有一些騎士家族對他的身份很好奇，已經來協會問過很多次啦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "不過我們也不是很清楚他的底細，似乎是從靠近薩爾貢那裡的某個鄉下來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "馬克維茨先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "......我知道了，你先走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "啊......對了，朱維爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "唔？您說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人馬克維茨",
      "text": "我還是你認識的那個馬克維茨......不用對我這麼拘謹，挺不習慣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "啊......遵命，我是說，明白，馬克維茨......先生。",
      "portraitKey": null
    },
