{
  "server": "tw",
  "storyId": "main_5_level_main_05-03_end",
  "groupId": "main_5",
  "stageId": "main_05-03",
  "title": "義膽凡軀",
  "storyCode": "5-3",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_05-03_end.txt",
  "sourceHash": "eda38cf77ce673848c3afebd4bd08ca2258524a00d939e839c1d48e215644032",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "為什麼都跑了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "用法術攻擊她啊！為什麼要逃跑？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "別，別跑！她，她過來了！攔住她啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "其他人都去哪了？為什麼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "只剩你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "呃，呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "鬼......救，救命......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......就這樣也想阻攔我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "不，我，不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "就這樣——也想阻攔我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "饒了我，饒了我吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你不配被這面般若享用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "咿，咿咿咿咿！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "丟，我們甚至還沒來得及發動攻擊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "一個人，兩分半鐘，她根本是一個人解決了所有整合運動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "真是條惡鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "慶幸你沒在五年前遇見她吧。我也很久沒見她這樣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "其他逃竄的整合運動呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "已被各小隊分頭抓獲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "......陳sir，星熊督察她好像在向你招手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "醫師，跟我來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "星熊，你剛才還向那些整合運動問了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "問他們倉庫是不是陷阱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "如果全部都是爆破物的話——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我就把他們一個一個丟進去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "所以呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "沒有。阿發被埋伏了以後才逃進去的。整合運動他們原本就埋伏在附近。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "老陳，你拉右邊門。我拉左邊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......似乎被卡住了，怎麼拉也沒反應。等我劃個口出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "算了，我撕開就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "（咆哮）！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "開了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "XR02，告訴我你的位置！XR02！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "XR02！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "陳sir......我聽見戰鬥的聲音，倉庫大門似乎也......破了。可能是整合運動。我會處理好自己......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "不，那是我！你別掛斷！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "是陳sir嗎？那太好了......我在......最裡面。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你的傷......你的眼睛怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "不小心中了法術。沒事，不妨礙，我，咳，給你東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "醫師，給他止血！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "不。陳sir，不用了。我知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "多話！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "是真的。看到我中了幾箭了嗎？我瞎了，也不想再動了。痛，我夠了。我很累。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "拿好，陳sir......S249TA，F106。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "49. 位置我記住了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "紙上是細節。整合運動滲透感染者聚落後的情報，沒有發給其他頭目，單線傳遞......一定是特殊目標。你得看看，越快越好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "咳......我可是，花了很大功夫才拿到......算了，陳sir，我沒想到會有這天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "雖然我起到作用了，可我沒想到會是以這種方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們都沒想到。因為你的努力，我們才有機會阻止敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "哈哈，咳，我沒喜歡過龍門，龍門也沒喜歡過我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "但現在，我居然給整個龍門做了點什麼，一個街頭仔能做到這步，值啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "中水三傑也算街頭仔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "有鬼姐在，我永遠都是街頭仔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "......陳sir，鬼姐她還好嗎？還在當差嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "還在。我和她搭檔很長時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "陳sir，鬼姐她......太耿直了。她在會裡的時候沒人，咳咳，敢動她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "但她鬥不過龍門的大人物。你一定得看好她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "鬼姐絕對不能丟臉，龍門那些趾高氣揚的富人別想因為她的出身欺侮她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "我只求你這一件事。就這一件。咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "不會的。星熊很強，沒人能動得了她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "雙拳難敵四手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "整個近衛局都挺她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "那好，太好了，鬼姐，有陳sir在，我們都放心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "陳sir，你還在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "我算不算是個好人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "幾年前，不好說。但現在你確實是。你是龍門引以為傲的好公民。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "哈哈哈，咳，哈哈......礦石病衰仔也能是好人了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "有些龍門人會糾結礦石病，但你不如問問龍門城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "怎麼，我問它，它難道還會回答嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "哈，我替它回答吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "“我不在乎。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "阿發，你一直是、也永遠是個龍門人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "謝謝你，陳sir. 謝謝你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "陳sir，有兩句話，我想你帶給鬼姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你自己和她說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "什麼意思？你是說......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "......大姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "啊。在這兒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "陳sir，你該早說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "她自己不出聲。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "大姐，我做得好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "還不夠。你得活下來才算做得好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "對不起，哈哈......能被大姐背一回，我已經值了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你想去哪？你從來都不肯告訴我你是從哪來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "就龍門。其實吧，我根本沒去過其他城市。如果可以的話，把我的骨灰埋在以前那個地方就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "總壇？可......那地方已經徹底荒廢了。一塌糊塗，我都不知道該怎麼打掃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "沒關係的。只要和其他人......放在一起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "大姐......雖然我們一直都怕你，但我們其實......都挺你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "線人",
      "text": "一直......都......挺你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我也是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
