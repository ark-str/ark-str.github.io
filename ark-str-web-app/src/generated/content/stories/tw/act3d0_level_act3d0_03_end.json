  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "保鏢A",
      "text": "燙燙燙！焦了焦了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保鏢B",
      "text": "噫！我的頭髮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保鏢A",
      "text": "嘖，撤退，撤退！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "哈哈哈，果然還是打架有意思啊，博士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "啊，對了，博士，我這是為了救你，而且也聽你的話沒有下重手了，你可不許告訴赫默我打架的事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "要是被她知道了我的作業肯定又要變多了！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "沒問題。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "伊芙利特",
              "text": "嘿嘿，我就知道博士是個好人！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "作業你要自己努力。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "伊芙利特",
              "text": "哼，那我可不管！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "源石驅動的火焰噴射器......而且這個功率，好厲害的術師。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "大姐，你的眼光不錯欸，我超厲害的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "我叫錫蘭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "謝謝你救了我們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "哦、哦......沒關係。這，這是我該做的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "喂，博士，這個姐姐好懂禮貌啊，這種時候我該怎麼做來著？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "微笑。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "鞠躬。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "跳舞。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "噢，好吧，那我試......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "啊？我忘記我的烤肉還在架子上了！我不跟你們多說了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "博士，錫蘭，你們之後要是想吃燒烤記得來找我啊！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "竟然直接就跑開了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "博士，我們也趕緊回去吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "博士，你們平安無事，很好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "十分感謝您的相助，請問......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫拉格",
          "text": "你可以叫我赫拉格。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫拉格",
          "text": "和博士一樣，我也來自羅德島。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫拉格",
          "text": "博士，你現在有時間嗎，有些話我要單獨告訴你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
