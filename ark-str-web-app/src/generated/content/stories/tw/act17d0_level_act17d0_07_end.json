{
  "server": "tw",
  "storyId": "act17d0_level_act17d0_07_end",
  "groupId": "act17d0",
  "stageId": "act17d0_07",
  "title": "地堡防線",
  "storyCode": "OD-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act17d0/level_act17d0_07_end.txt",
  "sourceHash": "c9c4794b3445436d30e9178eb31c0a77543295b1ad8afebb19522040832688a4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "皮加爾",
      "text": "滾開！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加爾",
      "text": "真是沒完沒了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "他們到底造了多少這種鬼東西！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "雷蛇！小心身後！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "源石畸變體",
      "text": "噶......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "芙蘭卡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "你在搞什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "領主小姐，幫我搭把手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加爾",
      "text": "好，好的!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "你......快跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "你不要說話了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "我的腿......你......你，別管我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "不要說蠢話！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我背你，快上來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加爾",
      "text": "它們又衝上來了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "趁現在，快跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧克芬",
      "text": "到這來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "奧克芬先生！你怎麼上來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧克芬",
      "text": "我實在是做不到待在下面乾等著，我可也是羅德島幹員啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "太好了！幫大忙了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "準備引爆爆炸物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "三、二、一......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "只是短暫被擊退，用不了多久它們還會再來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "它們......好像變少了一點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "“迎賓踏墊”已經用完了，我也沒有子彈了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "亞歷山大，接下來怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "去避難所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "去避難所！帶著羅德島的幹員，去避難所！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "那你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "我掩護你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "掩護？那誰掩護你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "我不需要掩護。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "冷靜點，亞歷山大！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "我很冷靜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "我已經受夠了不停地躲藏和撤退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "撤退無法帶來戰爭的勝利，歷史無數次證明了這件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "但我們不是在打仗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "對我來說，這就是在打仗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "當他們向感染者掏出武器，想要加害我所熟識之人時，這就是一場戰爭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "我這輩子經歷的戰爭太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "只要我在這裡多幹掉一隻該死的怪物，那些鎮民存活下來的機率就會上升。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "我就會守在這裡，直到彈盡糧絕，直到天昏地暗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "戰爭沒有結束，我為什麼要撤退？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "你自己說過不要逞英雄的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "但是我不覺得這是“逞英雄”，蒂娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "我只是在做對的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "無論如何，這一切都得在今天結束。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "亞歷山大！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我會留下來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "老先生，怎麼你也......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "事情總歸會變成這樣，從你們決定留下來幫忙的時候，其實大家都預料到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我會留下來，和這位戰士協助防守，如果情況太糟，我可以掩護他撤離。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "老先生......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "亞歷山大，給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "這是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "我自己試做的源石爆炸物，只剩下這兩個了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "......謝謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FROST",
      "text": "活著！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "......我不敢保證。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "你沒和她說實話，你也沒打算撤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "哈哈哈......你就不要戳穿我這個老頭子的小算盤了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "你需要有人幫你頂住那些怪物。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "這是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "據說是老領主的佩刀，我借來用了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "這把刀很好，老領主的品味很不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "漂亮的花紋鋼，手工鑲嵌的松綠石刀柄，不比那些現代工業生產的武器差多少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "比起衝在最前線，拿著弓箭在後方要安全得多。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我老了，動作遲鈍了許多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "但是這把刀，依舊是鋒利的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我還一直都不知道你的名字，戰士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "亞歷山大·謝納維耶夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "叫我亞歷山大就行了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我也應該告訴你我的名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "但是從鮮血塗抹山谷的那天起，我的名字也隨著過去的一切掩蓋在黃沙之下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "沒關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "你決定留下戰鬥，這很重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "“巡林者”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "“當時他們都說我要死了，但是他們錯了，我重生了。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "無論那些怪物有多少隻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "TACHANKA",
      "text": "讓它們放馬過來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
