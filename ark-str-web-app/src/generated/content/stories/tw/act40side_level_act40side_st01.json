{
  "server": "tw",
  "storyId": "act40side_level_act40side_st01",
  "groupId": "act40side",
  "stageId": "act40side_st01",
  "title": "陳皮菊花茶",
  "storyCode": "OR-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act40side/level_act40side_st01.txt",
  "sourceHash": "b77b1cd3b30151123e19d2d22ffafd4819cca73358743777163bcd6a63e04d9e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=2>1062年4月21日    穀雨</>"
    },
    {
      "type": "dialogue",
      "speakerName": "吆喝的夥計",
      "text": "客人，客人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "吆喝的夥計",
      "text": "這麼大的雨，進來喝壺熱茶，避避雨再走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "不必了。這場雨眼看著一時半刻也停不下來，還是快些趕路吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "吆喝的夥計",
      "text": "哈哈，有人盼著這場雨停下，可還有人盼著它多下一陣啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "吆喝的夥計",
      "text": "賣傘的商販笑開花，就是苦了趕路人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "閣下說的話倒是有趣……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "吆喝的夥計",
      "text": "客人還是歇歇腳吧。有人託我囑咐您，前路坑窪不好走，怕您踏錯沾濕了鞋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "嗯……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "吆喝的夥計",
      "text": "客人，這邊請吧，要見您的那位已經在裡面等著了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "尚書大人……好久不見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "不，現在應該稱您為……太傅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "玉門一別，的確很久不見了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "我以為這次回京述職，應該要先見司歲台和兵部才對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "所以我才趕在那之前來見你一面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……陛下駕崩了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "何時……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "半月前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "我想……如果陛下是壽終正寢，太傅也不會專程來見我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "難道……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "坐在陰影中的人伸出手，他的掌心，正躺著一枚黑色棋子。"
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "六十年前，他逃離了那座古寺，將自己化作一百八十一顆黑子，分散各地，至今下落不明。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "而就在半月前，司歲台在京城發現了這一枚黑子的蹤跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "……他做了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "尚不知曉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "唯一可以確定的是，他絕無可能進入禁城……應是有人主動見了他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "這個人的身分，不方便去查。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "他想做的事，按理不該牽扯到旁人才是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "今天我本不該見你。可當初那個罪人引起動亂時，畢竟是你親手將他制伏的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……宗師，對此事，你知道什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "……並無所知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "那次事故之後，我也沒有再見過他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "那我相信宗師。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "需要我做些什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "不要停留，即刻返回玉門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "烏薩斯動蕩不斷，玉門守將新舊交替，這個時間，切不可再使人心動蕩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "司歲台與兵部，我自會處理。你不在局中，我才能以重任相託。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "……明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "棋局之事，我會讓司歲台暗中繼續查下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "特殊時期，宗師不便再露面——你可以當今日沒有見過我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "真龍他究竟是……炎武殿下還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朔",
      "text": "這個時候，他應該——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "炎武……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "陛下去世的那天晚上，是炎武去見了他。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "啟稟殿下，那叛臣一族二十八人皆已收監。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "可核對名錄時發現，其家中本應有一個尚不滿月的嬰兒——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "但是禁軍今天在太師府中搜查時，將整個宅子翻了個底朝天，也沒有找到那嬰兒的下落。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "……一個還在襁褓裡的孩子，總不會是自己逃走的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "還是有人惦記著她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "殿下不必煩擾，禁軍會找到她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "哼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "今天早些時候，刑部尚書求見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "這一系列的案子，到底該怎麼審怎麼辦，他想徵求殿下的意見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "……依炎律審。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "我會轉告他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "我的那位兄長，現在到何處了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "據守軍報告，半個時辰前剛出京城。有部分禁軍追隨他叛逃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "守城士兵未得軍令，不敢阻攔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "是啊……我的確沒有下過要將他留在百灶的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "是他不願意留下，棄了所有人而去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "跟著他走的禁軍……有多少人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "十八人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "我這位兄長，就算犯下了這樣的滔天罪行，還是可以讓太師替他赴死，還是可以讓這十八死士願意追隨他而去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "這滿朝文武，還有多少人的心在他那裡？有多少人，還在盼望他回來坐這個位置？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "可如今，是殿下在這個位置。讓炎國萬世昌寧的責任，也在殿下身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "炎國上下，任誰都可以心思徘徊，猶疑不定……唯獨殿下您不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "我有許久沒有走出這座宮殿了……太尉，告訴我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "百灶的這場春雨，停了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "只要殿下想，這場雨就可以停下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "……若殿下改了主意，還來得及將他們留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "……乏了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "侍從",
      "text": "御膳司備了些八寶攢湯和筍絲，殿下可要用點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帷幕後的聲音",
      "text": "起菜吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "乖……乖……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "不哭不哭，我們回家去……就快要到家了……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "再快些……勞駕，麻煩您再快些……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車夫",
      "text": "這麼大的雨，路都看不清，不能再快啦……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "離下一個驛站還有多遠？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車夫",
      "text": "怎麼也得三十里地吧……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車夫",
      "text": "這位兄弟，您是有多要緊的事……拖家帶口的，怎麼就偏挑這麼個晚上趕路啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "……請快些吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "車夫",
      "text": "啊……！啊！什麼東西——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "車夫",
      "text": "見鬼了！這荒郊野外的，怎麼還有活人啊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "男人四下張望，綿延不絕的雨幕遮住了視線，夜色茫茫，什麼都看不到。"
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "不可以再乘車了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "勞駕，這些錢都留給您。請把車駛到前面的驛站去，要是有人問起的話，千萬不要說今晚拉過帶著孩子的客人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "在下拜謝先生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車夫",
      "text": "可是……這，唉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車夫",
      "text": "這麼大的雨，您要上哪去啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "從小路走……穿過北邊的林子——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚慌的女性",
      "text": "啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "怎麼了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚慌的女性",
      "text": "孩子……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚慌的女性",
      "text": "孩子不見了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉皇的男人",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的老人",
      "text": "這就是……那個孩子。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "襁褓中的嬰兒睡得香甜，臉蛋上沾染了泥污與血汙也渾然不覺。"
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "您交代我辦的事，我都已經辦成了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "他們的手段，我都清楚，也知道該怎麼應付。大人不必擔憂，我絕不會讓半點血沾在您的身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的老人",
      "text": "先生大義……老朽無以為報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "不……您不該謝我，我不是為您才做這件事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "那位大人曾有大恩於我。我做的這件事，卻不能為她洗淨冤屈，甚至連為她報仇都談不上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "我沒有親人，不用操心身後事。想拜託大人的，也就只有這一件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "大人……請您收養這個孩子吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的老人",
      "text": "這……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "您不必告訴她什麼，只要讓她平安長大，安穩地活過這一輩子就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的老人",
      "text": "……你知道，她留在這裡，就多一分風險，多一分將這樁舊案重新翻出來的可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "可這難道不是您盼望的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "時勢使然，現在我們注定無可奈何。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "可是總有一天，不管三十年也好，四十年也好……只要有朝一日，真相能大白於天下……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滿手血汙的人",
      "text": "這些血……就不算白流。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的老人",
      "text": "好，我答應你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
