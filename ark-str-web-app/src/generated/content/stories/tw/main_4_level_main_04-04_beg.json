{
  "server": "tw",
  "storyId": "main_4_level_main_04-04_beg",
  "groupId": "main_4",
  "stageId": "main_04-04",
  "title": "不要恐慌",
  "storyCode": "4-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-04_beg.txt",
  "sourceHash": "22954628ad67ca608a86f0b33968830540c28d8bf22e725b0942f6958647aa33",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "沒等太久吧。近衛局的會議稍微耽誤了點時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "沒事的，陳長官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "（陳長官，就像什麼事都沒發生過一樣......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "情況如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "羅德島的偵查小隊已經提供了一些有效情報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我總結了一下，從其中選了幾條你會感興趣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊......星熊警官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "別在意。我也想稍微聽一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "繼續說吧，阿米婭，沒關係的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好的。依據羅德島從部分感染者那裡得來的線索——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "偵查小隊已經查明了龍門平民區內整合運動的一部分窩點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "然後呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "有數支整合運動小隊正在謀劃針對龍門的防衛力量發動襲擊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們甚至查到一個整合運動向內滲透的管道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "呵，真是囂張。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "龍門近衛局被小看了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "關於那個切爾諾伯格分城廢墟的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "羅德島有數支偵查小隊正同時在分城執行任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "其中確實徘徊著許多整合運動的成員，而原本的居民基本都不知去向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "有一支小隊甚至與整合運動發生了三次以上戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "只是，以目前的情報量而言，我們還不能斷定這個分城與整合運動的行動究竟有何聯繫......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但我建議，將這座分城作為接下來的重點作戰目標之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......是嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "星熊，幫我去拿下報表。在我桌子左邊第三格抽屜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "現在？行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你繼續說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嗯，綜上所述......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "羅德島建議，應該發動一次聯合作戰，完全剿滅龍門內部的整合運動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "並不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "近衛局不會允許的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......什麼？陳長官......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我說，不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你，是感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "再在貧民區內執行任務，只會引起更大的騷亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "這是近衛局的決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊，稍等，我接一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這裡是阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是，是阿米婭嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......！潔西卡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "是的，這裡是潔西卡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是在進行什麼隱秘行動嗎，聲音這麼輕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "我們在分城廢墟發現了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......整合運動的領袖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "而且有......兩個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "什麼？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "喪家犬就這樣灰溜溜的跑回來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我可不屬於你們這種下等種族哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——如果你不是成功完成了任務，我一定讓你這張臉上多添一兩道疤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "麻煩被炸的手足全失的小孩子用嘴來為我化妝，真過意不去呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我們兩個鬥嘴——可是沒什麼好處的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我姑且承認了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "那麼，魚上鉤了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "一定。就看愛國者那個老傢伙能不能把真貨帶回去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "說起來，你還挺怕這老頭的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我心情已經有些不太好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哎呀，抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不過在釣上大魚之前，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "要嘛我們倆，就先相互忍耐一下吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哼。是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我先得解決這些小的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "羅德島的幾位，出來吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——想要在我面前隱藏自己，是絕對不可能的哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "潔西卡，別！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "這可能是陷阱......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "他發現我們了！必須——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "如果擊倒敵人的領袖的話，我們......必須......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "嗯，果然在啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是哪裡來的小貓咪呢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "這裡可不是讓你隨意玩耍的地方哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "喂，你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "是！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——分食豐盛的獵物之前——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "先去嘗嘗小的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "噢噢，噢噢噢！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "呿！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
