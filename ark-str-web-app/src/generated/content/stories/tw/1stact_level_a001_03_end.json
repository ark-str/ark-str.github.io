  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "幹掉了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "大鮑勃，你沒事——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "咦？你腿上的傷口......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "那裡有漏網的！可能是瓦各斯克團的人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "這個我自己能處理！先擊退敵人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "這小個子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "喂，喂，你那是什麼眼神？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "別，別過來，不怕我在你身上開個窟窿嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你都解決了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "真厲害。這麼小的個子，本事倒是不小。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "坐在那裡別動。我來給你包紮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "不礙事，讓我起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你看到了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你看到我身上的結晶了吧？你難道想被感染嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "感染者，本來就是我們羅德島的救助對象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "羅德島......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "羅德島是......？不是維多利亞......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "以前是維多利亞的騎警，不過現在，是羅德島的幹員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "離我遠一點，小姑娘。我是感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "可蘿爾小姐，這可能有點血腥，你稍稍回避下吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "好啦，已經止血了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你經常給感染者這麼做嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "你就不怕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "我的同事有很多都感染了礦石病，但我分不出究竟有誰感染了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "也就洗澡的時候能看得出來吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "——哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "多謝你了，沒戒心的小個子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鮑勃",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
