{
  "server": "tw",
  "storyId": "story_ghost2_set_1_story_1",
  "groupId": "story_ghost2_set_1",
  "stageId": null,
  "title": "自我",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_ghost2_1_1.txt",
  "sourceHash": "fef9690fe7f3276854e7f3e7f90b27f0302f4a14393fd39d507ee81bec7d62e3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "生命之喜"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "在此，我代表阿戈爾，接納你成為一名深海獵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我將是你的隊長，更是你的師長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "大海已准許我們行獵，而害物將無處躲藏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我將追隨，我將狩獵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "起來吧，勞倫緹娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "你可曾跳過舞？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "舞蹈課上學過一些，但不太熟練，隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "熟練與否並不影響舞蹈的感觸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "上前一步，牽著我的手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "在正式開始學習殺戮前，我希望你能夠先理解——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "生活的技巧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "那麼開始吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "聽清節奏，起——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "伊比利亞 格蘭法洛"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "所以，是......這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "嗯，踩好節奏，腳步放輕，其他交給我來就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "彎腰......揮手......轉圈......停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "嗯，跳得不錯，斯卡蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "說不定隊長已經迫不及待想成為你的伴舞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "這可一點都不好笑，鯊魚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "哎呀，是這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "呼呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "看來你恢復得不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "有細心的斯卡蒂照料，想繼續生病可不是件容易事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你還是那個總在胡言亂語的鯊魚，一點都沒變。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "能這樣真心誇獎我的人可不多，或許我該說聲謝謝？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "嗯，這麼想來，我的確欠你一個真心誠意的道謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "為了......感謝你對我的照料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "另一個我發病的時候陸上人可按不住我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那時候有能力把我重新抓回病床上的，想必也沒有別人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "斯卡蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我只是......很高興在岸上遇見一個深海獵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "除了你，隊長，二隊長，我再也沒有見過其他獵人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "保護隊友是我的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "就是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "謝謝，斯卡蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "不客氣，鯊魚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那麼，我教你領略了舞蹈的魅力，你能不能也教教我歌唱的奧秘呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "另一個我唱歌的聲調不太悅耳，我想請專業人士幫忙調整一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我覺得挺好聽的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "可我還是想要唱自己的歌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "方法我可以交給你，你可得好好學，鯊魚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我會成為一個好學生的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "（悠揚的歌聲♪）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "（躍動的歌聲♪）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "聲音再沉一些，把氣息穩在肚子裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我試試看。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "打擾了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "中午好，隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "二隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "斯卡蒂，凱爾希正在找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "凱爾希？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "嗯，她需要對你進行更有針對性的醫療檢測。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "好，我現在就過去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "一會見，鯊魚，二隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "一會見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "真可惜，我還想多唱一會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "現在有什麼計畫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我們時間有限，無法回到羅德島進行補給。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "凱爾希會負責調配羅德島上的資源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "伊比利亞的聖徒承諾懲戒軍會支援我們行動，他們是我們返回阿戈爾的重要助力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "你已經在計畫了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "考慮到海嗣大群的規模，以這些資源來創造進入阿戈爾的機會成功率並不高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "但設計並完成既定戰略目標，這是我作為戰爭設計師的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "但讓我擔憂的事情不止於此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "阿戈爾的城市遍佈大洋，而我有幸造訪過大多數。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "可那座城市......我毫無印象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "城市規模、建築細節，全都不是科學院頒佈的標準。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "這下可麻煩了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "所以在進入城市前，我們需要盡可能做好準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "等到時機成熟，城市的遭遇，阿戈爾的近況......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我確信能夠給你們一個交代。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我和我的鋸子隨時待命，需要切點什麼的時候，叫上我就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "勞倫緹娜，你有時間嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "今天的海風很舒服呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我們散散步吧，隊長。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "嘶——呼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "做回自己的感覺真不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "很高興你能夠擺脫源石造成的影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "因為我還聽得到海浪的聲響，聞得到海水的鹹味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "現在還算穩定，我能夠控制住自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "至於遠離海洋之後......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我不太確定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "不必勉強，你做得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "其實我也重新瞭解過自己，另一個我應該也會很樂意為了我的目標做出些小貢獻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我和我會相處愉快的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我和凱爾希談過，她會著手解決你遇到的難題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "和斯卡蒂的問題一樣，這是我們互助合約的一部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "有勞你費心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我們去鎮外逛逛吧，我想邀請你欣賞些藝術品。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "就是這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "看到了嗎，遠方那塊矗立的山岩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "很抽象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "很......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "幽靈鯊在組織語言為歌蕾蒂婭描述這塊被海風侵蝕出獨特造型的石塊。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "從正面看，它像是披著粗麻的老嫗，但只要往旁邊走幾步，就變成了一位靜靜祈禱的信徒。\n就像是可能性的具象，單一而多元，令她一時竟找不出合適的詞彙。"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "很美。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "風蝕賦予了這件作品在多重維度上的張力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "你想讓它成為你的作品？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "成為？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "不，我沒有資格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "它已經是件完成品了，多鑿一下都是褻瀆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "啊啊，可惜這樣的瑰寶不會出現在阿戈爾城市中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我們在海洋中征服了自然，這本就伴隨著代價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "但我還是很開心能見到這樣的奇跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "想要在阿戈爾雕鑿像它一樣大的雕像得有高級技術員審批，之後要去購買造石機的使用權限或者花更多資金去購買合適的石料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "還得支付大型雕刻台的租用費用，以及確保雕石的雙手絕不出錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "耗費了如此多心血只是開始，接下來的年月中，那塊石料就是你的子嗣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "拋開生活瑣事，日常飲食，甚至狠心摒棄閃現的靈感，把一切都撲在石頭上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "費盡心力去撫育它，刨去雜質，賦予生命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "最終，它必須去接受眾人評判，而我一定會聽到些蠻不講理的評論。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "這就是你本應走上的職業道路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "曾經有人和我說起過這樣一個笑話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "為什麼雕塑家也被算作技術工作者而非藝術人員？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "因為他們主要負責為科學院雕刻塑像，而那些科學人員想當然地把藝術發揮當成了純粹的技術。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "哼哼~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "你笑得很開心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "哎呀，是嘛，呼呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我只是覺得這樣向你描述，你就能理解我為什麼這麼喜歡那塊石頭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "時間的偶然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "嗯，時間與自然造就的偶然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "正因為偶然，欣喜感才能在胸膛裡跳動不止。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我們能在這裡坐一會嗎？我想多觀賞它一會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "請便。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "吃不吃鱗魚乾？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "雖然工藝粗糙了些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "你還感受得到饑餓嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "這些不充饑，只是提供些微味蕾刺激和咀嚼行為的快樂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "這不必要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "確實不必要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "試試看？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "哼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "（取過鱗魚乾）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "看來你對零食很陌生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "（細細咀嚼）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "乾燥，堅硬，調味料過量了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "但它很方便，還能帶回一些生活的實感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "每當我學有所成的時候，父母就會塞一包這樣的鱗魚乾到我手裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "包裝比這個更精緻，更鮮亮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "能有認同支持你的血親是一種幸運。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "但我也因為他們吃了些苦頭呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "養育我的女性承擔著城市穹頂的設計工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "而我的父親，則負責在工程中實現她的創想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "進行深海獵人招募的時候我已經閱覽過你雙親的資料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我總是隨著他們到處漂流，看著母親圖紙上的穹頂逐漸成形，看著城市從海床開始向四周延伸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "她的藝術美感影響著那些穹頂下出生的孩子，也影響著我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "一座又一座，一回又一回。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "見證從無到有的壯麗，以及從頭再來的喜悅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "她將深海從虛無的黑暗中解救出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我也希望，能成為她那樣的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我所停留的每座城市都賦予了我選擇的機會，音樂、運動、繪畫。阿戈爾豐富的文化底蘊開拓著我的視野。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我本以為自己還要抉擇許久，直到看到那座雕像，我下定決心成為一名雕塑家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "在海洋的黑暗面前，龐大無瑕的雪白人像是多麼珍貴。仰望著它，看著它的姿態，你在不經意間就會去模仿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那是祈禱，那是希望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "或許正是因為這些暗示，另一個我才會欣然接受教會修女這樣的身份吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我不會評價，這是你自己的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我還準備聽聽你的說教呢，真可惜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "被選擇成為深海獵人並不意味著要放棄追求夢想的權利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那你的夢想又是什麼呢，隊長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "待到城市的光亮重新鋪滿海洋，坐在阿戈爾大劇院的紅絲絨椅凳上，再看一齣戲劇。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "起身吧，我們已經休息了足夠久，該回鎮子了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "再過幾個小時，等太陽落下，星空就將顯現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "你好像很喜歡夜晚的天幕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "如海洋般深邃浩瀚的天空上點點光芒閃爍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "你不喜歡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "它能震撼我，但還不足以令我感懷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我們並非對海平面上的事物一無所知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "在我這樣一個雕塑學徒徒勞地想要將一瞬變為永恆時，天空已經讓永恆如每個瞬間般多彩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我怎麼能不感到激動？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "看來陸地生活啟動了你身為藝術家的熱情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "只是這片大地給我施加了足夠沉重的痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "漂上岸被曬得乾巴巴的，被可悲的傢伙們抓去灌了源石，現在還得接受海嗣們拿我稱兄道弟的現實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "所以我得抓緊時間享受，用我熱愛的藝術激情來為生活多加些調味料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "你應該比我更清楚，隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "藝術不會背叛，只區分美麗與醜陋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "而我很慶幸自己還懂得這一份美。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "城鎮就在眼前，今天還有諸多事項需要處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "感謝你帶來的短暫快樂，鯊魚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "請稍等一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "時機真合適，我想你得答應我一個不情之請。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我是否有機會，能邀請你跳上一曲呢，歌蕾蒂婭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "（伸手）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "我的榮幸，勞倫緹娜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "久違的共舞，我很享受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "是呢，以前也沒有跳過這樣一支舞呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "一支在乾燥草地上，潮濕的舞。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那是可愛的伊比利亞小鳥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "她往燈塔沿岸的方向去了，是想要再看一眼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "這裡的恐魚早已被殲滅，她去那裡做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "誰知道呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "接下來要回去工作了嗎，隊長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂婭",
      "text": "還有許多細節需要找凱爾希與那位老伊比利亞人確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那我就在鎮子外繼續閒逛一會，確保我們的小鳥兒可以安全歸巢吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "一會見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "可憐的小鳥，你迷路了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "誰！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "啊，是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "也是，只有你會這樣稱呼我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "夜晚的海岸可不是個散心的好地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "懲戒軍已經控制住了這裡，恐魚也被清掃乾淨，我想不出這裡有什麼可怕的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "對於陸上人來說，海浪有時候比海嗣更加無情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "浪潮來了，當心腳下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "呀！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "你真的瞭解它嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "就算不瞭解，我也會請求你們教授我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "為了應對災難，我必須學習。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "真好學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那麼，告訴我，你到這裡來，是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "我想再看看老師犧牲的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "再聽從一次他的教誨，再一次克服心中的恐懼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "唉疼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "你，你敲我腦袋幹什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "反應很可愛呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "呵呵，真有活力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "莫名其妙，你到底想幹什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "你已經能自信地直視前方了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "能不能請你描述一下面前有什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "大海，燈塔，懲戒軍的艦船，這難道還不明顯嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "再多看看，你應該看得到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "礁石，燈火，未完成的圓柱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "還有呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "你到底想戲弄我到什麼時候？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "抬頭。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "就在艾麗妮正準備生氣的那一刻，幽靈鯊指向了天空，她的視線隨著深海獵人的手指，攀上了夜空。\n看到滿天繁星的一瞬間，艾麗妮的怒火消失了。"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "你還感受得到，對不對，小鳥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "理想很沉重，你也做好了付出的準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "但在堅定信念戰鬥的時候，別把生活的快樂拋在腦後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "雖然平凡，但它們的確是能夠拯救你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "唔......嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "哼哼，聽話的小鳥兒，真討人喜歡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "回巢的時候，注意腳下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "你要走了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "呃，等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "還有什麼事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "我想，一直你啊你的這樣稱呼可能不太禮貌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "對呢，我好像從來沒有向你做過自我介紹。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "幽靈鯊後退兩步，微微提了下長裙。\n雙月的光芒灑在裙邊，粼粼波光反射出點點銀光，照在飄帶的經文上。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "你好，伊比利亞的艾麗妮，我是幽靈鯊，深海獵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "如果你願意，也可以稱呼我為，阿戈爾的勞倫緹娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "勞倫緹娜......勞倫緹娜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "很美麗的名字......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那麼，再會了，堅強的小小鳥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "（輕聲哼唱）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾麗妮",
      "text": "她在......唱歌嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......\n當我祈禱♪\n星星攀上夜幕♪\n當我舞蹈♪\n雙月褪去黑紗♪\n當我微笑♪\n大海要見證我的喜悅♪"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
