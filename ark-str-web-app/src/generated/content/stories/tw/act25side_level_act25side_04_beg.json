          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "......唔？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "感謝有你在我身邊。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "謝謝你幫助迷迭香。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "啊......哈哈......我們之間的合作還遠遠沒有結束，你老是這麼客氣的話，同一句話會重複很多遍的哦？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "博士......你真的這麼相信我嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你說什麼？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "沒事。走吧走吧，一起出發啦。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "赫默，這個溫度可以嗎......會不會太燙？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "你控制得很好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "塞雷婭的體溫穩定了下來，危險期已經過去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "伊芙利特，去休息一會吧。長時間使用源石技藝會損耗身體。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "不，我想陪著塞雷婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "我還記得以前我還住在白房子裡的時候，她也常常來到我的床前陪著我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "那時候我的身上總是很痛很痛，腦子裡也亂糟糟的，還會控制不住地燒東西。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "我不是每次都分得清楚她是什麼時候過來的。我只知道，當我睜開眼睛，發現她就站在床邊的時候，我會覺得特別安心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "所以我也想留在這裡陪她。雖然她的眼睛沒有睜開......但她一定能感覺得到我在。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "......她會知道的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "她只是需要......再多睡一會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "唔......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "還是感覺怪怪的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "怎麼了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "這麼看的話，塞雷婭沒比我高多少嘛。而且......掌心也軟軟的，指甲很漂亮，就和赫默的手抓起來感覺差不多啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "......嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "塞雷婭......當然只是個普通人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "恐怕她距離“普通”這個形容有些遠。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "雅拉主任......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "遇到什麼麻煩事都想悶不吭聲自己解決，又總板著一張臉，讓人有意見也不敢說出來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "你猜猜，以前每年我都需要為多少位防衛科的員工做心理諮詢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "您......對塞雷婭很不滿嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "不滿？嘖。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "那一年我問克麗斯騰，她是不是真的打定主意非要讓一個科研人員轉而負責防衛科——你猜你跟前這傢伙聽到之後做了什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "她把三十多枚竊聽器扔到了我的辦公桌上，當著我的面，用她剛研發出來沒多久的源石技藝把它們震成了碎片。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "很不幸，其中好幾枚正在運作，並且隸屬於我們可敬的市政部門。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "他們不過是對迅速嶄露頭角的科技公司抱有幾分最基本的警惕。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "我也樂於分享給他們一些“可控”的資訊，好讓他們在某些條款上放鬆一些。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "事後我不得不花了許多工夫去處理這些麻煩......可誰又能否認那個年輕瓦伊凡的決心與手腕呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "聽起來......塞雷婭一直都是那個塞雷婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "是啊，這麼多年過去了，她和那個時候相比，沒有任何長進。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "......她是我見過的意志最堅定的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "誰說不是呢？我一路看著她和克麗斯騰走到現在，我非常清楚，她有多麼堅韌多麼強大。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "但即便有著如此出眾的個人能力，她也不可能對抗......這整個國家。再任由她去扛這些早就扛不了的事，她只會粉身碎骨。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "收下這個吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "這是......車鑰匙？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "帶著塞雷婭和伊芙利特離開這裡，趁還來得及。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "塞雷婭......不會同意的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "不，孩子。我正在對話的人並不是塞雷婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "“無辜者的生命不該被置於由他人引起的危險之中”，你不一直都是這麼想的嗎？這個孩子不該被捲進來，你也是。沒人該在這裡喪命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "我需要......一點時間。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "雅拉主任？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "恐怕沒有時間了。從秘密通道出去，立刻。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫默",
          "text": "怎麼了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "......一位老朋友來了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......會議室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "開會的時候，帕爾維斯往往坐在靠窗的位置，繆爾賽思喜歡坐在中間，而你......雅拉主任，這是你的選擇，離克麗斯騰最遠。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "而你就和以前一樣，總是喜歡站在別人座位後面。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "呼......真讓人懷念。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "要喝點什麼嗎？紅酒，還是香檳？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "有這個必要嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "當然。斐爾迪南·克魯尼先生另謀高就，重返萊茵......難道不值得慶賀？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "你以為我是軍方的帶路人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "不，他們想在萊茵動手，我並不贊成。因為我知道，一旦副總統在萊茵出事，萊茵就完蛋了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "克麗斯騰可以不把萊茵當回事，但我不行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "我記得今天活動結束得很順利。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "別跟我裝瘋賣傻了，雅拉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "軍隊裡都是什麼樣的人，你未必沒我清楚。今天的事隨時都可能再次上演。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "趁那群野蠻人把我們過去十幾年的心血撕碎之前，你能不能跟我說句實話——克麗斯騰到底在搞什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "布萊克上校沒告訴過你嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "自從萊特女士失蹤的第一天起，我就把所有項目以及總轄有關的資料交了出去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "對了，還交了不止一次。就為了這件事，我可是加了好多天的班。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "呵，“萊特女士”，就彷彿你們只是普通的合作關係一樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "要我把你辦公室抽屜暗格裡的照片拿給布萊克看看嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "或者我們親愛的人事科主任已經想好了如何解釋，為何自己至今藏著二十年前的小克麗斯騰寫給你的新年賀卡？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "......只是一張舊紙片而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "孩子們長大之後，往往就沒那麼聽話可愛了。斐爾迪南，你比我更清楚才對。在359號基地挨的那一拳頭，是不是真的還挺疼的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "她躲了起來，就像一個死死抱著心愛玩具不放的孩子。可那不是什麼玩具，是該死的超級武器，背後還牽涉到一些誰都碰不得的秘密。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "只要你還在乎她，你就該把她拽出來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "還是說，你寧可眼睜睜看著她為了一個縹緲的理想去死？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "即便......我確實並不忍心看著她走到那一步，你又怎麼知道，我有能夠阻止她的方法？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "那可是克麗斯騰，斐爾迪南。她讓你輸得一乾二淨。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "她有可能放任這麼大的弱點——假如你們真的願意把我與她的關係視作她的弱點的話——在你們唾手可得的地方嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......好，很好。你拒絕了合作。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "那其他人呢？比如說......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "塞雷婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "你救了她，把她藏在這附近。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "你願意陪我說這麼多話，也是為了給她留點脫身的時間。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "可就算塞雷婭能順利地從這裡走出去，她又能去找誰？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "同樣深陷泥沼的羅德島，還是那群和你一樣，喜歡藏頭露尾的梅蘭德特工？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "......我不明白你在說些什麼。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "就在剛剛，軍方收到了一條新的情報。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "塞雷婭......還有她背後的那家名為羅德島的公司，涉嫌幫助克麗斯騰竊取事關國家安全的秘密。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅拉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "難道在萊茵生命工作的十多年，已經讓你天真到了......會把你的老東家當成什麼正義使者的地步？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
