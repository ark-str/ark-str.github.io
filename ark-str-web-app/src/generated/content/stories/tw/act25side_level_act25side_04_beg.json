          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "真巧啊，正想著什麼時候才能再見錫人先生一面呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "他的委託害得你們被軍方的人窮追猛打，怎麼都得讓他補償一下吧？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
