{
  "server": "tw",
  "storyId": "main_5_level_main_05-07_end",
  "groupId": "main_5",
  "stageId": "main_05-07",
  "title": "生死與共",
  "storyCode": "5-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_05-07_end.txt",
  "sourceHash": "2f46c38d43cbbcb1a4226f7d80a17f36123417f47f9715ebb59dc9ce6bf6656a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "醫療隊，原大古廣場南側12出口，傷者一名，身份是近衛局高級督察，動作快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "止血了沒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你還不清楚我嗎。傷口已經好了，但揮盾的話，短時間裡還有點問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "近衛局的夥計們，他們都沒事吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "只有我們兩個掉下了樓。不幸中的萬幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你真下定決心，這回不帶上我？近衛局裡潛伏著的可是整合運動的指揮官，這一定是場惡仗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我無所謂。但對你的狀態來說，這樣更好。你也是這麼覺得的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "這話有些傷人，但沒事，我心裡清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "記住，千萬當心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "整合運動不論從哪個層面上，都比我們估計的弱。但無論他們有多弱，他們都吃下了切爾諾伯格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "還有，你有個弱點。千萬不要，不要，不要沉浸在某個想法裡。不要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "別因為某種執著就一意孤行。除了你的現在，所有的東西都不配你去戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我就當做是建議，好好收下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "快去治療，任務完成之後，我等你歸隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我會保護醫療隊的安全。你快去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "整合運動已經經過銅鐘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "下環同樣有整合運動聚集，正在整隊。這是AU7的任務簡報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "AO3小隊已照既定計畫清理了前灣的整合運動，正逼迫殘餘勢力退向近衛局方向，完畢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "已全殲太羯宮的所有整合運動。正撤向查理士大道，前往既定地點會合。AL1小隊彙報完畢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "以上為整合運動行跡與各小隊進程通報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "通報完畢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "繼續行動。目標，將所有整合運動全都趕到指定區域。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "如果還有盤踞在其他區域的小股整合運動勢力，允許直接消滅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "可以的話，引誘他們出動。注意把傷亡比例控制在最低。我們需要保存實力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通訊",
      "text": "Yes sir。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "嗯？又有通訊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "喂，喂？阿陳嗎？你還在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你叫我什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "阿陳啊。你完了！大古廣場這事你死定了，我聽得清清楚楚，你叫他們動手的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你不會就想說這個吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "我說，你拒絕羅德島的協助，是不是因為心裡過意不去啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "別揣測我的心思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "沒事，我會幫你彌補的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "彌補什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "哼哼，暫時還是個秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "但大古廣場這事，你真的完蛋了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "對了，你記不記得上環有家茶餐廳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "啊？哪家？哎不管是哪家，現在都關門了啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "——你是不是很想岔開話題？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "三明治裡肉排很酥的那家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "哦？哦......哦！我想起來了！那家的茶餐廳，肉排包是不是有兩個手掌大！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "以前巡邏的時候，我也經常往這家店跑呢......躺下！誰讓你站起來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "叫什麼來著，“靚飲茶餐廳？”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "哼哼，我知道了，你是準備喊我飲茶，是不是？不過我們為什麼不去點高檔店？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你的高檔和我的高檔區別很大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "哎，我可以請你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "詩小姐，我像那種人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "你再這麼叫我試試？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "別介意，口誤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "你明擺著故意的啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "詩懷雅，其實我是覺得，如果這次我們不做好點，會對不起街坊鄰居。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們的事業仰仗著龍門，龍門也仰仗著我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "有感而發也該適可而止吧，你早點把整合運動幹掉，我們就能早點去飲茶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "你那裡的戰鬥好像很激烈？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "啊，沒事，我掌握得住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "快！他們要逃走了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "煩人！喂，你們幾個動作也快點！沒時間了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "阿陳！我要番茄排蛋堡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "沒問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "上次一不小心把你關在金庫那事，我向你賠罪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "那也能是一不小心？！算了，你肯定是存心的！算了，早上那杯水我潑得很解氣，兩清了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "喂，阿陳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "命最重要。不要為了眼前事把命搭上，你還有很多人可以依靠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "哼，是嗎。謝謝你的忠告。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "你在這家茶餐廳門口了，也就說明你快到近衛局大樓了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩懷雅",
      "text": "祝你好運。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "07:40 P.M.  天氣/陰\n龍門上城區，上廠街，近衛局大樓東側670m處"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "陳sir，第四機動小隊向你報到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "辛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "諸位，我們現在已經集結了一支精銳的隊伍。許多同事還在我們看不見的地方奮戰著，但我們有自己的任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們面前的大樓，曾是龍門安全的象徵，法律的實體，龍門近衛局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "但現在，它被整合運動奪取了，淪陷在陰謀戰火中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "對於各位而言，也許這只是工作；又或許這件事觸動了你的感情；甚至，這讓你義憤填膺。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "但無論如何，我們都是近衛局，我們不是暴徒，不是罪犯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們要奪回近衛局，未必是出於尊嚴或者正義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們是龍門近衛局，我們拿回屬於我們自己的東西，這已經足夠了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "不要讓龍門為我們擔憂。記住了嗎！服從，盡職，堅定！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "是時候了，就讓我們去摧毀近衛局裡的所有整合運動！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "Yes sir！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "出發。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
