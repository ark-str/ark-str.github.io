{
  "server": "tw",
  "storyId": "main_11_level_main_11-04_end",
  "groupId": "main_11",
  "stageId": "main_11-04",
  "title": "等價交換",
  "storyCode": "11-5",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_11-04_end.txt",
  "sourceHash": "8540bc341a98d441708a358ae1749d8739817fdb2412811249df79a66e17cd3e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "阿米婭，收到信號了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "術師幹員，和我一起維持住法術護盾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "其他所有人，往街角跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薩卡茲術師們整齊劃一地舉起法杖。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鮮血凝結而成的怪物從地底成群結隊地湧出，整條街道在戰士們的腳下張開了血盆大口。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "唔——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "太多了，來不及阻擋！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "黑色線條輕易地切開怪物的血肉。緊接著，更多怪物從倒下的血肉中重新生長出來，肆無忌憚地啃咬著法術築成的防線。\n戰士們一路狂奔，可捕食者口腔裡散發出的腥臭味依舊緊緊黏在他們的後頸上。\n直到他們成功踏入另一條小巷裡。凜冽但乾淨的氣味撲面而來。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "靜止。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "翻湧不息的血紅潮水突然停止了前進。\n就像是一面無形的牆從街角處瞬間彈開一般，蠕蟲外形的法術造物紛紛被撞得粉身碎骨，只在地面上留下了一道道鮮血沖刷過的痕跡。\n空曠的街道上再無聲音。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "傷亡情況怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "還好，大家撤得足夠快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "也不知道我們能不能牽制薩卡茲的行動，讓阿勒黛小姐與推進之王小姐的行動更加安全......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "感謝各位，尤其是自救軍的朋友們。謝謝大家願意一起冒險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍戰士",
      "text": "這有什麼！阿米婭小姐，克洛維希婭指揮官說了，羅德島是自救軍最重要的盟友！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍戰士",
      "text": "再說了，要不是您身邊這位很厲害的羅德島幹員幾次三番出手相救，我們哪來這麼多條命在血魔手底下一次又一次逃跑啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "無需道謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我已在倫蒂尼姆見到太多無意義的屠戮。失去理智的薩卡茲理應由同胞之手阻止。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "不好意思，博士......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我還以為我只是陪你回家。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我們是不是很不受歡迎？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......去年我從廠裡逃出去的時候，和奶奶吵了一架。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "十來個身強力壯的工人把你們團團圍住。\n他們每一個的眼神裡都充滿了警惕。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "你看了看他們手裡的鑽頭和扳手，又看了看與他們裝扮近似，卻形單影隻的費斯特。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "感覺不像吵了一架那麼簡單。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你確定我們不是被當成敵人了？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "看來奶奶還是很生氣......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "我沒有必要對一個死人生氣。畢竟直到剛剛，我都不知道自己唯一的孫子還活著。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我想過給廠裡發消息，但是這太冒險了，薩卡茲會監控海布里區收到的每一條訊息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我不能讓薩卡茲知道你們和自救軍有聯繫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "這麼說，你加入了那個什麼荒唐團隊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......倫蒂尼姆市民自救軍。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "奶奶，我們在薩迪恩區做了很多事，薩卡茲控制了報社和電視台，他們故意把我們稱作不知名的暴力集團......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "這麼說，確實是你們炸了城牆。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "呃......是博......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "是薩卡茲對自救軍的追捕導致了倫蒂尼姆城牆的損失。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "費斯特",
              "text": "......對，主要是薩卡茲幹的。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "您的孫子在那一戰中表現得十分英勇。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "費斯特",
              "text": "謝謝你，博士。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "費斯特",
              "text": "我只是負責為你綁了幾根滑索，沒想到你對我評價這麼高。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "那你這趟回來，是想把我們的軍工廠也炸了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......怎麼可能？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "你是怎麼對你的自救軍朋友說的？我們這些廠正在為薩卡茲生產武器，而這些武器最終都會指向維多利亞人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......不，奶奶，我告訴他們的是——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我的奶奶為了保護其他人的生活，而選擇站了出來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "奶奶，我知道我在你眼裡只是一個愛耍小聰明的小鬼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "但我不是為了把廠裡的大夥捲進來而回來的，我也不是為了說服你而回來的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "當然，我確實有我的目的，能讓你幫助我自然是再好不過，但是首先——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我只是想看到，你平安無事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "過來，讓我看看。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "奶奶......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "臭小子，長高了啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "嗯，長高了一點。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "我就快得到那樣東西了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "蒸汽騎士的甲胄——這玩意兒有多少人搶著要？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "萊塔尼亞的貴族們最喜歡用類似的古董裝點門面。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "對了，也問問哥倫比亞的那幾家公司，就算是幾百年前的技術，他們說不定也感興趣。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "運出去不是問題，你以為我在眼下的倫蒂尼姆靠什麼做生意？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "那幫薩卡茲是講不通道理的瘋子，但光憑他們可統治不了倫蒂尼姆。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "我在城防軍有很可靠的朋友，他們能幫我搞定的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "唯一的問題是——聽說我盯上的那具品相可不是很好，希望別折價。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "這麼擔心折價的話，不如放棄吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "誰在那裡？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "別怕，我們只是碰巧同路而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "快把這個人給我弄走！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "等等，我請的保鏢......保鏢呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我請他們在路口休息一會，等我們聊完天，你就能去找他們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "你把他們都......你只有一個人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "一個人？抱歉，從來不止。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "注意你的身後。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "你們......這是倫蒂尼姆！我的朋友你們可惹不起——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "那位朋友在哪呢？搞不好和我挺投緣？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "咿！！別衝動！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "我可從來不會一上來就動拳頭，只要你老實點就行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "推進之王說什麼，你就聽什麼。懂了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "要不然，我的鋼爪下一次落下的時候，瞄準的就不會是這堵牆了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "知、知道了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "......沒搞錯吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "最起勁的居然是你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "你們教我的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "好了，放開他吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "嗚嗚......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "珀蒂先生。請睜開眼，也不必費勁舉著雙手了。我們不會傷害你......至少現在不會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "你們到底要什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我的條件已經說清楚了。請你放棄覬覦坎伯蘭家的蒸汽騎士甲胄。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "我答應了你就會放我走嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "不過我會確保你履行我們之間的約定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "摩根，把我們的地圖給珀蒂先生看一眼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "是。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "地圖？這些標注出來的地方都是我的臨時倉庫......你們怎麼會知道？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "以後出門的時候，你最好再多注意一下四周。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "你們找人跟蹤了我？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "你說得沒錯，薩卡茲可不會被收買，一旦他們知道你借用的那點“關係”讓你偷偷地把這麼多違禁物品運進倫蒂尼姆......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "到時候，你猜你的那位朋友會不會救你？你猜他自己會是什麼下場？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "你在考慮主動找薩卡茲報信。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "你真要這麼做的話，我們或許誰都逃不了。可你要是繼續與我們合作的話，薩卡茲什麼都不會知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "那我還能選什麼呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我理解你的不易，也珍惜與你交易的機會。該給的酬勞，我們一分都不會少。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "......等等。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "女士，你和阿勒黛·坎伯蘭是什麼關係？你是她的扈從嗎？不，坎伯蘭家早就空了，哪裡還請得起扈從？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "胡說八道，那個坎伯蘭是維娜的扈從還差不多！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆商人",
          "text": "她可是大公爵的女兒！難道說......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......你搞錯了，我誰都不是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "非要說的話，我和坎伯蘭小姐是同伴，我們身後還有千千萬萬同樣渴望和平的倫蒂尼姆人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "珀蒂先生，但願你也不例外。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "騎士",
          "text": "所有忠誠於這片土地的戰士都在我的身後。與邪惡的決戰就在眼前......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "騎士",
          "text": "你們......是居住在這裡的孩子嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "騎士",
          "text": "別躲在街角的陰影裡，或許你們還無法舉起什麼武器......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "騎士",
          "text": "但從不是只有手握武器的人才是戰士。你們必須得睜開眼睛，去看，去聽，去判斷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "騎士",
          "text": "你們已經足以告訴我什麼是對的，什麼是錯的，什麼是你們想要的生活。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "騎士",
          "text": "現在，我將前進。而你們，則見證。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "茉莉",
          "text": "太棒啦！戈爾丁女士，您看拉爾夫演得多好......這孩子可真是長大啦，四年前他還像個調皮搗蛋的小獸！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戈爾丁",
          "text": "是啊，我也很高興。茉莉，你需要手帕嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "茉莉",
          "text": "手帕？對對，我可不能讓眼淚弄髒衣裳，在孩子們面前太不體面了......真是忍不住啊，一想到拉爾夫他們很快就要離開學校，我就......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戈爾丁",
          "text": "孩子們該休息一會了，我們也多了一點喘氣的時間。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "茉莉",
          "text": "對啊，還有最後一幕......最後一幕才是最精彩的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "茉莉",
          "text": "誰在鼓掌？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "茉莉",
          "text": "今天只是試演，您沒邀請什麼街坊朋友過來看吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戈爾丁",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "老師們的視線投向教室的最後一排。\n一個穿著軍裝的男人坐在距離門口最近的角落裡，緩慢而堅定地鼓著掌。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "真是精彩的演出。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戈爾丁",
          "text": "......萊托中校。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "戈爾丁",
          "text": "沒想到城防軍指揮官大人會有空蒞臨我們這間小小的教室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊托中校",
          "text": "午安，女士們。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
