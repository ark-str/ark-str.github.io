{
  "server": "tw",
  "storyId": "act17side_level_act17side_st09",
  "groupId": "act17side",
  "stageId": "act17side_08",
  "title": "主艦橋",
  "storyCode": "SN-ST-9",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act17side/level_act17side_st09.txt",
  "sourceHash": "18359fed09f8eec0a5dc4780cd0687c4c13617a325d3a4f395e844378250512e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "走快點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "......這些，溟痕。它們究竟是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "儘管微小，形式不同，但這些螢光的生命也是我們同胞的延展。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "先知曾說，在海洋的某個部分，發光的生命已經充斥了整個海域。它們即是整體，它們為所有同胞塑造生命的搖籃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "“溟痕”......只不過是遙遠的數千數萬海裡外的“祂”隨波而來的些許意志。哪怕只有一丁點，也確確實實在蠶食陸地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "溟痕會將陸地化為另一種海洋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "......是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "伊比利亞是你們計畫的第一個犧牲品，格蘭法洛也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "......犧牲品？你是不是，用錯了詞？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "審判庭會奪走這座小鎮，看看這些“美麗”的溟痕，它們一樣會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "這裡不再是我們的家。不再與那段如火的歲月有瓜葛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "蒂亞戈，你不該——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "喬迪也被帶走了......那些逃走的人此刻應該都被懲戒軍抓起來了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "你們都是兇手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "——（激動的尖嘯）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "Mon3tr——？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "它怎麼會在這裡？！不可能！它明明在城鎮的西邊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "你騙了我們，蒂亞戈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負責拷問的教徒",
      "text": "還有你也是？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的鎮民",
      "text": "......在成為審判庭的臥底之前，我只是一名格蘭法洛工人的女兒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的鎮民",
      "text": "別小看我們的恨意。忍辱負重，只是為了讓你們一同滅亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "審判庭也好，你們也好，都只是踐踏了我們家園的敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "來看看毀滅的模樣吧，看看我們當年所看見的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "蒂亞戈——！躲開！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亞戈",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（尖嘯）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喬迪",
      "text": "......已經沒有還能操作的地方了。剩下的，能源都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬迪",
      "text": "最後，就看這座燈塔，還能堅持多久了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬迪",
      "text": "（溟痕，已經，爬到這一層了？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬迪",
      "text": "我得再往上走......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬迪",
      "text": "大審判官閣下......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官達里奧",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "手臂發麻。\n礁石的形狀與排布已經發生了極大的變化。審判官不留餘力，盡可能殲滅進入視野的敵人。\n但敵人如字面意義上無窮無盡。\n劍已銹蝕，卷匣中的炸藥也已消耗殆盡。\n只有提燈中的火焰，比先前還要旺盛。\n達里奧沒有一次看向身後，看向他始終捍衛的高塔。\n他看著海平面的彼方。"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官達里奧",
      "text": "......海洋的生物，伊比利亞不會被你們毀滅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官達里奧",
      "text": "人類不會被你們毀滅。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "他咳出了卡在喉嚨裡的鮮血。血腥味充滿鼻腔。"
    },
    {
      "type": "dialogue",
      "speakerName": "恐魚",
      "text": "（緩慢的窸窣聲）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官達里奧",
      "text": "我，也不會，被毀滅。只是死亡而已。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "......耐心等待。加西亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "（乖巧地蹲在船長身邊）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "等著獵物上鉤的時間，總是無聊的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "還記得我們第二次捕獵怪物的時候嗎？那時候我們還有上百名倖存者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "離開海岸的時候，歡呼和禮炮的聲響，現在彷彿還迴蕩在我們耳邊。我們告別偉大的海岸，滿載阿戈爾的傳說，奔向海的深處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "只過了幾天，我們只在海洋上待了幾天而已——災難就來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "啊啊......為什麼這愚蠢的細胞還要剝奪你的語言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "我多想再和你說說話，而不是和那些，腐臭的，愚蠢的，花了六十多年才抵達這裡的白癡們交談。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "（傷心地蹭著阿方索的手）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "您好，船長先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "我正缺合適的餌把它釣上來，你下去如何？反正你是阿戈爾人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "......怎麼？忘了我說的話嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "要嘛你跳下去，要嘛我把你丟下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你能活下來是個奇跡。我從沒想過真的有伊比利亞人能活到今天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "這與你無關，我也與伊比利亞無關。六十年時間，我已經屬於這艘船。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "可是我們——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "——讓我來吧，斯卡蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "狩獵愉快嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "也許我溫和的態度讓你們誤會了許多事情。但我能感覺到你們身上流著怪物的血，我們是一樣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我們......一樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "與您，和您的大副？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "......誰允許你談論加西亞的？誰允許你，用這種眼神，看待我的加西亞？阿戈爾雜種？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "我從未和你們提起過加西亞曾經是個什麼樣的人。你們不知道他是男是女，是高是矮，是胖是瘦，是佩洛還是魔族佬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "但你們只要知道，它是我的大副也是我的愛人，而我永遠不會和外人透露半點它過去的形象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "它不需要你們的憐憫，更不需要你們用想像的過去來與它的如今比較，我們都不需要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "可笑。與獵物混血的獵人，你們的骯髒連海浪都洗刷不掉，還膽敢對我們表露敵意？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "斯卡蒂皺了皺眉頭。她極少在意別人的言辭，特別是陸上人的。但眼前這個特例的話語還是讓她感到不舒服。\n大副敏銳地將目光投向斯卡蒂。它在警告。"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "但是我們需要您的幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "......你們怎麼稱呼這些怪物？海什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "唔，“海嗣”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "我為什麼要幫助海嗣？那場災難之後，有多少好小夥子喪命於海洋？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "您就漂泊在海洋之上，不肯回到陸地，也堅持與海洋為敵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "這就是我的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我們是......深海獵人。我們來自阿戈爾，雖然不瞭解您存活下來的詳細情況，只憑猜測，我們也對您感到敬重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "也希望您理解，我們所做的一切，都是為了對抗它們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "阿戈爾怎麼做，和我有什麼關係？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "哦，不，您誤會了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "斯卡蒂微微瞥了一眼身邊的幽靈鯊。她本以為幽靈鯊的那句“讓她來”，是指她更擅交涉。\n但“交涉”應該是沒必要拿出那柄武器的。"
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我是說，殺死它們是我們的工作，而我本人則享受這個過程。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "既然您只是為了果腹而狩獵，殺死目標後，我給您留些血肉就是。反正這種令人作嘔的玩意，我一向是不愛處理的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "你們......很有本事？比起維多利亞人，比起萊塔尼亞人？我見過你們獵殺海嗣的樣子，你們沒什麼值得一提的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "哦，您誤會了。那些被稱為“恐魚”的低等生物，一般是不值得被二隊當做戰功記住的，歌蕾蒂婭也沒那麼小家子氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我比您強，這是不爭的事實。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "嘎......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "唔，別這麼著急，大副先生或是大副小姐，還沒輪到你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "......你敢動它，你就死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我會嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "既然隊長的任務是奪回這艘船，回到阿戈爾，那我們也沒悠哉到可以慢慢說服您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "這本來就是更簡單的交流方式——獵人的方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "——哈，你在找死！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "同類，我來找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "捕食，重要事項。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "你們，並非同胞。我已認識，但你們仍可回歸族群。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "我想問，你們作何打算？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索&幽靈鯊",
      "text": "滾開！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "哈，證明你不是海嗣的方法很簡單。殺了它。除非你不願意對你的“同胞”下手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "我由衷希望您不要拖我的後腿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "我更擔心你會對你扭曲的“同胞”手下留情，阿戈爾人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "那您確實多慮了。畢竟，如果我真的淪落到它們一邊，您也許根本打不贏我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "證明我不是海嗣之後，您願意把船借給我們嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "沒門。這艘船是我的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "真遺憾。也許我可以在這場戰鬥中讓你失去那隻手，你人類的部分就會更清醒些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船長阿方索",
      "text": "大副！別出手，讓我看看這個自稱人的怪物，和我們有多大差別。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽靈鯊",
      "text": "斯卡蒂，可別和我搶獵物喔，這場狩獵屬於我，讓我稍微......稍微發洩一下吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "捕食，必須去做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "使命，塑造環境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "你們，富含養分。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
