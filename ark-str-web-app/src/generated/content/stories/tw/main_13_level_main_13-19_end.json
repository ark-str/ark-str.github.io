{
  "server": "tw",
  "storyId": "main_13_level_main_13-19_end",
  "groupId": "main_13",
  "stageId": "main_13-19",
  "title": "殷紅君主",
  "storyCode": "13-21",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_13-19_end.txt",
  "sourceHash": "b871904f321f7d599d37c1a4e9e086a66ff635725f49153378ebfa2e0314bcc4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "瞧瞧，瞧瞧你們自己狼狽的樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "左支右絀，顧此失彼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "哪怕無人回應你們的號哭，也別浪費了這片舞台，別浪費了最後告別的機會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "“我陳述，則為我規定。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "“風雨止歇，無權流動。”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你喝止了奔騰本身？很精彩，血為你駐足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "但——我才是它們的主人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "喪鐘會潰朽，規程將疲敝，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "若你如此不屑於自己身負的高貴血脈，我會將它們抽取而出，送還給你的母親，女妖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "她會為你奏起哀悼的哨音。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "阿米婭！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這就是你的血嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "靠你的法術而熾熱，靠你的天賦而熾熱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但我所見過的熱血——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——都是為了反抗，都是為了活命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那些人的血，比你熾熱得多。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "……阿米婭，退回來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "他避開了要害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "多麼冷酷啊，魔王。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "真是一位寡恩之主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "血魔大君，鮮血王庭的主人，你的子裔填滿了薩卡茲所在的每一片戰場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你總向他們宣稱，殺戮和征伐就是血魔古老的傳統。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你將自己的王庭塑造成了如今的樣子。你讓所有人眼中的血魔，都如你自己一般只餘下扭曲的欲望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但我認識的血魔，不止你一人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "他們不曾與你一樣瘋狂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他們只是將自己的渴求隱藏得很好，他們只是被這個失去家園的時代規訓得太深。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "總有人選擇匍匐於侵略者的腳下，我為他們遺憾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不，不是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "血魔大君，你如何詮釋自己王庭所代表的鮮血？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "薩卡茲的苦難何須多言，每一個薩卡茲，哪怕臣服於你們的那些，都不免飽嚐血的滋味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "被人掀翻在暗巷，被人堵截在密林，有時是咽喉被割斷，有時則是肋骨間被刺入冰冷的匕首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "而他的兄弟姐妹也將因此得以轉醒，得以明白屈服的代價，於是他們反抗，直到自己也身披敵人的血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "多可悲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "殺死別人，或自己被人殺死，這就是薩卡茲所背負的，血的循環。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "“血的循環”，這就是你所定義的，鮮血的意義？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們第一次被血沾濕身體，難道不是……從母體中誕生嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "血是人們維生的根本，血是臍帶連接的傳承，血是探索外界時難免的磕絆，和必將癒合的傷口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "而你卻只將它們視作折磨與死亡的代稱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你的偏執使得你嗜血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你以你的驕橫與傲慢使他們相信，這才是薩卡茲原本就該行的道，該做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……我否決你，血魔大君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我否決你的行動，你的言語，你的王庭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "哈哈哈哈哈哈！我聽到了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你，一個異族，否決我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "區區一頂王冠，讓你膨脹到了什麼地步——“魔王”？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我不在乎我是什麼，我被稱為什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我只知道，我需要做些什麼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你就是這麼玩弄“魔王”能力的嗎，卡特斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你打算說些什麼大道理，又要用怎樣膚淺的情感來嘗試動搖我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你大可嘗試。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……我否定你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我否定你，將“魔王”，將薩卡茲，將卡茲戴爾歸結為力量與傳統。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我否定你，把未來寄託給過去，把生命寄託於殺戮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "特蕾西婭小姐，魔王，議長，巴別塔的領袖，曾給所有人看過一條道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "也許，那條道路過於理想；也許，她的承諾承載不住薩卡茲延綿千年萬年的仇恨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但絕不是現在，你的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你想笑我懦弱？指責我不配與你談論薩卡茲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "還是想嘲笑Logos先生此刻依然不打算借用你“喚醒”的血脈？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "……哦，“魔王”。偷聽我腦海裡的思維，就是你的能耐了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "那你自然知曉我要說些什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但我們從未說過，薩卡茲應當放棄反抗。我們從未說過，苦難理所應當。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "正相反——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "自煎熬和苦難之中，自仇恨和深淵之中覺醒的反抗者們——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "會比你強大得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "薩卡茲們所失落的家園，不在你一遍遍回望的、那些萬年前的歷史中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "它不該是一句口號，一個空想，一個象徵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "它就在這裡，就在薩卡茲們來的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那座名為卡茲戴爾的城市裡，明明就生活著如此之多真實存在的人，而你們卻只將他們葬送在了一個虛無的理念裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你用過去臆想現在，那真正的未來就永遠不可能降生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "停下吧，血魔。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "連特蕾西婭都失敗了，而你？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "所以，特蕾西婭小姐才需要我。博士和凱爾希醫生才需要我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "所以，我才在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "如死魂靈所說的，如你所說的，如諸多薩卡茲所認為的那般——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "異族的——弱小的——“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "讓開吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你已經沒辦法戰鬥了，血魔大君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "戰鬥該結束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "“魔王”，你不為我賜下那虛無的願景嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你不想窺知我的所思所想，我的所哀所苦嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你可以告誡我，你可以否定我，萬千薩卡茲都相信，這就是魔王的權力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你指控我敗壞我的王庭，那你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "“魔王”，薩卡茲以你所指之處為路，以你所行之道為途，我的同胞們追隨著你，期待你善加利用他們的血與肉，他們的生命與靈魂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "這種盲目的信仰，可笑至極。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我對魔王的撫慰嗤之以鼻，但我……曾見過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我的兄長，亦曾是魔王。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "“魔王”，呵，多麼尊崇的名號，多麼超絕的地位——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他被視為薩卡茲的領袖，我們的道標。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他是天生的拯救者，他是能將我們拉出苦厄的那雙手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "可事實又是如何呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "黑色王冠所挑選的，又是怎樣的一群人呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "在最開始，魔王確實是偉岸的，炎魔踏上譴罰之路，歌利亞咆哮無畏之災——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "可他們卻總被怯懦者背叛，被自私者出賣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "這是我們的詛咒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "“魔王……殺死了魔王。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這頂王冠的更迭，往往伴隨著死亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "卑劣者總是勝出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "於是，王冠被愚蠢和短視污染了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "魔王之中，開始出現軟弱之人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他們狹隘，他們醉心於玩弄手中的權術——他們變得和神民與先民那些虛偽的領主毫無二致。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "竊取而來的權力使他們再也無法認清自己，我的同胞們信仰的對象，也從無畏的戰士，變成了躲藏在王宮裡的蠹蟲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他們甚至忘記了——薩卡茲這個名字背負的恥辱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "而王冠卻還是在做出可笑的選擇，直到我的兄長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我原以為，他會是我們久盼而來的那位英雄！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "而他，居然膽敢向我聲稱，薩卡茲們已經無力繼續承擔戰爭，修復卡茲戴爾需要幾代人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "連我們腳下這具骸骨都知道，我們該修復的卡茲戴爾絕不該是一座城市。而“魔王”，才應是站在所有人面前的那個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他這樣的人，身體裡怎麼配容納那一滴提卡茲的血！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你看到了嗎，魔王！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我看到……一場灑滿了鮮血的內亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "王宮的地毯都被浸透染紅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我看見，一個……血魔，倒在另一個血魔懷中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "“覆血王子”的傳說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "他卒於一場內亂，而你是他的骨肉手足，你參與了那場叛亂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "……不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "不！當然不！“參與者”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "僅我一人，即讓王冠碎裂！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我仍記得那個場面，我的手貫穿了他的胸膛。提卡茲澄澈的血在我的指尖飛舞，最終沒入了我的血管。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他扭頭看向我，扯住我的衣服……“魔王”在死前卻對行兇者展現了本該賜予功臣的虛幻願景。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "在那幅願景裡，我曾看見……我也曾目睹，“安寧”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "正如你所說，卡特斯，鮮血不只等同於死亡。我站在山谷之間，看著一個平靜的村莊，醫生一邊談笑，一邊為傷者縫合傷口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "受傷的人告訴醫生，最近的獵物格外兇猛，但他最終還是贏下了那場搏鬥。院子裡，掛著新鮮收獲的獸肉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "……而那醫生就是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "可這讓我更加怒不可遏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "多麼悲哀，多麼虛無，多麼可恥！我的兄長，居然以為，這種虛假的“安寧”就能矇蔽我？他大錯特錯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他以為我被仇恨沖昏了腦袋？不，我知曉什麼是平靜，正因為這樣，我才更加躁動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我們渴望看到，真正強大的提卡茲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我將兄長的血納入己軀，我眼看著黑色的王冠在我眼前消逝——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "可你並未榮登“魔王”之位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "……我並不可惜。倘若它能選中強大的領袖，我反而由衷慶幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "可這頂王冠卻一次又一次讓我失望。更加失望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我兄長的繼任者是一個，流浪漢。再之後，是個樵夫。要不是赦罪師帶回的卷宗，這些人，根本不配被銘記。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "之後再一位入主卡茲戴爾的魔王，被那隻名為凱爾希的怪物殺死，倒在聯軍之前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "隨後，是特蕾西婭和特雷西斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "他們令人高看一眼，卻又讓人心生焦躁，只耽於空想的特蕾西婭白白浪費了她的強大，像極了我那……軟弱的兄長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "而她的繼任者……居然已淪落到是一隻異族的卡特斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "既然如此，既然王冠的選擇總是如此荒誕，它的存在卻又總是給我的同胞們帶去可恥的希望——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "那麼，我就在文明之外葬送它。我就讓它真的徹底遺落於歷史之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "你還在掙扎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "阿米婭，別給他機會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你也衰弱了。也是。王冠再怎麼蒙受玷污，其重量也不是你這樣一個嬰孩般的卡特斯所能承受的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "看來那些等著擺弄王冠的赦罪師們又要對我絮叨些廢話了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "……重新看看這裡吧，卡特斯。你若是死了，便不會再有任何“繼任者”了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "還是說，你能把你的王冠給月亮戴上嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "怎麼……？他怎麼可能還能戰鬥？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "魔王的術法已經深入他的身軀之內，他的軀體本應已無法再生才對！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "他在用血填補缺失的肉身，用血縫合傷痕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "他已是懸絲傀儡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你在越發熟練地運用魔王的力量，卡特斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "但是，你的一切勸誡、警告、審判、宣言，都是笑話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "無知的小兔子，你頭頂的王冠，並不代表任何職責或權能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "“魔王”，呵。我嘲弄魔王的愚蠢，不僅僅是在嘲弄你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "還有，這頂王冠本身。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "當薩卡茲們失去了可供仰賴的魔王，他們也許終會從這個苦等救贖的，卑怯的夢中醒來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我承認你說的，自深淵中覺醒的人將更加強大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "正因如此，你們無法勝過我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "薩卡茲已經墮落的意志，怎麼能抵擋曾承載提卡茲鮮血的我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "骯髒無法污衊純潔，惡濁無法染指澄澈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "提卡茲既是你們的來路，你們就只能在這條延長線上前進！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我們才是反抗者！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "“我劃定，即為我糾正。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "“血與火將熄滅，正視滅亡。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "Logos先生，小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "咳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "他的血，對我，產生了影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "比那些法陣強大數倍——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "是的，多虧了你們，我也在這裡流淌下了我的血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "也正因為如此——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "這裡也被納入了卡茲戴爾之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "誰能想到，當所有人都認為這片大地的全貌已經展露殆盡……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "家園的邊界卻仍在拓展。哪怕此時此地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "薩卡茲，我自稱薩卡茲的同胞啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "跟上血液的行軍，跟上永不會背叛你們的，血脈中的饋贈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我會將你們帶去，這一切的起點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "那裡會是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "抱歉，薩卡茲的饋贈，與我無關。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "小兔子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你*薩卡茲粗口*又不是薩卡茲，動起來！削弱他的束縛！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我在做！他的法術比想像中——更瘋狂！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我幾乎聽不見他的心聲了，那裡……那裡只有一片腥紅……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我就要……抓住了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "又一個異族……這倒是出乎意料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你鮮血的氣息，你是卡普里尼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "無趣的偽裝……就讓你的血絞死你自己吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "……呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你們覺得憑這種粗淺的法術，就能夠殺死一位薩卡茲的王庭之主？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "當然不能。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "別把屠殺的陳詞濫調稱作“覺醒”，血魔大君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "還在仇恨和毀滅之中兜兜轉轉的你，從來沒有離開過所謂的“深淵”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "還沒睡醒的，是你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "——卑劣的叛徒——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "魔王！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "就是現在！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "趁他沒有恢復以前，把他從骸骨上擊落！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "在我剛即位王庭時，喪鐘已與我的命運相連。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "我們都不能逃過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "但輓歌哀悼的不會是你的身軀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "而是與你我相連的一切。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我——不會——女妖——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "阿米婭，與我合奏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "去窺探輓歌的弦音。去尋覓女妖的起點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "看向我。看向你曾捂耳避諱的哀嚎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "我們必須將他終結在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我會嘗試！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "女妖！聽聽吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你還是——承應了你的血脈，我的賜福——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你還是，沒有打敗你自己！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "多可笑……就連眾魂都在嘲弄我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "女妖之主，還有……“魔王”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "……你們把這些無視過去的駁雜者留在身邊，在最後，你們甚至不敢自己動手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "啊……卑劣者，總是勝出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "這確實是我們的詛咒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "異族的魔王處決了我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "魔王與喪鐘共鳴。但你們卻不知，血色的連繫有多麼堅韌，就妄圖宣判……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你們——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "呵，你們最後，終於還是用出了血脈之中的力量！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "兩位輓歌歌者同時為我獻上悼亡曲——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你們終歸，還是敵不過構成你們一切的，來自血脈中的本能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "你們真的殺死了我嗎？不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "我已經把提卡茲的血還給故鄉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "去看吧，去倫蒂尼姆看看——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "text": "（輕如耳語的薩卡茲語）我在毀滅的帷幕後等著你們。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
