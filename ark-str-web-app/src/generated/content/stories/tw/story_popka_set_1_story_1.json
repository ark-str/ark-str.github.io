    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "梓蘭已經在休息室門口了，別讓她等太久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓蘭姐姐已經來了嗎，我馬上就過去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不過泡泡大姐頭怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "我會把她帶回宿舍的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那我先走啦，再見！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "再見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "滴滴，滴滴。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "泡普卡沒有問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "我現在就把泡泡帶過來。",
