    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "走吧莫提，我們把泡泡拖去醫療部。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "希望她這次能學到點教訓。",
