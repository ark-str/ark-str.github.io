{
  "server": "tw",
  "storyId": "story_popka_set_1_story_1",
  "groupId": "story_popka_set_1",
  "stageId": null,
  "title": "玩樂之間",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_popka_1_1.txt",
  "sourceHash": "17d77bb4dc0d1a698fef02d1798f4c610ed045d7ced19d31f43b90c28bec84db",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "羅德島本艦，公共休息區廊道"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "結束了耶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "沒了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那我們什麼時候可以看下一集？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡問問看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "巫戀姐姐，我們什麼時候可以看到《菲林寶寶》第二十集呀。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "Zzzz......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "她好像看到一半的時候就睡著了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "最近都是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "《菲林寶寶》不好看嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "斑點哥哥說，《菲林寶寶》只有小孩子才會看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "巫戀姐姐可能已經真的長成大姐姐了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我不信！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我們也就差了幾歲！憑什麼前兩集大家能一起看到結束，現在就只有我們兩個了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "我們也會很快長大的，說不定《菲林寶寶》全集結束的時候，我們就是大人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡長大以後想做什麼呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我嗎？我當然是回到部落裡把所有不服氣的人全打一頓然後當上部落勇士啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡想變成超級英雄，一拳一個壞人，兩眼放雷射，在天上想怎麼飛就怎麼飛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "超級英雄真的存在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我從來就沒看到有人能眼睛裡放出雷射，也沒有人能在天上飛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "能打壞人的倒是挺多的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我也能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡只是希望能變成那樣嘛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡的眼睛一直在生病，所以泡普卡在想，眼睛如果哪一天能像超級英雄一樣放雷射就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那就趕緊把眼睛養好吧，我還挺想看看你的眼睛的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "等病養好了第一個就給泡泡看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "真的？！好耶！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嘻嘻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "現在幾點了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "四點半了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓蘭姐姐說泡普卡今天可以在休息室玩兩個小時，只剩半小時了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "為什麼只玩兩個小時？每個小時都拿來玩不好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "每天都要訓練的，還要上課，之後還有作業了，作業不寫完老師要生氣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "為什麼要寫作業？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好好學習天天向上呀，大人們都這麼說的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我每天都在船上跑，從來沒聽說過要寫什麼作業。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "而且——作業是什麼？能吃嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不可以啦。作業是——嗯......泡普卡也不知道作業到底是什麼，只知道寫了會變聰明。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡你看看？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "這就是作業？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不就是一本書嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "裡面塗塗改改都是你做的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "大部分都是泡普卡塗的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不過紅色筆記是老師們的批改。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "看不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "喏，還給你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "要是讓我學這些東西，我立刻從羅德島跳下去跑回薩爾貢找爸爸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "有人攔著我，我就把他撞飛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "聽說，前幾天有個米諾斯的姐姐——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "沒有這回事，你聽錯了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那個豐蹄力氣才沒有那麼大呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡泡隨隨便便就把她推倒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我說的都是真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "如果泡泡以泡泡爸爸的名義發誓，泡普卡就相信這是真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "發誓就發誓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡泡以爸爸的名字鄭重發誓，那天泡泡根本打不過米諾斯的豐蹄大姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "原來是真的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你不要和其他人說啊，我真的沒那麼弱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "只是那個豐蹄姐姐太強了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡每次發誓就會說實話，泡普卡已經完全理解了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "沒，沒辦法啊，爸爸說了，用人的名字發誓那個人會聽到誓言內容的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "爸爸要是聽到我說謊，絕對會把我屁股打爛的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那泡普卡用爸爸的名字發誓，泡普卡的爸爸也能聽到嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不知道哎，你試試看？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡的爸爸，叫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡不記得爸爸叫什麼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "媽媽呢，媽媽也有用的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不記得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "雖然凱爾希阿姨說泡普卡是用泥巴捏出來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "但泡普卡就是覺得自己有爸爸媽媽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "而且大家都有，沒道理只有泡普卡沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你說的對哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "會不會那個白大褂醫生在騙你啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "凱爾希阿姨應該不會騙人吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那個菲林醫生總是板著臉，看起來就壞壞的，不像我老家薩滿伯伯，見誰都笑呵呵，一看就是好人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "冷靜不是壞壞哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "你看巫戀姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "巫戀姐姐也一直板著臉的，但巫戀姐姐很會照顧人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "上次泡泡吃仙人掌扎了一嘴刺，是巫戀姐姐把你弄暈以後一根根把刺拔出來然後交給醫生的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "而且巫戀姐姐很會選蘋果，又大又甜又脆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "這倒是，她帶的蘋果一直很好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好吧，你暫時說服我了，巫戀不是壞壞，醫生也不是壞壞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "但大家都不壞，醫生也沒騙你的話，為什麼你會記不得爸爸媽媽呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "可能是因為泡普卡記性不太好，記不了太多事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不過泡普卡有些事還是忘不掉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "礦場裡哐哧哐哧的聲音，比羅德島大好多的鋼鐵城市，還有許多人圍著的塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "有穿著白大褂的醫生、有很多亮閃閃的大鐵塊、有一間安靜的小房間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "還有一間白白的大房間，中間有張床。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你這不是記得很多嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "可爸爸媽媽的名字，想不起來......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "或許哪天一拍腦袋就想起來了呢，我經常這樣想起事情的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你要我幫忙的話，我可以幫你拍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我力氣可大了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "咣咣咣咣！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡力氣太大，會把我拍傻的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "會嗎？那還是算了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "滴滴，滴滴。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好無聊啊，巫戀都說夢話了——泡普卡，你的滋嗚嗚能借我玩一會嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "可以啊，但滋嗚嗚今天轉不起來哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "因為裡面轉圈的東西在維修。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡之前幫哥哥姐姐們鋸東西的時候壞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那我想想其他好玩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡普卡你就該和我一樣多玩玩，不要去什麼訓練啊上課的了，沒有意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "但只有訓練的好，去打壞人的時候才不容易被弄痛哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "而且泡普卡需要幫梓蘭姐姐她們分擔工作的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你太聽話了啦，像我一樣多好，只要拿著盾衝衝衝就可以了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡你這樣很容易受傷的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "一開始泡普卡也不懂，只會拿著滋嗚嗚到處亂甩，有時候還會傷到哥哥姐姐們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "但經過訓練的泡普卡已經完全懂得聽梓蘭姐姐的話了，梓蘭姐姐負責考慮事情，泡普卡負責聽話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "這樣泡普卡也不會被弄痛，哥哥姐姐也不會被弄痛，多好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你的哥哥姐姐，很強嗎？有我爸爸那麼強嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "沒有哦。但哥哥姐姐們一直都很照顧泡普卡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓蘭姐姐會給泡普卡梳頭髮，月見夜哥哥會幫泡普卡挑衣服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "空爆姐姐會帶好吃的，斑點哥哥會挑好看的漫畫書。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唉——聽上去好像很不錯耶，以後我也要讓博士找那麼多人照顧我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那你為什麼要拿滋嗚嗚追著他們跑呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "滋嗚嗚？追著哥哥姐姐跑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡不會做這種事的哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "巫戀也一直說自己是大人了，不可以被人摸頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "但有人摸了她還是很開心嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "巫戀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......對哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我想到了！巫戀的尾巴那麼好玩，我們為什麼不玩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "又柔又滑，我爸爸座位上的獸皮都沒那麼滑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那樣巫戀姐姐會生氣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "她還沒醒，不會知道的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "萬一醒了怎麼辦呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那我再想想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "摔跤怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓蘭姐姐說不可以在休息室裡摔跤，會打擾其他人休息的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你怎麼那麼聽話，無聊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "我會看好......她的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你看巫戀，都無聊到不停說夢話了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "到底能不能一起玩點什麼嘛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我想到了!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "扳手腕，玩扳手腕總可以吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "又安靜，又可以比力氣，最重要的是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "以前我們沒扳過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好像可以哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "就這張桌子上，來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我準備好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "我也好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "3！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "2！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡&泡泡",
      "text": "1！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哼！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我泡泡，扳手腕，就沒輸過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "哼！！！嘿呀！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "以爸爸的名義！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "扳手腕絕對不會輸的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哈啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嘿呀！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "桌，桌子塌了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "（小聲）怎，怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（小聲）我不知道啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "Zzzz......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "還好還好，沒吵醒睡覺的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "吵醒巫戀的話她絕對會對我下奇怪咒語的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那桌，桌子呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "桌子讓打掃的叔叔來收拾吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "要是叔叔問了，我們，說，說什麼呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "當然說它是自己斷的呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "說謊是不好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不說謊會被打屁屁的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那樣更不好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "說好了，一會大人們來了，就告訴他們，桌子是自己壞了，好嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唔，你眼罩好像有點歪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "裡面有點黑黑的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "（慌慌張張地把眼罩戴好）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那個黑黑的，是壞石頭嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "應該是吧，泡普卡也沒有摸過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓蘭姐姐和凱爾希阿姨都和泡普卡說過，絕對不可以把眼罩摘下來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "為什麼呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡不太記得了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那就讓我看看吧，就看一眼，好不好？看一眼就戴上，絕對不會出問題的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我給你吃糖果，上個禮拜剛剛從紫色沃爾珀胖姐姐那裡拿了盒好吃的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "而且還是你最喜歡吃的夾心小餅乾哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "只能看一下哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嘿嘿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "太，太亮了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "等一下啊，我把燈關掉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "（睜眼）......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "可以了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "（摘下眼罩）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哇哦，好好看唉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "又好看又酷！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "大概是什麼樣的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不知道，反正就是特別酷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嗯？裡面好像有點亮亮的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "哦——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哇，越來越亮了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你的眼睛真的好厲害啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好像有點熱哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "發生什麼了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "text": "眼罩戴好。",
