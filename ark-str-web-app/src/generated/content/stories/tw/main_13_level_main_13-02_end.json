          "value": "2",
          "blocks": []
        },
        {
          "label": "都不要慌張！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "崩潰的市民",
          "text": "讓讓，讓讓！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "啼哭的市民",
          "text": "他們，那些怪物就快要過來了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "崩潰的市民",
          "text": "戴兜帽的傢伙，別擋住路！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "啼哭的市民",
          "text": "別過來！你身上有血！和那些怪物一樣沾上了血！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "博士，我在這裡，抓住我！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士，抓住我的手。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……你？",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你……不是阿米婭！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "變形者……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭？",
          "text": "……為什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭？",
          "text": "“魔王”，應該是什麼樣子？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你不再是過去那個你了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我聽到了Logos的骨哨聲。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "眾魂依然拒斥了我們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "但……變化已經發生，我們的另一部分……已經離我們而去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "我們需要做出選擇……我們不可停滯不前。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "……“魔王”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "我們剛才試圖扮演你，但是失敗了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……新的變形者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這就是你的選擇？你決定真正與我們為敵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "……我們只是做出嘗試。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "唔——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "“魔王”，我們的意義能否在和你的戰鬥中得出？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "我們的路到底通向哪裡？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……我曾經詢問上一位變形者我該怎麼做。他告訴我，我需跨越所有的猶豫和迷茫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "既然新生的你仍稱呼我為“魔王”，那麼——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "自己去找吧，在我這裡，你得不出答案。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "哎呀，我弄痛你了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "那個叫阿斯卡綸的女人真討厭，她對所有人都那麼糾纏不休？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭，小心——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他們的目標，是你！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "怎、怎麼——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "小小的魔王啊，我早就迫不及待想要翻撿你的情感與記憶了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "我原以為死魂靈會讓你吃點苦頭，可你的狀況似乎比我預想的要好上一些。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "卡特斯，不，奇美拉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "你終究不是特蕾西婭呀。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "放開我——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "你是個被人賦予王冠的幸運孩子，但你真的了解你的力量嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "而我們，已經探究了魔王數個千年了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "至於你——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "別打博士的……主意！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "哦？被赦罪師的巫術環繞，你居然還能調動魔王的力量？我開始有些想念麗茲了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "算了，這對我們的實驗大有裨益。我會先留這位博士一命，我也會教你利用自己的情感。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "不過在把你交給首領之前，我得保證你比現在更乖一些，小兔子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩盧斯",
          "text": "變形者閣下，那個討厭的女人就快追過來了，後續就交給您了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "……好吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "也許，她能砥礪我們。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博……士……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭！",
          "value": "1",
