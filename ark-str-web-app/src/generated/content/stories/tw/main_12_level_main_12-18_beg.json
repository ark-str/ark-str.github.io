{
  "server": "tw",
  "storyId": "main_12_level_main_12-18_beg",
  "groupId": "main_12",
  "stageId": "main_12-18",
  "title": "誠摯邀請",
  "storyCode": "12-20",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_12-18_beg.txt",
  "sourceHash": "99296b8507a3d83aab679441dfc9617a07c73678b0d7e9622fad5905c50c9a01",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "老威靈頓幾乎把他所有的預備戰艦都派過來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "是的，公爵閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "威靈頓公爵似乎對那艘船......勢在必得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "他們的前鋒部隊應該已經與薩卡茲交火了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "嘖，還有開斯特......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "那女人幾乎從來不走出她的防區，這次連她都坐不住了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "這艘會飛的小船到底有多吸引人，值得他們這麼大費周章？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "......您的參謀們同樣建議您盡可能地獲得那艘飛空艇的技術，公爵閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "無論是抗衡薩卡茲，還是將來面對......其他可能的對手，這種前所未有的武器都能為我們爭取到更多的空間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "讓他們閉嘴。什麼可能的對手？他們這是在教唆我分裂維多利亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "我來這裡只是為了接戴菲恩回家的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "參謀們說，諾伯特區的情況，可能會很糟糕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "戴菲恩不會有事，她可是我的女兒。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞士兵",
      "text": "公、公爵閣下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "我沒告訴過你們嗎？不允許在艦內奔跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞士兵",
      "text": "您看，那個移動地塊的影子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞士兵",
      "text": "好像......有些不太對......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "溫德米爾公爵接過副官遞給自己的望遠鏡。\n被朝陽拉長的地塊影子中，投影出的卻不是諾伯特區的樣貌。\n是因為建築物的遮擋嗎？溫德米爾思考著，是有些奇怪，像是一座塔。\n塔？\n還是......大廈？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "......那是......碎片大廈的影子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "怎麼可能？這是一種自然現象嗎？還是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "你剛才說，開斯特和威靈頓的部隊還有多久能抵達這附近？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "恐怕不會超過兩個小時......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "真是難得，三位公爵的軍隊，居然一起出現在這個地塊附近......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "據我們的參謀報告，其他幾位大公爵也同樣在蠢蠢欲動，他們要是真開動自己的戰艦出現在這裡也並不奇怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "我在部隊待了這麼多年，還從沒遇上過這樣的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "停船！所有部隊馬上停下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "讓他們馬上撤出這個地塊附近！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "發射紅色信號彈，警告友軍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "快！快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "發送明碼電文，通告周圍的所有維多利亞部隊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "這裡可能會成為碎片大廈的攻擊地點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "好、好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "這艘船不要轉向，向諾伯特區加速行進！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫德米爾公爵",
      "text": "我得在那風暴形成之前，找到戴菲恩！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一朵朵紅色信號彈在雲層之下炸起，扭曲的地塊陰影正在變回原狀。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "很出色，伊內絲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "只是一次並非全功率的試射，我們有很多可以選擇的地點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "不過我不得不承認，有一些小小的可惜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "但軍事委員會的計劃目標，從來就不止一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "告訴食腐者之王閣下，準備進軍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "風暴會為他開路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "伊內絲常常提起，死亡也是工具。\n她有時會向赫德雷自嘲，自己可能已經習慣死人的身份了。\n不過等到死亡真的來臨，伊內絲發現，自己比想像的要平靜得多。\n她閉上了眼睛。\n猛然，火光與熱量撲面而來，伴隨著的，還有強烈的衝擊波。\n這種炸藥的味道，伊內絲很熟悉。\n她扯起嘴角。\n爆炸的塵煙撲面而來，餘燼仍然帶著火的溫度。\n這些餘燼在聚集，在飄舞，在編織。\n薩卡茲的歷史由餘燼織就，但有的時候，這些塵埃也能編織出些別的東西。\n比如......\n伊內絲栽入一團輕柔的煙塵之中。\n餘燼形成的巨網托住了她。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "我不該覺得......他們兩個能有什麼好主意的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "喂，伊內絲，還活著嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "這種爆炸的難度很高，搞出什麼意外也不奇怪啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "赫德雷，算了，直接埋了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "......真是抱歉，姑且活著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嘖，掃興。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不過，喜歡我給你放的煙火嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "猜猜我偷偷在你的衣服裡面縫上過什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哇！誰能想到，是個定位器耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "......你以為我沒發現嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "那麼粗的針腳，說真的，你的縫補手藝真夠差的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嘁，原本是為了給你點真正的“驚喜”的，不過，好吧，這樣也行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "還有這些——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "你們知不知道在戰場上保持衣服乾淨整潔有多不容易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "你們居然就這麼把我丟進了一團燒著的灰裡面？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......你以前還會形容我的源石技藝叫餘燼呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "現在沒這個心情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你傷得不輕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "總比死了強。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "什麼！赫德雷！你居然會用源石技藝嗎？我還以為你只會用刀砍人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "餘燼？怪不得我每次把炸彈扔你臉上你都好像沒什麼事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那你是不是不怕被炮打啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "怕。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那你是不是可以用灰揚別人一臉啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你老是把自己弄得灰頭土臉，是不是這個源石技藝的副作用啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "閉嘴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "......哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我已經多少年沒看過你這麼狼狽的樣子了，伊內絲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "相信我，你以後也不會再看到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "別對自己的運氣太有自信，搞不好回去的路上就撞上血魔大君在散步呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "W，我建議你換個比諭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "怎麼，在曼弗雷德身邊待了那麼長時間，對王庭裡那些老怪物有感情了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "喂，你該謝謝我！要不是我回來的路上遇到了遍地亂竄的你，說不定你已經又被你其他的老朋友抓走了呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "......你真的很吵，我寧願回監獄裡去，至少安靜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "請回，我可以主動向特雷西斯舉報你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "現在我們去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "W的安全屋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "好吧，我可以勉強當做是回家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "還有——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "......謝謝。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "......我要回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "她今天的腿腳怎麼那麼慢？是走路的時候摔傷了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "我們得去幫她一把，等把她接出來，這種救命之恩，肯定夠薛她幾瓶好酒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "愣著幹嘛，走啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "行了，漢娜！諾伯特區如今是一片火海！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "貝爾德又不是蠢蛋，她會躲著火走的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "......她死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "你說什麼？摩根，這不是開玩笑的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "我說了！貝爾德死了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "你沒看到那把蝴蝶刀嗎，那把沾著血的蝴蝶刀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "那是貝爾德從不離身的武器，不會有錯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "如今，這把刀在另一個人手裡，這就意味著......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "說不定只是個誤會，說不定是貝爾德不小心把她的刀弄丟了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "她也會有粗心的時候，對吧？她也不是沒搞丟過東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "當年，她搞丟了我們一打羽獸蛋，記得嗎？本來我們早上是有煎蛋吃的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "她偶爾會大意一下，這沒什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "漢娜......麥克拉倫拿著那把刀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "貝爾德最後就是去找他的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "他聾了兩隻耳朵，大概是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "哈！貝爾德和麥克拉倫多少年的交情了，你們是不是又在嚇我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "貝爾德就是把她的刀借給了麥克拉倫用一下嘛，沒什麼大不了的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "我......我們可以問問他情況，他也許會告訴我們，這只是個......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "漢娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "他人在哪？麥克拉倫和我們一起離開諾伯特區了，對吧？那就一定在這些人裡面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "問一下，不就能解開誤會了嘛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "麥克拉倫——你在哪——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "麥克拉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "......漢娜，他聽不見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "我要殺了他！！！我要殺了那個混帳！！！我要把他找出來，抽出他的每塊骨頭！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "漢娜！......行了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "維娜！你*維多利亞粗口*是不是早就知道？！你為什麼不去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "我為什麼不去敲碎他的腦袋為貝爾德報仇？！你以為我不想嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "你以為我不想嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "因為這*維多利亞粗口*沒意義！幹掉一個嚇瘋了的聾子沒有一點意義！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "漢娜，我恨透了這些，我恨透了這些東西，我是個徹頭徹尾的蠢貨，自以為是的傻瓜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "阿勒黛，貝爾德......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "如果我不參與這些事，她們也許就不會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "......我到底是為了什麼回來？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "我以為我是為了什麼回來？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "這是不是......從一開始，就是個因為虛假的責任心而犯下的錯誤？\n自己內心中怎麼看待她們，看待這些曾一起出生入死，一起歷盡磨難的友人？\n是不是......這份她無比珍視的“友情”，其實不過是個連自己都騙過了的說辭？\n是不是，就連自己，都開始漸漸地把自己看作是一位國王？\n賞賜慈悲，播撒仁義......然後，收取希望與敬仰。\n自己到底......想成為什麼？\n自己到底期待成為什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "......維娜，我們回來，是因為我們沒有辦法忍受......只是在一邊旁觀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "因為這是我們的街道，我們的區塊，我們的國家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "你總是衝鋒在前，但這不是你的責任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "我們跟在你身後，也不是因為期待你成為怎樣的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "維娜，你只是我們的維娜，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "......當然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "我只會是維娜，我發誓。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們需要把這些諾伯特區的市民帶去哪裡？總不能讓他們在荒野上自生自滅吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "更何況，這裡是戰場的中心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......如果這些市民願意的話，他們可以去我母親的領地裡生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "母親她開了一座移動城市到倫蒂尼姆附近，雖然只是小型的要塞城市，但安置這些人還是沒問題的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "卡鐸爾，你有什麼想法嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡鐸爾",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡鐸爾",
      "text": "戴菲恩，你發現了嗎，自從你開始不再掩飾自己的身份，你說話的口氣都變了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我知道貝爾德的事......讓你很難過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我們都很難過，但你不需要在這個時候讓大家的心情變得更糟糕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我只是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哎呀，總算找到人了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "變形者集群",
      "text": "請問，能為我們倒杯水嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "變形者集群",
      "text": "那條德拉克......我們不喜歡她的那些火，燒在身上難滅得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯卡綸",
      "text": "......變形者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "變形者集群",
      "text": "阿斯卡綸，我們有日子沒見了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯卡綸",
      "text": "你來這裡幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "變形者集群",
      "text": "找水喝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "變形者集群",
      "text": "順便來正式和我們的這位小魔王打個招呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "變形者集群",
      "text": "那位女妖可是誇了你不少呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭，後退。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "沒事的，博士，雖然我從來沒有見過這位客人現在的樣貌......但我對他們很熟悉，他們在那些歷史中出現了很多次。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但是他們總是游離在王庭之外，對除了自身之外的一切都......缺乏興趣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "變形者的碎片，你為什麼出現在我們面前？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "看來你確實是貨真價實的魔王，小兔子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "那東西把你也折磨得不輕。你不是薩卡茲，真佩服你的小腦袋裡能裝下那麼多的東西。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "記憶，我們最寶貴的東西，但有時候也會是我們的毒藥。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "你看，我們似乎還是能有些共同話題的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "您......是不是也覺得我不配承載“魔王”這頂冠冕？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "看來，那隻嘮叨的死魂靈狠狠罵了你一頓。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "別理他，他從來不討人喜歡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "您是一位古老的薩卡茲，您覺得......魔王需要怎麼做？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "唔，是個好問題。我們沒當過，我們也並不在意......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "但我們想，最起碼應該足夠強大？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "強大到......足夠跨越所有的猶豫和迷茫，對吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "但有一點我們十分確定，你不該向我們提出這個問題，小魔王。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "你還有很長的路要走。無論是繼續領著那個叫羅德島的組織打打鬧鬧，還是遵從薩卡茲眾魂的指引。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "啊，抱歉，我們忘了，薩卡茲眾魂不會接納你，就像不會接納我們一樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "我們都是異類。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "不過——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "你總會在未來的某一刻明白，你是無法戰勝時間的。我們的記憶中，每一任的魔王總會在最後走上同一條道路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......但那不會是我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我——拒絕走上那條道路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "先不要急著否定我們，卡特斯。我們也曾以為另一位年輕的魔王會給我們驚喜，但似乎你們的命運依舊牢不可破。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "可我們依然對你充滿了期待，一位不是薩卡茲的魔王......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "一位仍然不斷成長且質疑自己血脈的年輕魔王......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "一位我們都從未見過的魔王......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "......你想幹什麼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "我們......並無惡意。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "魔王，我們不敢宣揚我們比你更加具有智慧，我們也無法教會你任何事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "我們只是想要發出一個邀請，請求一個能夠深入瞭解這樣一個......“唯一”個體的機會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "阿斯卡綸，你要是和我們活得一樣長，你就會明白的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "當你眼前出現了一個從未見過的東西，怎麼可能忍住不去碰碰看呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "尊敬的魔王，請給我們漫長的生命一次驚喜。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
