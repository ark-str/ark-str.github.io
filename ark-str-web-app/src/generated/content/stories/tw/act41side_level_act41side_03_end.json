{
  "server": "tw",
  "storyId": "act41side_level_act41side_03_end",
  "groupId": "act41side",
  "stageId": "act41side_03",
  "title": "惶惑與衝動",
  "storyCode": "EA-3",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act41side/level_act41side_03_end.txt",
  "sourceHash": "265c25bcbdb13f2c5b806d9a17fbb23c73e26564d342559af389b4c0cf0aa80f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "哎喲！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "是誰——提奧？你不看路的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "抱、抱歉！羅里先生，我想去拉格蘭街碰碰運氣，看能不能買到一點馬鈴薯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "滾開！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "抱歉……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "車夫的聲音",
      "text": "小心！馱獸受驚了！快躲開！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "趕車的，你瘋了嗎？差點撞死我！給我停下來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "竟然就這樣跑了？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "羅里先生，我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "哈，哈哈，真是惡有惡報，被撞的竟然是你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "走，小子，現在你哪裡也去不了了，跟我去見深池的人，我要把你這個叛徒交給他們，這樣我就有馬鈴薯可以——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "不對，不能走大路！萬一這個間諜被其他人搶走……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男人一把提起男孩的領子，不顧男孩痛苦的呻吟，拖著他走向平日無人經過的小巷深處。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "真是奇怪，為什麼還是走不出去？難道我記錯路了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遙遠的爭吵聲",
      "text": "別搶！把馬鈴薯還給我！你自己去糧店買，你看那裡還有剩下的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遙遠的爭吵聲",
      "text": "還給我！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "還有剩下的？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男人看向聲音傳來的方向，又看了看一條手臂握在自己手裡，幾乎已經不成人形的男孩。"
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "快死了……快死了還能從他嘴裡撬出情報嗎？深池的老爺們還願意給我一口吃的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰沉的居民",
      "text": "……叛徒，算你運氣好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男人甩開孩子那反而抓緊了自己袖口的手，快步跑向聲音傳來的方向。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "好痛……我的腿……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "不行，站不起來……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "艾瑪阿姨……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "……誰叫我？誰？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "我已經照你說的做了，我已經做了！不要再來纏著我了——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "艾瑪……阿姨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "提奧？你怎麼了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "我被馱獸車撞到了，然後又被人丟到了這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "我不是維多利亞人的間諜，艾瑪阿姨。求你救救我，帶我去找庫林先生，好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "維多利亞人……間諜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "原來這麼快啊……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "艾瑪阿姨，我好痛，真的好痛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "我知道維多利亞人害了大家，大家都不喜歡我，沒人願意聽我說話，更沒人願意碰我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "可是能不能……至少把庫林先生叫過來，我好痛，而且好冷……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "艾瑪阿姨，等我長大了，我會去找維多利亞人報仇的，我會去幫尼亞爾叔叔……報仇的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "（深呼吸）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "提奧，如果死的只有尼亞爾，也許我會幫你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "艾瑪……阿姨？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "你只知道尼亞爾死在戰爭裡，可是還有更多人，他們沒上戰場，也死掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "因為你們維多利亞人封鎖了商路，直到現在還在封鎖，所有人都在挨餓，包括我，包括……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "尼亞爾留給我的……我肚子裡的孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "他也餓死了，被你們維多利亞人活活餓死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "所以，找其他人去幫你叫庫林吧。他們不像我，他們都是好人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "擔憂的居民",
      "text": "……很好很好的好人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "艾瑪，竟然是艾瑪……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "為什麼她會變成這樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "庫林，我不是想幫她辯解，但那天經過那裡的人，肯定不只她一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "是啊，不只她一個……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "……我是不是說錯話了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "不，你沒說錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "你之前還想帶提奧離開，是嗎？你看見什麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "別人欺負他。不是小孩子之間的打打鬧鬧，是大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我在第一次看見提奧被欺負的時候就衝上去了，我以為這樣的事情……不會再發生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "實際上……發生過很多次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "之前我只是一直有種很不好的預感，我覺得提奧不屬於這座城市，納斯爾紗可能容不下他，誰知道……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我知道了，你走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "庫林？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我說我知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "你……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我說我知道了！走！現在就走！讓我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "……一個人待著，好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "……抱歉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鐵匠呆呆地站著，靜謐的四周只剩下火焰的劈啪聲。"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "提奧，我……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "他錯過的事情太多，無法理解的事也太多，已經無力去釐清其中的因果與來龍去脈。\n他只意識到一件事——自己什麼都沒做到。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我算什麼英雄？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是啊，你算什麼英雄？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "鐵匠環顧四周，工坊內空無一人，唯有巨龍的雕像正用空空如也的眼眶斜睨著他，宛如質疑。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "你算什麼英雄？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我算……什麼英雄？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "英雄會放任一個每天面對無數敵意的孩子，在時不時對他口吐惡言的人群中東遊西逛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "英雄會讓糧食在自己鼻子底下運出城，直到城內無糧可吃，還只能向鄰居分發幾顆可憐的馬鈴薯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "英雄會在城內亂成一團時窩在家裡埋頭打鐵，就為了把自己的名字刻在雕像的基座上，滿足那點可憐的虛榮心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我……我絕不是為了什麼虛榮，我是為了……為了能用英雄的名號，去……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "去像你當時對涅梅絲說的那樣，“為那些在戰爭中失去了一切的同胞謀取幸福”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "就像現在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "……就像……現在？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "你要保護的弱小已經不在人世。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "你要伸張的正義，已經沒入黑暗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "你要為之謀取福利的同胞……艾瑪、羅里，他們真的還是你的同胞嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "他們難道不是活在過去的死人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "活在過去的……死人？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "他們甚至不像你，你那顆虛榮的心還夢想著未來，而他們？他們不過是一群活在過去的行屍走肉罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "你的同胞是個拿著從火裡搶出來的古董刀四處比劃的可憐人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "或者，為了一個流產的胎兒，就對一個無辜的孩子見死不救的走私犯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "又或者，面對變故，已經只能理解仇恨這一種邏輯的“城裡人”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "現在就抓一個人過來，問問他以後的打算，猜猜看你能聽見什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鐵匠從不離手的大錘噹啷一聲落在地上。\n他死死盯著巨龍的頭顱。"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "不，不……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "真正把人們困在過去的……難道不是你嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我收集同胞們生活用的碗盆，點燃同胞們取暖照明用的燃料……就只為了哺育你這個……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "怪物。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "糧食我不知道，但金屬、燃料……\n對，是我，我親手把鍋，把碗，把人們的生活餵到你的嘴裡，把你餵成如此巨大……"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "連我自己的生活也被你吞吃下去，緊接著，就是提奧的生命……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "提奧，提奧……\n對，是我養大了這個怪物，這個怪物又把你的命吞掉！"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "現在，它又要在夏末節那天站上廣場，張開雙翼，它說整座城的居民都會被它變成只能活在過去的死人……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "怪物，你說得對。我的確不是英雄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我只是個可憐的、虛榮的騙子。過去我騙其他人，現在，我騙的是自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "但人們需要我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "需要你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "他們需要一個英雄，去叫醒他們，告訴他們，戰爭已經結束了，現在重要的是明天，是未來，是即將開始的生活。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "就憑你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "就憑我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鐵匠決絕地自爐膛邊離開。他拿了一條最粗大、最堅固的鐵索，又拖著鐵索，回到巨龍那仍然斜睨著他的頭顱下方。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "跟我走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "廣場。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨龍",
      "text": "今天並不是夏末節。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我不能再等了，再等下去，你那些不祥的預言只會成真。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "跟我走……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "然後，我會將你拆掉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我會讓你把生活還給所有人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巨龍紋絲不動，但鐵匠分明看到，那頭顱向著他低了低，既像輕蔑，又像邀請。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "葦草、涅梅絲，我回來了。庫林的狀態很不好，也許你們應該過去看看他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "你們那邊的情況呢？城裡人怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "人們仍然在抓間諜……維多利亞間諜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "他們瘋了！說到底，塔拉人、維多利亞人，不都是人嗎？戰爭已經結束了，我們難道還要這樣繼續拚個你死我活嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "涅梅絲，去解釋給人們聽，讓他們吃不到飯的深池已經被紅龍懲治了，糧食也——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "布莉吉，別再說深池這個詞，一次也別說。這是領袖的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "而且……說到底，糧食的事，我也只是在慶功會上聽見他們竊竊私語罷了，沒有證明，沒有審判。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "甚至連糧食到底是怎麼回來的，我都一無所知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "更別說深——那些人不在了的消息，現在根本就沒傳到人們的耳裡……我到底該怎麼解釋？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "如果道理講不通，就只能硬來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "您是說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我回到這裡，原本抱著再也不當影子的打算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "但到了現在這個地步，如果真正的領袖始終不願露面承擔責任，我就必須出面，至少暫時安撫混亂的人心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "對了，那位庫林先生呢？他畢竟是公認的英雄，如果他能幫我們一把，事情就能順利許多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "他應該就在自己的工坊，我來帶路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "布莉吉，你趁現在快點出城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "你……如果我們和庫林都無法成功，你和人群之間……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "我懂了，因為城裡的人不喜歡我，我可能會礙事，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "抱歉，布莉吉，我不是說你礙事的意思——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "但你說得對，我就是會礙事啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "別擔心，我現在就走，去黑林碰碰運氣。也許它現在就願意放行了呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "庫林！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "庫林……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "他不在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "他……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "這是？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "涅梅絲",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "兩人瞠目結舌。\n工坊的門……\n不，工坊正對著她們的那面牆，已經不在了。\n那面本該在雕像完工時才拆掉的牆此時已經化為一堆瓦礫，而那些瓦礫掩蓋不住的，是一道通向廣場方向的拖痕。\n一道寬如道路的，長長的拖痕。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
