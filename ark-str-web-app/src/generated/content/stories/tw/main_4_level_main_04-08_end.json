  "storyId": "main_4_level_main_04-08_end",
  "groupId": "main_4",
  "stageId": "main_04-08",
  "title": "應激反應",
  "storyCode": "4-8",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-08_end.txt",
  "sourceHash": "e7568932da682649e57b582a4cf9b084e56f3395b15e734c1d3ceb825296b80c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我知道你在掩體後面，別開火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "看看我帶了誰來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "隕星，是我們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "誰？難道是......阿米婭嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "阿米婭！你......你居然來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "見到你，真是，真是太好了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "——你不該來。這是個巨大的陷阱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "讓你來營救我們，代價太大了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "這是個錯誤的決定......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "現在責怪她也沒有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "更何況，誰都看得出來你們根本沒有機會逃出來......阿米婭是不會放棄你們的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "我沒在責怪她！只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "嘖。對不起，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "沒關係的。見到你們平安，我就已經非常開心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但是......潔西卡她怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "她有點......被嚇到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "本來是想等她振作起來，但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "該說是留下了心理創傷......吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "潔西卡，你還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "只能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "霜葉，幫個忙。把她的手放在我的胳膊上，把她手指抓緊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......沒問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "阿米婭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我沒事！只是......唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好強的......悲傷......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "很模糊，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "潔西卡！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "沒問題的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "一定要振作起來呀，潔西卡......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......阿米婭......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "阿米婭......阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好了，好了......已經沒事了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "潔西卡......你還好嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "阿米婭......我是在......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......對不起......我沒想到......我沒想到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "沒關係的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "那些，那些......嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我感受到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "沒錯，我也經歷過——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——想要逃跑，卻走不動路——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——想要尖叫，卻發不出聲音——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我懂的，潔西卡......我也經歷過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": ".......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "站起來吧，潔西卡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你不用再害怕了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "因為你現在，和我們在一起。你不孤單，你身邊永遠有我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們還得一起回羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "芙蘭卡和雷蛇還在等你呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "......嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "阿米婭......你......剛才用了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可得......向凱爾希醫生保密哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
