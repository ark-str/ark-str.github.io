{
  "server": "tw",
  "storyId": "main_11_level_main_11-08_end",
  "groupId": "main_11",
  "stageId": "main_11-08",
  "title": "以命換命",
  "storyCode": "11-9",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_11-08_end.txt",
  "sourceHash": "bde61ac1becd89ad4f921a4fcb446b6872b7b7341c299bb7277421012a84a5d4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "喬治，願意去的人，都在這裡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "湯米呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "湯米他不見了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "沒事，本來就是自願的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "喬治叔叔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "費斯特，看來你找到了凱瑟琳留給你的東西，是你想要的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "既然你拿到了，那就快走吧，不然，可能就走不了了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "等等，發生了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "你知道那些薩卡茲把凱瑟琳帶去幹什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "她知道的太多了，他們要把像她一樣的工人秘密處決掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "剛才我就覺得不對，讓戴爬到工廠上面確認了這件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "你說......什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "凱瑟琳瞞著我們，以為我們什麼都不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "但我們也不傻，多多少少也猜到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "......然後你們要做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "不做什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "......我們忍了這些薩卡茲很長時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "許多人都習慣了，習慣了這種溫吞水的狀態。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "甚至許多人以為，只要再忍一忍，薩卡茲就會放過我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "然後，他們現在打算拿凱瑟琳開刀了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "你們會死的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "那也好過眼睜睜看著凱瑟琳被他們殺死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "聚集在這裡的，都是沒有後顧之憂的傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "你已經是自救軍的人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "你們的事蹟我們都聽說過，不少人其實都為你們高興。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "你有更重要的事要做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倫蒂尼姆工人",
      "text": "別讓凱瑟琳的犧牲白費。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "博士，雖然我獲得了奶奶留給我的情報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "但是，作為這座軍工廠的工人代表，奶奶本人無疑是對薩卡茲的生產線走向最為瞭解的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "她在戰略上有著重要的價值，對吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "毫無疑問。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我不否認。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......那麼，我想請求羅德島的協助。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿斯卡綸，你在嗎？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我記得你盯著......陪著我。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "我在。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "想必你已經摸清楚了這個區塊的敵軍配置。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "請描述一下這個區塊的敵人配置吧。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "他們收緊了防禦。外圍漏洞百出。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "現在看守中外圍這些區塊的，大多是一些結構鬆散的雇傭兵團體。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我們需要一些時間。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "轉移雇傭兵的視線，解決那些斥候。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "沒問題。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "謝謝你們，博士，阿斯卡綸小姐。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "費斯特深吸了一口氣。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "他將自己的工牌貼在胸口，走進了工人們的隊伍當中。"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "別做蠢事，費斯特。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "大夥，我並不是以自救軍成員的身份站在這裡的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我是以在這座工廠長大的、工人代表凱瑟琳孫子的身份站在這裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我屬於這裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我和你們一樣，不希望凱瑟琳死去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "而且，我不僅不會讓凱瑟琳死去，我也不會讓你們死去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "這位博士的手下會幫我們切斷薩卡茲的情報傳遞。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "只要能把奶奶和其他工人代表救出來，我們會有充足的時間撤離海布里區。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我會帶著你們去和自救軍會合。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "所有人都會得救。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......所有人都應該得救。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "工人們面面相覷。\n但他們都看到了彼此眼中緩緩燃起的希望之火。\n他們開始自發地走動，走到費斯特身後。\n他們決定相信費斯特。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "費斯特，我、我也去！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "湯米......你還是來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "不過，你還是不要去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "為什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "你爸爸身體不好，所以你才猶豫了，不是嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "但是——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "而且，我有件事想要拜託你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "不管結果怎麼樣，半個小時後，去向薩卡茲舉報，就說我們這些工人，擅自行動去鬧事了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "可......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "這也很重要，我不能害了留在這裡的兄弟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "......我知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "那麼，各位，讓我們出發吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "去把我們的老工頭們救回來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人們",
          "text": "噢！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "凱瑟琳默默地抽著煙。\n她看著那些薩卡茲將一個個熟悉的老面孔拖到臨時的刑場上。\n她能看到那些老面孔或憤怒，或放棄，或厭惡。\n最後，歸於平靜。\n她知道，很快就會輪到自己。\n她感覺心中空前地寧靜。\n費斯特說的是正確的。\n妥協與順從同樣無法解決問題。\n她必須為自己的選擇付出代價。\n但她至少在付出代價前，又見到了自己的孫子一面，並給他留下了一點東西。\n這就足夠了。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "到你了，老傢伙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "把她押過去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "我自己會走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "對了，明椒。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "格林應該沒讓你殺過人吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......是的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "那這是個好機會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "你該試著學會殺人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "薩卡茲就是這麼對待孩子的嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "我聽到了你說的話，你說得對，她還不知道戰爭是什麼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "如果可以，我也不希望知道什麼是戰爭。每一個薩卡茲都是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "但你們沒有給我們選擇。你們所有人都沒有。所以現在，她該知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "我喜歡你的眼神，老傢伙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "每當我發現那些死不瞑目的戰友時，他們，也往往都是這種眼神。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵",
          "text": "我殺過很多人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵",
          "text": "但是，把這些沒有反抗能力的人一個個處決的感覺，還挺怪的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "......不想幹的話，可以回你來的地方。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "你怎麼知道這些工人過去造的武器有沒有被用來殺你的同胞？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "我們在打仗。道德是留給和平的。我們從沒有機會真正公平地討論這個話題。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵",
          "text": "不用你來告訴我這點，我只是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "嗯？無人機？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "就是現在！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我用無人機在外圍偵察過了，就是這裡沒錯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我們衝進去！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我......不能交給別人嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "不行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "格林應該教過你，隊長的命令對雇傭兵來說是絕對的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "今天，要嘛你殺了這個老東西，要嘛，放下武器，但我會了結你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "動手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "但是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "動手！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我......我做不到！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "......我早就說過，格林太護著你了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "我們不是來說服維多利亞人把家園還給我們的。沒法動手，你可得吃點苦頭——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "唔——無人機？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵",
          "text": "隊長，有許多工人衝進來了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "費斯特，我們這邊有博士幫忙指揮，我們會幫你牽制住其他雇傭兵，凱瑟琳就交給你了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "......你們瘋了嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我們沒有瘋。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "你知道這樣的老工人，他們的經驗有多寶貴嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "很搶手的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "費斯特！你們——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "哼......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "假裝什麼都不知道，你們還能活得久一點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "不巧，奶奶從小就批評我，不知道在該閉嘴的時候閉嘴。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "那你以為你能打贏我？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "不能，但是她也許可以。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "什——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "呃......！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......混帳玩意，呃，還真結實......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "謝了，喬治。起碼出了口惡氣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "還是先謝費斯特吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "還有......你們這些薩卡茲，不動手嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......孩子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "你們的隊長說得沒有錯。我們不該在現在談論對錯。我們沒法談論對錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "但如果你甚至不知道自己在為什麼而戰......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "你、你們不能走......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......沒辦法了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我們上！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "怎麼回事，其他人呢......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "再沒有聯絡，就只能彙報給——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "呃......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "薩卡茲戰士感覺自己身體一輕。\n隨著身體不受控制地前傾，他逐漸模糊的視野中出現了一個黑色的身影。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "那是一個薩卡茲。"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "為......什麼......薩卡茲要......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "最後一個。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "雖是自言自語，阿斯卡綸卻像是確信一般收起武器。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "從她的位置，可以清晰看到憤怒的工人們將薩卡茲雇傭兵們衝散的場景。\n在累積了數年的憤怒面前，勢單力薄的暴力被摧枯拉朽般衝垮。\n強弱變換了位置，一些往事飄上心頭。\n她隨即將視線投向某個方向。\n那是倫蒂尼姆中央的位置。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......所有雇傭兵都被綁起來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我們有多少人受傷？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......不多。跟著這個孩子的雇傭兵第一時間沒有動手，他們全都慌了神。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "他們甚至沒有下定決心戰鬥。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我們——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我們......我們只是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......起碼你們試圖反抗，只是被狡詐的倫蒂尼姆人偷襲罷了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿斯卡綸解決了外圍的麻煩。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我們的時間並不多。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......本來只有我們幾個老東西去死。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "現在倒好，你們所有人都要變成薩卡茲的刀下亡魂了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "這就是你的主意嗎，聰明的費斯特？讓我們這麼多年的忍讓全部白費？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "如果今天我們坐視你們的犧牲而苟且偷生，那麼明天，就會出現另一批犧牲者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......直到再沒有人真的在意同伴的死活。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "而且......你不能總是替所有人決定這一點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "你說對了，你也不能替所有人決定，費斯特。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "但這次，是所有人自願來救奶奶的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "薩卡茲佔領城市很多年了......我們的日子很艱難，但有一些底線，我們絕不能失去。如果今天我們不出現在這裡，那我們——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "我們會被薩卡茲熬死在這一鍋大雜燴裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "喬治......你們也陪著他胡鬧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......並不是所有人都在這裡。那就說明，有很多人並不願意看到我活著回去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......現實的殘酷超過你的想像，費斯特，別把人的道德想得那麼簡單。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "但事情已經發生了......唉。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "凱瑟琳沉默片刻，看向明椒。\n但她終於還是沒有說什麼。"
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "走吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
