{
  "server": "tw",
  "storyId": "act35side_level_act35side_05_beg",
  "groupId": "act35side",
  "stageId": "act35side_05",
  "title": "文物也上班",
  "storyCode": "AS-5",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act35side/level_act35side_05_beg.txt",
  "sourceHash": "4c51bddc30484c77b27ef5187b078be7d6e9bf5636572bfe00ca2aac3a7ab004",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "博物館廣播",
      "text": "請排隊購票，請排隊購票。“與死而復生的沙阿時代將領相會”特別展覽正在售票中！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館廣播",
      "text": "請排隊購票，請排隊購票……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狂熱的觀眾",
      "text": "對，就這樣看著我，只看著我，不要看鏡頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狂熱的觀眾",
      "text": "再稍等一下，我整理一下婚紗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狂熱的觀眾",
      "text": "雖然是連夜趕製出來的，但我以我收藏的三千冊沙阿傳奇小說保證，它一定符合歷史！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "本展覽禁止使用閃光燈拍照，以免對文物造成損害，請您注意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狂熱的觀眾",
      "text": "來——二十連拍！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "騎著平衡車的觀眾",
      "text": "大家好，現在我終於進入了法爾賈萬達巴德博物館裡最神祕的房間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騎著平衡車的觀眾",
      "text": "接下來我將透過流暢的運鏡，三百六十度無死角地記錄這位將領的英姿，探索輝煌之城死者復生的奧祕。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的觀眾",
      "text": "爸爸，它的腿裡面好像是空的欸。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的觀眾",
      "text": "爸爸你聽，敲起來就是空的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "打電話的觀眾",
      "text": "嗯，對，這批貨要盡快送到東國，訂單不大，重在信譽……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "先生，麻煩管一下您的女兒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "打電話的觀眾",
      "text": "抱歉，等一下，我這邊有點事……喂，過來！別亂摸！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "請不要在博物館裡大聲喧嘩……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "打電話的觀眾",
      "text": "喂，你們自己要搞這種開放式展覽，讓你們那個展品到處走的嘛！還不限票，自己搞得展館這麼吵！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "這是由於，本館代理館長阿娜特認為“歷史與知識對所有人都是平等的”，不應該設置貴賓票。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "另外，我所處的展台周圍高約六十公分的護欄，本身具有阻攔遊客進入的作用。您的孩子越過護欄，將被視為違規行為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "請配合工作人員……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拿著硬幣的遊客",
      "text": "唉，沒投進去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看導覽手冊的遊客",
      "text": "手冊上沒寫外國貨幣有沒有用啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看導覽手冊的遊客",
      "text": "好吧，手冊上根本沒寫把硬幣扔進去就有好運。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拿著硬幣的遊客",
      "text": "試試看，萬一呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看導覽手冊的遊客",
      "text": "……給我一枚。往它的身體中間丟對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "請……停手……這是重要的歷史文物……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "人太多了，根本擠不過去……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "了解，我會使用武器揮開飛來的投擲物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "（抬手）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "披掛甲胄的觀眾",
      "text": "呃啊——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "披掛甲胄的觀眾",
      "text": "大家快看這裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "披掛甲胄的觀眾",
      "text": "我扮演的是一千年前的夢魘戰士，我被打倒了！這是偉大的歷史重現時刻！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我的武器並未觸及他的身體。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "披掛甲胄的觀眾",
      "text": "噢，沙阿麾下的將領！對你的手下敗將說點什麼吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "在我生活的時代，各軍在斬殺敵方被俘虜的首領示眾時，最常說的一句話是“你的內臟會被蟲豸吃光”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "披掛甲胄的觀眾",
      "text": "好，就這句，再說一遍……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "披掛甲胄的觀眾",
      "text": "喂喂，你們都別擠過來，我還躺著呢！要發生踩踏事件了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "糟了……得趕快申請人手支援。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館員工",
      "text": "這誰能想到……外面還在過漫灌節，怎麼會有這麼多人跑來看一具會動的古屍啊？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "身分高貴的女性",
      "text": "哈特謝普蘇特女士，我聽聞這幾日您在尋找一顆特殊的寶石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "身分高貴的女性",
      "text": "正好，家族中有顆珍貴非凡的寶石，今天特地帶來供您一閱，希望能為您解憂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "真是感激不盡……麻煩給我看一眼吧……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "身分高貴的女性",
      "text": "不知這幾日是否有幸邀請您到家中享用晚餐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "很抱歉，女士，我最近真的是忙不過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "謝謝您特意將這顆寶石帶過來，但很可惜，它並不是我要找的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "身分高貴的女性",
      "text": "喔，真是遺憾。那就不打擾了，哈特謝普蘇特女士，有空再見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "呃……還有多少人等在外面？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "還有七十三位，他們都聲稱自己手上的寶石可能是你在尋找的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "為什麼還有那麼多人要見——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "忍一忍吧，下午就能休息了，有幾位大巴扎的寶石商人說自己找到了一些線索，我們下午去看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "這叫休息嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "當然，下午我們不用見人，光看寶石就夠了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "啊……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寶石商人",
      "text": "阿娜特女士，這位帕夏之女已經愁眉苦臉地坐在這裡三個小時了，剩下的寶石你們還要看嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "還剩下多少顆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寶石商人",
      "text": "還有兩百多顆……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "……放在那裡吧，我們看完這一箱再說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寶石商人",
      "text": "那我就先行離開了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "阿娜特……剛剛有人來過嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "他們又送來了一箱寶石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "阿娜特，不對啊，你的腦袋怎麼變成四角錐體了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "怎麼四周的陳設都變成四角錐了……還亮晶晶的……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "佩佩！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "——博物館終於開門了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "旅館接待員",
      "text": "是啊，阿斯帕齊婭小姐，現在特展一票難求哪！我昨晚就聽說了小道消息，想提醒您早早排隊去買票，可您昨晚去哪裡了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "沒關係，特展不是我參觀博物館的重點，還是去拜訪那位收藏家更重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "旅館接待員",
      "text": "您看起來心情不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "正如我想的那樣，語言是和平的橋樑，溝通是理解的基礎，而這座歷史古城，也不乏有識之士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "唉，古往今來，以輝煌歷史為傲的薩爾貢人啊，他們如果都願意坐下來和我徹夜傾談，而不是四處掠奪，那該有多好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "在我的講解下，那位收藏家明白了米諾斯人的執著，而他對這座城市的介紹也令我受益匪淺……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……對了，有一件事，我想向你求證。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "在現代的米納特哈瑪儀，銀製品是否比金製品更珍貴？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "旅館接待員",
      "text": "哈哈，您怎麼突然開這種玩笑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "旅館接待員",
      "text": "當然，這種事情是有的……比如說，被王酋老爺們威脅的時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……多謝，情況我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "請問和我同住的那位旅伴回來了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "旅館接待員",
      "text": "回來了，還帶著您的另外兩位朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "另外兩位朋友……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "也好。思想的交流多多益善，我很樂意結識更多像她一樣熱情豪爽的庫蘭塔。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿斯帕齊婭走上旅館樓梯，在房門前站定。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "娜仁圖亞，你在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我有好消息要告訴你，聽完我三個小時的演說，獲得第三名的那位收藏家把金杯送給我了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "你想不想和我一起去博物館看成對的金杯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陌生的聲音",
      "text": "……昨晚我的確沒有見到任何人進出那間放著寶石的房間，娜仁圖亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陌生的聲音",
      "text": "我一直躲在對面的屋頂監視，沒有閉過眼睛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞的聲音",
      "text": "……你們應該知道這次綁架有多重要。只有這樣的目標能讓我們馬上搞到一大筆錢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "抱歉，娜仁圖亞。我們現在立刻去找帕夏之女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "晚了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我找來作掩護的商隊馬上就要出城，現在重新找到她，再計劃綁架，得手了也來不及逃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅妮",
      "text": "那……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "說後續的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你們還是回博物館，但別再碰那個帕夏之女了，找新的斂財機會，及時向我彙報情況。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我去找那顆丟了的寶石，至少把它還給阿斯帕齊婭……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "不用還。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "阿雅吉突然感覺到房間裡變得很安靜。\n她看了看闖進來的陌生人，又看了看娜仁圖亞，最後求助地看向阿雅妮。\n阿雅妮豎起一根手指放在嘴唇前，另一隻手摸向腰間的麻醉藥。"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "呃，聽我解釋，阿斯帕齊婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "現在是計劃的起步階段，等計劃完成，我一定還上寶石，至少也還上等價的東西。你可以對我更有信心一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "對了，這是我的另外兩個手下……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "什麼計劃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "呃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我聽到你們計劃用那顆寶石作為誘餌，綁架帕夏之女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……你都聽到了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "抱歉，我無意偷聽，但剛才我就站在門口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我相信溝通是理解的基礎，而且我也知道，你欠了一筆債，現在一定急需用錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "所以，你想詳細講講來龍去脈嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "說實話，我對寶石的下落毫無頭緒，你就算想幫忙，我也沒什麼任務可以安排給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "過去的事情已經過去了，現在的計劃……差不多就是沒有計劃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "你知道我問的不是這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "那如果我告訴你我為什麼欠債，想要多大一筆錢，你會支持我的做法嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我認為我們可以討論出一種更無愧於良心的做法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "嗯，我還是很了解你的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "阿斯帕齊婭。能不能麻煩你把手伸出來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "沒什麼，就是看在我們之間的情分上……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "阿雅妮和阿雅吉交換了一個眼神。\n她們很清楚，娜仁圖亞動手的訊號，是清脆的鞋跟叩地聲。"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "——能不能幫我欠的帳打個折？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿雅吉&阿雅妮",
      "text": "……欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我在你這裡借住了半個月，還拿走了一顆寶石，這些都算我欠你的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "這一袋金幣呢，共計一千二百第納爾，我知道不夠還，但……我們的感情就是這麼好，對不對？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "娜仁圖亞……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "對了，裡面混了一些外地的鑄幣，有些商人可能不認，但你總能找到地方花出去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "還有一些寶石，雖然都有點小，雜質也有點多，但勝在數量也多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "通融一下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……娜仁圖亞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "你就這麼不想跟我談一談嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "“溝通是理解的基礎”，但我已經理解你了嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你或許曾在神殿一天又一天地模仿雕像，練習持劍的基本功，或者跟著你的父母，立下一個家族世代傳承的誓言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "更重要的是，你是米諾斯英雄萬千追隨者的其中之一，所以，你想擁有一個純潔的靈魂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你一定會伸手去救一個從高樓墜落的人，也一定會狠狠指責一個想要用點……特殊手段的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "是的，你說得對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我相信人心中有衡量善惡的尺度，律令中亦有尺度。人應該依循尺度行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我也同樣理解你。或許你會告訴我，王酋帕夏的律令是失常的尺度，你寧可遵從自己的內心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "只是，娜仁圖亞……我不敢相信我自己的心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "那要是我哪天被王酋老爺們抓住了，莫名其妙被判了死罪，你會為我惋惜嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "當然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "哈，這就夠了。看來你也覺得，如果我死了，對整個薩爾貢都是一大損失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "要是你願意加入我的大事業，那我們把事情搞砸死在半路上的機率會小得多。但你不願意，那也沒關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "有人會來，有人會走，我當然想吸引大家留在我身邊，但要是對離開的人太計較，我豈不是和那些嫉恨我的人一樣傻？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我的意思是——我們都別為難對方了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我認為我們債務兩清了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "唉……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "你受傷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "一點擦傷而已，放心……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "你應該處理一下，我曾見過很多武士疏忽大意，對小傷口置之不理，最後失去生命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "現在已經不是那個時代了……改天我再跟你講講現代的醫療技術。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "你要休息了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不……我先修補一下泡水的筆記……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "泡水？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "這是一個很長的故事了，但我不確定自己還有沒有精力講給你聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "早上分別前，你說會將自己收穫的情報分享給我。你做出了承諾，佩佩，你應該告訴我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……好吧，我今天一無所獲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我將訊息放出去，無數人帶著相似的寶石來找我，但沒一個扯得上關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "一整天，無數顆寶石在我眼前閃來閃去，看得我頭暈眼花。隨後，我本想點杯飲料休息一下，但旁邊有兩個孩子突然打了起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "桌子倒了，飲料翻了，我擦傷了，筆記本泡水了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "這就是我能分享給你的全部了，祖拜爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你能否從中得到自己需要的資訊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "那……你想聽聽我今天的經歷嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "祖拜爾……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "來了很多很奇怪的人……不過也很有意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "明天再說吧。你是不需要睡覺，但我真的很累了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我不想留在展館內……佩佩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……再忍受幾天吧，我們需要幫助緹緹完成這次特展，畢竟作為交換，她都將寶石給我們了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "等展覽結束，我就帶你一起去找其他的寶石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我也不想去找寶石……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "那怎麼行，祖拜爾？作為沙阿寶庫的守護者，你不該盡快回憶起全部，重新肩負起自己的職責嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "更著急知曉寶庫位置的人不是你嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "啊……是，沒錯，不然你以為我喚醒你是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "佩佩，但我已經甦醒，你不能再將我當作文物來看待，我的行為與想法受我自己控制。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "至少此刻，我並不想那麼快回憶起自己的過往。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "明天是個好天氣，我想去外面走一走，不想掛念任何事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "要是看到博物館的展品獨自在街上曬太陽，城市裡面的人會發瘋的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "我說過了，我不是展品！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "抱歉，祖拜爾……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "沒關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "今天已經很晚了，我真的很累，有些事……我們明天再說，好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "晚安。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜爾",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "空蕩的房間裡，祖拜爾試著按了一下牆上的開關，關掉了燈。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "片刻後，他又試著按了一下，燈重新亮了起來。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米奧",
      "text": "喵？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "米奧站在深夜的街道中央，目不轉睛地盯著遠處那個燈光閃爍的窗口。\n然後——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "燈光不再閃爍，玻璃碎了一地。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "南風過去，那邊就是旱季了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我來得及在那之前弄到足夠的錢嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "好，準備跳……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "現在的小姑娘怎麼都這麼嚇人……你這是在幹什麼？不是要輕生吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你奇怪什麼，這不是本地漫灌節的習俗之一嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我要找河上的神靈問問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "那也不是以跳河的方式啊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "而且，小姑娘，你從哪堆歷史書裡翻出來的習俗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "很久以前人們猶豫不決時，確實會向河流提問，但後來很多問題都可以用錢解決了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "謝謝，不是很有用的生活小訣竅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "不過，我倒是可以回答你的問題。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "點燈人舉起手中那盞火，湊近娜仁圖亞。"
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "南風吹過之前，你得到的錢不足以填滿你自己的欲望，但夠用了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……我換個具體一點的問題。接下來我要去哪裡弄這筆錢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "黃沙深處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "薩爾貢可到處都是沙子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "我只能再回答一個問題了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我還以為米納特哈瑪儀的人都很闊綽，免費試用品都是無限取用的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……不，等等，剛剛的不算問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我想問……那個死腦筋的米諾斯人會來找我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "點燈人",
      "text": "會。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "對方的話音剛落，娜仁圖亞的餘光就瞥到一個影子。\n那個身影在空蕩蕩的街頭駐足，看了她片刻，然後轉身走開了。"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……阿斯帕齊婭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "阿斯帕齊婭！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "影子轉過街角，赤紅的庫蘭塔追了上去。\n在娜仁圖亞耳中，只有風聲、河水流淌聲，還有逐漸被她拋在身後的點燈人的歌聲。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……跟丟了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我娜仁圖亞居然會跟丟目標？真見鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "算了，我又不傻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "這裡人人都在祈禱見到什麼東西的影子，我剛才又沒有聽到腳步聲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "所以，我是真的見鬼了，對吧？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "她在街邊坐了下來。\n花壇另一側，同樣有人在黑暗中沉默地聽著河水流淌。"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "靠河那邊的長椅上經常有水，記得擦擦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "你不是真的怕鬼吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "怎麼，你也看到那個影子，然後害怕了？要我保護你嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……我感到懷念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "雖然沒能看清，但我總覺得，那或許是已故親友的亡魂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "兩個人都看到鬼魂，總比一個人見鬼好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我聽說，看到那個身影的人能獲得米納特哈瑪儀的祝福，但是坐在這裡的人，好像都是倒楣蛋啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……我只是跟人吵架了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "真巧。我想應該是沒吵贏吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "贏了就不會坐在這裡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你知道嗎？十分鐘前還有人告訴我，當地人沒什麼煩惱，因為錢總能解決煩惱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我覺得很有道理。如果沒有和我一樣欠著一筆債，你有什麼能不快樂的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……今天有人扔東西砸我，還有人弄髒了我上週才拿到的新斗篷。我還莫名其妙一天結了二十次婚，男女老少都有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "這些事還沒人願意聽我說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "喔，喔……那確實滿倒楣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你的年齡夠了嗎？能讓他們拿你的個人資料胡亂登記結婚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "無意冒犯，雖然你聲音有點怪，但聽起來是個年輕人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "唉，我在你這個年紀的時候，好像運氣還滿好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "有一次我們正趕著搶來的馱獸隊伍往回走呢，天突然就黑了，頭巾都擋不住刮過來的沙子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "還好我們人多，立刻找了一塊感覺不太一樣的空地開始挖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你猜我們挖出來什麼？兩間埋在沙裡的屋子，剛好勉強能擠下我們所有人，而且裡面有床有桌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……那是古代陵寢的常見陳設。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "哈哈哈，你還滿懂的嘛！我都是過了好幾年才知道的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……那是多好的時光啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "是啊……時光能讓河流改道，城市建起又消亡。能讓骸骨曝露於烈日黃沙，也能讓歷史越沉越深。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "逝去的時日令人懷念，而懷念……令人恐懼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "是啊，逝去的時日再懷念也無法追回。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "你懷念的那些人，現在怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "活著，活得很不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "最不好的是，他們都沒辦法從挫折裡走出來往前看了。你都不知道有多少人賣掉了刀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "所以我這個當老大的欠他們一筆債。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "反正，只要存出一座新的金山，那些傻子肯定就能打起精神，回來過以前那種日子啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "……但願如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "我……我也不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "就像人們拚命去追河中神靈的身影，最後看清的卻是自己並不想見到的一張臉，這何嘗不令人心生恐懼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "如果你依然去追了，那至少說明你也沒有那麼害怕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "好吧，我還沒有離開家鄉的時候，老媽總在我耳邊這麼說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "所有人都覺得，“夢魘應當是恐懼的主人，從不會被它支配”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失落的路人？",
      "text": "——你是夢魘？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "對啊，怎麼——",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "娜仁圖亞感覺到對方拍了拍她的肩膀，於是她自然地回過頭。\n寂靜的大街上，只有路燈由遠及近一盞一盞點亮。\n哼著歌的點燈人走到他們面前，爬上梯子，打開玻璃燈罩。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "啊啊啊啊啊啊啊！！！！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "救命，救命啊！我被死人纏上了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
