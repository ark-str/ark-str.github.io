{
  "server": "tw",
  "storyId": "main_10_level_st_10-02",
  "groupId": "main_10",
  "stageId": "st_10-02",
  "title": "交叉路口",
  "storyCode": "10-13",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_st_10-02.txt",
  "sourceHash": "7d057e51bd63e4b266a9bb32c43c257276120c48f1418404e76c07661d331721",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "呼......哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你已經沒有餘力了，蔓德拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "......怪物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "你們薩卡茲......都是怪物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "類似的稱謂我們過去聽過太多次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "當從一個趴在地上的對手嘴裡聽到時，我傾向於把這個詞當作讚賞。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "咳咳......\n咳咳咳。"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "薩卡茲，你們......和那些貴族一樣......可惡。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "這種法術......\n這種天生的法術，不管我怎麼學都......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你竟敢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "把礦石病當成一種恩賜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "無數薩卡茲，自出生起就背負著這種詛咒，身體潰爛，臟腑流膿——你們只當我們是傳播災難的害蟲，將我們從城市中驅逐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "每天有多少薩卡茲化作隨風而散的結晶，甚至都無法被安葬於故土，只因為他們想多看一眼日出？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "而你卻說......\n你羡慕這種力量？維多利亞人，你配嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "......你叫我維多利亞人。魔族，你真的很清楚怎樣羞辱我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "你知道......我為什麼不敢得礦石病嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "荒野裡的薩卡茲......你們至少還能在死前......看到日出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "本來就生活在城市夾縫裡的我們，要是身上出現了一點黑色的石頭......第二天就會變成下水道磐蟹的食物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "在維多利亞人眼裡，我們這些弱小的塔拉人......就連薩卡茲都不如。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "只有力量......\n只有力量才能讓我們活下去！"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你們之間的仇怨，薩卡茲從來沒興趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "我只知道，我給過你們機會。而且，不止一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "假如你今天能老老實實地守在北門外，我甚至都可以對你過去的小動作既往不咎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "多大方啊，我是不是該跪下感謝你的仁慈，“將軍”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "你做夢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "你這種人......我見過太多次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "你是不是總以為......我們能活下去，都是靠你施捨？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "我受夠了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "我受夠了成為你們的一個賭注，一枚棋子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "我的命運，塔拉人的命運......必須由我們自己決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......由你們自己決定？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你以為你決定得了什麼？從你來到倫蒂尼姆那一刻起，你的命運就已經註定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "你......你胡說！我......我是失敗了很多次，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "只要我在這裡殺了你，帶上倫蒂尼姆的所有情報，我就能回去找領袖！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......殺了我？就憑你這些堪堪能飛的假石像？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你該不會不知道，就算石翼魔王庭的人在這裡，他們也未必能勝過我吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "別拿我的法術跟魔族巫術比較——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "一次性生成了十個石像？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "就你這樣不是感染者的術師來說，還算有天分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "只不過，對付這種粗糙的法術造物，我甚至都用不上你口中的什麼巫術。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "唔......呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "我看到了你的極限。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "看到你法杖上的裂痕了嗎？等你這根華而不實的法杖碎裂，你就和一個孱弱的普通菲林沒有差別了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "哈......哈哈哈！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "那又有......\n什麼關係？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "石製的法杖應聲而裂。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "腳下的土地顫動著，四處毀壞的石像重新站起。\n它們踉蹌著衝向彼此，緊緊地互相纏抱著，成為一個高近五米的石像，大吼一聲，扇動翅膀，朝薩卡茲俯衝而來。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "防禦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "明白！將軍，您也小心——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "顧好你們自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "這仿製品還傷不到我。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "就像薩卡茲說的那樣，他沒有使用任何源石技藝。\n巨大的石像朝他嘶吼著，翅膀掀起來的風將無數磚石砸向他，突出的獠牙幾乎觸到了他的臉頰。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "而他只是刺出了一劍。\n石像頓在了半空，數秒後，崩塌成了無數碎石。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "看吧，你再也不能耍弄你那些石頭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "哈......魔族佬......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "直到現在，你還是這麼......傲慢。就因為你這該死的......天生的......力量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "我要殺了你......殺了你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你以為殺了我之後，你就能回去和你的領袖邀功？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "即便你真能得逞......你猜猜看，她是會歡天喜地地把你迎回去，還是把你的人頭送回倫蒂尼姆？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "轉告莫寧伯爵，領袖同意薩卡茲對倫蒂尼姆城內的深池人員的一切處置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "有必要的話，向那位薩卡茲將軍致歉——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "——深池無意破壞與卡茲戴爾攝政王之間的和平關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "雖然考慮到他身邊的高盧人，我們註定了無法達成真正的合作，但我們也還不急著彼此為敵，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "為表誠意，麻煩伯爵從中斡旋，把其他貴族部隊最近在附屬地塊截獲的幾名薩卡茲信使還給他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "放心，威靈頓公爵會記得伯爵的努力，領袖與深池更不會忘記。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "請他不要著急，等領袖安頓好眼前的事務，我們會去倫蒂尼姆與他會合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "......你問之前見過的那位深池指揮官會怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "蔓德拉......蔓德拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "我對她夠好了。我甚至特地為她在領袖面前求情，才為她掙來了去倫蒂尼姆的最後一個機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "要知道，領袖至今對她和那幾位在小丘郡辦的事很不滿意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "她為何就是不明白......深池走到今天，已經不再需要鬼魂部隊的名號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "我們最終要建起一個屬於德拉克和塔拉人的新國度——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "而想要取得民眾的支持，光靠憤怒與仇恨帶來的恐怖威懾怎麼行？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "假如她能理解領袖的意圖，學會壓抑自己內心的怒火，從倫蒂尼姆全身而退......至少念在她好好傳了信，領袖身邊一定還有她的位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿赫茉妮",
      "text": "你知道的，領袖她......從來沒有忘記過這幾位最初的塔拉同胞。畢竟，她們是一起從灰燼中走出來的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "或許到了天亮的時候，我就會見到一位從外面來的信使。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "那位信使一定是得到了某位伯爵或者男爵的授意，但毫無疑問，他背後必定是那位塔拉地區出身的公爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "他們或許會感謝我，因為我替他們除掉了一個不安定的瘋子指揮官，為我們之後的談判奠定了一個更好的開端。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "薩卡茲總是被當成好用的工具。是的，在這一點上，我們和你一樣，痛恨這些傲慢的貴族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "但是......蔓德拉，你只能到此為止了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......小刀？你想用一把小刀偷襲我？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "哈哈哈......\n咳咳咳咳......\n萬一......\n我能成功呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......你的大腦神經長在心臟上，剛才被我一起刺穿了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "我說過了，你殺不了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "而且，就算你殺了我，也沒有任何意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "沒有......意義？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "要是......任何事情......都要有個意義，那......我們這樣的人活著，豈不是從一開始就沒有意義？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "我要殺了你。不是因為任何人的命令......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "就只是因為......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "我想這麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "......真是個瘋子。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "瘋子......嗎？看看你這張總是這麼自信又冷靜的面孔......\n是啊，你不懂......\n因為你總能輕而易舉地做到你想做的事。"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "等你最在乎的人......死在身邊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "等你最信任的人......也把你丟下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "甚至......用劍把你釘穿在地......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "......也許你會理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "這就是你垂死之際最後的反抗嗎？你的這些詛咒之言根本無法動搖我分毫。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "呵......呵......\n那你還不快動手殺了我？"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "用不著我動手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "text": "你已經死了，塔拉人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "塔拉人......你叫我塔拉人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "薩卡茲......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "她躺在地上，艱難地喘著氣。\n地面越來越冷了，她漸漸感覺不到自己的手和腳。是在什麼時候被折斷了嗎？還是因為拼命奔跑變得麻木？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你想活下去嗎，塔拉人？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "是誰......誰在叫她？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你旁邊就是下水道。從那裡爬下去，那些可惡的貴族就再也追不上你。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "是啊，爬下去。\n下水道裡散發著濃烈的鐵銹和油脂的味道。從機器上拆下來的廢棄部件與從貴族餐桌上端走的殘羹冷炙混在一起。\n她很餓，這種饑餓感卻讓她感到噁心。\n除了鐵銹味和油脂味，她還聞到了另一股味道。\n她知道那是死亡的氣息。\n下水道是生活在移動城市裡的蟲豸們的墳墓。\n那些有錢人會在寸土寸金的城市內部修建墓地，而兜裡緊巴巴的普通人只能將骨灰撒向軌道之外。\n那蟲豸呢？蟲豸會無聲無息地死在地塊之間的縫隙裡。那是太陽永遠照不到的地方。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你敢走向死亡嗎？只要你有死的勇氣，你就能獲得新生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "領袖......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "只要再往左邊爬一點點。她就能爬進下水道......和那時候一樣。\n而再往右邊一點點......右邊一點點。\n她的塔拉同胞睜著雙眼，沉默地注視著她。"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "領袖，對不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "這一回......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "是我......我不需要你了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "她用最後一點力氣伸出了右手，觸摸到了她面目全非的老朋友。"
    },
    {
      "type": "dialogue",
      "speakerName": "蔓德拉",
      "text": "沒人......在追我們了。我們回家吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "即使你們相聚的盡頭是死亡？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "有人站在她面前。那個人腳邊沒有火光，短刀反射著漆黑的夜色。\n蔓德拉笑了。\n她想，她看到了真正的死亡。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "前面那個廢棄廠房下面就有入口，推開那台吊車就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "好的，麻煩你引路了，費斯特先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "我們走這邊，沒有受傷的人，請扶一下受傷的那些——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "該死，博士，又有追兵！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......他們到底是怎麼做到的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們離開製醇廠以後，無論擊退多少撥敵人，都還是會被發現......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這稍後再說。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "先處理掉這些敵人。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "是的，這是我們成功撤到地下的最後一個機會......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我們絕不能讓敵人跟到地下。自救軍的所有行動都建立在他們熟悉這些地下通道，而薩卡茲並不知道正確入口的前提下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "萬一讓薩卡茲發現這個入口，那自救軍在薩迪恩區的全部努力都會毀於一旦。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "可露希爾，準備爆破物。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "可露希爾",
          "text": "好的......欸欸？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希爾",
          "text": "博士，你是讓我準備好炸了這通道入口？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "這不失為一種保險的方法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "可露希爾",
          "text": "自救軍會有意見嗎......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "克洛維希婭把指揮權交給了博士。博士說了算。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "阿米婭，我們會在前一個街區攔截薩卡茲。等我信號，假如我們攔截失敗，麻煩你們提前引爆炸彈。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "他們往那邊去了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "別東張西望的，你的對手在這裡。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "呃——！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "一隊十個薩卡茲。能攔下來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "就算攔下這幾個......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "你們......你們跑不掉了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "大君聞到了味道......他會一個個地找上你們......劃開你們的身體，切斷你們的咽喉......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "你說的大君是誰？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "是不是......剛才襲擊了另一批自救軍戰士的人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "......襲擊？你們這些維多利亞菲林，還不值得他......偷襲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "他只是......在狩獵。作為獵物，你們甚至還入不得大君的眼。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "沒必要聽他們的污穢之言。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......因陀羅，你還記得剛才那些自救軍戰士的遭遇吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "那樣的景象，看一眼就忘不掉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "我見過的死人不算少，但那樣塗了一地的......就連人形都算不上了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "達格達，你幹什麼？那邊還剩下幾個敵人，我們需要儘快——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "推進之王，算我懇求你。我們離開這裡吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "你這說的什麼話？想和薩卡茲戰鬥的人是你，想臨陣脫逃的人也是你......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "臨陣脫逃的恥辱我忍受過一次了，不差這一回。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "只要能護送推進之王安全地離開這個地區，我隨時都願意回來與薩卡茲血戰到底。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "推進之王，你終於下定決心了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "或許是的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "達格達，我已經看到了你的選擇。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "我的......選擇？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "你走吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "維娜？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "等等......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "達格達",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "去找你該找的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "別讓這些薩卡茲擋住你的腳步。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們的人都下來了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "活下來的自救軍戰士都在。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "海蒂",
          "text": "多虧了你們，我們才能堅持走到這裡。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "維娜呢？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "還差四個人。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......我們來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "推進之王小組，三人歸隊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "咦，達格達小姐呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "她......她沒事吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "別跟我提那個混蛋！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "再怎麼用力捶牆，她也感覺不到。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "呃......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "達格達有她自己的事要做。阿米婭，我為她的離開向你和博士道歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不，不用道歉。我明白了，情況特殊，我理解達格達小姐的決定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們確定不用等她了的話——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "可露希爾。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "可露希爾",
          "text": "明、明白！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "真炸了......啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "達格達她......她想回來的話，是不是會找不到路......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......不會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "因陀羅",
          "text": "維娜，你的“不會”的意思是，她不會回來了，還是她不會找不到路啊？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "別纏著維娜了。我們還得繼續往前走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "是的，往前走吧。自救軍的戰士們還在等我們。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
