{
  "server": "tw",
  "storyId": "act7d5_level_act7d5_st03",
  "groupId": "act7d5",
  "stageId": null,
  "title": "今日廚房",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act7d5/level_act7d5_st03.txt",
  "sourceHash": "01ae9fd364820fa9c3be3d4d045ac72f70073ef3ab572751afc232aad35d24ee",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "9:50 A.M.  天氣/晴\n羅德島艦船，第二艙室，公共食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "北謝拉格風爆炒綠英菜，再撒上少許羅德島特製調味粉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "這樣就完成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "哇！看起來好好吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "過獎了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "這種綠葉蔬菜在謝拉格很少見，我也很少有機會嘗試去料理，能順利再好不過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "雪境不比羅德島，在謝拉格的雪原上，許多東西都很匱乏，是花錢也很難買到的。這裡雖說是在艦上，但物資卻還是很充足，真是難得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "物資啊......這方面的事情，我好像聽可露希爾姐姐提起過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好像是說，羅德島有專門的採購管道，定期會有採購人員向艦內運送物資什麼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "因為在很多地方都有據點，所以就經常能嘗到各地各種不同的食材啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "怪不得。不過，在很多地方都有據點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嗯......好像是類似什麼、辦事處一類的地方。這個我不懂啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "對了，食堂外面的告示板上不是還貼了心願單嗎？如果有什麼特別想吃的東西，都可以寫在那上面哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "據說負責採購的哥哥姐姐們會參考那個！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員A",
      "text": "小古米的嘴真甜，再叫一聲姐姐，姐姐給你帶糖回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "採購姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員A",
      "text": "哎，乖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員B",
      "text": "你正經點......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員B",
      "text": "角峰先生是吧，有什麼想要的食材可以嘗試寫在告示板上，如果有機會的話，我們會進行採購。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "明白了，有需要的話我會嘗試，屆時就辛苦各位了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員B",
      "text": "不必這樣客氣，這是我們的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員A",
      "text": "你們說話怎麼那麼死板？大家都是一條船上的人了，放輕鬆點、自由點說話行不？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員B",
      "text": "你那是自由過頭了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的採購員B",
      "text": "兩位別理這傢伙，我們接下來還有任務，就不打擾兩位了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嘿嘿，大家都是很好的人呢，之前停靠在城市邊的時候，可露希爾姐姐還帶我一起去採購了哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "雖然她會買些怪怪的東西......不過還是很有意思的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "哈哈，這我也有所耳聞。之前是不是還因為買了巨大陶土面具，惹那位凱爾希醫生生氣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "啊哈哈哈，沒錯沒錯，我試過一次，那個面具太怪了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "那種一看就很奇怪的東西，就不要去嘗試了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "嗯，菜涼下來了，溫度正好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "唔，好像有一點鹹了，這個口味，可能會有一點刺激......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "不會啦，我覺得一定很好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "啊，要不然讓我試吃看看吧？可以嗎，讓我吃吃看吧，角峰大叔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "大、大叔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（在這個年紀的孩子眼裡，我已經是大叔了嗎......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "當然沒問題，如果你願意嘗嘗看的話，算是幫了我大忙了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嘿嘿嘿，讓我嘗一嘗......咦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "嗯？怎麼了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "欸......怎麼回事，這盤菜，怎麼感覺好像、好像比之前要少了一點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好奇怪啊，是我的錯覺嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "算啦，讓我來嘗嘗看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "啊——唔。啊嗚啊嗚啊嗚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "（咀嚼咀嚼）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "怎、怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "唔姆唔姆。咕嚕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好吃！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "蔬菜又脆又多汁而且非常爽口，調味也很清爽，完全不會讓人感覺味道很重！哇啊總之就是好好吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "是、是嗎，多謝誇獎，這樣我就放心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "不過沒有你說的這麼誇張，這種料理方法步驟簡單，很適合家庭製作，之後我會把菜譜留一份掛在小廚房，大家都可以試試看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "角峰大叔也可以看古米的營養滿分烏薩斯秘製蔬菜凍湯！我們交換~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "聽起來很美味，那麼下次給小姐們做宵夜的時候，就讓我來試試看吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嘿嘿。初雪小姐和崖心小姐一定會喜歡的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（大小姐和二小姐嗎......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "對了，古米小小姐，你做好的蛋燉肉排，不快點送過去可以嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "是給博士做的吧？再放下去就快要涼透了，會很影響口感......不要緊嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "哇！差點忘記了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "那我先走啦！角峰大叔！炒綠英菜超好吃的，一定要記得留菜譜呀！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "真是個有活力的小姑娘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "出來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......不出來嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "那麼，別怪我不客氣——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "可怕可怕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "也沒必要上來就動刀動槍吧？說來，你那武器是從哪掏出來的？怎麼來廚房還帶著武器，真危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "唉，你是怎麼發現我的？奇怪了，我覺得自己藏得挺好的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "（咬蘋果）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "又來廚房偷吃東西嗎，其實你完全不必這樣，如果餓了，直接去食堂就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "上次的教訓還不夠？我記得之前後勤處的人員應該有和你強調過，如果再被發現利用特殊能力擅自取用料理或食材，會有相對的處罰吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "處罰？哦，你是說他們定的那個，‘被抓一次就在臉上畫一隻烏龜’的那個？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "這算什麼處罰，我還以為是在開玩笑來著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "哎，不對，你還沒說是怎麼發現我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "如果不是你動了我剛做的菜，總量少了一點，我也不會察覺到你的存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "啊呀，失算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "我本來只是想來找找有沒有什麼早飯剩下的東西可以吃，但是你做的那個，聞起來太香了，一時沒忍住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "對不起，真是對不起，我道歉，本人伊桑真誠道歉。啊，還是說道歉也沒用？你很在意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "太好了，你原諒......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "等下，嗯？你說啥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "我說，是的，我很在意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "喂喂喂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "（不是吧，這傢伙居然承認了？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "（不得了，這膽量不得了，居然敢承認這麼危險的事情！這可是可能會要吃傳票的大問題啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "啊，啊？什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "——剛剛沒用餐具，直接用手抓菜了吧！而且也沒洗手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "太不衛生了！這樣怎麼能行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "......啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "你剛剛說在意的......就這事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "注意衛生不是一件小事！對待食物要更加有誠心，特別是別人親手製作的食物，每一份都是蘊含製作者的心意的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "等等，你的蘋果不會也沒洗吧？身為戰士，對自己的身體健康要更加負責任才行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "好、好，知道了知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "這種敷衍的態度......就是因為這樣，杜賓小姐才會總是朝你發火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......算了，這的確不是我該多管的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "別這樣，我真的在反省啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "只是那什麼，哎，有時候習慣這東西真不是那麼好改的，從前我也沒這麼講究過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "不過你說錯一點，這回我有記得洗手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "只用水沖個一秒根本不算洗手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "你也太嚴格了吧老兄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "不說這個，不說這個，下次我一定記得行了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "真是輕浮的傢伙......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "對了，剛剛你嘗過那盤菜，感想如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "感想？你說那個炒蔬菜？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "那個叫古米的小姑娘不是誇過一遍了嗎，還要我再說一遍？也行，好吃哦，味道超棒，真不愧是你耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "你還有更敷衍一點的說辭嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "還真有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "別說出來，我怕我忍不住教訓你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "哈哈哈，說正經的，你真想聽實話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "好吧，那我直說了，你做的菜雖然好吃，但怎麼說呢，吃起來感覺很迷茫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "別說傻話，我做的菜還沒到能吃出感情的地步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "嘖，你這人真沒趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "行吧，實際上是我好幾次看到你一邊做菜一邊歎氣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "超明顯的。又是發呆又是歎氣，真難為你這種狀態下還能把菜燒得這麼好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "停，停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "算了吧，老兄，你不想說就別勉強，我一點也不在意的，真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "雖然不知道你在煩惱什麼，但我勸你萬事看開點，別和自己過不去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "你看我，過去還是那個樣子，看開了之後其實也沒什麼。反正看不開我也不能怎麼樣，還不如不想呢，羅德島的日子挺好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "哎，換個話題，我剛剛就想問了，你那邊鍋裡煮的什麼呢，聞起來真香。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......那是已經做好的燴獸肉，一會我還要撒點乾酪上去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "這是謝拉格的鄉土菜，雪境人從小都吃這個長大，我有稍微做一些改良，讓這種獸肉吃起來更細嫩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "哦！聽起來很好啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "這個也讓我嘗嘗行不？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "等等，這個不行，這個是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你在這裡，角峰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "老爺！您什麼時候來的羅德島，怎麼也不通知屬下一聲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "請稍待，我去給您泡茶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀灰",
      "text": "不必，我只是路過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "這次只是謝拉格那邊的事情臨時要找博士，所以來得很匆忙，事出突然，就沒來得及告訴角峰大哥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "行程這麼趕，老爺也太勉強自己了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "原來如此......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀灰",
      "text": "比起這個，角峰，恩希亞最近怎麼樣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "二小姐很有精神，病情已經得到了控制。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "按您吩咐的，小姐的身體狀況我和訊使都有關注，以免小姐不適應羅德島的飲食，稍後我會為二小姐單獨送一份午餐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀灰",
      "text": "那就好。順便再熱一壺鹹乳茶吧，恩希亞一向喜歡那個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "口味一直都沒變過呢，老爺和小姐都是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "是，一切聽從您的吩咐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀灰",
      "text": "嗯，那就這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀灰",
      "text": "有勞了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "這是老爺吩咐過，專門給二小姐準備的，一會我就要給她送過去。如果你還餓著的話，我可以再重新給你做點什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "是，是，那真是謝謝你。我也想吃那個什麼很嫩的肉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "那是珍貴食材，還是拜託任務會路過那邊據點的幹員帶回來的，總共也就這麼一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "而且，燴肉做起來太費時間了，你就用普通的炒獸肉將就一下吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "過分！區別待遇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "不自己動手的人沒資格抱怨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "也對！那我還是賺了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "我說，你說的老爺，就是你們的老闆吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "那位偶爾會突然露面，只和博士有話說的銀灰老爺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "沒錯。你見過老爺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "不管見沒見過，我勸你最好學會說話更尊敬點，這沒壞處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "已經很尊敬了，這不是還帶了敬稱嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "說正經的，你們老闆，我記得好像聽其他人說他有兩個妹妹？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "沒錯。怎麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "那，那個叫恩希亞的菲林女孩，就是你說的‘二小姐’吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "挺貼心的好哥哥嘛，還特地讓你來做家鄉菜，是怕妹妹吃得不習慣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "不過怎麼都是送給二小姐的東西，那大小姐呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......你到底想問什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "關於兩位小姐，這是老爺的家務事，我勸你最好不要多過問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "你這表情怪可怕的，放心，我才懶得管有錢人的家務事，我又不傻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "那你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "啊，幫我遞一下那邊的調味瓶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "這個？給，接好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "多謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "不客氣。哦，香味出來了香味出來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "好了，雖然只是普通的炒獸肉，但我有調整過配料，味道應該不差。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "那邊的籃子裡有麵包，旁邊的鍋裡應該還有米飯，你自己愛吃什麼就配什麼，我先把菜給小姐送過去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "吃之前，記得先洗手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "快走吧你，你是我老媽嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "不是。幸好我不是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "......這就走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "唉，可惜，那個燴肉聞起來真的蠻香的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "那就洗個手吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "真是怪了，我幹嘛這麼老實聽話？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "好，還用了清洗液，每隻手三十秒......三、二、一。這樣就行了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "（甩手）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "嘿，這下沒問題了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "至少把手擦乾再抓麵包吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "誰啊？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......不是什麼重要的人，只是個普通鐵匠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嗯？奇怪，角峰他不在嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "謝謝，角峰，茶給我就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嗯，好香，茶裡還放了香油？呵呵，那都是小時候的喝法了，難為你還記得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "大小姐謬讚了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "那麼，兩位慢用。在下就先失禮了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（在茶裡放香油，以前最喜歡這麼做的，應該是老爺才對。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（從維多利亞回來之後，老爺就再沒有這樣喝過鹹乳茶了，或許是忘記了吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（大小姐......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（二小姐這次又把水椒全挑出來了，哎，這個習慣倒是從小到大都沒變過。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（老爺也不管一管，再這麼挑食下去，營養會不均衡，問題很嚴重啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "這麼說來，我記得老爺從前，的確也會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（不行，打住。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "（這個問題太危險了，還是不要深究，就當做沒有過吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "喂喂喂前面的老兄——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "嗯？什麼人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "我啦！是我！一般看到東西自己在路上飄著那就也只有我了吧！你是不是裝傻啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "算了。諾，這個給你，拿好別摔了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "什麼，這個是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊桑",
      "text": "就這樣，我還有事，先走一步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "等等！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "那傢伙搞什麼，這個是......三明治？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "麵包烤的時間太長，也沒有切邊，裡面的鱗蜥肉切得太厚，這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "也別說得這麼嚴厲吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我看他做得還挺認真的，還切了甘仔片夾進去，味道應該還可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......火神小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "抱歉，您是來取盾牌的吧，我把幾塊要修理的全都放在廚房了，這就去取過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "沒關係，我和你一起去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "對了，剛才跑過去的那傢伙，在做三明治的時候說了奇怪的話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "伊桑他說了什麼讓您不愉快的話嗎？如果是這樣，我先代他向您道歉。他這個人說話比較隨意，但是沒有什麼惡意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那倒不是。你急急忙忙解釋什麼，我只是有點奇怪而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "他說‘要讓角峰大叔嘗嘗當代沒心沒肺青年人的瞎做料理當作回禮，姑且也算是蘊含心意吧’。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "哦對，他還把放在廚房的那兩盤做好的菜全端走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "什麼亂七八糟的，簡直是胡鬧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "的確是胡鬧，不過，我怎麼覺得你好像心情變好了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "沒有的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "你照照鏡子再這麼說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "咳。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......不過話說回來，伊桑他多大年紀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "為什麼連那傢伙都在喊我大叔啊？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
