{
  "server": "tw",
  "storyId": "story_12fce_set_1_story_1",
  "groupId": "story_12fce_set_1",
  "stageId": null,
  "title": "一些選擇",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_12fce_1_1.txt",
  "sourceHash": "53c10ff44e7b86a92cfd71a8d870eefa5ae2ae507e5841d1cadffc77470f7712",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "你不應該跟著我。\n在我前去的地方有永不停息的戰火。\n你只是累贅而已，沒必要自尋死路。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "薩弗拉，你怎麼還杵在那，嫌命太長嗎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "*薩卡茲粗口*，快找個掩體蹲下，炮火來了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "咳，咳咳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "喲，還活著嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "還好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "這裡的狙擊點暴露了，時間不多，現在馬上轉移！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "那麼快又再來？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "啊啊啊，該死！我的小腿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（施展法術）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "這邊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "咳咳，謝了兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "只不過是利用一下掩體，舉手之勞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "腿還好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "小問題，不知道受過多少次這樣的小傷了。包紮一下就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "不說我，兄弟你也不像很能打的樣子，竟能撐到現在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "看你用源石技藝挪動掩體來掩護的樣子，手法老道啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "你這是第幾次上戰場了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "雖然做過不少訓練，但是這還是第一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "到現在也全憑運氣，不是什麼大不了的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "你還挺謙虛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "不過說真的，再這麼僵持下去可不是個辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "上頭的人倒是輕鬆，但我們這可吃不消啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "看來這裡就我們倆了，不知道其他人如何。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我和其他人失散了......原本的突襲任務失敗了，敵人衝散了我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "前面一點動靜都沒了，看來衝到前方的隊員都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "嘖，那可真是巧，我也一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "我已經不指望他們能回來幫我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "就算是任務失敗了，我可不準備在這裡倒下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我去四周偵察下，一定有逃出包圍圈的方法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "偵察？你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "我不是看不起你，兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "但我敢保證，不管你的源石技藝能幫你製造多少掩體，只要你的白色腦袋露出來，對面的炮火馬上就能把你炸得稀爛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "還不如我們先在這裡觀望觀望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那可不行......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "三點鐘方向......有敵人來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "該死的庫蘭塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "對面的是輕裝庫蘭塔傭兵。雖然可能還有其他敵人......通常會協同作戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "等他們衝過來，就沒地方能逃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "可能還配備了術師無人機。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "你，怎麼知道得這麼清楚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "簡單的推斷，猜測，經驗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "可能有猜錯的，但是大致如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "雖然現在出去可能比較醒目，但是我們的位置躲不了多久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "知道得這麼清楚，那豈不是你也能輕鬆幹掉他們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "憑我的源石技藝可做不到，估計一出手就會被敵人解決掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "對我來說，只是逃跑就已經拼盡全力了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "哈哈哈看來雇你來上戰場的雇主也是看走了眼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "打敗仗的原因竟然是太摳門只能雇來這樣的士兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "......之前沒來得及問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "薩弗拉，你叫什麼名字？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "我的名字很多，現在叫我46A就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "哈，這個是名字嗎？聽上去像是什麼家用電器的編號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "其中一個代號而已，暫時就這樣叫我就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "聽你這麼說，看來是你自己也沒想好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "名字也許不重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "也對，看來你和我一樣，見機行事混口飯吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "我是不是聽到炮彈的聲音了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "走，46A，快走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "當了那麼久傭兵，我還是第一次看到引導炮火的無人機。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "這年頭那些無人機術師越來越難對付了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "要是早點發現，我們也不至於死那麼多人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "我在腳印上做了些偽裝，希望能多爭取點時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "你還真是什麼源石技藝都會啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "可不可以幫我治療下傷口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "抱歉，我沒學習過醫療源石技藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "沒事，我也就隨便說說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "我們的醫療兵是第二個失蹤的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "別在意，兄弟。常有的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "要是沒有你，我早就被那幫庫蘭塔捅穿了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "其他人沒逃出來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "看來是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "但這也意味著，我們安全了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "你還走得動嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "沒有問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "那就不休息了，集合點應該在前面不遠，以我們的速度，再走一個小時左右就能到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "這次啊，這次可真是站錯隊了，那幫領主開價那麼高，我還以為是穩操勝券呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "結果幾發炮彈掉下來，所有人都在往後跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "可惜了那幾個和我長期合作的兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "錢是到手了，命也交代了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "你呢，46A，你也是被他們高價騙來的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "我需要一些補給。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "哈哈別說得這麼文縐縐的。用命換錢，大家都一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "也在找人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "找人，在戰場上？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "什麼人？家人還是仇人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "恩人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "這可，太有意思了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "雖然這看上去還挺像你的脾氣，不過你想要在這樣鬼地方找恩人，怕不是被騙了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "那個人救了我，而且——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "好了好了。聽我一句勸，小心別被利用了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "我剛不好意思說，你這傢伙也夠奇怪了。現在我可要提醒你了，你覺得卡茲戴爾的哪裡能找到你那個恩人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "搞不好那個人根本沒有打算救你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "想想看你給幹過活的那些雇主、還有夥計，哪一個不是說翻臉就翻臉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲傭兵",
      "text": "也許見面以後，那人反手就——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沒想到竟會出現這樣的失誤，完全沒有注意到敵人的攻擊。\n爆炸物？法術？\n耳鳴。"
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "哈......哈......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "但是，不能死在這裡。\n就算是看不見，就算是爬，也要活下去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你總是能活下來，薩弗拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不過我沒想到，你能活到現在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你和那些殘渣不同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "你是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你能活到現在，我姑且認同你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "而我，也應當給你一個結果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "面對過去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "或是面對未來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "薩弗拉虛弱地，握住了法杖。"
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "這次，我可以跟著您嗎，巨梟？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "小夥子，該醒醒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "老先生，您怎麼在這裡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "今天別人都有事，只有你和老夫倆薩弗拉在這裡喝悶酒談天說地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "想起來點沒有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "好，好像......是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "給，冰水。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "多謝......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "再揉揉眼睛兩邊，用力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "呵，呼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "這是老夫年輕時醒酒的方法，效果怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "差不多了，多謝您，老先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "嚯，都是自己人，不用那麼客氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "這是老夫的偏方，只對薩弗拉有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "12F啊，你剛剛是夢見什麼了嗎，我看你好像身體繃得很緊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "啊，是做了個奇怪的夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "只是，想到了一些過去的事情而已。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "告訴我，你叫什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "我......我沒有名字，只有代號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "從今往後，你就跟著我好了。如我所說，會有更多的危險等著你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "能走到哪裡，就看你自己了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "現在的你，已經死在這裡了。今天是你的死期，也是你的誕辰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嗯嗯，作為禮物，就由我來給你一個新的名字好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今天是，3月3日......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那，以後你就叫12F好了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
