    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "老闆，那些傭兵和羅德島的人正在攻擊我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德魯奇",
      "text": "怕什麼，這宅邸固若金湯，就憑幾個傭兵又能怎麼樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德魯奇",
      "text": "讓術師操縱怪物幹掉那個菲林。其他人守住入口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "明白。",
      "portraitKey": null
    },
