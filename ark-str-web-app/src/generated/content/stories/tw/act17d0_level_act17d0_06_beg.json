    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "別衝動，敵人太多，這樣行動必死無疑，你需要為這座城鎮活下來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "我已經給其他人發了信號，他們很快就到。",
      "portraitKey": null
