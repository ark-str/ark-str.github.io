  "groupId": "story_ling_set_1",
  "stageId": null,
  "title": "醒時夢長",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_ling_1_1.txt",
  "sourceHash": "59fc6955705a281f3272fa5bd30cf1465dde7171f3003fa553b24b82f262ee46",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "《醒时梦长》"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "老哥，你的爛肉麵，趁熱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "燙燙燙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "這位客官，您要的歸行老酒只剩了半壇，再說這酒烈了些，這是小店新到的湖松酒，前晌剛啟窖，您看......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "向來是客挑酒，幾時有酒挑客？這尚蜀的規矩，未免與別處不同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "這......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "這新酒可能解渴？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "能。湖松酒清甜滑喉，入口綿長——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "可能醉人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "這就要看您喝多少了，是酒都能醉人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "我也不知，你見我醉了，不再上就是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "（欸，不像本地人啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "（看她的打扮和氣度，想必是哪個富貴人家遊山玩水，來尚蜀尋消遣吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "（話說，我這幾天連著做同一個夢......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "（那我昨天還夢見和小慧成親了呢！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "（趕緊吃你的爛肉麵，別耽誤上工。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "說來聽聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "呀，客官，我們瞎嘀咕，打擾您喝酒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "獨飲無聊，我請你喝酒，你把夢說與我聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "您是......解夢師嗎？我聽說大炎別的地方有專門幫人解夢的行當。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "那我權當給您解個悶吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "我這幾天，好幾次夢到附近天災頻發，人心惶惶，天師府連降多道權杖，任命我為總督造，負責尚蜀移動城市的改建。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "信使找到我的時候，我正在雕石頭——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "改建移動城市？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "是的。您一路來應該已經發現了，尚蜀的移動城市是與別處不同的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "將群山挪移至移動平台，這在其他地方無法想像，尚蜀的移動城市可謂巧奪天工。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "正因為這樣，我們的承重也超出了常規移動平台的好幾倍，機動性大打折扣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "要不是老天護佑，尚蜀人傑地靈，極少有天災，移動城市自建成起並未真的移動過，它還真不一定經得起檢驗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "有幾分道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "但那個夢！我在那個夢裡找到了解決的辦法！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "我當上總督造後，這個著急啊......突然在泡茶時得到了啟發。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "大炎江河連川，百川又歸海，這四通八達的水路本身便是移動城市天然的運行軌道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "況且，常言道“水可載舟”，水流還能與移動城市的動力系統結合，解決承重過大而機動性不足的問題。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "倒真是個壯觀的夢！我那個妹妹要是在，想必又能得一幅新畫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "哈哈哈你這個夢唯一真實的地方就只有雕石頭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "別的怎麼就不真了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "改建移動城市......你這是把自己當土木天師了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "倒也無妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "土木天師，想來最開始，也是要從這樣的夢做起的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "誰又想雕一輩子石頭呢......難道你想當一輩子夥計？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "（噓！當心點，別讓我們掌櫃的聽到。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "我覺得挺好的，客人們來來去去，五湖四海的，有趣得很。雖然起早貪黑，苦是苦了點，但逢年過節，掌櫃的也不曾虧待了我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "存一存，等過個一年半載，我說不定就能把小慧娶回家了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "那你可得抓點緊。小慧雖然家境一般，但長得好看，我可聽說已經有人向她提了親......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "錘子——哪個不開眼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "哈哈哈哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "不過說不定你真的能當上土木天師呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "你這夢要成了真，那就不是蜀道難，而是蜀道通了。到時我們山城的石雕和茶葉能賣到大炎的任何地方。不，不光是大炎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "說了半天，忘了問解夢師我這個夢到底怎麼回事了。連著做，總覺得不太尋常......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "我並未說自己會解夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "我也只是常做夢而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你要想聽，我也可以......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "那還是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒館夥計",
      "text": "哎呀，已經過了你平時上工的時辰了，趕緊把帳結了回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "呀！今天來得急，身上沒帶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "一併算在我的酒資裡，也不能白聽你一個夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "這怎麼好意思......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "多打聽一個事，這尚蜀三山十八峰，哪一處最幽僻，最稱得上“蜀道難”的說法？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石匠",
      "text": "您是要？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "酒喝夠了，想尋個安靜地方睡上一覺，興許也能做個如你這般有趣的夢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "書生夢馬簪金花，女娥夢橋生紅藥，世人所謂“夢”者，發乎事，起乎情。那個石匠的夢，也是此理。\n夢是好夢，但以為它關乎吉凶，隨隨便便做了，卻不敢隨隨便便解。\n夢終究只是夢，過往將來，終是由己。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你們怎麼在此？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "嘎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "是夕讓你們這些小傢伙來迎我，還是我已然入了她的畫中......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "嘎嘎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "抑或......我只是有了醉意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "剛剛說到哪兒了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "你說你羡慕我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你們這些小傢伙居然會說話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "好吧，湖松酒都有這般後勁，下次該試試歸行老酒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "墨兄，想來這天地間，和我殊途同歸的，也就只有你了。但你終歸要比我自在得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "這是哪兒的話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "器皿本是死物，無心無念，只不過意外受到令的點染，化成了倀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "缺柄少蓋的茶壺，生出來的倀同樣缺胳膊斷腿。薄薄青瓷的倀，同樣耐不住幾下摔打......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "倀的形與意，都局限在器皿本身了。本體怎樣，我們便只能怎樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "我們也同樣只存在於夕的畫卷之中，未必就算得上“活物”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "夕的畫卷，已然是另一方天地了......你們雖然是隨筆塗鴉而成，但和那畫中的無限風光一樣，都是夕的“念想”啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "“念想”是最無拘束的。有形的時候，一葉扁舟，千江疊浪，枯樹生花，華髮再青，天地顛倒，萬象迷離。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你從哪兒知道的這些詞......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "無形的時候，滴墨不染，擱筆留白，都自有意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "夕的念想不停，畫卷不收，你們便永遠自由自在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "聽得出來你著實羡慕啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "嘎嘎，器兄，我反倒覺得你才值得羡慕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "自由自在，未見得就是好啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "我問你，這裡好幾隻墨魎，你能分得清哪隻是夕喜悅時所塗，哪隻是夕傷懷時所塗嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "......你們都長得差不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "對啊，我們甚至不知道，夕在塗抹我們時，是何種心情，或者她就是......無情無感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "可拿你來說吧，你通體古褐色，但肚腹黢黑，那是沖茶煮茶十多年留下的茶漬。你還沒靠近，我就彷彿聞到了茶香。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "詩畫之倀附庸風雅，兵戈之倀嗜好殺伐，水火不侵的倀，我們便知它的本體必然經受過長久的火煉窯燒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "你們生來便有根可循，是限制，可未嘗不是歸宿，這正是你們的意義啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "見器倀便能見器物本身，更能見使器物的人。甚至器倀雖死，器物本身卻還在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "而墨魎呢，只是無根的風，吹過來晃過去。夕不喜不安時，便能把畫都撕了，更何況那畫上的幾抹塗鴉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "器兄，這樣無根的自由，你還羡慕嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "我依然覺得......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "這樣吧，我們誰也辯不過誰，正好令在這，請她做個評斷吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "令不要偏袒就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你們總算想起我了......爭得口渴了吧？我這邊還剩幾罈子湖松酒，正好解渴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "（咕咚咕咚）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "（咕咚咕咚）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "欸你別吐啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "咽不下去咽不下去，喉嚨燒得慌，我滴個天爺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "夕是不飲酒的，她怕睡著了做夢......那小墨魎你也應該喝不了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "（咕咚咕咚）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "沒有呀，我覺得挺好喝的，清甜滑喉，入口綿長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "暈乎乎的，像是夕翻轉了畫......難怪都說炎國人喜歡這玩意兒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "哈哈哈，確實是個好東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "我甚愛酒，南方的桃梅晚釀喝過，北方的烈刀子也喝過，可受我點染的器倀，卻連一口酒都咽不下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "滴酒不沾的夕，她所畫的墨魎偏偏覺得此味甚妙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你們可有所思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀&墨魎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你們確實是我和夕的造物，得了幾分形意。但幾分的我，便已然不是我了，二者終究是有區別的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "器倀非器，墨魎非墨。你們，難道不都是自己嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀&墨魎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "再者，到底何謂“自由”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你們覺得我和夕是否自由？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "令自然是自由的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "是嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀",
      "text": "難道不是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "我也不知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "真自在者，不知何為自在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你們越是苦苦糾結，越是不得其解。本就是自在之物，又何苦自尋煩惱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器倀&墨魎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "還是不解？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "呀，既然不解，索性都散了吧，別擋了路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "浪費了我幾口酒......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "常言道“蜀道難”，果然不虛。盤旋回折，聳峭入雲，山路轉彎，竟又是一段山路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "也罷，想來到山巔時，正好一場好眠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "看來又是一場詩會。\n白瓷的杯子順水而下，杯中酒與泉流渾然一色。酒杯停在誰處，即須成詩三句。筆力不逮者，銜杯作揖，是謂“流觴”。\n酒是桃梅晚釀，採早開的桃蕊，與存好的晚梅一併搗碎入酒，清冽甘甜，入口生津。\n那酒的滋味，妙絕。\n採菱的少女把滿滿一兜菱角倒進船艙，卻不留神將船槳踢飛了出去，脆生生的呼叫聲傳出去數里遠。\n春夏之交的雨下了半月還未停，在石板路上砸起的霧氣渺若輕煙，相鄰的人家隔著雨幕抱怨說廳堂幾時能乾燥些。\n好茶者鬥茶，好酒者鬥酒，好釣者鬥釣，富者鬥金玉，貧者鬥鳴蟲......\n哦對了，還有燈會，那可比流觴熱鬧得多了，造型各異的花燈從街的這頭燃到那頭，逢著佳節更是徹夜不滅。\n移一步可得一句，看一景可得一詩，所以那些年的詩會，我從未輸過。\n一江煙水一芰荷，酒招深處浣清波。\n倒臥西山翠，千年醒回舟。\n世情旖旎，酣醉酩酊，何妨衰病減心情。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "盡興嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "盡興。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "盡興是盡興，可就是太容易盡興了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "厭倦一樣事，便對百樣事都覺得新鮮。只是這新鮮到頭，終究還是厭倦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "令，這裡不是你的歸宿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何不聽我的，走得遠些去看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你所謂“春風不至”的地方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "又有什麼不同？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "去了便知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "那裡便是我的歸宿了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我也不知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "流觴詩會少一個令不少，多一個令不多。可我讓你去的地方，需要你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "或許你在那裡，才能寫出，新的詩來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "那座移動城市。\n那座橫在大漠前的移動城市。\n即使數百年過去，我依然記得初見它時的震撼。此刻，我竟然又站在了它的城樓上。\n大漠綿延千里，風沙蒸騰起熱浪，雲煙浩渺，我能感受到皮膚在急速失去水分。\n為了控制水源，它在建造時並未考慮佔據險要地勢，依山脈以為屏障，而是臨近草甸和湖泊。\n如此一來，乾燥的風掃過無遮無擋的大漠，直撲在城牆上。它像個孤獨的巨人，巍巍然矗立在天地間，身無可依。\n旌旗漫捲，長河落日。\n城關外，戰士們正將昨日死難兄弟的屍體搬運出來，一排排放好，我挨個走過，將他們的眼睛闔上。\n昨日的連場血戰猶在耳畔。遮天蔽日的箭，晴空似夜，殺聲如裂帛，經久不絕。\n火炬在他們身下點燃，無人哀哭，因為新的戰鬥將近。煙塵滾滾，但迅速被風吹進茫茫大漠。\n......\n詩酒已然幫我忘卻了許多我曾厭倦的東西，可在此般景象面前，我反應過來時，卻已重新握緊了武器。\n因為身邊的每一個將士，都握緊了武器。\n不能讓那些傢伙，靠近身後的大炎。那是他們的家鄉，那裡有他們的親人。\n橫在這茫茫大漠前的，不是這座巨人般的移動城市，而是這城裡的將士。\n孤城聽征鼓，年歲莫問，但憑豪氣多。\n誰言將軍有死志，故壘新柳年年生。"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "他說的沒錯......我是應該來此的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你竟然也來了，看來真是夢了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "（無言的轟鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "別吼了，我方才喝了幾罈子湖松酒，頭暈著哩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "（無言的轟鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "逃避？非也。我既不是年，也不是夕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "（無言的轟鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "好好好，那我且問你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你覬覦這天地，又可知這偌大天地間，到底有什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "（無言的轟鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你可知蒙壟的新茶，該是在三月採，還是四月採？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你可知大漠長夜苦寒時，常唱什麼歌，常飲什麼酒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你又可知......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "你對這天地，一無所知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "當然，你即是我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "枉我們自詡活了這千百年，卻依然有太多不知不聞的事，不解不曉的情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "（無言的轟鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "也曾像山腳酒館裡的那個石匠，連做夢也有憂戚，或者如我那妹妹一樣，連夢都不敢做了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "也曾像器倀和墨魎，覺得受限於自己，又受限於天地，總不自由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "我們這些活了千百年的造物，傲視幾十年壽命的芸芸眾生，笑他們活得愚昧。歸根結底，還是我們更蠢一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "從南而北，再到這蜀道山巔，於我而言，只不過是一場酣夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "其實，從太古以來，經過的時間，行過的地方，千年萬年，無非是更大的一場夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "這一場大夢做罷，我終於知我是誰——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“歲相”",
      "text": "（無言的轟鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "罷了，說了你也不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "既不懂，還不走？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "既是我的夢，怎麼解由我，醉也由我，醒也由我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "我既醒來，你又焉在？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "醒來。\n酒也空了。\n好一場夢啊。\n我看見了什麼？\n落日燒透半天的雲，三山十八峰，漫漫蜀道，觸手即是煙霞。這景色，不曾入畫，也不曾入詩。\n我看見了什麼？\n流觴詩會，瓷杯停在了一人又一人面前。漠上長亭，孤煙裡，千百人擊鼓遠征。\n既見縱情逍遙的我，也見求全求解、不求甚解的我。夢只是夢，我之為我，都快意。\n明明是在這攥江峰頂，無名空地，卻彷彿看見了整個大炎。不，是整個太古以來，縱橫四方，都如風掠過身側。\n見山卻問石，臨淵而忘水，原是如此。此地不如就叫“忘水坪”吧。\n......\n彷彿......還看見了年和夕。呵，既然夢中未見，想必夢外，很快也將再見的。"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "呼......日盡水長去......雪落月空留。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
