{
  "server": "tw",
  "storyId": "main_4_level_main_04-03_beg",
  "groupId": "main_4",
  "stageId": "main_04-03",
  "title": "人工製冷",
  "storyCode": "4-3",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-03_beg.txt",
  "sourceHash": "ac276ff7db11c2ee0970f76b9c42002fd04b63a1d5f613da59974b798e7f09b7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "好的，保持聯絡。嗅到氣味就立刻告訴我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "按第三個鍵就行。嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "——嗯？Dr.{@nickname}？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "阿米婭呢？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭前往貧民區了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "——你居然讓她一個人去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......也罷，至少有人保護她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你跟著去了，有很大機率是個拖油瓶。這次就不怪罪你了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你也是一個人回來的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "哦，企鵝物流。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你也要更加關注自己的人身安全。我們不是每次都能雇傭到可靠的本地嚮導的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Dr.{@nickname}——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "阿米婭不會在龍門逗留太長時間，畢竟之後還有任務。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你還會再一次面對她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "——如果是我的話，會把當時沒說出來的話，說出來。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊，博士？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "一直在等我嗎......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "對不起，讓你久等了",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯？我的表情與離開時不太一樣？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": ".....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "發生了些事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我覺得......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "也許陳長官，她也有著自己的想法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "即使她嘴巴很凶，即使她做了我難以接受的事情......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但也許......我們之間的隔閡也沒有那麼大。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "她有她的責任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......啊......原來是這樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "她也承擔了很多吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "也許我也......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭，你也承擔了許多事情。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是嗎......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我......只是沒有其他的選擇而已。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "至少阿米婭你堅持了自己的選擇。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......如果導致那樣的結果，也算是堅持的話。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士沒必要......這樣安慰我的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "其實，我明白的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不知道......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不知道，我們走到哪一天，這片大地才會變得不同......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但，我明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不會放棄。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我會承擔任何後果，因為......這是我自己選的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你會......陪在我身邊嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "儘管......這種愧疚，會一直存在......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "沒能抓住大家的遺憾，沒能救助朋友的遺憾......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但我必須坦然面對。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "和羅德島的大家一起——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯？是凱爾希醫生的通訊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "凱爾希醫生？請問有什麼事？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "阿米婭，有幾支偵查小隊發來了消息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "情況變得有些刻不容緩。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "好的，我馬上就來。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
