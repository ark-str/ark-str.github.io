    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "告訴我吧，瑪嘉烈·臨光，耀騎士。每一位心懷信念的騎士都會對你感到好奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
