  "stageId": "main_06-13",
  "title": "不錯的回憶",
  "storyCode": "6-15",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_06-13_end.txt",
