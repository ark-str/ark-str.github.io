        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "羅德島其實......能夠理解你和你的小隊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "也許你會反駁，會認為我根本不理解你們......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但霜星小姐，他們經歷過什麼，我清清楚楚。",
