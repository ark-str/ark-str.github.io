{
  "server": "tw",
  "storyId": "act29side_level_act29side_04_beg",
  "groupId": "act29side",
  "stageId": "act29side_04",
  "title": "狂想曲“望想”",
  "storyCode": "ZT-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act29side/level_act29side_04_beg.txt",
  "sourceHash": "976024e856f2e74fb541d1190aaf527aa1d71decf671f29ada04a45286fe50cb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "不好意思，阿爾圖羅老師，我又出錯了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "為什麼要停下來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "我上一行最後一個小節的演繹不夠好……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你的情緒是對的。不要被旋律束縛，而要用意志來引導旋律。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "我忍不住去想自己犯錯的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "那就不要忍耐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "音樂是你的心聲，是你表達自我的語言。在學會發聲之前，先被語法束縛，語言就失去意義了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你的羞愧，自我懷疑，對未來的渴望……都是真實的。讓它們活在你的琴聲裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "可是，法術課的老師不是這麼說的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "他說源石技藝是一門嚴謹的學科，本質是在混沌中發掘秩序，就像將一堆無關的音符構建成美妙的和弦一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "而我的雜念太多，琴聲亂糟糟的，所以法術能量也控制不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "除了你之外，我還教過一個學生。他以前和你一樣，拘謹，害羞，不會表達感情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "後、後來呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "後來他成了一個非常勇敢的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "我很遺憾，他並未如我所期望的那樣，擁有更長久美好的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "但我有幸聽過他最後的演奏。他發出的吶喊……並不比那位與他同姓的大音樂家遜色多少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "您的那個學生是哪位大音樂家的後人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "赫爾昏佐倫。 聽過他的曲子嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "您說……誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你們通常稱他為巫王。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "那位陛、陛下？咳咳，我幾乎沒有聽過別人直呼他的名號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "是嗎？可對我而言，他首先是一名音樂家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "呃，他們都說，那位陛下後期不再使用一般樂器來演奏了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "那音樂……不，那聲音甚至已經不像音樂，每個聽到的人都會感到恐懼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "嗯。他的旋律與和諧毫無關係，每一小節都超越了人們在聽到上一節時的預期。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "可我從未感受過如此頑強的……意志。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "您在校園裡可千萬別這麼說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的學徒",
      "text": "據說女皇之聲和憲兵們始終關注著路德維格大學，要是讓他們聽到的話，您可能會有麻煩。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "回宿舍去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "繼續練習這首曲子。無論外面有什麼響動，都請專注在你自己的旋律之上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雕塑發出的奇怪聲音",
      "text": "阿爾圖羅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "是你啊。既然你親自開口，那演出該開始了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雕塑發出的奇怪聲音",
      "text": "差不多了。該來的人都已陸續到場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雕塑發出的奇怪聲音",
      "text": "和過去一樣，你會為我演奏今天發生的一切，對嗎？當旋律響起的時候，我想在這裡聽著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你要從頭聽到尾嗎？這首曲子大概很長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雕塑發出的奇怪聲音",
      "text": "今天會有很多人受傷，甚至死亡。這些犧牲因我而起，我不能容許自己轉過頭去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "明明這麼痛苦，卻比任何人都要堅定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你呀……當我的演奏抵達你生命的終點時，我會看到什麼呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "路德維格大學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我在很多書上見過這個名字。近一點的……是最前線的源石技藝理論刊物。而最早的那些，還是鐫刻隱秘術式的法術卷軸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "它的校徽在萊塔尼亞的法術史上熠熠生輝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "不過是烏提卡家族徽章的變體罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "但它依舊是萊塔尼亞的第一所大學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我曾經幻想過，在這樣的校園裡生活，是什麼感受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "漫步在紅葉覆蓋的校園中，身邊都是同齡的朋友，圖書館裡有看不完的書卷……這樣的每一天，大概都很充實吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "持有女皇的特許，你可以隨意出入任意一所萊塔尼亞的學校。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "嗯……您注意到往來學生們的眼神了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "對求知的渴望，能夠暫時讓他們遺忘彼此間出身的鴻溝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "而在路德維格選帝侯將自己的高塔確立為“大學”之前，知識被權力封鎖於高塔之中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我怎麼忍心……再度用權力來污染這份難得的純粹？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "……憲兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "所謂的純粹在現實中並不存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "是您把他們叫來的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "沒必要。高塔上的眼睛從未離開過萊塔尼亞的土地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "尤其是這裡。你面前的是烏提卡領最古老的高塔。巫王曾在塔內待過十數年，即位後也常常回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "這個貌似平和的校園裡，處處都與巫王脫不了關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "包括我們要去找的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "格哈德·霍夫曼先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "不，我們先去找他的老師。他是最熟悉路德維格大學的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "從巫王的時代……不，從更久遠的過去到現在，他一直待在這所學校最古老的高塔裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "……學校裡怎麼會有這麼多憲兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你先前聲稱我是通緝犯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "就為了抓你？怎麼可能……而且我們一路上夠小心了，不可能讓憲兵盯上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "快找個地方藏起來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "五隊六隊去前面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "四隊好好把這座塔搜一遍。不要錯過任何可疑人士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "不，停下，你們不能這樣到處跑來跑去，隨便地使用源石技藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "這裡是大學，我們所做的很多研究都需要一個穩定的環境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "任何輕微的變化，都有可能會對那些精密的法術儀器，還有複雜的術式，造成不可逆的破壞。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "抓起來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "為什麼？我沒有違反任何法律！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "你的名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "路易，路易·施尼茨勒——你還沒有回答我的問題！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "福特岡的施尼茨勒？帶去教室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "我不明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "繼續查。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "平民帶去院子裡，貴族關在教室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "只要與烏提卡家族有過牽扯，就全控制起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "我只是姓施尼茨勒！我的父親甚至沒有繼承爵位，你們憑什麼因為幾十年前的舊事——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "我們查的就是舊事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "施尼茨勒少爺，您只要好好待著，不做什麼多餘的事，自然不會有什麼危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "我們一家馬上就會參加慶典，我要覲見女皇陛下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "路德維格大學是萊塔尼亞最古老的大學，就連二十三年前，女皇的軍隊都沒有傷害過這裡高塔的一磚一瓦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的學徒",
      "text": "你們憑什麼如此侮辱知識與藝術，踐踏萊塔尼亞的傳統？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "憑女皇的命令，年輕人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "殺死我們憲兵隊長官的兇手就藏在這所學校裡面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "如果你想保住這所學校的話，去轉告你的同學們，但凡有關於奇怪的薩科塔和巫王殘黨的線索，都主動交代。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "……女皇的命令？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "怎麼會？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你很驚訝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "驚訝？不，我真是個傻瓜。我竟然沒想到，以她的性格與手腕，怎麼可能置身事外？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "我不能再繼續追著阿爾圖羅走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我以為阿爾圖羅也是你的任務目標。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "阿爾圖羅是任務的一環。我的……委託人想搞清楚她行為的目的，以免她干擾我們的計劃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "但眼下更大的危機出現了。我不能讓計劃本身出問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "你……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我沒有其他疑問。你是萊塔尼亞人，應當也沒有什麼需要我執行的遺囑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "算了，難道我還指望從你嘴裡聽到什麼像樣的臨別寄語？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "執行者先生，阿爾圖羅牽涉的案件嚴重性遠超你的想像。即便是你們的教宗，也沒有插手的資格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米夏",
      "text": "就當是個建議吧，趁憲兵還沒找過來，放棄你的任務，離開崔林特爾梅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "評估完畢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "該任務並沒有放棄的選項。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "我們到了。德羅斯特，你最好在外面等著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "嗯？我沒有感受到危險……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "別動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "別動……什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你擋到我的煙斗了，對，就你左邊正在噴著氣的那個。你再動一下，我不能保證煙圈飄過之後，你的左手還在原來的位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您把煙斗做成了法杖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "法杖？別犯蠢了，抽煙就是為了休息，誰會在抽煙的時候想正經事啊！我只是想做個實驗，看看這煙圈能不能從這裡飄到雙子羊的塔頂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……我們是來談正事的，弗萊蒙特閣下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "真是煞風景啊，賴納。你就沒有旁邊那漂亮小鹿乖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我也想看看煙圈能不能飄幾十公里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "不，距離不是關鍵。關鍵是……不要有一具金光閃閃的盔甲在旁邊晃我的眼睛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "好了，沒心情了。說吧，叫你來找我的是陰沉羊還是浮誇羊？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "你是說，金律樂章的副本不見了。而且，還是放到風暴城去的那一本。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "你們都是光吃飯不長能耐的嗎？！還金律法衛呢，連樂章都看不住，這身衣服除了可以掛到高塔頂部當裝飾之外還有什麼用處？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "赫琳瑪特也真是的，說什麼遠離漩渦中心才更安全，我看她也是跟你們待久了沾上了傻氣！總不會真的是角越大腦子越笨吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "還有那個風暴城的小子也是！說什麼會用自己的命來踐行諾言……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……沃爾納選帝侯已經去世了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "在您面前的，就是他的女兒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "抱歉——如果你需要這個的話。但這並不改變這整件事真的蠢到家了的事實，尤其是赫琳瑪特還沒有第一時間告訴我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "那本失竊的樂章特殊至此嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "二十三年前，沃爾納選帝侯從崔林特爾梅回到施彤領，身上就帶著這本樂章。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "除了女皇與選帝侯本人，沒人能靠近它。我想，就和許多巫王時代流傳的法術裝置一樣，它上面留有巫王的術式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "巫王的術式……巫王的術式！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "路德維格大學的門口也有那傢伙的術式，能讓街邊的盔甲蹦起來跳個霹靂舞——但這有意義嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "赫琳瑪特難道沒說過？那不是什麼隨隨便便的術式，是赫爾昏佐倫這一生為了戰勝最強大的敵人研發出來的法器！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "巫王戰勝過的最強敵人……莫非是高盧的科西嘉一世？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "一位君主，一支軍隊而已，世俗意義的強大對全盛時期的赫爾昏佐倫來說算得了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "他當年戰勝的，是整個萊塔尼亞的意志。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……金律樂章。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "還不算太笨。自萊塔尼亞帝國誕生以來，金律樂章有且僅有一次變動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "赫爾昏佐倫以一人之力，向萊塔尼亞歷代先賢，所有為了構建金律樂章而注入過力量的源石技藝大師發起了挑戰。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "感覺怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "我的腦袋……哈……沒那麼痛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "普通的療癒術對你起不了太大作用，因為造成疼痛的不是傷口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "我知道。有個邪惡老頭在對我發脾氣而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "你……真的能聽到他說話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "偶爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "你一定很痛苦。巫王的聲音就和他的旋律一樣，都具有常人難以承受的力量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "當他想要殺死一個人的時候，一聲輕哼就足以做到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "您見過他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "我的老師，弗萊蒙特閣下，曾是巫王最重視的密友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "當那位陛下坐在巫王塔至高處時，曾有數千名術師匍匐於王座前的台階上。而我……也曾是那些術師中的一員。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "您也是……\n呃！"
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "又頭疼了嗎？別怕，後來我背叛了他。我加入了反抗的隊伍，在赫琳瑪特和伊維格娜德的帶領下殺進了巫王塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "那一天，我曾經跪過的台階……變得比路德維格大學里的紅葉還要鮮豔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "那場戰鬥一定很艱難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "和我並肩作戰的友人……十不存一。 他們都曾是這個國家最有才能的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "如果他們能和我一樣，幸運地活到現在，也一定能成為更優秀的學者、更偉大的術師。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "難怪您那天會去密林公園。我該向您和犧牲者們致敬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "別花太大力氣……並不值得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "覺得難受的話，可以再多靠著我一點。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萊辛",
      "text": "放開他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "萊辛……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "我就知道你會跟上來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "弗萊蒙特老師呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊辛",
      "text": "他對您很失望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "我很抱歉。萊辛，我不想傷害你，也不想和老師為敵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊辛",
      "text": "那為什麼要阻止我們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "始源之角不該就這樣降臨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊辛",
      "text": "我們並不是在追隨著邪惡的事業，而是要收回本就屬於我們的東西，同時摧毀那些不利的。您本該清楚這些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "巫王留下的遺產……該屬於誰？誰來確定？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "萊辛，你很聰明，也很正直。你該再想想這些問題，以免在二三十年後感到後悔。我把你當最喜歡的學生，才不想看你重蹈覆轍。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萊辛",
      "text": "我也曾……視您為師長。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "我還記得，弗萊蒙特老師把這把劍交給你的時候，你還沒有劍的一半高呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "一晃眼，你都快長到我攻入巫王塔時的年紀了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "待在學校裡，時間總是過得格外地快……不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊辛",
      "text": "我只擔心時間過去得還不夠久，我還不夠強，不配為我要保護的人揮劍。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "巫王殘黨，你的目標是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "而我唯一要對你說的就是——滾開。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "馬上就要下課了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "過來，走這邊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的學徒",
      "text": "梅耶爾，你站在這裡幹什麼？今天沒什麼要旁聽的課程嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的學徒",
      "text": "咳，你怎麼在教學樓裡拿著劍？你還真是沉迷鍛鍊啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊辛",
      "text": "……他是故意選的這條路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的學徒",
      "text": "你都聽說了嗎？今天有一大幫憲兵進了學校。他們逢人就查，特別是你這種出身於烏提卡領的平民——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的學徒",
      "text": "等等，你怎麼跑這麼快？還翻樓梯，這可是被學校管理員禁止的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "你還好嗎？何必為了我消耗自己。我比你年長這麼多，該是我保護你才對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "哈……哈，他本就是衝著我來的，我不想再看到任何人替我流血了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "以萊辛的能力與心性，他很快就會追上來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "我們得換一條更安全的路走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "我們在學校裡面？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "路德維格大學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "你是烏提卡家族的血脈，假如你出生的時候，巫王還沒有倒下的話，你也會在這裡學習源石技藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "……我寧可自己不是他的血脈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "烏提卡家族出過不止一位萊塔尼亞的君主。除了赫爾昏佐倫和其他幾位皇帝之外……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "路德維格，那位人稱“學士”的恩瓦德大區選帝侯，他也差點就成了萊塔尼亞的皇帝。他同樣是你的先祖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "讓所有人“掌握極上的知識”，令大地對萊塔尼亞“再也無可掣肘”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "當他一意孤行，將本屬於家族的高塔向所有恩瓦德的子民敞開的時候，許多人也將他視作瘋子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "瘋子……呵呵，用來形容一位烏提卡家族的人，還真是常見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "瘋狂與偉大並存，這向來是烏提卡家族的傳統。即便是巫王，他在陷入瘋狂之前，也曾是一位天賦卓絕的明君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "一個瘋了的暴君，比瘋了的普通人可怕得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "要是烏提卡的傳統注定將我引向瘋狂，那在此之前，我一定會找一個沒有人的角落，想個辦法把血放乾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "從第一眼見到你開始，我就看見了你骨子裡的勇敢。但你的生命很寶貴，在你面前的，從來不止自毀這一條路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "弗朗茨……我能叫你弗朗茨嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "您知道我拋棄的本名？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格哈德",
      "text": "以後你不必再孤身一人。請讓我幫助你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "……格哈德·霍夫曼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "在我的學生中，他最清楚金律樂章是什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "他在這裡就好了，我就用不著多費口舌去講這些了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您怎麼知道我們的來意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "來意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "巫王殘黨殺死了我父親，還有另外兩位參與過二十三年前那場政變的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我們懷疑，他們下一個目標是霍夫曼先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "呵，你們來得可真夠湊巧，就在十五分鐘前……等等，你們說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "格哈德和巫王殘黨扯上了關係？那群拿赫爾昏佐倫的曾孫子做實驗，就為了爆破一個犄角旮旯音樂廳的“殘黨”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……我想是的。他們未必真的是同一撥人，但確實在以相近的名目行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "不過，您為何會對維謝海姆事件的細節這麼清楚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "這能量波動……是用來維持空間結構穩定的術式留下的痕跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "和恩瓦德的術師軍隊使用的術式是同源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "別拿給小孩子啟蒙用的玩意兒跟我的術式比。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "別說如今的恩瓦德，就算是赫爾昏佐倫還在的時候，他調教手下人用的空間術式，也是我教的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "德羅斯特，後退。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弗萊蒙特",
      "text": "你摸劍幹嘛？離我的儀器遠一點，還有我這塔也幾百年沒修過了，經不起磕碰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……弗萊蒙特閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "您剛剛在這裡做的實驗，是否與“塵世之音”有關？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
