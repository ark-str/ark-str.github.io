  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 6上"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "這裡是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "唔——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（頭好暈......！視野......聽力......還算正常。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（腳踝......失去知覺了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（......好安靜，其他人都離開了嗎？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "（真的好安靜......等等，敵人就這麼把我放在這兒了？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......你醒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "咿呀——！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......別這麼緊張。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "啊、抱歉！突然被嚇了一跳——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "欸？您、您是？我記得，您也是羅德島的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "幹員，灰喉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "小聲點，這附近的叛亂者都被解決掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "解決......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......即使到了這個時候，你還是不希望把他們視作敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "放心吧，基本都性命無憂，已經交給塞弗林·霍索恩長官了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "......謝謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "啊——亞葉小姐她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "她沒事，其他幹員去幫她了，只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "安托她真的......犧牲了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "......嗯，很抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "所以亞葉才會是那副模樣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "只靠幾名幹員不可能收復這片街區，我們應該先撤回城鎮中心，重整旗鼓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "嗯，你能走嗎？你的腳踝受傷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "啊......我試試看，疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "來，手給我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "謝謝......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "——還有一個問題，塔佳娜小姐。我陪著安托抵達這裡的時候，沃倫姆德還是一片繁榮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "但為什麼現在，沃倫姆德連一個正規憲兵都沒有？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "放下武器，看看你自己，連套像樣的裝備都沒有，就這樣也打算戰鬥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "你們這些外來者，到底懂什麼！幫那些貴族爪牙，你們到底有什麼好處！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......沒有好處，我也對你們的政治不感興趣，但是......你是冬靈人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "冬靈人——？哈，我才不是那種土著，但我的確認可他們的抗爭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "看看你們呢？安托醫生是個好傢伙，但你們呢？你們只是在幫他們落井下石！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "沃倫姆德——不，整個萊塔尼亞都是腐朽的！他們今天敢放火害死感染者，明天就會放火燒死所有的窮人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "證據呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "——沃倫姆德一個憲兵都沒有！一個！都沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "你知道為什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "沃倫姆德和周遭的多個城鎮組成了聚落，天災來臨，憲兵數量並不足以照顧到所有的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "我呸！要真是這麼正常的理由，誰會不滿！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "——別想拖延時間，說，還是不說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "——哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "因為一場婚禮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......婚禮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "因為某個身居高塔之上的大貴族迎娶了另一位貴族的獨女，所有的憲兵都被調往了最近的移動城邦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "貴族的酒池肉林持續了多久？你猜猜看？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "哦，對了，貴族們還爭吵著哪一方才該開動移動城市去另一方的領土做客，爭執了一個月之久——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "我們的憲兵隊就那麼被扣押在貴族的宅邸周圍，為了排面和名義上的安保，滑稽嗎？可笑嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "——一點都不可笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "的確一點都不可笑，但我依舊沒有聽見關於火災的線索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "哼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "......你覺得，誰會放火燒掉一座醫治感染者的醫療營地？感染者自己嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "只有那些見不得感染者的人才會做這種事，你應該信任的人是我們——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叛亂的鎮民",
      "text": "——信任“整合運動”！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "長官！叛徒們不願意投降——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "他們的人並不多......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "但這場災難真正可怕的地方在於，雙方都不是戰士，都只是普通的市民。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "我們該竭力避免最壞的情況發生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "灰喉前輩！塔佳娜小姐！你們回來了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......而我們要讓這一切的罪魁禍首付出代價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "塔佳娜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "伯父......抱歉，我疏忽了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......不，你沒事就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "幹員亞葉......你也平安無事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "灰喉......對，是你陪著安托抵達沃倫姆德的，我有印象......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你知道發生什麼了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......大致瞭解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你覺得......如果你在她的身邊，能避免這場悲劇嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "亞葉，你不該——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "不能。沃倫姆德所展露出的多樣性矛盾有外力無法解決的困難，我們無能為力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......但至少，我該陪著她竭盡全力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "抱歉，我沒陪在她身邊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "不......唉，只是為了讓自己好受點還要為難你的，我到底在做什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "該道歉的人是我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......各位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "先容我道一句謝，感謝羅德島救下了塔佳娜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......羅德島，是救助感染者為己任的組織。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "塞弗林·霍索恩，因為萊塔尼亞一直以來的舉措的確讓人鬆懈，但我依舊要問，要在我們正式開始行動之前質詢你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你是否能代表沃倫姆德，保證沃倫姆德沒有在特殊情況下，對感染者採取了“額外措施”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......鈴蘭小姐和你的調查應該可以佐證這一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "沃倫姆德絕無針對感染者的意思，也絕不會因此對救助感染者的安托醫生懷恨在心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "你能滿意嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "亞葉姐姐，我相信塞弗林長官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "欸......那個......還不能說！但是我相信他！他不是會針對感染者的人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "麗薩......那麼，我暫且相信你的態度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "感謝理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "以及，我想聽聽各位的意見，下一步該怎麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......我對現場的情況瞭解並不如亞葉幹員，作戰任務時，我聽從亞葉幹員的指示。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "他們，人並不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "算上已經成功制伏的這些人，他們可能不過百來號人罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "對於平常的沃倫姆德而言，百來個暴徒不足為懼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "關於憲兵的事情，我聽說了一些有趣的傳聞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——那也是我從軍生涯中為數不多的荒誕決定，改變不了的事情能暫時擱置嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "容我打斷一下，告訴我們傳聞的那個俘虜，自稱“整合運動”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......我們曾經接觸過某個單獨的整合運動成員，他和這些因為各種原因義憤填膺的市民，完全沒有可比性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "他是個久經沙場的戰士，如果他那樣的傢伙有一支小隊，會很棘手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "那些武裝分子......這可不算什麼好消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "切爾諾伯格的事......烏薩斯的事......啊，又是烏薩斯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "我怎麼會信他們一個字！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "那場火災是一切的導火線，但到目前為止，衝突的可能性太多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "到底是這些問題導致了那場火災，還是那場火災暴露了這些問題，僅此而已？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "我們......我們只能開戰了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......這將是敲定沃倫姆德命運的選擇。幾千條人命不能這麼草率地決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "我們應當先回到議事廳做出正式決議。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "欸......但是對方好像不太願意給我們這個機會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......如果他們真的是“整合運動”，我們不需要手下留情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......明白。但是亞葉幹員，你應當留在這裡治療傷患。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "我要親自——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "麗薩，鈴蘭幹員並不是正式的醫療幹員，只有你是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "你應當優先保護無辜的民眾，而不是優先擊潰敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "亞葉姐姐......你應該留在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "如果亞葉姐姐總是氣勢洶洶地戰鬥下去......就會變得不像是亞葉姐姐了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......那就......好吧，我......我留下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
