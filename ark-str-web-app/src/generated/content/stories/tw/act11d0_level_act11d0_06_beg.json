  "groupId": "act11d0",
  "stageId": "act11d0_06",
  "title": "怒意漫延",
  "storyCode": "TW-6",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act11d0/level_act11d0_06_beg.txt",
