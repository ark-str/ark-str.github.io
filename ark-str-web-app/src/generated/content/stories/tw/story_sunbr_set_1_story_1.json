{
  "server": "tw",
  "storyId": "story_sunbr_set_1_story_1",
  "groupId": "story_sunbr_set_1",
  "stageId": null,
  "title": "缺失的陪伴",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_sunbr_1_1.txt",
  "sourceHash": "bdfb5d102e4abd4e1b455950cdd5e413595c08edc835e2c8b75dc7d4d4197355",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "髮繩、水杯，還有這個抱枕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "這些都要帶走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "這本書也帶上，安娜姐肯定會高興的。還有這個播放機......索尼婭姐聽歌用得上......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "嗯？這張照片是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "這是......初等學校畢業那天，爸爸媽媽特地回家我們三個人一起拍的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "爸爸、媽媽......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "拉達，差不多了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "抱歉，雖然也想讓你再多待一會，但我們不好在烏薩斯久留，萬一被查出身份就糟糕了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "車隊留給我們的時間不多，得抓緊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "啊，對不起，我很快就好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "收拾東西比預想的要多花了一點時間，這裡變得有一點點亂，很多東西都找不到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "唉，那群整合運動......當初在城區亂來一氣，這都幹的什麼事啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "拉達你接下來打算怎麼辦？還有什麼想去的地方嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "嗯......已經沒有什麼了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "奶奶過世之後，原本我就是一個人住，所以沒關係了，只要把東西收拾好就可以出發啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "這樣啊......這個年紀就獨自生活，真不容易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "欸嘿嘿，還好啦，早就已經習慣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "奶奶教了我怎麼烹飪，之後好幾年都是拉達做飯給奶奶吃哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "真了不起。我聽圓規他們幾個提過，說來了個會做我們老家當地特色菜的小姑娘，可惜還沒有機會嘗到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "......不過，拉達，說真的，你真的決定了要和我們一起走嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "怎麼啦，忽然好嚴肅地問這種問題......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "嗯，我已經決定了！要和索尼婭姐她們在一起！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "哈哈，你們幾個的感情還是那麼好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "但......我想問的不是這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "你看，雖然現在是把邊緣的地塊暫時讓其他城市收容，市民也只能暫居在收容區的安置所，但很多事都在逐漸恢復秩序。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "切爾諾伯格遲早會被重建，再等一陣子，回到這裡生活也是一個選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "其實......我還不確定，現在只是想和姐姐們在一起，但是之後的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "尖針大叔，我有的時候也會想，如果姐姐們都決定要離開了，安娜姐也好，索尼婭姐也好，都找到了自己要做的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "那拉達......之後拉達能去哪裡呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "抱歉，這個問題我沒法替你回答，這需要你自己考慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "拉達，你和安娜她們的情況不太一樣，雖然你說自己並不清楚父母的具體工作地點，就連檔案館也沒有留下記錄......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "但如果申請的話，羅德島也可以幫忙去找......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "我覺得可以不用這麼倉促地決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......才不是倉促決定呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "呃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "我知道尖針大叔是在替我擔心，可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "可是現在我只想陪著姐姐們......只要能大家都在一起，去哪裡都可以！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "以後的事情......拉達也不知道，拉達沒有想過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "拉達......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "可是，你的父母......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "爸爸媽媽......爸爸媽媽在外面工作，本來就很少回家，也不能告訴拉達工作地點，就連信都很少寫......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "就算沒有那些壞人襲擊城市，我也已經好久好久沒有見過爸爸媽媽了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "拉達，爸爸媽媽要出去工作了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "拉達在家要聽奶奶的話，做個乖孩子等著我們回來，好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "......爸爸，媽媽，又要丟下拉達了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "嗚......嗚嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "爸爸媽媽不要走，拉達不想做沒有爸媽的孩子......嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "......拉達......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "快要到出發時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "拉達，爸爸媽媽必須要走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "嗚......嗚哇啊啊啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "不要走！爸爸媽媽不要走......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "不要丟下拉達......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......所以，拉達想去哪裡都可以自己決定！才沒有人會在意呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "一定是這樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "這、這樣啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "（這小姑娘現在是在......鬧彆扭？看起來氣鼓鼓的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "好吧，你暫時跟著我們一起也好......至少現在這情況，也不能放心讓你這個年紀的孩子一個人在這裡生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "如果沒有別的地方想去，就像索尼婭那姑娘一樣，暫時留在羅德島也行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "唔，像索尼婭姐一樣當幹員？拉達沒想過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "當幹員可不輕鬆哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "那等你收拾好東西，我們就出發？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "再等一下下就好！那口鍋拉達也想帶上......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "還要帶？可不要超重了啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "總算是出城了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "前面就是約好的碰頭地點，我們來得還算及時。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "謝謝你，尖針大叔！包裹實在裝不下這些廚具，真是太麻煩你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "沒事，這點東西小意思，反正背鍋這事也不是頭一回了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "沒什麼，你別在意......哎，小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "拉達！沒事吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "沒事沒事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "......拉達？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "咦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "皇帝在上，真的是你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "是......波琳娜奶奶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "是認識的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "嗯！是一直很照顧我的鄰居奶奶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "波琳娜奶奶，你沒事真是太好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "這句話該我說才對！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "拉達，幸好你沒事，當時聽說學生們都被關在學校，之後又到處都找不到你，可把我們都急壞了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "你這段時間都上哪去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "我和學校裡的姐姐們在一起，有羅德......不對，是有好心人救了我們啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "好心人......？是說旁邊的這位先生嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "你好，波琳娜大娘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "......你好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "（沒見過的生面孔，怪模怪樣的......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "（我說拉達啊，救你們的人沒問題嗎，你可不是被騙了吧？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "（沒有啦，尖針大叔真的是特別好的好人！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "......咳咳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "好、好啦！比起這個，波琳娜奶奶現在怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "當時那群壞人沒有傷到大家吧，傑尼亞大叔呢？克拉拉姐姐呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "哎，沒事，大家都沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "我們那一片的警察行動得早，帶著我們躲進了荒地裡避難，這才逃過一劫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "你傑尼亞叔後來也帶人到學校去找過你們，但那裡沒人，我們只好先離開......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "幸好你沒事啊，拉達，真是皇帝陛下保佑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "才不是皇帝保佑我們呢，明明是拉達和姐姐們相互保護......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "嗯？拉達，你剛剛說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......沒什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "別擔心，波琳娜奶奶，我沒事啦，我現在很強哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "如果有壞人敢來欺負大家，一定要告訴拉達，拉達來幫大家把壞人都打跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "哈哈，我們小拉達現在這麼可靠啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "哼哼，拉達還會變得更強，更可靠的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "到時候那些破壞城市的壞人一個都逃不掉，拉達會拿平底鍋把他們都拍扁！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "你說的平底鍋......該不會是我背著的這一口吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "是哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "......很不錯的理想。加油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "拉達，時間差不多了，我們該走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "啊，好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "那波琳娜奶奶，我要先走了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "走？等一下，拉達，你不是來找我們的嗎？你、你怎麼還要離開？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "雖然我們現在是只能在收容區暫住，但那裡條件也還算可以，可能再等一陣子，原本的房屋也會開始重建......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "拉達，你的家不就在這嗎？你要走到哪裡去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "我的家......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "波琳娜奶奶......能遇到奶奶拉達好開心，但是，但是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "但是拉達現在更想和姐姐們待在一起......安娜姐，索尼婭姐，還有娜塔莉婭姐和羅莎琳姐，拉達不想和大家分開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "和姐姐們分開的話，拉達......不知道自己還能做什麼，會很害怕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "拉達......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "要是沒地方去，那就回家，和我們一起。我們回家，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "波琳娜奶奶，房子毀了，爸爸媽媽不會回來，拉達在這裡已經沒有家了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......但是沒事的，放心吧波琳娜奶奶，拉達要去的地方很安全的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "會有很多很好的人，大家都會對拉達很好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "對吧，尖針大叔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "嗯，至少安全還是可以保證的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "我們還不至於讓像拉達這個年紀的學生面對什麼太危險的狀況。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "哇......索尼婭姐聽到這句話，肯定會生氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "她都已經決定要申請成為正式幹員啦，好像連代號都已經想好了耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "饒了我吧，這話我可不敢當她的面說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "看來你已經下定決心了......好吧，那我就不多問了，記得要寫信回來啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "只要你安全，那我和你傑尼亞叔也能稍微放心了。你出去看看也好，能平安就好......等城市重新建起來了，到時候再回來也不遲......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "等等，拉達！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "還有東西要給你！我就盼著哪天能找到你，所以一直隨身帶著。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "這個給你，這是你爸媽前幾年走之前托我們家代為保管的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......欸？爸爸媽媽的東西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "本來是說等你中學畢業，那時候他們如果沒能趕回來，就托我們把這個轉交給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "但你要走了，之後也不知道什麼時候才能再見一面，我覺得還是現在給你比較好。你可一定要收好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "這個盒子裡面裝著什麼？這是......錄影帶？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "還有照片......是初等學校畢業時的合照，上面還寫著我和爸爸媽媽的名字......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "這應該是給你的禮物吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "出了這麼大的事，也不知道你父母在外頭得到消息了沒。唉，這麼些年了，信都不往家裡寄幾封，真不像話！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "——不是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "爸爸媽媽只是、只是工作太忙了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "唉，你能這麼想就最好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "你爸媽......他們的工作，聽說也不簡單。比起我們這的事，說不定還要更難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "當年你奶奶還在的時候，有時擔心得緊了，就會來和我說兩句，唉......說是研究啥東西，但哪有這樣連親人的面都不給見的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "總之，拉達你要自己好好照顧自己，不管去哪，都記得給奶奶報個平安。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯平民",
      "text": "不耽擱你們的時間了，快去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "爸爸，媽媽......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "你還好嗎，拉達？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "......沒事，沒事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "尖針大叔，我......我或許，想到之後要做什麼了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "拉達，好孩子，別哭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "爸爸媽媽是在做對我們烏薩斯很重要的工作，所以不能常回來陪著拉達，也沒有辦法經常寫信回來......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "但拉達絕對不是沒有爸媽的孩子，你是爸爸媽媽的寶貝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "可是，可是......其他小朋友都說......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年幼的女孩",
      "text": "說拉達是沒人要的小孩......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "怎麼會呢？爸爸媽媽都很愛拉達，其他的小朋友只是一時誤會了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "拉達，我們或許會一時分離，會無法見面，無法通信......可能在我們想念彼此時，只有一點點回憶能夠支撐我們繼續走下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "沒有辦法陪著你長大，是爸爸媽媽的錯。但是不要忘記，拉達，不要忘記爸爸媽媽會永遠愛你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的女性",
      "text": "不管我們身在何方，不管未來拉達你選了什麼樣的路......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "我和媽媽都會支援你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的男性",
      "text": "只要有機會，我們就一定會回到你身邊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "小的時候，周圍有孩子笑話我是沒有爸媽的野小孩。\n我很難受，哭著告訴了難得回家的爸爸媽媽。\n那之後不久，不知道為什麼，小朋友們就再也沒有這麼笑話過我。隔壁的姐姐會輕輕摸我的頭，和我說：\n“原來拉達的爸爸媽媽是很了不起的研究者，之前真是對不起呀。”\n我的爸爸媽媽，很了不起。\n但是我很少能見到他們。\n初等學校畢業那一天，爸爸媽媽回來了。\n我和爸爸媽媽一起參加畢業典禮，一起拍照，一起去很多地方玩......\n爸爸媽媽說，他們不想錯過我的成長。所以不管有多難，都會努力爭取，至少在重要的日子裡，能陪在我身邊。\n爸爸媽媽說，他們想讓我瞭解他們的生活，所以會記錄下來，留給我，在我想念他們的時候可以有更多陪伴。\n......那是不是只要我繼續成長，就可以和爸爸媽媽再見面？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "哼哼~哼哼哼~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "真理姐，拍下來了嗎？拍下來了嗎？我終於通過測試啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "等等，拉達，你跑慢點......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "呼......好了，都幫你拍下來了。但是你怎麼會突然開始想要拍生活記錄了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "嗯......因為要多存一點我成長的記錄，是一份秘密驚喜哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "啊，對了真理姐！現在我已經通過測試了，已經和姐姐們一樣是正式幹員了！要記得叫代號才行啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉達",
      "text": "古米！我的代號叫作古米！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "好，古米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......有點不習慣。拉達，這麼說的話，你的自稱也得糾正過來才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "對哦......！我都忘記了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米一定會加油的，一定會保護姐姐們，還有羅德島的大家！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "早啊，拉達，安娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "早上好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "尖針大叔！早上好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "不能再叫拉達了，古米有代號了，是正式幹員了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "哈哈，那真不錯，恭喜你啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "對了尖針大叔，古米有個問題想問！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "嗯？什麼問題，你說說看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "羅德島......有學校嗎？古米可以繼續讀書嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "古米......？怎麼突然提起這個......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "學校這麼正式的機構肯定是沒有啦，不過培訓課程，還有基礎教育的課程還是有的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "真的？那就是可以繼續讀書的意思嘍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "當然。你這麼積極，教課的老師看到你一定會很欣慰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "其實就算你不提，我估計之後也會有專門負責的幹員來通知你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "博士特地打過招呼，要盯著你們好好讀書，到時候你們想跑估計都跑不掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "......凜冬肯定要頭疼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "哈哈哈凜冬姐大戰教頭！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "爸爸媽媽......拉達現在在叫羅德島的地方生活。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "雖然，雖然還會有一些不習慣的事情，也會有一些，想起來會害怕的事......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "但是和姐姐們一起的話，拉達相信一切都會變好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "爸爸，媽媽，你們也要努力工作，我會給波琳娜奶奶寫信，告訴奶奶羅德島的聯繫方式......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "如果你們寫信回來，或者直接回來找我了，波琳娜奶奶會告訴你們我去了哪，然後我們就可以在羅德島見面啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "......把我丟下這麼久，在我最害怕的時候也沒有出現，我也是會生氣的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "很生氣很生氣，沒有那麼容易就原諒你們，到時候見了面，可能會和你們吵架......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嗯......但是吵完之後，我們也還是一家人，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "要是爸爸媽媽很忙，抽不出時間......這次就換拉達去找你們，去見你們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "不過現在的我還不行。現在的拉達，變了很多，可能會嚇到爸爸媽媽......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "我會把那些......那些不太好的習慣都克服掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "這裡有很多人會幫拉達一起克服，安娜姐她們也會一起......我們一定都會忘掉那些不好的事，我們都會振作起來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "等著我哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "拉達一定會繼續努力長大的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
