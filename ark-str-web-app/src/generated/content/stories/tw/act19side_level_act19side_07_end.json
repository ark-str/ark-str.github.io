{
  "server": "tw",
  "storyId": "act19side_level_act19side_07_end",
  "groupId": "act19side",
  "stageId": "act19side_07",
  "title": "瘋狂的信號",
  "storyCode": "DV-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act19side/level_act19side_07_end.txt",
  "sourceHash": "10a2563911a9631b0e89f37c56ca4c377cc71ead687dea8a3c871e0d0a811e85",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "萊茵實驗員",
      "text": "咦，這不是繆爾賽思主任嗎？這麼晚了您還來公司啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "呃......咳咳，是啊，有工作沒幹完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵實驗員",
      "text": "您可真是辛苦啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵實驗員",
      "text": "這兩位是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......我們的重要合作夥伴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "你沒認出這位嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵實驗員",
      "text": "呃......我看不清臉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "這位可是源石理論學者、礦石病專家、天災研究者，大名鼎鼎的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵實驗員",
      "text": "原來是您啊！真是難得的機會，竟然讓我碰到了像您這麼厲害的科學家！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（他根本沒聽說過我吧？）",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "（這都能糊弄過去？）",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "我們有急事需要儘快上樓——有機會的話，下回一起開午餐會啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵實驗員",
          "text": "當然。那就不耽誤您的時間了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵實驗員",
          "text": "等一下，我剛才就覺得您很眼熟，您難道不是那位防......防......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......防護材料領域非常有名的專家。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "帕爾維斯......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "帕爾維斯",
          "text": "這幾年萊茵的擴張速度很快，不是嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕爾維斯",
          "text": "新來的小朋友們還需要多長長見識啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵實驗員",
          "text": "......兩位主任同時出現？我、我......我還有工作沒做完！我先走啦！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕爾維斯",
          "text": "呵呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "......你不準備告訴他們我回來了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕爾維斯",
          "text": "請原諒我的老花眼，我以前認識您嗎，美麗的瓦伊凡女士？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕爾維斯",
          "text": "沒什麼事情的話，我就先回去了。太晚休息可不利於我這把年紀的人的身體健康。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕爾維斯",
          "text": "對了，繆爾賽思主任，別忘了你答應我的黑豆茶。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "呼......他真的是路過嗎，塞雷婭？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "現在是凌晨四點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "帕爾維斯平常的下班時間是九個小時以前。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "果然......直到最後一刻到來前，他都不會輕易把賭注壓在斐爾迪南和克麗斯騰之間的任意一方身上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "他還想看看誰的贏面大呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "就算萊茵生命變成了廢墟，他也一定是能活下來的那個吧？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "......他們進了萊茵總部。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "領航小隊，準備攔截。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "別著急。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "你是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "我見過你和塞雷婭交手，對你的裝備很感興趣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "方便借我看一眼嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "在戰鬥之前，你們是這麼打招呼的嗎，羅德島的精英幹員？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "請不要誤解，剛才那句話，我不是以羅德島精英幹員的身份說的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "作為一名機械師，我尊重任何優秀的技術及技術的發明者——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "所以，在我奪下你那根形制特別的法杖之前，我想先詢問一下你的意願。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "......你很有趣，Mechanist先生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "我之前只是想去見一見塞雷婭，但你和你的上司......那位博士給了我更大的驚喜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "你知道我的名字？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "你也調查過我，不是嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "掌握儘量多的資訊，是我們這類人在動手之前的習慣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "......萊茵總部的資料庫裡有你的名字，霍爾海雅女士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "但我不相信斐爾迪南會雇傭一名歷史學家來追殺自己的同僚。就算是在充滿不可能的哥倫比亞學界，這也太荒誕了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "那只是我的副業。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "你的副業是研究歷史？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "錯了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "我是一名歷史學者，我在這裡，只是為了見證一則流傳千年的預言成真。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "同樣的，我也相信，未來的走向能揭示一些被掩埋的歷史——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "我和你們一樣，都是真相的追尋者。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "我們到了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "知道怎麼去找你的混蛋上司嗎，研究員小姐？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "他應該在監控室裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "轉角的地方有個通風口，要是能爬上去的話，就能用最快的速度抵達監控室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "動作要快。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "畢竟，很快就有很多人來迎接我們了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "......警長。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "我就知道你會站到對面去。你的意志還是不夠堅定，你忘不了你和這名罪犯的過去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "他還不是罪犯，小子，能定罪的人從來不是你們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "......你在走一條不歸路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "為什麼？你們明明都那麼優秀，為什麼要自毀前程？為什麼......她也不聽我的勸阻？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "你真正想提問的對象並不是我，對吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "但我也可以替她再教你一回。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "呃——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "因為我們知道自己戰鬥是為了什麼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "為了守護某些人......守護某些準則不被像那個混蛋主任那樣的人踐踏，我們從來不會猶豫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "我們不會像你一樣......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "落腳之前總是先看好陣營——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "動手之前還要問為什麼！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "唔......！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "你們找到方向了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我想是的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "那快走吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "我有弩，你沒有。所以先別管我了，管好你自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......謝謝。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "保重。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "你怎麼不跟上去？你一路走到這裡，不也是為了找那傢伙算帳嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......我也有武器。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "我們很久沒有並肩作戰了，瑪麗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "什麼並肩作戰......那時候只是玩遊戲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "瑪麗",
          "text": "再說了，哪一次遊戲不是我帶你？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "哈哈......謝謝。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "我真的很想念......很想念那段時光。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "只要從前面的電梯上去，就能直達總轄辦公室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "走後面的秘密頻道會是更保險的做法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "我知道啊，可我們不是在趕時間嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "直接走的話肯定更快，要應對的武裝人員也能更少些......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "等等，別走到前面那個位置——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "咦？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "抱歉，我忘了，那裡是監控區......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "博士，我們要轉備用計畫了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "發現入侵者！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "這裡，在這裡！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "抓住這幾個入侵——等等，主任？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "你好，雷吉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "您怎麼回來了......不，您已經沒有權限，不能再往前走了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "面對入侵者，展露出內心的猶豫只會給敵人機會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "需要我再教你一遍該怎麼做嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "......舉盾！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "暈眩器準備，瞄準入侵者——塞雷婭！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "勉強算你合格。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "最新一批資料都記錄好了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "好了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "注意無人機的方位。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "不要讓實驗體的行動影響到第一手資料的採集。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "放心，老闆。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你想要的第一手資料已經自己走到你面前來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "埃琳娜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "我很高興......你沒事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我在你手下工作了那麼多年，閱讀你的微表情也變成了工作的一部分——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你的左側眉毛輕微地上挑了一下。你明明很驚訝，老闆。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......你總是能給我很多驚喜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "你回來了，我終於可以好好鬆口氣——那些蠢笨的新人需要像你這麼優秀的研究員好好調教。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你想讓我當組長？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "不，不是組長。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "看到桌上那把鑰匙了嗎？收下它。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "你已經完全證明了自己的能力。你不再需要給任何人——無論是我還是多蘿西——當助手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "下一個項目，你會是第一負責人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "這把鑰匙就是我為你準備好的禮物。那是一間嶄新的......空間充裕的實驗室，屬於你的實驗室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "無論你想做什麼研究，我和萊茵生命都會全力支援你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "太棒了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你是不是還考慮過讓我接任能量科主任？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......不是沒有這種可能性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "你......你看起來並不驚喜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "因為無論你給我的未來規劃了什麼道路......我的答案都是“不”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......放下你的法杖。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你在害怕什麼？你怕我背叛你，在這個你即將迎來重大成功的關鍵時刻，讓你沒法看到自己的光輝未來？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "或許我真的會考慮這麼做。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "我不明白。我明明給了你那麼多......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "我在你身上看到了天賦、勤勉和野心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "這些都是取得成功的必要品質，也正是這些品質鑄就了我自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你當然不明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "要是你真如你所言的那樣器重我的話——你就應該把整個實驗的真相都告訴我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "告訴我，你會無視那些受試者的安危，你會把我當成監視多蘿西的工具，等沒用的時候，就讓我連同你罪惡的證據一起灰飛煙滅......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......在你眼中，我是不是一個特別聽話的傻子？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "奧利維亞明明提醒過我，我卻直到你動手的最後一刻才醒悟過來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "你還沒有準備好，埃琳娜，我怕你會動搖，就跟現在這樣......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你從來沒有信任過我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你不相信任何人。斐爾迪南，你只信你自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "那麼，我憑什麼要再信任你......相信你的這些許諾？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "我從來沒有給過任何人那麼多機會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "埃琳娜，你知道嗎？你比我的孩子更像我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "我在你身上傾注了那麼多心血，即使此刻，只要你願意，我依然允許你回到我身邊——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "就當我求你最後一件事——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "閉嘴吧，老闆。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "帶著你的“禮物”和這些虛情假意，離我遠一點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我，埃琳娜·烏比卡，從今天開始，不再是在你手下任你擺佈的傻助手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "斐爾迪南·克魯尼，你被我開除了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "......斐爾迪南主任！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "給我抓住她，抓住這個暴徒！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "唔......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萊茵防衛科成員",
          "text": "主任，您沒事吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "我沒事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "埃琳娜......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "不要......再用這種......看起來很關心我的眼神......看著我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "這讓我覺得......噁心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "......你說我不理解你，可你也並沒有真正理解我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "也許......在剛才那一刹那，我是有過猶豫和擔心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "那並不是我擔心你給我搗亂，而是我在擔心你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐爾迪南",
          "text": "我是......真的不想看著你走到這一步。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "這句話......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "咳咳......我也想原樣送給你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "呼......呼......怎麼辦，防衛科的人越來越多了啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "斐爾迪南還真是做足了準備，塞雷婭再能打，也很難一下子打退這麼多人吧？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "還得麻煩你幫忙了，繆爾賽思主任。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "......我？不行的，我並不會打架啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "光是跑來跑去躲避他們的攻擊，我就已經很費勁了啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "你沒聽到我呼呼喘氣嗎，博士？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你剛才就很巧妙地幫了塞雷婭一把，不是嗎？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "只要你不再故意拖時間就行。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "你......你發現了？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "塞雷婭很久沒回萊茵總部，但還記得哪裡是監控區。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你總是有意無意干擾塞雷婭的視線。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自從聽到我猜測總轄就在這裡，你明顯不再著急。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "我......哎呀！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "......差一點就真的中招了啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "博士......你竟然還拉著我？你......你還願意拉著我嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "明明猜到我可能有其他想法......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "有什麼想法都是你的自由。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我並不在乎你究竟是什麼立場。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我請你幫助塞雷婭。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這是為了羅德島和萊茵生命的共同利益。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "這是為了哥倫比亞與其他國家的安全考慮。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "這也是為了你。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "......算上這次，你已經救了我兩回了，Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "好吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "就當作是報答好了，至少這一回，我會站在你們身邊，幫助塞雷婭去她想去的地方。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "聽到我的呼喚了嗎，水分子？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "繆爾賽思",
          "text": "親吻眼前的每一位生靈，捲走腳下的所有塵埃吧！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "......精靈動搖了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "真是可憐的生靈......她總是希望自己能從其他人口中得到一些關於明天的允諾。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "誰又會甘願承認自己與自己所屬的族群只屬於過去呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "克麗斯騰沒法給她的東西，那位Dr.{@nickname}難道可以？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "哥倫比亞雇傭兵",
          "text": "女士，塞雷婭已經突破了封鎖。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "就讓她見見自己的老朋友吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "我還有其他工作要完成......只能下一次再與這位機械師先生交流了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍爾海雅",
          "text": "——要是他能從這批動力甲手中活下來的話。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "有多久沒有回來了？\n一千四百九十七天。\n分別的時候，或許已是敵人。\n再見的時候，又還是朋友嗎？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你回來了，塞雷婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷婭",
          "text": "......你好，克麗斯騰。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
