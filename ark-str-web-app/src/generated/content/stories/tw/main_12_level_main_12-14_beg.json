{
  "server": "tw",
  "storyId": "main_12_level_main_12-14_beg",
  "groupId": "main_12",
  "stageId": "main_12-14",
  "title": "天邊的火燒雲",
  "storyCode": "12-16",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_12-14_beg.txt",
  "sourceHash": "ad0083114d5f21f8ddf46f7f4217d20fa1a7515b2b3863d331c3f1e1c4276567",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這就是......飛空艇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "我們所有的潛入計劃都失敗了，靠近的人就像憑空消失了一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "這是某種薩卡茲巫術嗎，魔王？你應當知道該如何破解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "特蕾西婭小姐......她也在這裡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可我感受不到——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一股沉重的壓力襲來。\n它無法被描述，它無法被言說，那麼濃重，那麼殘酷。\n阿米婭幾乎無法站穩。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這是......什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "你在做什麼，魔王？別想搞什麼小動作！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "使用你的那些巫術，幫我們破解它！否則的話——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰禮帽”",
      "text": "唔——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你來了，阿斯卡綸。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "博士，我來晚了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "阿斯卡綸，別激動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "這位同事的行為與我無關！我勸過他，可他不願意聽！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "我無意傷害你們的博士，我們只是在完成交易，那時候你也是見證人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "那就滾開。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "怎麼了？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你的表情很難看。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "你感受不到，你不是薩卡茲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "我們......在面對自己的歷史。在面對薩卡茲千萬年的苦難。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "它在訴說，它在憤怒，它強迫我們每個人聆聽它的悲號。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "......怪不得。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "哼，大公爵們要失望了，這並非什麼可被複製的工業技術。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "這艘船，是一位死魂靈。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗚——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我......這些聲音......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "阿米婭，別被它影響！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "堅持住，這只是幻象！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我明白，我在嘗試......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗚嗚——啊——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "這裡的影子......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "不對，這不是和那位伊內絲小姐類似的操縱陰影的源石技藝，這是什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "博士，離開飛空艇的影子！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "飛空艇的陰影蠕動著，延展著，被阿斯卡綸擊倒在地的另一名“灰禮帽”瞬間淹沒在漆黑的海洋中。"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "開什麼玩笑，這到底是什麼......",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "深重的黑色，深重的絕望，深重的憤怒。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "死魂靈......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看到了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "別去看，阿米婭，那是死魂靈的巫術！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看到了淚水。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "死魂靈，我看到了如此沉重的悲傷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "您一直與這些悲傷在一起嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "您用憤怒的火焰灼燒傷口。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這......很痛苦。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阿斯卡綸踉蹌了幾步。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你沒事吧，阿斯卡綸？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "我......還好......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "阿米婭她——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "死魂靈巨大的陰影裡，阿米婭仍然昂著頭。\n在這個角度，看不到阿米婭的表情，唯一能知道的是，她仍昂著頭。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "您說得對，死魂靈。我應該去看，我看見了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看見了這一切。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看見了那三千四百二十一次毀滅，我看見了每一片磚瓦化為灰燼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看見了每一位魔王的反抗，我看見了他們每一個人的心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看到了那些被吞嚥的淚水和鮮血，我看到了那些被高揚起的塵土和碎片。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......如此相似的身影交疊著倒下，如此相似的場景反覆上演。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我看到了，我仍然選擇去看，我還會繼續看下去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "死魂靈，我沒有一刻移開目光。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我會牢牢記住。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我會記住每一次艱難的選擇，每一次的死亡與犧牲，每一次的毀滅，每一次的希望。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可我已經在努力——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可是，我一定不會——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "特蕾西婭小姐希望我能成為......！她說，就算是異族，我們依然會感同身受！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阿米婭突然發現自己無法說出一個字。\n她為什麼要阻止這場戰爭？\n在看了這些憤恨，這些痛苦，這些渴求之後。\n她為什麼要阻止這場戰爭？\n這......這場戰爭，對於薩卡茲而言，確實是唯一的方法。\n每一個薩卡茲，在面對了這一切之後，都無法得出其他答案。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阿米婭發現了，有一瞬間，她理解了特蕾西婭現在的選擇。\n用淚水湮沒淚水，用苦難填埋苦難。\n只有焚毀的土地才能給薩卡茲帶來新生。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......我仍拒絕這條路。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "所以，死魂靈說的是對的。\n正因為她拒絕，所以她永遠無法真正與他們站在一起。\n她可以抽身而出。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "陰影狂亂地抖動分裂著，簡直要化為實體。\n死魂靈混亂的投影正在這座空曠的船塢中析出。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "真是個大傢伙。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "紫色的火焰撞上了黑色的陰影。"
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "我對你們的存在很感興趣，死魂靈。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "若是你被灼燒，會留下什麼樣子的餘火呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "那條德拉克......愛布拉娜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "任務簡報裡可沒說過她會親自出現在這裡！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "text": "走！快走！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我......我沒事......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "來，我扶著你。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士，我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我確實沒辦法，真正和他們站在一起......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "也許，正因為這樣，才必須是你。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......欸？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "那條德拉克的火燒過來了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "她......很強大。我們沒必要在這裡對抗她！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "哼——有意思。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "羅德島......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "我最近，是不是經常聽到這個名字？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "王庭軍士兵",
          "text": "將......將軍，那條德拉克......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不用理會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "她的那些火焰，除了自己狹隘的野心，什麼都點不燃。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "死魂靈閣下，請您帶領我們離開這裡。這狹小的船塢容納不下您的憤怒，這些聒噪的異族也不值得浪費您的時間。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我收到了攝政王的消息，他已經準備好了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "殿下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "薩卡茲的飛空艇已經升空，正在緩慢地向倫蒂尼姆方向轉向。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "我們的高速戰艦編隊已經在外圍做好了攔截準備。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "......也有其他部隊正在集結。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "哦？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "溫德米爾公爵的艦隊在更早之前就接近了這個地塊，開斯特公爵的軍艦也在蠢蠢欲動，恐怕很快也會接近。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "看來大家都很關心這裡。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "真的關心嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "考伯特",
          "text": "是不是各位公爵來得有些太遲了呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "你是......那個酒店的大堂經理？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "你怎麼會在這裡？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "......你是薩卡茲早就安插在倫蒂尼姆的間諜？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "考伯特",
          "text": "不，考伯特只是個普通的自認是個維多利亞人的薩卡茲清潔員罷了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "那麼你呢？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "我們......？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "和朋友正聊到興頭上，卻被派出來幹活的可憐人罷了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "德拉克，你還真是掃興。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "愛布拉娜",
          "text": "那麼，不如和我聊聊怎麼樣？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "......饒了我們吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "變形者集群",
          "text": "不如讓我們盡快結束這一切。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
