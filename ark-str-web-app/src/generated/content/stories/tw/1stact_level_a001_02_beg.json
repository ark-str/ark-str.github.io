  "title": "察言觀色",
  "storyCode": "GT-2",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/a001/level_a001_02_beg.txt",
  "sourceHash": "e981b688f4234fa6da524d0a3ea206b604153745e28fe2fd2f838e019fae813f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "攔住她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "攔什麼啊！你沒看到他們全部被幹掉了嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "你上啊，你平常不是很厲害嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "我，我不行！這傢伙可是那個災星啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（阿戈爾語）攔住我的都會死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（阿戈爾語）向我揮出武器的都將粉身碎骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（阿戈爾語）想死的，向前踏出一步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "你究竟在說些什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "唉？上尉？上尉怎麼消失了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "上尉掉進河裡了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "這、這傢伙一擊就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啊，忘了他們聽不懂......算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "說，她在哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "她？你指誰？別問我，我什麼不知道啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "呃啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "給、給我記住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "喂！你們別急著撤退！先把上尉撈起來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "那、那個人是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "你認識她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "她可能是我的同事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不過，接到這項委託的應該是我啊？我可是好不容易才從隕星姐手裡搶到這項任務的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "唔唔唔......也許她是為別的任務來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "唔，賞金獵人好像被擊退了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "事不宜遲，我們趁現在溜出村子吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "既然還有其他幹員在這個村子裡，說不定事情會好辦一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "可蘿爾，樓梯很黑，你要扶緊我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "那個，你要和她聯絡一下嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "嗯，如果可能的話，我想——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "噗啊————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "哇——————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "我、我的鼻子！這扇門怎麼自己彈開——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "欸？這裡怎麼會蹲著人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "格拉尼！發生了什——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "你們全都給我閉嘴！噓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "......噓？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "唉，你們這些幹農活的肯定什麼都不懂。沒看到那個災星嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "無論是哪個賞金獵人，都不會想和她碰面的！敢在她面前昂首挺胸的，多半是沒見過她毀掉整座城市的樣子吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "這麼誇張嗎！那不是靠她一個人就可以把————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "聲音輕點，別被她發現！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "唔，可是我還要找她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "說了小聲點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "好，好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "感覺比羅德島裡流傳的版本更離譜......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "那、那個怪物走了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "好，好像走了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "總算走了，啊喲，嚇死我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "是，是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "原以為這點活我們一隊就能搞定，怎麼會碰上這種麻煩事。那種傢伙都來了的話，得做好準備才能——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "——等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "哈！拿槍的小子！居然在這裡碰見你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "還有村長！你真是送上門來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "格拉尼，你難道是故意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不，只是他們態度那麼好，我也沒回過神來啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "廢話少說，把村長交給我們！不然我保證會用手裡這把刀讓你吃足苦頭！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "就用那把斷刀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金獵人",
      "text": "......這，這小子什麼時候出的槍？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "用暗號召集附近還在的人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的賞金獵人",
      "text": "還有，去把之前用來毀掉農田的蟲子都趕出來，讓她們嘗嘗厲害！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
