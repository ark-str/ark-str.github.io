{
  "server": "jp",
  "storyId": "story_mizuki_set_1_story_1",
  "groupId": "story_mizuki_set_1",
  "stageId": null,
  "title": "第五種接近遭遇",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_mizuki_1_1.txt",
  "sourceHash": "9fbfdb6b1966020f478d9229a3d267f4d7db2fb825d6ed620b9ee17eb2342c98",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "水月个人剧情1"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私の解釈が合っているかは分かりませんけど、ロドスのこの度の対応も、あなたが以前おっしゃっていた協力の一環なのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "まさにその件を協議するために連絡したのだが、どうやらキミは約束より数時間も早く来たらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "陸上であっても、約束の時間より早く到着する行為は背信にはあたらないはずですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "たとえエーギルの地であろうとも、他人の家宅に断りもなしに玄関以外から侵入する行為は、行儀が良いとは言えないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さすが能弁でいらっしゃいますこと。ですけど、謝る気はありませんの。それと……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "言葉が途切れるよりも前に、エーギル人の姿はすでに十数メートル先にある、廊下の突き当りの部屋の前に現れていた。まるで初めからそこにいたかのように。\nその声の残響のみ廊下に取り残され、移動の軌跡を物語っていた。\n淡青色のステッカー数枚に彩られたドアに、彼女は長槍を軽く突きつけた。その表情には幾分かの嫌悪と憤りが見て取れたが、呼吸は全く乱れていなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "教えていただいてもよろしくて？　御社はどのような意図でこの部屋を設けられたのかしら、ケルシーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "手紙に書いた通り、この居室は例のロドスの協力対象に宛がわれたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "聞き間違いでなければ良いのですけど。願わくば、あなたがあの狂人たちと彼らの吐き気を催すような技術からインスピレーションを得ようなんてしていませんように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ひとつの脅威を利用して別の脅威に対抗するような真似を、ロドスは試みたりしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それは何よりですわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "頑丈な合金のドアに深い傷跡を描くように、長槍は瞬時に振り下ろされた。そして激しい音とともに、優雅な所作でエーギル人に蹴り上げられ、真っ二つになった。\nエーギル人はドアの前から姿を消し、室内を一通り探索したのち、手ぶらで引き揚げ元の場所へ再び現れた。それもまた、瞬く間に起こった出来事であった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "本当に、奇妙ですこと。あの残滓たちに対する私の嗅覚が間違いを起こすなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "もしくは、あなたが私を制止しなかったのは、私の行為を黙認しているわけではないという可能性に、もっと早くから気付くべきだったかも知れませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "どうやら宿敵と対面したアビサルには、戦闘技巧以上にセルフコントロールが必要らしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "今のところ、彼らの進化は知性的思考に基づく結果というより、単に行動を最適化したそれと考えられるが、いずれはそのレベルに到達するかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ふっ、そういうことにしておきましょうか。あるいは訪れるかもしれませんものね――その考えや目的を知るがために、あの汚物たちをひねり潰したい衝動を抑えなくてはならない、そんな時が。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "では教えてくれませんこと？　ロドスがこんなモノを収容なさったのは、この大変貴重な学びを私に授けてくださるためだったんですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "キミをからかう意図はない。これはただアビサルハンターの秀でた行動力に対する信頼からとる措置だ。話を始める前に終わらせようとするのはやめてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "御社は、私のハンターたちが敢えて一切の血を流さず、無傷でいることに細心の注意を払いつつ、艦を遠く離れながらあなた方に協力しているのは、一体何のためだとお思いでいらっしゃいますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "あの検査対象の生理パラメーターから取り出せる情報は、恐魚を一匹ひねりつぶすよりもはるかに高い価値がある。戦争設計師であるキミにそれが分からないはずがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "「ミヅキ」と呼ばれる協力対象はすでに移転済みだ。どうか心穏やかに議論した上で、理性的な結論を導き出そうではないか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数ヶ月前\nボリバル ドッソレスシティ"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "よし、シンガスの奴らがかかった！　おい早く、計画通り始めると兄弟たちに知らせて来い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "おっ、おう。分かったぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "この商売が上手くいったら、俺らは今度こそ……自由だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "……爆発の一件、カンデラさんの耳には届いてないだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人A",
      "text": "報告します、目下特に問題ありません。我々の内通者が常に監視していますが、市長は一度も部屋を離れておらず、いかなる指令も発しておりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "いいだろう。日が昇るまでまだ数時間ある、現場を偽装するには充分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "爆発物の匂いを彼女に気取られないように。街の基盤を破壊し、享楽にふける馬鹿共に恐怖をもたらすものだけは、必ず嗅ぎつける人間だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "事件が起きた倉庫の責任者は分かったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人B",
      "text": "はっ、トゥルーボリバリアン出身の傭兵二名です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人B",
      "text": "通信端末では彼らと連絡がつかず、潜伏場所にも姿はありませんでした。現在、彼らの行方を追っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "シンガス側の動きは？　大会を前に彼らの手の者が爆発に巻き込まれ負傷したなんて事態、普通ならすぐカンデラさんに説明を求めているところのはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人B",
      "text": "彼らは人探しをしているようです。盗聴は断片的にしか情報を得られませんでしたが、「子供たち」がどうのと話しておりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "ああ、たしかリターニア人の少年合唱団が先日到着したとか。宿泊先はちょうど現場の倉庫近くのホテルか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "負傷者の中に、あのホテルの従業員はいるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人B",
      "text": "はっ。負傷した者の身元はすべて洗いました。ほとんど全員があのホテルの警備員であり、シンガス政府の軍人でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "ハハ、どうやら俺たちとシンガスの連中は、みんなあの二人にしてやられたようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "シンガス側がカンデラさんに訴えないのは、恐らく元々はあの二人から火薬を買う算段だったのだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "一方で、あの二人は取引を餌にわなを仕掛けた。爆発でホテルにいたシンガスの手の者を負傷させ、隙を見てVIPのゲスト――あの「子供たち」を連れ去ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人B",
      "text": "なんと……それでは、我々の方はどのように動けばよろしいでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "現場を偽装するのが先だ。カンデラさんにはごろつきの仲間割れによるアクシデントだったと思わせるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "もしこちらが先にあの子供たちを見つけ出せれば、今後シンガス側との交渉にも有利に働くかもしれない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人A",
      "text": "報告します！　先程警察の端末へ送られた匿名の情報をキャッチしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人A",
      "text": "内容はトゥルーボリバリアンの一味がリターニア合唱団を連れ去った件で、座標情報も添付されていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人A",
      "text": "現在この情報を入手しているのは我々のみとなりますが、この後は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "すぐにもみ消せ！　カンデラさんの周りの者には絶対知られるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "それと座標はダミーの可能性がある、軽率に動くな。街から出る道路を封鎖するだけでいい、爆発現場の偽装工作を優先するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボリバルの軍人A",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "どういうことだ……こんなことをして、誰の得になるっていうんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルネスト",
      "text": "……そこにいるのは何者？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……うそ、何て鋭いんだ。でも、僕を見つけるにはもうちょっとってとこかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うーん……子供たちを襲う悪人は、やっぱり放っておけないよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まぁ、あの子たちとは同じ商船でリターニアから来たわけだし、多少は縁があるともいえるか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それに、初舞台もまだ観れてないしね。せっかく買ったチケットを無駄にはできないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "ちっ、たかがホテルになんて警備の数だ！　先におびき出した奴らはまとめて片付けたてぇのに、まだあんなにいやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "で、でもよぉ……俺らでなんとかなったし、うまくやれるよな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "ふん、シンガスのクソどもが。こんな夜更けでもガキどもに見張りをつけるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "なんつうか、連中の方もガキたちのことを警戒してたような、逃げられないようにしてるつうか……なんか変だよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "お前にしちゃ冴えてるじゃねぇか、ひょっとしたら当たりかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "俺たちのことを考えてみろよ。こっちだって、あのトゥルーボリバリアンどもにもうこれ以上付き合ってられねぇからずらかろうとしてんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "それは……そうだけどよ。でも俺はなんとなく、パンチョの旦那の考え方もさ、完全に間違ってるわけじゃないと思うんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "ったく、そういう問題じゃねぇんだよ。たとえ間違ってなくても、アイツがこの街を掌握できなけりゃ何の意味もねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "それに本当に掌握したとしても、こんなまともな工場すらない街から搾り取れる金だって高が知れらぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "ボリバル人の国を作りたいだって？　クルビア人とリターニア人の後押しがなけりゃ、まともな武器すら集められねぇだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "でもよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "でももクソもあるか！　本当に何か手立てがあっても、俺たちのような下っ端が考えることじゃねぇだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "聞け。今回の仕事を片付けたらな、俺らはもう足を洗って好き勝手に生きようや。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "何ため息ついてんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "え？　ついてないけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君たちに好き勝手に生きられちゃうと、売られる子供たちには惨めな人生しか待ってないだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "んだとテメェ*スラング*！　どっから涌いて来やがったんだこの*スラング*ガキは！？　かっさらって一緒に売り飛ばしてやる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "ひぃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "お前は一々ビビってんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "いや、お、俺の刀が……一発くらわして痛い目見せてやろうと思ったら、何故か刃が急に曲がったんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "役立たずが！　やっぱまともな武器すら集められてねぇじゃねぇか連中はよ！　これじゃ子供にも太刀打ちできねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "それはそうと、ああいう肌がきめ細かくて柔らかそうな子供は金になるんだ、二度と手荒く扱うんじゃねぇぞ。俺のやり口を見てな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "ひっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "ど、どうしたんだ？　なんで急に這いつくばって、地面を掴んだりして……えっ？　部屋が、斜めに？　うおっ、た、立ってられな……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気弱な傭兵",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "ちっ、このクソガキめ……面妖な技を使いやがって……！　靴に吸盤でも仕込んでんのか？　こんな傾いた地面に……なんで立っていられるんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "えー、それは君たちが歪んだ道を選んだからじゃないの？　それで周り全部が傾いちゃってるように感じるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気な傭兵",
      "text": "ほざけ！　誰がお前をここへ寄越したんだ。これはリターニアの邪術か何かだろ。お前は、一体何なんだ！？――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それで、彼は一体何だというのだ？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "そんなに用心する必要はどこに？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "すまない、Dr.{@nickname}。だが今はまだ、キミにすべてを打ち明けるような時ではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "現段階で詳細を話しても、いたずらにキミの心配事を増やし、判断に支障をきたすだけだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "たとえキミの自己認識が指揮官であろうと、指導者であろうとな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君の決断の詳細を知らないのも、心配の種だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "艦内の人間について知らないことも判断を妨げる。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "だから私もこうして、私と医療部のスタンスや処置案をキミに隠していないし、早期段階でキミを本議題に招いたのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミの提案した、本検査対象に限り一部条約による制限を免除するという案については、このあと会議でその潜在的な危険性を挙げたいと思っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミのすべての疑問を晴らすには不十分かもしれないが、どうか私と医療部の意見を聞いてほしい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "皆の到着はもうすぐだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "俺の兄弟たちが今にも駆けつけるぞ！　テメェあんまり調子に乗るなよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "別に調子に乗ってなんかいないよ。あと君のお友達なら、多分もう来られないと思うけどね。先に寝ちゃったから、その隣のお仲間さんみたいに。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "というか、君たちに連れ去られた子供たちの方はそろそろ起きる頃なんじゃないかな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "あんな地下の小部屋に十何人も詰め込むなんて、寝心地が悪すぎると思わないかい。ちゃんと家に帰って寝なきゃね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "……テメェ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "ハッ、「家」、ねぇ。笑わせる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "家なんざどこにあるんだよ、あいつらに帰れる場所でもあると思ってんのか、ええ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "テメェのような派手な服着たリターニアのボンボンに、あのガキどもの暮らしが分かるかよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ん？　僕はリターニア人じゃないよ？　「ミヅキ」って言うんだけどね、極東の言葉にしては耳なじみする発音でしょ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "あぁ、それと「家」についての話だったら、僕は口を挟める立場だと思うけどな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "僕の家はね、小さい頃悪人に壊されたんだよ。君たちのような、他人から略奪する犯罪者のクズどもにね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "っ――……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "テメェのような小童に何が分かる。お、俺はガキどもを助けてやってるんだよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "何も分かっちゃいないようだな、あいつらがシンガスの手でこんな街に送られてきたのは何のためかをよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "ここでショーをやって、ボリバル人にリターニア文化に対するアイデンティティーを植えこむため？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "「この街の人間が衣食住に用いる製品はすべてクルビア人の物で、目耳に入るものはすべてリターニア人の文化だ。」",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "君たちのようなトゥルーボリバリアンの言い回しは、とっくに聞き飽きてるよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "ふふ、ははははは！　トゥルーボリバリアン、か……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "この街を選んだ人間は、初めからボリバルにアイデンティティーなんか持っちゃいないぜ。たとえ持っていたとしても、遅かれ早かれすり減って消えていくんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "ここに来る奴はよ、ボリバル人も、クルビア人も、リターニア人もみんな、「金」しか頭にないような*スラング*しかいねぇのさ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "お前は連中がリターニア人のミュージカルや詩を楽しむために、この街へやってくると思うか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "やつらはただ美しい声と顔を持った役者を物色して、宴席で自分の体面を保つのと、気晴らしのために使いたいだけなんだよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "けどリターニアのクソどもは最初からそれを承知の上で、ガキどもを使って自分たちのやりたいビジネスの便宜をはかろうとしてるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "ずいぶん事情に詳しいんだね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "詳しいさ、当然だ。俺らみたいなのも所詮は金持ち連中の見栄道具に過ぎないからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "金さえもらえりゃ奴らの後ろに控えて引き立て役にもなるし、番犬にだってなるさ。嫌でもそういうくだらねぇ事は目にする。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "あのガキたちも……大して変わらねえよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "お互いに苦しいって知ってるのに、君らはそれでもあの子たちを金稼ぎの道具にするんだね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "テメェの言う「子供たち」だって、ドッソレスの官僚や商人、富豪から財を搾り取ってるだろうが！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "よくもまぁ地面に這いつくばってそんな言い訳ができるよね。子供たちは他人を脅迫して、利益に換えるようなことはしないよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "な……何をする、来るな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "くそったれ、どうして動けないんだ！　テメェ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "君みたいな救いようのない悪人は、こうしなきゃ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "先刻、会議で説明した通り、彼はすでに別の生命形態へと変化している。ある種の、道を探して自身を造り変える生物だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミには理解して欲しい、生物が生存に使える資源は有限だ。一方でそうした生物は自身を造り変えるために莫大な資源を消費する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "今の彼らは制限された環境に閉じ込められており、同族を存続させるために自ら消費を抑制し、水面下で眠っているに過ぎない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "だがいつか、私たちと彼らは、生存に必要な一切を奪い合うことになるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "村を破壊する害獣を殺すように彼らの命を奪うかもしれないし、あるいは彼らの腹の中で養分になるかもしれない。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "本当にそうであるなら、選ばせる必要はない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "それでも君は選択肢を渡してきた。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミも気付いただろう。あれらの生物とは異なり、検査対象はその種のアイデンティティーから遊離し、自分なりの考えと戸惑いを抱えている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "でなければ、私たちもこんな話をすることはない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "この生物の進化というものは、本来なら一族の同類を発展させるべく道を選んでいくはずだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "だが、あの検査対象に限っては同類と呼べるものが全く存在しないこともあり得る。それは私たちでも、あの生物一般からしてもそうだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "やめろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "この人、この人は……僕と同類だ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "お、お前、どうやってここが分かった？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "……すべては僕が計画したことだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "何日か前の夜、僕はこっそり部屋を抜け出した。バーで酔っ払ったボリバル傭兵たちを見つけて、暗示のアーツを歌声に乗せて罠にかけたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "ホテルの護衛に魔が差して、あの爆薬を買おうとしたのも、僕が情報を漏らしたからだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "ってことは、僕が君たちを助けに来なくても……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "定刻に警察に情報が流れるよう事前に準備していた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "だから、もし彼を裁くなら……僕も共犯だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "ハッ、たかが歌唄いが……わざわざ追っかけてきて同情しようってのか、どうせ俺を笑いに来たんだろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "参ったなぁ。そもそもは君たちを送り返そうと思ってたんだ。じゃなきゃミュージカルのチケットが無駄になっちゃうからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "でも、もし君の言葉通りなら、このおじさんは果たして悪人と呼べるのかな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "けっ、何をブツブツ言ってやがる、このリターニアの犬め。さっさと俺を殺すなり切り刻むなり、好きにしやがれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "短気な傭兵",
          "text": "だがな、お前らリターニア人がそこの子供に手を出したり連れ帰そうとしてみろ、俺は死んでも化けて祟ってやるからな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "だから僕はリターニアから派遣されたわけじゃないってば……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "この人たちも、この街での生活と終わりのない争いに嫌気が差してたに違いない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "自分勝手な逃亡計画に利用したのは、とても申し訳なく思ってる……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "合唱団員",
          "text": "だけど彼らもきっと、僕と一緒なんだ……ただこの街から、自分の故郷から逃げたいだけなんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "ああもう、まったく……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "分かったよ。僕はもうこの件には手を出さない。じゃなかったら、まるでこっちが悪人みたいだからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "でもさ、僕には君の計画はこの一味の貪欲無しでは成功しなかったと思うな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "だから念のため、彼らにはやっぱりしばらく眠ってもらおう。その間に君たちは逃げるといい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "……この人たちは、僕が見張っとくから。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "たとえそれが真実でも、それでも……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "彼のことは自分がちゃんと見張るから。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミの能力を疑ったことはない、Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミなら、我々の考える「良い」方向へと、彼が自身を造り変えるように導けると確信している。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかし我々は、できるからといって、一人の人間をそうやって変えてしまうべきだろうか？　自分たちにとって、ある生存方法が正しいと思っているというだけで。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "そういったやり方は、自分が美しいと信ずる生命の在り方を実現させるために研究対象を改造する者と、どこが違うのだろうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "これは質問ではないのだが、Dr.{@nickname}、教えてくれ。キミは「自分の生命の形態がより優秀だ」と考えたことはあるか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼には選択の自由を与えたい。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "少し傲慢に聞こえるかもしれないが、選択権を持つのは往々にしてすでに贅沢なことだ。ましてや、与える側は言うまでもない。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "だが確かに、自分の能力が足り得るからといって他人に干渉するよりはましだ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "彼の考え方に干渉するつもりはない。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "人と人は常に関わりを生み出す。たとえ自ら望んでいなくとも、言葉を用いなくともだ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "オペレーターとして接すると決めた時点で、キミと彼は互いに影響を及ぼすことが運命付けられる。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "自分の行いには責任を持つ。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "それは私が最も聞きたい、同時に最も案じている答えだ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "オペレーターたちはキミを信じ、敬愛し、任務中はキミに命を託している。キミが勇敢に立ち向かうからであり、それはキミにしかできないことだからだ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "日に日に積み重なる重責を、キミが背負っていけることに疑いの余地はない。だがいつの日か、それらが矛盾をはらみ、軋轢を生じ、望まざる選択を迫られる日が来るかもしれない。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかし、キミがやろうと決めたなら、私もこれ以上止めはしない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミの配下のオペレーターに、私がいつも言っている通りだ。一度キミを認めたなら、もうあれこれ心配するな、とね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "余計な心配は、任務を含めた計画執行の妨げになるし、それにここは多くの者が暮らす家だからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "行こうか、Dr.{@nickname}。キミを信用している者を外で長く待たせるわけにはいかない。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "あ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "ドクター。ケルシー先生が、今日から僕はドクターの配下になるって言ってたよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "相変わらず、正式なオペレーターとしては認められないみたいだけど……ドクターが手伝ってほしいことがあれば何でも力になるからね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ああ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ミヅキ",
              "text": "なんだか適当に聞こえるな。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ミヅキ",
              "text": "……ドクター、まだ難しいことを考えてるの？　それとも、僕の考えすぎ？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ミヅキ",
              "text": "どうしたの、ドクター？　何か心配事？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ミヅキ",
              "text": "トラブルにあったなら、なんでも僕を頼っていいからね？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "自分も君が正式採用されるよう努力しよう。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ミヅキ",
              "text": "ん？　ドクターは、そう望まれるのかい？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ミヅキ",
              "text": "僕としては、どんな形でドクターの側にいても構わないよ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "それと、ドクター。僕のこと、そんなに心配しなくてもいいからね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "ケルシー先生が言ってた厳しい条約と制限は、全部僕の情報と安全を守るために決めてくれたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "それよりさ、ドクター……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミヅキ",
          "text": "自分の選択に、責任もってね？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "ひょっとして、そんな言い草で十分な……同情が買えるなどと、誤解されていませんこと？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "もちろんそうじゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "キミの陸地に対する調査はいずれ陸上の助けを必要とする。そして水面下の敵との戦いも、遅かれ早かれ陸上側の課題となるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "それに関して先行するロドスの独走に干渉しない限り、キミと条件を話し合ってもいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "すでに行っている情報協力に加え、そちらが奴らの陸上での足取りを掴んだら、我々も最大限キミたちを支援しよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "それは単に邪悪な生物に堕した無知な個体を庇うためですの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "有り得べき未来のために、だ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
