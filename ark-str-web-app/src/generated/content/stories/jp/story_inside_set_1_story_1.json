{
  "server": "jp",
  "storyId": "story_inside_set_1_story_1",
  "groupId": "story_inside_set_1",
  "stageId": null,
  "title": "極秘任務",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_inside_1_1.txt",
  "sourceHash": "83718e383e3f183efaddac2975c60a45b685bcc24ee11e6ce9a406ed98276726",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "先輩、手続き終わりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "ああ。お疲れ様、新人君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "やるべきことをやったまでです。それで、ご老人の容態は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "（無言で首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "病室内で私たちにできることはもうないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "そうですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……この場合、俺たちの任務はどうなります？　執行人としては、これから代わりに遺言の執行に取りかかる段階ですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "ええ。それが私たちの主な仕事でもあるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "遺言といえば……リケーレ、気を付け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "は……はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "うん、それでいいわ。仕事の時は気合を入れないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "本来なら、初任務のあなたにこんな大きなプレッシャーを与えるべきじゃないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "リケーレ、これより極秘任務を授ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……極秘任務、ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "そうよ。これを受け取りなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "先達の執行人は、封がなされたファイルと付箋を取り出し、続けて付箋を一枚はがすと、そこにとある住所を書き込んだ。\n一連の作業を終えると、彼女はそれらを新人に丁寧に手渡した。"
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "もうあまり時間がない、今すぐ出発してちょうだい。必ず本日中にこの書類をここの住所に送り届けるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "先方で迎えが待っているはずだから、その相手に渡してくれればいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "先輩、このファイルは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "私の口からは何も。いい？　一人前の執行人になるには、機密保持は絶対よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "けど一応言っておくわね。この任務は極めて重要よ。このファイルには……ラテラーノ全体を混乱に巻き込むほどの力が秘められているの……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……ラテラーノ全体を混乱に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（マジかよ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "そういうことだから、頼んだわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "って待ってくださいよ、先輩！　それほど重要な任務を俺みたいな新人に任せていいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "そ、それよりも、先輩自ら行った方が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "それは無理よ。私にはほかの緊急任務があるから、これはもうあなたに任せるしかないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "大丈夫よ。公証人役場の選考をパスできたってことは、あなたには十分な実力があるってこと。今こそその力を発揮する時よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……これってもしかして、公証人役場の本採用審査みたいなものですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "審査？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "うーん……まあそうね。この任務を無事に終えることができれば、あなたも立派な執行人よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "わかりました、そういうことなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "では、すぐに出発します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "ええ、道中十分に気を付けてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ハハ、せいぜい頑張ります……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "幸運を祈ってるわ、新人君。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（この住所……郊外みたいだな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（ルート的にはこの大通りを抜けて、表通りをずっと進むのが一番早いが……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（そのためには――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "これ知ってる？　ステファン区に新しくできたお店のドーナツ。街で一番美味しいと評判なんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "今朝わざわざ並んで二つ買ってきたの。食べてみて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "おっ、それなら前に食べたことがあるぞ。美味しいっちゃ美味しいけど……うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "けど？　何もったいぶってんの。言いたいことがあるなら早く言いなさいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "いやー、俺的にはダリアンおじさんの作るドーナツの方がやっぱ上かなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "一度食べたら、いつまでも忘れられない味なのさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "そんなに美味しいの？　ホントかなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "ちょっとそこのお兄さん、このドーナツ食べてみてくれない？　今まで食べた中で一番美味しいかどうか教えてほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "えっ、俺に言ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ごめん、ほかの人に頼んでくれないかな、今急いでんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "あ、待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "そんなに時間は取らせないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "執行人見習いは無意識に手を伸ばしかけたが、すぐさまそれを下ろした。\nそして、表情を作り直す。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ほんとごめん、マジで急ぎの用なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "そんじゃ、通してもらうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "ああ、待って……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "（チッ、足速っ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "（逃がすわけにはいかない、追うぞ！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "ハァ……ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "あたしもう、ダメ……あいつ……どっちへ行った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "ハァ……フゥ……俺に聞くなよ。てか、なんて足の速い野郎だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "だから、あんな手じゃ通用しないって……言ったでしょ！　何が……ハァ……雑談してるふりして近づけば大丈夫、よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雑談する通行人",
      "text": "強引に引き止めて、直接奪った方が、ぜったい早かったって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "文句言ってる場合か！　もう……ハァ……もうほかの連中には連絡したから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぶらつく通行人",
      "text": "……引き続き追うぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……やっぱ俺を狙ってたんだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ふむ……正確には、俺が持ってる「何か」が目的なんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "目をつけられるとしたら、どう考えてもこの機密文書しかないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "心の準備はしちゃいたが、まさか初っ端から狙われるとは……しかし妙だな、なぜひと目で俺だとわかったんだ？　明らかに待ち構えてる風だったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "さっきの話を聞く限りまだ仲間がいそうだが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（……！　今度は誰だ？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー",
      "text": "こんにちは、ちょっとよろしいですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー",
      "text": "先ほどこの辺りで強盗事件があったとの通報を受けたのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー",
      "text": "不審な人物を見かけませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "いや、たまたま通りかかっただけなんで。知らないすね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（また俺が通ろうとしてた道に……こいつも待ち伏せか……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー",
      "text": "しかし、周辺の状況を見る限り、現場を目撃した可能性があるのはあなたしかいません。申し訳ないのですがご協力のほどを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "すまん、急いでるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー",
      "text": "ちょっと、待ちなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの修道士",
      "text": "お待ちください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの修道士",
      "text": "何やらお困りのようですが、お手伝いできることはございますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（また出やがった。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "えーっと……困ってると言えば、まさに今のこの状況に困ってるんだよなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "俺はマジで急いでるんだ。他に用がないなら失礼させてもらうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー？",
      "text": "待ちなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの修道士？",
      "text": "このまま行かせるわけにはいきませんね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……ハハ、こりゃどういうつもりだい？　お二人さん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの修道士？",
      "text": "とぼけないでください。私たちの目的はよくおわかりでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの修道士？",
      "text": "その手に持っているものをこちらに渡しなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（おっとこいつは……ったく、参ったな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（にしても、この二人からはそんなに敵意は感じられない。一体何なんだ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "はぁ、いずれにしろ、これは新しい職場で任された初仕事……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ここでヘマして終わるわけにはいかねぇよな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー？",
      "text": "やる気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛隊メンバー？",
      "text": "ならば、公証人役場の執行人の銃さばきがどれ程のものか、見せてもらおうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "それはちょっと。街なかで騒ぎになるような事態はできれば回避したい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "それに、あんたらが相手なら、素手で十分だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "リケーレ、ここのところの護衛隊での働きぶり、よく聞いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "兵士として、非常に優秀な成果を挙げているようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "お褒めに預かり光栄です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "……兵士であるだけで、満足しているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "と、言いますと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "お前は確かに自分の仕事をよくこなしている。だが、ラテラーノは兵士には事欠いていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "我々も単なる兵士が欲しくて、あのシラクーザの辺境の町からお前を連れ帰ったのではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "お前から見て、ラテラーノはどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……ラテラーノは……すごく良い国だと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "想像より何倍も良いところです。生活の豊かさだけじゃなくって、ほかにも……そうですね、ここにはある種の秩序があって、みんなその中で規則正しく生活をしてます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "戒律のことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "恐らくそうかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "街のオブジェなんかを爆破したがる人はしばしば見かけるし、その見物を喜んでするような人も大勢いるみたいですが、それはどれも悪さをしようと思ってのことではなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ええと、俺が言いたいのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "人が死んだり、怪我したり、街全体がめちゃくちゃになって、生活に支障が出るような悪さじゃないという意味です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "俺、好きです。ここの暮らし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（……さすがにもう追ってこないよな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（ゴミ箱ん中にぶち込んじまったけど、大丈夫だろうか。まあ少なくともどっちも生きてたし、大丈夫か、うん……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（極秘任務に強奪騒ぎ……ハハ、まさにこれが本当のラテラーノ人の生活ってやつ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（配属後の初任務でもうこんだけ色んなことに出くわすとは……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（教皇騎士殿に頼んで、護衛隊に戻してもらおうかな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（そんじゃさっさと送り届けて、それからすぐに……ん？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……まだ居んのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "と、止まれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "ここを通すわけには……えーと、いや、その、とにかく止まれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "それを渡すんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（専門的な訓練を受けてるようには見えないし、辻強盗にしちゃ甘すぎるだろ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（それとも油断を誘うための演技か？　いや、なんか引っかかるんだよなぁ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "すまん、あんたの言う「それ」って……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "君が持ってるそのファイルに決まってるだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "そうか。なら悪いが、応じられないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "なんせこれを送り届けるのが俺の役目でね。解ってくれるとありがたいのだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "……こっちにも、譲れない理由があるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "どうしても差し出さないっていうのなら、悪く思わないでくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "おい！　いきなり手を出すのはナシだろ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "くっ……！　放せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "悪い、それも無理な相談だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "にしても今の攻撃、随分とへなちょこだったな。下半身は安定してないし、パワーも足りてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ラテラーノの基礎教育課程には格闘術の授業があると聞くが……お兄さん、それでよく卒業できたね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "うるさいな、及第点が取れれば認定はもらえるんだよ！　どうせ危険な仕事に関わる気もなかったし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "あーもう放してくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "危険な仕事に関わる気がない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "執務中の執行人を襲おうとして、返り討ちに遭った後に吐くセリフとしちゃ、少々説得力に欠けると思うが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "こうしよう。あんたらを送り込んだのが誰なのか、それを教えてくれたら解放してやるよ。どうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "それは……言えない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "君は全然わかっていない、その手に持っているものが何なのかを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "「ラテラーノ全体を巻き込む」何か、ってのは聞いてるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "大方、武器の設計図か何かだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "そう言っても、間違いじゃないが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "とにかく諦めろ、僕は何もしゃべらないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "まさにその通り。それこそ、ラテラーノが他国とは異なる要因だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "ラテラーノはかように特殊と言うが、では、お前自身はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "俺自身？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "俺はサンクタなので……一応、ラテラーノ人ではある、と思いますけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "それだけでは足りぬな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "……うむ、リケーレ、お前は公証人役場に入るといい。私が推薦状を書いてやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "傍観者としてだけでなく、自分の身をもって体験してみろ。本当のラテラーノ人の生活とはどういったものなのかをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "本当のラテラーノ人の生活……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "お前ならきっと気に入るはずだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ここまで来るのに時間がかかり過ぎた。巻きでいかせてもらうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ラテラーノに居るんじゃなかったら、もっと手っ取り早く片付ける方法もあったけどな……本当は回りくどいやり方があまり好きじゃないんだよね、俺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "……ど、どういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "こういう意味さ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "腰から銃を抜き、執行人見習いは残念そうな顔でそれを相手の眉間に押し当てた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "折角のいい天気なんだ。本当はこんなことしたくなかったなって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "はい、こちら中庭公証人役場、ご用件をどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "この前のご依頼……？　私どもの執行人が取りかかっており、本日中に完了する予定ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "……予期せぬ事態が起きた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "わかりました、すぐに対応いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "ご安心ください。たしかに担当の執行人は新人で、まだまだ精進が必要です。しかし彼なら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "きっと、やり遂げてくれるでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "……何ともない……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "わぁ！　く、崩れる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "あいつ……銃で支柱をぶち抜いたのか！？　無茶苦茶すぎる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "痛っ……危うく腕を折られるところだった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "もしもし、僕だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "僕も失敗したよ、止められなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "はぁ……だから言ったじゃないか。どうやったらこの僕が執行人を止められるっていうのさ、ましてやものを奪うなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した青年",
      "text": "でも、もうこんなに頑張ったんだし、ダリアンおじさんだってきっと勘弁してくれるよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（あっぶねー、殺っちまうところだった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（ここはラテラーノ……もう前と同じことはできないんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（……ふぅ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（……目的地はもうすぐだ。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "失礼します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "あら、ごきげんよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "（ほかに誰もいないし、この人で合ってるよな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "あの、遺言の受取人の方ですか……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "ええ、そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "わざわざ届けてくれてありがとね、お兄さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "いえいえ、これが私の仕事ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ではご依頼通り、こちらのファイルをお受け取りください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "中に何が入っているか、気になりはしないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "それは……とても重要なものだと伺っています。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "そうよ……とても貴重で、大切な宝物よ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "であれば、私が知るべきではないかと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "あら、物事の価値というのは、それを知っていたり持っていたりする人の数で決まるべきじゃないと思うけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "そうね、そろそろみんなが集まってくる頃だから、揃ったときにこの中身を読み上げるとしましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "読み上げる！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "ふふ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "お兄さん、先に見てしまっても構わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……本当に、よろしいんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "もちろんですとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "卵1個、砂糖大さじ3、イースト適量……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "小麦粉1カップ……メープルシロップ大さじ2……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……ドーナツのレシピ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "ええ。素晴らしいレシピ、そうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "うちの人ったらね、当時この秘伝のレシピを持って私にプロポーズをしたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "あの時、私の家族や友人があの人を追いかけて行く手を阻んだわ。たどり着いた時にはもうボロボロでね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ご婦人の旦那さんが……今回の依頼人ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "（小さくうなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "私たちには子供がいなくてね。もちろん、それは私たちにとっては残念なことでも何でもなかったわ。二人で一緒に過ごした日々、それだけで十分幸せだったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "ただ、私たちがいなくなった後、このレシピの味がラテラーノから消えるのはどうしても嫌でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "そういうことでしたら、執行人にまで内緒にする必要はなかったのでは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "道中追っかけてきたり、行く手を阻む人たちもその一環だったということですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "ふふ、主人の最後のわがままと思って、許してやってくださいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "きっと、あの人は私が何も知らないと思って、サプライズしようとしてくれたんでしょう。最後はみんなの祝福の中で、このレシピを残したいと思ったんじゃないかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "そうだわ、ドーナツを作ってあるのよ。あなたにはぜひ食べてもらいたいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上品な老婦人",
      "text": "きっと気に入るはずよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "お疲れさま。どうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "ごめんね、本当のこと教えてあげられなくて。それも依頼人の遺言の一部だったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "先輩……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "やっぱりよくわかりません、ラテラーノ人はどうしていつも必要のないことばかりするんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "あなた、前に甘いものが好きだって言ってたわよね？　もちろん、嫌いな人なんてラテラーノにはほとんどいないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "ちょうど、依頼人のお爺さんの耳に入ったみたいでね。それで、ぜひあなたにあのレシピを送り届けてほしいと指名してきたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "よかったらレシピを覚えて、時間があるときにたくさん作ってくれたら嬉しいってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "これがラテラーノ人なのよ。この仕事を続けていけば、これからもこういう場面に遭遇することになるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "どう？　この仕事が嫌いになったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "……いえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "とても気に入りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "あはは、ならよかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "text": "依頼達成おめでとう、新人君！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
