  "sourceHash": "ca103eacb3ff0e3f066574ecfec766ec8ddb373aef9f02c38b755d3fe2e37d4d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第九关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "よし……なんとか振り切ったようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "この調子で進めば、じきにこのエリアも抜けて、南側の出口まで辿り着けそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……それにしても、進むにつれて辺りが騒がしくなってきたようだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "大方、チェルノボーグを離れようとした市民たちが、レユニオンと衝突しているのだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ふむ。どうやら、チェルノボーグとの連結を切って、離脱した区画もあるみたいだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "そっちに乗り遅れた連中が、レユニオンともめてる……ってとこだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "俺の記憶じゃ、大きな広場だったはずだ。しかし今となっちゃ「広場だったもの」って感じだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "……感染者を虐げ続けたこの都市が、ついに報いを受けた……ってわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……Ace、お前――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ここで、なにかあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ああ、いや。……昔の話さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――空が……ますます暗くなってきましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "空気も、なんだか……焦げたような匂いがしますし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "市民",
      "text": "な、何をする――ひっ！　や、やめてくれっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "黙れッ、お前らが悪いんだ！　俺たちの怒りを思い知れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市民",
      "text": "うっ……うわあああっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "————!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "今の声、民間人か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……私にも聞こえはしたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "あの声の主が何者かまではわからんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――待ってください、あれは……レユニオン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "誰かを攻撃しているようです！　助けに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "待て！　この地形では、優位に立つのはまず無理だ。……非情なようだが、俺たちも無理を通せるほどの余裕はないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "――いいか、アーミヤ。確かに、命は大切なものだ。しかし、お前自身の命にも、同等の価値があることを忘れるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……っ、Aceさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "――！　奴ら、トドメを……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "チッ……なんにせよ、あれではもはや完全に手遅れだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……これ以上気にかけてはやれん。我々も、未だ危機的な状況にあるんだ。先を急がなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……皆、聞いてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――悪い知らせだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "行くぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――奴らを、皆殺しにしてやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――レユニオンの部隊に、広場の出口をすべて塞がれた！　気をつけろ……！　こちらへ向かってくるようだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "やるしかないか……！　全員、構えろ！　応戦するぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
