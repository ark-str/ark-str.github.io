{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_03_end",
  "groupId": "act12d0",
  "stageId": "act12d0_03",
  "title": "昔話",
  "storyCode": "RI-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_03_end.txt",
  "sourceHash": "33cbbc8c76083fb611d604ac20de6252dc41c5ed70eeb0fce09fbfe2e6bb948a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "あの変なガキったらすげぇな！　もう何人も倒したぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "わけわかんねぇこと言ってるが、大したヤツだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "あいつが大族長になるのも悪くねぇな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……ガヴィルさんの仲間、ほんとに強いですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ああ。戦闘では頼りになる。こういう時の悩みのタネでもあるんだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ようやく落ち着いてきたな、そろそろアタシがケーちゃんを黙らせるとしよう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "text": "なんだ、レユニオンめ、また来たのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "text": "ドクターを攫ったのはお前たちだったんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "text": "逃げるなー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おいちょっと待て！　どこ行くんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "アタシが追う！　トミミ、お前はドクターと一緒に待っててくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "あっ、また次の戦いが始まりましたね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "……ドクター、ガヴィルさんは外ではどんな感じなのか、教えていただけませんか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ガヴィルのロドスでの暮らしは――",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "ガヴィルさん、外でも元気に過ごしているんですね。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "もしかしてドクターは、ガヴィルさんとはそんなに親しくないんですか？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "よかったー！　あっ、いえ、すみません。ドクターはガヴィルさんと一緒に来ましたし、ガヴィルさんもドクターのことを気に入ってるようだったので、てっきり仲良しかと……",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "でも大丈夫です。ガヴィルさんは優しい人ですから、きっとすぐに仲良くなれますよ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "ガヴィルは医者として――",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "よかった、お医者さんになっても、やっぱりガヴィルさんはガヴィルさんなんですね！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "昔と全然変わってなくて……なんだか嬉しいな……",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "あの、変なことを聞くんですが、もしガヴィルさんがドクターの下から離れると言いだしたら、どう思いますか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "悲しいだろうな。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "やっぱりそうですよね。私もあのときはいっぱい泣きました……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "ど、どうして黙るんですか！　ガヴィルさんみたいな素晴らしい方がいなくなる事を想像して、なんで落ち着いていられるんですか！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "新しい道が見つかったことをお祝いするかな。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "ドクターはすごいですね……私にはできません。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "私は……ガヴィルさんに帰ってきてほしいって、ずっと願っているんです。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ドクター、その、ガヴィルさんに関しては、わ、私、絶対に負けませんから！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "頑張れ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（頷く）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "こっちも負けないぞ！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それで話の続きだけど、ガヴィルが戦った祭典の結末は？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "あのときは……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "なんだ、大人も案外大したことないんだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "まだアタシに挑戦したいヤツはいるか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人A",
          "text": "大人をこんなにあっさり倒すとは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人B",
          "text": "大したもんだな、ガヴィルは！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人C",
          "text": "もしかしたら本当に大族長になっちまうんじゃねぇか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "私がやる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "なんだ、お前かよ、ズゥママ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "大好きな機械いじりはもういいのか？　ったく、アタシが訪ねてもいつも無視するくせによ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ズゥママ",
          "text": "……最後に、試したくなったんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "試すってなにを？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ズゥママ",
          "text": "私の拳で、お前を倒せるかどうかを。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "なに遺言みたいなこと言ってんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ズゥママ",
          "text": "黙れ。今日は絶対負けないぞ、ガヴィル。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "へっ、やってみりゃいいさ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "結局、昼から夜まで戦っても、勝負はつきませんでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "最後には二人ともそのまま力尽きてしまって、他の人たちに祭典の舞台から放り出されました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "これがガヴィルさんが初めて参加した祭典での出来事です。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ズゥママってどんな人？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ズゥママは、当時は近くに縄張りを持っていた部族の人です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "小さい頃、ズゥママは毎日のようにガヴィルさんと喧嘩をしていました。もちろんガヴィルさんのほうが強かったんですが、ズゥママも殴られっぱなしだったわけではありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "しかしある日を境に、彼女は喧嘩をきっぱりやめて、機械弄りに没頭し始めたそうです。ガヴィルさんがそう言ってました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "そして祭典のあの日が、ガヴィルさんとズゥママの最後の喧嘩になりました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "その後ズゥママは、みんなに顔を見せることすら稀になりました。それから彼女の部族は引っ越してしまって、以来、私は彼女を見ていません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさんが出て行く前に乱入した祭典にも、ズゥママはやって来ませんでした。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ただいま。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさん！　おかえりなさい。大丈夫でしたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ。しかし足が速いなぁケーちゃんは。一瞬で消えちまった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "でもあれだけ強けりゃ、心配する必要もないだろ。トミミ、ズゥママは来たか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "まだです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人",
          "text": "他に挑戦者はいるか！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "私が出よう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "おっ？　ちょうどいいとこに戻ってきたみたいだな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
