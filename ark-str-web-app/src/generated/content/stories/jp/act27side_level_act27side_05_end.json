{
  "server": "jp",
  "storyId": "act27side_level_act27side_05_end",
  "groupId": "act27side",
  "stageId": "act27side_05",
  "title": "虹を歌おう",
  "storyCode": "SL-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act27side/level_act27side_05_end.txt",
  "sourceHash": "fee78a668049f5520df92ba925f9ed41037a03f16c92fa83e12b409575399853",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "どうしてお前さんがまだここにおる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あなたたち全員からサインをもらうまで、私は砂浜のハガネガニのようにここに居座りますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "そうかい、好きにするといいわい。わしは店じまいして帰って一杯やるとするかのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "どうぞご自由に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "今日はあのマーケットで目新しいもんを買ってのう。「源石マイクロウェーブマッサージ器」とか言うらしい。クルビア製で、ようわからんが、なかなか良くてのう。腰につけると気持ちええんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "新しいものを試してみるのは、悪いことではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "長毛の循獣が屋上でサーフィンをやっておったが、あのショーもお前さんたちが用意したものか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "循獣？　いえ、心当たりは全く……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "そりゃ残念じゃ。あれはなかなか面白かったんだがのう。黒曜石祭がなくなってから、あんな面白いショーを見ることはめったになくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "喜んでいただけて、幸いです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "そうだ、コイツをやろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……カリンバ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "昼間マーケットで買ったものですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "結婚祝いじゃ、小僧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "家族のために安定した仕事を見つけたんじゃろうが。少しばかりつまらん奴になったが、責任感はあると言えるのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "安定を好むのも理解できる。じゃが生きる道は常にたくさんあるものじゃ。あんまり一つのことに固執して、自分を粗末に扱うなよ小僧。息が詰まるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "人は生きているだけで息が詰まるものでしょう……周りの環境に適応していくしかありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "昔はお前さんの爺さんと賭けをしたもんじゃ。お前さんはいつか黒曜石祭で大賞を取って帰ってくるってのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "まったく……あんなに、素晴らしい音楽の才能を無駄にしおって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "聞いてくださる気があるなら、古いギターを引っ張り出して、また弾きますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた店主",
      "text": "もしお前さんがさっさとギターを持ってきて弾いてくれれば、わしもとっくにその紙にサインをしてやってたかもしれんのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ヘイリーさん、お店のサーフボードを取り戻してきました。揃っているか確認してもらえますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "本当にごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "あんたは手伝ってくれたんじゃないか。どうして謝るんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "ビーチもない場所じゃ、こんなガラクタはもう役に立たないと思ってたんだけど。おかしなもんだよ、一体誰が持って行ったんだろうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "うぅ、それは、私にもよく分かりません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "大丈夫だよ。テンションが上がり過ぎた観光客が、つい持って行っちまっただけかもしれないしね。返ってきたならいいさ。そんであんたは？　今日は楽しめたかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エニス",
      "text": "それ、温泉でずぶ濡れになったことを言ってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "旧シエスタの時の水遊びの感覚を、ちょっとは思い出せたんじゃないかい？　こんなに騒がしいのは久しぶりだよ、酒を飲みに来た客までみんなニコニコしてたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "ここんとこ、この商店街の連中は毎日浮かない顔してて、酒もまずくなっちまってたんだけどね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヘイリーは店の外のいまだ去っていない観光客たちを眺めた。夕日が少しずつ空を赤く染める中、誰もが満足そうな表情をしている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "何年も前に戻ったみたいだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は、時代を感じさせる佇まいのカフェへとゆっくりと歩み寄り、かつて何度も繰り返したようにドアを押し開けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は手探りでブレーカーを上げた。バーカウンターに積もった埃を雑巾で丁寧に拭き、棚から器具を取り出すと、オフィスから持って来た新鮮なコーヒー豆を懐から取り出した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "身に染み付いた動作で、何年も前と同じように湯を沸かし、豆を挽いて、慎重にお湯を注ぎ入れる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "この味……やっぱり、腕が落ちたな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男が窓の外に顔を向ける。暮れなずむ夕日の中で家路に就く人々の波が見えた。そうして日が落ち、通りに誰一人いなくなった頃に、ようやく彼は自嘲気味な苦笑いを発した。"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ったく……俺は一体何を待ってるんだろうな。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼はコーヒーを飲み干すと、道具を片付けて去ろうとした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その時、ドアをノックする音が聞こえた。だが、自分はドアを閉めていなかったはずだとコスタは思った。"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……誰ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "こんばんは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "まだ営業しているかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ドリーさん、本当にちびめーちゃんたちに、もうこんな騒ぎを起こしちゃダメだって、ちゃんと言ってくれたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "うん……まだ悪戯をするようだったら、彼らがわたしの一部であることを否定するよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぼうっとした生物",
      "text": "（空中で転がる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る生物",
      "text": "（通りの壁に突進する）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……ドリーさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "分かったって。頑張るから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぼうっとした生物",
      "text": "（落ち着いた動きで歩こうとする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "ね。だいぶマシになったでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "今はそうかもしれないですけど、今日の博覧会でこの子たちは大きな混乱を起こしましたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "でも空気は楽しい味ばっかりだったよ。うん、今でも甘いもん。この感覚は、わたしが初めてキミたちの言う「国家」ってやつの間を行き来した時と同じだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "山の多い場所じゃ滑空して遊べるし、水のある場所ではサーフィンができる。荒野でうざったいガキんちょに追いかけ回されたりもしてたんだよ。しかも場所ごとに、作ってる物も違うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "色んな所を簡単に巡ることのできないキミたち人間からしたら、こういう体験は物珍しいでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……なんだか、ドリーさんが自慢してるように聞こえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "バレちゃったかぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "じゃあキミは今日どうだったの、アデル。温泉でリラックスできたかな、サーフボードは刺激的だったかな、あのやかましいペンギンの騒がしい音楽で、テンション上がったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "そうだドリーさん、小さい子たちには、ちびめーちゃんが見えてたんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "はぁ、キミに楽しい気持ちになってもらうのは、どうしてこんなに難しいんだろうね？　空気に、またあの「悲しみ」の苦くて渋い味が混じってきたよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アデルはドリーから顔を背けてこっそり笑うと、またすぐに真面目な表情になった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ドリーさん、着きました。「展示品は見つかりました、わざわざ気にしていただいてありがとうございました」って、店主さんに書き置きを残してきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "たしか、紙とペンはカバンの中に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あれ、このカフェ……またオープンしたのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薄暗いライトの光が部屋を満たしている。窓越しに、カフェの中の装飾品がかすかに見えた。\nコスタがお湯を注ぐ音が、彼と客との間の沈黙を裂いた。\n蒸気が窓を覆っている。アデルがガラスに付いた温泉の白い湯気を軽く拭うと、ようやく客人の姿をはっきりと見ることができた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "入らないの？　コーヒーを飲むつもりだと思ったんだけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……ケラー先生？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "『テラ火山地誌』は受け取った。あれは君からだろう？　まさか長年大切に保管していてくれたとはな……感謝するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ああ、俺が頼んだんだ。ちょうどヴォルケーノミュージアムの展示品だか何かを探している子がいたから、その子に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あの女の子は君のところの従業員なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "アデルは私の教え子だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あっ、教え子か。そうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "君は今……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……惨めなシティホールの職員だよ。今はこの通りの住民たちから移転同意書のサインを集めているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "ここには、私の両親が残した小さな衣料品店もある。君のその話を聞くに、私も同意書にサインしなければならないわけだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "じゃあ君は……ここの再建に何か異議はあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "うちは、もうずっと前に衣料品店の商いで生計を立てることをやめている。もし、同意書へのサインが君の仕事にとって都合がいいのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "もちろんさ。協力に感謝するよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "コーヒー飲むか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "以前のような話し相手のサービスは、まだやっているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "一人前のバリスタは、客の話を聞くことも仕事の一部さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "じゃあ、座ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "もう行きましょうか、ドリーさん。書き置きを残すにはタイミングが悪いみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "えー、でもいい匂いだよ。コーヒー飲まないの……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る生物",
      "text": "（カフェに突っ込もうとする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "えっ……ちょっと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "衝突は閉じられたガラスのドアに遮られた。想像していたほど大きな音は立たず、ドアに跳ね返された羊は後ろ向きに回転して、そのまま道にまで転がり落ちた。\nアデルは緊張しながら、店内の二人の反応を観察していた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あの時は、どうして急にいなくなったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "出会いがあったんだよ。二人の……とても面白い人たちと会った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "それに、火山の研究をしたいなら、より沢山の場所を訪れないといけないものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "たしか、その人たちとはよくここで会っていたよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "ああ、あの二人が来るたびに、君はエレキギターで騒がしいヘビーメタルを演奏していたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "マグナはずっと「カフェのあの男の子」は、自分たちをあまり歓迎していないと思っていたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あー……あの頃の俺は、好き勝手やってたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "別にあの人たちに向けたものじゃなかったさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "分かっている。あの二人も本気で気にしてはいなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "君は二人にコーヒーサイダーを提供していたよな。しかも、モッキンバードお爺さんには秘密にしてくれと言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "爺さんは俺のオリジナルドリンクをちっとも認めてくれなかったからな。メニューに加えるたびに消されたよ……爺さんにとっては、俺のエレキギターやドラムと同じくらい変に見えてたらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ついでに言っておくが、あれはただのコーヒーサイダーじゃないからな。「ヴォルケーノコーヒー」っていうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "はいはい、「ヴォルケーノコーヒー」な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "ともあれ、あれの味は悪くなかった。リターニアに行ってからも、カティアはよく君のレシピ通りに、自分で再現していたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ところで、カティアさんと……マグナさん……二人は今どうしてるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "たしか、シエスタを離れる前に、二人と一緒に大地の火山を全て踏破するんだって君は言っていたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "旅をする中で、私はあの二人と長い間行動を共にした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "……しかし数年前、二人とはぐれてしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "はぐれた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "そのうえ、二度と会うことはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "それは……？　すまない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "だから私はここに戻ってきて、あの博物館の建設に着手したんだ。二人の当時の研究の全てを残したいと思ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あの日、博物館で君に会ったのは、全く……全くの予想外だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "私だって驚いた。記憶の中のあのやかましい人物とは、印象がすっかり変わっていたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "お互い様だろう……今はもう博物館の館長なんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "ああ、かつての理想は実現できたと言えるだろう。ただ、今の私の足取りを支える信念は、最初とは少し異なるがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "だが、変化も悪いことばかりではない。違うか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "バリスタと客はしばらく黙り込み、客の方はカップのコーヒーを軽くかき混ぜた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "今日の博覧会には行ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "行ったよ。観光客が増えて、店主たちも大喜びだったな。以前のシエスタのようだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "この場所を建て直し、観光客がまた増えれば、俺も将来について何か新しい考えが浮かぶかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "たとえば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "さあな。多分カフェを続けるか、でもロックカフェだな。それか楽器屋か、店の中はドラムとエレキギターでいっぱいのな。こういうのが好きな人はいるもんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "君の言った通り……以前のシエスタのように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "そうだ、今日は一つとても面白いことがあったんだ。あの商品博覧会で、「ヴォルケーノコーヒー」と全く同じレシピのクルビアの飲み物を見たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "言っておくが、私は君のレシピを漏らしたりしていないからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "違う、違う。一年前にこの店を閉めようと思った時にな、他の人にも「ヴォルケーノコーヒー」のレシピを教えたことがあったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "まあ、レシピって言っても……コーヒーにサイダーを加えるだけだしな。当然クルビア人が自分で発明した可能性だってある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "ドリップコーヒーにサイダーを加えるなんて、当時の君はどうやって思いついたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "若い頃はコーヒーが苦くて、何か入れないと飲めたもんじゃないって思ってたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "店内で得意げにロックをやる君でも、苦いのは嫌いなんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あの時は、そんなことまで気を使ってられなかったな。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ケラーは笑い、最後の一口を飲み干した。コーヒーの香りが店内に漂う。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "次の一杯は、サイダーを入れるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "いいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケラー",
      "text": "だがそれを飲んだら、今夜は恐らく眠れなくなるだろうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "アデル、先に言っておくけど、わたしは言ってあったんだよ。でもこいつらはどうしても、今すぐにこのお店に入りたがってるんだ。多分ヴォルケーノコーヒーを飲みたいんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "だから、これから生まれるだろう店主の損失の埋め合わせとして今日の博覧会の商品を一つ代わりに置いておくよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……博覧会の商品？　どこで手に入れたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "可愛い子供がいてね、わたしにくれたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "ほんとだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あっ！　今は入っちゃダメです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る生物",
      "text": "（隅に入り込む）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼうっとした生物",
      "text": "（箱をひっくり返す）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "落ち着きのない羊たちは、アデルの周りにある雑貨の中からガラス瓶の入った箱を引っ張り出し、興味津々に何かを漁っている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "最終的に彼らはサイダーのビンから取った金属キャップを口にくわえた。それはまるで宝物を得たような様子だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……どうしたんですか？　サイダーが飲みたかったんじゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "羊たちはぴょんぴょんと跳ね、めいめいがきらきらした瓶のキャップを頭に載せて列を作ると、戯れながら遠くへ走っていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "はぁ、待ってって言ったのに、どうしてわたしよりも急いでるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あれは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "あー、あれが探してた「種」だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あのキャップが……種？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "彼らの見ている世界は、キミたちのものとは異なるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "あの小さくて丸いものは、羽獣によって異国の地に運ばれ、根を下ろして芽を出し、全く異なる姿に変わったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "サイダーの瓶の蓋になったものもあれば、ソースの蓋になったものもある。一つ一つ味は異なるけど、どれも面白いよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "彼らの中には、クルビアでそのヴォルケーノコーヒーを飲んだことのある子もいるだろうから、印象深かったんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "こういう風に世界を見るのは、面白いものじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "取り残された生物",
      "text": "（地面を掘る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "だとしても……はぁ、キャップを地面に埋めても、飲み物は生えてこないんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "好きにさせておけばいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "答えは、自ずと芽を出すものだからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "はい、コスタです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電話の声",
      "text": "コスタさん、私はお爺様の入院されていた病院の者です。大変残念ですが、お爺様は本日夕方に亡くなられました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電話の声",
      "text": "良いことと言っていいのか、とても安らかに眠られました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
