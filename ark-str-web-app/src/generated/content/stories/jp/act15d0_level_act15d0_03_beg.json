{
  "server": "jp",
  "storyId": "act15d0_level_act15d0_03_beg",
  "groupId": "act15d0",
  "stageId": "act15d0_03",
  "title": "最初の襲撃",
  "storyCode": "MB-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15d0/level_act15d0_03_beg.txt",
  "sourceHash": "3bc0ea97f0bc953b6754dec200d1267fe67a81bc8a8836121d69189f9e658a09",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ロビンさんは、プロの殺し屋じゃなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それは私でもわかる。彼女からはそんな空気は感じなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "どうやら彼女に関する資料は本物だったみたいね。確かに彼女は警備会社で仕事していた。腕は確かなはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "でもそうすると、少し変よね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "何が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そんな彼女がなぜ殺し屋として雇われることになったのか……まあでもそんなに大した問題じゃないわ、ひとまず置いておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "それよりも、ほとんどの殺し屋が、ロビンさんのように個別で雇われたみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "殺し屋たちは、標的を殺すにあたって、自分に競争相手がいるって知らなかった。自分の雇用主が誰なのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……ハイドブラザーズは、一体何人の殺し屋を雇ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしもよくわからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "でもこれだけは言える。彼らはアンソニーさんを消すために、かなりの力を入れたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "殺し屋たちはどうやって監獄に入ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あなたも事前調査したんでしょうけど――マンスフィールド監獄はあの州のいくつかの都市政府が共同で建てたもの。すべての州においても唯一無二よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私の調査では――移動監獄が設立される前、あの州は開拓エリアとして急速に発展していたものの、それと比例して犯罪率も高くて、あふれた罪人の収容場所に困っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "同時に、今は監獄が建てられている移動都市も、当時は荒廃寸前の寂れた工業地帯で、その処遇が問題になっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そんな状況でランドル、つまり今の獄長が立ち上がり、各都市の政府にあの監獄を建てることを提案した。これによって、彼らは工業地帯の処遇と囚人の収容問題を一挙に解決することに成功した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "これと、殺し屋たちの潜入方法にどういう関係が？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "答えは明白じゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "これはつまり、あの監獄が「やっかいな」人たちを収容するための場所であることを意味している。しかも各都市があまり管理したくないような人たちをね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そういう場所に入るのは、実はあまり難しいことじゃないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "カフカさんはきっと、具体的にどうやって監獄に入ったかはあなたに話してないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もちろん、入るのは容易くても、出るのはそうじゃないけどね。あの監獄の警備は非常に厳重だから、逃げ出すのは困難を極めるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "それに、さっきも言ったけど、数ヶ月ごとに周辺都市に立ち寄る時以外、基本的にマンスフィールドは荒野に留まっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "たとえ囚人が逃げ出したとしても、そこに広がるのは見渡す限りの荒野だけ。殺し屋たちにとって問題だったのは潜入ではなくて、むしろ脱出の方法だったでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ほら、ロビンさんも言ってたでしょ？　謎の人物が、必ず彼女を逃がすと約束したって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そういう取り決めがあったから参加した連中も多いんじゃない。暗殺に成功した後は、バカなことをやって死なないように、救出されるまでおとなしくして待ってればいいのだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でもそんなにたくさんの殺し屋を送り込んで、ハイドブラザーズは彼ら全員を引き上げるつもりだったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もちろんそんなつもりはなかったでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "だから殺し屋たちに、互いの存在を教えなかったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "それに、一度監獄に入ってしまえば、もしそれを知ったとしても、逃げ出すことなんてできない。つまり、どんなに約束が疑わしくても出るためにはアンソニーさんを殺すしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "単純かつ有効的な手段ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でもやっぱりわからない、どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "サイモン社はすでに倒産し、中心メンバーも全員が服役中。ハイドブラザーズはそちらには手を出そうとしていないのに、どうしてアンソニーだけを消そうとしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "えっ？　……まさかそこから説明しなきゃいけないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "どういう意味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ふぅ……サイレンスさん、あなたが「こっち側」の事情に、本当に疎かったんだって、今やっと信じることができたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もしかすると、理解してなかったからこそ、無謀にもあんなことをしでかして、たまたま成功しちゃったのかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ごめんなさいね、皮肉のつもりはないの。むしろ褒めてると思ってもらって構わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "じゃああなたの質問に関してだけど、まず一つ逆に聞いていいかしら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "サイレンスさん、もしも監獄内でアンソニーさんを消し去りたいのなら、殺し屋を使うのは、実は最も非効率的だとは思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……思わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "だって明らかにもっと効率的な方法があるのよ？　たとえば看守を買収するとか、獄長に賄賂を贈るとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "なのに、囚人に仕立て上げた殺し屋を監獄に送り込み、別の囚人を暗殺させるなんて、なんだかマヌケだと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ハイドブラザーズには……それができなかったから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そう、彼らにはそれができなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "最初から説明させてもらうわね。サイレンスさん、さっきあなたが話していた、あの監獄の歴史に対する認識は少し間違ってるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "間違ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "カフカさんの話で、看守長のバートンが言ってた言葉を覚えてる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "我らが州立マンスフィールド監獄は、首都特別認可の試験監獄だ。将来的にはここのシステムが、手本として他の州にも広められる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それがどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "試験、特別認可、これらが何を意味するかわかるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ビジネス、なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "クルビアにおいて、最もお金になる商売は、政府の利権絡みのビジネスであり、この監獄はその典型よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "何を……言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あの監獄は事実上、ランドル獄長のマネーマシンだってこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でもあそこは監獄でしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そうよ、厳重に警備された監獄。嫌いな人を送り込んで生き地獄にもできるし、大事な人を送り込んで安全に保護することもできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "お金さえあればね。ランドルはそういう場所を管理している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "これって大きなビジネスチャンスだと思わない？　これ以上なく魅力的な商品よ。ランドルに対して、お金を積む人はたくさんいると思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もしそれが本当だとしたら、ハイドブラザーズは大金さえ払えば、獄長に事を運ばせるはずでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "……聞いた直後には驚いて嫌悪感を抱いていたのに、数秒後にはもう事実に適応するよう頭を切り替え、思考を展開している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ほんとすごいわ、サイレンスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "褒めてるようには聞こえない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あなたの疑問の通りだと思うわ。でもこの件については、あたしも明確な答えを持ってないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "でも、結果から推測はできるわ――客観的事実として、獄長は動かなかった。でもハイドブラザーズが話を持ちかけなかったはずはない。ということは、獄長が断ったとしか考えられないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしの個人的な見解で言うと、獄長は殺すなんて極端なことをしたくなかったんじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "アンソニーさんを虐待する程度ならお金で解決できたかもしれないわね。でも、監獄内でのアンソニーさんの影響力は大きいのよ。もし彼が死ねば、簡単には収拾がつかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "普通の囚人が死ぬのとは訳が違うわ。下手をすれば自分の方が脅かされることになるわよ。獄長の立場も絶対ではないもの。多くの者が彼のポジションを狙ってるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしの知る限り、相当抜かりのない人物だし、ランドルがリスクを冒すなんて思えないわ。ハイドブラザーズからお金を受け取っておいて、約束を反故にした可能性の方が大きいくらいでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "確かアンソニーは、アイアンフォージシティまで逃げ延びたのに、捕まえられたって言ってた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もしかして彼の父親が手配していたということ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "うん、その可能性もあるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "スミス・サイモンは、昔バンカーヒルシティのビジネス界隈では結構有名な存在だった。息子を守るために監獄に入れたとしてもおかしくないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でもそれは私の質問に対する答えじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "いいえ、もうすでに答えているわ。サイレンスさん、あなたは賢いんだもの、考えればすぐにわかるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……わからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ハイドブラザーズがマンスフィールド監獄でできなかったことが、同じようにバンカーヒルシティの刑務所でもできないとは限らない……私が言ってるのはそういうことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "待って、まさかアンソニーの家族は……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ようやくわかったようね、サイレンスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "さっきあなた、ハイドブラザーズはアンソニーさんの家族に手を出そうとしていないって言ったわよね？　でもそれは少し違うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "彼らがまだ死んでいないのは、今はその必要がないだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "それに、もしかしたらあなたは理解していないかもしれないけど、クルビアの人々にとって最も苦しいものは死ではないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "今回の件でサイモン社を排除してからというもの、ハイドブラザーズには他にライバルといえる相手はいない。彼らがサイモン家の再起を許さないのは誰の目にも明らか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "つまり彼らにとってみれば、サイモン家はもはや脅威ではなくなった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも、アンソニーが彼らの手の届かない場所にいると気付いた時、彼が脅威になり得ると考えた！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "その通り。アンソニーさんが生きている限り、彼らは常に反撃の危険に晒されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ハイドブラザーズの影響は、地元の監獄には及ぶけれど、一つ州を隔てたマンスフィールド監獄までは及ばない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "待って！　……単なる一企業が、たとえ背後にエネルギー課がいたとしても、どうして地元の監獄に影響を及ぼせるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "どうしてだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "まさか……あ、有り得ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ご飯できたよー、さぁさぁ二人とも食べて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれ？　サイレンス、顔色があんまり良くないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ちょっと冷静になりたい……メイヤー、ミュルジス主任に監獄内で何が起きたか話してあげてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん、いいよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "サイレンスも食べながら聞く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……いや、私は静かなところへ行きたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "じゃあキッチンがいいよ、テーブルもあるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うん、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "カフカの話をしていたのは聞いたけど、そのあとはどこまで話してたのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ロビンさんの経歴と、彼女が監獄内に入ってから、馴染むまでは話したわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わかった。じゃあ次は、彼女が最初の暗殺に失敗した時の話だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あっ、カフカの視点から言えば、彼女がアンソニーとの接触に成功した時のことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "おっ！　つまり彼女たち二人の行動が交わるってことよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そうね、あててみましょうか。確かロビンさんの話に、Cエリアへ掃除に行くってくだりがあったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "それのことでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん、カフカもその方法を選んだんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "聞いた感じ、確かにそれがアンソニーさんに最も接触しやすそうな方法よね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "アハッ、刺激的な展開じゃない！　そういうの好きよ、あたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "その間にあった細かい出来事はどうする？　聞きたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "うーん……それも面白そうだから興味がないとは言わないけど、まずはやっぱり脱獄そのものに関する話にしましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "じゃあカフカとロビン、どっちの話にする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ロビンさんの話がいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わかった。あの時、彼女が監獄に入ってからすでに一ヶ月経ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それまでの間、ロビンは一生懸命仕事に励んで、やっと清掃係としてCエリアに入る機会を得られた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "彼女は暗殺するために集めてきた材料を使って、自分の得意とする武器を作って、それを隠し持ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "周到に準備してたみたいね。だけど、失敗したっていうことは、アンソニーさんに気付かれた？　それともカフカさんに阻止されたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "違うよ。全く予想外のことが起きたんだ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "揃ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Aエリア囚人たち",
      "text": "イエッサー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人たち",
      "text": "イエッサー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "イエッサ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "（ねえねえ、君も新人だよね？　前に工場で君を見たよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "聞け！　新人もいることだ、もう一度ルールと流れを確認する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "AエリアとBエリアはそれぞれ違う部屋を担当する。俺たち二人が手分けしてお前たちを連れて行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "最後は、全員でミスター・アンソニーの部屋へ行って掃除をする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "おいおい、そいつはなぜなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "こういうのが「敬意」っていうんだ、わかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "……Aエリアの者は私に、Bエリアの者は彼についていけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "とにかく、入った後は余計なものを触ったり、勝手に持ってったりするなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "仕事はきちんとやれ、特にミスター・アンソニーの部屋はな。母親の面倒を見るような気持ちで丁寧に掃除しろ、わかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "ハッ……俺は別に母親の面倒を見たいなんて思っちゃいねえよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "つべこべ言うな、お前みたいに初めてこの仕事をする奴に言ってるんだ。面倒は起こすなよ、わかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "わかったわかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "ちゃんとやれば、空いてるCエリアの牢獄で遊ばせてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "おぉ、そんな良いことがあんならちゃんとやるぜ、へへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "ほら、掃除用具は全部持ったか？　持ったら上へ行くぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（ここがCエリアの牢獄……やっと入れた。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（各階に四部屋、それぞれエレベーターにしか隣接していない。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（でもここの牢獄は私たちのところとは全然違う……プライバシーがほとんどない。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "ちゃんと働け、きょろきょろするな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "ここがア……ミスター・アンソニーの部屋だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "もう一方のグループは先に着いているようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "入ったら黙って掃除するんだ、Bエリアの奴と殴り合いなんかするなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "きっちり監視しているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（この人、ほかの看守とは違う。威圧感が凄い……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（でも、ようやくアンソニーにお目に掛かれる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（写真を見ただけでもわかる。彼はとても強い……もし正面からやり合えば、私じゃきっと勝てない。でも――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（どんなに強くても弱点さえ見つかれば、チャンスはある……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（まずは掃除しながら様子を窺おう……今回は、彼の弱点に関する手掛かりが見つかるだけでもいい。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（父さん、見守ってて。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "ん？　どうした？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（看守とBエリアの囚人が数人倒れてる？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "お前たちは何者だ？　なぜ私を殺そうとする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "あんたの命を狙ってるのが誰なのかなんて、知る必要はねえぜ、アンソニーさんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "どうせここで死ぬんだからな、へへっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "text": "お頭、Aエリアの奴らが来ましたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "早えーな、へへっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "だが問題ねえ。おい、こいつら全員やっちまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "殺すなよ、俺たちはシャバに出なきゃいけねーからな、へへっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（まさか、あの二人もアンソニーを暗殺しに来たの……？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "くらえー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "な、なんだこの小娘？　どきやがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "うわぁっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（あっ、あの女の子！　やられちゃった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "フッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（えっ？　この看守、今笑わなかった……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（いや、今はそんなことどうだっていい。あいつが襲って来る、なんとかしないと！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
