{
  "server": "jp",
  "storyId": "story_caper_set_1_story_1",
  "groupId": "story_caper_set_1",
  "stageId": null,
  "title": "楽しい場所",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_caper_1_1.txt",
  "sourceHash": "31ca861036b5db7887a55111845707ecdc9aa890969590f787bac8ec9be93d95",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "「ゆらゆらシャンパングラス」を連続十回やっても吐かなかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "こっちは「ぐらぐらオーバーオール」を連続二十回やっても吐かなかったぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "りょーかい。じゃあ二人とも、チケットを出して。くじ引きさせたげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "どれどれ……「ゆらゆらシャンパングラス」が十回で、「ぐらぐらオーバーオール」が二十回。ってことで三回引けるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "んじゃ、引いちゃって。大当たりが出るといいね～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "もし一等を当てたら、通りの向かいにある二階建ての家を買うぞ。玄関から出たら二秒で遊技場だからな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "あっ、四等もいいな。ボックス社の最新モデルのクルーザー。売れば滞納してる「シャープトゥース」のみかじめ料分くらいにはなるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "もう母ちゃんの店を抵当に入れたけど、ちょっと足りないんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "ケッ、夢見ちまってよ。俺は慎ましやかな人間だから参加賞以外ならなんでもいいぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "何等だろうと当たりさえ出れば、吐くのを我慢して二十回揺れた努力が無駄にならずに済む……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "出た出た！　何が当たったのか確認しようぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "ちょっと待ってくれ。まだ目が回ってるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "おぉ～、これはすごい！　二人とも、マジでついてるね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "おめでとうっ！　本日の特別大賞――「あと百回遊べる」券だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "特別大賞？　あと百回？　つまり、もう百回くじを引けるってことか？　そいつはすげぇや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "いやいやいや、そんなのはつまんないじゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "おい！　そいつは俺が当てたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "いや俺だ！　あっちへ行け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "はいはい、ケンカしない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "「あと百回」ってのは、「ゆらゆらシャンパングラス」か「ぐらぐらオーバーオール」をあと百回無料で遊べるってことだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "二人で回数を共有できるから、一緒にぱぁーっと遊べちゃうね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二人",
      "text": "な、なんだって！？　オエーッ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "もうっ、避けるのが遅かったら、ゲロまみれになるとこだったじゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ごめんね、ウェイトレスのお姉さん。こんなに長く眠らせちゃって……そろそろシフト交代だよ。はい、借りてた制服！　汚れてないから安心してね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "でもさっきの二人、アタシが用意した特別大賞をちっとも気に入ってくれなかったみたい。遊技場って遊ぶところなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "タダで遊べるのに、がっかりするなんて、変なの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "すみません、スペシャルカクテル「ダブルサンライズ」を一杯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "クサイ演技はやめなよ、「赤毛」。そんなダサい合言葉なんて決めた覚えはないから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……本当に飲んでみたかったんだよ。みかじめ料を取り立ててるあの連中、全員いつも同じのを注文してるだろ？　そんなにうまいのか気になってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アタシは「退勤」したの。飲みたいなら、ウェイトレスのお姉さんが起きるまで待ってれば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "それならいい……情報交換の方が優先だ。場所を移そう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "それでどう？　みかじめ料を取り立ててる連中たちの正体は掴めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ああ、何人かの後をつけて、奴らのアジトを特定したよ……だが、思っていたより厄介だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "連中の背後にいるのは、このエリアを陣取ってる最大のギャング――「シャープトゥース」だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "じゃあ、あいつらを遊技場から追い出すってなると、そのギャング全部を敵に回すことになるってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "正しくは、俺らがこのエリアに居続けるには、そいつらのルールを守らなければならないってわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "フ～ン、だったらちょうどいいね。アタシ、ルールを破るのが一番得意だし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……カーリー、連中のことはもう放っておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "奴らがこのまま遊技場でみかじめ料を取り続けたとしても、俺らが楽しく遊ぶのにはなんら影響はない、違うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "金を要求してこない限り、あいつらを追い出す必要はないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ダーメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "「赤毛」、前に言ったでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アタシがドッソレスに来たのは、本当の意味での楽しい場所を探すためだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "遊技場で遊ぶのは楽しいんだけどさ、その楽しい雰囲気をぶち壊す奴がいちゃ、目障りなんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "他人の平穏と楽しみを脅しの材料にして、金稼ぎをする奴らより最悪なもんはないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ああ、そりゃそうだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "もし俺がボスだったら、絶対に部下にそんな真似はさせない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "えっ、ほんとに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "だったら、アタシたちであいつらのボスをやっちゃおうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "よし！　そいつが退役軍人だろうと市長の手下だろうと、叩きのめせばいいんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "はあ、どうしてアンタはいつまで経ってもそう無鉄砲なのさ？　いい加減頭を使うことを覚えようよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "カーリー、俺は奴をこの目で見たんだ。俺の軍隊生活で得たすべての栄誉をもって断言する。タイマンなら奴は百パー俺には勝てないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "お前が俺を軍隊に「送り込んで」くれたおかげでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "（小声）でも、もしそいつが本当に市長の手下だったら、勝ったところで誰かが仕返しに来るじゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "今なんか言ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……なんにも。軍隊に騙して参加させたこと、恨んでるのかと思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "あの時、招集兵の車に乗せられてなかったら、アンタはあと何年かはスラムのボスでいられたはずだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ケッ、ふざけたこと抜かしやがって。いまさらお前を恨んじゃなんかいないさ。当時、あの車に乗らなきゃ、こうしてドッソレスに来ることもなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "あの車に乗らなきゃ……俺の一生はスラムのボスで終わってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "いいじゃんそれで。アタシはむしろずっとあそこで暮らしたかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "もしも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ケイパーは赤い手袋の下でいつも、源石結晶の存在を感じ取れた。\nもうとっくに慣れた感触のはずだが、それでもほんの一瞬だけ、それを無視できない時が存在する。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……ま、いっか。今のアタシたちに選択肢はないんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偉そうな青年",
      "text": "*ボリバルスラング*、誰だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偉そうな青年",
      "text": "おい、クソガキ……俺の顔にこいつをぶつけたのはテメェか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アタシだけど、それがなに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ってかさ、アンタさっき風船売りのおじいさんからみかじめ料取ってたでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偉そうな青年",
      "text": "なんか文句あんのか？　言っとくが俺はなぁ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "無駄話はやめとけ、カーリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "わぁっ、痛そー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……「赤毛」、何してんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "待ってよ、なんでそいつのポケット漁ってんのさ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "なんでって、こいつが取った金を回収するために決まってんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ふーん、じゃちゃんと風船売りのおじいさんに返したげてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "返す？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "この金全部が、あのじいさんから奪ったわけじゃないんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "わかったわかった、そんな目で俺を見るな。あとでじいさんのとこで風船をいくつか買うから、それでいいだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ここからは別々に行動しよう。少しやることがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "あっそう、じゃあこっちも勝手にやらせてもらうからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "「赤毛」のやつ……一日中姿を見てないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "おじいさんにお金は返したよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……まあいいや、適当にやってるだろうし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……カーリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "こんなとこに座り込んで何してんの？　それに、この大量のビール缶……アンタ、どんだけ飲んだわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "アハハ……そうだな、どんだけ飲んだんだろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "なあカーリー、知ってっか？　スラム街では……俺の親父が冷えたビールを一缶買うには、革靴を二十足磨かなきゃ金に余裕を作れなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アンタ、なんか変な刺激でも受けた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "刺激？　ははっ、ドッソレスにいる毎日が、刺激的でたまんねぇよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "カーリー……お前も見たろ？　今日俺はパンチ一発であの下っ端チンピラをのしてやった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "あいつが集めたみかじめ料だけで……ビールがこんなに買えたんだ……こんな……ずりぃだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "「赤毛」……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "それはアタシたちがもらっていいお金じゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ハッ、口で言うのは簡単さ……でもよ、俺たちが求めてる楽しいことってのは、使いきれない金があるってことじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "カーリー、「シャープトゥース」のボスを倒したら……新しいボスになってやろうぜ、俺たち二人で！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "みかじめ料を取れるし、使いきれないほどの金も手に入る……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "そうすりゃ、親父に新しい家を買ってやれる。酒場の隣がいいな。好きなだけ飲ませてやれるし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "お前だって、母ちゃんをドッソレスに呼んで、でっかい工場を作ってやれるぞ！　ははっ、さぞかし立派な景色に違いないや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "そ、そんなの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アタシの家？　じゃあ……ママは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "ここにいるわ、カーリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "よかった、ママ……会いたかったよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "元気に過ごしてる？　悪いやつらが、またみかじめ料を取り立てに来たりしてないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ずっと手紙を書いてなくて、ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "今までずっと探してたの。本当に楽しい場所を……ママを呼んで、一緒に暮らせる場所を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "誰もアタシを追い出さないし、ママの作業場を壊したりしないような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "鉱石病のアタシが、ママの負担にならないような、そんな場所……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "でも、まだ見つからないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "大丈夫よ、カーリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "どんなことをしてでも、どれだけお金がかかっても、あなたの病気を治してあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "いやだ、ママ、そんなこと言わないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "あなたが楽しければ、ママは幸せよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "やめてよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "だってアタシは……ママにも楽しくいてほしいのに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "翌日"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "もう、そんな書き方、誰に教わったの？　ケンカ腰すぎ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "書き出しは「親愛なるボス様」から始めなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……ダメダメ、字が汚すぎ。書き直し！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "お、おう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "そう、あとは時間と場所も書いて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "「来週金曜日の夜七時、アジトで会いましょう」ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ああ、そんで続きはこうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "「首を洗って待ってろ。タイマンで勝負だ！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "書き直し。最後の一文はねぇ……「ご都合はいかがでしょうか？　直接お話したいことがあります」だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "おう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "でもよぉ、カーリー。これって果たし状なんだろ？　こんなに丁寧に書く必要があんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "なんだか、俺らがビビってるみたいじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "本当にアタシたちがビビってるって思われたほうが、おもしろいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "わかったよ、お前の言う通りにしてやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "それで、時間になったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "約束の時間になったら、まずアタシが遊技場でちょっとした騒ぎを起こして、手下たちの注意を引きつける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "それで、アジトの防御が手薄になった隙に、アンタがあいつらのボスのとこに乗り込むの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……タイマンなら勝てるんだもんね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "もちろんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "武器だってとっくに用意してある。フフッ、言っておくが、上物だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "作戦がうまくいって、俺らが「シャープトゥース」のボス、しいては遊技場のボスになれば……もしかしたら、ドッソレスのボスだって狙えるかもしれないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アンタってほんと、ポジティブすぎ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "またアタシに騙されたらどうしようとか、考えないわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……正直、お前と再会したばっかの頃は、ぶん殴ってやろうと思ったよ。俺が軍隊で味わった苦しみを、お前にも味わわせてやろうってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "けど、よく考えたら、お前は俺よりも頭がいいし、一応は昔馴染みだ……敵よりも友達でいたほうがいいに決まってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "そんで、今の俺は確信してんだ。カーリー、お前とつるむって決めたあの時の俺の選択は、正しかったってな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……それは計画が成功してから言いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ヘマするんじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……「赤毛」のやつ、話し出すと止まんないんだから。夜の十時前にはベッドに入りなさいって、ママから言われなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "こんなのんきに寝ちゃって……少しもアタシたちの作戦を疑ってないわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……あんな計画でボスになんかなれっこないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "いや、生きて「シャープトゥース」のアジトから出るのも無理だろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "まあいいや、果たし状はもう送っちゃったし……どうせイタズラするなら、思いっきり大暴れしなくっちゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ドッソレスの人たちに、本当の楽しさってものを見せつけてやる絶好のチャンスだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "えっと……「赤毛」が使う予定の武器はたしか、ここにしまってたよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ギャハハ、うん、こっちのほうが絶対におもしろいって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "そうだ、最高の席も用意しとかないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "もしもし、シールス・スカイレストランですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "あれ、俺のチケットは！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "やっと「ゆらゆらシャンパングラス」を二十回終わらせたのに、誰かが俺のチケットを盗みやがった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バタバタした客",
      "text": "私のカバンが！　天井の照明の上に飛んでいっちゃったわ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てふためいた客",
      "text": "なんだよこれ……ポップコーンシロップを床にぶちまけたのはどいつだ！？　新品のサイン入りシューズなんだぞ！　弁償しやがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "皆さん、落ち着いてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "遊技場に不審者が侵入しました。皆さん、落ち着いて指示に従い避難してください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "館内放送",
      "text": "ピンポンパンポーン、ゲストの皆さんこんばんは。避難指示に従って、遊技場前の広場に移動してください。皆さんにちょっとしたプレゼントを用意してますよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "館内放送",
      "text": "サングラス、腕時計、ヒールなど、落とし物はないか、しっかり確認してくださいね～。もし遊技場内に何かを落としたら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "館内放送",
      "text": "お前、どうやってここに入った――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "館内放送",
      "text": "（ドガッ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "館内放送",
      "text": "コホン、とにかく、皆さんどうか楽しい夜をお過ごしくださ～い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "プレゼント？　一体なんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バタバタした客",
      "text": "さあ？　見にいってみましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てふためいた客",
      "text": "おい、どこに目ぇつけてやがる！　俺の靴を踏むんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "もうっ、こんなとこで立ち止まるくらいならどいてよ！　はやく外に出ていい場所を取らないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "（口笛を吹いて合図を送る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "よし……ここからは俺の出番だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バタバタした客",
      "text": "いつになったら、プレゼントがもらえるのよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てふためいた客",
      "text": "まったく、スタッフは何をしてるんだ？　このまま俺たちを待たせておくつもりなのかよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "はい、不審者を追って外に出ましたが、入り口前に人だかりができているせいで見失ってしまい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "ええ、ええ……なんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "本当の狙いはボスだと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "クソッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "焦らないで、もうそろそろだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "さあ……五、四、三、ニ、一、レッツショータイム！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "トラックで突っ込んできたのはこのガキか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "トラックは「シャープトゥース」のアジトの壁を突き破り、後部だけが外に飛び出ている。\n一応は威勢のいい登場だと言えるだろうと、「赤毛」は思った。"
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "チッ、このオンボロ建物は前から雨漏りしてたけど、これでついに風もしのげなくなっちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "ガキ、何しに来やがった？　人の応接間をめちゃくちゃにしておいて、説明もなしなんてことはないだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "（どうなってやがる！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "（タイマンのはずだろ？　なのになんでこんなにたくさん人がいるんだ！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "何しに来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "あ、それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "（ええい、ヤケクソだ……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「赤毛」は黙ってトラックの荷室を開けた。\nかつての戦友から調達した源石大砲は、いつも戦場で敵を正確に吹き飛ばしてくれた。\n間違いなく殺戮兵器と呼んでいいだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "一対一でも、一対大勢でも、同じことだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「赤毛」の脳裏に、ケイパーからの言いつけが過る。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "言われた時は、なぜケイパーが「殺戮兵器」を「キャンディー」のように表現するのか、「赤毛」にはまだよくわかっていなかった。\nそして、荷室の中身を改めて見た彼は……自分の見間違いかと、思わず目をこすった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "*ボリバルスラング*！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この時になって、「赤毛」はようやく理解した。\n中に積んでいたはずの源石大砲は消え失せ、代わりになぜかカラフルなダンボール箱が積み込まれている。\nダンボールには可愛らしいイラストが印刷されており、テープには「楽しいひと時」と書かれていた。\nそして、タイマーとすでに火のついた導火線……しかも最悪なことに、導火線の炎はまもなく端に辿り着こうとしていた……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "花火が次々と打ち上げられ、夜空に咲き誇る。\n花束、ハート、羽獣……一瞬にして様々な形の花火がドッソレスの夜空を鮮やかに彩る。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "キャハ、どう？　ステキでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "こんだけ立派な花火ショーを用意するの、大変だったんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "これがさっき言ってたプレゼント？　うるさいだけじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらつく観光客",
      "text": "ああ、鼓膜が破れそうだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バタバタした客",
      "text": "そんなこと言わないで。きれいな花火じゃない？　ビルでほとんど隠れちゃってるのがもったいないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バタバタした客",
      "text": "前もって知らせて、いい観覧席を用意してくれたらよかったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目がまわる観光客",
      "text": "もう中に戻ってもいいか？　このまま眺めてたって、つまらないだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "ドッソレスの人ってほんと、意味わかんない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "見上げれば、誰もがちょっぴり花火を眺められる……これよりステキなことなんてあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "スラムに住んでた頃、都市の方で花火が上がるたびに、ママに呼ばれて一緒に眺めてたな……あれは、ママとアタシで分かち合える楽しさだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……まいっか、わからなくても。別に関係ないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "でも「赤毛」の方は……きっと全員、このサプライズを気に入ってくれてるはず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数日後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "どいた、どいた！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "わおー、すごいパレード。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "花束と風船を飾り付けた車がこんなにたくさん。しかも、ナンバーも全部連番だし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然、その中の一台が車列を離れ、ケイパーのそばに止まった。\n運転席のドアが開き、よく見知った人物が降りてきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "カーリー！　やっと見つけたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "あの夜から、どこ行ってたんだ？　大好きなカジノにも顔を出さないしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アンタこそ何してたの？　ずいぶん忙しそうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "新しい車、イケてるじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "おう、これはボスの車だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "そういえば、まだ言ってなかったな。俺、「シャープトゥース」に入ったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "あの夜……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "（なんだ、花火だったのか……って花火かよ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "終わりだ……何もかも終わり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "……終わり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嬉しそうな女性",
      "text": "まあっ！　なんてステキな花火ショーなの、ダーリン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嬉しそうな女性",
      "text": "びっくりしたわ。てっきりまたケンカでも始めるのかと思ったら……こんなサプライズを用意してくれてたなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "は？　ああ……その通りさ！　ずいぶん時間をかけて準備したんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "お前が手伝ってくれてたんだよな？　ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "えっ？　あ、まあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "さあベイビー、早く着替えておいで。今から忘れられないディナーに行こうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嬉しそうな女性",
      "text": "うれしい！　とっても楽しみだわ、ダーリン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "あの……すみません……ほかにやることは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "いや、もう十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "お前、なかなかやるじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "え……いや……すみません！　壊した壁はどうにかして弁償しますんで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "弁償？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "弁償だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "ここまでしてくれた奴に、弁償なんてさせるはずがないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "ずっとプロポーズのタイミングに悩んでたんだ。だが、フッ、今日がその日のようだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "おい、誰かドッソレスで一番の夜景が見られるレストランを予約しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」下っ端",
      "text": "ボス！　シールス・スカイレストランから電話です。予約時間を過ぎてるから、今夜の席をキャンセルするかどうか教えてほしいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "ん？　もう予約してあるのか？　またお前か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "いえ、いや、たぶん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "やるじゃないか、小僧。お前の顔、覚えたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シャープトゥース」ボス",
      "text": "おい、車を出せ！　すぐに向かうぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "あの夜、ボスの恋人は花火ショーを絶賛してて、その後……ボスは見事にプロポーズを成功させた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "そんで大喜びで、俺をその場で仲間に引き入れてくれたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "今夜はボスたちの結婚式なんだよ。この車列は、その式場に向かってるのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "おー……それはめでたい。よかったじゃん、アタシの作戦は大成功みたいだったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ああ、あれ以上の成功はないぜ。まさか、あんな突拍子もない作戦を思いつくなんてな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ハハッ、あの時はマジで死ぬほど焦ったよ！　お前が隣にいたら、俺の汗が床に落ちる音が聞こえてただろうな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "それより、「シャープトゥース」に入ったら、はやくボスに登りつめなよ。アンタなら、部下たちをみかじめ料の取り立てに行かせたりしないんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "それは……いや、そんな話よりもさ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "ほら、乗れよ！　お前もボスに頼んで「シャープトゥース」に入れてやるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "遠慮しとく、つまんないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "アタシが入っても、イタズラするだけだから、嫌われるだろうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "それに、そろそろドッソレスを離れようと思ってるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "えっ？　なんでだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "「シャープトゥース」に入れば、好きなだけ遊技場に出入りできるし、誰からもちょっかいを出されないんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "どうしたんだよ、カーリー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「赤毛」",
      "text": "こういうドッソレスこそが……お前の探してた「楽しい場所」なんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "そうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケイパー",
      "text": "でも、アタシの探してる楽しさってさ、ここにはないと思うんだよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その瞬間、ブライダルカーを飾っていた風船が一斉に放たれ、ふわりと空高く飛んでいった。子供たちの歓声の中、皆が一斉にそちらの方を向く。\n「赤毛」がハッと我に返った時、そばにいたはずのケイパーの姿はもうどこにもなかった。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
