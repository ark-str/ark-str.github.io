{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_04_end",
  "groupId": "act12d0",
  "stageId": "act12d0_04",
  "title": "機械獣の咆哮",
  "storyCode": "RI-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_04_end.txt",
  "sourceHash": "76e18b74745c55754d2315340ce182f0f2e5723d5c2560119f56653f97e26164",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アダクリスの雑魚A",
      "text": "ガハッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの雑魚B",
      "text": "つ、強すぎる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウダイ",
      "text": "やるじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルナ",
      "text": "調子に乗るな、ズゥママ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルナ",
      "text": "野郎ども、かかれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うう、さすがズゥママ、やっぱり強いです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "たった一人であんな大勢をやっつけちゃうなんて……並みのティアカウじゃ全然歯が立ちませんね。まるであのときのガヴィルさんみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼女について、ずいぶん詳しいようだな。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "はい。ズゥママとガヴィルさんは昔から、このあたりでは最強と呼ばれていましたから。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "でも私の知ってる限り、ズゥママは一度もガヴィルさんに勝ったことないんですよ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "ドクター、あんなに強い人はきっと外だと珍しいですよね！？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "でも、ガヴィルさんはもっと強いんですよ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "かっこいい女性だ。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "うーん、確かにズゥママもかっこいいんですが……",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "でも、ガヴィルさんはもっとかっこいいです！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさん、そうですよね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "あれ、ガヴィルさんは？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人A",
          "text": "おい、あれを見ろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人B",
          "text": "見間違いじゃなかったのか！　あいつは――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人C",
          "text": "ホントに帰ってきたのね！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "お前は――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "全員",
          "text": "ガヴィル！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "わああああ、ガヴィルさんが直接舞台に上がっちゃいました！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "久しぶりだな、ズゥママ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "今は、ユーネクテス族長って呼ぶべきか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ガヴィル、まさか戻ってくるとはな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ、トミミに呼び戻されてな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "あれ？　つーかお前もサルゴン語が話せんのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ああ、勉強した。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……お前もこの言葉を使っているということは、これは外の言語で間違いなさそうだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……もう戻らないかと思っていたぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "戻ってくるさ。今だけじゃなくて、これからもな。ここはアタシの故郷だからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……大族長になるつもりか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "いや、お前にも用があんだよ。用事の方は別に祭典が終わってからでも良かったんだけど――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "お前がこんなに強くなったのを見せつけられたら、いても立ってもいられなくてよ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "お前は本当に外で医者になったのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "へっ、これでも外では有名なんだぜ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "意外だな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "お前は最近どうなんだ？　前回の祭典は、機械弄りに夢中で参加しなかったが、今回出てきたってことはついに完成したのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……ああ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "すぐに見せる。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ううう、ガヴィルさん、手は出さないって言ってたのに……",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "手を出してほしくなかったのか？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "え？　そ、そんなことはありませんが、た、ただ……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "ドクターも見入っていますね……",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "うう、確かにかっこいいんですけど、でも……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "それでこそガヴィルだ。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "うう、そうは言いますけど……",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……相変わらず強いな、ガヴィル。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "へっ、お前もなかなかやるな、ズゥママ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "だが、お前は自分の拳に頼りすぎだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "その拳でお前は多くを成し遂げた。だがそのせいで、お前は拳以外のものに頼ることを知らない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "それがお前の限界であり、ここにいる私たちの限界でもあるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "なにわけわかんねぇこと言ってんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "そろそろ変わらねば、ということだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "「よいしょっ、よいしょっ」と規則正しい掛け声と共に、ジャングルから、なにやら大きなものが霊殿に近づいてきた。\n全容はまだ見えない。しかし、ゆっくりと、だが着実に「歩く」影からは、比類なき強さが伝わってくるようだった。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "確かにお前は強い、ガヴィル。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "あれは本当は、大族長になってから使うつもりだったのだが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "お前に勝つには、今ここで使わざるを得ないようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "どちらにせよ、結果は同じだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "これからはあれが、私たちを変えていく。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "だから全然何言ってるかわかんねぇって！　つーか何が来ても、アタシは簡単には倒れねぇぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "いや、お前はいとも容易く蹂躙される。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……大祭司、照準、放て！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "なんだ、ありゃあ！？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "言った通りになっただろう？　ガヴィル。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "だが、私の本来の目的はこいつでお前を倒すことじゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "拳だけでは、未来は創れないんだよ、ガヴィル。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "これからは、機械の時代だ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
