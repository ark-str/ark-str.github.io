{
  "server": "jp",
  "storyId": "main_13_level_main_13-07_end",
  "groupId": "main_13",
  "stageId": "main_13-07",
  "title": "思わぬ再会",
  "storyCode": "13-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_13-07_end.txt",
  "sourceHash": "951390c631e1b6042160a583abe7122a3744ffc96bde9b78d2305412e19a0ddf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "疲れたサルカズ労働者",
      "text": "ウルスラさん、積み卸しは終わりました。今確認して入庫してるとこです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れたサルカズ労働者",
      "text": "前と同じく、鋼材やら、純金やら、源石の類です。人員の輸送はもう半月以上もねぇし、きっとカズデルの王庭軍の移動はほとんど全員分済んでるんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れたサルカズ労働者",
      "text": "積み卸しの方がよっぽど楽ですぜ。前の王庭軍の野郎どもなんか、船酔いがひどくて、下りてくるたびに俺らに八つ当たりしてきて面倒すぎっすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "もういいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "そこまでにしときなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れたサルカズ労働者",
      "text": "ああ、すいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れたサルカズ労働者",
      "text": "それと上官、俺はこの途中集積所でもう半年も働いてるんです。勤務表によれば、もうそろそろ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "あんたの配置に関する指示は何も受けてないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "……けど、あんたの仕事ぶりは確かに誰の目にも明らかね。三日間の休暇を許可してあげてもいいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶサルカズ労働者",
      "text": "ヒュー♪　さっすが、我らがウルスラさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "けど、素直に山の中でおとなしくしてることね。間違っても出世だなんて馬鹿げた話は口にしない方が身のためよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "子供の頃からカズデルで靴の修理をしてたあんたの一番の才能は、靴底を繕うことでしょう。自分が爆弾になること以外に、戦う術なんてあんたにはないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶサルカズ労働者",
      "text": "つれないこと言わないでくださいよ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "さあ、もう行きなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "笑うサルカズ労働者",
      "text": "（小声）ほら、とっときなよ兄弟。ウルスラはそれがねぇと一日も持たねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "笑うサルカズ労働者",
      "text": "（小声）しかしあんたやるなぁ。一人連れてるってのに、その上さらに――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "口の利き方に気をつけることね、靴職人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "逃げるサルカズ労働者",
      "text": "蜜のように甘く、毒のように危険♪　それは一体何だろう♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "もし今あなたが手に持ってるそのノートを開いたら、即刻燃やしてやるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "あんたたちは変わりないみたいね。いいことだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "会うの、けっこう久しぶりよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あの時の作戦以来よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "私と、ヘドリーと、W……前のWで、起こすべきでないトラブルを起こし、殺すべきでない人を殺したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "それで、スカーモールを除き、好きなようにカズデルに姿を見せることができなくなったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "あそこではよくあんたたちの名を見かけるわ……手配書でね。なかなか有名よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺はこれまでずっと、値の張る男だったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "それもそうね。イネスの投資はうまくいったみたいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "……あの頃は皆若かったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あら、年寄りの自覚を持ち始めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "私はサルカズで、あんたはヤギ。理屈から言えば私の方が長生きしてることになるのよ、イネス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "皆感染者なんだから、私たちが比較すべきは種族としての寿命じゃないと思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "その通りね。あんたと、そして私自身の健康に乾杯しなきゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "――ふぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "サルカズが長生きしたければ、自分の頭を正気なまま保っておくことよ。そうしなきゃ頭は訳も分からないうちに、誰かに奪われて金にされるだけだ、って昔よく言ってたわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "欲しければ奪えばいいのよ。それがヴィクトリア人だろうと、サルカズだろうと、私にとってはどうでもいいわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "イネス、あんたシワができたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "これでも三度死んでるのよ。その代償が多少シワができた程度ならサルカズの魂に感謝しなきゃね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "サルカズの魂に感謝なんて、そんなの無理よ。あんたはただのヤギだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "それとヘドリーは、目を一つなくしたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "空っぽの目玉を見てみるか？　そこのキャプリニーの女性のおかげで空いた穴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "片目か、もしくは頭か。好きな方を選べたでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "手を下した時、イネスはすごく辛かったんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……その話はいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "せっかく旧友同士が再会したんだ、感傷的なムードに戻ろうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "歳月や時間、あるいは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前が一体いつ軍事委員会で最年少の少佐になって、この巨獣の骸骨の機関士をやるようになったのか。そいつを語り合うとしよう、指揮官ウルスラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "……そうね。確かに真面目な話をすべきかしら。私たちの立場的でこんな和やかな談笑は筋違いだもの。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "それと教えてもらおうかしら。二人のサルカズの……\nいえ、一人のサルカズの裏切者に、一頭のヤギさんが、どうして軍事委員会の極秘施設に現れたのかをね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "ヘドリー、あんたが将軍に逮捕されたのは知っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "そしてあんたは、私たちの軍事行動を妨害したイネスと、外で爆弾埋めてる小娘の三人で、白昼堂々私の管轄区域に忍び込んできた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "軍事委員会に身を置く士官として、私はこの件を容認するような立場にはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……私たちは今、二対一なのよ、ウルスラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "二対一？　自分が今どこにいるのか、よーく見てみることね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "試してみるといいわ、イネス。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "自分が選んだものすべてに忠実であること。これはここ数年で私が学んだ中で最も大切なことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あなたが選んだものというのは、テレシスのことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "いいえ、軍事委員会よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "あんたたちはバベルと共に行くことを選んだ――今はロドスだったかしら？　そして私は、軍事委員会と共に立つ道を選んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "私たちはとっくにそれぞれの道を選んでいるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ウルスラ、俺たちともう一度共に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "お断りね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "あんたの考えはよく分かるわ、ヘドリー。ほんと、ちっとも変わりないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "だけど私たちはもう、手にしたばかりの賞金を握り締めただけで、一日中大喜びしていたあの頃の子供じゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "任務の合間に、カズデルの街中で午後を丸ごと無駄に過ごしていた頃にはもう戻れないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "私たちはサルカズ……少なくとも、カズデルの市民なのよ。自分たちの街をより良いものにすることが、私たちが生まれ持った責任なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だからこそ、まさにそのカズデルの問題について議論をしているんだウルスラ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "だったら、まずは軍事委員会こそが最善の選択であることを認めなさいよ！　テレジア殿下でさえ、その点を否定してはいないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "カズデルを移動都市に移したのは、私たちがここでサルカズの未来について語り合うことができるのは、あの二人の殿下のおかげなのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "私を抜擢してくださったのも殿下たちよ。彼らはスラム街出身の貧乏娘に、古の純血を宿す王庭の者たちと、肩を並べて同じ戦場を眺める機会を与えてくれたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "ひとたび甘い考えと妥協に囚われたら、サルカズは真の「故郷」に限りなく近づくための機会を失ってしまうのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "ためらう理由なんて何もないと思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "軍事委員会こそが……「カズデル」が一つの「国家」となるための基盤なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "なら戦争の後も、この大地にカズデルは存在し続けるだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "さあ。私に分かるのは、裏切り者になるわけにはいかないってことだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "十分間だ。それ以上は持ちこたえられん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あのデカブツの情報をなるべく多く持ち帰ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "この背骨を貫いてるいくつかの「釘」が、きっと巫術で動く何らかの操縦装置ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "この近くの神経束が震え続けてる。まだ自我があるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライフボーンの守衛",
      "text": "あっちだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ふぅん、軍隊としての素養はなかなかじゃない。ウルスラは本当に精鋭部隊を育て上げたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "けど柔軟性が欠けてるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "人数以外は大したこと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……自分の身体なのに容赦ないわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "すぐそこね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ゲホゲホッ……ペッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "灰まみれだわ……風化した骨の粉末ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "おそらくここが中枢のはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "うーん、接続口のようなものはどこにも見当たらないわ。完全に巫術だけで動いているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "こいつは果たして従順な奴隷なのか、それとも操り人形のような抜け殻かしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "むっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "やっぱりアーツは避けられたか。心臓に風穴開けてやるはずだったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あなたも、アーツの軌道が左にブレる昔のクセが抜けてないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あの頃たっぷり食らっといて良かったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "……ふん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ずいぶん急いでるみたいね？　ヘドリーに痛い目に遭わされちゃったかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "こいつ、けっこう脆いんでしょ？　見た目ほどおとなしくもないみたいだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "好きなように推測してもらって結構よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "……機会があれば、その「三度死んだ」って件についてじっくり聞かせてもらいたいものね。間違いなく刺激的な話でしょうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "もう一回分増やさせるつもりかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "いえ、今は置いておくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "この乱気流の中で……生き延びられればの話だけどね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "少しは尊厳を保ってね、イネス。そんなことをしても無意味よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "あんたのその影じゃ、この巨獣の能力を防ぐことはできないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ご忠告どうも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ヘドリ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺たちはもう、友情を語り合う年頃はとっくに過ぎている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だが俺はむしろこう願っている。未来のカズデルに住む人々が、俺たちが嘲笑うところの「愚かな無邪気さ」を持ち続けていてくれたらとな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "ヘドリー、言い忘れてたけど、マンフレッド将軍があんたの書いた本を持って来てくれたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "なかなか悪くなかったことは認めるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "あんたは一つ一つ選び抜いた断片を、時間順に沿って配置し、そこに筋道を見出したと思い込んでる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "けどあんたは逃げ続けてる。ずっとそうしているつもりなの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "お喋りはもういいわ。そろそろお別れにしましょう、ウルスラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ヘドリー、今回は私と一緒に跳び下りる羽目になったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "歴史の奔流に呑まれないよう気をつけて。過去の断片を拾い上げるために……目の前の生活を忘れたりしちゃダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
