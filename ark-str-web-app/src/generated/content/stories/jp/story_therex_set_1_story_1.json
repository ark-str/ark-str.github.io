{
  "server": "jp",
  "storyId": "story_therex_set_1_story_1",
  "groupId": "story_therex_set_1",
  "stageId": null,
  "title": "灼熱のエネルギーショック！",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_therex_1_1.txt",
  "sourceHash": "9d33b37e58d3885ffa1a2a78a23b859c6b95bdc6fbc3c12d56b605974ec03f2f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 Thermal-EX"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 2:30 天気/晴天\nロドス本艦 チーフエンジニア室"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "クロージャさん、今月の艦内各エリアにおける配線の安全検査報告です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ふむ、ふむ……問題ないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ん？　ここにちょっとした乱れがあるみたいだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "――午前二時から六時までの四時間に、毎晩同じような異常が？　このエリアって宿舎でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "宿舎です。そういえば思い出しました。検査を始めたばかりの頃、あの付近で停電の報告があったんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "ただその時は、確認しに行ったのですが配線に特に問題はなく、ただ出力が許容値を超えていただけでしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ハックシュン――！　ううっ……ていうか、このオフィスちょっと寒くない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "そうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "というより、ここ最近ずっとちょっと寒い気がしますよね……室温を少し上げましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "我慢しよ、省エネは大事だからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "真面目な話、普通に考えて、どうせまたどこかのおバカちゃんが規則違反の電気器具をこっそり使ってるんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "そういえば、検査に行った時、廊下の近くでThermal-EXを何度か見かけたんですが、もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "え？　そしたら規則違反の電気器具じゃなくて、電気器具自体の規則違反ってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "Thermal-EXを呼んできましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "まずどこにいるか確認しとこ。オペレーター日誌、と……あった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "えっ、Thermal-EXは今シラクーザに行ってるって？　しかも同行者の中に――ドクターも！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "むぅ、これはちょっと予想外……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "まあいいや。問題があっても大したことじゃないだろうし、きっと大丈夫。それにドクターがいるんなら、何かあったらきっと解決できるだろうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "戻ってきたら、ケルシーに状況を訊きに行けばいいや。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シラクーザ ロコモティヴァ ロドス事務所"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "製薬会社代表社員",
      "text": "契約の条件はこれで問題ありません。遠くからご足労ありがとうございました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "製薬会社代表社員",
      "text": "この度はあの「ロドスのドクター」にお目にかかれて、身に余るほどに光栄です。お戻りになりましたら、アーミヤさんにもよろしくお伝えください。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分のやるべきことをしたまでだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "外回りもたまには悪くない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "製薬会社代表社員",
          "text": "あとは薬の配合方法とサンプルをお渡しいただければ――",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Thermal-EX.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "おおっ！　ついにこの私の華麗なる出番ですね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "製薬会社代表社員",
          "text": "ロ、ロボットが喋った！？　てっきり見た目が少しゴツい、ただの機械なのかと思っていましたが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "レイジアン工業の最新技術によって生まれ、天才クロージャ様と、偉大なるメイヤー様によりカスタマイズされた、この時代において最もパーフェクトなロボットが、この私でございます！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "ですから、驚かれるのも無理はございませんよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "ついでに一言申し上げますと、私の可能性はあなた様の想像を遥かに超えております。この灼熱のボディをご覧ください。瞬きは禁物ですよ。今からあなた様に光と熱のイリュージョンを――",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "おっと、Thermal-EX――",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "ドクター様、お呼びでしょうか？　私が必要とされていることは、承知しておりますよ。一声かけていただければ、ドクター様のために何でも致しましょう。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "今言おうとしたのだが。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "ちょっと黙っててほしい。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "了解しました！　Thermal-EX、ただいまより制御コネクタを切断致します――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "待て待て！　いきなり電源まで落とす必要はないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "コホン。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "ドクター、モバイル源石フロッピーの用意ができました。こちらの十枚です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "製薬会社代表社員",
          "text": "この中に薬の配合方法が入っているんですか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "いや、今――",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "うおっ、うおおおお！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "――データ転送中なので、完了してから……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "製薬会社代表社員",
          "text": "本当に不思議な機械……いやロボットです！　さすがはロドス、やはり尋常ではありませんね。医薬のみならず、工業技術もこのように素晴らしいとは。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "ありがとうございます！　あなた様のご慧眼も、同様に突出しておられるようです！　その熱きお褒めの言葉が、私の更なる原動力となるのです！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "製薬会社代表社員",
          "text": "は……あはは……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "転送進捗率、五十パーセント。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "ようやくこの任務から解放されそうだ。まさかA6のあいつらが恋しくなるなんてな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "少なくともあいつらとはまともに会話ができる。今回の臨時チームみたいに、全然しゃべらない奴も、ベラベラと永遠に話し続ける奴もいない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "スポット様、あなたは昨日、雨で濡れた毛並みを私に寄り添って乾かされたではありませんか。たったの十分間でしたが、あなたと距離を縮められたという事実が私を熱くさせたのですよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "コホン。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "転送進捗率、七十五パーセント。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "製薬会社代表社員",
          "text": "いやはや、それにしても今回御社とは想像以上に順調に――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "シーッ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "製薬会社代表社員",
          "text": "え？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "チッ、めでたい口だな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "伏せろ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "な、何？　通り沿いの壁が爆破された？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "あぁ、なんと馴染み深いエネルギーショックでしょう！　しかし、私のエネルギーとはやはり比較になりませんな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "ドクター様、私が盾となりましたが、ご無事でしたか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "大丈夫だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "君は掩体としては少し小さい。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "今の爆発の規模から考えて、多分地元のマフィアの仕業でしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "ですが妙な話ですね。我々がここで活動を始めてからもうずいぶん経ちますが、たまに揉めることはあれど、基本的には皆友好的だったはずです。我々は彼らに薬を提供しているわけですし。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "ああ、わかりましたぞ！　彼らはおそらく私を気に入ったのでしょう――私のようにパーフェクトでビューティフルで熱エネルギーあふれるロボは他におりますまい？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "私がいれば、彼らはあのような粗末な爆発物など必要としなくなるでしょうからね！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "……時々、こいつはミッドナイトの血を分けた兄弟なんじゃないかと思うよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "その可能性は高い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "お？　そりゃどっちについての話だ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "……頃合いを見計らって実行される計画的な奇襲には、必ず明確な目的がある。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Thermal-EXの持っている配合方法のデータか。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "どこからか取引の情報が漏れていたようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "ファイヤーウォッチさん……俺たちにまで睨みを利かせなくても……怖いですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "私の友人を謀る奴は、誰であろうと許さない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "おい、配合方法っていえば、このなんとかっていう代表さん、気絶してるぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "弱すぎだろ。壁からあんなに離れた場所にいたから、ビビって気絶しただけだとは思うが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "戦闘準備だ。敵が近づいてきた……五人だ。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Thermal-EX——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "承知いたしましたドクター様、なんなりとお任せください！　私の情熱は今まさに、最高潮に達しています！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "――タイミングを見計らえ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "来た。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "おおお！　エネルギーショック全開！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "全員倒れた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "こりゃ効率がいいな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "う……うぅ……灼熱……灼……熱……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "text": "……だが所詮ただの一発屋だな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スケール",
          "text": "Thermal-EXは……大丈夫なんでしょうか？　何かブツブツ言っていますが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "灼……熱……",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "過負荷で他の機能モジュールが一時的に停止しただけだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "数分すれば元に戻る。慌てる必要はない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ファイヤーウォッチ",
          "text": "外にまだ敵の援軍がいる。今度は更に多い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
