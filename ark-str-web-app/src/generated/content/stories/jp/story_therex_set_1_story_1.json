          "blocks": []
        },
        {
          "label": "一瞬で丸焼きにされるところだった。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Thermal-EX",
          "text": "申し訳ございません、ドクター様！　一度目は経験不足でした！　熱すぎる私には、敵を熔かすことと仲間を暖めることのさじ加減をうまく調整できなかったのです。",
          "portraitKey": null
