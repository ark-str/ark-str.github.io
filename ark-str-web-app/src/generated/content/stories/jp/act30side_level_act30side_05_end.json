{
  "server": "jp",
  "storyId": "act30side_level_act30side_05_end",
  "groupId": "act30side",
  "stageId": "act30side_05",
  "title": "不正乗車？",
  "storyCode": "RS-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act30side/level_act30side_05_end.txt",
  "sourceHash": "f444d575883da14ac4e94164826f1ba44efec1fd40baf38b7736f7f1731d72cd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私の手に掴まれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ふっ……おりゃあっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "よし、と！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "前にも列車で一度お会いしましたが、まさかこんな場所であなたに助けていただくとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "手を差し伸べていただかなければ、あとどれだけここに閉じ込められたか、わかったものではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ロザリン・タチアノヴナ・ラリーナ嬢、ご親切に感謝を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……ああ。別に何てことねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "お前、どう見ても地元民じゃねぇよな。山には観光に来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ええ、まさしく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "だったらどうして山道を歩かずに、こんな森の中に入ったんだ？　しかも狩猟用に仕掛けられた落とし穴に引っかかるなんてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私が偶然通りかからなかったらどうするつもりだったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "山の景色に魅了されてしまって、つい。まさか雪の下にこんな仕掛けがあるなんて思いもしなかったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "仮にあなたが通りかからなければ……もうしばらくはぼーっとしていたことでしょう。それから落ち着いて、どうにか自力で脱出する方法でも考えたかと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "しかし、こうしてみるに私は幸運だったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ふーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ところで、あなたはこのまま山を登るおつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ん？　ああ、そうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "であれば、もうしばし同行させてはいただけませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私も、イェラグの雪の山頂に広がる景色を堪能してみたいのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……いいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私は別に構わねぇよ。そんじゃ、行くとすっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "山頂まではまだかかるからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "今のは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "おーい、ライリー爺さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "ざっと様子を見てきたんだが、この辺に仕掛けた落とし穴が一つ崩れてたよ。多分獲物が落ちたんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "だけど、覗いてみても何もいなくてさ。多分、逃げられちまったんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "それより、さっきの奴を見たか？　トゥリエルの奴が探しとるとかいう男に似とった気がするんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "それって、デーゲンブレヒャーさんから探してほしいって頼まれてる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "真っ黒なコートの気取った奴で、帽子を被って顔を隠しとった。こいつは間違いないじゃろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "行くぞ！　すぐに戻ってこのことを伝えねば！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なあ、えっと……そういやお前の名前、まだ聞いてなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "お前らみたいに気取った連中は、会ったら最初に自己紹介して、形式張った挨拶とかするもんじゃねぇの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "おっと、これは失礼を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私はジョン・スミスです。ご随意にお呼びください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ジョン……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "その名前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "どうかなさいましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……前にドクターが見てたスパイ映画の主人公みてえだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "うん、絶対そうだ！　同じ名前だった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "確かその主人公には超絶美人のパートナーがいたんだけど……いややめとくか。カップル向けの人気スポットに一人で来てるくらいだから、あんたには相手なんかいねぇだろうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "面白い偶然もあるものですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "だろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "でさ、ジョン。本題に戻るけど、山頂まではもう少し登らないとなんねぇみたいなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "聞いた話じゃ、雪山って上に行くほど寒くなるし、息も苦しくなってくるんだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あんたはどうだ、疲れてねぇか？　休まなくて平気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "心配はご無用です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "ロザリン嬢こそ、休憩は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私は平気だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あんた体力は結構あるみてぇだな、「スパイ」の兄ちゃん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "……ははは。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "どうやら、彼は完全にあなたに騙されてるみたいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "私は嘘は言っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "「グレーシルクハット」は公爵のために情報を集める密偵だ。普通の嘘では騙すことなどできんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "だが私は、この手の人間が皆「疑う」ことに長けているのを知っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "「ペイルロッシュ家の跡継ぎが秘密裏に帰国した」――この事実を彼自身が発見した以上、それが重要だと信じ込むのは必定だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "ゆえに、彼がロザリン・タチアノヴナ・ラリーナをマークするのは当然の帰結だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あなたの読みはいつも正しいってことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あの子はもう山へ登ったし、ラタトスはアークトスに連絡を取っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あの「グレーシルクハット」もついていったと報せが入ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "彼は私を避けているようだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "構わん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "彼があの少女に注意を向けていることさえ確かめられたら十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "お前も、そろそろ出発の時間だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そうね。食後の運動と行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だけど、「グレーシルクハット」をあの子に近付かせたりして、あとからあのドクターに何か言われない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "「グレーシルクハット」はスパイであって、殺し屋ではない。彼が欲しがるものは命ではなく情報だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ドクターにもそう釈明するつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "ドクターには私から――謝罪をしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "良い心がけだこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "だが、私の動向など重要ではない。それより興味深いのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "デーゲンブレヒャー。お前がドクターを認識していたことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "Sharpは悪くない相手だった。実力不足の有象無象の騎士なんかよりずっとマシだったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あれほどの戦士に敬われていて、あなたにも一杯食わせた――そんな人間なら覚えておいて損はないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "ドクターに興味があると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そう思ってもらっても構わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ほら、世間話はここまでにして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "仕事の時間よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ひゃっほ～う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "やっと到着だ～っ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ふぅ、結局何時間もかかっちまったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "もうへとへとだぜ。中腹で皆引き返すのも納得だ。こんなん超疲れるもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "確かにここからの景色はサイコーだな……もしかして、ありゃ銀心湖か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あっはは、こっから見るとイェラガンド像が豆粒みてえだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "凍り付いた冬の銀心湖は、ここから見下ろせば透き通る宝石のように見えるとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "それゆえに、イェラグの民は皆、銀心湖をイェラガンドの与えたもうた宝と見なしているそうですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "確かに、これほどの高みに立たねば見られぬ景色ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "言われてみれば、ほんとに宝石みてーだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おっ、向こうには駅が見えるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "こうしてみると、イェラグも結構鉄道が走ってんだなあ。ここからだと、列車がおもちゃみたいにみえるぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "発展途上国としては、このくらい鉄道があっても決して多いとは言えない数ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "それが多く見えるのも、ここに銀心湖が、そしてイェラガンド像があるがゆえでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "今はまだカランドには及ばぬものの、すでに開通した鉄道路線はすべてここを経由して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "――待てよ。現行の路線はすべて、銀心湖を経由している……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おーいジョン、ぼーっとしてないで手伝ってくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "この近くで、並んで生えてる二本の木を探したいんだけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そいつらは多分老木なんだが、枝同士が絡み合って不思議な形をしてるらしいんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "なるほど、喜んでお力になりましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ありがとな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "つーかさ、ジョン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私が木を探してる理由は聞かねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そういや、山を登ってる理由も聞いてこなかったよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私も色々考えてみたけど……やっぱ得意なやり方で解決すんのが一番だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "何を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "動くな、大人しくしろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "……ロザリン嬢、これはどういうおつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そういう言い方やめろよ、まだ何もしてねぇだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "それより、正直に言え。ずっと隠れてついてきといて、山頂に着いても何もしてきやがらねぇとは一体何を考えてんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "何のことだかさっぱりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "とぼけんじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "お前に名前を教えた覚えはねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "……誤解ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "ご存知の通り、私はハロルド・クレイガボン子爵と付き合いがありまして。あなたの名前は彼から聞いたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ほーん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私を騙すのなんか簡単だと思ってんな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そもそも私は、あのおっさんにもフルネームは伝えてねぇんだぞ。なのにあいつがどうやってお前に教えられるってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "それに、山頂まで一気に登っても息切れひとつしねぇ奴が、ただの狩人の掘った穴なんかに落ちるわけねぇだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "たとえ落ちたのが本当でも、出てこれねーはずがねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "アンナたちにはいつも、もっとよく考えてから行動しろって言われちまうけど、私に言わせりゃのんびり考えてたってしょうがねぇ時もあんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジョン・スミス」",
      "text": "あなたは想像以上に注意深いお人ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "嘘ついてたこと、認めるんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "どうせジョン・スミスって名前も偽名かなんかだろ？　まさか……マジでスパイなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "そうだと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "だとしたら、お前この仕事向いてねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私でもおかしいって見抜けたんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ごもっともです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "実際、私は多くのミスを犯してしまいました。どうも、イェラグでの暮らしで少々気が緩んでいたようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "イェラグ内での行動は比較的自由が利く上に、私が脅威と感じるような人物もそういませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ハッ、でけー口叩くじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "言っとくが、妙な真似はすんじゃねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "お前が今立ってんのは崖で、足元にあんのは雪だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私が雪を蹴り落とせば、お前の足元は崩れる。そうなりゃ、引っ張り上げてやれる保証はねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いいでしょう。では、私からもお伝えしますが、あなたが昨日……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "待て！　ヴィクトリアのクソ野郎が！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "このアークトスが来たからには、好きにはさせんぞ！　その子から離れろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "うわあっ！？　お、おっさんどこから出てきたんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あああっ、待て待て！　そんなズカズカ歩いたら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "うわあああっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "ッ、ロザリン！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "掴まれ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いささか滑稽な状況ではあるが、アークトスは明らかに私を止めるためにここへ来ていた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "まさか、ロザリンには本当に、山頂へ来た目的があったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いずれにせよ、こうなった以上は後を追って降りるしか――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "――ッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……黒騎士ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "どうかしら、ゆっくり休めた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いいえ、まだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "それは良くないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そんな相手とやり合っても面白くないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "そこまで率直に言いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あら、いけない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "であれば、私からも率直に言わせてもらいましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あなたは、列車内で起きた出来事すべてが誤解だとハロルド子爵に信じ込ませたのですね。私もあの時は半信半疑でしたが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "今、はっきりとわかりました。かの高名な黒騎士も人を騙すのだということが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だったら、あなたはまだ私のことがわかってないみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "――今すぐにきびすを返して山を下りれば、まだのんびりランチができる時間よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "申し訳ないのですが、私は一度仕事を始めると寝食を忘れてしまうクチでしてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
