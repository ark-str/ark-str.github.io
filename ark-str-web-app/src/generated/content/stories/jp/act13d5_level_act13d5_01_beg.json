{
  "server": "jp",
  "storyId": "act13d5_level_act13d5_01_beg",
  "groupId": "act13d5",
  "stageId": "act13d5_01",
  "title": "エレンズチョイス",
  "storyCode": "MN-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13d5/level_act13d5_01_beg.txt",
  "sourceHash": "6cd5b69c6c1a989f290f11b753821d4a023a3e13f30cc048d8196ee1d8356e67",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔 1上"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "マリア！　どうだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "待って――もうちょっと！　……あとネジ一本！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "しっかり締めろよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "うん……あ、待って！　接触不良の原因がわかった気がする――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "早くしろ！　このジュークボックス重いんだよ、これ以上は持ち上げてられねえ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ほら、チーズ盛りお待ちどおさん、フォー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "……おい、今回は爆発せんじゃろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "たかがジュークボックスの修理で爆発するわけないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "そうとも言えぬ。源石と関係があるものなら、コーヴァルはやりかねんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "俺の悪口を言ってるのは誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "コーヴァル師匠！　き、気を付けて、あんまり動かさないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "おお――すまねえ、マリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "フォー！　俺の手が空いたら覚悟しとけよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "いいだろう、待っておるぞ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "賑やかなのはかまわないが、うちのバーでケンカはやめてくれよ。グラスを割ったら弁償だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "ふん、あやつはもう何十年もああしてグダグダぬかしておるが、あやつがわしに勝ったのを見たことがあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "前回だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "あー……前回わしはだいぶ酔っておったからな。それに、関節炎も出とったじゃろ……だからあれはノーカウントじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "ゴクゴクゴク――プハーッ！　……昔、あやつがわしにくっついて辺境を駆け回っておった頃は、あんな口の利き方はさせなかったんじゃがな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "フォー！　またあんた大ぼら吹いてんじゃないだろうな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "昔、お主はわしの従者の一人だったくせにという話よ！　どうじゃ間違っておるなら言うてみい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "いつまで過去の栄光に酔いしれてんだよ。今やあんたにヘコヘコしてた従者たちが、スーツを着込んであんたや俺の上に立つ時代だろうが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "マリア！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ひゃいっ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "痛っ――！　痛てて……この馬鹿、急に手を放すんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ご、ごめん。でもちょっと隠れさせて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ゾフィア、頼むからそっと開けてくれ。今月だけで何回ドアを交換したことか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "はぁ……これだから自動ドアに替えたくても躊躇するんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "どうしたゾフィア？　そんなすごい剣幕で怒鳴り込んできて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "そこにいるんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マ・リ・ア！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ひぃ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "おい嬢ちゃん、バレてるぞ。というか、そもそも隠れられてないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "うぅ……このジュークボックスどうしてこんなに小さいの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ねぇ師匠、今あの人どんな顔してる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ヤバいな……酔っぱらって暴れたガキの騎士を追い払った時以来、あんな怒った姿は見たことねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "――あっいや、微笑みながらこっちに来るぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "それはもっとヤバい時のやつだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "コーヴァル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ゴホンッ――フォー！　酒でも飲もうぜ！　あんたさっき俺の悪口を言ってたよな？　今日はあんたを酔い潰してやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "ケッ、逃げ出してきおったか腰抜けめ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "じゃああんたはどうしてマリアを助けに行かないんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "わ、わしは何があったか知らぬからな！　他人の家の問題にむやみに口出しせぬ方がよかろう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マ、リ、ア、どうして隠れてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "え、えーっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "君ね……何か私に隠してるでしょ？　ていうか私もう全部知ってるんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あは、あははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア、騎士競技に出ることが何を意味するかわかってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "なるほど……ゾフィアがあんなに怒っとるのはそういうわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "どうして私に相談してくれなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "だ、だってゾフィア姉さん絶対怒るでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "怒るに決まってるでしょ！　だって君、自分が向き合ってるのがどういうものなのか、全く理解してないじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "うぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "で、でも私だって少しくらいはわかってるつもりだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "へえ、それは実の姉を見てわかったつもりになってるのかな？　カジミエーシュの耀騎士、メジャー最年少の奇跡の一人に習って？　それは良かったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "でもね……君は、マ・ー・ガ・レッ・ト・じゃ・な・い・の・よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "痛い痛い！　み、耳をつねらないで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "で、でもうちの家の経済状況はどんどん酷くなってるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……お祖父ちゃんが死んじゃった後も、叔父さんは相変わらず騎士協会と関わろうとしないし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "冗談抜きで、来年には寝るためのベッドすらなくなっちゃうかもしれないの！　家具を全部売り払うしかなくなっちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……もしそうなったら、うちに住めばいいじゃない。お風呂場は大きいし、庭だって二つあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "どんな理由があろうと、軽率に競技騎士になんてなるもんじゃないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "首席のいない騎士一族は、貴族騎士として認められないんだって。協会からもう何度も催促が来てるの……どうしようもないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お姉ちゃんがカジミエーシュから追い出されてずいぶん経ったし、私がなんとかするしか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "たとえそうだとしても、私に相談するべきでしょ……君一人で勝手に突っ走り過ぎよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "うう……それは本当に申し訳ないと思ってるよ……でも相談したらゾフィア姉さんはきっと私を止めたでしょ？　だから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "当然止めたでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……じゃあ今はどう思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……「耀騎士再び！？　ニアール家から新たな騎士がデビュー。貴族の栄光奪還なるか」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "今日の競技新聞のトップ記事よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あははっ……やっぱりお姉ちゃんって有名人なんだねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "笑い事じゃないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "メディアは手段を選ばないから、きっと変な見出しとデマでさらに盛り上げようとするだろうけど……今辞退すればまだ間に合うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "でももし私が出なかったら、ニアール家は破産して貴族騎士の資格を剥奪されちゃうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "自分が何をしてるかはわかってるつもりだよ。ゾフィア姉さん……私……やらなきゃダメなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア、君ねぇ……ちょっと、マーティンおじさん！　騎士競技がどんなものか詳しいでしょ、何か言ってやってよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "そうだな、うん……だったらやらせてみればいいんじゃないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "――はぁ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "マーティンおじさん！　ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "いやいやいや！　今のマリアじゃ私の腕一本、いや、指一本にすら敵わないかもしれないわ。本気で言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "言い過ぎだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "そう言うてやるなゾフィア。お主はメジャー十六強入りした騎士。お主の腕一本に勝てさえすれば、それで合格ラインじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "そうそう、今のフォーもゾフィアの腕一本には勝てないしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "何じゃと？　もういっぺん言うてみい！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ふぅ……まあここの常連客はみんな引退した年寄りばかりで、実力も昔ほどじゃない。だが人を見る目に関しては食えないジジイたちだ。俺もマリアは見込みがあると思うがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "何を言うか！　食えないジジイなど、誉め言葉ではなかろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "意味が通じてんだからそれでいいだろ！　……ったくあんたらお騎士様たちは、そんな気取った話し方してよく疲れねえな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ゴホンッ――フォーの言う通りだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "私はマリアの才能を信じている。この子のアーツと剣の素質は悪くないはずだ、幼い頃からの剣の練習を見てきた君ならわかるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……でもここ数年、マリアは機械に夢中だったし、てっきり職人にでもなりたいんだろうと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "機械いじりはただの趣味だよ。別にやめたいとは思わないけど、今はそれよりもやらなきゃいけないことがあるから――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "痛っ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……私はまだ君が勝手に決めたことを許してないわ。今回ばかりは冗談じゃ済まされないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……その点に関しては私もゾフィアに賛同するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "一族のために身を投げ出し、それでも前向きでいられる君の心意気は賞賛に値する。しかし騎士競技は、君や観客たちが思っているような華々しいものとは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "いや、華々しいだけではないというべきかな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マーティンは片腕を上げて見せた――その腕は大半が機械に置き換えられ、関節からは精巧な駆動音がする。"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "これはちょっとした不注意がもたらした結果だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "そうじゃな……わしも覚えておる。相手は双剣使いのヴィクトリア人じゃったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "じゃが、最終的にお主は勝ちおったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "そうだ、それでも私は勝った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "これがいわゆる栄光の代償ってやつだ。今じゃグラスを拭くのさえ一苦労だがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "騎士競技か、ふんっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "競技場には本物の哀れみも敬服も有りはしない。滴り落ちる血だけが本物なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "観客が歓声を上げるのは、単に刺激によって満足したというだけ。スポンサーの厚い待遇なんてのも、ただの利益目的さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "よく覚えておくんだ。リスクをしっかりと見定めた上で攻める。これこそ真の騎士に必要とされる素質だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "わ……わかってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……マリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……うん。私、本気だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "叔父さんはいつも「たとえ貴族の身分が剥奪されたとしても、紋章が無くなったとしても、金輪際『ニアール』が存在しなくなるわけじゃない」って言ってるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "でも私はやっぱり守りたいの。お祖父ちゃんやお姉ちゃんがずっと守り抜いてきたものを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お姉ちゃんはもうここにはいない……私は、ニアール家最後の世代として、自分の家が没落していくのをただ見てるなんてできない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "もしそんなことしたら……私は自分で自分が許せなくなるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "過酷な現実を知ってなお、茨の道に足を踏み入れる……これこそが騎士じゃ、時代がどう変わろうとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "マリアよ……わしはお主ならできると信じておる。この一杯はお主に捧げよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ハッ、俺もだ、マリアに捧げるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "（無言でグラスを掲げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "はぁ……私はみんなに説得して欲しかったんだけど。次から次へとほだされちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あの……ゾフィアおばさん、お願いだから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "その呼び方はやめて！　君より五歳年上なだけなんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……私だってニアール本家に仕えてきたんだもの。もちろんマリアの気持ちもわかるわ。でもやっぱり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "私ちゃんと剣術を磨くから！　ちゃんと言うことも聞くから、私のことを信じて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "そうだ！　だったらゾフィア姉さんが私の教官になってよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "へぇ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（あれ？　マズった――かな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "そういえば、最後に私たちが剣の稽古をしたのって、いつだったかしらね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……お姉ちゃんがカジミエーシュを去るより前だっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "じゃあその時君に教えた剣術はどんな技だった？　どの国の？　どういう時に使うもの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "えーと……あはは……ど……どの技だったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……うん、いいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "明日の朝、うちの庭の訓練場に集合よ。遅れたりしないわよね？　騎士のマリアさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "え？　う……うん、遅れない、絶対遅れないから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
