{
  "server": "jp",
  "storyId": "act16side_level_act16side_03_end",
  "groupId": "act16side",
  "stageId": "act16side_03",
  "title": "混血児",
  "storyCode": "GA-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16side/level_act16side_03_end.txt",
  "sourceHash": "80352fd02f811965fb6c18eaa5933c5124a0bd75399f47ae1f5b55671e951d40",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "逃げるつもりのようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "させないわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ご機嫌な物売り",
      "text": "……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "静かな物売り",
      "text": "うっ……俺が食い止める、早く逃げろ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ペッローがサルカズのために攻撃を防ぐなんて……あなたたち、逃がさないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "エゼル、あなたはここで大人しくしていなさい。下手な……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "下手な真似は許さない、ですね。わかってます、端末の電源も切ってませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "僕が守りたいのはセシリアの安全だけなんです、どうか信じてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……考えが変わったわ。あなたは今すぐセシリアを大聖堂へ連れて行きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "このまま街にいては……なおさら危険よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "え……？　聖像の方に向かってたんじゃないの？　お兄ちゃん、聖像はあっちだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……ちょっと遠回りしようと思ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "遠回り？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "君が今行くべき場所は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "安魂教会だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "逃げられないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ご機嫌な物売り",
      "text": "もう追いついてきた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "静かな物売り",
      "text": "どうすりゃいいんだ、全然振り切れない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ご機嫌な物売り",
      "text": "こうなったのも私のせいだし……あのリーベリは絶対に見逃してくれないわ。私が残るからみんな行って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "静かな物売り",
      "text": "お前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ご機嫌な物売り",
      "text": "いいから行って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "下がりなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "この、アーツは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "アンド……アイン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "今度こそ逃がさない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "出てきなさい！！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "わからないわ。教皇聖下はなぜあの「迷い人」たちをこうも……野放しにしておくのかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "モスティマ、あなたあの人たちと知り合いなんだし、思い当たる理由があれば教えてくれないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君とその話はしたくないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "そんなに根に持っているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あの時、あいつの手で死にはしなかったけど、君には殺されかけたからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "忘れられない経験だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "だから私の前でもずっとフードをかぶっているの？　邪魔じゃないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "これだけ長くレガトゥスをやってるんだし、フードをかぶるくらいどうってことないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "とにかく、君とはできるだけ関わりたくないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あら、私への恨み言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……別に。ラテラーノには守るべきものがあって、君みたいにそれを重んじてる人もいるってだけの話でしょ。それに文句なんて言うつもりないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あなた、ちょっと誤解してるわ。教皇庁にとどまる堕天使がめったにいないのは、教皇庁じゃなくて堕天したサンクタ自身に原因があるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "私の態度はちょっと過激かもしれないけど……モスティマ、あなたに自分は変わり者だって自覚はないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そんな言い方されたら、私も君が言うところの「一般的な堕天使」になっちゃうかもしれないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "もしあなたが「一般的な堕天使」と同じ道をたどるような人なら、私と「こんな話」すらできてないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "はいはい。それで、フィアメッタはいつ異動させてくれるのさ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いつも私にくっついてちゃ、いいことなんて何もないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "本人に直接は言わないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "言ったよ、でも効果なし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "じゃあ私が言えば効果があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君はよーく知ってると思うけど、権力は他人の意思を無視できるから便利なんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "他人の意思を無視するにはそれなりの対価が必要になるわ……そうまでしてフィアメッタを異動させたい理由を教えてくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フィアメッタは私の護衛とか言ってるけど、そもそもあの子を護衛につける必要なんてあると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "もちろん、堕天使である私の監視役だと思ってる人もいるみたいだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そういう人は、たぶんフィアメッタのことを何もわかってないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私はフィアメッタに餌にされてるだけさ。アンドアインを釣るためのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "その言葉を彼女が聞けば、きっと不快に思うでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "はいはい、じゃあ言い方を変えるよ……私自身じゃなくて、背負ってるこの錠と鍵が餌だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "……それで？　フィアメッタの願いが叶うのが嫌なの？　彼女がアンドアインの始末に成功するか、或いは大聖堂に連れ帰ることができるのなら、私は当然うれしく思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "それとも、あなたたち二人がかりでもアンドアインは捕まえられないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そうじゃないよ。アンドアインが錠と鍵を気にかけてる限り、食いついてくるのは間違いないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ただ……思うんだけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "もしさ、アンドアインがもう別の道を見つけてたらどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "八年前のあの雨の夜からは、私もレミュアンも、アンドアインでさえ抜け出せたのに、フィアメッタだけが囚われたままなんて……そんなの見たくないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あの子にはこんなの言えないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "こういう時だけは共感の便利さが恋しいよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あっ、というかフィアメッタってリーベリだったね。今のナシ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "まことに若者の会話であるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "なんですか、私に「経験者の教え」でも説くおつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "年長者の特権を行使してよいのなら、是非ともそうさせてもらいたいところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "構いませんよ、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "八年前に君が私に言ったことを覚えているかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……えっと、この和やかな雰囲気を壊したくはないんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……すっかり忘れちゃいました。すみません、教皇聖下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "「いや……私にはまだやるべきことがあります。守らなきゃいけない人がいるんです」だったかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……ヴェルリヴが私のモノマネなんて寒気がするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "あの時君は、私が君に代わって選択することを拒んだ。ならばなぜ今君は、フィアメッタに代わって選択を下そうとしているのかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "人の道とは自身で探求し、選択し、そして自らの足で歩んでいくものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "ヴェル、これは君への答えでもある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……セシリア、もうすぐだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ごめんなさい、エゼルお兄ちゃん。わたし歩くの遅いから……お日様ももう沈んじゃうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "いや、セシリアはすごいよ！　交通機関が使えないのに……頑張って移動区画の外まで歩いてきたんだから。もし僕にフィアメッタさんみたいな身のこなしができれば、こんな苦労は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "大丈夫だよ！　ママと一緒にお家からすごく遠いところに行ったこともあるし……ここと同じくらい遠かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "でも、こっそりここに来たこと、フィアメッタお姉さんに気付かれないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "端末の位置信号をチェックされるだけだったら大丈夫なはず……僕の細工が少しくらい時間を稼いでくれればいいんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "それに……もう到着だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママはここに来てるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……セシリア、君にどう説明すればいいかずっと考えてたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "フェオリアさん――君のママは、確かにここに来た。でももうここにはいないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "僕には君をママに会わせてあげることはできない。だけど、ここでならママとお別れすることはできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃん……お兄ちゃんが言ってること……よくわからないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママがここに来たけどもういないなら、ママは……また別のところに行っちゃったってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "どこに行っちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……まずは中に入ろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "市民",
      "text": "……父は亡くなる前、葬儀に涙はいらないから、笑顔で見送ってくれと望んでいました。でも私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な修道士",
      "text": "きっと、ご尊父様が本当に望まれていたのは、ご自身の逝去によりあなたが悲しみに暮れないことなのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な修道士",
      "text": "涙を見せようが、笑顔で振る舞おうが、それがあなたなりの別れ方ならば……きっとご尊父様は喜んで受け入れてくださいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市民",
      "text": "ありがとうございます……修道士様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な修道士",
      "text": "さぁ、表へ出てお花畑でも散歩しましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お兄ちゃん、あのお姉さんもお父さんが「なくなる」って言ってたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "うん……亡くなった人は、みんなここに来るんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "だから生きてる人たちもここに来て、そんな人たちとお別れをするんだ……それから、亡くなった人への想いとともに生きていくんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "じゃあ亡くなった人はどこに行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……お空で、僕たちを見守ってるのかもしれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お空に行っちゃったから、もう会えないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、これを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "これは……ママの守護銃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……僕の両親も、公証人役場の執行人だったんだ。二人とも忙しくてね、小さい頃は全然会えなかったから……おじいさんが僕を育ててくれたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "おじいさんは自分の銃をすごく気に入っていて、いつも銃を磨くたびに、僕に若い頃の話をしてくれた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "参加した戦争や、戦友について……おばあさんと出会った時の話、あとは僕のお父さんが小さい頃にやらかした話……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "おじいさんの銃を見るたびに、そんな話を思い出した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……そんなある日、おじいさんは亡くなった。僕がセシリアよりほんのちょっと大きいくらいの頃だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "それから、おじいさんの銃は公証人役場の執行人に持っていかれてしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "僕が君のママの守護銃を持ち去ろうとしたみたいに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エゼルはゆっくりと膝をつくと、フェオリアの銃をセシリアの手に置いた。\nセシリアは下を向き、手の中にある母親の守護銃を見つめた。\nエゼルがセシリアの手を優しく握りしめる。\n温かな水滴が守護銃に刻まれた模様に滴り落ち、少女の手の平へと流れ、小さな水たまりを作った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お兄ちゃん……わたしどうして泣いてるんだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……おじいさんから教わった通り、僕は毎週裏庭の鉢植えに水をあげた。そしたら綺麗な花が咲いたから、僕はうれしくなっておじいさんを呼んだんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "でも呼んでから気付いた。おじいさんはもういないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "僕はもう二度とおじいさんに会えないし、それ以来おじいさんの銃を見ることもなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "「亡くなる」ってね、もう二度と会えなくなるお別れなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "しかし、別れとはすなわち死を克服することだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "生者はこちらに、死者はあちらに――ゆえに「別れ」となる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "「別れ」とは生者の死者に対する想いであり、ゆえに死者の存在の証明である。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "だからこそ私たちは、別れを告げねばならない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
