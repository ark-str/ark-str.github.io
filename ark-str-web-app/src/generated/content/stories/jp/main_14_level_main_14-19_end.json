          "type": "dialogue",
          "speakerName": "テレジア",
          "text": "では、私たちは敵になるしかないわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "テレジア……さん？",
