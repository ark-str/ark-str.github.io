        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "殿下も……昔はこうやってあたしのことを見守ってくれたんでしょうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "ありがとね、アーミヤ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
