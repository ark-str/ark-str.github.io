  "storyId": "main_0_level_main_00-09_end",
  "groupId": "main_0",
  "stageId": "main_00-09",
  "title": "騎士",
  "storyCode": "0-9",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_00-09_end.txt",
  "sourceHash": "5eba46818942b03ea0912432fd2d6f0037c76898a813aad1ebe3d877ebfdabe9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "きゃっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "！　危ない！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "だ……大丈夫です、このくらい……かすり傷ですから……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "包囲網が、少しずつ狭まってきています……早くここから抜け出さないと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "そうは言っても、今の人数では守りに入るしかない……！　包囲自体の突破口は見つけたが、増援がなければどうにもならんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……わかりました。であれば、もう少しだけ耐えてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "敵方の先鋒には、我々――術師オペレーターが対応します！　みなさんは、狙撃手を優先的に攻撃してください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "アハハ！　いいねえ、その調子だ！　――F3からE5へ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "チッ、あのガキ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "素晴らしい！　そのまま行くよ！　――次はB4からB5だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "！　敵が後方から回り込んできます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "であれば、牽制を！　重装オペレーターを二人、狙撃オペレーターを一人、対応に回してください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "それじゃ、今度は――H2からH6！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "嘘……！？　あ、あの人たち、突撃してきますっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "っ、前衛オペレーター！　奴らを抑えろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "わお、いい表情するじゃないか。もっと苦しんで見せてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "――さあ、今だ！　C7へ！　奴らのルークを蹴散らせ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "術師！？　一体どこから！？　――まさか、重装兵の背後に隠れて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ッ来るぞ、伏せろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "きゃああっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ぐ、ッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "――死ね、死ね！　雨に打たれる炎みたいに、惨めに消えろ！　アハハハハ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っ……あんな指示で――チェスの駒でも動かすような一言で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "粗暴な構成員たちをたった一人で制御して、あれほど正確な指揮を執るだなんて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "このままでは、向こうに有利な展開へと持ち込まれて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "少し見方を変えてみろ。あのガキが部隊の要なら、奴さえ抑えればどうとでもなるということだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "――総員、奴らに付け入る隙を与えるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……クソッ……しかし何にせよ、時間がないぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ええ！　これ以上、足止めを喰らうわけにはいきません……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "何か……何か方法を見つけて、この状況を打開しなければ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクターや、みなさんの身に危険が……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "う、うわああああっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "――えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "……一体……何が起きてるんだ？　――僕の兵士が、吹き飛ばされた……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "あれは……何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――到着が遅いと思えば、こういうことか。お陰で、待ち時間のあいだに、市民の避難誘導まで済ませてしまったが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　その声は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――さて、道を開けてもらおうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "うわっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "皆、今だ！　敵が陣形を整える前に、一気に仕掛けるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――ニアールさんっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "アーミヤ、無事で良かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ひとまず、話はあとだ。まずは撤退しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ああ！　助かったぞ、ニアール。お前がいてくれてよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "いいや、そちらが信号弾で正確な座標を教えてくれたおかげだ。……しかし、これは確かに厄介な状況だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ときに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "あなたがDr.{@nickname}か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――カジミエーシュの耀騎士（ようきし）、ニアール。あなたたちを迎えに参上した。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
