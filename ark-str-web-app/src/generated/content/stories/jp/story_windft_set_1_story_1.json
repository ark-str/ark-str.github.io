{
  "server": "jp",
  "storyId": "story_windft_set_1_story_1",
  "groupId": "story_windft_set_1",
  "stageId": null,
  "title": "古工場のダンス",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_windft_1_1.txt",
  "sourceHash": "ad9eabdc10a8b8ada02d5955c63d35e425fcc4411ddbb3d1cd7935ddd672b5d9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "月曜日"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "父さん、母さん、ただいま……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あれ？　お客さん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ふむ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若造よ、お前さんがガントとこのせがれか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "どうりでわしが出向かにゃならんわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "まったく今どきの若もんは、一日中端末ばっかり見おって……お前さんみたいなのに洗濯機の修理を任せてたら、洗いかけの服がひからびてもまだ直っとらんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "僕はただ採用通知を待ってるだけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "お前さんのような若い連中が揃いも揃って外に出たがるせいで、わしらのような老いぼれは、家の物が壊れたら、わざわざ大金を外の奴らに払って修理しに来てもらわねばならんのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "全く理解できん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "わしがいることに感謝するんだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あっ、レンチを落としましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "そこに突っ立っとらんで、さっさと手伝わんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "は、はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "いたっ……タンスの角に足の指を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "まったくそそっかしい……その調子で何ができると言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "お？　ガントんちの息子が帰ってきてたのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "だったら、ジョンさんはもううちに来なくても大丈夫だ！　うちのドアの錠はガントくんの手が空いてる時に見てもらうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "いや、僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "おい、この老いぼれじゃ上手く直せんとでも言いたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "言っとくが、お前さんの家のボロい錠くらい、どんなに手が震えてでも直せるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "そうじゃないって！　俺はただジョンさんの負担を減らしたかっただけさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……こいつの腕じゃ任せておけん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "少し待っておれ。こっちの仕事を片付けたら、行ってやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ジョン爺さん、錠の修理なら僕、できます。だから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ガントのせがれよ、老いぼれをあまりなめないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ジョン爺さん……僕、そんなつもりなんかないですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "荷物を置いたらすぐに手伝います。少し待っててくださいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火曜日"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "ガントくん、今日も来てくれたんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "はい……修理に来るって約束しましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あの、ウィリーおじさん、ここに置いてあるのはなんですか？　ストラップ……それとも、オモチャでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "こいつか。説明すると長くなるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "子供が生まれた当時は、俺も女房も忙しくてな、子供と遊んでる暇なんてなかった。だから、バネに小さなオモチャを引っ掛けて吊るしておいたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "仕事の合間に物を取りに帰ってきた時、タンスを閉めると、このオモチャはしばらくの間ずっとピョンピョンって揺れるのさ。それを見ると、娘は夢中になって掴もうとするんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "なるべく長く揺れてもらうために、毎回わざと思いっきりタンスを閉めてたよ。そんでいつしか、それは俺の癖になっていった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "今じゃ娘も家を出て外で働いているが、俺のこの癖はずっと治ってない……切符を買う金がもったいなくて、もう何年も娘と会えてないがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "だけど、このオモチャを眺めていると、娘が近くにいるような気がしてくるんだよ。だから、壊れては修理を頼んでんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……ちょっと待ってくださいね、ウィリーおじさん。ここの部分にもう少し多めに潤滑油を塗っておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "それと、ここにちょっとした緩和器を付ければ、かなり寿命が延びるはずです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "そうか……はぁ、結局こいつがしょっちゅう壊れるのだって、俺の悪い癖のせいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "娘のことは確かに心配だが、俺と女房は地元の方が性に合うし、生活もそれなりに上手くやれている。　そうだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あっ、ジョン爺さん、ドライバーを落としましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……若造。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "わしの仕事にケチをつけようってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "いえいえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ただこうすれば耐久性が上がるから、ジョン爺さんも頻繁に修理に来なくて済むでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……目ざといところもあるじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "それとも誰かに教わったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "小さい時は工場で手伝いをしていましたので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "僕がこっそり働けば、両親の収入も増えるし、学費も早く貯まりますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ほら、あの一番大きな製造ラインですよ。もしかしたら、ジョン爺さんとも会っていたかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ガキのお前さんとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "フンッ。……若造よ、お前がガキだった頃のわしは、こんな工具なんざ握っとらんかったぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "そうだぜ！　昔のジョンさんはなぁ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "（タバコを大きくひと吸いする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ゲホッ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "端末",
      "text": "ピコン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "「ママジョンズがお届けする……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "なんだ……広告か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若造、仕事中だぞ、集中しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あっ、はい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "水曜日"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "ジョンさん、最近脚の調子はどうだい？　それと、手の痛みもまだひどいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ゴホッ、まあまあだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若造よ、昨日の仕事っぷりは悪くなかったぞ。今日はお前が先に作業してみるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "はい、分かりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "この錠……ここまで劣化していると、修理したところでまたすぐに壊れちゃいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "どうして新しいものに取り換えないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "あー、お前はもう何年も帰ってなかったから、知らないのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "うちの嫁、移動都市に出稼ぎに行ったんだよ。起業して大金を稼ぐまでは戻らないんだとさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "だから、あいつが戻ってきた時に、昔持ってる鍵でドアを開けられるよう、この古い錠をずっと残してんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "もし俺が錠を変えたら、遠くにいるあいつに鍵を送るにはかなり高くつくだろう？　手紙を送るだけでもあんなに金がかかるんだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "鍵を一つだけ送るのはもったいない……かと言ってこんな所にわざわざあいつに送るほどのモンもない。仮に送るモンがあったとしても、無駄遣いだって嫁に怒られるだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "まぁなんだ、地元に残った俺にできるのは、しっかり自分の仕事をこなすだけだ！　コツコツ頑張ってりゃ、いつかは報われるだろうぜ、な！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……そうなんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "だけど、鍵に合わせて、同じ錠に変えることだってできますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "そんな金なんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "シリンダーを作るのは難しいし、できる人も少ない。たとえいたとしても費用がな……そんな金があれば、貯金した方がマシだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "完璧に直すのは難しいですよ……とりあえずやってみますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "ガントくんは都会の立派な大学を出てんだ、きっとできるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "立派な大学か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "（タバコを大きくひと吸いする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "そいつは将来有望だろうな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "端末",
      "text": "ピコン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "（端末を確認する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "また気が散っとるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あっ、すみません……ただ、今は就活シーズンで求人を出している企業も多いから、チャンスなんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……残念ながら、届くのは毎回悪い知らせばかりですけどね",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "心配すんなって。お前みたいな立派な若者なら、いつか必ず上手くいくさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若造よ、そんなに出ていきたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "新しいことを学んで、持ち帰りたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……いい心がけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "初心を忘れなければそれでいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あっ、またドライバー落としましたよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "木曜日"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "ガントくん！　マジかよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "新しいシリンダーを作ってくれたって？　やるなあ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "いえ……大したことじゃありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "（黙々とタバコを吸う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……老いぼれはやはり若者にゃ叶わんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "おいおい、マジかよジョンさん。ここで修理の仕事をやり始めてもう何年経つんだ？　そんな弱音、今まで一度だって言わなかっただろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "（黙々とタバコを吸う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若造、一つ頼まれてくれんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "はい、なんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "わしの家に……古いピアノがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "おぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "これは……立派なピアノだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "だけど、もう長い間、誰も弾いていないように見えますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老いた労働者は鍵盤蓋を開ける。埃が空気中に舞い散った。\n機械オイルの油汚れがこびりついた指で鍵盤を叩くと、ピアノは音程の外れた不明瞭な音を発した。"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "前にこいつをちゃんと弾いたのは、もう何十年も昔のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "当時のわしは――広々とした立派なホールで演奏をしてたもんだ。下の観客席には、わしのピアノファンでびっしりと埋まっておったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人は震える指で曲を一節奏でる。\nすると、部屋の奥からカサカサと布が擦れる音と共に、しわがれた嬉しそうな声が響いてきた。\nあなた、聞こえたわよ！　ピアノを弾いているのね？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "おお、マギー、聞こえるか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "なら、こっちに来てお前の大好きなダンスを踊っておくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "調子はずれな音ではあったが、震える指から絶え間なく奏でられる旋律からして、それが楽しげな舞曲であることが辛うじて聞き取れる。\n老婦人はスカートの裾を持ち上げ、優雅にポーズを取ると、つま先を伸ばしステップを踏み出す。\nそのダンスには正式な名前があるようにも、専門的な指導を受けた経験があるようにも見えなかったが。それでも老人は瞳を細目、ゆるりとターンを決める妻を愛おしく見つめた。\nガントは無意識のうちに呼吸を止め、目の前の光景をじっと眺めていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "手を治すために、あらゆる医者を訪ねて回って、最終的には諦めたというわけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "その手……そうだったんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若造よ、お前がやっとの思いで外で仕事を見付け、いよいよ初出勤の日になった途端、頭の中の知識だけがすっぽり消えちまった状況を想像してみな。それと同じさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "自分のした努力も、手に入れた栄光も、成し遂げたことも、全て覚えているのに、手元には何も残っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "わしの手はもう鍵盤を上手く叩くことはできん。そして、このピアノを見る勇気すらも、なくなってしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "だから僕が、子供の時に工場で会ったことあるかもしれないと言った時に、あんな表情をしたんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "両親が教えてくれたんです。僕がこっそり働いていたこと、実はみんな知っていたんだって。もちろん、工場側はそんなこと許していませんよ。だからみんな、ずっと黙っててくれてたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……あいつらはわしのことも黙っててくれたさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ピアノを弾けなくなったせいで、契約していた会社が違約金を請求してきおった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "契約書にそんな細かな条件が書かれていたなんて、一体誰が気付けると言うんだ？　あれはわしが死ぬ気で一生ピアノを弾き続けてようやく払えるような額だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "わしはここへ逃げ込み、連中が探しに来るたびに倉庫のあらゆる場所に隠れてやり過ごしてきた。そして、マギーに出会ったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "マギーはわしのために、隠れ場所を探してくれて、こっそり食事まで届けてくれた。そして、外の夕日がどんなに美しいのかを教えてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "じゃあ、このピアノは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "この前こっそり戻って、古い倉庫から引っ張り出してきたものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "もう二度とピアノを弾くことはないと思っていたんだが、マギーの耳が……遠くなり始めてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "あっちこっちで色んな仕事を引き受けていたのも、どうしても金が欲しかったからだ。マギーの耳がまだ聞こえているうちに、このピアノを修理に出して、毎日演奏を聞かせてやりたいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若造、いや、若いの……わしもわざとお前さんの粗さがしをしていたわけではない。お前には任せておけないと言ったのは、ただ……稼ぎが減るのが心配で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "すまん……若いの、わしのためにこのピアノを直してくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "わしらにはもう時間がないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "だけど……僕に楽器の修理経験なんてありません……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "坊や、そんな困った顔をしないで。できないのなら、それもでいいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "執着しすぎると、前のジョンのようになりかねないもの。私、何度も彼に言い聞かせたのよ？　一番大切なのは今この瞬間だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "音が聞こえなくなったって、彼が奏でるメロディーはずっと心に刻まれているわ。何もかもが終わったわけじゃないんだから、なんとでも方法はあるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "いえ、僕、絶対に直し方を覚えます。だから、安心してください。一生懸命勉強しますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ただ、少し考えていただけです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "もし僕が二人と同じようなことを経験していたら……きっと、僕は今の二人のようには生きられなかったなと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "二度とピアノが弾けないと知ったら、二度と音が聞こえないと知ったら……きっと僕はすべての夢を諦めてしまうはずです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "どうやって立ち上がり、前に向かって進めばいいのか、想像もつきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "だけど、さっきの光景に、すごく……心を揺さぶられたんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人の老人の顔は、気分の高ぶりのせいか、うっすらと汗の玉が滲んでいる。それをガントはじっと見つめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "こんな言い方は失礼かもしれませんが……欠けた星でも夜空で輝き続けられるのなら、僕にだってやればできるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "頼んだぞ、若いの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "金曜日"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "調律はわしに任せろ。だが……いくつかの鍵盤は、押しても戻りが遅い。恐らくハンマーと上手く連動していないんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "どれどれ……たぶんここのレバーフレンジの部分が原因でしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ジョン爺さん、先が曲がっているタイプのペンチはありますか？　ここのネジを調節してみます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ほら、替えのスプリングだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "よし……これをここに装着すれば、この……えっとハンマーってやつも、動きが良くなるはずです……そういうことですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "ああ、その通りだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若いの、少し休ませてくれ……お前さんももう少しゆっくりしな。後で一緒に夕飯でも食べよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "（マギー婆さんは将来……耳が完全に聞こえなくなるんだよな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "（このピアノを直したとしても、あとどれくらい時間が残っているんだろう？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "おお、マギー、聞こえるか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "なら、こっちに来てお前の大好きなダンスを踊っておくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "（結末を変えられないのなら、ピアノを直したところで結局、二人にとっては大した助けにはならないんじゃないのか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "（だけど、もし曲を目で見えるようにできれば……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "羽獣の一番柔らかい綿毛なら、弦の動きに影響しないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "外付けの装置をこの部分に取り付ければ、音の響きも変わることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "二人がこの色を気に入ってくれるか心配だけど、あの日、マギー婆さんが履いていたスカートはちょうどこんな感じの水色だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "同じ色の染料を探すのは大変だったよ。自分のセンスにはそんなに自信はないけど……うーん、まぁ、羽とリボンが嫌いな人なんていないよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガントが試しに鍵盤を叩くと、弦の振動は精巧な装置を通して外に括りつけられた羽とリボンに伝わり、美しい曲線を描き出す。\n夜明けの光が窓から差し込まれ、ピアノを照らし出す。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "僕の勝手なアイディアだけど、二人は喜んでくれるのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "土曜日"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "試しに弾いてみませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ピアノ本体にはなんの改造も加えていません。気に入らなければ、すぐに取り外すこともできます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……ごめんなさい、相談もなしに勝手にこんなことをしてしまって……昨晩、急に思いついたので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "（鍵盤を叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "いや……すごく綺麗だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "このリボンの色……あえて水色を選んだのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "マギーの瞳の色と同じ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "（曲を奏で始める）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "今宵、工場には煌々と明かりが灯る♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "まるで昨日、君に愛を伝えた時の夕日のよう♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "あなた、聞こえるわ。今弾いているのは……昔、私が仕事帰りに毎日歌っていたあの曲ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "工場の中を歩く私を、あなたが後ろについて来るの。こんな風に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "（軽やかなステップを踏む）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ガントには、数十年前の二人の姿が見えたような気がした。\n礼服を身に纏ったジョンと、ステップを踏むマギー。奏でられるピアノの音色に合わせ、ドレスの裾が工場の中でクルクルと円を描いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "（……僕はようやく、何かを成し遂げられたのかな？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "先程の曲が終わると、老人は今度は繊細なメロディーの曲を奏で始める。"
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "若いの、何を考えているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……明日、ちょっと工場へ行ってみようかなと思うんです。頭の中にずっと居座っていた、あの生産ライン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "あっ、すみません……こんな言い方じゃ分かりませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "もしかしたら、両親がずっと作業していたあの製造ラインを、みんなのために改良できるんじゃないかと思ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "僕が働いていた時は、毎日椅子に座って、ただひたすらベルトコンベアを眺めては、流れてきたものを裏返して、品質が基準に達しているかを確認するだけ――すごく非効率で、疲れる作業でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ずっと考えていたんです。だから、明日それを実行しようかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "外の会社からの連絡を待っていたんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "工場の製造ラインを改良するってことは、ずっとここにいるつもりなのか？　工場長はなんと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "いえ、外へ行きたい気持ちは変わりませんよ。まだ企業からの連絡は待つつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "なら一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ジョン爺さん、工場を改良したいという考えは、ずっと昔からありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "むしろ、この考えこそが、僕が頑張り続けてきた根本的な理由かもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "……お前たち若者が外へ出たがるのは、その利口な頭で金をもっと効率的に稼ぐためだと思っていた。一旦出ていけば、ここに残った老いぼれのことなぞ、もう誰も気にせんのだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "だが、お前さんは他の若者とは違うようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ジョン爺さん、僕だって同じですよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人はピアノを弾く手を止めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "僕だっていい会社に入って出世して、お金をたくさん稼ぐのが一番の目標だし、自分から機会を奪った人たちを妬む、普通の人なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "でも……メイスンおじさんが言っていた、「錠を変えないのは奥さんの帰りを待つためだ」と似たような言葉を、たくさん聞いたことがあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "「父さんはもう食べてきたから、お前と母さんで食べなさい」「母さんのこのズボンは、数年前に買ったばかりなんだから、まだ時代遅れじゃないわ」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "分かっているんです。みんな、他に選択肢がないから、少しでも自分を納得させるためにそう言っているだけだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "初めは、いくらか新しい技術を身につけて、工場で働く負担を少しでも軽くしたかっただけでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "そうすれば、両親の仕事がもっと楽になって、収入も増えて、狭い家で暮らさなくて済むと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "初心を今でも覚えているだけで、他の若者とは全く違っておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "だけど、ふと思ったんです。会社が採用してくれないからというだけで、今まで自分がしてきたことを否定し、みんなを助けることを諦めるのかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "（黙々とタバコを吸う）考えすぎて方向性を見失うのは、よくあることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "もしマギーがいなければ、わしだってとっくにどこかで一人、野垂れ死んでたさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……僕はゴールにたどり着くまでの道のりに、執着しすぎていたんです。だから帰ってきたばかりの時は、ずっと……あんな調子でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "少し考えれば分かることなのに、自分で自分の考えを縛り付けていたんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガントは自嘲気味に笑ったが、その目はキラキラと輝いていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "僕が製造ラインを改良すれば、ウィリーおじさんは娘さんに会いにいけるお金を稼げるのかもしれない。メイスンおじさんも、奥さんに新しい鍵や色んな物を送れるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガントは深く息をついた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "ジョン爺さん、明日から修理のお仕事を手伝えなくなるかもしれません。だけど、工場の件が落ち着いたら、また必ず訪ねに来ます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老いた労働者",
      "text": "お前さんはよくできた子だ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人の会話をはっきり聞き取れないマギーは、窓辺にもたれかけ夕日を眺めていた。そして、ジョンが再びピアノを弾き出すと、嬉しそうにパッと振り向いた。\n彼女は進み出て、ガントの両手を取る。"
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "ほら、そこに突っ立ってないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "今の私はまだピアノの音も聞こえるし、ステップも踏めるわ。それにほら、夕焼がこんなにも美しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マギー",
      "text": "踊らない理由なんてないでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "今宵、工場には煌々と明かりが灯る♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "まるで昨日、君に愛を伝えた時の夕日のよう♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "端末",
      "text": "ピッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "端末",
      "text": "ピピッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "端末、家に置きっぱなしだったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "15件の未読メッセージ……全部広告だ。前回メッセージをチェックしたのは……もう三日も前？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "……そんなに長い間、端末を確認してなかったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "フッ……アハハ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "今夜は星が綺麗だなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガント",
      "text": "明日は何を修理しに行こうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガントはベッドに倒れこむ。一日中作業し続けていたせいで、両腕がパンパンに張っていた。\n彼は壁紙が剥がれてまだら模様になった天井を見つめる。\nそして目を閉じると、すぐに眠りに落ちていった。\n夢の中では、数年後の彼が工場を引き継ぎ、皆は清潔な制服と広告でよく見る頑丈なヘルメットを身に着け、温かく広々とした家で暮らしていた。\n彼は満足げな顔で大きく寝返りを打つ。腕を振った拍子に、枕元に置いてあった薬瓶がゴトリと床に転がり落ちた。"
    },
    {
      "type": "dialogue",
      "speakerName": "端末",
      "text": "ピコン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
