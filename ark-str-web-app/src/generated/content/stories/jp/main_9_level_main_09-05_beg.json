{
  "server": "jp",
  "storyId": "main_9_level_main_09-05_beg",
  "groupId": "main_9",
  "stageId": "main_09-05",
  "title": "ダブリン",
  "storyCode": "9-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_09-05_beg.txt",
  "sourceHash": "edd361758bc7895afdf028fd8a0446a784f8c99ed7d04ac5f0406ecd22a6a5b8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "大佐……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ああ。また会ったな、スカマンドロス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……ここで会うことに、驚きはないようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ハッ、「驚き」だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "君と初めに会った時から、驚くべきことなど何一つない――このクズどもといることも想定通りだよ。大方、貴族のマナー講座で安っぽい同情心を学んでしまったのだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……我々に監視をつけていたのですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "「合理的管理を行っていた」と言ってもらいたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "まあ、ともあれ、君たちには感謝しているよ。こうして案内してもらわなければ、このウジ虫どもを一網打尽にする絶好のチャンスを逃すところだったのだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "……さて、そこのクズども。貴様らは普段、随分と奥深くに身を隠しているようだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "一体どうして、こうも大胆に集まろうなどと考えたんだ？　まさか数回取るに足らない襲撃を行っただけで、ヒロック郡は既に自分たちの支配下にあるなどと勘違いをしたわけでもあるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野心に満ちた男爵",
      "text": "あの、その……た、大佐さん、きっと何か誤解があるのではと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "――ボルトン男爵。我々の間に誤解など存在しない。私は貴様らが腹に抱えた企みをはっきりと理解しているのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野心に満ちた男爵",
      "text": "ですが……っ、今日ここに集まっているのは、私の親戚と一部の友人だけなのです！　私の名誉にかけて、誓い――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "口を慎んでいただこうか、男爵閣下。貴様らが祖先から受け継いだ栄誉など、私からすればまったくの無価値なのでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶった女性貴族",
      "text": "な、なんてことを仰るの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "考えてもみたまえ。貴様らのような貴族の品位を貶めているのは私ではない。ヴィクトリアが与えた地位と富を享受しておきながら、裏で最低の反逆者どもと結託しているのは誰だろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶった女性貴族",
      "text": "そんなっ……まったくの言いがかりですわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "――くだらん無駄話にはもう飽き飽きだ。貴様らも、クズならクズらしく、外にいる連中と同じように……炎の中で泣き叫びながら、自らの犯した過ちを懺悔するがいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼の言葉通り、外からは、いくつもの泣き叫ぶ声が耳に飛び込んでくる。窓を見れば、ところどころに炎の光が映っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）……隊長、外を見て！　包囲されてるのはここだけじゃないみたい。多分、ターラー人の地区全域だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）あの人が言ってること、全然大げさなんかじゃない！　一般市民を武力で脅してるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）あっちの通りなんて、いるのはほとんどお年寄りや子供さんだったのに……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）いきなり過激な手段に出るなんて……彼は、何らかの――恐らく、亡霊部隊に関する情報を掴んでいるみたいね。私たちには隠しているんでしょうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）トライアングルから連絡は？　来てないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）午後に入ってからずっとないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）えっ？　それって、何かマズいことでも起きてるんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）心配しても仕方がないでしょ。今は、駐屯軍を何とかして止めるのが最優先よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）それもそうだね。ここで足止め喰らうわけにはいかないし……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "そこのヴイーヴル。壁を破って出ようなどとは考えるなよ。私がいいと言うまで、誰一人としてこの部屋から出ることは許さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ありゃ～、目ざといなあ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "出てこい！　そこにいるのはわかっている。妙な動きはするんじゃない！　そのまま、おとなしくひざまずけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "答えろ！　家の中には誰かいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "い、いません……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ほう。本当に誰もいないんだろうな？　では、私が見てこよう。……いいか、そこを少しでも動いたら、どんな理由があろうとも即刻頭を撃ち抜くぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "う、ううっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あなた、一体何をしてるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "誰だ！　急にクロスボウの前へ飛び出してくるとは……貴様、死にたいのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ん？　待てよ、お前……アダムス隊の儀仗兵だろう？　新年の行事で見かけた覚えがあるぞ。だが、お前たちの隊は行動命令を受けていないはずだ。ここで何をしている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あ、あたしは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あたしは、近くで別の任務に就いてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "そうか。では、各々任務に戻るとしよう。こっちの邪魔はしないでくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "えっと、でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "（立ち上がらなきゃ……あのバグパイプって子が言ってたもの。嫌な状況を変えることくらい誰だってできるって。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "（でも本当に、そんなことできるのかな……？　――ううん。考えてないで、とにかくやってみなくちゃ……！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "この人たちが……一体、何をしたっていうの？　こんな乱暴な扱いを受けるほど、悪いことをしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "そんなこと、こいつらに聞いてみたらどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "う、ぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "何を泣いている？　暴徒を匿い、飲み物や食い物を与え、連中のために情報を流していたのは貴様らだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……それ……証拠はあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "証拠？　お前の言う証拠とは何だ？　第九隊と十三隊の死して間もない身体に残った傷のことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "彼らの中には、恐ろしいアーツで殺された者もいれば、我々の装備と同じモデルのクロスボウや刀で殺された者も……首に農業機具の跡が残っていた者すらいるんだぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……想像したことがあるか？　頭をコンバインで麦みたいに切り落とされ……まるで地面を耕すみたいに、トラクターで体を平らに押し潰される……そんな惨状を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "吐き気がするだろ？　私は、それをこの目で見た。しかもその頭の持ち主は知り合いだったんだ。……死体を目にした日は、ずっと吐きっぱなしだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ど、どうして……同じ人間なのに、どうしてそんな残酷なことができるの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ハッ、いいことをいう。「同じ」じゃないんだろうよ、奴らは人間と呼ぶには値しない連中だからな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "お前も、こいつらがこういう扱いを受ける理由がわかっただろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……おい、何をぼんやりしてるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……だから……この人たちはみんな、悪い人だっていうの？　この人たちが……ターラー人だから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "う、ううっ……あぁ……私は、私は何もしていません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……ねえ、こんなふうに泣いてる人を、あなたは疑ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "彼女の旦那さんはもう鉱石病で亡くなってて、お子さんはまだ十歳くらいなんだよ。こんな、誰も頼れずに苦しんでる人が、人を殺したりなんかすると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "何度言えばわかるんだ！　こいつらは皆同類なんだよ！　たとえこの女やその子供が、まだ何の過ちも犯してなかろうが、こいつらは全員一緒だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "もし、この人たちがターラー人じゃなくて、ほかのヴィクトリア公民だったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "それでも、あなたたちは彼らを暴徒の仲間と見なすのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "もし……もしも、あんな差別的な法律が初めから存在しなかったら……ターラー人もほかの人たちと同じように、収入や治療を受ける機会を得ることができたなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "争いなんて起きなかったんじゃないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……もういい。質問がしたいだけなら勝手にしろ。答えのない質問など、誰にも応じようがないだろうがな。ともかく、この家の捜索はほぼ終わったんだ。私は次の家に行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "っおい、貴様！　立っていいとは言っていないだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "ううっ……み、見逃してください……あの子は……クレイグは私がいないとダメなんです……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "このっ……！　そうやって子供子供と泣きわめいて、同情を引こうとしても無駄だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……見逃してあげてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "お前か。はぁ、まあいい、私は忙しいんだ。この女一人に構っている暇はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……おい、儀仗兵。お前は親切心でこいつらを守ろうとしてるんだろうが、せいぜい不意を打たれないように気を付けるんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "あの憎しみに満ちた目を見ただろう？　お前がどう振る舞おうと、こいつらの目から見れば、お前もこちら側の人間――私たちと同じにしか見えないってことを忘れるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……お願いだから、早く行って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "チッ、忠告はしたからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ふぅ。……ねえあなた、大丈夫！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……は、い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "よかった。シアーシャと話した後、なんだか胸騒ぎがして戻ってきて正解だったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "立ち上がることで、変えられるものはあるんだ……本当に、ほんの少しだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ほら、家に帰ろう。あたしが支えて歩くから。今夜は……ううん、明日も家から出ないようにね。外は危ないし、それに……ええと、とにかく、最近のヒロック郡は安全とは言えないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "そういえば、息子さんは？　ええと、クレイグだっけ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "クレイグ……あの子は……う、ぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "まさか、捕まったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "わ……わからないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "それなら、私が探しに行くよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "どうした、ヒル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官ヒル",
      "text": "ご報告します、大佐！　廊下の窓から逃走を図った男を発見、捕縛いたしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がる青年",
      "text": "ひっ……ご、ごめんなさい、ごめんなさい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ほう。では、当ててみようか。この男が貴様らのうち、誰の手の者で……そして、誰に情報を伝えようとしていたのかをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野心に満ちた男爵",
      "text": "わ、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貪欲な商人",
      "text": "べ……弁護士を呼べ！　私は市長だけでなく、議員たちとも親交があるんだぞ！？　だっ、だから我々を解放しろ！　お前たちにはこうして我々を拘束する権利などないはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ふむ。私の予想は的中したようだな。貴様らは全員、反逆者と結託しているのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "さあ言え。誰でも構わんぞ。――共犯者はどこにいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "おや、返事がないな。　では、こうしよう。三つ数えたら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怖がる青年",
      "text": "う、うわあああっ！　こ、殺さないで……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶった女性貴族",
      "text": "キャーッ！　な、なんてこと……！　どうしてそんな残酷なことをなさるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "そうだよ！　そんな資格あるわけないでしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "何？　――スカマンドロス、君の部下に教えてやれ。私に「資格」があるかどうかをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ッ、隊長……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――臨時統制法。我々がロンディニウムから直接命令を受けられない場合において、ハミルトン大佐は確かに、ヒロック郡駐屯軍の最高司令官として、都市全体に戒厳令を敷く権利を持っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うちだってそのくらい知ってるよ！　でも、だからって本当にそんなことしたら、亡霊部隊に宣戦布告するようなもんだべ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "だけど彼らの言うことには、正しい部分もあると思うの。私たちは既に、戦争の中に身を置いているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "でも、うちらは敵部隊のこと、ほとんど何にも知らないようなものでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "向こうはきっとうちらのことをよく知ってる……どう考えても、今はこっちから仕掛けるべきタイミングじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ハッ……タイミングだと！　連中はこちらの都合など考えずに襲撃してくるんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "大佐。我々小隊の意見を一切受け入れていただけないとしても、現在あなたが取っている行動には、明確に反対の意思を表明せざるを得ません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "己の立場をわきまえてくれたことには感謝しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "正直に言えば、私もこんなことはしたくない。ほかの選択肢が残されている限りは、帝国の法を破りたくはなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "だが――事実として、もう時間がないのだ。今もなお、あの連中は暗闇の中一歩ずつこちらへと迫っているのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "そして、君も言っていただろう、スカマンドロス？　君たちも、あの亡霊を白日の下に晒すべくここへやってきたのだ、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "今こそ、陰謀のすべてを明るみに出さなければならない。でなければ我々は、明日を待たずしてヒロック郡を失うことになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ですが大佐……危急の状況だからこそ、一つの選択を誤ればより深刻な事態を招くこともあるかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "何より、この場の人々の多くは無実だと、私は確信しております。まずは彼らを連行し、それから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "いいや、無意味な取り調べに時間を浪費するわけにはいかん。今ここで、このクズどもに吐かせねばならないのだ。こいつらの仲間が一体どこに隠れているのかをな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "これ以上は時間の無駄だ――ヒル、やれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩人ウィリアムズ",
      "text": "……大佐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "この*ヴィクトリアスラング*はどこのどいつだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩人ウィリアムズ",
      "text": "――私を連行してください。何せ私はボルトン男爵の招待を受けた客人です。この今にも卒倒しかけている可哀想な若者より、多くを知っていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野心に満ちた男爵",
      "text": "シェイマス！　どうして君がそんなことを！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "シェイマス？　詩人のシェイマス・ウィリアムズか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩人ウィリアムズ",
      "text": "はい、大佐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ふむ、いいだろう。元々貴様には会いたいと思っていたんだ。愚か者どもを文字で扇動する物書きなど、いつまでも野放しにはしておけんからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ウィリアムズさん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "詩人ウィリアムズ",
      "text": "大丈夫ですよ。どうかご心配なく。私は、むしろ大佐に感謝しなくてはならないくらいですから。……つい先ほど、あの詩をどう終わらせるべきか思い至ったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "――捕らえろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "えっ……ボール？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ヒル！　外にいる見張りに、窓を割ったクズを探させろ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "待って、なんか変だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……ッ！　ボールの中から音がする！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "なッ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "伏せてっ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "だっ、誰だ？　どこから出てきやがった！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ぐあッ――！　き、貴様ら……！　と、とにかく大佐に報告を……第四隊が暴徒に遭遇、広場西側の路地に――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "――これで、この小隊は殲滅した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "リーダー。付近にあるターラー人地区を完全に占拠しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した青年",
      "text": "あんた、たちは……一体……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した青年",
      "text": "あっ！？　あなたは、あの方ですよね！　俺たちが、待っていた、あの……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した青年",
      "text": "あなたが……手を差し伸べて、くれるなんて……お、俺は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……キミを虐げる者は、もういない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "キミはもう、誰かに助けてもらう必要もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "これからは、この大地を一人で、自由に歩いて行ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した青年",
      "text": "ありがとう……ありがとう、ございます！　俺がやってきたことは……やっぱり、正しかった……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した青年",
      "text": "きっと俺たちターラー人も……いつかは、自分たちの都市を持って胸を張って街を歩けるようになる日が来るんだ。その時には、不公平な扱いを受けることだってなくなるんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "ええ。私たちは、その日のために来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した青年",
      "text": "リーダー！　あの、あちらを見てください。あれは、俺たちが、あなたのために灯した火なんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "あれは……パーティーホール……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "マンドラゴラ様からの情報によると、駐屯軍上層部は現在、全員あの場所にいるようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "とはいえ、この程度の爆発では、駐屯軍の勢いは殺せど、殲滅まではできていないかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "駐屯軍のほかに、誰がいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "我々に好意的な地元住民たちです。が、彼らはこちらの内情をいくつか知っているそうで……幹部の方々のお考えとしては、今後を見据えれば生かしてはおけないとのことでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "それから、もしあなたが手を下さないのなら、自分たちで処理するとも、仰っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……だったら、私の炎で……その方が早い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "彼らに伝えて。やるべきことはわかっている、と……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "――あの会場は、私が制圧する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "はい、リーダー！　――あなたの炎なら、数百年もの間、我々を抑圧してきた束縛を必ず打ち破れるはずです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
