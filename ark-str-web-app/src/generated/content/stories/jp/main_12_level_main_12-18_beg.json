{
  "server": "jp",
  "storyId": "main_12_level_main_12-18_beg",
  "groupId": "main_12",
  "stageId": "main_12-18",
  "title": "真摯な誘い",
  "storyCode": "12-20",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_12-18_beg.txt",
  "sourceHash": "fb47579370efcb90c75a99c5f64f272d9b72e310d8df8c8c2ba3fe13ee850575",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "ウェリントンはほぼすべての予備戦艦を送り込んだのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "はい、公爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "ウェリントン公爵はあの船を……必ずや手中に収めんとする勢いでございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "彼らの先遣部隊はすでにサルカズと交戦しているはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "チッ、それにカスターまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "あの女、これまでほとんど自分の守備範囲から出てこなかったが、さすがに今回はあやつといえどじっとしていられなくなったか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "奴らがここまで魅了されるとは。あの空飛ぶ小船には一体どれほどの価値があるのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "……我が軍の参謀たちからも同様に、可能な限りあの飛空船の技術を手に入れるよう進言を受けております、公爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "サルカズに対抗するにせよ、将来……対立する恐れのある他の相手と向き合うにせよ、あのかつてない武器は我々にさらなる選択肢をもたらしてくれるとのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "彼らを黙らせろ。対立する恐れのある相手？　それはヴィクトリアを分裂させるよう、私をそそのかしていることになるのだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "私はただデルフィーンを迎えに来ただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "参謀たちが言うには、ノーポート区の状況は、恐らくかなりひどいものだろうと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "デルフィーンは無事に決まっている。あの子は私の娘だぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵士",
      "text": "こ、公爵様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "言わなかったか？　艦内では走るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵士",
      "text": "ご覧ください、あの移動区画の影を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵士",
      "text": "何か……変です……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウィンダミア公爵は、副官から差し出された望遠鏡を受け取った。\n朝日に引き伸ばされた移動区画の影……だがそれはノーポート区の形とはかけ離れたものだった。\n建物に遮られているせいであろうか？　それにしても奇妙な形だ、どこか塔のようにも見える──ウィンダミアはそう思った。\n塔？\nいや……ビルか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "……まさかあれは……ザ・シャードの影？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "そんなことがありえるのか？　あれは自然現象か？　それとも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "さっき、カスターとウェリントンの部隊は、あとどのくらいでこの付近に到着すると言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "恐らく二時間はかからないかと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "滅多にないことです。この区画の近辺に、三人の公爵の部隊が一斉に集うなど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "参謀が言うには、他の大公爵たちも機をうかがっているようです。彼らが自ら戦艦を指揮し、ここに現れてもおかしくないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "私も軍に入って何年も経ちますが、このような事態に遭遇するのは初めてです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "船を止めろ！　緊急停止だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "すぐに全部隊をこの区画近辺から撤退させろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "赤の信号弾を発射し、友軍に警告せよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "大至急だ！　急げ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "電文を送れ！　周囲のすべてのヴィクトリア部隊に通達せよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "このエリアはザ・シャードの攻撃対象になる恐れがある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "り、了解です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "この船は旋回不要だ、ノーポート区へ向けて加速せよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィンダミア公爵",
      "text": "嵐が形成される前に、デルフィーンを見つけるぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "赤い信号弾が雲の下で次々に炸裂し、ねじ曲がった区画の影が元の形へと戻る。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "見事だ、イネス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "最大出力ではないただの試射だ。それに、選択できる地点は他にも数多くある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "とはいえ、認めざるを得ないな、少しばかり惜しいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "だが軍事委員会の計画する目標が、単体であったことなどない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ナハツェーラーの王に伝えよ、進軍の準備だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "嵐が彼に道を切り開くであろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "イネスはよく口にしていた。死も道具であると。\n彼女は時折、ヘドリーにこう自嘲した。自分は死人として扱われることに慣れてしまったのかもしれないと。\nしかし死が本当に目前に迫った時、自分が想像していたよりずっと冷静であることに気付いた。\n彼女は目を閉じた。\n突然、火と熱が正面から襲ってきた。続いてそれに伴う強烈な衝撃波が体を打った。\n鼻をつく爆薬の匂い……この匂いをイネスはよく知っていた。\n彼女は薄く笑みを浮かべた。\n押し寄せる爆煙に包まれる。体中を打ちつける余燼は、今もなお火の温もりを帯びている。\n周囲の余燼が舞うように集まり、編み上げられてゆく。\nサルカズの歴史は、余燼によって織り成されている。だが時に、こういった塵芥は別のものも編み上げるのだ。\n例えば……\nイネスは柔らかな煙の中に落ちた。\n余燼が巨大な網となって彼女を支えたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あの二人に……これ以上のやり方を期待すべきじゃなかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "おーい、イネス、まだ生きてるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "こういう爆発ってすっごく難しいから、事故が起きても不思議じゃないのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "しょうがないわ。ヘドリー、このまま埋めちゃいましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……悪いけど、一応生きてるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "チッ、シラけるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ところで、あんたのために打ち上げた花火は気に入ってくれた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたが気付かないうちに、その服に縫い付けたものはなーんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ざーんねん、答えは探知器よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……私が気付いてなかったとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あの雑な縫い目。あなたの裁縫技術はほんとお粗末よね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "チッ、元々ホントの「サプライズ」にしようと思ってたんだけど。でも、まぁ別にいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "それからこの燃えがら──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "戦場で服を綺麗に保つのがどれだけ難しいか、あなたたちわかっているのかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "くすぶってる灰の中に私に放り込むなんて、何を考えてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……前は俺のアーツを余燼と表現していただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "今はそんな気分じゃないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "怪我は重いようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "死ぬよりはマシよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "えっ！　ヘドリー、あんたアーツが使えたの？　てっきり刀で人を斬ることしかできないと思ってたわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "しかも、余燼ですって？　道理であたしが毎回あんたに爆弾を投げつけても涼しい顔してたわけね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "じゃ、砲弾ぶっ放されても怖くなかったりする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "怖いさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "灰で他人の顔に一発お見舞いしてやることはできる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そういえば、あんたいつもほこりまみれだけど、それってアーツの副作用か何か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "黙れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……プッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "イネス、あんたのこんな無様な姿を見るのは何年ぶりかしらね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "賭けてもいいわ、もう今後二度と見ることはないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "自分の運を過信しない方がいいわよ。帰り道でブラッドブルードの大君のお散歩に出くわすかもしれないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "W、別のたとえにした方がいいかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "何よ、あんまり長くマンフレッドの近くにいたもんだから、王庭の化け物たちに愛着でも湧いたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ていうかあんた、ちょっとはあたしに感謝しなさいよね！　もしもあたしが帰り道に、逃げ回ってるあんたと出くわさなければ、今頃は違うお友達に捕まってたかもしれないのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……まったく騒がしいな。これなら監獄に戻った方がマシかもな。少なくとも今より静かだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どうぞ戻れば？　テレシスに、あんたのことチクってあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "今からどこへ行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "Wのセーフハウスだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "オーケー、しょうがないから帰るとしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ああ、忘れてたわ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……ありがとね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……俺は戻る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あいつは今日に限ってなんでこんなに遅ぇんだ？　走ってるうちに転んで怪我でもしちまったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "助けに行こうぜ。ここで恩を売っときゃ、酒を数本たかれるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "何ぼさっとしてんだよ、行くぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "いい加減にして、ハンナちゃん！　ノーポート区は今、火の海なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ベアードはバカじゃねぇ、火を避けながら向かってんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "……ベアードちゃんは死んだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "モーガン、何言ってんだてめぇ？　冗談じゃ済まされねぇ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "だから！　ベアードちゃんは死んだんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あのナイフを見たでしょ？　あの血の付いたバタフライナイフを！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あれはベアードちゃんが肌身離さず持ってたナイフだって。間違いないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そのナイフが別の人の手に渡ってた。それはつまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "単なる早とちりかもしんねぇだろ？　ベアードがうっかりナイフをなくしちまっただけじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あいつにだってさ、ヘタ打つ時くらいあんだろ？　物をなくしたことだってあるしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "覚えてっか？　あいつ羽獣の卵を一ダース分なくしたことがあっただろ、朝飯に目玉焼きを食う予定だったのによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あいつだってたまにゃヘマするさ、そんな大げさなことじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ハンナ……マクラーレンがあのナイフを持っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ベアードは最後にあいつを探しに行った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "あいつは耳が聞こえていない、恐らく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ハッ！　あいつらがどんだけ長い付き合いだと思ってやがんだ？　また俺をビビらせようとしてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ベアードはマクラーレンにナイフをちょっと貸してやったんだよ、そんだけのこった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……どういうことかあいつに訊いてくる。きっと教えてくれるさ、これがただの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ハンナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "マクラーレンはどこにいる？　一緒にノーポート区を離れたよな、そんならこの中にいるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "訊いてみりゃ勘違いだってわかるさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "マクラーレン──どこだ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "マクラー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……ハンナ、彼には聞こえない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺は──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ぶっ殺してやる！！！　あのクソ野郎をぶっ殺してやんよ！！！　あいつを見つけ出して、骨を一本ずつ引っこ抜いてやる！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ハンナ！　……もうよせ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ヴィーナ！　*ヴィクトリアスラング*とっくに知ってやがったのかてめぇ！？　だったら何で──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "何であいつの頭を叩き割ってベアードの仇を取らないかって？　私がしたくないとでも思っているのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "必死で堪えているんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "なぜならそんなことしても*ヴィクトリアスラング*意味がないからだ！　耳の不自由な狂人を一人殺したところで何の意味もない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ハンナ、私はすべてが憎い……これらすべてが憎くてたまらない。私はどうしようもない愚か者だ、身勝手なバカ野郎だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "アラデル、ベアード……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "私がこの都市の問題に関与しなければ、もしかしたら彼女たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……私は一体何のために戻ってきた！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "私は自分が何のために戻ってきたのかわからない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これは……初めから、偽りの責任感によって犯した過ちだったのではないか？\n自分は心の中で彼女たちを、共に死線を潜り抜け、共に苦渋をなめ尽くした友人たちをどう見ているのだろう？\nこの……かけがえのない「友情」は、実は自分さえも欺いている、ただの言い訳にすぎないのではないか？\n自分でさえも、自らを国王だと錯覚し始めているのではないか？\n慈悲を与え、仁愛を振り撒き……そして、希望と尊敬を集める。\n自分は一体……何になりたいのだ？\n自分は一体何になることを期待している？"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "……ヴィーナ、吾輩たちが帰ってきたのは、ただ……傍観していられないからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ここが吾輩たちのストリートで、吾輩たちの縄張り、吾輩たちの国だからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あんたはいつも前線に突っ込んでくけどさ、それはあんたが責任を背負ってるからなんかじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "吾輩たちがあんたの後ろについてくのも、あんたに何者かになってほしいからじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ヴィーナ、あんたは吾輩たちのヴィーナでしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……もちろんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "誓おう。私はただのヴィーナでしかない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ノーポート区の市民の方々をどこに連れて行きますか？　このまま荒野で放っておくわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それに、ここは戦場の中心です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "……彼らが望むなら、母の領地で生活することができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "母が移動都市をロンディニウム付近にまで移動させています。小型の要塞都市ですが、ここの人たちを収容するには十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "カドール、他に何か考えはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "デルフィーン、オマエ気付いてるか？　身分を隠すのをやめてから話の視点まで変わってるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "……ベアードの件で辛いのは分かっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "私たちも同じ気持ちなんです。でもわざわざみんなの気分をもっと悪くするようなことは、言わなくてもいいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "私はただ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おや、やっと人を見つけたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "ねぇ、僕たちにお水をくれないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "あのドラコ……彼女の使うあの火は嫌だったな。体に燃え移って全然消せやしないんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……変形者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "やぁ、アスカロン、久しぶりだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "何をしに来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "お水を探しに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "ついでに僕たちの小さな魔王に挨拶でもしとこうかと思ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "あのバンシーが君のことを随分と褒めてたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ、退がるんだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "大丈夫です、ドクター。この姿は初めて見ましたが……私はこの人たちのことをよく知っています。あの歴史の中に何度も現れていますから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが、この人たちはいつも王庭から離れていて、自分たち以外のすべてに対し……興味がないようです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "変形者の欠片、あなたはなぜ私たちの前に現れたのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "どうやら君は正真正銘の魔王みたいだね、子ウサギさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "あれは、君をすごく苦しめたみたいだね。サルカズでもないのに、よくあんなにたくさんのものをその小さな頭に詰め込めるよ。ほんと感心する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "記憶は、僕たちにとって最も貴重なもの。でも僕たちにとって毒になることもあるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "ほら、僕たちにはやっぱり共通の話題がありそうでしょ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あなたもやっぱり……私は「魔王」の王冠を戴くのに相応しくないと思っているんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "どうやら、あのぐちぐちと小うるさいレヴァナントに、こっぴどく罵られたみたいだね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "無視していいよ、あいつは昔からうざいから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あなたは古のサルカズですよね、あなたなら……魔王はどうあるべきだと思いますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "うーん、良い質問だね。まぁ、僕たちはなったことがないし、気にしたこともないんだけど……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "でも僕たちが思うに、せめて強大じゃなきゃダメなんじゃない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "どんくらい強大かっていうと……あらゆるためらいや迷いを余裕で乗り越えられるくらい──かな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "だけど、一つだけ確実に言えるのは、君は僕たちにそんな質問をすべきじゃないってことだよ、小さな魔王。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "君はまだまだ長い道のりを歩まなくちゃならないんだ。そのロドスとかいう組織をこのまま率いて騒ぐにせよ、サルカズの魂の導きに従うにせよね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "あっ！　ごめんごめん、忘れてたよ。サルカズの魂は君を受け入れないんだった。僕たちを受け入れないのと同じだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "僕たちはどちらも彼らにとって異類だからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "でも──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "君は将来のある時点で理解するはずだよ。時間を打ち負かすことはできないってね。僕たちの記憶の中では、どの魔王も結局最後には同じ道を歩いてたよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ですが、私はそうはなりません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私は──その道を歩むことを拒みます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "そう急いで答えを出さなくてもいいよ、子ウサギちゃん。僕たちも昔は、もう一人の若い魔王に驚かせてもらえるかもと思ったことがあったけど、君たちの運命は揺らがないみたいなんだよね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "それでも僕たちは君に大きな期待を抱いてるよ、サルカズじゃない魔王……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "今なお成長を続け、自らの血に疑問を抱く若き魔王……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "僕たちがいまだかつて見たことのない魔王……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "……お前の目的は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "僕たちに……敵意はないよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "魔王、僕たちは君より知恵を持ってるとは言えないし、君に何かを教えることもできない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "ただ、お願いをしたいだけさ、こういった……「唯一」の個体を深く理解する機会が欲しいんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "アスカロン、君がもし僕たちみたいに長命ならわかるはずさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "目の前に今まで見たことのないものが現れた時、触れずにいられるわけがないだろう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "敬愛すべき魔王、僕たちの長い生命にサプライズをくれないかな？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
