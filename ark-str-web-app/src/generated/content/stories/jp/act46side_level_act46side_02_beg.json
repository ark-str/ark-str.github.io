    },
    {
      "type": "dialogue",
      "speakerName": "リスバーン",
      "text": "い、いや、俺の考えすぎかもな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "相変わらず勘の鋭い奴だな、お前は。",
