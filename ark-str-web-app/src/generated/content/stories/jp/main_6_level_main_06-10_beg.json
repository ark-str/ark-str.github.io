{
  "server": "jp",
  "storyId": "main_6_level_main_06-10_beg",
  "groupId": "main_6",
  "stageId": "main_06-10",
  "title": "「こんな事」",
  "storyCode": "6-11",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-10_beg.txt",
  "sourceHash": "6a5d4a2a8d793070f51b021f7c728f08dda2e1679adaac048c719e3b7276b7d4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（前）\nううう、ぐすん……。\nお腹が空いたよぉ……！\nパパは？　パパはどこに行っちゃったの？\nパパがいなきゃやだ……パパ！　パパ！\nパパが迎えに来てくれるはずだもん！"
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "子供？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "Blaze-4、Amiya-1小隊に報告。スラム四番街、破壊された十号建造物の中で、子供の生き残りを発見した。感染者よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "ぐすん……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "だ、だれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "龍門の人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……君たちを傷つけない人。ウルサス語は下手だけど、敵意はないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "なに言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "私と来て、ここは危険だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "おじさんがここから動くなって言ってた……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……でも私は君たちと一緒にパパを探してあげられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "本当？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "本当。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "後ろに隠れてるのは分かってる。出てきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前は……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前はあいつらと違うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前は……ロドスか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "君たち、下がって。こっちに来ちゃダメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "あんたたち、武器を下ろして大人しく私に従って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "俺たちを助けに来たってわけじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ロドス！　お前たちはこのスラムに何が潜んでるか知らねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "こうしてやっと待ち伏せの罠を仕掛けたのに……。ここであいつらを奇襲して殺さなきゃ、逃げたっていずれ追いつかれて殺されちまう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "子供を囮に使うような奴は、殺されたほうがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……何を勘違いしてやがる？　俺たちが殺されればそれで全部終わるとでも思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "たとえ俺たちが殺されたって、あいつらは子供に情けをかけたりはしねぇ。誰一人逃がすつもりなんてないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "俺たちが殺されて全てが終わるってんなら、子供なんて使わず自ら命を差し出すさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前にだって攻撃してないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "あいつらって……もしかしてあの黒装束たちのことを言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そうさ、あいつらを知ってんならわかるだろ！　ここの奴らを皆殺しにするつもりだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "そんなの言い訳にならない。あんたたちを制圧した後、保護してもらえるよう申請するから。ここは大人しく私に従って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "この状況で誰がお前を信じるんだ！？　お前のそのクロスボウで撃たれて死ねば、保護も何もあったもんじゃないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "一時的に命は保証してあげられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "もう構うな、そいつをやっちまってまた待ち伏せをすればいい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "集合命令と撤退ポイントの情報は受け取ってんだ。もしここで死んだら、子供たちを守るために死んでいった親たちに申し訳が立たない。あいつらだって俺たちの仲間だったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "チッ……子供たちは離れてて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "うっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "私……まだ生きてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "じゃなきゃどうだっての、死んだほうが良かった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "ブレイズ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "君が死んだところで、今さらこの大地がどうにか変わるわけじゃないからね。だったら、生きてたほうがマシってもんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "敵は……あのレユニオンたちは？　子供たちはどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "グレースロート、私は君のことを誤解してたみたい。ごめん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "子供たちはっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ああもう！　レユニオンは片付けたよ！　子供たちも避難させた！　人の話を最後まで聞いてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "必要ない……子供たちが無事ならそれでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……君って本当に相手を怒らせなきゃ気が済まないんだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "じゃあ、何を誤解してたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "君が感染者の子供たちのために奮闘してる様子を、見させてもらったんだ。わぁお、君ってばいい女～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "あんた、お世辞が下手ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "思ったことをそのまま口に出しただけだって！　これまで君は血も涙もない非感染者で、ロドスに入ったのはもしかするとスパイ目的だと思ってた。それが私の誤解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "もし私がスパイだったら、確かにこういう方法で相手の信頼を得ようとすると思うけど。あんたが手当もできない馬鹿じゃなければだけど……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "手当をしてくれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "これでもエリートオペレーターだし、それも私の仕事のうちだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "君の言う通りかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でも、もし仮に君が本当にスパイだって知っても……君が正しいことをしたのは揺るぎない事実。そしたらまずは君を助けて、それから取り調べにかけてたかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "私は逃げるかもしれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "できもしないことを妄想しないほうがいいよ。私より速く走れるっての？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "信頼ってのは、何もかもさらけ出すって意味じゃない。相手が何をして、何をしないか、その人となりを知ってるってこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "君が正しいことをすれば、私は全力で支持する。もし間違ったことをすれば、それを正そうとするし、阻止することだってある。それこそが信頼ってものだと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "だからありがとう、グレースロート。私のことを信頼してくれて、そして行動で私の考えを正してくれて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "これまでの態度、本当にごめん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でも君のあの説得のやり方は、正直良くなかったよ。あのレユニオンだって、本当は子供を囮になんか使いたくなかったと思う。あの状況で仕方なくああしていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "もしあの場面で予期しない事態になってたら、やっぱり君を取り調べることになってたと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "好きにすればいいじゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "いい感じだ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "彼女たちの関係、少しは和らいだ？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そうですね……少なくともブレイズさんは前向きに考えてるみたいです。彼女は先入観に囚われず事実に基づいて考えられる人です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ロドスのエリートオペレーターが優れているのは、戦闘能力だけではありません。ブレイズさんは人の輪に溶け込み、他人とコミュニケーションをとることにも長けています。ただ、そこには彼女なりの立場があります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "彼女の指揮を執り、その支持を得るためには、彼女の信頼を勝ち取る必要があり、それ以上に彼女を信頼する必要があります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私はブレイズさんとは長いですが、ドクターも……彼女の支持が得られるよう、色々試してみてください。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "もう十分やっていると思うが。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "うーん……まだ足りないと思います。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ブレイズさんは無頓着そうに見えますが、実は心の中は複雑な人なんです。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "もう少し時間と経験を積み重ねれば、Dr.{@nickname}もきっとできるようになるはずです。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "でもそれには努力が必要ですよ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "お互いを信頼し合える関係になるというのは簡単ではありません。ですが、絶対に必要なことです。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "私たちにはドクターの力が必要ですが、ドクターがその力を戦術レベルでちゃんと発揮するためには、オペレーターの皆さんから信頼されなくてはいけません。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "時間の掛かることだとは思いますが、ドクターがこれからもロドスを指揮していくためには、避けては通れないことなんです。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "それには彼女の協力も必要だ。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ブレイズさんは、エリートオペレーターの中でも強襲のような荒々しい作戦を得意とする方です。しかし戦術に関する造詣はそこまで深いとは言えません。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ですがドクターが自身の戦術に基づいて命令を出せば、彼女はその意図を汲み取り、最大限の行動をしてくれます。彼女とドクターの力が上手く噛み合うことで、何倍もの力が発揮できるんです。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "それが協力と言えるなら、彼女は十分に協力してくれていると思います。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "それこそ今のように……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "オペレーターの皆さんの多くは、ロドスが合理的な命令を出せば、責任感で従ってくれますが、まだ本当に心から信頼してくれているわけではありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "本当の信頼というものは、相手への理解の上に成り立っています。今ブレイズさんがグレースロートさんを信頼し始めたように。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あっ……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "接近中のレユニオンがいるようです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あの様子だと、ブレイズさんたちには、もう少しお互いを理解するための時間が必要ですね。この手のことに関しては、かなり口下手な人ですから。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ではできる限り時間を稼ぐぞ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "ブレイズは口下手なのか？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ブレイズさんは話を弾ませることは得意かもしれませんが、感情を表現するのが苦手なんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "今ブレイズさんはグレースロートさんに謝ることに時間を掛けているというより、自分の経験則から生じた他人に対する誤解、あるいは自らの根が深い偏見に対して内省しているのでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "非感染者が感染者に偏見を持っているのと同じように……感染者も非感染者に対して偏見を持っているんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "心の中にある内なる敵は、目の前に見える外の敵にも引けを取らないほど厄介なんです。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ならば全ての敵に打ち勝てばいい。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……はい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "その通りです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "先程のレユニオンの眼差しには、恐怖が満ちあふれていました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私たちや近衛局相手に、あそこまで追い詰められることはないかと思います。ましてやなりふり構わず自身の大原則すら歪めさせる程だなんて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "彼らは一体どんな敵に遭遇したんでしょう……一体何が、彼らをあんな風にしたんでしょう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私たちも……その何かと対峙することになるんでしょうか？",
          "portraitKey": null
