{
  "server": "jp",
  "storyId": "story_sunbr_set_2_story_1",
  "groupId": "story_sunbr_set_2",
  "stageId": null,
  "title": "成長",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_sunbr_2_1.txt",
  "sourceHash": "badfbaf9ba46caa3fca3b07080d01ed4c98023dbe6c6f5e0bf4955f521c9bbcf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "グムにはたくさんの思い出がある。\n良い思い出、悪い思い出。\n楽しかった思い出、悲しかった思い出。\nそれから、どうしても忘れられない思い出。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "アイツらだ、あそこにいるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "こっちだ！　もう逃げ場はないはずだ……アイツら食料を持ってやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンナ",
      "text": "気を付けてください、ラーダ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "ちっ、虫けらどもが！　アンナ、ラーダ、アタシの後ろに隠れろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "なかなかの肝っ玉じゃねぇか。上等だ、来いよ。アタシの前に出る度胸があるのはどいつだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロザリン",
      "text": "痛てて……またかよ。こっちはまだ腕が治りきってないってのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロザリン",
      "text": "おい、ソニア。どっちが多く倒せるか勝負しねーか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "──くだらないこと言ってんじゃねぇ……危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナターリア",
      "text": "あらあら、こんな時にぼんやりしていてはだめよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナターリア",
      "text": "集中しなきゃね、将軍のお二方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンナ",
      "text": "ふう……危なかったですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンナ",
      "text": "ソニア、ロザリン、背後にも気を配ってください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "チッ、悪ぃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロザリン",
      "text": "不意打ちなんて、よっぽど死にてーらしいな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女子学生",
      "text": "うっ……怯んじゃだめよ。相手はたったの数人なんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "そうだ、多勢に無勢じゃねぇか！　全員でかかりゃ負けるはずねぇんだ！　ビビってたら救援を呼ぶスキを与えちまうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナターリア",
      "text": "（小声）どうするの？　確かに数じゃ圧倒的に不利よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンナ",
      "text": "（小声）……どうにかして突破するしかありませんね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女子学生",
      "text": "ごめんなさい。でも……私たちもほかに方法がないの。何としてでも食料を手に入れないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女子学生",
      "text": "これ以上は無理なの……こんな所で飢え死になんてしたくないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "門を塞げ！　アイツらに逃げ道を与えるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "かかれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "ゴホッ、ゴホゴホッ……ろくでなしどもめ、キリがねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロザリン",
      "text": "まさかもう限界だなんて言わねーよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロザリン",
      "text": "ペッ！　……くそっ、歯が一本折れちまったみてーだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "オマエ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナターリア",
      "text": "待って、敵の数が合わないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンナ",
      "text": "ソニア、危ない！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソニア",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "食い物を寄越せ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "うあぁぁっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "ゴフッ……ヴゥ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "（地面に倒れ、けいれんする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンナ",
      "text": "ラーダ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラーダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラーダ",
      "text": "ソニアお姉ちゃんを傷つけるなんて許さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラーダ",
      "text": "絶対に許さない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女子学生",
      "text": "きゃあぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女子学生",
      "text": "あの子、く、狂ってるわ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男子学生",
      "text": "アンドレイの首をへし折りやがった！　ヤバい、逃げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラーダ",
      "text": "ラーダが……ラーダがみんなを守る……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラーダ",
      "text": "お姉ちゃんたちを傷つけるなんて、絶対に許さない！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "グムにはたくさんの思い出がある。\n良い思い出、悪い思い出。\n楽しかった思い出、悲しかった思い出。\nそれから、もう絶対に思い出したくない思い出。\nグムは人を傷つけた。\nお姉ちゃんたちを守るため？　それとも自分が傷つきたくなかっただけ？\nグムには分からない。\nだけどグムは……グムはもう二度と誰も傷つけたくない。\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "グム？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どうしてこんな所で寝ているんですか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "起きてください、グム。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "う……ふわぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "起きてください、グム。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "顔色が悪いですよ。まだ傷は痛みますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "悪い夢を見てたみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "傷はもう全然痛くないよ。心配しないで、イースチナお姉ちゃん。グムは大丈夫だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "それならいいのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ん？　イースチナお姉ちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "黙っちゃってどうしたの？　そろそろ出発？　グムはいつでも出発できるよ。ズィマーお姉ちゃんとリェータお姉ちゃんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "いえ、まだ出発の時間じゃありませんから、もう少し休んでいても構いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "彼女たちはルートの下見です。もうすぐ帰ってきますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "じゃあグムも手伝いに行くよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "待ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "座ってください、グム。大人しくしていてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "傷は言うほど軽くはないでしょうし、あまり動き回ろうとしないでください。もう一度薬を塗ってあげますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ほんとにそんなにひどくないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "本当だよ！　嘘なんかじゃないんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ただ、ちょっとだけ……ほんのちょっとピリピリするだけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "良い子だから、動かないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うん、分かった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "……傷だらけですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "以前の傷跡は徐々に薄くなってきていますが、今日の傷は跡が残らないとも言い切れません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "残らなかったらいいなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "医療部のお姉ちゃんたちが、とってもよく効く軟膏をくれるから、それを毎日ちゃんと塗れば、醜い傷跡だってきっと全部消えちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "そうですね。元々あった体の傷は、この一年あまりでほぼ治りましたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ですが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム……さっきバウンティハンターの襲撃を受けた時、本当は負傷せずに済んだはずでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "どうしてすぐに倒してしまわなかったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "最後の一撃の時、急に手を止めましたね。あの状況で躊躇するなんて……とても危険ですよ、グム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "でも、でもグムは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムにもどうしようもないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "……グム……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "実は、ジュナー教官にもあなたの習慣について尋ねられたことがあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "教官が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "怖いんでしょう、グム？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムは怖いの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "三発目は、自分をコントロールできなくなっちゃうから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "そしたら、学校でのことを思い出しちゃうし、夜中に悪夢も見ちゃうよ。ベッドライトを点けたまま寝たってダメになっちゃうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "それは……知っています。グムは眠れない時、絶えず寝返りを打ちますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ズィマーも知っていますよ。ですがそれは自分自身で克服するしかないことなので、何も言わないようにしていますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ですがグム、私たちは心配なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムは頑張ってるよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ええ、頑張っていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "私たちの中で一番たくましいと言っても過言ではないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グムは今ではもう、ベッドライトを点なくても眠れるようになったでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "まだ時々、私やズィマーの所へ来ることはありますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムは頑張って成長して、悪い習慣を全部直したいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "アーミヤとケルシー先生に聞いたんだ。グムのお父さんとお母さんは危険な仕事をしてて、会うのはとっても難しいって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ご両親を探しに行きたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うん。でも今はまだダメなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムは、お父さんとお母さんに今のグムを見せたくないの。二人に再会した時に、グムは悪い子になったって思われたくない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "だから今はまだダメなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム……あなたは悪い子ではありませんよ。いつも私たちを守ってくれているんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "でも、でも──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "やっぱりうまくいかないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "自分をコントロールできなくて、人を傷つけちゃうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "イースチナお姉ちゃん、グムはどうしたらいいのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "……きっと解決方法はありますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "今すぐに変えられなかったとしても心配はいりません。私たちが側にいますから、グム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "皆がついていますから、安心してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……イースチナお姉ちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うん！　お姉ちゃんたちがいれば、グムは何も怖くないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "その意気です、勇敢な小熊さん。もう怪我しないでくださいね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "痛ててっ、つっつかないでよイースチナお姉ちゃん、痛いよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "やっぱり痛いんじゃないですか。痛みに後悔したなら今後は気をつけてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "薬は塗り終わりました。ズィマーたちもそろそろ帰ってくるはずですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "見に行ってみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "オマエら、ちゃんと休めたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ズィマーおねえちゃん、グムはもう大丈夫だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "傷口の処理は済みました。作戦に支障はないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "そちらはどうでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "この先の村は様子がおかしい。静かすぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "あのバウンティハンターどもが、また何か企んでるんだろうよ。みんな気をつけろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "こんなことになるなんて思わなかったわ。迷子の子供を探すだけの簡単な任務だったはずなのに──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "まさかバウンティハンターに目を付けられるなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あ？　あっちが先に喧嘩を売ってきたんじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "それに子供を二人も誘拐しやがったんだぜあのクソ野郎どもは！　子供捜しをしてんだから手を出さねーわけにはいかないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "その辺にしとけ。見ちまった以上放っとく道理もねぇだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "さっきはうまく逃げられたが、次はそう簡単にはいかねぇぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "慎重にいきましょう。彼らは手強いですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "向こうは子供を人質に取っています。あまり刺激しすぎないようにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "また悪い奴が現れたら、グムがお姉ちゃんたちを守るよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "安心して、グムが悪い奴を全員こてんぱんにしちゃうんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "けれど、万一向こうから現れなかったらどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うーん……引きずり出す？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "めんどくせぇな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "私に考えがあります……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ごめんください──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "誰かいますかぁー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "すみませーん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うーん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "誰もいないみたいだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "ああ。どうやら調べても成果は得られなさそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "もういいだろう、帰るぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "これじゃあ完了報告ができないわ。もう一度他のオペレーターに頼んで来てもらうしかなさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "ふぅ……次はきっと百戦錬磨の先輩たちが来るでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "き、きっとそうだぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "たしか、何だっけ……そうだ、超絶強くてぇ、バウンティハンターもやってた先輩で、ビ、ビルを素手で壊せるらしいぜぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "（ため息）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "（小声）ロザリン、演技が下手すぎますよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "（小声）こういうのは苦手なんだよ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "帰ろ帰ろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "先輩たちが絶対に悪い人たちをみーんな捕まえてくれるもん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "（小声）物音がした、来るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム、危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ふん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "防いだもんね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喋らない賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "あまり首を突っ込むんじゃねぇぞ、ガキども。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "後悔することになるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "はっ、今まで後悔したことなんざ一度もねぇんだわ。腕に自信があるんなら掛かってこいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "くだらねえ話してんじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "おい、答えろ。ここにはオマエらしかいねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "ここの村人たちをどうした。オマエらに誘拐された二人の子供は今どこにいる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喋らない賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喋らない賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喋らない賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "（小声）……全然しゃべらないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "どうやら無理矢理口を割らせるしかなさそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "お！　やっちまうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "簡単に言うけれど……模擬訓練と違うってことは、みんな分かっているわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "大丈夫だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムがみんなを守るから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "重い……！　だけど、グムは耐えられるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "はあっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "それっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "（攻撃の手を止める）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喋らない賞金ハンター",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ううっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "チッ、どきやがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喋らない賞金ハンター",
      "text": "う……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "くそっ、もう少しで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "もう少しでアタシがこのヤローを倒せたのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "よそ見してちゃだめよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金ハンター",
      "text": "うっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "イースチナお姉ちゃん！　グムの後ろに隠れて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムの守りを……突破できるなんて思わないでよね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "気を付けて、グム！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "私が彼らの動きを抑えます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ズィマー、今です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "ああ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "チョロいもんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "大口を叩くものじゃないわ。息が上がってるじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ズィマーお姉ちゃん！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ケガしてるよ！　も、もしかしてさっきグムを庇ってくれた時に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムのせいだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "うるせぇな、めそめそすんなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そうだそうだ。どう見たってコイツが油断したからだ。グムのせいなんかじゃねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "でもっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "それよりも、今は他に解決しないといけねぇことがあるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "おい、どうする？　残りはもうオマエだけだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "早く答えろ。この村はどうした。それとあの二人の子供はどこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "言わねぇんなら──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "言わないなら、き、君の歯と髪の毛を全部引っこ抜いちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "（……そこまでする必要はねぇだろ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "ふんっ、このクソガキどもが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "口には気をつけやがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "せいぜい数人に勝ったから何だってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "目的はあのガキどもか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "そうだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "早く白状して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "ハッ、そう簡単に言うわけねぇだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "残念ながら、ガキどもの行方を知っているのは俺だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "俺が口を割らなけりゃ、お前らは絶対あいつらを見つけらんねぇってことだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "隠していても、損をするだけですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "思うに、こういう場合は、交換条件を出すものではないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "まずは俺たちを解放しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "そうすりゃガキどもは村に連れ戻してやる。だが、それ以外の奴らについては、お前たちが関わることじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "言いたいことはそれだけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "悪いが──断る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "てめぇよ、自分の立場がわかってんのか？　なんでそっちが条件を出すんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "そうだそうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "（小声）この人まで黙っちゃった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "（小声）まさか本当に死んでも言わないつもり？　どうしよう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "（小声）参りましたね。本当に拷問するわけにはいかないですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "もう何発かぶん殴ってやりゃいいんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "あ、声が大きいってば、ズィマーお姉ちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "なめやがって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "──くそったれの熊どもが！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ズィマーお姉ちゃん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "あっ──！？　ぐあっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "卑怯モンが……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "卑怯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "卑怯だろうが勝てりゃいいんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "死ねぇっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ソニア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "くそっ！　このガキ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "ゴフッ、うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "許さない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ソニアお姉ちゃんを傷つけるなんて許さない……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "もう一発……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "待て、グム！　アタシは大丈夫だ、落ち着け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "まだ子供たちの行方を聞き出さなきゃなんねぇんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "う、うう──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不機嫌な賞金ハンター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "グム……大丈夫か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あーあ可哀想に、死んだか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "いいえ、まだ生きてるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "ねぇロザリンさん、どうかこの方をあちらまで運んでくださいませんか？　私が止血をして、ついでに「目を覚まさせる」ので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "何だよ急にかしこまって。気持ちわりーな……別にいいけどよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "いいからいいから。早く来て。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ズィマーお姉ちゃん、傷口……血が出てるよ。ほ、包帯を巻いてあげるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ごめんなさい、ズィマーお姉ちゃん、イースチナお姉ちゃん。グム……またやっちゃった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "バカなこと言ってんじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "オマエが何をやらかしたってんだ？　オマエはアタシを助けてくれたんだろうが。感謝してもしきれねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "ズィマーの言う通りですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム、あなたは怖がりながらも、私たちを守ってくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "その通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "それにな……グム。アタシはオマエの怪力っぷりを知ってる。もしオマエが本当に全力でアイツの頭をぶっ叩いてたら、アイツは今頃とっくに死んでるだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "じゃ、じゃあ、あの人は──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "安心して、無事よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "もう一発殴って、たたき起こしてやらねーか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "無事だったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ってことは、グ、グムはコントロールできたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "そういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "最後の一発を力任せに振り下ろしたかと思えば、相手に当たる直前で力を抑え込んだ。この目ではっきり見たぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "こちらに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "それからズィマーも、こちらに寄ってください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "私たちは入れてくれないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "一体何の遊びだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "うるせぇな、押すなよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まだ争いの跡が残る現場で、ウルサス学生自治団の少女たちが仲睦まじく寄り添い合う。\nイースチナがグムの左手を、ズィマーが右手を取る。小熊たちは手を取り合い、額を寄せ合った。友の髪の毛が頬をくすぐっても、三人は決して離れようとしない。\nグムは自分の頭を二人の頭の隙間目がけて突き出し、いつものように自分の額を仲間の額に軽くぶつけた。\nそれから、親しみのこもったお返しの頭突きをもらった。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム、前に言ったことを覚えていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "あなたはよくやっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "安心してください、皆がついていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そうだそうだ、グムは本当によくやってるぜ！　最後に攻撃を受け止めた時なんてもう完璧だったぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "text": "ふふ、そのうち、自分の機嫌すらコントロールできない誰かさんよりも強くなっちゃうわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "は？　誰のことを言ってやがんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "プッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ズィマーお姉ちゃん、急に動いちゃダメ！　傷が開いちゃう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グム、グムは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グムは本当に……コントロールできたの？　本当に、力を抑えられたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "text": "ああ。できてたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "さて、落ち着いたらあの人を起こして、子供たちの居場所を聞き出しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "安心してください、私が白状させますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "text": "グム、あなたは私たちだけでなく、子供たちをも救ったんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "グム……コントロールできたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……グムはやれたんだ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "これと、それからこれも……あっ、そうだ、パンも多めに持って行こう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ふぅ、ようやく荷造りが終わったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "お父さんお母さん、ラーダがもうすぐ会いに行くよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "ケルシー先生は難しいって言うけど、やっぱり探しに行きたいの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "そうだ、ラーダね、攻撃をするたびに手を止めちゃう習慣を克服できたんだ……それに、三発目の力加減もコントロールできるようになったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "もうお姉ちゃんたちを……それにお父さんとお母さんを心配させずに済むよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "いまだに悪夢は見るけど、お姉ちゃんたちのおかげで、今はもう前みたいに怖くないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "お父さんお母さん、ラーダはここで楽しく暮らしてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "あ、お姉ちゃんたちに挨拶してこなきゃ。ラーダ、一人で遠出するのはこれが初めてだからね。絶対にまた帰ってくるから、ちゃんと待っててって言っておかなくちゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "……ふぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "よし、録画はこれでOK。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "──それじゃあ出発！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
