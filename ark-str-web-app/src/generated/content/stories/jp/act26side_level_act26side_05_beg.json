{
  "server": "jp",
  "storyId": "act26side_level_act26side_05_beg",
  "groupId": "act26side",
  "stageId": "act26side_05",
  "title": "主は御座におられる",
  "storyCode": "HE-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act26side/level_act26side_05_beg.txt",
  "sourceHash": "950abee2b629905bafc6f07b632b2233e5eae733bfd816d1015ee211fbf3282e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "……どういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "俺を疑ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "いや、そういうつもりじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "お前らは？　お前らまで、こいつと同じように俺を疑ってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な住民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ住民",
      "text": "疑うだの疑わないだの。そんな言い方は良くないんじゃないか、ライムント。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "俺は火なんて放ってねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "じゃあどうして、図ったみたいなタイミングで姿を見せたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "お前たちは普段、俺たちと共に祈りを捧げたりしないじゃないか。聖堂にくることだってない。お、お前らにはそもそも、信仰なんてないはずだからな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "確かに俺たちには信仰なんてねぇが、それとこの火事とは何の関係もねぇだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "信じようが信じまいがお前らの勝手だがな、俺はただ……ちょっとした用事があって、たまたま通りがかっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "どんな用事だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "答える義理なんてねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "お前……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェルナンド",
      "text": "なんだ？　俺たちはこの辺にきちゃいけないのか？　ぐだぐだ言ってるが、要するに火を放ったのは俺たちだって言いたいんだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェルナンド",
      "text": "ケッ！　ライムント、やっぱ俺たちゃ火消しの手伝いになんて来るんじゃなかったな。いっそ全部燃えちまえばよかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ住民",
      "text": "なんだと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な住民",
      "text": "……この時期に火事が起きるなんて、以前にもなかったわけじゃないわ。ただの偶然って可能性もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "だけど、こんな偶然あるかよ！　なぁ、そこのサンクタのお兄さんも誰かが火を放ったに違いないって言ってただろ？　あんたはどう思う……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "これが人為的な放火であるとの判断は変わっていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "お前もこいつらみてぇに、俺の仕業だって考えてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "いえ、そうは思いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "嘘つくんじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "嘘をつく意味がありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "助燃性物質を使用したという前提で考えると、着火から炎が広がるまでに要する時間はごくわずかです。そのことから、放火犯は事件発生時、聖堂付近からさほど離れていなかったと推察できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "つまり、ライムントの奴が……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "誤解しないでください。私が言いたいのは、火災発生時に現場付近にいた可能性のある人間であれば、誰であろうと容疑者足り得るということです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "その中には真っ先に駆け付けた皆さんや、私自身も含まれます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "な、何を言って……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な住民",
      "text": "全員に、放火の可能性があると考えてるの？　私たちサンクタが、聖堂を焼き払うかもしれないと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "種族がなんであれ、それが罪を犯してない証拠にはなりません。もしも聖堂を破壊する必要に迫られれば、私はためらったりしないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な住民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そちらのサルカズの方に対する嫌疑ですが、裏付けとなる証拠は現場にはありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェルナンド",
      "text": "フンッ、そこの兄ちゃんは案外筋の通ったことを言うじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "フェデリコさんの言う通りです……証拠もないのに他人を疑ってはいけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "だから、はいそうですかって言えってのか！？　聖堂なんだぞ！　あの花壇だって、お前が心血を注いで育ててきたものじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "これ以上はもう……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "私は……我々の中の誰一人として疑ってはおりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる住民",
      "text": "クレマン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "口論はここまでにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "サンクタが聖堂を破壊しないとは限りません。真犯人を見つけ出すまでは、私がこの事件の調査を行います。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "おい、翼持ち。さっきのことだが、その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "さっきのは、元はと言えばお前が始まりだろ。お前が助燃性何とかだの、放火犯だの言い出さなければ、俺たちに疑いが向くことはなかったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "それにお前、そもそも俺のことまだ完全に信じてないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "お前なぁ、もうちょっと何かマシな反応できねぇのかよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "チッ、まあいい。とにかくだ、俺が言いたいのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "……感謝の言葉なんて期待すんじゃねぇってことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "必要ありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "（小声）サラ、聞いた？　このお兄ちゃん、ありがとうも言えないんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "（小声）かわいそう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "（小声）かわいそう！　だけど、ぼくたちならお兄ちゃんに教えてあげられるよ。ありがとうって言うのは別に難しいことじゃないんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "（小声）うん……でもこのお兄ちゃん、ちょっと怖いし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "……うるっせぇな！　誰がありがとうすら言えねぇって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "おい翼持ち、この二人のクソガキは一体どっから連れて来た！？　こんな奴ら見たことねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "うわあっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "この子たちをご存知ないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "何だよそれ。俺がこいつらを知ってるはずだってのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ちょうどいいタイミングです。ここのサルカズたちが暮らす集落、及びこの子たち二人について訊きたいことがあります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "訊きたいこと？　そりゃあ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "俺が代わりに答えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "ジェラルドの旦那！　さっきの大火事は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "全部見てたよ。いい仕事っぷりだったぞ、ライムント。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "それと……また会ったな、執行人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私には理解できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたは先ほどから長い間この近くに立っていました。元々姿を現すつもりなどなかったように見受けられますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "……執行人の目はごまかせんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "なぜ心変わりをなさったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私に会いたくないご様子でしたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "平和な日々が長く続けば、人は多少なりとも内気になるもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "どうだ、執行人。あんた自ら、俺たちのいるところまで足を運んでくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "何のもてなしもできんが、座る場所くらいはある。あんたも俺たちサルカズがどういう暮らしをしているのか、その目で確かめられるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "それと、もし訊きたいことがあるなら……なるべく答えよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "こんなに体を動かしたのはずいぶんと久しぶりだわ。この手の追いかけっこって、昔から得意じゃないのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "だけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "とうとう捕まえたわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "（奇怪な叫び声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "シッ、声を抑えて。ここは居住エリアなんだから、他の人のご迷惑になっちゃうわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "（うなり声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "食ベ……オなカ……スい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "まあ、喋れるの？　つまり意思疎通も可能ってことかしら？　もしそうだったらやりやすいんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "（奇怪な雄たけび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……そう簡単にはいかないみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "悪いけど、これ以上暴れさせるわけにはいかないのよ。危険すぎるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたのことは、イベリアの裁判所に連絡させてもらうわね。彼らならあなたについてよくご存じでしょうし。まだ人としての思考が残ってるなら、あそこの宣教師たちに訴えることも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "くっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "誰！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "逃がさないわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "止まりたまえ、お嬢さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突如、波打つ光が夜の闇を断ち切った。\nレミュアンの構えた銃は、ずしりとのしかかる重たい力によって、動きを封じられた。\n光を放つ黒い影は、無言で立ち尽くしている。影は銃口を向けられたまま、その手に握る奇妙な形をした長剣をゆっくりと下ろした。\n月明かりを遮っていた暗雲が散り、レミュアンはようやく目の前の人物をはっきりと視認することができた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……今日は本当に、招いていないお客さんが立て続けにやって来る日ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "宣教師さん、邪魔しないでくれるかしら？　こんなところで時間を無駄にして誰かが傷付く結果になったら、私本当に怒るわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "すまないが、君に道を譲るわけにはいかなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "どうかあの哀れな魂を止めないでやってほしい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……何か聞こえました。詳しい状況は定かではありませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたたちの仲間は、それほど多くはないようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "少ないとも言えんがな。それと外に出ている数人がまだ戻ってきてないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "夜も更けてきた。皆、今日のところは家に戻ってゆっくり休み、英気を養ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重なサルカズ住民",
      "text": "ボス、本当に明日ここを出て行くのか？　まだ戻って来てない奴らもいるが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "前に話した計画通りだ。明日の朝会後にここを発つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重なサルカズ住民",
      "text": "……了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "ねぇ、フェデリコお兄ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "なんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "眠いよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "眠い！　あとお腹空いた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "フェデリコお兄ちゃん、ぼくたちをおうちに連れて帰ってくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "おうち帰りたい……ママに会いたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "お前たち、まさかずっと何も食ってなかったのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "ママもほとんど何も食べないけど、お腹は空かないって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "でも、ぼくたちは今日何も食べてないけど、お腹が空いてすごく辛いんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "ふしぎなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "食欲は人の基本的欲求の一つであり、正当かつ合理的なものです。長期間エネルギー摂取を怠り、エネルギー欠乏が限界を超えた時、不快感や苦痛を伴います。何も不思議なことではありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "むむむむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "難しいよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "何も食べないと辛くなるのは、普通のことなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "じゃあママは……ずっと何も食べてなかったけど、あれって、ママはずっと辛かったってこと……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "食べていないというのが事実であれば、その通りです。あなたたちの母親は、長い間身体的苦痛に耐えていたことになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "おいよせ、執行人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "これは事実です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "……うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "うう、ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "うわあぁぁ――ん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "時には事実を口にしない方が良いことだってあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "ママは……ママは、今も苦しんでるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたたちの母親が現在どのような状態にあるかは、私には分かりません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "皆が見守る中、執行人は身をかがめた。その身分を象徴するローブの裾とサッシュが土で汚れてしまっても、この時ばかりは誰の目にも留まらなかった。\nフェデリコ・ジアロは、子供たちの両目を見据えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ラテラーノ中庭公証人役場の執行人として、私に与えられた任務の一つは、この修道院に秘められた真相を明らかにすること。そしてもう一つは、この場所の安定した秩序の維持です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "失踪した住民の捜索も、私の職務の範囲内になります。つまりそれは私の任務です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "それって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "……お兄ちゃんが、あたしたちのママを探してくれるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ええ。私があなたたちの母親を見つけ出しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "ほんと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "やったぁ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "こいつは驚いたな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "執行人、この子たちはひとまず俺に任せてくれないか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私には彼らの行動を決定する権限はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "……それもそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "お前たち、しばらくの間はこっちのお兄ちゃんと一緒にいてほしいんだが。どうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "……俺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "俺はまだ……いや、もう聖堂は燃えちまったんだ。こいつらを送っていくくらいなら問題ねぇか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "（小声）フェデリコお兄ちゃんよりも怖いお兄ちゃんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "（小声）うん、すごく怖い……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "お前らなぁ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "まあまあ、落ち着けライムント。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "このお兄ちゃんがお前らをご飯に連れて行ってくれるぞ。そんで、食べ終わったらおとなしく寝るんだ。いいな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "でも、あたしフェデリコお兄ちゃんと一緒がいい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "サラ！　フェデリコお兄ちゃんはとても忙しいんだ。わがまま言うんじゃないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "う……うん！　じゃあそっちの怖いお兄ちゃんについてく……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "ふはははっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "旦那！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "ゴホンッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "ライムント、すまないが、子供たちを連れてって飯を食わせた後、休ませてやってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "そりゃ構わねぇけどよ……こいつらどこに寝かせりゃいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "ハイマンの家に連れてってやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "ハイマン？　確かに今あそこにゃ誰もいねぇが、もしあいつが夜中に戻ってきたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "大丈夫だ。送っていけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "へいへい、分かったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "フェデリコお兄ちゃん、また明日！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "明日、ママに会えるといいな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "明日は私があなたたち二人を迎えに行きます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "やったー！　じゃあおやすみなさい、フェデリコお兄ちゃん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "フェデリコお兄ちゃん、フェデリコお兄ちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "そ、それじゃ届かないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "もっとかがんで。もうちょっと……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "何ですか……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "えへへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "お、おやすみなさい……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "ケッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェラルド",
      "text": "ふははっ！　ずいぶん好かれてるようじゃないか、執行人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "今時のガキってのはよく分かんねぇな……こんな奴のどこがいいんだか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "おいガキども、もう少しゆっくり歩け！　ったく……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……おやすみなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "元々私は今回の出張を、のどかな旅行のようなものと思ってたわ。修道院の同胞たちをラテラーノに迎えるだけのお仕事なんて、そう難しくもないように思えるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "まあせいぜい、オレンって同僚がちょっと面倒事を起こすかもってくらいでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "でもちょっとしたトラブル程度なら、私にだって解決できる自信はあるわ。オレンだって話の通じない人間ってわけじゃないんだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "確かに君の銃の腕前であれば、大方の問題は解決できるだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "けどあなたの相手となると、この程度じゃ全然足りないみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "買い被りすぎだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "褒めてなんかいないわよ……宣教師さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あの奇妙な姿の客人を庇うために来たのよね？　私の勘違いでなければ、あなたはイベリアから来た宣教師ではない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "確かにその通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "宣教師のローブを纏ってるけど、ラテラーノの教えを信仰しているようには思えないわ。雰囲気が全然違うもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "鋭いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……はぁ。全然動じないのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "こうなった以上、はっきり言わせてもらうわ。こういう厳しい言葉遣いにはあまり慣れてないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "直ちにここから立ち去りなさい。それ以上、一歩たりとも前に進んではダメよ、宣教師さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "この楽園は、あなたが足を踏み入れていい場所ではないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "残念ながら、今はそうも言っていられないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "ここにはまだ私の助けを必要とする者がいるのでね、ラテラーノのお嬢さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "（くっ、まったく厄介ね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "（かなり特殊な剣を使ってくるわ。それにあの剣術、確かイベリアの……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "君の攻撃は、その言葉遣いよりもよほど苛烈だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "私は人と人とは分かり合えるものだといまだに信じているのだが、君からすれば、このような対応は至極妥当と言えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "ただ……一つ気になることがある。お嬢さん、君は楽園をいかなるものと定義しているのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "皆が平和に、幸せに暮らせる場所、かしら。何も特別な定義なんてないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "もちろん、怪しい目的を持った客人が少なければ、それに越したことはないと思うけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "では君にとってこの地は、間違いなく楽園と呼べるかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "まだそんなお喋りをする余裕があるなんて、ずいぶん見くびられてるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "六十年もの間浮き世を離れて暮らしてきた人々が、世間から隔絶された安息の地を作り上げたのよ。これを楽園と呼ばないなら、どんな場所が楽園と呼べるのかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "そこでの暮らしが、終わりなき飢えと寒さとの戦いに過ぎなかったとしても、かね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "確かに物資は足りていないかもしれないけど……だからと言って、終わりがないわけじゃないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "ああ、そうだった。ラテラーノがすでに救いの手を差し伸べていたのだったな。もうじきこの辛い日々にも終わりが訪れるのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "一部の者たちを代償として捨てれば……だがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……そうなってしまったのは、誰のせいでもないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "誤解しないでくれたまえ。私は誰かを責めているわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "ただ、私は常々こう考えている。人と人との違いは一体何なのか、とね。我々の間を隔てているのは、肉体的な差異なのか、それとも別の何かなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "個として誕生したその時から、それぞれの個は、各々を形作る要素に影響を受けて思考し、異なる結論を出す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "ならばその中には、いわゆる相互理解などというものが本当に存在するのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなた、サンクタに対して本気でそんなことを訊いてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "もし来世でサンクタに生まれ変わる機会があれば、自分で確認してみればいいんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……くっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "（まずいわね、時間が掛かりすぎてる。万一さっき逃げた侵入者が住民を襲ったら目も当てられないわ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "（さっさと片付けなきゃ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "お嬢さん、焦る必要はない。実のところ、私は何も企んでなどいないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "助けが必要な同胞のため、ここにいるのだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "誠実な言葉ね。けど、その言葉だけであなたのことを信じるわけにはいかないの……\nゲホッゲホッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "君のその頑固さは、私がかつて教えていた生徒によく似ているよ。そのような気質は普段は好ましいものだが、時には困らせられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "宣教師さんを困らせるほどの生徒がいるなんて、ちょっと興味が湧いてくるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "あれは私が今まで教えてきた中でも最も優秀な生徒の一人だ。残念ながら、彼がイベリアを離れてから一度も会えていないがね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "本当はこんなことはしたくなかったんだけど……はぁ、また怒られるわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "交渉は……決裂ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "けど正直、残念だとは思っていないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "レミュアンの話す声は小さく、動きはとても軽やかだった。\n車椅子が持ち主によって押しのけられると、肘掛けに吊り下がっていた灯りが夜風に揺れ、「キィッ」と音を立てて地面に落ちた。\n光源が砕け、光が無秩序に外へと流れ出し、その前方でゆっくりと立ち上がる背中を照らし出す。\nその瞬間、重たい夜の帳に光が灯った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "立てたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "正直……まだうまく動かせないんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ま、リハビリの時間が多少伸びて、お小言をくらうだけのことよ。何も問題なんてない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……くっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "私としては、無理はしない方がいいと思うがね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "君の身体は楽観視できるような状態ではないし、そもそも君はこういう戦闘を得意としているわけではな──\nむっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "お褒めに預かって嬉しいわ。残念、さっきの一撃はあなたのそのよく回る口を狙ったんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "お説教ばかりじゃ嫌われるわよ、宣教師さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "うまくいかないことばかりで、私はいま虫の居所が悪いの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたが売ってきたケンカなわけだし、多少やりすぎても問題ないわよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "弾を装填する音が響いた。桜色の髪の枢機卿補佐官が目を細める。長年の療養生活の間ずっと身にまとっていた柔和な雰囲気は、もはや影も形もない。隠し切れない鋭さだけが、そこにはあった。\nレミュアンは、小さく冷たい笑い声を上げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "この状態はすごく疲れるの。手早く終わらせましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それじゃ、もう一度言わせてもらうわね──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "──立ち去りなさい、宣教師さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ここは、あなたが踏み入るべき場所じゃないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "食ベ……オなカ……スい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "食ベル……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薄い扉が外側から押し開かれた。間延びした音は、まるで不本意な警告のように響く。\n小屋の中では、子供たちが眠りについていた。\n開いた扉の隙間から寒風がボロ小屋の中に吹き込み、未知の脅威が音もなくゆっくりと忍び寄る……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "食ベ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "オナカ……空イタ……食ベ、ル……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うごめく化け物",
      "text": "ア……アァ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
