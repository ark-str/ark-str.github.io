{
  "server": "jp",
  "storyId": "act34side_level_act34side_06_beg",
  "groupId": "act34side",
  "stageId": "act34side_06",
  "title": "エーギル失格",
  "storyCode": "BP-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act34side/level_act34side_06_beg.txt",
  "sourceHash": "382f15dce11f429ff9aaeb8d1184a16a21a0ad51df8dc0e605d95c006e23577c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "あーあ、ほんと嫌な臭いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "こんなに時間が経ったのに、あの人たちはまだ迷彩クリームを改良する気がないみたい。私たちが嗅いだ時とシーボーンが嗅いだ時で違う匂いにするくらい簡単でしょうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "やたらと動かないで、サメ。臭いがきつくなるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そんなに濃いシーボーンの臭いをふりまかれると、あなたを斬りたくなっちゃうわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "台地全体が揺れている……大型のシーボーンがこの下の岩層で蠢いているのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "隠れて頂戴。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "（わずかに液胞を震わせる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "（コアを激しく揺さぶる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "この数だと、海流にシーボーンが運ばれてるって言うべきか、シーボーンが海流を生み出してるって言うべきかわからないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "あいつら、前線に向かって押し寄せてるわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "前線にいる戦士たちがどんな戦いを強いられているか、想像できないくらいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "落ち着いて、スカジ。剣の柄を握りつぶさないようになさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "任務を完遂することこそ、戦士たちに捧げる最良の手向けよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "軍団の艦隊がシーボーンの群れを牽制していてこそ、私たちは巣穴深くに潜入して、ビーコンを投下することができるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "この先は少しのミスも許されないわ。シーボーンと同化してしまった植物一つを見逃せば、奴らの視線に晒されるかもしれないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "さあ、あの死んだ大きな珊瑚を遮蔽物として、海溝深くまで潜りましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター/スカジ",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "ジョディ君、だったかな？　君、飲み込みが早いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "そばで少し見ただけでできるようになるとは。以前職業体験に来た学生たちはみんな、丸一日かけて操作手順を整理しないとミスをしていたものだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "もしや、似たような経験が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ほんの少しですが。以前、イベリアの大灯台での仕事に携わったことがありまして。灯台とビーコン塔の原理には似たところがありますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "工学に興味があるんだね。それなら不思議ではないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "でも、僕が一番長くやってきた仕事は介護士なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "「介護士」？　それはどんな仕事なのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ええと、お年寄りや病気の人のお世話をして、日常生活の面倒を見て、時々雑務を引き受けるという感じですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "なるほど。リトル・ハンディに153号パーツと274号パーツを追加したようなものかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "あの、確かリトル・ハンディに人格は搭載されていない……はず、ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "何だか緊張しているようだね。私は別に、エーギルの一般常識を試す試験官などではないのだから、リラックスしていいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "何と言いますか、リトル・ハンディが人格を持たないのなら、お年寄りや病気の人の感情面をどう支えているのかを聞きたかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "何しろ、介護士は人々の一番弱く、やりきれない部分に接する仕事ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "我々には、身体的に弱っているのを理由に、感情面が特別揺れ動くようなことは滅多にないんだ。安らかに死を迎える人にとっては、その原因が病であっても、やりきれないというようなことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "確かに、お年寄りや病人は安楽死の処置を受ける前に、臨終対話を申請することはできるがね。その場合は通常、高名な哲学者やほかの分野の学者が対応することになっているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ぼ、僕は哲学のことなんてわかりませんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "その代わり、ごく普通の話をするんです。食べ物だとか、草花だとか、お日様の話を。でもなぜだか、皆さん嬉しそうにしてくれるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "それはすごいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "つまり君は、他人の感情の機微を敏感に察知できる人だということだよ。もしかすると、展望研究所や公共養育所で才能を発揮できるかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ぼ、僕がですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "……ええと、とにかく、ありがとうございます！　こ、この記憶装置はリセットできましたので……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "完璧な操作だな。では――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "待った、今ホログラムに何か映らなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "何が――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーコン塔技術者",
      "text": "侵入者だ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "お前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "見なかったことにしろ、若造。無暗に状況をひっかきまわすなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "待ってください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "丸鋸では音が響きすぎるわ。スカジ、あなたが道を開きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "この珊瑚を斬るの。できるだけ静かにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一瞬にして、美しい色彩とおぼろげな光と影が、侵入者たる狩人たちを包み込んだ。\nイベリア人が溟痕と呼ぶ生物が幾重もの珊瑚の間を漂い、そびえ立つ岩壁には密集した卵が揺れている。\nそこからは、水流に伴って絶えず卵が落ちていき、回転しながら形を変えて名状しがたいひだを伸ばすと、シーボーンとして姿を見せた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "生まれたてのシーボーン",
      "text": "（柔らかい膜を動かす）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "生まれたてのシーボーン",
      "text": "（ひだのような皮をはためかせる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "新たに生まれた複数体が音もなく集まったと思うと、その身体の震えが巣穴全体に伝わっていく。触手とひげが絡み合い、シーボーン同士が絡まり合って遠くへと流れていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "奴らのほうは今も、絶えず新たな個体が前線へと向かっているのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "待って、何か変じゃない？　今の奴、急に何体かに増えなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "奴らは何をしているの？　増殖？　それとも分裂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "カジキ。この前艦隊の救援に向かった時にも漠然と不安を感じたけど、こいつらまた進化してない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "シーボーンは常に進化していてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ねえスカジ、最初に殺したシーボーンのこと覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "はっきりとは覚えてないわ。触手がたくさん生えてた気がする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "そうね。触手や棘や、キチン質の外殻は……まだ見れば何だかわかるし、その機能もすぐに理解できるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "これまで、奴らは他種が長年にわたって蓄積してきた進化の成果をかすめとることにだけ特化していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "でも、目の前のこいつらは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "どういう器官を備えているかもわからないし、三ヶ月前に殺したあのゴミどもとこいつらの間に関係があるとは思えないほど、別物になっているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……これまで通りの進化では、もはや奴らは満足しない。それで、自分たちだけの進化の答えを探し始めたんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "つまり、奴らの進化の形はすでに、私たちの認識を超えようとしているということよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "奴らの身体構造を観察し、器官の機能を判別し、進化の方向性を予測することができなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "殺し方すらわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "撤退するときに、ブランドゥス顧問にサンプルを持ち帰ってあげましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "けれど、今は任務が優先よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "スカジ、まだ溟痕に覆われていない岩壁を見つけ次第、ビーコンを埋め込んで起動させましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ローレンティーナは周囲を警戒していなさい。設置が終わり次第、即刻撤退するわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "クレメンティアさん。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "執政官閣下。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "あなたがドクター殿ですね。お噂は伺っておりました。お初にお目にかかります。ようやくご挨拶できましたね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "イベリアの正式な代表はケルシーだからな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ご謙遜を。実際、ケルシー医師のご見識は空間と時間の境界を超越するもので、感銘を受けておりますけれど――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "その後ろに姿を隠しておられたあなたは、きっと輪をかけて深いご見識をお持ちなのでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ご質問であれ、ご結論であれ、喜んでお伺いいたします。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "あなたは狩人たちを危険な巣穴へ送り込んだな。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "あなたはロドスのオペレーターを危険にさらしている。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ケルシー医師と同様に、この決定に疑問を抱かれているのですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "けれど私は、彼女たちを再び死地に送らざるを得なかったのです。今の膠着状態を打破しうるのは、彼女たちを置いてほかにおりませんから。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "理にかなっているが、かないすぎているとも感じるな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "軍団は出払っており、エーギルに戻ったばかりの狩人たちまで戦闘に駆り出されるこの状況が、何者かの意図によるものだとお考えなのですね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "都市内で何かを発見されたということでしょうか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ビーコンと兵器の連携システムが改ざんされたかもしれない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "リトル・ハンディ。今すぐ、航路用ビーコンと第Ⅳ級兵器の中核研究開発と管理を行っている担当者に連絡を。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "加えて、全軍団の指揮官に通達しなさい。一部艦隊を残して前線のシーボーンを牽制、狩人たちを援護しつつ残りは順次撤退し、都市の防衛に戻れと。海巡隊はビーコン塔制圧に当たらせるのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "情報提供に感謝いたします、ドクター殿。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（黙ってうなずく）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "アビサルハンターの配置については、お二人にまだ説明すべきことがございますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "我々は、戦術上の説明を必要としているわけではありません。アビサルハンターの持つシーボーンへの対応能力については、あなたのほうがお詳しいでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ですが、あなたほどの観察力を以てして、グレイディーアの首の鱗を見逃すことはないはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "狩人たちには無事任務を遂行する能力があると仮定しても構わないでしょう。ですが、彼女たちがシーボーンの巣穴で変異してしまわないという確証はあるのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ブランドゥス顧問が保証しているというだけでは？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "評議における彼の発言が、狩人たちに対するミリアリウムの信頼を確固たるものにしたのは確かです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "けれど、私にとってあれは気休めにもなりません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "それを聞くに、アビサルハンターに関して、何かお考えがあるようですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "……実際のところ、「ファーストボーン」を仕留めた後も、アビサルハンター計画は停止されてはいないのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "私は関与していませんが、その内情について知り得ていることだけでも、本来なら公民全員からの質疑を受けるべきと感じます。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "「ファーストボーン」の死後すぐに、アビサルハンター計画には大きな変化が起きました。関連実験には異常が頻発するようになり、深海教会の動向も狩人により焦点を当てたものになったのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "これは、アビサルハンターの背後には今も、早急に発見されるべき未知なる何かがあることを意味しています。ですが同時に、公開型のプロジェクトとして運用すべきでないことも示しているのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "そうして今日まで、アビサルハンター計画は今も秘密裏に進められています。けれど現状では、エーギルのアビサルハンターはいまだにグレイディーアを始めとする三……四名のみ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "技術は絶えず進化を続けていますが、それでもエーギルは、再びアビサルハンターを生み出すことはできませんでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "被験者のバイタルサインと精神状態の数値がどれほど安定していようとも、彼らは目覚めた途端に正気を失い、シーボーンへと変貌してしまうのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "実験室を出ることさえなく、海に触れずともそう成り果てるのです……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "「アビサルハンターの血は繋がっている」と聞くが……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それはいかなる血かという話題を、我々は常に避けてきた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "私にもその答えはわかりません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "狩人たちが意識を保てる理由はまだわかっていないのです。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "であれば、彼女たちはその謎を解く鍵となるだろう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それでもあなたは、彼女たちを前線へと送った。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "……ええ。あの三人、ひいてはすべてのアビサルハンター計画の参加者に対して、無責任な行為だと思います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ですが、ミリアリウムはすでに前線にあるのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "陸へと押し寄せるシーボーンの波は即座に阻止できましたが、ミリアリウムは難攻不落とは呼べません。仮に航路を切り拓くことができなければ、この都市が陥落するのも時間の問題です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "シーボーンは組織的に航路の要衝を押さえていますから、正面から強引に攻め込めば、大規模な反撃を招くことになります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "そうなれば、誰一人生き残れはしないでしょう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "狩人が危険を冒して戦うことは必要な代償だと？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "彼女たちが犠牲となる可能性も、変異する可能性もあることは事実です。けれど今は、彼女たちが何よりの希望なのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "グレイディーアは、航路計画の実現性に疑問を抱いていました。ゆえにこそ、計画への参加を躊躇いなく決めたのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "その懸念と葛藤はあなたとは違うものかもしれませんが、導き出す結果は同じでした。エーギル人の心は、暗黙のうちに通じ合っているようですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "……悲しい通じ合いとも言えますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "――闘智場の入り口に積まれたレンガには、設計者であるマルトゥスが残した格言が刻まれています。曰く「ここに正義はなく、ただ前路のみがある。」",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "かの先哲は……物事の価値にとらわれるあまり、際限のない価値の比較に精神力を大きく浪費した、と後世の人々から評されることもあります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ですが、彼が気に掛けていたのは、実のところエーギルの前途だけでした。マルトゥスは、正義のような、大衆が好む感情に根差す価値観にとらわれることを良しとしていなかったのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "こうしてみるに、私もグレイディーアも、無意識のうちに彼の理念を実践していたのでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ケルシー医師が以前仰られたことは正しいと思います。どうあれ、私の身には「エーギルの傲慢」がしみついているのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "その発言は訂正させていただけますか。「傲慢」という言葉では、エーギルを要約するには不十分なように思います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "あなた方はすべての同胞の人間性を尊重し、人々がその価値を発揮することを社会全体の発展目標と見なしている――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかし同時に、エーギル全体の存続のためなら、どれほど残酷な決断でも下し、それを冷静に受け入れることができるのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "冷静に……ですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "エーギル人は冷血ではありません。あなた方が怒りを覚える時、私の心も何一つ動いていないということはないのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "そうした感情をグレイディーアに向けて表現したいとすら思いましたが、私にはそんな資格などないと気付かされました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "私は、彼女に対して純粋に理性からなる決断を下したのですから、感情的な許しを求める資格など当然ありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "今この時も、それは同じこと。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "それゆえ私は、「冷静に」自分の決断を受け入れたのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "「リトル・ハンディ」",
          "text": "ご指定の担当者への通信が完了しました。ですが、ブランドゥス顧問には連絡がついておりません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "お二人とも。要領を得ないご回答ばかりで申し訳ありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ですが今は、責務を果たさせてください。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
