            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "ドクター、もう一つ冒険と言っていい考えがある。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "エーギルだ。現時点において総合的に判断すれば、これが最適な選択だろう。",
