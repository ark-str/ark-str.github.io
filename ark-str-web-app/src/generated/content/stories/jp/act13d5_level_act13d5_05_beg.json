{
  "server": "jp",
  "storyId": "act13d5_level_act13d5_05_beg",
  "groupId": "act13d5",
  "stageId": "act13d5_05",
  "title": "スウォマー食品",
  "storyCode": "MN-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13d5/level_act13d5_05_beg.txt",
  "sourceHash": "d0a03c30a0c9eeb950ddef2638877be073c9fdb5999efdbcb10717ba3a2d9d4a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔 5上"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "あなたのグラスです、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "あ、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "ロアーガードは会員に多種多様なドリンクを提供していましてね。いやはや、実に羨ましいものです。会員たちはここで飲みながら、騎士の奮闘する姿を眺められるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "さて……話は変わるのですが、あなたは善良な国民ですよね。違いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "え？　えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "法を犯したことは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "……いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "では、悪事を働いた覚えは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "いえ、もちろん、ございません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "つまり、あなたは真面目に働き、自分と家族のためにお金を稼いできた、いかにも善良な国民ではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "そ、そうですね。その基準ならば、私は確かに善良な国民ですが、カジミエーシュには同じような人は大勢いるかと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "ええ、大勢いますね。さあ、善良な国民たちに乾杯しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "あ、はい。乾杯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "それでは……ある人が善良な国民から職を――生きる術を奪おうとするならば、その人は善良だと言えるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "と、言いますと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "田舎の農夫でさえ、一日の終わりには近くの都市で開催されている騎士競技の中継を楽しんでいるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "数十万……いや、数百万単位のカジミエーシュ人が、騎士競技関連の産業に従事しています。彼らは至って善良な国民なのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "それは、つまり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "もしも騎士競技が無くなってしまったら……バックアップする企業が一夜にして消えてしまったら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "誰が征戦騎士のために年々増加する軍事費を負担し、外敵の侵略を防ぐためにカジミエーシュの経済的地位を担保するというのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "いかがでしょう。こう考えると騎士競技に反対している人たちは、いわゆる「悪人」に該当すると思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "あなたは紛れもなく善良な国民です。彼らはそんなあなたから生活の糧を奪い、それをもって彼らの古き「名誉」に華を添えようとしているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "私たちはこの社会の一員として貢献するため、大勢の人たちに――たとえそれが感染者であっても――生きるための手段となる仕事を提供してきました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "しかし「悪人」たちは、くだらない自己満足のために、国と国民の利益を蔑ろにしているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "では、もう一度お聞きしましょう。あなたは善良な国民である――間違いありませんね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "おお、カジミエーシュらしい雰囲気が漂っているな！　ここがあのニアールが贔屓にしているバーか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "おーい、オーナー！　今日もマリア・ニアールは来るのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "それは君たちの運次第だね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "なんじゃ、大繁盛しておるではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "マリアのおかげでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "こんなに盛り上がるのはいつ振りじゃ？　ゾフィアが活躍しておった頃以来かのう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "これが「騎士」人気というものさ。ここに来る客の大半はマリアの顔を拝みに来たんだ。どこのメディアでうちのバーが紹介されたかは知らないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "何故そんな渋い顔をしておるのじゃ。金になるんじゃろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "私はどちらかと言えば、彼女たち二人が静かにリラックスできる場所を提供したかったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "マーティン、この椅子に「コーヴァル専用」って文字を彫ってくれないか？　次に来たときも待たせられるなんて御免だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "指定席料金を払ってくれたら、考えてやらんでもないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "チッ！　ドケチめ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "おい、おい！　本当にニアールが来たぞ！　本物だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "記念写真を撮りに行くぞ！　早く早く！　この機を逃すな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "え？　あ、ありがとう……写真？　私と？　ごめんなさい、あの、今はちょっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "はいはーい、どいたどいた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "えっ……ゾフィア？　“ウィスラッシュ”ゾフィアじゃないか！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "やはりあの噂は本当だったんだ！　“ウィスラッシュ”ゾフィアがニアールの教官なんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ゾフィアさん！　昔、あなたの試合を観戦しました！　とても感動したんです！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "（ああ、この状況はもう、ダメだ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（お、おばさん！　早くなんとかしてよ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "マリア、愛してるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "何だと！？　マリアはお前一人のものじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "おい、喧嘩は外でやってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "そうだぞ、中で喧嘩するのは老いぼれの特権なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "――コーヴァルおじさん、フォーゲルヴァイデおじさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "はいはい皆さん、ご注目。長い間、弊店をご贔屓にしてくださっているマリアの好成績を祝うべく、本日は全メニュー20%以上割引の大セールを実施したいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "さあ、今すぐ席についてご注文を。各種アルコール類やスナックは数量限定だから、早い者勝ちだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "セール？　ツイてるな、今日は！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "いや……それより……あのハゲおやじは、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "私はマーティン、ただのしがないバーのマスターだよ。はい、ご注文は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "マーティン……？　間違いない、「震鉄」マーティンだ……うう……今日はなんて最高の日なんだ……「マーティンスペシャル」を一杯お願いします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "や、やっと治まった……でも、ここがこんなに賑わってるところなんて初めて見たよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "ありがとね、マーティンおじさん。セールの赤字分はあとでちゃんと払うから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ははは！　「20％オフ」くらいで私のバーが原価を割るとでも？　このマーティンを舐めないでもらいたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……さすがね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "な……なんじゃ？　お主、もう飲めんのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "バカ、もう誰もいないんだぞ、誰と飲む気だよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "わしは――オエェ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "おい、こんなところで吐くな！　吐くなら外で――くそっ！　このボケジジイが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "もう閉店の時間だし、これで君たちもやっと落ち着いて話せるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "閉店したら、私たちの貸し切りになっちゃうわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ははは！　なんなら、閉店後がこのバーの正式営業時間だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア……結論から言うと、君のポイントはもう充分足りてるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "まさかの連戦連勝、大したものだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "う、運が良かったんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "このまま、シーズン後半までポイントを守り抜けばいいっていう話なんだけど……私の不安は他にあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "おばさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……マリア、次はレースよ。ポイントの変動が比較的緩やかな種目だから、勝ち抜けをより確かなものにするために出ればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "でも、それ以降の試合には出さないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "で、でもこのままっていうわけには……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "もういいの、ほとんど「勝ち確」なんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "さっきの騒ぎを見たでしょ？　……マリア、今の君はたくさんの人の注目を浴びている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "今まで通りの調子をキープしていれば、ポイント確定後に必ず騎士の称号が得られる。これで私たちの目的は達成できるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "いい？　私の言う事を聞いて。これが最善策なの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "でも……でも、それじゃあ何の変化もないじゃない！　……私が前に進まないと、ニアール家の現状は変えられないっていうのに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ムリナール叔父さんだって、こんなやり方は認めないと思う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "ムリナールは石頭なんだから、君が何をしたって認めてくれるわけないわ。それは君が一番よくわかってるはずでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "難しく考えないでマリア……いい？　これでいいの、潮時なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "おばさん……何かあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "君は騎士競技の本当の姿を理解していない……これから出くわすのがどういうものか、君は知らないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "おばさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……競技場にはね、騎士の勝利なんて最初からないの。真の勝利はいつだってカジミエーシュのもの……企業のものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "本当に彼らと手を組むのが嫌だったら、最初からこの騎士競技に参加するべきじゃなかった。それでもこの道を歩むというのなら……マリア、ここで諦めるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ゾフィア、何か掴んでいるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……スウォマーの社員が、内部に出回っている噂を教えてくれた。マリアの人気が、騎士協会上層部の目に留まったみたい。悪い方の意味でね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリアの成績を適当な順位にとどめないと、奴らが動いてしまう。相手がどんな卑怯な手を使おうと、私たちにはそれを止める方法はない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "だから、マリア、私の言う通りにして。わかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "わ……わからないよ……その人たちに目をつけられないために黙って目を伏せるんなら、結局向こうの思惑通りじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア！　これは冗談じゃないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "わかってるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "君は競技場で死ぬかもしれないのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……「焔尾」も言ってた。私は騎士競技を理解していないって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "たしかに私は騎士競技の理不尽な一面をまだ見ていない……でも、私だっていい加減な気持ちで参加したわけじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "たとえ予想外のことが起きたとしても……そのせいで代償を支払う結果になったとしても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "もういい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あ……ごめんなさい。私、おばさんのことを言ったわけじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "こんなもの「代償」とは言わないわ。そんなくだらない理由で君に万が一のことが起きてほしくないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "そういう気持ちで競技に臨んでいるのなら、尚更やめるべきよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……でも、私はここで足を止めちゃいけないと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "メジャーに出場できなくたって、目標の一歩手前でつまずくようなことになったって、自分の理想には自分の努力で近づかなきゃ……私は立てなくなるまで戦い続けたいの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……わかった。もういい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "おばさん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "もう騎士競技に挑み続けるべきじゃないって考えは変わらないわ。君は騎士競技を裏で動かしている連中の恐ろしさも、当時のマーガレットがどれほど突飛なことをしたのかもわかってない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "カジミエーシュが真に公平な国なら、君の言い分は正しかったかもしれない。でも、現実は大抵理想の真逆のものよ。これらの規則がどんなにあやふやなものか、少し考えれば誰でもわかると思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "君はまだ騎士称号も無ければ、どの組織や企業にも属さない独立騎士なのよ。マリア、私はいつでもあなたの参加資格を取り消すよう騎士協会に申請できる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "話はここまでよ。それじゃ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……おばさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "落ち着きなさいマリア。ゾフィアにも頭を冷やす時間が必要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "彼女は君のためを思って言っているんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……わかってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ゾフィアの言う通り、騎士競技の勝敗はいつだって思い通りにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "企業は「ニアール家の新しい騎士」に芽吹く機会を与えた。だが、収穫の時期になれば、彼らは躊躇なく鎌を振りかざしてくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "騎士には、大会に「参加申請する」権利しか与えられていない……メジャー本戦を除いて、大会の全ては企業の手に握られている。騎士に選択権はないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "もしゾフィアが聞いたという、企業内部の噂が確かな情報だとすれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "そんな危険なシグナルを、無視するわけにはいかないだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "うぇっぷ……どうしたんじゃ？　今さっきゾフィアが店から飛び出していくのを見たんじゃが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "なんだ嬢ちゃん、顔色が悪いぞ？　勝ったんだろ？　勝っても喧嘩するのかお前らは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "役立たずの老人どもはいい加減、口を挟まないでくれるかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……さ、先に帰るね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "レースに備えて、装備の点検もしなくちゃいけないし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア&プラチナ",
      "text": "ん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（キレイな人だな……でも、血の匂いがする。騎士なのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "（マリア・ニアール、ずいぶんと若いな……資料で見るよりもっと若い気がする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア&プラチナ",
      "text": "（勿体ないなぁ……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
