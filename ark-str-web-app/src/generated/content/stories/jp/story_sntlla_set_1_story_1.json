{
  "server": "jp",
  "storyId": "story_sntlla_set_1_story_1",
  "groupId": "story_sntlla_set_1",
  "stageId": null,
  "title": "明日に咲く雪花",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_sntlla_1_1.txt",
  "sourceHash": "b576d70697dd4dcb5a99f3f4ffda63c402963d186e4384e914273a5ab58b9658",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "うん……少しズレちゃってはいるけど、大体座標の位置辺りまで来たみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "人々が移動の際に使うであろう道には見当がついているわ。目標地点に誰もいないようであれば、そこから座標の場所へ向かっても遅くはないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "あのサーミフィヨド……サーミ人の話にあった「清泉」と「茸木」はどちらも族樹を持つ部族なの。族樹は移動時にとても大きな音を立てるから、見つからないということはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "なるほどねえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ちょっとノーマン、今の聞いてた？　君も少しはサンタラさんを見習いなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "へいへい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "俺に五日分必要な旅程を四日分で収める能力なんかがありゃあ、あの時軍を除隊されることもなかったと思うがねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そうは言っても、これはかなりの急行軍が前提になるし、私の焦りに付き合わせることになって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あなたのせいじゃないよ。最近サーミの情勢が複雑になってるのは確かだしさ。観測隊もサーミの戦士も北へ向かってる一方で、部族のほとんどは南に移動してるわけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "そうやって部族単位の移動をしている中でも、感染者の診察を任せてくれる部族がいるのは信頼関係あってのことだし、これくらいの苦労はなんともないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンタラは通信機に耳を寄せたが、ノイズのほかに聞こえるものはない。\nこの通信チャンネルはおそらく、すでにウルサス人の手で閉鎖されたのだろうということを彼女はほとんど確信していたが、それでも通信機を手放そうとはしなかった。\nこれが少しでもウルサスの情報をもたらしてくれる可能性がある以上は、まだ持ち続ける価値があると思ったのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あっ、そろそろ到着かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "森のあちこちで樹冠が動いてる。多分救援を要請してきたサーミ人だろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ごきげんよう……「清泉」の戦士よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "なぜそれを――さてはシャーマンか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "身につけた紋様や装飾は、あなたについて雄弁に語るものです。尊敬すべき戦士よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "救援要請の信号を送ってくれたのはあなたですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "いや、それは姉だと思うが、彼女は今、部族間を取り持って動いているところでな。直接の出迎えができず申し訳ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "お気になさらず。我々は感染者のために訪れただけですから、おもてなしやご挨拶をいただくのは皆さんが目的地へ到着した後で大丈夫ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "感謝する。さあ、どうぞこちらへ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "各部族から、感染してしまったサーミの同胞が皆ここに集められているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "まずはこの場の全員に、基本の検査を行いましょう。オペレーターの皆にもそう伝えてくれる？　フィー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "はーい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ノーマン！　早くこっち来て通訳してー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "わかったわかった……今行きますよっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "そちらの人員は、まるで戦士のような備えをしているのだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "病との戦いは、往々にして硝煙のない戦争のようなものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "それもそうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "姉が賭けに出たのは正解だったと見える。君たちに彼らのことを頼めるのなら、本隊もこの得体の知れない病気のために議論を重ねる必要はなくなるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "こちらへ来た時、樹冠が四つ移動しているのを見ましたが、此度は四つの部族がまとまって移動しているのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "しかし、それにしては人数が合わないような……たとえ、大きな部族ばかりが四つ集まったとしても、ここまで大所帯にはならないはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "我々としても、四つで済めばどれほど良かったかとは思うが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "本当のところは七つだ。今ここには、七つもの部族が集まっているんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "しかも、そのうち二つの部族の雪祭司は、エイクティルニルの召集に応え、戦士と族樹を連れて北上していった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "族樹を連れて……！？　そんなことをサーミがお許しになるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "そこは私にはわからないが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "ともかく、この場の状況も混沌を極めているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "幸いここでは、五つの族樹に囲まれている分、夜は心穏やかに眠ることができるがな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "五つ、と仰いましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "ああ、五つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "「亡寒」の族樹はまだそれほど古い樹ではないのでな。樹冠が森を突き抜けるほどの高さはないんだ。ここへ来る時に見えなかったのはそのせいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サーミの戦士",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "いえ、なんでもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "その「亡寒」の部族は……どの辺りにいるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "（サーミ語）心配しなくていい。あんたの症状はまだ軽いほうだからな。だが患部をいじるのはやめてくれ。そんなことをしても、痛い思いをするだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "（サーミ語）ああ。定期的に薬を飲んで、注射をすれば、病気の進行を抑えられるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "（サーミ語）嘘なんてつくわけないだろ。見ての通り、俺も感染者だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "源石融合率も皆そこまで高くないし、私たちが持ってきた薬だけでも十分そう。だけど、支援が来れば食料不足の人たちを配給で助けてあげられるから、早く来てほしいところだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あれ？　サンタラさんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "もう戻ってきてもおかしくない頃だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ねえノーマン、サンタラさん見なかったー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "（サーミ語）ああ、そうだ。薬をただ飲むだけでいい。いちいち呪文を唱えたりシャーマンに頼んだりしなくていいからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "……っと、悪い、今なんつったー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "サンタラさん、見てなーいー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "さっき出迎えてくれたサーミ人と話したあと、後ろの部族のほうへ歩いてったぞー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "どうかしたのかー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "なんでもない、ありがとうー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "（じゃあ、もしかして……向こうにいるのが、サンタラさんの部族なのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "（でも確か、あの人は……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女が部族を離れてから、どれだけの時間が経ったのだろう？　数年か、あるいは十数年だろうか？\nかつてあった不満と失望はすでに薄れて消えており、代わりにあるのはわずかな郷愁だけだった。\nそれに、彼女は今も、何人かの顔なじみと、部族内の風習、そして伝統の一部を覚えていた。\nかつての温もりや心地よさは、今なお彼女の記憶に残っていた。だが……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ごきげんよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "やあ、初めて見る顔だな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この地に生きる者たちは、風雪の娘のことを今も覚えているのだろうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "どこの部族の人なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これまで彼女は、敵であれ味方であれ、誰に対しても正直に接してきた。\nけれども今日、彼女は嘘を吐かなければならない運命にあった。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "よそから来た、通りすがりの者です。人から手紙を託されて参りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "族長様はいらっしゃいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "族長ならまだ天幕においでだ。案内しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "ところで、君のことは何と呼べばいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "サンタラと呼んでいただければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "サンタラか、いい名前だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "では、ついて来てくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "以前ならば、彼女は老樹が忘れられたことに怒りを覚えていたのだろう。\nだが今では、彼女自身も忘れ去られてしまっていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "道すがら、今も記憶にある人々が、物珍しげな目を向けてきた。\n彼女という「よそ者」に。\n華やかな衣服を身に纏い、鋼鉄でできた杖を携えた人物に。\n誰も思い出してなどくれず、そこに「思い出」は存在しなかった。\n彼女は完全に忘れ去られていたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "ここだ。少し待っていてくれ、族長にお伝えするから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒の戦士",
      "text": "よし、入ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ようこそおいでくださいました、友よ。なにかお力になれることはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "あなたは……もしや先代エイラス様のお孫さんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ええ、そうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "確か族長代理はあなたのお兄様が務めていらしたと思うのですが、あの方はどちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "兄は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "兄は、エイクティルニルに追従して北上しました。ですので、今は私が代理を務めております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "そのようなことを問われるとは、あなたは一体、何者なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "老樹に拾われし捨て子であった、サンタラの木の娘です。覚えておいでかはわかりませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "サンタラの木の娘……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "本当にごめんなさい……老樹に別れを告げる儀式のことは記憶しているのですが、その下で暮らしていた頃のことや、去った人々のことはあまり覚えていないのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "今では、彼女も過去のものとなっていた。\nあの老樹と同じように。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……そうですか。お気になさらず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "見張りの者からは、あなたが手紙をお持ちになったと聞いていましたが、あれは私に会うための嘘だったのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ええ……申し訳ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "責めているわけではないのです。わが部族はこれまで多くの離散を経験し、多くのものを失ってきましたしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ですから、私にできることや、何か証明してほしいことがあれば何なりとお申し付けください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "相手に思い出してほしいという気持ちは確かにあった。だが、それが叶ったとして、その先はどうなるというのだろうか？\nすでに追放者となった人物を思い出したとして、何が変わるというのだろうか？\n彼女の過去など、もはや取るに足らぬことになったのなら……\n後悔を抱えたまま去るまでだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "白樺の木の娘アルマよ、此度の失礼をお許しください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私はかつて亡寒の民であり、今はその追放者を自認する、サンタラの木の娘シモーネです。本来ならば掟に従い、部族に戻るべからざる身なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それでもここを発つ前に、部族のために何かをさせていただけたらと思っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ですのでどうか、あなたの意見をお聞かせ願えませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "なぜ私の名を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "あなたがかつて部族の一員であったと……信じましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "となると、そうですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ご覧の通り、私たちは今も移動の最中です。これまでも色々な出来事に見舞われましたが、対処をしてこられましたから、それに関してはあなたのお手を煩わせることはないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ですが、私たちの故郷……つまり、森へ移住したあと暮らしていた場所のことですが、そこを立ち去る前に先祖の魂を慰めるための儀式を行えなかったことが気にかかっていて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それは、北方の厄災のせいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "はい……その当時は、厄災の影響が集落まで及びかけていたので、急いで立ち去ることしかできなかったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "わが部族にはまだ新しい雪祭司がおらず、シャーマンだけでは厄災に立ち向かうことなどできませんでしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "時に、あなたもまたシャーマンであるとお見受けいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……シャーマンとしての責務を果たすことなら、かないましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ならば、その儀式の実行をお願いできますでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ええ。必ずご期待に応えて見せます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "サンタラの木の娘よ、本当に申し訳ありません。これほど親身に手を差し伸べていただいているのに、あなたが誰なのかすら思い出せないなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "お気になさらず。もう、過去のことですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "では、またお会いしましょう。亡寒の族長よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "あなたと部族の皆様が、無事にサーミの背骨を渡り歩くことができますように。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "変わった方だったけれど、もしかしてお爺様のお弟子さんかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "お爺様がまだご存命であればきっと、私にも彼女のように自信と謙虚さを持って部族を導くことをお望みになるのでしょうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "（身につけていた琥珀のペンダントを取り出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亡寒のシャーマン",
      "text": "ねえ、こんな時あなたならどうするのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シャーマンは、旧友が残した首飾りをぼんやりと見つめた。それは彼女が幼い頃、とある歳若きシャーマン見習いと遊んだ時にもらった贈り物だった。\nその子はフェリーンで――\n彼女の瞳は、先ほどの訪問者によく似ていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あっ、サンタラさん、おかえり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ただいま。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "こっちのほうは人手は足りてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "うん、十分だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それじゃ、少しほかの用事で出てくるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ある部族の人から、以前暮らしていた場所に崩壊が迫っているという話を聞いたの。万一それが広がってしまったら対処が難しくなってしまうでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "だから調査をしてこないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "一人で行くつもり？　それって……危ないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "人数がいれば解決するというものではないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私はシャーマンとして訓練を受けているし、この場で汚染に対処できるのは私だけだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "大丈夫、何も起きないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "うーんと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "それじゃあ、今から事務所に報告して、すぐにほかのシャーマンを何人か、できれば雪祭司も呼んで、手伝ってもらえるように要請してみるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "それと、ティフォンが観測隊から戻ってきたら、そっちに向かうように伝えておくね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "直近で出発した観測隊はどこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "多分、まだ森林地帯を抜けたばかりのところにいるはず。もうすぐ山岳地帯を通って氷原入りする頃だとは思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それなら、増援依頼はお願いね。用心するに越したことはないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "うん、もう準備にかかってるところ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "じゃあ……気を付けてね、サンタラさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "まだ働いている皆にはお詫びを伝えておいて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "いいっていいって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "あれ、サンタラさんどこ行ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "彼女と一緒に働くのは初めてってわけでもないんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "サーミで起きる変なことなんて私たちにはどうしようもないし、こうやってサンタラさんに任せっきりになることくらい珍しくもないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "で、感染者の人たちは？　様子はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "偵察オペレーター",
      "text": "みんなこっちの仕事に理解を示してくれてるよ。メンタル面も落ち着いてるし、しばらくは心配なさそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ふぅ……それはなにより。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "じゃ、ちょっと手を貸して。チャパットに緊急の電報を入れなきゃいけないから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数日後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "この場所ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "あら、ここ……電波が入るのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（通信機を操作する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ううん、通信とは限らないわよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "もしかして、悪魔？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "自然が彼女に答えることはなく、そこには族樹の輪郭に似た巨大な影が彷徨っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "亡寒の族樹の影が、白昼をも彷徨い始めたというところかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "まだ攻撃性はないけれど、それに近い状態ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "厄災の兆しと見えるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "クルビア式の方法で少し試してみましょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "1234、1334、4444。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "1+1=4。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "次は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（小型の計算機を取り出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（数字を見ずにボタンを押す）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "結果は……完全に食い違っているわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "穢れを取り除かなければ、何をしたところで徒労になりそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "亡寒の祖霊たちよ、どうか私の怠慢をお許しください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "またすぐに戻って参りますので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "族樹なき今、この地は庇護などほとんど得られない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ならば……最後にもう一度、老樹に人々をお守りいただくことにしましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンタラは一本の枯れ枝を取り出した。それは老樹との最後の思い出の品だったが、彼女は自分の指に傷をつけ、そこから出た血を枯れ枝と大地に滴らせる。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "恒久なるものよ、どうかこの地に永遠の安寧を取り戻したまえ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "地面に滴り落ちた血はすぐ、清らかな水へと変じた。そうして彼女のアーツの影響を受け、瞬く間に霜となって上へと伸びていく。\n穢れなき氷霜はやがて枯れ枝を包み込み、古木の枝はそのまま大地へと植えられて、過去の人々の視線を集める。\nすると、ぼんやりとした灰色の霧が晴れていく。その代わり、植物のほうは次第に黄色く萎れていった。\n過去とは祝福でもあり、同時に呪いでもあるのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "まだ足りないわね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンタラは辺りを見渡すと、新しい族樹が根を張っていた場所に視線を落とした。\n彼女が族樹が落とした枝や若葉を拾ってみたところ、それはまだ汚染されておらず、さらには今なおサーミの原初の生命力を内に宿していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "これでいいでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "族樹の枝と老樹の枝を絡ませて、若葉をちぎって地面に撒く。\nサンタラはそれを、何かしらの象徴としたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "アルボラよ、そしてソナフェルよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "過去と今とを結び、その繋がりを築きたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "地に立ちあるいは落つる眼が、四方に向けられんことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "祖霊の父よ、世を去りし先祖よ、大地を彷徨う幾千万もの魂よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "見守りたまえ……どうか、見守りたまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "このシモーネの、サンタラの木の娘のささやかな願いを聞き届けたまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "この地の穢れを融かし、サーミに清浄をもたらさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "枝は「高木」となり、ちぎられた葉は「巡視」となった。\n通常は啓示板によって発される宣告が、シャーマンの呼びかけに応じて大地にもたらされる。\nと同時に、概念の崩壊は収まり、自然はいつも通りの活力を取り戻し始めた。\nしかし、森の縁には、今なお黒く濃い霧が漂っている場所もある。\nそれは自然にも浄化しきれぬ異物であり、サーミを蝕む数多の穢れの源でもあった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "あれは……「黒印」！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "スゥー……フゥー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "躊躇いもなく、周囲の氷雪を瞬時に鋭利な刃へと変えて、その人影に向け放つ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "何の準備もなく「皇帝の利刃」に遭遇したい者などいない。\nそれが悪魔によって異形と化した利刃とあればなおさらだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "眼前の難敵を攻撃すればするほど、その体内に巣食う悪魔を周囲にばらまいてしまう……\nかと言って何もせずにいようものなら、奴は殺戮を繰り返して大地を穢し、サーミの地を隅々にわたって踏みにじることだろう。\nサンタラの周囲は啓示によって呼び起こされた自然の祝福に守られているものの、一つ一つの攻撃がもたらすであろう災いは決して無視できない。\nこれは戦いとは呼べぬものであり――\nけれど戦いではないことが幸いした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「黒印」はよろめきながら前へと進み、攻撃の姿勢を取っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "だが、次の一歩を踏み出した瞬間、それは空間を超え、忽然とサンタラの目の前から姿を消した。\nそうして自然の浄化によって、この地の崩壊は消え去った。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "逃げられた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それとも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "何か手伝えることはあるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "今のところは大丈夫。さっきチャパットにいるオペレーターに連絡を取ってみたんだけど、ちょうど出発したばかりだった観測隊とも連携して、支援を送るって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "直近で出発した観測隊はどこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "多分、まだ森林地帯を抜けたばかりのところにいるはず。もうすぐ山岳地帯を通って氷原入りする頃だとは思うけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この場所は観測隊の現在地からそう遠くはない。そして、厄災の動向は一見無秩序に見えるが、一定の傾向は見て取れるものだ。\nたとえば……\nより多くの「生命」と「存在」を無に帰そうと動く、という傾向がそれにあたる。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "このことを早くティフォンに伝えないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "尊きサーミよ、わが無礼をどうかお許しください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンタラは自身のアーツユニットを振り上げると、力いっぱい大地に突き刺した。\nすると氷雪が彼女の願いに従って、地面に何かの図形を浮かび上がらせる。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "エンギナよ、エンギナ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "サーミよ、あなたが彼らの命運をお見守りくださっていることは存じております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "どうかこの先触れを、友のもとへと送り届けたまえ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女の言葉に従うように、氷雪でできた図形は瞬く間に消え失せ、そこには再び乾いた大地だけが残された。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "皆の安全は任せたわ、ティフォン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私も……託された責務を果たさなければ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンタラは一頭の角獣を狩ると、果物をいくらか摘み取った。\nこれは先祖たちへの供物だ。\n品数豊富とは言えないが、それでも亡寒の先祖たちを慰めるには十分だろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "父上、母上。雪祭司エイラス様、そして祖先の皆々様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私は族長の意に従い、皆様に供物を捧げるためここへ参りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "どうかこれからも一族を守り、その心を不安から守り、夢の中で導いてくださいませ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そしてどうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "皆様が忘れ去られることなく、いつまでも記憶に刻まれ続けますように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私は、心よりそう願っております。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "供物は烈火に包まれ消えていき、先祖たちの食卓へと届けられた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そうして、サンタラは一晩の間、燃え盛る炎を見つめ続け……炎が燃え尽きる頃、ようやくゆっくりと夢の中へ落ちていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "各捜索隊へ告ぐ。「黒曜石」による被害を受けたと思しき区域を発見した。近隣の人員は直ちに具体的な座標を確認し、報告後速やかに撤退せよ。該当区域には決して踏み込むな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "繰り返す――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "「黒曜石」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "「黒印」は確か、その方角からやってきたはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ウルサス人はまた何かを隠そうとしているのね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンタラは儀式と啓示の宣告を行った場所をちらりと見た。\n供物はすでに灰と化したが、枯れ枝と若枝はいまだ絡まり合ったままだ。\n彼女は少し考えてから、一握の灰を絡まった枝の根本に散らし――\nウルサス人が示した方角を目指して森を出た。\n彼女は二度と、ここへ戻ることはないだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "座標の場所はこの近辺ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "氷原の奥深くまで来てしまったけれど、ウルサス人たちは一体何を企んでいるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それにしても、この辺りは穢れがひどいわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ここが……例の場所？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "何かを覆い隠そうとするかのように、辺りには激しい吹雪が吹き荒れている。\nしかし、サンタラの命を受け、それは少しずつ晴れていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そうしてついに、隠された真相が白日の下に晒される。\nそこには、「国土」に覆われた三人の近衛兵が立っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ッ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "恐怖が一瞬にして彼女の魂を鷲掴みにした。何かが虚無から目を覚まし、こちらに視線を向けようとしているかのような感覚が走る。\nだがその時、折よく吹雪が巻き起こり、彼女をその中に匿った。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（今のは……穢れのあるなしに関わらず、この一瞬で殺されていてもおかしくなかった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（ここで一体何が起こったの？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は気持ちを整え、周囲の異常な気配が落ち着くのを待ってから吹雪の中を抜け出して、国土の境界へと近付いた。\nその中心には、なおも微動だにしない三人の近衛兵がいた。\n今度は、その光景がはっきりと見て取れた。\n彼らは全員、ウルサスの軍刀で心臓を貫かれていた。\n恐らくは何らかのアーツか、呪術によるものだろう。\nいずれにせよ、彼らの遺体は倒れこんでいることもなければ、悪魔に利用された様子もない。\nただ死の直前と同じ姿勢を保ったまま、国土に呑み込まれている。\nサンタラはふと、どうやら彼らが命を終える前、四人で背中を預け合うように立っていたらしいことに気付いた。\nだが、本来四人目がいたであろう雪の上には、ウルサスの軍刀だけが突き刺さっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "「黒印」……あなたはここからやってきたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウルサス人がどれほどの偉業を成そうとも、彼らの悪行がなかったことになるわけではない。\nだが、この英雄たちが命を賭して成そうとしたことは、一人のサーミ人の心を動かすに値するものだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（サーミはただ、あなたたちの安らかな眠りを守るために、この地を吹雪で覆い隠してくださっていたのね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（勇士たちよ、あなたたちに敬意を表するわ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（ほかのウルサス人たちはここからそう遠くない場所にいる……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（あなたたちが無事に故郷へ戻れるように、私が吹雪を止ませておきましょう。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "だがその時、彼女の心の中には大きな憂いも生じていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（ウルサスの戦争兵器が集団で行動しても、こんな最期を迎えることになるなんて……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（エイクティルニル……サーミの部族を分断して、先の見えない遠征にサーミフィヨドの命と未来を賭けたあなたは、それが失敗に終わった時のことを一度でも考えているのかしら？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（サーミがあなたをお許しになった以上、私も干渉はしないけれど……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（私もサーミの一部だもの。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "（私は私のやり方で、南から来た仲間たちと一緒に、サーミのためにより良い未来を勝ち取ってみせるわ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "祖霊の父よ、どうかわが決意の証人となりたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "吹雪よ、共に往きましょう。英雄たちのことは、彼らの従者に任せるべきよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "来世では、祖霊の枝葉の間からあなたたちに美酒を捧げましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "さようなら、ウルサスから来た魂よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女が吹雪に消えていくと、吹雪もまた共に消えていった。\nその後まもなく、氷原にウルサスの角笛が鳴り響いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二週間後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ただいま、今戻ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "さ、サンタラさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ど、どうしたの？　そんなに慌てて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "一体どこに行ってたの！？　あとちょっと遅かったら、あなたが任務中に失踪したって本艦に報告するところだったんだからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "こうしてちゃんと戻ってきたじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あなたが色々大変な事情を抱えてるのはわかるけど、次はこんなに心配させないでよ！　もし本当にあなたがいなくなっちゃったら、残されたみんなはどうすればいいっていうの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "はいはい、私が悪かったわ。本当にごめんなさいね、フィー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ごめんなさいで済むと思ったら大間違いだからね……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "じゃあ、お詫びに角獣のローストを作ってあげるわ。それでどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "角獣のロースト！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "赦してもらえないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ふん……そこまで言うなら、今回は赦してあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ありがとう、フィー。あなたは本当に頼れる友達だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "そ、そんなにおだてても何も出ないからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そういえば、観測隊は戻ってきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あっ……そっか、まだ知らないよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "なんか、氷原入りを前にしてちょっとトラブルがあったらしいよ。ウルサス軍人のお化けみたいな怖い奴に出くわしたんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "まあ幸い、ティフォンが事前に備えをしてくれてたから、みんな無事に撤退できたけど。仮に死傷者が出てたら大変な騒ぎになってただろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そうだったのね。無事で何よりだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それじゃあ、南へ移動していった部族のほうはどうなったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "南で住むところを見つけたって。感染者の人たちは、部族に残って暮らす人もいれば、ロドスのサーミ事務所で治療を受けるって人もいる感じ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そう、悪くない状況ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "となると、もう心配事はなさそうかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あっ、もしかしてまたどこかに行くつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "いいえ。戻ってひと眠りするだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "おお、やっと休むことを覚えてくれたわけね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "明日にはマゼランとティフォンに会いに、チャパットへ行くつもりだけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "結局どこかには行くんじゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "サーミのシャーマンとして……あるいはロドスのオペレーターとしての責務を果たしているだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あーあ、もし私がそんなふうにバリバリ働いたりしたら、一ヶ月しないうちに医療部送りになりそうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "仕事は確かに大事だけど、ちゃんと休みも取ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ここで少し休めるだけでも私にとっては十分よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "だめだめ、睡眠はしっかり取らないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "明日のことは明日考えればいいんだしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ほら、もう行った行った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ええと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それじゃ、少し休ませてもらおうかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ありがとう、フィー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "いい夢見なよ、サンタラさん。おやすみ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ええ、おやすみなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
