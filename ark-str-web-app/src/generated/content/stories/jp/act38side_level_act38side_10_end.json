  "sourceHash": "975f18dccff875fcbb4fa7c6bb3ce052458708ce45295207f9b4436af8dd71c3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "マフィアA&B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドライバーA&B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "*シラクーザスラング*！　ま、まだ命令してないでしょ！　どうして引き金を引いたの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "俺じゃない。こっちは今安全装置を外したばっかりだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "向こうのドライバー連中でもないらしいな。あいつら、全員ビビってるし、誰か怪我してないか確かめてるみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "武器が暴発したのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "いや、怪我人は出てない――だが、それなら銃声はどこから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "というか、急に銃声が聞こえたせいで、わからなくなってきた……こ、これからどうすればいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "フロート車が……先頭のフロート車が見えてきてるわ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "……なあ、あんたたち。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=2>3分前</>"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ごほ、ごほっ……ぐっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あと、200メートル……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "イングリッドさん……あなたは、相変わらず……腕がいい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "ッ……確かに、少しずつ……血が流れ出るのを、感じる……だが、それなら……私にはまだ、時間がある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "この路地を出て……広場にさえ、戻れば……状況は、掌握できる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "我々は、裁判所を……港を、占拠したんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "私は死ぬだろう……ごほっ、だが、その前に……裁判官の席に腰かけ、最後の命令を……下そう。このバカらしい試験場に、がは、ごほっ……判決を……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アントニオは壁伝いに、必死で身体を支えながら、よろよろと歩いていく。\n路地はとても暗く、今の彼が歩くには難しい場所だった。\nアントニオは不思議と昔のことを思い出した。当時、彼はシンガス政府から逃げ出した遊撃隊を率いて、夜闇に紛れてジャングルを抜け、ボリバルから逃げ出したのだ。\n彼はあの飲んだくれの貴族がリストに雑に描いた円と、その首が遊撃隊の人々の手で斬り落とされたときのことを思った。\nそして、イングリッドを、ヴェネツィアを、レオントゥッツォを、アルベルトを、ミズ・シチリアを……彼の嫌う人々のことを思い描いた。\n彼らの手からすべてを奪い、全員の名に大きくバツをつけてやれたら。"
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "まだ、終わりじゃない……まだ、まだ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は突然そこで止まった。\n冷たい感覚――額に銃口を押し付けられたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "あ、アントニオ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "カール？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "あなたのことは追い出したはず――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "な、なんで俺が追い出されなきゃならないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "お前に一体何の資格があって、そんなことをするって言うんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "どんなに耳や尻尾を撫でつけて狼の真似をしたところで、お前はドンに育ててもらった番犬でしかないってのに！　この――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "私を、殺す気ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "あなたが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "そんな震えた手で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アントニオ",
      "text": "私が何と戦い、何を成し遂げてきたか知っているんですか？　あなたのような、何の取り柄もない間抜けな狼に――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "倒れこむその人物を、カールはぼんやりと見つめていた。アントニオの最期の表情は、これまで見たこともないほどの怒りに満ちたものだった。\nカールは、相手に残った生気を奪い去ったのは銃弾ではなく、自分が彼を殺したという事実であるような錯覚さえ覚えた。\nアントニオの身体の下、路面の模様を伝って血があふれ広がっていく。それは巨大なバツ印に見えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "なあ、あんたたち。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "エイレーネ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "大丈夫だから、見てろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "全員が見つめる中、エイレーネはドライバーの列を離れると前へ二歩進み、道の中央に立った。\n彼女は臨戦態勢のマフィアたちを前にして、深く息を吐くと、握っていたクロスボウをゆっくりと置いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "何のつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "向こうを見ろ。先頭のフロート車はすぐそこの交差点を曲がったところだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "パレードが辿り着いたのに、本気で十数万人のヌオバ・ウォルシーニ市民の前で死ぬまでやり合うつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "あんたらの計画が何であろうと、もう間に合わない。そうだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "武器を下ろせと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "バカにしてるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "あたしらはそうしたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "「陸上艦の上にいる白い狼が、この武器を広場にばらまいたから、あたしたちはパレードの通行を妨げないようにそれをさっさと拾い上げた。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "これが事の顛末だって、あんたらはこのドライバー連中のために証言できるよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "同じようにこっちも、あんたらのために証言してやれるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "今日はカルネヴァーレだってことを思い出せ。一緒に市民を歓迎しようじゃないか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "早く乗れ、カール。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "パレードがもう来てるんだ。あまり長く交差点で停めるわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それと、運転席にカルネヴァーレのマスクがあるからそれを被れ……顔に血がついているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "っ、ドン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "車を出せ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "車はゆっくりと動き出し、お祭り騒ぎの群衆がその後ろを通り過ぎていく。\nきらびやかな照明に、次々と聞こえる音楽と歓声。祝典は四、五時間続いていたが、ヌオバ・ウォルシーニ人の熱意は少しも衰えていなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "開拓区からヌオバ・ウォルシーニのほぼすべての重要ブロックを通過して、パレードは間もなく今夜のゴールへと辿り着こうとしており、そんなときに逆方向へ向かう車に注意を払う者はいなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "申し訳ありません、ドン……お、俺は任務をこなせませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "アントニオに追い出されたあと、あなたがチャンスを下さったのに……秘密裏に奴を殺すという任務を、俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "仮にイングリッドが俺より先に重傷を負わせていなければ、恐らくは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "いいや、違う。アントニオはお前の手にかかって死んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ファミリーの正式な構成員を処分する時には、ドンの指示を仰がねばならん。そうでなくとも、ほかの幹部に知らせて利害関係を明確にすべきだというのが、シラクーザの昔からのルールだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "イングリッドのやり方は適切ではなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "ドン、アントニオは死にました……あの人は、あなたの義理の息子で、ファミリーにとっては――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ヌオバ・ウォルシーニには自らのルールがあり、ヴェネツィアファミリーにも自らのルールがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "いずれにせよ、アントンは過ちを犯したんだ。早いうちにベラの供ができたことは、慈悲深い罰と言えるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "それに、あいつの死は無価値というわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "では、この後はどうします？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "家に帰って、部屋を掃除するとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "明日の朝一番に、シティホールと裁判所の人間にヴェネツィアファミリーから誠意を見せ、それで腰を据えて私と話をしてもらえるよう願おうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "そのためにも、今夜はまだやるべきことがたくさんあるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通行人A",
      "text": "遅れるな！　裁判所広場はこの先だし、いい場所を取らないとな。前のフロート車を追い抜いて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人B",
      "text": "だからって押さないでよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "客引きするカメラマン",
      "text": "あれ、そこの君、ついていかないのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナカブ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客引きするカメラマン",
      "text": "街中が華やかな服やマスクで着飾った人で溢れかえってるのに、君の素朴なファッションはかえって目を引くね。すごい工夫だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客引きするカメラマン",
      "text": "記念に写真を撮ってあげようか？　住所を教えてくれたら、何日か後にレタッチした写真を送るからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客引きするカメラマン",
      "text": "えーっと、聞いてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナカブ",
      "text": "アンニェーゼ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナカブ",
      "text": "アンニェーゼ、どうして話してくれないのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナカブ",
      "text": "ずっとルナカブのそばにいたのに……どこにいるのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナカブ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ループスの少女の目つきが変わった。\nカメラマンが通りの反対側を見やれば、絶え間なく流れゆくフロート車と群衆の向こう、赤い服が目を引いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナカブ",
      "text": "罠か？　なぜお前も――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエ、気が散っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "アンニェーゼというやつ、オマエのオバアサンか？　オマエも、オバアサン見つからないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナカブ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "残りは、オマエだけ。オマエ、最後の真狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエを殺せば、答えが見つかる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "ええ、私よ、レッド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、レッド、勝った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "もちろん、ちゃんと見ていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "今の戦いのすべてをね。アンニェーゼの牙の居場所を突き止めるやり方も、罠の仕掛け方と誘い方も、一撃で仕留める手際も。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、見てた？　オバアサンの目、もう良くなった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "じゃあ、オバアサンの腕、生えてきた？　心臓も、元通り？　どうして……レッドにはまだ、オバアサンが、はっきり見えない？　どうして、オバアサンに近づけない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "そうでも言わないと、こんなに狩りを頑張らなかったでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "レッドはようやく、最後の真狼を殺し、おばあさんのために退屈な勝利を勝ち取ってくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "さてと、おばあさんは新しい子を探しに行くとするわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、レッドを騙した？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "どうして？　レッド、わからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "煩わしいわねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "言い方を変えましょう。そのほうが、この先どうすべきか理解できるかもしれないものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "レッド、あなたはこれまであなたに殺されてきた連中と同じなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "あなたはウルフハンターであり、真狼でもあるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "text": "真狼はまだ滅びてはいない。オバアサンは今も救いを得てはいないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "（拍手をする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "いやあ、あの人たちすっごく息ぴったりだったね。キミもそう思わない？　テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "たった数分でこれだけの武器をトラックの荷台に隠して、肩を並べてパレードを出迎えるなんて、まるでリハーサルでもしてたみたいだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "この人たちはついさっきまで武器を向け合ってたんだ、なんて言っても誰も信じないだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アハハハッ、今回もキミの勝ちだ、テキサス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミって本当に運が良いね。正義と良識は、またしてもキミの味方をしたわけだ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "テキサスは何も答えなかった。白い狼は一層大きな拍手を送っており、その顔につけられたマスクはインクのように黒かった。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いや、それよりも気になるのは、どうして急にマスクをしているのかということなんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "カルネヴァーレではみんなこれを付けないといけないんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "テキサスったら、キミの勝ちなのにどうしてもっと嬉しそうにしないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "見て、パレードが続々と広場に入っていくよ。さっき起きてた出来事は全部ちょっとしたハプニングで、恐ろしい動乱に発展することはなかった。まさにめでたしめでたしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "それともキミは、思わずこんなふうに思っちゃうのかな……「この結果に落ち着いたのは、さっき突然鳴った銃声が群狼の一匹を冷静にさせたからでしかない。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "「そして、いわゆるカルネヴァーレというものは、泥沼の上にそのまま敷かれたレッドカーペットとなった。」……とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "何が言いたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "今夜起きたことはすべて、これまでシラクーザで起きてきた内乱とは異なるものだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……ファミリーの縄張り争いというバカバカしい演目のために、死に追いやられかけた一般人が増えただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "その言い方は……まあ正しいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "でも、彼らのパフォーマンスには本当に目を見張るものがあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "特に裁判所で見たあのドライバーさんは、一人で色々なことを悟ったみたいだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ヌオバ・ウォルシーニは、日照りや洪水に晒されても豊作が見込めるブドウ畑なんかじゃない。良い種を蒔けばみずみずしい果実を収穫できる、なんて保証はないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "忘れたのかい？　ここはまだシラクーザであって……泥沼の中にあるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "泥水の中でもがいているのはファミリーの奴らだけじゃない。泥沼の魔力を甘く見ちゃいけないよ。この場所は誰のことでも悪い狼に変えちゃうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そしてそれは、ある種の本能をシラクーザ人の遺伝子に刻み込んだのさ。新しい地盤のすべてを、同じ泥沼に変えてしまうという本能をね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "このサイクル、これぞシラクーザだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だから、ここから逃れる方法や改善する方法を考えるよりも、泥沼を愉快に泳ぐことを学ぶのが一番だ。そうじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "これはボクのお父様や、ミズ・シチリア……そしてキミと、キミたち全員が教えてくれた道理なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ファミリー以外の秩序を実現できるか、それを検証するために、レオントゥッツォとラヴィニアのやり方には少し焦りすぎた部分もあるかもしれない……彼らの道のりはまだ遠い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だが、これこそがヌオバ・ウォルシーニの意義であり……一つの可能性を示している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それにしても、お前はその的を射た意見を言うためだけに、こんな真似をしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "本当にシラクーザの未来にそこまで関心があるというのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アハハッ、さすがだね。ボクがしたい質問をキミのほうからしてくるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけど、そうでなきゃどうしてボクの招待状を受け取るなり、龍門から駆け付けてきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "わかった、きっとこう言いたいんだね――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "白い狼は不意に言葉を止め、それから咳払いをすると、テキサスの口調を真似て話し始めた。\n起伏はないが、感情が込められた声色で。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "コホン――「単なる物流会社の配達員である私には、その手の偉大な理想や崇高な信念は無関係だ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "「私はただ友人のことが気がかりで、純粋な良識を持っていて、見過ごせないものがあるだけのこと……ウォルシーニの時もそうだった……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ああテキサス、ボクたちが初めて会った時のことは忘れられないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミはおじいさんのサルヴァトーレの手を握って、移動式プラットフォームの縁に立ち、ブドウの木を剪定しているうちの労働者を眺めていた。あの時のキミは、シラクーザに来たばかりだったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミのおじいさんとボクのお父様は、乱れていくクルビア情勢や、シラクーザの今後の天気、今年の収穫、そしてキミがしばらくうちに住むことについて話し合っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あの頃のキミの目は本当に輝いてた。今よりもずっと面白い表情を見せてくれたりもしたし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あれはお前の摘んできたブドウが酸っぱかったからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "テキサス。今夜は広場の全員がマスクをしているけど、キミがつけているものが一番特別だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミほど冷静な人はいない。だって、誰よりも早くこの泥沼の本質を理解して、ここから逃れようとしたんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけどそんなに冷静でいるのは、前提としてキミが失望していたからだ。キミはかつて、この泥沼に大きな期待を抱いていたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ボクの発言が的を射た意見かどうかはさておき――アハハッ、キミは*シラクーザスラング*なくらい、正真正銘の理想主義者だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "否定はしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あるいは、そうであろうとなかろうと、関係はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "結局、私がやることは同じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "はぁ、本当に「テキサス」らしい答えだね。模範的すぎて少し退屈なくらいだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な通行人",
      "text": "あれは――陸上艦か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な通行人",
      "text": "シティホールがわざわざステージの一環として用意したのか？　こんな大掛かりなことをするなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する通行人",
      "text": "なあ、甲板にいるのってさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する通行人",
      "text": "テキサスファミリーの生き残り、「最後のテキサス」じゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な通行人",
      "text": "それっぽいな。ウォルシーニの裁判所で見たことあるんだ――それで、向かいにいるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する通行人",
      "text": "ラップランド？　八年前、サルッツォのドンに名字を剥奪された白い狼か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な通行人",
      "text": "どうしてあの二人がカルネヴァーレに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する通行人",
      "text": "シティホールが招いた特別ゲストだとか？　ほら、カルネヴァーレのフィナーレを飾るために、二つのファミリーの代表者として呼んだとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する通行人",
      "text": "レオントゥッツォさんの宣伝映画よりも説得力があるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な通行人",
      "text": "な！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ラップランドはマスクを外すと、テキサスに差し出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "どういうつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "負けを認めるってことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "昔のルールでは、カルネヴァーレ当日は色んなファミリーの人間たちがマスクを被って殺し合い、最後まで生き残った狼が敗者のマスクを剥いでやるのがお決まりだったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけど、この新都市においては、この行為にも新しい意味づけをすべきだよね……んー、たとえば新しい人生の始まりを意味しているとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "実は、さっきの質問にはどう答えてもらっても別に構わなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だって、シラクーザは誰にでもマスクを被せるものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ボクたちは今や、カルネヴァーレのフィナーレの一部になったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミがどんな目的でここに立っていようと、今この瞬間キミはシラクーザの一部を――新しい、あるいは壊れて捨てなきゃならない部分を代表する存在なんだよ。アハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ファミリーの構成員とトラックドライバーも、シティホールの職員と裁判所の裁判官も、広場にいるシラクーザ人全員が、自分の望む意味をボクたちに割り当てているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "もちろんキミは、今すぐ身をひるがえしてここを去ってもいいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ほらほら、ぼーっとしてないでさ。数十万人のヌオバ・ウォルシーニ市民がこっちを見てるんだから！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "沈黙が落ちる。\nテキサスは、目の前にいるこの上ないほどよく知る友人、あるいは敵を見つめ……しばらくして、手を伸ばした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まるで幾度もリハーサルをしていたかのように、十数台の獣をかたどったフロート車が裁判所広場に収まり、狂喜する群衆が波の如く押し寄せてくる。\n音楽と歓声が段々と大きくなり、照明がきらめき、その瞬間、空を覆うほどの花火が打ち上げられて、陸上艦という舞台に立つ二人に華を添える。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "聞こえるかい？　彼らはどうしてもこの夜を盛り上げたいみたいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "みんなキミとボクに、この新都市に、この先の新しい人生に歓声を上げているのさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前は相変わらず、歯の浮くようなことを言うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "フフッ、褒めすぎだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だが私は、この演目の一部となることを厭わない。彼らが今私の身に見出している「意味」も拒絶はしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "失望の前提にあるのは期待だ。クルビアであれシラクーザであれ、私は確かに、泥沼の中にありながら真の活気にあふれる都市を見たいと願っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それを築き上げることが私の想像よりもはるかに困難で複雑なことだと言うのなら、私はもはやそれを避けずに、友人たちと共に立ち向かおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ハハッ、決めたよ。最後の最後に、もう一度だけキミのため、シラクーザのために、厄介ごとを片付けてあげよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あのバカな狼たちを荒野に連れ戻して、彼らのくだらないゲームがシラクーザに影響を与えないようにしてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "お礼はいらないよ。だけどそうして、数々の障害が取り除かれた先で、彼らは、ううん、キミたちはこの泥沼をどんな姿に変えることができるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "テキサス、急に聞きたくなっちゃったんだけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ボクがヌオバ・ウォルシーニに来たのがキミのためじゃなかったこと、がっかりした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アハハ、これまた模範的な「テキサス」らしい答えだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "それじゃ、ボクらのショーの成功を祝おうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "テキサスがマスクを受け取る。\nすると、白い狼は手を離した。そうして何の前触れも、何の未練もなく、身をひるがえして陸上艦の奥へと歩いていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "――テキサス。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "この先、キミがボクに楽しみをもたらしてくれることはもうないんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=2>1100年11月9日 p.m. 11:57</>"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "陸上艦に、サルッツォの白い狼とテキサス、それとドライバー互助会か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "どうやら、色々とショーを見逃したらしいな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "れ、レオントゥッツォさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "久しぶりだな、エイレーネ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "カルネヴァーレが終わり次第、一度話し合う場を設けよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイレーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "どうぞ、レオントゥッツォ市長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "あの二人のショーは終わった。カルネヴァーレ閉幕のスピーチといこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ここまで送ってくれたことに感謝する。それと、最後まで満足のいく回答をしてやれずすまない、ディーマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "お前はいつからそんな無駄話をするようになったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……それもそうだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……皆さん、こんばんは。レオントゥッツォだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ご覧の通り、多少怪我は負っているが、どうかご心配なく。大した支障は出ていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "実は、先ほどまでパレードの中に身を置いていた。皆さんと共に裁判所広場まで歩き、我々が共に生活するこの都市のありようを身を以て体験していた次第だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ゆえにラップランドさんとテキサスさん、両名がフィナーレを飾ったショーの素晴らしさは言うまでもなく、私が話したところで蛇足ではあるだろうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それでも皆さんと会い、話をして、共にこの夜を過ごしたいと思ったんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "この一年、ヌオバ・ウォルシーニは多くの変化を遂げてきた……たとえば、シラクーザ最大の物流港であるヌオバ・ウォルシーニ港の建設がそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それがもたらす繋がりの一つ一つが、巨大な心臓を動かす脈動の如く、健康的で旺盛な生命力を示している。その力は、何千という企業と数十万人の市民生活を支えうるだけのものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "我々はこの国で初となる警察学校と、まったく新しい法律を持ち、今ではますます多くの人間が「ヌオバ・ウォルシーニ人」という呼び名にアイデンティティを感じるようになってきた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "私はそれに心から喜びを感じるとともに、より大きくなった不安も覚えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "というのは、この新都市には今も、無視できない問題が多く存在しているからだ。たとえば、市民ポイントの認証体制には不便な点が残っており、すべてのケースをカバーできるわけではないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "別の例で言うと、『新都市管理法』の特殊性から、事件がほかの都市の管轄であった場合には、裁判所の十分な支援を得ることが難しい場合もある……といった具合だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "一年という時間はあまりにも短く、シティホールと裁判所の成すべきことはまだたくさん残されている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そこで、皆さんに問いたい――ヌオバ・ウォルシーニをどう思っているのかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そして、ウォルシーニ、シチリア、モンテルーペといったシラクーザのほかの都市の人々に、彼らがヌオバ・ウォルシーニをどう思うかを問いたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ひいては隣のリターニアや、はるか遠くのウルサスに至るまで……この大地で変革を遂げているすべての国家が、この若き都市をどう見るかを知りたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "彼らは我々を新たな可能性として見てくれるだろうか？　暴力にしがみつく存在ではなく、より揺るぎなく、強く、団結力を持った、対話に値する存在として見てくれるだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "彼らは、我々の力がその何よりも切実な渇望から来ていることに気付くだろうか？　我々は、ここにいる自分とほかの人々が、ようやく手にした新しい人生を守れるようにと渇望しており――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "事実としてこの一年、それを実現するため、必死に努力を重ねてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "「ヌオバ・ウォルシーニにファミリーは存在しない。」この言葉は決まり文句となった。そして、それに関わるすべての改革が、シラクーザ人の慣れ親しんだ「シラクーザ式」の手法――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "秘密の交渉や、雨夜の暗殺、都市全体を巻き込む粛清、ファミリー間の殺し合いのいずれにも依存していない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ここで起きたこと、そしてこの先起こることのすべてに、対応の根拠となる法律や、検討の参考となる規則がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……我々は、新しい人生に確かな秩序を与えたんだ。シラクーザ人が慣れ親しんだ泥沼は、もはや以前のように我々を容易く揺さぶることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "かつて私は、ある友人から「お前が行くのはイバラの道だ」と言われたことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "確かに彼の言う通りだが――我々がぶつかる問題はすべて、「ヌオバ・ウォルシーニ人」が前進し続けるべきだということを証明している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "この一年で傷ついた人に、そして今後この道で傷つくこともあるであろうすべての人に詫びたい。しかし、それと同時に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ヌオバ・ウォルシーニに今も願いを託してくれる友人を、これからも招待していきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "私は、皆さんと共にイバラを踏み越え、この新しく唯一無二である都市を少しずつ良くしていこう。この都市が、一つの時代を牽引できるようになるまで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "事実としてシラクーザの新時代は、無限の可能性に満ちた未来は、すでに始まっているんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ディミトリは黙って前を見ていた。無数のライトが、レオントゥッツォのシルエットを浮かび上がらせ、その後ろ姿をより鮮明に見せる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "俺にはもう、言えることなんざなさそうだな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "サルッツォのワインは確かに美味いが、やっぱり自分で作ったカクテルのほうが好みに合うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "ベッローネは、俺のやり方で、お前のルールに従ってこの都市に入る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "これが、俺からお前にしてやれる約束だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ディミトリは身をひるがえした。\n市長の演説はまだ続いていたが、彼は望んでいた答えをもう得ていた。ディミトリは、送られた招待状を――あるいは、今後長きにわたる闘争への挑戦状を受け取ることにしたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "皆さん、どうかこの夜を楽しんでくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……新しい日は、もうやってきているんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
