  "sourceHash": "63222d41afc61f782a95f2f06ebb43b784dbe397cff2fcd27bc2cf644b2e7bd0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "見ろ、ミーシャ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "う、うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "これが、トリガーだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "こうやって弾を込めて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "狙いを定めたら、トリガーを引く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "そうすれば、弾が飛び出していくから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "次は、グリップを握って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "精神を集中させたら……アーツを放つんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "そうすれば、飛んでいった弾薬が爆発する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……私に、できるのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "できるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "お前には、俺と似た力を感じるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "さあ、想像してみてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "この源石を握って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "っ、う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "集中しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "ちょっとだけ……手のひらが、熱いような。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "よし、その調子だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ミーシャ、やっぱりお前は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "っはは、そうだ……そうだよな。はは、はははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だって、お前は俺の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――スカルシュレッダー！　ここを離れよう、撤退だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "この場所には、もういられそうもない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ッ、何が起きた！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ロドスが襲撃してきたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――なっ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "あのクソ野郎どもが……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "慌てず立て直せ、反撃に出るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "っ、スカルシュレッダー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "ロドスが相手なんだったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――奴らと話し合えって言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "だって、あの人たちは絶対感染者の助けになってくれるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "俺の仲間は何人もロドスに殺されたんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "あいつらは全員感染者だったのに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ロドスは、皆を助けたりなんかしなかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "なのにお前は、そんな連中と話し合えって言うのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "一体……何がそんなにお前の目を曇らせてるんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "そ……そんなこと、言われても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……悪い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "つい、腹が立って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だけど、本当に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "感染者にはようやく、レユニオンという希望の光が訪れようとしているところなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "それなのに、ロドスは……あの連中は、自分たちだって感染者のくせに、俺たちを傷つけて、殺そうとまでしてくるんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "どう考えても、奴らは裏切り者じゃないか……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "そんな奴らと何を話せって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……でも……感染者同士で殺し合う必要なんて、どこにあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だったら、どうしろって言うんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "仲間が死んでいくのを、黙って見過ごせばいいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……心配するな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "俺たちが、お前を守るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "お前は、戦いに巻き込まれないように……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "自分をしっかり守ってくれたらそれでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……気をつけろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "あなたこそ……絶対、戻ってきてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "やっと会えたんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "もちろん。必ず戻ってくるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だからその時は、一緒に帰ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ハア～イ、ごきげんよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もしかして、あたしの助けが必要かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "実は……今の状況が、タルラの予想とは少し変わってきてる気がするんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "思ったより敵が手強くてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だから、お前には何があってもミーシャを守ってもらう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "守る？　あたしにそんな義務ないと思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "いいや、ある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "OK、OK……わかったわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど、ミーシャを守るだけじゃ足りないわよねえ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたたちがしくじったら、あいつらは絶対追いついてくるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "何か、考えでもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あら、前にも教えてあげたと思うけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……それなら覚えてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――Dr.{@nickname}……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "あいつを始末すれば、戦況は一気に逆転する……そうだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ご名答～。簡単な話でしょ？　向こうの指揮官を殺すだけだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――いつもウサギちゃんのすぐそばにいる、フードを被った誰かさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "戦場でのロドスは、すべてがその指揮下にある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "つまり、あいつさえ殺しちゃえば……あはっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ロドスのブレインは死んだも同然よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そうなったら、何もかもが楽になるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "とはいえ、こっちは人手も減っちゃったし、使える戦術にも限りがあるしで……やるとしたら、そうねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "採掘場の近くに、待ち伏せに持ってこいの場所があるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "うちの術師に援護させるから――やることはわかってるわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "連中の誘導は部下にやらせるし、あんたは心配しなくていいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だから、チャンスをきっちり生かしてちょうだいねえ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――ミーシャのこと、頼んだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "はいはい、任されてあげますとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それじゃ……幸運を、な～んてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
