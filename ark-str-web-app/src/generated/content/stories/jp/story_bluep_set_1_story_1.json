{
  "server": "jp",
  "storyId": "story_bluep_set_1_story_1",
  "groupId": "story_bluep_set_1",
  "stageId": null,
  "title": "遥か遠く",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_bluep_1_1.txt",
  "sourceHash": "31dea0e1e556720cee2b3bda2b7c9639905ea279b4077968ab1a00783f6f8c92",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "あとどれくらいかかるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "焦らないでくださいませ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "だって、本当にいい香りですもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "生地がオーブンの中で徐々に黄金色に染まっていき、ゆっくりと膨らんで、最終的にふわふわのケーキへ変わるこの瞬間を見守る。それこそが、スイーツ作りにおいて至高の時なのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "想像こそが究極の美味ですわよ、グラウ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "私は直接舌で味わえる美味しさの方がいいんですけどね。それで、今日のケーキはどんな味なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "新しいレシピですわ。生クリームに数種類のベリーで作ったジャムを混ぜた、トロピカルなお味ですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "うわっ、相変わらず凶悪な色のジャムですね……ファッションセンスは良いのに、どうしてスイーツになるとこんな壊滅的になってしまうんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "え？　鮮やかな色合いは食欲を促進すると聞いたのですけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "きっとアズリウスさんの鮮やかさへの定義は、通常の人とは少し違うのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "そうは言っても、結局グラウが完食してくれるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "それは美味しいからですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "スイーツ好きと自負している人たちが、こんな美味しいものを見過ごしていたなんて、本当に残念です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "全員、あなたのような体質を持っているわけではないのですわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "でもケーキに毒なんて入れてないじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "はぁ……この時間帯の休憩室なら、いつもはもっと騒がしいはずなのに、私たちが入ってきてから、どんどん人が減ってるような気がします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "そう言わないで。ロドスの皆様は私を仲間外れにしているわけではないですし、私もここで楽しく過ごせていますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ただ「毒物」と上手に付き合う一番のコツは敬遠すること。私も皆様も、それをよく理解しているだけの話ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ポジティブに考えれば、休憩室を独り占めできるチャンスなんて、滅多にありませんわよ。外勤に向かう前の貴重な時間を、目一杯楽しみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "サルゴンの荒野じゃ、ゆっくりとケーキを楽しむ余裕なんてないですしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "任務が順調に終わるといいですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "そう他人事のように言わないでください。アズリウスさんだって遊撃隊の隊長なんですから。セーフハウスを建てるだけの簡単な任務とはいえ、軽く見てはいけませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "あそこは、人っ気のない場所のようですし、何が起こるか分かりません。えっと、何て名前でしたっけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ケルトウェンですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "そうそう、ケルトウェン。アズリウスさんは行ったことがあるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "うーん、じゃあ後でケーキを食べながら、一緒に任務の資料でも見ましょうか。まずは補給地点の確認と……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "あっ、焼けたみたいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あとはクリームを塗れば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "アドナキエル！ またあたしに黙ってケーキ焼いてるー！　あ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "アンブリエルさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "ごめん！　ケーキの香りがしたから、てっきり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "アンブリエルさんもどうですか？　焼きたてですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "いやー、あたしは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "（ゴクリ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "アズリウスの手作りねー……チャレンジ性ありまくりじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "よければ召し上がってくださいまし。お茶もありますわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "まっ、ちょうど時間を持て余してるし……ここでゆっくりするのもアリかなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "このケーキに関しては、ちょっと心の準備をさせてねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "アンブリエルさん、無理して食べる必要はありませんわ。毒が心配なのでしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "いや、そうじゃなくてさー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "なんか、ジャムの色がさ、アレだから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "ふぅー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "どう？　美味しいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "前にグムからアズリウスの料理の腕について聞かされたけど、これは想像以上だわ。こんなもん出されたら、ラテラーノのスイーツ屋の半分は潰れると思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あいつらはさ、バカみたいに砂糖を大量に入れるだけで、味のバランスってものを全然分かってないんだよね。スイーツは甘ったるくすればいいってもんじゃないっつーの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "……ラテラーノ人のアンブリエルさんにお褒めいただけるなんて、光栄ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "もっともっと威張ってもいいくらいだよ。スイーツ専門家のあたしからの誉め言葉はすっごく価値があるんだからさー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "はぁ……みんなもアンブリエルさんみたいに、アズリウスさんの手作りを試してくれればいいのに。こんなに美味しいケーキをいつも独り占めだなんて、ちょっと罪悪感を感じちゃいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あたしは美味しいスイーツのためなら、命を懸けられるタイプだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "……やっぱりアンブリエルさんを、不安がらせてしまっていたのですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "心配なのでしたら、医療部に私の毒専用の解毒剤がありますわ。自分で提案するのは少し気まずいですが、もし必要ならば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あぁー、ごめんね！　そういう意味じゃないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "あっ！　気をつけてください！　バッグが！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "これって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あっ、いや、この解毒剤はちょっと前に用意しといたやつだよ。ほらさ、もうちょいしたら一緒に外勤に行くじゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "そういえば、アンブリエルさんも今回の任務の遊撃隊メンバーでしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "そうそう、あたしたち一緒に戦うわけじゃん？　だから一応念のために、ね？　ただ念のために用意しとこっかなって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "マジごめん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "いえ、謝らないでください。私自身も皆様のために解毒剤を常に用意しておりますわ。これが「毒物」としての、責任ですもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "もし私の存在が、皆様を不安にさせているのなら、申し訳が立ちませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "アズリウス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "ねぇ、ケーキもう一切れもらっていい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "アンブリエルさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "どうか無理をなさらないでください。お気持ちはうれしいですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "無理にケーキを食べるラテラーノ人なんていないよ。だから、おかわりお願い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "アンブリエルさんって、そういう一面もあったんですね。はい、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あざーす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あたしもいつかグラウコスみたいな境地に達せたらいいな。同僚を百パー信頼できるあんたを見習わなきゃねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "いや、私はただ、この人の毒が効かないだけですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "うぐっ！　ゲホゲホッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "あ、落ち着いて！　ほら、この解毒剤を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "ゲホゲホッ！　だ、大丈夫。それより、お茶を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "本当に大丈夫ですか？　これはワルファリン先生に頼んで調合していただいた、フルーツ味のものですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "本当に大丈夫だって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "プッ……アハハハハ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "アンブリエルさん、本当にありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "もし、ずっとこんな風にロドスで過ごせたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "プハァ～生き返ったー！　ん？　今なんか言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "いえ、何でもありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "では、ちょうどアンブリエルさんもいらっしゃることですし、ケーキを楽しみながら、任務の概要を確認いたしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "えー、もう仕事始めんのー？　もうちょっとダラダラしてたかったのにー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "まいっか。ケーキのお礼ってことで、残業に付き合いまーす。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ケルトウェン――サルゴンの広大な密林の中に位置する谷地。古来より、サルゴンの首長たちの直接的な支配を受けてこなかった。\nこれはロドスがセーフハウスの建築場所として、ここを選んだ主な理由の一つでもある。\nケルトウェンが、このような特殊な場所となった要因は様々だ。資料によれば、ここは資源が乏しいわけではなく、かつては自身の勢力をこの地まで広げようと試みた首長もいた。\nだが、全て失敗に終わったのである。"
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "詳細な原因については、更なる調査が必要ですが、現地のガイドによれば、原住民が関係している可能性が非常に高いとのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "そして、その原住民たちは今回の任務における最大の不確定要素でもあります。ガイドいわく、彼らはとっつきにくいわけではないのですが、非常に恐ろしい能力を持っているのだそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "情報は断片的で、発生した現象についての供述しか入手できていませんが、分析したところ、彼らの能力は恐らくある種の有毒化合物を用いたものであると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "うわぁー、メンドくさそー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "ご心配なさらなず。任務の難易度はそれほど高くはないですし、原住民の方たちにケンカを売りに行くわけでもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "アズリウスさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "何でもありませんわ。続けてくださいまし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "はい、えっと……どこまで話しましたっけ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "あっ、そうだ、その場所でセーフハウスを建てると同時に、天災観測所や臨時の医療拠点としても利用できるようにする必要があります。あとは、現地人員の配属が終われば、任務完了です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "うんうん、いつも通りの流れだねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "つまり、もしすべてが順調にいけば、数ヶ月後には本艦に戻って、またケーキを焼けるということですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "ちょっと！　「もし」とか不吉なこと言わないでよね！　なんか怖くなってきたじゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "意外とそういうのを気にするタイプなんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あと、ちょっと気になったんだけどさー、その原住民ってのは……なんの種族なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "資料に記載はありませんが、聞いた話によれば種族の特徴が明確ではないらしく――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "アヌーラですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "私と同じです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "……どうして知っているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "その原住民は私の一族だからですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ケルトウェンは、私の故郷ですの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "なっ……そんな話は聞いていませんよ！　なぜずっと黙っていたんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "特に話す必要もなかったからですわ。それに、私はイベリアで育ちましたので、そこへは一度も行ったことありませんの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ケルトウェンに関することも、おばあさまが聞かせてくれたお話の内容しか知らないですわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "それで、どんな感じのトコなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "実は……私も詳しくは知りませんの。おばあさまの話は、あまりにも美化されすぎていて、まるでおとぎ話のようでしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "私の一族たちは百年前にはもう既に、イベリアへ移住していましたのよ。「移住」という表現は少々平和すぎますわね。実際はもっと酷い状況でしたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "私たちは実験体としてイベリアに売り飛ばされたのです。不運なことに、私たち一族のアヌーラは生まれつき体に毒を宿しています。ですが、それを不幸だと思わない人もいるんですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "陰謀と毒薬ほど、相性がピッタリなものなんて存在しないと思いません？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "アズリウス、話したくないのなら、無理しなくていいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "大丈夫です。お気遣い感謝いたしますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "私自身が、実験を実際に経験したわけではありませんので。あの災厄の後、イベリアは自分たちのことで手一杯で、私たちのようなよそ者に構っている暇などなかったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "残酷な過去は、年長者が語ってくれる物語の中の出来事に過ぎないのです。ケルトウェンに至っては、その物語のプロローグでしかありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "おばあさまのお話は、毎回こんな風に始まるんです。「昔々、まだ私たちがケルトウェンに住んでいた頃……」あなたたちだって、似たような言い伝えを聞いたことがありますでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "「昔々、エーギル人がまだ海の中に住んでいた頃……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "「昔々、まだラテラーノという国が存在していなかった頃……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ウフフ、どうやら昔話や言い伝えは、皆同じような始まり方のようですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "あたしならさすがに笑えないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ケルトウェンの美しい言い伝えは、私たち一族を代々支え続けてくれていたのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "その場所はまさに楽園なのです。そこでは、誰も私たちを「毒物」という理由で恐れたりしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "人々から孤立された環境も、恐る恐る暮らす日々も、全ては一時の試練に過ぎない。ケルトウェンに帰れば、幸せな日々が戻ってくるのだと、おばあさまはいつも言っていましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "だけど、おかしなことに、おばあさまは亡くなる直前にようやく私にこっそり教えてくださったのよ。一族の最年長であるおばあさまですら、ケルトウェンで暮らしたことがないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "楽しそうに話していたあの物語は、おばあさまがどこかから聞いた話と、自分の想像を組み合わせた、ただの作り話だったんですの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "おばあさまは、ケルトウェンがどこにあるのかすら、知らなかったのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "幸いなことに、今の私たちなら分かります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "そうですわね。こんな形で知ることになるとは、予想もつかなかったですけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンブリエル",
      "text": "でもいーじゃん、故郷に帰れるなんてさ！　まー、故郷って呼べるのかはちょっとビミョーだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "経験上から言わせてもらいますが、あまり期待しすぎない方がいいですよ。言い伝えの中のケルトウェンは、現実とは大きくかけ離れている可能性が高いので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "それに、アズリウスさんだってロドスでの暮らしの方が楽しいですよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラウコス",
      "text": "アズリウスさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ、そうかもしれませんわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "けれど、もしそこでしか、私が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ドクター？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケーキの香りがしたから来てみた。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "おやつある？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アンブリエル",
          "text": "はぁー、びっくりしたー。言っとくけど、別にサボりとかじゃないから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラウコス",
          "text": "ドクター、これ、アズリウスさんが作ってくれた焼きたてのケーキなんです。いかがですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "え、それは……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "いただいてもいいかな、アズリウス？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ド、ドクターがそうおっしゃるのなら、どうぞ……解毒剤も用意してありますわ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "いや、ドクターほど特別な身分の方となれば、やっぱりケルシー先生をお呼びした方が――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（モグモグ）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "これはおいしい。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（モグモグモグモグ）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "甘酸っぱさに爽やかな香り、ナッツの食感も最高だ！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ほ、本当に大丈夫ですの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラウコス",
          "text": "今日は、私以外で二人もアズリウスさんのケーキを食べてくれましたね。新記録達成です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ええ、新記録ですわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラウコス",
          "text": "あまり難しく考えないでください、アズリウスさん。あなたはもう私たちの仲間なんですから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ありがとうございます、グラウ、アンブリエルさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "それと、ドクターも。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "もし、本当に私が……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "いえ、何でもありませんわ。今のは忘れてください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "それでは、作戦会議でまたお会いしましょう、ドクター。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アズリウス遊撃隊、任務内容は理解したかな？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ええ、問題ありませんわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ですが、やっぱり隊長を辞退させていただけないでしょうか？　私に小隊を率いる素質なんてありませんわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ご存じの通り、私の毒は皆様を傷つけてしまう恐れがありますのよ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君こそ最も適した人物だよ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "君を信じている。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "……そうなのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラウコス",
          "text": "そうですよ。頼りにしてますからね、隊長。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アンブリエル",
          "text": "それにアズリウスだって、とっくの前から解毒剤を用意してくれてたでしょ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラウコス",
          "text": "しかもリンゴ味です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "……フフッ、そうですわね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君に任せてもいいかな、アズリウス隊長？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "全力を尽くしますわ、ドクター。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グラウコス",
          "text": "それじゃあ、先に行きますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ええ、また後で。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ドクター、書類の整理を手伝いますわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "（あっ、ドクターの手に触れて……！？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ごめんなさい、ドクター！　私がうっかりしていたせいで……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ほら、行きますわよ！　医療部で消毒してもらいましょう！　い、急がないと……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "平気だよ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "これくらいの接触なら問題ないことは確認済みだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ですが！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アズリウス、気にしすぎだよ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "……わ、私は「毒物」なのですよ。私との接触は、いかなる場合でも害を及ぼすリスクが……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君はロドスの一員だ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "私なんかがなれるのでしょうか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "もちろん。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "では、ドクターの手元にある書類から、申請書を一枚取り下げてもよろしいでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "今回の任務が終わったら、ケルトウェンに建てたセーフハウスの駐在オペレーターにしていただこうと、少し前に異動申請を出していたのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "幼い頃、祖母から故郷のケルトウェンだけが、「毒物」としての重荷を背負わずに暮らせる唯一の場所だと教わり、私もずっとそう信じておりました……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "だけれど、自分が何者なのかを決められるのは自分だけ……そうですわよね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "私はロドスの一員ですわ。そして、ここでの暮らしが大好きです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ですから、誰かに見られてしまう前に、その申請書をこっそり回収させてくださいませ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "ドクター、それともう一つ、ちょっとしたお願いがあるのですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アズリウス",
          "text": "またスイーツの新レシピを思いついたのです。もしこの後お時間があるようでしたら、是非試食にいらしませんか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
