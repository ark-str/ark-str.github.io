{
  "server": "jp",
  "storyId": "story_12fce_set_1_story_1",
  "groupId": "story_12fce_set_1",
  "stageId": null,
  "title": "ある選択",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_12fce_1_1.txt",
  "sourceHash": "fc1ffb74ef2c2bfd155706cfc21b9a646545d2ae693de10aba51d6262421b885",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "私についてくるのはやめなさい。\nこの先はもう戦場なの。終わりのない戦いが待ってるのよ。\nあなたはただの足手まとい……進んで死地へ行く必要はないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "おい！　そこのサヴラ！！　いつまで突っ立ってる気だ！？　死にてえのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "*サルカズスラング*、早く隠れろ！　砲撃が来るぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ゲホッ、ゲホゲホッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "おい、生きてるか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ええ、まあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "この狙撃ポイントは位置が割れた！　移動するぞ！　急げ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "なっ！　また砲撃音が！？　くっ早すぎる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "グアアッ！　クソっ、足が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（アーツを放つ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こちらです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ゲホッゲホッ！　助かった、ありがとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "偶然あった遮蔽物を使っただけです。大したことはしていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それより、足はどうですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "問題ねえ、これくらいかすり傷のうちだ。適当に処理しとけば何とか動ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "それにしてもお前、見かけによらないな。まさかここまでやれるなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "アーツで物を動かして盾にするなんざ、随分手慣れたもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "よっぽど戦争の経験があるんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "訓練はそれなりにしましたが、本当の戦場は初めてですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ここまで生き延びられたのは、ただ運が良かっただけです。自分の力など、たかが知れています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "へえ、謙虚なんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "まあいい。ともかく、だ。……このままじゃ俺らはジリ貧だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お偉いさん方は安全な後方待機だからな。いくらでも時間をすり潰せるんだろうが、現場の俺らはたまったもんじゃねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "この辺で生き残ったのは俺ら二人だけみたいだしな。他の奴らはどうなったんだか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は当初予定していた襲撃が失敗して、逃げる際に所属していた部隊からはぐれてしまったんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "目標地点で何の騒ぎも起きていないところを見ると、正直、もう私の隊の隊員たちは……残念ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "へっ、そいつは奇遇だな。こっちも似たようなもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "誰かが助けに来てくれるなんて希望はとっくに捨てたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ですが、私は何があっても帰らなくてはなりません。こんなところで終わりを迎えるわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "とりあえず周囲を偵察してきます。脱出する方法を探さねば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "やめとけ。っていうか、いいか……よく聞けよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お前のアーツがどれだけすごいかってのはさっきの見りゃわかるけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ものを盾にできるったって目ん玉は二つしかないんだ。どれだけ警戒しようが、死角から撃たれたら終わりだよ。ましてや、そんな目立つ色の頭じゃいい的だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "しばらくここで待機して様子を見るべきだ。俺の目ん玉も足して全部で四つ。生き延びる確率も上がるってもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "魅力的な提案ですが……どうやら実現は不可能のようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "3時の方向から……あれは、おそらく敵です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "クランタのクソったれどもか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ええ、先行しているのは軽装のクランタ傭兵のようです。おそらく後詰めがさらに……一般的な作戦行動であれば、ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "囲まれたら、それで終わりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "囲いを破れたとしても、ドローンに追撃されるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "おいおい……なんでそこまで詳しんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "単純な予想ですよ。ここに至るまでの経験と、得た情報に基づく推測です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "間違っていればいいのですが……恐らくは、当たらずとも遠からずといったところでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今出ていけば見つかりはするでしょうが、何もしないままここで死を待つよりはマシだと思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "そんなに頭が回るんなら、まどろっこしいことしねぇで連中を始末する方法も簡単に思いつくんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "残念ですが、頭脳だけではどうにもならないことがあります。私の持つアーツでは状況を打開できません。すぐに蜂の巣にされるのが関の山です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どうすればここから逃れられるか、私にはもうそれだけなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "はっ……お前の雇い主が負けるわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "金をケチったのか、見る目がなかったのかはともかく……雇ったのがお前みたいなのじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "そういや聞きそびれてたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お前、名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "46Aです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ハッ、なんだそりゃ？　名前なのかよそれ。家電の型番って言われた方がそれっぽいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "名前など単なる呼称にすぎません、識別できればそれで足ります。ひとまず46Aとお呼びください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ひとまずってなぁ。適当すぎんだろ。その言い草だと自分で決めてんだろうが、はっきりしろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "私にとって、名前はその程度のものなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "……まあいいか。本人がよけりゃ、俺がどうこう言うことじゃないわな。どうやらお前も俺とおんなじで、きな臭いところに首突っ込んで飯を食ってるご同輩のようだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "……おい、砲撃音が聞こえたな！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "くそ、行くしかねえか！　46A、急げ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "傭兵稼業に身を沈めて随分になるがよ、砲撃を誘導するドローンなんて初めて見たぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "技術の進歩ってのは怖ぇな。機械のやつら、ますます手強くなってきやがる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "もっと早く気付いていれば、こっちだってこんなに死人を出さずに済んだんだろうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "とりあえず足跡がカモフラージュされるよう細工しました。これで少しでも時間を稼げるといいのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "それもお前のアーツかよ。役に立つもんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ついでに俺の傷の治療はできないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "申し訳ないのですが、医療アーツは習得していません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "なに、言ってみただけだ。気にすることはねえよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "私の部隊の衛生兵は作戦開始初期に失踪したのです。そうでなければ応急手当だけでも学べたのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ま、ここじゃよくあることだろ。しょうがないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お前に出会ってなけりゃ、とっくにあのクランタたちの餌食になってた。俺は運がよかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "他に逃げた味方はいないのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "さあ……分からんが、望み薄だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "厳重な包囲網だった。ここまで逃げ延びてる奴がいるなんて連中も思わないだろうよ。俺らにとってはありがたいことにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お前、まだ歩けるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "ええ、問題ありません。それよりあなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "多少痛むが、何とかするしかないな。集合地点として設定されていたポイントはそう遠くない。このペースなら、一時間も歩けば着くだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "了解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "今回はよ……本当に今回ばかりはつく側を間違っちまったな。領主どもが自信満々で高値を出すもんだから、勝算があるんだろうって思っちまったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "その結果が砲弾の集中豪雨だ。運が悪い奴はみんな死んじまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "いまさら言ってもしょうがねえが、腹が立つのは抑えられねぇ、どうしたもんだか……これまで長いこと一緒にやってきた奴だっていたのによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "死んじまったら金なんか意味ねえだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お前はどうだったんだ？　46A、お前も領主どもの積んだ金に騙されたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "結果としてはそういうことになりますね。私には先立つものが必要です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ハハ、“先立つもの”か。他人行儀なのか、上品ぶってるのかは知らんがよ、もう少し砕けても構わないぞ？　命を金に換える、ここにいる奴らはみんな同じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "私は……人を探しているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "人を？　この戦場でか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "どんな奴だ？　家族か？　それとも仇か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "恩人です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "恩人？　恩人だと？　フッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "そいつはまた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "短い付き合いだが、お前らしいっちゃらしいわな。だがこんなろくでもない場所で恩人を探すなんてよ。ここにいる保証なんてあんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "分かりません……ただ、その方は私を救ってくれた後、戦場に行くと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "なるほどな。じゃあ、俺からもアドバイスだ。お前は有能だが、素直すぎんだよ。利用されないように気を付けるんだ。いいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お節介はやめようと思ってたんだが、どうもお前は危なっかしくて仕方ねぇ。その話は確かなのか？　戦場なんて曖昧な言葉でよ。カズデルのどの戦場でお前はその恩人を見つけるつもりなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "そもそもお前を救ったってのも、本人にとっちゃ何かのついでくらいだったのかもしれねえだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "お前の雇い主だの仲間だのを思い出してみろ。どいつもこいつもすぐに手のひら返すだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "万が一、会えたとしてもそいつが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まさか、こんなミスをするとは。敵襲に全く気付かなかった自分が情けない。\n爆発物？　アーツ？\n耳鳴りがする。"
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "ハァ……ハァ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "しかし、こんな場所で死ぬわけにはいかない。\nたとえ見えなくても、歩けなくても、生きていかなければならない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたはいつも生き残るわね、サヴラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まさか、ここまで生き延びるなんて思いもしなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたは……あのろくでなしたちとは違うのかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ひとまず、ここまで生き延びたことを褒めてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "褒美として、選択肢をあげましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "過去と向き合うか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それとも、未来と向き合うか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さあ。選びなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "束の間沈黙したサヴラは、弱々しくアーツユニットを握りしめて、呟くように口を開いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "私は、もう足手まといではないはずです。今度こそ、あなたについて行ってもいいですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "若者よ、そろそろ起きる時間じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "…………うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "これは、レンジャー殿……何故にこちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "昨晩はおぬしと儂の二人、サヴラ同士で愉快に飲んでおったのだが、酒が少し過ぎたようじゃ。寝こけてしもうたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "儂もさっき目を覚ましたら、皆やけに忙しそうじゃったのでな。儂らも何か手伝うことがあるなら一緒にと起こしたわけじゃが……記憶は戻りそうかのう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "ええ、どうやら、だんだんと……失礼はしませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "特に気にするようなことはなかったわ。それよりも、ほれ、冷たい水じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "それから目の両側を押すんじゃ、強めにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "フッ、フゥ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "儂が若い頃からやっている酔い覚ましじゃが……どうじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "ああ、だいぶすっきりした気がします。ご教授いただきありがとうございます、レンジャー殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "何を他人行儀な……仲間じゃろうに、遠慮はいらぬわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "よく効くじゃろう。これは儂のとっておきの方法でのう、サヴラにだけ効くんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "12Fよ、何か悪い夢でも見ておったか？　ずいぶんと体が強張っておったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "悪い夢……どうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "12F",
      "text": "昔の思い出です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――ねえあなた、名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "46A",
      "text": "私には名前など……名前などありません。あるのはコードネームだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そう。私についてくるつもりだというのなら、いいわ。だけど、思いもしないような困難が待ち受けていることを覚えておきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これから、どんな危険があって、どんな風にそれを乗り越えて、どこまで生き残れるのか、全てはあなた次第よ。覚悟はいいかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今この瞬間にあなたは死に、生まれ変わるの。今日があなたの命日で新しい誕生日よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "記念に私から贈り物をしましょう。これから新しく生まれ変わるあなたに、新たな名前をあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今日は3月3日……そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――決めたわ、あなたは12Fよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
