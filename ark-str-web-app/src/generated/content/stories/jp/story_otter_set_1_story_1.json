{
  "server": "jp",
  "storyId": "story_otter_set_1_story_1",
  "groupId": "story_otter_set_1",
  "stageId": null,
  "title": "仕事三昧",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_otter_1_1.txt",
  "sourceHash": "0cc8190ec87cd1abe957587fbfedfff61522506eb3f6aee67cbb79568d27289e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 梅尔"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロドス本艦\n「ラボ・ルトラ」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "おっと、もうこんな時間か、仕事始めなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今日の予定は……っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん、OK。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まずは――マゼランちゃんに頼まれてる「ドローン・DDF操作改善プラン」だね。締切は今日だけど、後は仕上げだけだから余裕余裕。マゼランちゃんはいつ取りに来るかなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それと――サリアの防護服のメンテ依頼？　えーっと、たしか主に外装の塗り直しだったよね……やばっ、私もしかして塗料の注文忘れてる！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あー、良かった。前のがまだ残ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今日はこれにかかりっきりになりそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "もし時間が余ったら、新しい部品をいくつか発注して……それから稼働中のミーボたちをメンテナンスしてあげよーっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし、そんなところかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "お仕事開始！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メイヤー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メイヤー早く開けてー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "急ぎの用なんだってば！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーん、サリアの防護服、今回はどうしたんだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "チャージ率がどうやっても上がらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "変だなぁ、一体どこに問題があるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メイヤー、中にいるんでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "声が聞こえるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ここかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あは～、やっぱり～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "根本的な原因さえ見つかればあとは楽勝だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "居留守を使うなら、こっちにも考えがあるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "故障したコネクタを直せば、全体の機能が回復するはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うんうん、まずはチャージ経路を最適化してから塗装をすれば、すぐ正常な状態に戻るはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ついでにほかの機能も付けちゃおっかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "//（开门的音效）"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "はぁ、権限乱用でケルシーに怒られちゃうかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "でも知らない。メイヤーが聞こえないふりするのが悪いんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メイヤー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "これでよしっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "コネクタの位置をもっかいチェックしとこっと……塗料が染み込んだりしちゃ面倒だもんね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まったく……イヤホンをつけたまま仕事して、誰かにおどかされる可能性とか考えてないのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "よーし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "フフフフ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（メイヤーの肩を叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "（噛みつく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ぎゃあぁぁぁ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "痛い痛い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "放して、早く放してよ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あたし美味しくなんかないって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ひどいよメイヤー！　せっかく面白い話を持ってきてあげたのに、居留守どころか、噛みつくなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ごめんごめん。でも私の仕事の邪魔すると、噛みつかれることくらい知ってたでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うううう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "じゃあ、クロージャにも一回噛みつかせてあげるから、それで許してよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "今、抗源石塗料を塗ってたでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "じゃあ遠慮しとくよ。今君に噛みついたら医療部送りになっちゃうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あ、確かにそうかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "クロージャ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どうしてドアが開いてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わざわざ電子ロックを設置して、「取り込み中」モードにセットしたはずなんだけどな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "もしかしてドアをハッキングした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ま、まさか〜。ドアは普通に開いたけどなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "君がドアをロックし忘れたんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ロックし忘れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "……おかしいなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ちょっと待ってて、監視カメラの映像を見てみるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "監視カメラまで設置してるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん。この部屋にはライン生命の内部資料もたくさんあるからね。万が一なくしちゃったら会社間の問題になって色々面倒でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "防犯対策はやっぱり必要だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "えーっと……それより先に仕事した方がいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あ、安全マニュアルを守らないと！　この塗料、結構危険でしょ。作業途中で他のことに気を取られると、事故が起きちゃうかも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "大丈夫だよ、ロボットアームを使ってるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーんと、どのプログラムだったっけな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あ、あの……メイヤー！　塗料の性質が変化しちゃわない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "これのこと？　大丈夫だよ、これ不活性塗料だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "たとえ沸騰したお湯に浸けて、三時間ほど電離させた後に凍らせたとしても、解凍すればすぐに使えるようになる代物だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "このフォルダに入れてたっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あったあった、監視プログラムを開いて……と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "えーっと、時間はだいたい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "メイヤー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あ、あたしと一緒にAIロボットのカスタムしない！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "メイヤー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "メ、メイヤー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あ、ごめん。聞いてなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "もっかい言って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あたしと一緒に、AIロボットの……カスタムしないかって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "いいねそれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "良かった！　じゃあ詳しい話を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "（監視映像を再生する）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジジッ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "監視映像",
      "text": "（ガチャ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監視映像",
      "text": "はぁ、権限乱用でケルシーに怒られちゃうかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監視映像",
      "text": "でも知らない。メイヤーが聞こえないふりするのが悪いんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ミーボ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "噛みつけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あああ！　ごめん、ミーボはやめてぇ！　うわぁ痛い痛いよ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それで……何の用で来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うううう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "起爆装置に関する問題で力を貸してほしかったんだよぉ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ベースになるロボは、レイジアン社製のプロバカートルシリーズでラヴァキャット・デビルパフォーマンスモデルなんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "そこにカスタムした全量エネルギーアーツショック発生器を載せたんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "だけど期待した効果が得られないから手伝ってほしいなって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うううう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "とりあえずホラ、これを嗅いで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うん……うううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "（息を吸う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "これは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "（深く吸う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "落ち着いた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "はぁ～～～～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "落ち着いたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "えへへ、ありがとメイヤー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あんなにずっと泣かれてちゃ、仕事の話ができないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うん、そうだよね……えへへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "なんでそんなにこの精錬グリースを嗅ぐのが好きなの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "もちろんイイ匂いだからに決まってるじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ワルファリンが言ってた通り、君の血管に流れてるのは血じゃなくてオイルなんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まぁそんなのはいっか……仕事の話をしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "オッケー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "プロバカートルを改造してほしいんだよね。攻撃力を上げたい、そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あと自己防衛ルーチンとダメージ耐性、戦場離脱プログラムの設計もお願い。AIを搭載する子だからさ、簡単に壊れてもらっちゃ困るんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そりゃ確かに私にピッタリの案件だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "で、報酬は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "格納庫に小さな物置があるの覚えてるかな、あそこを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "引き受けた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "へへ、それじゃよろしくね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "アイアイサ～――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "と言いたいとこだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あそこの黒板を見て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "紙がいっぱい貼ってあるやつ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そうそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれは私のスケジュール表なんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "急ぎの案件だとしても、一番右下で順番待ちすることになっちゃうんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "もうちょっと優先的にスケジュール調整できないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "できないんだなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "つまり、二ヶ月後ってことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まぁ、早ければ五十日かな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あんなたくさんの仕事をたった五十日で！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まぁね。インスピレーションさえ降りてくれば、すぐに終わらせられることもあるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うう……じゃあとにかくお願い……あたしはそろそろ帰るね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "お仕事頑張ってね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ちょっと待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "帰る前にドアをフォーマットしてってよ、設定し直すから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あと、君の管理者権限も消しといて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今すぐ。この場で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "えぇ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "わかったよぉ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "2時間後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あとは最後の仕上げっと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "（ドアをノックする音）"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "メイヤーちゃーん、いないのー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "なんでドアが開かないんだろう……パスワード変わった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "これで大体オッケーっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれ？　そこに誰かいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたしだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "マゼランちゃん？　あ、今ドアが壊れてるから、横にあるボタンを押して入ってきて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "やっほー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どーもー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ごめんね。今サリアの件で忙しくて、おもてなしできないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ところで、何か用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "予約してあるんだけどな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ドローンのプラン、どんな感じ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あっ……そうだった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それならもうできてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "技術的要件と改善プラン、あと必要材料を一通りリストアップしてあるよ。全部テーブルの上のファイルケースに入ってるから、確認してみて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "問題なければ改善プランに沿ってパーツ製作するから、改めて依頼を出してね。要望とか質問があれば時間を作って話そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "オッケー、ありがとうメイヤーちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えーっと、テーブルってどのテーブル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれだよあれ。ロボットアームが指してるあれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そっちにはテーブルが四つもあるし、どれかわからないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ちょっとメイヤーちゃん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あっ、引っ張らないで、まだ塗装中なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "塗装はあとでもいいでしょ、先にどのファイルか教えてよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "メイヤーちゃ～～ん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わかったよもう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ありがとう〜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーんとね……これ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "これは先月の君のオーダーリストだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あっ！　ごめんごめん、こっちだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うーんと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ありがとうメイヤーちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "いやいや大したことないよ、当然のことだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "忙しいとこ邪魔しちゃったね、それじゃバイバーイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "一番大事なことを忘れるとこだった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ねぇねぇ、今って何時だと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "お昼前くらいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "とっくに午後だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "メイヤーちゃん、ご飯食べた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "え、私？　私はエナジーバーを食べるから大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "大丈夫じゃないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "はい、これ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "何これ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "食堂で買ってきたの。今日は川の幸の盛り合わせがあったからさ。大好物でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "本当は一緒に食べたかったんだけど、あたしも忙しくてつい誘うの忘れちゃってたんだよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "食べ終わってからそれに気付いて、テイクアウトしてきたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わあ、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ちゃんと食べてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん、わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まだ何かあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "それってサリアのチャージ防護服？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あとどれくらいかかるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "一、二時間くらいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そんなの餓死しちゃうよ！　あたしも手伝うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "大丈夫だって、私は平気だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたしに手伝わせるか、あたしに食べさせられながら作業するか、選んで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ええ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わかったよ、じゃあ手伝ってくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えへへ～、いいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "さっそく始めよっか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ふぅ、終わったー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "お疲れ様〜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし、手を洗っちゃおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "こういう時だけは、ライン生命の全自動洗浄装置を恋しく思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "どうして戻らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "戻ったら面倒くさい仕事をたくさん押し付けられるからね。ミーボを改造する時間がなくなっちゃう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それに、あっちだと人間関係も面倒だしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "それはロドスにもあるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "君は外勤が多いから、部署間の対立の闇を知らないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あそこはね、新しく誰かと知り合ったら、別の人に「あの人はどこそこの部署と関係があるから、距離を置いた方がいい」って言われるような場所なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それにもっと恐ろしいのは、たとえ同じ部署内の同僚だとしても、上司間の争いのせいで騙し合いになることだってあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "私そういうのほんと苦手なんだよねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "だからここに逃げてきちゃったってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうだったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ごめん、こんなこと聞くべきじゃなかったね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ううん、大丈夫だよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし、じゃあご飯をいただこっかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "じゃあ、あたしはもう行くね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あ……ミーボ、メイヤーちゃんがしっかり規則正しい食事をするように見張ってて。あたしが出て行ったらすぐに仕事を始めちゃうかもしれないからね。わかった？　おーい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "返事はしないって。発声モジュールは付けてないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "じゃあわかったってことで。後はよろしくね！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "それじゃ、ほんとに行くね、バイバイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "バイバーイ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし。食べるのは部品を発注してからでいいや――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うわぁ！　ミーボ、何するの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ちょ、ちょっと発注するだけだよ。ご飯はちゃんと食べるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わかったよ、食べる、今すぐ食べるから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ふぅ……お腹いっぱい。よし、仕事仕事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーん、先に部品の発注を済ませるか、それともミーボのメンテを始めるか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "やっぱりミーボにしよう。ミーボの方が大切だもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "おいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どれどれ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "塗装に配線チェック、データアップデートにエネルギーチャージっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "一体メンテするだけでもやること多いなぁー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "任務用のはあと四体か……予備の五体もメンテしちゃおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今、何時だっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まあ、今日中には終わりそうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "きっと終わるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "これ以上、誰の邪魔も入らなけれ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メイヤー！　開けてくれ！！　頼みたいことがあるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "なんでまた！@~#！@",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "フゥ、フゥ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "落ち着け。落ち着くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "（深呼吸）スー……ハー……スー……ハー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "笑顔、笑顔っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うわっ！　なんだ、やっぱりいたんじゃないかメイヤー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "なにを楽しそうに笑ってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "入って、教えてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ほら、これがミーボだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それは知ってるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "手を出して、いいものあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おっ、そりゃあ珍しい。どれどれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ミーボ、噛みつけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うわああっ！！　なんで噛むんだ！？　あ痛たたたた！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "深夜"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あーーついに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "終わった〜〜！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今朝立てた予定がやっと全部終わったぞー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あ、それはいいよ。部品発注は明日にするってさっき決めたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "えーと、明日の予定は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まず購買部に行って部品の発注。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "医療部の実験装置取り付け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "おっと、作業台も整備し直さないといけないんだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "明日はこんな感じかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今は……11時36分か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん、そろそろ休もうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "適当にカップラーメンでも食べてから寝よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ミーボ、また明日ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーボ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うぎゃーーー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
