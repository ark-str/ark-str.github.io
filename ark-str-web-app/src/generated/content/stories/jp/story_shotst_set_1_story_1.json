  "sourceHash": "88f355c3eb367f6cf06c2f8bd8949c4e64069016b353f7feed418d175439b580",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "流星"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 11:00 天気/豪雨\nメテオの宿舎"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "すごい雨ね、寒いわ。暖房をつけましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ええと……どうやって温度を調節するんだったかしら？　こう？　この丸いつまみを、こっちにひねって……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "これでいいはずよね？　はぁ。電子機器って本当にさっぱりよ。暖炉があったら、どんなにいいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ふう、もうこんな時間……ミーナはいつ終業になるのかしら。医療オペレーターは本当に大変ね。同じ宿舎なのに、全然顔を合わせないんだもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "メテオ、私だよ。こんなに遅く電話をしてごめん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ミーナ、残業中なんでしょう？　どうしたの、忘れ物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "私じゃなくて、ジェンナなの。あなたに会いたいってずっと泣いていて、誰もなだめられないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジェンナ！　何があったの？　気分が悪いの？　待ってて、着替えたらすぐに医療部へ行くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "違うのよ、メテオ。彼女、雷に驚いちゃったの。まぁ落ち着いて。この子をそっちへ連れて行ってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そう……いいわ。先に少しジェンナと話してもいいかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "分かったわ。さあジェンナ、メテオお姉さんがお話がしたいって。おいで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃん、怖いよぉ、ううう。どこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジェンナ、怖がらなくて大丈夫よ。お姉ちゃん、あなたの大好きなスノウィライスミルクを作って待ってるからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "よしよし、ジェンナ、泣かないの。今からメテオお姉さんのところへ行こうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "ううう……ミーナお姉ちゃん、あ、あたし頑張るよ……もう泣かないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "大丈夫よ。すぐに着くからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ミーナ、今日は寒いから、ジェンナに厚着させてあげてね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "もちろん。医療部には子供用の特製セーターがあるのよ。暖かい上に着心地もいいんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "靴下なんかも、しっかりね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "うんうん。じゃあメテオ、私はあの子を抱いて行くから、切るね。また後で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ええ、待ってるわ。また。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あんなにひどく泣いて、本当に心配ね、あの子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "暖房を少し強くしましょう。子供に風邪は引かせられないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一ヶ月前\n医療部"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "メテオ、申し訳ないんだけど、しばらくの間、この子の面倒を見てくれないかな？　お願い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "この子はガレキの中で見つけたの。落ちてくる天井を家族がこの子の代わりに受け止めて、どうにか彼女を守ったみたいでね……生き残ったのはこの子一人だけ、可哀想に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ああ、なんてこと。もちろんいいわよ。ただ……どうして私に？　医療部には看護の専門家がたくさんいるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "実は最近、医療部は仕事が多すぎてね、恥ずかしい話だけど、全然人手が足りないの。それで同室のあなたに頼むしかなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "ああ、そうだ。ちょっと待ってて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "この子の診断書よ。医療部の心理科の医師によると、できれば誰かがずっと付き添ってあげるのがいいみたい。だけど私はずっと側にはいられなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そうだったのね。じゃああなたが忙しい時は私が彼女に付き添ってあげるわ。ちょうどこのところ、これといって仕事がないことだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "助かるわ。あの子はまだ幼いし、家族を失った苦痛に当分向き合えないかもしれない……だけどあなたが側にいてくれたら、きっと立ち直るのも早くなるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おだててるの？　ふふ、お礼を言っておくわね。それはそうと、その子は今どこにいるの？　会いに行けるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "もちろんよ。ついてきて、こっちの病室にいるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "この子が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "ジェンナ、いい子で薬が飲めたかな？　今日はあなたにお客さんが来てるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うん、いい子にしてたよ、ミーナお姉ちゃん……後ろの人は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "お姉ちゃん、だあれ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "ジェンナ、この人はメテオお姉さん。今日から私と一緒にあなたのお世話をしてくれるの。心配しないで、このお姉さんは優しくて面倒見がいいから、きっとジェンナも大好きになるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ミーナお姉ちゃん、うぅ、あたし……大丈夫だよ。ミーナお姉ちゃんは忙しいってわかってるから、いい子にするよ、安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "ああ、ジェンナ。その聞き分けの良さ、かえって切なくなるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "メテオ、私は急ぎの仕事があるから、先に行くね。あなたたちはここにいて。終わったらすぐ戻ってくるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "わかったわ。また後でね、ミーナ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "お姉ちゃん……こっ、こんにちは。あたしジェンナ、六歳なの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "えっと、お嬢ちゃん、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "あ、あたしは、お薬をしっかり飲んでるし、ごはんもちゃんと食べてる。そ、それから、紙のバラも折れるようになったの。お姉ちゃんはバラは好き？　ぜ、全部あげるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ふう――コホン。ジェンナね？　こんにちは。私はメテオよ。メテオお姉ちゃんって呼んでくれていいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "……メテオお姉ちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "実は知ってるの……お姉ちゃん、よくミーナお姉ちゃんに会いに来てたでしょ……だから見たことあったんだ。お姉ちゃんの話し方は優しくて……それで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あなたさえよければ、私を本当のお姉ちゃんだと思ってくれてもいいわ。私もずっと妹がほしかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ほっ……ほんとにいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "もちろんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "メテオお姉ちゃん、あたし……うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "どうしたの？　大丈夫よ、何でもお姉ちゃんに話してちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "あたしのお人形が、なっ、無くなっちゃったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そうだったの。ミーナお姉さんは知ってるのかしら？　一緒に探してくれた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ミーナお姉ちゃんはすごく忙しいから、あたし……邪魔しちゃいけないと思って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "大丈夫よ。そうね、お姉ちゃんが他の場所を探してきてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ううん、もういいの。探さなくていいから、だからお姉ちゃん行かないで、おねがい……おねがい、一人にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "分かったわ、心配しないで。それじゃあ一緒に新しいお人形を買いに行きましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うぅ……新しいお人形もいらない。お姉ちゃんがいてくれればいいから……一緒にいてほしいの、一人はいやだよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "大丈夫だよ。私はどこにも行かないわ、あなたの側にいるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うぅぅわぁん―――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "よしよし、お姉ちゃんはここにいるわ。大丈夫、もう怖がらなくていいわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ちょっとジェンナ、どうして裸足なの！　ミーナ、この子に靴下をはかせてあげなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "そうじゃないのよ。この子ったら、あなたに会えるって聞いて、上着を着ただけで飛び出しちゃって、捕まえられなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うううーっ、メテオお姉ちゃん、怖いよぉ。雷の音がすごくて、一人じゃ寝られないよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "雷の音？　本当に悪い雷ね。明日ドクターのところに行ってこらしめてもらいましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うん、ううう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "さぁ、早く入って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "いや、私はもう行くよ。ジェンナの歯ブラシはこれね。ミルクを飲んだら忘れずに歯を磨かせて。それからタオルと、靴下、手袋に、お人形、あと羽の髪留めよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "分かったわ。あなたってば、本当にお母さんみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "えっ？　そう言われれば、そうかもね。ふふ、じゃあ「お母さん」はまだ仕事があるから、ジェンナはここでいい子にしてるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おいで、ジェンナ。ミーナお姉さんにバイバイして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "ううう……またね、ミーラお姉ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "ミーラじゃなくてミーナよ、ジェンナ！　まぁいいわ。そろそろ戻らなきゃ。おやすみなさい、メテオ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おやすみ、また明日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うううっ、まっ……また明日。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジェンナ、私のパジャマに鼻水をつけないでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "そんなことしないもん……スビッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "すすって我慢しないの。お姉ちゃんはティッシュくらいちゃんと用意してあげられるわよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うっ、メテオお姉ちゃんっ、また落ちちゃう！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ああっ！　ティッシュはどこ？　あった！　はい、早く拭いて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "よし。早くお布団に入って、足もちゃんと入れてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃんのお布団、あったかいね。それに、バラの香りがする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ぷっ、この子ったら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃんも早く来て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "抱っこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "何かお話する？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "お話を聞き終わったら、いい子で寝るのよ。もう雷は怖くない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "……メテオお姉ちゃん、実はね、あっ、あの日……あの日も今日みたいな天気だったの。お父さん、お母さんやお姉ちゃんはどんどん冷たくなって、だっ、だから怖いの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……それを思い出すから、雷を怖がっていたのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "う、やっぱりあたし、メテオお姉ちゃんみたいに強くなれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "強さは関係ないわ。お姉ちゃんも昔を思い出して怖くなるときがあるのよ、ジェンナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "ほんとに？　でもメテオお姉ちゃんはいつでもとっても勇敢だよ。どうしたらそうなれるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "まずはね、お姉ちゃんは過去の記憶を怖いモンスターだと思うの。それから、自分は勇敢な狩人だって想像するの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "それからは？　どうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "それには、まずはあるお話から始めないといけないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "お話？　どんな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "昔々、遙か遠いカジミエーシュの広大な森の中に、大きな落ち葉の山がありました。その中には……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "何があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "一人の小さな狩人が、ブルブルと震えていました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "あたしみたいだね。あたしも今メテオお姉ちゃんの布団の中で震えてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "震えているの？　あら、そうね。足が冷たいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "もう少しこっちへ来て、抱っこしてあげる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "まだ寒い？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "寒くないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "じゃあ続けるわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "可哀想な小さい狩人は一人、家を離れて、山の中でさまよっていました。冷たい北風が薄い上着に吹き込んで、氷水のような雨が彼女の柔らかい髪を濡らしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "遠くの空で雷の音が響いています。それは飢えで背中とくっつきそうなお腹と一緒に、ゴロゴロと苦しみの音を立てます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "怖いよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "いいえ。更に怖いのは、一匹の獣です。ずる賢くて巨大な獣が、微かな気配をたどって、小さな狩人の後を追っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "獣は鼻を湿った泥に突っ込んで、ざらざらした木の皮にこすりつけます。草むら、沼、小川の畔、どんなところも見逃しません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そしてある枯れ木の下で、獣はついに嗅ぎつけます……見つけたのです……一本の小さな足を――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うわぁ！　メテオお姉ちゃんの意地悪、足を放してぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "うん、だいぶ温まったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "もうっ、お姉ちゃんのお腹にのっけてやるー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "いいわよ。えっと、どこまで話したんだっけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "獣が狩人を見つけて、狩人が捕まっちゃいそうになったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ああ、そうね。落ち葉の中に隠れていた小さな狩人は、怖くて頭を抱えました。はっきりとした獣の荒い鼻息と、歩くたびに爪が泥をはね上げる音が聞こえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "スフ――ッ、スフ――ッ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "ポタッ――ポタッ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "小さな狩人は怖くて息もできません。大きな涙の粒がこぼれ落ちました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "獣が小さな狩人を追って何日経ったことでしょう。今までは何とか危険を逃れてきました。しかし今日、この時ばかりは、可哀想な少女にもう逃げ場はありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "あきらめちゃだめだよ、狩人さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "その通り、絶対に折れちゃだめよ！　獣が鋭い爪を出した、その瞬間のことです。小さな狩人は何とか心を落ち着かせ、自分に問いかけました。本当に打つ手はないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "彼女は落ち着いて、矢筒の中から最後の矢を取り出しました。そして落ち葉の隙間から、勇気を振り絞り、はじめて恐ろしい獣を見つめました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "怖くなくなったの？　どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おじいさんの歌を思い出したの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "どんな歌なの？　歌って歌って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "小さな狩人が、まだ小さな小さな狩人だったとき、おじいさんが彼女を抱いて歌っていたの。「♪お利口さんのお嬢ちゃん、ほんわり明るい月の下、わさわさ茂った森の中、獣が後から追ってくる♪」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "「♪忘れちゃいけない、大きく前へ歩むこと。行く道なかったら、勇気を出して振り向いて。小さな弓構えて、小さな矢をつがえよう♪」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "その瞬間、月の光が彼女に方向を指し示し、大地が彼女の肩を支えました。小さな狩人が引き絞った弦を放すと、強い北風が木の矢を獣の胸めがけて送り届け、ついに獣は倒れたのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃん！　その獣は死んだの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そうよ。決心と勇気によって、小さな狩人は最後の最後に、恐怖をもたらす獣に勝ったの。そしてメテオお姉ちゃんもね、そんなふうに恐ろしい過去を打ち負かしたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "だからジェンナも、勇気を奮い立たせて向き合えば、どんなに窮地に立たされても絶対に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "でもメテオお姉ちゃん、あ、あたしは、自分の過去なんか倒したくないよ！　だって、怖いときはね、嫌なことだけじゃなくて、みんなとの楽しい思い出も、一緒に出てくるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "でも、それを思い出すとジェンナは辛いんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "うん、とっても辛くて、涙が出ちゃうの。でも胸が熱くなって、すごく暖かい気持ちになるんだ。メテオお姉ちゃんと出会う前は、その思い出たちがずっとあたしの側にいてくれたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ええと……そ、そうなの？　あなたの獣さんは、あなたを食べようとはしてないみたいね、はは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃんのお話の中の獣も、小さな狩人を食べようとはしてなかったんじゃないかなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あら、どうしてわかるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "じゃあ小さな狩人こそ、どうして獣が食べようとしてるって知ってたの？　獣に聞いてないでしょ。彼女は怖がって逃げてばかりで、振り返って聞いてないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "でも、獣はずっと猛烈に小さな狩人を追っていたのよ。彼女を食べる以外に目的があるとは思えないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "違うよ、メテオお姉ちゃん。お姉ちゃんは、小さな狩人は怖くて、寒くて、お腹が減ってるって言ってたけど、獣に追われて怪我をしたとは一度も言わなかったよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "もしかしたら獣は、この道は歩きにくいから、独りぼっちの女の子には一緒に歩いてくれる仲間が必要だ、って思ったのかもしれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "だから獣を殺さないで、お願い。メテオお姉ちゃん、殺さないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃん、どっ、どうして黙っちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "あたし、悪いことを言っちゃった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "いいえ。少し昔の出来事を思い出したの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "胸が熱くなるような思い出？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ええ、そうよ。以前は思い出すとなんだか辛くなったから、なるべく頭に浮かび上がってこないように抑えていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "そんなことしちゃだめだよ、メテオお姉ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そう、あなたの言う通りね。小さな狩人は間違ってた。私も間違っていたわ。どうして殺そうとしたのかしら？　どうして記憶を閉じ込めていたのかしら？　……いつだって、いたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "家を離れてからの、数え切れないほど長い夜たち。かつての荒野と密林。苦しい時、楽しい時、悲しい時、退屈な時、私のここまでの道にはいつだって、アレがいた。一度も私を殺そうとはしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "（今のメテオお姉ちゃんの話、少しだけ分かるような、でも分からないような。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（深呼吸）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジェンナ。私……新しい結末を思いついたわ。聞きたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "聞きたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "じゃあもう一度寝て。しっかりお布団に入るのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "寝たよ。目も閉じたから、早く話して、お姉ちゃん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "最後の最後、小さな狩人は短剣を抜きました。しかし、鋭い刃は獣の心臓に向かって振り下ろされませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "なんと小さな狩人は、自分の服を切って、優しく獣の傷口に巻いたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "獣のふさふさの頭を撫でながら、聞きました。「まだ立てる？　大きな君？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "獣は少しの間黙っていましたが、ゆっくりと立ち上がりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "小さな狩人はまた聞きました。「私、これから未知の冒険に出かけるの。だから仲間がほしいと思ってたんだ。君も一緒に来る？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "今度は獣は黙っていませんでした。獣の喉から、楽しそうな叫び声がほとばしり、鞭のように力強い尾がゆらゆらと揺れ始めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "獣は走るのがとっても速くて、その高い高い背中に跨がると、小さな狩人は風に乗ることさえできるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "もうこの先、小さな狩人は独りぼっちじゃありません。二人は一緒に太陽へ向かって駆けていきました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "ふ――ふわぁ――メテオお姉ちゃん……あたし眠くなっちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "スゥ――スゥ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "寝たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "スゥ――スゥ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ミーナってバカね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ミーナはあなたが強くないって思ってたみたいだけど、ジェンナ、あなたはとっくに過去との向き合い方を知っていたのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（キス）でも、ありがとう、ジェンナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ありがとう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
