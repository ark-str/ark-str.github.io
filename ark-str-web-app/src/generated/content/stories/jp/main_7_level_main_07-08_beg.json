        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ええっ？　先生、やっぱり……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、行きましょう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "目標は、レユニオンのサルカズ巡回部隊です！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "私も行く。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "Guard、だっけ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "あなたは私のこと、誤解してる。でも私があなたを守るよ。あなたの代わりに、敵に仕返ししてあげる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "あなたたちにしたこと、私の家族にしたこと、全ての人にしたことを全部返してやるの。全部……",
          "portraitKey": null
        },
