{
  "server": "jp",
  "storyId": "main_7_level_main_07-08_beg",
  "groupId": "main_7",
  "stageId": "main_07-08",
  "title": "暗がりの火",
  "storyCode": "7-10",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_07-08_beg.txt",
  "sourceHash": "929821ff111fa02e0e5a62fd7ac41e495042dfe8e333c824154a2596d2e377b5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "Guard、君の行動について説明してくれと言っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "ああ、俺の姿はもう、完全にレユニオンに見えますよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "やっぱりあんたたちは知り合いなんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "ということはこのコータスの娘は嘘をついてたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "あんたたちとレユニオンは最初からグルだった！　そうでしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "……食料は見つかったか？　避難所のみんなはもう、それほど長くは持たない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "いつまで私を弄んで苦しめるつもり！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "そんなつもりはないが……とりあえず安全な場所まで行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "Guardさん！　彼女に近づかないで！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "何もしやしませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "今の状況は非常に説明しづらいんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "とにかく彼らへの接触は注意を払ってください。このエリアに住む全てのウルサス人感染者は、酷い生活を強いられていて——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "その大半はもう精神崩壊寸前だ。あとはきっかけさえあれば——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "「酷い」なんかじゃ済まないわ！　この人殺し！　汚い虐待野郎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "私まで……私までこんなふうにしやがって！　こんな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "これ以上ここにいるのは危険だ。サルカズに見つかってレユニオンに引き渡されてしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "パトリオットの部隊はもうこのエリアを離れた。君が捕まったら、俺には助けられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "死なせてくれればいいじゃない！　あんたたちみたいな化物だらけのこの地で生きてくなんてごめんだわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "何が遊撃隊よ……何が感染者の盾よ！　違いなんてあるの？　他のレユニオンと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "あるさ。彼らがいなけりゃ、俺たちはもう死んでいたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "じゃあ説明してよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "あんたがずっと言ってるように、あの人たちが本当に正しいってんなら、なんでレユニオンにいるの？　なんでこの街をめちゃくちゃにするのを放っておいたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "なんで反抗しないの？　なんで脱退しないの？　どうして私たちが殺されて、侮辱されて、迫害されてるのに、全部見過ごしたの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "あんたが言う遊撃隊は、なんであのうろつき回る化物たちと戦ってくれないの！？　ねえ、なんで！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "この目で見たのよ、奴らが手で……素手で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "パトリオットの目が届かない場所が多過ぎるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "彼が人々の生活を守るよう、遊撃隊に指示を出したときには既に、街全体で問題は深刻化していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "それでも……遊撃隊がいる場所では、レユニオンの暴徒が好き勝手をすることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "遊撃隊の戦士は、暴徒たちとは全然違うんだ。パトリオットの部隊の者は、たとえサルカズでもちゃんと規律を守っている——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "じゃあなんで今、そいつらはここにいないの！？　どうして！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "遊撃隊とやらがいなくなった後に何が残った？　あの感染者たちの暴力がますます酷くなっただけじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "遊撃隊がいなければ、私たちもここまで酷い目に遭わなくて済んだのに……そうでしょ！？　奴らは遊撃隊への当て付けに暴れてる。結局彼らが悪いんじゃない！　遊撃隊が悪いのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "それは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "遊撃隊は悪くない。だが君の言うように他のレユニオンの連中は、遊撃隊への当て付けで横暴に振る舞っているのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "奴らがそうする理由は、非戦闘員とはいえ、敵勢力の人間である君たちを、遊撃隊の戦士たちが命掛けで守っているからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "遊撃隊は君たちの生きる権利だけでなく……尊厳をも守っている。俺はこの目で見た——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "彼らが、他のレユニオンに対して、君たちのことを番号ではなく、名前で呼ぶようにと命令していたのを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "そうだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "それに、パトリオットがここに俺たちを残したのは、彼らがいない時に君たちを助けるためだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "チェルノボーグの都市機能は、既にバラバラに解体されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "一部のエリアにはまだ遊撃隊が残っているかもしれないが、それ以外の場所はもはや無法地帯も同然だ……秩序を維持する者がいないのであれば、俺たちが……君たちを守るしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "たとえ命を落とす危険があるとしても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "アーミヤさん。今私が言ったこと、信じてもらえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "違う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "コータスの娘、信じちゃダメ……そいつはレユニオンなんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "あんたたちまさかレユニオンの言葉を信じるの？　感染者になったからって、私にもレユニオンのふざけた言葉を信じろって言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "ほら、さっきこいつが言ってた、今私たちを殺そうとしているのはレユニオンなんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "あんたたち誰が誰で、私を殺そうとしてるのは誰なの！？　たとえ生き残ったとして、感染者になった私はこの先どうなるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "あんたたち……レユニオン……みんな……一体何なのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "（アーミヤ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "（先生？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "（ここからは落ち着いて行動するように。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "ケルシー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "ケルシー、このままここにいても仕方ない。先に進むべきだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "どうして君がここに……？　まさか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "あなたたちは……レユニオンを殲滅するつもりなんですか！？　ロドスまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "くっ！　今はそれどころじゃないか……いいですか、この辺一帯を巡回するサルカズの部隊は、この時間帯に倉庫エリアに来ます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "見つかったら連れて行かれてしまう！　急いで隠れないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "それ以外にも、普通のレユニオンの巡回部隊も時々やってきます。つまり俺たちが物資を探す時間はかなり限られている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "そのせいで、食料も薬品も足りずに、多くの人がどんどん命を落としていったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "アーミヤさん、ケルシー先生、それにDr.{@nickname}も、できれば俺の言葉を信じてほしい。せめて今は隠れてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "Guardさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そこのウルサスの感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "私のこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君に、幾つかの問題について諮りたいのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "そ、その喋り方……あんた帝国の首都から来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "でも言葉遣いは古臭いわよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ふむ……君は比較的、高等な教育を受けているようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "……前は大学の書記だったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "今はあんたたち感染者のせいで、何もかもめちゃくちゃだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "では訊くが、君の後ろにいる男——かつて我々の一員だったが今はレユニオンとなった彼のことを、君は信頼しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "この人、あんたたちの仲間……だったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ロドスには、「戦闘状態においても、罪なき一般人の生存を優先的に確保せよ」という行動規約がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "しかし、君が「罪なき一般人」の分類に入るかどうかは、まだ判断しかねるが……どうしたものかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そうだな……よし——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス人感染者",
      "text": "ああっ……うわあああー！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ケルシー先生！？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何をするんだ！？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "あ、あんたのそ、それ——な、なに……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス前衛オペレーター？",
          "text": "……まさか自分がMon3trに捕えられる日が来るとは思ってもみませんでしたよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Guard……君の首に触れている刃は、8度の切入角しかない。6mm刃を入れるだけで君の大動脈を切断できる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "お嬢さん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "えっ、なに……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "彼は、彼自身の言葉の中にあったように、君たちの生存の権利を、迷いなく守ってくれたのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "何なの……？　それってどう言う——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "彼、あるいは彼が所属するレユニオン部隊が、君の命を脅かす、あるいは君を傷つけるような行動をしたことはないか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "事実だけ教えてほしい。君の返答次第で彼の処分が決定する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "そいつの命で私を脅すつもり！？　私はそいつとは……何の関係もないのに！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "彼個人として、レユニオンの命令に従って他人を害するような行為はあったか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス前衛オペレーター？",
          "text": "先生……俺を侮辱するようなことは——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "私が重きを置くのは、目撃者と被害者の証言だ。君が彼女の権利を保証していると主張するのに対し、君が不当な行為を行わなかったかどうかを判断する唯一の材料は、このお嬢さんの言葉しかない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "君の言葉は単に君の言い分に過ぎない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス前衛オペレーター？",
          "text": "でも彼女の言葉だって――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "彼女の立ち位置は君とは違う。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "君には力がある。破壊を伴う攻撃や、脅迫に効果を発揮する力だ。それをどう使うかは別問題として。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "感じる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "アーミヤ、サルカズだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "すぐ近くまで来ている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "何なのよ……彼が何だって——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "彼は君たちのために、他のレユニオンに抵抗したことはあるか？　他のレユニオンの侵害から君たちを守っていたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス前衛オペレーター？",
          "text": "先生……！　巡回部隊がもうそこまで来てるんだ！　これは遊撃隊なんかじゃない……これ以上、これ以上近づかれると——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "横暴よ！　そんなやり方は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "緊急の措置とはいえ、我々の行為は、ウルサスの最低限のモラルを逸脱していないと判断する。そして彼のことを告訴したのは君だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "彼は……確かに彼はいつもこの時間に……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス前衛オペレーター？",
          "text": "ケルシー先生！　俺にあのサルカズたちを止めに行かせてくれ！　そうすれば彼らを他のルートへ誘導する！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "彼女の答えが先だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "言うんだ。でないと、誰も真実を知りえない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "直線距離24メートル。近づいてる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "…………",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "22メートル。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Mon3tr。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス前衛オペレーター？",
          "text": "先生！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "やってない！　彼は一度も悪いことなんてしてない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルサス人感染者",
          "text": "少なくとも私は見たことがない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "アーミヤ。ドクター。",
          "portraitKey": null
        }
      ]
    },
