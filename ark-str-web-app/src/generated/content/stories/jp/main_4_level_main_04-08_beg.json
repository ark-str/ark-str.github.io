  "sourceHash": "11aa50001cd1573240c445eabd22a458736a53a343f2b152c6339fdbcd039b55",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ええと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "多分、この辺りのはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "すでに、フロストリーフさんから送られてきた座標の近くまで来ているんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "なんだか少し、嫌なにおいがしますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "どこか焦げ臭いような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "この場所は一体……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――！　危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ッ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "は、外した……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "安心しろ、ここなら安全だし――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "う、っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――！？　お、おい、急にどうしたんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "……っ……あ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "聞いたところで、二度と答えは得られんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "な、なっ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今のは――あの建物からです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　待って……もしかして、あそこにいるのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "フロストリーフさん！　あなたですよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ああ。……安心しろ、この場の敵は片付けておいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "それより、心配をかけたな。アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……ッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……！　どこか痛みますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "医療班、手当をお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……これは……凍傷？　一体、何があったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "この程度、かすり傷だ。問題はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……メテオリーテとジェシカは、まだ広場にいる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "私がレユニオンを引きつけておいたから、恐らく気付かれてはいないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "とはいえ、今は無事でも、この状況が長引けば危険に晒されることは確かだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "では、そのレユニオンは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "すでに近くまで来ているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "この場所は奥まっているし、もうしばらくはやり過ごせるだろうが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "子ギツネさ～ん、どこに隠れてるのかな～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "かくれんぼなんてやめて、出ておいで～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "さもないと、1分ごとにお友達の指を一つずつ折っちゃうけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "君はそれでも逃げ回るつもりなのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "（メフィスト――！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）落ち着け。あれはハッタリだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "（小声）っ……彼は、この場所で何を……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……よし、やり過ごせたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "まさか、メフィストもここへ来ていたなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "いえ、とにかくまずは、メテオリーテさんたちに連絡を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……あれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "汚染された区域は抜けたはずなのに……どうして、通信できないんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "これを見ろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "通信機……？　フロストリーフさんのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……！　凍ってる……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "一体、何が起きたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "さっきいたメフィストは、あくまでオマケみたいなものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "というのも、この廃都市には……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "奴よりもよほど恐ろしい連中がうろついているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "恐ろしい連中、というのは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "スノーデビルだ。奴らに出くわせば、マズいことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "スノーデビル、というと……スノーデビル小隊のことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "恐らくな。現状、推測でしかないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "だが、辺り一帯の温度が低下していることや、会敵した各部隊の状況を鑑みると……奴らの仕業としか思えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "レユニオンの連中が、この廃都市に自らの領土を築き始めているということだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――そろそろ、暗くなってきましたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今のうちに、移動しましょうか。この開けた道も、気付かれずに通り抜けられそうですし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "とにかく、まずはメテオリーテさんたちを助けに行かなくては。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "わかった。付いてこい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "広場に何か、置かれているような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "彫刻……でしょうか？　変わった見た目ですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それに、嫌なにおいもしますし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "あまり見ない方がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "それより、私のそばを離れるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "――レユニオンの姿があるな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ここは、音を立てずに片付けるとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
