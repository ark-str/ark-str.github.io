{
  "server": "jp",
  "storyId": "act40side_level_act40side_st02",
  "groupId": "act40side",
  "stageId": "act40side_st02",
  "title": "雷公栗",
  "storyCode": "OR-ST-2",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act40side/level_act40side_st02.txt",
  "sourceHash": "70d5093bb5d2acd3826d2bca15d22675c3ec40723a745ab4a4480f3558805792",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "随分と悠長ですね。今年の龍門では中秋節のイベント事がたくさん催されているというのに。一つも出席されないつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "何に参加するという。テレビでまでこの老いぼれの顔を見たい者などいると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "スワイヤー家の娘に考えがあるようだからな、彼女に任せておけば賑やかにしてくれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "……玉門から帰ってきて以来、日に日にお暇になっているように見受けられますよ。家では日がな書斎で点心を摘まんでいるばかり。外に出なければ、晩年に福々しくなってしまうかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "はは。ここ半年リン・グレイも養生して大して出歩いていないからな、朝のランニングの供も見つけられん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "ふっ……寄る年波には勝てないものだ。若者たちは才気煥発で、仕事に耐え得る能力もある。手を出せば無粋だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "今になってその道理が理解できたのですね。もっと早くにそう考えられていたら、チェンちゃんは出て行っていましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "どれだけ経ちましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "何のことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "チェンちゃんですよ。出て行ってから、どれだけ経ちましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "五年だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "五年ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "一体あの子は外でどんな経験をし、病の方はどのような状況なのでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "先般に玉門を訪れていた頃、あの子もそこにいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "フェイゼは壮健だ。剣術にも上達が見られた……悪くないと言えるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "それで？　あの子が去って行くのを、またそのまま黙って見ていたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "私に会いに来なかったということは、まだ帰ってくるつもりはないということだろう。無理強いはできん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "安心しろ。彼女の歩む道は、我々よりも長いのだからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "影衛",
      "text": "ウェイ閣下、お手紙が届いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……わざわざ君たちに運ばせる手紙か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "影衛",
      "text": "都からです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "送り主は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "影衛",
      "text": "禁軍でございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "手紙以外に、その方から言付けはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "影衛",
      "text": "真龍は、ウェイ閣下を百珍宴の席に招いております。共に月を愛でたいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "手紙は机の上に置いておけ。君は下がるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "影衛",
      "text": "恐縮ですが、ウェイ閣下はいかがされるおつもりでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "私には私の考えがある、心配には及ばない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "影衛",
      "text": "我々は喜んでウェイ閣下を都まで護送いたします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……下がれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "招待状がどういう書きぶりなのかをご覧になりますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "必要ない、そこに置いておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "いずれ来ると分かっていた日だ。むしろ、私が想像していたよりも少し遅かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "……何年になりますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "四十年……百灶を去ってから、丸四十年だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "日数からして、玉門も都に着いている頃だろう。どうやら我が弟は多くの古帳簿を一息に清算するつもりらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "よく「秋終わって清算する」と言うが……秋か、よく言ったものだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "行かずともよいのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "四十年も前のことだというのに、彼はどうしたいというのです？　また禁軍、あるいは軍隊を派遣して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……みだりなことを口にしてはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "今この時期、弟にそのつもりはないはずだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "それでは、彼は一体どうしたいのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "お前には、あの日々のことをあまり話してこなかったな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "結構ですよ。聞きたくありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "フミヅキ、私は人生で多くの者に申し訳ないことをしてきた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "エドワード、妹、亡き師……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "言うなれば……弟も、そのうちの一人なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "なぜ、あれだけ多くの命を奪ったのは地位であると言わないのですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……選べた者など誰もいなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "では、あなたのせいではありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "仮に当時あなたが残っていたら、事態は好転していたとでも？　血は流されなかったとでもおっしゃるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "民のために嘆願した大臣のことを覚えている者なんていませんよ。皆の記憶に残るのは君主を、親を殺した皇子のことだけです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "質問があれば手短にお願いします。急いでおりますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "今の自分の立場をわきまえなさい。理論上はあなたも事件現場で取り締まりを受けた容疑者です。同僚のよしみから、取調室で質問を受けていないにすぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "言ったでしょう！　現場で犯人を目撃しました。でも捕らえることができなかったのです――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "落ち着きなさい。犯人を捕らえられなかったから、ここで私にうっぷんを晴らしたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……そのためには貴方に勝てる見込みがないと無理でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "ああ、そこまで状況が見えていないわけでもないようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "では大理寺で何年も共に働いてきたよしみで教えなさい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "なぜ今日の午後、鼎豊楼の事件現場にいたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……事件の捜査です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "百珍宴を間近に控えた時期に、先立っては文書保管庫が焼かれ、続けて鼎豊楼で二度も火災が起きました。この一連の事件の背景に何らかの繋がりがあると思わないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "まさか、今日何者かが鼎豊楼に放火するとあらかじめ知っていたため、事前に向かって待っていたと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "手がかりの調査に向かったにすぎません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "手がかりの調査に「すぎない」……ここ数日のあなたの数々の行動を列挙しましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "私をつけていたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "私もそこまで暇ではありません……しかし当然、それを知る術はあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "もう一度聞きます。リン・チンイェン。本日鼎豊楼に向かったのは一体誰を訪ねてのことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……こそこそと行動しているのは、私だけではないのではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "どういう意味です？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "あなたもそうでしょう。礼部所蔵のグー・チュエンの資料は偽造されたものであり、彼は百灶を去る前に死刑囚監獄に入っていたと伝えなかった……大理寺卿であるあなたが知らなかったとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "全て重要な証拠だというのに、なぜ大理寺の資料の中に記載が見つからないのですか、なぜ隠すのですか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "……それがここ数日で、文書保管庫火災事件のためにあなたが調べ上げた手がかりですか……？　どのように知り得たのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "それを知る必要はありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "当時ユー・チェンに忠告した言葉を用いて、今のあなたに同様に忠告します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "過去のことは、知られていることも、知られていないことも、全てに理由があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "……永遠に忘れ去られることが、最良の結果である物事もあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……まさか、そのような言葉が大理寺卿の口から飛び出してくるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "私のことは腹に権謀術数を抱え、刑部から転任してきた大理寺卿とでも思っておいてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "けれど、自分が何を話しているかはよく分かっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "私もよく分かっています。どのような理由があろうとも、真相は真相であり、誰かが弄んだり、意見を異にする者を攻撃したりするための道具であってはならないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "覚えている人は必ずいます。真相は残された人にとって、まだ意味を持つのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "例えばあなたが必死になって匿っている娘。ヴィクトリアから百灶に連れ帰ってきて、今は隣の部屋にいるあの者のことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "はい……グー・チュエンにはヴィクトリアに一人娘がいたことは調べがついています。グー・チュエンの事件において、彼女も重要な参考人です――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "リン・チンイェン、まだとぼけますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "すでに、グー・チュエンの資料が偽造されたものだということも突き止めたのでしょう。ユー・チェンがグー・チュエンの事件を追っていたことも知っているのであれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "恐らく調べがついているのではないですか。四十年前、禁軍に連れ戻され、文献上は死亡したと記録されている子供……その資料の真偽も疑っていますね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "あなたが百灶に連れて帰ってきた娘、彼女の出身地は果たしてヴィクトリアなのか、それとも百灶なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "よく分かっているでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "あの娘の素性を早くから疑っておきながら、それでも彼女を百灶へと連れて帰ってきたのは間違いがないように事を運べる自信があったからなのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "それとも、「真相」のためなら、彼女の生死など初めからどうでもいいからですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "脅しているのですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "冗談を言っているように見えますか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "リン・チンイェンは大理寺卿の持つ記録に全神経を集中させていたので、着ている服が濡れるほどに自分が汗をかいていることにすら気付かなかった。\nしかし次の瞬間、奇妙な光が煌めくと、薄い紙は大理寺卿の手の中から完全に消えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "ですが、これらは私が気にかけていることではありません。少なくとも今、最も気にかけていることでは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "言ったでしょう、過去のことが今のことより重要であるなど永遠にない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "あなたのおっしゃる今のこととは、何を指していらっしゃるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "知っていると思いますが、玉門は百灶から百里にも満たない場所にあり、百灶は三ヶ月前から、分割移動の準備をしています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……それもグー・チュエンの事件と関係があるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "この事件をこれ以上調査するのであれば、恐らく炎国において、答えを出せる人物は一人しかいないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "チンイェン、頑迷を貫くというのであれば、この扉から足を踏み出した後は、私でもあなたを守ってやれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン・チョー",
      "text": "……あなたではなおさら彼女を守れはしない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "チェン家の旧宅の書斎に、隠された棚がある。私が去った後、中のものを取りに行ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "そこに書いてあることに従えば、龍門の安寧とお前の安全を守ることができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "行かれるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "確かにいい頃合いなのだ。グレイの娘はスラムをうまくまとめ、スワイヤー家も老いぼれトラが一人で全てを担う必要はなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "龍門に今必要なのは、もはやウェイ・イェンウでも、総督でもない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "この場で遺言を残すのは、少し早計ではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "事は龍門の未来に関わる……フミヅキ、聞いてくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "私は多くの過ちを犯し、多くの後悔もしてきた……だが唯一この龍門だけは、私たちが一手に築いたこの……多くの人々にとっての家――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "龍門だけは、混乱に陥れてはならん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "ではあなたが龍門に留まり、しっかりと面倒を見てください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "若者には独り立ちできる能力があるでしょう。けれどまだ、この都市の世話をする年寄りが必要なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "この書簡はお前も見ただろう、どう目をつむれと言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "それでまた簡単に死を口にするのですか？　前回のように、自分の命を差し出すのですか？　それで償いになるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "……今回は違う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "私が向き合っているのはもう一人の敵ではなく、過去に作った借りにすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "当時の私はあのような選択をした……四十年来、何をするにも自分に言い聞かせようとした――顔向けができない者は確かに多いが、私の選択は間違っていなかったと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "だが、いつまでも逃げ続けることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "分かっていらっしゃるでしょう。あなたの命が、あなた一人だけのものであったことはありません。過去はご存じの通り、今は言うまでもないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "自分の命をもって何かを埋め合わせようと考えるのは、いい加減にやめてください。過ちで過ちを埋めても終わりはありません。私たちは長く生きてきたのです、この道理は心に刻んでいるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "龍門に残ってください。私たち二人で向き合いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "フミヅキ……止めてくれるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ・イェンウ",
      "text": "過去の償いについては……お前でも私を阻むことはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "では仕方ありませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "私がここに立っている限り、あなたはどこにも行けません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "イェンウ、今度は私が守る番です。私があなたを守ります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "レイズ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……ご無事ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "もちろん平気だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "例の大理寺の人は火災現場で何を見たかって聞いてきたけど、何も見てないって答えた！　ホントのことだしね。そしたらすぐに解放してくれたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "君の方こそ、どうしてこんなに時間がかかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……もう大丈夫です、帰りましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "待って待って！　どうして帰るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "モー・ブフーは明らかに色んなこと知ってるみたいだったし、今から話を聞きに行こうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……何も聞くことはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "どういう意味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "あなたの父の事件に関して、私はもう触れないつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "数日のうちに、あなたを百灶から送り出します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "レイズ！　それなんの冗談なの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "いや……さっき、何か新しい手がかりを見つけたんだよね？　だからわざと冗談言ってるんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "もうよしてよ。ほら早く教えて、一体何に気付いたの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……ホァン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "なっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "こちらは大理寺の正式な資料です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "グー・チュエン……ヴィクトリア帰国炎僑、1077年礼部入職、奉礼郎に任命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "1092年、礼部宣礼使に任命、ヴィクトリアへの使節団に同行。途中吹雪に見舞われ、川に転落し死亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "レイズ……嘘だよね……？　また私をのけものにする気？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……あなたの父はどうやって亡くなったのか、ずっと訊ねていましたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "全ての手がかりを調べ終わりました。何も疑わしい点などなく、単なる事故でした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "これまで不足していた資料は、全て補完されました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……この事件は、これで終わりです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "中秋が次第に近づき、夜空に月は見えない。\n街中のエネルギー杭は依然最高出力で稼働していたが、察しの良い者は気温がいつもより下がっていることに気づくだろう。\n夜が更けて街が静けさに包まれる。人波は散って、冷ややかな風が吹き込む。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "ハクションッ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "寒いんだったら、暖房をつけたら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "簡単に言いますけどね。この小さい店が潰れないようにするには、こうやって少しずつ節約しないとダメなんですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "じれったいなぁ、こんな時間なのに、ホァンさんたちからの知らせはどうしてまだ来ないんでしょう？　ちゃんと会えたんですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "あんたが気にしてるのは賞金でしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "な……何言ってるんですか！　ハクションッ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "この窓から隙間風が吹いてません？　今度修理しないと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "あれ、帰ってきたかな……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "あ……あなたは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "なんだ？　この店は客を入れてはくれんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "どうぞどうぞ、お茶をお持ちします……何かご注文なさいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "麺をくれ。長寿麺を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "か、かしこまりました、すぐにお作りします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "ここの店主が作ったものを食べたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ジャンが振り返る。元々階段の上に立っていた小さな料理長はとうに姿を消していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "えーと……うちの料理長は用があって出かけていまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "ではここで待つとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "遠くまで出かけていて……帰ってくるのは半月後ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "それでも待とう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "三十年、老骨となるまで待ってきたのだ。待てないことなどあろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "モー料理長、冗談はよしてください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "あなたは天下一の料理人なんですよ。そんな方が三十年も待つ価値のあることなんてありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "*炎国スラング*……私のどこが天下一か！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "モー・ブフーは湯飲みを持ち上げ、一気に飲み干した。\n温かいお茶が彼の口元からこぼれ、白髪交じりの髭を伝って滴り落ちる。"
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "はっきりと記憶している……三十年前の冬、天災が故郷の村を破壊した。私はこの料理の腕を頼りに、他の生存者と共になんとか百灶で生計を立てられないかと考えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "道中苦労しながら百灶を目指し、いよいよたどり着くという時に、また別の被災者に遭遇した――あるいは盗賊だったのかも分からんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "彼らは得物を携えて、凍てつく荒野で何里も私たちの後をつけてきた。しばらくして、我々のわずかに残った物資と食料を狙っていたのだと思い至った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "山を越え川を渡って、一ヶ月あまりも旅を続けていたので、我々の中には負傷者や病人も多かった。残っていた食料では、ついてくる連中の分まで賄えないのは明らかだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "かといって逃げるほどの余力もなく、進退窮った我々はいっそ正面から戦った方が活路が開けるのではないかと考えた。そして衝突しようという時、なんとも場違いに良い香りが漂ってきたのだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "辺りを見回すと、ほど近くに古寺があり、その入り口のそばで竈を作って、どうやら麺を茹でている者がいた。湯気のせいで顔はよく見えなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "なぜこんな所で麺を茹でている者がいるかは分からなかった。しかし我々は尋ねることも考えることも、そして周りの者たちと命のやり取りをしていたことも忘れていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "その匂いを嗅ぎ、湯気が立ち上るどんぶりを見て、全員が静かに彼のそばに立って麺が出されるのを待った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "あんなに美味いものを食べたのは初めてだった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "麺を口に入れた瞬間に、まるで何十年と麻痺していた舌が突然生き返ったかのように感じたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "何の飾り気もない一杯の麺が、これほど魂を揺さぶる味になるなどと、私は知らなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "あれはこの世のものとは思えぬ美味さだった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "麺を食べ終えて顔を上げると、その人はすでにいなくなっていることに気付いた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "生涯をかけて料理を学んできたが、まさか最も印象深い授業が、百灶郊外の小さなぼろ寺で受けるものであるとは思いもよらなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "その後、いつの日かあの麺を作れるようになるために、私は至る所で弟子入りして学んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "しかしどうしても作れなかった……私には、ついにあの味は作れなかったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "記憶違いだったりしませんか……ほら、当時はお腹が空きすぎていたせいで、やたら美味しいと感じたとか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "私の舌が間違うとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "一杯の麺だ。色褪せることなく記憶に残り続けるあの麺を、三十年も探し求めた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "当時のあの人物がもしまだ百灶にいれば、今はもう五十を超えているだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "北の茶水翁を訪ねたが、違った。南の麺点王も、また違った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "探し回った果てに、同輩の老いた料理人たちは皆が鍋を置き、私だけが残った。もう諦めようとしていた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "しかし今日、再びあの味に出会ったのだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "なぜかは分からん……あの娘の料理の腕は未熟だったが、彼女が差し出してきた麺は、間違いなくあの時の味だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "あの麺は、ここの料理人が教えたのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "鼎豊楼の選抜大会で送った招待状は百通、私は全て把握している。この「余味居」の評判も、昔から耳に入っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "この店の料理人が、あの人物とどのような関係かは分からんし、なぜ自身の才能を埋もれさせているのかも分からん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "しかし私にはできない……長年受け継がれてきた技術を、私の代で途絶えさせることなどできはしない。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "モー・ブフーは立ち上がり、懐から取り出した手紙を机の上に置いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "……ここの料理人に伝えておいてくれ。彼の半人前の弟子は合格だと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "明後日の午の刻までに、鼎豊楼へ来るように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "えっ……？　ご、合格？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "商売は繁盛しているようだな、この扉の敷居はまた低くなったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "十年以上換えてませんので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "敷居が低くなれば、風が防げなくなる。今後はより一層に冷たい風が吹き込むことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "店主が換えようとしないんです。低い方がいい、高くすると、世の腹を空かせた人たちが来づらくなると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モー・ブフー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "モー・ブフーは低い敷居を跨ぎ、果てしない夜の闇の中に消えた。\n飯屋には、広間を抜ける風だけが残された。風の音が次第に大きくなった。泣いているかのように、訴えているかのように。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "……もう行った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "はぁ……あなたって人は！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "ホァンは試験に合格したの？　なら賞金は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "よくもまあ、賞金のことを考える余裕がありますね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "どうして人を困らせるようなことするんです……七、八十歳のご老人なんですよ。あんなに焦っているのに、よく黙って見てられますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "お眼鏡にかなう弟子が見つからないってだけでしょ？　何を焦ることがあるんだ……私ですらそんなことないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "相手の気持ちを考えてもみてくださいよ。生涯をかけて磨き上げた技術が途絶えようとしてるんですよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "だったら途絶えればいいでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "もう――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "彼が見てるのは後世の名声で、背負っているのは天下一の称号、心の中で気にかけているのは他人の料理の腕ときた――そんな人がどうやって自分の腕を理解できるっていうんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "この関を越えられないようじゃ、誰も彼を助けてあげられないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "おや、ホァンさんおかえりなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "もう遅いけど夜ご飯まだですよね？　腹に入れるものを用意してきますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "おめでとう、いい知らせがあるよ。あんたは鼎豊楼の試験に合格した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "前の約束通りに賞金は七三で分け――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "反応薄くない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "もしお金にまったく困ってなくてどうでもいいっていうなら、残りの三割も――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "あれ？　シィンズゥさんは一緒じゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "そうだ、シィンズゥちゃんは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "そういえば、午後にジャンが買い出しに行った時に一回帰ってきてあんたに手紙を残していったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "手紙……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "貴殿は鼎豊楼の料理人選抜試験に合格いたしました。つきましては――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "あぁ、そっちじゃない、こっちだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "わざわざ手紙で言うなんて、どんな秘密の話なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "彼女から……家に招待された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "……ニン府だって？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
