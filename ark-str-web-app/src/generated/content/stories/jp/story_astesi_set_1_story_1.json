{
  "server": "jp",
  "storyId": "story_astesi_set_1_story_1",
  "groupId": "story_astesi_set_1",
  "stageId": null,
  "title": "照らし出す光",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_astesi_1_1.txt",
  "sourceHash": "b9d29a3a1000fbdf0b28ee6040fb33dc51ee11812193631635c678774df99ace",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "ロドス本艦\nアステシアの部屋"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（目をこする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "私の記憶違いでなければ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "この本には、今夜は観測に最適だって書いてあったはずよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "何か収穫が……あるといいのだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（思わずもう一度目をこする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "近頃私が出している観測結果は、占星術研究協会が発表したデータと乖離しすぎているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "お父様はきっと……この結果を不満に思うでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "それを思うと、お返事を書くのは少し時間を置いたほうが良さそう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "鉱石病……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（無意識に目じりをこする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "今夜はいつもより詳細な記録を取っておきましょう。推測が疑わしい以上は、まずは正しいデータが必要だものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（目じりを軽くおさえる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "うう～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "目がかゆい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "姉さん、来たよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あ、おはよう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ちょっと、どうしたのその目！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ああ、これ？　大丈夫、ちょっとかゆいだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "両目が充血しちゃってるし、内出血も起きてるよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "すぐ治るわよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "うわ、ものもらいみたいになってる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ほっといて自然に治せる範疇はもう超えちゃってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "すぐ医療部へ連れて行ってあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "だけど、今夜は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "星なんか気にしてる場合じゃないでしょ。流れ星を見たって姉さんの目は治らないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ほら、行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ま、待ってってば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "細菌感染ですね。両目共に、急性の化膿性炎症を起こしています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "幸いそこまで深刻な状態ではありませんし、切除して薬を塗ればすぐに良くなりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ただ、術後三十六時間は目の上から包帯をしたまま過ごしていただくことになりますから、万一に備えて医療部に留まり、安静にするのがいいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "その手術、遅らせることはできるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "……先生、この件は私が判断するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "では、まずご家族と患者さんの間で相談してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ねえ、ジーニ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "何言ったってダメなものはダメだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "事情はわかってるし、それが姉さんにとって大事なことだっていうのも理解してるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "それでも、何度でも言うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ダメなものはダメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "私にとってどっちのほうが大事かくらい、わかるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "姉の同意が取れたので、手術の用意をお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "アステシアさん、本人への口頭確認も必要なのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）それで、お願い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "それでは、同意書をよく読んだ上で、ご家族のサインをこちらに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "（同意書を読んでサインする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（同意書を受け取り、端末に情報を入力する）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "このあとは、受付でベッドの割り当てを行います。術後は病室まで直接患者さんをお連れしますので、ご家族の方はそちらで待機してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "アステシアさん、こちらへ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "手術自体はそう難しくありませんので、安心してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "術前にご説明した通り、全身麻酔を施しますが、よろしいですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（うなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "では、始めましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（麻酔を注射する）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "1から10まで、ゆっくりと数えてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "1",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "2……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数時間後――"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……えますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "聞こえたら手を動かしてみてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小指を震わせる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "患者の意識回復を確認……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "手術は成功しましたよ、アステシアさん。もう少ししたら、看護士があなたを病室までお連れします。夜には、私が巡回診察に向かいますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "何か違和感があれば、すぐ私に知らせるようにしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ここまで聞こえていたら、頷いていただけますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（何とかうなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "問題なさそうですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "医師の足音が少しずつ遠ざかり、ベッドが水平に倒されると、廊下へと押し出されていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "床との摩擦で軋む車輪が耳障りな音を立てる。\nしかし、それ以上にうるさく感じたのは、医療部の医師や、患者、付き添いの人間たちの声だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？？？",
      "text": "もう少し我慢してちょうだいね、ポプカル。もうすぐあなたの番だから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？？",
      "text": "ったく、今日はどうしてこんなに患者が多いんだか……おーい、次は誰だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？？？？",
      "text": "お金は払ったでしょ？　どうしてその契約書にサインしないといけないの？　ああもう、わかったから速く持ってきて。姉さんを病室で待たせちゃうし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "かゆすぎでしょ～……このマニキュアでアレルギー起こすなんて知らなかったんだけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "人の声が無意識下の感情を乗せ、あらゆる方向から聞こえてくる。\n落胆、後悔、恐怖……アステシアには、それがはっきりと伝わってきた。\n彼女の心に微かな不安がよぎる。\n普段であれば、苦しむ人たちをいくらか慰めてあげられるかもしれない。\nだが今は、彼女自身も床に伏せる患者なのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "患者を乗せて廊下を進んできたベッドがゆっくりと止まり、向きを変えて病室の中へと入っていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "医療オペレーターたちはてきぱきとベッドを固定して、病室での注意事項を説明してくれた。\nそして、患者の容態に問題がないことを再度確認すると、彼らはすぐに病室を出ていた。\n扉が閉じられた瞬間、医療部の喧噪はアステシアから離れていく。\nそこには静寂だけが残った。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ジーニ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "麻酔の効果が薄れてくると、彼女は口を開き、妹の名を呼んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ジーニ……そこにいるの……？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "返事はない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "誰かいる？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "部屋には彼女の声だけが響いている。\n無力感がその心へと押し寄せてきた。\n彼女はかつて、人々を導く占星術師だった。\nだが、今では他人のために道を示すどころか、自らの前途を見定めることさえできない。\n源石が身体に根付いたあの時から……\n星々は沈黙してしまった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "高名な占星術師の中には、感染者であることを公表している人もいるのを彼女は知っている。\nそして、自分の感染を知った父の態度も覚えている。\n「心配の裏に喜びを滲ませているような」……\nそれゆえに父は、娘が感染を経てさらに優秀な占星術師になるどころか、何一つできなくなってしまったことを知った時、失望を隠しはしなかった。\n......\n恐らく、星々もとうに愛想を尽かしているのだろう。源石漏洩に晒された実験室と一人で向き合う妹を、怯えながら安全な部屋でただ眺めていただけの臆病な人間に……\n星空は彼女への憐れみを捨て去り、その代わりに源石の反射光だけがそこにある。\nそれはきらきらと輝いて、人の心を突き刺すのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（小声）姉さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（小声）具合はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……ジーニ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "うん、私。ここにいるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "医療部の入院手続きがややこしくてさ。静かな個室を確保したいって交渉してたら時間がかかっちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "個室って……また無駄遣いして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "大したことじゃないよ。ちょっと設備費を調整すれば済む話だし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ねえ、どうしたの？　手汗がすごいけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "何でもない……大丈夫よ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "目のほうはどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "かゆみは収まったわ。フォリニック先生がしっかり処置してくれたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "なら良かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "姉さんったら、いっつも私に早寝早起きしなさいってうるさく言うくせに……どうして自分はこうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "まだ天体観測のこと考えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "今夜はこの数ヶ月で一番観測条件の整った日だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "もし包帯を取ろうとしたら、すぐ先生にお願いして拘束具を借りてくるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そんなことしないわよ、ただ考えてただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "目のほうが大事だもの、大人しく言うことを聞くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "んー……だったら良いんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "観測したところで、父さんは良い返事なんてくれないと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "どうしてそれを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ここ何ヶ月かの観測記録と解析結果を読ませてもらったの。協会のものとかなり食い違ってるんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あなた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "手続き用の身分証を探してたら、ちらっと見えちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "あの書類、机の上に置きっぱなしで、別に隠されてもいなかったし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……あれ以来、お父様にも協会にも、正しい推測データを提供できなくなったの。叱責されるのも当然よ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "実は、記録を基にシミュレートしてみたんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "姉さんの観測結果は全部正しいと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "慰めなんていらないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "私だって完全に専門外ってわけじゃないのは知ってるでしょ？　天体観測は好きじゃないけど、教育はそれなりに受けてきたわけだしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "正しいものは正しいし、間違ってるものは間違ってる。それだけのことで嘘をつく必要なんかないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "姉さんの目が治ったら、私がデータモデルを使って全プロセスとその可能性をリストアップしてあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "つまり、協会のデータが間違ってるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "やれやれ、姉さんって父さんに似て石頭だよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "どっちも正しいって可能性もあると思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "研究分野ではよくあることだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "データ一つ取ってみても、色々な要素の影響を受けるのは当然のことだよね。ロドスはクルビア領内にあるわけじゃないんだから、地理的な位置も観測環境も全然違うでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "それに、天体運動は不規則なんだから、ここでのデータがクルビアのものと一致してたら、そっちのほうが問題じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "でも、方位に基づいて計算のロジックは調整したのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "落ち着いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "姉さんのデータが正しいのは、その調整をしてるからこそだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "子供の頃、父さんの教えたやり方を身につけるのは私のほうが少し早かったけど、解析と推測に関しては、姉さんのほうがずっと正確だったでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "それに、父さんがいつも正しいとは限らないっていうのもそろそろ覚えたほうがいいよ。向こうに疑われたからって、自分が間違ってると思い込むのはやめよう、ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "（小声）まあ、私もこんなこと言える立場じゃないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "こほん！　とにかく、病気が治ったら協力してあげるから。どうしてもって言うなら……一緒に家に帰って、父さんと話してあげたっていいよ。それでどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……ジーニ、手を握ってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "子供じゃないんだから……はい、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（妹の手を軽く握る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ありがとうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "姉妹なんだから、お礼なんていらないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "あんまり考え込まないで、今はゆっくり休んで元気になってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そうするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "そうだ、何か食べたいものある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "アイシングケーキを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "オッケー、ナッツのクッキーとベリージュースね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "そうだ、夕飯はお弁当作ろうか。ここに来てからは姉さんがいつも料理をしてくれてるし、たまには私の手料理も味見してみてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "じゃあ準備してくるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "（ゆっくりと姉の手を離す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "左のテーブルに果物を切って置いといたから、食べてね。一つ一つ爪楊枝を刺してあるんだけど、食べたら楊枝はお皿に戻しといて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "それとそっちの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "枕元のすぐ右に、姉さんの天球儀を持ってきといたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "うん、これだけあれば大丈夫だよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "それじゃ、またあとで。お大事に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "病室の扉が閉じて、アステシアはまた一人きりになった。\n目の前は依然として真っ暗だが、天球儀の緩やかで落ち着いた作動音を聞いているうちに、暗闇で過ごすのもそれほど苦痛ではないかもしれないと思えるようになってきた。\n妹の励ましを受けて、自分の問題を見つめ直すことができたのだ。\nしかし、これで独り立ちできていると言えるのだろうか？\n恥ずかしいことに、アステジーニと比べると、そうとは言えないのは確かだろう。\n妹が理想の人生を求めて足かせを破り抗っていた時、彼女は父親の疑念を否定する勇気すら持てずにいたのだから。\n占星術というものは伝統を重んじる学問で、現代科学ほど厳密ではないとはいえ、それなりに長い歴史を持っている。そして古くから存在するものには、権威が生まれるに最適な土壌があるのだ。\n彼女はとうに、自身が行う探求や疑問は必ず先達によって否定されるか、決められた回答を与えられるだけだと気付いていた。内心賛同していなくても、それを喜んで受け入れてきたのである。\n正しいのは常に彼らと決まっているからだ。\n権威に否定されることを恐れるがゆえに、彼女は彼らの結論を全面的に受け入れ続けてきた。\nそれがなぜ、鉱石病への感染をきっかけに、その壁を打ち破れたのだろう？\n権威を否定するか、己を否定するかというジレンマに直面したからだろうか？\nそれとも、妹の身を挺した行動を目の当たりにして、自分もようやく長年の疑問と向き合う勇気が持てたからだろうか？\nアステシアはその答えを出せずにいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二回食事を作りに行ったのを除けば、アステジーニはずっとアステシアのそばにいた。妹と共に過ごしていると、病床での生活もそこまでつらくはないと思えた。\nやがて、夜の帳が降りてくる。アステジーニは姉のそばにいてやりたいと考えていたが、そんな彼女にアステシアは少し考える様子を見せてから、やはり宿舎に戻るようにと説得した。\n今まさに荒野を進むロドスの頭上には、一面に輝く星空が広がっていることを、アステシアは知っている。\n彼女はそれを幾度も見てきたが、今なおその中に潜む不確実性に魅了されている。できることなら、ずっとそれを見続けていたいと願うほどに。だが今は――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ジーニ、どうかしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？？？？",
      "text": "巡回診察に来ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "フォリニック先生。どうもありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "目の調子はどうですか？　かゆみはないですか？　涙が止まらないとか、発熱があるとか、異物感などの問題はありませんか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ないわ。あなたのお陰ね、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "であれば、回復は順調に進みそうですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あなたの声、なんだか疲れているように聞こえるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "毎日こうですから、もう慣れてきましたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "他にご用事がなかったら、ここで一休みするのはどうかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "お恥ずかしい話なんだけど、妹が果物を切りすぎちゃって、一人では食べきれないと思っていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "もうすぐ就寝時刻ですし、今日の巡回はあなたで最後ですから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ここで……十五分くらい休んでもいいかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ありがとう、先生。ベッドの横に椅子があったと思うから、よければ座ってちょうだい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ええ。……アステジーニさんの選んだ果物はどれも身体によさそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "実は私たち、昔からこれが大好きなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "一つ質問があるんです。もしかしたら気を悪くさせてしまうかもしれませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "どうぞおっしゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "私は、占いやオカルトに詳しいオペレーターさんとは、あまりお話ししたことがなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "そうした人たちは、いつも全知全能の存在として振舞っているように思いますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "本当に未来を予知できるのなら、どうして自分の病気を回避することすらできないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "私は自分を全知全能だなんて思ったことはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ただ占星術師の家系に生まれて、小さい頃からそれを学んでいたというだけなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "誰かを助けたいと思った時、私に使えるものなんて……あなたからすれば曖昧で無駄に思えるだろう知識しかないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "だけど、クルビアのエリートであろうと、開拓隊の文字が読めない若者であろうと、誰しも自分の経験だけでは説明できない事象に遭遇するものでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そんな時、彼らは人知の及ばぬ不思議な力に頼って迷いを払拭したいと願う……そこに、こういう技術を身につける理由があると私は思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あなたにも、迷う時くらいあるでしょう？　フォリニック先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……あなたには理解していただけないと思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そういえば、知ってる？　今日の夜空で一番明るい星座は、ウルサスを表すものなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "確かにあなたの心の痛みを理解してあげることはできないけれど、非科学的な方法でも、ある程度のいきさつを察することはできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "私には、あなたを慰めることはできないわ。あなたにとってそれは無意味な嘲笑に等しいでしょうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ふふっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "あなたが医者になったとしたら、間違いなく心理学の大家になりえる器ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "誉め言葉として受け取っておくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "とはいえ、どんなに優秀なカウンセラーでも、自分がある日突然目の病気に罹るなんて予測できないものなのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そうなった時はやっぱり、堅実に知識を身につけてきたあなたのような人に治してもらうしかないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……そろそろ時間ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "おやすみなさい、アステシアさん。明日私が巡回に来る頃には、目が見えるようになっていると思いますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "病室から出ていく前に、医師はアステシアのためにテーブルライトを消していった。アステシアは、今夜の星空を想像しながら眠りについた。\n妹が科学を愛するように、彼女は幼い頃から空に浮かぶ星々を愛していた。\n天体観測には、生まれた家の影響だけでなく、後天的に得た趣味としての側面もあるのだ。\nそれゆえに、拒絶や否定を受けてしまうと、彼女の心には悔しさが生まれる。\n権威に拒絶されたことよりも、自分がすべてを理解できていないことへの悔しさが。\nしかし、こうした幽玄の知識は学べば学ぶほど、自分の矮小さを実感するものだ。\n星空に抱いた疑問の答えなど、本当に存在するのだろうか？\nアステシアにはわからない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "それでも、一つ確信を持っていることはあった。\nそれは――荒野で一人夜道に迷った時、人は星空を見上げ、共に歩む星々の煌めきに励まされながら、苦境を脱するまで前へ進み続けるしかないのだということだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "陽光が包帯とまぶた越しに瞳へ差し始めるのを感じて、アステシアは目を覚ました。\nそうして彼女は妹の来訪を待つ。\n妹さえ来てくれたら、その肩を借りて手洗いに行き、歯を磨き、顔の包帯で覆われていない部分を拭いて、軽く身体を動かしてからもう一度ベッドに戻ることができる。\n待ち望んでいた扉を開ける音はすぐに耳へと届いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし、やって来たのはアステジーニではないようだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "調子はどうですか、アステシアさん！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "トミミ、どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "さっきまでガヴィルさんといたんですけど、お前とよく一緒にいる奴が昨日病室に運ばれたぞって聞かされて、急いで駆けつけてきたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "大丈夫ですか？　すごく重傷みたいですけど……目から血が出るまで殴られるなんて、一体誰にやられたんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そこまでの傷じゃないわ。ただ細菌が入ってしまっただけだし……もうじきに治るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あ、でも、枕元に歯ブラシとコップ、それからタオルがあるかどうか見てくれるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ありますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（ベッドから起き上がる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "じゃあちょっとそれを持って――洗面台まで行くのを手伝ってくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "もちろんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ゆっくり歩いてくださいね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "着きましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい、アステシアさんの歯ブラシと、歯磨き粉と、コップです。歯磨き粉はつけといてあげましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "大丈夫よ。タオルも横に置いておいて。あとは自分でやるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい、わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（手探りで歯ブラシに歯磨き粉をつける）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そういえば、最近宿舎の片付けをして、台座をいくつか置いてみたんです。そこに物を乗せたら、ガヴィルさんが目を輝かせて「トーテムへのお供えみたいで面白えな」って楽しそうにしてくれて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（曖昧な返事をする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それから、少し前に看護能力資格っていうのを受けてみたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "試験はあんまり得意じゃないんですが、ちゃんと合格できたので……将来的には、お医者さんの仕事を一緒にやってもいいってガヴィルさんが許可を出してくれたんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（歯を磨きながら頷く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それとそれと、私、今バイビークさんからお裁縫を教わっていて……一通り覚えたら、私も皆さんにお似合いの服を作ってあげられると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "アステシアさん、どうしてお喋りしてくれないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（口の中の水を吐き出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ちゃんと聞いてたわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（タオルを洗う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "頑張ってるわね、トミミ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えへへ……アステシアさんがアイデアをくれたお陰で、最近はなんだか、やりたいこととできることが増えた気がするんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "やりたいこととできること、ね……ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（丁寧に顔を拭く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "でも、そういう良いことがいっぱいあったせいで、大変なことも起きたんですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そうだったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（タオルを絞る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "とりあえずベッドまで一緒に戻ってくれる？　話は座ってゆっくり聞くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "気をつけてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "足元に注意して……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "着きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "よいしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ふぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "トミミ、座ってちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "もう座ってますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "じゃあ教えて。大変なことって、何が起きたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "宝物のお世話とか、ガヴィルさんのお手伝いとか、バイビークさんのところでお裁縫をしたりとか、ほかにもたくさんやりたいことがあるので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "最近はちょっと時間が足りないなあって思っていて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "もしかして……何かを諦めようとしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "確かに、私には好きなことが多すぎるのかなって考えたこともありました。ロドスにいると、趣味以外にもやらなきゃいけないことがたくさんありますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "だけどその、楽しいことを先送りにするのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "もったいないわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうなんですよ、その通りなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "でも、どうすれば時間に余裕ができるのか、全然わからなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "何もかも大事にしたいと思うのは人間の本能なのよ。チャンスを逃したら二度と取り戻せないこともあるんだし、自分を責めることはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あなたはまだよく知らないかもしれないけれど、時間を上手く使うことも大きな学問の一つなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "私も詳しくはないけど、教えられることは何でも教えてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ありがとうございます、アステシアさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "その学問も、占星術なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "星々は道を示してくれるかもしれない。でも、前に向かって進むことに関しては、占星術は役に立たないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "それに必要なのは自分の意志と、とてつもない努力だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "とはいえ、私が思うにあなたならそれができるんじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "は……はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "それで、明日の午後は本屋さんに行く予定？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "じゃあ、明日会いに行くから、雑誌を買ったあとゆっくりお喋りしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "さあ、もう行きなさい。今頃、助手がいないってガヴィルさんが文句を言ってるかもしれないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "た、大変！　すぐに行かないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ありがとうございました、アステシアさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "どういたしまして。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ははあ……今の子、姉さんの友達？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ふーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "顔はもう洗ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "前が見えてないのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "私の目になってくれた人がいたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "確かに、まだ一日しか経ってないのに姉さんのお見舞いに来る人がドアの前で列を作ってるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "ふふ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "text": "じゃあ、今日は何食べたい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......\n夜が近付き、一日せっせと働いていたアステジーニは姉のそばで眠りについていた。\nアステシアは、もうすぐ光が戻ってくるという期待と共に、暗闇がもたらす静けさを味わっていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "アス……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）アステシアさん。目に異常はありませんか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）おかげさまで、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）では、包帯を外しますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "医師は道具を手に取ると、アステシアの目を覆った布を切り落としていく。\nそうして、ガーゼで余分な軟膏を拭き取った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）おめでとうございます。無事に治りましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）ベッドランプは暗くしておきますね。目が慣れてきたら明るくしても構いませんので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）当面はお酒を飲んだり、刺激の強い物を食べたり、激しい運動をしたりするのは避けるようにしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）それと、術後用の目薬は処方箋を妹さんに渡してありますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）……ところで、週末にでも、時間を取れたら少しお喋りをしに伺えたらと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）……私にもカウンセラーが必要かもしれないので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）いつでも歓迎するわ。……おやすみなさい、フォリニック先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "（小声）おやすみなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "医師が去った後、アステシアはゆっくりと目を開いた。疲れ切った妹が寄りかかっているベッドの横には、アステシアが天体観測の記録用に使っているノートが置かれている。\nノートを開くと、一番新しいページには彼女とよく似た筆跡で、アステジーニが昨夜の天体に関する詳細を細かく記録していた。\nその一部には誤りがあり、天体の名前にも明らかに間違っているものがあった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし、それが何だというのだろう？\nアステシアはノートを閉じて、窓の外の夜空を見上げる。\n今夜の空に星は見えず、月さえも暗雲に覆われて、一筋の光も放てずにいた。\nそれでもこの時、彼女の目は星々の如く――\nきらきらと光り輝いていた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
