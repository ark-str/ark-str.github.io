{
  "server": "jp",
  "storyId": "act20side_level_act20side_01_beg",
  "groupId": "act20side",
  "stageId": "act20side_01",
  "title": "没入型ツアー",
  "storyCode": "IC-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act20side/level_act20side_01_beg.txt",
  "sourceHash": "6af4cde57941bb7860e1466fdb58613bfd10d448478377e0b12600be6c07ce6a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そっちは危険だよ。ボク、来た道を全然覚えてないのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "子供扱いするな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ただ、その、ちょっと道の特徴が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕みたいなエキスパートがガイドにいなきゃ、この子だけじゃこんな危険な洞窟は手に負えなかったんじゃない？　この僕でも、少々気を引き締めなくちゃいけないくらいだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "というわけで、今のうちにテントを張って休憩したらどうかな？　苦手な人がいたら僕が手伝うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんた本気なの？　こんなところで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "もちろん。ここは広くて空気の通りが良いし、雨風をしのげて温度もちょうどいいでしょ。それにとても暗いから、アイマスクだっていらないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うーん……エリジウムさんの言う通りだと思います！　ですがロドスの外勤用テントにはまだ慣れてなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "大丈夫さ、僕が教えてあげるよ。このタイプはね、設営がとても簡単で、開けばすぐ使えるんだ。あとは留め具を数ヶ所固定すればっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わあ！　本当に簡単ですね！　とっても便利です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "でしょ？　支援部がこのテントを設計する時ね、サバイバルのエキスパートであるこの僕に相談してきたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "このシリーズに僕の名前を使ってもいいよって気前よく許可をしてあげたんだけどね。なんで採用しなかったのか謎だなぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "うーん、もしかしたらこのテントにはまだ改善の余地があるから、まだ僕の名前を使うには値しないって判断したのかな？　まったく水臭いよね、僕はそんな細かいこと気にしないっていうのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……トミミ、あんたがロドスでうまくやってるって聞いて喜んでたんだけど、今こうしてみるとなんだか怪しいわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんたたちロドスは、昇降機の中でテントを張って寝るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "いえ、エリジウムさんは結構特殊な方ですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "もう一度言っておくけど、これは普通の昇降機じゃないぞ。オレたちドゥリン人が誇る、超便利大エレベーター壱号機なんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "うん、テントを張るのに便利だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "なっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんたたち、はしゃいでないで静かにしなさい。スディチ、あとどのくらいであんたの言う地下都市に着くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "もうこのエレベーターに乗って三十分は経ってるしね。いつになったらつくんだい、ボク？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だからオレは子供じゃないって……はぁ、もしかしてオレが部族の連中から聞いたガヴィルに関するめちゃくちゃなエピソードって、アンタたちも関わってたりする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そりゃそうだよ！　あの人にはいつも殴られてばかりなんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……アンタらさ、やっぱりもういいから帰ってくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "いや、いつもは言い過ぎかな。三週間に一回とか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "待ってください！！　エリジウムさんとガヴィルさんはただの同僚ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私はガヴィルさんが一番頼りにしている相棒であり、アカフラ最強の部族「ガヴィルウィル」の族長なんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……後半は、まぁぎりぎり嘘はついてないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……ハハッ、寛大で献身的な協力には感謝するよ。この都市はアンタたちを歓迎する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "（小声）地上のあの超絶ブッサイクな鉄道機械が、役に立てばいいんだけどね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "スディチ、何か言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "いや、別に。もうすぐ着くよって言ったんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "地上のみなさん。ようこそ、地下都市ゼルウェルツァへ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ドゥリン人の都市を訪れる機会は地上人にとっては貴重だろ。ましてやこんな美しい──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ねぇねぇねぇあれは何だい！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "大きな滝？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "お……大きな滑り台です！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "いや、あそこは重要じゃない。それより向こうの庭園がある美しく洗練された──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ドゥリン人の都市ってこんなに先進的だったの？　私はてっきり、その……もっと素朴なカンジかと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "雑誌には「神秘的な地下宮殿」みたいに書いてあったわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ゼルウェルツァはドゥリンの都市の中でもかなり特殊な例だ。というのも、ここはオレみたいな伝説的デザイナーたちが建設した都市だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "先人たちがここへやって来たのは、美と調和に満ちた都市を作り上げるためだった。そして彼らの理念の継承者であるオレたちによって、あの美しく！　洗練された──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "スーパースパイラルスライダーじゃないか！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "アカフラは面白い場所だってディランから聞いた時、彼はニヤニヤしてたから嘘だと思ってたんだ。でも本当だったんだね！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わー！　すごいすごい早く見に行きたいです！　今度は絶対ガヴィルさんも連れて来ます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ところでドゥリン人たちは、商売に興味はあるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレの作品は、あのでかいだけのガラクタと比べて、そんなにパッとしないのかよ！？　アンタらの脳は、シンプルなものの美しさが理解できないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "もういい……オレは頼む相手を間違ったみたいだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ふぅ、この近くのはずなんだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "部族の年寄りにアカフラの地下には大きな洞窟があるって聞いてはいたが、こんなに複雑だったとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "どうやらトミミたちが言ってたことは本当らしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "最悪の場合、アタシたちティアカウだけじゃなく、この地域全体の住民にまで影響が及ぶかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "そこまで深刻じゃないわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいや！　どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "そりゃもちろん、お前さんたちが面倒事にぶち当たったのを察してのう、様子を見に来たんじゃ。わしは全知全能の大祭司じゃからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "だったら教えてくれよ、どうやってあの伝説の地下都市に行きゃいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "そう焦るでないわい。小娘たち、地下洞窟の奥深くまで来るような機会なんぞ滅多にないのじゃからな。周りの景色を堪能しようではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ほれ、この蛍光植物を見るがいい。お前さんたちに一つ秘密を教えてやろうかの。これを粉にして、焼いた鱗獣肉に振りかけると、そりゃもうたまらん旨さなんじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "それとこのツルに生っておる実じゃが──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいや、私たちは急いでるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "わかったわかった。あの安全な道へはどう行くんじゃったかな？　確かまずは左に曲がってそれから右、さらに右に曲がって左だったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "それでもって、四回続けて左に曲がるんじゃったかのう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "それ元の場所に戻るだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "そうか？　おかしいのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ちょいと思い出す時間をくれんかね。……うむぅ、この地下洞窟はうねうねくねくねしておってややこしいのじゃよ！　さては右に曲がって坂を上るのか？　それとも下るんだったかのぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "もういい、危険な道ならどうやって行くんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "お前さんは、相変わらずせっかちじゃのう。幼い頃と変わっとらんわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "確かにちぃとばかり危険じゃが、早く行ける道ならあるぞい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "あの川が見えるか？　あれに飛び込むんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "本気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "お前さんたち二人の身体能力なら、恐らく心配ないじゃろうて。しかし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "よーし！　ズゥママ、準備はいいか。深呼吸して──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "行くぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "じゃがな、やはり焦らずわしについてきた方がよいと思うぞ。実はだな……ん？　あやつらどこへ行きおった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "とにかく、ここがゼルウェルツァ、オレたちドゥリン人の都市だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "アカフラの地下にこんな場所があることを、今まで知らなかったなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ゼルウェルツァは昔からずっとここにあったよ。だけど冒険物語に頭をやられたバカ以外は、オレたちも普通はそこまで地上に興味を持たないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "まあ、オレは例外だけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "君は冒険物語が嫌いで頭がやられてるタイプなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ああ、オレは冒険物語が嫌いで……待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "その手は食わないぞ。オレはバカでもないからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "全くそうは見えないけどね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "こほん、改めて自己紹介をさせてもらおう。オレはスディチ・ブランクキャンバス、この都市で最も優秀な建築デザイナーの一人だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "見たらわかると思うが、この都市で、見た者の心をぐっと動かすような建物は、みんなオレがデザインしたんだ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "もしかして、あの巨大滑り台ですか？　スディチさん、私、ちょっと見直しちゃいました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "や……あれは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "じゃあきっとこの都市のドームのことだね。太陽光まで似せることができるなんて、おチビちゃんもなかなかやるじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "アンタたちさ、どんなセンスしてるわけ？　この都市の一番良いところがわかんないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "えーっと……緑化が良い感じよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "どうやら、アンタたちはまだまだセンスを磨く段階みたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "せっかくの機会だし、オレの依頼に着手する前に、この都市の真の英知の結晶とも呼べる場所を案内してやってもいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "このスディチ・ブランクキャンバスの自宅だ。オレがデザインしたもので、コアとなるコンセプトは深い思想に……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ほらあっちの──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "見てくださいイナム、あのお店は何を売ってるんでしょう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "水着かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すごく可愛いです！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんたのスタイルじゃ、ドゥリン人の服は入らないわよ。何よりその太い尻尾……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ううう、尻尾のことは言っちゃだめです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "見るのは別に自由じゃないですか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "おい、そこの二人……おーい！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "エリジウム、あの二人を連れ戻しに──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの物売り",
      "text": "は～い、どうもまいどあり～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "う～ん、この焼きキノコの食感。異郷の風味ってのは、やっぱり一味違うね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "食に関してはケーちゃんは素晴らしい専門家だよ。アカフラのキノコも絶対食べなきゃいけないけど、アカフラ地下のキノコはもっと珍味だ！　君も一本どう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……馴染みすぎだろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "うぅ……頭が痛ぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "兄弟、耐えろ！　これしきのことで、あんたが負けるはずねぇ！　今までの数々の困難と辛かった日々を思い出すんだ！　俺たちはあれに耐えてきたじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "病気がこんなんなったら仕方ねぇよ。今までお前たちと一緒に過ごせて、とても楽しかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "きっとまだ方法はある、きっと何か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "あの不思議な液体はどうだ！　兄貴を元気にしてくれるおかしな液体があったろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "あぁ、そうだ。まだあの不思議な液体があったな。あれを飲むと、なんでか生きる気力が湧いてくるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "そこの通りすがりの心優しい人！　助けてくれ！　俺たちと一緒にあの魅力的な名前を叫んでくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "そこの太い尻尾のお嬢さん、お願いだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "え……私ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "さぁ、心のままに、あの名前を叫ぶんだ、三、二、一、はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "口を揃えるドゥリン人",
      "text": "カールミード！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えーっと……ガヴィルさんお手製ミートスープ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "ちょっと待てぇい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "全然違うじゃないか、ふと尻尾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そ、その呼び方はやめてください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "アヴドーチャはどっからこんな変な奴を連れてきたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "アヴドーチャ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "待てよ……お前たちはカールミード愛好家協会の者じゃないな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "アヴドーチャ以外で、協会員にお前たちみたいなシラフがいるはずはねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……判断基準、そこなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "どうするよ兄貴？　「心から愛するものを叫ぼうぜキャンペーン」は中止にするか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "そいつはダメだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "お前は、地上からやってきたリーベリだろ？　ここで会ったのも何かの縁だな。こっちきな、ちょうど酒が残ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "イナム、この人たち酒樽を持ち歩いてますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……一体どこからあんな大きな樽を取り出したのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "こいつはゼルウェルツァで一番の酒だ！　それを認めようとしないわからず屋たちもほんの少しだけいるけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "ちょっと味見してみないか、リーベリ？　きっと後悔はしないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "君たち……本当に熱心だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "ほらほら遠慮はいらねぇって！　特にあんたみたいな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "イケメン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "天然であんまシラフに見えねぇ奴は、俺たちの協会に入るにはピッタリだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕が人とは違うオーラを持っているってことかい？　アハハ、そこまでの評価を受けたのは初めてだよ。まさか僕に自分ですら気付いていない一面がまだあったなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ならお言葉に甘えて、一杯もらおうかな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "そっちの嬢ちゃん二人も、良けりゃどうだい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ええ、私も貰うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ちょ、ちょっとだけなら！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "待てって！　なんで酒盛りが始まりそうなんだよ！　オレの手伝いをしてくれるんじゃなかったのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "ん？　お前は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "親愛なるゼルウェルツァ市民のみなさん、大物建築デザイナーを目の当たりにして、緊張してしまうのはわかるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だけど、実はこの暇そうに見える人たちには、やらなきゃいけないことがたくさんあるんだ。だからオレたちは失礼するよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "なあ、お前も一杯どうだ？　うまい酒だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレ？　遠慮しとく、オレは酒は飲まない主義だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "頭を使って問題を解決する数少ないドゥリン人として、アルコールで思考を濁らせたくないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "口を揃えるドゥリン人",
      "text": "……ケッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……何だよその顔。どうして酒樽を持ち上げてるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "聞き間違いじゃねぇよな、こいつ今なんて言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "こいつ、酒を飲まない主義だって？　しかもアルコールで思考を濁らせたくないだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "同胞たちよ、大事件だ！　他所もんが俺たちの街に紛れ込んでやがるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "酔っ払いが！　目をしっかり開いてよく見ろよ、他所者はそいつらの方だろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "こいつに教えてやらねぇとな、自分がどんなデタラメをのたまっているのかをよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「堅氷よりも硬く、冬の日よりも長く、涙滴よりも静かで、ため息より虚しい。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「イノヴァはいまだ、己が去ったあの午後のことを忘れられない。小さな町は、咳き込む巨人のように鉄錆を吐き出して、血の痕を残したのだ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「彼女は幾度も倒れては起き上がった。歩みを止めたことは一度もない。彼女の願いはささやかなものだ。夢のない土地で、何をするでもなく過ごせる時が欲しいだけだ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「ささやかな望みとして、そこに一杯のお茶か、薄い酒を付け加えることもあるだろう。楽しむことは罪ではない、少なくとも彼女にとっては罪にはなりえない。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「彼女は……一体何を追いかけ、何から逃げているのか？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「その彼女自身ですら、答えを知らないのだ。」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
