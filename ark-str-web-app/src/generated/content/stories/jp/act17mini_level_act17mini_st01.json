{
  "server": "jp",
  "storyId": "act17mini_level_act17mini_st01",
  "groupId": "act17mini",
  "stageId": null,
  "title": "花火の如く落ちて",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17mini/level_act17mini_st01.txt",
  "sourceHash": "63df78fc17f763da879febee10cca8f8845aadad1708412687d6225cb7ef09f2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "p.m.9:30　天気/曇天\nカズデル　生活エリア"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "炉に燃える炎は～♪　カズデルの太陽さ～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "童の服を乾かして～♪　戦士の胸を温める～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おとなしい駄獣",
      "text": "（蹄を踏み鳴らしてリズムを取る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おとなしい駄獣",
      "text": "モ～モ～",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "炉辺はカズデルにゃ珍しい良い所さ～♪　ケチな商人や敗残兵が争い合っている～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "この*サルカズスラング*！　誰に向かってほざいてやがる！　歌唄いの分際で、毎日毎日壊れたスピーカーみてえにギャーギャー騒ぎやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "俺らがあのヴィクトリア人どもに負けただと？　違う、俺たちは――ええと、何て言うんだっけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "戦士たちは気慰みに言う～♪　休養期間を取っただけ～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "そう！　急用帰還だ。急ぎの仕事が入ったもんで……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "だけど駄獣さえ知っている～♪　彼の荷物は空っぽで～♪　離れて久しい娘からも～♪　嫌～われ～てる～♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "中継炉の火を囲む人々は楽しげな笑い声をあげた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すると程なく、けたたましい音が鳴り響き、笑い声はピタリと止んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "ぐっ……戦士は怒れる裂獣と化し……♪　死の、拳を、お見舞いしてくるが……♪　僕を救える人がいるとすれば……♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "それはただ一人……彼女だけ！　さあ、おでましだ～～♪♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てふためく少女",
      "text": "あと5分で儀式が始まるっていうのに、まだこんなところで騒いでるの！？　楽譜だって規制線の上に置きっぱなしじゃない！　早く荷物を炉端からどかしなさい、おんぼろギター！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てふためく少女",
      "text": "それから、鉄頭さんも！　規制線から離れなさい！　お友達の駄獣の毛皮が焦げちゃってもいいの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "おお、ニンフ、お前も来たのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "そう慌てんな、安心しろって。こんなちっこい上にボロい炉が、どんくらい火花を散らせるかなんざ、俺のほうがよくわかってるっての。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "あやうく頭が割れかけて～♪　いま僕は思い出した～♪　そもそも炉中の魂に～♪　別れの歌を書きたかっただけだと～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おとなしい駄獣",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "三十過ぎだからって偉そうにしないでよね。昔は昔、今は今なんだよ。これまではレヴァナントを燃やしてエネルギーにしてたこの炉も、もうすぐ新しいエネルギーに切り替わるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "エルミーが、今夜は炉の中からレヴァナントを呼び出す大事な儀式があるって言ってたよ。万が一何かが起きて、炉が「ドカンッ」なんてことがあったら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ちょっと鉄頭さん！　人の話聞いてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "俺がどれだけ死線をくぐってきたと思ってるんだよ。あのフェリーンの都市防衛砲だって、こいつらには傷一つ負わせられなかったんだぞ。こんな火花くらい怖がるこたねえだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "そんなことより、炉が温まってるうちに、この剣を鍛え直す方が大事なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火に当たる駄獣",
      "text": "フン、フン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "もう……どうして言うことを聞いてくれないの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "だったら、実力行使するからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "おい、駄獣を引っ張るのはよせ！　そいつらは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "わっ……きゃあ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "……お前と仲良くなろうとして、体当たりしてくるからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "理不尽こそが条理～♪　迫害する奴だけが迫害を免れる～♪　ご先祖はすべてを見てきたが～♪　もうすぐ自由になれそうだ～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "ふざけんな。サルカズはサルカズを迫害したりしねえよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "（蔑むように口笛を吹く）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "うう……いたた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "ニンフ、お前も大変そうだな。広場にゃこんなに大勢集まってるってのに、本気で全員家に帰らせるつもりなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "本当に追い払いたきゃ、お前のジャールの能力使って、脅かしてやりゃあいいじゃねえか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "だ、ダメだよ。そんなひどいことできるはずないでしょ！　サルカズはサルカズを迫害しちゃいけないもん！　それに、ジャールの能力は軽々しく使っちゃダメなの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "はいはい、わかったよ。カズデルのジャールで――いいや、サルカズで一番心優しいジャール様。そんじゃ、引き続き頑張りな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフが振り返ると、炉の中継広場には騒々しい歌声と、物売りの声、武器を叩く音が絶え間なく響いていた。\n視線を遠くに向ければ、そびえ立つ魂の炉からは黒煙が立ち上り、レヴァナントのささやき声がかすかに聞こえてくる。\nそれは二百年もの間、日夜エネルギーを中継炉に送り込み、カズデル内に無数にある家々へ供給し続けていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "儀式はうまくいってるのかな。炉の中のレヴァナントたちは、どうなってるんだろう……考えてみれば、レヴァナントってどんな姿をしてるのかも知らないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "はぁ……儀式の間は、この区画の人たちの安全を守るってエルミーと約束したのにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "カズデルのサルカズって、どうしてみんな、全然言うことを聞いてくれないんだろう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どういうつもりだ？　これでは最後まで読めんじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "なぜそう癇癪を起こす？　何度も何度も、飽きもせずに。どうあれ儀式の材料は、お前たちの身体から取り出すわけではないだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "これ以上、ここで排気ガスを吸うのは御免なんだ。少しくらいは協力してくれないか？　そうすればお互い多少は楽になるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "とにかく、さっき読んだところはもう読まんぞ。どのみちお前たちも聞かんだろうしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "「魂の炉の使命は間もなく果たされ、汝らの焼身の痛みも終わりを迎えるであろう。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "「ゆえにこそ、サルカズの魂による見守りのもと、ここに祈りを捧げん……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ちなみに、儀式の祝詞の中には「祈り」とあるが、お前たちも知っての通り、これは「告知」だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "それと、「典礼を待て、痛みを増やすなかれ」というのは、人に迷惑をかけず大人しく待て、という意味だ。現状都市内にはやるべきことが山積みだが、時間ができ次第、盛大な儀式を執り行おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "その時には、家に帰りたい者は帰ればいい。残って手伝いたい者は残ればいい。手持無沙汰ゆえ殴り合いたいというのも構わん。城壁を壊さなければな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "聞こえたか？　聞こえたなら何か言ってみろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ああもちろん、お前たちが閉じ込められて窮屈な思いをしていることはわかっているとも。我々後代のサルカズも無情ではない、ゆえにこそ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "お前たちをそこから出す方法を考えているわけだろう？　だから騒ぐのはよせ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "*サルカズスラング*、まったくこれは何事だ！　散々道理を説いてやったというのに、聞き入れんつもりか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "それが万年以上を生きる者の態度なのか！　年長者としてのプライドを持ってもらいたいものだ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老いたリッチが大声で怒鳴りつけると、炉から飛び散った燃え殻が彼の顔や頭を目がけて降りかかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "先生！　そちらは大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "計器に表示されているエネルギー量が不安定なのですけれど……何か問題でも？　お手伝いは必要ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "げほ、ごほ……ッ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "不要だ！　手出しするな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "*過激なサルカズスラング*……誓ってやるとも。今夜のうちに、この老いぼれどもを片付けられなければ、マンフレッドの靴磨きでもしてやるとな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "げほ、ごほっ……ごほっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍事委員会の衛兵",
      "text": "将軍閣下。一日中こちらを見張っていらっしゃいますでしょう。そろそろ休まれたほうがよろしいかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "この儀式において、今は最も重要な時だ。いかなる問題も起きてはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "総員、持ち場について見張りを続けよ。何か異常に気付いた際は、ただちに私へ報告するように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍事委員会の衛兵",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ううむ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "この時季のカズデルは、やはり少し冷えるな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "ねえ、あんた本気でその「旧友」たちに会いに行くつもり？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴァナントの長者",
      "text": "今日は……長き歴史の終わる、重要な日だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴァナントの長者",
      "text": "こうした献身は彼らの本意ではなかったとはいえ、結果的に、彼らは自らの万年に渡る艱難辛苦をサルカズのために捧げたのだ。ゆえに我は、彼らに敬意を払う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "でも結局、あいつらを捕まえて炉の中に押し込んだのはあんただったんでしょ。ほんとに和やかにお喋りなんてできるわけ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴァナントの長者",
      "text": "テレジア殿下は、我に理性を取り戻させ、明瞭な意志を与えてくださった。今の我は心中に陰りなく、無意味な怒りに囚われてもいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴァナントの長者",
      "text": "彼らに会わせてくれ。さすれば、我が彼らの怒りの炎を鎮めてみせよう。この手で始めた苦難の歴史は、この手で終わらせるべきなのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "チッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "……うまくいくといいけどね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "炉で炙られる魂が～♪　抱くは恨みか憎しみか～♪　はたまた喜び悲しみか～♪　このまま去りそれでいいものか～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "ほらほら、そこでボケッと炉を眺めてる暇人ども、うちの名品を見ておくれ！　見た上で買わないってんなら、見る目がないってもんだよ！　そこの嬢ちゃん、うちの……って、またあんたかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ぷくぷく財布のおばさん！　この前は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "っとと、危ない。君、痛くなかった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "駆け回っていた少女はニンフに向かってあっかんべーをすると、足早に去っていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ねえおばさん、お客さんがいないんなら、早く荷物を規制線の外に運んじゃってよ。あたしも手伝うからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "ああ、構わないよ。どうせ暇だしね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ほんとにいいの？\nよかった。じゃあ始めよっか。"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "その前に、場所代をもらおうか。これだけの大荷物を動かしてほしいとなりゃ、まずはこの場所を貸してやることになるからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ば、場所代？　でも、ここってもとは誰のものでも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "今はあたしのもんなんだよ。炉端は人も多いし、暖かくて良い場所だろう。一日三食全部がここで済むし、家のエネルギーも無駄遣いせずに済む。絶対まけてやれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "それと、今の情報はタダってことにしてやるけど、これ以上話すつもりなら、その分の見返りをもらうことになるよ。ほら、商売の邪魔だ、行った行った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あのねえ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフは魂の炉の方角を心配そうに見つめた。錯覚だろうか？　炉から噴き出す煙がますます濃くなったように見える。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あたしにピッタリな仕事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "オッケー！　最近ちょうど懐が寂しくなってたから、ほんと助かるよ、エルミー！　で、何をすればいいの？　物の修理？　それとも駄獣の世話とか？　どれもちょっとは心得があるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "まさか。「人の気持ちがよくわかる」ニンフさんに、そんな雑事を任せるなんてもったいないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "そうですわね……どういった役職がいいかしら。区画長……なんていかがでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "区画長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "たった今思いついた呼び名ですの！　具体的な仕事内容としては、この近辺の面倒ごとを片付けるというものですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ご存知の通り、ヴィクトリアの件があってからというもの、こちらはそもそも人手不足なのです。おかげで、街の秩序維持に人員を割くことはなおさら難しくなりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ですが、皆の安全を守ることについては、あなたはいつもよくやってくれているでしょう。何しろあなたは、カズデルで一番人の気持ちがよくわかるジャールですもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "そ……そうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "でも……まあ、何となく事情はわかったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "みんなの安全を守る、ね……あたしに任せて。全力で頑張るから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ねえおばさん、あたしがこの場所を借りたら、規制線の外に下がってくれるんだよね？　約束だよ！　それじゃ、ちょっと待ってね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あれ、あたしの財布は！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "待って、絶対あるはずなのに……あっ、別のポケットかな？　……そんな……もしかしたら、家を出る時忘れてきた……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "とんだ間抜けに出くわしちまったみたいだね。それともまさか、正真正銘のお人よしなのかい？　いや、そんな奴いるはずもないし、やっぱりただの間抜けかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "財布がなくなっちゃった……でも、儀式はもうじき終わっちゃうだろうし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "おばさん！　お願いだから、お店をたたんでくれないかな。あなたが動かないと、鉄頭さんもきっと動かないだろうし、このままじゃみんな大やけどしちゃうよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "フン、あのバカまだあたしに難癖つけてんのかい？　あいつが戦争行ってる間、家を荷物置き場にしてただけなのに？　別に、出発前はダメとも何とも言わなかったじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "それに、あいつの留守中、あたしゃ何年もあいつの娘を育ててやってたんだよ？　なのにあいつはすごすご逃げ帰ってきて、値打ちもんの一つも持ってないときた。丸っきり育て損だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "何が育ててやってただ、この*サルカズスラング*！　娘を泥棒なんかにしやがって！　俺はあいつに立派な名前を付けてやったし、読み書きも学ばせようとしてたのに、お前のおかげで台無しだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ちょっと、ケンカはやめてよ。炉の……規制線が……それに時間も……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "あっ！　あれって、あたしの財布！？　ねえ君、ちょっと待っ――\nきゃっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少女に転ばされたニンフは地面に倒れ込み、泥だらけになった。その後、大勢に笑われながらも引っ張り起こされた彼女は、困り果てた様子で、口ゲンカする二人を見つめた。\n人々は相変わらず好き勝手に動き回り、誰も中継炉の規制線から出ようとはしない。一番聞き分けの良い流浪の歌手ですら、あぐらをかいて座り込み、炉の火明かりを借りて曲を書いている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギター弾きの歌い手",
      "text": "なぜだろう～♪　彼女の望みは～とても単純なのに～♪　叶えるのはすごく難しい～♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "まだ終わってないの？　なにをグダグダやってんのよ。今までは順調だったじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "お手上げだってんなら下がってなさい、あたしがやるわ。ねえ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "はぁ。ウィシャデル、誰の許可を得てここに来たんだ？　儀式中は誰も近づけるなと、エルマンガルドには言っておいたはずだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "来るだけならまだしも、なぜその方まで連れてきた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "あんたが上に行ったきりちっとも音沙汰ないから、何かあったのかと心配して来てあげたのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ただ冷やかしに来ただけだろう！　私の心配だと？　そんなことより自分の身でも案じておくんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "この先祖どもをとっ捕まえて、焼き甘イモみたく丸焼きにしたのはあたしじゃないのに、何を心配しなきゃなんないって言うのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "やれやれ、実に結構だ。そのような態度でレヴァナントとの対話に臨む輩は、大抵ろくな目に遭わんものさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "負債？　我にそのようなものはない。\nすべては……必要な代償だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我はお前たちを迎えに来た。\nお前たちの使命はもう終いだ。\n我はこの狭き煉獄から、お前たちを連れ出しに来たのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "お前たちの怒りは理解できる。その怒りは、喜んで引き受けよう。\n我はただ、お前たちを連れ出し、今のカズデルを見せてやりたいだけなのだ。\nそこから抜け出し、お前たちが育んだこの都市を見るがいい。この地は、お前たちが生きた証であり――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ふっ……\n我を哀れむ必要はない。\nこの傷だらけの魂は、もはや存分に燃え盛ったのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "ねえジジイ、こいつら何を言い争ってんの？　通訳して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ううむ……これが言い争いと言えるかどうかもわからんが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "あら？　急に静かになったわね。もう口ゲンカは終わり？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ぷっ……ぺっ、ぺっ！　灰が顔に……\n今度は何なのよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "これまでの奴らとの付き合いから言うと、今の行為は、概ねツバを吐くことに等しいものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "はぁ？　あたしは何にもしてないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィシャデル",
      "text": "*サルカズスラング*！　この老いぼれども、一体何やってんの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我に……このような……\n貴様ら……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まったく話にならん！！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "何事だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍事委員会の衛兵",
      "text": "将軍閣下！　艦砲が……我々の制御下を脱し、エネルギーを充填しています！　コアに残ったレヴァナントの断片の影響によるものと思われます！　現在――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "艦砲が勝手に起動しただと？　攻撃目標は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍事委員会の衛兵",
      "text": "見間違いでなければ……おそらく、魂の溶炉です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "今すぐ動力を断――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "奇妙な光がほとばしり、カズデルの夜空をかすめて、無数の痕跡を残していく。さながら燃え盛る雨のように。\nしかし、冷え切り疲弊した頑迷なカズデルは、いつもの如く沈黙を守り、それを懐に隠し続けていた。\nこんな時間にも、いまだ眠りに就くこともなく、小さな夜空に何かを捉えようとしている人々はいるものだ。\n何かというのは、たとえば……轟然と打ち上がる花火などである。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "溶炉が！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから微かに響く声",
      "text": "――誰が――撃ったんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "うちの屋根が……！　嘘でしょ。最近直したばっかりなのに……この大きな岩、一体どこから落ちてきたの？　……それにこの、焼けるようなにおい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "うっ！　頭が……熱い！　なんなの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "え？　な、なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ううん、屋根なんて気にしてる場合じゃないよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "みんな、聞いて。さっきの異変はきっと儀式に関係あると思うの。いつ炉が再起動するかわからないから、今すぐここから離れなきゃ危ないよ。規制線の後ろまで下がって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カン！　カン！　カン！　武器を直している傭兵が一心不乱に鉄を打つ、耳をつんざくような音が鳴り響いている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "さあ、通りすがりのお客さん、寄ってらっしゃい見てらっしゃい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "みんなったら……もう……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すると、鉄頭は槌を持つ手を止め、ぷくぷく財布のおばさんは客引きをやめ、流浪の歌手は弦をぷつりと切ってしまった。"
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "お、お嬢ちゃん……今なんつった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あたしは……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "なっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "みんなの安全のために……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "武器を直す傭兵",
      "text": "お、おい、落ち着け、寄るな……一体何するつもりだ？　俺の服も駄獣の毛も、全部……なんつったか、ええと……そうだ、可燃物なんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "そうよ、落ち着きなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "今すぐ規制線から出て。じゃないと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "じゃないと……\nあれ？　みんなどこに行っちゃったの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "広場の人々は次々とニンフの方を振り返っては睨んでくる。鉄頭は全力で戦友の駄獣を安全圏まで引いており、ぷくぷく財布のおばさんも、歳に似合わぬ驚くべき速さで屋台を片付けていく。\nニンフは腹部に軽い衝撃を感じた。見れば先ほどの少女が、盗んだ財布を彼女の懐に突き返し、一目散に逃げ出していった。\n流浪の歌手も、楽譜を脇に抱えたまま、安全圏につっ立っている。まるで最初からそこにいたかのように。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "わぁ、これって……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフは頭をかいて、頭の上に降りかかった輝く欠片を払い落とした。その欠片には、炉内の熱がいまだに残っている。\n欠片を取り除けば、彼女の頭の中に響く奇妙な声も、ピタリと止んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ニンフ！　聞こえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ニンフ――ニンちゃん！　返事をしてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "エルミー？　どこにいるの？　なんで姿が見えないのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "私が送った小さな箱の中の、鏡を見てくださいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "うわっ、なんで鏡の中にいるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "送った時にお話ししたでしょう？　また説明書を読んでくれなかったのですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "だって、リッチの創造物なんてちんぷんかんぷんだし。どうせ必要になったら助けてくれるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "で、何があったの？　炉の辺りでなんかすっごい爆発が起きたみたいだけど！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "レヴァナントをなだめる儀式でちょっとした問題が起きまして。ご先祖様方が暴れ出して、飛空船のレヴァナントと炉内のレヴァナントで争い始めてしまいましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "そうだったんだ。エルミーは、怪我しなかった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ええ、大丈夫ですわ。こんなことで怪我を負う私ではありませんもの。先生から用事を頼まれている分、少々多忙ではありますけれどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "それで、溶炉のことですが……炉自体は頑丈ですから、何の問題もないのです。けれど、爆発のせいでほかのトラブルが起きてしまいまして、またあなたの助けをお借りできたらと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "エルミーが無事なら何よりだよ。で、あたしに手伝えることがあるんだね？　何でも言って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "まずは空から降ってきたスラグを集めて、その中にレヴァナントの欠片が含まれていないかを確かめなければなりませんの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "レヴァナントの……欠片？　それって危険そうだよね？　この辺りでは、落ちてきた欠片を集めてる人がもう大勢いるんだけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "危険だからこそ、急いで探し出せと先生から申し付けられているのです。大溶炉内のレヴァナントは、一部を失ったことで今とても苛立っていらっしゃいますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "それに、方々に散らばったレヴァナントの欠片は時限爆弾のようなものですの。いつ厄介なことになるか、わかったものではありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "とはいえ、そこまで心配しすぎずとも大丈夫ですわよ。炉内に残ったレヴァナントの数からして、レヴァナントの残滓が染みついた欠片はほんの一部だけ。合わせて十にも満たない数ですもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ふぅ……ようやくいいニュースを聞けたよ。あの花火のあと落ちてきた破片は一万個じゃ済まないだろうし、探すのにどれだけかかるんだろうと思ってたとこだもん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "それもあながち間違いではありませんけれどね。この仕事の厄介なところは、欠片がどこに落ちたかがまったくわからないところですの。カズデルの隅々に散らばっている可能性がありますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "じゃあ、そのレヴァナントの残滓が染み付いた欠片って、どういう見た目をしてそうなの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "具体的な形までは、私も見ておりません。ですが、レヴァナントが付着した物体はかなり見分けやすいはずですわ。何しろ、近くの人の感情に影響を及ぼし、触覚まで変化させてしまいますので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それって、周りに煙みたいなのをまとってて、きらきら光ってるやつ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ええ！　恐らくそういったものかと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "じゃあ、探してるやつはこれかな……感情に影響を及ぼすっていうのは特に感じなかったけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "今は自宅ですか？　すぐそちらに向かいますわね。くれぐれもそれを誰にも触れさせないようになさってください。皆さんはジャールではありませんので！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あっ、うん！　家の近くの中継炉のそばにいるから、早く来てね。ふぅ……それにしてもこの石ころ、すっごく熱いんだけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "エルミー、おかえり！　先生はなんて言ってた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "いい知らせと悪い知らせが。良いほうから言いますが、あれはやはりレヴァナントの付着した欠片でしたので、先生の手で炉内に戻されましたわ。そして悪い知らせは、届けるのが早すぎたことで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "すぐに届けられたなら、いいことじゃない？　どうしてそれが悪い知らせになるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あっ、まさか……褒めてくれたとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "どうやらあなたも、あの人の性格はわかっているようですわね。あの爺さんが好意的な言葉をかけてくるのは、何か悪だくみをしている時ですの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "私は毎日、都市に出入りする物資をチェックして、市内のパトロールも手配しています。大溶炉に穴が開いた時に整備士を呼んだのも私ですし、リターニアから来た彼の荷物登録までしましたのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "今もこんなに忙しいのに、先生ったらまた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それじゃどうにもならないじゃん！　時間が全然なくて手伝えないから別の人に頼んでください、って言ってみなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "もちろん伝えましたわ！　それに、一個目をこれほど早く見つけられたのはあなたのおかげだということも添えて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それで？　考えを変えてくれたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "なに、そんな目で見て……待ってエルミー、まさかあなた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ニンフ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "お願いです、今回だけ手を貸してくださいまし。私、本当に手が回りませんのよ。あの爺さんが丸投げしてきた今、頼れるのはあなただけですの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "レヴァナントの欠片をすべて回収してくだされば、報酬はたっぷりお支払いいたしますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "あなたは衣食に困ってはいらっしゃらないでしょうが、この報酬はきっと欲しくなると思いますわよ。それに……こんな条件をお約束できるのは私だけです。先生ですら無理ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "もったいぶらずに教えてよ。考えてみるからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "今はまだ詳しいことは明かせませんけれど、どうかご安心くださいな。リッチはみんな太っ腹ですわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "まったくもう、頼み事してくる時は、いっつも隠し事するんだから……あたしじゃなかったら、とっくに逃げ出してるからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それじゃ、今すぐ欠片探しに出かけてもいいけどさ。ターゲットの位置がわかる地図とかないの？　ほら、上に小さな黒い点が浮かび上がったりするようなやつ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "リッチのことを、何でも願いを叶える機械だとでもお思いなのですか？　そんなおかしな物、あるわけないじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "とはいえ、確かにあなたの言う通り、このまま運任せで動き出しても、途方に暮れてしまいそうですわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "それに、レヴァナントの欠片をしまう道具もお持ちではないようですし……そうですね、あなたの鞄を貸してもらえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "これを改造するのに少々時間がかかりますので、一旦戻って休んでいただいても構いませんわよ。終わり次第、私のほうからお訪ねしますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "えっ？　てっきり一分も無駄にできない任務だとばっかり思ってたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "そこまで差し迫った話でもありませんのよ。それに、手に馴染む道具があれば、節約できる時間は数時間どころではないですもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "わかった。でも、地図の件はなんとか検討してほしいな。それじゃ鞄はここに置いとくから、また後でね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "レヴァナントの探知方法となると……隔離にはどうするべきか……ここを分解したら、ダメですわよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "エルミー？　先に戻ってるよ。いい知らせを待ってるからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "あっ、ええ、また！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "リッチって考え事にのめり込むのが早すぎるよね。いつかエルミーも先生みたいになっちゃいそうで心配だなあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ふわ～ぁ……明日は大事な任務があるし、早いとこ休まないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "今夜は、何人があの花火の夢を見るのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ふぅ……ふぅ……熱い……これが溶炉の温度なの？　焼き立ての甘イモを持ってるみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "初めまして。あたしや、あたしのパパとママや、おじいちゃんおばあちゃんが子供の頃から、炉の中で燃えてたレヴァナントの……おじいちゃんだよね？　さっきはすごい怒りようだったね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフは広場の隅の静かな場所に向かうと、階段に腰かけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あなたのことは送り返さなきゃいけないみたいなんだけど、やっと会えたから……今のうちに伝えたいことがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あたしね、子供の頃からあなたたちの存在を信じてたんだ。ほんとだよ。みんなは子供騙しだって言ったけど、あたしはずっと信じてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "子供の頃、お家の玄関から出てすぐのとこにバベルのテントがあってね。パパとママからはあまり遠くに行くなって言われてたから、いつもテントの中のお医者さんのとこまで遊びに行ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あたしが一番好きだったおとぎ話は、バベルのお医者さんたちが語る未来のお話だったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それから……バベルの大人たちが急にいなくなっちゃって……会いに行っても、もぬけの殻になっちゃってて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "その時はすごく悲しくて、中継広場の炉に向かって、泣きながら話聞いてもらったりしたな。地下にあるエネルギーを運ぶパイプが、あたしの声をおっきな魂の溶炉まで届けてくれるって聞いたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "でね、あたし、今あなたに会えてようやくほっとしたの。あたしたちを、カズデルの全部を守ってくれてたあなたたちが、ほんとに実在したんだって――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ご、ごめんなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフが目を丸くして見つめていると、陽炎のように微かな影が、発光する「スラグ」からにじみ出てきた。その声は、もはや先刻ほどのような怒りに満ちては聞こえなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "おんぼろだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "この街のこと？　あはは、見慣れればそこまで悪くないと思うけどね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "進歩がまるで見られん。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "……進歩？　えっと……それって、二百年前と比べて、かな。\n確かに……あなたは長いこと炉の中にいたわけだし、外に出るのは初めてかもしれないもんね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "手の中の、二百年間燃え続けていた欠片にもっとはっきり見せようと、ニンフは「スラグ」を持った手を前に伸ばした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "見て、レヴァナントのおじいちゃん。ここが今、あたしたちが住んでいる場所だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "これは何の音だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "おんぼろギターが歌ってるの。あの人が持ってる楽器は、散らばった廃品をかき集めて作ったものなんだ。ギターっぽい見た目してるんだけど、ほんとは何て名前なのかはあたしも知らないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "傭兵は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "鉄頭さんのこと？　お酒を飲んで、お友達の駄獣の周りで踊ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "……軍隊は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それって……軍事委員会のこと？　えっと、多分……ほら、あの上に飛んでるおっきな船、あの中にいるんじゃないかな。そう聞いたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スラグ」の影",
      "text": "休む――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "長い沈黙の末、スラグはそう言った。ニンフには、その言葉の意味がよくわからなかった。\nそう遠くない場所で、流浪の歌手が楽器を弾き、別れの歌を歌い始めた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
