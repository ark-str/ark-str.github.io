{
  "server": "jp",
  "storyId": "main_9_level_main_09-03_beg",
  "groupId": "main_9",
  "stageId": "main_09-03",
  "title": "一触即発",
  "storyCode": "9-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_09-03_beg.txt",
  "sourceHash": "626ea18f343f57c63baca9eeef62c4034f8dec131b288a47f7197ce355b5e854",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "この歌の後半って、こんな歌詞だったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "すごく、もの悲しい感じがする。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "ダミアンも逝ってしまうなんて……どうして、まともな葬儀すらさせてもらえないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "あの連中がダミアンを返すわけがないだろ。遺体を灰になるまで燃やしたら、その辺の土でも捨てるみたいに、都市の外へ適当に撒くに決まってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "う、ううっ……そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "最初はラウリー、その次はクリス、今度はダミアンだ！　なあ、グルニエ。ショーンが連れて行かれた時、連中は彼を鉱石病の感染者だとか言ってたが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "や、やめて。それ以上言わないで、ローナン。ショーンは……あの人は、偶然病気になってしまっただけなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "あの人は、貧しいのに勤勉で、真面目な人だった。私とあの子が少しでも良い生活を送れるようにと、いつもそればかり考えてくれていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "グルニエ、まだわからないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "あの連中からしてみれば、俺たちはネジみたいなもんだ。いくらでも替えがあって、錆びて使えなくなったら、迷わずゴミ箱に放り込むぐらいの価値しかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "たとえ錆び付いてなくたって、この都市に合うネジじゃなかったら……俺たちは同じ運命を辿ることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "あの連中は、俺たちが鉱石病に感染するかどうかなんて気にしちゃいねぇ。知らん顔だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "その証拠に、工場で毎月配布される予防薬だって、ほかの労働者たちには規定量渡してるのに、俺たちにはいつもその半分しか配られてない。ひどい時なんて三分の一だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "それに、防護服だって……なあ、ショーンの防護服は随分な使い古しだったよな。五年……いや、七年は使ってただろ。あんた、何度夜なべしてあの服をこっそり直してやったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "法案にせよ規範にせよ、何もかも奴らだけが甘い汁を啜れるようにできてるんだよ。それに引き換え、俺たちの暮らしはどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "俺たちがありつけるのは、奴らが捨てたジャガイモと腐ったリンゴだけだ。農地の隅から隅まで、俺たちの汗水と苦労で出来てるってのにな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "俺たちは工場で昼も夜もなく働いて、ただ命をすり減らすしかないんだ。そして働けなくなった頃には、連中のお望み通り、皆すっかり感染者さ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "そうなっちまえば、奴らが俺たちターラー人を全員都市から叩き出すにはいい口実になる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……ローナン。お願いだから、もうやめてちょうだい。そんなふうに言ったところで何にもならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "向こうにいるクライナたちを見て。皆、息子や兄を想って泣いているのよ。あなたたちの怒りのせいで、愛する人を失う苦しみを、あとどれだけの人にもたらすつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "いいや、違う。それはあの人殺しどもがもたらした苦しみだ。連中は時には病を、時には砲弾を用いて、俺たちの命を奪っていく。グルニエ、これ以上自分に嘘をつくのはやめろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "（声を抑える）……今朝、オブライエン家とコナー家の兄弟たちが訪ねてきてくれてな。全員、俺たちに加わると決めたそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "あんたら親子が苦労してるのは皆よく知ってる。今こそ、互いに助け合うべきときじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……うちの子にも、私にも、どうかもう近付かないでちょうだい。これまでショーンがあなたたちに良くしていたことに免じて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "グルニエ、俺はもう行くよ。あそこにいる奴、見えるよな？　あの制服を着た女だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "俺たちのルールは知ってるだろ？　俺はあんたを信じてる。だからあんたも、俺をもっと信じてくれ。もし、その気になったらシアーシャに伝えてくれればいいから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "こんにちは！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あ、行っちゃった。……おねーさん、こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "バリーさん……えーっと、ダミアン・バリーさんの家族のこと、知りませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あれ？　さっきおめーさんたちの歌が聞こえたから、場所は合ってると思ったんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "わ……私は、あなたが何を探しているのかは存じませんけど……ダミアンのお母さんも妹も、何も知らないと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "だったら、バリーさんと特に仲良しだった友達とか、倉庫で一緒に働いてた人とかはどうだべ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……私たちは、何も知りません……本当に……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "ううっ……ど、どうか！　どうか、私を捕まえないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "おわ！？　ご、ごめん……近付きすぎちゃったかな？　傷つけるつもりはないから、安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "随分びくびくしてるけど、うちの顔、そんなに怖いかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "い、いえ、何でもありませんから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "あの……もしお許しいただけるなら、もう家に帰りたいのですが……その、今朝の果物がまだたくさん残っていて、放っておくとすぐにダメになってしまいますから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "う、う～ん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……あれ？　あの人……ケリー大尉だよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……クライナ、私はただ一目君に会いたいと思っただけなんだ。君とフィオナが無事でいるかを、確かめたいと思って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "ああ、私のせいだ。けれど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……ほかに、どうしようもなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……ッ、もちろん覚えている。何もかも覚えているとも。ダミアンは……あの子は、私の甥なのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "私もあの子の成長をこれまでずっと見てきたんだ。私がペニンシュラ郡からヒロック郡へと呼び戻された日なんて、あの子が……私の帽子に、シャムロックをつけてくれて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "その頃、ダミアンはまだ幼い子供で……私、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……すまない。こんなことを、君たちに話すべきじゃなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "君の言う通りだ。……私は何もできなかった。ここへ帰ってくる資格なんてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……ダミアンは、奴らと関わりを持ってしまった。けれど私には、あの子を思いとどまらせるだけの時間がなく……大佐の命令に逆らうことも、できなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "それに私は、こうしなければならなかったんだ。すべてはヒロック郡のために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "私は君たちを、そしてこの都市を愛している。……だから、奴らが私たちの家を破滅させていくのを、何もせずに見ていることなんてできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……わかっているさ。クライナ、我が妹よ……君の赦しが欲しいわけじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……じゃあ……私は、もう行くよ。君は……君とフィオナは、どうか達者で暮らしてくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "明日にでも、また時間を見つけて会いに来るから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "いッ……な、なんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "お前、一体何の――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレイグ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……なんだ……子供か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "やれやれ……ケガはしてないかい？　あんまり走り回るんじゃないぞ……この道は何十年も整備されてないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレイグ",
      "text": "うるさい、裏切り者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "なっ――いきなり何を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレイグ",
      "text": "あんたは裏切り者だっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……ッ、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "クレイグ！　何してるの！？　早く戻ってきなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "あなた、そのボール……はぁ。どこに行くにもちっとも手放さないんだから。それで、クレイグ。またコナーさんちの兄弟のところへ行ってたの？　きっと、ローナンから何か言われたのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……やだ、手が真っ黒じゃない。採掘場の砂に手を突っ込んでたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "明日からは私と一緒に朝市に行きましょ。それと、しばらくはあの人たちに会っちゃダメよ。……あなたを、彼らみたいにはさせられないもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "「裏切り者」、か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……あの子の言う通りだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大尉は、暫くその場に立ち尽くし、同じ言葉を二度繰り返した。 そうして、ようやくきびすを返すと、去って行く。\n彼はひどく項垂れて、誰とも目を合わせようとはしなかった。 その様子を見て慌てて駆け寄ってきた年若い同僚すらも、例外にはならなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "待って、大尉……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "おい、お前たち――ここで何をしている？　さっさと家に帰れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "言ったはずだろう！　当面の間、街頭での集会を禁ずる、と！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っている男性",
      "text": "ここは俺たちの家だぞ！？　お前の方こそさっさと帰れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "――貴様、誰に向かって物を言っている？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "なッ……！？　何だ、これは……腐った野菜……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ふざけるな、今すぐ出てこい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "このターラーのクズどもが！　私の手で――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ちょっと！　道端でクロスボウなんて構えたら危ないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……誰だ、お前は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あ、軍令を受けて、事件の調査に来た者だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "なるほど。バーで起きた殺人事件を調べに来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "えっ……殺人事件？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "知らないのか？　我々の仲間たちが、そこのクズどもに何人も殺された事件だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……それって、ダミアン・バリーさんとも関係あるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ああ……聞いた話じゃ、奴は処刑されたらしいな。もしかして、あんたたちが捕まえてくれたのか？　そりゃ有り難い、感謝するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "捕まえた時は、事件のことなんて知らなかったけど……それじゃあの人、本当に亡霊部隊の人だったのかな？　うーん……まあ、一旦置いとこ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "私は奴が何者かなんざ知ったこっちゃないが、死んで当然だってのは確かだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "――おい、貴様ら聞こえなかったのか？　私は「集まるな」と言ったんだ！　ひそかに集会を行った場合、全員容疑者として逮捕するからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "だっ……！　この*ヴィクトリアスラング*――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "お、落ち着いて、おにーさん！　あの人たちのほとんどは、ごく普通の市民なんだよ？　身内を亡くしたんだから、集まってそれを悼むくらいは当然のことでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "わっ！　なんか飛んでき――って、腐ったジャガイモでねえべか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ハハッ、ほら見ろ。そうやって弁解してやったところで、この仕打ちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "あんたは好きなだけここにいるといいさ。私はクズどもが大人しくしてればそれでいいからな。……はぁ。こんな巡回を任されるなんて、私もツイてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "――おい、そこのゴミどもが！　もう一度言っておくぞ。集会は禁止だ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……うちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あいたっ！　はぁ、ここにいたら腐った野菜が大集合してきちゃうべ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "――そこの人、こっちだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "んえ？　あっ、待って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「報告！　第九防衛隊が襲撃されました――」\n「報告！　現在、第十三防衛隊が交戦中――」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ハミルトン大佐に会いたいの。もう一度取り次いでちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "できかねます。大佐は今、緊急対応に当たられていますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "あなた、二時間前にも同じことを言ってたじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "そもそも、私たちは昨日ヒロック郡に入った時点で、規定通りに任務内容の説明を提出しているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "それなのに、大佐は私たちを容疑者の取り調べに参加させず、あまつさえ容疑者を早々に処刑した。その上今は私との面会を拒絶しているとなると――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "一連の行動は、こちらの軍令の遂行に対する故意の妨害ともとれるけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "私にはお答えできない問題です、中尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "別に構わないわよ。誰かが聞いてるならそれで十分。私は言いたいことを言ってるだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "既に伝えた通りだけど、本件で盗難にあった源石製品の量は少なくないわ。これだけあれば小さな街を攻め落とすにも、中型移動都市を支えるキャタピラーを爆破するにも十分でしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――でも、一体誰がそんな物を欲しがってるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "並の盗人ならリスクが高すぎる行為よ。大量のヴィクトリア軍需品なんて、クルビアの庇護下にあるサルゴン最大のブラックマーケットですら買い手がつかないかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "だったら、犯人は誰なのかしら？　――改造費で小金を稼いでるような、現地の民間武器商人？　いいえ、彼らでは到底手に負えない代物だし、そもそも、そんな度胸があるわけないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "こんな物を手に入れて、私たちの捜査網をすり抜けることができるのは……軍事作戦を熟知している、よく訓練された部隊くらいのもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "だとすれば……大量の源石製品を手に入れた目的は何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "国家の転覆？　あるいは、ロンディニウムから距離があるのをいいことに、管理を一任された物品を横流しして、外部勢力と結託し、私腹を肥やしたいのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "なッ、中尉……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "あら、急に慌ててどうしたの？　こんなの、根拠もないただの推測でしょ。誰かさんに待たされてるお陰で、これくらいしかやることがないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "――ッ……（声を抑える）……すみません、ご報告が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "中尉。間もなく、大佐が到着されるとのことです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
