{
  "server": "jp",
  "storyId": "main_16_level_main_16-10_beg",
  "groupId": "main_16",
  "stageId": "main_16-09",
  "title": "静まる泣き声",
  "storyCode": "16-10",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_16-10_beg.txt",
  "sourceHash": "bf01b1c61f5e887c903f6c4c8cee5c738db71be2946f62e0071fb8154f4a35be",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "（小さく歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "おばあちゃん、気分は、どうですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "（小さく歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……チク、タク。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "チク、タク。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "（小さく歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "時計が、チクタク、鳴っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "時計は、誰も、待ちはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……でもわたしたち、歌っちゃいけませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "さあ……もう行きましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "こっちに生存者はいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "ちっ、立てなくなっちまったみたいだ。リディヤ、いるか？　誰かに起こしてもらわないと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "リディヤ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "あっちを見て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "誰か来るわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "ランキン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "火は消えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "ああ、とっくに消えたよ。生き残った村人はもう僕たちを見つけてる。何かしないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "それに、ホーリーをいつまでもこうやって跪かせてるつもり？　気が狂ってとんでもないことを仕出かしたとはいえ、こんなにひどいやり方で苛むことはないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "火が消えてから周囲の気温は下がり続けてる。これ以上続けたら、死んじゃうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "ああ、こいつは死ぬ。だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "今じゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ランキンは村の入口に目を向けた。\nかつてそこに整然と並んでいた柵は、食糧を狙う牙獣を阻むためだけに設けられたものであって、村に入ろうとする人間を拒むことはできなかった。それが善意を持つ者でも、悪意を抱く者でも。\n壊れた柵の向こうに人影がちらほらと現れ始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼らは震えながらこちらを見つめた後に、怯えたように離れていった。\nランキンはまるで独り言のような口調で言った――"
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺は間違っていた、ニクト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "何だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺は間違っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "何のことだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "ホーリーはおかしくなってなんかいやしない。奴が火事場で叫んだ言葉は、ナディア夫人や死んだ息子に向けられたものじゃなくて、俺に向けた言葉だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "「……これで、俺は殺戮の罪を犯した。食糧のためでも、清潔な水のためでも、暖かな家のためでもない。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "「俺は共に行く仲間たちの魂に、救いが与えられることを願っただけだ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "僕は何も聞いてないよ。たとえ言ったとしたって、それはヴェトチキやお婆さんがよく口にしてた祈りの言葉だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "あいつらの佯狂者や皇帝信仰は今日に始まったことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "「佯狂者」？　「皇帝」？　そんなあるかもわからないものは関係ない。ただ、俺があいつに息子を手にかけさせたのに、ホーリーはそれでも俺を救おうとしたということだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "だが魂とは一体何だ？　誰がそんなものの存在を証明できる？　それに、それがこの世に生きる命よりも尊いと言うのか？　バカげてる……バカげてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺はあいつを追い詰めるべきじゃなかったんだ。だがもう最悪の結果は生まれてしまった。もし以前あいつが息子を殺したのが俺の望みを叶えるためなら、今放った炎も、目的は同じのはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "いや、よく聞け。そんな理屈は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "だから、この炎は俺が放ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺が償わねばならない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "ランキン、バカな真似はよせ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "なるべく手短に話します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "今さら……今さら何を言うってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "食糧と水を分けてやったというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "これがその返礼か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "決してそんなつもりはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "ではここで道を塞いで何をしようというんだ。我々を追い出す気なのか、それとも暴力を続ける気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "皆さんに、人殺しがその行いに相応しい末路を迎える様を見届けてほしい。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "はっ……ははっ……\nはははははっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "人殺し？　末路？　まさか放火犯も、殺人犯も、略奪者も、全員捕まえて殺す気かね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "そんなことはできやしない。だからあんたは武器を持って私と話しているんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "聞かなかったことにしてやる。我々を皆殺しに来たのではないのなら、とっとと出て行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "二度と姿を見せるな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ランキンは手にしたツルハシを置き、身に着けたすべての武器も外すと、両手を上げて目の前の人物に意志を示した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "ランキン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "どけ、ニクト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "身ひとつになってもお前たちは、アーツも使えるだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "ここに犯人を差し出します。好きに処分してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "……なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "武器は捨てました。アーツも使いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "好きにしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "なるほど。あんたは自分一人を差し出して、多くの者を守ろうとしているのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "私は算数が苦手だが……あんたのやろうとしてるのが割りに合う取引ではないことはわかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "決して反抗はしません。ずっとここにいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "だが私が、我々が必要なのはあんたじゃないんだ！　火事が起きた時、そもそもここにいなかっただろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "最初に火を放った奴を寄越せ。隙を見て略奪した奴を、私の故郷を燃やした奴を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "私の妻を殺した奴を連れてこい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "その暴力の原因が俺にあるとしてもですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺の傲慢さが部隊を窮地に追い込み、俺が追い詰めたことであいつはこんな残虐なことを仕出かしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "あなたは俺を殺すべきです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "断る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "聞いてください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "あいつ以外じゃ意味がない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "廃墟の一角が片付けられ、空き地で処刑が執り行われることとなった。\n群衆が自然と周囲に集まった。寒い夜に火を囲みつつも、その温度に身を焼かれることを恐れているかのように見えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "やっぱり納得できねえ。ホーリーはなんで火を放ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "俺たちを助けてくれた村に対して、こんなことをするなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "狂っちゃったんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "息子が死んでから、様子がおかしくなってたし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホーリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "だけどよ、ひょっとしたら――あいつが火を放ったわけじゃないんじゃないか？　ランキンはただ村の人らを納得させたくて、そしてちょうどホーリーの病気がひどいもんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "俺の知ってるホーリーはこんなことをする奴じゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "事実はわからないけど、私はランキンを信じるわ。彼は自分を差し出してまで、ホーリーを助けようとしたのよ。知らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "だけど幸いだったのは、村人たちが罪のない身代わりじゃなくて、断固本物の犯人を要求してきたことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "……とにかく、俺は見たくない。まだ始まってもいないが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "俺はちょっと他のとこ行くよ。少し休まないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "待ちなさい。ランキンが何か話すわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "大体揃ったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーリー",
      "text": "（小声）……苦しみを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーリー",
      "text": "（小声）共に分け合う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "この男を殺す前に、いくつか皆に言いたいことがある。犯人を弁護するためでも、彼に代わって被害者に許しを請うためでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生き残った村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "この男は死んで当然だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "彼は差し出された善意と信頼を踏みにじり、ここにいる皆を危険に晒した。全力で生き抜こうという我々の初心を裏切って罪のない人を傷つけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "我々が選んだ道を進むうえで、死にぶつかることが避けられないのはわかっている。だがそれはこんなやり方や、こんな理由によるものであってはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "さあ、よく見てくれ。この男のもたらした教訓をしっかりと胸に刻み付けるんだ。そしてこれから彼の命を奪う男は、本来その資格がないことを覚えておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺が彼を殺すことを選んだのは、被害者の要求と、そして俺自身の判断によるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "これは俺がリーダーとして最後に下す判断にもなる。仲間殺しの罪など誰も背負うべきではない。だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーリー",
      "text": "（小声）悔い改めろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーリー",
      "text": "罪を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "雪がホーリーの肩に降り積もり、厚い層をなす。彼は何も聞こえていないかのように跪くと、祈るように両手を胸の前で合わせる。\nそして顔を上げ、執行者に向けて首元を晒した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "……そうだ。俺は、本当ならとっくに己の罪を悔い改めねばならなかった。ならば、俺の手でやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "（小声）すぐに会おう、ホーリー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "クソッ……鏡くらいは直せると思ったのに、もっと粉々になった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "縁起が悪いな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "ランキン、ホーリーの遺体を持ち帰ることもできないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "ダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "村人が遺体を手元に置いてたって無意味だろ。まさかホーリーを荒野にでも晒すつもりか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺たちには交渉する資格がないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "それに、お前たちが今後も俺についてくるつもりなら、ホーリーと同じ末路を迎える可能性は高い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "どういう意味だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた坑夫",
      "text": "あんた以外の誰についていけばいいって言うんだ？　冗談言ってる場合じゃないぞ、ランキン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "これは冗談じゃない、決断だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "ついさっき皆に話した決断だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ランキンが振り向くと、顔中が汚れにまみれ、疲れ果てた人々が、まるで道しるべを見つけたかのように再び彼の周囲に集い始めた。そこに彼がいる、ただそれだけの理由で。\n彼らはリーダーを見つめたまま、ぼんやりとして次の指示を待っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "放心した坑夫",
      "text": "まだ南へ進むの、ランキン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放心した坑夫",
      "text": "もう疲れたわ。私は風と雪を避ける屋根が欲しいだけなのに、ここにはもうそれすらないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放心した坑夫",
      "text": "このまま進めば死ぬ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放心した坑夫",
      "text": "ここに残っても同じよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな坑夫",
      "text": "ランキン、あいつらは見つからなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな坑夫",
      "text": "パーヴェルとボジーナは……見つからなかった。遺体すらな。すまん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな坑夫",
      "text": "あの村人たちが近づかせてくれなかった。ツルハシを置いてもダメだった。彼らは明らかに俺たちのことを怖がってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな坑夫",
      "text": "もう村の人たちを怖がらせたくない。行こう、ランキン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな坑夫",
      "text": "俺たちを連れていってくれ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ランキンの視線が一人一人の顔を横切っていく。声を上げた者も、そうでない者も。"
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "すまない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな坑夫",
      "text": "ランキン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "これからは、皆が進む道を決めることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "さっきも言った通り、罰を受けるべきはホーリーじゃなく、俺の方だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺がホーリーの残虐さと狂気を作り出した。これまで俺が下してきた決断が、彼をあんな窮地に追い込んでしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "誰もが死と向き合う覚悟を持っているわけじゃない。今回の件が起きるまで、俺はそのことに気づいてすらいなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "独断で物事を決める能力が俺にないのは、事実が証明している。だから俺が最後にできる一番賢明な決断は、決断を下す立場を放棄することだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "選択権はお前たちに返す。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "沈黙。\n長い沈黙が流れた。\n誰一人答える者はない。誰もかれも身じろぎ一つせず、わずかな表情の変化すらもない。\nその決断を聞いた全員が沈黙した。やがて群衆の一番奥から、震えた声が響いてくるまで。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わたしたちを……見捨てるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "そうじゃないんだ、ヴェトチキ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "じゃあ、なん、です？　さっきの、言葉を……どう、理解すれば……いいんですか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ランキンを囲む群衆は問いかけを発した者のために自然と道を作った。\nヴェトチキは前に出なかった。その場に立ち尽くし、指が白くなるほどに、拳を強く握りしめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "「もう決めることはない」って、言いました！　みんな、ここまで……こんなに遠くまで、来たのに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "先生は、見捨てようとしてます。わたしたち、みんなのことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "違う！　俺はこうしなきゃいけないんだ。皆にこれ以上悪い結果をもたらさないためにも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "俺の勝手な決断のせいで無意味な犠牲が出るのにこれ以上耐えられない。俺たちが鉱区から、あの死者の国から逃げ出してきたのは、こんな結果のためじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "「死者の」……「国」？　だけど、あそこは、わたしの家です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "なんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "鉱区は、坑道は、わたしの……家です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "みんな、の、家です。かつてはそうでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "……「家」？　お前たちは皆、自分から逃げ出したんだと思っていた。俺と同じように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "それは、信じてた、からです。先生を――ランキンさんを、信じてた、から。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わかって……なかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "お前たちが出ていくことを選んだのは、ずっと前から逃げたかったからだと思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "先生は、黒い虫を殺して、立ち上がって、こう言った。「さあ――ここを出よう！」って。だから……わたしたちは、逃げ出した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "でも今先生はホーリーさんを、捕まえて、殺して、こう言ったの。「お前たちを、連れ出したのは、間違いだ！」って。それが、「選択」だって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わ、わたし――わからない！　わたしたちは、先生にとって、一体……何なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "大切な友人であり、家族だ。複雑すぎて、定義できない。だがお前たちが大切だからこそ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "それにここは、ここはあの、村人たちの、家だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "村は、建て直せるかも、しれない。でもわたしたちは？　一体どこへ……ど、どこへ行けばいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "先生は、わたしたちを……こんなに遠くまで、連れてきたんだよ。もし今、それをやめるって、言ったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わたしたちは、どうやって――帰れば、いいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "ランキンさん、教えて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わたしたちはどうやって、生きればいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "ヴェトチキ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "やめてください。また、あの口調で、わたしを呼んで、また、わたしを、騙そうとしてます。わたしは、もう――子供じゃ、ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "反論、しないんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "お前の言葉のおかげで、俺の推測が正しいとわかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "これまで俺がやってきたことは、すべて自分の考えをお前たちに押し付け、無理やり進めていただけだった。だからお前たちは俺の計画も、その裏に隠された意図も理解していない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "お前たちが信じているのは自分の選択ではなく、俺という男だ。だがもし俺がいなくなったら、お前たちはどうすればいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "お前たちの信頼には感謝するが、これは間違っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "だから、俺は今ここで問題をはっきりさせて、お前たちに選んでもらう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ランキンは再び目の前にいる一人一人の顔に目を向け、皆の注意が確かに自分に向いていることを確認した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "カジミエーシュとウルサスの国境へ向かい、感染者だけの農場を見つけることは俺たちの最終目的だ。だがその過程で、この旅をウルサスが俺たちを直視するためのきっかけにしなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "問題は、そうすると俺たちは必ず極めて危険な状態に置かれるということだ。なにせウルサスを揺るがす行為だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "かつてそうした者たちは、その後に消息を絶った。彼らのマークと名前だけが、この雪泥と沼に覆われたツンドラに伝わっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "もし今、俺についてきたら彼らと同じ道を辿ることになるかもしれないと言ったら？　己で選択できる理性のある者に対して、生き延びたいと願う者に対して、俺はそんな選択を勧めたりしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "……だが、俺はホーリーに選択の余地すら与えなかった。だから、あいつは死んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "あいつは俺に教えてくれたんだ。選択権をお前たちに返さねばならないということを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "群衆は答えを返さないまま、曖昧にざわめいた後に徐々に散り散りになっていった。\n初めはあまり顕著な差はなかった。何人かはランキンの隣や後ろに立ち、また何人かは彼の目の前に立ち止まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な坑夫",
      "text": "ランキン、いつ出発するの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランキン",
      "text": "全員が決断を下したら、すぐに出発する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "より多くの者がランキンの元へと歩み寄っていく。差が次第にはっきり現れ始めた。その足音は、ヴェトチキの耳にはまるで遅れて響いた退勤の鐘の音のように聞こえた。\n一、二、三……一つ数え間違えるたびに、また一人坑道に呑み込まれるかもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……生きたくない、人、なんているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "どうして、選ばなきゃ、いけないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わ、わたしは……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ヴェトチキは、彼らが自分からどんどん離れていくように感じた。\n彼女は何かを掴もうと無意識に一歩踏み出したが、直後に腕を引かれるのを感じて足を止めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Raidian",
      "text": "――ヴェトチキ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "お、おねえちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "おねえちゃんも、行くんですか？　今までどこにいたんですか？　わたし、どうすればいいか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……みんな……みんな、離れようとしてるんです！　わたしたちを置いて、死にに行こうとしてて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Raidian",
      "text": "大丈夫、大丈夫だよ。さっきはニクトの手当てをしてたんだ。彼は鏡の破片で怪我をしてたから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Raidian",
      "text": "ううん、それはひとまずいいや。とにかく、後半の話は聞かせてもらったよ。あなたが生きたいと思うことは何も間違ってない。無理に納得できない道を行く必要はないよ。私も行かないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "い――行かないんですか？　おねえちゃんは、ここを離れないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Raidian",
      "text": "うん、私は小隊と一緒に負傷者の手当てを続けるよ。それにニクトも残るはずだし。そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Raidian",
      "text": "……ニクト？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二つに分かれた後も群衆は騒ぎ続けていてニクトの姿は見えなかった。Raidianがアーツを使って特定の電気信号を探るとすぐにニクトの居場所が分かった。"
    },
    {
      "type": "dialogue",
      "speakerName": "Raidian",
      "text": "彼は私たちの部隊の後ろにいる。やっぱりここを離れな――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "……すまない、セラフィナさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "ニクト――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "すまない、ヴェトチキ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "僕は戻るわけにはいかない。僕がサンクト・グリファーブルクの出身だっていうのは知ってるだろ。最初から鉱区は僕の家じゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "それに進む先が死とは限らない。僕があいつのことを見ていれば、あいつが言うほどひどい状況にはならないかもしれない。だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニクト",
      "text": "チャンスっていうのは、人の手で作り出すものだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "いや。いや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "どうして……どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "なんで、そうしなきゃ、いけないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "なんで……いつも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……離れ離れになるんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな声",
      "text": "さあ、早く帰りましょう、ヴェトチキ。風邪をひいてしまうわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな声",
      "text": "ひと眠りして目を覚ましたらお父さんもお母さんもお家に帰っているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな声",
      "text": "もしおばあちゃんも褒めてくれるくらいいい子にしてたら……そうしたら、目を覚ました時に枕元にチョコレートが置いてあるかも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不明瞭な声",
      "text": "……ボイコット……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不明瞭な声",
      "text": "権利を勝ち取る……賛同する者は……いなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不明瞭な声",
      "text": "……死刑……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な声",
      "text": "「母」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な声",
      "text": "「父」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な声",
      "text": "「子」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な声",
      "text": "……「おばあちゃん」？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「おばあちゃん」",
      "text": "（小声で歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "ひと言だけ！　あなたのひと言だけでいいんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "たったひと言だけで、私の魂は……救われるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「おばあちゃん」",
      "text": "（小声で歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "わ……私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "――どうか……お許しください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "あなたの子を殺した罪を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「おばあちゃん」",
      "text": "「私は……」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……おばあちゃん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "（小声で歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……おばあちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "（小声で歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "おばあちゃん、誰か……外にいるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "誰も残ってはいないし、誰も待ってはいないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "みんな……行っちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "みんな泣きながら、おばあちゃんの手に、キスして、「離れたくない」って、言ってたのに……行っちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "誰もが歩むべき道を持っているのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……じゃあ、これは避けられないことなの？　でも、どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "苦しみを受ける魂よ、あんたには理由が分かるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "ランキンさんから……まだお、教わってないの。あの時計の……読み方を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "ストップウォッチ、時計……？　鐘の音が、聞こえる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "いつもと同じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "おばあちゃんの、手……どうして、冷たいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "炎が熱いからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わたしの身体、も、冷たい。それに、痛い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……でも、炎のせいじゃ……ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "わからない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "いいんだよ。人は皆そうやって混沌とした生を過ごすものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "死ぬ……まで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "そうとも。死ぬまで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "（小声で歌を口ずさむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……おばあちゃん、その歌、一体……何の、歌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "愛だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "でもわたし……苦しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "それはあんたが愛しているからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "愛は、人に苦痛を、忍耐を、服従を強いるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "そして人を強く、裕福に、高貴にするものでもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "あんたが愛しているから、苦しい。あたしはあんたを愛しているから、あんたの苦しみを一緒に感じるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェトチキ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ヴェトチキは口をつぐんだ。彼女はぎゅっと目を閉じ、身体を更に丸める。だがいつものように自分の頬を撫でてくれる手に、これ以上触れることはできなかった。\nその言葉は、前にも聞いたことがあった。その時は訳の分からぬ状況の中、それを支える根拠を見つける必要もなかったが、今は、彼女にもはや確信を持てなかった。\nただ朦朧と生きているだけなのに、どうして王侯貴族より裕福で高貴であると言えるのだろうか？\n明らかに何の力もないのに、どうして棍棒を振るう権威より強いと言えるんだ？\n目の前には焚火がある。本来ならそれは人を暖めるはずだったが、ヴェトチキは体の隅々に寒気が侵入してくるのを感じた――\nその冷たく、干からびた手を伝って。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "「私は黙して祈り、そなたの苦しみを共に担おう。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "「我ら皆が……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディア",
      "text": "「心から罪を悔い改めんことを願おう。」",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "その声はただの繰り返しであり、残響だった。\nその残響は……破滅を指し示していた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
