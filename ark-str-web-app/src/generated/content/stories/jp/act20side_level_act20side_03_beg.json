{
  "server": "jp",
  "storyId": "act20side_level_act20side_03_beg",
  "groupId": "act20side",
  "stageId": "act20side_03",
  "title": "奇談怪論",
  "storyCode": "IC-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act20side/level_act20side_03_beg.txt",
  "sourceHash": "44d490ea1865e4b8fb96a16fb06a78598890f68f836e3c672b4f5201848e5dc5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "で、滑り台を爆破して鉄道を修復するには、商業代表のクロッケ・ダイアモンドフェースと、工業代表のデカルチャー・シルバーミント、あとキャッチを説得しなきゃならない──そういうことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "そうだよ、その人たちはこの都市で最も重要なポジションにいて、他のドゥリン人たちも彼らの意見を参考に選択をするんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前が自分で行きゃいいんじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "どうやらあんま仲が良くないみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "そんなにハッキリ言わなくたっていいだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "聞いただけでメンドくさそうな話だな。だが仕方ねぇ、アカフラのためだと思って行ってやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "それでどこへ行きゃ会えるんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ふぅ、やっと一段落ついた。にしても、あのガヴィルって奴は、ホントおっかないな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "思い通りに事が運んでいるみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "エッジじい、これで満足か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "正直なところ、「どでかい水たまり」は、ちと惜しいがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ハッ！　鉄道橋の真ん中に建てるのが悪いんでしょ？　でなきゃ、オレだって壊す理由はないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ところで、新しいアイディアが浮かんだんだ。ドームが壊れて滝ができ、あの巨大滑り台が建設されて半年以上が経った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "皆はまだ楽しく遊んではいるが、少々飽きてきた頃だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "いっそこの機会に、新しいものを作るのはどうだ？　お前もキャッチと超巨大ウォーターキャノンとかいうものについて、さっき話したんだろ？　すでに噂が広まっているぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "実のところ、私も非常に興味があるのでな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "まったくあのアダクリス人！　なんとも野蛮で、無礼で、短気で、自分勝手！　クロッケさん、想像できますかしら？　創作に行き詰まって気晴らしのために、洞窟に自生する茶葉を摘みに行ったら！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "抱えられたまま滝から飛び降りる羽目になったんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "まったくもってひどすぎますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "でも普通のゼルウェルツァ市民にとっては、その体験は魅惑的だと思うよ。もし物語にすれば、大ヒットするかもしれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "「ガヴィルを信じろ」「アヴドーチャ、しっかりつかまってろ！」うん、ちょっとロマンティックかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "よしてくださいまし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "少なくともあなたが書いた、例の雪に関する物語よりはいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "そういえば、数日前に子供が何人か、短編小説を読ませてほしいと来ましたわ。ようやくこういう本も誰かに読まれるのだと思ったのですけれど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "その子たちの感想は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "「めっちゃ笑えた、また読みに来る」ですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "だろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "アヴドーチャ、その子たちに悪意はないよ。私たちドゥリン人にはおそらく、あなたの経験を想像するのが難しいだけなんだと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "私があなたの感覚を理解するまでに、何度説明を聞いたと思う？　普通のドゥリン人だったら、まず無理だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "ドゥリン人は本物の雪すら見たことがないんだから、あなたが書いたあれはなおさら……なんて言うんだっけ、「狡猾」、「逃亡」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "それらの言葉が文学の中でのみ存在するというのであれば、何よりの幸いですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "とにかく、わらわは今の暮らしに非常に満足しておりますの。他人を搾取することも、搾取されることもなく、恐ろしい陰謀が進んでいることも、罠や暗殺に巻き込まれることもない日々に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "わらわは商店街のキャッチコピーを書き、看板をデザインするだけでお腹が満たされるのよ。そこに何の不満がありましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "毎日デッキチェアでのんびりと日光浴ができる──人工光源ではありますけど、それで充分ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "このような平穏な日々が続いてほしいと、わらわは切に願って──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ここが商業代表のクロッケ・ダイアモンドフェースのオフィスか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ちょっといいか、例の巨大滑り台を爆破したいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お、アヴドーチャ、お前もいたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "顔色が良くないみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "クロッケさん……申し訳ありませんが、わらわはお先に失礼させていただきますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "家に帰って、このクロスボウのメンテナンスをし直さなければなりませんの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あいつ本気で怒ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "ウオホッンッ！　あなたたちは地下都市ゼルウェルツァに来たばかりだよね？　キャッチから話は聞いてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "なんて言うか、彼の今回の評価はかなり正確みたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "「ドゥリンよりもドゥリンらしい人たち」か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "回避シマス！　回避シマス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "うむ、独特の構造だな。Lancet-2姉様とは全然違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "警告！　接近ヲ禁ズル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "どうやら姉様ほど賢くはないようだ。基本反応はいくつかあるようだが、どういった原理なんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "脅威レベル：A判定！　正体不明デス。一定距離ヲ保チマス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "落ち着くんだチビすけ。私はズゥママという。悪い人じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "個体識別定義完了シマシタ。個体名ズゥママ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前の名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "プロパティ照会ヲ確認シマシタ。当機ハ、ドゥリン族専属ノ栄光アルR3-E3型アシスタントロボ、ナンバー0429。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "こんにちは、ナンバー0429。どうしてそんなにグラグラしてるんだ？　ダンパーシステムに問題でもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "セルフチェックレポート：部品老朽化ヲ確認。耐用年数ノ満了直前デス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私が見てやろう。ほら、メンテナンスの道具はすべて揃っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "メンテナンス有効性チェック……低レベル。耐用年数満了後ニ即時廃棄ヲ推奨シマス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "チビすけ、お前の状況はそれほどひどくない。多分ネジを数本絞めてやるだけで大丈夫だ。そう自棄にならなくていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前はとても可愛いから、喜んで助けてやる。どうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私と友達にならないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "トモダチ？　認識不能ナ入力ヲ確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "個体名ズゥママ、当機カラノメンテナンス申請ハ可能デスカ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "問題ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "だがまずはお前のボディを切り開く必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "拒否！　申請キャンセル、申請キャンセル！　危険！　危険！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "大丈夫だから、逃げるな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "……今、地上から来たフィディアが、アシスタントロボットを追いかけてなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "変ね、昨日飲み過ぎたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "そういえば、アヴドーチャの書いたよくわからない物語に、あんな感じのシーンがあったわね。「追いかけて殺す」とかいうような。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "うーん、あの子が「これはコメディじゃない」って言ってた理由がわかったような気がするわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "イナムさん、お茶でも飲む？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ドゥリン人もお酒以外の液体を飲むのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "たまには違う味も楽しみたいしね。それに、コホンッ、まだ仕事中だし、お酒はやっぱり休み中に取っておかなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "さて、あなたが二人だけで話し合おうと提案した理由を聞こうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ガヴィルの戦闘能力は確かなものだけど、こういった件に関しちゃ彼女の拳は何の役にも立たないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "それに、私たちは同じタイプの人間だと思うの。ゼルウェルツァの商業代表さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "どうやらあなたは商売の話が好きみたいだね。ちょうどよかった、私も嫌いじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "ゼルウェルツァはドゥリンの小さな集落にすぎないけど、まだ他の都市と交流があった数年前に、私は商業代表としていくつか仕事をしてたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "だけど例の地震の影響で、唯一の鉄道が崩壊しちゃったんだ。幸いゼルウェルツァは自給自足が可能だし、住民ものんびりしているから、交通の復旧はそこまで急を要することじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "今の私の仕事は、市民の要求に応えて、娯楽活動を推進することだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "「どでかい水たまり」近辺のお店を管理したり、セルカーと呼んでる自走式車両（セルフドライバー）の新パーツを発売したり……まあ、結構暇かな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……ドゥリン人の感覚をきちんと理解していないんだけど、普通、泥酔してサーフィンに行くのはのんびりしてるって言うのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "言うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "でも、地上の人間の基準だと──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "言うんだ。私たちの基準では、それは「のんびり」にあたる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "だから、スディチがあなたに何を約束していようと、もし滑り台の爆破計画について同意してほしければ、私が動きたくなるような何かを見せてもらわないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "お互いが喜んで交換できてこそ、商売が成り立つわけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "イナムさん、あなたはゼルウェルツァの商業に何をもたらすことができるの？　アカフラの手芸品ではいまいち魅力に欠けるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "嗅覚が鋭いセルカー屋は、すでにあなたたちの外見を新しいパーツに取り入れてるみたいだけど、それじゃ足りないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんた……思ってたよりも地上のことをよく知ってるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "実際に地上へ行ったことはないけど、都市の図書館も飾りじゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "あなたたちの風習についてはよく知ってるよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "アカフラ人は、ハガネガニを取り囲んで不眠不休で踊り続け、最後まで踊っていられた者が大王の称号を得るんだ。そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……どこでそんなものを見たのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "『奇談怪論』だよ。ゼルウェルツァで最も流行っている本で、さる大冒険家が昔、地上から大量に持ってきてくれたんだ。地上に関する百科事典とも言えるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "それは作り話だらけのデタラメ雑誌よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "……え、嘘だろう？　あれを読むために、苦労してサルゴン語まで学んだっていうのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……道理でほとんどなまりがないわけね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "はぁ、拍子抜けしたわ。最新の『奇談怪論』数冊であんたを手懐けられそうだなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "最新の？　あれってまだ続きがあるの！？　うーん……もし本当にあなたが手に入れられるっていうなら、考えてもいいけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "それよりもっといいものがあるわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "これは何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ビデオテープよ。見てみたい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "見つけましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おう、アヴドーチャ。奇遇だな、またアイディア探しか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "貴方がたは一体何がしたいんですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "クロッケさんの方はイナムが任せろと言うので、私たちはズゥママを探しに来たんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "そういう意味ではありませんわ。わらわが訊いているのは、地上人──貴方がたは、わらわたちの都市へ何をしに来たのかということですわ。真の目的は何ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "わらわは、超便利大エレベーター壱号機周辺をずっと監視しておりましたけど、貴方がたに続く主力部隊はどこですの？　サルゴンの首長たちはついに地下の財宝に目を付けましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ここには貴方がたが望む資源はありませんわ。今すぐここから去りなさい。本当に、この平和な小都市を血で染めたくないというのなら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "誤解だって言ってるだろ。スディチが鉄道の修理を手伝ってくれる奴を探してて、アタシたちはあいつに騙されてここに来たんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……それは便利な労働力扱いじゃありませんこと？　そのような口車に乗せられてしまいましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あのな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あん時あいつがくそマジメな顔で話して、おまけにトミミが大げさな表現をしたせいだよ……はぁ、どんだけ心配したと思ってんだ。激戦に備えて、ズゥママと夜通し全速力で駆けつけたってのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うぅ、ごめんなさい。私はただガヴィルさんに休んでほしくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "はぁ、まぁいいや……今のうちに気晴らしでもしとくか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……つまり、貴方がたに本当に悪意はございませんの？　どこかの貴族の命令を受けてここへ略奪に来たのではなく？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "信じるか信じないかは、お前次第だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……確かに、たとえサルゴンの仕業だったとしても、貴方のような大雑把な方を遣わすなんてことはありえませんわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "大雑把だぁ？　アタシはただ無駄話が嫌いなだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "アタシの考えは簡単だよ。スディチのガキンチョに手を貸して、その見返りにティアカウに役立つ技術を持って帰る、それだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ロドスにはアタシの回診を待ってる患者がたくさんいるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "というと、貴方はお医者様ですのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "なんだよ、医者にゃ見えねぇってか？　免許だって持ってるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "こちらのトミミさんがお医者様だというのなら、まだ数秒の間は信じられましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、お医者さんなら私もできますよ！　ガヴィルさんから麻酔術を教わったことがありますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "首筋に狙いを定めて、それからドンってやるんです──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ロドスの皆さんは、これを……えーっと「ガヴィル式ナチュラル麻酔術」って呼んでます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "……言っとくが、こういった非常手段は、アタシも特殊な状況でしか使わないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "例えば、ちょうど麻酔薬が切れて、補給パックも人を殴ってる間になくしちまった時とか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "──やはり貴方がたはわらわが監視しますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ゼルウェルツァで、バカな真似をしようなどとは考えないことですわね。ここはわらわの安住の地、貴方がたに壊させはしませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "好きにするがいいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "貴方がたがやるべきことを終え、完全にゼルウェルツァを去るまで目を離したりはしませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "んじゃ、事を済ませる前に、のんびりと街ブラでもすっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あの、アヴドーチャさん……地元の方でしたら、ゼルウェルツァを案内してもらえませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……先に言っておきますわ。もしも都市の地形を調査しようなどとお考えでしたら、速やかに諦めた方がよろしいですわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ち、違います！　私が言いたいのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "アヴドーチャさんのお洋服がとっても素敵なんです！　オススメのアパレルショップとかはありますか？　私……見学したいんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "そういうことでしたら、よろしいですわ……確かにいくつかご紹介できるお店はありますわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ドゥリンスタイルのアクセサリーにご興味はあるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "見たいです！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "スディチ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……キャッチか、何しに来たんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "珍しいね、前はいつも部屋にこもりっきりだったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレにだって、日差しを浴びたいと思う時くらいあるさ。アンタがわざわざ来たのは、そんなことを言うためなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "僕の滑り台を爆破したがっている人間と話をしに来ちゃダメなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……ふっ、耳に入ったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "エッジ先生が教えてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "あのジジイめ……で、オレを非難しに来たってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "違うよ、実は反対はしてないんだ。この夏はもう充分すぎるほど堪能した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "それに建築デザイナーとして、最高の作品っていうのはいつだってこれから創る作品でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "チッ、アンタのそういうとこが一番ムカつくんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "どういうとこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "常に楽観的でお気楽なところだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ハハハ、それは嬉しい評価だね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "だけど、巨大滑り台の取り壊しに同意する条件として、君とドームのことについて話がしたいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……何も話すことなんてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "少し散歩でも行こうか。「どでかい水たまり」を爆破する前に、せめてアトラクションを体験しておいたらどうだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "まだ続きはある？　次の試合は！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "んぐんぐ──プハァッ！　いー酒だ！　イナム、もっと飲む？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "私はまだ残ってるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "飲むのが遅いんだから～",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "「ワイン＆コーヒー」ってチーム、もうちょっとで優勝だったのに残念！　あ〜あ、あの船までほんとあと少しなのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "どうやら気に入ってくれたみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "まさかあなたたち地上人の生活が、あんなに楽しそうなものだとはこれっぽっちも思ってなかったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "これは一体何ていうビデオなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "「ドッソレスウォーリアーチャンピオン」の記録よ。これはキャラバンの友人から手に入れた古いビデオなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "噂じゃ以前事故があったらしくって、ここ数年はまだ続いてるかどうかわからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "ねぇ……まだ見足りないんだけど！　敗退したチームの、翌年のリベンジマッチが見たい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "クロッケ、どんなに退屈な娯楽でも、ほんのわずかな「競技性」を加えてあげれば刺激が増すものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "自分のひいきのチームを応援しながら、友達と一緒にビールを飲む――そんな生活を嫌がるドゥリン人はいないと思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "それに通常、開催期間中はお酒やファーストフードの売上は倍になるわよ。どう？　ドゥリンにピッタリでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "お酒の売上は普段から充分にあるから、大会を開いてまであおる必要はないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "でも……うん、思う存分遊ぶっていう観点で言えば、確かに魅力的かも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "なら率直に言うわね、商業代表さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "水上レースを開催する気はない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
