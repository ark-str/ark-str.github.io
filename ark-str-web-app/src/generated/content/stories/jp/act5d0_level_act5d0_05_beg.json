  "sourceHash": "8126a43f59cada4df10d8640eca03abd6d8e46242c44cf8a75f5dbf342bfe65b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "やっほ～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ちょエクシアはん、ちゃんと前見てや。て、片手運転すんなや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "やっと追いついた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサスさん……次は……も、もう少しゆっくりでお願いしてもいいですか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "す、すまない。これでも極力抑えたのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "オッケー！　もう合流できたし、次はボスを探しに行こうか——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あれ～？　なにか足りない気がしない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……バイソンは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "え？　テキサスたちが連れてくるんじゃなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……もしかしてあたしたち、バイソンくんを置いてきちゃった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……自分たちのペースに慣れてしまっているからか、突然一人増えると感覚が狂うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "じゃあ、すぐに助けに戻った方がいいかも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "モスティマがそこら辺にいるんでしょ？　問題ないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "お——い！　ちょ、ちょっと待ってください！　ハァハァハァっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……自転車？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "うわぉ！　まさかチャリンコでテキサスはんのスピードに追いついて来よるなんて、バイソン坊、ど偉い奴やったわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "おい！　あいつどの路地に入ってった！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "あっちだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんか後ろに大勢連れてきてるねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いや、一人で自転車漕いでマフィアの武装集団を振り切れなんて無理だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……マズい、待ち伏せだ。エクシア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ちょっと間に合わなかったかな——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "うおぉぉぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "や、やっと追いついた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "そうだな、道案内ご苦労だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あなた誰——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ちょっとは眠ってもらおうか、坊や。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "うぁっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "チッ、一歩遅かったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "こんばんは、ペンギン急便の皆さん。俺はガンビーノ・リッチ、このファミリーのボスだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "残念だが、あの坊主の命は俺たちが預かってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "しかしこの程度のことで取り乱すような皆さんではないと思うが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "元はといえば、あたしたちが彼を忘れてたせいだからね……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやけどなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "貴様、どういうつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "フン……。正直鬼ゴッコにはもうウンザリしてしまってね。それに騒ぎが大きくなるのはお互いにとっても都合が悪い。違うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "そこであの坊主が役に立つわけだ。人質がいる以上、キミたちは正面から戦うしかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "そうすればコチラの手間も省ける。真っ向勝負で解決できるのが一番楽だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ペンギン急便、キミたちはもう逃げ場はないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "なるほど。それは良かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……なんだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そうだな。この状況は我々も好都合だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "クロワッサンとソラは陣形を維持。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシアは援護に専念しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "バイソンを取り返す。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
