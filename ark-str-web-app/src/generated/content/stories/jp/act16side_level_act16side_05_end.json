{
  "server": "jp",
  "storyId": "act16side_level_act16side_05_end",
  "groupId": "act16side",
  "stageId": "act16side_05",
  "title": "葬儀",
  "storyCode": "GA-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16side/level_act16side_05_end.txt",
  "sourceHash": "bcd0d999a3d5aa63b91a27d6fb2d5623f71617f246920ac6a9fe03ded96f8305",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "先導者様……これ以上下がるわけにはいきません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "やめろ！　セシリアを駆け引きの道具にはさせない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……エゼル！　セシリアを連れてこっちへ来なさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ちょっと、エゼル！　一体どういうつもり！　まさかあなた本当にその――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "――その異端分子？　それともテロ組織？　教皇庁はそんなくだらないレッテルを貼るしか脳がないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "パティア、どきなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "フィアメッタ……あなたの言ってた通り、人の考えは簡単に変えられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "あなたもあたしも同じよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "元気そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "おかげさまでね。君は結構老けたんじゃないの……「隊長」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ああ、おかげさまでね。あの銃で受けた傷は、治るのに随分かかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ハハハ、それは良かったね。でもあの子の銃弾を受けるよりはマシでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あの子は……レミュアンは死ぬところだったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ああ、知っているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "だが、彼女の銃弾を受けるよりはマシさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……君の頭はおかしいままみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ねぇ、そこのお兄さん、君が例のエゼルくん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "（またレガトゥスか……どうするべきだ……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……堕天使！？　フィアメッタさん、これは一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……ああ、そうか、堕天したんだったね。私に向けて銃を撃ったんだから、当然のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "もう感じ取れないのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だから今は、目で観察して、心で判断するようにしてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……おチビちゃん、君がセシリアだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お姉さん、角も光輪もある……お姉さんはサンクタなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "えっと……たぶんそうかな？　自分でもよくわからないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "さぁエゼルくん、セシリアを連れてこっちへ来て。その子には何もしないって約束するからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……堕天使の約束なんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そこのこわーい顔のリーベリよりは信用できるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ちょっと、誰のこと言ってるのよ！　向こうのあいつよね！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……モスティマ、この子の母親の葬儀がまだ終わっていないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "おっと、その手には乗らないよ。安魂教会の主祭だかなんだか知らないけど、君ってそんなに責任感が強いタイプじゃないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ちょっとモスティマ！　あなた、そいつと思い出話をするために付いてきたの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "エゼルくん、考えは決まったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、僕たちは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お姉ちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロゼラ",
      "text": "セシリア……まだやらなきゃいけないことがあるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "アンドアイン、それにしても大層な人数だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "セシリア一人を迎えるには大所帯すぎない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そうだ、伝言があるんだった。錠と鍵の中のあいつから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "勇気は賞賛に値するけど、たどり着く答えに君が満足することはないだろう、ってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "忠告痛み入る。私が共に歩む機会はないが、当時真実のベールの端をめくってくれたことで、大いに収穫を得た――とでも伝えておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……君の今の様子、本当に「収穫を得た」って言えるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "己のみぞ知ることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "――まずい、エゼル！　下がって！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……あぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "信じられますか――\n僕は信仰が凝縮してできた海を見ました。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……以上が、今回の行動における報告になります。ほかにも本件に関わった方がいらっしゃるかと思いますので、もし報告に漏れがあれば補足いただければと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "私からは、都市全体に戒厳令を敷くことを提案させていただこう。アンドアイン一人でも厄介だが、それに加え「混血のサンクタ」が確認されたとなれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "銃騎士ジョヴァンニ殿、サミットはもうまもなく開幕します。このタイミングで戒厳令を敷けば、外国使節の間でどれほどのパニックが起きるかおわかりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "枢機卿、あれほどの危険人物を「パニックが起きる程度の措置」だけで片付けられるなら、最善の結果に他ならないと思うが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "教皇聖下が長年準備されてきた……来たる「万国サミット」は、ラテラーノがこの大地で立脚するための基礎の一つになり得ます。ですがパニック一つでそれが台無しになるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "アンドアインがサミットをぶち壊さない保証がどこにある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "銃騎士ジョヴァンニ殿、ナーバスになりすぎじゃないですか？　除け者にされていじけちまった連中の寄せ集めと、正体不明の少女一人に何をそんなに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "オレン、ラテラーノは長きにわたる平和と安寧をどのように維持してきたと思っている？　いかなる不確定要素も排除すべきだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "（……毎日街で爆発騒ぎばっかり起こしてるラテラーノ人がそれを言うかよ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "まさかとは思いますけど、長い間その威光ある大口径をぶっ放してないもんだから、久々に一発ぶちかましたくなってるだけじゃありませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "この銃は私の誇りだ。何の問題がある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……すみません。事態がひっ迫していますので、話を続けてもよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "……続けてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ご存じの通り、私とモスティマはアンドアインと……同じチームに在籍していました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私の知る限り、彼は目的外のことはせず、備えなき戦いは避ける傾向にあります。従って、たとえ彼にラテラーノを混乱に陥れる力があっても、意味なく混乱を引き起こすことはないと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "現状、セシリアという混血の少女を支配下に置こうとしている動きを除き、迷い人はいかなる行動の予兆も見せていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "つまり、彼らの今回の目的は、セシリアを連れ去ることだけだと推測するのが妥当です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "その目的がすでに果たされたことを考えると、次に予測される動きは……ラテラーノを去ることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "よって、以下の二点に焦点を当てた今後の対応を提案させていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "まず、国境管理のレベルを引き上げ、出入国ゲートの護衛隊を増派すると共に、特殊部隊を結成して迷い人の隠れ家を捜索し、アンドアインの身柄を確保します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "次に、万が一に備えて、到着済みの使節や他のサミット関係者に迷い人が接触していないかの調査、サミットが標的にされる確率の評価、そして対策案の提出――これら三点を第七庁に依頼します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "サミット自体については……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ヴェルリヴのお望み通り、引き続きスケジュール通り進めればいいんじゃない。今回はお試しみたいなもんだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ああでも、立食パーティーのスイーツは激マズだったよ。サボテンタルトとか流石にちょっとね……アレ、なんとかならないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "私は風味豊かで楽しめたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "この点に関してだけは、モスティマと同意見です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "何を言うか！　非常に美味であったぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……ジョヴァンニ殿がそう仰るなら、味の評価は決したかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "同意ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そうそう、ジョヴァンニが好きなら絶対マズいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "モスティマ、私を愚弄する気か！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "子らよ、声を落としてくれんか。老人の耳は騒音に耐えられん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "前例のないことに対しては、善意でもって当たれと律令が我々に示している……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "サボテンタルトをそこまで厳しく取り締まらずともよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "……そんな「律令」初耳ですけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "うむ、今朝思いついたばかりであるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "………………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "教皇聖下……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "君の提案通りに事を進めるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "ヴェル、ジョヴァンニ、フィアメッタを手伝ってあげなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "アンドアインは……自ずと終点へ至るであろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふぅ、だから会議って嫌いなんだよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "まったくよ。本題は三分で終わって、あとは全部無駄話だったじゃない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "お二人とも、教皇聖下たちはどんな決定をされたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……まだここにいたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "アンドアインを捕える件は私が引き継ぐわ。連日お疲れ様、帰って休みなさい。公証人役場には、あなたの一連の行動は私の任務に協力してのものだったって伝えておくから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "フィアメッタさん、僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "これからのことはあなたの権限や能力じゃ話にならないわ。まだ実践研修すら終えてない身であることを忘れないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "セシリアが心配なのはわかる。でもこの件を私に引き継ぐのが、あなたが望める最善の結果よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "あの、フィアメッタさん、あなたとそちらの……堕天使さんは、友人ですか？　あなたたちとアンドアインさんは……古いお知り合いかなにかですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "それは両方の質問に対する答えですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "古い知り合いじゃなくて、古い仇よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "でも、セシリアに怒りを向けたりはしないから安心して。あの子が今朝何を考えてたのかはわからないけど……小さな子供を責めてもしょうがないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それよりあなた、あの場所に二日もいたんでしょ。アンドアインに何か吹き込まれてない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……信仰に背く話を少し。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "全部忘れた方がいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あなたもまだ普通に暮らしていきたいでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "帰ったら何日か休みをもらって、それから公証人役場でしっかり働きなさい。なかなか将来有望みたいだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ラテラーノでの暮らしは貴重なものだし、ちゃんと大事にしなよ。私みたいなのでも、時々恋しくなるんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "普通に暮らす……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……それもそうか。彼らと違って、僕はただの普通の人だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "今日の仕事はおしまいっと、帰ろ帰ろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "護衛隊が国境管理を任され、教皇騎士も目を光らせてるとなると……しばらくは撤退できないわね……一応隠れ家は準備してあるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "オレンにも連絡つかないし……もう何なのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "大丈夫さ、待てばいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "セシリア？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "後悔しているのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……わからない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "でも、もしフィアメッタお姉ちゃんに付いていったら……大聖堂に行かないといけないんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わたしまだ答えが見つからないの……ママとのお別れのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "大丈夫さ、セシリア。ゆっくり考えればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……修道士さん、さっき教会で、角と輪っかがあるお姉さんがいたけど、あの人は……サンクタなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そうかもしれないし、そうじゃないかもしれない。彼女自身が決めることさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "サンクタなのにサンクタじゃないかもしれないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ああ。ほとんどのサンクタは一生涯サンクタのまま過ごす――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "けれども、選択できる。あるいは選択しなければならない人もいるんだ。……ある種の不幸によってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そして偶然にも、セシリアもその内の一人だよ。これが君にとって幸か不幸かは……誰も知りえない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "サンクタはサルカズと一緒にいちゃダメなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "もちろん一緒にいていいよ。君こそがその証拠だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "でもわたし……みんなに迷惑をかけてるんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃんにも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "セシリア、心配してばかりだと、何もできなくなってしまうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "人は常に争い合うものなんだ。「優しさ」や「相互理解」をもってしても、争いを根絶することなんてできないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "それに、人と人とが争うのは、どちらかが善で、とちらかが悪だからとは限らないよ。互いのやりたいことに矛盾が生じて、それが争いに発展する場合も多い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "つまり、互いの目的が異なるせいで、知らず知らずのうちに相手の邪魔をしてしまうことがよくあるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "どうしてみんな一緒の道を歩けないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "なぜなら、人々がこれから歩む道は、歩んできた道によって事前に決まってしまっている場合がほとんどだからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "例えばサンクタとサルカズの関係もそうだよ。一番最初に起きた争いの原因を知ってる人なんてもういなくても、数千年の憎しみがすでに道を作ってしまっているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "道は自分で選べるんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そうだね。でもそんなに簡単なことじゃないんだ。歩んでいる道を離れ、新しい道を探すには、果てしない荒野に飛び出さないといけない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "しかも、広大な荒野をいくら彷徨っても、新たな道は見つからないかもしれないんだ。自分の人生とすべてを、代償として差し出す必要があるにもかかわらずね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……じゃあ、じゃあどうしてそこまでして探すの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……そうだね、どうして探すんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "もしかすると、ただそうしたいだけなのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……「そうしたい」って……そんなに大事なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……それは私たちが唯一持っているものだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "あの……修道士さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "なんだい、セシリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "修道士さんがしたいことは何なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……セシリア、一つお話をしてもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うん、聞かせて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "何年も昔、私がまだ若い頃……挫折を経験し、ここを離れた時のお話だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ここを離れた？　どこに行ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "どこへでも行ったよ。あちこちを……旅したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そして私はある町にしばらく滞在した。小さな小さな町で、私の故郷とどこか似ていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ただそこはもっとボロボロで、もっと落ちぶれていて、みんな苦しそうに生活していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "（え？　ラテラーノと全然似てないよ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そんなある日、私は町の酒場を通りかかったところで、鼻歌交じりの酔っ払いとぶつかってしまってね。彼は私の服に嘔吐した上に、私のせいで転んだと難癖をつけて、酒代を払えと脅してきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "酒場にいた人は皆、いや、町中の誰もが彼をあざ笑い、罵ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "気の小さい人は彼を避け、みんな口々に彼のことを醜い愚か者、ごろつき、汚れた病人と蔑んだ……それは一人のサルカズだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "だけど、だからといって彼を町から追い出す人はいなかった。彼も日雇いの仕事でその日暮らしをしながら、苦しい生活を送っている住民の一人に過ぎなかったからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "それから数日後、誰もが外出をためらうほどの暴風雨が吹き付けていた真夜中のこと……突然教会の鐘が鳴り響いたんだ。悪い人が町に来たという警報の鐘だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "しかし幸い、住民たちが鐘の音で目覚めたおかげで、私たちはなんとか悪い人を撃退することができた。鐘が鳴った理由は誰にもわからなかったが、きっと奇跡だと皆で喜び合った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……私は何気なく鐘楼の方へと向かうと、外の荒れ地で墓を掘っている教会の門番が目に入った。彼のそばの台車には貧相な棺桶があり、中には全身傷だらけのサルカズの酔っ払いが横たわっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "私も墓を掘るのを手伝ったが、門番はその間ずっと悪態をついていたよ。母親のための棺桶をサルカズに使うのは納得できないとか、病気のサルカズだからさっさと埋めないといけないとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "門番が言うには、その晩は雨が降りそうだったから、サルカズに同情して鐘楼で一晩休ませてあげていたらしいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "それで、鐘が鳴った直後にサルカズが家のドアを叩いたそうだ。門番に早く逃げろと伝えると、そのまま玄関で息を引き取ったそうでね……本当についてないと言っていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "門番は文句を言いながらもひたすら土を掘った。なんとか埋め終えると、サルカズがいつも酔っ払って歌っていた歌を真似して口ずさんでいたよ。後半のメロディーはあやふやになっていたけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "門番は最後にまた悪態をついて、瓶のお酒を半分墓にかけてあげた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……高い高い山の風♪……英雄と共に遠くへ♪……長い道を行き♪……イバラを踏み越え♪……えーっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ごめんよ、私もよく覚えてないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……それ、ママとロゼラお姉ちゃんが教えてくれたお歌だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……じゃあ、鐘を鳴らしたのはそのサルカズなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そうだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "じゃあその人もみんなを救った英雄なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そうかもしれないね。でも、彼のような人を英雄と呼べるかはわからない……多くの人がそれを認めないだろうからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "もしかすると彼はただ、自分に良くしてくれた門番を逃がしてやりたかっただけかもしれない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "じゃあ修道士さんは、その人は英雄だと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……セシリア、英雄とは一体何だろうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "私は長い間考え続けてきた……しかし、この問いに答えることで決まるのは、「そのサルカズが何者か」ではなく、「私は何者か」なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼自身について言うならば、彼はきっと英雄になるために鐘を鳴らしたわけではないだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "だけど、私たちが彼を褒めたたえようと、貶そうと、あるいは忘れ去ろうと……もはや彼とは関係ないことなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "私が直面しているのは、すべて「私」自身に関する問いだ……なぜ私はこの事件を目にすることになったのか？　これは私にとってどんな意味があるのか？　そして、私にどんな啓示を与えるのか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そう詰問されるのはいつだって生者だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "しかし私は考えてしまう。いつも考えてしまうんだ――もし彼がやらなければ、どうなっていた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼が同じようにやったとしても、あの狂信……悪い人を鐘楼に呼び寄せてしまっていたらどうなっていた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "町の人が目を覚ましても撃退できなかったらどうなっていた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "さらには、もし彼が鐘楼の上で誰にも気付かれずに死んでいたら、その後……どうなっていた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "絶対に成功する方法も、絶対に確かな選択もないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……だから私は最終的に、その土砂降りの真夜中に彼が鐘を鳴らしたのは、ただ彼がそうしたかったからだと自分を納得させた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "それはささやかな善意の衝動によるものであり、もっとも直感的な行動理由だったとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そしてその結果に関しては、今となってはもう彼とは関係のないことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼は英雄だ。あの歌の英雄と何ら変わらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロゼラ",
      "text": "高い高い山の風♪……英雄と共に遠くへ♪……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……長い道を行き♪……イバラを踏み越え♪……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "他の者もそれに続き歌を口ずさむ。\n小さな歌声が部屋中にこだまする。\n私は安らぎを感じた。\nラテラーノの夜に――\n久方ぶりの懐かしい安らぎを。"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……修道士さん、ボーッとしてどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……いや、何でもないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ありがとう、セシリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "修道士さんが見てるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "あれは鐘楼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ラテラーノの鐘楼だよ。とても古い石塔でね、まだラテラーノにいた頃、私も時々登っていたんだ。空がとても近くに見えるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お空……ママは今あそこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……ああ。君が望むなら、お母さんはそこにいるだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……修道士さん、一つお願いしてもいい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
