{
  "server": "jp",
  "storyId": "act35side_level_act35side_05_end",
  "groupId": "act35side",
  "stageId": "act35side_05",
  "title": "働く展示物",
  "storyCode": "AS-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act35side/level_act35side_05_end.txt",
  "sourceHash": "d6fb5197f6c628dd2d3a14b90e4e08b3e3a6bb5db32d14751f5770dd82ed8375",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "これは何を待っているのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "電話さ。あなたみたいな年寄りにはちょいと新鮮かもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "あとここでどれほど待たねばならぬ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "疑ったりせずに、おとなしく待ってて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "後ほど余にも電話で話をさせてくれるか？　使い方は以前教わっている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ダメダメ、ダメだって。そんな機械の合成音で話したら、詐欺電話だと間違われちゃうじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そういえば、あたしたちの協力は歴史上の偉大な同盟の再現だとか言ってたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "左様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "じゃあ訊くけど、あなたのために宝石を探すことで、あたしに何のメリットがあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あぁ、確かに収穫はあったか。昨日の夜あなたにビビらされた時、この金のサンダルが顔に飛んできたからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "何か問題はあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ないない。生きてることがあなたから受けられる最大の恩恵だよ。あなたはサルゴンの先祖なわけだし、宝石探しの手助けをするのは当然のことだもんね。だから興奮しないでちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "でも、豊穣祭で一位を取った品もこんなサファイアがはめ込まれた純金のサンダルだったような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "左様。それらは恐らく一対のものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "つまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "夜中に通りで叫んで近所迷惑になるのも、一種の金儲けの手段ってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……本来は一対の骨董品だったものだ。しかし片方が川底に永遠に沈んでしまった以上、当然もう片方も価値の大半を失っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……興味から尋ねるのだが、この時代のナイツモラは……皆そなたのように振る舞うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "答えに困る質問だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "略奪や闇取引、誘拐のために、各大部族の風習や信仰を調べたことはあるけど、あたし自身の出身地について調べたことはなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ある日の朝、お天道様が顔を出したあの時以降、あたしは一度も帰ったことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "というと、そなたはもしや……己の天路を歩いているさなかか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "天路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "（古代語）天路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いやいやいや、そんな言葉はこれっぽっちも聞きたくないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしは天路なんて歩かない。ご先祖様に脅迫されたとしても無駄だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "そなたもしや今に至るまで成人の儀を行っておらぬのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだよ、別に重要なことでもないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしの体に少しはナイツモラの血が流れてるかもしれないけど、その数滴の血があたしを暴君や征服者にするわけじゃないし、自分の生活に影響を与えさせるつもりもないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "否。それは重要なことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "天路を歩まぬというのであれば、そなたの血はいかにして先祖に認められる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "構わないさ。あたしのご先祖様たちはほとんどが大地の果てで失踪したし、あなたみたいに突然博物館から甦って叱ってきたりはしないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだ、じゃああなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "シャア時代の人たちは成人すると頭髪を剃ってバルサムを塗るって聞いたけど？　でも、「バルサム」ってのは実は匂いがキツいって言う人もいて……気になってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "余も……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "おっと、来た来た。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……どうした、こんなに早く宝石の情報が手に入ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宝石仲介人",
      "text": "はい。偶然ではありますが、つい先ほど宝石取引所の支配人が情報を出しまして。すぐに取引したい宝石があるそうなんですが、それがあらゆる点であなたの説明と一致しているんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "よし、直接そいつに会いに行くとしようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宝石仲介人",
      "text": "ですが……たとえ私の紹介があっても、その支配人と直接取引するのは難しいと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "何だって？　あたしの手下たちからは、直接受付に行ったら宝石が売れたって聞いてるけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宝石仲介人",
      "text": "確かに売るのは簡単ですが、買うのはまた別なんですよ。宝石取引所は普通の店とは違っていて、支配人から直接品を受け取るには、十分な「錘（おもり）」を差し出す必要があるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "十分な錘？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……いい考えがある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "コホンッ、そう、あたしが話したい商談はこれについてなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "これは近頃博物館で展示されている古代のミイラ……シャア時代の名もなき将軍さ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "宝石取引所の若き支配人は複雑な表情で彼女の方をちらりと見て、それから巨大な金メッキの箱の前で身をかがめる。\nズバイルは両手を胸の前で交差させ、静かに横たわっている。\n客観的に見て、これこそがズバイルの最も価値のある状態であるとナラントゥヤは思う。恐ろしげな黄金のマスクでさえ、今この瞬間だけは神聖で柔らかな光を放っているように見えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "この箱には見覚えがあるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "これは博物館からそのまま持ち運んだ棺……のレプリカ、レプリカさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "……（ズバイルの体を軽く叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "（懐中電灯で胸の中を調べる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "えーっと、これはそんじょそこらの遺産とはわけが違うのよ。専門家らしく、尊重した扱いをしてほしいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "……これはすでに復活し、思うままに動けると聞いたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "それは全部アーツによるパフォーマンスさ。人は死んだら生き返らないってことは誰もが知ってるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "それに、もしこれが本当に動いたら、怖くない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "買い取った後に勝手に逃げ出さないかって？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "それは……\nあれ、そっちの黒い動物はあなたのペット？　あはは、綺麗ね！"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "さすが宝石取引所の支配人、都市全体の金銭の流通を掌握している人だ。ペットも個性豊かだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "（小声）ワオ、彼で合っているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "（嗅いで探る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "（棺のそばで座る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ほら、見なよ。この子が嗅ぎ取ったよ。千年もの間死んでいた臭いなんて絶対に偽造できないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしの誠意にこれっぽっちも嘘が混じっていないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "もちろん、この品があまりに貴重だってのはわかってる。あなたであってもそう簡単に取り扱えるものじゃないだろう。つまり、あたしは面倒事を押し付けることになるからそこまでの金は望まない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "だけど博物館があたしにたどり着くことはないって保証するよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "いや、あなたは十分な錘を差し出した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "ただ、決して私の秤で量れないほどではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……あぁ、そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "何と交換したい？　宝石を求めて来たと聞いたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ああ、元々はそうだったんだけど、来る途中で考えが変わったよ。あの宝石はもう必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしはよそから来たんだ。金の延べ棒をくれればいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "純金で精算していいか？　専用の秤を取ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "その間にほかの人に見られないよう、品物を部屋の中に運んでくれるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なら……交渉成立？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ハッ、ああいう潔い奴はいいね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "この棺の中で再び眠る感覚は微塵も好きではない。そなたの手下にわざわざこれを運び出させる必要はなかったと思うが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "シッ、しゃべるんじゃないよ……もう少しの辛抱さ。すぐに迎えに来るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "急ぐんだよ。今日中に目当ての宝石を見つけといて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "わかった。ゆめ忘れるな。まだそなたには用がある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "これが対価だ。いかがかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "えーっと……♪刃に映る忘れえぬ三日月、少年の心は清められ黄金になる♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ほんと忘れられないね……異存はない、全くないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そんじゃあたしはこの辺で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "ああ、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "（ズバイルに目くばせする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "（ナラントゥヤに目くばせする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "それじゃあ今後ともよろしくね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "今後があるとは言っていない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ハッ、あたしだって別に今後があるとは言ってないよ。少なくともしばらくの間は絶対にね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "しかもあの骨董品、あたしをパシリに使おうって魂胆かい？　悪いけど、これでおさらばだよ！",
