  "title": "不治の病",
  "storyCode": "2-10",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_02-10_beg.txt",
  "sourceHash": "3e5fd6f0cd83db7589dc49504dbb42598815d3d8f3618b676e632c841ea5a4d3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "リスカム！　そっちはまだ持ちこたえられそう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん、問題なし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカのほうも、両翼からの攻撃に気をつけて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ええ！　にしても、ほんっとしつこい連中ね……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ハッ！　この護り、打ち破れるとは思うなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前らなんざ吹っ飛ばして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――っ、ぐ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "いっ……く、クソッ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "何なんだ、その剣は……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ふふっ、すごいでしょ。下手に触るとヤケドじゃ済まないわよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まあ、それで済ます気もないけどね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ふー、やれやれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "医療班、こっちへお願い！　負傷者がいるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "運ぶときはそーっとしてあげて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "――アーミヤ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そっちの状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ちょっと面倒が起きてるところ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　フランカさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "こちらはリスカムさんと同行中、レユニオン幹部と遭遇したところです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "隠れようとしても無駄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "お前らに逃げ場はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "今から全員、俺がこの手で――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――徹底的にぶちのめしてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "お前らは……感染者を裏切ったんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あ～ら、ようやくご本人様のお出ましね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "聞いた感じ、超小物っぽい口上だったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "！　アーミヤさん、このままでは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ってうわ、行き止まり！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もしかして、ルートを外れちゃってたかしら……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "っ、向こうも同じ状況か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どうやら、誘導されていたようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "アーミヤさん、ここは強行突破しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "我々の実力なら、奴らを退けるには十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "少し本気を出せば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "わかってないわねえ、リスカム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "本気を出すのは別にいいけど、それで近衛局に目をつけられたら厄介なことになるのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そのくらいわかってる！　それでも、四の五の言ってる場合じゃないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――重装部隊、防御陣形を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……お前が、ロドスのリーダーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "自分も感染者のくせに、龍門なんかの感染者狩りに手を貸しやがって……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "犠牲になった同胞たちの命は、お前らの血で償ってもらうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――かかれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っ、レユニオン……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの日、チェルノボーグで……復讐と称して他人を傷つけ、はじめに暴力を振るったのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたたちのほうです！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
