{
  "server": "jp",
  "storyId": "act29side_level_act29side_07_end",
  "groupId": "act29side",
  "stageId": "act29side_07",
  "title": "協奏曲「復活」",
  "storyCode": "ZT-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act29side/level_act29side_07_end.txt",
  "sourceHash": "ba48cd293debf76eb86a41b6cc0a155063e4a2e3c0712fc92a2b04f9f7e5d212",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "憲兵……お医者さんがすぐに来ます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "ゴホッ、ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "ヴィヴィアナ、泣いているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "……私にはもうあなたの涙を拭いてあげる力もないみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "はぁ、本当に繊細で、優しすぎる子ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "私たちが初めて会った時のことをよく思い出すの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "ツヴィリングトゥルムからシュトルム領へ駆け付け、ウェルナーの高塔からあなたを迎えた。あなたは車の後部座席で縮こまり、小さなトランクをぎゅっと抱きしめ、私の胸にそっと頭を寄せた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "父親と離れるのが怖いのかしら？　それとも、これから向かうカジミエーシュという異郷での生活に恐怖を感じているの？　当時はそんなふうに思っていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "だけどヴィヴィアン……あなたはただ、目立つ角を見られないように姿勢を低くしようとしているだけだった。行き先が明るみに出れば、ウェルナーに面倒をかけてしまうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "実は、あの時はすでに夜更けで、あんなに大きな選帝侯の高塔群の中じゃあ、誰も一台の車が去ったことに気付くことはなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "ゴホッ、当時のあなたはとても小さかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "もう覚えていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "いいえ、覚えているでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "ヴィヴィアナ、あなたは恨んでいい、責めていい、失望していい、後悔していい、憤っていい、ゴホッ、何を思ってもいい……だってそうしてようやく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "私は……あなたを失いたくありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……私には、もうあなたしかいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "もう一度……私によく「見せて」ちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ここです、私はここにいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "あなたの今の表情が見えなくて本当によかったわ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コーラ",
      "text": "ヴィヴィアナ、あなたはもっと良い生活を送っていい……送るべきだわ……もし本当にそのような生活があれば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "女帝の塔はどれだけ高くとも、果てがないわけがない。\n螺旋階段は目の前に広がっている。しかしその方向は未知の不可逆的な力に引き裂かれているようだった。彼女はずっと前へ進んでいるのに、いつまでもその場を離れられずにいる。\nヴィヴィアナは少し疲労を感じた。そして人は疲労を感じた時、自分の失ったものに気づきがちだ。\n……彼女の二十二年の人生のように。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どうされました、道に迷ってしまったんですか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ヴィヴィアナは顔を上げた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そこには若いキャプリニーの女性が立っていた。こちらを見る彼女の顔は好奇心と親切心に満ちている。"
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ごめんなさい、私が急ぎすぎたせいであなたにぶつかってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "あの、顔色がとても悪いですけど、大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "はい。ただ考え事をしていただけです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "あなたはこの場所にお詳しいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "はい、この近くに住んでいますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "では、この先はどこへ通じているのか教えていただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "えっと、自分で来たんじゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "道がどこへ通じているかは、あなたがどこへ行きたいかで決まるものですよ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "それじゃあ気を付けてください。私はもう行かないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "私がどこへ行きたいか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヴィヴィアナは指先で傍らの手すりをなでた。分厚い埃の下には、赤褐色のペンキがウルティカ家の紋様を覆い、その鮮やかさはまるで昨日塗られたばかりのようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "巫王。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は前に読んだあの『余燼』という歴史小説を思い出した。\n巫王は即位してまもなく、職人たちに一枚の設計図を渡した。そこには、リターニアの未曽有の巨大建築物――「始源の塔」が描かれていた。\n設計図を見るだけで、まるでその下に立っているかのように感じ、息が詰まった。\n始源の塔に対する巫王の要求は極めて厳しく、手すり一本一本の材料や塗料に至るまで細かく指示し、永遠に色あせないよう求めた。\nそれはリターニアの唯一の象徴となる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "どういうこと、「始源の角」は完全に降臨したの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "けれど先ほどの女性は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヴィヴィアナははたと気付いた。\n先ほど通りかかったキャプリニーは、ツヴィリングトゥルムの外縁エリアで最もよく見かけるような若者だ。エネルギーに満ちた年頃で、忙しくても疲れ知らず、その声は新茶のような熱気があった。\n女帝の塔にせよ、「始源の角」にせよ、彼女のような人がいるはずがない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヴィヴィアナは慌てて振り返ったが、相手の姿はとうの昔に消えていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ヴィヴィアナ、ならあなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "あなたはどうしてここにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "なぜリターニアに戻ったの？　当時はなぜ去ったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "階段は依然延び続ける……ある目立たない角で、ヴィヴィアナはふと一つの扉を見つけた。\nこれ以上ないほどに見慣れた、小さな扉。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "接続地点ごとに左折し、進行方向から逸れながら前進。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "失敗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "下りを試みます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "四十五分経過。いまだ螺旋階段の底に戻れず。失敗。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フェデリコは、すでに女帝の塔の螺旋階段で相当な時間を浪費していた。再び突破に失敗すると、彼は足を止めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "原理からすれば、アーツとはより厳密な秩序です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "双子の女帝は高塔の設計に精神疾患を抱えるデザイナーを起用するはずありません。このような支離滅裂な建築構造を再現できる職人もいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ルートヴィヒ大学の奏鳴塔における経験が私に判断を誤らせたようです……女帝の塔の内部で起きている歪みは術式とは無関係です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "「始源の角」が女帝の塔を覆って、空間に異変を起こしたのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アルトリアのチェロの音も消えました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フェデリコは少し考えると、守護銃を抜き、前方へ発砲した。\n鋭い発砲音が空間全体に響き渡る。だが弾は形のない何かにかき消され……目の前で消失した。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そちらのサンクタさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "声が響いた瞬間、フェデリコには再び数発の銃弾が見えた。まるで石が水面に浮かぶように銃弾の軌跡はゆっくり、そしてはっきりしている。漣が広がり、水の下のすべてが次第に浮かび上がる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "ふぅ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "銃をしまってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "銃をしまってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "繰り返す必要はありません。聞こえています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "今回の任務で遭遇する人は全員そう繰り返しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "それは常識だからですよ……ツヴィリングトゥルムはラテラーノとは違います……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "ロリスがよくラテラーノについて話していました。サンクタは道を歩く時に、気に入らない建物があると「爆破」しようとして、気に入った建物だとさらに「爆破」したくてたまらなくなるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "あれはただロリスが故郷に良い印象を持っていないから適当にでっち上げたものだと、私とヤンはずっと思っていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "とにかく、周りを見てみてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "ツヴィリングトゥルムは古い都市で、どこかの壁やレンガに、百年前の芸術家が酔っ払って、アーツで刻んだ楽譜や詩があるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "周り……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "フェデリコはすぐに目の前の異様な光景に適応した。\n仮にここが「始源の角」、「巫王の遺産」が保管されている場所、即ちアルトリアの最終目的地であれば。\n弾丸一つで何かしらの障壁を破り、自らをあの不可解な螺旋階段からここへ連れてこられるとは思えない。\nフェデリコは目の前の女性を見る。彼女は顔に怒りの色を浮かべている。それは観光客の常識外れな行為を制止する正義の市民そのものに見えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "サンクタさん、理解してもらえますか……銃をしまってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "少しよろしいですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私たちは明らかにツヴィリングトゥルムの街にいないのですが、あなたには全くその自覚がないようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それと、あなたは今「ロリス」と「ヤン」と言っていました。もしそのフルネームが「ロリス・ボルディン」と「ヤン・シュールレ」だとすれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "お名前と身元を教えてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る女性",
      "text": "ユリア……ユリア・シュールレです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ここが……「始源の角」内部、巫王の死後の地？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "けど巫王は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "なにキョロキョロしているんだ、サンクタ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "追ってきたのね……驚くことではないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "フフッ、むしろお前の方がまさかリッチの糸にしがみついて、自分から「追放」されるとはな……とても驚いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……巫王はどこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "死んでいる。当然だろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "いえ、彼を感じることができるはず。彼のアーツ、彼の感情、彼の意志……私が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アルトリアが周囲を見渡す。この空間には、境界など存在していないかのように、ただいくつもの名状しがたい光と影が流れている。まるで混沌の呼吸のようだ。\n彼女はチェロを立たせ、指でそっと弦を押さえると、弓を当て、そして引いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "静寂。\n弓と弦は交わるも、何の音も発さない。体に染み付いた動作も、この瞬間に突然意味を失った。"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "フンッ、ようやく気付いたようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "演奏できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私は音を……失ってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "「始源の角」のせい？　それとも巫王が定めた「ルール」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "傲慢。愚鈍。バカ。お前の頭の光輪は肌を白く見せるだけで、頭のキレを良くする効果はないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ここがどんな場所だと思っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ヘーアクンフツホルンの棺桶か？　サルゴンにある歩くと砂がこぼれるパーディシャーの宝の洞窟か？　ヴィクトリアのおとぎ話に出てくる老いた魔女の魔法のポケットか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フレモントさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "（サルカズ語）「千糸万弦の終始」。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "独り言のように、フレモントはサルカズ語でそのあまりに聞きなれない単語を発した。"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "あるいは、あいつが付けた名を用いた方が、お前たちの認識能力には合っているかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "（リターニア語）「荒域」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "荒域……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "お前が見ているのは「実在」のもう一面、空間のもう一つの次元なのだ。それは永遠に変化し、あらゆる規則や現実はそれに触れられた瞬間に滅ぶ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "我らリッチ一族は長い時の中で、それを垣間見たことがあるにすぎない。ヘーアクンフツホルンは生涯を費やして、この果てなき混沌の中にこういった不安定なしゃぼん玉を作り出したくらいだった。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アルトリアはフレモントの怒りに反応しない。彼女は再び弓を当てるも、チェロは沈黙を保ったままだ。\n失望も、恐怖もない。あるのは疑問だけ。\n強烈な疑問がアルトリアの顔に一瞬浮かんだ。すると、彼女は顔を上げ、相手に向かって微笑む。"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "素晴らしいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "巫王は、何か秘密の方法に頼って自らの意志を引き延ばしたのではなく、荒域の中に自分の「宮殿」を築いたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "この空間は実在している。なら、彼もきっとこの場所にいるわ……ただ彼の玉座にたどり着くには、もう少し歩く必要があるのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "……お前は、荒域内で再び「追放」された場合に何が起こるかわかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "影が伸び……アルトリアはとっさに警戒する。\n自分が話している間に、相手はすでに巫術を放っていた。フレモントを中心として、その糸のような影は膨張し太いツルとなり、元々曖昧な色彩の地面に溶け込んで根を伸ばしてくる。\n腐敗の息吹が広がる。それが限界まで満たされた形態は、即ち死と消滅だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……まだ答えを得られてないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私の音を取り戻さないと。巫王を、演奏しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私はまだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……死ねない。\n彼女は演奏をすることで終点へ向かうのを厭わない。しかし真相の前で、静寂の中で自らが消えるのは受け入れられない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "影が一瞬にして裂けると、灰色の雨が上へと逆流し、全てを包み込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫王の楽師",
      "text": "ウィーン大時計塔が鳴った！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫王の楽師",
      "text": "早く、始源の塔へ行こう。演奏が始まるぞ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫王の楽師",
      "text": "新たな曲、新たな術式……ヴィドゥニアを天災やガリア人の火砲から守ってくれる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫王の楽師",
      "text": "ヘーア……ヘーアクンフツホルン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "……ここの時空は安定していない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "「追放」が誘発したのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "いや、私たちが荒域に入る前からこうだった。ヘーアクンフツホルンの力が衰えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "「始源の角」の……崩壊が加速している。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "うっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私は……まだ生きてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "さっきの旋律が……また消えた……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は周囲の環境とは異なるその音をつかみ、「追放」の糸から死に物狂いで逃れた。\nそして今、その旋律は実体となり、混沌の中から出てきて、彼女の前に落ちた。\n一人の……人間となった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（はっきりしない音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなた……は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "さっきの旋律はあなたが奏でて、私を……救ってくれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（はっきりしない音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたは巫王のそばに仕える……高塔術師なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユリア",
      "text": "ふ、巫王！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユリア",
      "text": "私が巫王とそんな関わりを持てるわけがないでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユリア",
      "text": "あっ、気を付けて、あまり話さないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユリア",
      "text": "誰かに追われてるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユリア",
      "text": "怪我してますよ……無茶をせず、まずはここで隠れててください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユリア",
      "text": "安心してください。この辺りには詳しいので、誰にも見つかりませんから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
