{
  "server": "jp",
  "storyId": "main_7_level_main_07-15_end",
  "groupId": "main_7",
  "stageId": "main_07-15",
  "title": "感染者の盾-2",
  "storyCode": "7-17",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_07-15_end.txt",
  "sourceHash": "d7042664ba819932b1702068550d16cd8c63ec6193fa5d9393d5257220d67751",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "３番伝令兵、沈黙しました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "７番伝令兵、片付いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "８番伝令兵、制圧完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "Raidian、陽動作戦を展開。君のアーツで影響範囲を拡大するほか、奴らの神経システムに直接干渉しても構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "全ての敵を引きずり出せ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はぁ、はぁ……厳しかった……皆さん大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーター",
      "text": "なんとか……でも正直ヤバかったです。こんな規模の戦いは初めてですからね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーター",
      "text": "もし帰れたら、今度は長めの休暇が取りたいです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。きっと許可します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "でもその前に……この部隊をなんとかしないと！　あとで昇給でも長期休暇でも特別手当でも、何でも叶えますから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "敵がいるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "歩調を乱すな！　陣形を整えろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "東方向出口で戦闘が発生？　下手に動くな。慎重に方向転換。敵に隙を見せるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "この戦術はウルサスでも炎国でもないな。どういうことだ？　今度の敵は誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "いつもはウルサス軍に戦いを仕掛ける側だというのに、今度は自分たちが襲われる番ということか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "実質的な戦闘は発生していない？　……腰抜けが。遊撃隊を舐めると高くつくぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "祭壇に注意！　大尉が付与してくれた防護措置は、その影響を軽くしてるだけだ。必要がない限りあの近くを通るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "伝令兵、すぐに他の部隊に知らせろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "おい……返事はどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "砲手たちは？　サルカズの連中は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遊撃隊戦士",
      "text": "待て。何かがおかしいぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "12番の伝令兵、片付いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーター",
      "text": "遊撃隊が部隊を後退し始めた！　今が前進するチャンスです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "待て！　罠かもしれない！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えっと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "わかりました。ロスモンティスさん、私たちのアーツで周囲を確認しましょう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "届かない。敵が……何かが私を阻んでいる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "サルカズの術師だ。彼らにしかこの手のアーツを無効化する手段はない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "なら私に任せてください……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Raidian、あとどれくらい持つ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……わかった、こちらを急がせる。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……見つけました。その通りです。彼らが拠点とする建物の中に、狙撃手や術師がたくさんいます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "冷静で……少し興奮気味ですが、感情的になってはいません。彼らは……拠点を死守しているんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……責任を持って。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクターの言う通り、確かに罠でした。待ち伏せされています！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "近くに着いた。私がやる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "できそうですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "できる。建物全体じゃなく、彼らのいる足場を崩す。そうしないと彼らに邪魔される……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "アーミヤ、私はできるよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい、ロスモンティスさん……わかっていますよ。あなたはきっとできます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "……アーミヤは私に感服してくれる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "え？　かん……なんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "ブレイズが、アーミヤが感服する人は滅多にいないって言ってた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ああ、感服ですね。急に炎国の言い回しをされたので、聞き取れませんでした。つまり……尊敬するということですね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "私にもわからない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……大丈夫ですよ。私は最初から、ロスモンティスさんに「感服」しています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ロスモンティスさんは本当にすごい人です。私にはとても耐えられませんから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "失うこととか、孤独とか……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ロスモンティスさんのように耐えることなんてできません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "嘘つき。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "え……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "でも別にいいよ。嘘つきでも、アーミヤはアーミヤだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "私みたいな人に感服して……いいの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "もちろん。ロスモンティスさんはロスモンティスさんですから……私はあなたのことを尊敬しています。エリートオペレーターとしても、友達としても。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "頑張ってください。ロスモンティスさん！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "うん。頑張る。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "まだ出てこない？　奴らは何を待っている？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "おい、ダメだ！　このエリアを離れることは許さん！　奴らの姿を見つけ反撃するんだ。これ以上伝令兵を失うわけにはいかない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "待て。向こうのビルの上に立ってるのは何だ、敵か？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "……猫？　フェリーンの子供か……！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "伝令兵！　術師に知らせろ！　敵は向かい側のビルに術師を配置している！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "そいつを潰せ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "――何だ？　何か棒みたいなものが空中に……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "違う、剣だ！　どういうことだ？　巨大な剣が宙に浮いている！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "ここから、あそこまで、切る。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "手で、掴む……剣で、切る。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "じゃがいもを二つに切るみたいに。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "じゃがいもを二つに切るみたいに……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ドクター！　私のそばに来るんだ！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ビルが……真っ二つに！？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ロスモンティスが遊撃隊の拠点を破壊している。落石に気をつけるんだ！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……あれは一体何だ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ロスモンティスのアーツに対する質問と捉えよう。そろそろ君にも説明した方がいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "あれは彼女自身の精神状態が具現化したものだ。彼女の周囲には、観察することも触れることもできない巨大なエネルギー体があると解釈して良い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "それが彼女の感覚を拡張している。彼女はそれで物体を握ったり、押したり、振り払ったりもできる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかし、彼女の主観的で確固たるイメージに対し、第三者にとってこのアーツは、客観的な視認性や質量を欠いている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "我々はその力を一方的に受けるだけで、返すことはできない。これは非常に特殊なアーツで「それが確実に存在する」という結論しか得られないのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "理解するのは難しいかもしれない。君の専門外のことだからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "武器を与えられる前、彼女のアーツはもっと大規模で無秩序な破壊をもたらした。移動都市に轢かれたような廃墟には、そこで跪いて号泣する幼い娘の他に、動くものは残っていなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "あのような状況は二度と繰り返してはならないのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……ドクター、行こう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "見えた。指揮部隊はもうすぐ現れる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "廃公園の噴水。その下には地下水路が通っているはずだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "あんな場所に隠れているとは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "灰馬峰で7日間潜伏し、当時最強の征戦騎士たちをも欺いたというあの待ち伏せ作戦の話は本当だったのかもしれないな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "今だ！　行こう。Dr.{@nickname}、急ぐんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Raidian、交戦を停止。安全を確保し、通信の維持に専念。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Mantra-2、全ての会話をしっかり記録するように。一言一句も漏らさずにだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "14番の伝令兵、片付いた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "アーミヤ、ケルシー先生。準備できたよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "（おい、大丈夫か……俺を見ろ！　なんとか言え！？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "（よし、何とか生きてるな。俺は平気だ。お前はここに隠れてろ、見つからないようにな……お前の力でチームを立て直すんだ。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "（わかっている。敵は俺が何とかする。お前は声を出すな！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "（俺は大丈夫だ、怪我などしていない。こんな石ころ、ウルサス人の破城槌に比べりゃ屁でもない。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "（おい、慌てるな！　俺が引きつけるから、お前は隙を狙え！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "…………",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "そこのお前たち！　さっきから突っ立って何を見ている！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "どこの国の部隊か知らんが、なぜ攻撃してこない？　パトリオットの血と巫術が怖いのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "サルカズとの戦闘を思い出すだろう。奴らと戦ったことはあるか？　サルカズに、その数倍もの戦力で対抗して勝ったとしても、受ける損害も数倍だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "だが俺たちの力はそれをさらに上回る！　お前らは俺たちの盾も、鎧も打ち破れない！　不沈艦パトリオットの前では、お前たちなど虫けらも同然だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "ウルサス史上最も偉大な戦士……槍も盾も使わずに、足だけでお前たちを粉々に踏み潰してやることもできる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "お前たちは……何ひとつできやしない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "遊撃隊の戦士はすぐにまたここに集まってくる！　レユニオンは、お前たちを一人も逃さない。必ず報いを受けさせてやる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "この圧制者どもめ……よくも感染者を奴隷扱いしてくれたな！　お前たちは必ずレユニオンが殲滅する！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "レユニオンが――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "レユニオンは、既にあなたたちを裏切ったかもしれません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "――なんだと、小娘？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "…………",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "……感染者の小娘が……二人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "お前たち何をしている！？　何を企んでいる！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "どいて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "あなたの後ろのそれ……壊すから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "…………",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "子供だからって俺が手加減すると思うなよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "パトリオットの盾兵を舐めるな！　俺たちは感染者の盾だ……ここに立ってるのも、お前たちを止めるためだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "わずかでも感染者に近づいてみろ、絞め殺してやる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "言葉が通じないのなら、私はアーツで語るしかない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "お前……さっきの猫か。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "その剣は……一体？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伝令兵",
          "text": "（お前はもう行け！　俺のことはいい、他の奴に知らせるんだ！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "（それはお前の仕事だ！！　生きろ！！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "さあ、かかってくるがいい！　この盾を貫けると思うのか？　俺の鎧を斬れると思っているのか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "アーミヤ。もう待てない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "でも……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "死なせはしない。でも立てないようにはなるかも。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "待て――",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "行け。突き飛ば……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "そうは、させん。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "（私の剣を振り払った？　しかも片手で……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "（うっ……手が……痺れてる……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "いつの間にここに？　気配を感じなかった……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "違う。もしかして……さっき建物が倒れたと思ったあの感じは……本当はあなたが近づいたせい？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "あなた一人、いや、あなたとあなたの部隊が……一つの——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "山に見える。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ロスモンティス、撤退だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロスモンティス",
          "text": "でも……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ロスモンティス、これは命令だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "命令だと言っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "遊撃隊戦士",
          "text": "大尉……！　パトリオット大尉！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "お前は、よくやった。もう行け、戻るが、いい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "そして、諸君は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "ロドスか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "今の私には、諸君が、何者かなど、どうでも、いい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "私の部下を、攻撃した、諸君には、死んで、もらう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "身分はどうでもいいかも知れんが、立場はどうなる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "それも、関係な――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "……待て。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "貴方は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……思い出したか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "貴方が……何故……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "久しぶりだな、ボジョカスティ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "貴方は……ケルシー、士爵？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
