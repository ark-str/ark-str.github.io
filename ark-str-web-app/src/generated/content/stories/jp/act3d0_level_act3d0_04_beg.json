  "stageId": "a003_04",
  "title": "ザ・ジェネラル",
  "storyCode": "OF-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act3d0/level_act3d0_04_beg.txt",
  "sourceHash": "82419a563b47bc327e822118c132f6e62a24b86f2af7a5e44f65188f440a50a8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "A小隊とB小隊、遠距離から敵を引き付けろ。C小隊は、後ろから回り込んで包囲しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "ほう、傭兵団の戦術か……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "それなりの実力は備えているようだな。良い教官がいたのだろう。だが、それでは足りない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "シュヴァルツさん、あ、あのジジイ。マジで強ぇっすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "確かに、レベルが違うな。周囲で守りを固めていろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "………。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（あの女性……只者ではないな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（普通のボディーガード程度では私に傷をつけることは叶わんが、彼女は脅威になりうる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "無知なよそ者め……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（怒りを向けるのか。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（彼女の立場上、本当に我々がセイロン殿を騙していると考えているのかもしれん。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（だが、それにしてもこの実力……彼女は一体……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "さすが経験豊富な傭兵というべきか。守るべきお嬢様が攫われても少しの動揺も見せないとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "当たり前だ！　俺たちのリーダーは昔……むぐっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "黙っていろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（む？　待て……クロスボウにフェリーン、そしてシュヴァルツという名前。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（どこかで聞いたことのある名だ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "待て、あのジジイ何するつもりだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（ドクターの方も少し心配ではあるが。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "（……しかしドクターの能力、そしてシエスタにいるオペレーターたちのことを考えれば、恐らく問題ないだろう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "こちらへ突っ込んでくるぞ、気でも狂ったか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "は、早く止めろ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "へラグ",
      "text": "遅い！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
