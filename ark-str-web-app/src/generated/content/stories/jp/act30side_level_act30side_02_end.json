{
  "server": "jp",
  "storyId": "act30side_level_act30side_02_end",
  "groupId": "act30side",
  "stageId": "act30side_02",
  "title": "同乗異心",
  "storyCode": "RS-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act30side/level_act30side_02_end.txt",
  "sourceHash": "a333b811b397d3ba96dee56f051cc0e2fa7d92d6bbe974a4cd80728ecb4f41d6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "見て見て、雪山！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "めっちゃ近いね！　これがカランド？　そうじゃなくてもすっごく綺麗な景色だけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "あ、あのさ、窓閉めてくれるか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "さ、さっきから寒すぎて、く、くちがまわらないんだよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "大げさすぎでしょ。そんな耐えられないレベルじゃないと思うんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "マジ？　お前寒くないの？　ズボンも穿いてねえのに――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "サイテー。次似たようなこと言ったらセクハラで訴えるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "私はあったかレギンスの一番厚いやつ穿いてるから平気なの！　あんたの格好よりこっちのがずっとあったかいんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "いってて……はいはい、わかりましたよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "ふーんだ……ほら、写真撮るからもっと寄って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "なあ、何か聞こえないか……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "紳士淑女の皆様方、どうもご機嫌麗しゅう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "観光やレジャーのお邪魔をしてしまい、誠に申し訳ありません！　恐れ入りますが、少々席にお戻りになって道をお開けいただけますでしょうか！　我々は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "こんな時にゴチャゴチャ言ってんじゃねぇっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ほらほら、悪りーけど皆どいてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ロザリン！　それではあまりに失礼なのでは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ちょ、ちょっと、そんなに引っ張らないでください！　袖がちぎれてしまいますよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "えーっと……これもイェラグの風習なのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "私たちも走ってみる……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "そんなわけないだろ。バカっぽいし、俺はやらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "そう？　ま、じゃあ先に写真撮ろっか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "カメラ見て！　3……2……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "1……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "こういう追いかけっこは嫌いじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私は好きとは言えませんね。座ってゆっくりお話しできませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "やましいことがあって逃げてるのはそっちでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "止まらずに走り続けたほうが身のためよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ああ、ついでに言っておくと、あと五分で一番綺麗な景色が見られるわよ。せっかくならそこで撮ったほうが良いかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "それじゃあ楽しんで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "今の人、誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "さあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "でも、こうしてみるとやっぱお前が言ってた通りかもな。もしかしたら、イェラグには本当に列車内でダッシュする風習があるのかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "それだったら俺たちも……まあ、郷に入っては郷に従えって言うしなあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "どうしたんだ？　さっきからぼーっとして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "み、見て、この写真！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寒がりな観光客",
      "text": "あ、そういやどうだったんだ？　さっきの人はあと五分でもっといい景色が見られるとか言ってたし、もうちょっと待ったほうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "そうじゃなくて！　いいから見てよ！　さっきのお姉さんの顔が偶然ばっちり写ってたの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "なんかこの人、見覚えがあるような……どこかで見た気がするんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "まあ、カッコいいから何でもいっか！　これ、軍服なのかな？　超似合ってるよね～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気な観光客",
      "text": "この写真、宝物にしよーっと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "もてなし好きの地元民",
      "text": "では、皆様にご紹介しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "もてなし好きの地元民",
      "text": "こちらは、このイェラグで最も有名なチーズフォンデュでしてね。地元特産の美味しいチーズを使っているからこそ、ほかでは味わえない濃厚さをお楽しみいただけるのですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な観光客",
      "text": "まあ、本当にそんなに美味しいの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ほらおっさん、もっと急げって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お、お待ちを……ごほっ、ごほごほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "紳士淑女の皆様方、失礼いたします！　こちらのチーズフォンデュは確かに絶品なのですが、コショウを少し加えるとさらに風味が増しますのでオススメですぞ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "もてなし好きの地元民",
      "text": "な、なんだ今のは……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "もてなし好きの地元民",
      "text": "またか！　一体どうなっている！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な観光客",
      "text": "……イェラグの列車の旅って、やっぱりとてもユニークね。お友達が言っていた通りだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な観光客",
      "text": "あら、コショウを加えたら本当にすごく美味しいわね。この味、気に入ったわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの地元民",
      "text": "はぁ、つ、捕まえたぞ！　これで全部だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの地元民",
      "text": "皆さんのおかげでなんとか、羽獣はみんな見つかりました。手伝っていただいてありがとうございます。どうお礼すればいいやら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乗務員",
      "text": "これからは袋の口をしっかり結んでくださいね、おじいさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乗務員",
      "text": "というか……今回は大目に見ますが、そもそもこの列車は生き物の持ち込みが禁止されていますので、よく覚えておいてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乗務員",
      "text": "次はありませんからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの地元民",
      "text": "いやあ申し訳ない、よく気を付けます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの地元民",
      "text": "おおっとお二人さん、何をそんなに急いでおるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乗務員",
      "text": "お、お客様！　車内では走らないでください！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの地元民",
      "text": "うわっ！　そこの帽子の兄さん！　気を付けて……ああっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの地元民",
      "text": "なんてこった、わしの羽獣が！　も、戻ってこーい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悩む観光客",
      "text": "このブラインドボックス、何回引いても限定のシークレットが当たらないじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悩む観光客",
      "text": "も、もう一個だけ……もう一個だけ買ってみよう……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悩む観光客",
      "text": "おい、気をつけろ！　ボックスの中身が壊れたらどうすん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悩む観光客",
      "text": "あっ！　し、シークレット！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ここまでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "これが最後の車両よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "追いかけっこはもうおしまい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "疑うべくもなく、あなたの勝ちですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ですがどうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "黙りなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "こっちはあまり時間がないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "焦らずとも、あなたが話をしたがっていることは覚えておくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "後で二人だけで「お話し」しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "さあ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "出てきなさい。これ以上手間をかけさせないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "けほっ、ごほごほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "お、おう姉ちゃん！　私ならここだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "けほっけほっ、うえ……ほこりっぽいな、この床……そんで、私に何の用なんだ？　美人の姉ちゃんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "私が探してるのはあなたじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "でも、ここには私しか……\nうわっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "（小声）おい、じっとしてろよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……さっきから、それは一体何のお芝居？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "し、芝居！？　そそそそ、そんなことしてねぇって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "（小声）おっさん、大人しくしろっての！　今誤魔化してやってるとこなんだぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（小声）あいたた、髪を引っ張らないでいただけますかな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あなたロドスの人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "え？　そうだけど……ロドスを知ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ひょっとしてあんた、ドクターが前にここへ来た時出会った知り合いかなんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "知り合い？　違うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そんなことより、お喋りしてる暇はないんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "私が我慢できなくなる前に出てきなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（小声）もう結構ですから、出していただけませんか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ぷはぁ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "私のためを思ってここまでしてくださることには感動しましたが、少しは手加減していただきたいものですな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ううっ……私の髪が、それに髭が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "やっと見つけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なんだ、知り合いだったのか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ごほん、うぉっほん。\n知り合いというほどのものではありません。以前に何度かお会いしたことがあるだけですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お久しぶりです、デーゲンブレヒャー殿。お見苦しいところをお見せしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "挨拶はいらないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "山にいるレオン爺さんから、あなたを急ぎで呼んできてくれと頼まれたのよ、クレイガボン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……レオン殿が、私を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お待ちください。私を探していたのはレオン殿なのですか？　貴方ではなく……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あなたを見つけてほしいと頼まれた以上、同じことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そこまで急ぎのご用件とは、一体どうされたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "言われてみれば、何か忘れているような気もするのですが……はて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "リリーのことよ。あの子があなたを待ってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……そうでした、リリー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "誰だよリリーって……まさか愛人か？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "あ、愛人――！？\nごほっ、ごほん、違います！！"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……子爵様。そういった行いは、ヴィクトリアのイメージを損ないかねませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ご夫人とお嬢様がこのことをお聞きになれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "うわぁ、クズじゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お、お待ちを！　げほ、ごほっ、この忌々しいほこりめ……！　違います、違うのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "リリーは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ご乗車の皆様へお知らせします。この列車はまもなく、終点――\n銀心湖駅に到着いたします。\nお忘れ物をなさいませんよう、お気をつけて、各車両前後のドアより順序よくお降りください。\n当列車をご利用いただき、誠にありがとうございました。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "今ならまだ遅くはないはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "でも、列車を降りたらなるべく早くレオン爺さんを訪ねるべきね。とても焦っていたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なあ、もうこの辺で別れようぜ。そういう奴とつるんでると母ちゃんがいい顔しねぇしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いえ、ですから、ごほ、ごほっ、リリーは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "――あの子は人間ではないのですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "愛人作っといてそいつを人でなし呼ばわりとか、サイテーだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いえいえそんなまさか……ふふっ、失礼！　ついつい笑ってしまいました。本当に、まったくの誤解でしてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "リリーは駄獣よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "駄獣……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "なるほど、そうでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……言わなかったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "「グレーシルクハット」！　貴方、何をとぼけているのですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "イェラグでの私の行動については、そちらの部下から報告を受けているはずでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "大変申し訳ありません。あなたが治療なさっている駄獣の名前となりますと、そこまでの重要情報ではなかったもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……ってことは、おっさんはクズでもなんでもねぇ上に、なんかの危険が迫ってるわけでもねぇってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なーんだ。さっきの追っかけっこからして、てっきり命に関わるような超一大事かと思ってたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "やれやれ……実際、一大事ではありますよ！　これは私の名誉に関わることですからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "それで、いつまでグダグダやってるつもり？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そんなところに突っ立ってたら通行の邪魔よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "駅に着いたわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
