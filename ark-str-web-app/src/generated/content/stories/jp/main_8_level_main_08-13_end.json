{
  "server": "jp",
  "storyId": "main_8_level_main_08-13_end",
  "groupId": "main_8",
  "stageId": "main_08-13",
  "title": "国土覆う「黒雪」",
  "storyCode": "R8-11",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_08-13_end.txt",
  "sourceHash": "95e1c33f7918bdb5fac6150253826ab3a9de746411726bd795cd5f4030133e6a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……失、せ、ろ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "なんとすさまじい潜在力だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "シュー……ここは敬意をもって脱帽の礼をするべきところだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "残念なことに、今日は軍帽を忘れてきてしまったのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ハァ、ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "これ以上の戦いは無意味のようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々は所詮、ウルサスの守り手にすぎない……お前は感染者の衛兵として、これからも生きていけばいい。お前の部隊も、このまま存続させて構わない。実に合理的で我々の意にも沿っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "何が守り手だ。お前たちは……何を守っているというんだ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "どの国にも、衛兵を名乗る輩は存在する。守るべきものが多いからこそ、衛兵の旗を掲げる者は後を絶たない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "しかし、その大半は腐った無能な連中だ。我々の価値は、己が守る存在の価値によって定まる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々が守っているのは、ウルサスの未来だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "そう言っておけば、悪行を帳消しにできるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前たちが犯してきた罪は数知れない。シモンクの街は湖に沈み、エラフィアの村人は一人残らず飲み込まれた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "私はそんな非道な行為の数々を、幾らでも暴露できる！　お前たちがしでかしたことを全て、公に曝け出せる！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "そんなお前たちが、国の意志を代弁するだと？　なんと哀れな……その愚かさが遠くない未来に打ち砕かれるとも知らずに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "どの国でも、最も怠惰で愚かな民を最後には鞭で懲らしめるもの。そして我々の場合は鞭ではなく、刀を使う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "いつまでも木にしがみついて養分を吸う事しかできない無駄な枝、それを剪定することが悪行だというのなら、我々は悪かもしれないが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々の「行為」を「暴露」するだと？　お前はまだ我々の全てと向き合っていない。お前の考えも今後変わっていくはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々がお前に歩み寄れば、お前は後ずさるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "タルラ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "来るな！　戦士たちを守れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ウルサスの善行と悪行は並列するものだ。我々の悪行に向き合うつもりなら、それと同時に我々が善意で行なってきたこと全てと向き合わなくてはならない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "全てに、だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "国家とは決して善悪のみで測れるようなものではない。同じ基準で語れるものなど存在しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……お前に今すぐ彼の知恵を理解させ、彼と同じ高みに立つことを望むのは、少々現実味に欠ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "だがもし本当に彼の言った通りに事が運ぶのならば、その時が訪れ次第、我々はお前の意見にも耳を傾けるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "しかし、今のお前は潜在能力と種以外、何も持ち合わせていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "帝国は、今のお前が容易く理解できるようなものではないのだよ、ヴイーヴル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "待て……ヴイーヴル、お前の背後にいるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "まさか、あなたは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "36……【暗号】！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "――ウェンディゴ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "たった二人の衛兵では、私は殺せない。これ以上私たちに刃向かうというのなら、三人以上でかかってくることをお勧めする。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "大尉！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "盾を押せ！　前進だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "待て、パトリオット。そうではない、我々は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "向こうで私の娘と戦っている者たちを含めれば、近衛兵は合わせて五人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私の知る近衛兵は、お前のように容易く動揺などしない。言え！　お前たちは己の実力にどれほどの自信があるのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々はあなたを敵に回すつもりはない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ウェンディゴ……今の帝国軍では、あなたのことはもはや知られざる伝説だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "しかし、たとえ移動都市の市民があなたのことを忘れようと、我々は先代たちが毎日のように語っていた物語を鮮明に覚えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あなたに敬意を表します、ウェンディゴ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……彼女の後ろ盾はあなただったのか。雪原の兵士は、骨の髄まで戯言に染まったような者たちばかりだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あなたが感染者になったという噂は、真実だったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私が感染者のために戦うのも、当然のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "それは間違っている、ウェンディゴ。こんな計画など間違いなく座礁する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "この国には大勢の感染者がいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "信じる者が多いからといって、妄想が現実になることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "これを妄想と呼ぶ前に、お前はウルサスにおいてどれほどの勝利と敗北を経験してきたというのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "確かに、私の代ではそれらの経験はまだ浅い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ゆえに……我々はあなたを勧誘したいと思う。元ウルサス軍大尉、ボジョカスティ、どうか我々と共に戦ってくれ。ウルサスにはあなたが必要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "何を言い出すんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "先帝の配下で百年以上戦ってきたあなたならば、当時のウルサスの栄光を憶えているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あれは、どれほど華麗で偉大な時代だったろうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々は種族を問わず、ウルサスの名の下に団結していた……未来のために戦い、数多くの敵を刃と大砲で沈黙させてきた。我々は無敵だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あの時代に戻りたいという願いは、普遍的なものだ……我々は皆、全員が兄弟のように団結し、共通の敵に立ち向かったあの時代に戻りたいのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "そのために我々は、貪欲な諸国に略奪した土地を吐き出させ、蹂躙を受けてきた人々の尊厳をウルサスの恩恵の下で取り戻す。我々の征服は殲滅ではなく、再構築なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "この大地を、再び蘇らせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々と共にあの時代を再現しようではないか。皆が一丸となって、襲い来る嵐に立ち向かう日々を……こんな雪原で孤独に喘いでいるよりは断然マシだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "その言葉、まさに今踏みにじられているウルサス人に言ってみろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "誰一人、いい暮らしなどできていない。今はそれほど不幸な時代なのだ。ウルサスの市民でさえ苦しんでいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "秩序の欠落、力の流失、道徳の崩壊、これら全ての過ちのせいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "これらの過ちが、今のウルサスを滅ぼした。問題の根源は明白だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "だが、この過ちは正すことができるのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "……戯言を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ならば、お前たちのリーダーに聞いてみるといい。彼が我々の言う事を信じるかどうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "貴様……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ボジョカスティ、我々ならウルサスの道を正せる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "今のリーダーは私ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "彼女だ。お前たちのことを信じるかどうかは、彼女に聞け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私は、お前たちの父の代の者たちと共に戦ったことがある。お前たちも、彼らに劣らぬほどの戦術家であり、力に溢れているようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "しかし、お前たちはあの頃のウルサスを美化し過ぎている。それはお前たちの妄想にすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "だがあなたもあの時代を否定できないはずだ。あなたの一挙手一投足が未だウルサスとあなたを繋いでいる。その称号も同じように、あなたの意志を表しているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "ならば聞こう……今の皇帝を戴くお前たちが目指すウルサスに、感染者の居場所は設けられているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ウルサスが感染者に「恩恵」として与える地位など、お前たちの妄想と同じ、一時の幻にすぎない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "タルラ……シュー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "お前たちの力が加われば、事情は変わるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "何を……言っているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々「利刃」が約束することはない。一介の武器が約束を交わすことはないからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "だが、私個人の意見を言えば、感染者はウルサスが持つべき力の一部だとも考えられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "つまり、お前たちがウルサスの栄光の象徴になればいい。ウルサスに盾つく感染者は殲滅されるべきだ。しかし、お前たちがウルサスのために戦うというのならば、それは讃えられるべきだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "タルラの耳に、感染者たちのざわめく声が響いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私がお前たちの言い分に反対しないからと言って、賛同していると思い込むのは大間違いだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "お前たちはすでにその権力の味を占めているのだろう？　好き勝手にやっておきながら、自分たちの行為の全てが次の時代のためだと強弁できる権力を。お前たちは何をもって栄光を口にするのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ならば、少数のために戦うあなたたちは、何をもって多数派の賛同を得ようというのだ？　あなたたちが感染者のために振るう刀は、なぜ正義だと言える？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ウェンディゴ、あなたなら機知に富んだ回答を返してくれるものと信じている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "――正義かどうかに、なぜ人数の多寡が関係してくるのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "近衛兵よ、一つ聞く。当時、陛下を敬愛していた人間は、どれくらいいた？　多かったか、少なかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……コホー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "陛下の死に、お前たちは関係しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "「していない」と言ったら……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……コホー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "どうやら、このわだかまりは解けないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "お前たちが何を言おうと、私の陛下は死んだ。ウルサスが他人の手に渡ってしまった以上、私が追い求めるものは一つの理念のみ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "――彼女の理念だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "パトリオットはタルラの身体を支えた。まるで彼女が本物の家族であるかのように。これまでも、これからも、彼女を失うその日が来るまで、家族であり続けるかのように。"
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "シュー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "なぜ、彼女なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "互いを熟知しているからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "確かにお前が思い描いている未来は、悪くないものかもしれない。だが、私はすでに決断し、感染者を選んだのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "軍人が命を捧げる対象は国家と信仰であり、その統治ではない。だからこそ私は、正義の戦争を発起し、今の帝国を滅ぼそうとしているのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "しかし我々の行いも正義であり、同じように感染者の支持を必要としている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "となれば、あなたが我々の提案を拒む理由は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あなたは「レユニオン」のどこが「団結と革命」よりも優れているというのだ？　効率か？　それとも、レユニオンならば民への損害を抑えられるとでも考えているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "いや、そのような話ではない。この戦争の火蓋が切られた以上、私はその結末を最後まで見届けなければならないというだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "かつて忠誠を誓ったあの情け深い陛下でさえ、感染者を受け入れはしなかった。そういった甘言の類を信じることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "お前たちが本当に感染者を団結させられるのならば、戦争など起こらなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々は、感染者があなたの下で団結することを望んでいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "違う。お前たちが本当に彼らを団結させたいのならば、私など必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "もういい、近衛兵たちよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "お前が言うような道ならば、私はとうの昔に踏み越えてきたのだ。だからこそ「より優れた選択」とやらを鵜呑みにすることはない。先見の明を自負する者は、まだ運命に弄ばれていないだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "お前たちもいずれわかるだろう。北原で死ぬのも異種族に殺されるのも、同胞の手にかかるよりはましだ。落陽の谷で戦死した二十人以上の近衛兵のように、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "近衛兵たちよ、私は帝国の裏切者だ。和解の余地はない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "宣言はただの言葉にすぎない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あなたの考えは理解した、ウェンディゴ。だが、あなたの背後にいる者たちはどうだ？　あなたと同じように彼女を信じられるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "彼らは、あなたの武力や正義に憧れているようだが、それが単なる偶像崇拝ではないとどうして保証できる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "彼らを守る力を持つ邪悪な偶像と、まな板に置かれた崇高な偶像。彼らはどっちを選ぶと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "前者の比喩の対象が私の尊敬する相手でないことを祈ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ウェンディゴ、現実は西北凍原の吹雪よりも厳しい……力を失えばあなたたちは抵抗さえできなくなる。そして、そんなあなたたちに真っ先に刃を突きつけるのは、必ずしも敵であるとは限らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "コシチェイの名に馴染みはなくとも、彼らは公爵を知っている……そして、その娘がいずれ公爵の座を受け継ぐことも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あなたのそばにいる者を目に見えるものだけで判断しないことだ。彼女の力と知恵があなたに対抗できるほど成長したあかつきには、あなたをも出し抜くほどの狡猾さを見せてくるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "その言い方、彼女のことを認めているようにも取れるが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "いや、ウェンディゴ、違う……あなたはウルサス人としての時間がまだ足りていない。あなたはまだわかっていないのだ、コシチェイのことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "汚れた知識を受け継いだところで、それと共に汚れていく運命とは限らない……彼女が雪原に残してきた足跡は、あの蛇とは同じ道をたどらないことを十分に証明している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "シュー……コホー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "……噂に違わず、あなたは若者を贔屓している。それは贔屓というより、むしろ溺愛に近い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "真に尊敬に値する者に対しては、たとえその若さから、衰えて死んでいく様子が容易く想像できても、尊敬の念が揺らぐことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "立ち去れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "ボジョカスティ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "今すぐ、立ち去るんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私たちの戦士を傷つけた罪は、今は問わないでおこう。あるいは、今ここでお前たちを殺して、その死体を回収に来る衛兵部隊とやり合っても構わん。どちらか一方が滅びるまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "――たとえ、滅びるのが私たちであろうと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "あぁ。ウェンディゴ……我々はこれ以上秘密を口外するわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "我々の警告は言葉遊びではないのだ、ボジョカスティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "もはや我々には、あなたを哀悼することくらいしかできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "戦いの時が来れば、お前たちを弔うのは、私になるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "その時は来ない、ウェンディゴ。来るはずはないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "さらばだ、「パトリオット」。あなたの決断は実に残念だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "そして、タルラ……我々はお前の変化に期待している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「皇帝の利刃」",
      "text": "お前は彼らを導くべきだ。それがお前には相応しい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "父さん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "エレーナ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "はぁ、はぁ……あいつを、やったぞ……スノーデビルと一緒に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "一人、撃退した……！ だが、まさか……奴は自ら撤退したのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "全部で……たったの五人しかいなかったのか？　もし私一人だったら……きっと小隊を守ることさえ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "よくやった、娘よ。今度はもっと上手くやれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "当然だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……ここで何があったんだ？　なぜみんな――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "タルラ？　盾兵たちまで……これは一体？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "……大尉……奴らが言っていた話は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "過去のあやふやで不確かな事例を掘り起こし、歴史は必ず繰り返すものである、あるいは身分が将来の全てを決めるなどと断定してしまうのは、ある種の自惚れだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "彼女は大丈夫だ、この私が保証しよう。皆はまだ受け入れ難いかもしれないが、秘密だけは守ってほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "もちろんです！　それはもちろん、わかっています。タルラの人柄は十分理解しているつもりですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "ただ、あれは……真実なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "お前たち……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……何を考えているんだ？　お前たちが言ったんだろう、仲間の出身がどうだろうと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "真実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "タルラ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "確かに私は昔、貴族に「後継者」として育てられていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "質問には答えた。まだ何かあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "リーダー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ミスター、言ったはずです……その呼び方はやめてください。さあ撤収しましょう。ファウストと射撃兵の訓練がまだ残っています。あなたも参加するでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "君が私を失望させない限り、私は最後の瞬間まで君と共にいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "タルラ……父さんはお前を支持することを選んだようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前も同じ考えであれ、などと迫るつもりはない、エレーナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "チッ。まさかお前は私が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "キャンディをくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "なんだ？　らしくないな……ほら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "フッ。行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "撤収だ、戦士たち。まだ知りたいことがあるなら、私は全てを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "どうした……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "タルラ……\n……お前は何を企んでいる？"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
