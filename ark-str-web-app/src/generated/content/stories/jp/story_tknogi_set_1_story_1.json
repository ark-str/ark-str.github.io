{
  "server": "jp",
  "storyId": "story_tknogi_set_1_story_1",
  "groupId": "story_tknogi_set_1",
  "stageId": null,
  "title": "いつもの夕日",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_tknogi_1_1.txt",
  "sourceHash": "1180e083cf3d736bd2abb3b6e20c95c2b6ae7722e5e550d3eef4bf19e765c473",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あそこだ！　あれが俺が住んでいる建物だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もっとスピードを出せないのか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "天災が間近に迫っています、お急ぎください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "急かすな！　この部屋は僕が自分で配置したんだ。予備の画材がどこに置いてあるかくらい、ちゃんと把握している。それを回収したらすぐに出るよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "この棚の下に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ここにしまってあったのに！　なぜなくなってるんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "クソッ、あいつらのせいだぞ！　逃げるのに夢中で僕の画材を倒したから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "偉大なる傑作誕生の瞬間を台無しにしやがって！　罪深い連中め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "落ち着いてください。ここには他にどなたか住んでいらっしゃらないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "他には……大家のペリー夫人が住んでいる。夕日をフライパンの中の目玉焼きと見間違うような、芸術に疎い主婦さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "その方が避難を終えているかどうか、リストの確認をお願いいたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "了解です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "彼女とはほとんど話さなかったから、連絡先を交換していたかどうかも記憶が曖昧なんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "デヴリンさん、通信端末に新着メッセージが届いていますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "「デヴリンさん、天災が迫っているのに家にいなかったので、荷物をまとめて玄関のスーツケースに入れておきました。帰宅したらそのまま持って避難してください……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "「無事を願っています――ペリー」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "なんと！　ペリーさん、あなたの優しさに感謝するよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "このスーツケースでしょうか？　車にお積みしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ああ、頼む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "本当にありがたいよ、これで車の中でも絵が描ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "急ぎましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "もっとそっちに詰めてくれ。絵を描くスペースが欲しいんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "デヴリンさん、そんな恰好では車から落ちてしまいますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "あ、ああっ、そ、そんな！　僕の画材が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "芸術も分からん馬鹿な女め、なんてことをしてくれたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "キャンバスは汚れてるし、筆は絵具に沈んでしまっている。その絵具だって……やっぱり全部ぐちゃぐちゃだ！　これではもう使い物にならないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "たったの絵一枚じゃないですか。また描く機会はいくらでもありますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "違う……そうじゃないんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕が長い間、必死に天災を追いかけてきたのは、全部この瞬間のためだったのに……あの無上の美しさを誇る景色を僕の手でキャンバスに描き留めるためだったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "デヴリンさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕の絵、僕の夢、僕の生活――僕のすべてはもう……水の泡だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕に構わないでくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "構うなと言ったんだ。聞こえなかったのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "今何時だと思ってる？　もう日も暮れてるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "カウンセリングなんて必要ない。別に僕は自分で命を絶つつもりはないんだから、もう放っておいてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "これは最後の警告だ。まだしつこく付き纏うのなら、タダじゃ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "君は……どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "こんばんは、デヴリンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ああどうも……覚えているよ。君はあの日、天災を知らせに来てくれた……えっと、確かなんとかアイランドの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ロドス・アイランドです。私はロドスのオペレーターです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……は？　それだけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "自己紹介は初めてお会いした時に済ませたじゃありませんか。それともまさか、道中ずっと付き添ってあげていた女性の名前をお忘れで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "そ、そんなわけないだろう。君は確か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ツキノギさんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "とうやら私への印象はそれほど悪くなかったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "さて、そろそろ本題に入りましょうか。お休みのところ申し訳ないのですが、デヴリンさんにいくつか質問があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "お身体の調子はいかがですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……そもそも大したケガはしていない、君たちのおかげでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "それは何よりです。ではご気分の方はどうでしょうか？　何か悩みを抱えていたり、塞ぎ気味になったりしていませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "相変わらずだよ。もう絵を完成させる夢は破れてしまったんだ。これ以上の悩みはもうないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "そうですか。では避難所の生活で何かお困りの点はありますか？　今のところ来客を全て断っているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "困ったことか……あの「親切」な隣人どもにもう僕を構うなと言っておいてくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕は「被災者助け合いの会」などという活動には興味もないし、参加する気もない。他人の不機嫌な顔なんて見たくもなければ、玄関先に居座られ意味のない質問をされるのはもっとごめんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "分かりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "質問はもう終わりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "お望みならば、いつでも切り上げますよ。デヴリンさんを不快な気分にさせたくはありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……君たち天災トランスポーターってのは、天災が過ぎ去ればすぐにいなくなるものだろう？　なぜ君はまだここに残っているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "私以外の天災トランスポーターにお会いしたことがあるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "い、いや……本で読んだだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "天災トランスポーターにも色々な人がいるのです。職責外のことまで気に掛ける人もいますし、中には……フフッ、いっそのことトランスポーターを辞めてしまう人だっていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "そして、私がここに残っているのも当然、私なりの理由があってのことです。たとえば、あなたのことが心配だからとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……冗談はよしてくれ。僕なんかよりもっと他の人を心配した方がいい。毎晩外から気味の悪いすすり泣きが聞こえてくるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "今言ったのは数ある理由の内の一つにすぎません。ただこの場所の風景が名残惜しくて留まっていると思っていただいても結構です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "風景と言いますと、確かこの周辺にはひと目見る価値のある景色が数多くあるようですね。特に丘から見える夕焼け空には大変心を打たれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "リターニア屈指の風景画家であるレオンさんの弟子であり、若くして名を馳せ、生涯をかけて光と影の描写を極め続けると誓った優秀な絵描きであれば、きっと足を運びたくなるかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕のことを調べたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ただの絵好きとして、有名な画家の噂は大体小耳に挟んでいるだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "あなたがリターニアを離れる前に残したあの風景画……夕日が消えゆく瞬間を捉えた緻密な筆遣いは、一度見れば忘れられない印象を心に刻み付けてくれます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "あんな駄作……天災の美しさには遠く及ばないよ。そもそも天災と比べることすらおこがましい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "絵を描くためでなくとも、美しい風景は気分を晴れやかにしてくれます。もしご興味があるのならば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "断る、興味なんてないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "いいかい、ツキノギさん。君とその仲間が僕を天災から避難させてくれたことには感謝している。だけど、僕の絵が台無しになったのも事実なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "もしあの時、君たちがもっと早く、もっと容赦なく道を塞いでいた暴徒たちを蹴散らしてくれてたら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ペリー夫人が僕の荷物をまとめる前に部屋に辿り着けていたのかもしれない。そうすれば、僕の画材だってめちゃくちゃにならなかったはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "こうなってしまった以上、君たちの気遣いなんて必要ないんだよ。何をしても構わないから、ただもう僕のことは放っておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ツキノギさん、君に会うのはこれが最後であることを願うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "何はともあれ、あなたと出会えたことをうれしく思います、デヴリンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "それと、最後にお渡ししたい物があるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "敬意を示すとまではいきませんが、業務においての過失の賠償というわけでもありません。一人の絵好きとしての、ほんの些細な贈り物です。どうか受け取ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ここに置いておきますね。それでは良い夢を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まっさらなキャンバスには何も描かれておらず、ただ影だけが映っている。\n彼は長い間、ゆらめく影の輪郭を眺めていた。\n光と影が入り混じっては、バラバラに散りゆく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然、彼は思いっきり拳を振り下ろした。イーゼルが音を立てて床に倒れる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "描けない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "クソッ、描けない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "天災のような……盛大で美しく輝かしい光と影のメロディーは……色彩の協奏は……もう二度と出会えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "しかも今はもう筆すら持てないとは……これで何が描けるっていうんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "贈り物……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "画材に絵具。明らかに弁償のつもりだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕がこの銘柄の絵具しか使わないことを知っていたのか？　誰かに話した覚えはないのだが……絵画に使われていた顔料から推測したのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "だが、意味のあるものは特になさそうだ……期待した僕が馬鹿だったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ん？　これは……極東の木版画か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "しかも風景画……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "見たことのない技法だ……線の引き方は悪くない、表現力も高い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "常識に捉われない大胆な色使いだが……それが却って興味深い効果を生み出している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "こんなやり方もあるのか……悪くないアイディアだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "もうこんな時間か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "最近は夜中に外から泣き声が聞こえてくることも減ってきたな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "絵をくれた彼女は、もうここを発ったのだろうか……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "取り込み中だ！　少し待ってくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "今開けるよ！　だからもうノックはやめてくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "何度言えば分かるんだ。君たちが開いた「移住記念祭」とやらに参加する気はないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "こんばんは、デヴリンさん。またお会いしましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "少しは気分が晴れましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "顔色がずいぶん良くなりましたね。しっかり眠れているようでなによりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "どうしてまた僕の前に現れたんだ？　前に言ったはずだろ、もう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "シーッ、女性の傷付いた思い出を掘り返すなんて無粋ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "先ほど取り込み中だとおっしゃっていましたが、絵を描いていらしたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……新しい技法を試していただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "それはよかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "今日は質問をしに来たのではなく、デヴリンさんに渡したいものがあるのです。ほら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "花？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ええ、夕暮れ時に以前話した丘から摘んできたばかりです。ほら、まだ露が滴っているでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ただの花だな。単調な色合いに、適当に束ねただけの造形……こんな美しさに欠けるものは、なんのヒントにもならないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "これは観賞用としてお渡しするわけではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "じゃあ何のために……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "この花の静物画をデヴリンさんに依頼したいのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕がこんなつまらないものを描くはずがないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "あの極東の版画は、お気に召されましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "私は極東育ちです。幼い頃に家族と山を下りお城へ訪問すると、いつもたくさんの絵師が屋敷の門を取り囲んで、我先にと自分の作品をそこの主人に献上しようと争っていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "そのおかげで、私は素晴らしい名画をいくつもこの目で見ることができました。そうして鑑賞していくうちに、少しだけ絵を見る目が鍛えられていったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "極東を離れる時、絵も何枚か一緒に持ってきました。観賞用のつもりでしたが、一人で見るのも少し退屈でして。いつかその作品たちが誰かの助けになれればいいのにと、ずっと思っていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "あなたもそう思いますでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……花を寄越せ。描いてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "まだ他に何かあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "私が依頼した絵なのですから、花の配置も私が決めた方がいいのではないでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "部屋が散らかっているんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "夜はとても冷えますね。まだこのまま外で立ち話を続けるおつもりなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……入ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "あら……確かにおっしゃる通り、片付いているとは言えませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "花を置ける場所もなさそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ほとんどが支給された使い道のない物資だよ。片付けに余計な時間を使いたくなかったんだ、どうせ仮住まいだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "それはいけませんね。快適な環境は心を落ち着かせてくれます。絵を描く時は心を静めなくては。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "それでは……私が部屋を片付けてさしあげましょう。より素晴らしい絵を完成させるためということで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "その必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "どこから始めましょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "おい、待て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "あら、そこに積んであるものはなんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "それには触るな！　自分でやるから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二十分後。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "この紙束はあそこに置いておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ほら、すぐに片付け終わったでしょう。これでようやく生活感を感じられる部屋になりましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "まったく面倒なことを……あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "イーゼルの向きに、受け台の高さ、それとあの花……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "あの日に拝見させていただいたデヴリンさんの部屋は、とても几帳面に整理整頓されていましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "記憶を元にそのレイアウトを再現してみました。惜しいことに、壁に掛かっていた花の静物画はあの部屋に置いてきてしまっていたので、代わりに私が持ってきた花を飾ってみました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "どこか気に入らない点はございますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "いや……天災の前と……そっくりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "毎晩、絵の練習から帰って来て灯りをつけると、目に飛び込んでくるのはいつもこの景色だった。たまにペリーさんが下の階で肉スープを作っていて、その香りが窓から漂ってくるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "一回も食べたことはなかったけど……すごく温かく感じたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "気に入っていただけたのなら幸いです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ですがそこに積んであるスケッチは……以前の部屋にはありませんでしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "あれはペリーさんに捨ててもらうように頼んだはずだったが、なぜかスーツケースに詰め込まれていたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "フン、僕の画材が台無しになったのも、失敗作の紙屑をスーツケースに押し込んだせいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "拝見してもよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "好きにしな。どうせただのスケッチの練習だ。何の役にも立たないゴミでしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "そんなことはありません。どの風景画もとても美しいです。山の麓に海岸、野原……それと黄昏に沈む夕日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "きっとペリーさんも君と同じように、その絵を様になっている作品だと勘違いしてスーツケースに入れたんだろう。そのおかげで大迷惑を被ったわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "いえ、ここにある多くの夕景を描いた絵は、夕日の描写がとりわけ優れております。デヴリンさんが学院に残したあの絵を既に超えていると思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "そんなものは比較対象にならないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ツキノギさんはきっと……多くの天災を目の当たりにしてきたんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "だったら分かっているはずだ。朝焼けも夕焼けも……この大地のいかなる景色だろうと、天災の前では色褪せてしまうのだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "リターニアにいた頃、僕は未だかつてない技法を編み出し、最も美しい色の組み合わせで、光と影の刹那を完璧に絵の中に落とし込んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "なのにあいつらはそれを否定したんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "繊細さに欠けるだの、趣を微塵も感じられないだの……そんな馬鹿げた理由で僕の絵を締め出し、画展にも参加させてくれなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "初めの頃は自分の技術不足のせいかと思ったよ。だから必死に練習したんだ。正直レオン先生にさえ認めてもらえれば、他の連中の批判なんてどうでもよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "そしてついに夕暮れを描いた美しい風景画を完成させた。でも、その絵を先生に見せにいったら、なんて言われたと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "「今の君の絵は私の心には響かない」だそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "そこでようやく分かったんだ。僕の技術の問題ではなく、そもそもあんな絵を描くべきじゃなかったのだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "正直、昨日君からもらった絵を見た時、一瞬だけ過去に戻ったかのような感覚に陥ったんだ。大喜びで新しい技法を試そうとして、でも筆を滑らせた瞬間、現実に引き戻されてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "もう無理なんだよ……どんなに心境が変わったところで、僕はもう凡庸な景色なんて描けない。僕はそんなものを描くために生まれてきたわけじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕には十分な技術がある。だけどあいつらに認めてもらうには、心を揺さぶるような情景を……永久不滅の傑作を描き上げなきゃダメなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "夕日？　ハッ、そんなものになんの価値がある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "絵筆を手にしたあの日から、この道を進む運命はもう定まっていたんだ。僕は己の生涯をかけて必ず描いて見せる。この大地で最も美しい景色――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "天災を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "そうだったのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "君には感謝している。改めてありがとう。依頼した花の絵を完成させたら、すぐにここを発つよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "また天災を追い求める旅に出るのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "そのスケッチ、ご不要でしたら、私がいただいてもよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "好きにしてくれ。できれば燃やしてくれるとありがたいんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "では私はこれにて失礼いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "うるさいな……外で一体何が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "うまそうな香り……でもこれ、どこかで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ペリーさんの肉スープだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "デヴリンさん、起きたんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ああ……それより一体何をして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "「移住記念祭」よ。みんなで一緒にのんびり過ごせるようにって、ツキノギちゃんの「被災者助け合いの会」が開いてくれたのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "デヴリンさんの絵のおかげで、記念祭に芸術的な雰囲気もかなり足されたねえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕の……絵？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼が顔を上げると、空を背になびく木綿糸が目に飛び込んできた。\n糸の端は小屋の屋根に結ばれており、そのようにして無数の糸が小屋同士を繋げていた。\nその糸には何枚ものスケッチが吊下げられ、風に合わせてひらひらとはためいている。\nそれは彼の絵だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "だから言ったじゃない。せっかく綺麗な絵を描いたのなら、みんなにも見せてあげなよって。なのに毎回不機嫌そうな顔をするんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "ツキノギちゃんがどうやって説得したのか見当もつかないけど、デヴリンさんの絵をやっとみんなに見てもらえて、あたしはうれしいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "やめろ……下ろしてくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "あれは絵なんかじゃない！　ただの紙屑だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "どうして？　あたしはデヴリンさんの絵、好きだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "それはあんたが絵のことを何も知らないからだ！　もし……もしあいつらがここにいたら、それがどんなに稚拙なのか一から十までご丁寧に解説してくれてたさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "確かにあたしは絵のことなんてサッパリだよ。でもデヴリンさんの絵は、心の底から気に入ってんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "それに、絵は特定の誰かにだけ見せるものじゃないと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "デヴリンさんの絵を見ていると、天災に壊されてしまった家を思い出すの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "悲しい気持ちはもちろんあるよ。でも、あんなに美しい絵を見ちゃうと、思わずこう考えてしまうのさ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "もうひと踏ん張りして、暮らしを早く安定させれば、辺りをぶらぶら散歩する時間もできて、絵に描いてあるような美しい景色を見つけられるかもしれないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "うそだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "まったく……あたしのことが信じられないんなら、周りを見てごらんよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "はにかんだ女性",
      "text": "ほら、あれ見て、ポプラの森の絵……あんな森の中を散歩したり、ピクニックしたらきっと楽しいわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい男性",
      "text": "生活が落ち着いたら、あの絵のような素敵な場所を探しにいくよ。そしたら一緒に出かけよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "わんぱくな子供",
      "text": "まっかな目玉やきだー。パパ、おなかすいたよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた男性",
      "text": "あれは目玉焼きじゃなくて、霧漂う森の中、木と木の間をゆっくりと昇っていくお日さまなんだよ。ああ、本当にきれいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "わんぱくな子供",
      "text": "お日さま！　ぼくお日さま大好き！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "みんなあんたの絵が大好きで、とっても感動しているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "ここに来てからトラブル続きだったし、みんな故郷を追われた身なんだ。誰だって気が滅入っちゃうに決まってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "そんな中、ツキノギちゃんは一生懸命サポートしてくれたさ。あたしの鍋だって、あの子が直してくれたんだよ。みんなが前向きになれたのも、ツキノギちゃんのおかげだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "しかも、あたしたちのためにこんなに楽しい記念祭まで開いてくれたんだし、感謝してもしきれないくらいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "彼女は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "それと、ツキノギちゃんから聞いたよ。デヴリンさんには、ちゃんと謝らないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "避難の時、あんたの画材を全部まとめて詰め込んだせいで、使い物にならなくなったんだろう？　本当にごめんなさい。どうお詫びすればいいのかね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "そうだ、あたしの肉スープ食べてみないかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ツキノギさんは……ペリーさん、ツキノギさんはどこにいるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "それならあの子から伝言を頼まれてるよ。もしあんたに居場所を聞かれたら、南にある小さな丘に来るように伝えてほしいって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "ちょっとちょっと、待ちなさい！　まだ話は終わってないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリー夫人",
      "text": "今行っても誰もいないよ。いつ自分に会いに行けばいいのか、デヴリンさんなら分かってるって言ってた。それと、画材を持ってくるのを忘れないようにってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "ペリーさん、スープを一杯くれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "大盛で頼む。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "やっぱり……今ならいると思ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "またお会いできてうれしいです、デヴリンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ほらね、ここの景色はとても美しいでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "視界の届く遥か先の方で、大きな黄色い光の玉が今まさに沈もうとしていた。\nそれはまるで巨大な心臓のように、わずかに残った昼の命を、懸命に繋ぎとめようとしている。\n地平線はその体を蝕んでいく。その鼓動の一回一回が、溢れんばかりの陽光を大地に降り注いでいた。\nしかしそれでも夜の闇は、波のように容赦なく迫りくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "きれいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "極東を離れたあの日、出発前の窓に広がっていたのも、こんな夕焼けでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "どうして……あんなことをしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "あなたこそ、なぜご自分でスケッチを処分されなかったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "そういうことに……慣れてないからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "お座りください、デヴリンさん。ひとつお話をいたしましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ここから遠く離れた土地のある山の神社に、一人の女の子が住んでいました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "彼女は人々から敬われる古い家系に生まれ、一族の未来を担う運命にありました。そのため、幼い頃より様々な儀式や舞を学び、多くの有力者と繋がりを持ちました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "ですが、彼女はそういったことが大嫌いだったのです。なんの役にも立たない気取っただけの振る舞いの全てを、彼女は好きになれませんでした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "だから大きくなった彼女は家を離れ、天災トランスポーターになる道を選んだのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "彼女は自身の能力のおかげで、多くの者を天災から救うことに成功しました。ですが、唯一家族とだけは滅多に交流を図ることはありませんでした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "そしてある日、彼女の故郷近くで天災が発生したのです。住民のほとんどを避難させることはできたのですが、頑なに家を離れようとしない家族を前にした時、彼女には成す術もありませんでした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "その時になってようやく、彼女は自分が家族とどんな風に話せばいいのか、まったく分からないことに気付いたのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "不思議でしょう？　遥かに地位の高い者は説得させられるのに、最も親しい存在である家族に対しては、指をくわえて悲劇が起きるのを見ていることしかできないなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "悲しい話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "デヴリンさんならお分かりでしょう？　必死に理想を追いかけるあまりに、そばにある景色を見過ごしてしまう人もいることに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "確かに夕日と天災はまったく異なるものですが、そこに優劣などありません。景色が人を感動させられるかどうかは、旅人がそれに気づけるかどうか次第です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "だからあなたもどうか、その瞬間の景色を見逃さないためにも、たまには立ち止まってみてくださいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "思い出した……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "あの頃、僕は絵を描くのが好きな普通の子供だった。夕方になると毎日、酒場にある絶好のスポットで夕日を描いていた……帰路に就く羽獣たちが残した羽に、夕焼けが黒く影を落とす忙しない人々。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "酒飲みの職人たちは僕が絵を描くところを見るのが好きだった。彼らは僕を囲んでは、夕日が丸い目玉焼きにそっくりだと大笑いし、それを聞いて僕は次はもっと上手く描いてやると言い返してたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "僕は自分の絵を捨てたことが一度もなかった。完成した絵は酒場の壁に貼り付けて、気に入った客がコイン数枚で買い取ってくれるのを待つ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "あの頃は本当に楽しかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "そしてある日、レオン先生が背後に立って、絵を描いている僕を眺めながらこう言ったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "「坊や、君の絵に感動したよ」と。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "……そういうことだったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "でも……今の僕にまだあの絵が描けるのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "天災を望むこの両目と、筆すら握ることのできないこの両手で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "私に絵を描いてくださると約束したはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "今ここで描いていただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デヴリン",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "私の踊る姿を描くのは……いかがでしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まもなく消えゆく光の中、夕焼けと共に軽やかに舞い踊る。\n繊細な筆遣いが、その刹那を永遠として刻み付けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "さすがツキノギさんですね。今回の避難後の住民調査、生活満足度の数値が新記録を達成しましたよ。住民たちの心理状態も申し分ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "これなら今後の移住作業もすんなりいきそうです。住民の皆さんが一日でも早く移住都市での新生活に慣れてくれるといいのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "それはよかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "これがツキノギさんが毎回、天災が去った後もその場に残る理由なのですか？　住民たちが天災で負った心の傷を乗り越え、新たな生活と向き合えるようにサポートするために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "はい、命が助かって万事めでたしではありませんからね。生きる希望を取り戻すのも重要なことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "ツキノギさんがサポートした人の中に画家もいたそうですね。聞いた話によれば、彼がリターニアに送った新作が、あの有名なレオン先生から大絶賛されたんだとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "レオン先生が作品の評論をしたのは十数年振りのことらしくて、芸術界にセンセーションが巻き起こっているそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "噂では、その画家は個展の話を何件も持ちかけられ、もう既に準備に取り掛かっているそうですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "フフッ、元々とても魅力的な絵を描かれる方でしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "正直に話してください。ツキノギさん、今回もまた女の子が出てくるお話をしたんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "さぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "本当に読めない人だなあ……ツキノギさんはどんな話でも、本当に起きたことのように話すんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "でもやっぱり気になるんですよね。ツキノギさんが最初に、天災の後の現地に残ろうって決めたきっかけってなんだったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "私はただ……悲しいことが嫌いなだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツキノギ",
      "text": "さて、お喋りはここまでです。まだ任務が残っているのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "はい、今回も忙しくなりそうですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
