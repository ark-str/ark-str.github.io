{
  "server": "jp",
  "storyId": "main_6_level_main_06-06_beg",
  "groupId": "main_6",
  "stageId": "main_06-06",
  "title": "断弦",
  "storyCode": "6-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-06_beg.txt",
  "sourceHash": "56bce34a3e6993ea9096a5a4ad7d47c19796f645d676ee8adff1995a8a21d72b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "グレースロートさん！　どこですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "アーミヤ、こちらは近衛局と合流した。近衛局小隊の交戦をサポート中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "すぐに向かいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "エリートオペレーターの皆さん、聞いてください。今回の作戦行動は私たちが龍門市内で展開する唯一の、そして最後の大型作戦になるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "まずは各自に設定された、第一目標の達成を最優先として行動してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "敵指揮官に対する包囲網の形成と攻撃には、私と私のチームも全力で参加します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "皆さん、これだけは覚えておいてください。私たちの一番の目的は協定の内容を履行することです。近衛局と共に行動し龍門の治安を回復させます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですが、ロドスとしては今回の戦いにおいて、感染者と一般市民との間に起きる摩擦を軽減し、衝突を回避するのも重要な目的です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "どのような気持ちで作戦に臨むかは人それぞれですが、皆さんはロドスの一員です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それは、いつどんな時であろうと変わりません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もし、私たちの行動が実質的にロドスの信条から外れるようなことがあれば、即座に戦いを止めて構いません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "だからこそ、戦う以上は自身の行動に責任を持ってください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "なんだか全部私に言い聞かせてるみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "アーミヤちゃんはいろいろ気を使いすぎだよ……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "急がなければ間に合わなくなる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "どうしようもないでしょ。あの感染者たちがどれだけ厄介かはさっき自分の目でも見たでしょ。たった一人のオペレーターや小隊程度の規模でどうにかなるモノと量じゃないよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "やっぱり、展望デッキであの坊やを始末するべきだったのかもね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "あ、通信だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ブレイズさん、速やかに行動を。すぐに待ち伏せ地点に向かわなければ、ここ一年の風紀違反記録を全部ケルシー先生に見せますよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "いやいや、時間通りだって！　慌てないで！　もうすぐ着くから！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ！　ブレイズに服を掴まれてる！",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ブレイズさん！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "えっ、いやいや、これはしょうがないでしょ。急いで移動してるんだから、しっかり掴んでおかないと落ちちゃうし……。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "（余計なこと言って。後で覚えときなさいよ！）",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ドクター、どうして何も言わないんですか？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "……ブレイズさん！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "私は何もしてないって！　この人が喋らないだけ！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "ちょっと何か喋ってよ！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "ねぇ！　ちょっとどうしたっての……！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "自分を下ろしてから通信してくれないか？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "あっ……。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ごめんなさいドクター。ブレイズさんと一緒に行動してたらそうなりますよね……。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "臨機応変ってやつだねっ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "なんでそんなに得意げなんですか……。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "まぁ、わかりました。今はお二人の位置と状況を知れればそれで。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ところでお二人とも、いつの間にか仲良くなってますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "うん。そうだよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……そうなんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "（待ってよ、何かマズイ雰囲気？　なんて答えればいい？　）",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（知らない）",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（何も言わない）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "（分からない）",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "（マズイよこれ！　ヤバいんだって！　私のメンタルに関わることだから助けて！　今すぐ！　）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "では、頑張ってくださいね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "切られた！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……終わった。私も完全におしまい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……まぁ、とにかく目標地点には着いたよ。少し座って休もうか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "目標地点はこんな高いところじゃない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "あ～間違えちゃった、なんてね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "私は高いところが好きだからね。それに直線距離で行くのが一番早いんだし、ここから飛び降りればそれで到着だよ。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "この高さから？　飛び降りる？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "そうだよ。ふわぁ～あ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "待って。アレが見間違いじゃなければ……目標の待ち伏せエリアに移動してくるのは、東側がメフィストが連れてた部隊だね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "そしてもう片方は……ウロコの坊や？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "部隊を連れて何かと戦ってる。あの黒い群れは何？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……メフィストの家畜？　あの数はどういうこと！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "ここでのんびりしてる暇はなさそうだね。行くよ、ドクター。これが最後の戦いだよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "もしもし、アーミヤ、応答して！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "すぐにドクターと戦場に飛び込む！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "で、あんたの作戦ってやつを聞かせてくれない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "一部のレユニオンをあえて泳がせ、スラムまで奴らを追跡する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "あの特殊部隊に弱みを握られるだけじゃないの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "だが我々もそれに乗じて、再びスラムに突入できる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "既に状況は調査済みだ。我々がいる限り、特殊部隊は派手な動きができないのは明らかだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "戦いが終わるまで持ちこたえれば、特殊部隊も手を出せまい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "「上司」から命令が下ったらどうするの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "あれを「これは私の部隊だ」などと公言できる上司がいるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "はいはい、まぁ計画は悪くないわね。で、スラムはどんな状況？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "諜報員たちが調査を続けてくれている。一部連絡が途絶えたエリアもあるが、我々が掌握している情報は他よりずっと多いはずだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "ちょっと大きな賭けになりそうね。でも賭けてみるしかないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "今の状況においては、あの特殊部隊が忌諱するのは恐らく近衛局だけだからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "アーミヤ、聞こえるか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "チェンさん、こちらは全員位置につきました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……わかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "以前、レユニオンがあの感染者をさらった事件、改めて謝罪させて欲しい。もし我々がより周到であれば、あんなことは起きなかっただろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ですが近衛局がスラムで事前に工作を進めていたからこそ、龍門はレユニオンの潜伏を暴く計画を事前に立てられたんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あの時の状況で、チェンさんに責任があったとは言いません。ですが私個人の気持ちとしては……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "チェンさん、ミーシャさんはもう、生き帰りません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "それと、私はまだチェンさんの感染者に対する考え方には同意できません。それはチェンさんご自身もはっきりと分かっているはずです……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "龍門を愛する全ての人々が龍門のために戦い続けています。その人たちが感染者かどうかは関係ありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "あら、この子ウサギちゃん、なかなか言うじゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "この声、スワイヤーさんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "こいつは気にするな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "ちょっと！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "君の考えを認めよう、アーミヤ。確かに龍門のために戦うという一つの目標の下では、どんな者であれ団結できる——あのレユニオンに入れ込んでいる者たちを除いて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "だがこれから先も龍門で生活していくとなれば、また別の話だ。私は時間が全てを解決してくれるとは思わない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そうですね。時間ではなく、私たちが解決するんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "だが、その考え方はあまりにも稚拙だ。感染者と非感染者の間には未だに大きな隔たりがある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ミーシャさんの死、無数の感染者の死を受け止めてきた私が、ただ稚拙な考えを言っているように見えますか？　チェンさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "その隔たりこそが、彼女たちを死に追いやりました。私たちは、それを消し去りたいと思っているんです。それなのに、正にその隔たりを理由に、私たちにできることを諦めろと仰るのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "チェンさんにも、どうか分かってほしいです……ロドスの感染者と非感染者が、どうして肩を並べて龍門の為に戦っているかを……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "…っ、チェンさん、敵が来ます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "戦闘準備！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "クソッ、待ち伏せか！　近衛局が包囲網を縮めてきている！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "スラムの方向に突破しろ。クラウンスレイヤーからの通信はないが……スラムが唯一の脱出口だということは変わらない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "メフィストも連れて行ってやれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "じゃあファウストはどうするつもりだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "俺といくつかの小隊があれを……「家畜」を引きつけた。こちらへ向かっている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "奴らは俺には攻撃しない。その特性を活かせば、俺は奴らを味方に戦える。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "text": "敵の前線を粉砕せよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "もう長くは持たない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "家畜",
          "text": "ぐ……ぐああ！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "text": "変異した感染者がいるぞ！　気をつけろ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "……俺たちを逃がすために囮になるつもりか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "そんなことをすれば、もう戻っては……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "むぐ、うぐぐ！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "大丈夫だ、喋らせてやっていい。どのみち今の状態では、アーツは使えないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "何するつもりだよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "メフィスト……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "ファウスト！　一体何をするつもりなんだよ！！　戻ってきて！　ダメだ、ダメだよ！　戻ってきてよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "メフィスト、俺がやってほしいことは、何でもやると言ってたな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "サーシャ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "それに、自分で選択はしたくないとも言っていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "ただ、もしお前に本当にやりたいことが見つかったなら、俺は……お前が何を選ぼうと責めはしない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "もしそんな日が来れば……メフィスト、それはきっと素晴らしいことだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "だが……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "俺にはもう選択の余地はなくなってしまった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "今から言うことは、俺の最後の願いだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "……サーシャ？　何言ってるんだよ、わからないよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "text": "奴らを逃がすな！　敵の指揮官を討て！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレースロート",
          "text": "あっ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "……ロドスのツバメか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "（口パク：引き金を引け。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "text": "危ない、伏せろ！　なんて火力だ、しかも挟み撃ちを仕掛けてきている！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレースロート",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "text": "ロドスの狙撃手、後退せよ！　この通路はこのような時のために用意してある！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "ファウスト！　下がれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "いや。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "聞け、狙撃手たち。俺はフロストノヴァが駆けつけてくれると信じている。クラウンスレイヤーは音信不通だが、あいつの部隊もまだスラム内に残っている可能性がある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "フロストノヴァが到着したら、お前たちの指揮権は全てあいつに委ねることにする。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "俺はフロストノヴァを信じる。あいつが来れば、お前たちは皆助かるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "それと、俺のアーツは、その気になれば移動中であろうがお前たちの姿を隠してやれる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "ファウスト！　それは知っているが……あれは使うな！　負担がかかりすぎれば、感染した臓器が破裂してしまうかもしれない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "大丈夫だ。もう俺にはこれを使わない理由はない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "命令、即時撤退。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "……メフィストも連れて行ってくれ。チェルノボーグは行くなよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷彩狙撃兵",
          "text": "……ファウスト……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "そんなのダメだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "一人になっても、生きていけ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "死ぬな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "——これが俺の最後の願いだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "サーシャ！！　サーシャ！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "……俺は誰も傷つけたくない。そして誰にも傷つけられたくない。そんなこと、もうどちらも嫌なんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "もしあの時に戻れるなら、俺たちは最初から全てを捨てて逃げ出すべきだった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "俺たちは……逃げられたはずだった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "サーシャ、君が言ってくれたんじゃないか。僕たちは約束したじゃないか！　一緒に生きていくって！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "もう遅いんだ。俺は……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "……もう疲れたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メフィスト",
          "text": "サーシャ！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ファウスト",
          "text": "お別れだ、イーノ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "彼はクロスボウに、矢をつがえる。\n最後のひと矢の、狙いを定める。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
