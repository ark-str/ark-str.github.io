{
  "server": "jp",
  "storyId": "act36side_level_act36side_02_end",
  "groupId": "act36side",
  "stageId": "act36side_02",
  "title": "密林解毒スープ",
  "storyCode": "DT-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act36side/level_act36side_02_end.txt",
  "sourceHash": "fdad19f0f6d48f1e89ca7b63e9444b2ce6b19f154a12422511d61b00dbff9412",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "うわあっ！？　オレの鱗獣干し台が！　それにベッドまで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ライオス！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "なんだ、やけに機敏だな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "俺たちのことを炎竜だと思い込んでいるみたいだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "どうする！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "とにかく、呼びかけてみよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "マルシル、俺だ！　ライオスだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "あ、あなたがライオスなわけない！　ライオスは叫びながら変なポーズでバジリスクを威嚇するような奴なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "アレは確かに強烈だったな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "ならば、俺がライオスだと証明するにはこれしかないな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "クエーーーッッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ライオス……本当にあなたなの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "上手くいくのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ねえライオス、炎竜がファリンを食べちゃったの！　だから炎竜を倒して、ファリンを取り返して、蘇生してあげないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "待て待て、なんで俺を指さしてんだよ！？　俺のどこが炎竜だってんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック&センシ",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "一体何が原因なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "うおっ！？　もしかしてそいつ、目を回してる上にフラフラ歩いてるとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "ああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "すごい勢いで威嚇してきて、わけわからないこと言ってたりする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "そう、そうなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "だったら、口から泡吹いてたりも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "してる！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "なら、そいつは毒に当たったんだ！　運が良いことに解毒法を知ってる奴ならいるんだが、運の悪いことにそれは行方不明の大祭司なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "私たちが出せるのはカピピ草くらいね。普段は中毒や病気になった時もお腹を壊した時も、とりあえずこれを食べてるの。まずはこれで応急処置をしましょう！　でも効果にはあまり期待しないでね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "となれば……俺がマルシルを落ち着かせよう。君たちのほうは、まず大祭司の気を引けるものを探してきてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "どうやって？　どこで探しゃいいんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "とりあえず豪華なメシでも作って、それで大祭司を引き付ければいいだろ！　早く！　オマエらのツレは多分幻覚を見てるから、このままじゃオレんちが吹っ飛ばされちまうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "チルチャック、君たちは行ってくれ！　ここは俺がなんとかする！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "わかった、マルシルは任せたからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "魚と木の実は十分手に入ったな……案内に感謝する、アダクリスたちよ。世話になった上で悪いのだが、もう一つ頼みたいことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "サカナってなんだ？　こいつは鱗獣だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ほう、ここでは魚をそう呼ぶのか。　とにかく、先に村へと戻って湯を沸かしてもらいたいのだ。できるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "湯を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "うむ。たった今思いついたアイデアでな。普通の食事では、大祭司をすぐさま引き寄せるのは難しいだろうし、大鍋でシチューを作ろうと思うのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "お前たちが我々に親切にしてくれたことへの礼でもあるが、その大祭司とやらは賑やかなほうが好きだという話も聞いたのでな。皆で鍋を囲めば、自然と賑やかになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "おお！　超美味いシチューを作ってくれるってことだよな？　やったぜ！　そんなら急いで準備しにいくよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "うーむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "この魚と木の実があれば、副菜としては十分だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "まだ何かが足りないような……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "おかしいのう。妙な音が聞こえて様子を見に来たが、変わった様子はなさそうじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "それにしても、「インビンシブル・クール」も急に爆発してしまったし、どうもツイてないのう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ま、もう良いじゃろ！　帰って寝るとしよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "やれやれ、ここの研究を代わりに見ておいてやるとズゥママに約束していなければ、一人でここに留まろうとは思わんかったんじゃがな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ふくよかな体型に鮮やかな色……丸々と太った健康的な鳥だ。念のため、食べられるかどうか『ボブのグルメガイド』を確かめてみるとしよう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "「羽獣。全身が羽毛に覆われており、空を飛ぶことができる。食べられる。美味。どう調理しても良い。」か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "なるほど……この食材であれば、シチューの主役に相応しい。見た目にも心惹かれるものがあるな。これならきっと大祭司も満足するだろう！　よし、これに決めた！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "（何やらドゥリンがわしを狙っているようじゃが、まさか食おうとしているわけではあるまいな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "（ん……むむ？　こやつ、本当にドゥリンか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "（……ほほう、なるほどのう。これは面白い。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "（じゃが、待てよ……しばらくこれをやっておらんからのう。死んだふりというのは、どうやるんじゃったか？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ギャアアアアアッ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "……そこまで苦しめるつもりはなかったのだが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "グッ――ガアッ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "まあ、仕留められたのなら良しとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "チルチャック！　木の実は十分集めたか？　そろそろ戻るぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ねえ、あなた本当にライオスなの？　どうして炎竜っぽい姿をしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "マルシル、ファリンの話をしようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ファリンはねえ、私の親友なんだよ！　あの子は本当にあなたのことが大好きでね。知り合ってからもずっとライオスの話ばっかりしてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ほかの人たちはファリンのことを落ちこぼれだと思ってたみたいだけど、私はそうは思わない。だって、あの子から色んなことを学んだもの！　私、あの子のことが大好きなの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "だけど……それなのに……私が弱すぎるせいで、ファリンは炎竜に……炎竜に食べられちゃった……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……それは君一人の責任じゃないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "ファリンは俺の妹なんだ。絶対見捨てたりしないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その一方で、彼は好奇心を抱かずにはいられなかった。今のマルシルの目からは皆が炎竜に見えているようだが、それぞれ一体どんな竜として映っているのだろうか？\nセンシであれば、背が低く丸々とした炎竜だろうか？　チルチャックなら、小柄な炎竜なのだろうか？\n自分もその実を探して食べてみるのはどうだろう？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "マルシルの様子はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "たった今眠ったところだ……体の防衛反応の一種ということだが、できるだけ早く解毒して目覚めさせた方がいいと彼らが言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "わかった！　ならば、すぐにシチューを作ろう。この丸々と肥えた鳥を使ってな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "上手くいくといいんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "とにかく、今は急がねばなるまい。鳥はわしが下ごしらえをしておこう。ほかの食材のほうを手伝ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "森の中の風向きを確かめ……火災が起こらぬよう、風の当たらない場所で火を起こす。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "木の実と食用のキノコ、そしてジャガイモをきれいに洗ったらちょうどいい大きさに切り、一度脇に置いておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "次は、鍋に香辛料とカピピ草を入れ、肉に味がしみやすくなるようにひと煮立ちさせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "そこに木の実とキノコを加えたあと、数分煮て出汁を取り、その後肉とジャガイモを入れる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "魚はウロコを取り、腹を切って、食べられない内臓を取り出す。エラは流水できれいに洗うか、ナイフで直接取り除いておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "水平に切り込みを入れた魚に、トウガラシ、胡椒、塩、レモン汁を均等に混ぜ合わせたものを塗り……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "清潔な枝で刺し、たき火のそばに立てておく。この時、均一に焼けるよう頻繁に回転させるのを忘れてはならん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "その後は再び鳥のシチューの調理に戻る。スープにとろみが出てきたら、塩で味をととのえ、味見をする！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "香りが立つまで弱火で煮込んだら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "完成じゃ！　このシチューを大祭司に捧げよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "お前たちは普段、どのように大祭司を呼び寄せておるのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "歌って！　踊って！　楽しいお祝い気分で、思う存分食うんだ！　そうすりゃ大祭司は自然と寄ってくるぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "よし、早速みんなで食べてみよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ふむ……キノコと木の実を加えたことで、シチュー全体の味がとても豊かになったな。薬草の独特な香りも相まって最高の一杯だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "うわぁ……いい匂いだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "ほらほら、歌って！　踊って！　ぼーっとしてたら大祭司は来ないわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "よ……よし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "チルチャック、センシ！　君たちも踊ってくれ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "はぁ……まだ来ないのかよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "だったら最終手段だ！　真剣に呼んでみよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "大祭司様！　ご馳走を用意しました、お出ましください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三人",
      "text": "……大祭司様！　ご馳走を用意しました、お出ましください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "うぐぐ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解毒草と鳥のシチュー",
      "text": "グガガガガァ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "じゅるり……もぐ……もぐ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ごくん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "なんと温かい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "こんなにも気持ちの良い風呂に入ったのは久しぶりじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "しかし、この風呂は妙な物ばかり浮かんどるのう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "キノコのスライス、そのうえこれは、角切りのジャガイモか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "トウガラシとカピピ草まで入っとる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "じゅるじゅる……もぐ……もぐ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "むぐ……ぺっぺっ！　ひどい味じゃな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "もしやこれは薬湯なのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "あぁ……しかし、この尻の焦げるような感覚は、メカから打ち上げられる直前にコックピットを満たす熱を思い出させるのう。なんとも心地が良い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "これに浸かれば、爆発疲れも一気に吹っ飛ぶわい！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "なんと……！　この鳥、復活したのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "捌いた鳥が元通りになるなんて、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……こいつは「不死の魔物」なのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "大祭司！　どうして鍋の中にいるんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "はあ！？　このデブ鳥が大祭司だって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "うっ……あいつ、風呂みたいに浸かってやがる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "おえ……一口飲んじまった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "（ああ、「不死の魔物」だと思うと味が気になる……！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "うむ！　わしこそが大祭司じゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "風呂に浸かっている間に、お主らが何を求めているかはすべて理解した！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "仲間が毒に当たったのだろう！　無論わしは、決して見殺しにはせんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "なんでそれを知ってるんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "うぉっほん！　仲間の解毒をしてやりたいのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "この薬湯を飲ませるのが一番じゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "こんなに不味いものを飲めば、どこぞの狂った狼だろうがきっと正気に返るじゃろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ま、不味いだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "だとしたら、一番の原因はメインの食材だろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "何にせよ、大祭司がそう言うなら、大祭司の祝福を受けたシチューをそいつに食わせてやろうぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ずずっ……うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "変なシチュー……でもあったかい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……うぅ……うるさい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "すごいぞ！　大祭司シチューが本当に効いた！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "大祭司……シチュー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "しまった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マルシルがなんとか目を開けると、そこには――\nそこには、喋る魔物の姿があった。そのうえそれは、生きたまま自分を茹でる鍋の中でシチューを味わっており、目の前のお椀からはその鍋と同じ香りが漂っている。\nと同時に、スプーンを握ったライオスが、目にも止まらぬ速さで鍋へと手を伸ばし、ひとすくいして自らの口へと運ぶのも見えた。\nマルシルは口を開くと、ようやく我に返ったかのように悲鳴を上げた――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ま、魔物！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ああ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "もういや！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "もう魔物なんて食べたくないよ～～！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "へえ、このシチューなかなかいけるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "わーっはっは！　お主、ひどいセンスをしておるのう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "大祭司……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "シッ！　お主が尋ねたいことはわかっておる！　事の次第はなんとなく理解した……なるほど、今はその時ではないようじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "その時？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "おおっと、何でもないわい……それよりお主ら、ロドスを探しておるんじゃろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ならばそのまま探し続けるが良い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "お主らは正しいほうへと進んでおる！　このまま進めば、きっと大丈夫じゃ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "き、消えた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "なんの役にも立たないアドバイスだったな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "正しい方向に進んでるも何も、俺たちはまだ、どこへ向かえばいいかもわからないってのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "ところでマルシル、どうしてあの実を迂闊に食べたりしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……木苺にそっくりだったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "木苺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……昔、ファリンがくれた木苺によく似てると思って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "小鳥もあれをついばんでいたし、きっと同じものだと思って少しつまんじゃったの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "でも、それならファリンに土産話ができたんじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "食中毒で大変なことになったってな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "も〜、うるさいな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ほら、行こ！　ロドスを探しにいかないと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
