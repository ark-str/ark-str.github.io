{
  "server": "jp",
  "storyId": "act30side_level_act30side_01_beg",
  "groupId": "act30side",
  "stageId": "act30side_01",
  "title": "乗車時のご注意",
  "storyCode": "RS-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act30side/level_act30side_01_beg.txt",
  "sourceHash": "584ad40f3bebebbdb61a90d0bfffd45b5187a282762b7b3ec573ed6eecfb685a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "身軽なチェゲッタ",
      "text": "フン！　ハァッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "息を切らすチェゲッタ",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "text": "ハッ……！　セイッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闘志みなぎるチェゲッタ",
      "text": "食らえ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタたち",
      "text": "ハアッ！　かかれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたたち、食事はちゃんと取ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もう一度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "text": "む、無理ですよ姐さん、本当にもう限界ですって……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "立ちなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "私はあなたたちにどう教えてきた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "立って、武器を握りなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闘志みなぎるチェゲッタ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "息を切らすチェゲッタ",
      "text": "はぁ……はぁ……やあッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "遅すぎる。それに軽すぎね。アーツは急ぎすぎているし、戦術がワンパターンだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "少しは息が合ってきたようだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "全体の実力としてはお粗末ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "身軽なチェゲッタ",
      "text": "比較対象が姐さんじゃなあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "text": "はぁ……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "text": "まあ、一言褒めてもらえただけでも、ここんところやってた訓練には価値があったってもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闘志みなぎるチェゲッタ",
      "text": "こんなもんじゃまだ足りねぇよ！　俺もいつかは姐さんみたいに、片手で岩を細切れにできるようになんねえと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "息を切らすチェゲッタ",
      "text": "お前なんかが……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "休憩はこれで十分そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "それじゃ、もう一度いくわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタたち",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "text": "姐さん！　大変です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "まずは落ち着きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "何があったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "text": "あっ、た、大変なことが起きたんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "text": "麓のほうで、大騒ぎになってて……ち、血がたくさん……！　俺たちじゃどうすることもできません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "text": "一刻を争う事態なんです！　早く来てください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "わぁ！　発車したよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "あはははっ！　ママ、はやくはやく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "――うわっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "text": "列車の中で走っちゃダメって言ったでしょ！　ケガはない！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "ママ、見て見て！　変な帽子の外国人いるよー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "text": "こら、何てこと言うの！　人を指さしちゃいけません！　失礼な子は巫女様に嫌われちゃうわよ。早く謝りなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "text": "はぁ……あの、大変申し訳ありませんでした。なにぶん、まだ何もわからない年頃でして……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "失礼、私は前の席なので、これで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（明らかに定員オーバーだな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（現地の住民と観光客でおよそ半々か。ふむ、観光列車にしては珍しいな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（最後列の隅に積まれた麻袋が若干気にかかるな……袋の中で、何かが動いているようだ。動物は持ち込み禁止とされていたはずだが……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（ふむ。ほかに異常はなし、注意すべき人物もなし……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（あの情報は銀心湖行きの列車を示していただけだった。実際の手がかりを得るのは、そう容易ではなさそうだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（やはり、機を見て個室を確かめなければ……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドン。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドンドン。"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "先ほどから、背もたれに異常な振動を感じる。\nまさかイェラグの列車には、背もたれを蹴り続ける怪異でもいるのだろうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドンドンドンドンドン。\nまるで無反応な彼の様子を不満に思ったかのように、また背もたれが何度も蹴られる。\nしばらくすると、後ろに座っていた子供が、彼のほうを覗き込んできた。"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "ねえねえ、変な帽子のおじさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "もしかして、おじさんって列車乗るのがすっごく好きなの？　何日か前にも見かけたからさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "……私を見たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "見たよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "あっ、もしかして今までレールや列車を見たことなかったとか？　それでそんなに列車が好きなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "ごほん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "なんで咳するの？　恥ずかしがらなくていいよ！　ぼく笑ったりしないから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "この列車、とってもすごいんだよ！　ぼくもだーいすきなんだ！　ママが言ってたんだけど、これがあるのは巫女様とエンシオディス様のおかげなんだって！　イェラガンドのご加護だよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "あ、そうだ……ぼくのおもちゃ貸してあげるよ！　ほら、列車のおもちゃ！　だから一緒に遊ぼう、おじさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "text": "もう、やめなさい！　ちゃんと席に座って、ほかの人に迷惑かけないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "text": "ご迷惑ばかりおかけして、本当に申し訳ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "text": "しつけがなっていないもので……しっかり言い聞かせておきます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "いや、気にするな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（この帽子……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "text": "（そんなに変なのか？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "今日は乗客が多いですね。例のイェラガンド像はどうやら大人気と見えますな！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "しかし、列車に乗るたび思うのですが、カジミエーシュ騎士競技の競技場は――\nむっ！　わが足指をつついているのは何奴か！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "こいつは……羽獣か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "逃げ出した羽獣",
      "text": "（力強くつつく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おおっとっと、羽獣殿、どうぞおくちばし柔らかに……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "逃がしちまってよかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "大丈夫なのかよ。列車の中ってペット持ち込み禁止じゃねぇの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ルール上はそうなっておりますが、そこまで厳しく取り締まらない場合もあるのですよ。それが必要な地元民に便宜を図っているとでも言いましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ですがご安心を。この手の羽獣は大抵、麻袋に入れて持ち込まれていますので、大きな問題にはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それはさておき、レディ。私が予約しておいた個室はこの先にございますぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ふぅ……はぁ～、やれやれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "クソ混んでたな！　やっと座れたぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "立ち乗りも覚悟してたから、個室に入れてもらえてよかったよ。ありがとな、おっさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お安い御用ですよ、レディ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "やめてくれよ、そんなバカ丁寧に喋らなくていいって。レディとか言うのもやめて、ロザリンって呼んでくれ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ではお言葉に甘えて……\n「ロザリン」。いやはや、実に美しい名前ですね。貴方によく似合っていますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "へへっ、そうだろ。母ちゃんがつけてくれたんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おっさんはなんて名前なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ぜひ、ハロルドとお呼びください。無論、引き続き「おっさん」でも構いませんがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それにしても、貴方は運の良い方だ。この列車を逃せば、暗くなる前に銀心湖に着くのは難しかったと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そーなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "へへっ、間に合ってよかったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そういや、ハロルドも銀心湖に向かってるんだよな？　本当は何しに行くんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はて、その質問にはお答えした気がしますがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "何しろ、イェラグの景色はこんなにも素晴らしいのですから、良い目の保養になるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "誤魔化しても無駄だぜ。こんな大所帯で観光なんかするわけねぇだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おや、観光客には見えませんでしたかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おう、ちっともな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "どっちかっつーと、面倒ごとを起こしに来たように見えるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はっはっは！　そんなことをするはずがないでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "私はイェラグの景色と文化にすっかり惚れ込んでおりましてね。引退後はいっそ、この地で隠居しようかとすら考え始めたほどなのですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ですので、そう、よほどのことが起こらなければ、我々はただの観光客でいられるというわけでして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "じゃあもし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "――ではロザリン、そう言うあなたのほうは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "観光客にしては随分イェラグ語が堪能ですね。本当にここへ来るのは初めてなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "無理やり話題変えんなっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はっはっは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "まあいいや。まだ話してなかったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私は半分イェラグ人みたいなもんなんだ。ウルサスで母ちゃんに女手一つで育ててもらってたから、正直自覚はねぇんだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ほう、母君はウルサスの方なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ああ。でも母ちゃんが言うには、私はイェラグ生まれで、父ちゃんはイェラグ人らしくてさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "つっても、ガキの頃のことなんてあんま覚えてねぇし、言っちまえば旅行みたいなもんかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "なるほど、そうでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ところで、お会いした時から聞きたかったのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "貴方がずっと抱えているその箱は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "こいつは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いや、申し訳ない。プライベートな事情に関わるものであれば、何も仰らないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "別にいいって。ただ、どう言えばいいのか考えてただけでさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "これは母ちゃんが私に託した……形見なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "心より哀悼の意を表します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "つらい過去に無暗に触れてしまって申し訳ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お悔やみ申し上げます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "別に、何もつらくなんかねえっての。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私が今回帰ってきたのは、母ちゃんの願いを叶えるためなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "text": "デーゲンブレヒャーさん、これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "もう大丈夫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "やれることはやっておいたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "text": "あなたのおかげじゃ……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "text": "デーゲンブレヒャーさんがいなければどうなっていたことか。これもイェラガンドの思し召しじゃな……おかげで皆命拾いしたわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "私にできるのはここまでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ごめんなさいね。あまり……気持ちのいい眺めではないけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "text": "じゃが、今はもう、ほかにどうしようもないしのう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "text": "姐さん、お身体に血がついてますが、どうなさいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "後で考えるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "今は時間がない。一通り対処はしたけど、また問題が起こらないとも限らないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "今は「あの人」を見つけることのほうが先決よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "text": "ですが、あの人はもう駅を離れたって話ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "text": "今すぐ列車を止めてくれ、なんて鉄道側に連絡したら、パニックになるかもしれませんし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "列車を止める？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そんなこと、するまでもないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "text": "じゃあ、どうするんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "下を見なさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "text": "こいつは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "text": "列車だ！　ちょうど下の山道に差し掛かったとこですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "text": "え、待ってください、姐さん！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "落ちて行く彼女の姿は、雪より軽いようにも、石より重いようにも見えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "さて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あの人はどこかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
