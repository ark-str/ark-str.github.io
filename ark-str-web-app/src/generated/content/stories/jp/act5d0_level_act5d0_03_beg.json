{
  "server": "jp",
  "storyId": "act5d0_level_act5d0_03_beg",
  "groupId": "act5d0",
  "stageId": "act5d0_03",
  "title": "7:22P.M.",
  "storyCode": "CB-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act5d0/level_act5d0_03_beg.txt",
  "sourceHash": "f640f7b9232dc427e7f30f308bcf38f9d55559d6d44298bd7d5ec312d77ba500",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "えっ、ぼく……落とされたの？　橋の上から？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "地面までの高さはどれぐらい？　あと敵はどこから狙撃を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "いや、そんなことより、ぼくが今すべきは——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "うっ——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ぷはっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "た、助かった。これは……？　うわ、べたべたする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "これは安魂夜用のキャンドル？　助かった。こんな所に積んであるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ねぇ、角にも一本引っかかってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "え？　あ、ありがとうございます。抜かなきゃ、ん——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "えっとロウソクくん、まずはじっとして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "静かに、この箱の後ろに隠れて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "フロンゾとの通信が途絶えた。この近くにいるはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "あとペンギン急便の奴らもここにいるハズだ。ターゲットを発見したら、すぐにボスに連絡しろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もう出てきていいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あ、はい……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "助けてくださってありがとうございます。ですが、ここにいると貴方まで巻き込まれます。どうかここからすぐに離れて下さい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "んー、私もそうしたいんだけどね。せっかく龍門に戻ってきたばかりだし。でも依頼があるからそうもいかないかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こんなにボロボロになるとはね。ペンギン急便との付き合い、なかなか大変でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……ええ、まぁ、なかなか刺激的ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ところで貴方は？　ただの通りすがりというわけではなさそうですね……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そんなに警戒しなくても大丈夫だよ。とりあえず、君の敵じゃないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あ、また奴らが来たみたいだね。とりあえず隠れて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "クソが、フロンゾはやはりペンギン急便の奴らに捕まったか。俺らはどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "あのバイソンとかいうフォルテの坊主が、奴らとはぐれたようだ。これはチャンスだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "だがここはもう市街区だ。俺らで出来るのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "カポネさんは全てお見通しさ。目立たないようにコッソリやれば、龍門だって大目に見てくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "わざわざ、あの生ゴミくせぇ路地裏に構う奴なんていねぇだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "わかった。それなら俺らは救出に向かって、お前らは捜索だ。それで問題ないな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これ以上ここに長居するのはダメそうだね。私たちもここを離れようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どれどれ……ああ、あそこだね、手でも振ってみて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ボス、バイソン坊はまだ見つからへんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "俺がかけてるのはサングラスであって望遠鏡じゃねぇんだ。そう急かすなっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "あ……見えたぞ。こっちに向かって手ぇ振ってるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なら早く迎えに行こうよ。それからコイツの尋問をしないとね。何のためにこんな事しているのかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "う——うう——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "どうやら俺たちは、ラッキーな実習生を安全な場所に落としたみたいだな。奴は自分で帰ってくるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "マジか……十二メートルの橋の上から落下して、安全な場所なんてあるかんいな？　ちゅうか、安全な要素なんてゼロやん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "彼も敵のターゲットの一人でしょ、本当に自力で帰ってこれるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ああ、アイツが一緒にいるのが見えたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "アイツって……彼女が……帰ってきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシア、集中して。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "奴らあそこにいたぞ！　フロンゾを取り戻せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あちゃー、確かによそ見してる暇は無さそうだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お、あの連中、ごそっと行っちゃったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "で、テキサスたちはまたどんな面倒事に巻き込まれたの？　今度は誰と戦ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "それより貴方は一体……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ああ、自己紹介をしようか。私はモスティマ。ペンギン急便のトランスポーターだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "一応、君の同業者ってところだよ。でも単独行動をする方が好きなんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……モスティマ…さん。父のところでお名前だけは聞いたことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "（そして漆黒の双角を持つサンクタだということも……あの噂は本当だったみたいだ。いや、やっぱり聞くべきではないか……。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "へぇ……名前をね。それって良い噂？　それとも悪名の？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "いえ、何というか……どれも不思議な噂ばかりで……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "すみません…。貴方はぼくを助けてくれたのに、ぼくは貴方を疑ってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ああ、気にしなくていいよ。かしこまられると私が困る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ありがとうございます。では、まず必要なのは情報の共有でしょうか……。とはいえ、今の状況はぼくにもさっぱりなんですけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……簡単に説明しますと、ペンギン急便とシラクーザのマフィアの間でいざこざが起きています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "うん、そうみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "え？　リアクション、それだけですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "心配しすぎるだけ野暮ってやつだよ。気にしても仕方ないところは気にしない。そして自分の心の赴くままに任せる。そしたらペンギン急便のペースに付いていけるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "それって、いわゆる思考放棄なのでは……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ま、ユニークな人ばかりだからね。常識なんて通用すると思ったらダメだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……モスティマさんもですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "普通、それ直接本人に聞く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "そ、そうですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "とにかく、ここから離れるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "付いてきて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "おい！　まだターゲットは見つからないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "畜生、ここは人が多すぎるんだよ。何やってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "行くぞ、俺たちは別の場所に向かう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……奴ら、ぼくたちに気付かなかったみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "こんな感じで行こうか。それからテキサスたちと落ち合う方法を考えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "うーん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ど、どうしました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "この方向、正面のはまさか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "や、奴らに見つかったんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ここだったのか。やっぱり長いあいだ龍門を留守にしてると、名前なんて全部変わっちゃうよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "うーん……バイソンくん、食べたいのある？　抹茶味かチョコレート味とかどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
