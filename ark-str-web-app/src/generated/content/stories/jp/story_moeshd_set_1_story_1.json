{
  "server": "jp",
  "storyId": "story_moeshd_set_1_story_1",
  "groupId": "story_moeshd_set_1",
  "stageId": null,
  "title": "商売とは",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_moeshd_1_1.txt",
  "sourceHash": "22e3054e90c022cb98248021fc9f59da48dd613e58f981dd8db41c74d41ddbe9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "エクシア、クロワッサンから返事あった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うん、ええよーだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "よかった～。会社の倉庫が一杯の時はここに荷物を置いてもいいって聞いてはいたけど、一応事前に伝えておいたほうがいいもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "はぁ～あ、バーゲンセール期間さまさまっていうべきかね、うちの倉庫はもう満杯で、足の置き場すらないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "そうだね、こんなに忙しいのも久々だよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ていうかびっくりだよね、部屋自体ごく普通だったのに、下にこーんなデッカい倉庫があるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あたしは知ってたけどね。クロワッサンが前に言ってた。部屋は二フロア借りてて、一階は住宅用で、もう一階は荷物置きにしてるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "いや～こんなにたくさんの荷物が、きちっと仕分けして整理されてるとこを見ると、気持ちいいよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "フルーツの缶詰は、えっとー……工芸品、日用品、洋服に食べ物だから、ここあたりかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん？　……横にあるこの箱たちは何だろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "メイスーのメンテナンスオイル……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "エクシアはーん、連絡もろてすぐ飛んできたで！　どや？　置く場所見つかったかいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "見つかったっちゃ見つかったけど……ねぇ、なんかオイルが山積みになってるんだけど、どういうこと？　もう買えたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "お金足りたの？　つい先月も生地を買う金が足りないって、あたしに借りに来てたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あーそれな、前に買い溜めした旧パッケージなんよ。まとめて売りさばくつもりやで。その売り上げで、また最新版を仕入れられるっちゅうわけや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "でも旧製品でしょ、そんなの買ってくれる人いるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "確かにもう古うなっとるけど、今年の頭に出たモンやし、まだ使用期限も切れてへん。値段も市場に出とる新製品より安いし、十分買い手はつくやろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "今年の頭？　随分バージョンアップが速いメーカーだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやなぁ。年に二回リニューアルするんやから、開発能力もバツグンやろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ねぇ、クロワッサン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ん、どしたん、ソラ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あたしからしたら、年に二枚は必ずアルバムを出すようにって要求されたら、クオリティの保障まではちょっと……ってなる気がするんだよね。でもまったくの畑違いだから、わけが違うかもだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あぁ、そこは心配せんでええよ。ここのオイルはウチもずっと使うてきてん、なかなかイケるで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "機械に錆ができた！　設備が摩耗して老朽化！　パーツもなんだか動きが鈍い！　そんな悩みをお抱えのそこのあなた！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "あれもこれもぜーんぶ――最新のメイスーオイルにお任せあれ！　耐高温、耐酸化、高粘度、高純度！　ベストチョイスがここに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "独自の添加成分で、あなたの機械と設備を、いつまでも新品同様に輝かせることができる！　五つの効果が今までにないような体験をもたらすでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "さらにさらに――今だけのチャンス！　フルセットのご予約で、なんとシークレット版を入手できます！　――いつまでも良い暮らしを、メイスーと共に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "クロワッサン、ラジオ変えてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ええで。いやーしかしメイスーはほんま広告に力を入れとるなぁ、いつ聞いても絶対流れとるんやから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "龍門にその名を轟かせる職人、李錘錘（リー・ツェイツェイ）との限定コラボ商品が発売決定！　メイスーのオンラインショップと実店舗のどちらでもお買い上げいただけます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "リー氏のサイン入り工具一式を、先着百名限定でプレゼント！　欲しい方は今すぐお電話を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低い男性の声",
      "text": "リー・ツェイツェイだ。メイスー、マイスターも選ぶクオリティがここに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ん？　この人って、今ネットとかでめっちゃバズってる機械修理職人やないの！　メイスーとコラボ商品を出すなんて、最新版がよっぽど気に入ったんやろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でもさ、大事なのって実際に使ったお客さんたちの口コミなんじゃない？　有名人の一人や二人が宣伝したからって、ねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやかて、買いたい人よーさんおるんよ。店の前にできた長蛇の列がそらもう道路を埋め尽くす勢いやったんやで？　ウチの予測を遥かに超えたヒット商品や。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "こんなに人気の商品は見過ごされへん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "人気あるのはいいけど、古い在庫はどうすんのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "はぁ、それを言わんといてな。ウチんとこ来るメーカーはみーんな口裏合わせたみたいに、低い値段を出してくるんよ。きっとウチが早よう捌きたいっちゅーのを見透かして値切って来よんねんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあどうするの？　売るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "今週中に余所から連絡が来ーへんかったら、売るしかないんやろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まぁ、商売に波は付き物だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "おっ、ウチのことを慰めてくれてはるん？　エクシアは～ん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ちょ、こっち見ないで前見てよ、前！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "在庫処分セール、とってもお買い得ですよ！　欲しい香りがすべてここに！　全品値引き中！　最高のフレグランスがあなたを待っています！　気になる方はぜひオルソネーザル社までご連絡を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あっはは～、どうやらウチと同じように在庫に困っとるかわいそうな人がおるみたいやね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "笑顔が引きつって見えるよ、クロワッサン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "車内ラジオ",
      "text": "オーツミルクプラスコーヒー、あなたの暮らしがより健康、そして豊かに。時として、１＋１は２を超えることもある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うーん、最近の広告って、どんどん胡散臭くなってるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやろか、ウチは理に適っとるとこもあると思うんやけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "コーヒーにオーツミルクを入れたら暮らしが豊かになるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ちゃうちゃう、そのあとの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "１＋１は２を超える？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せや！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性の声",
      "text": "フレグランスの責任者に取次ぎいたしますので、もう少々お待ちください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性の声",
      "text": "張（ジャン）さん、朝に面会予約をいただいたお客様がお見えになりました。ご案内してもよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "ああ、お通ししてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性の声",
      "text": "承知しました――ではお客様、中へどうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "これはジャンはん、おおきに。お忙しいところすんまへんなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "はは、構わないよ。ところで、何とお呼びすれば良いですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "クロワッサンや、まんまクロワッサンて呼んでもろて構わんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "ではクロワッサン殿、本日はどういったご用件で……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "やー、実はな、手元に廃盤になったメイスーのメンテナンスオイルがあってな、倉庫に溜まってるねん。早いとこ捌きたいねんけど、なかなかいい買い手がつかんのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "……すまないが、なにか勘違いされているのでは？　弊社はオイルの需要はありませんし、ご存知の通り、うちも在庫が減らず頭を抱えてる状態でして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（指を振る）チッチッチッ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "いんや、今日のとこは別にセールスに来たわけやないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "はぁ……でしたら何の用で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "おたくの会社と提携したいと思って来ましてん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "それはありがたいお話ですが、正直に言いますと……そちらがずば抜けた販路をお持ちのようには到底見えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ははっ、あんたはん目利きやね！　でも、ウチが提供するのは販路やない、策や。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "ほう、と言いますと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せや、お互いウィンウィンになれる策やで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "伺いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ズバリ、お互いの在庫の抱き合わせ販売や。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "処分品のオイルと流行遅れのフレグランスを？　どう考えても消費者に見放されそうな組み合わせですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "いやね、ウチが在庫で抱えとるオイルはちょこーと匂いがキツいねんけど、おたくのフレグランスと一緒に使うたら、ちょうどええ感じになるんちゃうかな思て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "それにおたくはバリエーション展開が多いやろ？　そこにピンと来たんや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "オイルとフレグランスだけじゃ確かに味気ないけど、おたくの商品は種類が豊富やさかい、シンプルでも色んな組み合わせを出すことが可能や。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "パッケージにあえて香りのタイプを載せないようにするんも一つの手や、お客に買ってからのお楽しみってやつを味おうてもらえるやん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "（神妙に頷く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ほんで聞きたいねんけど、おたくの商品で比較的に受けがええんは何やろか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "そうですね、バラの香りのタイプが最も売れ行きがいいですかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ほな、それをオマケにしましょか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "一番人気の商品をオマケにするなど、そんな非常識な！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "そんなことあらへんよ。オマケをつける条件は、ほかのセットを全部買いそろえたお客限定にするんやからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "なるほど──しかし、バラの香りのタイプは在庫が少ない。もし品切れになったらどうすれば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あっ、それやったら景品にするしかないなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "全セット購入につき一回、福引きを回せるとかでどやろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "段々と見えてきました。こちらにはほかにも細々とした在庫がありますから、それらを参加賞にして、二等と三等をそれぞれオイルとフレグランスにするというのでどうでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "しかし、一等賞を何にするかは、そうですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "一等賞の景品はこっち持ちでもええねんで。むむ、厳しいけど、手放したるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "何を提供するおつもりで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "エンペラーはんの、サイン付きポスターや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "なんと！？　そんなものを景品にしていいんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ううっ……せやねん、ウチがずーっと大事にしてきた宝物やけど、これも商売のためや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（いや～、去年最優秀従業員賞でもろた景品がやっと役に立ちそうやわ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "目からうろこが落ちるご提案、感謝いたします。ただ、クロワッサン殿、利益配分についてはどのようにお考えで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "この提携において、弊社の商品が多くの割合を占めていることは明白です。よってこちらが多めにいただくのが筋だと思うのですが、そこのところは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "それを決めるにはまだ早いで、ジャンはん。今はもっと詳細なセールスプランを練らな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "それもそうですね。では、こちらが私の名刺です。いつでもご連絡ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ほな、ウチの名刺もどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "こ、これは──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "どないしはったんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャン",
      "text": "いや、な、何でもありませんよ。ただ……こんなにも可愛らしい名刺は、初めて拝見したもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あはは、第一印象はバチコーンと決めたいさかいに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "おっ、おかえりー。やっと帰って来たね。商談どうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "バッチグーやで、まぁ分配金についてはまだ確定やないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ふーん、なんか考えでもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "……せやねぇ、このタイミングで電話してみよか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "えーと電話番号何番やったっけな、名刺名刺……これは服屋やろ、電気用品屋に農産物屋、これは散髪屋……あ、フレグランスさん、あったあった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……その名刺入れ、広げると地面についちゃうぐらい長いんだね……じゃなかった、電話するって、もうセールスプランができたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "セールスプラン？　そういう話はまだ時期尚早やで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あっ、まいど～、ジャンはん？　今朝お会いした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "そうそう、クロワッサンや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "こっちのオイルの在庫はもう整理が済んどるから、いつでも梱包作業に移れるねんけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ただ、さっき機械の修理屋さんのバイヤーがウチんとこに来てな、ウチが持っとるオイルにえらい興味持ってくれとんねん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ほんでな……実は向こうが結構いい値段を出しはって、ぜひ譲ってほしいて言うてきたんや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あーいやいや、まだ返事はしてへんで。もちろんウチかておたくみたいなデカい会社さんと協業したいと思とるよ、せやけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "うん、分かってる。ビジネスやっとったらこういう場面は避けられへんもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "やばっ！　ジャンはん、例のバイヤーが追っかけて来よった！　少し待っといてくださいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（ハハ、中々の演技派だねぇ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（マイクを手で軽く覆う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "なんやて！？　ホンマに全部買うてくれはるんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "いや～でもそういうわけにもいきませんて。もう余所と抱き合わせで売り出すっちゅう約束をしてもたからに……いやいや、値段の問題やないんですわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "そない言われても困りますわ～。なんぼ急いでるいうても……はぁ……分かりました、ちょっと考えますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（マイクの手を外す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "お待たせしましたジャンはん、いや～すんまへん、例のバイヤーがしつこくて。なんや向こうはめっちゃデカいプロジェクトを抱えるらしくて、大量のオイルが必要みたいなんですわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "こっちの配分が多めでもいい？　いや～、そんなん申しわけ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "気ぃ使うていただいておおきに！　ホンマに感謝しとりますわ！　ほな、明日の朝にまた商談っちゅーカンジで？　……ええ、ええ、ほなジャンはん、また明日！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "上手くいった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "うん、一件落着や。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "これで金も入って、新製品を買う算段がつくだけやのうて、ソラへの借金も返せそうやわ。ありがたや～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "クロワッサンさ、俳優業に転身するとか考えたことない？　きっと売れるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ないない、そんなん割に合わん商売……ちょい待ち、それ本気で言うとるんやないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（肩をすくめる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "いや～しかし……上手くいきすぎて逆に怖ぁなってきたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（ガラスに映ってる自分の姿を見る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "うん、ええ面構えや。あんたが稼がんで誰が稼ぐっちゅーねん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "よいしょお！　これが今日売り出す最後の一箱っと。どれどれ……残り二箱か、ええやんええやん！　まだ完売してへんのにもう元が取れてもうたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "前はそのやり方が全然理解できなかったけど、今にしてみれば確かに正解だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ウチはちいこい頃からおとんやおかんにこういう目利きの訓練をさせられとったからなー。ハズすようなことはあらへんで、ごっつ頼もしいやろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "代々商人の家系なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "うーん……まぁそんなとこや、両親がやっとる売店で育ったようなもんさかい、知らぬ間に商人の考え方や習慣が色々と身に染みついたんやろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "で、残りのオイルはどうするの。買ってくれそうなとこ、もう目処がついた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "この二箱は自分用に残しとくつもりや。実際に使ったお客さんからの口コミも悪くなかったし、ええモンなんやろと思てな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしも一瓶もらってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "一箱でもかまへんで、好きなだけ持っていき！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（パッケージをじっくりチェックする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "何を見てはるん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "成分表、銃にも使えるのかなーって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "そういや、ウチもずっと売りさばくのに忙しかったから、このオイルに新しく添加された成分が何なんか見てへんかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "前のオイルの空瓶もまだ残っとるし、比較してみよか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "持ってきたで！　ほな見てみよか……一体どんなすごい成分を追加したんや？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まずは75%の鉱油系基油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "そこは変わってへんな……他は何が入っとるんや？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "増粘剤、抗酸化剤、防腐剤……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "特に何も変わらへんな？　なんやねん、成分まったく同じやん、広告で言うとった新成分はどこに行ったん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "待って、下の方に確かにこっちにはない文字が……ええと、ローズオキシド？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "何やそれ？　ちょっと調べてみるわ……ローズオキシド、香りの成分で、バラの甘い香りがするんやて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっ、じゃリニューアル版って結局香料が足されただけってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ウソやろ……してやられた気分やわぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "メーカーの考えと偶然一致したってことだよね？　すごいじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（クロワッサンの肩を叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ほら行こ、まだ夜の配達の仕事が残ってるんだからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "クロワッサン、行かないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一ヶ月後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ここって、いつ来ても長い行列ができてるよね……角を曲がっても全然終わりが見えないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "また何か新商品の発売日なんじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モニターの広告",
      "text": "メイスーオイル最新作、いよいよ本日発売！　今回はなんと、カスタマイズサービス付き！　十二種類もの香りの組み合わせで、新たな体験をご提供！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニターの広告",
      "text": "今ご予約いただくとさらに、フレグランス専門のオルソネーザル社より、コラボ製品となるシークレット版をプレゼント！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニターの広告",
      "text": "いつまでも良い暮らしを、メイスーと共に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "このメーカーのオイルって、確か先月にリニューアル版が出たばっかだったよね？　もう新しいのが出るわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "てかさ、この列にクロワッサンもいたりするのかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "そりゃいつもなら絶対いると思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "でも、今回はいないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ここんとこずっと落ち込んでたじゃん。買い物や外食に誘っても来ないし、自分の商売も何か手に付かない感じで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "知ってた？　例の倉庫、今じゃ空っぽになっちゃってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あの一件が相当こたえたみたいだね。それもそっか、あんだけ苦心したのに、結局はメーカーの掌の上で転がされていただけだってことに気付いちゃったら、そりゃ落ち込むよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まさかもうこれに懲りて、自分のビジネスを辞めたりはしないよね……？　そういえばもう何日も見かけてないし、何してるんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "さあね……はぁ、何だかあのせかせか走り回る姿が懐かしいよ。得をしても損をしても、次の日にはすっかり元気になってたクロワッサンの姿がね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしも……にしてもオルソネーザルって、なーんか聞き覚えがあるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あっ、ほら見てエクシア。やっぱりクロワッサンは列にいなかったみたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "こんばんは～！　お二人、一日の仕事終わりに、新食感の肉団子でもいかが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "おっ、サンキュー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "二人とも今帰りなん？　ほな乗りぃや、ついでに送ったるさかい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（身体を少しずらす）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "オッホン、何かに気づかない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "えーっと……髪型変えた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしじゃなくて、後ろにあるショーウィンドウだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ああ、それな。一週間前から知っとったで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あれ？　でも今日出たばっかりの新商品だよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "メイスーの内部情報や。いい提携先を紹介してやったんよ、ほら、あのジャンはんな。そのお礼として、発売日前に新商品をウチに優遇価格で卸してくれる販路を都合してくれたんや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どうりで聞き覚えのある名前だと思ったら……じゃあもう新商品は買い付けたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "いや、断ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どうして？　がっぽり稼げるいいチャンスじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "もうアレを擦る気がなくなったんや……今は新しい商材に注力しとるんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "今度は何を売るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ん～っ！　ちょっと、クロワッサン！　この軟骨入り肉団子、すっごく美味しいんだけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "へへっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
