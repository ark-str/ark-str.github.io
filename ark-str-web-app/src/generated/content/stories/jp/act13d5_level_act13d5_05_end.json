{
  "server": "jp",
  "storyId": "act13d5_level_act13d5_05_end",
  "groupId": "act13d5",
  "stageId": "act13d5_05",
  "title": "スウォマー食品",
  "storyCode": "MN-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13d5/level_act13d5_05_end.txt",
  "sourceHash": "1e9b6d3ca447de677dc1838650514ff4f7630338edc4701950b35e20d81972d1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔 5下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "――騎士競技とは、一体なんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "シェブチックさん、あなたはどう思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……ふざけるのも大概にしろ、チャルニー。俺は忙しいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "用件を言え。どういうつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "……残念ながら、ロアー騎士団はあなたをメジャーの先発から外すつもりのようです。新参の補助騎士が、あなたとほぼ同じ順位につけており、団体戦だと彼のアーツのほうが役立つとの判断で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……なんだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "お前……話が違うぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "もちろん、お約束した前金はちゃんと支払いますよ。ただ、補欠となると税率が変わります。これはおわかりいただけますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "おやおや、どうか感情的にならないでください……たしかお子さんがもう間もなく十歳の誕生日を迎えるんでしょう？　職を失うリスクを背負ってまで、私なんかを攻撃する意味は無いと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "ロアー騎士団があなたに支払う金額は、決して少なくありません。少なくとも、今年はこれ以上頑張らなくても済むでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "俺にはメジャーの参加資格が必要なんだ！　俺は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "それはあなたの努力次第ですよ、シェブチックさん。生きる方法なんて山ほどあるはずですよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "こういう話は、適当に社員を寄越せば済むだろう？　どうして直接お前が来たんだ？　代弁者ってやつはそんなに暇なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "ああ……どうか誤解なさらぬよう。別にわざわざあなたに会うために来たわけではありません。私はただ、試合のスケジュールを確認しに来ただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "どうも我々は気を抜き過ぎていたようでしてね……各ブロックでも少なからず問題が起きていますし、悪巧みをしている連中にも隙を見せてしまったようでして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……俺を脅そうというのか？　「合成樹脂」騎士シェブチックに、お前の汚い仕事に加担しろと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "滅相もございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "何が目的だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "実は、私には気になっている騎士が二名ほどおりまして、彼らにはいつでも出場できる状態でいてくれないと困るのです。しかし残念ながら、彼らのポイントはまだ充分ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "はっ……騎士の一人や二人を次の段階まで送るくらい、お前らならいくらでも方法はあるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "いえいえ。ルールに従い、陰から動くことも大事なのですよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "――ルールを破るのと、ルールを利用するのにはとても大きな差があります。根本的な違いは、それが可能か否かの力量の差です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "あなたさえ頷けば、ポイントを譲渡する追加試合や手続きはすべてこちらでご用意させていただきます。もちろんあなたが抱えている騎士団内部の問題にも、微力ながら手を貸しますよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "いかがでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "――おっと、故障か？　なんと「拍車」騎士の靴底にある加速装置が機能しなくなりました！　突然の減速に彼はゴールの手前で派手に転倒してしまったーーー！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "そして先頭の騎士がゴール！！　一位はグローリーフォール騎士団の「藤蔓」騎士！！　そして続く二位は……マリア・ニアール！　マリア・ニアールが今、到着致しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "生命線だった加速効果を失った「拍車」は、そのまま二位から七位まで落ちてしまいましたーー！！　残念すぎるぞ、「拍車」騎士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これで皆様もおわかりいただけたでしょう！　騎士にとって装備がどれほど重要なものか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "そこでエレンズチョイス社は、装備の日常メンテや修理、強化から管理まで、全面サポートいたします！　さらに会員限定の安心手軽なサブスクリプションコースもご用意！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ふぅ……二位か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（これで……メジャーにまた一歩近づいた……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（ゾフィアおばさん……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "おや、予想外のお客さんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "お好きな席にどうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "マーティン……本当にあんたなのか？　かつてあれほど多くの栄光を手にした「震鉄」騎士が、今やこんな小さなバーのマスターだとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "その「震鉄」はとっくに騎士の身分を剥奪されたよ。今は貯金でなんとか飯を食ってるただのジジイさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "「合成樹脂」騎士のシェブチック殿ともあろう方が、どうしてこんな寂れたバーに？　正直言うと、この店に来る現役の騎士なんてほとんどいないんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "この店を贔屓にしてるマリアは今や売れっ子だ。昨晩もこのバーがエンタメニュースで紹介されていたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "ふん、売れっ子……か。「レッドエーデルワイス」を一杯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "奢るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "光栄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ロアーガード社の訓練基地は結構遠いだろう。わざわざここまで足を運んでくれたからには、誠意を見せないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "さて。敗北を喫した相手の本拠地まで来たということは、メジャーで仇を取るための情報でも探る気かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……俺はメジャーには出場しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ほう……ロアーガード社の決定かい？　君はてっきりスポンサーとは仲良くやってると思っていたのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "はっ、仲良くだと？　企業とねんごろになるのは、天災と恋愛するようなものだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "もちろん、決めたのはさらに上の奴だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "騎士協会？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "いや……もっと上だろう。例えば、商業連合会とかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "うわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "言いたいことはわかっているぞ、マーティン。「一介の騎士である合成樹脂ごときが、そんな大事の中心になりえるか？」とでも思っているんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "俺はこれでも、分を弁えている方なんだよ。聞き分けのいい騎士のために連中がここまでするはずがない。つまり……問題は別の場所で起きている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "世間は今こんな噂で持ち切りだ。「耀騎士は感染していなかった、彼女がカジミエーシュから追放された理由は他にある」と……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "私は何も知らないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "そうピリピリするな……別に探りを入れているわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "俺はただ、貴族を弄ぶにはそれ相応の代価が必要になるという事を奴に――チャルニーに思い知らせたい……マリア・ニアールも奴の照準圏内にいるはずだ。そうだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……不満のある騎士を集めて協会に抗議でもするつもりか？　そんなことをしてもろくな目には遭わないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "俺は誰かの言いなりになりたくないだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "いい酒だった、礼を言う。マーティン、余計な一言かもしれないが……俺は若い頃、あんたの試合を観て、競技騎士になると決めたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ふっ……どうやら、道を誤ったようだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "いいや。俺はここから自分だけの道を切り拓いていくつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "またな、マーティン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "シェブチック、私からも一言……くれぐれも、気を付けるんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……ふん、ロアー騎士団なら、俺の考えに賛同してくれるさ。騎士が商売人に頭を下げる道理などあるわけがない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「焔尾」ソーナ",
      "text": "……ねぇ、ずっと後をつけてきてるみたいだけど、もうそろそろ顔を見せてくれてもいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「焔尾」ソーナ",
      "text": "うわっ！　ずいぶん荒っぽいわね……こういう危なっかしいファンは嫌いなんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「焔尾」ソーナ",
      "text": "「いや、待って――その弓――あなたはまさか！？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「焔尾」ソーナ",
      "text": "――なーんて、驚くと思った？　無冑盟の刺客さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「焔尾」ソーナ",
      "text": "ふうん……君たちってこういう感じだったんだ。いっつも陰でなんかやってるみたいだけど、君たちの姿を目視できた騎士は一人もいないらしいじゃない。気味の悪い話よねぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「焔尾」ソーナ",
      "text": "ま、せっかくの機会だし――いいわよね？　カイちゃん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "……ふん、しょうがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「焔尾」ソーナ",
      "text": "よーし、それじゃあ――正々堂々、勝負しよっか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あ、おばさ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "えっと……叔父さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "少し目を離したらこれだ……どうやら身の程も弁えられなくなったようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "いつ、手を引くつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "お前のことを何度も何度も上司から聞かれた。おかげで私は毎日、宣伝部でお前が起こした問題の火消しをしている……上司に状況を報告するだけで大半の勤務時間が削られるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "今すぐ騎士協会に行って棄権を申し込んできなさい。お前は自分が何をやっているのかわかっていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "でも、それじゃあ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "自ら火に飛び込もうとするな、マリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "お前もニアール家の子ならば、分は弁えられるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "メジャーに至るまでの、子供の喧嘩程度の遊びには目を瞑ってやったが、今のお前はいらぬ衆目を集め過ぎている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "本当に自分がメジャーに出場できると思うか？　これまでに戦ったライバルたち以上に強い選手はもういないとでも思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "でも、私はニアール家が貴族の名を剥奪されるところを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "そんなものはただの見栄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "言ったはずだぞ。ニアール家が、今の醜い騎士協会ごときに認めてもらう必要などない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "奴らが認めぬからといって、先祖の功績が消えてなくなるのか？　馬鹿馬鹿しい！　ニアール一族が築き上げてきた栄光は、他人の手で造られたものではない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "できないのなら、諦めるのだ。諦めを知らない人間が辿る先には……死しかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "叔父さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "マリア、お前はマーガレットの影響を受け過ぎたんだ。あいつは最後の最後まで己の愚かさに気付けなかった。そんなあいつを盲信してはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "なんだその目は、私は何か間違ったことを言ったか？　規則の中でその規則の主に勝てるとでも？　まったくもって馬鹿げた話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "マーガレットの性格は、お前もよく知っているはずだろう。あいつは商業化した騎士競技を軽蔑していた。あいつなら、少しは騎士の本分を理解してくれるかと思っていたのだが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "結局はどうだ？　「信念」とやらのために、やむを得ず騎士競技という道を選んだではないか。そうだ、「信念」だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "その「信念」で、あいつが何を変えられたというのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "叔父さん……お姉ちゃんのこと、そんな風に言わないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "何も変えられてなどいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "あいつが唯一変えたのは、ニアール家に対する企業の態度だった！　唯一の成果は、危篤状態の父上にまで尻拭いをさせたことだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "あいつに「耀騎士」の称号は相応しくない。あんな輩にその栄光を背負う資格などあるものか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "叔父さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "じゃあ、叔父さんはどうなの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "叔父さんだって……企業のために働いてるんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "私には競技騎士なんかになるなと言うくせに、企業に媚を売って、ニアール家が騎士の地位を剥奪されるのを、黙って見ているだけの自分が正しいって言うの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……フン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "お前はまだ未熟だ……その無知を責めるつもりはない。だが、目上の者の意見は尊重するのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "またそんなことを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "高層ビル群が落とす影は……カジミエーシュ人が何代もにわたって積み上げてきた努力の象徴だ。家で年長者の庇護を受けていただけのお前に何がわかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "お前のような駆け出しの若輩騎士が、何かを成し遂げられるとでも本気で思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "辺境では、ウルサス人の要塞にそびえ立つ高楼が、日の出と共に地平線の雲を突き破り、国境線にプレッシャーを掛け続けている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "競技場では、塔の侍従が貴族のご機嫌取りで気ままに戦う一方、若き蒸気騎士が年季の入った鎧を身に着け、同時に腕を磨いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "賞金稼ぎや盗賊どもが貧しい村を片っ端から襲い潰しているというのに、国は競技場を増やすことしか頭にない。村の収穫量と税金の比率は悪い冗談としか思えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "父上が病床で漏らした最後のため息がそれら全てを物語っていた。あれはマーガレットに対してでも、お前の両親に対してでもない――このカジミエーシュすべてに対する悲嘆だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "それでもお前は、私に失望するなと言うつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "だがマリア、さっきお前が言ったことは正しい。今の私は、何一つとして取り柄のない、企業に飼い馴らされている駄獣に過ぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "では改めて聞くが、お前はどうする？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "はい……主任！　いえ、現在ちょっとした私用の処理中でして……とんでもない、当然仕事を優先すべきです……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "プロジェクト会議？　今日ですか？　いえ、忘れていたわけでは……申し訳ございません！　誠に申し訳ございません……はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "すぐに参ります……え？　いえ、彼は私ほど今回のプロジェクトのスケジュールを把握しておりませんので……はい、すみません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "では、彼に代理出席させます……はい、大変申し訳ございません。二度とこういったことは……はい、これが最後だと誓います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "もしまた、このようなことがございましたら、私の職務を剥奪していただいて構いません。ええ、必ず……お約束します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "まことに申し訳ございません、主任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……マリア、これ以上時間を無駄にできん。返事を聞かせてくれ、今すぐにだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "私の考えは変わらないよ、叔父さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "お前もマーガレットと同じなのか……いちいち私の反感を買おうとする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "今のお前たちを、両親は誇りには思わないだろう。頭を冷やせ……そして己の立場をもう一度考え直すがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……もうそれ以上言わないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "身の程知らずが……せいぜい大怪我などせぬようにな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
