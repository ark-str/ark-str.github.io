  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "12:21 P.M.\nチェルノボーグ移動都市「エリア14」跡地\nエリアブロック"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "何をしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "スノーデビル小隊、どうして攻撃を止めたの？　何をゴソゴソやってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……瓦礫を掘り起こしてんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "源石の設置は完了しているんじゃないの？　どうして地面ごと崩壊させて、ロドスを一網打尽にしてしまわないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "冗談言うな、フロストノヴァの姐さんが下にいるんだぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "分かった。じゃあ私たちがロドスを始末するから、続けているといいわ。私たちはもうすぐ到着するから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "このエリアに来るな！　地面の基盤がもうボロボロになってんだ、訓練を受けていない部隊がここで戦えば、大崩壊を起こすだけだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "ロドスの討伐は優先事項よ。偉そうなことを言うのならさっさとやりなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "あれこれ急かすな……やるべきことはやるって。ちなみに、その優先事項ってのは誰が決めたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "最高戦略目標を鑑みれば当然のことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "じゃああんたらは、ウルサス人に私怨をぶつける時も戦略目標なんて考えてたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "頼むよ、こっちはなんとかするから。少し大目に見てくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "あなたたち、もしかして……ロドスと繋がってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "これはレユニオンへの重大な裏切りよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "（どうなってるの？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "（ひと悶着ありそうだな。流石に誤魔化せねぇ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "もしあんたらが、ちょっとロドスと話しただけで裏切りだって言うなら……そうだな、そういうことにしてもいいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "そんな状況判断しかできないから、ただの指示待ち集団になってんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "……スノーデビル！　何をするつもり！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "私たちの部隊の人数はあなたたちの何倍もいる。馬鹿なことは止めなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……いやいや、俺たちだってウルサスの常設軍と何度も戦ってきたんだよ。寄せ集めの奴らが何を偉そうに言ってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "待ってなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "（通信切断）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "てなわけでロドス、俺たちはあの道理のわからない馬鹿者たちを教育してやらなきゃいけねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "あんたらは手を出すなよ、内通者だとは思われたくないんでな。俺たちは休戦中だが、仲間って訳じゃねぇからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "えっ、内通者？　そんなの全部ひっくるめて何もなかったことにすればいいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "アーミヤちゃん、そうだよね？　もし後で廃都市で何があったか問われたら、ロドスとしてはどう返答する？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……「特に何もありません。私たちはスノーデビル小隊と交戦しただけで、他のレユニオンのことは知りません。」ですかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "さすが。お芝居なら得意中の得意だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "じゃあそれっぽい振る舞いをしつつ、混乱に乗じてここの人たちを全員始末する。これでどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "異論はない。そちらの隊長さんの考えは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの、何とお呼びすればいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……あっ、えーっと……お嬢さんはすごく可愛いが、俺とお嬢さんはまだ会ったばかりだし、その、心の準備がぁ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "準備じゃねぇよ！　馬鹿野郎が、なに考えてやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "すまんすまん！　いや、ほら、空気を和らげようと思ってな。じゃあスノーデビル1号とでも呼んでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ではスノーデビル1号さん……今の私たちには、お互いに助けなければいけない人がいる、そうですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "でしたら、一緒に救護の邪魔になる可能性のあるレユニオンを退けましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル1号",
      "text": "よし。力がみなぎってきたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……その元気はどこから来るのやら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
