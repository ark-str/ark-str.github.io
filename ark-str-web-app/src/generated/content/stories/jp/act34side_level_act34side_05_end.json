{
  "server": "jp",
  "storyId": "act34side_level_act34side_05_end",
  "groupId": "act34side",
  "stageId": "act34side_05",
  "title": "不治の運命",
  "storyCode": "BP-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act34side/level_act34side_05_end.txt",
  "sourceHash": "32c965e84f240a338dcedc6413aca886aa5a12b92059e5ad42f7464ea8f70c4d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "海巡隊か。俺を尋問しに来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "ハッ。「尋問」なんて言葉、俺には縁がないと思っていたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "研究所へ侵入する時に想像しておくべきだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "なら、それ以前だったら？　お前と俺の何が違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "どうしてここで尋問するのがお前なんだ？　なぜ俺は、尋問されなきゃならない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "私は時折、自分たちのやり方がぬるすぎると感じることがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "イベリア使節から聞いた話では、彼らは尋問の段階で刑罰を与えているそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "無駄口を叩くのに満足したなら、お前が何者か言え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "以前は街路用珊瑚を栽培していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "犯行の動機は何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "道端の珊瑚をきちんと観察したことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "俺たちはどの道に配置された珊瑚にも、違う形と色を持ち、ひいては異なる機能を担ってもらえたらと思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "闘智場の東側にある珊瑚の中には物流ケーブルが通っていてな。そのわずかな光に照らされて、珊瑚虫の一匹一匹がきらめくんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "まるで小さな星雲みたいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "そして、ポートターミナル周囲の――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "珊瑚なら、つい先ほどいくつも観察してきたところだ。お前たちが以前使っていた試験用の畑でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "その場所で、ある罪のないデータエンジニアが死んだんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "彼女の理想も、執念も、彼女の愛した藻類も……お前の言う珊瑚と同じように美しかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "だがお前たちは、そんな彼女を殺した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "先ほどの質問はもっともだ。ゆえに聞こう――お前と彼女の何が違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "どうしてここで生きているのがお前なんだ？　なぜ彼女は、殺されねばならなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "それは彼女が気付い……あ、いや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "なぜそこで黙る？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "あるいは、この質問はカシアにするべきか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "お前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "深海教会は航路計画にどんな小細工を仕掛けたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "お前たちの目的はビーコンか？　それとも兵器か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "吐け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "はぁ、深海教会だの、深海教徒だの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "そう呼ばれるのは慣れないな。まるで馴染みのない名前だ。それはお前ら海巡隊が、誰かを捕まえるのに都合がいいからつけたものなんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "その教会だとか、教徒だとかいう言葉のどこに神聖性があるというんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "俺はそんな曖昧な存在を崇拝しているわけじゃない。ただ、カシアの考え方に賛同しただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "エーギルに広がる絶望の中に、彼女はこの国の弱さを見た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "人々は物事の価値を重視しているにもかかわらず、そうした価値がどれほど脆く変わりやすいものかを認めようとしない。彼らは、既定の価値の忠実なる信徒となってしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "だが今、そうした価値が崩れつつある。エーギルが完全な絶望へと陥る前に、誰かが警鐘を鳴らさなければ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "*エーギル感嘆詞*！　お前、カマをかけたな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した「研究員」",
      "text": "これ以上は話さんぞ。結果を急くなら俺の脳波を解析すればいい。どうせ大した手間では――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "クズが！　質問という形式をとるのは、人として最低限お前を尊重してのことだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "お前が自分を無実と思おうと、己の行いを陰謀ではないと思おうと好きにするがいい。だが、その情報は一つ残らず吐いてもらうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "さあ、言え。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "第二隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "スカジ、もうすぐ出発の時間よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "急を要する事態なのはわかってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "前線の兵力は、シーボーンとの均衡を保つのがやっと。二個艦隊が全滅したことで、現状の戦力差は明白よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "今入ってきた情報では、第八、第十軍団が幾度か陣形変更を試みたけれど、いずれも成功せず、苦戦を強いられていると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "このまま、巣穴の指定位置にビーコンを投下できずに睨み合いが続けば……航路計画は失敗に終わるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ええ、わかってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "軍団の艦隊はもうじき、犠牲をいとわず総攻撃を仕掛け、シーボーンの注意を惹きつけるでしょう。私たちは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "戦場の死角へ切り込んで、巣穴の奥深くに入り、ビーコンを投下しないといけない。そうよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そうよ。それで、あなたの状態はどうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ひとまず、さっきはよく眠れたわ。あの戦い以来、夢も見ないような眠りなんて初めてだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "都市内の現状は、ますます穏やかでなくなっているけれど……ドクターの行方は知っていて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "でも、第二隊長が何を言いたいのかはわかるわ。私に秩序の維持やドクターの保護を命じて……どうあれ、このまま都市に残らせたいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "正直に言うと、迷っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "海のゴミを掃除するのがアビサルハンターとしての務めだけれど、私にはあなたたちを守る責任もあるのだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "スカジ。海に戻ったあと、イシャームラに目覚めの兆しは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "アレがいるにしては静かすぎると思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "まあ、何か言ってきても黙らせるだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "第二隊長。実はあなたに話があって来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私たち、こんなに慎重に行動したことはないわよね。事が起きたとしても、対処法はわかってるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もし、深海教徒の言う神が、あのゴミどもの言う「イシャームラ」が本当に私の身体の中にいて、私を暴走させることがあれば、その場で私を殺せばいい。それだけのことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私の心臓はここよ。あなたならヘマはしないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "スカジ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "話はまだ終わりじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もしあなたか、あるいはサメが、戦闘中に私よりも早くあのゴミどもの影響を受けることがあれば、私も情けはかけない。……それだけよ。言葉を遮ってごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "私が言おうとしていたのは、大きな戦いを前にした今、その言葉よりも安心できるものなどないということよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "行きましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ローレンティーナさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "さん付けされると悲しくなるわ。私たちって、もっと仲良しだったわよね？　小鳥ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "……ローレンティーナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "エーギルの都市に来てからしばらく経ってるのに、やっと会えたのが今だなんて、すっごく悲しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "勇敢な戦士たちを連れて、深海で本当の狩りをするところ、ずっと見せてあげたいと思ってたの。でも、今回ばかりは巣穴が遠くて深すぎるところにあるから、連れて行ってあげられないのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "そうでなくても私は今、ミリアリウムに留まるべきなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "へえ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "ここのところ、この都市では色々なことが起きてるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "私は、深海潜水装置をつけて海に入ってみたりもしたけど、結局流されてしまって……だから今の私じゃ、ついて行っても足手まといになるってことを認めないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "そんなに卑屈にならなくていいのよ。最初は誰だって苦戦するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "とにかく、私は巣穴に行くよりも、都市に居たほうが役に立てると思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "それにあなたたちの任務が終わったら、エーギルの兵器システムがこの海域を掃除し始めるでしょ。そうなれば海の変化に対処するために、なるべく早くカルメン閣下の下へ戻らないといけないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ああ、つまりはもうしばらくのお別れってことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "そうなるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "本当なら何か選別を渡したいところだけど、ミリアリウムに来る前はこんな状況になると思っていなかったから、何も準備してなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "気にしないで、また会えるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "今回は、死にかけのあなたを海から引き上げなくてもよさそうだけど。この戦いのあとの再会は、あの時とはまた別の意味で忘れられないものになると思うわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "こほんっ！　……スカジたちが来たわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "気をつけてね、ローレンティーナ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "そっちの話は終わったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "出発するわよ、狩人たち。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "ドクター。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "どうやら求めていた証拠を手に入れたらしいな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ああ。世話になったな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それで、結論は？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "何を見つけたか、共有してくれないか？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "先にも告げた通り、今も都市内にあるビーコンと、シーボーンの巣穴に投下済みのビーコンとの間に、異常な交信の痕跡が見られた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "そして今回得た情報を参照するに、その操作はほとんどC-22研究所、つまり俺たちが先ほど潜入した場所で行われている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "俺はビーコンシステムと第Ⅳ級兵器の原理を完全に理解しているわけではないが、この通信内容から概ね推測はできる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ビーコンと兵器の連携システムが書き換えられているようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "見立て通り、航路計画の上層部には内通者がいる。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "「見立て通り」か。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "初めから航路計画に疑念を抱いていたのか？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "そうだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "厳密には、この計画が生まれる前から、俺はエーギルに疑念を抱いていた。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "その疑念は何に由来している？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "……あの戦争を決定づけた戦いだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "本来「ファーストボーン」を仕留めるのは君だった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "だが肝心な時に、部隊と連絡が取れなくなった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "結果、その重責はスカジに託された。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "……すでに知っていたか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "スカジは思った以上にお前を信頼しているようだな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼女の話から当時の状況を推測するのは難しくない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "スカジは、実際何が起きたのかをよくわかっていない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "俺の失態は一瞬の油断によるものだった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "イシャームラの核心部である器官に最も近い洞窟、あるいは奴の身体の中で、俺は有り得べからざるものを見た。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ざらりとした肉質層に濁った粘液、最初は身体の結節部だと思っていた。周囲の目盛りと模様をはっきりと見るまではな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "それは、腐食した水脈探知機だったんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "……エーギル製の、な。数百年前作られていた、今では博物館にしか置いていないような代物だ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "数百年前？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "変質の度合いから見て、少なくとも二百年はイシャームラの体内にあったのだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "だが、当時俺が得ていた情報では、俺たち以前に「ファーストボーン」の本体と接触した者は、エーギルにはいないはずだった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "つまり、シーボーンという生物がエーギルに認識されるより前に、「ファーストボーン」と接触した人物がいたにもかかわらず、エーギルはそれを知らなかったということだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "エーギルの穏やかな水面の下にある暗流は、誰が思うよりも激しいものだったんだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君が証拠を確保している間に、こちらも異常を発見した。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "狩人たちは目覚めるなり、急いで去っていったんだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "前線の膠着状態を打破するために投入されたのだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "何らかの任務を割り当てられていることは想像に難くない――戦線を迂回し、巣穴へ潜り込み、ビーコンを投下するんだな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "補助要員から作戦の中核へ移されるのが早すぎる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "加えて、あの顧問が狩人たちより焦っていた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼女たちが目覚めるなり、彼はすぐさま研究所を離れた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ブランドゥスか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ならば、我々も急ぐべきだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ビーコンと武器の連携システムが何者かに書き換えられた以上、向かうべき場所はただ一つ。航路計画の中心を担う、ビーコンの発射サイロだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "そしてお前は……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "狩人たちに命令を出した人物に会いに行く。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "クレメンティア……執政官。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
