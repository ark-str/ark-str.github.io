{
  "server": "jp",
  "storyId": "main_11_level_main_11-05_beg",
  "groupId": "main_11",
  "stageId": "main_11-05",
  "title": "文明の変遷",
  "storyCode": "11-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_11-05_beg.txt",
  "sourceHash": "5ae471f3a8943fdaf8d701afef564c5b6a5aa5ca797c1c6370f96c4d25adfdb5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "どういったご用でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "先ほど言ったように、ただ劇を見に来ただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "……みんな、私の後ろへ来なさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "レト中佐、失礼ですが、この場所はあなたを歓迎しません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "そう冷たくせずともよいだろう、ゴールディング。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "君の努力は認めてきた。困難な時代であるほど、教育の重要性は強調されるべきである。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "中佐さん、その言い方は、自分がこの「困難な時代」とは無関係であるかのように聞こえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "どんな時代から見ても、あなたの身なりは立派なものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "胸の勲章もどんどん増えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "軍事委員会に協力して、ロンディニウムを管理することは容易いことではないよ。私とて多くの……困難に直面している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ではあるがね。この都市に対する私の愛は変わったことがない。この点に関して、私は君たちと同じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "靴屋のトムは、きっと賛同してくれるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "トムは私の友人でもある。あのようなことが起こるのは、私とて不本意だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "彼はただ酒に酔って、「陛下」や「蒸気騎士」と呟いただけです。彼は「サルカズ」の綴りすらわからないのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "彼はまだ生きている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私たちが存在している意味は、ただ生きるだけではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私がヴィクトリアに対する逆徒だと非難したいのかね、ゴールディング？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "レディ、君たちの勇気は尊敬に値する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "だが誤解している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私が本日ここに足を運んだのは、またこの学校を見たくなったからという、それだけなのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "モリーさん、残念だよ、どうやら君は私のことを忘れてしまったようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "……忘れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私がここで過ごした時間は、君に負けないくらい長いのだ。君や君と一緒にやってきたあの子供たちのことも、私は覚えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "だが残念ながら、軍事学校を卒業してから、あまり暇な時間がなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ゴールディング、君はかつて私を信頼してくれていたな。私たちはよくガリアの歴史について語り、不朽の文学について話し合ったではないか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "もうやめてください、レト中佐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "あなたの父上にはとても感謝しています。彼は長年にわたりこの学校に資金援助をしてくださいました。子供たちのために知恵のトーチを灯し、蒙昧と無知を追い払おうとしてされていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私はかつて、あなたも彼と同じだと思っていました……しかしあなたは、そのかすかな火を自らの手で消したのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "そうかね？　ではゴールディング、この学校がどうして今日まで存続できていると思っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "あなた――私たちを脅すつもりですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私には君たちを脅す理由も動機もない、子供たちが見ているしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ゴールディング、私たちは共にガリアの遺民だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "戦争は最も無情な破壊者であると、君も私も理解しているはずだ。幾千万もの命を奪い去るほかに、知識の探求のために人々が行う一切の努力を無意味にする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私は、このロンディニウムが第二のリンゴネスになるのを見たくないのだ。同時に、先ほど見た素晴らしい劇が、このまま途絶えるのも見たくはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "これが、私の自らの選択に対する責任だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……あなたの考えに賛同することはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "リンゴネスのロイヤルオペラハウスはすでに灰と化しても、『凱旋の讃歌』はいまだ各地で繰り返し演じられています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "たとえ建物が倒れようと、巨大な建築物が崩れようと、私たちがその中に集めた結晶が滅びることは永遠にない。それが私たちの教育であり、私たちの文化でもあり、そして私たちの希望なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "戦争の暗雲が濃くなるほど、私たちはより固い信念を持たねばなりません。美しいものを信じることで、自分は人間であって、獣とは違うのだと言い聞かせるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "君は、文明が暴力に敵うとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "あなたたちが体現しているもの、つまり恐怖や権力、殺戮が……全ての人を飼い慣らすことは永遠にありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私は、そう信じなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……私は信じるほかないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "光さえあれば、私たちは光に向かって歩んでいくと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "君が羨ましいよ、ゴールディング。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "頭上を覆う暗雲を見よ、嵐はまもなくやってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "雷が落ちるまで、我々にはまだ時間がある。互いにまだ選択の余地があるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "いつか……この劇の終幕が見られることを願っているよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そうして学校を発ったあと、都市防衛軍の指揮官が街に留まることはなかった。\n彼は確かに一人でやってきており、都市防衛軍の兵も付近には来ていない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女はアダムスを探し、情報を伝えなければならなかった。\nどれだけ敵意がないように見えても、あの指揮官殿が何の理由もなしに学校に来るはずがない。\nモリーにも、子供たちにもわからない。しかし、ゴールディングは彼がなぜやってきたのか理解していた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "どうして急にサルカズがこんなにたくさん？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "本屋への道はよく知るものだった。彼女は、ここ二年余りで幾度となく通ってきた。\nしかし今日のこの道は終わりが見えないほどに長い。サルカズが都市へ入り込んできたあの日を、彼女はまた思い出したのだった。\n彼女は本当に変えることができるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私は信じなければならない、私は……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ゴールディングは、突如恐怖に喉が絞めつけられるのを感じた。\n危うく吐き出しそうになり、彼女は身を翻して逃げ去る。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ランス、パティ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "あの子たち……！　ラン――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "うっ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……このような簡単な任務は、閣下のお手を煩わせるに値しないかと思われますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "だったらさぁ、君はゴールディングを捕まえるべきじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "マンフレッドならそうするよ。赤目の老いぼれなら、学校にいる奴一人残らず殺してただろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "まあいいけどね、君がサルカズじゃないのはわかってるし。君は自分にも、都市防衛軍にも、この都市の住民にも、多少の尊厳は残しときたいんでしょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "でも、僕たちはそっちの方が確実だと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "ランス、パティ……子供たちは無事でしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "中佐さん、私は怖いんです。あなたのような人やサルカズが子供たちを傷つけないか……子供たちがあなたのような人になってしまわないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……あなたの口調は、こちらの意識を失った女性とそっくりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "うん……僕たちは感じます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "彼女は幼いヴィクトリア人たちのことを自分よりも心配なんです。僕たちは感じることができますが、理解はできません。特にこういう血縁に基づかないものに関しては。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……閣下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "僕たちは、あなたたちに興味があります。あなたたちを通じて、僕たちは自分を……サルカズをもっと理解できるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "あなたは我々から答えを探しているのですか？　一体……どんな答えを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "レト、あなたはサルカズに興味を抱くような人ではないはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "申し訳ございません、閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "任務を優先しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "こちらのモリーさんを連れて帰ってください。ちゃんと見張っておくように。僕たちは、ゴールディングさんのそばに残ります。これからの戦争に向けてより多くの情報を得たいので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "わかりました、閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "どうされました、閣下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "僕たちに気付いた者がいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "兵をこちらへ寄越しますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "必要ありません。兵士ではその方を止めることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "彼はテレジアからたくさんのことを学んでいます。僕たちもすぐに……気軽におしゃべりすることになるでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……モリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私が出ている間、何も起きていませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "何もありませんでしたよ。ランスとパティが怯えて震えていましたのですが、ラルフたちが小さい子たちを連れて休ませに行ってくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "ならよかったです。子供たちは……こういった劇を気に入ってくれているはずですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私たちの努力には意味がありますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "何を言ってるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "いえ……何でもないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "あの防衛軍の指揮官の話なら、気にする必要はありませんよ、ゴールディングさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "少し気分が優れないので、休んでもいいですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "すみません、モリー、ここの片づけはお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "大丈夫ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "この劇には終わりが必要です、蒸気騎士はすでに王宮の門まで来たんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "また数日後には、子供たちが最後の一幕を演じるんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……必ず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "物語の終わりが演じられない限り、そこには様々な可能性が存在することになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "でもすでに演じられた劇が、変えられないとは限りません。人々は常により最新版を見たがるものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "……あなたはそばでずっと見ていたのですね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "舞台がまだありますし、私たちで最初から演じてみましょうか？　第一幕から。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "誰もが幻想を抱くものである。もしも、何もかもが起きていない道であれば、そこはどのようであったかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だが臆測に、意味はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "しかし、もしわずかな可能性であるなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "そちらのお方、お暇なら、劇に加わりませんか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "おはようございます、閣下！　浮かない顔をされていますが、閣下にそのようなお顔をさせているものとは一体？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "おぉ、勝利の角笛は城壁の上で、すでに三日三晩鳴り響いているというのに、なぜ私の心はこれほどまで焦燥に灼かれているのであろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "我らの偉大なる将軍様は、とうに凱旋されたではありませんか？　彼の勇敢さと恐れを知らぬ精神を称えましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "勇敢さ？　恐れを知らぬ精神とな？　そうかもしれぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "一度の過激な号令が、我らの信念を一つにしたのだ。しかしながらその代償は、目の前に迫る破滅と憎しみである。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "あなたは本来、君主に仕えるべきなのです、にもかかわらず、逆賊に忠誠を捧げました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "舞台の上、謎の観客が一歩前へ進み、その視線を目の前の人物から遠くへ移した。\n彼は、感情を練り上げてはいない。むしろ、とうに埃に埋もれた別の戦場の過去を整理している。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "私が付き従うのは君主ではなく、実直と、勇気である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "これ以上進めば、あなたを迎えるのは破滅のみです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "この国が暴君によって破滅に導かれる過程に、生きながら立ち会う方が、個人が滅びることよりはるかに恐ろしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "どうしてこの国の結末がわかるのです、閣下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "私にはこの国の結末が予見できるのだ。この国のこれまでを知っているように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "嘘です！　あなたはまだ年若い、どうして過去を懐かしむような物言いができるのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "太陽が永遠に沈まぬようにできる者がいるか？　その欲望が生まれること自体が最大の貪欲なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "この壮大な輝きを維持するための狂った行いを、私は数えきれないほど見てきた。彼らはあるいは強盗になり、あるいは互いに争い、ついにはただこの国の腐敗を早めるのみ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「モリー」は舞台上で身を翻し、数歩ゆっくりと歩いてから振り返ると、その表情を照明の下の陰に隠した。\nしかし、先に口を開いたのはもう一人の演者だった。彼は波一つない水面のように落ち着いており、手首をわずかに回すと、体の前で両手を重ねた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "彼らは認めたくはなかった。落ちていく者が日の光をつかもうとしても、手に握っているのは稲光でしかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "人々は落ちるのに身を任せるしかないというのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "人々は山の頂を振り返らないという選択もできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "もし自らの視線を移したのならば、目の前の深淵は深淵でなく、無限の可能性をはらんだ沃土であることに気付くだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「モリ―」",
      "text": "深淵に打ち勝てるのですか？　あなたには深淵の真相がわかっていません。時間が差し迫っていることを、わかっていないのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「謎の観客」",
      "text": "深淵が目の前にあるのならば、我らは肉体によって深淵を埋め、鮮血でもって瓦礫を焼き尽くし、後世の者たちに広々した野原を残してやろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
