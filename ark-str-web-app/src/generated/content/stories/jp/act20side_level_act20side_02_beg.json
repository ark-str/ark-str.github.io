{
  "server": "jp",
  "storyId": "act20side_level_act20side_02_beg",
  "groupId": "act20side",
  "stageId": "act20side_02",
  "title": "落下",
  "storyCode": "IC-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act20side/level_act20side_02_beg.txt",
  "sourceHash": "de48e5e57cae1449426d869eb7694cfa7efd1634c33b748c683377aa6fa3f4c8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "よく言うじゃねぇか、ほら……なんつったかな？　いつもブレイズが言ってる言葉──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "直線距離で行くのが一番早い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そうそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "わしに大胆な考えがあるんじゃが。お前さんたち密林の民は、ここに生まれたこと自体がすでに充分不運じゃからこそ、他の面では格段に運が良いのではなかろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "そうでなければ、これまで絶滅せんかったのはなぜなんじゃ？　全く道理が合わんぞい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "まあこういうやり方が、効果的な生存戦略だったってことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいや、ドゥリンの都市とはどういった所なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "うーむ……覚えておらん。つまり退屈だったんじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "およそ百年程前、わしはその地下都市にしばらくおったんじゃが、唯一思い出せるのは、だいぶん酷い場所だったということだけじゃの。そこら中、愚か者ばかりじゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "川辺で寝ているオリジムシを見ておった方が、よっぽど愉快じゃろうの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "じゃが、うむ、そうじゃのう、若者は色々な経験をすべきじゃ。好奇心旺盛であってこそじゃぞ！　わしのようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ちなみに、次の分かれ道は左じゃ。飛び降りてはならんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいや、私たちはどれだけ進んだんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "良い質問じゃな。人生の道に終わりはない、ただ一心に前へと足を踏み出して進むのみじゃ。安心せい、わしのような年寄りがお前さんたちを見守っておるでな、細かいことは気にせんでいいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "おっと、あの都市まであとどのくらいかという話ならの。わしのように石の隙間を通り抜けられるのであれば、あと五、六百メートル下に真っ直ぐ落ちれば着くじゃろうて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "こいつ、やかまし過ぎんだろ。ズゥママ、お前よく今まで我慢してこれたな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "機械と一緒にいる時は少しだけ静かなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "このチェーンソーは機械のうちに入るか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "フンッ！　失敬な！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ほら、効いただろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ここが……これが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えっと、「どでかい水たまり」ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……この際、ドゥリン族のネーミングセンスには突っ込まないでおきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "遠くから見てもものすごいウォーターパークだったけど、近くで見るともっとびっくりするわね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ドゥリン人は、普段一体どんな生活を送っているのかしら！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ヒャッホー！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あいつ、いつの間に水着に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "エ、エリジウムさん、気を付けてくださいね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "うおっ、危ない！　君大丈夫？　お酒はこぼれちゃってないかい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの青年",
      "text": "……珍しいな、どうしてここに地上人がいるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの青年",
      "text": "それに、もうドゥリン人と同じくらい楽しくなっちゃってるみたいだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "こんにちは、私たちはスディチ・ブランクキャンバスの招待を受けてやってきたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "スディチさんは、スディチさんは……とにかく、彼は私たちに何かお手伝いをしてほしいみたいなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの青年",
      "text": "スディチ・ブランクキャンバスか……帰ってきてたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの青年",
      "text": "てっきり彼が尊敬する師匠と同じように、この都市とおさらばしたもんだと思ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの青年",
      "text": "本当は君たちにようこそと言いたいんだ。ドゥリン人は友好的だからね。だけど、スディチみたいにドゥリンのルールを無視して好き勝手に振る舞うことは、僕にはできないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの青年",
      "text": "自己紹介をしよう。僕はキャッチ・ライトレース、この都市のデザイナー代表だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "そんなに緊張しなくていいよ、すぐに終わるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "えっと……これはどういうつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "あれぇ？　なんか雰囲気がおかしくなってない？　こんなにたくさんの人から同時に乾杯されても困っちゃうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あなたたち……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "攻撃をするつもりですか？　あなたたちみたいな小人さんなんか、怖くありませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさん直伝の戦闘スキルを見せてあげます！　ふぅ……背筋を伸ばし、腰に力を入れて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "いざっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "取り乱すドゥリン人",
      "text": "あ、あの人何してるの！？　棒で殴りかかるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張するドゥリン人",
      "text": "うわあああああ！　こっち来るなああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ちょっとちょっと！　君たち何してるの！　ストップストップ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "え？　戦うんじゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "僕たちはそんな野蛮じゃないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "早く武器をしまって、ついてきて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "コホンッ！　ゼルウェルツァ市民のみんな、今期第四百十七回目の採決を始めるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "前々回は今月のBGMを決定して、前回は今週の街灯の色を決定したけど、また新たな問題が発生したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "この問題はものすごく重要だというわけではないから、この場にいる人数で充分ゼルウェルツァを代表する決定が可能だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "さて今日の議題は、ゼルウェルツァにやって来た新たな訪問者を、僕たちは受け入れるべきかということについてだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "その訪問者はどこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "お酒を飲まないって言ってた人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "えーっと、そうじゃなくて、僕たちの目の前にいる──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "お兄さん、乾杯！　ていうか、お酒を飲まないドゥリンなんかいるはずないよねぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "乾杯！　そうだよ、そんなのおかしいよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "これ飲み終わったら、水遊びに行くわよ〜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "はっ！　君たちに見せてあげるよ、僕たち地上人の実力をね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "トミミ、もう一回訊くけど、あんたロドスでの生活は本当に問題ないのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "は、はい、多分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "もしダメだと思ったら帰ってきなさいよ。劣悪な環境が人に与える悪影響を甘く見ちゃダメ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "キャッチ、早くしてよ！　私たちまだやらなきゃいけない大事なことがたくさんあるんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "お兄さん、サーフィンって遊びは聞いたことある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "サーフィン？　よーく知ってるよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "俺は反対だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こいつらは信用できない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "はぁ、そう簡単にはいかないだろうと思ってたわ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "おい、そこの酔っぱらったリーベリ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "呼ばれてるよ、イナムさん。僕は酔ってないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "お前だよ、手にグラス持ってるお前！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "おっと。やっぱり僕？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "高貴なミードが好きなのか、それとも低俗なスピリッツの方が好きなのかハッキリしろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "俺たちカールミード愛好家協会は両手を広げてお前を歓迎しようとしてるのに、何でそのスピリッツのカスどもと一緒にいるんだ？　失望したぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "さっきは肩を抱き合って共にミード万歳と叫んでただろう！　すぐロクデナシどもとつるみやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "あっ、いや、どっちも本当に美味しくてさ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "ダメだ！　俺たちはどっちつかずのヤツは歓迎しないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "ハッ、笑っちゃうわね。比較してみなけりゃどっちが良いかなんてわからないじゃないの。そうよね、お兄さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "怖がらなくてもいいわ、あなたの本当の気持ちを話せばいいのよ。偉大なスピリッツに対するあなたの感想を話してごらんなさい、もしまだこのゼルウェルツァにいたいならね──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "おい、スピリッツのカス！　そいつを脅してんじゃねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "チッ、ミードのバカ！　あんたたちはそのお子ちゃまドリンクでも飲んでなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朦朧としたドゥリン",
      "text": "そんなに自信があるっていうなら、今夜バー・ジャイアントバレルで決着つけようじゃねぇか！　逃げるなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "ハハッ、どっちがお子ちゃまドリンクをより多く飲めるかって？　どうせやるならもっと面白いのにしましょうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "待て、ストップ！　まんまる広場での採決は、厳粛で神聖なものなんだ！　お酒の話は後にしてくれるかな──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "みんな手を挙げて自分の立場をはっきり表明してね。少数派は多数派に従う、これがゼルウェルツァの原則だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ではこれより、決を採るよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "おい、お前が挙げるなら俺は挙げないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "勝手にすれば？　私は挙げますよーだ、バーカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ふらふらなドゥリン人",
      "text": "あとで滑り台で待ってろよ、そのツラに水ぶっかけてやるからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千鳥足のドゥリン人",
      "text": "あんたにできるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "うん。いいね、とても厳粛な採決だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "この状況を厳粛って呼べるのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "計算が終わったよ、結果は明らかだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ゼルウェルツァ市民の決定は、「好きなだけ楽しんで」だってさ、地上人さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン人たち",
      "text": "カンパーイ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ついでにもう一つ、僕は建築デザイナーなんだけど、湖の上にある大きくて派手な建築物は僕の自信作なんだ。思う存分遊んでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あの「どでかい水たまり」のこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "……名前は僕が付けたんじゃないよ、みんなが採決で決めたんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "あの「どでかい水たまり」……また色々と増築されたのか？　オレがここを離れた時よりひどくなってるみたいだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "あれはキャッチ坊ご自慢の傑作なんだ。あいつの前でそんなことは言うなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "あんなもの、オレがデザイン上の欠陥を指摘してやる価値もない。というより、手の施しようがないね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "あのねじ曲がった構造……一眼見ただけで倒れそうだよ！　どうしてゼルウェルツァの連中はあいつがデザイナー代表をやってることに耐えられるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "あの巨大滑り台が楽しいからだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "もしオレが作るなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "お前なら、直線だけで構成されたコンクリート打ちっぱなしの……そう、キューブ状にでもするのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "やっぱオレをあんま理解してないね、エッジじい。オレだったらただあそこに細長いコンクリートの帯を置くだけだよ。シンプルさこそが究極の美だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "えーっと、滑り台の機能すらないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "少しくらいなら角度をつけてやってもいいけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ゴホンッ、本題に戻るぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "このドームは見た目こそさしたる問題はないが、私は不安なんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "半年ちょっと前の地震でドームが漏水し始めてから、水の漏れる量がどんどん増えてるんだ。これがさしたる問題じゃないって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "少なくとも市民はそう思ってる。水量が増えた？　急流滑りがもっと爽快になるぞ！　温度管理システムが壊れたって？　なら夏はまだ終わってないってことだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "源石探知システムについては……どうせゼルウェルツァ付近では、もう二十年以上活性源石層を検出していないんだから関係ない！　というふうにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "フンッ、短絡思考め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "だったらお前が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "嫌だよ。なんでオレがあのボロドームの改修をやらなきゃいけないんだ。もう百万回は言ったろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "あの時お前が地上に逃げたのは、何とかしようとしたからではないのか？　実現可能なドーム改修計画を立てるというような──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "違うね、オレはアンタから逃げたかったんだよ。小煩いじいさんはうんざりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "それは少々ひどすぎないか？　私は数ヶ月前に、「ゼルウェルツァで一番親切なご老人」トップ100に選ばれたというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "はいはい、茶番はもういいよ。アンタが心配しているドームのことだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "キャッチがドームの強度問題すら解決できないなら、デザイナー代表の立場返上なんてものじゃないよ。すぐにゼルウェルツァから出てった方がいいくらいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "結果から言えば、ドームの安全問題については、まだ心配する必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "温度管理システムは放っとけばいい。市民たちは存分に楽しんでるみたいだし、みんなが飽きたら、採決をとって冬に変えられる可能性もあるわけだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "あと源石観測システム。アンタがオレにずっとつきまとってるのはあれが一番心配だからでしょ？　オレに言わせれば、そもそもあれは信頼性が低い。そこでオレに新しい計画がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "前の地震で壊れた鉄道橋を修理して、崩れたトンネルを復旧させるんだよ。あそこに源石探知の計器を直接設置した方が、より正確な測定値が得られるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "元々、このドームの機能は複雑すぎるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "随分と面倒な真似をするな……そこまであのドームに対処したくないのか？　いくらヴィンチが何も告げずに去ったとはいえ、あれはお前たち師弟の──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ストップ。その話はやめろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "エッジじい、オレを怒らせないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "今は、源石観測の問題解決が先だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "地上から何人か使えそうなのを連れてきた。彼らのガラクタいじりの技術なら、ゼルウェルツァの鉄道修理には充分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "その次は──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "話の腰を折ってすまんが、お前が言っているその使えそうな地上人とは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "あっちの空を飛んでる人たちのことではあるまいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "イヤッホーッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんたとズゥママやクマールがロドスに入った時は何も思わなかったけど、今のこいつの姿を見てると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "トミミ、正直に話してちょうだい。ロドスって甘っちょろい職場で簡単にお給料がもらえるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ああ見えて、エリジウムさんは、実はプロのガイドで通信の専門家で……えーと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えーと？　はい、彼はいつもあんな感じです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの物売り",
      "text": "お待ちどうさん、あまあま果実酒だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "えーっと、お金はどう払えばいいのかしら？　ていうかあんたたちこれまでどうやって買い物してたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "仕立屋のおばあさんにガヴィルさんの武勇伝を聞かせてあげたら、大喜びしてタダで服をくれたんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕の場合……お酒は愛好家協会の人たちが払ってくれたよ。で、食べ物はスディチくんのツケにしてもらった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……あんた、どこに放り出されても生きていけそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "これこそプロのガイドたるゆえんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "それじゃあ、このお酒二杯もスディチのツケにしておいてもらえるかしら。きっと少し増えても気にしないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの物売り",
      "text": "りょうか〜い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ハハッ、いやいや、あいつは実はとってもケチだよ。そのお酒は歓迎の印ってことで僕が持とう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ここは僕の自慢の遊園地なわけだし、みんなには思う存分楽しんでもらいたいしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "キャッチさんはスディチさんと親しいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "それは君の「親しい」の定義次第だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "僕たちは若い頃、お互いに勝つためにずっと競ってたんだ。彼とはいくつものコンペで戦ったよ。僕が勝つこともあれば、彼が勝つこともあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "だけど唯一、僕たちの頭上にあるこのドームだけは、どちらも勝ち得ることができなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "僕たちはゼルウェルツァのシンボルであるこのドームの改善案をいくつも考えていた。毎日顔をつき合わせてた時期もあるくらいだ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "僕たちは自分の改善案の方がより優れているということを、多数決大会で証明しようとしたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "でも結局、二人ともゼルウェルツァの人たちの過半数を納得させることはできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "このドームはね、ヴィンチ先生──先代設計代表が手掛けた作品なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "そしてスディチは、彼の教え子であり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ま、僕から話すことじゃないね。あとは彼に聞いてみてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "キャッチくんさ、君はまだ幼いのに、どうして年寄りみたいに「若い頃」なんて言うんだい？　それはあんまり感心しないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ほら、このエリジウムお兄さんを見習いなよ。純粋な心で、笑顔で人生に向き合うんだ！　昔を嘆くよりも、僕たちと一緒に美味しいお酒を心ゆくまで飲んで──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの物売り",
      "text": "リーベリのお兄さん、お待ちどう！　ご注文の品「暑さも吹っ飛ぶ冷え冷え特大ジョッキビール」だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "みんな、遠慮はいらないよ！　こんなにも親切なキャッチくんが楽しんでほしいって言ってるんだ。その好意を無下にできないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ところで──キャッチくん、もうちょっと追加でお酒を頼んでもいいかな？　例の愛好家協会の人たちが払ってくれない別のも、全部試してみたくってさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "君、本当は竹馬に乗ったドゥリン人とかじゃないよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……他に考えなければならないキャッチコピーはあったかしら？\nありましたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「ロングリーフデュードロップの喉越しをどう表現しよう？　どうすればありきたりな褒め言葉にならずに済む？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「雲の欠片を口にできたら。春の雨を喉に流し込めたら。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「冬の最後の雪が舞い落ちるのを感じ取れたなら……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "違うわね。彼らは恐らく冬の雪を理解できないでしょうから、ドゥリンらしい比喩を使ってみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「超クールでフルーティーな氷が二つ、バカうまいカクテルの入った大きなグラスの中に落ち──」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "うっ、痛ってぇ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "今回は飛び降りるべきじゃなかったな。まさか大祭司の言ってたことが本当だとは思わなかったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "この骨が砕けそうな感覚は随分久しぶりだ。前にお前とやり合って以来だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ホントだぜ。アタシなんか幻聴までしてきたぞ。フルーティーな氷とかカクテルがどうとかって……まさか飛び降りた後遺症か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あん？　なんでこんなとこにループスが寝てんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "もしかして……私たちのせいなんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "……マジか？　なら、治療してやった方がいいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "救急箱を持ってきているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ケルシー先生が言ってたろ？　真に優れた医療オペレーターは己の両手でほとんどの問題を解決できるってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "言ってたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "具体的には覚えてねぇが、アタシはそう理解してるんだよ。よし、どれどれ、どっから診てやるかな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あっ、起きた。まだ何もしてねぇのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "その……大丈夫か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "ううっ、少し頭がクラクラしますわ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "悪いな、さっきぶつかっちまったみたいなんだ。診察しようか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "貴方がたはなぜこのような場所にいらっしゃるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "どうやってこの場所を見つけたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "えーと、道を訊いてもいいか？　この近くに謎の地下都市的なのがあるの知らないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "……貴方がたは地上からいらっしゃったのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "変な言い方だな、お前もだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私たちは、地下に恐ろしい災いが訪れようとしていると耳にした。それで──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "地上人、やはり貴方がたはやってきてしまいましたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "「斧とチェーンソーを携えて汚れなき花園を訪れることは、もとより天災に等しい。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "……「文明の野獣はその鋭い牙を隠そうともせず、我々に向かって人を喰らう巨大な口を開いた……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "わかったぜ。牙とでけぇ口を持った野獣がいるんだな？　安心してアタシに任せろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "え？　いえ、そうではなく、わらわはつまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "体長十メートル以下の相手なら、チャチャっと片付けられる自信があるぜ。ちょうど、体を動かしたかったところだしな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ループスの方、道案内してくれ、どっちへ行けばいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "また下に飛び降りた方が早いだろ、多分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "およしなさい、地上人！　貴方がたの体を濡らす血が──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "安心しろ、ちゃんと加減するから。野獣をぶっ倒す時に、血は飛び散らないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ズゥママ、いけるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "問題ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ループスの嬢ちゃん、しっかりつかまってろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ガヴィルを信じろ。彼女は喧嘩に関してはプロだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ループス",
      "text": "あっ、実は他に道がありますの……ちょ、ちょっと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
