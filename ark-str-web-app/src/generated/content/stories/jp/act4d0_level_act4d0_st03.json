  "stageId": null,
  "title": "射撃訓練",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act4d0/level_act4d0_st03.txt",
  "sourceHash": "a436a8f8096cf11ab7836b73b590b9ca09dfcb7f29d25c42bb630c71ae9f88e5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "三時の方向、20メートル、術師ターゲットA。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "八時の方向、30メートル、敵重装兵に隠れた指揮官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "十時の方向の狙撃手に警戒。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 05:32　天気/晴天\n龍門接舷エリア ロドス艦内 深層フロア射撃訓練室"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "射撃の反復訓練は、まだ5セット目だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "最後のターゲット切り替え速度が明らかに遅くなってた、それに有効ポイントにも命中してない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もし実戦だったら敵に反撃されて逆に撃ち抜かれてたかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どうしたの、ジェシカ。この訓練、まだ厳しすぎる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はあっ、はあ……ふぅ……そ、そんなことありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "続けてご指導お願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "意気込みは良いけど、無理しちゃダメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "10分休憩にしよう。ひとまず休んで、息を整えて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "この10分間で、銃の基礎的な運用方法をもう一度復習するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "戦場にいる時はなおのこと、いちばん大切な基礎を絶対に忘れないようにね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "まずは射撃姿勢を常に安定させること。どんな地形を移動中であっても、身体の軸はブレさせないように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そう、上半身を低く保って重心を安定させる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "次に、銃をコントロールするためのアーツを使う時には、心の乱れは厳禁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "腕を銃の内部につなげるイメージで、正確に弾丸の装填状態を感知する。そして銃芯を活性化させて撃つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……と口で言うのは簡単だけど、アーツを繊細にコントロールして持続させる必要があるのは分かるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "その過程に乱れが生じれば、射撃は失敗、ひどい時には銃が暴発してしまう危険性だってある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そして最後に重要なのが目標へ向けての正確な照準と、射撃後の位置取り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "BSWの射撃理論じゃこれは基礎中の基礎だね。もちろんジェシカも知っていると思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "じゃあ、さっきの射撃の一番の問題点は何か分かる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっと……私の訓練が足りなくて、身体の重心が安定していなかったのと、ターゲット切り替えが遅れたこと、そしてアーツのコントロールも上手く行かなかったこと……でしょうか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そして……発砲の際に躊躇したり注意散漫だったりで、うまく照準が合わなかったこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ううう……こうやって振り返ってみると、全部の過程に問題があるように思えてきます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "半分正解で半分外れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカはいつでも完璧を目指し過ぎ。素早い射撃と高い命中精度を同時に実現しようとしてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それが原因で、気付かないうちに全過程で焦りが生じてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "焦れば焦るほどアーツが乱れる。本来なら敵に照準を合わせることに注力すべきタイミングで、まだ銃内部のアーツを気にしてるような状態になってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そんな風に、射撃の過程がどんどんちぐはぐになっていったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ、そうだったんですか……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "まずやるべきことは、あれこれ考えないようにして、指先に集中すること。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "自分の相棒を信じて、その銃はあなたを裏切らないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "これまであなたがその銃に接してきたように、銃もあなたの想いに答えてくれるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "アーツの注入量と速度は重要じゃない。一番大切なのは精度のコントロールと安定性だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "よし、そろそろ特訓再開。三つの練習台の前にある複数のターゲットに素早く射撃して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もう5セット！　手のアーツに集中して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はいっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "基礎訓練、基礎訓練、基礎訓練……これだけでもう三時間よ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたし、もうこの汗臭い訓練室を出てもいいかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ジェシカが参加するのって、ただのチェルノボーグ廃都市の偵察任務じゃない。休日まで返上して訓練する必要あるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まさか、散歩にフラフラ出てきた悪党がいるかも……なんて心配でもしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ジェシカの場合は、技術なんかより心の問題ね。自信をつける方が重要だと思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "BSWから来たジェシカの査定資料、先に見ておいて。今の様子からして、恐らくどの評価も平均値ぐらいかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "BSWの看板を背負ってロドスに駐在しているジェシカには、かなりのプレッシャーがかかっているはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フロストリーフさんとメテオリーテさんがついてるとはいえ、万全の準備をしておいて悪いことはないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "戦う前に訓練で疲れすぎて戦場で動けないなんてことになったらどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あの子は自分が足を引っ張ることにならないか心配して、もっと戦闘能力を高めたいって私に相談してきたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "龍門の掃討任務が終わったら、私たちは一度BSWに戻らないといけないから、ジェシカに特訓してあげられる時間だって少ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "だからせめて、銃の扱い方に関して私の経験を少しでも分けてあげられたらと思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "可愛い後輩のためってわけね、良いわねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "というかあなた、BSWに戻らないといけないことなんてすっかり忘れてると思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "今回は龍門の任務について報告するだけじゃなくて、定期試験もあるのも忘れてないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなた自身は何も準備しなくていいの？　査定評価が落ちちゃってもいいってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "BSWに提出する報告資料はとっくに準備してあるし、私はロドスに戻ってから、ずっと寝て遊んでたわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "へぇ～なんであたしが寝て遊んでたのを知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "へぇ、リスカム先輩はほんっとーに同僚の事をとっても気にかけてるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "別に査定だって、もし評価が落ちて異動にでもなれば、フランカと一緒に居なくてもよくなる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "こんな特訓をしたところで、たかだかちょっと訓練量が増えて、雀の涙程度の経験を積めるだけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "こんなところでチマチマ苦労して特訓するより――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "銃の扱いに関する研究討論なら、あの眩しい天使たちを捕まえたほうが早いんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あいつらこそ銃のプロフェッショナルってもんでしょ。一撃必中でバンバーン！　ってね。半人前の技術でもいいから盗めれば、あなたから学ぶよりずっといいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あの人たちに聞いても「何が難しいの？　道を歩くのと同じくらい簡単じゃん」「感覚でなんとかなるでしょ？」って答えが返ってくるだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "大型の銃を何丁も扱えるだけの心得がある天使からしたら、こんな携帯型の銃なんて子供のおもちゃみたいなもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ラテラーノの射撃技術は発展しすぎていて複雑だから、何の参考にもならないと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "へぇー、羨ましいものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "目まぐるしく変わる戦況下での繊細なアーツコントロールは、普段の訓練量だけじゃ身につくものじゃない。少しでも多く練習しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "なんでBSWを立ち上げたお偉いさんたちは、こんな面倒で扱いにくい武器を支給することにしたのかしらね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "同じ遠距離武器でも、クロスボウよりもずっと扱いが難しくて、弾薬も高いし手入れも大変。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "BSWが銃を選んだのには、全く理由がないわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "武器を標準化して支給することで、会社にとって管理の手間や人員異動のリスクを減らせる。あと同じ武器を使うことで、個人の能力差も目に見てわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それに射撃速度が戦場の環境に左右されることがない。なにより他の遠距離武器より携帯しやすくて隠しやすい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はいはいはい、もうそんな話は聞き飽きたわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしも分かってるわよ。まぁ、あなたたちは好きにやってて、何もないならあたしはもう戻るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ジェシカのことは心の中で応援しておくわ。あたしはBSW本部に戻る前にたっぷり休んでおきたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わざわざフランカを呼んだのは応援してほしいからじゃない。ジェシカにはフランカの助けも必要なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "前線で敵中に攻め込みながら作戦を展開するコツは、私じゃ教えられないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "でっかい盾で電気をバリバリやりながら移動する技を教えてあげればいいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あれもこれも教えるなんて無理だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それに私のアドバイスなんかより、フランカの経験の方がずっと役に立つはずだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "前線を素早く駆け回って、敵の防御を軽々と突破する。それもアーツによる武器の強化を長時間維持しながら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "アーツコントロールに関しては、BSWでもフランカより上手な人はいないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ちょ、ちょっと待ちなさい。な、なんでそんな言葉がスラスラ出てくるのよ……。バカっ…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "聞いてるだけで顔が赤くなるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はぁ……ジェシカに教えてあげるのがダメってわけじゃないけど、どうやって先生になればいいかなんて分かんないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "私が言ってることがわからなかったり、私のスピードについてこられなかったりしても、手取り足取りゆっくり教えるなんて無理よ。",
      "portraitKey": null
    },
    {
