{
  "server": "jp",
  "storyId": "main_15_level_main_15-08_end",
  "groupId": "main_15",
  "stageId": "main_15-09",
  "title": "減圧症",
  "storyCode": "15-9",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_15-08_end.txt",
  "sourceHash": "373b88ad9103b6831912ff1919db4c6101a2b5bc69cff1557c025ad22c4d5064",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ドクター……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……アーミヤ？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、よかった……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "目覚めてくれて。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "目覚めてくれて？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……自分は長い間意識を失っていたのか？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい。撤退の作業は決して順調だとは言えないものでしたから。思考共有の切断が突然だったことに加えて、境界の情報による衝撃もあり、私自身も安定した状態を維持するのが難しかったんです。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ、君の状態はどうだ？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "私もつい先ほど完全に意識を取り戻したところです。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ですが、心配しなくて大丈夫ですよ。テレジアさんが守ってくれているおかげで、ドクターよりも影響は小さいですから。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "アーミヤ……自分の今の状態はどうなっている？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "私にもよくわかりません。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ケルシー先生がドクターの全面的な検査をしてからでないと具体的な状況の判断はできません。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクターがずっと私の手を離さずにいてくれてよかったです。でなければ、もっと心配しているところでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、勝手に動いたらダメですからね。私たちはひとまずケルシー先生が建てた緊急観察エリアにいなければなりません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシー？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "緊急観察エリア？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私たちとロドスの安全を確保するために、ケルシー先生は付近のエリアを片付けて、ずっとドクターと私を見守っていたんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ケルシー先生は私たちが「文明の存続」に入っている間、想定外の出来事が起こることを望んでいませんでした。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼女はやはりわかっていたのか……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "彼女が見当たらないが――",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "接近する声",
          "text": "君たちが目覚めたのを確認した後、すぐに認知機能ベースラインテストの準備をしに行っていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "接近する声",
          "text": "君とアーミヤに対してすでに簡易な診断を行ったが、明らかな損傷は見られなかった。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかしながら、思考の変化状況は生体組織とは異なって容易く判別できるものではない。さらなる確認が必要だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "おかえり、ドクター。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "なんだか……疲れているようだな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "君たちが「文明の存続」に入っている間、予期せぬ事態が発生して私が処理をしていた。後ほど現在の状況を共有しよう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我々も役に立つかもしれない情報を見つけた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "目下の急務は、君が無事であるかを確認することだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "黒い王冠を通じて思考共有を行うこと自体が極めて危険な行為だ。そのうえ、君たちは「境界」を越えるという過激な行動をとっただろう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "であれば、やはり君の思考が安定しているかそして、身体的健康は保たれているかの確認こそが私の今の最も重要な責任だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "過去の過ちを再度起こすことを私は決して許さない。君の命の安全に影響を及ぼす危険が存在し続けることも当然認められない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Dr.{@nickname}、ついてきてくれ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "き、君は怒っているのか？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "アーミヤ、君も認知機能ベースラインテストを受ける必要がある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "だが、今はゆっくり休んでくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "わ、わかりました、ケルシー先生。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤにもついてきてもらってはいけないか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "それは私の段取りにはない。アーミヤの検査には君の検査が終わり次第、取り掛かる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "行こう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "これがテストの機械か？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "こんな機械があったのか？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "医療部が開発した原型機で、元々は私とテレジアで設計し開発したものだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "だが思考と認知に対する我々の研究には限りがあり、被験者の思考の安定性を測定するこの技術を正式に現場で使用することはなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかしドクター、今は状況が特殊だ。これ以外に有効な検査方法がない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "隣の隔離室に入ってくれ。楽にして、緊張する必要はない。私がテストしたが、身体にそれとわかる負担はなかった。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ほかに注意すべきことはあるか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ない。私の指示に従ってくれ。まず機器の調整をする必要があるから、肩の力を抜いて私の指示を聞いてくれればいい。ただし、決してためらわないことだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ドクター、君の名前をもう一度教えてくれ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "{@nickname}。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "よし、いいスタートだ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……{@nickname}？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "緊張しなくていい。ただの調整だ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "私の後ろにある時計が見えるか？　心の中で時間を数え、できるだけ実際の時間と同期させるんだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（黙って数えて、時間の流れを感じる）",
          "value": "1",
          "blocks": []
        },
        {
          "label": "このようなことをする意味が理解できない……",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "これは現実の認知を強化するのに役立つ。すでに二十秒が経過したが、どこか不快感はあるか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……何とも言えない。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "計器に異常な数値は出たか？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "まずは調整を続けるとしよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "今も思考の中でアーミヤの存在を感知できるか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "できる。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "恐らく誤った切断による思考共有の名残だろう。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "できない。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "よし、この方法に慣れてきたな。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "調整を続けよう。君はロドスの理念に同意しているか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "している。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "即答か。調整は間もなく終了する。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "していない。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "面白い回答だ。だがこれは嘘発見器ではない。それとも、より一層ドラマチックな結果を期待しているのか、Dr.{@nickname}？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "続けるとしよう。ドクター、君は思考の境界で彼女を見た。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうだ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "驚くことではないが、想像していたよりも冷静だな。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "誰のことだ？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "私に隠す必要はない、ドクター。無条件に信じてくれて構わない。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "最後の調整だ。ドクター、君によく似たあの人物に対して疑問を抱いたか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ああ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "当然の感情だ。しかし、いかなる方法や立場でもってしても疑問に答えてやることはできない。君はいずれ自分で答えを見つけるだろう。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "あるいは、すでに君には主観的な推測があるのかもしれないな。これに関して私に干渉する権利はないが、君がロドスの利益を損なうことはないと信じている。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "全く。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "text": "どうやら、君はすでに確信に近い推測があるようだ。私はそれに対して何の意見もするつもりはない。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "終了だ、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "認知機能ベースラインテストの結果、君の思考の安定性は依然として概ね安全な閾値内にあることを示している。残りは副次的なプロセスだけだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "待て、これは調整じゃなかったのか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "より正確なデータを得るために講じた必要な手段だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "君の能力であれば、私の考えをより微細に捉え、偽装することもできただろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "君がこの原型機を騙そうと思うのなら、それは決して難しいことではない。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それはもちろんだ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……その、我々はまだ検査中なのか、ケルシー？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Dr.{@nickname}、残りの検査は間もなく自動的に終わる。私には君の疑問に答える時間がある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
