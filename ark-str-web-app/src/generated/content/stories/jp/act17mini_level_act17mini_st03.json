{
  "server": "jp",
  "storyId": "act17mini_level_act17mini_st03",
  "groupId": "act17mini",
  "stageId": null,
  "title": "シーツを被った怪物",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17mini/level_act17mini_st03.txt",
  "sourceHash": "12e5317f212c54cbe20df9122683b90e31052f7c1d79beff6f662dd59d118565",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "痩せぎすのサルカズ男性",
      "text": "俺のはほかの連中のとは違うんだ、見てくれ！　どれも選り抜きのもんばっかりだろ。よそのやつぁ花火の粒だが、うちのは花火の芯なんだ！　同じ値段とはいかねえよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "中継炉の見張り番",
      "text": "変わらんよ。多く見積もって三つだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすのサルカズ男性",
      "text": "……じゃあこうしよう。ポケットん中にもう一握り分あるんだ。全部混じりっけなしの異鉄で、源石不純物も入ってねえ。こいつを加えるから、あんたんとこの粉焼きを一つ分けてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "中継炉の見張り番",
      "text": "いらん。粉焼きもやらん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすのサルカズ男性",
      "text": "この頑固ジジイ！　窯焚き屋の分際で、大物にでもなったつもりかよ？　焼き甘イモたったの三つで、三カゴ分の異鉄塊と交換しようたぁ、あんた良心まで窯で丸焦げにしちまったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "中継炉の見張り番",
      "text": "俺の粉焼きはどれも混じりっけなしの小麦粉だけで作ってんだぞ。それを一握りのスラグと交換しろってのか？　バカ言ってねえで失せな！　ほら、次来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "中継炉の見張り番",
      "text": "二カゴか？　秤にかけな。よし、焼き甘イモ二つと交換だ。自分で灰の中から取ってくれ。ちょろまかすなよ、ちゃんと数えてるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "中継炉の見張り番",
      "text": "おい豆もやし、失せろと言っただろ。何を突っ立ってる？　後ろの奴の邪魔になるだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "わかったよ、クソジジイ。この街にゃお前以外にも窯焚き屋はいるんだ。ほかに目利きがいるはずさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "中継炉の見張り番",
      "text": "まったく恩知らずな奴だな。もし、ほかんとこで焼き甘イモ三つと交換してもらえたら、この窯にある粉焼きを全部タダでくれてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "皆聞いたな？　後からやっぱナシなんて言っても聞かねえぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "*サルカズスラング*！　どいつもこいつもケチな野郎だ！　こっちの窯焚き屋なんて二つと交換とか言いやがる。しかも去年の倉庫の余りもんときた。こんなんじゃ食っていけねえよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "一晩中拾い集めて、腰が折れそうだってのに、まさか一日分の飯にすらならねえこたないよな……どのみちあのジジイんとこにゃ戻れねえし、いっそ東の市場に行ってみるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "けど東に行くってなると、あのバラックを避けては通れねえよな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "あのジジイたちの話だと、戦争中に欠けちまった遺体は全部あそこに捨てられて、今でもサルカズの魂の中に戻れてない亡霊がいるとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "いやいやいや！　そんなの子供だましの作り話に決まってらあ。俺がビビってどうすんだ！　笑わせんなってえの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ただちょっと暗い路地に、誰も住んでねえバラックがいくつか立ってるだけだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は覚悟を決め、キシキシと音を立てる粗末な作りの手押し車を押して歩きだした。そうして散らばる薪の山や、路上の深い水たまりを避けながら、曲がりくねった狭い路地の奥まで進んでいく。\n前方の道には一本の暗い境界線があり、その向こうは魂の炉の影に覆われた区域だ。痩せぎすの男は歩みをゆるめ、上着を脱いで手押し車の上にかけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ごくっ……この角を曲がればすぐそこだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ハッ、しかしひでえ天気だ。真昼間だってのにこんなに冷えるたぁな。寒さで身体が震えてきたぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "うわっ、何の音だ？　だ、誰が話してやがる！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ここはもう誰も住んでないはずなのに……今度は何だ？　包丁でも研いでんのか？　肉をさばいてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "*サルカズスラング*！　もう目をつぶって突っ切るしか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼が大溶炉の影から抜け出そうとした瞬間、手押し車が勢いよく壁にぶつかった。\nいや、正しく言えば、壁ではない。……彼が視線を灰色の金属から徐々に上へと移していくと、真っ赤な両目と目が合った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ば、化け物だ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な通行人",
      "text": "おっと、失礼。どうやら道に迷ってしまったようでして。お怪我はありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "どこ見て歩いてんだ！　こっちはこんなデカい荷物押してんのに……って、あんたその身体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な通行人",
      "text": "申し訳ない。私が不注意でした。すぐに離れますので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "いいから、あ……あんたはそこでじっとしてろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ほ、ほんっとにひでえ天気だな。太陽も見えねえのに暑すぎるっての！　顔中汗でびしょびしょじゃねえか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ったく、この街ときたら最近は変な奴ばっかり出てくるな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "げっ、またあんたかよ。西へ向かったんじゃなかったのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "街角の影の中、真っ赤な両目がゆっくりと上がっていく。それはサルカズの頭を越え、両脇に建つ小屋を越え、枯れた樹木を段々と越えていった。\nその重い身体がゆっくりと回転しながら炉の影を抜け出してくる。腐った麻布は灰色の裂け目を覆いきれていないものの、サルカズの視野を埋め尽くすには十分だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーツを被った怪物",
      "text": "（かすれた低い唸り声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "で、出やがった……*サルカズスラング*……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "若きサルカズは手押し車の持ち手を放し、白目を剥いて地面に倒れた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "とりあえず、ここで一休みしよっか。あっちの水で顔を洗えそうだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "顔中埃まみれにゃなったが、無駄足ってわけでもなかったな。工事現場にあったあのデカ岩は違うってことがわかったしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あーんなにおっきな岩なのに、鉄が含まれてるのは表面だけで、中身は全部灰だったなんて誰にも想像できないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ねえペールさん、次はどこへ行けばいいと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "ここから東に行けば露店市がある。あそこならどんな変わったもんでも見つけられるが、店じまいが早くてな。大溶炉の影が東の城壁を越えると、すぐに通りから人影がなくなるんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "炉辺の子供",
      "text": "ちょっと、ニンフお姉ちゃん！　あたしが書いた文字踏んでるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あっ、ごめんねチェリーちゃん。あれ、おじいちゃんは？　またあなた一人で炉の番をしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "工事現場にお仕事探しに行くって言ってたけど――おじいちゃんったら毎回ひどい臭いのまま帰ってきて、すぐに横になっちゃうし、お話も聞かせてくれないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "そうだ、せっかく来たんだから、あたしが書いた字を見てよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "灰を使って字の練習をしてるのか？　だが、この灰は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "炉からかき出したばっかりだから、きれいだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "上手に書けてるね、チェリーちゃん。前に教えたやつも全部合ってるし！　これはご褒美をあげないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "飴ならあるぞ。ほら、やるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "飴ちゃんだ！　でも……ううん、やっぱりいらないよ。だって怖いもん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "怖いって何が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "路地裏の怪物が、取り上げに来るって聞いたから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "この先に、お化けの路地裏があるでしょ。あの辺のバラックに近付いたら、中のお化けに狙われるってみんなが言ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "ずっと後をつけてきて、隙を狙って襲い掛かって、持ち物を取って行っちゃうんだって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "そんな話があるかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "ほんとだよ！　会ったって言ってる人、いっぱいいるもん。飴ちゃんだけじゃなくて、干してたシーツまで取られた人もいるんだよ。だから珍しいものさえ持ってなければ、狙われずに済むんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "大方、そいつらは追いはぎのチンピラに出くわしたんだろ。だが、それを素直に言うのが恥ずかしくて、そういう話をでっちあげてお前を担いだんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "ニンフお姉ちゃん、このお兄ちゃん意地悪だよ！　あたしのこと信じてくれないし、こんな人と遊んじゃダメ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "よしよし、泣かないでチェリーちゃん。今言ってた……「お化け」を見た人は、いっぱいいるんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "うん。信じられないなら、豆もやしに聞いてみて。あの人は、ついさっき見たばっかりだから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "そうそう、あいつは三階建ての建物くらい背が高くてな。しかも全身に包帯を巻いて、目から血を流してたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "待って、さっきは「炎をまとってた」って言わなかった？　それなら包帯が燃えちゃうんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "そりゃあ、鬼火だからだよ。鬼火ってのは普通冷たいもんだから、燃えたりしねえんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "んー、わかった。続けてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "これ以上何を説明すりゃいい？　そんな状況でほかに何ができたってんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "俺はその時、急いで鉄の塊をつかんで、バク転で鬼火を避けながら空中でそいつの目玉を狙ってやったんだ。奴はまったく反応できずに、俺の一撃でめまいを起こしてやがったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "バク転？　あなたが？　昨日は腰が痛いから、薪を玄関まで運んでくれとか言ってたのに……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "多分、あの時俺の才能が目覚めたんだろうな。窮地の中で、全身に力がみなぎってきてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "はぁ……やっぱ他の奴に聞いてみようぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "いやいや！　俺ほどわかりやすく話せる奴ぁほかにいねえって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ほかの連中は全員、一目見た途端気絶して、目が覚めるなり振り返りもせずに慌てて逃げ出した挙句、借りた手押し車も放り出す始末さ。そんな奴らに何がわかるってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "一目見た途端気絶したって……自分のことだったりしない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "……だったら何だよ！　とにかく用があるなら俺に聞け。ほかの奴らに迷惑かけるんじゃねえっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "迷惑だあ？　俺らはそこまで暇じゃねぇよ。さあ、でまかせはやめて知ってることを正直に話してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ペー……じゃなくて、顧問さん。この人は結構ショックを受けてるみたいだし、ほんとに思い出せないなら無理強いしちゃいけないんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "顧問？　あ、あんた顧問の旦那か！　お、俺ときたらなんて見る目がねえんだ！　旦那が自分で尋問しに来るって知ってりゃあ、隠し事なんぞしなかったのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "別に尋問ってほどのもんじゃねぇけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ここから東へちょっと行った先の、化け物バラックのあたりだよ。旦那ならきっと知ってんだろ？　俺はあそこで出くわしたんだ。最初は壁際にうずくまってて気づかなかったが、よく見てみりゃ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "真っ赤な目に、ボロのシーツをまとった、俺の倍くらいの背丈の奴だったんだ。キシキシ歯ぎしりしながら歩いてくるもんで、俺は怖くなってその場で倒れちまってさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "だがその後、目が覚めたら驚いたことに五体満足でな！　何ともなかったみたいなんだ！　夢でも見たかと思ったが、頭の後ろを触ったらタンコブが残っててよ。見てくれ、ほら、この辺り――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "見せなくていいっての。\nニンフ、どう思う？　こいつが出くわした怪物ってのが、俺らが探してるやつだったりしねぇかな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "わかんない。けど、探知機が反応するかどうか、確かめに行ったほうがいいと思うよ。そんなに遠くもない場所だし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ニンフちゃんも旦那も、俺の話は全部本当だって信じてくれよ。あんたらが何を失くしたのかは知らねえが、俺が取った訳じゃねえからな。はぁ、俺らときたらほんとツイてないぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "迷惑かけるつもりはほんとにないから、安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "でも、手押し車は取り戻したほうがいいね。じゃないと、デカ頭さんから文句を言われかねないし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サルカズの若者は引きつった笑みを浮かべると、悩ましげに己の頭を叩いた。だがそれが運悪くタンコブに当たり、痛みに顔をしかめていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "なあ、ところで物は相談なんだが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "着いたぜ。あいつが言ってたバラックだ。ここは何年も、誰も住んでねぇはずだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "探知機に反応は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ないね……場所を間違えちゃったとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "あのガキんちょに騙された可能性のほうが高いと思うぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "……そういや、あいつは知ってんのかな。自分が字を書いてた灰の中に、サルカズの遺灰が混ざってることをさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "まあ、多分知らないんだろうな。あんたはあの子をちゃんと守ってやってたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ああいうのも……「守る」って言えるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "もちろん。はぁ、にしても、マジであんな子供一人に騙されたとなりゃ、情けねぇ話だが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "とはいえ、せっかく来たんだ。追いはぎのチンピラってのが本当にいるんなら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "――ついでに片付けてやろうじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "入りな。中には誰も……\nうっ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフが口を開こうとした瞬間、扉の後ろから伸びてきた剣がペールの首に突き付けられた。\nそれは相当のなまくらで、刃のあちこちが欠けている。しかし、振るう手さばきは異様に落ち着いており、耳の下3センチのところにあてがわれた切っ先は少しも震えていなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "ニンフ、よせ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジャールはいつの間にかアーツユニットを抜き出していた。かすかなアーツの波動は、ペールの言葉を受けても消えることはなく、発動の機をうかがっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "こいつに俺は殺せない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷たい声",
      "text": "試してみるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "その剣を……放しなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "大丈夫、俺を信じろ。試す必要もねぇさ。っていうのは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷たい声",
      "text": "ぐあっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "ふぅ……俺ぁ怪我人一人も倒せないほどボンクラじゃねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "あんたの手、血が出てるみたいだが……そりゃ、サルカズの血じゃねぇな。あんた一体何者だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "お前に答える義理はない。さっさと失せろ、ここは俺の家だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "いいや。ここはカズデル、つまりはサルカズの家さ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ちょっと顔を見せてみな……\nあんた、郊外の居住地で見かけたことがあるな。確か、マドロックって奴と一緒に都市外へ食糧を密輸してたような。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "マドロック？　なんとなく……聞いたことがあるような。あなたたち、ロドスから来たの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "ごほっ、隊長を知ってるなら、とりあえず引っ張り起こしてくれないか。この腕はうまく力が入らなくてな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "もう三回も言っただろ。あいつらは工事現場で食い物を稼いでるだけで、密輸をしてるわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "俺が行かなかった理由なんざわかり切ってるだろ？　もう一度この腕を確かめてみるか？　俺だって本当は行きたいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "密輸目的じゃねぇなら、どうしてわざわざ都市に入ってきた？　こんな幽霊屋敷みてえなバラックに住んでまでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "ここ以外に住める場所なんてあるか？　毎晩押し入られずに済むのはここだけなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "人の多いところに住んでると、夜は眠れないし、昼間も気軽に出かけられないんだ。ちょっとでも目を放した隙に、ドアフレームまで奴らに取られて薪にされるわけだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "前に、角を短く削ったキャプリニーの泥棒さんがいたよね。よく工事現場に忍び込んで、鉄筋やレンガを盗んでた人……もしかして、あの人もお仲間？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "あり得ないな。角を短く削ってサルカズに成りすましてたのか？　俺たちはそんなバカげた真似はしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "こんなとこに住んで幽霊のフリして暮らすのだって、大して変わんねぇだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "幽霊のフリなんざした覚えはない。あのバカどもが勝手にビビってるだけのことを、俺たちのせいにするつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あなたのお仲間さんたちは、本当にレンガや鉄筋を盗むために工事現場に行ってるわけじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "バカバカしい。サルカズじゃない俺でも、そんなことあり得ないってことくらいわかるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "土石の子にレンガ泥棒の疑いをかけようだなんて、本気で言ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "土石の子？　じゃあ、そのマドロックって人はアンズーリシックなの？　そんなこと、想像もしてなかったよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "それなら、色々と辻褄が合うな。前にマドロックを見かけた時は、郊外に家を建ててるところだったし、よそから来た感染者たちが耕作地を切り拓く手助けもしてたって聞いてるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "だけど、それならどうしてわざわざ都市の中に？　土石の子の助けがあっても、都市の中でしか解決できない問題があるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "さっきから色々聞いてくるが、お前らに何の権利があると思ってるんだ？　そもそも、都市に入ると決めたのはマドロックだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "俺たちが、この街のサルカズ相手に恐れをなすとでも思うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ううん、違うよ。怖がってるのは……あたしたちのほうなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "はぁ……で、隊長さんはあとどれくらいで帰ってくるんだ？　このまま日暮れまで待つわけにはいかねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "いつもなら、とっくに仕事が終わって帰ってきてる頃だ。だが、今日は俺もいないし、巨像もどっかに行っちまったから、もうちょいかかりそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "じゃあ、ここで待ってようか。隊長さんには絶対会わせてもらわないと。この人たちをこのまま都市の中にいさせるのは……危なすぎるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "こほん。ところであんた、サルカズ語がかなり上手だな。なまりから察するに、リターニア出身か？　よかったら、名前をお伺いしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "よく喋る男だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "「よく喋る男」さんか。ちょっと奥に詰めてくれよ、俺にも座らせてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "太陽が徐々に傾いていく。ニンフは手にした探知機を見つめ、何か考え込んでいるようだ。\nペールは立ったり座ったりを繰り返した末、退屈そうにしゃがみこんで床に散らばった砂利を数えている。\nそうするうちに、大溶炉の影は東の城壁を越え、傷口から流れた血は新しく換えた包帯に染み込んで、完全に固まっていった。\n腕を怪我した感染者は突然立ち上がると、床に突き刺してあったなまくらの剣を引き抜いて、窓の外の影に目を向けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "あいつらを探しに行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "お前らも来るか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "どの工事現場に行ったか、わかるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "わからん。最悪、全部を見て回るつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "まさか、堂々と街中を歩いていくつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "怪我した異種族の人が出歩くなんて……こうしよう。あたしがついて行くから、誰かに何か聞かれたら、こう答えて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "シーッ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ペールはなおも床の砂利を見つめていた。\n彼の手によって、色と大きさで四つの山に分けられた砂利が、独特なリズムで崩れていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "戻ってきたみたいだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "マドロック……捕まえたのか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドン。ドン。\nドン。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "重い足音が路地の入口で止まった。細かな金属のこすれ合う音が壁に沿って近づいて来て、すぐさまニンフとペールの耳へと届く。剣が鞘から抜かれた音だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "マドロック――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "俺なら平気だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "土石の子が街角から現れた。仲間の呼びかけすら聞こえていないような様子で、動きに無駄は一切ない。彼女の後ろについてきた感染者たちもまた、武器を収めたのが見えた。\nマドロックはボロボロのバラックに足を踏み入れると、持っていたスコップを部屋の隅に放った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "入ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "座って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "縛り付けておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マドロックはほとんど間を置かずに、疲れた口調で三つの言葉を発した。\nニンフはマドロックの向かいのスツールに腰かけた。外の感染者が次々にバラックへと入ってきたが、そのうち二人は路地まで伸びるロープを手に持ち引きずったままでいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "ジャールか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "う、うん、あたし、ニンフっていうの！　こんばんは、マドロックさん！　ええと、うちのパパとママもジャールで、お姉ちゃんもそうなんだけど……ロドスで会ったことあるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "家族も来ているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ううん。その、あたしがここに来たのは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "俺らを追い出すためだろうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "スティック、話を逸らすな。――続けてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "実は、ここに来たのはある物を探すためなんだ。このバラックの近くで恐ろしい怪物に会ったって人がいて、その怪物が探し物に関係してるんじゃないかと思ったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "でも、今考えると、ただの誤解かもね。怪物なんていなかったわけだし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "要は俺たちがその「怪物」だって言いたいんだろ？　この街のサルカズたちは皆、そういう目で見てくるからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "そ、そんなつもりじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あたしは、ここのサルカズも、都市外の居住区の人たちも似たような境遇だと思ってるよ。ここに残ることを選んだのは、ほかに行くところがなかったからでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それに、言ってしまえば、サルカズがほかの種族から「怪物」扱いされてきた歴史は、カズデルの歴史と同じくらい長いはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "マドロックさんなら、あたしの言いたいこともわかってくれると思うんだけど、よかったら説明してもらえないかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "なるほど。恐らく、誤解ではないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "あなたの言う怪物は、ああいう見た目のものだろうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外の感染者",
      "text": "おーい、ちょっと手を貸してくれるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "俺かい？　ええと……おう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（不安げな雄たけび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "お……おいおい、こいつは一体何なんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外の感染者",
      "text": "しっかり掴め！　中まで引きずっていくぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外の感染者",
      "text": "せー、の！　もう一回！　せー、の！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "感染者がロープを腰に巻き付け腕に力を込めると、ロープは少しずつ手繰り寄せられ、腕に巻きつけられていく。\nペールが驚いた表情をしてロープの先に目を向けた時、暗闇の中からゆっくりと引きずり出されたのは――\n人二人ほどの背丈があり、目が赤く、白いボロボロの麻布を身に纏い、鉄線とロープでがんじがらめにされた――\n怪物だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外の感染者",
      "text": "縛り付けるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "どこにどう縛り付けろってんだ？　ここはただのバラックだぞ？　こいつがちょっと足を踏み鳴らせばぶっ壊れちまいそうだが、マジで大丈夫なのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外の感染者",
      "text": "とにかくやるんだよ。マドロックがやってくれっつうんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "……あんたら、どうやってこいつを捕まえた？　それと、こいつは一体どこから来たんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "探知機が震えてる！　マドロックさん、あれって……あなたの作った巨像なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "ああ。帰り道で、偶然見かけてな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "昨日までは特に問題なかったんだ。岩を運ぶのが多少遅くなってはいたが、壊れている様子はなかった。だが、夜中に急に飛び出していって、どうしても戻ってきてくれなくてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "アーツを使っても、何かの妨害を受けているかのように位置を割り出せなかったんだが……もしや、何が起きたか知っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "多分、レヴァナントの欠片の影響だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "レヴァナント？　どうして彼らが関わってくるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "実は……はぁ。とりあえず、その像を見せてもらってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "気を付けてくれ。人を見ると見境なく襲おうとするんだ。仲間たちはほとんど皆殴られてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "スティックさんの腕もそれで折れちゃったのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "あれは、工事現場で仕事を奪い合っていた時、相手に鉄筋で殴られたせいだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した感染者",
      "text": "おいマドロック、あの時俺を助けてくれなかったことまではいいとしても、どうしてよそ者の前で笑い話扱いするんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "助けるどころか、仕返しまでしただろう？　結局私一人で相手の仕事まで片付けることになったが、おかげで彼は、一日中日を浴びながら、コーン一粒すら受け取れなかったらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "その巨像のことだけど、ほかに何か気になるところはあるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "やけに私のことを恐れている様子で、姿を見るなりすぐに逃げ出してしまった。広場に逃げ込まれて炉をひっくり返される恐れさえなければ、とっくに捕まえていたのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "それ以外は、特にないな。ええと……ニンフと言ったか？　巨像の暴走が本当にレヴァナントと関係しているなら、無理はしないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "カズデルのジャールは全員合わせても幾人もいない。私と会ったばかりに怪我をさせたくはないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "わ、わかった……忠告ありがとう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフは探知機を取り出し、暴走した巨像にゆっくりと近づけた。\n一歩、二歩……三歩目まで進んだその時、探知機が耳をつんざくような警報音を鳴らし始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "こいつで当たりか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ううん、この子自体じゃなくて……その中にあるみたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジャールは巨像の身体についた亀裂を指差した。その裂け目の奥には、一つの石ころが挟まっている。\n網に絡めとられた巨像がどれだけもがこうと、その石ころはまるで敵を睨みつける目玉のように、かっちりと巨像の身体に嵌まったままだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "異様な何かを感じるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "それは何百年も燃やされ続けてきた苦痛と……何万年もの間続いてきた憎しみだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暴走した巨像",
      "text": "（かすれた雄たけび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "これがレヴァナントの欠片。巨像が暴走したのは、きっとこれに関係してるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "巨像に襲われた人はいても、怪我人までは出なかった理由は今までわかってなかったけど、思えば……きっと、サルカズにだけは暴力を振るわないからなんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "……なるほど。レヴァナントからすれば、今のカズデル同様、サルカズ以外の人間の存在は許されないということか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "とにかく今はこの欠片を取り出さないと。マドロックさん、手伝ってくれる？　この巨像を作り出したあなたなら、きっと制御方法がわかるはずだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "この子が暴れないようにしてほしいな。少しの間でいいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マドロックは手を上げ、暴走した巨像に向けた。すると巨像は何かの脅威を感じたかのように、より激しくもがき始めた。\n鉄線の錆びた部分が断ち切られ、地面に強く打ち付けられて、埃が舞い上がる。\n巨像の目の赤い光がさらに輝きを増し、冷たい声が全員の脳内に同時に響き始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暴走した巨像",
      "text": "抑圧への……復讐を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴走した巨像",
      "text": "駆逐！　駆逐！　駆逐せよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "あなたの目には憎しみしか映っていないようだな……もはや誰がサルカズで、誰がよそ者かもわからなくなっていながら、それでも拳を振り上げるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "レヴァナントはそのような存在であってはいけない。こうなれば……巨像を解き放ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "おい、気は確かか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外の感染者",
      "text": "……わかった。皆離れててくれ。3、2……1！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暴走した巨像",
      "text": "駆逐せよ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴走した巨像",
      "text": "カズデルは、サルカズだけの、地となるのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "ならば、今のあなたは何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "レヴァナントでもなければ、アンズーリシックでもない。気の触れた作り物に過ぎないあなたこそ……カズデルを出ていくべきではないのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暴走した巨像",
      "text": "！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "マドロックさん、気を付けて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巨像のあらゆる亀裂から煙のような物質がにじみ出てきた。それによってその体躯はますます巨大化したように見え、振り上げる右拳はほとんどバラック一軒分ほどの大きさになっている。\n次の瞬間には、その拳が若きサルカズの頭上に振り下ろされてしまうだろう。\nジャールのアーツユニットがかすかに輝き始めた。彼女は巨像の両目を見据え、毅然としたサルカズ語でいくつか言葉を唱えていく。そしてそのたび、巨像の目の赤い光が次第に弱まっていった。\nその一方で、ニンフの背後にある影もますます恐ろしい姿に変わっていく。それは今にも、スラグの地面から這い出しそうな様子だった。\nその影が地面を貫こうとした瞬間、マドロックは伸ばした手を握り締め、指を鳴らした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "パチンッ――\nすると、巨像の形を保たせていたアーツが解除され、瞬く間に泥と石の塊と化して崩れ落ちていく。振り下ろされる寸前だったその拳も、一陣の息詰まる強風へと変じた。\n埃がいまだ立ち込める中、夕暮れの残照が影の獰猛な角を跡形もなくかき消していった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "送ってくれてありがとう。ここまでで大丈夫だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "気にするな。私も都市内にあるロドスの事務所へ向かって、レヴァナントの件を報告するつもりだし、そのついでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "それより、そんな小さな箱に入れて……大丈夫なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "これはリッチの作った物で、すっごく頑丈なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ところで、あなたの仲間のことだけど……あたし、今日の警備当番の人と知り合いだから、誰の注意も引かずに街の外へ出してあげられると思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "なぜ都市を出る必要が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あの暴走した巨像みたいに、この街には異種族が自分たちの隣人になることを許せない人がまだたくさんいるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あなたたちには食べ物と寝床が必要なんだと思うけど、この街の中にいても、それを手に入れるのは外より簡単にはならないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "では……私が彼らをこの都市に連れてきたのは、単に食べ物と寝床を確保するためではないと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "ニンフ。そう遠くない以前までは……この街にも、サルカズ以外の人がいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "それぞれ違う場所から遥々やってきた人々は、知識を伝え、人を救い、レンガを積み上げていた。彼らが望んだのは、食べ物と寝床だけではなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "バベルのことだよね……でも、あの人たちはもういないんだよ。その理由は、あなたもあたしも知っての通りだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あの時代って、素敵な夢みたいだったよね。そんな夢に包まれながら子供時代を過ごせたことは、幸せだったと思うんだ。でもサルカズに、カズデルにとっては、それは良いことばかりじゃなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "今のカズデルはすごく脆いの。だから、もう一度……同じことを繰り返すことはできないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "それはあなたの考えか？　それともサルカズ全員の考えなのか？　私からすれば、今のカズデルはそれほど弱いものだとは決して思えない。カズデルがそれほどまでに弱かった時代もないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "悪いことは避けられるものだ。その一方で良いことは、どこまで行こうと良いことであるのに変わりはないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "カズデルはいずれ多くのことに向き合わねばならない。最後の希望を胸にカズデルへやってきた多くの者を、いつまでも郊外の居住地に留まらせておくわけにはいかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "だけど、あなたはサルカズでも、あなたの仲間はそうじゃないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "構わない。彼らは私を信じてくれている。私がアーミヤを信じるようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "アーミヤ……ロドスの人だよね。あなたたちの理想は聞いたよ。確かに……すごく魅力的だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ふぅ――ますます気になってきちゃった。ロドスって、一体どんな場所なのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "共に行こう。アーミヤに会ってみるといい。事務所はさほど遠くはない。あの通りを越えたらすぐだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "彼女もカズデルにいるの？　いつの間に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ううん、でもやっぱりこの仕事を片づけてからにするよ。きちんと終わらせるって約束したから。しかも、約束した相手はかなり気難しいタイプだし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニンフが自分の鞄を持ち上げて揺らせば、中の小石は転がったが、何の音も立てはしなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マドロックはこくりとうなずくと、一人で大溶炉の方角へ歩き出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "ふわあ～……話は終わったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "うん。次はどこへ行けばいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "本当なら東の市場を回るべきだろうが、この時間じゃとっくに店じまいしてる頃だな。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "今日はこの辺にしとくか？\nんー……ただ、何か忘れてる気がすんだよな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "あっ！　豆もやしさんの手押し車！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ニンフちゃんはまだか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "もしデカ頭のほうが先に戻ってきちまったら、ブン殴られて俺のほうが「デカ頭」になっちまうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "なに怖がってるの？　ニンフお姉ちゃんに任せとけば大丈夫だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "ほら、噂をすれば――お姉ちゃーん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "手押し車だ！　よかった！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "ありがとうは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "ありがとう！　恩に着るよ！　あの化け物に捕まらなかったよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "化け物も怪物もいなかったよ！　チェリーちゃんをあんまり怖がらせないでよね。あれはただ、追いはぎさんが迷惑かけてただけ。もう顧問さんが懲らしめてくれたから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "ただ、あそこの家は古くて修理もされてないし、道も狭いから、用がないなら近付かないほうがいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "本当にいなかったの？　でも、午後にも誰かが怪物に追いかけられてたってみんなが言ってたよ。城壁のこっちからあっちまでずーっと追い回されてたんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "ニンフお姉ちゃんも、ひょっとしたら……もう狙われてるのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "だとしたら、残念だけど多分明日は来られないだろうし、明日の分の文字を先に教えてもらっといてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "……あたしは狙われてなんかないから、安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "このガキんちょ、気の遣い方がずいぶん独特だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "とりあえず、時間も遅いし、俺は先に戻るぜ。角折れ組の連中が俺の留守中に何かやらかしても事だしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "それでよ、今日あのマドロックって奴に会ってひらめいたんだが……あの花火の欠片、もしかしたら郊外にも落ちてるんじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "だから、こうすんのはどうだ。明日俺は、郊外の密輸業者んとこに情報収集に行った後、ついでに軍事委員会の駐屯地辺りを回ってみる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニンフ",
      "text": "わかった……ならあたしは、東の市場のほうに行ってみるよ。それと、もし見かけたら必ず連絡してね。くれぐれも無茶はしないようにして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペール",
      "text": "心配すんなって。んじゃそういうことで。またな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里帰りの傭兵",
      "text": "げほっ。ごほ、ごほっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェリー",
      "text": "あ、デカ頭おかえり。誰に殴られたの？　腕が腫れちゃってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "あ……兄貴。手押し車お返しします、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里帰りの傭兵",
      "text": "ああ、そこに置いといてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "そんじゃ、何にもなければ戻ってもいいですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里帰りの傭兵",
      "text": "さっさと失せやがれ。俺は疲れてんだ。お前に構ってる暇はねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "あー怖かった、てっきり一発殴られると思ってたぜ、はははっ。なあデカ頭の兄貴、あんたまさか一日中何も食べてねえのか？　どうしてそんなにくたびれてんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里帰りの傭兵",
      "text": "今俺のことなんつった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里帰りの傭兵",
      "text": "どうして手押し車の後板が凹んでんだ？　ハンドルもひび割れてやがるぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里帰りの傭兵",
      "text": "おい、こっち来い！　腹から声出して答えろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豆もやし",
      "text": "やめてくれえ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
