{
  "server": "jp",
  "storyId": "story_rosesa_set_1_story_1",
  "groupId": "story_rosesa_set_1",
  "stageId": null,
  "title": "夢に見た素敵な暮らし",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_rosesa_1_1.txt",
  "sourceHash": "c49c9a1468f93db1880ea284450700c7032467cf0cd88b0f15a8422bfa968cce",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "お嬢さん、心から感謝するよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "まさか愛しい娘が無慈悲にもこの年老いた父を置き去りにして、手紙すら受け取ってくれないとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "じきに雨乞いの儀式当日だ。こんなタイミングで君が現れ、娘に代わって大事な儀式の完遂の手助けをしてくれようとは……ああ、なんとお礼を言えばよいのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "まあ、おじさま。そんなことを言わないでください！　こんなに裕福で娘想いなお父様ですもの。娘さんだってきっと一時の気まぐれで、すぐ戻ってくるに違いありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "今回、お手伝いを引き受けたのも、見返りを求めてのことじゃなくて。ただおじさまみたいな優しい方が悲しむ姿を見過ごせなかっただけなんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "なんていい子なんだ……君は本当に優しい子だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "しばらくは我が家で窮屈な暮らしをさせてしまうが……この報酬はお嬢さんへの感謝の気持ちだ！　儀式が終わったら追加の謝礼もお渡ししよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "そんな、なんだか申し訳ないような……あたしはおじさまみたいな優しい方が傷つくところを見ていられなくて、力を貸してさしあげたくなっただけなんですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（申し訳ありまくり！　さっさと金を寄こしなって！　前払いでこんなにたくさんくれて、豪邸に住めて、終わったら追加の報酬まであるなんて！　こんな依頼、逃したら大損！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "ああ、お優しいお嬢様、どうぞこちらへ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "うん、ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "いいえ、お礼などいりません。特にあなたのような心優しい御方は……それに、おもてなしするのは我々の責務ですから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（小声）それにしてもおかしな話……大豪邸に住んで、たくさんのジュエリーに囲まれて、幸せな暮らしが約束されてるってのに、首長の娘が家出するなんてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（小声）こんなにいい暮らしを嫌がる奴がいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（小声）それならあたしがもらっちゃうけど、へへっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "乗り心地の良い御輿は何度か角を曲がり、豪邸の前で止まった。\nローズソルトは使用人の手を借りて御輿から降りた。傍にいた首長が屋敷の門を開けるよう従者に命じる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "わぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "広々としたホールには暖炉があり、火が燃えていた。その炎は使用人の動きによって起こるささやかな風で揺らめいている。"
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "お望みなら、いつでもここで舞踏会を開くことができますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "舞踏会……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "室内には穏やかな音楽が流れている。ローズソルトは裸足で絨毯を踏みしめ、毛並みの柔らかさを味わった。"
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "まあ、なんて愛らしくてお行儀が良いのでしょう。本当にお嬢様とそっくりです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "先ほど旦那様から涙ながらに、あなた様をお嬢様と同じようにもてなすよう言い含められました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "さあ、お嬢様。我々はあなた様のお好みについてまだ把握できておりませんので、お召しものについては色々な種類を用意させていただきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "旦那様は季節ごとに新しい服を準備するようお命じになるのです。こちらをご覧ください。素材はリネン、サテン、シルク、コットンで……スカート、パンツ、スーツと、なんだって揃っております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "こちらの宝石を散りばめたドレス、真珠飾りのサテンドレス、そして羽毛のロングドレス、どれがお好みですか？　ドレスがお嫌でしたら、それ以外のご用意もたくさん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "ううん、面倒をかけちゃ悪いし、選ぶ必要なんてないよ。どれも気に入ったから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（選ぶ？　そんな必要ないじゃん？　全部もらっちゃえばいいんだから！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "本当ですか？　ああ……とても嬉しいです。まさかご用意した服をすべて気に入っていただけるなんて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "それではこちらへどうぞ。ディナーをご用意いたしました。本日いらっしゃるとは思っていなかったものですから、急ごしらえしたものですが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彫刻の施されたロングテーブルにずらりと並ぶ豪勢な料理を見て、ローズソルトはひっそりと唾を飲んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "わぁ、すっごーい。みんな、本当に良くしてくれてありがとう！　ぜーんぶ大好物だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（ステーキ！　肉のスープ！　新鮮な鱗獣にフルーツまで！　あははっ、全部いただき！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "夜が更けると、ローズソルトは宝石を散りばめた本絹のパジャマに身を包み、ふかふかした羽毛ベッドに横になった。\nカーテン越しに差しこむ月明かりが柔らかな白い光となり、あたかも水のように天然石の床の上に降り注ぐ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あぁ……こんなにいい暮らしが……ついにあたしの手に！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "何があっても、ここから出て行くもんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "ぜーったいに！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数日が経過した。ローズソルトは首長の豪邸のなかにある、あらゆるものを堪能していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……むにゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "うーん……うん！　よく寝た……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "んー……今日は何を食べようかなぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "お嬢様、お目覚めでしょうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "お嬢様、お食事になさいますか？　近頃は肉をたくさん召し上がるので、お口に合うよう朝食をご用意いたしました。まずはお顔を洗うのをお手伝いいたします。その後、食事にいたしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あ、あ、あんたたちずっとそこにいたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "もちろんですとも、お嬢様！　ここの生活に慣れていただくため、私どもはこの数日、あらゆる角度からお嬢様の一挙手一投足を観察しておりました。おかげで今では自信をもってお仕えできます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あ、あらゆる角度から？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "ええ、私どもはお嬢様のお力添えに心から感謝しているのです。まさかお嬢様のような心優しい方がおられたなんて！　この屋敷で快適に、幸せにお過ごしいただけるよう、全力を尽くす所存です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あ、あたし……起きないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "動いてはなりません。私どもにお任せを！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "使用人は身体を起こそうとするローズソルトを抑えて彼女の背中に枕を当てると、バラの花の香油を染み込ませたシルクの布で顔を拭いてから、部屋着のドレスを着せた。"
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "起床のために、お嬢様のお手を煩わせることなどできましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "え……えっと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "ああ、お嬢様、なんとお美しいのでしょう……観察の通りなら、お嬢様は起床後すぐにお食事を望まれるはず――さあ、テーブルをこちらに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "え？　あ、あの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "わぁ、すごく美味しそう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "動いてはなりません。私どもにお任せを！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "もう一人の使用人がまたしてもローズソルトの手を抑え、テキパキとステーキを切り分けると、口元まで運んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "お嬢様のお手を煩わせるわけには参りません。さあ、お口を開けてください。あーん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "あーん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "どうなさいましたか？　お口に合わなかったでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（なんなのよ？　あたしのこと、自力じゃ食べることもできない三歳児みたいに扱ってくれちゃってさ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "ま、まさか～！　すっご〜く美味しいよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "いえ、お嬢様は今、私どもを拒絶なさいました。何か不手際があったに違いありません！　お好みを間違えたのでしょうか？　この肉がご不満でしたか？　それとも味付けが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（はぁ？　人から食べさせてもらうなんて変だって、誰も思ってないわけ！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "そんなこと！　料理はすっごくおいしかったよ！　ただその……できれば自分で食べたいなーなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "お嬢様、そのような仕打ちは私どもにはできません。ですが、どうしてもと仰るなら、お嬢様の指が痛まぬように柔らかいリボンで食器を包むことをお許しください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "さあ、このリボンで包んだ食器をお持ちになって……重くはありませんか？　手首やお手は痛みませんか？　やはり私が食べさせてさしあげましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "だ、大丈夫だって、こんなことしなくても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（クソッタレが、近寄んな！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "ああ……このような重い物を持たせてお嬢様を疲れさせるなんて、とても耐えられません……お嬢様には万事において快適に過ごしていただかなくては！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "ご自分で食事を召し上がるなんて。胸が引き裂かれそうです……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（助けて！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "う、ううん！　そんなことないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あたしはここで暮らせて、みんなの助けになれるだけで満足してるの。それなのにみんなを苦しめちゃうなんて、なんだかごめんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "自分で食べるほうが慣れてるだけなんだ。だから、そうさせてもらえたら嬉しいな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "わ、分かりました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……（笑顔で咀嚼する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（まったく、人が食べてるところをジロジロと！　クソっ、マジで消化不良になりそう！！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "おいしかった、ごちそうさま！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "ああ、お嬢様、お手は平気でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "お料理はお気に召されましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "ありがとう、とっても満足だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "でも食事をしたら、外に出て散歩したり、いろんなところに遊びに行きたくなっちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "ええ、外へ遊びに出かけるのですね。どちらへ行かれますか？　裏庭はいかがでしょう？　景観はとても美しく、お嬢様のために育てた様々なペットもおります。今から一緒に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "いやいや。分かってる。大丈夫だよ。ねぇ、みんなはあたしを満足させるのが仕事なんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "もちろんですとも、お嬢様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "ふふん、それならさ、分かってるはずじゃない？　あたしをもっと満足させるにはどうすればいいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "どうすればよろしいのでしょう……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あたしを一人で裏庭に行かせるんだよ。みんながついてこないだけで、あたしはとっても満足なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "……なっ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "じゃ、そういうことで！　絶対について来ないでね！　それだけであたしはとってもとーっても満足だから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "やあーっと外に出られたぁ！　クソッタレどもが、まったくなんなの？　へへっ……でもまあ、これでやっと自由の身だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "そういや、この庭もあたしだけのもんだって言ってたっけ？　これが金持ちの生活ってやつ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "ロッキングチェアは快適、日よけもバッチリ。涼むための氷もあるし、美味しいフルーツまで……だけどなんだか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "チッ……なんだかここでも視線を感じるな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……んー……いや、誰も見てないか。ただの気のせい……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花の中に隠れる使用人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "花の中に隠れる使用人",
      "text": "（小声）潜伏に成功しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "よくやりました。お嬢様から何か要望があれば直ちに私に知らせなさい！　くれぐれも見つからないように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花の中に隠れる使用人",
      "text": "（小声）了解！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "まあいっか、とりあえずこの綺麗な場所でうとうとしよっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……ふ……ふぁ、花が多すぎて、なんだか鼻が……クシュン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花の中に隠れる使用人",
      "text": "（小声）お嬢様がクシャミを！　クシャミをされました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "わかりました！　すぐにハンカチをそちらに送ります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "第二班及び第三班はお嬢様の周りの花を気づかれないように切りなさい。決して見つからないように……お嬢様のお休みを邪魔してはなりません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "クシュン……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "うーん……何か聞こえたような？　ミツバチかな……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "それにしても綺麗なところ。蝶々にミツバチ。空には飛び交う羽獣に、青い空と白い雲。\nそれに、ドローンまで……\nん？　ドローン……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あのドローン……ハンカチを運んでる！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "空からハンカチを持ったドローンが飛んでくる。その理由をローズソルトが悟る間もなく、チョキンと鋭いハサミの音が密やかに響き渡った。\n切られたバラの花が地面に落ちる寸前、茂みから伸びた手がそれを受け止め、すぐに奥へと引っ込む。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "な、何の音！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "チョキン！　チョキンチョキン！\nローズソルトは警戒しつつ周囲を見回した。しかし何も見つけられず、ただその場でぐるぐると回るばかりだった。近くには誰の姿もない。にもかかわらず、花はひとつまたひとつと消えていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（バカな……！　長いこと外で盗みをやってきたけど、あたし以上の早業をやってのける奴を見るのははじめて！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（こっちの茂みにも、あっちの茂みにもいない！　誰！？　何がしたいの！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "チョキン！\nそうして最後の一輪が白昼堂々消えていった。しかし、庭をどれだけ見回しても、彼女の他に人影は見当たらなかった。\nローズソルトは恐怖を抑えきれず、今しがた受け取ったハンカチを握りしめた。そこには小さなメモ書きが残されていた……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……「お嬢様！　私はお嬢様の使用人ではありませんし、お側にもおりません！　どうか、今すぐハンカチで口と鼻を押さえてください。花粉で喉と鼻をやられないように！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……うわぁ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "助けて――！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "花の中に隠れる使用人",
      "text": "（小声）はぁ……はぁ……！　無事任務を完遂しました。お嬢様には見られていません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花の中に隠れる使用人",
      "text": "（小声）ああ、そんな。ど、どうしたことでしょう！　お嬢様が悲鳴を上げて駆け去ってしまいました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "なんということでしょう。何か我々に落ち度があったに違いありません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "一体なに？　どういうこと？　一人で遊ばせてって言ったのに、近くでずっと身を潜めて監視してたってわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あいつら、全員おかしい！　もう逃げちゃったほうがいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "でも首長の報酬は大金だし、終われば追加報酬ももらえる。ここでの暮らしも最高なのに……まだ逃げるなんてイヤだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "クソッ、クソッ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "おお、お嬢様、こちらにおられましたか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "イヤだ！　もうあたしについて来ないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "い、今なんと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "えっと、いやその……あんたたち、さっきこっそりとついてきてたでしょ。そのせいであたしはとってもイヤな気分なの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "お風呂に行くから、今度こそ絶対についてこないでよね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "ああ、どういうことなのでしょう……きっと私たちが未熟で、お嬢様への愛が足りていないから、不満を抱かせてしまったに違いありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "はやく何かしなくては……お嬢様にここでの暮らしをご堪能いただいて！　我々の感謝の気持ちを受け取っていただかなければ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "これでほんとに一人になれたよね？　もう監視なんていないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "クソッ、いつまでここに隠れてればいいの？　あいつらほんとに近くにいないかな……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……ダメだ、こんな風にただ待ってるだけなんて大損だよ！　ここは首長の娘の浴室で、アロマオイルに花びらもある……せっかく来たんだし、一度くらいお風呂を堪能しておかなきゃ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "お湯を出して、アロマオイルを垂らして、花びらを浮かべて……\nん……？　これって……？\n浴室の床に大きな穴が空いてる？　どうしてこんなところに？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "うわ、これもしかして地下通路に通じてるの？　首長の娘の浴室にこんなものがあって、塞がれずに残ってるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "もしかして……中に何かあるのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "この地下通路、長すぎじゃない……？　照明までついてるし……一体どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "壁に文字がある。「皆の愛が重すぎてもう耐えられない！」「何をするにも周りに人が群がって！」「自由がない。もう出ていく！　こんな暮らしはたくさんよ！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "これって……まさか本物の娘が書いたもの？　どおりで家出したわけだよ！　クソッ、あたしだってあんな奴らもううんざり。今すぐ出ていきたい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あっ、この地下通路、外に通じてるっぽい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "待って、てことはここから外に出られるじゃん？　それなら毎日お風呂に行くふりをしてここから出て、夜に戻って来れば……いい暮らしを楽しみながら、あいつらの監視から逃げられるんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "そうだ……きっとそう。早く出よう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "もうすぐ出口だ！　外に出られる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "あと少し、あと少しで、あたしは自由の身だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……おや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "わぁ！　誰！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まあまあ……お風呂の時間を利用して逃げようとするなんて、本当にお嬢様とそっくりですね。この地下通路は以前お嬢様が掘ったもので、私どもがわざと残しておいたのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "助けて――！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "五日後"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "素晴らしいです、お嬢様。この数日はお嬢様のお手を何ひとつ煩わせていませんから、お顔によりツヤが出てきましたね！　ああ、良かった。これで私もひと安心です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "入浴も終わり、お身体にはパウダーをはたいて香油を塗り、美しいドレスにお着替えもできました。さあ、儀式に向かわれても結構ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "儀式では黄金のお椀を満たした水に柳の枝を浸し、その水を黄金のお皿に振りかけるのです。たくさん水がかかるほど、儀式は成功です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "分かったよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（クソッタレ！　もうたくさん。やっとこの日が来たんだ。金稼ぎなんて面倒なことはさっさと終わらせて、こんな場所とはおさらばしなきゃ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "さあさあ、お嬢様。今日のお姿はとても素敵です……行って、儀式を完成させましょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ローズソルトは長いドレスの裾を持ち上げ、シルクの靴を履いた足で羽毛を敷き詰めた通りを歩いていく。\nその横では住民たちが期待に満ちた目で彼女を見つめ、儀式の成功を心待ちにしている。\nローズソルトは五重、六重に重ねたドレスの中で息を切らせ、身体中に塗りたくられたパウダーと香油の匂いに包まれ、二時間もかけて編まれた複雑な三つ編みを頭に乗せながら心を決めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（やった、ついに抜け出せた！　今日逃げなきゃ、次のチャンスはいつになるか！　儀式の後の追加報酬なんざクソくらえだ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（金は懐に忍ばせてあるんだ、もう逃げよう！　こんな儀式ぶち壊して、逃げ出してやる！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する住民",
      "text": "お嬢様、お嬢様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幸せな住民",
      "text": "お嬢様が祈祷を捧げれば、儀式はきっと成功します！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（金碗を地面に叩きつけて、視線を遮るために羽毛を散らしたら、煙を出す薬草の束を火に投げ込む……大丈夫、それできっと逃げられるはず！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "お嬢様、ご心配には及びません。疲れたら仰ってください。私が目的の場所まで背負ってさしあげますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "ああ、お嬢様、金碗は重くはありませんか？　ここは私がお持ちして、目的の場所についてからお渡ししましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "おお、我が子よ……我が愛し子よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（がああ、こいつらときたら……！　二度と会うもんか！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "（よし、今だ！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ローズソルトは隙を見て、複雑なドレスを引きちぎった！\n脳内では、これまで逃げてきた時と同じように俊敏な身のこなしで瞬く間に姿を消し、残された人々は互いに目を見合わせて何が起きたかすら理解できない……そんな情景が繰り広げられていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし現実は、シルクの靴と羽毛に足を取られて派手に転んだ。羽毛が舞い散る中を金碗と薬草の束が四方八方に飛んでいく。そして彼女は大の字になって地面に倒れ込んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……終わった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし意外にも周囲からは歓声が上がった。"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する住民",
      "text": "ああ、お嬢様！　これは奇跡だ、かつてない奇跡が起きたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幸せな住民",
      "text": "金碗が金皿にぴったりと収まって、水が一滴もこぼれていない！　これは神の御業だ。お嬢様、感謝します！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する住民",
      "text": "ありがとうございます、お嬢様！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……え、え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "ああ、なんてことだ。我が子よ！　まさかこのようなことが……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "助けてくれただけでなく、これほど見事に祈祷を成功させるとは……本当にいい子だ！　感謝のしるしに、宝石の袋をいくつか用意してある。ぜひ受け取ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過保護な使用人",
      "text": "ああ、お嬢様！　それでこそ私どものお仕えする御方！　さあ起きてください。儀式はこれまでにないほどの成功を収めました。本当にお見事でしたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな使用人",
      "text": "ああ、涙が……涙が止まりません……！　どうか私の手をお取りください。御輿をこちらに用意してあります。屋敷へお送りして、それからディナーにいたしましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……イヤだ！　もう勘弁してよ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ローズソルトは首長から受け取った宝石を懐に抱え、大声で叫びながら地面から跳ね起きると、一目散に数百メートル先まで走って逃げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "おお、我が子よ。どうしたのだ、何故逃げる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "首長",
      "text": "儀式がこれほどの成功を収めたのだ。来年も是非来てくれ！　次も頼んだぞ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "フン！　誰がやるか！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "半月後"
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーターA",
      "text": "最新版の『サルゴン寓話』か。噂じゃ今回はいくつかの物語が一新されてるらしいな。中でも『首長と娘』が最高傑作らしいぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーターA",
      "text": "首長が二人の娘に立て続けに家出されて、辛い日々を送るという話だそうだが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーターA",
      "text": "おかしな話だよな。そんなにいい暮らしを嫌がる奴がいるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーターB",
      "text": "ほんとよね。見てよ、この宝石、庭園、衣装、それに食事……こんなに贅沢な暮らしから、どうして逃げたがるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーターB",
      "text": "そんな風に思い詰める人がいるなんて信じられないわ。ねえ、そう思うでしょ、ローズソルト？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズソルト",
      "text": "まぁ……あんたがそう思うなら、そうなんじゃない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
