  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act5d0/level_act5d0_04_beg.txt",
  "sourceHash": "03f0ffa31e02c5b109fddecb4b7efb1ff656b1f3c21e46c214145bf8781ad835",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）\np.m.07:59 天候/曇天\n龍門人工河川 埠頭"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "船員",
      "text": "もう二度と船に飛び乗るんじゃないぞ！　危ないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ごめんなさい、これには理由がありまして……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ところで、いまサンクタの人を見ませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船員",
      "text": "いや見てないな。本当に勘弁してくれよ。このキャンディーは今夜のパーティーに使うものなんだ。もし配達が遅れたらタダじゃおか……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船員",
      "text": "さ、サンクタ……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "はっ！　モスティマさ——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "モスティマ？　君、モスティマを知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……すみません、人違いでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "（この人、どこかで見たことがあるような……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船員",
      "text": "コホンッ、とにかく今回はこのぐらいにしておいてやるが、もう二度とこんな危ない真似するんじゃないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ご、ごめんなさい。本当にお騒がせしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "うーん……フォルテの子供……なんとなくなにか忘れてるような……なんだろう……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "わっ！？　な、なにするんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "君の角にキャンディーがひっかかってるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あっ、本当だ。返しに戻った方がいいかな……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "それから、この角、思い出したっ！　あのフェンツのロゴマークと同じだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "君はフェンツ運輸の若旦那くん、そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "わ、若旦那くん……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ところでソラ先輩、この道で本当にテキサスさんたちと合流できるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "安心して。テキサスさんが何を考えてるか、手にとるように分かるんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "はぁ、そうなんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……この声、やっぱり聞き覚えがあるような。一体どこで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "「先輩」かぁ～、えへへ、あたしにもトランスポーターの後輩ができる日がくるなんてー！　みんなについてはどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "皆さんにお会いした感想ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "とても……えーと……その…刺激的でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あはは……。どんな状況だったのか分かっちゃいそう……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あっ、ごめんね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "ちゃんと前見て歩けよ！　チッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "おい、ぶつかってきたのはそっちでしょ——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "あ？　てめぇには関係ねぇだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "なんだと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "いいよいいよ、ほっとこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "でもあいつ、ぶつかったときにソラ先輩の財布を——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "へへ、知ってるよ。でもあのお財布には、パンプキンキャンディーしか入ってないからいいの。本当のお財布はこっちだよ、ほら～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "「トリック・オア・トリート」ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あいつはトリックしたかっただけだし、それに今日はハロウィンではなく……。どうしてわざわざそんなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "龍門は最近、色々なことがあったからね。今はそう見えないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "安魂夜の暖かなロウソクって、この都市の隅々まで照らしてくれるわけじゃないから……。光の当たらない子たちが可哀想で……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "えへ、でも実はとっさの思いつきなんだけどね。悪くないアイデアでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "もし財布が盗まれたのがぼくだったらどうするんですか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "この先を抜けると、合流場所に着くよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ここは……公園ですか？　一体なにが……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "見て、やっぱりあそこにいたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "もご――もごもご、もごっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ヘイ、これ以上口を割らない気なら、火を点けちゃおうかなぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "おい兄ちゃん、ええかげん白状せんとアカンでぇ。この花火でホンマに天国行きにしよってもええんやで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……お前たち、そいつの口に貼ってるテープを剥がしてないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あっ、そうだった。ごめんごめん、えいっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "――――――！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "てめぇ、この野郎！　俺らがどこのモンなのか知っててやってんだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……シラクーザの、マフィア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "うっ、オメエ、て、テキサスか……俺ら…お前らなんかにビビると思うなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ハイハイ。分かってるって。うちのボスの秘蔵品をぜーんぶ吹っ飛ばしちゃったしさ。アソート缶爆弾なんて、ほんっと子供じみたトラップだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "……何言ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "俺はアソート缶爆弾なんて知らねぇぞ、バカバカしい！　ウチのボスが手ぇ下して、そんなんで済むかよ。お前らなんてすぐ木っ端みじんに——うぶっ！　もがが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんかコイツ生意気すぎるんだけど。やっぱり打ち上げちゃう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "我慢しろ、エクシア。こいつに喋らせてやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ぶはぁっ――お前らはなぜ龍門の連中が俺たちのことを見て見ぬふりをしているのか、不思議に思わないのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いや、別に毎月警察署に行って、公共物破損の罰金をちゃちゃっと払えば、普段は私たちにも見て見ぬふりをしてくれるよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "マジかよ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ちょいとエクシアはん、話の腰折ったらアカンでぇ。ええから続けてドーゾ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "この…余裕こきやがって……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "あの方はな、俺らのペンギン急便への動きを全て黙認したんだよ。同じ龍門のグレーゾーンにいるモノなら、これが何を意味してるのか分かるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いやいや、あたしたちは、合法的な営業許可証を持ってる運送会社だよ？　それに運営状況も別に悪くないし？　一緒にしないでもらいたいね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だからなぜ毎回私たちの扱いがこんな……はぁ、まぁいいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それであの方とは、誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "しかもその意味ありげな言い方、ほんとアホっぽいよね。雑魚感がタダ漏れっていうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "お前ら、まだシラを切るのか！？　鼠王はな——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "お～い！　テキサスさん！　みんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あっ、ソラ！　やっほ～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "なんや、バイソン坊も一緒みたいやな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "へへ、途中でぼっちになってたバイソンくんと偶然会ってね。連れてきちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……皆さん、ここで何をしているんですか？　エンペラーさんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ボスは確認したいことがあるって、どっかに行っちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ソラ、他にここに来るときに会った人は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "え？　いない……と思いますけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん？　なんであたしを見んの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "な、何でもない。とにかく今の状況はバイソンくんから聞いたよ。これからどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まずは、こいつから聞けることを聞き出して、後は臨機応変ってやつかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "待ってください、エクシアさん。あの……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "実は、さっきモスティマさんという方に偶然会ったんです。でも、途中でいなくなってしまって……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "えーと、つまり、ぼくたちはマフィアの包囲網から抜け出して、そしたら彼女は——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……彼女のことは心配ないよ。よくあることだからさ。あいつ、急にいなくなったと思ったら、数年間も音沙汰ないなんてこともあり得るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "——数年間？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやなぁ。そういや、ウチもこの会社入ってから、モスティマはんの顔なんて見たの数えるぐらいやわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あはは、エクシアのためにも、この話はもうこの辺にしといたほうが……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "やっぱり……常識というのが通用しないんですね……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "トランスポーターとしての彼女は特殊だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ボスと契約を結んではいるものの、それよりも彼女はラテラーノの——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "——エクシア、ボーっとしてないで、マッチに気をつけて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あっ、ヤバっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ふんご――もごもご――！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あっちゃ～。こら手遅れやわ。やらかしよった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ふがが――！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "何事だ、いまフロンゾの叫び声が聞こえたぞ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "あっちの方からだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "へぇ、本当に人間を天まで連れて行けるんだぁ。あの花火、やっぱ凄いんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "奴らが来たぞ。左右で二手に分かれて対処する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
