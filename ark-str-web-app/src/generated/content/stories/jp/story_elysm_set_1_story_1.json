{
  "server": "jp",
  "storyId": "story_elysm_set_1_story_1",
  "groupId": "story_elysm_set_1",
  "stageId": null,
  "title": "長き旅路",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_elysm_1_1.txt",
  "sourceHash": "e7c2062c4a2f359f4c3d6e64abb65138c54afb3e27218f433cb0c865a149ee6d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "店主さん宛ての手紙、ここ置いとくよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "午後に街へ行くから、もし買ってきてほしい物があったらリストに書いといてね。さっさと行っちゃうから、書き忘れても苦情は受け付けないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "あらま、もう返事が届いたのね！　エリジウム君、ありがとー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "また街へ行くのかよ？　今回もあれか、お前のその……なんとか送信機のために？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "なんとか送信機じゃなくて、「信号送受信機」ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "中古品だから通信範囲はそんなに広くないんだけど……それよりこのボディのカラーを見てよ！　僕のコーデにぴったりでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "俺にゃお前のファッションセンスとやらはよくわかんねぇな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "おう若造、街でタバコを買ってきてくれんか。前のと同じやつで構わんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "私は最近街で流行ってるヘアアイロンが欲しいわ。頼まれてくれるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "オーケーオーケー、あの最新式のヘアアイロンね、覚えとくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "おい若造、わしのも忘れずに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "あのさー、前回僕にタバコを買ってこさせた結果、家族にバレてお小遣いまで没収されたのは誰だったっけ？　僕はちゃんと覚えてるんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ま、あと四、五十年経ったら僕も忘れるかもしれないし、それまで待つことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "……長すぎるわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "ちっ、最近の若いモンはおせっかい焼きで口うるさいのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "エリジウム君、こんな人放っときなさい。お医者さんにいくら禁煙しろって言われても聞きゃしないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "ほらこれ、ヘアアイロン代。よろしく頼むわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "任せといてよ。一番おしゃれなやつを選ぶからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "じゃ、行ってくるね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "――故郷を離れてから何年経っただろう？\n三年だろうか？　いや、三年目にはまだクルビアにいたはずだ。それからそのまま北上し、サーミへ辿り着いて――\nさらに北上しようとしたところで、現地の雪祭司に引き止められ、やむなく進路を変えて旅を続けたのだった。\n健康な大人で、さらに多少のアーツの心得があれば、選り好みさえしなければ日々の暮らしにはそう困らない。\n旅費が底をつけば現地で仕事を探し、お金が十分に貯まったら再び出発する――進んでは止まり、止まっては進み、エリジウムは思うままに様々な風景を見てきた。\n豊かで栄えた地も、貧しく荒んだ地もあった。\nこの町で足を止めたのも、特にこの地に特別なものを感じたからではない。\n休みなく動かしてきた足を、少し休めたかっただけだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "最新式のヘアアイロンと、それから……うん、タバコ一箱だけならそこまで身体に毒じゃないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "発信器の方は……増幅器以外は揃ったけど、その増幅器がなかなか見つからないんだよなぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "それにしても、この空……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "なんだか嫌な感じがするなぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "この天気……何だか妙だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "おっ、気が合うね。実は僕も何かおかしな感じがしてさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "というかその恰好……ここの店員さんであってるよね？　逃げ遅れた強盗犯が店員のフリをしてるって言われても信じちゃうよ。何を売ってるか知らないけど、今日は商売あがったりなんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "……余計なお世話だ。そもそも俺たちは単なる商人じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "へぇ、でもそれ売り物じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "これは──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "今後普及させる予定の予防薬だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "予防薬？　そりゃすごそうだけど、まさか鉱石病の予防なんて言わないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ほんとに効果のある予防薬は目が飛び出るほど高いって聞くよ。本物は大金持ちしか買えないし、一般人でも買えるものはほとんど効果のない偽造品ばかりだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "いや、でも僕は人を見る目があるからね。君らは偽物を売りつけるような輩には見えないし、まさか本物……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "お前、聞こえているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "おしゃべりな奴だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "情熱的と言ってもらいたいね。情熱は人付き合いを円滑にしてくれるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "特に、見るからに危なそうな人物と交流する時は必需品さ。もしかしたら僕は今、見ちゃいけない物を見てるのかもしれないしね。例えば――出処不明の予防薬、とか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……君たちがこれから僕をシメるつもりだとしても、きっとこれで手加減してもらえるはずでしょ。特にそこのマスクのお兄さんは、情に厚い人だろうからね。僕にはわかるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "……そんなわけあるか。おもいっきり顔面を殴りつけてやるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "照れなさんなって、素直になりなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "それにさっきも言ったけど、君たちは偽の薬を売る詐欺集団とか、密売組織には見えないから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "当たり前だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "私たちは……製薬会社だ。感染者問題を片付ける組織だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "へぇ。片付けるのは「感染者が抱える問題」？　それとも「感染者そのもの」？　――なんて、君たちが相手じゃなきゃそう聞いてたかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "まったく、おしゃべりもいい加減にしろよ。ぶん殴られたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "いやいや、暴力は反対だよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "まぁいいや、だいぶ時間食っちゃったし、僕ももう行かなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "じゃあ最後に一つアドバイスだよ――君も隣のその人も売り子には向いてないと思うから、別の人に変えるべきだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "余計なお世話だ、いいからさっさと行け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "受け取れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "うわっ！　飛び道具で不意打ちなんてひどい……って、これは例の予防薬？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "もしかして僕にくれるの？　そんなの申し訳ない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「寡黙な女性」",
      "text": "3ターレルだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "やっぱりお金取るんだ！？　まぁ、高くはないからいいけどさ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "隊長……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "さっきのあいつ、独り言ってわけじゃないですよね？　まさか隊長と会話してたとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "でも隊長は……そんなのあり得ませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な女性",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "悪いねぇ、お客さん。お求めの増幅器は品切れみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そりゃないでしょ店長さん、ここが最後の希望なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ほんとに、もう一個もないの？　倉庫の隅っこに埋もれてて気付かなかったとか……そんな可能性あったりしない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "探せるとこは探したし、うちは仕入れた物も売った物も全部記録してるから、間違いようがないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "わかった、わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "あんた、うちは初めてじゃないよな。前に直したいって言ってた機械のためかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そうそう！　見てよこの信号送受信機！　全部この僕が自分で改造したんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "この手の知識なんてすっからかんなんだけどさ、独学で改造してみたら意外とうまくいっちゃってね。いやー、我ながら自分の学習能力の高さには驚かされるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "あとは、これにぴったりの増幅器さえ見つかれば、こいつの性能はもうワンランクアップするってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ねえ店長さん、僕ってトランスポーターに向いてると思わない？　僕のアーツはそういう仕事にはもってこいだし、こんな逸材が埋もれたままなんてもったいないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "ははっ、送信機さえ持ってりゃ誰でもトランスポーターになれるわけじゃねぇだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "たしかテストがあるんだよね？　言い忘れてたけど、僕は故郷では一夜漬け四天王って呼ばれててね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "良い意味の呼び名にゃ聞こえないんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "まぁとにかく、テストへの対応力ならピカイチってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "はぁ、くだらねぇ話はこの辺にして……増幅器だったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "あんたが欲しがってるモデルは普段あまり出回らない物なんだが、時間をくれれば仕入れられないか試してやってもいいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "全然オッケーだよ。しばらくこの近くの町に留まる予定だからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "じゃあそういうことでお願いしてもいいかな。またしばらくしたら来るから――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ放送",
      "text": "――緊急速報、緊急速報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ放送",
      "text": "ただいまより、市民の皆様に重要な速報をお届けします――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "ずいぶん真剣に読んでるな。誰からの手紙だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "いいから邪魔しないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "やった！　やったわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "あ？　何がやったんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "ふん、大方あのエリジウムとかいう若造に関することじゃろう。大都市に異動になったあの……なんとかトランスポーターの名前が署名されておるしのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "「天災トランスポーター」さんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "エリジウム君がこの町に来てずいぶん経つから、いつまでもうちの狭い部屋に住んでもらうわけにもいかないと思ってたのよ。部屋の費用だって馬鹿にならないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "だからダメ元で天災トランスポーターさんに手紙を書いてみたんだけど……あの人の家をエリジウム君に使わせてもいいって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "……あいつめ、そんなお人好しだったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "何の話をしてんだお前ら。天災トランスポーターさんが何だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "この町には、もうずっとトランスポーターなんて来てないだろ？　エリジウムが前に、「もしかしたら僕がこの町の常駐トランスポーターになるかもね」とか何とかぬかしてやがったけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "……実は、昔はこの町にも天災トランスポーターさんがいたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "町としてもその人にはずっといてほしかったから、わざわざ住む家まで与えたんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "しかし、こんな寂れた町に留まる物好きもおらんし、しばらくしたら出ていきおったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "思い出しただけで腹が立ってきた……もういい、わしゃ先に帰る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "まぁ文句は言えないけどね。大都市でもらえる報酬は、うちみたいに辺鄙な町のものとは比べものにならないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "構わねぇさ、出ていきたいやつは出ていけばいい。俺たちゃてんで気にしねぇ！　それに、今はエリジウムのやつもいるじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "あいつはなぁ、「プロのトランスポーターになるための第一歩は、いかしたコードネームだ」とか言って、仕事用のコードネームまで決めてやがんだぜ。冗談で言ってるわけじゃなさそうだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "あはは、本気だといいんだけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "うわっ……どうしたのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "おい！　大変だ！　早く出てこい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "空が、空がおかしいんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "南西部方面か……うちの仕入れルートにもないし、気にする必要はなさそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "あんたの希望商品の仕入れにも影響はないはず――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "店長さん、代金は先払いでここに置いてくよ！　絶対入荷しておいてね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "商店の店主",
      "text": "おい待て！　兄ちゃん、いきなり走り出してどうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "走らないわけにいかないでしょ。今回はまさに文字通り、天災との駆けっこになるんだからさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "今戻れば、自ら大きな危険に飛び込むことになる。\n果たして自分はあの小さな町に、そこまで深く入れ込んでいたのだろうか？\n――いいや、決してそうとは言えないだろう。たった数ヶ月過ごしただけの田舎町に、命を賭すほどの思い入れなどないはずだった。\nだがそれと同時に彼ははっきりと理解していた。自分には絶対に、ここでただ黙って眺めているような真似はできないことを。\nだったら、できもしないことを考えるのはやめにしよう。\n今は自分に何ができるのかだけを考えるべきだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怖がる子供",
      "text": "ママ、どうしてお空におっきくて真っ黒な雲ができてるの？　怖いよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おろおろする母親",
      "text": "だ、大丈夫よ。今からパパのところに行きましょ、怖がらなくていいわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "取り乱す女性",
      "text": "じ、地震！？　どうすればいいの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した男性",
      "text": "誰かこの板をどけてくれ！　急に崩れて来やがって、足が……足が動かせねぇんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "待ってろ！　今助けに行く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "何てこった、こりゃ一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "て、天災だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "前の時と同じだ！　急いで逃げねぇと！　できるだけ遠くまで行くんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "あぶねぇ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ふー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "完璧なヒーロー登場シーンだったよね。もし僕が審査員なら、今の身のこなしには間違いなく満点をつけていたよ。ねぇ、君たちもそう思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "エリジウム君……！　ケ、ケガしてるじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "どうして……街へ行ったんじゃなかったのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "心配いらないよ、かすり傷だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕の第六感が、君たちのピンチを察知して――ってウソウソ、この辺が天災に巻き込まれるって聞いたから、戻ってきたのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "どうだい、僕ってすっごく義理堅いでしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "こっ、こっ、このバカ野郎！　鳥頭！　こんな時に戻ってくるやつがあるか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ちょっと、何でそんな罵倒されなきゃなんないのさ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ま、冗談はここまでにしとこうか。今はそんなことしてる場合じゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "みんなで手分けして、町のみんなに今すぐ避難するよって伝えてくれるかな！　突発性天災はあっという間に強まるから、これ以上留まってると本当に手遅れになっちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "避難って……どこに避難するっていうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕に任せといてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "こう見えてサバイバルのプロだからさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "みんな、離れ離れにならないようにぴったりついてきてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "天災の環境下では空気中の源石濃度も急上昇するし、強風に乗って活性源石の粒子も飛んでくるかもしれないから、なるべく素肌を晒さないで！　それと、絶対に傷口を作らないように気をつけてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "じゃあ、あなたさっきのケガは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "心配しないで、僕には秘密兵器があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（さっきもらった薬をすぐ使うことになるなんて……さすがに予想外だよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（偽物じゃないことを祈るしかない、か……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "みんな、あと少しだけ頑張って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "目的地は……すぐそこだから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ハッチをしっかり閉じて……よし、これで当面は安全なはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "ここは……地下避難所か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "その通り、既に廃棄された避難施設さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "こんな場所があるなんて聞いたこともなかったが、よくたどり着けたな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "自慢じゃないけど、この辺の土地勘じゃ僕の右に出る者はいないだろうね。付近一帯の地図を描くために、周辺の荒野全域をこの足で測量して回ったんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "つまり、この辺に僕の知らない場所はないってわけ。廃棄された避難所を見つけるくらい朝飯前さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "何が言いたいかって言うと……もっと僕のことを褒めてくれてもいいんだよってこと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "へ？　そ、そうね……えーと……かっこいいわ、エリジウム君！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ありがとう、そういう風に事実を言ってくれればいいのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "……ふんっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "あー、ま、まぁ確かに感謝はしてるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "それより、急いでたから何も持ってきてないんだが……どれくらいここにいりゃいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "少なくとも天災が去って、外の環境が正常に戻るまでだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "でも安心していいよ。突発性の天災は、降りかかるのも去っていくのもあっという間だからね。そんなに長くはかからないはずさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "……もしお前が戻ってこなけりゃ、俺たちゃ今頃どうなってたことやら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "いいって、気にしないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "でも今後はちゃんとした災害対策を考えないとね。この避難施設もあちこち老朽化してて、正直あまり安全とは言えないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "もし今回の天災が、地層から地上に向かって伸びる源石クラスターを伴うものだったら、この場所も危なかっただろうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "はぁ……俺たちじゃ天災に太刀打ちできねぇってことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "事前に天災が来るってわかってりゃ、多少準備はできるんだろうけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "あんまり悲観的になっちゃダメだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "それに、そういう問題を解決するために僕がいるんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "はいはい、そいつはありがてぇことで……それより、さっきから何をいじくり回してんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "機械を調節してるのさ。周囲数キロに向かって「救援求む」って叫ぼうとしてると思ってくれればいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "まぁ今使う必要はないけど、備えあれば憂いなしってね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "また地震ね、怖いわ……一体どれくらい続くのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "ひっ！　な、なに今の音！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "何かが崩れてきたみたいな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "見てくるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リーベリは人混みをかき分けていく。灯りの乏しい避難所内は、町民たちでごった返していた。\n状況が飲み込めず首を傾げる子供を、おろおろと慌てふためく母親が抱きしめている。老人は身体を縮こまらせ、まるでしわだらけの彫像のように隅の方にじっと座っている。\n時折、押し殺したようなすすり泣きも聞こえてくる。ここに集まった頭数が、記憶にある町民の人数よりも少ないような気がしたが、エリジウムはそんな考えを頭の奥底に追いやった。\n大きな音がした方向には、避難所の出入口であるハッチがあった。年月を経たほこりが、震動によってエリジウムの顔にパラパラと絶え間なく落ちてくる。\nふと、彼はある不吉な予感を抱いた。\nリーベリは手を伸ばすと、ほどなくして呆然と立ち尽くした。\n調査の結果、あることに気づいたのだ――\n外に通じるハッチが岩石によって塞がれ、いくら強く推しても開かなくなっていることに。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "閉じ込められただって！？　そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "何を慌てとる！　ただ崩れてきた物に塞がれとるだけじゃろうが。天災が去ってからわしら全員で掘り進めればよかろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "みんな落ち着いてったら……僕の信号送受信機の存在を忘れないでよね。実はさっき救難信号の送信に成功したから、あとは待ってるだけで大丈夫だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "ほ、本当？　よかった……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（とは言ったものの、増幅器がないんじゃ、信号が届く距離は相当限られる……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（他に何か方法を考えなくちゃ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（予防薬を使う暇もなかったな……ケガした腕の感覚がなくなってきてる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（服一枚を隔ててたとはいえ、さっきまでずっと源石粉塵が漂ってる環境で動いてたから……ちょっとマズいかな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（まさかここまでツキに見放されるとはね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（でも、今の状況に限っては、ある意味ラッキーだったって言えるかも……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "何だか外が静かになったみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "いいニュースだね、どうやら天災はもう去ったみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "まだ救難信号の返事は届かんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "今のところはまだね。でも朗報だよ、僕の頑張りによって発信範囲が広がったみたいなんだ！　天災ももう過ぎたから、すぐに救援が来てくれちゃったりしてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "そうだといいが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "エリジウム君、ケガがひどくなってきてるように見えるけど……秘密兵器とやらは使わないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "えーと……その、今はまだ使うべき時じゃないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "大丈夫大丈夫、必要になったら使うからさ。必要になったらね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "くそっ、この上にゃどんだけ土砂が溜まってるんだ？　いくら掘っても光が見えねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "食いモンも飲みモンもねぇし……このままじゃまずいぞ！　まだ外からの返事は来ねぇのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "焦らないでってば。掘っても無駄そうなら、ひとまず体力は温存しておこうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "これが焦らずにいられるかよ！　お前が信号を発信してからもうどれだけ経ったんだよ！？　まだ何の音沙汰もねぇんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "誰も助けになんざ来ねぇのさ！　このままじゃ、ここにいる全員が飢え死にか、さもなきゃ窒息死だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕に考えがある……もし近くの移動都市と連絡が取れれば、誰かが救援に駆けつけてくれるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "そのオンボロじゃそんな遠くまで連絡できねぇだろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そうだね、そこでこの男前の僕がとっておきの秘術を披露するってわけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "でも一つ注意してほしいことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "これからみんなには、僕からなるべく離れていてほしいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "離れるって？　そりゃどういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "それは……うーんと、文字通りの意味だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "一人になれる空間がほしいのさ。絶対に近付いちゃダメだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "もう……何日目なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "もう、ダメ……これ以上は身が持たないわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "もう少しだけ頑張って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "いつまで待ちゃいいんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "発信範囲がどんどん広がってる……やっとコツが掴めたんだ！　ほんとにもう少しだけ……もう少しだけ耐えてくれよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "もうおしまいだ、みんなおしまいなんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた町民",
      "text": "逃げ遅れた奴らも、わしらも……みんなおしまいだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ちょっと――ゲホッ……そんなネガティブな話はやめてよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（もっと急がないと、こうなったら……もっともっと強くだ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（感染者問題を片付ける製薬会社……だったよね。期待を裏切らないでくれよ！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ゲホッ、ゲホゲホ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（傷口がずいぶん腫れてる……こりゃ多分化膿してるね。全身が同じように痛むよ。前にレム・ビリトンの旋盤機に身体を挟まれた時みたいな感じ……いや、あれよりもっと痛いかも。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（アーツはどんどん強まってるけど……痛みも増してる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（これが鉱石病の感覚なのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "（貴重な予防薬は、残念ながらもう役に立たないね……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "何の……音……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……まさか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "応答があった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "……応答……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そうだよ！　応答があったんだ！　基地局が僕の信号をキャッチして……返事をくれたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "みんな聞こえたでしょう？　もうひと踏ん張りだよ、救援はもうすぐだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "ここで合ってるよな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "あの信号……どうしてああも正確に俺たちの位置を捕捉できたのかは見当もつかんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マスク姿の変わり者",
      "text": "しかしロドスはいつの間にこんな有名になったんだ？　まだ活動を始めて間もないんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "隊長、地下に大量の生体反応を確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "準備完了、いつでも救援可能です！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "いらっしゃ……ああ、エリジウム君じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "おはようみんな。それにしてもすごいじゃない！　しばらく来ないうちに、こんなに復興が進んでるなんて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "え、ええ……あなたのおかげで、私たち全員無事だったんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そりゃよかった、僕も頑張った甲斐があったってもんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "とりあえず、雨風をしのげる程度の簡単な家を建てただけだしな。このくらいならすぐできるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "……ここ最近どこに行ってたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕かい？　僕の方は悪人っぽい見た目のお人好しに連れられて、病気の治療に行ってたんだよ。それにしてもこっぴどく叱られちゃってさ……あんなに怖い医者がいるなんて知らなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "病気って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "と、とにかく座って。すぐに飲み物を出すわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "いやいや、お気遣いなく。ちょっと話したらすぐ出るからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "もうすぐここを離れようと思ってるんだ。今日はみんなにお別れを言いに来たんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "い、行っちまうのかよ？　でもあんた言ってたじゃねぇか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "あー、ここにトランスポーターとして残るって話ならごめんね。僕が一方的にすっぽかしたってことになっちゃうけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "悪いね、やっぱり僕は色んな景色を見てみたいらしいんだ。自由の翼は縛られるべきじゃない……って、どう？　君がコソコソ楽しんでた詩集から拝借した言葉だけど、かっこいいでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "ダメよ、エリジウム君。ま、まだ恩返しできてないもの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "そうだぜ。ただの病気くらい……大したことじゃねぇさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "もし鉱石病が理由で出て行こうとしてるんなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "はいはいそこまで。みんなの厚意は十分伝わったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "でも町に感染者が住んでたりしたら、みんなビクビクしながら過ごすことになっちゃうでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "あんたのことを怖がったりするもんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "……うん、わかってる。でもリスクが減るわけじゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そんな顔しないでよ、実は僕にとっても良いことなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ロドス――って、みんな覚えてるかい？　僕らを助けに来てくれたあの会社だけど、あの人たちについていくつもりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "あの人たちったら、僕に長期的な治療サービスを提供してくれるなんて言うんだよ！　こんな幸運そうそうないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "彼らなら……あなたの病気を治せるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "それは……どうだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気さくな店主",
      "text": "じゃ、じゃあまた戻ってくる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "もちろん。時間ができたら必ずみんなに会いに来るよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい町民",
      "text": "じゃあそのロドスはこれからどこに向かうんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "それについては、僕もよく聞いてないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "まぁ、ついてけば分かるでしょ。今回は何だか素敵な旅になりそうな予感がするよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
