  "sourceHash": "353b87f0aa10dd0e78d0e41e9db1099c8bb41631a304e9e74b7d6aae77797dc6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "みんな大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "だ、大丈夫ですけど、建物が丸ごと消えちゃいましたよ……。あれはいったい何なんですか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君は？　さっきアーツのど真ん中を突き抜けて来たでしょ、いつも無茶するんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふっ、いま気付いたんだけど、あの長い髪を切ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ちょっと！　笑うことないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "もう頭は砂まみれだね。ショートでもちゃんとお手入れしてあげないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしは大丈夫。ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……ありがとう？　私たちって、もうそんなに他人行儀な仲になったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしは誰に対してもお行儀が良いの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フフ、そうかもしれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ただ君がいつも業務時間中に昼寝をしたり、教会の外でロックのライブをしたり、何かやらかすと公証人役場の人に三つ先の街まで追いかけられたりしてなければね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君にうっかり爆破された母校なんて、君がラテラーノを離れた日には横断幕まで掲げてたんだよ？「エクシア、龍門にいってらっしゃい」というね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "な、何これ？　旧友との集まりって黒歴史の暴露し合いが必須項目なわけ？　い、いいよぉ、じゃあ次はあたしの番ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ああ、構わないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……だ、ダメだ、そういえば、あたしってばキミの黒歴史をあんまり知らないっぽい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "良い子は、あまり知りすぎるのはよくないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "キミはあたしのお姉ちゃんか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まぁ、そんなもんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "（この二人、仲がいいな。同じラテラーノ人だから？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "（それにエクシアさんが手綱を握られてるなんて……。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あのさ……モスティマ。ちょっと気になることがあるんだ。ちょっとだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どうしてこのタイミングで戻ってきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "んー、うーん、色々あるからね、どう言ったものかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "第一に、仕事だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "第二に、龍門の安魂祭って、いつもセールをやってるからね。それを逃したくないというか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ここ何年もの安魂夜はずっと行方知れずだったのに、よりによって今年に戻ってきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "本当に聞きたいのはそれじゃないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もう……察してるなら直接教えてくれてもいいじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふふ、珍しく君がモゴモゴしてるのが見れた。懐かしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いずれにせよ、体験学習に来た子の前でそんな込み入った話はできないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あっ……ぼくのことは気にしないでください。ええ、ぼくは後ろの方にいますので、どうぞ気兼ねなく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それはダメだよ。まだ追われてる可能性があるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あ！　バイソンくんを言い訳にするのはズルすぎでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まずはテキサスたちと落ち合おうよ。怖いマフィアたちがまだこちらを狙ってるんだしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私がいない間、君たちはいつもこんな面倒事を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "よくあるってほどじゃないと思うけど？　週に四五六七八回くらいある感じ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……うん、そうか……。それは確かによくあるという程ではないのかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ところでキミは、どこに行っていたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ボスに初めて会えたあの時、キミがもう龍門を離れたって聞かされたの。マラソンのゴールライン目前でズッコケたみたいな、あの時のあたしの気持ち、わかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まぁ、色んなところに行ったよ、数えきれないほどにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "旅人すら寄りつかない村に行って、手紙を受け取って、山々の向こう側に行って、移動都市を追いかけて、って感じかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんか、聞いてるだけで孤独感がすごいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "でもこれで旅行記でも書いたら大ヒットするかもしれないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "モスティマさんは、この大地にある全ての国に行ったことがあるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まぁ、大体はね。羨ましい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……少しはね。普通のトランスポーターなら、そういう機会は滅多にありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いずれ機会はくるさ。でもペンギン急便には期待しない方がいいかもね。私たちは常識で判断してはいけないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "その点に関しては、もう痛感してます……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "広い砂漠でトラックに乗って、黄砂越しに沈む夕日を眺める。ロマンチックに聞こえるだけど、そのロマンが百時間も続けば、ほとんど擦り減って消え去るからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "黄砂と夕日の組み合わせはあんまり見たことないけどさ、それより今日の砂嵐はひどいと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ここ数年で龍門の空気はかなり悪くなってるんだよ。空気清浄機を増やすべきだよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "空気の質か……そうかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "エクシア、バイソン、申し訳ないんだけど、君たちは先に——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン&エクシア",
      "text": "また？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "やれやれ、私はね、自分の行方をくらますタイミングをよく把握できてると思うけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……それ真面目に言ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "キミにとっては、まぁ、ただの数時間だったかもしれないけど、あたしにとっては——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まぁいいや。モスティマ！　帰ったらご飯おごって！　絶対だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "——はいはい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……本当に、今夜は賑やかだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "本当にモスティマさんを一人置いていくんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "誰が誰を置いてくって？　どうせ今止めても、次の瞬間急にいなくなるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……怒ってます？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あーもう――！　まずはテキサスを探しに行こ！　残りは後でっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシアの奴、こんな時に限っていないのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "なぁ、ウチらこれ、ヤバいことになってるんとちゃう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "囲まれてるな。突然現れたように見えるが、最初からスラムに潜伏していたんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "コイツら、あのマフィアの仲間なんかいな？　そないな感じには見えへんけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "いや、知ってる顔が何人かいる。みんな龍門の地元の人だね……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門の人？",
      "text": "——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門の人？",
      "text": "ボスの言いつけ通り、奴らに痛い目を見てもらおう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あ、あれ？あたしたち、テキサスを探してるんじゃなかったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんで急に飛び出してきたこの人たちに囲まれちゃってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門の人？",
      "text": "……そっちが勝手に荒らしに来たんだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ああっ、やっぱり！　エクシアさんの無茶な道案内のせいで、変なところに来ちゃったんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門の人？",
      "text": "悪いが、簡単にここから逃がすわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "どうしましょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "キミはフォルテだし、盾も持ってるし——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあ、クロワッサンとあたしの普段のやり方で行くよ！キミが道を開いて、あたしはシンガリ。でも今回はボーナスはないかもね。さぁ行くよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
