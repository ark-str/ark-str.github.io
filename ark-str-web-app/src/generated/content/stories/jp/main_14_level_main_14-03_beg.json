{
  "server": "jp",
  "storyId": "main_14_level_main_14-03_beg",
  "groupId": "main_14",
  "stageId": "main_14-03",
  "title": "通信封鎖の解除",
  "storyCode": "14-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_14-03_beg.txt",
  "sourceHash": "4b1910cd9193fb1e35105e218263eca3158da0cef0d5f3c5319c7c7a1f28259e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……あっ、あ、あなたは――？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ふぅ……はぁ……だいぶ楽になりましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "人というのは、歳を重ねるほど、明るく暖かな場所を好むようになるものですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "それからこれは……豆の香りでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あっ、は、はい。うちがさっき晩ご飯にと思って豆を煮たんです。ただの缶詰ですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "公爵様も食べますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "では、お言葉に甘えて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ふむ……悪くはないですが故郷の味がいささか欠けておりますね。塩漬け獣肉もあればより嬉しいのですが。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ですよね！　うちらゴドズィンの人は皆……\nって、あれ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "いかがなされました、お嬢さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ううん、何でもないです。ただ公爵様、ニュースで見たのとちょっと違うなーって思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ははっ、あなたの隊長に聞いてみるといいですよ。私は幼い頃の彼女を抱っこしたこともあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "確か幼いリタは私にこう言いましたね。公爵様にはツルツルの角が生えてるのに、どうしてパパにはないの？　と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……ご無礼をお許しください、公爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私の角に触れた勇気ある者はそう多くはありません。スカマンドロス中尉、あなたは幼少の頃から並外れて勇敢だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "いえ……この場にいる全員がヴィクトリアで最も優れた戦士であると言うべきでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "あなた方がチェットリー防衛戦で見せた功績は、驚嘆に値します。その後のブレントウードでも同様でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "「模範軍」……でしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "前々から、英雄たるあなた方にお目にかかりたいと思っておりました。残念ながら、リーダーの方は私との対面を快く思ってはいないようですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "公爵閣下、恐れながらあなたが突然ここに現れたことを……無条件に善意と受け取る者はいないかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "もちろんですとも、ミス・ウィンダミア。その点は理解しております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "とりわけ……時期が時期ですからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "すでに「ガラヴァエ鉄盾」には人を差し向けてあります。あれは素晴らしい移動速度ではありますが、幸いなことにアンフェリスに花を手向けるのに間に合いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "……ご厚意に感謝いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "公爵閣下、貴様が自らここへ足を運んだのは、我々に勲章を授けるためではあるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "もし……そうだと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "もう少しストレートに話しをしてもらえないか。我々の多くは貴族ではないし、高等教育とやらを受けたこともない。腹の探り合いには慣れていないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "アレクサンドリナ殿下、やはりあなたは噂通り……勇ましく率直なお方だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "では私もお仲間の方々と同様、シージとお呼びしても構いませんかな？　その方があなたも気楽でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "シージさん、実のところ私はよく分かっているのです。「模範軍」がここまで公爵部隊を避けてきた理由をね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "あなたは公爵間の利益争いに巻き込まれるのを避けたいと考えているのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "当時の伝説の部隊のように……ただヴィクトリアと、ヴィクトリアの人々のためだけに戦うことを望んでおられるのでしょうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ですから、私がここへ来たのは、ゴドズィン公爵としてではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私、ヴィクトリア議員ショーン・ゴドズィンは、議会直属部隊テンペスト特攻隊――及び模範軍メンバーであるその他の方々も含め、あなた方を勧誘するために参りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "そんな古びた識別コードが入った箱は捨てなさい。私はあなた方を今の議会の名の下にこの戦争に介入させたいと考えています。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "……採掘者たちの野営地は、完全に焼き払われているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "サルカズ兵士の痕跡は見当たらない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Miseryはかすかに寒気を感じた。焼き尽くされた野営地からは、全く熱を感じられない。\n崩れた木造家屋を払いのけると、とうに変わり果てた死体がそこにあった。"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "採掘者。感染者の遺体。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "……どこも同じか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "この音は……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "「霊骸布」、地面の下に隠れていたか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "ギブソンハム北西にて、ナハツェーラーを発見――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "……通信距離外か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「霊骸布」",
      "text": "死が、お前を捕えた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Miseryの足元から、文字が刻まれた数本の刃が勢いよく突き出した。しかし彼はすでに先ほどの位置にはいなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ナイフが空間を引き裂いた頃には、Miseryは敵の攻撃範囲外から離れていた。崩れた廃墟が瞬時に檻と化し、ナハツェーラーたちの干からびた身体を閉じ込める。"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "静かにしろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "俺もあんたらを捕えた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……公爵閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "私の知る限り、ヴィクトリア議会は長らく正常に稼働していないはずだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ロンディニウムから逃れた誰もが知っていることだ。ここ数年、聖王会西部大広間で命令を下しているのはサルカズだというのはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "もちろん、私とてその現状を否定する気はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ですが我々も今少し先のことに目を向けてみてもいいでしょう？　この戦争が終結した後に訪れる未来のことを考えるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ハハッ、未来？　それをネタに脅迫……いや、よく言えば「取引」を試みるには、いささか性急すぎやしないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "誤解はなさらないでくださいね。ゴドズィンはカスターとは違います。私は交渉よりも、暖炉のそばで友人たちと酒を飲み、トランプに興じる方を好むタチでしてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "しかし実際、夏が過ぎた途端に急に冷え込んできましたね――側近の者に薪をくべに来るよう頼んでも構いませんかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "もう外に待機してるんだろう。入ってきてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ふぅ……楽になりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "それで、どこまで話しましたかな？　そう、「未来」についてでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "戦争はじきに終結し、その勝利者はヴィクトリアでなくてはならない。このことは誰もが知るところでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "しかしこの戦争はこれから紛れもなく……いえ、すでに我々に不可逆的な影響をもたらしています。二十年余りも膠着していた局面についに変化が訪れるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "この部屋の中の誰かが、空の王座に関心を持っているとして、それは間違いなく私ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ハハッ、素晴らしい。少なくとも我々の間に、共通認識が一つ生まれましたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "正直に申しあげますと、私はつい最近、ささやかな会合の場をどうにか設けたところでしてね。かの鉄公爵にお会いしてきたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "彼に会うたびに、初めて「ガストレル」号を目にした日のことを思い出さずにはいられません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私は「帝国の弔鐘」の物語を聞いて育った多くの子供たちと同じように、リンゴネスの残骸の影を必死に追い求めておりました……そして、自分がその影にガリアを見出せないと気が付きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私が見つけたのは、この時代に最も隆盛を誇る国の放つ輝きだけでした。その煌めきは、目も眩むほどでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "つまり貴様はゴドズィン領地の利益よりも……ヴィクトリア全体を気にかけていると、我々に信じさせようとしているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "「高尚な」愛国心の類のことを言っておられるのなら、正直なところ、私は持ち合わせておりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "公爵として、私はいかなる状況においても自らの領地を優先して考えねばなりませんのでね。信じてください、これは単なる利益の問題ではありません。むしろある意味、責任とも呼べるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私はゴドズィンとウェリントンがどれだけ違うかを、考えております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ヴィクトリアがなくなろうともウェリントンは変わらずでしょう。ですがひとたびヴィクトリアの輝きが衰えるか消えるかした時、ゴドズィンの方は……一体どうなるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "最悪の事態には陥らないかもしれませんが、まずもって良い結果にはならないでしょうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "貴様は大公爵たちが本気で分裂する様を見るのは嫌というわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私だけではありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "あなたにも、いずれ分かります……そう思っているのは、決して私だけではないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "強大なヴィクトリアにも敵がいないわけではありません。ウルサスに、リターニア、クルビア、ひいてはサルゴンまで野心を持ったあらゆる国々が我々に目を光らせています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "この戦争が終わった後、我々には事態を迅速に収めるための、統一された声が必要になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "それこそが議会の存在意義です。全ての公爵領地は……ウィンダミア領も含め、然るべき代弁者を選ぶことになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "それが、あなた方「模範軍」――この戦争における英雄の持つ意義なのです。あなた方が代弁者となればヴィクトリアのために奮闘せんと願う兵士たちの期待は、二度と裏切られることはありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン&バグパイプ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "アレクサンドリナ殿下。ヴィクトリア議会が成立して以来、議長の座は常に国王本人が担ってきました。けれどだからと言って、議長が王座に留まっている必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "あなたがこの事実を受け入れるのであれば、殿下は我々に大きなものをもたらすことができるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "誰一人、言葉を発する者はいない。\nただゴドズィンがつけた火だけが、パチパチと爆ぜている。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "公爵閣下、一つだけ聞きたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "今までの話はどれも、この戦争が終わってから持ちかけてきても構わない内容ばかりだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "では仮に今、私が「ノー」と答えたとしたら、私や仲間たちは「諸王の息」を持ってこの場を立ち去ることができるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ははっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "シージさん、気を付けてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "隊長、外に狙撃手が！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "包囲されたみたいです。あるいは、彼が現れた時にはもう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……素晴らしいな。これで我々はカスターの「約束」だけでなくゴドズィンの「友情」にもお目にかかれたわけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "友人同士とは対等な関係ですよ。違いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私の誘いも、フェアであることに変わりはありませんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "少なくとも……そこの同郷のお嬢さんに、私に向けて破城矛を突きつける機会は与えてさしあげたのですからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ドローン六号の信号がまたロストしちゃった……まったく、とんでもない環境だね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "バリンちゃん、イヴちゃん、ヴィクトルちゃん、これじゃもうどうしようもないよ。やっぱり皆で探査ポイントを手動制御するしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "君たちの方はどんな感じ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "術師オペレーター",
      "text": "問題ありません。ビーコンは設置済みで、センサーも動き始めました。砂嵐の影響がやや強いので、今ノイズフィルターをかけてるところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "術師オペレーター",
      "text": "ヴィクトル、あんたも急ぎなさいよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狙撃オペレーター",
      "text": "あと五分待ってくれ。思ったより地面が柔らかくてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "術師オペレーター",
      "text": "流砂には気を付けてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "術師オペレーター",
      "text": "この一帯の地質、前回のサンプリング結果とはずいぶん乖離があります。その部分のデータも送っといたんですけど、そっちに届きましたか隊長？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うん。君がいてくれて助かったよ、イヴちゃん。君をスカウトしたあたしの目に狂いはなかったね。ゴホッ……アーススピリットちゃんに何日も睨まれ続けた甲斐があった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "クロージャさんも、もっとマシな労働環境を見つけた方がいいですよ。砂がたくさん口に入るのはよくありませんから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ちょっとバリンちゃん、アーミヤちゃんの口調真似はやめて！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "あたしの血には自浄作用が備わってるの……\nゲホッ、ゲホッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……ははっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "君も笑ってばっかいないで、早く手を動かしてよ！　この通信塔をさっさと設置できれば、それだけ早く安全エリアの位置を発信できて、君らも早く町に向かえるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "今まさに頑張ってるとこ！　ロドスの設備が特殊すぎるだけで、俺の学習速度はこれでも十分すごいんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あたしも真面目に言ってるんだからね。そもそも君やロックロックちゃんは、ここに留まってるべきじゃないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ドローンを貸した以上は、あたしも一緒についてなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ほら、ロックロックだってこう言ってることだしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あたしの安全を気遣ってくれてるのは分かるけど……あの眷属たちに敵わないのはそんなに恥ずかしいことじゃないでしょ？　ブラッドブルードの間にはそもそもすごーくおっきな差があるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "それより君たち二人とも、ヘルメットくらいは被っておきなって。感染者になっちゃったら、笑い事じゃ済まないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "分かったって。ご心配ありがと。だけど……あんたたちが戦場を駆け回るのだって、すげー危険なことだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あたしたちって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ロドスの皆のこと。自分の身の危険も顧みず、この戦場をあちこち駆けずり回ってるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "それに、バリンさんはヴィクトリア出身の感染者でイヴさんは感染者だけどヴィクトリア人じゃない。ヴィクトルさんにいたっては、感染者でもヴィクトリア人でもないじゃんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ロドスのオペレーターには色んな出身の人がいるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ここ最近さ、どうしても思い出しちゃうんだよな。ばあちゃんや、クロヴィシアさん、それから……トミーたちのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺が見てきたロドスのオペレーターさんたちみたいに、自救軍の皆も一緒に団結し合えたらいいなって、前まではそう思ってたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "んー……実際のところ、生まれつきの善人とか、悪人なんて、なかなかいないんじゃないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "環境が変われば、人も変わるからね。もしかしたらいつかは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "いつか自救軍も、一致団結して、協力して行動できる組織に変わる日が来るかもしれないよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ちょうど今、同じ目標に向かって突き進んでる「模範軍」みたいにさ。俺たちは災厄の中でも前に向かって進めるし、敗北や裏切りへの覚悟だってできてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "でも、そんな俺たちを繋ぐのは、必ずしも同じ種族だとか、出身とか、境遇だけとは限らない……ロドスとおんなじで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "はいはい、お世辞はそこまで。分かってるって、あたしらの設備が欲しいんでしょ？　なんだったら契約でも結んどこっか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "クロージャさん、俺は別にロドスが羨ましいわけじゃないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "むしろあんたたちに抱く印象は、その不思議な通信設備と似たような感じ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ある種の可能性ってやつかな――俺は未来に浅はかな妄想を抱いた青くさいガキじゃないんだってことを、あんたらは教えてくれるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "……ちょっと待って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "フェイスト、ちょっと喋りすぎだよ。クロージャさんの仕事の邪魔に……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "何の音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロック十八号のモニターを確認してみるね――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "監視カメラに映るノイズまみれの画像は煙で埋め尽くされている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "天災？　でもデータでは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "煙の奥からは、ボロボロの旗と戦争のささやき声が顔を覗かせていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ナハツェーラー……どうしてここに！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "逃げるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "君たち二人はすぐにここを離れて……他の自救軍メンバーも、ギブソンハムの方へ逃げて、早く！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "一体何の騒ぎ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "サ、サルカズだ！　こんなところにまで来やがったのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "迎撃するぞ！　戦闘準備！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "爆発音？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上級士官",
      "text": "公爵様、サルカズが町に攻め込んできてます！　早く撤退しましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "どうやら予想より早く敵に漏れてしまったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "サルカズめ、アンフェリスの件で味を占めましたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "やってきたのは何者ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上級士官",
      "text": "ナハツェーラーの精鋭軍団です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "アレクサンドリナ殿下、お仲間と共に我々と撤退しましょう。この町を守る意味はありませんが、皆さんの存在はヴィクトリアの未来にとって非常に重要です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ご安心を。我らの高速戦艦なら、三時間以内にシルバーロックブラフスまで戻れます。あの地こそ、あなた方が輝ける場所であるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "剣を掲げ、皆の注目を集めることが輝く瞬間なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上級士官",
      "text": "公爵様、もう時間が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "貴様らの時間は限られているな。たとえこの町にまだ多くの一般市民が残されていることを知っていようと、迎撃するつもりはないのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "当然、彼らを見捨てる気だ。議会の名目を持ち出したところで、この町のような貧しい家からは三代かかっても、たった一人だって議員が誕生することはないからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "貴様のゲームテーブルの上に、彼らは存在しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "アレクサンドリナ殿下、私はただ、現実の方をしかと見据えているに過ぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "現実だと？　貴様が理想とするヴィクトリアの未来は、あの旗で埋め尽くされたホールの中にしかない。それが現実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "だがな、私にとってのヴィクトリアは、貴様に見捨てられた人々なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上級士官",
      "text": "公爵様――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "分かりました、アレクサンドリナ殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "私は時折、あなたにお父上の面影を重ねてしまいます。その純真さと、向こう見ずさに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "そうか。だがどうでもいいことだ。父のことはよく覚えていないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "ははっ、なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴドズィン公爵",
      "text": "では、幸運を祈っております。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ホルンさん、全区画の戦闘員を直ちに集結させてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "デルフィーン、後方支援及び医療チームに待機命令を出すよう、シアラー少尉に知らせてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "通達済みです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
