{
  "server": "jp",
  "storyId": "story_blitz_set_1_story_1",
  "groupId": "story_blitz_set_1",
  "stageId": null,
  "title": "チームの盾",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_blitz_1_1.txt",
  "sourceHash": "7ef0110a1848e86bcf312a0c34ed14fa4ce3a6d5b585e561186a341c7912b685",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "サルゴン\nフェーンホットランド辺境"
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "あっち行け。お前なんかと話す気力はねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "水や食料を売ってくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "（目を細めBlitzをじっと見る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "おっと、傭兵の旦那か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "何しに来た？　この村には熱風と砂以外にゃ何もねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "南に向かってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "南だぁ？　はっ、熱気で頭がやられたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "こっから南っつったらフェーンホットランドしかねぇぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "まさにそのフェーンホットランドに向かってる最中だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "（再びBlitzをじっと見る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "頭は大丈夫そうだが、何が悲しくて死に急ぐんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ちょっと見に行くだけさ、冒険がしたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "さては頭がおかしいと思われて、仲間に追い払われたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ま、そんなところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "で、俺に何の用だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "物資を売ってほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "傭兵の旦那、この村にゃ一口分だって余分な水や食糧はねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "金じゃどうにもならんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "他の村人から聞いたが、お前がよその村との取引役ってのは間違いないよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "フンッ、こんなところに買い物をしにくる奴がいるかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "（サルゴン隠語）「金貨三枚」ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "（片言のヴィクトリア語）ケーキが必要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "（サルゴン隠語）砂を一粒あげよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "フッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "中で話そう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "ロドスセーフハウスへようこそ、オペレーター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "えっと、確かオペレーターって言うんだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "間違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "何が必要だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "水と食糧をある分だけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "本当にフェーンホットランドに行くのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "あそこから吹く熱風のせいで、毎年何人かが逝っちまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "それ以外のやつらも、まぁ見ての通りだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "みんな外で動きもせずにただ涼んでるだけ……喋るのも億劫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "俺はちょっとばかり商売ができて、よそと接触する機会があるってだけで……そうでなきゃ俺も似たようなもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "このクソみたいな場所に四十年もいるが、あんな場所に行きたがる奴なんか誰一人もいなかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ま、見に行くだけ行ってみるよ。別に損はないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "お前らみたいなよそ者だけだ、興味を持つのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "ああ、待て、そういえば以前ロドスの奴から預かったものがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "水でも飲んで待っていろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "あっ、あった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "初めてこの──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "──（訛りのきついヴィクトリア語）「セーフハウス」を頼まれた時だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "フェーンホットランドに向かう人間に注意書きを残してったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "字は読めねぇから、自分で見てみな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "どうも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "（標準ヴィクトリア語）フェーンホットランドの探索はおすすめしません。どうしても向かう場合は、サバイバル用の資源を充分に用意してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "なんて書いてあるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "補給物資をしっかり準備してけって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "なぜそこまでしてあんな場所に行きたいのか、俺にゃさっぱりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "まぁいい。水と物資はここにある。なんちゃら契約で、もともとお前らオペレーターに提供するってことになってるんだ。自分で持って行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "さっきの水は飲んだか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "具合はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "頭痛はさっきよりマシになったみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "同じものを水筒いっぱいに入れてやるよ。頭が痛くなったらひと口飲むといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "いっぺんに飲みすぎるなよ、幻覚を見ちまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ああ、世話になったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "全部で金貨一枚だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "金貨一枚？　はい、もらってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "えっ？　いや、こんなに──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "戻る時に駄獣を都合してもらうことになるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "しかし──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "帰りの物資を買う分も入っている。それでもまだ釣りが出るんなら適当に手土産でも選んでおいてくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "いいだろう、わかった。よそ者はみんな羽振りがいいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "ここで一晩泊まってから行くのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "いや、今すぐ行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "わかった。引き止めはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人",
      "text": "そうだ、あんた名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Blitzだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フェーンホットランド──Blitzのサルゴンでの旅の終着点。\n彼を待ち受けていたのは、灼熱と狂風と砂嵐だった。\n地平の見えない砂漠、灼熱の嵐、これらすべてがテラ人にとっての大地の果ての風景を表している。\nしかしBlitzにとっては、ここが冒険の始まりである。彼の強靭さに少しの運が味方をすれば、手がかりが自ずと示されるかもしれない。\n誰も足を踏み入れていないということはつまり、この砂漠が僅かな可能性を秘めている証拠である。\nひょっとして帰る方法が見つかるのでは？\nBlitzは僅かな可能性に賭けてみることにした──"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "……こうして俺はフェーンホットランドに入り、そして無事帰ってきたってわけだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "その勇気だけは称えてやるよ、兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "テラの各危険地帯は重点的にマークしておいたはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "なのにあんたたちときたら、片っ端から全部回ってくるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "フッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "で、フェーンホットランドで何かわかったことは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺としてもグッドニュースを持ち帰りたかったんだが、残念ながら砂しかない場所だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Tachanka、Frost、北の氷原には変わったものがいっぱいあるって話だが、そうなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Frostはモンスターたちと戦った。厄介な奴らとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "形があるものと戦えるだけマシだと思うけどな。少なくともそこで生物が存在できるってことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "でもフェーンホットランドは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "空と狂風と砂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "それであそこの全てだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "旅行先としては最悪だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "つまらなかった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そして寂しかった──と、Blitzは思った。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "そういえばサルゴンに冒険に行った時、我々の旧友は訪ねたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "旧友？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ああ、はいはい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あれだろ……ロングスプリングの新しい領主さんのことだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "元気にしてたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あの厄介なモンスターたちを処理したら、新しいクルビアの会社が訪ねてきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "いい予感はしないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あのマイレンダーが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あのマイレンダーだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あちらさんが出した条件は魅力的だったが、以前ヴォルヴォート・コシンスキーが起こしたトラブルの影響でピカールはその一部にしか応じず、基本的な貿易提携のみを結んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "かつてのロングスプリングの資金源は主に源石の売却だったけど、深い層の採掘場はとっくに閉鎖され、浅い層もあの時あたしたちの手によって爆破された……源石の産出は不可能のはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "何か他に売れる物があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ま、そこは我らがアレクサンドルさまのおかげで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺に何の関係があるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あそこで暇つぶしにマトリョーシカをたくさん作っただろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "まあな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "調査に来たクルビア人は、その「サルゴンの民芸品」がどうもお気に召したらしく、マイレンダーの人間がピカールから独占販売権を取得したみたいだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ふざけた話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "すると現地の人たちはみんな、たちまち「サルゴン伝統民芸品」の職人に早変わりしたってわけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "領主さんはその最初のロイヤルティを使って、クルビア人から砂漠での栽培に適した穀物の種を買いつけたんだ。それに加えて町全体もリニューアルした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ちなみに、先代の領主の屋敷はピカールの指示で公園にされたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしたちから見れば、よくやったと思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "フン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "なら──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "──ミアロ先生の墓はまだ残ってたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "……墓石は砂嵐の浸食で崩れ始めていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "……墓石をきれいに拭いて、花を供えてきた。その後、現地の人に頼んで墓石を覆う小屋を作ってもらった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あの世ではきっと元気にやってるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "それは何よりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ゴホン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "とにかく、全体的に見ればサルゴンは面白い場所さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "彼らの言語の発展は、今まで見てきたほとんどの国と大きく方向性が異なる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "同じ地域の住民でも、種族の違いで異なる訛りを持っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "しかも特定の種族でしか使わないイントネーションや、他の種族では発音が不可能なものまである。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "トカゲか別種の生き物にでも──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "変身しない限りはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "変わった注目ポイントね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "専門だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "言語と言えば、サルゴンで変わった場所を訪ねた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "アカフラっていう場所だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "アカ……クーラ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "アカフラだ。医療部にいるあのアダクリスの女性の地元だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ガヴィルか、聞いたことはある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "まさかサルゴンに、あんな天国みたいな場所があるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "しかし、残念ながらあそこのアダクリスたちはみんな「情熱的」すぎて、拳で解決できるものに関しちゃ、極力言葉を使わないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "最終的に盾を酷使しすぎて、ボンッ！　またぶっ壊れちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "アカフラを出る頃には、仕方なく木とスタングレネードで仮の盾を作る羽目になったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "面白いわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ジャングルにはユニークな獲物がたくさんいるんだ。ティナもきっと気に入ると思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "そろそろ食事の時間よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "みんな、午後のスケジュールは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "人事部に行って新しい制服を発注しなくちゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "サルゴンの砂で制服がボロボロだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "こんなのを着て作戦にいちゃ、自分の身すら隠せないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "こぼれた砂をたどれば俺の居場所がわかっちまうレベルだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "それは災難だったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "オーケー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "では、二時間後にロドスの訓練場に集合、異議はないかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "一同",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "一つの小隊として通常訓練を行うのは久しぶりね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "みんなが対抗演習のポイントをまだ覚えていることを祈るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "では二時間後。解散。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "じゃあな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "さあ、やるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "今日もたくさんの任務がお待ちかねだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロドス\nレインボー小隊臨時宿舎"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "新しい制服に新しい装備……不具合はなしっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "どれどれ──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Blitzは鏡に映る自分の姿を眺めた。\nここしばらくの間、彼はたった一人でサルゴンを旅し、帰るための手がかりを探していた。\nサルゴンの栄えた街や廃れた街、アカフラの鬱蒼としたジャングルでさえ、彼の冒険を止められはしなかった。\nしかし、フェーンホットランドは違った。\nあの場では、時間すら砂に支配されているかのようだった。\n一日、二日、十日が過ぎても──\n目の前の景色は何一つ変わらない。\nひたすら砂を踏んで前へ進んでいく。\n得るものは何もない。\n彼は怖くなった。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "自分がいつ引き返そうと決断したかはわからない。だがあの状況下では、もはや進むも戻るも同じだったようだ。\nフェーンホットランド辺境のセーフハウスにたどりつき、ようやく生きている感覚を取り戻した。\nそしてすぐに、疲労感の波に襲われた。\nあのことを思い出すたびに、怖くなる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "調子はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "まぁまぁかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "あとで弾丸飲み放題コースをおごってやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "先に行ってるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "（Blitzの肩を叩く）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "仲間の声が彼を記憶から現実へと連れ戻した。\n彼は手に持ったカスタムガンとフル充電されたシールドを見た。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "対抗演習は多分、俺とAshチーム対FrostとTachankaチームだろ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "仲間との連携、攻防、戦術的目標の共有。\n彼は急にパワーが漲る感覚に包まれた。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "サプライズの時間だぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "四時間後\nロドス本艦 訓練場"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ふぅ、はぁ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "フェーンホットランドをさまよっていた時、彼はある瞬間「この砂の果てまで進もう、そこで命を落としてもそれはそれで構わない」──そう思った。\nだが、セーフハウスでもらった不思議なドリンクを飲みすぎたせいで幻覚を見た時──彼はふと気づいた。\n自分は結果を追い求め、盾を掲げてひたすら前へ進んできた。\nしかし、後ろにいる仲間たちのことを考えてはいなかった。\nエリアス・ケッツ……オペレーター・Blitz。\nその使命は仲間を守ること。\nFrostに罠を仕掛けるチャンスを作ること。\nTachankaの射程圏内に敵をおびき出すこと。\nAshに的確な情報を知らせること。\n単独で危険を犯し、冒険することではない。\n彼は目が覚めた。\nだから今、彼は戻ってきたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "最後にウェルカムマットを踏んだ時の感覚を忘れるとこだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "サンキューFrost、モンスター用の罠を使わないでいてくれて助かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "礼はAshに言いなさい。あのブリーチング弾がなければ、あなたはとっくにリタイアしてたはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あくまで二対二の対抗訓練だから、実戦より簡易になっている要素はたくさんある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "アレキサンダーがどこに防衛線を敷いたのか、ドローンで何度も確認していたから賭けてみたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "訓練用の弾丸じゃなかったらチャンスはなかったぞ、Ash。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "わかってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "今回はあえてそれを利用した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺たち四人が突然消えたのは仕方ないとしても……ElaとIanaまで巻き込んでなけりゃいいがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "残念ながら、五人揃った特殊小隊の編成はもう不可能ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "この世界で新人を募集するっていうのは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "私たちは対テロ特殊部隊よ。民間軍事会社の傭兵じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "私たちの唯一の任務、それは平和維持だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "残念ながら、ここの平和は地球のよりも脆い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "だから今私たちがすべきことは、生きること……そして帰る方法を探すことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "仲間になってくれる人が現れたとしても、最後までこの道を一緒に歩むことはできないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "けど、本当にそんなに違いがあんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺たちそれぞれの祖国の違いよりも大きいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "前は上司のシックスが尻拭いをしてくれてたけど、今は全部が俺たち次第だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "この世界に馴染んでみてもいいと思うぜ、Ash。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺たちがよく知っている環境とかけ離れているとはいえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "慣れちまえば、こんな世界にも意外といいところはあるって思えるかもしれないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "帰るのはもちろん重要だが、それがすべてじゃないぜ、コーエン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "帰る方法が見つかるまでの間は、まずどうやって生きていくのかを考えてみてもいいかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "銃を下ろしても、この大地で歩いて行ける方法をな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "それがあんたの考え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ただのアドバイスだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "友人からの、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "考えておくわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "誰か来たぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "久しぶりだな、レインボー小隊の諸君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "いらっしゃい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "いらっしゃい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "待てよ、Ash……これはどういうことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "text": "私たちも訓練しに来たのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ファロン",
      "text": "あるいは、訓練を受けに来たと言うべきかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレース",
      "text": "どうも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "新しい対戦相手もスタンバイできたことだし、早速始めようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Ash、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "我々はオペレーター、レインボー小隊だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "本日のこの任務を引き受けるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "引き受けよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "マットの種類を変えないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Blitz、あんたは？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "答えは言うまでもない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "断るって選択肢は俺ん中にゃないぜ、Ash。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "さぁ、かかってきな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
