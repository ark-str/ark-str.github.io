{
  "server": "jp",
  "storyId": "act21side_level_act21side_08_end",
  "groupId": "act21side",
  "stageId": "act21side_08",
  "title": "累卵の危機",
  "storyCode": "IS-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act21side/level_act21side_08_end.txt",
  "sourceHash": "247d0cb254beb6b03c02f5549022a57bf29da242d47de29bd150d4081be1450d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサスさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "カタリナさん……ううん、ジョヴァンナさんが危ない目に遭ってるかも……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "今電話してたんですけど、なんだか様子がおかしくて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……ラップランドか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ハーイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "何の用だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "つれないなあ。キミの幼馴染が、キミたちの拠点の近くで自分の部下に囲まれちゃってるよって伝えようと思っただけなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ジョヴァンナさんを助けに行かないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……わかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "待ちなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "本当に行くつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミはロッサティを敵に回してでも、ここを離れようとしてるんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "なのに、あの人のために自分からこの泥沼に留まろうっていうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "よく考えたほうがいいよ、テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "踵を返して立ち去るのなら、今が最後のチャンスだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ソラ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサスさん、聞いてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "確かに、最初はあなたを探すために活動の場を広げただけのことでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "だけどあたしは、シラクーザの舞台芸術の雰囲気がだんだんと好きになってきてるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ここの人は傲慢なところもありますけど、龍門のがめつい商人に比べればよっぽどマシですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "それに、エクシアだって、シラクーザで一番美味しいピッツァを見つけるんだーとかずっと言ってますし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "クロワッサンは……そもそもあの性格なら、どんな環境でもやっていけますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "だから、さっき提案しようと思ってたんですけど……みんなが遊び尽くしてから龍門に帰るのもいいんじゃないかなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "何にせよ、いずれ龍門に帰る時は四人揃っていないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "はい。四人揃って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あっ、すみません、もう一人。さっきジョヴァンナさんと話してた時に、龍門に招待して案内するって約束したので、全部で五人ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "路地には数人が倒れこんでいた。\nジョヴァンナの身体にはすでに多くの傷跡があり――\n彼女自身を含めた誰もが、逃げ場などないことを理解していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "ジョヴァンナさん、もう諦めてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "ねえ、お酒はある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "……お前、車からボトル取ってこい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "……私、考えたことがあるのよ。クルビアでのビジネスに手を出すべきかどうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "源石兵器に新薬、それに軍とのパイプや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "役人からのご機嫌取り、クルビア政府からの「好意」も含めて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "チャンスを掴むべきじゃないか、ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "でも、私はずっと、ある程度で止めたほうがいいこともあると思っていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "私たちは既得権益者であって、あまりに多くのものを奪ってきた。自分を善良と言うつもりはないけど、私たちにはやってはいけないことがあるのを忘れるべきじゃないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "これを古臭いルールだとか、つまらないこだわりだとか思われたって構わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "時代は変わったんですよ、ジョヴァンナさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "新しい時代には、新しいルールが必要ですから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "ジジイどもの信じる道義なんてもんは捨てるべき時が来たんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "たとえ俺たちがやらなくたって、いつか誰かがやるでしょう。そうなれば、俺たちは取り残されることになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "あなたは、ほかのマフィア連中がそういう商売をものにしていくのを黙って見てろ、なんて言うつもりなんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "じゃあ、あなたならどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "全部掌握してみせますよ。新しいものも、古いものも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "俺は、古巣に戻ってそういうものから目を逸らすような真似はしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "text": "ウォラックさん、ボトルを持ってきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "さあ、ウォラック。最後の一杯を注いでくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "あら、私のお気に入りじゃない。前から準備してたわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "あなたが戻ってきてくれたら、祝杯として注ぐつもりでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "フッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "それじゃ……これからは、あなたがロッサティのドンよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "ジョヴァンナさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "やってちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "……ッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鋭利なものが身体を貫く音が路地へと響き――\nすぐさま、雨音にかき消されていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "テキサスには、自分が遅れてしまったことがわかっていた。\n戦いの痕跡は路地の至るところにあり、地面に血が広がっている。\nその血を辿って視線を走らせれば、よく知る姿が倒れこんでいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "心が震える。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ジョヴァンナ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ここでなら、ゆっくりお話しできそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたの共犯者になるつもりはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "……随分辛辣な仰りようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "お助けしたことへの感謝の言葉はいただけないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "まあ、構いません。私が勝手にしたことだとでも思ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなた方のようなお若い人は積極的なのが長所ですが、すぐ頭に血が上ってしまうのは玉に瑕ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "実のところ、あなたに手伝っていただきたいことなどないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "私はただ、優秀な若者が破滅へ向かうのを見たくなかっただけですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたがそんなことを仰るんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "どうやら、カラチの件で誤解されているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたに対して誤解があるとは思えませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "私は、目の前のことにより気を配っているだけなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "「政府というのは、グレイホールの円卓に敷かれたテーブルクロスのようなもの。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "シラクーザ人なら誰もが、ミズ・シチリアのこの言葉を知っていますよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ですが、この言葉がどこから来たものかを知る人は恐らくほとんどいないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "三十年前……今のあなたのように、自分たちならこのシラクーザをマフィアの支配から解放できると夢見る若者たちがいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ですが、シラクーザの空を覆う暗雲は果てしなく、彼らの支持者は見つかりませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "やがて、彼らは利益を餌にいくつかのファミリーを抱き込んで……敵うと思ったその相手に、抵抗しようとしたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "けれど、その末路は……誰も知りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そんな……ことが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "一つ、想像してみてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "――あなたの父は市政府で働く事務員です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ある朝、いつも通り起きたあなたは、顔を洗って朝食を食べ終えたところで、父の忘れ物に気付きます。そして、母からそれを届けてくるよう頼まれるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "その時は雨期で、父親と喧嘩したばかりのあなたは機嫌が悪かったのですが……自分にも非があると思いなおし、謝りに行こうと考えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "けれど、あなたがシティホールに入ると、そこは妙に静まり返っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "普段であれば、その時間のシティホールが静かなはずはないというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたはそうして、いくつものオフィスの扉の下から血が流れ出ているのを見て……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ホールの床が血だらけであることに、ようやく気付いたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "その日、シティホールの人は全員いなくなってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "輪をかけて恐ろしかったのは、誰一人としてこの事件について語ろうとしないことでした。誰に尋ねても――あなたの母でさえ、皆と同じように沈黙を選んだのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "消えてしまった人たちなど、最初から存在しなかったかのように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "その後しばらくするとシティホールには再び人が集まり始め、もうしばらくすれば以前の賑わいが戻ってきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "最後には気付かされるのです――すべては、「こういうもの」なのだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ミズ・シチリアの例の言葉が広まりだしたのはその時からでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "「政府というのは、グレイホールの円卓に敷かれたテーブルクロスのようなもの。」――であれば、いつでも取り換えられるのは当然のことなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "こうしたことを経験すれば、理解が及ぶでしょうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "怒りが存在するのは自然なことです。けれど、そのあとにやってくるのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "虚無なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "今のあなたは、あふれんばかりの怒りをぶつける相手すらもわからずにいることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "それはドン・ベルナルドか、ベッローネか、あるいはミズ・シチリアか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "いいえ、どれも違います。彼らは皆秩序の一部にすぎませんし、あなたは秩序の守り人として、誰よりもよくわかっているはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "――この秩序が、こんなにも揺るぎないものであることを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だからあなたと同じように、両目を閉じて耳を覆い、今起きているすべてに見て見ぬふりをしろと言いたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "自分を偽って生きろとでも、言いたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたはうちの娘以上に考えが甘いようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "先達としてお教えできることは、あなたが訪ねていらした時と変わりません。――どのような理想があるにせよ、まずは生き延びることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "死に急ぐにしても、せめて後継者を見つけてからにしなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "思想を伝えるために生きていくことは、時として潔く死ぬよりも難しいものですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ところで……私の就任は数日後に決まりました。合わせて、ドン・ベルナルドが都市全体へのスピーチの場を用意してくださっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "その際私のために何かしていただく必要はありませんが、うちの妻と娘の面倒を見ていただけると嬉しく思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "このくらいなら、あなたの信条に背くことでもないでしょうしね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "おや？　若者よ、君は友人と共に去ったはずでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "それが～……ちょっと個人的な質問があってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "聞こうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "学生時代に、おじいちゃんのことを何度か聞いてたんだ。若い頃は教皇聖下と並んで、すっごく有望視されてたんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だけど、ミズ・シチリアがラテラーノを訪れたあと、おじいちゃんは迷わず彼女と一緒に国を出て行ったんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "なぜシチリアと共にラテラーノを去ったかを知りたいのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうじゃなくてさ……おじいちゃんとミズ・シチリアって仲良しなんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "何をもって「仲がいい」とするかにもよるが、彼女への理解度という意味であれば、確かに私より深く理解している者はいないかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "とはいえ、実のところ我々の性格はまったく異なっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "少なくとも今日に至るまで、こうした都市で彼女が私にもたらすだろう面倒ごとを喜んで避けようとするくらいにはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だけど、それも仲良しだからこそじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "否定はするまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあさ……どうやってミズ・シチリアと何十年も仲良くやってきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "はっはははは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "アグニルおじいちゃん、あたし真面目に聞いてるんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "実にいい質問だ、若人よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "君の友人の質問よりもよほど面白いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "だがその前に……こちらにも気になることがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "先ほどの話から察するに、君とテキサスは非常に良い関係を築いているのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うん！　あたしたち、最高の相棒なんだ～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "となれば、自分たちの友情を疑ってはいないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もちろん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ふむ。であれば――その問いかけをする理由が見えてきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "共感があれば人と通じ合うことはたやすくなるが、共感をし合えない相手と付き合う中では、やはり疑念も生まれるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "そして、君は騙されることを恐れているのではなく、疑念そのものを恐れている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "人から誠意を持って接されると、疑いを抱いたことが恥ずかしくなるのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "しかし同時に、いつかその疑念が現実になったら、自分がどう振舞うかわからないと感じて恐ろしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "違うかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そう、それ！　それが言いたかったの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "思うに、ラテラーノを去ったサンクタは皆こうした問題に直面するものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "シチリアがラテラーノに滞在していた当時、私は彼女のガイドを務めていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "けれど実際のところ――私は噂にあるように、シチリアの考えに感銘を受けて彼女と共に発ったわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "あの頃のシチリアはまだ若かった。どれだけの才があっても、しばらくラテラーノに滞在したくらいで、すぐさまシラクーザを変える方法を思いつくなど不可能だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "彼女の考えは未熟で非現実的だったが、当時の私の考えと偶然一致する部分があった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "そこで我々は日夜討論を重ね、論争をし、最終的には共にシラクーザへ向かって、二人の考えを証明することにした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "討論と……論争？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "シラクーザに来たあとも論争は絶えず続いているんだ。実際、この国に対する見解が我々の間で一致したことは一度もないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "だが、それは互いの考えを理解することを妨げるものではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "つまり、その討論と論争が秘訣ってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ははっ……君はどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしは違う考えだなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "テキサスとは、何かを真面目に話し合ったことなんてほとんどないけど、いつの間にか相棒になってたからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "若者よ、君は聡明だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "結局のところ、私とシチリアを結びつけたのは……理念でも、状況でも、感情でさえもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "それは歳月だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "歳月……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "過ごしてきた月日が大抵の溝を埋め、人々がそれをどう思うにせよ結びつきを与えるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "君たちはこれからも良きパートナーであり続けるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もっちろん！　いつまでもサイッコーの相棒だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ならば、迷わず進みなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "君はこの先多くを経験することになる。それは彼女もまた同じことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "それぞれの物語としては、交わる部分は多くないかもしれないが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "そこで君たちが、同じ道を共に歩むのならば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "そんな心配は必要のないことだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
