{
  "server": "jp",
  "storyId": "act23side_level_act23side_03_end",
  "groupId": "act23side",
  "stageId": "act23side_03",
  "title": "木々でさえ",
  "storyCode": "WB-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act23side/level_act23side_03_end.txt",
  "sourceHash": "db67e35d45248f2c0624ad9dfdfd632a70c57553725098074d141593da4e127b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "うまくいったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪な山海衆メンバー",
      "text": "双方とも想定外の腕利きがいて、手を出すチャンスがありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "持燭人のガキは放っておけ、俺たちの計画にさして影響はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "龍門から来たあのアマ、予定外に現れたくせに、俺たちを嗅ぎつけるのが早い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "あいつは面倒だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪な山海衆メンバー",
      "text": "引き続き監視を強化し、機を見て始末します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "いや、二度の衝突を経て、政府の奴らも警戒を高めるだろう。今後は慎重に行動しなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "あの女の命に何日か猶予を与えてやるのは、場合によっちゃ受け入れられんこともない。だが、組織の動向をさらすことは絶対にあってはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪な山海衆メンバー",
      "text": "はい……ではこれから、どうされますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "待つ。先生の次の指令はすぐに来るだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "「山海八荒、尽く其の主に帰す。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "大地にのさばる奸賊どもが、それを自覚すらしていない……玉門のやつらはいずれ自らの傲慢さの代償を支払うことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "――その時は近い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "貴様らは誰を待っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "朝廷官吏の命を狙い、民の暮らしを乱す貴様らの行いは、どれも炎国の法は目に入らんと言わんばかり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "選択肢は二つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "武器を捨てて我についてくるか、我が貴様らをひっ捕らえ連れていくか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "お前、つけられていたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪な山海衆メンバー",
      "text": "先ほどのあいつです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "逆にお前の後をついてきたのだろう。相当な手練れだ。お前如きでは手も足も出ないだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "だがこの場所まで連れてきたのは、お前の失態だな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪な山海衆メンバー",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "ならいい。まずはこいつを片付けろ。お前の処罰はそれからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "痴れ者めが、まだ足掻くつもりか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "もう朝の方が近いというのに、まだ休んでいなかったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "昨晩のようなことが起こらぬよう、気を付けた方がいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "それで、何のご用でしょうか。よもや夜景を見るために呼び出したわけではないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "この最後の時に、せっかくウェイ殿が来られたんだ。本来なら、玉門をあちこち巡って、風景を見ておくべきだったんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "平祟侯の決定には、彼の考えがあるのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "私が言うべき言葉ではないかもしれませんが、平祟侯が背負っているものは、決して玉門一都市の安全だけではないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "たった一度の過ちであったとしても、結果が取り返しのつかないものであるとき、「信頼」という二文字は物の役にもたちません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "確かにその通りだな。ズオ将軍と私は数十年の付き合いがあるが、全て「信頼」に頼ってきたわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "宗師、ご理解いただけるとありがたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "文句を言ったことはないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "そういえば、宗師とはまだゆっくりと昔話などもできていませんでしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "前回玉門に来たのは五年前、その前は十年前でしたか。いずれも忙しなかった覚えがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "そして私たちが最後に会ったのは、更にさかのぼって……都にいた時だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "ウェイ殿が都を離れた年、私もちょうど報告のために訪れていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "まさか宗師がそれほど昔のことを、まだ覚えていたとは思いませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "ウェイ殿も覚えているじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "具体的に何年だったかは思い出せないがな。あれも春の頃合いだった印象がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "晩春です。今よりも少し後の時期でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "ああ、そうだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "当時ウェイ殿はまだ剣を扱っていたか……いや、当時貴公の姓はまだ「ウェイ」ではなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "数え切れぬほど目にしたはずの佳景に武術。しかし月日が流れた後も脳裏に残っているものは、いくつもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "今でも武術の批評を行おうという時には、時折思い出すのだ――赤霄剣法、その最後の型を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……武において宗師から高評をいただけるのは、光栄に存じます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "あの晩は雨が降るかという空模様で、蒸し暑く、雲が低く垂れ込めていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "私は遠く離れた城楼にいたが、それでも宿場の方から差す剣の光を見た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "雲を切り裂き空を拓くような、すさまじく果断な一剣だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "「雲裂の剣、当に立てれば則ち立つべし。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "その後、ウェイ殿はすぐに都を離れたのだろう。雨は、結局降ることはなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "本当に昔の話です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "宗師が今その話に触れたのは一体……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "城楼は高く、二人の袖がはためく。\n本来は風のない夜だ。\n見渡す限り玉門の家屋や望楼が連なり果てが見えない。高所を通る風によってのみ、この都市が高速で移動しているのをはっきりと感じ取ることができる。"
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "人の心は測り難く、朝堂とは伏魔殿だ。ウェイ殿よりもこれを理解している者はいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "だが私は、権謀術数だけに始終する者が、あのような剣術を扱えるとも思わん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "一つ、ウェイ殿にお願いしたいことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "宗師自らのご依頼とあらば、否やはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "此度の件、ウェイ殿には玉門を信じていただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "ウェイ殿は平祟侯同様、炎国一地方の安寧を担っている。心を砕くべきことも多かろう……だが玉門は龍門とは異なる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "玉門は軍事のために建てられた都市だ。この地の民も、多くは己が感情に素直な江湖の者ばかり。彼らが身の内に蓄えているのは熱い血潮で、謀り事は少ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "だが、国のため民のため、悪を憎む心は違わないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "私はただ、純粋な心を持つ者が悪党に利用されながらも、それに気付いていないのが心配です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "ズオ将軍が約束した期日は三日だ。三日のうちに、必ずやウェイ殿に納得のいく結果を出してみせるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "それまで、平祟侯への異議を脇に置き、ひとまず手は出さないでいただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "客は主人の便宜に従うもの。平祟侯がこの軍営で安心して待てと言うのであれば、たとえ私に彼の力になろうという心積もりがあるところで、どうすることもできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "思えば、数日前に龍門からやってきたリン特使、あの者は確かに頭が切れる腕利きであるな。わずか数日の間にいくつもの事件を見事に解決しただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "ウェイ殿の下には、このような人材がさぞや多くいると推察する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……そのようなことは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "太傅にせよ、平祟侯にせよ、このウェイ・イェンウにせよ、慮るのは皆等しく民の暮らしと、国の繁栄にすぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "我々は同じ船の上にいるべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "だが過去を顧みれば、この幾千年の間、同じ目標を目指していながらも、互いにしこりを残したまま喧嘩別れし、ひいては仇のように憎み合うに至った人々の例など、いくらでもあるだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "宗師であればこそ、力を持つ一言ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "いいでしょう、先の件は宗師に免じて……違えぬと約しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "夜明けも遠くない頃合いです。早くお休みになってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……そういえば。宗師には話していなかったですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "――赤霄剣法の最後の型は、雲裂の剣ではありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "（抑えた息切れ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "今なら、まだ五体満足で縄につけよう。次の技を身に受ければ貴様は二度と立ち上がれなくなる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪な山海衆メンバー",
      "text": "（苦しげなうめき声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "今はまだ腰の位置だが、身動ぎすれば、土くれは貴様の肩まで捉えるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "左の路地に三人、右の屋根にあと二人隠れているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "貴様ら二人の先ほどの動きは、伏兵を活かすため、我のほころびを引き出そうとしたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "だが貴様らに、そのような機はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "お前の実力を過小評価していたことは認めよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "アーツと武術が、双方共にここまで優れた者は……珍しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "貴様ごときが我の武を評価するな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "……ふんっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "昨日近衛局のリン特使が街に戻る際に彼女を襲撃し、今日また彼女の後をつけてよからぬことを企んだな。従前に司歳台の持燭人が市場で襲われたのも、貴様らの仕業だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "なにより天災信使を殺害し、データを奪取した。貴様ら山海衆は玉門で何を企んでいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "背後にいるのは何者だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "その前に自分の背後に誰がいるか見てみるんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "な――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪な山海衆メンバー",
      "text": "た……助けていただいて感謝します……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "お手を煩わせてすみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆首領？",
      "text": "時を徒に費やすな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "あの龍門から来た女、すでに鋳剣坊の倉庫まで調べ上げています、厄介です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆首領",
      "text": "あの女を厄介と思う気持ちはあるのか。であれば何故、唯一局面に影響を与えうる更に厄介な不確定要素を始末しにいかぬ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "……鋳剣坊のじじいですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆首領",
      "text": "奴を探せ、あの天災データごと葬るのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "先生、危ない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆首領",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆首領",
      "text": "何故まだ立てる。何がお前を突き動かすのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "行か……せる……ものか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "地面が突如沈んだ――と、ごうっと一息に土石が隆起する。粘りある力強さを感じさせる土砂の壁が、たちどころにその場の全員を取り囲んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆頭目",
      "text": "先生、こいつやばいです――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "凛冽たる光が煌めき、すぐに消えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "人は地に倒れ伏し、土石はただの土石のまま在る。\n玉門の街は――ただ、しんと。"
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆首領",
      "text": "時の無駄だ。くだらぬ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ユーシャ姉、随分と遅かったですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "たまたま知り合いに会ったから、挨拶をしてたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あんた龍門人なのに、玉門に知り合い多いわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "まあ無駄話はいいわ。それぞれが見つけた情報をまとめて、手がかりがないか見てみましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "午後に通りで会った時の話がまだ終わってなかったわね。あんたの方は何か進展あった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "ドゥさん、南にある鋳剣坊の親方の素性はわかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "モンおじさんのこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "モンおじさんは、父さんがまだ現役の鏢師をしていた時に知り合った友人よ。武術の腕がとても高くて、話のわかる人だから玉門の武林――武術界隈の関係者みんなから信頼を得ているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あたしは玉門じゃ伝手もないし土地にも不慣れだから、行裕物流を開業できたのは、おじさんが世話してくれたおかげなの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "今回の件ってモンおじさんと何の関係があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "聞いてみただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "まどろっこしいわね。何かあるなら、はっきり言いなさいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "これまで、今追ってる賊たちは、都市間の物資補給の隙をついて龍門から玉門に密航したものだと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "だけど今日、密輸犯の手がかりを調べていたら、鋳剣坊の倉庫にたどり着いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "それで？　何を発見したの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "倉庫の中にあったのは鉄と鍛造用の燃料よ。確かに鋳剣坊で使われているように見えたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "――けど、奇妙な点が一つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "倉庫番の首に、変な日焼けの跡があったの。あれは恐らく特別な防具を付けた時に残った跡ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "私の知る限り、欽天監が派遣する天災観測チームは、長期間砂漠を歩くことから、風と日焼けを防ぐために、制式のマスクをつけている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あの日焼けは真新しいものよ。そして、玉門欽天監が最近派遣した部隊は、一つしかないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "つまりあんたは、都市外で起きた信使部隊の事故には裏があって、それにモンおじさんに関係してるってことが言いたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "私はただ調査結果をあなたに共有してるだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "玉門は砂漠の奥深くから戻って来たばかりなのよ。ここは日差しが強いし、住民が日焼けするのは普通でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "たったそれっぽっちでモンおじさんを疑うなんて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あなたたち、これに見覚えは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "（震える声）それ……どこで見つけたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "鋳剣坊の倉庫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "中を探った時、隅で拾ったの。ユニークなデザインだったから、燃料や鉄の山の中でも目立ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "これ、「行裕物流」の腕章よ。あたしがデザインしたもの……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ユーシャの手にあったのは、金で縁取られた赤地の腕章だ。中央には尚蜀独特の模様が刺されている。二本の線が五芒星を突き抜ける図案は、幸運招来と商売繁盛を願ったものだ。\n吉事有祥と平安無事の願いが込められた腕章は、恐ろしげな赤褐色が染まって、こびりついた砂が一層にそれが潜り抜けてきた修羅場を感じさせた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "これを持ってるのは、あたしについて尚蜀からやってきた若者たちだけよ。ダーチーとシャオチーが都市を出た時だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "もし信使部隊が本当に、外で事件に遭遇したなら、これが都市内にあるはずないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "ダーチーとシャオチーはまだ生きてるの！？　ならどうして隠れて出てこないの？　違うわ。もしかして、誰かが二人を拉致して隠してるとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "まさか、モンおじさんが？　おじさんの方も、四人の仲間がチームに加わってたはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "一体どういうことよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ドゥさん、落ち着いて、まずは冷静に分析しましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "考えても無駄よ。あたし、これから直接鋳剣坊に行ってはっきりさせてくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ドゥさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ユーシャ姉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "なに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "先ほど階下で観光客に扮した龍門人を見ましたが、ユーシャ姉のところの人ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "彼はあなたに届け物をしに来たんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あの腕章は、玉門の外で信使が殺害された現場から持ち帰った証拠物よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ドゥさんを利用したんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "多くの手がかりが鋳剣坊を指し示しているの。探りを入れるのは、必要なことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "鋳剣坊の主に問題がないことが判明すれば、好ましくない可能性が排除されて、彼女本人も安心でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "もし本当に問題があるなら、これは彼女を危険にさらすことになりませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "この街では、危険にさらされているのは彼女だけじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "……ユーシャ姉には、ユーシャ姉の職責があるのはわかります。今までだって、こうしてきたのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ここで議論をする気は毛頭ありませんが、これだけは言っておきますね。私は絶対にあなたのやり方を認めることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ドゥさんを手伝いに行ってきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守備軍",
      "text": "公子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "どういうことですか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大柄のフォルテの男がベッドで横たわっている。顔面は蒼白で、たくましい胸は上下しているようには見えなかった。\nズオ・ラウの記憶においては、タイホーは山のような存在だった。\nいつだってどっしりと父と自分のそばにそびえ立ち、揺れ動くことはない。\nどのような力ならば、その山を崩せるのか？　ズオ・ラウはそのような出来事が発生することすら、想像してこなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守備軍",
      "text": "たった今、タイホー御史が二名の民間人によって軍営まで運び込まれました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "いいからタイホーさんの状況を教えてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守備軍",
      "text": "ぐ、軍医が言うには、ひとまず一命は取り留めたようです……ですがそれだけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守備軍",
      "text": "御史は体に多数の外傷を負っていますが、それよりも深刻なのは臓器の損傷です。大量の内出血を起こしていて、もし普通の人だったら、恐らくとっくに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "タイホーさんは本当なら、この件に手を出すべきではないんです。でも彼は私を助けるために陰から……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "父は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守備軍",
      "text": "将軍は都市外周の城楼を守っておられます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守備軍",
      "text": "先ほど将軍に知らせたところ、一言が返ってきたのみでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉門守備軍",
      "text": "「己の役割を果たせ」とのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……タイホーさんを運んできた人はどこにいます？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "何があったか、順番通りに全て話してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した通行人",
      "text": "わ、私たちは、官服を着たあのフォルテの役人さんが道端で倒れてるのを見つけて、何が起きたかわかりませんでしたが、とにかくここに運ぼうと思ったんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "現在玉門では戒厳令が敷かれています。あなた方が深夜に外出していた目的は何ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した通行人",
      "text": "そ、その眠れなくて、外をぶらついてただけで……まさか扉を出たら道端に人が倒れてるなんて、私たちも驚きましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "近くに住んでいるのに、何も異常に気付かなかったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した通行人",
      "text": "全く……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "あなた方はどこで彼を発見したのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した通行人",
      "text": "街の南、鋳剣坊近くの路地です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "鋳剣坊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した通行人",
      "text": "あの……もう帰ってもいいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "あなたの証言には、はっきりしない点があります。証人として、詳細が判明するまではまだ帰すわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張した通行人",
      "text": "えっ、そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "千人隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千人隊長",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "すぐに、部隊を集めてください。私は先に現場へと向かいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "――鋳剣坊を捜査します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千人隊長",
      "text": "公子……将軍の命令は「己の役割を果たせ」なんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "父は私に三日以内に宗師の剣を取り返し、犯人を捕らえ、玉門に安寧を取り戻せを命じました。タイホー御史ほどの武芸者が、しかも玉門の都市内で負傷したのなら、必ず巨獣信者と関係があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "即刻事件の現場へ向かって真相を明らかにし、主謀者を捕らえることこそ、役割を果たすことではないのですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千人隊長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "行きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "千人隊長",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
