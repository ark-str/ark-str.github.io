  "storyId": "1stact_level_a001_ex01_end",
  "groupId": "1stact",
  "stageId": "a001_ex01",
  "title": "青天霹靂",
  "storyCode": "GT-EX-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/a001/level_a001_ex01_end.txt",
  "sourceHash": "6b4663a7e6e8e066cc132adcb13ae3f828b5389f271c998aafa8c24be1122492",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……我々は彼を麻袋に詰め込み、\n夜明けとともに帆柱に吊るさねばならぬ……。\n……我々は彼の喉を切り裂き、\n暴風雨の中で海にそれを捧げねばならぬ……。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "はっ…！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "……また……この夢……ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "あら、誰かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "――あなたですか。でも不思議ですね……どうしてあなたの名前が思い出せないのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "別に構わないわ。ロドスのオペレーターの一人とでも思ってくれればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "苦しそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ウフフ……ただの悪夢ですわ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "意識の中をぐるぐる廻る黒い破片が、あのボロボロの教会の影の中に隠れて……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "私が近づくと、それは枷と鎖となり、この私を深い深い海の底へ連れ去っていくのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もう少しでこの苦しみを終わらせる方法が見つかるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "そうですか。ウフフ……素晴らしいことですが、あなたを信じても良いのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "あら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "あなたの纏うこの空気……私は知っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "いえ……違う、これは香り。濃密な香り、血の香り、彼らの香り。深海の香り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "懐かしくて、嫌な気持ちになる香り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "お名前を……教えていただけますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "スカジ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "あなたには何故か興味が尽きませんわ……どうやってここへ来たのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ケルシー先生の許可がなければ、この部屋には入れないはず……我を失った私に八つ裂きにされるのを恐れないなら話は別ですが…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "恐れ……皆恐れているわ。私はそれに慣れているだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そろそろ行く時間ね、戻ってくる頃には状況に進展があるかもしれない。でも、これまで通り私を忘れてくれていいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "どこへ……向かわれるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "秘密が眠っているところ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたからずっとずっと遠くにあるところよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
