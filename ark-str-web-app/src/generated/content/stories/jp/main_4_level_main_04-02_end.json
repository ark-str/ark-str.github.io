{
  "server": "jp",
  "storyId": "main_4_level_main_04-02_end",
  "groupId": "main_4",
  "stageId": "main_04-02",
  "title": "雨の中を歩く",
  "storyCode": "4-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_04-02_end.txt",
  "sourceHash": "5ebe7c8910cfb51da3ea530a289b11e76e03a86f5c28d6604de70022275f8775",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "あっ！　そ、そこどいてっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "きゃっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "ご、ごめんなさい！　ぶつかるつもりじゃなかったんだけど……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ううん、大丈夫。そうしてすぐに謝れるなんて、立派だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "わわ、そうかな？　えへへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "ところで、お姉さんはここで何してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "この辺は雨が降ってるし、雨宿りしたほうがいいんじゃない……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ええっと……ううん、その……少しお散歩してただけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それより君、何か手伝ってほしいことがあるんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "えっ！　どうしてわかったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ふふっ、ないしょ。これはお姉さんの秘密だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "ええ～？　……んー、まあいっか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "じゃあさ、お願いがあるんだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "うーん……でも、やっぱり無理かなあ……お姉さん、背が小さいし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もう、そんなこと言っちゃダメだよ！　君に比べたら、私のほうが背が高いでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "わわ、ごめんって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "それじゃ……とりあえず、やってみる？　えっとね、この板どかすのを手伝ってほしいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "下敷きになってる蓄音機を持って帰りたくてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "これ？　うん、やってみよっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "じゃあいくよ。いち……にの……さん！　えいっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　できた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……っ、これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "わあっ、お姉さん力持ちだね！　ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うん、でも……この蓄音機、壊れてるみたいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "大丈夫大丈夫！　見つけた時にはもう壊れてたしね。いつか、これをちゃんと直して使えるようにするつもりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "実は僕、みんなのためにレコードをいっぱい集めててさ。まあ、自分でも、一度も聴いたことないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "でも、いつかみんなに聴かせてあげようと思って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……難しい目標のはずなのに、簡単なことみたいに口に出せるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……私、何のために行動してるのかな。……私にできることって、何だろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "……あのさ、お姉さんは僕のこと、怖くないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ううん。……どうして、怖がられると思ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "だって僕、鉱石病なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あははっ、私もそうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "え～っ！　こんなに可愛いのに感染者なんて、もったいない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "感染者になったからって、全部台無しになるわけじゃないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "だって、たとえ君が感染者でも、そうじゃなくても――いい子でいたなら、その事実までは変わらないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "ん～……そうなの？　よくわかんないや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "（ぐう……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……もしかして、お腹ぺこぺこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "……うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……じゃあ、これあげる。って言っても、これしかないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "えっ、いいの？　やった、ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "……あれ？　そういえば……お姉さんって、なんでここに来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……私が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ある人と、約束したからなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "――お姉さん、またね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うん、またね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの子みたいな子供でも、結局、最後には……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "感染者め。お前たちはもう、人ではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私にできることを、もっと……もっと考えないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……どうして……全員を守ることは、できないんだろう……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "お前にできるはずがない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "飢餓、迫害、そしていずれ訪れる凄惨な死……\n感染者の末路など、ほかにはない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そんなこと、ない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ロドスが、感染者のために立ち続ける限り……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "お前は数少ない恵まれた人間の一人だ。そんなことを言えるのは、そのためでしかない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "違う……！　多くの人が団結して、同じ目標に向かって努力し続けているからこそ、私は……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "この大地は、すでに麻痺してしまったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……いいえ、まだそうはなってない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "感染者を、絶望の淵に追いやらせはしない……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アーミヤ。\n怒りに身を任せるが良い。\nただのそれだけで――"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……ダメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "絶対に……そんなこと、しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "だって、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの人と、約束したんだから――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "この声は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "あのお姉ちゃんが教えてくれたんだ。このお人形は、誰かのために作るから意味があるんだよ、って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "だからね、これ、龍のお姉ちゃんのために作ったの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性の声",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今聞こえたのって、もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "やっぱり、あの後ろ姿は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "チェンさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "――――――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "――――！　――――――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "――――――――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性の声",
      "text": "――――――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの、チェン隊長……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ここで、何をしていらしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "なんというか、私はてっきり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミには関係ないだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "単に、龍門の問題は、すべて私の管轄下にあるというだけの話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……チェン隊長……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "初めて見た……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "彼女が、あんな目をしているところなんて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
