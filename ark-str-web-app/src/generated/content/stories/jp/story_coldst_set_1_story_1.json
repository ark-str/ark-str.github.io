{
  "server": "jp",
  "storyId": "story_coldst_set_1_story_1",
  "groupId": "story_coldst_set_1",
  "stageId": null,
  "title": "いってらっしゃい",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_coldst_1_1.txt",
  "sourceHash": "76e7ecec8cd96fd39a197a33f6697b633004ad5d82f7400a559e76f31c0b818d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ふぅーー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "風が気持ちいわね！　こうやって思いっきり風を切って走ったのは久しぶりよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それにしてもジェシカ、こんなイカした車を持ってるのに、どうして普段は乗らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "今回、あなたの車に乗せてもらって大正解だったわ。開拓地事務所に着くまでの短いドライブっていうのが残念だけどね。そうだ、任務に向かう前に、まずあたしにこのまま野営地まで運転させてよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あら、赤いランプが光ったわ。ねぇ、ジェシカ、これってどういう――どうしたの？　顔が真っ青じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "さ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "サードギア？　ダメよ、それでも遅すぎるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ニ、一……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ヘレナさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "はいはい、わかってるわ。ほらそこ、壊れたのはトランスミッションね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ジャンパを繋いで、レンチを何回か回せば直るわ。二分もかからないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "もう、そう暗い顔をしないの。急ぎの任務があるのはわかるけど、あたしのおかげで時間を無駄にすることもなかったじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あなたが持ってたマニュアル通りの速度で運転してたら、今の半分も進めてなかったかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "安全マニュアルの指示速度は、道路状況や気候など様々な要因を元に算出されたものです……参考価値は十分にあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "こんなにイカした車を、ハガネガニ以下のスピードで走らせるなんて、心が痛まないわけ？　それに、あたしが節約してあげた時間があれば、たっぷり十回は修理できるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ？　わたしが修理するんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "「他人の懐とボンネットの中身は探るべからず」――これが荒野のルールよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それに修理の技術なら、もう全部教えたはずでしょ？　保安官が他人に車を修理させてたなんて、そんな恥ずかしいことはないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、車が壊れたのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "いいから、さっさとレンチを手に取って。時間がないんでしょ？　こんなとこ長居するもんじゃないわ。あとで事務所の手前にある酒場についたら、最高のお酒を奢ってあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "いえ、お気持ちだけ受け取っておきます。この後任務があるので、お酒は飲めません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "何を心配してるのかはわかってるわ。あそこのお酒はうちの野営地の手作り酒よりずっと上等だから、この前みたいにひと舐めで酔ったりしないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ、そこまで弱くありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ああ、パーツがすっかり緩んじゃってます。やっぱり、さっきのスピードが原因で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "その言い方、あたしがスピードを出しすぎたせいだとでも言いたげね？　じゃあ、後でもっと速く走れるか試してみる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あはは……ヘレナさんは、とりあえず座って休んでてください。トランクから部品を取ってきますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "そうそう、その調子よ！　保安官なら、車くらい自分で修理できなくっちゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "嘘でしょジェシカ！　トランクパンパンに部品を詰め込んでたなんて！？　どうりでさっき運転してる時に、車の重心に違和感があったはずだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ですが、これはすべてマニュアルに書かれていた予備部品です。これでも、タイヤ交換用の道具をいくつか減らしたんですよ。あとでパンクしなければいいのですが……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "……なんだかウッディにバッジをもらってからのあなた、どんどん堅物になってきてるわね。\nまあ、好きにやりなさい。あたしは日陰でのんびり景色を眺めながら涼んでるから、修理が終わったら声をかけて。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから響く声",
      "text": "♪彼女は十輪の夕陽を引き連れ、荒野の中心へと駆け出す♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから響く声",
      "text": "♪風を振り払い、影すらも置き去りにして♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから響く声",
      "text": "♪彼女は決して止まらない、決して帰らない♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "エンジンを止めろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "この歌声、あの女ですか？　もう何年も経つのに、まさかまたここに姿を見せるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "黙ってろ！　今確かめてんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "ああ、あの女で間違いねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "お前ら、騒ぐな！　あの時のことをもう忘れたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "お前、その望遠鏡をきれいに拭いて、奴が隠れてる場所を探せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "いましたぜ、下の曲がり角のとこです。車の下にもう一人隠れてるみたいです……車が壊れたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "仕掛けるんだったら、まず下の奴からだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "で、これからどうします？　このまま待つんですかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "ああ、だがナイフとクロスボウはしまうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "♪彼女は決して止まらない、決して帰らない♪",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "はあ、歌いすぎて喉がカラカラだわ。\nねえ、ジェシカ！　まだ直らないの？　もう日が暮れてきたわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あともう少しです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ほんとに手伝わなくて平気？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい、もうほとんど作業は終わりましたので。最後に溶接部分をもう少し補強すれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そうだ、ヘレナさん。次はわたしが運転をしてもいいですか？　安心してください、免許を取ってからずっと無事故無違反を守っているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ダメダメ！　あたし、ノロい車に乗ると酔っちゃうの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それに、あたしは途中まで乗せてもらうだけで、別に一緒に任務に行くわけじゃないでしょ。事務所に着いたら、あとはあなたの好きに運転できるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そうですか……あの、もう少し待ってくれませんか？　もう一回点検したい場所を思い出しまして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "もう、じれったいわね。前に野営地で見せた勢いは一体どこにいっちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "まあいいわ、ならもう少しこの美しい夕焼けを楽しませてもらうわね。この岩に登れば、もっとはっきり見えそうなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "沈みゆく日に照らされた荒野の岩壁は、様々な色を見せてくれるの……ほんと何度見ても飽きないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あら、あそこにいるのは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "直りましたよ。これで先を急げ……\nうわっ、ヘレナさん！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "どうしたんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "薄汚い奴らが、匂いを嗅ぎつけてやってきたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "フフッ、威嚇射撃をしても逃げる気はないようね。かと言って、崖の上に立ってこちらをコソコソ伺うことしかできない。ずいぶんな腰抜けさんたちねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "せ、戦闘準備ってことですか？　銃はシートの下に隠してるので、すぐに取ってきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "待って、ジェシカ……その必要はないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヘレナは目を細め、沈みゆく真っ赤な夕陽、仄かに紫色帯びた崖下の影、そして袖口の汚れた少女へと順番に視線を移す。\n少女の瞳には微かに緊張の色が浮かんでいるものの、その奥底は彼女の胸元に留められたバッジと同じくらい、揺るぎない決意に輝いていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "だってあなた、大切な任務があるのでしょう？　あんな虫けらたちに時間を費やす必要はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "車はちゃんと直せた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい、いつでも出発できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "なら、エンジンをかけなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ちょっと、なに助手席に座ろうとしてるのよ。まさか、あたしにスコープを覗きながらハンドルを握らせようっていうの？　さっさとカギを持って反対側に行って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしが運転するんですか？　でも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "今回はちゃんとスピード出しなさいよ、冗談抜きでね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "背後の崖から、車に乗った集団が駆け下りてきました！　あの車も……改造済みのようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "どれどれ……ああ、大したことないわ。この車よりずっとダサいから、安心しなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それに、あいつらの運転技術も改造のセンスと同じくらい冴えないわ。あんな緩やかな坂でブレーキを踏むなんてね。あなたは運転に集中すればいいわ。狙撃はこっちに任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの人たちのこと……知ってるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "色んな人から恨まれてるから、誰なのかは思い出せないけど、誰でもどうせ似たようなものよ。大体向こうが先にケンカを売ってきてたわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "頭を下げて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ちゃんとスピードを出しなさいって言ったでしょ！　何をチンタラ走ってるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リミッターを取りつけたんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "なんですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "その……ヘレナさんがまた無茶な運転をするんじゃないかって思って、スピードリミッターを取りつけたんです！　だからマニュアルに書いてある以上のスピードは出せません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヘレナは窓から勢いよく身を乗り出し、ネイル砲を後方の立ち込める土ぼこりに向けた。獰猛なトゲのついた車の輪郭が、その中から浮かび上がってきたかと思うと、ヘレナの手元から轟音が響く。\n一発、また一発と致命的な攻撃が、舞い上がる土埃の向こうに消えていった。弾薬が切れ、爆発音が風に吹き飛ばされる頃には、追撃者の姿もずいぶんと減っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの人たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あいつらは一度獲物に食らいついたらそう簡単には放さないわ。マニュアルだの上限だの言ってないで、アクセルをしっかり踏み込んで、限界までスピードを出しなさい！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "は、はい！\nでも……これはどう考えても危険運転ですからね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "こんな時に、まだギアなんかをチェンジしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "大変です！　あの人たち、また追いついてきましたよ。今のスピードじゃ……ど、どうしましょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "トランクを開けなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "今も後ろでジャラジャラ鳴ってる、無駄に重い部品よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "トランクを開けて、全部捨てちゃいなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "はやく……あたしを信じて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "トランクの蓋が弾けるようにして開き、巨大な合金製の工具箱が勢いよく地面に叩きつけられ、跳ね上がり、転がりながら土埃の中へと消えていった。\n歪んだ留め具は、もはやその機能を失い、ネジやらドリルやらレンチやらが、我先にと工具箱から踊り出し、怒りの嵐となって相手の車に襲い掛かった。\nほどなくして、金属と金属がぶつかり合う音、タイヤが砂利に擦れる音、そして慌てふためく叫び声と罵声が響いてきた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "効果てきめんみたいです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "まだよ。捨てられるものを全部、あいつらのフロントガラスにぶつけてやらなくっちゃ！　あたしに任せて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "この箱の中身は何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ロドスの後方支援部で印刷した安全運転のマニュアルです。持って帰ろうと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あのマニュアルって、自分でわざわざ印刷したものだったの！？　しかもひと箱も！　全部捨てるわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あとはこの盾……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それは捨てちゃダメです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "わかってるわよ！　あとはこのシートも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "チッ、後ろのシートは全部ネジでがっちり留められてるわ。レンチを貸して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "レンチは……さっきので全部捨ててしまいました！　もう余っていません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、こうすれば！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジェシカは片手でハンドルをしっかりと握りしめ、もう片方の手で銃を抜くと、後部座席に振り返り、太いネジに狙いを定めて引き金を引いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "バンッ――車台に穴が空いた瞬間に、ネジとシートが外へ投げ出される。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "次は声をかけてから撃ってよね。鼓膜が破れるかと思ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "すみません、焦っていたもので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "車内で銃をぶっ放すのは、安全マニュアルには違反しないの？　まあ、なかなか悪くないエイムだったわよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "車台の部品や装置を、ちゃんと避けて撃ったのでしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジェシカは何かを言おうとしたが、開きかけた口をぎゅっときつく結び、ヘレナに向かって力強い視線を素早く投げた。一方、ヘレナもそれだけで、彼女の考えをしっかりと汲み取った。\nすでに車のパーツがあちこち緩み始めている。金属同士が擦れる不快な音が響く中、鉄の塊が次々と振り落とされ、車台に空いた穴から飛び出ていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "急いで装填をお願いします……この車が、あとどれだけ持つのか、わかりませんので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "待って、今の揺れは何？　突然加速したのは気のせい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ずいぶん軽くなったとはいえ、こんなに一気に加速するのはあり得ないわ……もしかして、リミッターが振り落とされたとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……いえ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジェシカはチラリと足元を見てから、今度は首を横に振った。\nヘレナが彼女のほうに目をやる。そして、真っ先にその額に吹き出た玉のような汗に気づいた。\n続いて、スピードメーターの針が、目盛りマックスのところで小刻みに揺れているのが目に入った。同じく、ハンドルをギュッと握りしめているジェシカの両手も、小刻みに震えていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "……ジェシカ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "アクセルが……戻らないんです……ブレーキも効きません。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "たぶん……さっき、ブレーキの配線ごと……\nうわあ！\nヘレナは一瞬固まったが、すぐに肩を震わせて笑い出した。今ここで起きている何もかもが、突然可笑しく思えてたまらなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あはっ、ははははっ……ほんっと、最高ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "このイカれたカーチェイスを思う存分楽しみましょ、ジェシカ！　安全運転だの、コースだのは忘れてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ、忘れるって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "なあにぽかんとしてるの？　シャキッとしなさい！　後ろのひっつき虫どもを撒いて、全部丸ごと忘れちゃうのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの人たちは、わたしには追い付けません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ええ！　こっちのテールランプすら見えやしないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "テールランプはもうとっくに取れちゃってますけど……その通りですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "いいわね！　この瞬間の気持ちを、湧き上がる思いをよく覚えておきなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "これはウッディからは学べない、あなただけが味わえる人生のひと時よ！　風のような、夕陽のようなね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "なんだか……感じたような気がします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "誰もあなたが進む道を指図することなんてできない。だって、ハンドルはあなたが握っているのだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "今目の前に見える道こそが、あなたの先に広がる未来よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……わたしの未来って、崖っぷち？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "車から飛び降りて！　はやく！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "マスター、起きなさい！　お客さんが来たわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "誰だようるせぇな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "おお、ヘレナ！　今日はやけに早いな。顔がホコリだらけだけど、何してたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "盗賊団に追い回されて、車ごとペシャンコになるとこだったのよ。ほら、こんな惨めなあたしを慰めるためにも、早く二十年物のヴィンテージを二杯、出してくださらない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "あんたなら、うちに置いてある在庫を全部把握してるだろ。一ヶ月物でよけりゃ、カウンターから勝手に注いできな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "こっちのお嬢ちゃんは初めて見る顔だな。ちょっくらおしゃべりしようぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "初めまして、おじいさん……わたしはお水で大丈夫ですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "「おじいさん」だって？　俺、そんなに老けてるのか？　フン、ヘレナに免じて許してやるが、そうじゃなきゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ご、ごめんなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "こーら、あまりからかわないの。あたしが今こうして生きているのも、その子のおかげなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "いつもここに置いてある氷は？　このお酒、ロックにしなきゃ飲めたもんじゃないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "一週間前くらいから製氷機が壊れてんだよ。もうちょい頻繁に通ってくれてりゃ、とっくに知ってただろうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "先週は、開拓地にいなかったのよ。あちこち駆け回って、クタクタだってのに、誰も心配してくれないのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "じゃあこうしましょ。店の前に繋いでる駄獣をプレゼントしてくれたら、製氷機を直してあげる。どう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "遠慮しとくぜ。レッドのことは諦めな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "大変！　時間が……ヘレナさん、急いで事務所へ戻らないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "大丈夫よ、一杯飲む時間はちゃんとあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "今はまだお酒を飲んでいい時じゃないですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "お酒はいつだって飲んでいいものよ。ね、「おじいさん」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "俺の前で可愛い子ぶるんじゃねぇ。お嬢ちゃん、酒ってのはな、飲みたいやつは時間関係なく飲むし、飲みたくないやつは一晩説得したって一滴も飲ませられん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "この一杯はあたしの奢りよ、ジェシカ。飲むか飲まないかは好きにして。ここの最高のお酒を奢るって約束を、守りたかっただけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "北に向かってひたすらに二十分歩けば、開拓地の事務所に着くわ。任務に向かう前に、顔を洗う余裕だってあるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ヘレナさんは？　本当に一緒に来ないんですか？　もしさっきの人たちがまた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あたしの心配はいらないわ。強盗は、この酒場になんて入ってこれしないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "その通りだ。ここは雨も風も防げねぇが、強盗の野郎どもだけは一人たりとも通さねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "元々あたしは、ついでに車に乗せてもらっただけだから、車がなくなったらここで解散よ。あなたは任務にいってらっしゃい。あたしはここでもう少し飲んだら、野営地に戻るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それに、さっきのやつらはこれくらいじゃ諦めないでしょうね。あたしと一緒にいて、万が一また絡まれたら、もっと任務に遅れちゃうわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "ハハッ、あんな身の程知らずのヤツどもを相手するのは、ヘレナ一人で十分だ。むしろ、お嬢ちゃんがいると、かえって足手まといになるんじゃねぇかなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そうですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、わたし足手まといになんてならないはずです。そもそも、荒野の盗賊を片付けるのは、保安官であるわたしの役目ですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "もう、足手まといだなんてあたしは言ってないでしょう。長い間、一人で荒野を駆け回っていたせいで単独行動に慣れてるだけよ。それに、今日は久しぶりに若い頃の感覚を思い出せたわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あたしのせいで、ジェシカが任務に遅刻しちゃったら、それこそ申し訳が立たないもの。だから、用事をちゃんと済ませてきなさい。自分が起こした面倒は、自分で片をつけるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "まさか、たかが悪ガキどもにあたしが手こずるだなんて思ってないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "たしかに、ヘレナさんの言うことは、どれも筋が通っているように聞こえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、自分が何もしないのは、なんだか申し訳なく感じてしまうんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "どうしてあなたが申し訳なくなる必要があるの？　保安官になったからといって、自分をその枠に閉じ込める必要はないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "役目だの、信頼だの、借りだの、守るだの……ウッディがそんなことをクドクド言ってるところを見たことある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、わたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "まあそれは彼が元々無口なせいもあるけど。ああ、話が逸れちゃったわ。もう一度思い出してごらん。今日、なりふり構わず、思いっきりアクセルを踏んだ時、どんな気持ちだったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ジェシカ、あなたにはルールで決められてない選択を下すこともできるし、そうするのに値する子よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "まだ若いんだから、自分のやりたいことをやりなさい。あたしを含め、他人から言われたことじゃなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ああ……若いのって素晴らしいわね……ねえ、マスター！　このお酒、やっぱり氷なしじゃ飲めやしないわ。本当に製氷機を直してもらわなくて平気？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "ああ、断じてお断りだ！　どうせ飲むのは俺じゃねぇしな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "つれないわね。あたしが力になりたいってこんなに頼んでるのに。はあ……知り合ってたったの数年で、もう冷たくなっちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの……製氷機の修理、わたしにやらせてください。まだ時間にも余裕はありますし。その……休ませてもらったお礼だと思っていただければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あなた儲かったわね。この子の修理の腕は、あたしにも劣らないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "じゃあ頼むよ。ついてきな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "さて、そろそろ支度しようかしらね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ふぅ……よし、これで大丈夫なはずです。ただ強く叩くのはもうやめてくださいね、マスター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "あんた、修理の技術は誰から習ったんだ！？　古新聞とガラスの破片にあんな使い道があったなんてな。おいヘレナ、聞いてくれよ……あれ？　ヘレナは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "グラスの下にお代が置いてあります……本当に一口も飲んでいませんね。そんなに美味しくないのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ゲホッ！　ゲホゲホッ、喉の奥がツンとします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "今日のあいつ、やけに思い切りがいいな。ん？　こりゃ二杯分にしちゃ、ずいぶん金額が多いぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "妙だな。チップにしたっていつもと比べて気前が良すぎるし……まさか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "しまった、俺のレッド！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒場の店主",
      "text": "ヘレナ！　レッドに傷一つでもつけてみやがれ！　これからお前の酒代だけ二倍にするぞ！　いや、注文全部二倍だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジェシカとマスターが外へ飛び出た時には、駄獣に乗った背中はもう遠くにポツンと見えるだけだった。\n夕陽の残輝のぬくもりは、複雑な表情を浮かべる二人を優しく慰める。荒野を吹き抜ける風に混じって、かすかな口笛の音と歌声が、耳元を掠めては消えていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "まだ見つからねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "タイヤの跡は崖の手前で消えてるし、足跡もわざと消されてます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "*クルビアスラング*、あの女、運がいいな。今後も俺の前に姿を現さねぇのが身のためだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "えっ、見逃しちまうんすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "じゃあどうしろってんだ？　あの女に追いつけた奴なんて今までいるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "ああ！　いましたよ！　望遠鏡で見つけました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "何人連れてやがる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "一人と、駄獣が一匹だけです。でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "顔に傷跡のある開拓者",
      "text": "なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "……こっちに向かって、何か合図をしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる開拓者",
      "text": "ボス、見つかっちまったのはあの女じゃない……俺たちのほうだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "さあ、逃げなさい。道中の無事を……祈っているわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
