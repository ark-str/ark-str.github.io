{
  "server": "jp",
  "storyId": "story_bldsk_set_2_story_1",
  "groupId": "story_bldsk_set_2",
  "stageId": null,
  "title": "たまには真剣に",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_bldsk_2_1.txt",
  "sourceHash": "55a09f9890f61f8a6be6d85fab61410952fe4e62af677f177fbfe64a5a5c5698",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ワルファリン先生。私の体に、何か異常でもあったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "うむ、異常ありだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "また少し身長が伸びたぞ、アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ううっ、驚かさないでくださいよ、ワルファリン先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "大ごとであろう？　妾なんかここ二百年は身長が変わっておらぬのだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "まあそれ以外は各指標に異常も見られなかったことだし、鉱石病の具合も比較的安定しておるから、悪くないと言えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "とはいえ、ロンディニウムに入ってからは、なるべく指輪を外さぬ方がよい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "と言ったところで、聞く耳は持たないだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの……ワルファリン先生、もしかして私たちがロンディニウムに行くことに、怒ってらっしゃいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "怒る？　アーミヤ、そなたの力で、妾の今の感情を感じてみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "とても穏やかです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ふむ、どうやら妾は自分の感情も勘違いするほど老いぼれてはいないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "二百年前なら思うところもあったかもしれんが、今では避けようもないことで怒りはしない。そんな暇があったら、研究にでも使った方がマシだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "避けようもないこと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "例えば、そなたにとって戦うことは避けられない運命だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そして紛争、死、憎しみ……それらもロンディニウムにとっては避けられない運命なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "しかし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "言うな、アーミヤ。そなたの言いたいことはわかっておる。その話はこれまで何度も聞いてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたを責めても、怒ってもいない。いちいち怒っていたら、命がいくつあっても足りないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "こっちへ来い。血液検査も行うから採血をするぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そういえば、ブラッドブルードである妾が医者になった理由を話していなかったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あ、その話は聞いたことあると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "たしか先生は、かつて同族と同じように、血に飢えて好戦的だったとおっしゃいましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "でも、しまいには戦争にうんざりしたとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "なんだ、話してしまったか。チッ、せっかく今「かつてはブラッドブルードの英雄だった」というバージョンを思いついたのに。今度その話をほかの奴にしてやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "誰も信じないと思いますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そうとも限らんぞ？　うまくいけば、ロドスでの妾の威厳を取り戻すことも不可能ではなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そんなことするから威厳がなくなるんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "まぁ、威厳などさほど気にしておらぬしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "話を戻そう。これは、そなたにも話していないことなんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "実のところ、どれだけ好きなことであっても、百年もやり続ければ飽きてしまうものだ。だからほとんどのブラッドブルードは、戦いに対して感覚が麻痺しておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "しかし、一つのことを百年も続けていると、それは習性に変わってしまう。種族全員にその習性が染みつけば、それはもはやその種族のアイデンティティと言えるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "つまり、血と戦への嗜好はブラッドブルードのアイデンティティなのだ、アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そして未だに、妾は身についたその「アイデンティティ」を克服できておらぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それでも、ワルファリン先生はロドスで事故というほどの事故は起こしたことがないじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "当然だ。妾は二百年も自分を鍛えてきたのだぞ。普段のあれやこれはただの戯れに過ぎん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "S"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そんな目で見るでない。まぁ、ドクターの前では少々取り乱しがちなのは認めよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "それについては、ロドスのメンバーが増えてきてからは、妾も何か対策せねばと思案しているのだが、まだいくつか実験が必要で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "いや、その話はさておき、ともかくだ。妾が医者になった理由は簡単だ。戦争に飽きて、うんざりしたからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そして妾は、ブラッドブルードのアイデンティティから脱却しようと決めた。本能を克服する方法を探しているうちに、成り行きで医学研究者になったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それがきっかけでケルシー先生と知り合いに……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あやつは謎も肩書きも多いが、医者としての腕は確かだ。そなたがそう思うのも無理はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だがアーミヤ、そなたには、あやつが他人と膝を突き合わせて、医学理論について真摯に語らうような人に見えるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あるいは、そなたには妾がそのような輩に見えるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "でも、お二人はかなり前からの知り合いですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ちょっと待ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "確か、これかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "いや、これはその後あやつと共作で出した本だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "このボロボロのやつはなんだ……？　ああ、そうか、これは妾が初めて出した論文が掲載された雑誌だ。休刊後に記念として取っておいたのだった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あったあった、この雑誌の束だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "これは……何十年も前の医学専門誌！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "当時、妾はこの雑誌に寄稿していたが、ある日とんでもない長さの論文で妾の理論上の欠陥を指摘した奴が現れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾に間違いがあったわけではないが、あやつが指摘したのは、いずれも妾の考えが足りなかった箇所だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "負けず嫌いな妾は、あやつの考えを取り入れて、実験をやり直してみた。すると本当に改善が見られたときた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "当時は誰でも雑誌に論文を載せられる時代だったが、あの一本は妾の目にかなう数少ないレベルの高いものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "その人は、もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "もちろん、ケルシーだ。ペンネームすら使わない女だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "その後、妾は立て続けに十数本の論文を出して反論したが、それ以来あやつは一本も出さなかった。それが一番腹立たしい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "確かにケルシー先生らしいです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そしてある日、魔王テレジアの代理として、妾に加入してほしいという女が来た。そやつはこの雑誌を取り出して、自分がケルシーだと名乗った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……それから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾はあやつを追い出し、この雑誌への寄稿もやめた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ？　あの時ケルシー先生にあるお医者さんのところに連れて行くと言われましたが、てっきりお二人は前からの友達かなと思ってました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "ワルファリン、これは王庭直々の命だぞ。逆らうつもりか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "小童。妾が今までどれだけの王庭の貴人に会ってきたか、その中でどれだけの者をつまみ出してきたか、知りたいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "これは戦争だ。我々の種族全体の命運がかかっているんだぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "……うっ、お、お前、何をした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ここに留まれば、十秒後にはそなたの血が固まり始め、十五秒後には彫像となろう。今出ていけば、まだ間に合うぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "嘘だ、そんな能力を持つブラッドブルードなどいるものか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ならば、その身で確かめるがよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "チッ、王庭に逆らえると思うなよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "おうおう、その言葉は聞き飽きてるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "はぁ、これでまた新しい住処を探さねばならんな。金も貯まってきたし、いっそヴィクトリアにでも引っ越すか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "医療機器を全部運ぶのは大変そうだが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ青年",
      "text": "おい、ワルファリン、本当にあいつを彫像にできるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "できるわけなかろう。脅しただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ青年",
      "text": "そうか。しかし、君がすごい人だっていうのは本当だったんだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "何を今さら。ブラッドブルードで知らぬ者のおらぬ名医だと言っただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ青年",
      "text": "医者をやるブラッドブルードなど聞いたことないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ青年",
      "text": "それで、どうしてこんな辺鄙な場所に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "好きだからだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "カズデルの辺境に近いここに住めば、論文を国外に送るのも容易だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……一人また一人と……まったくなんて日だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ青年",
      "text": "誰だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "治療を求める者だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あいにくだが、戦争に関わる者は診ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ青年",
      "text": "ワルファリン、こいつを追い出してやろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたが？　やめておけ。自分の血をここに残して、代わりにおふくろさんに薬を持っていってやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ青年",
      "text": "おぉ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "この辺では、名が知られているようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたほどではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "で、さっきのは何の冗談だ？　そなたのような者に妾の診察が必要あるのか、ケルシー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "診てほしいのは私ではなく、この子だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "こ、こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾のルールを知っておるな、ケルシー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "何をどうあがこうと、テレジアは紛れもなくこの戦争に関与している一人だ。そして、そなたもまた彼女の手の者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたが連れてきた者は誰であれ、妾は診ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "テレジアは死んだ。この子が新しい魔王だ、ワルファリン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あの頃は妾の肘に届くかというくらい小さかったのに、今やこんなにも大きくなって……あと何年もしないうちに背を追い越されるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "気付けば、出会ってからもう四年になるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "初めてワルファリン先生に会った時は、私もびっくりしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "医者に見えなかったからか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そうか。まぁ、妾はケルシーと違って、無駄に偉そうに振る舞うやり方に興味がないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "当時、ロドスはカズデルからの撤退準備中でした。艦内の設備も多かれ少なかれ被害を受けていて、治療のため他の場所へ連れて行くと言われたのを覚えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ケルシー先生の話では、その医者はブラッドブルードだけど、奇特な方で、血よりも研究の方が好みだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "医者としての腕は確かで、戦争が起こるたびにブラッドブルードの王庭から声がけがあったほどなのに、いつも断っていたとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あやつのことだから、妾の悪口を大げさに話すと思ったら、ありのままを話したのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そうだ、ワルファリン先生、一つお聞きしてもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "その先生という呼び方をやめたら、答えてやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたは一応、妾の上司だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うーん、でもワルファリン先生は私の命の恩人ですよ。それにロドスの医療の基盤を作り上げたのも、ワルファリン先生とケルシー先生のお二人です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "他の人が知らなくても、私は知っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あぁ、わかったわかった、答えてやるから聞くといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "先生はどうしてロドスに入ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "医学の研究と命を救うために決まっておるだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "でも、当時のロドスは今と違って、カズデルから撤退することだけが目標でした。それでもケルシー先生の誘いに応じたのはどうしてですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "アーミヤの様子は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "身体の方は問題ないが、精神状態がいささか厄介だ。おそらく魔王になった影響だろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "うわごとを言ったり、無意識に他人の感情を読み取ったりする。力も制御できていない。普通の医者なら、お手上げだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だから君に頼んだんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたも残ってこの子の面倒を見てくれると思ったら、妾に任せきりではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "テレジアとドクターを失ってから、ロドスの指揮系統は混乱し、各勢力からも密かに狙われている。私が前に出て秩序を維持しなくてはならないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そんな状況で、よくも新しい魔王を連れてはるばる妾のところを訪れたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ケルシー、この子は魔王なんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "こんなか弱い女の子を後継者に選ぶとは、テレジアも惨いことをするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "しかし、アーミヤは彼女が残した唯一の希望でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ケルシー、サルカズにとって希望は毒だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたの噂は色々聞いておる。次の魔王を手に入れておいて、何も企んでおらぬとは思えんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "この子を待っているはずの苦難を背負わせるより、眠っている間に苦しみなく逝かせた方が良いかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……できるものなら、私もこんな事態は避けたかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "しかしこうなった以上、もう戻ることはできない。医者として、今はただ一つの命を救いたいだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "医者だと？　綺麗事は結構だ。そなたもまた計画者であり、冷徹な戦略家であり、戦争の共犯者でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "否定はしない。だがワルファリン、そういう君は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君はあらゆる王庭からの誘いを断り、戦争を遠ざけた。辺境の町に身を隠しながら、地元の住人にのみ治療を提供するブラッドさんの名はとうにヴィクトリアとクルビアの医学界に知れ渡っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ブラッドブルードの異分子になっても己を貫こうとする君だが、戦争から逃れたい全ての人を救おうというのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ケルシー、そなたの目的はわかっているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ほう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "包み隠そうともせず自分たちの現状を妾に打ち明け、新しい魔王を妾に託し、自らは敗北者のふりをしてこの戦争と無関係のように見せかける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "その目的はただ一つ、妾を引き込むためだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾の返事はあの時と一緒だ。断る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "テレジアの理想は、最初からサルカズにとどまってはいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "彼女はより遠いところを見て、より大きな志を抱いていた。それが今回の災いを招いたのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "戦争を起こす者は皆、美しい理想を語る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "テレジアには鉱石病の治療に取り組みたいという考えがあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……理想にそれを掲げるのは初めて聞くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そしてロドスには、それに関する研究の原形がもう出来ている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……そなたがやったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "もちろんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "テレシス動向を巡って、いずれロドスが動くこともあるだろう。それは否定しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが約束する――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "それに関与しない権利を、君に与えることを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの時、ケルシー先生がそんなことを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "勘違いするな、妾は断った。体裁の良い言葉ばかり並べる手口はさんざん見てきた、ああも簡単に説得されるわけがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だが翌日、そなたを連れ帰ろうとやって来たあやつは言った。怪医ワルファリンがロドス陣営に加わったという噂を流したのだと、もはや断っても手遅れだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "それを聞いてカッとなった。宮廷のしつこい勧誘から逃れるために何百年も逃げ回ってきた妾だぞ、今回も逃げきってみせると思ったら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "あやつがMon3trを操って、妾をロドスに「ご招待」ときたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "正直、あやつとテレジアが本気で鉱石病の治療に取り組みたいなど微塵たりとも信じていなかった。鉱石病に関する研究資料をあやつから見せられるまではな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そして妾は、戸惑いながらもここに残った――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "おい、アーミヤ、何やら辛そうだがどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "もしや血を採り過ぎたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "いや、妾に限ってそれはないな。たとえ寝ぼけていてもそのようなヘマをするはずがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……つまり、ワルファリン先生はここを去るおつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "なっ、どうしてそういうことになる！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "だって……私たちはもうすぐロンディニウムに入ります。今日、ワルファリン先生が珍しく真面目なのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ロドスがやろうとしていることが自分の目標と合致しないから去るつもりだと、そういう話をするためでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そんなことはないぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたは艦内の患者たちを見捨てるようなことをするか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もちろんしません。だからこの採掘場作業プラットフォームに停泊することにしたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "無理やり妾を一緒に連れていくようなことは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それもしません。今回の行動はロドスの名義で行うものではありませんから、ほとんどの人は艦内に残ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ならば、妾が去る理由はどこにもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "今日いろいろ話したのは、そなたにとってロンディニウムに行くことが一つの決断であり、新たな門出だからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたのかつての主治医としては、プレゼントを用意してあげるべきだと思ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "プレゼント、ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾の記憶が確かなら、この話をするのは百年ぶりだ。ケルシーと語らう時だけ話したくなるような話題だしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だが、あやつはすべてわかってるし、わざわざ妾の口から言う必要もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "まぁしかし、ここまで話した以上、もう少し言わせてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "アーミヤ、戦争を起こすような者に、本物の愚か者はいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そのほとんどは、極めて聡明だ。自分やその一族が望むものを手に入れるには奪うことがもっとも簡単で、効率的なやり方だとよく心得ているのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "自分がしていることを理解しているからこそ、何のためらいもなく異を唱える者を排除し、この大地を血で染めることができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "やがて己の目的を達成し、新たな秩序を構築したところで、また次の革命児に倒される。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そしてこれらはまるで終わりがないかのように繰り返され続け、おそらく本当に尽きることはないのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい、わかっています。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "はぁ、そなたには、わかってほしくなかったんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "まぁ、それと、一つだけ知ってほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ケルシーが言った通り、妾は戦争が「嫌い」なのではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "戦争から離れると決めた後、妾は王庭を去り、あちこちを転々としながら隠棲生活を送っていた。そして医者となり、戦争に関わる者を診ないというルールを決めた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だが、もし妾が戦争を嫌うとしたら、志を抱く者たちのように、戦争を終わらせるために戦争に身を投じるべきだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "彼らのやり方を軽蔑はしない。ただ終わりがない、そう思っているだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾の選択は臆病と思われても仕方のないことだ。戦争に対し見て見ぬふりをする、それはすなわち戦争を黙認していることになる。多くの命を救ってきたが、より多くの犠牲には目を瞑ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だが科学的な観点から見れば、戦争とはまさに一種の終わりのないエネルギーロスであり、未来へ進むためにはより良い道があらねばならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ちなみに、これは本で読んだ言葉だ。かっこいいだろう？　覚えておいて損はないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "確かにそうですね。何という本に出てきたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "……忘れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ふむ、探してみよう。見つけたら今度教える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ああ、そうだ、それから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾がエリートオペレーターにならなかったのは、いずれそなたたちの歩む道に戦火の燃え上がる日が来ると知っていたからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "これは妾の最後の一線であり、誰のためにも譲るつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だから妾が怒っているとか、がっかりしているとか思ったら、それは大間違いだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "最初から期待していないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "とはいえ妾は、この手でロドスの血液センターを作り上げ、わずか数人だった医療チームが今日の規模になるまで成長し、ロドスが医療会社にまで大きくなるのを見守ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたとケルシーが鉱石病を治す志を諦めていないと、そう信じている限り……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾はずっとロドスに残って、ここにいる患者全員の面倒を見る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "これが妾から贈れるせめてものプレゼントだ、アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ワルファリン先生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "約束します。私は絶対に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "死にに行くような言い方をするな。約束なんかより、出発の前にドクターの血を採らせてはくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それは……ケルシー先生の許可が必要かと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "チッ。アーミヤ、何でもかんでもあやつの言うことに従ってばかりではならぬぞ。ちゃんと自分の考えを持て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そう言われても、ドクターの血をむやみに採取するなんて、私も認めませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "やはり探求心が足りないな。前から考えていたんだが、今度帰ってきたら、しばらく妾のところで実習した方が良い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "アハハ、考えておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "こんなに長く話したのは久しぶりだ。喉が渇いたぞ。アーミヤ、そなたの右手側にある血液の入った試験管を取ってもらえぬか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "冗談だ、最近よくこうして人をおちょくっておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ブラッドブルードへの固定観念を利用して人を怖がらせるのは楽しいぞ。特に幼子にはよく効く、注射の時などすぐ大人しくなるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そんなのダメですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "なあ、アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾はロドスの患者全員を診ているが、そなたは妾がここで引き受けた最初の患者だ。それだけは忘れないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だから、生きて帰ってこい、わかったな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
