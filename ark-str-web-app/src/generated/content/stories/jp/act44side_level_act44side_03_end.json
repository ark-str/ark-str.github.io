{
  "server": "jp",
  "storyId": "act44side_level_act44side_03_end",
  "groupId": "act44side",
  "stageId": "act44side_03",
  "title": "夜逃げの誘い",
  "storyCode": "AT-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act44side/level_act44side_03_end.txt",
  "sourceHash": "a0845e34cec55b035527435cd410893d836872cc2e30df1d048126bb1338070f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "今のニュースは何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "わ――わかんない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "慣れたふうだったが、金兵衛は前にも番組の司会をしていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "金兵衛って？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "三船のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "えっと、私がすごく小さい頃のことだから、詳しくは覚えてないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "所長が言うには、金石テレビの創業初期はどんな番組も三船さんがこなしてたらしいよ。ニュースも、バラエティも、なんでも……天気予報で外ロケにゲスト出演することもあったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "そういえば、私も金石テレビで結構長いこと天気予報のコーナー担当してたなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "と、話を戻して……そのあと金石テレビはどんどん大きくなって、あの人も重要なニュースしか担当しなくなって、その後は完全に番組に出なくなって、裏方に引っ込んじゃったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "では、今のは一体――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "目ざとい通行人",
      "text": "見て、あそこ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きがない通行人",
      "text": "あれ青鬼じゃない！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きがない通行人",
      "text": "ほんとに萌々香と一緒にいる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きがない通行人",
      "text": "どうする、止めたほうがいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目ざとい通行人",
      "text": "死にたいの？　それよりテレビ局の人に知らせましょうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目ざとい通行人",
      "text": "ほら見て、あの子泣いてるわ。きっと青鬼に無理やり連れてこられたのよ……もしかしたら洗脳されてるのかも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きがない通行人",
      "text": "そっちはテレビ局に連絡して。あたしは警察に通報するから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "目ざとい通行人",
      "text": "でも、警察は何度も通達出してたじゃない。うちは心霊対策局じゃない、怪談関係の通報は受け付けないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きがない通行人",
      "text": "それもそっか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "チッ、急いだほうがよさそうだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "萌々香はすでに全速力を出していたが、星熊には目の前の景色がどこまでもループしているように見えた。\nネオン、通行人、摩天楼、十字路。ネオン、通行人、摩天楼、十字路――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "だがある瞬間に、そのループが不意に途切れて、鍛冶町のような古びた街並みが視界に広がり始め、建物の数も次第にまばらになっていく。\nやがて二人は、一面に広がる荒地を進んでいた。そこには着工した形跡がある場所も、すっかり荒れ果てた土地もあった。\n次第に空が白んでいく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "星熊さん、もうすぐ目的地だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "よし――待て、減速しろ！　これでは突っ込んでしまうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "萌々香は思い切りブレーキを踏み込んだが、時すでに遅し――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "スクーターは風を切って神社の境内へと突っ込んで、その中央でようやく止まった。それでも、萌々香の優れたバランス感覚のおかげで、二人は転倒せずに済んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "やっちゃった……！　これって神社に対して失礼なんじゃ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性の神職の声",
      "text": "宮司様！　宮司様！　また女の人が突撃してきました！　今度はスクーターに乗ってます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性の神職の声",
      "text": "なんだって、また！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性の神職の声",
      "text": "今回はなぜか誰に止められることもなく、二人して一直線に突っ込んできて……！　境内の中央で止まりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "「二人」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "乗っていたのは本当にヴァルポでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性の神職の声",
      "text": "ええと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性の神職の声",
      "text": "宮司様、あれはヴァルポではありません。一人はエーギルで、もう一人は鬼です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性の神職の声",
      "text": "申し訳ありません、前と似た状況だったので、慌てすぎて顔をよく見ておらず……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "気を配っているからこそ、冷静さを欠いてしまったのでしょう。あなたのせいではありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "訪れたのがどなたであれ、私が対応しましょう。皆さんは、仕事に戻ってください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "ごめんなさい宮司様！　わざとじゃないんです！　緊張しすぎて、ブレーキを踏み忘れてしまって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "誰かと思えば、萌々香さんではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "ぐ、宮司様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "なんだ、知り合いか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "萌々香さんは以前、よくここへ来てくださっていたんです。五年前を最後に、しばらくお見えになっていませんでしたが、それはきっと願いが叶い、生活が軌道に乗ったからでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "実はそうでもないんです……あれからどんどん忙しくなって、神社に来る暇もなくなっちゃっただけで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "そう落ち込まないでください。ここは縁結びの神社ですので、ご活躍されている萌々香さんは必然ご縁に恵まれていて、来る必要がないのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "ところで、お隣の方はなんとお呼びすれば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "星熊でいい。ある人を探すため、こちらにお邪魔した次第だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "誰をお探しなのでしょう？　この神社に勤める神職はそう多くはありませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "神職ではなく……人に頼まれて、ある「神様」を探していてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "正確には、姿の見えない誰かが乗った一輪車を――御机では「輪入道」と呼ばれるものを探しているんだが、あれは本物の神様なのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "人に頼まれてと仰いましたが、その方がご縁を結ぶため、あるいはご加護を求めて神様をお探しなのであれば、ご本人にお参りいただかなければなりません。人に託して願うことなど成りませんので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "その人はただ神様にお会いしたいだけで、ご縁や、ご加護の類にはあまり興味がないようだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "森内君はつくづく頑固ですね……いえ、粘り強いと言うべきでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "森内さんを知っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "ご加護を願うでもなく、特定の神様に会うことだけを望む人など彼くらいのものですので。もう長年の付き合いになりますから、顔なじみですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "それなら、神様探しにも協力してくれますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "いや、森内さんが私に依頼をしてきたのは、宮司様でも力になれなかったからだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "星熊さんが仰った通り、神様ご自身に姿を見せる気がないのなら、我々神職にもできることはないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "お二人が神社に対して無礼を働いたから、ということではありませんよ。まあ、それもスクーターで境内に乗り入れたことを除けばの話なのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "じゃ、じゃあどうすれば？　神様に謝るべきでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "そうですね……神様のお怒りを鎮めたいということであれば、まずあちらの授与所で、すべてのお守りを一つずつお買い上げいただきましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "それから一回百文のおみくじを引き、「末吉」「中吉」「大吉」を一枚ずつ揃えてください。途中で他のものが出ても基本は構いませんが、「大凶」が出たら最初からやり直しとなります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "ええっ！？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "――そして最後に、\n今言ったことはすべて冗談です。あのくらいのことでは、神様はお怒りになりませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "えええっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた神職",
      "text": "お二人がこの神社で真に望む物を得られますように。では、雑務がございますので、私はこの辺りで失礼しますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "びっくりしたー。お金足りるかなあって思わず考えちゃったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "どうやら、宮司様には神様探しを邪魔するつもりはないらしい。それだけでも僥倖だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "まずは一息つくとしよう。おみくじでも引いて、気を静めてきたらどうだ？　その間に、私は周りを見てこよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "うん……そうするよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "星熊は境内をゆっくりと歩き始めた。\n彼女には神社や神道にまつわる知識はほとんどなく、目の前の建物が「本殿」か「拝殿」かあるいは「幣殿」なのかさえわからなかった。\n森内が見せてきたキーホルダーと似た形の物はなく、しいて言うなら、石灯籠の後ろにペッローの獣眷らしき二つの彫像があるくらいだ。\nしかし、この場所に吹く澄み切った風は、子供の頃父と共に僧院を訪れた時のことを思い出させた。\nあの時は、松林の中に父と鉄斎の姿が見え隠れする中で、住職が彼女の頭を撫でながら、最初の鬼にまつわる物語を語り聞かせてくれたものだ。\nあの鬼の名は、確か「クイロン」だったか……"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "星熊さん、星熊さん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "大変なの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "……大凶でも引いたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "ううん、末吉だったよ――じゃなくて！　変な音が聞こえたの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "輪入道か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "わかんない！　そうかもしれないけど、もし幽霊だったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "こんなに朝早くから出てくるなら、とんでもない凶悪な怨霊かも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "せめてあの宮司様のことは信じたらどうだ。彼が怨霊などを神社に入れると思うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "それはそうだけど――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "わっ、また聞こえた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "落ち着け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "うぅっ、そう言われて落ち着けたら苦労しないよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "まさか本当に輪入道がいるとは。地面にタイヤの跡が残っているな……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "跡が残れば後を追われると悟ったのか、一輪車は石畳の道へと進路を変えたようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "ど、どうしよう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "これはむしろ好都合だ。奴は石畳の上しか移動できないわけだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "だけど……神様なのに、どうしてタイヤの跡を隠すくらいのこともできないのかな……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今……なんつった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "しゃ、喋った！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "獣眷像の後ろか！　萌々香、お前のほうが近い！　すぐそこだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "消えちゃった？　どこに行ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "いや、後ろに回り込んで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "私の……後ろに？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "きゃっ！　ゆゆゆ、幽霊が、幽霊が追いかけてくる！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "輪入道を見た人って不幸になるんでしょ！？　じゃあ追いかけられてる私なんてもうおしまいじゃない！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一人と一台の立場は瞬く間に逆転し、まるで初めから萌々香が追われる側だったかのように、一輪車は彼女を執拗に追い回している。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "萌々香、止まれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "と、止まるの！？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "その指示の意図が掴めないまま、萌々香は思わず足を止めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すると、星熊が般若を放り投げた。三角形の巨大な盾が一輪車の進路を遮って、それはたまらず急停止する。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "萌々香、そこを動くな！　私が奴を捕らえよう！　もしそちらに向かわれても、慌てるなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "わ、わ、わかった！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "星熊は角度を見定めて、一輪車が逃げられないようゆっくりと追い詰めていく。\n一輪車はその場に留まったまま、ハンドルをせわしなく左へ右へと動かしていたが、そのペダルはまるで動いておらず――とはいえ、どちらへ進むべきかの判断は難しくなかったようだ。\n一方には背の高い鬼が、そして一方には先ほどまで逃げ回っていたエーギルがいるとなれば……\n一輪車は、すさまじい勢いでペダルを回して、萌々香のほうへまっすぐに向かってきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "萌々香、そいつを捕まえろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "猛スピードで突っ込んでくる一輪車を見て、萌々香は咄嗟に背を向けて逃げ出そうとした。だが、その足は少しも動かない。\nああもうダメ、逃げられない、おしまいだ――そんな考えが頭を埋め尽くし、彼女は恐怖に固まる羽獣の如く呆然と立ち尽くした。\n一輪車が近づいてくる。\n怪談話の通りなら、もう助からないが――実際のところ、ツイていないのは輪入道に会う前からではないだろうか？　そんな考えが不意によぎった。\nもしおでん屋台の前で星熊に会っていなければ、とっくに……"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "萌々香はつばを飲み込むと、星熊を見やってから、数歩先まで迫る一輪車に目を向けて――\n逃げることなく、それどころか飛び掛かっていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "宮司様、不届き者が池の中に飛び込んで……あれ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "えっ、萌々香！？　それに星熊も？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "何やってるかは知らないけど、あたしも加勢するよ！　ごめんね宮司様！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "星熊さん？　吉星さんも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "それに……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "池の中には、小さな一輪車が置き去りにされ、ペダルだけがからからと回り続けている。\nそして、一輪車に乗っていたものは、今や彼女の目の前にいた。それは小さな頭にぴったりのヘルメットをかぶっており、丸く輝く両目は、身体から滴る水滴を呆れた顔で見つめている。\n萌々香の傍らにいる星熊は、彼女に怪我がないのを確かめると、安堵した表情を見せた。\n彼女は背後にいる吉星らしき人物に軽くうなずいて見せ、それから遠くを見やった……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "どうあれ、萌々香はようやく何かを成し遂げたらしかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "あなたってやっぱり……幽霊か何か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あのなお嬢ちゃん、水でずぶぬれになる幽霊なんざどこにいるってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それに、こんなんただのかくれんぼだろ？　お前もあっちの鬼も本気になっちまいやがってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "ほ、本気って……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さっきはすげえ顔してただろ。俺を水に叩きこんでやらなきゃ、自分の人生に価値がなくなるってな具合の表情だったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "森内の奴にしたってそうだ。確かに俺は神だが、あいつは神なら何でもいいからとにかく追っかけりゃ、都合よく目当ての招き猫に辿り着けるとでも思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "吉星",
      "text": "萌々香、宮司様を引き離しとこうか？　それとも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "text": "ううん、大丈夫。私たちが探してた人――じゃなくて「神様」は、ここにいるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな神",
      "text": "まあ安心しろ。こうして姿を見せたからには、勝手にとんずらこいたりしねえよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな神",
      "text": "この俺がついてる限り、この神社でお前らにちょっかい出せる人間なんていねえんだ。好きなだけ池に浸かってりゃいいさ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "萌々香はおそるおそる神に手を伸ばした。すると、今度は逃げることなく――落ち着かない様子ではあったが、人間に撫でられることは承知してくれたようだった。\n境内を涼やかな風が吹き抜けて、水面を撫でていく。こうしていると、夜明け前に繰り広げられていたあの逃亡劇も、恐ろしい現実ではなく、奇妙な夢を見ただけのようにすら思えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "逃しただと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "相手は怪談話如きで腰を抜かすような小娘だぞ。それを、逃したのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "構成員たち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "何を黙っている？　金石会の構成員は家族同然なのだから、この件もヘラヘラ笑っていれば水に流してもらえるとでも思うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "肝の据わった構成員",
      "text": "そのようなことはございません、親分！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "肝の据わった構成員",
      "text": "彼女は青鬼と共にいまして、我々ではどうにも力及ばず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "なんだと？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "三船は一歩前へと踏み出すと、その構成員の目前に顔を近づけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "鉄斎と結託して鍛冶町の発展を妨害し、俺の命令に背いて勝手に逃げ出した挙句、あんな女と組んでいるような奴を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "まんまと取り逃がしておいて、力及ばずなどという一言で済ませるつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "肝の据わった構成員",
      "text": "っ、わ、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "武彦の件は聞いたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "肝の据わった構成員",
      "text": "は、はい。親分が直々に手にかけざるを得なくなってしまい、葬式を盛大に執り行って、親分は墓前で泣きながら武彦を弔っていらしたと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "あいつを殺したのは誰だと思う？　俺か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "肝の据わった構成員",
      "text": "もちろん鉄斎のクソ野郎です。奴が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "違う、あいつを殺したのはお前らだ！　お前らが揃いも揃って、力及ばずなどと言い訳を垂れ、鉄斎を今日まで野放しにしてきたせいで武彦は死んだ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "三船の手がゆっくりと懐へ伸び、何かを取り出そうとしている。\n構成員は微動だにできずそれを見ていた。やがて、三船の手が懐から引き抜かれ、ゆっくりと開かれると……\n数枚の金貨が、鈍い音を立てて落ちてきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "肝の据わった構成員",
      "text": "こ、小判……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "偶然引き出しから出てきたものだ。拾え、くれてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "肝の据わった構成員",
      "text": "ありがとうございます！　ですが、これは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "次に「力及ばず」などと言ったら、自分の腕を斬って落としてもらう。その金は最高の義手を買うのに使うといい。わかったな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な忍者",
      "text": "親分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な忍者",
      "text": "我々の手の者が仁田街から北へ追跡を続けていたのですが、萌々香と星熊が……神社に入っていくのを確認しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "聞いたか？　やはり俺自ら育て上げた忍者のほうが優秀だな。お前たちも少しは見習うことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "構成員たち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "神社、と言ったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な忍者",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "神社は神域であり、清らかなる土地だ。そんな場所で騒ぎが起きて喜ぶ者などいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な忍者",
      "text": "と、仰いますと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "お前たちはこの役立たずどもを連れて神社を取り囲め。ただし、目立たないようにしろ。中の連中が外に出られないよう見張るだけで構わん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "あの二人が立てこもるようなら、番組スタッフを何人か送り込んで叩き出せ。奴らと関わった連中も逃すなよ。神社が近すぎて手を出せないのなら、場所を移せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な忍者",
      "text": "中にいる神職は如何しましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "まだいい。奴らに手を出すのは時期尚早だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な忍者",
      "text": "承知しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "では行け。俺は客人を待たせているのでな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "……三船さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三船の冷ややかな表情はすぐに消えることはなかったが、哲也を見やるとそれは徐々に和らいでいった。まるで、苦悩と疲労の果てに新たな希望を見出して、ようやく安らぎを得たかのような顔だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "今出ていった人たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "いつも通りだ。お前ほどやる気のある奴は誰もいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "あいつらのことはいい。お前の家はどうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "親父は……相変わらずでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "そう落ち込むな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "俺は今でも覚えているんだ。お前がまだ小さかった頃、両親に手を引かれて歩いていた姿をな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "はぁ、それがまさか、金石会のためとはいえ、おやっさんが泣く泣くお前を手放すことになるとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "三船さん、親父を庇うことないですよ。あいつは会長の座に長く居座りすぎたせいで、人間らしい感情なんてなくしちまったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "そう言うな。父子の間に流れる血は水よりも濃いものだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "俺も昔は、おやっさんを実の父親のように思っていたんだ。しかしあの人はどうにも俺を認めてくれず、そのせいで行き違いが増えてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "とはいえ、今回北院のスパイが御机に潜入してきたのは、一つの転機になるかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "と言うと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "お前の母上殿はかつて、北院との繋がりを疑われ、濡れ衣を着せられたんだ。お前がスパイを捕らえれば、おやっさんの態度も和らぐだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "ちょうど、そのスパイに関する最新の情報が入ったところでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "聞かせてください！　そいつがどこにいようと、必ず捕らえてみせます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "そのスパイは……鍛冶町にいるそうだ。しかも、噂の「幽霊屋敷」に関わっている可能性がかなり高い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "まさか……星熊の……姉御が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "あいつは――いや、あいつはこの件には無関係だ。単に帰ってきたタイミングが悪かっただけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "ですが、あの人がいるのなら、中には入れませんし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三船",
      "text": "だったら、あいつがいない時を狙えばいいさ。それに、鍛冶町は広いんだ。ほかの手掛かりが見つかるならそれもいいだろう。さあ、行ってこい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哲也",
      "text": "は、はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そうして、次に部屋に入ってきた女性を見やるなり、三船の表情はまたもや一変し――\n疲れ、辟易し、苛立ちながらも、すべては手のひらの上にあり、あとは機が熟すのを待つのみだという自信がそこに滲み出ていた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
