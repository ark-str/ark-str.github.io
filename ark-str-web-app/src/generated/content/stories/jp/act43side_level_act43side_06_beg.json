{
  "server": "jp",
  "storyId": "act43side_level_act43side_06_beg",
  "groupId": "act43side",
  "stageId": "act43side_06",
  "title": "巻き戻された独白",
  "storyCode": "AD-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act43side/level_act43side_06_beg.txt",
  "sourceHash": "ac3677f24ebd9cf7e1cf21de9523743119f9f2eecaae24ccb984af6441194ab6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "真っ暗なフロアで、小柄のザラックの女性が一人手探りで歩んでいる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "うん……なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "構造とシステムは一見複雑だけど、原理さえ理解すれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "ただの小道具師にでも操作できるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "例えばここ、まずは方向を調整して……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "時間を設定したら、レバーを引いて、シャッターを開く。それから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "できた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "うん、完全に想像通り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "これで、たとえ予期せぬ事態が起きても……何とかなる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "さて、残るは最後の仕事だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "彼女のところに行かないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "懸念があるのはわかっているわ、ルシアン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "今この区画は危険な事件が簡単に起きる状況で、みんな殺されるかもって怯えてるのに、やみくもに撮影を続行するなんて言い張るプロデューサーは、どこからどう見ても信用するに値しないものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "我々の間に、信用は必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ふっ……そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ランクウッドで二十年やってきたけど、私はどのパートナーも信用したことがない。信じているのは自分の目だけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私はメラニーがチャンスを最も必要としている時に彼女にオファーを出した。オークションであなたが演技の奇才だと見抜いた。アブナーは私を恨んでいても撮影には加わるだろうと判断をした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……そして、五年前はローラの死が映画を救う唯一の答えだと確信した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "君はあの事故とは無関係だ。だが彼女の死を利用した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ローラは才能に恵まれた新人だったわ。勉強熱心で、勤勉で、作品へのあふれんばかりの情熱を持っていた。ただ時々積極的すぎて、ルールを破ってしまうことがあったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "五年前のスティーヴンは経験が浅くて、作品は期待したレベルに達しなかった。撮影の途中で気づいたわ、この映画は私の口座を空にし、それだけでは飽き足らずに名声まで地に落とすだろうと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "その危機を乗り越えるには「外的要因」が必要だった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ローラの転落死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "メディアを利用して、撮影現場の裏話で世間を賑わせたところで何の意味もないわ。野次馬が少しの間ため息をつくだけで、あっという間に忘れ去られてしまうもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "そこで、私は大金を注ぎ込んで警察の捜査とテレビ局の注目を抑え込み、ローラの家族にも相当な額の弔慰金を渡した……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "アブナーが撮影していた転落死シーンを全て残しておくよう編集者に伝え、あえて映画のクライマックスシーンにしたの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "彼女のことを嵐のように現れて引退していった天才女優だと思っている人は今でもいる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "君は彼女の死を隠した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "彼女が映画の中で永遠に生き続けられるようにしたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "いずれ君の手管に気づく者が現れるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "毎年ローラの命日には、彼女に会いに行っているわ。五年が経って、今では彼女の墓前にあるのは私の捧げる花だけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "罪悪感を覚えないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私は咎を免れることはできないでしょう。でも今は、懺悔なんかしてる場合じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "この瞬間にやりたいことはたった一つ――映画を撮り終えることよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "『ミズ・デュポンの死』の上映後、撮影中に起きた連続殺人事件は必ずメディアの注目を集めるわ。それを機に、ローラの死の真相も正式に公表するつもりよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "その時になれば、もっと多くの人が彼女を悼み、私は、私の罪と向き合うことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "今の告白が、感傷から出た言葉ではないことはわかるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "君は自身の真実をもって、私と取引がしたいのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "あなたに初めて会った時、これは運命が与えてくれた恵みだと、これからクランクインする私の映画へのとても大きなプレゼントだと思ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "でもチームに加わってからの数々の振る舞いを見て、それだけではないと確信した。あなたはただ者じゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ダルトンが目の前で死んでも、あなたの表情は落ち着いたままだったもの。それどころか、撮影の続きを楽しみにしている節まであったわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私が天災を撮影しようとしている証拠を掴んだ時、あなたはそれを絶妙なタイミングで、一番口の軽い撮影アシスタントに教えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "今、チームが正式に解散し、ほとんどの人たちは迫りくる危険から逃れようと必死になっている時、あなたは部屋で私が来るのを待っていた。まるで、突然の悲劇と死には慣れているかのように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "あなたは一体何者なの。なぜ私のオファーを受けてくれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "君が落札した脚本に惹かれただけだ。ほかに理由はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "かもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "今さらあなたの正体を問い詰めたところで、私の撮影のプラスにはならない。でも、私の誠意であなたの誠意を引き出せることを願っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ルシアン、私は自分の目を信じているの。だから、たとえあなたの身に疑わしい点を見つけたとしても、主役へのオファーを取り下げるつもりはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "だけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "もしあなたの本当の目的が口に出せないもので、私よりも遥か高くから物事を見ているのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ローラの死、そして五年後にその事件が切っ掛けで巻き起こっている出来事こそが、この区画で本当に撮影されている「物語」だと思っていて、それこそがあなたが参加した理由であるのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "グレータ・ストーンは改めてあなたにオファーを出すわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私の映画の「主役」になってちょうだい、ミスター・ルシアン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "君の……そして私の望み通りに、ミズ・グレータ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "常夜灯の微弱な光に照らされて、ベッドの上の微かな膨らみが見える。布団に包まる人物は、審判の訪れなど知る由もなく、ぐっすりと夢の中にいる。\nぐっすりと？　死者を辱め、己の罪を忘れ、警告を無視した……グレータはどの面下げてぐっすりと眠っている？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "何者かがひっそりと枕元に近付き、袖口から鋭利なナイフが滑り出た。か細い指が刃物の柄をしっかりと握り締め、凶器を高々と振りかざす。\n懺悔なんて聞きたくない、悲鳴も耳障り。このまま消えろ、償え！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あれ、手応えがなんか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "布団をめくると、中はもぬけの殻で、黒い影があるだけだった。\n影？　影がなぜ急に現れた？\n来訪者は数歩後ずさり、影がゆっくりと凝縮して見覚えのある姿になった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ミス・クリスティーン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "罠……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ようやく会えたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ようこそ、神出鬼没の客人よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "本当に……あなただったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "モイラ……チーム内で一番仕事熱心だったあなたが、本当に三つの殺人事件の犯人なの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "四つのはずだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "ルシアンさん、いつから気づいてたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "君の異常に最初に気づいたのは私ではなく、ミス・クリスティーンだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "私が現場に入って最初のシーンを撮影する際に、ミス・クリスティーンが現れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "普段、彼女は私以外の他者に自ら近寄りはしない。しかし、君には近付いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "あれ以降、彼女は君に何度も接触した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ミズ・ティッピは、ミス・クリスティーンがわざわざ小道具部屋に行って映画を見るのは、君たちに好感を抱いているからだと思っていたようだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "それは半分正解といったところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ミス・クリスティーンはただ君に興味があっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "見るがいい……君が手に凶器を持っているにもかかわらず、彼女はやはり君のそばを離れない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "バカバカしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "あなたはこの謎の生き物の好みから犯人を推測したって言うんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "それともペットとして、この子があなたの意志に従っているとでも……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "モイラはミス・クリスティーンの深い青色の目を見つめた。\n次の瞬間、彼女の意識の箍が外れた。\n喜び、悲しみ、怒り、あらゆる感情が心の中で渦巻き、最終的に空白が訪れた。ぽっかりと空っぽで、空恐ろしさすら感じるほどだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "君はミス・クリスティーンに対して、まだ誤解があるようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "言っただろう、誰もミス・クリスティーンの意志と行動には干渉できないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ミス・クリスティーンが生まれつき自由であると述べたわけではない。彼女に干渉する「力」を持つ者はいないという意味だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "彼女の方こそが、他人を左右する「力」を持つ者なのだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "謎めいた黒い生き物は平然とした顔で、前足を舐めている。\nモイラは今のミス・クリスティーンと、先ほど自分が受けた大きな圧力に結びつけるのが難しかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ミス・クリスティーンは感情の動きに対して非常に鋭敏だ――無理やり取り繕おうとする苦痛、瞬きの間に湧いて消える邪念……全てが彼女の注意を引く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "長い時の中で、彼女はテラの隅から隅まで歩き回り、数え切れぬ喜怒哀楽を味わってきた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "彼女は単一の感情よりも、混じり合った複雑なものを好む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "彼女の判断は論理ではなく本能に基づくものであり、決して間違えることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "犯行の動機を見つけることなく犯人を見つけるなんて……おめでとうと言うべきでしょうか、ルシアンさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "復讐だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "誰のための？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "制作チームの多くの人々の心に未だ纏わりつく、かの亡霊のための。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "ミズ・グレータ、今まさに君の眼前に立っているのは、五年前に転落死した新人女優ローラの家族――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "彼女を深く愛している、妹だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
