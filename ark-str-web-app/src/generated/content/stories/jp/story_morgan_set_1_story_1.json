{
  "server": "jp",
  "storyId": "story_morgan_set_1_story_1",
  "groupId": "story_morgan_set_1",
  "stageId": null,
  "title": "巨輪の下",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_morgan_1_1.txt",
  "sourceHash": "1e03ee43b798dde6dcdce792efae6005d665a44856e088cc48ed3b8e45540475",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "サツの野郎どもは、結局この件をどう処理するつもりなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員B",
      "text": "し、知らねぇよ。ボスを病院に連れてくだけで手一杯だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "じゃあボスの容態はどうなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員B",
      "text": "コンテナに頭をぶつけた後に、すげーたくさん血を吐いて気を失っちまった。傷は多分浅くはないと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "先に手を出したのはどっちだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員B",
      "text": "あいつらの方だよ！　それにあの野郎め、やり合ってる最中にボスをフォークリフトの方へ押し出しやがったんだ！　ありゃ絶対にわざとだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "*ヴィクトリアスラング*、サディアン区のクソどもが……最近勢いづいてきたのをいいことに、調子に乗りやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員B",
      "text": "仲間を残してきたから、情報が入り次第すぐに報告がくるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員B",
      "text": "多分もうすぐだろう。しばらく待つか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "おいおい、お前らまだサツどもが正しい裁きをするって信じてんのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ハンナちゃん、ちょっと黙ってなってば。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "何だぁ？　どうして余所モンがいる？　誰だこいつら入れたのは？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "敵じゃないよ。「リーン・ブラザーズ」のボスのリーンさんがケガしたって聞いたから、グラスゴーを代表して吾輩たち二人が様子を見に来たんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "グラスゴー……聞いたことあるような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "まあとにかく礼を言っとこう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "（小声）だから言ったでしょ、ケガ人を見舞うなら普通は病院に行くもんなんだって。なのにハンナちゃんときたら、拠点に行くって言って聞かないんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "別に間違ってねぇだろ？　見舞いなんかより助っ人の方が役立つに決まってんじゃねぇか。これこそ助け舟を出すってやつだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "（小声）もうちょい声抑えて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "報告に来る構成員",
      "text": "ハァ、ハァ、フゥ──ちょっと一息つかせてくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員B",
      "text": "サツの動きは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報告に来る構成員",
      "text": "仲間が何人か捕まっちまった。それにボスが退院したらそのまま身柄を拘束して、調査に協力してもらうって言ってたらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報告に来る構成員",
      "text": "「ノーポート区のギャングがサディアン区の工場で騒ぎを起こしたとあれば、これは区を跨いだ凶悪事件ということになる。必ず厳格に対処し、首謀者を厳罰に処さねばならない。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報告に来る構成員",
      "text": "……とにかくそういうことだそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員B",
      "text": "じゃあ、ボスをケガさせたあのクソ野郎はどうなった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報告に来る構成員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報告に来る構成員",
      "text": "奴はちょっとした罰金を払って、すぐに解放されたよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "*ヴィクトリアスラング*！\n*ヴィクトリアスラング*！\n*ヴィクトリアスラング*！\n呆れて物も言えねぇぜ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "まあまあ、落ち着きなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だから言ったろうが。サツに期待なんかすんなってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺だったら、今すぐサディアン区にカチ込んで、てめぇらのボスを傷付けた野郎を引きずり出して、顔面に一発ぶち込んでやるがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ここ数ヶ月、割食ってきたんだろ？　今回もまた泣き寝入りするつもりかよ？　百倍にして返してやろうぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "そうだ！　そこのグ……グラスゴーの奴の言う通りじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員A",
      "text": "連中んとこへ向かおうぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギャングの構成員",
      "text": "ああ、行こう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "よし、俺もついてってやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ハンナちゃん、ヴィーナはリーンさんの様子を見に行けって言っただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "よそ様の事情なんだから、深入りするのは良くないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "いいや、こいつはノーポート区全体のメンツに関わる問題なんだ。全員でやんなきゃならねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ポール、生ビール大、二杯追加だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ハンナちゃん、今日のビールはなんか石鹸みたいな味がするよ。あんまり飲まないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "お前が中に「調味カプセル」とやらをこっそり入れたからだろ？　バレバレなんだよ。言ってやるのもめんどくさかっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あはは～……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "モーガン、さっきは何で邪魔しやがった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "おバカなハンナちゃんは、先週のビデオシアターで起こった一件を覚えてないみたいだね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ほら、ガラス工芸工場の連中が、マクラーレンのビデオシアターに来たでしょ。借りたテープは返さないし、吾輩たちの座席まで占領して揉め事起こした挙句に、警察沙汰にまでなったじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "けど結局のところあいつらは、何のお咎めもないままサディアン区に帰っていったんだよねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "そうだ！　クソ、思い出しただけでムカついてきたぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ここはまだこっちのシマだし、警察だって一方に肩入れすることもあるよね。だから今日のあいつらのやり方は、ちっとも意外なんかじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だから今度こそ復讐すんだろうが。それなのに何だってサツを当てにしなきゃならねーんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "誰も警察を当てになんかしてないから。ちょっとは頭を使いなよ、ハンナちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "今日の事件は大ごとだったのに、対処がかなり適当だったでしょ。明らかにわざとだよ。「リーン・ブラザーズ」が突っ込んでくのを奴らは期待してるのかもね。一網打尽にできるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "要は、どうしてサツはいっつも片方に肩入れするのかってこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ここ二、三年、こういうことは何度もあったでしょ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "*ヴィクトリアスラング*、んなこと分かるか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "ポール、ビールスープを二杯くれ。疲れてるから腹をあっためたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "クルトン多めで頼むよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "あの封筒じゃ、薄すぎてサディアン区労働者管理所のお偉いさんの目にゃ留まらないかもしれねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "……けど、あれは俺が半年ちょっとかけて貯めた金なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "もう気にすんな。今日は俺がおごるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "ああ──ありがとな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "やっぱりサディアン区に移れるよう、何とかしてコネを作る方法を考えないと。毎日、区を跨いで仕事に行くのは面倒すぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "それもそうだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "ハァ……ノーポート区の人間が、逆にサディアン区の工場とか埠頭に行って働かなきゃ生活できないなんてな。こうなることが予想できた奴は、十年前にはいなかったろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "仕方ないさ。こっちが不景気になっちまったんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "かつてノーポート区は、ロンディニウムで最大、最多の物流拠点があり、ロンディニウムの玄関だった。だがサディアン区の軽工業の発展以降、変化が起こりつつあるのは誰の目にも明らかだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "紡績品、ガラス工芸品、缶詰、電化製品……工場が増えるにつれ、向こうで生産できる物もどんどん増えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "そうすれば自然とサディアン区の物流拠点の数も増えるし、規模も大きくなっていく。一方でノーポート区は目に見えてダメになっちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "ここ二、三年でこの街に増えていったのは二つだけだ。一つは暇を持て余したガキども。そこらのギャングとつるんで、一日中ビデオシアターやビリヤードルーム、バーなんかでたむろしてやがる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "もう一つは救貧院だ。だが所詮は対処療法さ。政府の失業手当を頼りに生きてる人間が、ノーポート区にどれだけいると思う？　ロンディニウムは俺たちなんざ気に掛けるつもりもないのさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "モーガンはふと自分で破り取った「モーガンの回顧録」のページを思い出した。ビールが喉を通り過ぎるまでの間、多くのことが脳裏に浮かんできた。\nシャトルバスやクレーン車、ブティック、雑誌売り……満足そうに笑いながら通りを行き交う人々。\nホテル・サンセットストリートでは、ドアマンが朝から晩まで、水一口飲む暇すらないほど忙しそうに働いていた。\nヴィクトリア各地から、果てはリターニアやカジミエーシュに至るまで、泊まりに来る商人や上流階級民は後を絶たなかった。\nまさに、ロンディニウムの顔というべきものだったのだ。\nそれが今ではどうだ？\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "モーガンは一気にグラスを飲み干した。ノーポート区の二十年が、彼女の二十年が、ビールとともに喉を滑り落ちていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "*ヴィクトリアスラング*。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "もう帰ろう。明日も働かないといけないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "明日もう一度労働者管理所に行こうと思うんだが、一緒にどうだ。俺の言った通り、早いとこサディアン区に越した方がいいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憂鬱そうな労働者",
      "text": "名残惜しい気持ちは痛いほどわかるさ。だがいつロンディニウムに捨てられるかなんて、誰にも分からないんだぞ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ハンナちゃん、さっきの二人のこと覚えてるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "前に埠頭で計測員をやってた、生粋のノーポート人だよ。吾輩が子供の頃は、あの二人の仕事が羨ましかったな～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ノーポート区の人間がノーポート区を気に掛けなくなったら、あの二人の言うように、いつかマジでロンディニウムに捨てられちまう日が来るだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だから今回ばかりは、放っとくわけにはいかねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "誰も放っとくなんて言ってないんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "一つ言っとくけどね、おバカなハンナちゃん。吾輩はいつでもあんたと一緒にサディアン区まで行って、リーンさんにケガさせた奴をボコボコにできるよ。殺しちゃってもいいって思ってるくらい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "だけど、ただケンカするだけじゃ、いま吾輩たちが抱えてる問題は解決できないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "心配ご無用。最近の吾輩は、このことばーっかり考えてるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ウソじゃねーことを祈ってるぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "半月後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "さっきからウロウロしてどうしたんだ？　新しいソファで尻でも痛めたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ヴィーナ、今日皆を集めたのは任務があるからって話だったよな。どんな任務だ？　もう半月は経ってるけど、ようやくリーンのために一肌脱ぐ気になったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "そう焦るな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "ヴィーナ、リーンのとこの人たちが、「リーン・ブラザーズ」を解散した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "何だと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "自分らのボスが大ケガ負わされて病院送りにされたってのに、やり返すどころか拠点を捨てただぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ここは、手下ども全員が怒り狂って、すぐにでも工場を焼き討ちに行くところじゃねぇのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "実際そのために人を二回集めた。でもノーポート区を出る前に妨害に遭って、結局諦めるしかなくなったって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "今週、サディアン区の労働者管理所がノーポート区の労働者たちを受け入れたんだけど、名簿の中に「リーン・ブラザーズ」の幹部の名がいくつかあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "「リーン・ブラザーズ」にはもはや舵を取れる者がいなくなった。解散もやむなし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あの裏切りモンどもが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "奴らを責めることはできんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "「リーン・ブラザーズ」はかつて、この付近で最大級の倉庫を複数傘下に収め、倉庫ビジネスのみかじめ料で何百人もの人間を養っていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "だが今ノーポート区の市場はどこも静かなものだ。あのままやっていくのは相当厳しかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "ヴィーナ、他の皆は呼んだ。外にいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "よし。では出発しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "どこへだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "「リーン・ブラザーズ」の拠点だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "路頭に迷った「リーン・ブラザーズ」の連中を、グラスゴーへ迎え入れたいと考えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "どういうことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "分からないのハンナ？　私たちが「リーン・ブラザーズ」のシマを貰い受けるってこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "まるで火事場泥棒じゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "そう言いたければそれで構わん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "何でそんなことすんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "すぐに終わる話じゃないから、それは道すがら説明してあげる。支度が終わったらすぐに出発しよ。今日は色んな場所へ出かけることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "「リーン・ブラザーズ」の倉庫だけじゃない。ビデオシアター、ビリヤードルーム、パーラーにレストラン……ノーポート区のほとんどの場所に足を運ぶ必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "あなたの拳も、今日は忙しくなるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ノーポート区のギャングはどこもそれほどでかい組織じゃねぇが、いつだって自分らのシマは自分で面倒見てきたんだ。互いのシマは荒らさず、何かありゃ一致団結してきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だから他の区の連中も、なるべく俺らを刺激しねぇようにしてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ヴィーナはノーポート区に来て数年ちょいだから、分からんでもないが。ベアード、子供の頃からここで育ってきたお前やモーガンがこんなやり方に賛同するはずがねぇ……そういやモーガンは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "何でいねぇんだ？　あいつはこの件について知ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ハンナ、この計画はモーガンの立案だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "あいつには別の任務がある。我々は別行動というわけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い男",
      "text": "来てやったぜ。出て来いよ、ここには俺一人だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い男",
      "text": "こそこそしやがって、何モンだ……石に手紙をくくりつけて投げ入れるなんて真似しやがって。窓が割れちまったじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い男",
      "text": "随分きったねぇ字だしよぉ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "へへっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "吾輩の字、そんなに汚いかなぁ～？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い男",
      "text": "でっけぇナタぶら下げやがって、何を企んでやがる！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い男",
      "text": "下手な真似はすんなよ。俺が声を上げるだけで、近くに待機してる仲間がすぐ集まってくるからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "じゃ叫んでみれば～。吾輩の手紙はもう読んだはずだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い男",
      "text": "てめぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ここに来たのが吾輩の友達じゃなかったことを喜びなよ。吾輩はただ「お話」をしに来ただけなんだしさ。このナタを使うのはお話がまとまらなかった時だから、安心しなって～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "一応確認するけど、サディアン区ロミー紡績工場のバーニーさんで間違いないよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い男",
      "text": "あの手紙の内容、どうやって調べた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "それって、捺印のない商品リストと、あんたの名前が書かれた決済書類のことかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "調べるのなんて簡単だったよ～。この半年ほどの記録を全部集めるのに、大体半月くらいで済んだかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "海賊版のビデオテープに、未加工の香料、アーツ発生装置、源石機械……サディアン区じゃ厳格に規制されているはずのものが、こんな簡単に持ち込まれてるとはね～やれやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "バーニーさんさ、工員の親方が自分とこの物流ルートを密輸なんかに利用してるなんてことが、社長のロミーさんに知れたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "社長自らあんたの脚をへし折るか、それとも警察に引き渡して折らせるか、どっちを選ぶだろうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "……一体何が目的なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "半月前、あんたがちょうどこの場所でリーンさんと衝突して、彼に重傷を負わせたことを忘れちゃいないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "彼は今でも病院でおねんね中だよ。ちゃんと謝りに行った方がいいんじゃないの？　それと慰謝料は一ペニーだってごまかしちゃダメだからね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "やっぱり「リーン・ブラザーズ」の奴か。半月も経って現れたのがお前一人とはな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "待てよ、確かお前ら解散したはずじゃなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ノーポート区にはもう「リーン・ブラザーズ」は存在しないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "吾輩はモーガン。グラスゴーのモーガン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "この二つの名前をよーく覚えときなよ～。これから長い付き合いになるんだからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "どん底まで落ちぶれたお前らノーポート区の連中と、何の付き合いがあるってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "何たらゴーのくそガキ、お前の後ろにある機関車を見てみな。あの十数両もの車両はな、お前らのおんぼろ物流ゲートが一週間に取引する量を、たった一日で運べちまうんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "忙しく稼働する昇降機やシャトルバス、その背後に並ぶ工場を見てみろ。ノーポート区でこんな光景が拝めるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "そうだ。取引してやってもいいぜ？　お前を俺の工場で働かせてやるよ。その代わり、手紙に書かれてた証拠の原本を渡せ。悪くねぇ話だろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "何のつもりだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "グラスゴーのブレインは笑顔で相手に歩み寄ると、そのまま腹部に容赦のない一撃を叩き込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は顔をくしゃくしゃに歪め、痛みのあまり腹を押さえてその場にうずくまった。\n彼が顔を上げると、居丈高に自分を見下ろす若きフェリーンの姿が目に入った。口元から覗く歯は白く輝いていたものの、あまり機嫌の良さそうな表情ではなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "クッ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "ナタを持った方の手に気を取られ過ぎた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そんなにすごいサディアン区様が、どうしてノーポート区のルートを通して遠回りに密輸なんかしてるのかなぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "サディアン区の税関検査はとっても厳しいから、わざわざうちらの落ちぶれたおんぼろ物流エリアを経由しないと、ロンディニウムに持ち込めないものもあるってのは……なかなか面白いよねぇ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "この二、三年間、ノーポート区のギャングたちは規模に関係なく苦しい毎日を送ってきた。だけどこれからは、ノーポート区の全てが吾輩たちグラスゴーの傘下に収まることになるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "まだこんなビジネスを続けるつもりなら、大人しくすることだね。あんまり調子に乗ると痛い目見るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "じゃ、吾輩はもう帰るね。明日になっても病院に行かなかったら、どうなるか分かってるよね～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そうだ、もう一つ教えてあげる。いま吾輩たちが争ってるのも、実際は何の意味もないことなんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "サディアン区は確かに活気づいてる。煙突がずらっと並んでいて、労働者もたくさんいるよ。あんたらの生活を羨む人もそりゃいっぱいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "でもねぇ、バーニーさん。オークタリッグ区に行ったことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あの貴族たちの荘園や邸宅を目にすれば気づくはずだよ……あそこの道路はサディアン区の大通りよりもずっと広いよね～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あいつら仕事なんてしなくていいんだ。海賊版ビデオの密輸なんてなおさらさ。なのにあいつら、いつでもピカピカのお洋服を着て、工場敷地より広い庭でアフタヌーンティーを楽しんでるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あいつらにとっちゃ、サディアン区もノーポート区も大した違いはないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "サディアン区が次のノーポート区にならないなんて保証できる？　数年後には、他の区で政府の支持を受けた新たな産業が、あんたらの地位に取って代わってるかもしれないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "いい？　バーニーさん、ロンディニウムにとって吾輩たちみたいな連中は皆同じ、いくらでも代わりがいる存在に過ぎないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "その変化に常に追いつくことなんて、できやしないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警戒心の強い密輸犯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "戻ったよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "モーガン、無事だった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あったりまえでしょ～？　心配するならバーニーって奴の方だよ。今頃リーンさんの病室にいると思うけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "誰もついて来てくれなくって残念だったなぁ。ケイト・モリガンがサディアン区の密輸犯何百人を相手に立ち向かう様は、圧巻だったのにな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "まっ、いーや。回顧録に書いておくからさ、後でみんなも読めばいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ホラ吹きも大概にしろよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "あはははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そっちはどうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "「リーン・ブラザーズ」の残党十数人も、ヴィーナをボスと認めてくれた。これからはモーガンも、倉庫番をしながら本が書けるようになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "今日は七組のギャングを訪ね、三組を説得した。残りの四組は私とハンナの拳で納得させた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "だがノーポート区の市街区は寂れすぎている。シノギのほとんどを街に頼ってたギャングもバラバラの状態だ。本気で奴らを一つにまとめるのはまだまだ難しいだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ま、焦らず気長に行こうよ。グラスゴーの長期計画ってことでさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ヴィーナ、吾輩の案を採用してくれてありがとね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ねえ、ずっとヴィーナに訊きたかったことがあるんだけどさ……ロンディニウムって、一体誰のロンディニウムなんだろうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "一つ二つ街が消えたところで、ロンディニウムは変わりゃしない。それじゃ吾輩たちみたいな連中は一体何なんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ひょっとしたらこのノーポート区自体、そのうちロンディニウムから完全に見捨てられるかもしれない。そう思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "モーガン、正直それは私には答えかねる質問だ。ロンディニウム、ひいてはヴィクトリア……私もその疑問の答えを探し求めている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "だが私は今グラスゴーの一員だ。つまり必然的にノーポート区の一員でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "約束などはできないが、もしそんな日が来たとしても、ただ黙って見ているつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "あのさ。ヴィーナが私たちに何かを約束する必要なんてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "グラスゴーの皆が一緒なら、怖いものなんて何もないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "その通り！　中央区の貴族連中が、マジで何かムカつくようなことを仕出かすつもりなら、俺が奴らの荘園にカチ込んで、顔面に一発お見舞いしてやるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "じゃあ私は、奴らの礼服にアツアツのコーヒーでもぶちまける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "火を放つのは私に任せろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "お前はどうする、モーガン？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "安心してよ。そん時は止めたりしないからさ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そうだよねぇ。考えたところでどうにもならないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "確かに吾輩たちは貴族じゃない。工事やら何やらで、この衰退した市街区を発展させることもできないし、政策だのを発布してここに住む人たちの生活を助けたりもできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "だけどここの人間だってみんな、何かしらできることがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "お前らの言う通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "そういやモーガン、お前どうして俺には今回の計画を事前に教えてくれなかったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ふふっ、ハンナちゃんはおバカだなぁ。脳みそまで筋肉の詰まったあんたに、吾輩の計画が理解できると思う～？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
