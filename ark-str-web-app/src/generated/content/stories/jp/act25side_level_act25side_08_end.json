{
  "server": "jp",
  "storyId": "act25side_level_act25side_08_end",
  "groupId": "act25side",
  "stageId": "act25side_08",
  "title": "交差する今昔",
  "storyCode": "CW-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act25side/level_act25side_08_end.txt",
  "sourceHash": "9a4b4ed439a58d97bd78cc39d1589efec3a64ffe3934cf25f15ea2611396e5ce",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "僕の質問に答えるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "し、しもべ？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "ケルシーのしもべになった覚えはないんだが……",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……Dr.{@nickname}は記憶を失っており、あなたの知るあの者たちの誰でもありません。もはやそうではなくなったのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "今のドクターはテラの一員であり、ロドスの一員です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "我々は今日まで、共に多くを経験してきました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "……ロドス？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "（未知の言語）ロドスか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "……なるほど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "それで「記憶喪失」というわけか。なぜ君はこの……「ドクター」にすべてを話さなかったんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ああ、わかったぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "君は、過去の「ドクター」の実在性を疑っているのだな。もはや信用できない昔の記憶を復元するよりも、新たに世界を認識したこのドクターを信じることにしたわけか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ふむ……それも無理もない話だ。地上で発生するすべては偽れぬ事実であり、十分な介入があればテラは今のようにはなっていないだろうからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "どうやら、何一つ我々の望んだ通りにはなっていないようだね。君は覚えていないようだが……Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ここで君たちに出会えるとは、まったく貴重な機会だ。しかしこの状況を思うと……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "記憶を失くした「Dr.{@nickname}」と、ケルシーを名乗るAMa-10よ。君たちがここへ来た理由は何かな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "クリステンが君たちを焦らせたからか？　あるいは、すべてが君たちに制御可能な範囲を超えたからか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "こちらの質問に答えてもらっていないようだが。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "偉そうにするのはやめてくれ！",
          "value": "2",
          "blocks": []
        },
        {
          "label": "自己紹介は対等な会話の前提だろう。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "僕はある計画において、人格を模倣して作られたシミュレーションシステムだ。これまで数万年、この暗い広間を――そして、数十万人の同胞の冷たい身体を見守ってきた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "かつての僕は最後の希望であり、悲観的な試みであり、ニヒリズムの代名詞でもあった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "だが今は、ちっぽけな君たちからすれば……クリステンの狂った計画の共犯者であり、その黒幕とでもいうべきだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "僕は瀕死の「保存者」であり、君の目に映るすべてに畏敬の念を抱いている、文明の滅びそのものなのだよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ここで間違いない。伝達物質の反応も……強く出ているし……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私は――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ヤラ主任……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "どうしてここに？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……あなたは私の祝福を携えて、ここまでたどり着いたのね。それもいいでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私を……止めに来たんですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "渡しておいたその武器、まだ持っていてくれて嬉しいわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "一時の衝動でここに立ってるわけじゃなさそうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "はい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "最後のチャンスよ、お嬢さん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "逃げるか、それとも続けるか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私は……あなたの仰る「戦士」になってみせます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "サイレンス、あなたはわかっているでしょう。クリステンはフォーカスジェネレーターに集めたエネルギーを、大地にあるどの都市にも向けるつもりはないの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "だから、止める必要なんてないのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "彼女はただ、すべての科学者と同じように、誰も足を踏み入れたことのない場所へ前進しようとしているだけなのだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あるいはそうかもしれませんね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私はあなたほど統括を理解してはいませんが、あなたの言うことなら喜んで信じます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ですがそれでも、すべてを止めに行きます。たとえ私の前にあなたが立ちはだかるとしても。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……なぜなの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "これがどのような実験であれ、統括がこのまま実行し、成功してしまえば――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あの人はライン生命の統括ですから、感情的な信頼にせよ理性的な判断にせよ、成功する確率が高いということは私たち皆が知ることですが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "とにかくその時、クルビアの研究者たちが彼女をどう見ると思いますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ライン生命の人事調査課主任をこれほど長く務めていらっしゃるあなたなら、ここの人たちを誰よりも理解していますよね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……彼女は英雄になるでしょうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "彼女は、クルビア科学界の英雄に、そして理想になる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "そう、あの人は科学者の理想、研究者たちの模範となるんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……そうなれば、こういうことは後を絶たなくなるでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "一つ一つの物事に対して、研究者たちは飽きることなく夢中になるものです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "けれど、クリステン・ライトは一人しかいない。彼女だけしかいないんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "一方で、そのほかのリーダーや天才を自称する人たち――このいわゆる「手段を選ばぬ開拓精神」に触発された人たちは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "自らの執着や理想をためらいなく実践に移す人たちは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私たちと同じように、貪欲で、傲慢で、向こう見ずで、頑固な人たちはどうでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "そんな人たちが、統括の行いを美徳と見なしてしまったら――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "どんな未来が訪れるのか、あなたなら想像に難くないでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "いえ、想像する必要すらないかもしれません……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あなたも、ライン生命が行ってきた研究を知らなかったわけではないでしょうから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "ええ、よくわかっているわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "私はよくわかっている……トリマウンツで、いいえ、クルビア国内でこれまでに、そして今この時に、こんなことがどれほど多く起きているのかを。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "これまで私の前には、無数の狂気じみた魅力的な計画が並べられてきた。それを差し出す人の目は輝いていて、皆心からの笑顔を浮かべていたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "彼らは本気で「純粋な科学のために」尽くしているつもりでいて、自分こそが認知の荒野を開拓する者だと思っているのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "そしてそれを受けたあなたやその同僚たちは、彼らの実験計画と壮大な青写真に基づいて、多少の「代償」や「コスト」を支払うべきかどうかを判断するだけでいいでしょうからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "「代償」。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "それは時に肥沃な土地であり、数名の不治の病を患う人や死刑囚であり、一つの村や町であり、特定の種族や国家であり……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "私に言わせれば、時折、彼ら自身であることすらあったわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あなたには、それを恐れる気持ちがありますか？　それとも、科学の進歩の可能性に興奮していますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ヤラ主任、この大地にはガラスケースに収められた「純粋な科学」など存在しません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "科学は私たちの――人間の手中にあるべきものです。その温度を、重さを、そしてそれが人を焼いてしまうものでないか、どんな苦しみや慰めをもたらすものかを知る必要があるんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ああいう人たちはいつまでも、前進を叫んでいます。でもその実、ただ自分が踏み出したい方向へとむやみに足を踏み入れているだけなんですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "だけど、それこそが前進というものよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "どこに道があるかなんてわからない以上、そうして歩くしかないのだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "運の良い人は正しい方向を見つけ出し、光の中に辿り着く。運の悪い人は行き止まりへと迷い込み、さまよい続けることになる……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "それでも彼らを立ち止まらせることなんてできないの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "あなたも研究者であるのなら、一番止められようもないことが何なのかはわかっているでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "――それは渇望よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "物質的にも、道徳的にも、たとえ規則を用いても縛りようのないものなの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "この大地において、古から今、クリステンの時より前に、あなたの言う貪欲で、傲慢で、向こう見ずで、頑固な人たちが、立ち止まったことなどあると思うの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "それならば、彼らはこれから立ち止まるべきです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "少なくとも、身をかがめて自分の足元を確かめることになる前に、立ち止まらなければなりません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ヤラ主任。私は――科学の燃料となるものは、欲望や理想、計算や取捨選択によるものであってはならないと思います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "科学とは、あらゆる人に真摯に向き合うことですから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "それは大学図書館の廊下に掛けておくには相応しい、素晴らしい言葉だと思うわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "けれど、それをラボの壁に掛けておきたがる研究者はいないでしょうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "そんなのは空論だもの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "だったら、私が実現させます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "途中で諦めたくないんです。私はまだ、あなたの祝福を携えていますから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "クリステンは長い時間をかけてこの計画の準備を整えてきたの。あの子がこのために、どれだけのものを差し出してきたかわからないくらいにね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "だけど、彼女の覚悟は両親に勝るとも劣らないものよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "あなたは――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "いいえ……あなたじゃなくて、これは私の気持ちね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……私は、希望が再び泡と消えるのを黙って見ていられないの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "では、あなたは何を望んでいらっしゃるんですか？　クリステンの成功を見届けることですか？　それとも、彼女が無事に帰ってくることですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "――私の知り合いには、ルビーという研究員がいます。彼女の一番の望みは毎日定時に退社することと、いずれ無事に定年退職することです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "そして、先ほど出会った兵士の、恐らく今唯一の望みはというと、この制御不能なエネルギーウェルから無事に脱出し、親族を連れてトリマウンツの狂った科学者から逃げることだと思います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "こういう人たちの望みよりも、統括の「希望」のほうが崇高だなんてことあるんでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "彼女の望むものが、それに足るほど「進歩的」だから……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あるいは単に、あなたと彼女がそれに足るほど親密な関係を築いているからと言って、それが正当だと言えるでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "これは不公平なことだと、あなたはおわかりのはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "こんな身勝手、許されることではありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "私は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "私は……あなたの言う通り、身勝手なのよ。だから道徳や正義を理由に自分を騙して、あなたを行かせるなんてことはできないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "――感情の重さを、私たちは認めなければならない。私は、クリステンのあの夢を何もせずにただ見ていることなんてできないのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……サイレンス、あなたならわからないはずがないでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ですが、私たちが統括を止めることさえできれば、きっとまた――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "いいえ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "そうはならないわ、お嬢さん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "私にはよくわかっているの……この計画に着手した時から、あの子は後戻りするつもりなんてないのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "ずっと昔、私たちが初めて会った時には、すべては……とっくに取り返しがつかなくなっていたの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "サイレンス。あなたが立ちはだかってくれることを嬉しく思うわ。私としては、あなたの主張を支持するとさえ言ってもいいくらい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "だけど、クリステンの……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……家族として、あなたを行かせるわけにはいかないの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "だから、見せてちょうだい。あなたが本当に……自分の言葉に責任を負う準備ができているのかどうかを。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "この先、あなたが相対することになるのは、もはやパルヴィスやクリステンといった単なる個人ではなく――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "前進を試みるすべての人になるのだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "わかりました。必ずそれに備えておくと、お約束します。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "科学は進歩しなければならず、また必然的にそうなるもの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あるいは統括のように「前進」を得意とする人も現れるでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ですが誰かが立ち上がり――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "科学を、人の手中に収めておかねばなりませんから。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……「保存者」。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "よもや、本当にあなただったとは。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ですが、あなたであったなら、なぜ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "なぜ一匹の小動物の狂った計画に協力するのか、かな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "それとも、なぜ幼い文明が揺りかごから足を踏み出す第一歩をただ眺めているのか、かな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "いずれにせよ、君は来るのが遅すぎたな、「ドクター」。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "僕は……すでに待つ意味を失ってしまった。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "この状況に比べれば、上で起きていることは些事にすら思える。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "……説明がほしい。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "クリステンを助けているのはあなたです。つまり、彼女は何らかの手段であなたと接触したことになります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "僕はクルビアのネットワークを通じて、テラの歴史と文化、言語に種族、そして科学技術のレベルについてはすべてを知り尽くしている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "実に皮肉なことだが、地上における現在の情報伝達技術は全世界をカバーすることさえできないものだというのに、互いを滅ぼす手段だけは、進化の効率に見合ったものになっているようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "テラで取られている方式はあまりにも原始的かつ、源石に依存したもの。この程度の変換効率でクリステンの試みを実現するには――必要なエネルギーもまた想像を絶するものになるでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "この難題を解決する方法など、テラには存在しえないものです。とある手段を除いては。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "そうとも。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "僕は最後の血を彼女に与えたのだ。消えゆく灯火を見守るよりも、新たな心臓を動かすほうがマシかもしれないからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "あなたは、本気で――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……なぜそこまでなさったのですか？　長きにわたるあなたの努力すべてが……無駄になってしまうというのに。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "確かに、無駄になってしまったな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "計画は僕の手で終止符を打たれ、コマンドも僕自身によって入力された。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "後悔など許されない判断をしたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "もうすぐ、もうすぐさ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "巨大な震動が遠くから広がってきて、地下空間の明かりが何度か明滅した。\n「保存者」と名乗る存在は暫し沈黙し、そして深いため息をついたように思えた。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "な、何が起きた！？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "まさか、エネルギーウェルが？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "赤子が好奇心に満ちた眼差しを未知へと向ける、それだけのために――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「保存者」",
          "text": "どれほどの障害を乗り越えねばならぬのやら。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "p.m.8:11 エネルギーウェル異常充填状態"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "あのロドスという企業は、あなたに素晴らしい訓練を施してくれたようね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "はぁ……はぁ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "腕はまだ上がる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "大丈夫です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "そちらの腕はどうですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "大丈夫よ、医療保険には入っているから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "さて、まだ続けるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……あなたがなおも行く手を阻むおつもりなら。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "いいわ、それなら続けましょう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "……待って。何か妙だわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "この辺り、温度が上がりすぎている……エネルギーウェルが発射準備をしていたとしても、ここまで高温にはならないはずよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "軍の人たちは、エネルギーの充填を止めるために、ここにあるエネルギー源はほぼすべて遮断したと言っていました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "ということは、警報システムや制御システムへの供給も？　あの愚か者たちときたら――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "早く！　ここを離れましょう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "上にまだ兵士が残っていますから、ヤラ主任は彼らを連れて逃げてください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "あなたはどうするの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "制御システムのエネルギー源が遮断されているのなら、統括がこの場所を遠隔操作できているのはなぜだと思いますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "伝達物質の反応は今も強まっています。私にはまだ、チャンスが残されているんです。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "サイレンス！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "熱気がヤラの顔をじりじりと焼く。それまで特別目を向けたことのなかったリーベリの研究員は今、エネルギーウェルのさらなる深層へと駆け出していた。\nヤラはふと、彼女を妨げられるものなど何もないように感じた。\nもしかすると、彼女が約束してくれたことは、本当に成されるのかもしれない。\nヤラは思った。その時が来たら、自分も多少は力になれるかもしれない、と。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "発射の準備は整ったみたいね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "「科学とは、あらゆる人に真摯に向き合うこと」……ね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "ふっ、私は科学者じゃないのに。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "クリステン、あなたは夢見た空の高くまで飛んで行くでしょう……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤラ",
          "text": "必ずね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "ナスティさん、もっと見やすい場所を選ぼうとは思わなかったんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "……君はいつまで付きまとってくるつもりだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "そういえば、以前調査でリターニアへ行った時、彼らの花火の祭典を見たことがありましてね。リターニア人はその祭典のために、最高の作曲家を招いて曲を作らせるんですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "最初の花火が上がった時、音楽家たちが一斉に演奏を始めるのですが……あの光景はまったく、それはもう美しいものでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "君のように語彙力の乏しい人間は、リターニア人には嫌われるだろうな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "ははっ、確かに。それにしても、まさか今日トリマウンツであの時さながらの華やかな景色を見られるとは思いませんでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "空に浮かぶリングに、ドローンが放つ弾丸という光の雨、そして装甲から散る火花……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "かの花火の祭典にも劣りませんよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "時間的に、この演奏はそろそろクライマックスですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "人心震わすフォルティシモが響き渡るはず――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "これは……想像以上に美しい光景ですね。ライン生命としては、この一幕を目にした市内の全員から見物料をとってもいいくらいですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "……ひとまず成功だな。フォーカスジェネレーターの材質及び構造はエネルギービームの衝撃に耐えることができた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "次はチャージとフォーカシングだ。負荷が高い条件下での測定値を収集することさえできれば……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "その前に、軍とマイレンダーの人間が最後のチャンスを逃すまいとして、フォーカシングを阻止しようとしてくるでしょうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジャスティンJr.",
          "text": "統括のことは心配なさらないんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "彼女がいつ、我々の心配などを必要とした？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "我々は単なる同行者でしかないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "ただ自分たちの仕事をして、あとは……彼女の幸運を祈ればそれでいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナスティ",
          "text": "（サルカズ語）いつか、カズデルもまた空に浮かぶ時が来たら、その炉には君の名を刻もう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
