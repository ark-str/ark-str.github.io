  "stageId": "main_00-04",
  "title": "混戦",
  "storyCode": "0-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_00-04_beg.txt",
