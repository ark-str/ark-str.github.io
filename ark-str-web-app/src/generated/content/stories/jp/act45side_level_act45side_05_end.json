{
  "server": "jp",
  "storyId": "act45side_level_act45side_05_end",
  "groupId": "act45side",
  "stageId": "act45side_05",
  "title": "マスカレードへの招待状",
  "storyCode": "SS-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act45side/level_act45side_05_end.txt",
  "sourceHash": "91e5329abd209fd9768480cf189a4abb6d325e3b79e3f50e99401f99466510c5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "はぁ……はぁ……くっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "掘削機の重苦しい音が、がらんとした洞窟内に響いている。\n気温は徐々に下がっていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "洞窟を抜け出した瞬間、冷気が祥子を襲った。\nその刺すような寒さに、鼓動がますます早まっていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしは……どうやってあの子と向き合えばいいの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "何かを伝えることも、顔を合わせることもできない。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "やれやれ、どうすればいいのかしらね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "振り向かずとも、誰が来たかは明らかだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "あの子の夢、とっても気に入っちゃったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "どんな子にも素敵な夢を見せてあげるのが夢のお城の役目。だからあの子の願いも全部叶えてあげたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "そうしたら、意外と安定してる――ううん、それどころか、この夢は完璧よ。まさかここまで上手くいくなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "それに今は、もっと面白いことになってるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……睦を騙していますのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "騙す？　そんなことするわけないじゃない。何度も交渉して、あの子も私の正体はよく知ってるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "最高の結果になって、とっても嬉しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "夢だと理解していながら、それでもここを離れたくない。それってつまり、私の夢作りが完璧って証拠よね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カールトンたち",
      "text": "（賛成するような鳴き声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "あら？　あんたが来るなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "ふふっ、面白いわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーフィアス",
      "text": "私はここで失礼するわ。祥子、あんたもすぐこの夢の面白さに気付くはずよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "若葉睦",
      "text": "祥子ちゃん、みんな待ってる。帰ろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "どこへ帰ると言うんですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "モーフィアスが消えても、少しも驚きませんのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若葉睦",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若葉睦",
      "text": "ここにあるものは、全部私たちが作った「ウソ」だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "「私たち」……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若葉睦",
      "text": "あなたは……私たちのものじゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "睦の母",
      "text": "睦ちゃんの演奏、本当に良かった〜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若葉睦",
      "text": "祥……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若葉睦",
      "text": "ねぇ、ママ……祥はどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "睦の母",
      "text": "さきちゃん？　あれ？　どこに行ったのかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若葉睦",
      "text": "違う……祥は、私を置いて行ったりしない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "賑やかにしていた聴衆が突然静まり、睦に視線を注いだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "睦の母",
      "text": "睦ちゃん、忘れちゃったみたいね――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "睦の母",
      "text": "ここはあなただけの夢じゃないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「睦の母」",
      "text": "ここは「私たち」の夢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "「私たち」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "この夢の中では、すべての「睦」が願いを叶えられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "私たちは睦ちゃんを中心に、私たちだけの美しい夢を作った。みんなが幸せになれる、そんな夢をね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "私たちは睦ちゃんの中から、ずっとその人生を見てきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "それで、最後はみんなの意見が一致したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "祥子ちゃんは、私たちの敵だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "睦、何を言っていますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしも、あなたにこれ以上辛い思いはさせたくありません。でも、こんな夢に逃げていてはいけないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "違う！　大事なのは、睦ちゃんがここでずっと幸せでいることだもん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "だから祥子ちゃん、私の言うことを聞いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "ここに残って、一緒に睦ちゃんの夢を守ろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "睦ちゃんは弱い子だから、迷ってるんだ。目を覚ましたほうがいいか、このまま幸せな夢を見続けるかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "今の睦ちゃんにとっては、祥子ちゃんだけが現実かどうかの基準なんだよ。だから祥子ちゃんのいる場所が「現実」になるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "祥子ちゃんが残ってくれたら、この夢を一生見ていられる。それってもう「現実」とほとんど変わらないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "だから祥子ちゃん、ここに残ろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お断りします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "……残ってくれないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "現実の睦は、今もあの冷たい夢のお城で眠っていますわ。そんな結末でいいと本気で思ってますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "本当に睦を愛しているなら、こんなことはできないはずですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "睦ちゃんが幸せでいられるなら、私たちみんなが生きていられるなら――そこが本当の現実かどうかなんて、どうだっていい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "私は睦ちゃんの記憶を全部持ってる。だから、祥子ちゃんの本当の望みも知ってるんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "祥子ちゃんがここに残ってくれたら、完璧なAve{@nbs}Mujicaだって実現してあげられるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "やめなさい！　あなたは睦ではありません。睦はそんなことを言ったりしませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "そんな……祥子ちゃんも、睦ちゃんも大好きなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "どうして私を板挟みにするの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "どこからともなく、二人に向かって声が響く。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子の視界の中で、遠くの山々がぐわんと揺れ、地面の小石がカタカタと震えだす。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人以外誰もいないはずの場所で、祥子は無数の目に見つめられているように感じた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "私たちは睦ちゃんにとって、いくつもある影のひとつなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "影がずっと暗闇に隠れるためには、みんなの言う通り、ちょっとした光でも消しておかなきゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「睦」は一歩ずつ祥子に迫り、崖際に追い詰めていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……一体何を……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "祥子ちゃん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は腕を伸ばし、祥子の肩に手をかけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "体が空中に投げ出され、「睦」の姿がどんどん小さくなっていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "祥子ちゃん、私は睦ちゃんにずっと幸せでいてほしいし、みんなにも消えてほしくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "だから、こうするしかなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "睦ちゃんには、もう祥子ちゃんはいらない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「睦」",
      "text": "さよなら、祥子ちゃん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
