{
  "server": "jp",
  "storyId": "story_phenxi_set_1_story_1",
  "groupId": "story_phenxi_set_1",
  "stageId": null,
  "title": "楽園",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_phenxi_1_1.txt",
  "sourceHash": "dfa6b82d343004a0f79eff60e879ed74dacbb09155ae61379b846b90b04bca61",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "不死鸟浅层"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "パァンッ──"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかな子供",
      "text": "うわぁ！　お姉ちゃんすごい！　また新記録だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひねくれた子供",
      "text": "フン、大人にしちゃまあまあかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爽やかな店主",
      "text": "おめでとうございます！　こちらが賞品のぬいぐるみです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "やったぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ねぇ、黎明破壊者、君もやってみない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかな子供",
      "text": "リーベリのお姉ちゃん、黎明破壊者っていう名前なの？　かっこいいな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひねくれた子供",
      "text": "変な名前……でもまあ強そうだな。射的が得意なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "はぁ……言っておくけど、まず、私は黎明破壊者なんて名前じゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "敬愛すべき我らが上官から授かった役職名じゃないか、大切にしないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "次に、大の大人が射的の屋台で新記録を作ったぐらい、何も騒ぐようなことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いいからやってみなよ。これは銃じゃなくてバネで動かすもの、つまりおもちゃだから、リーベリでも問題なく遊べるはずさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……それから、店主さんの顔色があまり良くないんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爽やかでいたい店主",
      "text": "とんでもない。どんな商売にも波ってもんがあるからね。こちらのお姉さんも良かったらぜひ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "はぁ、わかったわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "パァンッ──"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "おっと、特等賞だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "いい波ばかりじゃないわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかな子供",
      "text": "うおおぉ！！！　スイーツ食べ放題の年間パスだ！！！　しかもラテラーノ全店舗共通のやつ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひねくれた子供",
      "text": "す、すごい！！　あんた、本当は護衛隊のスナイパーなんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかな子供",
      "text": "もしかして、教皇庁の偉い人！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爽やかでいられない店主",
      "text": "ま、まさか、教皇聖下の側近の……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "店主さん、食べ放題チケットをもらっていく代わりに、このトイガンに小細工したことは見逃してあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無理に作り笑いする店主",
      "text": "はい……あの、もしよければ……お名前を、伺っても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私の名前？　もう知ってるんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私の名は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "黎明──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "破壊者！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "黎明──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "破壊者！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "モスティマ！　いい加減にしなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そこそこ楽しんでたくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "はぁ……もう、好きにすればいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "もう抵抗は諦めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "抵抗が効果のある時とない時がある。あなたの場合は後者だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ところで、里帰りの気分はどう？　悪くないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "たまにならね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "本当は結構ラテラーノが好きなんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "当たり前でしょ。ラテラーノは楽園よ、頭がイカれた人だって認めざるを得ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ラテラーノ人なら、たとえ鉱石病にかかって、街の中に住み続けられなくなったとしても、ラテラーノ公民という身分があるだけでかなりの面倒事を避けられるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "もちろん、砂糖アレルギー持ちや、ツイてない堕天使っていうなら話は別だけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ちょっと！　私だってここを気に入ってるんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あなたが気に入らない場所なんて存在するの？　そもそも、自分がどこにいるかすら気にしないんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "「郷に入っては郷に従え」って表現の方が好きだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "はいはい、風のごときトランスポーターさんは、一つの所に留まることはない、でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だけど、君は私とは違うんだ、フィアメッタ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君には選ぶ権利がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "だから何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だから、せめて長らく待たせてしまっているあのお客さんに、会いに行ってあげなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "銃騎士に報告しなければならないようなことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "その銃騎士が君の恩師だとしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "卒業して何年経つと思ってるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君の大好きなおじいさんだとしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それはあの人が勝手に言ってるだけだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "正直に言うと、私は銃騎士と取り合いになるのは避けたいんだ。ああいう人たちの癇に障りでもしたら、私にも変な名前が付いちゃうかもしれないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まあ、もう街で行きたいところは一通り回ったんだし、外で待ってるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ちょっと！　モスティマ！　モスティマ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "チッ、あいつ、アーツを使ったわね……動きが、ぎこちなくなってる……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "今の話でモスティマに対する評価が少し上がったな……少なくとも目上の者を敬ういい子じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……ご無沙汰しております、銃騎士パトリツィオ殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "久しぶりじゃな──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "暗闇を照らす光、太陽を曇らせる影……我が最愛の学徒、黎明破壊者よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……失礼させていただきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィア！　ちょっと待ってくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "相変わらず、時の流れを感じさせませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ワシのことか？　褒めてくれるとは珍しいのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "いいえ、この修道院のことです。そもそもあなたの顔は兜で見えませんよ、銃騎士殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "仕方なかろう。教皇騎士たる我々銃騎士には、勤務中はフル装備着用というルールがあるのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "今は勤務中なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "勤務中なら最愛の孫に会ってはいけないとでも言うつもりか？　そんなバカなことがあるものか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "銃騎士殿、あなたはサンクタで私はリーベリ。血の繋がりはございませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "言ってくれるな！　昔のフィアはそんなことを言うような子ではなかったのに……おぬしをワシに託したご両親も、そんな無礼な物言いを許すとは思えんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "昔はこーんなに小さくて、豆粒ぐらいの大きさしかなかったというのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あなたにはじめてお会いした時、私はもう七歳のはずですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "手取り足取り射撃の方法や弾道の計算を教えたのを、まるで去年のことのように覚えておる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "あの時、おぬしは銃の使い方を学びたいと駄々をこねた挙句、結局暴発させてワーワー泣いていたものじゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "何年も経たないうちに、あの可愛いフィアはいつの間にやら苦難監督者……いや、粘着幽光……宣告者？　最新のものは何じゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……黎明破壊者です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ああそうじゃったな。歳のせいかのう、さっきまで覚えていたというのに……名前は一つに固定してくれんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……月替わりにしたのはあなたたちじゃないですか！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "はて？　忘れてしもうた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "じゃあ廃止してもらってもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "今、おぬしの担当はレミュアンじゃからな。ワシにはどうすることもできんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "とにかく、昔のフィアはあんなに可愛いかったのに……今はまるでつまらない……お土産の映画すらどんどんつまらなくなってきておるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "じゃが……『片腕チェーンソーガール』はまあまあ良かったぞ。あれは星3.5ぐらい付けてもいいじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "──ふぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "では、親愛なる誇り高き銃騎士パトリツィオ殿、私を呼びつけたのは一体何のためでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私にはまだ執行待ちの任務がたくさんあり、多忙なのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "任務？　モスティマとあちこちフラフラすることがか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私の任務はモスティマという堕天使を見張り、彼女が守るべき秘密を誰にも漏らさないように監視することです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "またまた。大した秘密なんかなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "仮にそんな秘密があったとして、それが守るべきものかそうでないのか、おぬしはどう判断する？　監視と言うが、モスティマの行為が果たしてルールに則っているかどうか、おぬしにわかるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私はただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィアメッタよ、はっきり言うぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "今のおぬしの生活にはまるで意味がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……自分の生活を批判される筋合いはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "筋合いならあるわい。私はおぬしの院長であり、師であり、保護者だ。おぬしが本来どこまでやれる人間なのか一番よく知っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "今のおぬしは時間をただ無駄にしているだけで、成すべきことを何一つ成しておらん。なにより深刻なのは、今の生活を楽しんですらいないことじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "モスティマ……彼女には私の助けが必要です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "逆じゃよ、フィア……モスティマがおぬしを必要としているのではなく、おぬしが彼女の見張りを言い訳にしているのじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "あのモスティマのことだ、自分のことくらいどうにかできるじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "まあ、店で洋服を試着する際には、背中のファスナーを閉めてくれる者が必要かもしれぬがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……パトリツィオ殿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "怒ったのか？　それだけの気骨はまだあるようじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "おぬしには大いに期待しておった。なにしろ、ワシの最も自慢の生徒で、史上初のリーベリの銃騎士になれる可能性だってあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "本来なら、もっと背負うべきものもあったはずじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "まぁ、そこまで大仰な話にせんでも、銃騎士というのは楽しい仕事じゃぞ！　おぬしはサンクタではないし、この忌々しい輪っかもないから、兜を被っても頭が痛くならずに済む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "大型の銃は扱えぬじゃろうが、特大のグレネードランチャーくらいなら支給しても問題ないはずじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "何より、銃騎士は街中で暴れ回った損害も自腹で弁償しなくていいんじゃぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィア、おぬしには才能も経験もある。戻ってくるべきだと思うがのう。ラテラーノにはおぬしが必要なんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "しかしパトリツィオ殿、私は銃騎士にはなりたくありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "子どもの頃はそうじゃなかったぞ。おぬしがあれだけ訓練熱心だったのも、すべては銃騎士に──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "大人になるためです。大人になり、すべての選択肢の前に立つ資格を得るためです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "それで、結局選んだのがモスティマの付き人なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "最初こそは後ろめたさで彼女について行ったのかもしれません。彼女が堕天使になったのは私の責任でもあり、彼女が自暴自棄からどん底まで転げ落ちてしまうのではないかと心配していたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "それは当時のおぬしがまだモスティマをよく知らなかったからじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ええ、確かに。あのモスティマですしね、アハハッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "後になって思いました。アンドアインはいつかまた彼女のところに舞い戻ってくるはずだと。ずっと彼女のそばにいれば、あの狂人に相応の罰を与える機会が巡ってくるのでは、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "先日の万国サミットで彼に会ったそうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "逃げられました。次こそは必ずこの手で彼を捕えます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "じゃったら、なおさらモスティマについていく必要はなかろう。執行人になって、その件のためだけに動けばよいではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "いいえ、それは違います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "今回戻ってきて、ふいに気がついたのです。これまでモスティマとあちこちを旅し、様々な人に会ってきましたが、目的や意味抜きに考えても、行動そのものは私自身の選択なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "おぬしは言っておったな……ラテラーノは楽園だ、誰もそれを否定できないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ええ……だけど、一度も故郷から出たことがない人間には里帰りの意義を理解できないものです。ラテラーノより魅力的な場所はたくさん見てきましたが、ラテラーノは唯一ここにしかないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それに、悪い旅路ではなかったのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "パトリツィオ殿、確かにあなたのおっしゃる通り、私は今の生活を楽しんでなどいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私は経験しているのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ワシの目には、何の成長にも繋がらず、ただただ苦労しているだけにしか見えぬぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィアよ、ワシらはみな君に残ってほしいと思っておる。銃騎士の議事堂に席を一つ増やすくらい、造作もないことじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "どうしても破天荒な仕事がしたいというのなら、レミュアンの下で枢機卿を務めるのもよかろう。明日にでも教皇聖下のところへ行って話を通してやってもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "銃騎士よりは苦労の多い仕事じゃが、常に転々とするよりはマシなはずじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "いっそのこと、「残れ」とおぬしに命令してもよいかもしれぬな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "そんな命令はなさらないでしょう。あなたは他ならぬパトリツィオ殿なのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ああ、おぬしをここまで育てたのはこのワシじゃからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "年を取るのは何ともひどい心地じゃ、フィア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "日々衰えていくのがよくわかる。毎朝、目覚める度に昨日よりも死に近づいたと実感するんじゃ。すべてがワシから離れていく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "友は次々と亡くなり、生徒たちも散り散りになってしもうた。修道士たちはワシを敬うが、話にはめったに付き合ってくれぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "退屈じゃ、フィア……この上なく退屈なんじゃよ。過ぎ去った日の思い出を噛みしめても、ぼんやりした感情しか浮かばぬ。自分が何に思いを馳せているのかすら、思い出せない時もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "八年前、私が荷物をまとめていた時、ドアの外にいらっしゃっていましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "どうしてそれを知っておる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私のバッグに、膨大な量の見たい映画が書かれたリストが入ってたからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ああ、そういえばそうじゃったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "あの時はランクウッド映画にハマりすぎていたからうっかりおぬしを行かせてしまったが、次の日にはもう後悔していたんじゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "たとえ私が本当に映画を持って帰ったとしても、それは早くとも数年はかかると気付いたからですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "……さすがは我が孫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二人して",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二人して",
      "text": "ハハハハハッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "つまるところあなたはさっさと代役を見つけて、修道院で映画三昧の生活を送りたいだけでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "そうかもしれぬな。しかし、映画もいつか、すべて見終わってしまう日が来る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "今回はいつ出発する？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "そろそろです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "もう少しゆっくりしていかぬのか？　もうすぐラテラーノ目隠し逆立ち射撃大会じゃというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "結構です。子供の頃に一生分見ましたからね。あなたに連れられて参加したこともあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ああ、覚えておるよ。おぬしは優勝したからのう。トロフィーだってまだ裏の部屋にとってある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "まだ残してるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ならば、また一人ぼっちで見に行くしかないのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "可哀想アピールはよしてください。どうせ修道士たちの付き添いはありますよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "それはそうじゃが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ところで『片腕チェーンソーガール』シリーズの新作が出るらしいです。次に帰ってくる時のお土産にしますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "次に帰るのはいつになるんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "おそらく来年になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "その頃にはブームも終わっとるわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "見られるだけありがたいと思ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "そろそろ時間です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "まだ何かあるんですか、ご老体？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "いや、やっぱりいい。さっさと行ってしまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "では、失礼いたします、銃騎士パトリツィオ殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "さらばじゃ。再開を心待ちにしとるぞ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "黎明破壊者よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "今すぐあなたの修道院を燃やしてきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "冗談じゃよフィア、冗談！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私ってこんなにツイてなかったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪なサルカズ強盗",
      "text": "ハハッ！　ぼっちのサンクタ野郎を捕まえるなんてツイてるぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪なサルカズ強盗",
      "text": "さぁ、どんな死に方をしたいか言ってみろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面なサルカズ強盗",
      "text": "このサンクタ、なんで角なんか生えてんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪なサルカズ強盗",
      "text": "フン！　知るかよ、殺せば分かるさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "こっちは急いでるからさ、やめてもらえないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面なサルカズ強盗",
      "text": "命乞いか？　無駄だ！　うちの兄貴がお前らサンクタ野郎のせいで──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強面なサルカズ強盗",
      "text": "なっ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶悪なサルカズ強盗",
      "text": "グハッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "普段旅路が楽なのは誰のおかげなのか、これで分かったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あっ！　その声はまさか！？　黎明──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "そのネタまだ飽きないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いや、さすがにちょっと飽きてきたかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君が身動きを取れるまであと何日はかかるだろうから、先に行かせてもらおうと思ったんだ。あのじいさんが直々に孫を捕まえに来たことだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私があのままラテラーノに残るかもって考えなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まさか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私に秘密を守らせなきゃならないんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "そのじいさんが、今度ラテラーノに帰って来た時は一緒に映画鑑賞会でもやろうって言ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるサルカズ強盗",
      "text": "ど、どういうことだ！　たった二人しかいないんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無謀なサルカズ強盗",
      "text": "全員でかかるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それは光栄だね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "考えておこう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "はぁ、今日も適当に見て回るとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ん、これは？　スイーツ食べ放題チケット……しかも年間パスじゃと？　どうして私のポケットにこんなものが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "知らぬうちに何かの抽選に当たったのか？　それともこのあいだ教皇聖下からもらったんじゃったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "まあよい、とりあえず食べに行くか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "パスの期限が切れる頃には……あの子も帰ってくるじゃろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
