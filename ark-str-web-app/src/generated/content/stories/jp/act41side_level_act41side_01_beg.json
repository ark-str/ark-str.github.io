{
  "server": "jp",
  "storyId": "act41side_level_act41side_01_beg",
  "groupId": "act41side",
  "stageId": "act41side_01",
  "title": "巻頭の序文",
  "storyCode": "EA-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act41side/level_act41side_01_beg.txt",
  "sourceHash": "c1669e11d8619d539d38af5fe45e2c394789cf84f5ad343079dca950d241dc00",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "新聞売りの子供の声",
      "text": "号外、号外！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売りの子供の声",
      "text": "ヴィクトリア人が戦わずして撤退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売りの子供の声",
      "text": "これでターラーの領土は全て奪還されたってさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売りの子供の声",
      "text": "サウィン祭目前の今、ターラー全土に平和が戻ろうとしてるんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性の声",
      "text": "ここで下ろして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍人の声",
      "text": "あなたを殿下の元まで滞りなく護送するようにと命を受けましたので、寄り道している時間はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性の声",
      "text": "姉さんに会う前に、自分の目で確かめないとならないんだ。姉さんの都市を、戦後のターラーを、生き残った市民の姿を……彼らの生活が、ついに始まろうとしているのかどうかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍人の声",
      "text": "……そこまで仰るのなら、いいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍人の声",
      "text": "ですが、ターラー人はまだ二人の赤き龍に向き合う覚悟が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性の声",
      "text": "もちろん、わかってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "頼むよ――こいつを受け取ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "この鉈も、斧も……碗も盆も、全部鉄製だ。最高の素材になるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "だから頼むよ、クラン。これを溶かして、あの像に目を作ってくれてもいいんだぜ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "おーい、テオ！　手を貸してくれ、こいつを工房まで運ぶぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "すぐに来てくれれば、俺も今夜は時間を作って、ナイフをもう少し鋭く研ぐやり方を教えてやれるんだが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "あいつときたら、サボってばっかだ。あんた、甘やかし損だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "いや、とにかくテオの奴がいようといまいとどうでもいいから、これを受け取ってくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "ダメだ。どれも生活に使う道具だろう。ましてやお前の義足なんて論外だ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "でも、俺はほら――\nちゃんと立ってられてるだろ？　な？"
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "ネモスが作った木製の義足は間に合わせのものでしかない。都市からもっと腕のいい職人が来たら、その鉄製の義足も直してくれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "だけど、あんたが作ってるのはこの戦争の勝利を記念する彫像なんだぞ。サウィン祭に合わせて都市の中央広場に建てられるもんじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "この義足にも、勝利を味わわせてやっちゃダメなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "ダメなものはダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "受け取ってあげなさいよ、クラン。どれも家の片付け中に出てきた古い物ばっかりで、もう使えないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "椀だの盆だのは別に壊れてもないんだぞ。まだ使えるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "鉄のお碗がなくたって陶器のお椀があるでしょう。それに、斧や鉈だって、皆で貸し合って使えば事足りるじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "今は戦争が終わったばかりだし、この都市には何もかもが足りないでしょう。皆で力を合わせなくちゃ。像が未完成のまま終わるのを黙って見てるわけにもいかないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "その義足だけは何があっても受け取らんからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "我らが偉大な英雄さんは素晴らしい人だけど、頭だけは本当に固いわね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラフシニーはゆっくりと群衆の中に入っていった。\nしかしなぜだか彼女には、自分と彼らの間に何か隔たりがあるように感じられた。それは、焚火の向こう側にいる人を見ているかのような感覚だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "これは何をしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "見ない顔ね。最近じゃ珍しいわ！　どこから来たの？　ヴイーヴルさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "遠くから、ターラーに戻ってきたところなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "ほらクラン、さっさと受け取ってたら、遠路はるばる帰ってきた同胞にも笑われずに済んだのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "もう一度言っておくが、他の物はともかく、義足はダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "どうしてみんな、食器や……義足まで差し出そうとしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "サウィン祭に合わせて、広場に像を建てるためよ。それでターラーの復活を祝うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "キミたちはサウィン祭を開くつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "ターラーの伝説でしか聞いたことがないけど、たしか秋の豊作に感謝して、収穫後に冬が訪れる前に開かれる、死者を弔うお祭りだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "あなた物知りなのね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "元々は秋の収穫の後に豊作を祝うためのものってことしか知られてなかったんだけど、ダブリンの人が、このお祭りには由来があるって教えてくれたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "家の掃除をしたり、おもてなしの宴を開いたり。何より重要なのはかがり火を灯して、生と死が交わるその日、宴に訪れる人すべてをもてなすこと……そのためにできることは山ほどあるんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "それに、これはターラーが復活して以来初めてのサウィン祭だからなおさら盛大に祝わないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "まあ、こんな理由でもなければ、クランはたとえ自分の家を取り壊すことになろうとも、私たちの物を受け取ったりなんてしなかったでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "そういうことだから、あなたも何か鉄製の物を提供して、この英雄の手で像の中へ鋳溶かしてもらったらどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "私が持っているのはこの栞くらいなんだ。多分鉄製だと思うけど、これでもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "受け取るかどうかを決めるのは俺なんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "ところで、キミたちは何の像を造ろうとしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "赤き龍の像だ。ターラーの復活を祝うためのな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "赤き龍の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "おいクラン、言っとくが、義足を受け取ってくれないなら、俺は今日一日ずーーっとここに居座り続けてやるからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "だったら、担いででも連れて帰ってやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "ったく、あんたって奴は！　サウィン祭が無事に終わって像も完成すれば、俺たちの暮らしはきっと良くなるはずだろ。そうなったら新しい義足なんていくらでも作れるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "想像してみろ。巨大な赤き龍の像が闇夜にそびえ立ち、冬が訪れようとその炎は伝説の通り決して消えず、人を喰らう霧をすべて払いのけてくれるほどの力を持つんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "俺たちが忌々しい夜間外出禁止令なんかを守る必要も――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "あれは赤き龍が決めたことだ。俺たち全員の安全を守るためにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "そりゃもちろん、わかってるさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そんな会話をしているうちに、クランを囲む人だかりはますます増えてきた。皆、鍛造炉にくべられるであろう様々な物を懐に抱えており、小さな路地は人の波で溢れかえっている。\n彼は根気強く一人一人に応対し、足元には物がどんどん積み上げられていく。見たところ、腕一杯に抱え込んだところで、一人で皆の熱意のすべてを一度に持ち帰るのは難しそうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "クラン、手伝うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "いや、大丈夫だ。弟子のテオが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "あなた、まだあの子に期待してるの？　テオならとっくにどこかでサボってる頃でしょう。人前では真面目ぶってるけど、本当は怠け者の典型的なヴィクトリア人だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クラン",
      "text": "両親が死んだ時、あいつがいくつだったと思ってる？　影響なんぞ受けるわけがないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "ねえ、あなた名前は何て言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "リード。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "リードね。お宿はもう見つけた？　よかったら、うちに一晩泊まっていきなさいよ。そうすれば、外出禁止の時間に街中をうろつかなくて済むから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "泊まる場所ならあると思う。でも、夜間外出禁止令が出ているということは……この都市にはまだ、鎮火の鐘があるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "確かに、ヴィクトリアの鳴らした鎮火の鐘はターラー人を抑圧するためのものだったけど、ナ・シアーシャで今出されている外出禁止令は私たちを守るためのものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "黒き森に立ち込める霧はナ・シアーシャを守ってくれているけど、時々その黒い霧が都市の街道にも入り込んでくることがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "つまり、夜間外出禁止令は誰かが霧に接触せずに済むようにするためにあるってこと。許可なく黒い霧に踏み込めば、その人は二度と帰ってこられないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "まさか、本当に霧が人を喰らうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "……まあまあ、せっかくはるばる帰ってきたんだから、こんな話はよしましょう。どのみち、すぐに状況は良くなるはずだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "ついてきて、ナ・シアーシャを案内してあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "だけど、像を造っていた……あのクランという人はどうするの？　私はアーツが少し使えるから、力になれると思うんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "大丈夫よ！　彼は黒き森の戦いで、たった一人でヴィクトリアの先遣隊を一部隊壊滅させた英雄だから。ただ、残念なことに彼が最後に情けをかけた結果、テオみたいな子が今もいるわけだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "たった一人で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "ええ、なんたって黒き森の中でのことだもの。いつだってこの森は私たちターラー人の味方をしてくれるの――ってもう、リードったら話を逸らしすぎよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "さあ、ついてきて。ビールを飲んで、お肉のシチューでも食べて、まずは身体を温めましょう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "そうそう、あなた、今帰ってきたのは、絶好のタイミングだったわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ふぅ、よかった。まだ店にジャガイモが残ってて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "しまった、もうこんな時間だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "いってえ！　おいお前、バタバタ走りやがって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "テオか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "ごめんなさい！　帰りを急いでて……わざと足を踏んだわけじゃないんです。すぐに靴をお拭きしますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "……お前まで俺をバカにする気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "えっ？　ち、違います。あの、うまくお伝えできてないかもしれませんけど、僕はただ、何かお力になれたらと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "近寄るな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は手にした杖を振り上げると、テオの胸を突き、そのまま思い切り突き飛ばした。\n不意を突かれたテオは後ろに倒れ込み、朝露が石畳の隙間に溜まってできた濁った水たまりに突っ込んでしまった。"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "ヴィクトリアのクズめ、何様のつもりだ。施しでもしてやろうってのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "ぐっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何やってるの！？　その杖を下ろしなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "テオ、大丈――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "へ、平気だよ、ブリギッドお姉ちゃん。先にぶつかったのは僕のほうだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "ふらふらしてばっかのノマドに、あちこちで余計なことしかしやがらねえヴィクトリアのろくでなしか。鼻つまみ者同士、気が合うわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "ブリギッド、お前はつくづく先祖の顔に泥を塗るのが上手いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "何それ、どういう意味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "フンッ、そっちのクズはともかく、お前の振る舞いはどうなんだって言ってんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "お前はあの放逐王の末裔で、ターラー人に情報や手紙を届けて、天災の兆しを伝える一族の人間だってのに、そんな奴とつるんでるなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "お前らは戦時中だってそうだった。味方が勝とうが負けようが、冷淡な顔で戦況報告書を要塞に投げ込むばっかりで、その後はどうでもいい家族宛ての手紙なんかを運ぶだけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない様子の住民",
      "text": "そんな連中が、ターラー人と呼べるのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "つまり、君はここ以外に行くあてがないってこと？　どうしてクランのところにすぐ戻らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "だって……服が汚れちゃったから、洗ってからじゃなきゃ、帰れないでしょ。でも、すぐに終わるし、僕のことは気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "そんなことできるわけないでしょ。わたしは君を探しに来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "ねえ、こんな場所のどこがいいの？　戦争でボロボロになって放置されっぱなしのここよりも、クランの工房にいれば、少なくとも炉はあるし、温かい食べ物もあるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "僕はただ……これ以上クランさんに迷惑かけたくなくて。だから、今日あったことはクランさんには言わないでおいてくれない？　服が乾いたら、すぐ戻るから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "別にクランのところになんて行かないよ。わたしは君を連れ出しに来たんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "連れ出すって……クランさんから、何か言われたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "あの人は何も関係ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "今日わたしが来てなかったら、君はやり返しもせずに殴られてたでしょ？　わたしの勘は絶対外れないんだから。このまま街に居たって、みんなからあの手この手でいじめられるだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "今日は杖で殴られて、水たまりに突き落とされたわけだけど、明日はどうなるかわかったもんじゃないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "とにかく一緒に行こう。わたしが原野まで連れていってあげる。そのあとは、どこへだって行きたい場所に送ってあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "わたしたちはこの町の人間じゃないし、行き先が思いつかないならまずはネモスが住んでたところへ行こう。霊の守人の集落にしばらく居させてもらうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "ネモスさんには霊の守人のお話をたくさん聞かせてもらったし、確かに行ってみたいけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "でも、クランさんが出て行けって言ったわけじゃないなら、僕は行けないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "ネモスさんは忙しそうだからクランさんの手伝いはできないし、赤き龍の彫像もまだ完成してない。こんな時に弟子の僕がいなくなったら、手が足りなくなっちゃうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "とにかく、ありがとうね、ブリギッドお姉ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "だったら、クランのところまで送るよ。わたしはそのあと街を出るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "ううん、いいよ。今はちょっと寒い分、服が乾きにくいし、待たせちゃうと思うから。あとで僕一人で戻るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "どうしても服が乾かなかったら、あそこの誰も住んでない小屋で風はしのげるしね。誰かが残していった布団もあるし、前にもここに住んでたことがあるから、僕は大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "……わかったよ、そこまで言うなら。確かに、街の中のどこにいるより、こっちのほうが確かに安全だろうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "でも、クランにも君の面倒を見られない時は結構あるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "クランさんにはもっと大事な用がたくさんあるから、僕が力にならないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリギッド",
      "text": "じゃあね。自分を大事にするんだよ、テオ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "着いたわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "本当、あなた良い時期に来たわよ。今日は新鮮なビールに、お肉のシチュー、オーツ麦のお粥もあるし……かがり火がないのだけが残念だけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "サウィン祭はまだだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "でも、昔の習わしでは、サウィン祭の数日前にはかがり火を灯していたそうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "とはいえ戦争が終わったばかりで、街には余分な燃料がないし、黒き森の木をむやみに伐るわけにもいかないから。どのみち夜は外出禁止だしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "まあ、どうあれ、まだ明るい時間だし、太陽がかがり火の代わりをしてくれるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "お喋りは後にして、まずは席についてちょうだい。場所を空けるように言っておくから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラフシニーは前に出た。湿った冷たい空気の中、卓上に並ぶ一見豪華な料理の数々は、すべてが同じ香りを漂わせている。\n温かく、素朴で、シンプルな……けれど、聞かされたものとは違う香りを。\n彼女は内心の驚きを抑えて周りを見回してみたが、誰もそれに疑問など覚えていないようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……これが、肉のシチュー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友好的な住民",
      "text": "そうよ。こっちがお肉のシチューで、こっちは焼き鱗獣。手元のグラスに入っているのはビールね。そうだ、オーツ麦のお粥もあるから、今よそってきてあげるわね――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この料理は、どれも同じく……\nジャガイモで出来ているのでは？\n彫像は食器で出来ており、かがり火代わりは太陽で、宴席に並んでいるのはジャガイモだ。\n住民が「オーツ麦粥」をよそいに行っている間に、ラフシニーは静かに立ち上がり、自分を待っていた駄獣車のほうへ歩いていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "殿下はすぐにお戻りになりますので、こちらでお待ちください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "ここは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "ナ・シアーシャの要塞です。あなたのそばの階段を上がったところに、この都市で最も高い場所があります。そこは、殿下がこの都市にいらして以来、しばしば滞在される場所でもあるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "ここに燭台や、音楽家の姿や、豪華な宴席がなくて良かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "すでにご説明した通り、都市内の物資不足の主な原因は、ヴィクトリアとターラー間の貿易が今なお回復していないことにあります。我々は、問題解決のため尽力しております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "市内の住民たちの反応はどれも、ターラーへの理解と善意、そして熱意によるものであり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "エブラナ殿下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "下がって構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ラフシニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "姉さん、この街に何が起きたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "収穫もなければ、かがり火もない、宴席に並ぶのはジャガイモだけ――そんなサウィン祭をみんなで祝っているなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "「将校」が言ったことをもう一度私の口から聞きたいがために私に会いに来たと言うなら、久方ぶりの再会に免じて許してやらんでもないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "それより気になるのは、お前の槍のことだ。あれをどこへやった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "槍？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "姉さんにもらったあれのことなら、今はロドスの倉庫に置いてあるよ。もう必要なくなったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "だが、丸腰でどうやって権力を勝ち取るつもりだ？　そんな無防備な人間は、力を手にするどころか、いつ命を落としても不思議ではないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "「姉さんにもらった槍は」置いてきたってだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……それに、少なくとも今はまだ、姉さんは私を殺したりしないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "ようやく魂を取り戻した操り人形を、遊び飽きる前に壊すなんてこと、姉さんは望まないだろうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "そんな言い方をされると傷付くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "誰しも操り人形になり得るものだが、お前だけは違う。お前は、私の影となることを選んででも、共に踊ろうとはしない、私のダンスパートナーだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "今から一年くらい前、姉さんはそれに嫌気が差したわけだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "……よく覚えていないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "それと、権力に関して言うのなら、私はそれを勝ち取りに来たわけじゃない。それは姉さんが持つべきものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ほう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "姉さんがターラーの各地に灯した火が、ターラー人を縛っていた鎖を焼き切ったことは事実だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ではなぜ戻ってきた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "私は見届けに来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "姉さんが、本気でその権力を使ってターラーの人々の暮らしを立て直そうと思っているなら、私はそのために全力を尽くす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "現状、都市内の物資不足にまで手が回っていないと言うのなら、できる限りのことをするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "その時はもう一人の赤き龍として表舞台に立ってもいいし、今日みたいに身分を隠して動くのでもいい。私はどちらでも構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "相変わらずの気高さだな、ラフシニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "だけど、わからないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……姉さんが本当に、それで満足するのかどうかが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "私の知る姉さんは、贅沢な暮らしのために権力を追い求めるような人じゃないし、こんなところで歩みを止めることもしないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "だけど、これまで姉さんが歩んできた道は、いつも屍と血に覆われていた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "ただ私は、それがほかに選択肢がなかったせいだと思いたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "姉さんに槍を突きつけるような日が永遠に来ないことを願っているんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "実に良いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "どうやらお前は、放浪生活の間に、私の影を務めていた頃よりも遥かに多くを学んだらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "回りくどい話はやめにしよう。私が帰って来た理由は説明した通りだけど、帰郷を受け入れてくれた姉さんは私に何を求めているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "今にわかるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "その前に、まずはついてこい。赤き龍の巣の全貌を見せてやろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "設計者はこの場所を、ターラー王城の外観にならい、あえて起伏に富んだ地形になるよう設計したという。\nターラーの石工たちは、手がけた建築にその卓越した技術を注ぎ込むことに熱中していたが、それでも、間もなく傀儡を迎え入れることとなる要塞に対しては、一切装飾を施そうとしなかったらしい。\nラフシニーはそんな話を何度も聞いていた。だが、その物語が果たして燃え盛る炎そのものなのか、あるいは岩壁に映る影なのかは判然としなかった。\nゆえに彼女は姉に続いて階段を登り、己の目でこの都市を見た。\n下の広場にある空の台座は、何か巨大な物が置かれるのを待っているかのように見える。\nその広場からはでこぼこと蛇行した石畳の道が伸びており、いじらしいほど素朴な石造りの家々も視界に入った。\nしかし、彼女が目を凝らしたその時、彼女と住民の間を隔てていた物がようやくはっきりと見えてきた。\nそれは、決してここにあってはならない物だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "炎……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう――\nよく見れば、街の至る所で語らい、駆け回り、大声を上げ、そして休息を取る住民たちの身体に、ちらちらと炎が灯っているのだ。\n紫色の死の炎が。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "街の人たちに何をしたの？　彼らを死者に変えてしまったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "つい先ほどまで民衆の中にいたのなら、私よりもよくわかっているはずだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "炎というのは、燃え広がるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "それでも、姉さんの死の炎が生きている人の身体に広がることなんて、あってはならないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "残念なことに、戦場であれ賑やかな街中であれ、人のいるところには死があるものだ。炎はそれを早めているに過ぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "だが、私が現状に満足していないという点については認めざるを得んな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "死者は生前の欲望のままに荒野を彷徨い、他方で死の炎に侵された生者は二度と本当の人生を取り戻せずにいる……生と死がこうして入り混じり、互いを冒涜し続けることなどあってはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "これまで姉さんは、ずっとそうしてきたのに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "死とは、我が意に従うべきもの。私の望まぬものまでもを、破壊すべきではないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ではラフシニー、愛する妹よ。意見を聞こう。お前はターラーをどこへ導くつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "生者を生き延びさせ、死者を眠らせるか？　それとも、ターラー全土を死の国に変えるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……そんなこと、聞くまでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ならばお前のやるべきことは簡単だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ラフシニー、私を殺せ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "っ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "お前が人々を率いて旅をしている間に、私は色々と準備をしておいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "お前の槍の穂先が私の心臓を貫き、呼び起こした死が私を抱擁したその時、死の炎に侵されたすべては、私と共に消え去るだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "そしてお前は、ターラーの歴史においてはこの数十年で唯一のリーダーとなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "……私はもう姉さんの影になる気はない。それに、人々から蔑まれるような、身内同士の狂った殺し合いなんてすべきじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "身内で殺し合うことと、高潔な人格を持っていることは、必ずしも矛盾するわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "それに、生きているのに死の炎に侵されてしまった人たちが、姉さんが約束したように新しい人生を手に入れることなんてできるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "私は人生にまつわる約束などしたことはない。それは、炎に侵されていない者に関しても同じことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "街の人々に関しては、すでに紫の炎に憑りつかれている以上、この先少しずつお前の知るような生きた屍と化していき、その後は私と共に去るばかりとなるだろう。ほかに道などもはやない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "あの人たちは生きているんだよ！　姉さんに命じられるまま、姉さんのために戦争に打ち勝ったんだから、新しい人生を謳歌する権利があるでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "これが彼らの不幸な宿命だというだけのことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラフシニー",
      "text": "違うよ。それは絶対に違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ならば、お前はどうするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラフシニーはなおも言葉を続けようとしたが、エブラナはすでに背を向けて廊下へと歩き出していた。その足音は静かすぎて、ラフシニーは姉が立ち去ったことにしばらく気付かなかったほどだった。\nその姿が完全に闇に溶けたあと、ラフシニーは再び都市を見下ろした。\n彼女は、すべてがエブラナが作り出した幻であればいいのにと願ったが……炎は確かにそこにある。\nラフシニーは拳を握りしめ、フードを被ると、踵を返して階段を降りていった。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
