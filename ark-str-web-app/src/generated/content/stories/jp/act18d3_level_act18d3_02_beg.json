{
  "server": "jp",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "歌い手",
  "storyCode": "SV-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "86639b329db5f8101e38a24fe8fe43c74fb34ad66b79ae73548d8976fab28be4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "p.m. 3:23 天気/曇天\nイベリア サルヴィエント"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "地図にある場所は……ここね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……嫌な臭い。それに、気持ちいいとは言えない空気だわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "すみません――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "別の男性住民",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……ここには怪物がいる、ですって？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "人しかいないみたいだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "（イベリア語）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "今はこんな言い方しないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "（発音を少し変えたイベリア語）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……それに、今の私は歌い手だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ホセさんが言ってたわ。歌い手はそんなことしないって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "九十九……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "今、何か言ってたわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "九十九。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "子供……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "間違いない……数字を数えてるみたいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私からネックレスを盗っていくなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "待ちなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "九十九、九十九……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もう逃げられないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "う……あぅ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "なぜ私の物を盗ったの？　ここへおびき寄せるためかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "落とし穴に、縄まで仕掛けて……残念だけど見え見えよ。三流バウンティハンターの待ち伏せの方が、まだサマになってたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "出てきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私もあなたたちに用事があるの。さっさとして。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "妙な奴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "そうだな、トタン。こんな奴、見たことない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "俺も、見たことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたたち、言葉を話せたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "お前は何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "さすらいの歌い手よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "さすらいの歌い手？　それは何だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "トタン、こいつと話すな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "知らない顔だ。妙な服を着ている。よそ者だな。何をしに来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "聞きたいことがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "お前……新品の服を着ているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私の仲間を見なかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "それに、強そうだ。腹いっぱい食えているんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "彼女は私より先にここへ来たはずなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "その箱も、重そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……楽器なんてどれも重たいものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "持っているものだって、おかしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ここのハープも、これと似たようなものでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ほら、ちょっと弾いてあげるわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "……ッ！　耳がおかしくなりそうだ。武器に、違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "武器以外の使い方もあるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "トタン、こいつ、変だ。もう構うな。話すの、疲れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "おい。ベンチを放せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ベンチ……この子のことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "この子に危害を加えるつもりなんてないわ。ネックレスを持って行かれたから、追いかけたの。大事な物なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "お前は、何か奪いに来たのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "違うわ。私は自分の物を取り返して、それから話の通じる相手を見つけたいと思っただけよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "あぅ……う～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "俺たちの子供に、触ることは許さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "俺たちの物を、奪うことも許さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "何を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "俺たちのルールを、破ることも許さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "トタン、あまり近付くな。どうするつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "あいつは俺たちの子供を傷つけ、俺たちの物を奪い、俺たちのルールを破ろうとしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "あいつは、俺たちの姉妹ではないのか？　姉妹には、分け与えてやるべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "あいつは、違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……話が通じる相手じゃなさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "なら、他をあたるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "駄目だ。行かせない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "待て、トタン……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "あ、穴が、ある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "木枠の穴だ。忘れたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あら、それ本当に役に立つのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "text": "よそ者、ここは俺たちの場所だ。お前が来ていい場所ではない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
