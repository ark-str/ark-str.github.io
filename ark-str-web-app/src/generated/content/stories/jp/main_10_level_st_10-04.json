  "sourceHash": "216d2de5b4fa9d3da05d595719959592e3a0d5a9453598db39242f1a83640970",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "st04"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサスの若い学生",
      "text": "こんにちは、君もコシェルナ先生の授業を聞きに来たのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "コシェルナ……先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサスの若い学生",
      "text": "そう、彼女のウルサス帝国史の授業は人気なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサスの若い学生",
      "text": "最近は君みたいな若い人が廊下で聴講しているのをよく見かけるんだよ。君はうちの学生じゃないよね？　大学生に見えないもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサスの若い学生",
      "text": "教室に入っても平気だよ。コシェルナ先生は教室の後ろに人が立っていても気にしないから。その方がよく聞こえるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "必要ない。彼女の声は十分よく聞こえる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサスの若い学生",
      "text": "そうか？　まあ、どうせもうちょっとで授業も終わるしね。俺は別の授業があるから、じゃあな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "早くここから去るといい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒッポグリフの先生",
      "text": "何か聞きたいことでもあるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "見つけたぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "彼女はどうして街に入ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "ある人を探しに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "俺たちがこんなリスクを冒す価値のある奴なんて一体誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "ナイン、お前が言ったんだ。移動都市と関わるような行動は絶対に取るなと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "私たちはずっとタルラを審判にかけたいと考えている。だが満足のいく対話を始めるためには、まだ足りない。彼女は答えを見つける必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "もしその答えがなければ、彼女本人も自分の言葉を信じられないだろう。私たちはなおさらだ。そのような状態の彼女など信じるに値しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "俺たちはそもそもあいつを信じるべきじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "一人で街に入って、このまま蒸発したら？　あいつを救出するために俺たちがした努力が、あいつに関する計画が、何もかも水泡になるんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "……そうはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "彼女はよくわかっているからな。自分にはもう行き場がないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "加えて、一点保証しよう。彼女がどこへ行こうと、私は何度でも彼女を捕らえる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "お前のことは信じてる……だがこれはお前がこの一年俺たちを率いてきた実績をかってのことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "お前はあいつとは違う、口先だけじゃないからな。ナイン、俺たちはみんなお前のそんなところを気に入っているんだ。どうかその美徳を失わないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "私が彼女に影響を受けてしまわないか心配しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "そんなことにはならないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン術師",
      "text": "ナイン、監視隊が近づいてるわ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "隠れろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "予想通りだな。あと三十分もすれば、このルートはもう使えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "……彼女が早く戻ってきてくれればいいが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒッポグリフの先生",
      "text": "もっと早く会えると思っていたよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒッポグリフの先生",
      "text": "――タルラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "コシェルナか。相変わらず単調なネーミングセンスだな、コシチェイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "あぁ……名前か。名前はただの呼称にすぎない。もしこの発音がお前の不愉快な記憶を呼び起こさせるのなら、フィオレットと呼んでくれて構わないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前の名が何であれ興味がない。その顔の皮と同じように、私が記憶する価値などない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "ならお前は何のために来たんだ、タルラ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前は私の口から回答を得たいのか？　「そうだ、コシチェイはすでにお前から去った、今のお前はただのタルラだ」、とでも聞きたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "ならば、お前は望む答えを得るだろう。私の答えは一文字たりとも異ならない。先ほどの言葉を繰り返してやろうか？　だが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "――お前はそれを信じるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "黒蛇の言葉を信じるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "これがお前の新たな手口か、コシチェイ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前は私に多くの情報を与えた。いち早くお前を見つけられるように――つまりあえて私をここにおびき寄せたとしか思えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前はもうあの家に戻ったか？　私たちの家に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "あれは家ではない。ただの陰謀の発生源、毒蛇たちお気に入りの巣窟だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前の口からそういう言葉を聞くと、実に心が痛い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "だがそれでも私の手紙を読んだのだろう？　コシチェイ公爵が蛇鱗の密書を受け取るのに用いていたルートを、お前は覚えていた。公爵領を占拠した秘密警察ですら見つけられていないあれを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――十年前に出された手紙で、差出人はこの学校にいる者だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前の思慮深さを称賛すべきか、あるいはあのルートが十年間封じられ、お前のウロコたちがとっくに朽ちたのを喜ぶべきか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "領地の荒廃を見てどう感じた？　嬉しかったか？　タルラ、あの地にいた者たちは本来お前の統治下でより良い生活を得られたのだ。第四軍に踏みにじられることなどなくな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "さも彼らを気にかけているようなフリをするのはやめろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "言え、お前がこの最北の小都市に留まっている理由は何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前は南寄りの都市を好んでいたと記憶しているが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "そちらの方が空気が潤っている。それだけでなく、権力の中枢となる人物を何代にもわたって育んだ土地の方が、お前の陰謀をはびこらせるのに適しているからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "だが凍原は違う。ここの生活は苦しく、人々の頭にあるのは食糧の悩みだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前の自慢の演説は、身につけた造花のように、見掛け倒しの飾りで何の役にも立たない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "タルラ……タルラよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "もし、私がここにいるのは、この付近の凍原にはお前が残した足跡があるからだと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ならば私はそんなのデタラメだと言うだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "「人の歴史とは、闘争の歴史だ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前はすべて覚えているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "かつて私が教えたすべてを、お前はその後の戦いで用いたのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前がすべて覚えているのなら、凍原の感染者闘士タルラ、そして公爵の位を受け継いだタルラ、この二つは私にとってどこに違いがあるというのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "だがお前は私が凍原で築き上げたすべてを滅ぼした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "私が滅ぼした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "この一連の致命的な過ちを犯したのは、一体誰だと思っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "もしお前が本当に己に罪がないと判じているなら、自分はどのような死に方を選ぶべきかと、一年半もかけて考える必要などなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "それどころか、お前はすぐさま次の戦いに身を投じるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "タルラ、なぜお前が私の前に現れたのかはわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前は私に対する裁きでもって自身を裁きたいと考え、私の懺悔を聞いて自身の懺悔を始めようと思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前が求めているのは、少しばかりの、哀れな気休めにすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……続けろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "私に続けさせるのか？　てっきりお前は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "怒りを見せると思っていたか？　いや、コシチェイ、お前にそんな資格などない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "これまでのところ、お前のひと言ひと言、すべて脳内で想定したことがある内容だ。一年半は短い時間ではない。ロドスに捕らえられていた私は何もすることがなかったのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "この場で己の命を終わらせたくないのであれば、もっと新鮮味のある話をすべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "どうやら閉じこもっていた時間はお前に忍耐を与えたらしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "だが私が凍原について言及したのは、お前を刺激するためではないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "タルラ……この学校を見てみるといい。学生たちの顔つきを見てみるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "彼らは五月の日差しが凍原の雪を溶かし、凍原の土よりも堅牢なウルサスが彼らの足元で変化すると信じている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "そしてお前はまたあの卑劣な思想でもって、彼らの純真を汚すつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "私が彼らの中から次の継承者を探そうとしているとでも思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "違う、違うのだタルラ。私はただの普通の大学教師にすぎない。私が伝えているのは知識と思想のみだ。いかなる権力や富も私の手にはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "もしも、彼らが権力を欲するのなら、その両手でもって勝ち取ればいい。陰謀を渇望するのなら、私が教え伝えた知識の中から適切な手法を見つけ出すことができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前は――あの塔の上での失敗によって改心したと言いたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "失敗？　あれが失敗とは思ったことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "レユニオンはチェルノボーグ中枢区画で完全に消滅したわけではないからな。コシチェイの計画も同様だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "確かにお前たちは一時的に彼を阻止した。彼はウルサスを即座に変革させる戦争の到来を望んでいたが、それは叶わなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "しかし、ウルサスはそれでもコシチェイが設けた軌道に乗った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "戦争はまさに今起きている。議会と軍の摩擦は過熱し、人々の意志も一つ一つの衝突の中で新たな火花を散らしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "そして私は、どこよりも活力ある土壌において、力の及ぶ限り種をまく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "私は……こうした変革の発生を導く、あるいは促すと言うべきか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前は私に大衆を教育する意味を否定していたと思うが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "事態が変化しているにもかかわらず、統治者が過去の手法を変えることなく旧態依然に甘んじるなら、その者は必然的に破滅へと向かう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前はいまだ……統治者とうぬぼれているのか。なるほどな、少しも変わっていないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "忘れるところだったよ、お前はこの言葉をひどく憎んでいたな。コシチェイの支配を憎み嫌っていたのと同じように。ずっと前に言っただろう、誰が統治するかなど私は気にしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "ウルサスがヒッポグリフの手からこの土地を奪ったあの時から、明に暗に一体何度権力の交代が起きたと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "タルラ、お前は私であり、私もお前である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "我々が望んでいるのは、ウルサスが我々の手の平で火花を散らすことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "この火は……いずれウルサス全体を燃やすだろう。いや、ウルサスだけではない。ヴィクトリア……それに他の国も、みな巻き込まれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "大火の後、この土地はより一層の繁栄を迎えるのか、あるいは破滅に進むのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "ウルサスは自らの最初の千年を歩んだ――そして私は二つ目、三つ目に向かわせる。これこそ黒蛇が存在する意味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "黒蛇は不死である。自身を存続させる意志があるからではなく、ウルサスが生き延びねばならぬからだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "アスラン王の世継ぎがロンディニウムに戻った、だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そうみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "この前サルカズのトランスポーターたちを送り返してあげたお礼として、向こうがくれた情報よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お礼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "奴らは我々の手を借りて、公爵同士の争いを激化させたいだけにすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そうね。誰の目にも明らかよ。でも奴らのやり方から、ロンディニウム内の情勢に変化があって、サルカズが少し焦っているのも見て取れるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "サルカズはほかに何か言っていたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "特に有用な話はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "チッ、「スパイ」が捕われてから、得られるロンディニウムの情報がだいぶ減っちゃったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "残念だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ええ……ほんと残念だわ。まだ制御可能な範囲での損失でよかったけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そうだ、もう一つ多分重要な情報があったんだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "これは私たちに協力してくれてるクルビアの武器商が教えてくれたんだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "一ヶ月前、あのレユニオンと呼ばれる部隊が以前の「リーダー」を取り戻したそうなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それはつまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "タルラよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "これまでの情報がすべて正しいとすれば、彼女も……ドラコである可能性が非常に高いわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ほ、ほんとうなの？　う、嘘言ってないよね！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……キミに嘘を言ってどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "チェンちゃん、うちのこと殴って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "何をバカなことを言っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "早く殴って！　本当に夢なんじゃないかと勘違いしちゃうべ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だったら壁に頭をぶつけてみればいいだろう？　だがあまりやり過ぎるなよ。人家の壁を壊しでもしたら、この郡の騎馬警察に事情を説明しなきゃいけなくなるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うち……なんて言えばいいのかわからないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どうしてそんなに驚いている？　毎日毎日、隊長は絶対に死んでないと力説していたのはキミじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "でもうち……うちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "彼女がまだどこかで、キミが助けに来るのを待っていると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "でも隊長が生きてたって知れて、やっぱりすごくうれしい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ありがとう、チェンちゃん。おめーさんがいなかったら、うちロドスの人たちと知り合えてなかったし、ロドスに入ることも、隊長を助けてもらうこともなかったよ。ほんとよかった、うううっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ちょっ……抱きつくな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ううっ、だってすっごくうれしいんだもん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "せめて……そんなに力を入れないでくれ……うぐっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あれ、じゃあ……もしかして、チェンちゃんもう行っちゃうの？　隊長を探すの手伝ってくれるって言ってたけど、もううちが助ける必要はなくなったから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "こういう時だと、キミの頭の回転は速いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "正直、考えたことがないわけじゃない。あいつがロドスを逃げ出したと知ってから、ずっと捜索を検討していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "実は、うちわかってたべ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だがチェン・フェイゼは途中で投げ出すような奴じゃないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "これだけ長い間歩んできて、私たちはようやく手がかりを得た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "バグパイプ、私は引き続き調査を手伝う。「亡霊部隊が再び太陽にさらされるその日になったら」――私はすべきことをしに行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "タルラを探しに行く。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "タルラ、コシチェイがお前に教え込んだ技術を使え。私の言ったことが本心からのものであるか見てみるがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "ではお前はまだ私をここで殺そうと考えているのか？　都市の衛兵の視線をかいくぐるために、お前はいま剣を持っていないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "ならば自分の炎で私を処刑するしかない。私を愛するこの学生たちの前で……お前はそんな恐ろしい罪を犯してもいいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前を殺す程度、誰にも気取られずにできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "知ってるだろう、それもお前から教わった技術だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "私を殺すことで……お前は満足するのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "私一人で満足できなければ、二人目、さらには三人目の名を教えてやることもできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……つまり、ウルサス内の黒蛇は、お前一人だけではないと言いたいのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "生き延びるためについた嘘だと思ってくれてもいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前の新しい体は……とてももろいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "お前の息の根を止めるのは、あの老いたフィディアを殺すよりずっと簡単だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "なら何を待っている？　さぁ、私の体を消し炭にし……この薄暗い廊下にばらまくがいい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "「恐怖の感染者殺人鬼、再び大学に現る」――明日の新聞の一面はこれになるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "お前は……そんな悪名など気にしないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ついでに伝えておくが、私は三分後にここに駆けつけるであろう監視隊も気にしていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "だが……都市の外にいるお前の新旧の友人は……彼らは皇帝近衛兵の相手ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "たとえ近衛兵たちが一部の権力者の意を受け、お前がウルサスに戻ることをひとまず許容していたとしても……ウルサス内で殺人を犯すことまで許しはしないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……コシチェイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "もし近衛兵たちが不死の化け物――チェルノボーグ事件の首謀者がここにいることを知ったら、私を捕らえるよりも先に、その視線と刃をお前に向けるとは思わないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コシェルナ",
      "text": "なら、なぜまだ手を下さない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "……もうすぐ時間だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "まだ戻ってこないな。ナイン、あいつを見誤ったんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "万一時間になっても彼女が現れなかった場合、お前たちは計画通りに撤退するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士",
      "text": "お前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "彼女はまだ私の拘束具を付けている、つまり私の囚人だ。私自ら捕らえてこよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ならその手間が省けたな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "――タルラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "戻ってきたか。しかもぴったり時間通りだな。会いたい者には会えたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "まあな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "それで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "どんな成果があったかまで話させる気か？　あの長ったらしい無駄話でお前の耳を汚すつもりはなかったがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "ほう、随分と元気が出たようだ。冗談まで言えるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "例の邪神は？　殺せたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "奴はもう変わったと言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "信じるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "信じない。だが私も、もはや奴を殺せば問題が解決すると思っていたタルラではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "奴が私の目の届く範囲から離れるのを許さない。必要となれば、私はすぐに手を下す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ただ、一つ予感がする……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "予感？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "不死の邪神は……いずれ死ぬ。だが奴を殺すのは、私ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――ウルサスが奴を殺す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "奴は今なお人々の意志を操れると思っているが、私たちも奴に見せてやるのだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――いつの日か、目覚めた人々が愚昧な統治者を容赦なく捨て去る様をな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "その後、黒蛇はウルサスから消え去るだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "では今は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "まずはヴィクトリアへ。ここに戻ってくる前に、あの場所へ向かわねばならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
