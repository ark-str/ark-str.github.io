  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十一关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "これで……最後！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "がはっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "敵追撃部隊、制圧完了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "周囲に敵影なし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ところで、指揮を執ってた幹部は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "この部隊にはいなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "となると、どこかに潜伏して様子見しつつ、あとをつけてきてるってとこかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "大方、あたしたちの体力切れを待って、確実に仕留められるタイミングで襲撃するつもりでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。恐らく、そうだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "チェルノボーグでの経験からして、レユニオンは奇襲作戦を得意としているようですし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ここはひとまず、撤退しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ですが、現状の撤退ルートでは、安全とは言い切れません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "交差点を塞ぐ形でビルを破壊されでもしたら、危険に晒されることは明白ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "では、すぐにほかのルートを探しましょう。できるだけ目立たない道が理想です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "アーミヤさん、四時方向のはしごから降りるのはどうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "んー、ちょっと無理があると思うけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "はああっ！　ロドスめ、覚悟しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　伏兵です、気をつけて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "行け、続けて追撃しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "息つく暇を与えるな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……あの、隊長さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――スラムの中には……子供の感染者もいるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "できることなら、どうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "あの子たちを、守ってあげてくれませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……龍門の治安を守ることは、もとより近衛局の責務だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "感染者は、龍門の市民ではないが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――紛れもなく、龍門の一部ではある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ゆえに、私は私の為すべきことを為そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミの頼みには、何を保障することもできんがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "結局のところ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――でも、あの子たちから聞いたんです。前にも、あなたが……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "="
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――我々は常に、そうした責務に努めてきたし、今後もそう在り続ける。それだけの話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……ありがとう、ございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ときに、我々がキミを探していた理由については理解しているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "いえ……はっきりとはわかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "私には、あなたたちに必要とされるような心当たりはないですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "だけど、もしかしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "その理由は、私自身じゃなくて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――お父さんにあるんじゃないか、って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……その通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミのお父上は、チェルノボーグの高名な科学者だったと聞いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それと同時に、かの都市における政治的な重要人物の一人だった、ともな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ゆえに、キミは何かを知りえている可能性がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――とはいえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "あくまで可能性の話だが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "とにかく、キミがレユニオンの手に落ちるような事態は避けねばならない、というのが我々の見解だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "アハッ、み～つけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ごめんなさいねぇ？　近衛局に恨みはないんだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "今回はと～っても面白い筋書きを用意しちゃったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "これをもっと素敵な喜劇にするために……あんたたちにも、舞台へ上がってもらわないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それじゃあ……早速、始めましょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
