{
  "server": "jp",
  "storyId": "story_sleach_set_1_story_1",
  "groupId": "story_sleach_set_1",
  "stageId": null,
  "title": "つがいの羽獣",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_sleach_1_1.txt",
  "sourceHash": "d9ab3c2b1bbc5ce265c167a326a4599aa265f6dec40c473b365a83e83e248885",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "実はロドスに来る前……自分の身に何が起きるのか、あらかた予想はついていました。だけど、いざそれを目の当たりにした時、心の準備なんてちっともできていなかったことに、気付いたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "あたしは所詮、ただの儀仗兵に過ぎないのですが、それでも命は揺るぎないもので、容易くかき消してはならないと、ずっとそう信じてきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "だけどこの一年、本艦に乗ってあちこち駆け回り、たくさんの人を見てきましたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "多くの者は、まるでそっと吹き抜ける微かな風のよう。来たことに気付いた頃にはもう、音もなく通り過ぎていくのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "何も残すことなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "みんなの顔を、目の前で消えゆく命を、永久に心に刻み付けようとしました。だけど、たったの一年でもう記憶から薄れてしまっているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "きっとあなたも、同じ経験をしてきたのですよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "……なんて聞いても、その答えが返ってくることはもうないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "すみません、昔の癖でつい、どうでもいい話をダラダラと喋ってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "今日は花を持って来たんです。ここまで運んでくれる車隊が見つからなくて徒歩で来たから、少し萎れちゃってますが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "（誰か後ろにいる……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "すみません、ちょっと待っててください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ジェーン・ウィロー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "なぜお前がここに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "どうしてあたしの名前を知っているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "は、早まるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "俺だ、アークトンだよ！　第五防衛隊、ヒロック郡駐屯軍第六大隊所属のアークトン・コルセアだ。何年か前に会ったことあるが、覚えてないのか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アークトン……\nああ、思い出した。どうしてまだここにいるの？　軍はもうとっくに撤退したのでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "（袖を軽く引っ張る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "その腕……もしかしてあの時、十七地区から撤退できなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "汚染爆弾が落とされた時、上からの撤退命令を受けた者は一人もいなかった。通信機が壊れていたのか、ただ長官がうっかりしてたのか、それとも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ハッ、農家なら常識だろ？　雑草を抜く時は、どうしても麦の苗が何本か犠牲になるもんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "……アークトンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "お前が落ち込む必要はないよ。それより、お前の方こそ、どうしてここにいるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "亡くなった知人に花を手向けに来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アークトンさんは……まさかこの廃墟に住んでいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "いや、区画外の荒野で野営地を作って暮らしているよ。食い物を探しに廃墟に来たら、偶然お前に会ったってわけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "その言い方……あなた以外にもここで暮らしている人がいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ああ、取り残された兵士のほかに、ターラー人の生き残りも辺りを放浪している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "事件の後、軍は運よく生き残った感染者を探し出し、まとめて管理しようとした。そのために何回か捜索まで行っていたが、幸いなことになんとか目を搔い潜ることができたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "しばらくすると、損壊と汚染があまりにも深刻だと気付いたのか、この区画を完全放棄し、残った者たちも放置することにしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "食べ物を探してたって言ったけど、何か見つけられたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "（首を振る）はぁ、どうやらまた数日間は腹を空かせなきゃなんないみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "食料と薬なら少し持ってる。よかったら全部あげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "恩に着るよ、ジェニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ここに発信装置はある？　同僚に連絡を取ってあなたたちの状況を説明すれば、きっと物資をもっと届けてくれるはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ふむ……確かに廃墟で見たことあるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "本当？　詳しい場所を教えて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "そう遠く離れてないはないが、あそこはターラー人の縄張りだ……鉢合わせたら厄介なことになるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "敵同士とはいえ、辛い環境の中で生きているのはみんな同じ。誰もこれ以上揉め事を起こしたくないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "だからお互い普段は可能な限り、相手を避けるようにしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アーキトンさん、大体の場所だけでいいから教えて。やるだけやってみたいの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "この先の活性源石能動は安全値を超えている……ターラー人はこんな環境の中で暮らしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "もうずいぶん歩いてるのに……人影すら見当たらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "待って、あそこにいるのは！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "すみません！　待ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "あなたを傷つけるつもりはありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "薬と食料を持っています。これをあげますから、代わりに発信装置を借りてもいいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "今――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "今薬を持ってるって言ったの？　本当なのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "はい、ほら見てください。必要なら全部差し上げます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "ついて来て。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "アイスリン、ただいま。お薬を持ってきたわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瀕死の女の子",
      "text": "いたいよ……助けて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "この子は私の娘よ。あなたの持っている薬で助けてあげられる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "いや……ここまで症状が酷いと、応急用の薬程度じゃ果たしてどこまで効くのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "とにかく試してみてください。この子はまだほんの小さな子供なんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "分かりました……やってみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アイスリン、聞こえる？　少しだけチクッとするからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "（女の子の体に薬を注射する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "大丈夫、力を抜いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "娘は助かるの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ごめんなさい……力にはなれなかったようです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瀕死の女の子",
      "text": "なにも、見えない……お母さん、怖いよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "アイスリン、大丈夫、お母さんはここにいるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "……本当にごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "あたしにも、もうこれ以上できることは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瀕死の女の子",
      "text": "さむいよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "（女の子を抱きしめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "出て行ってちょうだい。もう二度と来ないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "食べ物はここに置いておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "この数日間、区画外の荒野に滞在しています。助けが必要なら、いつでも探しに来てください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "失礼しました。なるべく早くここから離れます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せた女性",
      "text": "……あなたのお目当ての装置は向かい側の建物の中にあるわ。勝手に持っていけばいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "……ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "おい、どうしたんだそれ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ふぅ……あなたたちの野営地が区画からこんなに離れてたなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "こんなデカい装置、よく一人で運んでこられたな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "はいはい、感心してる場合じゃないよ。まずは装置がちゃんと作動するか調べないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ほれ、ドライバーだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "よかった、中の部品は全部揃ってるみたい。これなら少し調整すれば使えるはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "そんなことまで分かるのか？　こいつは驚いたな……機械修理なんざいつ習ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "新しい仕事を通して、色んなことを学んだだけだよ。これでよし。ドライバーは返すね、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "すぐに発電装置に繋げてくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "どうだ、ランプはついたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "うん、ちゃんと起動したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "そういや、どこで装備を見つけたんだ？　ターラーの連中に難癖つけられたりしてねぇよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ううん、持っていた物資で交換してもらったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ならよかった。奴らも一応は礼儀はわきまえてるようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アーキトンさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "物資が届くまで、しばらく時間がかかるみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "だからその間に、畑を作って自給自足できる環境を整えたいの。危険を冒して区画で食べ物を探すよりずっと安全で効率もいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "理論上はそうだろうけどよ……ここにいる奴らのほとんどは体を満足に動かせられん。手を貸せる奴は少ないせ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "それとね、区画にいるターラー人たちにも野営地に加わってもらおうと思ってる……食べ物と水を条件として提示すれば、きっと了承してくれるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "何言ってんだ！　奴らがここに来たら、真っ先に俺たちを始末するに決まってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "あなたたちが相容れない仲だというのは分かってる。でも今の状況に選択肢なんてないんだよ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "あたしにできるのは一時的な手助けだけ。共に支え合って先に進んでいけるのは、同じ感染者であるターラー人たちよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "そして今、あなたたちの前には、過去のことを水に流して共に生きるか、恨みを抱えたまま共に死ぬか、この二本の道しかないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "考えさせてくれ……それに、他のみんなの意見も訊いてみないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "装置を探していた時、一人の女性に会ったの……あたし、その人の娘を助けられなかったのに、それでも装置の場所を教えてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "あの子連れの女のことか？　彼女のことなら知ってるぞ。そうか……道理で最近は娘といるところを見かけなかったわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "はぁ、彼女はこれからどうなるんだろうな……例の事件で夫も両親も姉妹も、みんな亡くしてしまったのに、今度は娘まで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "だからアーキトンさん、ちゃんと検討して。あそこにいるターラー人だって、必死に生きようとしているただの人なんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "おい、ザック、あいつらのことを信じるのか？　俺らを油断させてその隙に何かしかけようって算段だとしか思えないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無関心なターラー男性",
      "text": "そんな難しいこと、俺にゃ分からねぇし、分かりたくもねぇ。もう何日も食ってねぇんだ。今は食いモンのことしか頭にねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "これは絶対に罠に決まっている。あの兵士どもめ、腹の底で何を企んでやがるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無関心なターラー男性",
      "text": "だからどうだってんだ？　散々文句を言っておいて、結局お前も来てるじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "フン……あのヴイーヴルが、鉱石病の症状を緩和できる薬を持ってるからね。ここ数日、発作のせいで体が酷く痛むんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "野営地の東に簡易的な浄水装置がある。南の土地が、これから畑になる予定の場所だ。そんで、病人はまとめて北のテントで面倒を見ている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "毎日の昼と夜に、野営地の中心で食料の配給がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "コホン……まぁ説明はざっとこんなところだ。ジェニー、何か補足したいことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "誰かいつも小さな女の子を連れていた、痩せた女性を見かけたことがある人はいませんか？　女の子は最近亡くなったばかりなので、今は一人だと思いますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "それって、モイールのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "目の下に小さなホクロのある茶髪の女性よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "ああ、モイールで間違いないな。でも、探し出して何をするつもりなんだ？　まさか彼女、君の恨みでも買ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ううん、ただ最近元気にしているのか、気になっただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "そんなの、誰が知るかよ。しばらく見かけていないから、どこかで野垂れ死んだのかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "そんな……あなたたちはお互いのことを、少しくらいは気にかけていると思っていたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "ハッ、こんなとこで暮らしているのにか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "いいかヴイーヴル、ここじゃ、誰も他人のことを気にする余裕なんてないんだよ；",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "なんだその目は。俺はただ本当のことを言ったまでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "いえ、特に何も……では皆さん、長旅で疲れているだろうし、今日はもうゆっくり休んでください。明日から、やることが山積みですからね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ジェニー、俺にはお前が何考えてんのかサッパリだぜ。あいつらに食べ物と住む場所をくれて何になる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "俺らに媚びへつらえとまでは言わないけどよ、せめて騒ぎを起こさず大人しくしとくべきじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "なのに昨日、仕事中に掴み合いの喧嘩が起きたらしいな？　当事者の一人はまだ寝込んでんだとよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "うーん、あの木の実、高すぎて手が届かないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "おい、ジェニー！　俺の話、聞いてたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "え？　ああ、あの件ね。先に失礼なことを言って喧嘩を売ったのはあなたの仲間よ、アーキトンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "誰がそんなこと言ったんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "騒ぎが起きてすぐに、あたしが現場まで駆け付けたの。頭を殴られて寝込んでる人を介抱して、ベッドまで連れて行ったのもあたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "そんなの……ちゃんとことのいきさつを全部聞いたのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "えぇ、だからお詫びの印に、この木の実が入ったバスケットをアーキトンさんが持って行ってあげてよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "苦しそうな兵士患者",
      "text": "苦しい……サイラッハさん、俺はこのまま死んじまうのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "そんなことない。今鎮痛剤を注射したから、すぐに痛みが引くはずだよ。だからもう少しだけ頑張って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しそうな兵士患者",
      "text": "ありがとう、ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "どう？　少しは楽になった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しそうな兵士患者",
      "text": "何か話をしてくれよ、サイラッハさん……怖くて仕方ないんだよ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "どんな話が聞きたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しそうな兵士患者",
      "text": "なんでもいい……誰かの声を聞いていると安心できるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "なら、詩の朗読でもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しそうな兵士患者",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "「一対の白い羽獣となって、君と波頭で戯れよう」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "「時は私たちを忘れ、悲しみは二度と訪れない……」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無関心なターラー男性",
      "text": "サイラッハさ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "シー、今眠ったところなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "（小声）ザックさん、みんなのお世話をしてくれてありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無関心なターラー男性",
      "text": "（小声）いいよ、礼なんて。それより果物でも食べるか？　取ってきてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "（小声）果物？　そんなもの、どこで見つけてきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無関心なターラー男性",
      "text": "（小声）どういう風の吹き回しなのか、兵士の一人が突然持ってきてくれんだ。野生の木の実らしいが味は悪くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "（小声）きっとこの前のお詫びだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無関心なターラー男性",
      "text": "（小声）どうだろうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しそうな兵士患者",
      "text": "ううっ……寒い……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "顔をしかめながらも、男は優しい手つきでベッドに眠る患者のために布団をかけ直してやった。"
    },
    {
      "type": "dialogue",
      "speakerName": "無関心なターラー男性",
      "text": "（フン、寝てる時まで騒がしいやつめ。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アーキトンさん、起きて！　はやく！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ジェニー……？　どうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "北の患者テントで酷い水漏れが発生したの。様子を見に行くから、人手を集めてきて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "なんだって！？　待ってくれ、すぐに行く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アーキトンさん、こっち！　急いで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ああ、待たせた！　中にいる患者はどうやって運び出せばいい？　畜生、雨に濡れて体を冷やしたら、さらに病状が悪化するぞ。急がないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "患者ならもう他のテントに移動させたよ。真っ先に駆け付けてくれたターラー人のおかげでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "だから、ターラー人たちがもう患者を全員移動させてくれたの！　だから安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "全員って、俺の兄弟たちもってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "もちろん。でもあたしが持ってきた薬は、運び出すのが遅れて、もうダメになっちゃってるかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "落ち込むな。そいつは俺が何とかする。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ありがとう、デイグランさん、アーキトンさんを探すのを手伝ってくれて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "礼なんていらない。　薬をくれたから頼みを聞いてやっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "実あたしが持ってきた薬はもうほとんど使い切っちゃてるの。ここ数日、みんなに配ってる薬は全部、アーキトンさんたちが危険を冒しながら廃墟から見つけてきてくれたものなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "チッ、面倒をかけやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "おい、アーキトン！　どこにいやがる！　返事くらいしやがれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "こ、ここだ！　ここに閉じ込められてる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アーキトンさん！　怪我はしてないよね！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "平気だ。ただ出口の道が崩れちまって、外に出られねぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "フン、用もなく地下室に入ったりするからだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "無駄口はいいから手を貸してくれ。怪我して気を失った女を見つけたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "分かった。引っ張り上げるから、下の方から支えてて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "こいつ……モイールじゃないか！　生きていたのか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "よう、スコーン食うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "スコーンだと？　下らない冗談はよせ。そんな贅沢なもんを作る材料なんてどこにある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ジェニーが作ったんだよ。昨日、森からなんか採ってきたかと思いきや、本当に成功させるなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "そうなのか？　俺にも一つ味見させてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "こんなとこで甘いもんが食えるなんてな。少し前までは飯すらロクに食えなかったのによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "こうして畑を耕したり、羽獣を飼育できるのも、あの小娘が俺たちをまとめてくれたからだ。彼女は治療や看護の知識もあって、修繕の技術も持っている。しかも料理までできるときた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "喋ってないでさっさと食え！　もう一個いるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "いやいい、残りはモイールに取っておくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "モイールは少しは元気になったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "怪我の方がだいぶ良くなったが、相変わらず喋ろうとしないし返事もしてくれない。我が子を失ったショックが相当大きいのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ジェニーには苦労をかけるな。ここ数日、ずっと付き添ってくれてるんだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "おっ、噂をすれば、だな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "アーキトンさん、同僚から連絡が来たの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "そうか！　向こうはなんて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "南にある事務所の物資を一部、緊急でこっちに振り分けてくれるらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "いつ届くんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "道中何事もなければ、一週間くらいで届くはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "そんなに早くか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "喜ぶにはまだ早いよ。同僚が言うには、あたしたちの位置を正確に特定できていないせいで、輸送車両がに早速遅れが出てるらしい。たぶんこっちの電波の問題だと思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "なんだ、そんなことか。後で区画に行って、電波増幅設備がないか探してみるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "うん、お願い。それと野営地の中心に目印になる旗を立てなきゃいけないの。旗と位置測定器を組み合わせれば、もっと正確にここの場所を特定してもらえるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "そんなの、悩むようなことじゃないだろう？　派手な色の布を高い位置に引っ掛けておけばいいじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "目印なんだから、一応ちゃんとした旗の方が良くないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "それなら、区画に落ちている郡の旗でも拾ってくればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "まさかお前、まだ自分をヒロック郡の人だとでも思ってんのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "フン、俺は別にお前ら駐屯軍の旗でも構わないけどな。探せば区画のどこかには落ちてるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "冗談じゃねぇ……あんなもの、もう一生見たくないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "だったら、せめて何かしらアイディアを出してくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ジェニー、お前にいい案はないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "あたしもまだ思いついてない。それに、こういうのはみんなの考えも聞かなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "ハッ、みんなこう言うはずだよ。サイラッハの考えが一番いい考えだとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ああ、それについては同意だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ごめんなさい、アーキトンさん。こんな夜遅くまで、裁縫を手伝ってもらっちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "気にすんな。こんな不器用で良ければいくらでも手伝うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "浮かない顔だな。まさかまだ旗のことで悩んでるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "今日、野営地で意見を聞き回ってきたけど、みんなまるで口裏でも合わせたかのように、あたしが決めればいいって言うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "みんな、お前の決めたことなら大丈夫だって信じてるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "だからこそ余計に悩ましいんだ。全員満足できるような案を出さないと、信頼を裏切ってしまうことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ジェニー、本当は分かってんだろ？　仮にお前が何もないまっさらな旗を作ったとしても、文句を言う奴なんざ誰もいないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ここ最近毎日、日が昇る前からみんなを率いて区画や森に食べ物を探したりと、俺らのためにずっと忙しく駆け回ってくれてたろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "しかも野営地に戻った後も、こまごまとした雑務に追われて、なかなか休む暇がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "みんなが旗の件をお前に任せたのだって、体力を使わない仕事の方が楽で、お前を休ませられると思ったからだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "そうなの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "そうだよ。だからお前が旗のことで必要以上に気を遣ってたら、みんなの気遣いが台無しだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "というわけでジェニー、残りの作業は俺に任せて、今日は早めに寝ちまいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ロウソクの火が少し弱くなってる……窓をもう少し開けるね。今日は月が出てるから、それでだいぶ部屋が明るくなるはず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "……ねぇ、アーキトンさん、聞こえる？　誰かが歌ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ほら、耳を澄ませてみて。風が強いから、ぼんやりとしか聞けないけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "本当だ。どこで歌ってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "さあ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "もの寂しげなか細い歌声が、ゆらゆらとの中を揺蕩う。その存在に気付いた人々は、思わず共に口ずさみ始めた。\nそうして歌声は徐々に大きくなり、ついには風の音をかき消した。気付けば、野営地の隅々にまで、歌声が響きわたっていた。\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "……モイールだな。前に世話してた時に、囁くように小さく歌っていたのを聞いたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイラッハ",
      "text": "ステキな歌声ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "ふわぁ……なんなんだ、朝っぱらから騒がしいな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "デイグラン！　こっちに来てくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "どうした……まさか、何かあったのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷した兵士",
      "text": "ジェニーだよ！　あいつ、やってくれたぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なターラー男性",
      "text": "は……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ざわつく群衆を押しのけ前へ出ると、男は野営地の開けた場所に目を向けた。\nそこには、朝露と冷たい風を受けながらも、旗竿に向かって背筋を伸ばし真っすぐ立つ少女の背中があった。\n少女の服装はきっちと整えられ、髪は一つの乱れもない。そして、その手には巻かれた旗を持っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少女の歌声と旗紐を引っ張る動き合わせ、旗はゆっくりと空高くまで昇っていき、風を受けてひらりとはためく。\n一対の白い羽獣が青空を飛び交っていた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
