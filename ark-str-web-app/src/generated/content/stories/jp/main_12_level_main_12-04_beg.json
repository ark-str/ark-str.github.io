{
  "server": "jp",
  "storyId": "main_12_level_main_12-04_beg",
  "groupId": "main_12",
  "stageId": "main_12-04",
  "title": "脆い鋼",
  "storyCode": "12-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_12-04_beg.txt",
  "sourceHash": "6791ddc6d5b4dbfc813b1bf8481bf51fe785430097a2858116d99efbb05da63e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "ロンディニウム市民自救軍のメンバーの中で……都市外への撤退を決意した者たちはこれだけか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "損害は想像以上だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ロンディニウムに残るって決めた人もいるよ。サルカズは俺たち自救軍の拠点を破壊したけど、協力者全員の名前を把握してるとは限らないってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "情報漏洩の程度は分かんないけど、ほとんどの連中はそこまでひどいモンじゃねーと思ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "フンッ、だから普通の生活に戻るフリができると考えるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あたしたちには、もう逃げ場なんてないことがわからないのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "そう言ってやるな、ロックロック。彼らの大多数は本当の戦士などではなく、我々に少しばかりの希望を見出しただけなのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "ここに立っている我々も……大半は戦士などではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "誰に忠誠を尽くすべきかわからなくなった兵士、職を失った記者、サルカズの搾取に憤る組立工……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "皆、普通の人たちだ。ただ、耐えられなくなっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "ロンディニウム市民自救軍は本来そういう人々で構成されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "ロンディニウムを去り、我々の育った場所を離れれば、もはや情報を伝えたり、武器を製造したり、サルカズの傭兵たちと戦ったりすることもなくなる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "いつまで続くか、何人の犠牲が出るかもわからない本当の戦争の中で自らの居場所を見つけなくてはならない。これは確かに恐ろしいことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "ここは我々のロンディニウム、だからこそ我々自身の手で守らねばならない……当初我々はそう思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "我々はずっとそういった恐怖に抗い続けるのだと思っていた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "しかし、それが本当に自分の身に降りかかってきた時、それを受け入れることは想像した以上に難しいものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "正直言って、我々の運命が今後どうなるかはわからない。友人ができた。しかし敵もまた真の牙を剥いたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "もしかするとすぐに殲滅されて、荒野をさまよう亡霊となり、最終的には散っていくのかもしれないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "指揮官、そんな縁起でもないこと言わないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あたしがここに来たのは、自分の手で自分の自由を取り戻したかったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "みんなそうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あたしは労働者で、もっともらしい道理なんかは全然分からない。分かるのは、自分の手で作り上げたものこそが、この世で一番信じられるってことだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あたしは、宮殿やお城に隠れてる奴らの手から、自分たちの都市を救い出したい。一人じゃ無理だけど、運よく君たちと出会えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "もしあたしたちだけでもまだ足りないなら、もっとたくさんの人と一緒に立ち上がろう。最終的にそれでも失敗したなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "それで構わない。あたしはその結末を受け入れる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ちょっとロックロック、今はまだ結果についてどうこう言う時じゃないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ほらほら、さっさと足動かして。こんな鼻の曲がりそうなパイプの中じゃ、負傷者たちの健康に良くないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "そうだな、郊外の空気はロンディニウムよりいいはずだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ロドスの分析によると、もう少し先に進めばサルカズの補給ルートの分岐に入れるはずなんだけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "戻ったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ばあちゃん、状況はどうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "安全は確認した。駐屯軍もいなかったし、巡回の痕跡もない。あそこは整備通路らしくて、用途不明の計器なんかは残ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "妙なことに、実際の「補給ルート」がどこなのかは分からなかったけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "とはいえ、今の状況だったら撤退はその整備通路で十分間に合うだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "早くしな、フェイスト。あんたの友達を動かすんだよ。今は安全かもしれないけど、それが永遠に続くわけじゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ああ、わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしは運び出した設備の様子を見てくるよ。いくつか使えそうなものがありそうだ。廃棄されてたクローラーが何台かあったけど、運が良けりゃまだ動くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ばあちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺は……その。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺たちがしてることを疑ってるわけじゃないし、失敗してしょげてるわけでもねーけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺は……俺たちは帰ってこられるよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "フェイスト、あんたはあたしに何て言ってほしいんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺はこれまでずっとみんなを励ましてきたけどさ、実際は俺自身もここを離れたことなんてねーんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "それに、こんな形で去ることになるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "フェイスト、あたしも以前は時々こう思っていた……あたしたちは本当は幸運に恵まれてるんじゃないかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "ロンディニウムという都市で生まれて、信頼できる友人がいて、やりがいのある仕事を持っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "休日には、路地裏の飲み屋で一杯やることもできるし、トランプで小銭をいくらか稼いだりもできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "もちろん、ヴィクトリアが本当の意味で平和だったことはないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしらの作ったもんは国境へ送られて、サルゴン人やリターニア人との戦いで使われる。敵対する連中の体に風穴を開ける道具だ──だけどそれはあたしらの仕事とは関係ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしらはただ、工場で鉄塊をねじで締めてればいいのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "ロンディニウムで暮らしてたって、苦痛を味わうことはあった。癒えない傷を負いもした……だけど明日誰を殺すのか、あるいは誰に殺されるのか、なんていう心配はしなくてよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしらはまだ暮らしを続けられていたんだよ。少なくともそれのフリはできてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "それからサルカズがやって来て、毎日が苦しくなった。工場を明け渡して、毎日はさらに苦しくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "だけどあたしの基準からすれば、まだ幸運の範疇だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ばあちゃんの言う幸運の定義って一体何なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "そうさね、今ここで立ってあんたと昔話をする時間がまだあるってことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "今は、いよいよ運が尽きる時が来たってだけだよ。宝くじが永遠に当たり続けるような奴はいないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "だけど運が尽きたから何だってんだい？　ほとんどの人間にはツキなんて端っから回って来やしないんだ。それでもどうにかして暮らしてるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あんたは、あんたの仕事をしな。「自救軍の大物」なんだろ、旋盤は自分で勝手に荷造りしちゃくれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "やるべきことをやるんだよ、あの時あたしに約束したようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "フンッ、何て言ってたっけねぇ？　「俺はどんなに暗い夜にだって乗り込んでくから──」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "分かったから、ばあちゃん！　あん時はちょっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "大口叩いたことを後悔してるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "いんや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……何べんやり直しても、俺は絶対同じことを言うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "そういう時のあんたは、ハービーによく似てるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "キャサリンはフェイストを横目で見ると、振り返って人波の中へと消えた。フェイストのそばを色んな格好をした人たちが慌ただしく通り過ぎる。彼らは皆疲弊していたが、誰も諦めてはいなかった。\nフェイストは知っている。この場所に立っている者たちは皆、最も信じるに値する仲間だと。\n無いよりはましという程度の安らぎを感じながら、フェイストは小さく息を吐き、長い間張り詰めて強張った腕を動かした。\nチャンスや時の運、あるいは何か別の名前で呼ばれているその霧が晴れた時――ロンディニウムを離れた時、自分たちにはどんな暮らしが待っているのだろう？\nフェイストは想像するのをやめた。その代わりに、思い切りよく飛び込んでいくことにした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "フェイスト──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "負傷者たちはすでに所定の位置についてる。これからその整備通路に入ってロンディニウムを離れれば、ひとまず安全を確保できる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "その時がきたら、あたしたちはもう一度、自救軍第十一小隊を結成するよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "当たり前だろ、ロックロック。約束だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "行こうぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フェイストはふいに微かな震動を感じた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "これは……何が起こったの？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "遠くで地下構造の出口と入口が同時にゆっくりと閉まっていくのが見える。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "パイプが閉じられてる？　まさかサルカズに気付かれたの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "まずい！　キャサリンさんと指揮官が入口近くにいるのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "違う、付近のサルカズの通信をずっと傍受してるけど、あたしたちの動きは多分まだバレてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "うーん、まさか制御回路の故障ってことはないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……いや、このパイプのゲートは入口で手動制御するんだ。ここに入る前にチェックしたけど、ドライブシステムに問題はなかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "仕事で常に明かりを必要とする工員の中では珍しく、フェイストは視力が良かった。それは彼の自慢でもあった。\nしかしそんな彼も、この時ばかりは自分の視力の良さを呪った。\n入口の閉じかけているゲートの隙間に、彼は見覚えのある人影をいくつか目撃した。\nそれらが見えたのは一瞬のことだった。その後、最後の一筋の光が鉄のカーテンの向こうに消え、ゲートは完全に閉ざされた。\n辺りは漆黒の闇に包まれた。\nフェイストは辛うじて体勢を立て直したものの、口の中に血の味が広がっていくのを感じた。\n彼はその血生臭さを飲み込もうとしたが無理だった。それすらも。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "こんなの計画になかったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "通路の向こうにいるのは誰？　どういうつもりなの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "どうしたの、フェイスト？　君……唇から血が出てる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺は通路の向こうにいる奴を知ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "あれは……俺のダチだ。十一号軍事工場の工員たちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "あいつらは、他に持ち出せる設備がないか見に行くって言ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ゲートを閉められるのは、あいつらだけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……トミー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員A",
      "text": "キャサリンさん、違うんだ……これは俺の考えじゃありません！　みんなで決めたことなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしを助けた、あの時みたいにかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "それとこれとは違う、キャサリン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "トミー、お前は仕事に戻れ。その前に都市防衛軍の奴らを探して、この場所のことを伝えるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員A",
      "text": "は……はい！　どこにいるかはわかってます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "さすがのあんたらも、人を縛りあげる技術はサルカズには劣るね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "お前に危害を加えるつもりはねぇんだよ、キャサリン。俺たちもう何年の付き合いだ？　お互いのことを嫌ってほど知ってるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "だがよ、俺たちだってロンディニウムの郊外で死ぬのはごめんだ。あの化け物たちの術にやられて死にたかねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "俺はただの鋳造工だぞ！　溶解炉が使えて、旋盤が使えて、精巧な部品を作れる──その程度なんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "なのに奴らは俺たちを都市から引っ張り出して、大公爵とサルカズの戦争に巻き込もうとしてるんだぞ？　冗談じゃねぇ、俺が使える一番武器っぽいものといやぁ、せいぜいレンチくらいだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "キャサリン、約束するよ。何もかもうまくいくさ。俺の叔父さんが都市防衛軍の兵士なんだ。工場のみんなのことは、俺が叔父さんに頼んどくから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしらがすでにやっちまったことはどうするんだい？　サルカズを襲撃したんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "全部あの自救軍がやったことにすればいい、俺たちはただ脅されて仕方なく協力したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "ハッ、奴らが信じるとでも思ってるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "俺たちが今後受ける扱いはもっと残酷かもしれない……だが大公爵たちがこの戦争に勝てば、昔みたいな日々に戻れるだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "だってこのロンディニウムは、俺たちの手で作ったんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "……きっと何もかもが元に戻るはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "以前のあんたは貴族に希望を託すような奴じゃなかったろうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "だったら他にどうしろって言うんだよ！　教えてくれキャサリン、一体他に何ができる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "俺はただ……自分の家を捨てたくないだけなんだよ。ただもう一度ロンディニウムの大通りを歩いたり、たまにダチとサッカーをしたいだけなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "……俺は砲弾で吹き飛ばされてできた穴の中で、バラバラになって死にたかねぇ。前に見たことがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "だがサルカズたちは……もっと残酷なことだってやるだろう。俺が死んだら娘は死体を全部かき集めることすらできねぇだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "一緒に来てくれ、キャサリン。お前に手荒な真似はしたくねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "そして自救軍のチビリーダー、お前は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "ん？　どこ行った？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クロヴィシアがいた場所には、切れたロープだけが残っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員C",
      "text": "あれ？　さっきまでここにいたはずだよな？　ちょっと目を離しただけなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "お前らこんだけいてガキ一人すらまともに見張れねぇのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員C",
      "text": "き……きっと何かのアーツだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "まあいい……放っときゃいいさ、あいつもただの仕立屋の娘だって話だしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員B",
      "text": "このロンディニウムの夜の中で、せいぜい隠れる場所が見つかることを祈っといてやるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "……すごく臭い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "ここ数日でどれだけ死んだと思ってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "東の路地には行くんじゃねぇぞ。昨日あそこで感染者が何人か爆発しちまったせいで、そこら中が源石粉塵だらけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "クソったれ！　サルカズどもの目的はオレらをここに閉じ込めて、野垂れ死にさせることだぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "昼間、運輸組合に行った時、マーシャルは何て言ってた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "あそこは今燃え尽きて骨組みしか残ってねぇよ。マーシャルがあの死体の山ん中にいるかどうかは知らねぇ、探してもいねぇからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "だがオレらは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "ノーポート区の連中はバカやビビりばっかじゃねぇ、そうだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "ただちょっと……ストレートパンチを食らって、頭がクラクラしてるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "それが治ったら、ノーポート区総出で反撃すんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "ひょっとしたら、すぐにでも大公爵たちがここに軍を送ってくれるかもしれない、その時は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "何だ、オマエいつから大公爵たちの崇拝者になったんだ？　オマエの引き出しにゃウェリントン公爵のサインでもしまってあんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "オレらはなぁ、自分しか頼れるモンがねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "オレらは絶対にここから脱出できる。オレがオマエらのために敵陣に突っ込んでやるよ、この拳に誓うぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "前にも誓った。夜番で絶対に寝ないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "あん時はちょっと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "まぁいい。でも夢を見るなら、今晩の食事にありついてから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "今まで生き延びられたのは、普段からデルフィーンがジムの倉庫を食料でいっぱいにしておいてくれたおかげ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "でなきゃ、私たちも今頃この死体の中の一つになってた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "カドール、向こうでまた戦闘が始まったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "チッ、何でこんなとこまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "行き先を変えるぞ。荷下ろしエリアのレストランなら、まだ在庫があるかもしれねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "ありゃ売ってくれるんじゃねぇかな……交換でもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "もし向こうに売る気がなかったら、どうするつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベアード",
      "text": "あなた武器持ってるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "これは……単なる護身用だ。多分使うことはねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カドール",
      "text": "状況は……まだそこまで悪かねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
