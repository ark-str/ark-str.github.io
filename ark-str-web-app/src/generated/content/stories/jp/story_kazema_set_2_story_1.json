{
  "server": "jp",
  "storyId": "story_kazema_set_2_story_1",
  "groupId": "story_kazema_set_2",
  "stageId": null,
  "title": "人混みの中で",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_kazema_2_1.txt",
  "sourceHash": "f72ad4a524a991f5f975b30ef45b6e0e7bdf1b7794041f573d449e8ed7aa7ea8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "嬉しそうな声",
      "text": "戦争が、ついに終わった！　我々は生き抜いたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声",
      "text": "ハハハハ、これからは毎日パンを食うんだ！　ステーキにかぶりつくんだ！　毎日綺麗な新しい服を着るんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "ちょっと、喜ぶならもっと周りを見てやっておくれ。あたしゃスープを運んでるんだからね——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "危ない！　お手伝いしますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "おや、お嬢ちゃん。どこから湧いて出たんだい？　さっきまで全然姿が見えなかったけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "でも、ありがとね。あんたがいなかったら、時間をかけて作った肉のスープがこぼれてしまうところだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "お気づきにならなかったかもしれませんが、ついさっきまですぐ後ろにいたんですよ。鍋はわたしが運びますので、ゆっくりで大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "ありがとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "いえいえ、以前も感染者たちのために薬代を寄付してくださって、今日もこうして料理のお手伝いに来てくださったじゃないですか。これくらい、当然のことです。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "老人は微笑み、落ちてきた髪をかき上げ、リボンの中に押し込む。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "そのリボン、とても素敵ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "あら、そうかい？　嬉しいねえ。これは自分で作ったんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（ふぅ、つい無意識に潜行の技を使っちゃったけど、おばあさんを驚かせなくて良かった。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（早くお鍋をテーブルまで運ばないと。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "おっ！　見ろ、また料理が来たぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる感染労働者",
      "text": "嬢ちゃん、あんたも給仕はその辺にして、こっちに来て座りな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安堵する金持ち",
      "text": "おいでなさい。こちらなら赤ワインも飲めますぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "ええ、分かりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "さあ、俺と乾杯してくれ！　数日前にあんたが店の内装を手伝ってくれたことに感謝せにゃならないんだ。俺一人だったら、二、三日はかかってたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる感染労働者",
      "text": "気にするなって！　あんただって、前に新鮮な果物をたくさん分けてくれたじゃないか。あの時に果物があったおかげで、まだ希望はあるって思えたんだ。助けてもらったんだから、返すのは当然さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる感染労働者",
      "text": "もちろん、あんたにも感謝しないと。あんたが商人を探して車を借りてくれたおかげで、俺たちは果物や野菜を買うことができたんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安堵する金持ち",
      "text": "いやいや、大したことはしてないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "ハハハ、まあ何はともあれ、これからは皆、苦しい日々を共に乗り越えた仲間だ！さあ、乾杯しよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（……これまで努力した甲斐があったなぁ。本当に良かった。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "乾杯――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "あれ？　爺さん、浮かない顔してるな？　どうしたんだよ。料理が口に合わないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……いや、今夜の飯はとても美味い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "少し疲れているだけかもしれん……ハハ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "そうか。まあ、一杯飲もうぜ！　こいつはうちで新しく作ったビールなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる感染労働者",
      "text": "こんな美味いビール、俺は飲んだことがねぇよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安堵する金持ち",
      "text": "まったく、お前たちときたら、大声で飲めや歌えやと、はしゃぎすぎではないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安堵する金持ち",
      "text": "どれ、もっと優雅に、我が「ヴィクトリア」らしく杯を挙げて祝おうではないか！　さあ、私の秘蔵の赤ワインを味わいたまえ。それでこそ、地中に埋めて隠しておいた甲斐があったというものだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる感染労働者",
      "text": "おうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる感染労働者",
      "text": "俺も一杯もらおう、赤ワインなんて飲んだことがないぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人は長いこと沈黙していた。\n皆の顔から楽しげな笑みが消え、やがて困惑が浮かぶ前に、老人はようやく力なく皆と杯を合わせ、中の酒を一気に飲み干すと、すぐに立ち上がった。"
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "もういいだろう。わしは帰る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "だが、喜びに浸っている人々は彼をこのまま帰したくはなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "おいおい、まだ料理も揃ってないのに、もう帰るのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安堵する金持ち",
      "text": "もう少しいてもいいだろう。今帰ってしまったら、私が持ってきたこの上等な赤ワインは誰が飲むんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……遠慮しとくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる感染労働者",
      "text": "そう言わずに、もうちょっとだけ。な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "そうだよ、ほら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "まあまあ、無理に引き留めないでおきましょう。何か用事があるのかもしれませんし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……すまんな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ社会人",
      "text": "そういや、爺さん。いつも大事にしてた娘さんはどうしたんだ？　今日は一緒じゃないのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その途端、まるで爆発音のようなガラスの割れる派手な音が彼らの会話を遮った。\n賑やかだった宴の席は一瞬で静まり返り、人々は呆然と床に叩きつけられたビールジョッキを見ていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "娘は死んだ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "わしは娘を、生まれたその瞬間からずっと大切に育ててきた。ずっと健康で、戦争が始まっても、あの子に苦労ひとつさせなかった。なのに、それなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "鉱石病の急性感染で死んでしまうなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "娘は素晴らしい人生を送れたはずだったんだ！　あの子は命を落としたというのに、感染者はのうのうとここに座って、皆と一緒に飯を食っているだと？　また誰かにうつすと考えもせんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "わしはお前たちが、感染者が、感染者と共存しようとするやつが、憎い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "お前たち、碌な死に方をせんぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "民衆",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……隊長、以上が昨夜の宴会で起こったことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "この数日間、我々は感染者の保護や、損壊した建物の再建、物資の運搬、停止していた工場や店舗の再稼働などの支援にあたってきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "多くの感染者も自主的に協力してくださって、作業を手伝ってくれました。昨夜は誰もが待ち望んでいた、ここ数日間のカレドンの活動成果を祝うための宴会でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……まさか、あのようなことが起きるとは予想もしていませんでした。このままでは、感染者に対する差別的な言論が再び盛んになるのではないかと心配しています……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "我々が最近把握している状況だと、戦争が終わっても暮らしが良くなるどころか、かえって感染者が増えたことで、誰も彼も戦後に感染するのではないかと不安がっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "また、鉱石病で親しい人を失った者もいる。このような事態は……ある程度、想定の範囲内だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "隊長、人員を割いてこの状況に対処する必要があると思います。このままでは、今後の任務に支障をきたす恐れがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "事務所は今、人手不足だ。負傷した感染者の保護に戦後の復興に……我々がすべきことはまだ山ほどある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "日頃からできる限り情報を集め、感染者関連の問題の発生を発見した場合は速やかに警察に連絡し、状況に応じて協力するしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……わかりました、隊長。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "次の任務は……無許可で開かれている教室の巡回と感染者の保護、それから議会の書類整理……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "全力を尽くします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な学生",
      "text": "（学校はまだ完全には再開していないし、自主的に開かれている教室も政府に届け出は出していない。けど幸い、どれも学校の先生が主催している補習みたいだから問題はなさそう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な学生",
      "text": "（やっと授業が終わった。帰って報告書にまとめれば、この任務は完了かな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひそひそ話す声",
      "text": "……ねえ、見た？　前に座ってる男子、感染者みたいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な学生",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な学生",
      "text": "（ついて行ってみよう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひそひそ話す声",
      "text": "ほんとだ、感染者っぽいな！　あいつが座ってる椅子には座らないようにしよ。うつされちゃうかもしれないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひそひそ話す声",
      "text": "はあ、戦争は終わったけど、感染者が一気に増えたよね。私たちもうつされちゃうかもしれないよ！　先生はどうしてクラスを分けないんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な学生",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "最近は回復も順調で、病状も安定していますよね。これを見てください、場所を探しておきました。まずはここで日用品でも売って金を稼ぐといいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "ロケーションは悪くないと思います。人通りも多いし、一日働けばいくらかは稼げるはずです。稼いだお金はまず貯金して、余裕ができたら治療費を返しに来てください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の露店商",
      "text": "はい、ありがとうございます、本当にありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "いえいえ、気にしないでください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急いでいる声",
      "text": "売店か？　水を二本くれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の露店商",
      "text": "かしこまりました。こちらがお水です！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不満の声",
      "text": "――ひっ！　おま、お前の手に、結晶が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の露店商",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不満の声",
      "text": "お、俺に近寄るな！　水はいらん、金もくれてやる！　やっとの思いで戦争を生き延びたんだ、病気をうつされちゃたまらん……まったく、縁起でもない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "あの、ご安心ください。政府も最近お知らせしていますが、一般の感染者と日常的に接触するだけでは感染しません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不満の声",
      "text": "フン、お知らせだ？　信じられるか。本当にもしうつされたら、誰に文句を言えばいいんだ？　どけ、俺に近寄るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "あと一つ、あと一つ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "あとは、あとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "（あの時のおばあさん？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "こんにちは。どうして一人で塀を壊しているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "おばあさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "あんた、ここらでは見かけない顔だね。でもその格好を見るに……政府の職員さんかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "ええ、資料室で働いているんです。こちらが職員証です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "見せておくれ……本当みたいだね！　あんたたちは最近、なにかと助けてくれるからね、安心して話せるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人は身をまっすぐにして、塀で囲まれた家を指さした。"
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "ここに住んでるハム爺さんはいい人なんだ。もう何十年もご近所だけど、揉め事なんて一度もなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "それなのに若造どもが、どこからか噂を聞いて、爺さんが鉱石病だかをうつすからって、家を塀で囲っちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "爺さんも爺さんで、人に迷惑をかけたくないからって、それを許しちまったんだがね。あたしは納得できないんだよ……感染して長いし、よく一緒に飯を食ってたけど、あたしにはうつってないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "さて、時間がないから話はこれで終わりだよ。息子が戻ってきたら壊すのを止められるだろうからね。自分たちまで差別されるだのなんだのって……まったく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "わたしも手伝います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "そりゃ……ありがたいよ、嬢ちゃん。あたしゃ目が悪くてね、名前はなんて言うんだい？　今度政府にお礼を言いに行かないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "いえいえ、名乗るほどの者ではありません。ただ、おばあさんを手伝いたい者だと思ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "……そうかい。じゃあ嬢ちゃん、急ごう。早く綺麗に壊して、ハム爺さんにまた胸を張って生きてもらおうじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな息子",
      "text": "母さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "ああ、ほら、もう帰ってきた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな息子",
      "text": "母さん！　言っただろ、この塀のことは放っておけって。ハムおじさん本人だって何も言ってないのに、何してるんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな息子",
      "text": "こんなことして、あいつらがうちに何かし出したら困るだろ？　もういい歳なんだから、やめてくれよ。さあ、帰るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "はあ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな息子",
      "text": "それからあんたも、年寄りが意地になってるのを見て止めもしないで、一緒になって塀を壊すなんて何を考えてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな息子",
      "text": "とっとと行ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記録係ケイト",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カゼマルはため息をつき、手にしたレンガを置くと、老人が息子に連れられて家に帰るのを見つめた。\n塀は未だそこに聳え立っていた。自分や先ほどの老婦人がどれだけ懸命に壊そうとしても、どれだけ時が経とうとも、ずっとそこにあり続けるかのように。\n彼女はふと、自分の肩が重く、だるいと感じた。\nこんな感覚は久しぶりだ。遠い昔、忍者として様々な肉体訓練を受けていた時でさえ、これほどの疲労を感じたことはなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "わたしたちはたくさんのことをしてきたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……どうしてこうも、変わらないんだろう。まるで、何もしてこなかったみたいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "カゼマル、今すぐ手を止めて事務所に戻れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "大勢の群衆が事務所の前に集まり、中にいる治療中の感染者を引き渡せと要求している！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "ひときわ興奮している男がいて、自分の娘が鉱石病の急性発作で死んだと繰り返し叫んでいるんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "――！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "中の感染者を全員出せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "どうか落ち着いてください。ここにあなたの娘さんを死なせた者などいません。彼らは皆さん、我々が身元を把握している患者です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "ただの患者なら感染者じゃないとでも言うのか？　そいつらが病気をうつさないとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "こいつらのせいで何人が死んだ？　何人が病気になって死んだ？なぜこいつらが何の責任も負わず、のうのうと生きていられるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "我々は製薬会社です。俺がここの責任者として、ここにいる感染者が病気をうつすことはないと保証します――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "いや、そんなことを言っても無駄だ。お前はわしの娘の死に、責任が取れるとでもいうのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "……取れるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "そうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "戦争が終わったばかりで、皆苦しい生活をしているんだ。それなのにどうして我々のような一般人を気にかける者は誰もいなくて、感染者だけを専門に世話する会社があるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "無料で治療して、仕事まで斡旋してやるだと？　じゃあ俺たちはなんだってんだ？　俺たち一般人が、あいつらにうつされても自業自得だとでも言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "病気の奴らは全員カレドンから出ていくべきよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "住民たちは口々にわめき立てたが、実際に手を出す者はおらず、ただ言葉で皆の感情を煽り立てるだけだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "（小声で）カゼマル、表に出るな。できるだけ裏から群衆を解散させろ……できるだけ、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "あ！　そこのあんた、誰と通信してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "何をする気だ、記者や警察を呼ぶつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する老人",
      "text": "わしらはただ、この病気の奴らに出て行ってもらって、これ以上感染を広げないでほしいだけだ。それの何が悪いって言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "皆さん、どうか落ち着いてください。最近政府もお知らせしていますが、一般的な感染者から鉱石病がうつることはありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "数年前のように恐れる必要はないんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "（大声）どうせ誰も私たち一般人なんて気にしてないのよ！　昨日だって、感染者に近づきたくなくて、「病気なんだから人混みをうろつかないでよ」って言っただけなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "（大声）簡単な話よ！　うつされるかどうかなんてわからないじゃない？　そしたら案の定、二、三言言っただけで、いきなり火の玉を出してきたのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "感染者はアーツを制御できなくなることがあります。それは故意ではなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "（大声）当たらなかったけど、死ぬほど怖かったわ！　なのに、病気の奴らは誰一人として私を慰めようとしないで、逆にその男の周りに集まって大丈夫かって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "（大声）私はただ離れてほしいって言っただけなのに、いきなり攻撃されたのよ！　私が殴られて当然だとでも言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……あの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カゼマルは何度か口を開こうとしたが、この場で何を言い、何をすべきか、全くわからなかった。\n何を言っても、何をしても、この群衆は聞き入れも、見向きもしないだろう。\n潜入、追跡、誘敵は、彼女にとって呼吸をするのと同じくらいに自然なことだったが、今、彼女はただ群衆の中で立ち尽くしていた。\n人々はなおも様子をうかがい、きっかけが訪れるのを待っていた。新たな突破口を開き、抑えつけられている感情を、完全に発散させるためのきっかけを。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "タン！　タン！　タンタンタン……！\n突然、群衆の中で奇妙な音が響いた。\n物心のつかない子供は、大人たちが何をしているのか理解することなく、ただボールで遊んでいた。だがうっかり手が滑り、ボールは道の真ん中へと転がっていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "あ、僕のボールが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "どいて、どいて、僕のボールがそっちに転がっていっちゃった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "子供はわめきながら群衆の中へと走っていった。\n騒がしかった群衆が一瞬、静まり返った。\nカゼマルはすぐに警戒態勢に移った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "困惑する声",
      "text": "……おい、あいつの袖の下を見ろ。あの黒いの、源石結晶じゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推測する声",
      "text": "みたいだな。あの子、見たことあるぞ。それに、あいつの母親が薬をもらいに連れてきてたのを見たような気もするぞ。黒い袋に入れてた。あんな風に薬を入れるのは感染者だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "どいてよ、どいてってば。こっちに転がってきたのを見たんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "困惑する声",
      "text": "……親はどこだ、なんでついて来ない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満の声",
      "text": "フン、親も感染者なんだろ。今頃隠れて、出てこられないんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "あれ、僕のボールは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "僕のボール、どこに行っちゃったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮気味な声",
      "text": "あ、あいつ、袖をまくったぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮気味な声",
      "text": "見ろ！　やっぱり感染者だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮気味な声",
      "text": "捕まえろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮気味な声",
      "text": "感染者は――カレドンから出ていけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（紙人形、行って――！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "ん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "どこから出てきやがった、目ぇついてんのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "不満そうな住人は感染者の子供に手を伸ばしたが、突然何者かが横からぶつかってきたせいで、その者の腕を掴んでしまった。そのまま住人は怒りにまかせて何かを引きちぎった。\n顔を上げると、その者の腕は明らかに一部が欠けていた。だが、手元に目を落とすと、握りしめていたのは――"
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "紙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "さっきのあいつ……紙だったのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "困惑する住民",
      "text": "紙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "どういうこと？　見てくる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "ねぇ、あなた、どこから湧いて出たの？　体についてるそれは何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "答えなさいよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紙人形",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（まずい、人が多すぎて間に合わない――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "どういうこと？　どいつもこいつも前を見ないなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る住民",
      "text": "……妙ね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（誰だろう。遠すぎてよく見えなかった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（足が速過ぎて、もう姿が見えなくなっちゃった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（隊長に報告しないと。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "いや、違うんですよ、おばあさん、とりあえず放してくれませんか？　やることがあるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "しつこく言う声",
      "text": "やれやれ、これはいかんよ。あんたたち、年寄りが寝る時間だというのに、まだ街で騒いでるじゃないか。なんて迷惑なんだい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しつこく言う声",
      "text": "ぐっすり寝て、明日は子供たちにご飯を作ってやろうと思ってたのに、あんたたちのせいで起きちまったじゃないか。そのうえ出てきて説教もしないといけないなんてね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満そうな住民",
      "text": "違うんです、俺たちは皆が安心して暮らせるように、こうしてるんですよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "しつこく言う声",
      "text": "なんだって――？　耳が遠いんだよ。もっとゆっくり喋って、ゆっくり歩いておくれ。転んじまうだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しつこく言う声",
      "text": "安心して暮らせるように？　あんたたちがこれ以上騒いだら、あたしが安心して暮らせないよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不満が解消された住民",
      "text": "ちょ、ばあさん、杖で叩くなよ！　ちょ、ちょっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "しつこく言う声",
      "text": "あんたのことは知ってるよ。さっき家を出る時に、あんたんちのおやじがあんたを探してたよ。早く帰らないと、お仕置きされるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒りが静まった住民",
      "text": "ええ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒りが静まった住民",
      "text": "ああ、もう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（ん？　どういうこと？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "隊長？　ちょうど連絡しようと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "一番声が大きかった連中が、急に静かになったようだ。中にはその場を離れた者もいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "どうやら誰かが先導していた者に目を突けたようです。でも警察ではなく、近隣の住民のようですが……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビタールート",
      "text": "……妙だが、群衆が解散するならそれでいい。引き続き監視し、何かあればすぐに連絡してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "はい、隊長。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（おかしい……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "おばあさん、お気を付けて。何かわたしにお手伝いできることはありますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし老人は答えず、すれ違いざまにカゼマルに軽く頷くと、まだ完全には解散していない群衆の中へと再び入っていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カゼマルが振り返ると、老人が手に持っていた杖を街角に置くのが見えた。よく見ると、それはただのモップの柄のようだった。\nそして、老人の姿は人混みの中に消えていった。\nカゼマルは老人の顔をはっきりと見ることはできなかったが、最後に白髪に編み込まれた、とても美しいリボンに気づいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "あれは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "お気づきにならなかったかもしれませんが、ついさっきまですぐ後ろにいたんですよ。鍋はわたしが運びますので、ゆっくりで大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "ありがとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "いえいえ、以前も感染者たちのために薬代を寄付してくださって、今日もこうして料理のお手伝いに来てくださったじゃないですか。これくらい、当然のことです。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "老人は微笑み、落ちてきた髪をかき上げ、リボンの中に押し込む。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "そのリボン、とても素敵ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しそうな老人",
      "text": "あら、本当かい？　嬉しいねえ。これは自分で作ったんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（あのリボンは……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "（わたしがこの前に助けたおばあさん……？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カゼマルは自分の服に触れた。この数日、彼女は何度も変装していた。変装先は世間知らずの学生に、政府で働くホワイトカラー、そして日常で最もよく見かける普通の住民など多岐にわたる。\nそのため、老人はカゼマルに気づかなかったようだ。おそらく、先ほどの努力する姿を見て、見知らぬ彼女に感謝を伝えたかっただけなのだろう。\nカゼマルは先ほど群衆の中で気になった顔に目を向けたが、彼らが誰なのかすぐにはわからなかった。\nだが、彼女は見知らぬ人々の善意と努力を確かに感じ取った。そしてふと、気持ちが晴れやかになっていることに気付いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "事務所に戻って、発見を報告書にまとめよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数日後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "「カレドンの近況報告は以上です。我々は確かに感染者を標的とした深刻な集会とデモを目撃しました。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "「しかし、警察と数名の市民の協力により、この騒乱は速やかに鎮められました。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "「また市議会も新たに発布された感染者法案を受理し、感染者と非感染者が平和的に共存できるよう、都市の再計画に取り組んでいます。」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "報告を終え、カゼマルは立ち止まって考えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "「多くの困難に直面しましたが、事態の悪化を防ぐため、我々以外にも同じように努力している人々がたくさんいます。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "「どうしようもないことは常に起こりますが、諦めずに努力を続けていけば、現状は必ず変わります。」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カゼマルはペンを置き、報告書を畳んでファイルに入れると、素早く記録係の服装に着替えて、ドアを開けて外に出た。\n彼女は久しぶりに、忍者であった頃の感覚を取り戻したような気がした。\nそして、今回は一人ではなかった。彼女の周りには、同じように名前と身分を隠しながらも物事が良い方向へ進むよう、陰ながら力を貸している「忍者」たちが大勢いるのだ。\n彼女は遠くの政府庁舎に目を向けた。カレドン市議会が、まもなく特別会議を開くことになっている。\n「けれど、我々がすべてを乗り越えるには、もう少し時間が必要です。」"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
