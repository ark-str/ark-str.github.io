{
  "server": "jp",
  "storyId": "story_franka_set_2_story_1",
  "groupId": "story_franka_set_2",
  "stageId": null,
  "title": "足休め",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_franka_2_1.txt",
  "sourceHash": "9dc3244425ec1a67b406b09e10e0acc073c7a344c73cd6254b9eb0b4eae63438",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "バニラ、こんなところで何してるの？　ここって……ジェシカの宿舎でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あっ、フランカ先輩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "はい、ジェシカ先輩の部屋を整理しているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……それもそうね。我らが勇敢なるお嬢様は開拓地へ行っちゃったもの。今後は本艦に滞在することも滅多にないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "はい、なので部屋にある荷物を整理して、先輩のところに送ることにしたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしも手伝おうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "エンジニア部から装置を借りてきているので私一人で十分ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "自動ドアに挟まれてた子が、今や立派に成長するなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "えへへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "フランカ先輩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "先輩はジェシカ先輩の選択が間違いだったと思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あの子に聞いて来いって言われたのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まったく、あんな決断を下しといて、今頃になって先輩の目を気にするなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ほんとに成長したのか怪しいものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……私はジェシカ先輩はすごいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "恵まれた環境を自分から捨てる勇気があるんですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ふふっ、そんなに慌てて肩を持とうとしなくていいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ジェシカはまだ直さなければいけないところがたくさんあるけど、あの子は自分のやるべきことを常に理解している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だからあの子なら大丈夫だって初めから分かっていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まあ……こんな早い段階で決断を下すことになるとは思ってなかったけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "早いん……ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ええ、あの子、まだ二十代前半でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まだ時間はたっぷりあったはずなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だけど、それも悪いことじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "決断を下せない人と比べれば、ジェシカはずっと優秀よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ごめんなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私も自分の将来についてはずっと考えてはいるんですけど、いつまでたっても答えが出なくて……だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "プッ……アハハ、あなたのことを言ってるんじゃないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だってあなたもまだ若いじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしが言っているのは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……誰のことかしらね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "では、トランスポーターさんに配達をお願いしてきますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "いってらっしゃい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "任務？　分かった、すぐ行くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一つの任務が終われば、暇つぶしに何か楽しいことでも見つけて、また次の任務を待つ。\nいつも通り。何も問題はないはず。\nそう考えながら部屋を出ようとした瞬間、ある声が彼女の歩みを止めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "分かってます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "はい、わたしの考えは変わっていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "自分の警備会社を持つこと……それは今も私の夢です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ミスターグリフがわたしと話をしたいと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "分かりました。明日、一度本部へ戻ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "普段なら何食わぬ顔で相棒の前に出ていき、目配せしていたことだろう。\n機嫌がいい時だったら、面白おかしなイタズラまでしていたかもしれない。\nしかし今日は――"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "彼女もわたしの考えを知っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……分かりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "この件について彼女と話し合います。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……あたしったら、何から逃げてるのかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ちょうどいいところに来た。わたし、一度本部に戻らないといけないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あら？　何かあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "前にも言ったと思うけど、ミスタークリフと話をしに行こうと思ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ようやく決心したのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん、ジェシカの勇気にあてられちゃったのかな……わたしも、もう少し勇敢にならないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "勇敢と無謀は違うわよ。あなた、あの「クリップ」クリフと向き合う覚悟が本当にできているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "一人じゃ対処しきれないなら、あたしも一緒に付いていってあげられるけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……大丈夫、こういうことにも慣れなきゃいけないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなたのその素直な性格じゃ、陰湿ジジイに会話の主導権を完全に握られちゃうわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカ、今日機嫌悪いんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それ、今の会話と何か関係でもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "毎日あなたの相手をしているうちに、わたしも少しは人を見る目が鍛えられたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あら、我らが優等生サマまで立派になっちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "戻ってきたら少し話がしたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "真面目な話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "大体一ヶ月くらいで戻ると思うから。じゃあね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そうね、確かに今のあたしは機嫌が悪いみたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "状況は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "事前に得ていた情報とおんなじ。盗賊たちが輸送ステーションの従業員を人質にして、そこを占拠してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "人数はそこそこいるし、装備も充実してる。でも警戒態勢はそこまで厳重じゃないみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "建物の構造とあいつらの人員配置はもう調べてあるから、今そっちの端末に送っといたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "届いたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "いやぁ、キミとリスカムちゃんみたいなエリートを製薬会社に派遣するなんて、ずいぶんもったいないことするなあってずっと思ってたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "でもやっとそうした理由が分かった気がする。結局やってることはそんなに変わってなかったってことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "後方支援部か人事部に申請を出せば、ここでしんどい目にあう必要もなくなるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "それは無理だよ。だって外勤オペレーターはBSWのエンジニアよりもずっと好待遇だもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "それに、前からこういうタイプの仕事って体験してみたかったんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "前線は遊びで来るような場所じゃないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "だからわざわざ二人の先輩と一緒の任務を申請したじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "優秀な先輩からは学ぶところも多いだろうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "戦場で使う知識を学んだっていいことなんてないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなたは一生戦場で過ごすわけじゃないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "あたしちゃんからすれば全部一緒、お金になる知識だけどね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "稼げる時にいっぱい稼いだら、自分のやりたいことを思う存分できるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "やりたいことって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "へへ、実はまだ決めてないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "でも、いつか思いつくはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "フフッ、若いっていいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "キミだって大して変わんないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "BSWでもロドスでも、あたしのほうが先輩よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "はいはい先輩、肩でもお揉みしましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "結構です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "よし、作戦の組み立てが終わったわ。今から共有するわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "えっ、もう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "うわっ、しかもめちゃくちゃ細かいし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "先輩の実力を見くびるなってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "見くびったことなんてありませんけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "二チームに別れて、Aチームが正面から敵を足止めして、その隙にBチームが人質を救出する、なるほどなるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "でもAチームの人数、少なすぎじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "事前情報によれば、敵のリーダーはかなり警戒心が強いらしいわ。大人数で攻め込んでは逃げられてしまう可能性が高いの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "山に逃げ込まれたら面倒なことになるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "だけど、この人数はいくらなんでも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなた、誰かさんからこんなこと言われたでしょ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "「リスカムがいない間は、フランカの行動をよく見張るように。絶対に早まったことはさせるな」って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "うっ……言っとくけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "リスカムに言われたわけじゃないのは知ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だって優等生サマは、あたしに直接言ってくるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "でもそうね、あたしたちはコンビでいる時間が少し長すぎたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ロドスから任務を任せられる時だって、いつも一緒に組まされるくらいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "それっていいことじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "本当にそう思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "うん――だって頼りになる相棒がそばにいたら安心するじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "戦場に刺激を求めて危なっかしい行動を度々取るフランカちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "そして、そんな彼女を守るために、様々な方法でブレーキをかけようとするリスカムちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "普段の二人はいつも口ゲンカばかりなのに、戦闘時は常に息ピッタリで、いつも完璧に任務をこなしてくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "BSWにいた頃から、キミたち二人のコンビの噂はさんざん聞かされていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしもリスカムも、気付いたらそんな関係にすっかり慣れちゃったのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言って彼女はため息をついた。\nBSWへ加入する際、ほとんどの者は制式の武器を一つ選ぶことになる。\nフランカは護身用に制式のスティレットを選んだものの、メインの武器は今まで通りレイピアを使い続けた。\nそうしているうちに、彼女は周りからレイピアしか扱えないものだと思い込まれた。\n実際の彼女は、スティレットの扱いもとても長けているのにも関わらず。\nそして今や、彼女自身すらそのことを忘れかけていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "行くよ、さっさと片付けちゃいましょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "フランカちゃんが相手を正面から食い止めてくれたおかげで、あたしちゃんたちはスムーズに人質を救出できたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "だけど振り向いたら、フランカちゃんが敵に行く手を塞がれてたのが目に飛び込んできたの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "そんな！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "あの時は口から心臓飛び出るかと思ったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "敵が持ってる装備は大したことなかったけど、数は向こうが圧倒的に多かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "それに相手もフランカちゃんに弄ばれてたことにはとっくに気づいてたから、ものすごく恨みを募らせてたしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "なのにフランカちゃんってば、のんきにその場に突っ立ってただけでさあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "ああ、もうおしまいだ、リスカムちゃんがこの場にいないのをいいことに、思いっきり羽目を外そうって魂胆なんだって思った時……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "なんと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "なんと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "ふふ～ん、これは特ダネだよ。続きを聞きたいのなら、それ相応の代価を支払ってもらわなきゃ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アーモンドは金銭を意味するジェスチャーを指で作りながら、ニヤニヤとあくどい笑みを浮かべた。"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……し、仕方ありませんね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "いてっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "他人を話のネタにして金儲けなんてよくないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "あたしちゃんは貴重なネタを合理的に運用してるだけだし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "って、リスカムちゃん、帰ってきたんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカの話をしてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "そうそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしにも聞かせてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "はいはい、今日は特別に出血大サービスといきますかね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "うっ……なんだか罪悪感が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "とにかく……コホン、まさにその瞬間！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "フランカちゃんは戦場のど真ん中に立っていて、人質を安全な場所に移動し終えたばかりのあたしちゃんはタワービルの上にいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "ステップごとの行動時間は厳格に決めてたわけじゃないから、フランカちゃんはあたしちゃんのいる位置を把握してなかったはずなんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "なのにあの時、フランカちゃんは確かにあたしちゃんに向かって視線を投げてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "その視線が誘導する先を見ると、そこには今にも崩れ落ちそうな建物があったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "しかも、その建物はちょうど盗賊のすぐそばにあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "その瞬間に全部分かったんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "フランカちゃんは考えなしにただ敵の前に飛び出ていったわけじゃない。わざとあの位置まで敵を誘い込んだんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "しかも、あたしちゃんがタワービルに来るタイミングまで予期してたの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカにそんな超能力はないよ。ただあなたや他の隊員が来る時間を大体予想してただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "じゃあ、もしあたしちゃんたちにトラブルが発生して、そこに行けなかったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "たぶんそっちに合流するか、もしくは用意していた予備プランを実行してたと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしだったら、その崩れかけの建物にあらかじめ爆薬を仕掛けておくかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "あっ、確かに作戦開始前にフランカちゃんから爆薬がほしいって言われたわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "今回の任務のフランカちゃんは、なんかいつもと違うふうに感じたんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "落ち着きがあって、頼もしくて……いや、普段のフランカちゃんも頼りがいがあるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカはどこにいるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "任務から戻ったあと、ずっと部屋にこもっているみたいです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーモンド",
      "text": "そうなんだよ～、勝利を祝ってパァッと打ち上げでもしようと思ってたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……様子見てくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "おしゃべりのアーモンドのことだから、きっと今頃あちこちに言いふらしていることでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はあ……もう好きにすればいいわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "机の上には、母からのあの手紙が今も綺麗な状態で置かれていた。\nフランカは定期的に母に仕送りをし、母からの質問にはどれも丁寧に答えていた。彼女は母をとても愛しているのだ。\nだけど二つだけ、ずっと避け続けていた質問があった――\n傭兵なんて危険な仕事、いつまで続けるつもりなの？\nいつ家に帰ってくるの？\nその二つは、実際には同じ意味だ。\n言葉を変えて何度もそう尋ねてきたのは愛ゆえの行動だと、彼女は信じている。しかしフランカにとって、その二つの問いかけには誰にも想像しえない重みを含んでいるのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女はクロワッサンのところから物色してきた中古のレコードプレイヤーのスイッチを入れると、柔らかなベッドに倒れ込んだ。\nまるで自分のことを知る者が一人もいない奈落の底へ飛び込むかのように。\n覚悟はできているつもりだった。\n自分は今この瞬間の一分一秒を楽しめているのだと思っていた。\nしかし、ジェシカが開拓地へ行くことを決めた時、リスカムが自分の警備会社を設立すると決めた時、自分の胸に広がったのは喪失感だった。\nそれは未来への戸惑いからくるものではない。彼女は自分の進むべき先を見失ったわけではなかった。\nそれは――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "規則正しい丁寧なノック音。誰なのかすぐに分かった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしが部屋にいるのは分かっているわけだし、きっとスペアキーの隠し場所を探すはずよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そう、ドアのそばに置いてある鉢植えの下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そして、なんのためらいもなくドアを開けるの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はあ……やっぱり今度からカギの隠し場所を変えようかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "らしくないね、フランカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "どうしていればあたしらしいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……少なくとも今のような姿じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "優等生サマ、今から時間あるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "時間がなかったらそもそも来てないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしたち、もうずいぶん長いこと手合わせしてないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "つまり、自分の理想を馬鹿正直に全部話したってことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それ以外のやり方なんて知らないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まあ、無理して上辺だけの話をするよりも、確かにこのやり方のほうがあなたに合っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "で、結果はどうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "良くはなかったよ。ミスタークリフはわたしの選択を好ましく思ってはいないみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "だけど、辺地にビジネスパートナーが一人増える程度なら別に構わないとも言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もっともらしい言い方ね――警備会社の間には本当の意味での協力関係なんて存在しない。一度BSWを抜ければ、あなたはもう赤の他人なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それは分かってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人は話しながら、それぞれ訓練場の両端へと向かう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ローラから話は聞いたんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どうしていきなり手合わせをしたいなんて言い出したのか、なんとなく分かった気がする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "今日はそっちが満足するまで付き合ってあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "優等生サマ、あなた最近ちょっと調子に乗りすぎじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わざと言ってるの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "剣と盾がぶつかり合い、激しい音が訓練室に響き渡る。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そういえば、訓練生時代からずっと連絡を取り続けてる友達にも何人か会ってきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしについて来るって言ってくれた人もかなりいた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "なかなか戻って来ないと思ってたら、「同窓会」を開いてたわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そんな大袈裟なものじゃないよ。軽く集まっただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "みんな、あなたの話をしてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしの話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いつもわたしのこと「優等生サマ」だって呼ぶけど、毎回トップの成績を取っていたのはあなたのほうでしょ。同期たちにとって一番優秀なのはあなたのほうなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "戦場に立つ人にとって「優等生」なんて、なんの誉め言葉にもならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それにあたしは、最初のひと目からあなたのことが気に食わなかったの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "知ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "初めて模擬訓練で手合わせした時のこと、まだ覚えてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "その時のあたし、なんて言ったんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "「優等生サマは、実戦においても優等生かどうか見させてもらおうかしら」って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなたはその日から、わたしのことを「優等生サマ」って呼ぶようになったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "今までずっと根に持ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そのあだ名、今からやめてもらっても遅くないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "お断りね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人は互いの戦い方を熟知しており、しばらくの間、武器がぶつかり合う音が部屋中に響き渡った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなたのような野心もなければ武器商人でもないような人が傭兵をやるだなんて、どう考えてもおかしいでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "今でもそう思ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "刺激を求めて傭兵になっただなんて、上辺だけの理由を並べてる人にとやかく言われたくないね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ますます口が達者になってきたじゃない、優等生サマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いいお手本がいるおかげでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "さっき部屋に入った時、机の上にあの手紙が置いてあったのを見たけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もう何年も帰ってないよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "会っても何を話せばいいか分からないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "お母さんとの仲は悪くなかった印象だけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "悪くないどころか、あたしは母を愛しているし、母もあたしのことを愛してるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしのやりたことはなんでも応援してくれて、やりたくないことを強制したことは一回もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしがこんな性格をしてるのも、きっと母に甘やかされて育てられたせいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そうみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "だけど性格の話をするなら、わたしと似たようなタイプの傭兵はかなり多いけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなたみたいに、戦いの中に面白さを見出し、危険を回避することよりも楽しむタイプはかなり少ないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしもそのことを理解するのにずいぶん時間がかかったけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなたは何も心配することがないからこそ、そんなふうに振り切れたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そうよ。あーあ、あたしの子供の頃の写真を見せてあげたいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "自慢じゃないけど、当時のあたしより「裕福な家のお嬢様」っぽい女の子なんていなかったからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いや、別にいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "チェッ、仮に見たかったとしても写真なんて残ってるかどうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "いや、実家に帰れば見つかるかもしれないわね。きっと母が取っておいてくれてるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はあ……今この瞬間が楽しければ楽しいほど、帰るのが怖くなる。こんなことになるくらいなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そもそも家なんて出なければよかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "母のそばにいて、小さなお店でも開いて、慎ましく暮らしていける分のお金さえ稼げれば十分だったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だけどあたしは……どうしても憧れを抑えきれなかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フランカは手に持った剣を指さすと、振り返って決して狭くはない訓練場内を見渡した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "フリーの傭兵をやってた頃から、母はいつもあたしのことを心配してた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そしてBSWの訓練所へ出発する日、車に乗り込むあたしを母は笑顔で見送ってくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だけど、車が走り去ったら母はきっと泣くんだろうって、あたしにはちゃんと分かってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "お母さんに会うと、離れられなくなってしまうんじゃないか怖かったから、ずっと家に帰らなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "自分でも抑えきれずに、母を責めてしまうのが怖いの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしたちは、互いのことを本当に愛しているのに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……ただ単純に機嫌が悪いのだと思っていたけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そうじゃなくて、どうやら完全に参ってるみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "これだけ長い付き合いなのに、こんなに長々と話しているところなんて初めて見たよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そうだよ。だっていつも小言をこぼすあなたを、あたしがからかうのがお決まりだったから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなた、まさか鉱石病が進行したわけじゃ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "安心して、病気のほうは大したことないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "治ることはないけど、これ以上悪くもなってない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "シャワーを浴びてる時に、結晶が手に当たる感触にも少し慣れてきたしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もしかしたら、あたしおかしくなっちゃったのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしね、別に大層な理想なんて持たなくてもいいんじゃないかって思ってるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "戦いを通して自分が着実に成長していることを感じられたり、周りの人をからかってちょっとした楽しさを感じられれば、それだけで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それだけで、あたしは十分なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "BSWでもロドスでも、楽しい時間が大部分を占めていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "このままずっとこうしていられるのだと思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ジェシカやあなたが自分の決断を下す時まではね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "その時になってようやく、このままじゃいられないんだって気付いたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしは思わず自分自身に向かってこう問いかけていたわ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "「それなら、あたしはどこへ向かうべきなの？」って。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカはどんなことだって、いつもそつなくこなせられる、みんなの憧れなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたし含めてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……えっ、あなたが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "初めての任務でいきなりあたしを引き留めたくせに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それはあなたの戦い方を危険すぎると判断しただけであって、今の話とはまったく関係ないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どうしてあなたとコンビになったのかずっと疑問だったけど、最近になってようやく少しずつ分かってきたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなたが何を考えていたかなんて関係ない。とにかく、わたしは知りたかったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしとは正反対のあなたのような人にとって、人生はどのように目に映っているのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それか、あなたからたくさんのことを学べるんだって、直感が告げていたのかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "今まであたしから何か学べたとは思えないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "たくさんあるよ。戦闘技術に会話テクニック、それと……ポジティブな考え方とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もちろん、あなたから学んだというよりかは、あなたについていくために自分で身に着けたものだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ローラと一緒に担当したあの時の任務みたいに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなたはフランカなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "誰かが支えなければいけないように見えても、あなたが本当に必要としているのはそんなものじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなたに必要なのは、背中を教えてくれる誰か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "これって一種に決別宣言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしはただ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そんなにわたしを気にする必要はないってことを伝えたいだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "突然気付いたけど、あたしを怒らせるスキルは一丁前に上達してきてるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いいお手本がいるおかげでね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "テルミットレイピアが手から弾かれ、刃が空中で危なっかしく弧を描きながら飛んでいく。一方、ヴィーヴルのほうも耐え切れず持っていた盾を地面に落とした。\nいつも通りの結果、引き分けだ。\nだが今回、いつものようにリスカムをからかいながら、武器を拾いに行くフランカの姿はなかった。\n彼女は何かを考えこんでいるのか、ただ呆然とその場に立ち尽くしている。\nリスカムもそんな彼女を待つかのように、一歩も動かなかった。\nそうして長い沈黙の末に、ようやくフランカが口を開いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "戻ったら話があるって言ってたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それってもしかして、あたしをあなたが立ち上げる警備会社にスカウトするって話だったりして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたし、行かないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "今のところはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "分かった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リスカムはレイピアを、フランカは盾を拾い上、お互いに投げ渡してやった。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしの病状は、もうほとんど安定してきてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だから長期休暇を申請して、一旦実家に帰るわ。母と向き合うためにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もしかしたら考えがまとまらなくて、色々言葉をぶつけてしまうかもしれないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そのあとは……ちょっと遠出しようかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "長期の外勤任務かなんかを受けて、少し遠い場所へ行くの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしが戻ってくる頃には、あなたの新しい会社がもう完成しているかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "その時は遊びに来ていいよ。ちゃんと接待してあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "喜ぶにはまだ早いわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなた、勝手にあたしを追いかけてロドスまで来たんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もしかしたらいつか、あたしがロドスにいられなくなったら、その時はそっちの会社に図々しく居座らせてもらうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしが私情よりも規則を取る人だってことは、あなただって知ってると思うけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そうなったら、あなたの会社のビルの目の前で野宿しながら、あなたの恥ずかしいあんなことやこんなことの書いてある看板でも立てちゃおうかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……はあ、なんでこんな人が知り合いなんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "確かにあたしみたいな人と知り合いだなんて、ほんと同情するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ところで、お昼は何食べる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どっちのおごり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もちろんそっち――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はいはい、今日はあたしのおごりよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
