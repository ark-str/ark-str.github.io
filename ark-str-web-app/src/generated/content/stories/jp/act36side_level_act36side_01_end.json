{
  "server": "jp",
  "storyId": "act36side_level_act36side_01_end",
  "groupId": "act36side",
  "stageId": "act36side_01",
  "title": "オリジムシの田舎風",
  "storyCode": "DT-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act36side/level_act36side_01_end.txt",
  "sourceHash": "7b38fef6f5142407dbe9393fc85cd5b8fb171b6f527feacb1adf6c1c57aff551",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "だが、思うに何かがおかしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "こんな所に逃げ込んじゃって、逆に退路失ってない！？　あいつが追いかけてきたらどうしよう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ねえ、どうするの！？　私の魔術だけじゃ、限界あるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "あの虫たちは殻の違いで習性や攻撃性も異なるようだった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "それにしても、なぜあのオークに似たたくましい生物と行動を共にしているんだ？　まさか、飼い慣らせるくらいの知能があるとか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "シッ――静かに！　さっきのオークが来たぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "（小声）ち、近付いてきてる……！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "（小声）あっ、虫を攻撃してる……！？　あいつのペットってわけじゃないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "（小声）それとも、目の前の生き物を無差別に攻撃してるだけ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……待て、俺に考えがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ライオス、何するつもり！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……えっと、どうも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "えっ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "得体の知れないオーク？",
      "text": "……ああ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "もう無理！　こうなったらやるしかないでしょ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "マルシル！　待たんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ファリンのためにも、こんな得体の知れない場所で殺されてたまるもんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "得体の知れないオーク？",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "得体の知れないオーク？",
      "text": "何のことだ？　殺すなんて……そんなことするはずないだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "得体の知れないオーク？",
      "text": "……私はそこまで恐ろしげに見えたのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……！　いくよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "得体の知れないオーク？",
      "text": "おっと、気を付けてくれ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "得体の知れないオーク",
      "text": "これで片付いたな。まったく、ちょこまかと逃げ回られて本当に大変だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "思った通りだ！　君はやはり、無差別に人を襲う狂暴なオークなんかじゃなく……ただこの虫を大人しくさせたいだけだったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狂暴ではないオーク",
      "text": "……へ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狂暴ではないオーク",
      "text": "ははは、この辺りに来るのが初めてなら、そうなるのも不思議ではないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狂暴ではないオーク",
      "text": "ここは小さくはあるが、私の農場なんだ。あの小屋は仲間と一緒に建てたもので、オリジムシの管理のためにかなり手間をかけているんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ああそうだ、私のことはビッグ・ボブと呼んでくれ。君たちは……どうやら、どこかからの流れ者のようだが、荒野で過ごすのは容易ではないし、ここで休んでいくといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "な、流れ者……。一応私たち冒険者で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……それは流れ者とは違うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ち、違うよ！　……多分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "なるほど、あの生物は「オリジムシ」というのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "おいおい、冗談だろう？　まるで初めてオリジムシの名を聞いたような口ぶりじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "おっと、そういえば自己紹介がまだだったか？　俺はライオス。それでこっちはセンシ。少し前に知り合った仲間だ。そっちにいるのが、魔法使いのマルシルに、鍵師のチルチャックだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "変わった服装をしているが、流れ者ではないというのなら、君たちはランクウッドの役者か何かなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "何だそれは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……いや、忘れてくれ。君たちは私が何を聞いているのかすらよくわかっていないようだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "しかし、あんな真似をするとはな。あれだけ多くのオリジムシを見たら大抵の人は逃げ出すだろうに、わざわざ近付いてきたりして。あいつらは君たちを侵入者と見なして攻撃していたようだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "そうか……この農場は、オリジムシを飼育するためのものだったんだな！　君は本当に大したものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "なに、どうということはないさ。この辺りにはあの小さいのがわんさかいるし、連中を相手取るよりも、なんとか育ててみるほうがマシというものだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "今はちょうどあいつらの活動時期だから、私もこの小屋に泊まり込みに来ていたんだ。とはいえ、まさか君たちが先にあいつらを叩き起こして、あちこちに散らしてくれるとは思わなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "仕方がないから、一匹ずつ気絶させて連れ帰ってきたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "あっ、ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ははっ、別に構わんさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "農場で飼っているということは……つまり、あのオリジムシたちは食用だったりするのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……ん！？　何言ってるの？　さっきあれに襲われたこと、もう忘れたわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "それに、今は食べ物のこと考えてる場合じゃないでしょ！　私たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ああ、確かに、オリジムシは食用にもなるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス&センシ",
      "text": "本当か！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "あんなヤバそうな見た目してるのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "この辺りでは一般的な食材なのか？　どういう味なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "いや、味というよりは……ううん、上手く言い表せないな。このオリジムシを使った料理を振舞ってあげるから、とりあえず食べてみるといい。そうすればわかるだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ならば、わしも手伝おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ええ……っ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "食べるの！？　この虫を！？　やだーっ！　無理無理、絶対無理！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "鍋は洗っておいたぞ、ビッグ・ボブ。この虫をいかにして調理するのか、まずは見せてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "よし！　では前提として、捕まえたばかりのオリジムシをそのまま食べることはできない。ひっくり返して水に入れ、五日間絶食させて胃を空にする必要があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "おいおい、それじゃ続きは五日後に、なんて言わないよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "そんなに待たせると君たちが餓死してしまうし、その工程を終えたものを持ってきた。調理時は必ず手袋を着用した上でオリジムシを水で軽く煮ていこう。すると身が縮んで殻がむきやすくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……煮ないで剥いちゃダメなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ああ。これは内部の粘液をきれいにするためにやっているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "あまり長時間煮る必要はないし、ある程度火が通ったら取り出す。そうしたら殻をむき、不純物を洗い流すんだ。この粘液が見えるかい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "うっ……なんかスライムみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "スライム？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "え？　知らないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "スライムならどんな迷宮にもいると思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "さて、オリジムシの身を取り出したら、殻は湯に戻して加熱しておくといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "待って、話を流さないで……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "身のほうは、まだ粘液がたくさんついているから……塩を加えて強く揉み洗いし、粘液をすべて洗い流す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "内臓を取り……外膜をむいて……繰り返し五回もみ洗いする。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "内蔵と外膜は食べられないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "明日の太陽を拝みたくないのなら、食べてみても構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "おい、食べて本当に大丈夫なものなのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "ここまで丁寧な下処理が必要になるとはな……わしの知る食材の中でも、これほど念入りに何度も洗浄せねばならんものは多くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……何せオリジムシだからな。普通の生物よりも危険度は高いし、この工程を省くことはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "私の農場で養殖した、生活環境が管理されているオリジムシでも、丁寧に洗浄する必要があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "この先、野生のオリジムシに出会った時は、絶対に食べるんじゃないぞ。あれは何十回洗っても食べられないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "すっごく重要なのはわかったけど、これっていつまでかかるの？　そろそろ私たち……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "手を抜いてはいかん。こうした食材を扱う時は、十分注意を払わねばならんのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "この処理が終わり次第、今度は香草、つまりそこのトゲのある植物の枝と葉を鍋に入れ、こちらも沸騰させる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "また煮るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "そう焦るな、耳の長いお嬢ちゃん！　これも加えることでようやくオリジムシの泥臭さが取れ、身が柔らかくなるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "泥臭くても気にしないというのなら、香草を省略しても構わんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "だったら入れて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "わかった。ついでに、今回はトウガラシをうんと加えてみよう。食べたら火を噴きそうになるくらいにな。では次に――薪を加え、強火に変える！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "あとは特別なことはない。調味料をいくつか、香りが出るまで炒めたら、切ったオリジムシの肉を加え強火で炒める。端が丸まったら頃合いだ。あまり炒めすぎて身が硬くならないようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "いいな、端が丸まったらだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ん？　おっと忘れていた、オリジムシビールをひと回ししたほうがよかったんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "いいよもう、これでいいから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "やっと完成だね！　そしたらちゃちゃっと食べちゃおう！　さっさと食べてさっさと出発！　これ以上手間をかけなくていいから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……まあそれならいいか、大した問題ではないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ではこれで、ピリ辛オリジムシ炒めの完成だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ところで、君は何を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "わしも試してみようと思ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "この殻は洗浄し終えたのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "何する気だろ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "さあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "洗った虫の肉を殻の中へと戻す。ニンニクをみじん切りにし、少量のバターと、胡椒、塩を混ぜ合わせる……その後、今度は忘れずオリジムシビールをひと回しして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "殻の内側に、みじん切りしたニンニクをひとつまみ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "そちらを上にして火にかけ、しばらく焼く……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火がオリジムシの殻をあぶり、小麦の香りをくゆらせる。\n油がじゅうじゅうと音を立て、アツアツのにんにくの匂いが漂ってきた。\nそれから、とても小さく、喜びを表す音が鳴り響く――\n――パキッ！"
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "完成じゃ！　よし、火からおろしてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ついでにホットケーキも焼き上がったぞ！　食べるとしよう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "美味い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "オリジムシの肉をパンに乗せ、トウガラシと一緒に食べつつビールを流し込むんだ。さあ、お試しあれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "このホットケーキもぜひ食べてみてくれ！　羽獣の卵を加えてコクを出しているから、きっとおいしいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "上に乗っているカラフルなものはキャンディか？　甘くて効いているな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "わ、私にもちょうだい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "これ、何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "オリジムシの触角だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "うわっ！　美味しい！　すごい歯ごたえ……でも辛いっ！　センシの料理とは全然違うけど……これも美味しいね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "うん……ビールを加えて焼いたオリジムシは生臭さが消えてる。でもピリ辛のほうはまだちょっと泥臭いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "やはり、手間を惜しまず作った料理は味も良くなる。焦りというのは悪い結果を招くものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "些細に見える工程にも丁寧に取り組んでこそ得られる成果、これぞ料理の魅力じゃ。マルシル、お前の焦りがわしにそれを気付かせてくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "そんなつもりじゃなかったんだけど……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "私だって時間に追い立てられるのは好きじゃないよ！　ただ、あなたたちに焦りがなさすぎて不安になってるだけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "みんな悠長にしすぎっていうか、本気で早く帰ろうとしてるようには見えないっていうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "このビールも美味いな！　麦の香りが独特で、これまでに飲んだどのビールとも違ってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "そう言ってもらえると安心するよ。このオリジムシビールはブランドとして打ち出して販売する予定でな。今年はかなり造ったから、大きな稼ぎになりそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "そういや、オリジムシビールって……さっきの虫を使って作ってるのか？　一体どうやって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "やり方は色々とあるが……生まれた時から清潔な麦の殻を積んだ場所で育てると、それがくっついて、そのうちオリジムシの背中に麦の香りのする殻が生えてくるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "生えてきたその殻をホップと合わせて醸造すれば、こういうビールが出来上がる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "だが、聞いた話によると、ほかの場所では別のやり方をしているらしい。オリジムシにホップを食べさせて、その粘液を使って酒を造るんだとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "それはそれでまた違う風味になるんだろうが――何と言っても私は自分で造ったビールの味が好きなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "先ほど君たちに食べてもらったホットケーキも、ビールの時と同じような工程を経ていてね。キラキラした小さなオリジムシに果物を食べさせると、その殻が甘くなるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "うーん……げっぷ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "君たちにお墨付きももらったことだし、安心してビールを売り出せそうだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "本当にどれも美味かったな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……実は、彼女が焦っているのも理由があって。俺たちは別の場所からここへ迷い込んだ可能性が高いんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "なるほど、さっぱりわからん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "はぁ……仕方ない、どこかほかの場所で聞いてみるか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "まあしかし、故郷が恋しくなるのは人間の常というものだ！　ほかの部分は何のことやら理解が及ばなかったが、そこだけは私にもわかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "とはいえ、何も知らない君たちに、右も左もわからないまま旅をさせるのは良くないだろうし……これをあげよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ビッグ・ボブは先ほど下処理をしたオリジムシの肉とビールをさっと包むと、小冊子を添えてライオスに手渡してきた。\nライオスは冊子を開いてみたものの、そこにはくねくねしたよくわからない文字が書かれている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "……これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "『ボブのグルメガイド』さ！　これまでに私が見てきたものについては、食べられるかどうかをすべてこのノートに記録しておいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "持っていって、何か新しいものを見た時はこれの記載に従うようにするといい。道中で飢え死にしたり、毒のあるものを食べたりしないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……完全にライオスが好きなやつだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "今どんな顔してるか、見なくたってわかるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "そういえば、君たちの故郷を探すにあたって力になってくれそうな人たちに心当たりがあるぞ。そこにはかなり大勢のへん……変わり者がいてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "彼らは、あの恐ろしい赤い目の女も相手取れるような人たちだし、君たちの問題もきっと解決できるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "ほんとに？　それって何ていうところなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ロドス・アイランドだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "彼らの事務所は各地の辺ぴな片田舎にまで置かれているし、見つけるのはそう難しくないはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "ロドス・アイランドだな。メモしておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "センシ",
      "text": "（小声）……妙な名だな。島なのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チルチャック",
      "text": "（小声）海を渡らなきゃなんねーってことか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "無事にロドスにたどり着けたら、マドロックという奴によろしく伝えておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライオス",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "では、君たちが無事ロドスを見つけられるよう願っているよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルシル",
      "text": "……ありがとう、大男さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "本当に愉快な連中だったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "彼らが早いところ、例の……迷宮？　を見つけられるといいが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "さあて、仕事だ仕事！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……おや？　まだ料理が残っていると思ったんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "結局全部食べていったのか？　うーむ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……けぷっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "オリジムシって煮込むと美味しいんだねー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
