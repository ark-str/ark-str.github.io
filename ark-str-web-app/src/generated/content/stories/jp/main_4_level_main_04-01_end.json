  "blocks": [
    {
      "type": "narration",
      "text": "第三十一（后）\np.m.6:03 / 曇天 / 視界：19km\n龍門外縁部付近の荒野 / 第十四号施設"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……目標地点に到着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "今のところ、異常なしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……これで報告はおしまい、と……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "フロストリーフ？　さっきから難しい顔をしてるけど……どうかしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "いいや。単に、アーミヤたちの状況が少し気になっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あの子たちなら、無事にロドスへ戻ったって聞いてるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "だけど、ニアールとドーベルマンのほうは、一週間前に、龍門以外のエリアへ向かったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "わざわざあの二人を送り出すなんて、よほど大変な任務なんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "BSWとペンギン急便にも、それぞれ仕事があるみたいだし、頼ってばかりもいられないのが困りものだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "BSW……あっ、リスカム先輩とフランカ先輩のことですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "お二人なら、大丈夫だとは思いますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "そうね。とはいえ、あなたも頑張りどころよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あなたを預けていった時、そのフランカが言ってたんだもの。あなたのことを高く買ってる、ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ？　ほ……本当ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ええ――ただし、臆病なところを克服すれば、とも言ってたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "う、ぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……ちょっと、急に泣き出さないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あなただって、BSWの一員でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "な、泣いてません……泣いてません、から……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……いいわ。とにかく、任務を続行しましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "次は、各地点の偵察隊と合流して、廃都市内の調査を行うわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "これは主に生存者の捜索と救助活動、それから状況確認を目的とした任務ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "特別危険な仕事というわけではないけれど、注意は怠らないようにしてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "もし、感染者関係の問題を確認した場合には、迅速に対処していきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "でも、万一それがレユニオン関係の問題だった場合には、ケルシー先生に報告した上ですぐに撤退すること。わかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "は、はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "よろしい。……それじゃ、早速仕事にかかりましょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m.6:12 / 曇天 / 視界：19km\nロドス本艦\n廃都市内での「第十四号施設」発見から翌日"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あっ、ドクター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "Dr.{@nickname}、ちょうどよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "実はあたしたち、ここでの仕事は大体終わったし、そろそろ退散しようかな～って。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "帰るのか？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……わかった。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "寂しくなるな。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "リスカム",
          "text": "また近いうちに戻ってきますから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "そうそう。ちょっとBSWに顔を出して、状況報告を済ませたら、すぐに帰ってくるわよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "だから、あたしがいなくても、あんまり寂しがらないでね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エクシア",
          "text": "なるほどね～。あ～、残念だけど、あたしたちが帰るのには、そういうまともな理由はなくてさ。だよね、テキサス？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "余計なことを言うな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エクシア",
          "text": "だって、ペンギン急便は休暇をもらっただけだもん！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エクシア",
          "text": "たったの一日だけど、それでも――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "……すまない。こんな時に言うべきことではないというのに。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いえ……お休みも必要ですからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "……それは、本来私のほうから伝えるべき言葉なんだがな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エクシア",
          "text": "テキサスの言う通り！　アーミヤだって、ちゃんと休まなきゃね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが、ロドスにはまだ対処すべきことがたくさん残っていますし……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "リスカム",
          "text": "アーミヤさん。仰ることは理解できますが、あまり背負い込みすぎるのも良くないかと。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "どんなに強い信念があっても、ずっと頑張り続けていると、そのうち身体を壊しちゃうわよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "皆あなたを頼りにしてるんだから、元気でいてくれなくちゃね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そんな……私なんて、見守ってもらってばかりですし。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "だが、お前が戦い続ける姿勢が、皆を勇気づけていることは事実だろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "となれば、それだけで十分だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エクシア",
          "text": "さーて、いい機会だしロドスで無料検診受けてから帰ろっかな～。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "じゃ、あたしたちもそろそろ行きましょうか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "と……そうだわ。アーミヤ、ドクター。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "——?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい、何でしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ&エクシア",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ&エクシア",
          "text": "頑張ってね！ / ファイトだよっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "わ……わわっ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "リスカム",
          "text": "報告を終え次第、すぐに戻りますので。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "何はともあれ、この先もまだやるべきことは多くあるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "身体には気をつけてくれ、アーミヤ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……みなさん……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ありがとうございます。みなさんも、どうかお身体には気をつけてくださいね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "また、お会いしましょう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "もう一度、龍門外周付近のスラム街へ行ってみようと思います。何かしら、手伝えることはあるでしょうし。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "一人で大丈夫なのか？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "危険があるような……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "一緒に行こうか？　アーミヤ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "大丈夫ですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ちょうど、レッドさんというオペレーターが、龍門でほかの任務に当たっているんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "本当に頼もしい人ですし、いざという時は彼女を頼ろうと思って……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですから、心配しないでくださいね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
