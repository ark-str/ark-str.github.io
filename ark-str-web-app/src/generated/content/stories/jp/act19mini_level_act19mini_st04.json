{
  "server": "jp",
  "storyId": "act19mini_level_act19mini_st04",
  "groupId": "act19mini",
  "stageId": null,
  "title": "白錦",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act19mini/level_act19mini_st04.txt",
  "sourceHash": "6023000605dafd833990ae7d32b4d858b607d3f8d722ea44858267d1cd904371",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "兄ちゃん、まだ打たないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な棋士",
      "text": "そう焦ることではない。もう少し考えないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "けどもうずっと考えてるじゃん。前に来た時も、その前に来た時もそうだったよ。誰かに騙されてるんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "こんなに来てるのに、誰かと対局してるの見たことないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な棋士",
      "text": "これでいい。ただ……次の手を考えてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な棋士",
      "text": "己の手に相手がどう呼応するか。そして、その後に起こるあらゆる変化まで、そのすべてを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "面倒くさいなあ、想像するだけで頭が痛くなってきた……とりあえずこの局を終わらせてから相手に教えてもらうんじゃダメなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "ただの碁なんだから、負けたって何が起こるわけでもないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な棋士",
      "text": "それでも負けるわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な棋士",
      "text": "この局面を用意した者は約束した。もし勝てたら、願い事を一つ叶えてくれると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "願い事？　ほんとに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "はぁ、それなら僕もやってみたいけど、こういうややこしいこと考えるのは苦手だ……力仕事の方が向いてるかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "そろそろ日が沈みそうだし、家に帰らなきゃ。片付けなきゃいけないガラクタが山ほどあるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "それじゃ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "あ、何度も会ってるのに、まだ兄ちゃんの名前聞いてなかったね。何て言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な棋士",
      "text": "姓は蘭（ラン）、名は可（カ）と言う。梅蘭の蘭に可否の可だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "じゃあ僕の名前は覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "洛勤（ルオ・チン）？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "うん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "じゃあ、ほんとにもう行くね。しばらくは引っ越して外で暮らすって母ちゃんが言ってたから、戻ってきたら、きっとまた会いに来るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "じゃあね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "足音が徐々に遠ざかり、夜の闇が盤に落ちる。日光が碁石を照らして、雨雪が石の椅子を洗い流す。\nラン・カは白石を手に取って、それを打とうとして、再び引っ込める。しばらく石を指で撫でた後、結局碁笥の中に戻した。\nこれで十度目の死局（しきょく）だ。彼ははっきりと覚えていた。\nまたしても周到に仕組まれた一局。今度こそ、勝つための妙手を考え出さねばならない。\n……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "text": "ユンさん、私はここまでで失礼します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "あの方は、山の上で待っているというお話でしたが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "text": "ええ。あの方は今、山の上におられます。そして、私の仕事はあなたをこの山道へお連れするまでで終わりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "text": "ここから山へ登る道は一本だけで、さほど険しくはありません。周囲の森は整備されておりますから、猛獣などもおりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "text": "道なりにひたすら上へとお進みくだされば結構です。その他の手配はすべて整っております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "なるほど。これ以上の詮索は、かえって不調法ということですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "それでは、ここで。ご案内ありがとうございました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "text": "ごきげんよう、ユンさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "とは言ったものの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "山道など、どこにあるのでしょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "地面には落葉が厚く積もっていて、長らく人が通った形跡がなさそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "獣道すら見当たらない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "地元の人に尋ねてみるべきでしょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "すみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "こんにちは、どうかなされましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "あの、私の夫を見かけませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "中年にはまだ入っていない男で、髪は茶色、尻尾の先は真っ白、薄めの上着に土色のズボン、革靴という格好です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "いえ……そんな人は見かけなかったと思います、すみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "そうですか……お時間を取らせてすみませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "待ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "あなたは地元の方ですよね。お伺いしたいのですが、この付近に、山へ登る道はありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "山へ登られるのですか？　それなら道を間違えていると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "正しい道は町の反対側にあります。ここは裏山で、道も険しく、町の者がここから山へ登ることは滅多にありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "（裏山？　大通りをまっすぐ歩いてきたはずだが、なぜ裏山に？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "そうでしたか……ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ですが……道案内をしてくださった方がこちらから登るように勧めたということは、きっと何か理由があるのでしょう。やはりここから上に向かってみます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "それでは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "あの、私もご一緒させていただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "それはまた、どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "山道は危険です。二人で行けば、お互いに助け合うこともできるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "それに……町の中はもう探し尽くして、この辺りでまだ探していないのは山の中だけなんです。夫がまだこの辺りにいるとしたら、山の中しかあり得ません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "そうですか。では、お言葉に甘えて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "何とお呼びすればよろしいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "さまよう女性",
      "text": "……白錦（バイ・ジン）と申します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ・チン",
      "text": "ラン兄ちゃん、この盤面からどうするか、まだ迷ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "焦ることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ・チン",
      "text": "もうずいぶん時間が経ったよ。僕まで囲碁の打ち方を覚えちゃったくらい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ・チン",
      "text": "その局面って、「三劫循環」って言うんでしょ？　囲碁の規則だと引き分けだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "引き分け……それではいけない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "あの人と約束した。この対局に勝たなければ、願いは叶えられないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "必ず勝ち筋を見つけなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ・チン",
      "text": "そこまでして叶えたいなんて、一体どんな願いなの？　この対局でどうにかしなきゃダメなの？　他に何か方法はないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "他の方法……そんなものがあるはずもない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "死に別れた二人が……再会する方法など……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "劫……この劫は一体どこから来たと言うんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "ジン、これでいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "とっても素敵！　あなたって本当に手先が器用ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "焼き物なんて、碁石くらいしか作れないと思ってたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "ふふ……まだまだできることはたくさんある。君が欲しいものも好きなものも、全部焼いてみせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "私たちの式が終わったら、この花瓶は客間の一番目立つ場所に置こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "「東に瓶、西に鏡、終生平穏なり」と言うが……まだ鏡が足りないな。けどそうすると、鐘が置けなくなる。でも町にある鐘が朝晩一度ずつ鳴るから、それで十分かな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "その時、花瓶には花を生けて、鏡には君が映って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "もう先の話はそれくらいにして……家の薪がなくなりそうなのよ。まだ明るい内に裏山へ行って取ってきてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "分かった。少し待っていてくれ、すぐに戻る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "ええ。帰ってきたら、ちょうど晩ご飯ができてる頃だわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "これは……何事だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "この怪物どもは、どこから現れた！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "ジン――――！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "こんなところに……本当に……道があったなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "……手をお貸ししましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "ご心配には及びません、ユンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "私も山育ちの人間です。これしきの道はなんてことありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "あなたの方こそ顔色が優れないようですが、一休みしていきましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "では……少し休ませてもらいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "スゥ……ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "あなたの何としても諦めない様子、私の夫そっくりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ご主人は、真面目な方でいらっしゃるのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "あの人ときたら、何をするにも頭が固くて、人の言うことなんてろくすっぽ聞かないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "飲まず食わずで、終わるまでじっとその場に釘みたいに張り付いてね。はぁ、憐みはしますけれど、うんざりすることもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "私の言うことならまだ耳を傾けてくれることもありましたから、いつも私があの人の耳を引っ張って連れ戻してたんです。小さい頃からずっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "だけど町にいる囲碁の先生がおっしゃってたんです。あの人の性格なら、棋士に向いてるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "何年か学べば、地方で一流の棋士になれるかもしれないし、それどころか国一番の棋士にだってなれるかもしれない。そうなればこの町を出て、もっと遠い場所へ旅立つことになるだろうって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ご主人は、碁を学ばれたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "ええ……長いことずっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "夢中になってのめり込んで、他人が何を言っても聞こえなくなるくらいでした。まったくひどい話です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ははっ……私も聞いたことがあります。囲碁の黒白と縦横に秘められた果てなき奥深さは、人を夢中にさせると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "大地は広く、それゆえに人を惹きつけてやまない物事が必ずあります。時にはたった一つの想いに囚われ、その中に長く迷い込んでしまうことさえあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ご主人が囲碁に執着したのも、きっとご本人なりの理由があるのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "あの人の肩を持つんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "少し思うところがあっただけです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ところで……ご主人が行方不明になったということですが、一体いつ頃のことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "あの人は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "ある日の夕方、山へ薪を取りに行くと言ったきり、消息が途絶えてしまったんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "それは確かに心配ですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "バイさん、今すぐ出発しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "もう少し休まれなくてよろしいのですか？　失礼ですが、お身体が丈夫そうには見えませんし、普段こういった険しい山道は歩き慣れていないのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "私は武術こそ不得手ですが、呼吸法の鍛錬は、日々欠かさず続けています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "先はまだ長いですから、私もここに留まってはいられません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "山頂に古亭が見えます。あそこに着いたらまた休むとしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "この対局、まだここで膠着しているのか……この一手にどれだけ思い悩んでいることやら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "ラン兄さん、もうどれだけ経ったと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "さあな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "私の孫は、今やあの時の私と同じくらいの背丈だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "あんたの話をしても、信じてはもらえんかったよ。たかが一局に、一生を費やす人などいるものかとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "あんたがバイ姉さんと別れたのはいつのことか、覚えているかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "覚えていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "町で事件が起きた後、私は意気消沈して、山の中を数ヶ月も彷徨った挙句、ここへ辿り着いた。それほど昔ではなかったはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "それはいつのことだったかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "よく覚えていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "では、今が何年かは知っているかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "さあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "そんなことはどうでもいい、まずはこの局面を解いてからだ。他のことは、その後でいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "おお、今や町の人々はお宝とやらで大騒ぎしとると言うのに、こんなところへ足を運ぶ者がおるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "あんたもこの対局を見に来たのかね、お若いの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "私たちは、一休みしに通りかかっただけです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "私たち？　あんた一人じゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "いえ？　一緒に山を登ってきた女性が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "おかしいですね……さっきまでいたはずなのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ユン・チンピンは辺りを見回したが、バイ・ジンの姿は跡形もなくなっていた。\nただ一人、寡黙な青年だけが、碁盤をじっと見つめて座っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "こちらの方は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "はぁ、この兄さんはもう碁の中から出てこられなくなっとるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "あんた、囲碁が分かるなら、助けてやってくれんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "この局面は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "三劫循環さ。このまま続けたところで、引き分けにしかならん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "だが兄さんは、どうしても勝敗を決めたがって、その結果自分で自分を盤の内に閉じ込めてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "私もどうしようもなくてな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "（盤面を観察する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "（熟考する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "ああ、ダメだ。また一人取り込まれてしまったわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "まったく、次から次へと、はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "引き分けではなく、ただ勝利だけを求める……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "心が劫にのみ囚われたままで、勝ち負けなど決められるものだろうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "この子供……まだ命が残っているとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チョンユエ",
      "text": "だがこの重傷では、これからどれほどの苦しみを味わうことになるやら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "この体では、武術など修められようもありません。そんな私が天下の武芸を記録したところで、一体何の意味があるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "先生、私には分かりません……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ユンさんは、宗師が用意した道に一度も疑いを抱かなかったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ないわけではありません。最初に役目を受けた時は、不満にも思っていました。私のような者に日々皆さんが武を学ぶ様子を見せつけるのは、柱に縛り付けて目の前にごちそうを置くようなものだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "香りが鼻腔をくすぐって、見ているだけでよだれが出てきそうなのに、一口だって食べられやしない。苛立ちと苦しみが募り、辛くて仕方がありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ですが今のユンさんは、少しも辛そうには見えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "たとえ理論だけであっても、道を深めることは多少なりとも慰めになるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ですがそれ以上に――きっと私も、物事の道理が少し分かるようになったのだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "私が最近見た夢について、話していたでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "いいえ。ぜひ聞かせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "無名の者として、田園に隠居する夢を見ました。記録してきた技や型を畑仕事に応用し、気を整え力を用いて草を刈り土を耕す日々を送っていました。気を上手く使えば労力もぐっと減りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "またある晩は、恩讐を巡る壮絶な戦いの夢を見ました。先生の型をなぞって、勁発すれば江潮落ちるが如く、気収まれば秋毫平らかなり。拳の一撃で伝説を刻み、そのまま力尽き果てました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "どちらも今のユンさんとはかけ離れた姿に聞こえますね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "執念とは泥濘の如し。足をとられれば、はっきりと見えなくなるのも当然です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "よくよく考えてみれば、答えはただ一つ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "先ず捨て、次に見て、最後に得る。それだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "この一手、打つべきはここです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ユン・チンピンは白石を一つつまむと、盤上の百目を懸けた攻防を気にも留めずに、あっさりと別の場所へ打った。\n黒はそのまま勢いに乗じて盤上の数多くの白石を奪っていったが、激しい展開の末、なんと白にとって明らかに有利な局面へと変わっていった。\nラン・カは幾度となく見つめてきた黒白の石が、まるで泡沫のように消えていく様を茫然と見つめていた。後に残ったのは空っぽの碁盤と、三人の男だけだった。\n硬直した局面は、破られたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "なんと……こんな手があったとは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "感謝する！　長く考えてもまるで見当がつかなかったのに、まさか来て早々に解いてしまうとは、感服したよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "過分なお言葉です。私は碁に関しては素人ですが、世の道理は相通じるもの。捨てるものあれば得るものありという武の道もまた碁の道に通じるはずだと考えただけです。運良く上手く行きましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "あなたの棋力は私よりも遥かに上でしょう。しかし劫の勝負に執着するあまり、かえって盤面全体の解を見落としていたのだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "いずれにせよ、この詰碁が解けたことには違いない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "君は……ルオ・チンか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "私はルオ・チンの孫さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "祖父は生前、故郷の山で碁を打つ変わり者の話をよくしていて、私も何度も足を運んだ。私の孫にもこの場所のことを託すつもりだったが、まさかこの若者が幕を下ろしてしまうとは思わなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "では、今はもう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "百年あまりが経っておるよ。麓の町もすっかり変わってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "まさか……ジンと別れてからそれほどの歳月が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "ジン！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "ええ、私よ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "あなた……久しぶりね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "本当だったのだ！　あの仙人は嘘をついていなかった！　本当に君に会えるなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "よかった、本当に……よかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "家に帰ろう！　父さんと母さんが私たちを待って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイ・ジン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "ジン……？　なぜ、黙っている……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "そうか……ははは……そういうことだったのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "私も……もうとっくに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラン・カ",
      "text": "いずれにせよ、私はまた、君に会えた……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "硬直した局面は破られ、仙人は約束を果たした。\nそれゆえに、ラン・カにもはや悔いはなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "「バイ・ジン」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "バイさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "違う……あなたは先ほどの話の中のバイさんではありませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「バイ・ジン」",
      "text": "ええ、夫に会えた今、もう他に未練はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「バイ・ジン」",
      "text": "私は彼女の衣冠塚（いかんづか）の前に捧げられ、あの人の涙と想いが滲みこんだ冥銭です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「バイ・ジン」",
      "text": "彼女の願いと、私の運命は、何もかも夫君との再会にかかっていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「バイ・ジン」",
      "text": "あの人が去った今、もうここに留まる理由はなくなりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「バイ・ジン」",
      "text": "ユンさん、ルオさん、お手数をおかけしますが、どうか私の最後の願いを叶えてください。夫のお墓を彼女のお墓の隣に建て、そこで「私」を燃やしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「バイ・ジン」",
      "text": "共に今生を送る幸運には恵まれませんでしたが、来世でも……また会えますように……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "言い終えると、「バイ」は両手を組み合わせて深くお辞儀をし、瞬きの間に――\n彼女がいた場所には、風に揺れる一束の冥銭だけが残された。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "冥銭……あのバイという女性は、器鬼だったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "百二十年前のとある晩、なぜかこの町に大量の器鬼が突然押し寄せて人々を襲った。あれは本当に惨い事件だった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "私の祖父は、ラン・カと呼ばれる青年に救われた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "その晩、青年は町で多くの人々の避難を助けた……そして彼自身はバイ・ジンという女性の手で器鬼の波の中から引っ張り出された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "しかしバイさん自身は……その晩に命を落としたそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ランさんとバイさんは、どちらも善良な方だったのですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "聞くところによれば、器鬼は例外なく想いから生まれ、想いが消えれば、再び元の物へと戻るそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "我が家で三代に渡って語り継がれてきた秘密に片が付いたと言うのに、なぜこうも涙が止まらんのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "若者よ、私は山を下りることにする。バイさんに頼まれたことは、私がきちんとやり遂げねばならん。そうすれば、祖父にも良い報告ができるようになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "あんたはどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "山の上で私を待っている人がいます。急いで行かなくてはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "ふっ、今や山の上は騒がしくなっておる。わざわざ裏山から呼び出すとは、一体どんなお偉方なのだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "では、私は先に失礼するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルオ",
      "text": "縁があってまた会うことができれば、うちに茶でも飲みにくるといい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ルオは地面の物を丁寧に片付け、竹籠の中にしまうと、よろよろと山を下りていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君が、あの局面を打開したのかい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "雑用専門の半身だ。労働用の器鬼のようなものと思ってくれればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君は長け……チョンユエの傍で記録を務める人間だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "ということは、あなたも歳獣の代理人の内の一人なのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こんな形で招いてすまないね。登ってきてくれ、客人が山頂で君を待っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "つまり私を「招いた」のは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まさしくこの私だよ。本来は別件で用があったのだが……まさか道すがら、ついでにあの硬直した局面を破ってしまうとはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（大声）これで、またもやあなたの読み通りだよ。嬉しいか、囲碁バカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "棋局に関しては単なる偶然です。それが誰かの策略であるはずはないと思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "かつて兄さんがここに棋局を残した時、真の慧根を持つ者だけがこれを解くことができるだろうと言っていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今思えば、わざわざこの場所に棋局を仕掛けたのは――兄弟姉妹の中で最も「人の身」に近いのは、長兄だ。その弟子をここへ導いたのも……驚くべき妙手ってほどでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さあ、登ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "碁盤を持っていくのを忘れないでくれ。打ち終えた今、それはもう君のものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "お名前をお伺いしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "一文字で梁（リャン）。建物の梁のリャンさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "リャンさんは先ほど、あの局面を打開できるのは先生の弟子だけだとおっしゃっていましたね。ですが私よりも前に、すでに解こうとしている人物がおりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "ラン・カのことかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "あの者には確かに、あそこで碁を打つ許可を与えたことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "あれは劫にこだわればこだわるほど、破るのが難しくなる盤面でした。打ち手がそこに執着すると分かっていて、あえて盤上に引き入れたということは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "仕組んだ者は、ただ世を弄ぶことが目的だったのか。それとも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "text": "碁を布くは人を見るが如し。彼もまた、あの盤面と同じく頑な心の持ち主なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "ああ、いいところに目を付けたね。いいよ、すごくいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "（構造が震えるのを必死に抑える）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "次は本人の前でその言葉を言ってやって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "着いたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン",
      "text": "こちらが君に会いたがっていた人だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "利発そうな少女",
      "text": "この巡り合わせも、天意というものなのでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "利発そうな少女",
      "text": "またお会いできて光栄だわ、ユンさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
