{
  "server": "jp",
  "storyId": "main_2_level_main_02-01_end",
  "groupId": "main_2",
  "stageId": "main_02-01",
  "title": "龍門",
  "storyCode": "2-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_02-01_end.txt",
  "sourceHash": "15820f4d9c62f344640f90e2a231df6e539ca05709d7fd93070db1690440a51a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十三关（后）\np.m.10:14 / 晴天 / 視界：19km\n龍門第五区外　検疫所"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ロドスの人員が到着しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "――繰り返し、龍門からのお知らせをお伝えいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "天災の影響により、龍門全域が停泊状態となっております。また、龍門第五区のゲートはすべて、2時間後に封鎖される予定です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "皆様、ゲート通過の際には、鉱石病の検疫にご協力くださるようお願いいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "合わせまして、未登録の感染者を発見されましたら、付近の警備員まで直ちにお知らせください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "『緊急事態管理法』に基づき、近衛局が速やかに対応し、対象の人物を捕縛いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "繰り返し、龍門からのお知らせを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "聞いていた通り、ですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "行きましょう、ドクター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――お待たせしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ロドスとの面会は10時の予定だと聞いていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だが、今は10時14分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "この遅刻で、私の時間を14分も無駄にさせられたことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……申し訳ありません、チェン隊長。先ほどこの近辺でレユニオンと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "説明は不要だ。事情はわかっている。それより、本題に入ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――そちらの人物は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ロドスの顧問、Dr.{@nickname}です。ケルシー医師のほうから、龍門側のみなさんにお伝えしてあるかと思いますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……ふん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "まあいい、これで人員は揃ったというわけだ。では、私と共に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "――隊長！　緊急のご報告です！　感染者が、また――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "狼狽えるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "第一部隊、警戒態勢を！　狙撃手は配置につけ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "一般市民",
      "text": "な、なんだなんだ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "放せ！　放せよ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――何事だ。状況を報告しろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "俺が何をしたっていうんだ！　頼むよ、通してくれ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "俺たちは化け物なんかじゃないんだぞ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "この感染者たちが、我々の指示に従わないものでして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……そのくらい、見ればわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もういい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "一度ゲートを封鎖し、奴らを全員拘束しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "対応を終え次第、30分後に検疫所を再び開き、ゲートを解放するように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それから、検査エリアを40メートル前倒しにしておけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "さて……ロドスの人員は、アーミヤとDr.{@nickname}のみ私に同行してもらう。ほかの者は、ここに残って龍門国境警備隊の補佐に当たれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そのくらいの任務もこなせないようでは、話にならんからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――「PC94172」。彼らに指示を与え、今夜はこれ以上騒ぎが起こらないように努めろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "了解しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "それでは、ロドスの方々。警備任務についてご説明を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "（小声）チェン隊長は、想像以上に厳しい方のようですね……",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（頷く）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "さあ、行くぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "ついてこい。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "――ここだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "わあ～……！　こ、こんなに高いビルがあるなんて……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……あっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "す、すみません、つい……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "――キミたちロドスが、見どころのある組織だということは知っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えっ……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ええ、と……ありがとうございます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "だが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "チェルノボーグでの事件後、生き残った人々は一様に、必死で龍門に向かってきているようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "感染者が龍門へ来たらどうなるか……そのくらい、当事者たちは理解しているだろうにな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "――念のため、もう一度申し上げます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "このままでは、龍門が次のチェルノボーグとなることは確実です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "！　これは、ケルシー先生の声ですね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "ああ。キミたちロドスの交渉役として、ウェイ長官と会談している最中だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "では、ここで待っていてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "のちほど案内しに戻る。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ふぅ……チェン隊長って、なんというか少し……とっつきにくい人ですね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "何はともあれ、交渉については、ひとまずケルシー先生にお任せしましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "大丈夫です。先生を信じてください、ドクター。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
