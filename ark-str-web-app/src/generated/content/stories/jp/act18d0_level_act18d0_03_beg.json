  "blocks": [
    {
      "type": "narration",
      "text": "3上"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "十三年前\np.m. 8:09 天気/大雪\nヴィクトリア辺境自治領 ドルン郡 ヴィンセント荘園"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "なんと美しい雪の夜でしょう。皆さん我が荘園へようこそ、どうぞ中へとお入りください。使用人たちにお体の雪を払わせます。それが終わったら暖炉で温まってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣装が派手な商人",
      "text": "伯爵、ごきげんよう。実に華やかなパーティーですこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "ようこそお越しくださいました、ダイアナ様。新年前夜にあなたにお目にかかれるとは、光栄の至りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣装が派手な商人",
      "text": "いえいえ、こちらの方こそですわ。伯爵、こちらをお手に取ってみてくださいまし。カジミエーシュで、伯爵のために入手した贈り物です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "なんという美しいペンダントでしょう！　ありがとうございます、ダイアナ様。旦那様によろしくお伝えください。さあ、早く中に。雪であなたの美貌が覆われてしまうのはもったいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衣装が派手な商人",
      "text": "フフッ、相変わらずお上手なこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "おお、誰かと思えば、「麦畑男爵」ではありませんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恭しい男性貴族",
      "text": "わたくしごときに伯爵からお呼びが掛かるとは思いませんでした。しかし、それでも厚かましく罷り越しましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "何をおっしゃいますか！　我々は皆、心から男爵のことを尊敬しているのですよ。自分たちの腹を満たしてくれるお方を敬わない理由などありません、ハハハッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恭しい男性貴族",
      "text": "いやはや、もったいないお言葉です。来年の収穫時期にはぜひとも我が畑をご贔屓願いますよ。ドルン郡最大の風車と、小麦粉の香りは必ずや忘れがたいものになるとお約束できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "もちろんですとも。この吹雪が過ぎれば、来年はきっと豊作になることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恭しい男性貴族",
      "text": "あなたがそうおっしゃるのなら間違いありませんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "さぁどうぞ中に入って温まってください。今宵は男爵の最も愛するスパイスパンもございます――もちろん、男爵の農場で作られた、最も繊細で美味な小麦粉でできております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恭しい男性貴族",
      "text": "楽しみですね……おや、伯爵はまだお入りにならないのですか？　まもなくお時間ですよ。残りの客人の出迎えは、使用人に任せればよいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "おっしゃる通りかもしれませんね。しかし私は、招いた方々を自ら迎え入れるのが好きなのですよ。貴族であろうと商人であろうと、修道士であろうと兵士であろうと、皆素敵な方々ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "そんな方々が喜んで来てくださるこのドルン郡は、本当に素晴らしい場所です。違いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恭しい男性貴族",
      "text": "なるほど、あなたには本当に頭が下がります……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "さて、残りは、アリゾナご夫妻、尊敬すべき灯台の守り人、それと……ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "コホンッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "私の最も尊敬する同輩、天性の演説家トムソンは、最近体調が良くないと聞いている……だからこの吹雪の中、わざわざ足を運ばせるのは忍びなく、トランスポーターをやって祝福を贈ったが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "なぜこんなところに――彼の可愛らしいトランスポーターがこそこそと隠れているんでしょう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "それっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "ハハッ！　久しぶりじゃないか、ハイディ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "ヴィンセントおじさま！　せっかくセットした髪をぐしゃぐしゃにしないで！　このメイクもすっごい時間かかったんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "わかったわかった。あのハイディも大きくなったな。もう立派な、一人のレディではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "しかし、君のお父さんから今日君が来るとは聞いていないぞ。正直に言いなさい、君は黙って家を抜け出してきたのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "立派になったとはいえ、君はまだ若い。そんな格好をしているのをお父さんに見られたら、またうるさく言われるぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "おじさま、私はうるさく言われたくないから、こっそり抜け出してきたのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "今日はおじさまが有名な人をたくさん招待してるって聞いて、興味が湧いたの。それに学業のみにとらわれず、視野を広げなさいってパパがいつも言ってるもの。まさにいい機会でしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "さては、若き才能あふれる青年との出会いを期待しているのではないのかね？　お父さんから聞いたぞ。最近、低俗な恋愛小説に夢中だというじゃないか。彼はそのせいで頭を抱えていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "そ、そ、そんなことないよ。私はもうそんな幼稚な女の子じゃないんだから。あは、あはははは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "君のお父さんは素晴らしいことを言っていた。「ロマン主義は良いものだ。しかし消費を目的に人生の真実を偽り、読者に媚びて利益を貪るような書物は、全くの無価値である」とね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "このドルン郡のすべての者は、君のお父さんの言葉から学ぶべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "ちょっと、おじさま、やめてよ、聞いていてこっちが恥ずかしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "パパったら、昔は金持ちの悪口ばっかり言ってたのに、結局は自分も商人になって、お金を稼ぐ側になるんだもの……学会の先輩たちはいつもパパのこと茶化すんだよ、ほんとやんなっちゃう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "必要に迫られてのことさ。可愛い娘や奥さんのため……そういうことにしておいてあげなさい。若い頃の彼は、才能を認めてもらえないとよく私に嘆いていたよ。最近彼の体の具合はどうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "いつものやつだよ。冬が過ぎれば、また元気になると思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "つまりご両親が君に構っていられない隙を突いて、君はこっそりお母さんのお洋服を着て、ここの私のパーティーに参加しに来たというわけだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "まあね――あ、違う。勉強目的だってば。パパの教育方針に従ったまでだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "ハイディ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "ふふっ、何も見なかったってことには……できない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "今回はあまりにも奔放すぎるぞ。こんな大雪の日に、もし道中何かあれば、私は君のお父さんに何と説明すればいいのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "あは、あはは……でもおじさま、今日はもうこんなに遅いんだし、いまさら帰るなんてできないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "まったくこの子は……ほら、早く入りなさい。風邪をひくぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "やったぁ！　おじさま大好き！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "あれ？　ねぇおじさま、まだ誰か待ってるの？　おじさまが入口で雪だるまみたいにならなきゃいけないほどの、大事なお客さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "うむ……とある偉大なラテラーノの修道士さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "昨年、君のおばさんが原因不明の病で高熱に悩まされていた時、その修道士が治してくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "それから親交を結び、私はしばしばその方を訪ねるようになった。その修道士は優れた医療の腕前を持つだけでなく、あらゆる分野に独自の見解を持っていてね、本当に驚かされるばかりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "へぇ……おじさまがそんなに評価するなんて、きっととてもすごい人なのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "もちろんだとも！　あのような方がヴィンセント家に忠誠を誓ってくれれば、この地ももっと発展できるのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "本来ならロンディニウムの旅で、その修道士に友人として――あとおばさんの退屈しのぎの相手としても同行してほしかったのだが、あいにくその方にも用事があってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "だから今日は、ぜひその方を皆に紹介したいと思っているのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "おじさま……そのラテラーノの修道士って、男性の方？　もしかして礼儀正しいサンクタだったりしない？　年齢は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "まったくこの子は……やましい考えはないと、さっき自分で言ったばかりじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "ち、ちょっと聞いてみただけだもん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "残念だったな、その方は女性だ。サンクタでもない。修道士としては珍しいフェリーンだ。しかし本当に称賛に値するよ。彼女のように素晴らしい女性は他にいないだろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "コホンコホンッ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "お、おじさま、私何も聞いてないから。おばさまにも絶対言わないから安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "text": "何をバカなことを言ってるんだ！　まったく、トムソンにしっかり教育させる必要があるようだな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "申し訳ありません、ヴィンセント殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "遅れてしまいましたでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
