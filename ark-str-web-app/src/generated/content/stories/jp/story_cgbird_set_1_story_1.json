  "groupId": "story_cgbird_set_1",
  "stageId": null,
  "title": "青い羽根と歌",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_cgbird_1_1.txt",
  "sourceHash": "fe7806fb4b271153942440b75ffff887d794f561ae507f1d59fab682a326d979",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "p.m. 4:37 天気/晴天\nリターニア北東部のとある村"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "衰弱した子供",
      "text": "ゴホッ、ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦っている母",
      "text": "どんどんひどくなってきてるみたい、どうすれば……ルカ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衰弱した子供",
      "text": "母さん、痛い……痛いよ……脚が、脚が燃えてるみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "しっ！　大きな声を出すなルカ、我慢するんだ……隣のトーマスに聞こえてしまうだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "お前は強い男だ。耐えられないほど痛いなら、枕でも噛んでいろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦っている母",
      "text": "枕はもう、噛みすぎて中綿までボロボロよ！　汗も止まらないし、熱も引かない……や、やっぱりマルコス先生に診てもらいましょうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ダメだ。それはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ほら、この子の脚を見ろ……この真っ黒い固まりを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦っている母",
      "text": "こ、これは鉱――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "しっ！　今その言葉を口にするな。ルカに聞こえてしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ついこないだ、ヤニックんとこのベン――あの子の手にもコイツができた。それであの子は奴らに連れて行かれたんだ。お前も知ってるだろ？　あの子は二度と家に帰らなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦っている母",
      "text": "ううっ……ルカ……私のルカは絶対あんな奴らに連れて行かせたりしないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ああ、だから今はこうするしか、こうして……やり過ごすしかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衰弱した子供",
      "text": "お母さん……お母さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "枕がボロボロなら、父さんの手を噛んで食いしばるんだ。ルカ、もう少しの辛抱だ……お前は強い子だ。今によくなるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "奇跡は……必ず奇跡は起こるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "そう信じるしかない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ごめんください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦っている母",
      "text": "誰か来たわ！　こんな時に訪ねて来るなんて、まさか奴らがルカを連れて行こうと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "怖がるな。俺が見てくる。お前はルカを抱いて、部屋の奥に隠れていろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "クランタ？　その格好は騎士ですか？　俺たちが住んでいるような小さな村じゃ、あまり見かけませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ああ、驚かせてしまい申し訳ありません。私たちは通りすがりの医療団です。実は、水が欲しいと思っていたところ、ちょうどこちらのお宅が目に入って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "あ……そうでしたか。我々のような見ず知らずの者から受け取った水が怖くないのなら、水の一杯くらいたやすい御用ですが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "どうぞ。飲んだらすぐに出て行ってください。いっそのことコップごと持っていって構いません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "どうした、リズ？　この水は安全だと思うぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "感じるのです……声なき苦痛が……この近くに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "そうですね。微弱ではありますが、はっきりと感じます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "誰かが助けを求めています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "二人がそう言うのであれば――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ご主人……つかぬ事を伺いますが、あなたの家に鉱石病の患者は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "鉱石病！？　よ、よくもそんなことを！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "患者さんは、かなりの痛みに耐えているのでしょう？　ですがまだ希望はあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私ならば……治療できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "……その角……その形！　そっちの奴もだ！　お前ら魔族だな！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ご主人、どうか落ち着いてください。先程言ったとおり我々は医者です。もし本当に鉱石病の患者がいるなら、その病状を緩和することができます。治療費も見返りも必要ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "言ったはずだ――病人はいない、治療なんて必要ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "早く立ち去れ、嘘つきのクランタめ！　お前ら魔族もだ！　俺の家に近づくな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "彼の意志は固かった。よほど私たちに家族の治療をさせたくなかったのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "よくあることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "医者と病人の間には信頼関係がなくてはなりません。しかし、今の彼は私たちを信頼できない状態なのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "それにかなり緊張しているようにも見えた。もしかしたら私たちの格好が、彼に警戒心を抱かせたのかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "いつも人に好かれるはずのニアールさんでさえ拒絶されたのです。私とリズさんは言うまでもありません。サルカズの印象は、どこへ行っても良いものではありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "今まで他所でやってきたように、彼を説得してみても良いかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私たちが憲兵隊に遭遇しなければの話ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "そうだな。憲兵隊を「説得」するのは、病人の家族を説得するよりもよっぽど難しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "目下、そのような「説得」の場面はなるべく避けたいところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ああ、ここ最近はリズの体調も優れない。今は危険を冒すべきじゃないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "しかし残念だ。あの家にいる病人は、このままにしておけば病状は悪化する一方だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……辛いです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "リズ、どこか悪いのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私が感じたあの苦しみ……あのお家の子供だと思います……とても辛そうで……小さな部屋に閉じ込められ、病気の痛みを耐え忍んでいるように感じました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "部屋でじっと苦しみに耐えているのかもしれないな。痛いと叫ぶことすら我慢して……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "まさか彼らは感染者を虐待しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "いえ、違うと思います。あの父親が……鉱石病の話をする時、顔に憎しみの色は見えませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "他の場所では、鉱石病と聞けば、みなさん決まって憎しみを顕にしますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "では、あの態度は病人を守るため……ということか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "リターニアでは感染者を家から連行し、集団隔離生活をさせていると聞いた事がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "もし本当に彼の子供が病気なら、憲兵隊に連れて行かれないよう、必死にその事実を隠すだろうな。それが親子の情だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ですが、その情が今も少しずつあの子の命を奪っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "愛という名の檻に囚われ、希望を失い、生きる力をどんどん枯らしていく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "リズ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……もう考えるのはやめておきましょう。悲しみは、あなたの体に負荷をかけます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "今日は随分と先を急ぎました。あなたが疲弊しているのはひと目でわかります。休息が必要です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "肩を貸そう。テントが設営できるまで、あと少しの辛抱だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "――できました。火をおこして、食事にしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "空が暗くなってきました。リターニアの憲兵隊の進軍は迅速です。明日にはここへ到着するかもしれません。面倒を避けるため、彼らが来る前にはここを離れた方がいいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "そうだな。憲兵との遭遇は避けよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "リズ、ここに寝かせるぞ。焚き火で暖まってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私が見張っていますから、休んでください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "憲兵隊です。やはりやって来ましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "シャイニング……起きていたのか？　まだいくらも寝ていないだろうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "十分です。すぐにここを離れましょう。リズさん、歩けますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ええ、大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "顔色が良くないですね。昨晩はあまり寝られませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "だ……大丈夫です。少し目眩がしただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "憲兵隊が昨日の家へ向かっていく……シャイニング、私たちは本当にこのまま立ち去っていいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……低木の裏なら身を隠すことができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ここに隠れていれば、彼らからは見えないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ニアールさん、リズさんを支えていてください。もしも状況が悪化したなら、臨機応変に対応しましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リターニア憲兵",
      "text": "ライスさん！　ドアを開けなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "え、ええっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リターニア憲兵",
      "text": "ライスさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "憲兵さん、言った通りでしょう！　この家はおかしいんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "ついこの間、この家の末っ子――ルカという名の男の子が、近所の田んぼで遊んで帰ってきてから、突然倒れたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "それ以降、ずっと家の門を閉め切ったまんまで、呼んでも誰も出てきやしないんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ル、ルカをつきっきりで看病していたので――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "そんな話が信じられるか！　あんなに丈夫な子が、起き上がれなくなるなんて、一体何の病気だって言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "それに、ただの軽い病気だってんなら、どうしてマルコス先生に診せに行かない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リターニア憲兵",
      "text": "話を聞く限り、やはりどうも変ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "そうでしょう、憲兵さん！　私は、村の皆の安全を考えて言ってるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "ここは……この美しく静かな村は、鉱石病の前にはひとたまりもありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リターニア憲兵",
      "text": "ええ。だからこそ感染者はすべて、隔離エリアに集めなくてはならないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "そうさ！　ライスの旦那、聞こえたろ。隔離エリアに連れて行ってもらうだけさ。そこでルカは、より良いケアを受けられる。家でこそこそ看病するよりよっぽど良いだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "いや、ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リターニア憲兵",
      "text": "ですが何だと言うんです、ライスさん？　家の中を確認するまでは絶対に帰りませんよ。さあ、ドアを開けてください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "そうだよ、お父さん。早くドアを開けてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "もうお腹ペコペコだよ、パンが食べたいな。一枚じゃ足りないな、今なら一気に五、六枚は食べられるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "え――ええっ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "あっ、トーマスおじさんごめんなさい、ぶつかっちゃった。急いで家に帰ってご飯を食べなきゃって思って。でないと母さんに怒られちゃう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ルカ、やっと帰ってきたか。朝早くから一目散に飛び出して、随分長いこと遊んだじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "憲兵さん、これが息子のルカです。悪意があって扉を開けなかったわけではないんです。汚い部屋ですし、肝心の息子も家にいない状況ではなんとも気まずくて……本当にすみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リターニア憲兵",
      "text": "この活発そうな子がルカくん？　彼は本当に病気なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ゴホゴホッ……軽い風邪ですよ。この年頃の子供なら、遊び疲れて体調を崩すことくらい誰にでもあるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リターニア憲兵",
      "text": "確かにそうですね。私は数多くの感染者を見てきましたが、こんなにピンピンしている患者は見たことがありません。マルコス先生、どう思われますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年配の医者",
      "text": "ん……お？　検査ですかな？　では少し診させていただこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年配の医者",
      "text": "どれどれ、頑丈そうな腕じゃ。汗をかいてすべすべじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年配の医者",
      "text": "それから脚は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "コホンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年配の医者",
      "text": "うむ。泥だらけじゃがなんとも力強い脚じゃ。目一杯遊んできたようじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する隣人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "マルコス先生、ご面倒をおかけしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年配の医者",
      "text": "いやいや……さあ！　憲兵殿、早朝から忙しく働いたおかげでワシの腹もペコペコです。目もかすんで、もうよく見えませんわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年配の医者",
      "text": "この子を家に帰してパンを食べさせてあげましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年配の医者",
      "text": "心配しなさんな、もしこの子がまた病気になれば、ワシがきっちり検査をして、異常があれば必ずお伝えしますでな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ふう、危なかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ルカ――もう一度ちゃんと見せるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "本当に……良くなったのか？　走り回れて、食欲もあって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "見たところ随分良くなったようだ。鉱石は……まだ残っているが、随分小さくなった。周辺の腫れや赤みも引いている。マルコス先生が一目で発見できなかったのも無理はないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "こ、これは奇跡なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "お父さん、奇跡じゃないよ。小さな羽獣さんが治してくれたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "……羽獣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "とっても、とーってもキレイな羽獣さんだよ！　羽がね、あの真っ青な湖の水よりも青いんだ！　あんなにキレイな羽獣は今まで見たことがないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "昨日の夜、窓から飛んで入ってきて、僕の枕元にとまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "羽獣は真っ白な光に包まれてたんだ。その光は明るくて、とっても暖かくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "それからその羽獣が僕に寄り添ってきたんだ。そしたらすぐに痛みが引いたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "羽獣――しかも光る羽獣だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "うん！　ホントにホントの話だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "かわいそうに。病気で朦朧として、幻覚でも見たんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "そんなんじゃないってば！　あと歌も歌ってたよ。ちゃんとこの耳で聞いたんだ。あの青い羽獣さんは僕に歌ってくれたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "よしよし……わかった、わかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無力な父",
      "text": "ありがとう、奇跡の青い羽獣よ。現実だろうと幻だろうと――まあ当然幻だろうが――とにかく、うちのルカに美しい夢を見せてくれてありがとう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……怒っていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "何に対して怒るというのですか？　闇夜に紛れて、病人の元へ飛んでいった小鳥のことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "あの、あれは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ああ、しかもその鳥は光るのだとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ゴ、ゴホン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "すまないシャイニング。昨日の夜、眠れないリズを見かねて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "シャイニングさん、私がニアールさんに頼んで、あの子のところに連れて行っていただいたんです",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "でなければ……眠れませんでしたから。ずっと頭の中があの子の苦痛に呻く声で溢れていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "もし私の脚が……もしも私の脚に力が入れば、一人でも行っていたでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ですから、ニアールさんを責めないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "謝る必要はありません。私たちは医者です。あなたたちはやるべきことをしたまでです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "それにしても、まさか憲兵隊が本当に今日訪ねてくるとはな……あの子供と家族は今後どうなるのだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "もしかしたら平穏に暮らしていけるかもしれません。あるいは、近い内に引っ越しを余儀なくされることも考えられます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "医者は一時の苦痛を和らげることはできても、壊れた部分を元通りにすることはできませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "分かっています、シャイニングさん。ですが私はあの時、そんなことまでは考えませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……あの子は、とても痛がっていましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "あの子のことを思うと、私まで痛みを感じる気がするんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "わ……私には、彼の痛みを緩和することしかできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "それでも彼を助けたい……病気の痛みを和らげて……あの部屋から出してあげたい。もう一度、走ったり、跳んだりできるようにしてあげたいと思ったんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん、一つだけ質問をします。私の目を見て答えてください。あなたは、「自分はそうしなくてはならない」という考えに囚われているのではないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "そうしなくてはならない……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ええ、昔のように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "昔のように……昔のようになるのは嫌です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "あの時は、相手の方から私を訪ねて来ました。それから私は閉じ込められて……どこへも行けず、彼らを治療せざるを得なかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……では今は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "今……今は違います。いろんな場所へ行って、私の方から人々を訪ねることができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私は彼らの苦痛を感じます。そして、これ以上苦しんでほしくないと思うのです。だから彼らを訪ねて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私は手を伸ばし、彼らの苦痛を抱きしめます。そして私の小鳥に、彼らの耳元で歌ってもらうんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ですがまさか、あの子が小鳥を見ることができるとは、思ってもみませんでした。彼は夢の中でとても楽しそうに笑っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "その時、私の意識から……常に私を刺激するあの乱雑な欠片が消えたように感じました。小鳥の踊りもとても軽やかになりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "そして私はとても幸せな気分になりました。シャイニングさん……これが嬉しいということなのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……わかりました。良い答えが聞けました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "そうです、リズさん。それが嬉しいという感情なのです。あなたはついにそれを理解したのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "そうなんですか。これが嬉しいということなのですね？　それなら私は今も……う……うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "辛いのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "はい、シャイニングさん……今はどうやら辛いみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ど……どうしたんだ、リズ？　立ち上がる力さえないじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "彼女の選択の結果です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……昨晩、あの子を治療したからか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ええ。彼女の状況は元々良くありません。簡単な治療アーツさえも大きな負担となります。ましてや急性鉱石病の治療など尚更です。彼女の体は今どんどん……限界に近づいています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "それを先に知っていれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "先に知っていれば、彼女を止めましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……私が望んだことですから。あの子を治療したかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "これがリズさんの願いなんです。たとえその結果、自らがボロボロになったとしても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "そうだな……シャイニング。私には彼女を止められない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "はい。それがあなたたちの選択です。あなたもリズさんと同じく、そこにある苦痛を救うためならば、いつでも自らのすべてを犠牲にすることを選ぶのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私は……お二人の選択を尊重するべきなのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "シャイニングさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ですが私は……リズさんには、より多くの選択肢があってほしいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "それから、マーガレットさん、あなたにもです。あなたにも、より多くの選択肢があってほしいのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "たくさんの選択肢とは、どういう意味ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ずっと外を見てみたかったのでしょう、リズさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "はい。それが私の最大の望みでした。私はこれからもあなたについていきます、シャイニングさん。私たちとニアールさんは、これまでたくさんの場所へ訪れてきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "それらはどこも……美しかった。時折、憎しみや苦しみが天と大地を覆うことはありましたが、それでもなお、その下に流れる美しさを私は見ることができました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私は……私の小鳥さんが歌って聴かせてくれた場所だけではなく、よりたくさんの場所を見てみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ならば、そうしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "何かを決断したようだな、シャイニング。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ニアールさん。前にあの病人が言っていた製薬会社のことを覚えていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "それは……ロドスのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "そうです、ロドスです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "皆で行動を共にしたこの数年で、私たちはどれくらいの病人を治療できたのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……覚えていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "覚えていなくても構いません。リズさん、もっとたくさんの人たちを治療しに行きたいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "はい……行きたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "分かりました。ではニアールさん、あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ロドスか……異存はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "私はシャイニングの決断を信じたい。もしリズが行きたいというのなら、彼女を連れて行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "一緒に……行ってくれますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ええ、一緒に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "決まりですね。では、早速出発しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……行きましょう、ロドスへ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
