{
  "server": "jp",
  "storyId": "act20side_level_act20side_05_end",
  "groupId": "act20side",
  "stageId": "act20side_05",
  "title": "ラストスパート",
  "storyCode": "IC-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act20side/level_act20side_05_end.txt",
  "sourceHash": "7b6d8e9d9b5665ed7e86415c067831e3672451e93e8aaf1fce1a8d07471f2d58",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "ズゥママ、ボート、組ミ立テ、正解カ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ、構造上はそれで問題ない。だがまだ調整の余地はあるな……例えばほら──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "見ろ、こうすればもっと頑丈になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "ズゥママ、ズゥママ！　スゴイ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ちょっと経験があるだけさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ズゥママ、やっぱりここにいたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "イナム？　どうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "この源石観測用設備を向こう岸まで運ぶんでしょ？　今はちょうどヒマだし、運ぶのを手伝おうと思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "なんであんたが私にお礼を言うのよ……あんた自分もこのロボットたちの一員だと思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "そうだな。こんなにたくさんの良き友人ができるなんて、めったにないことだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "text": "ズゥママ、ズゥママ、良キ友人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それに、実を言うと私はLancet-2姉様にピッタリのお見合い相手がいないか、ずっと探しているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……私の記憶が正しければ、Lancet-2ってあの時一緒に来たロドスのロボットのことよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ、今は私の姉だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私の技術ではまだLancet-2姉様のようなAIロボットは作れない。だからこのロボットたちの中から見つけられればと思ったんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "結果は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "この子たちはとても優しい。だがどの子も姉様が好きなタイプではなさそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "姉様はドクターのような知的なタイプが好みみたいだからな。そこが悩ましい点だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "まあいいわ。ティアカウの変人はあんた一人しかないってわけじゃないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "皆さんこんにちは、クロッケだよ。引き続き比較的安全な高い場所から中継をお届けしたいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ゴールまではあと、うーん……三百メートルくらいかな？　まあ細かいことはどうでもいっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "我らが都市建築デザイナーの中でも個性的な方に数えられるお人、そしてヴィンチ先生の唯一の弟子スディチ・ブランクキャンバス氏が、どこからか入手したボートで、レースに乱入してきました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ん？　彼がこちらに向かって何か言っていますね。カメラをズームして口の動きを見てみましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ふむふむ、えーと……恐らく「オレが一位を取ってやる！」と豪語しているものと思われます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "おぉっ、私に向かって怒りのジェスチャーをしています！　まさかあのクールな建築デザイナーが、その仮面の下にこのような熱い心を隠していたなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "かなり出遅れたとはいえ、ボートはレースに相当有利なはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "私がこうして話している間も、かなりの距離を詰めています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "向こうはなかなか盛り上がってるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ガヴィルが通った場所はいつもこう、と言いたいところだけど、ここの人たちの盛り上がりはちょっと異常ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "慣れないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "以前はね。でもアカフラに長くいたせいかしら、慣れないことにも慣れちゃったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "今や、誰も喧嘩やバカ騒ぎをしないなんて日があったら、逆に気持ちが悪いわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前も立派なティアカウになったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ところで、ズゥママ。あんた二年前のあの時、もしガヴィルが帰ってきてなければ、アカフラの大族長になるつもりだったんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "正確に言えば、大族長になることが目的だったわけではない。私はただ、それによって自分自身を証明したかっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私の理想は常にただ一つ。一番すごい機械を作り出すことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "そう、ならやっぱりその方面であんたに期待するのは無駄ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "首長の件について考えているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "よかったわ、どうやらあんたとトミミは外で国家体制の知識をある程度は学んできたようね、ガヴィルと違って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "まったく、ガヴィルはここ数年、外で一体どういう暮らしをしてきたのかしらね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私たちが当然必要だと思っているようなことも、あいつにとっては違うんだ。例えば、環境に合わせることとかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "アハハ、確かにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それで、お前はガヴィルを首長にしたいのか？　彼女がふさわしいと本当に思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "正直言うと、サルゴンの大通りで適当に通行人に声を掛けた方が、彼女よりふさわしい首長を見つけられるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "同意だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "けど、アカフラを統率できる人材をティアカウの中から選ぶなら、彼女しかいないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それはティアカウとしての考えか、サルゴンのトランスポーターとしての考えか、どっちだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "レースはすでに後半戦に突入しています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "リードはだんだんと縮まっていますが、ガヴィル選手が依然トップを保っている模様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ですが、彼女を追い抜こうとしているのは、アヴドーチャ選手ではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "アヴドーチャ選手もかなり健闘していますが、やはりあの服を着たまま試合を始めたことが、ここに来てじわじわと効いているようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "水を吸った服の重みが動きに与える影響は軽視できません！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "つまりガヴィル選手の尻尾に食らいついているのはアヴドーチャ選手ではなく……そうです、エリジウム選手です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "前半で力を蓄えて、今、エリジウム選手がようやく真の実力を私たちに見せ始めました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "すでにアヴドーチャ選手を追い越し、まもなくガヴィル選手の横に並ぼうとしています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ですが──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "あの三人は誰一人気付いていません！　本当の脅威が背後から近づいていることを！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ガヴィルに追いつくなんて、エリジウムも結構やる奴だったのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "彼はチャラチャラした態度で人の目を欺くのが好きなだけだ。それも一種のうぬぼれではあるが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ふふっ、確かにここへ下りて来る時に気付いたわ。あいつは本当は有能だけど、それを隠したいだけだってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "話をそらすな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……ふぅん、あんたもロドスで色々学んだみたいね、ズゥママ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "別に望んだわけではない。だが、クロージャ師匠がいつも技術とは関係のない会議にも参加するよう言ってくるからな。聞きたくなくても耳に入ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "その人は、あんたに大きな期待を寄せているんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "で、あんたの質問についてだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "私がアカフラで暮らし始めて、もうずいぶん経ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "都市での生活よりも、ジャングルであんたたちがどうでもいいことで毎日喧嘩してるのを見てた方がいいって思うくらいにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんたは信じないかもしれないけど、さっき言ってた二つの立場、サルゴンのトランスポーターとアカフラの大族長は、実は私にとっては分かれていないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "むしろサルゴンとしての視点を持っているからこそ、アカフラが今のままずっと放っておかれやしないってわかるし、あんたたちには先手を打ってほしいと思っているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前を信じよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "レースは徐々に佳境に近づいてまいりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "皆さん！　エリジウム選手の目を見張るような爆発力にご注目ください！　ガヴィル選手との差は、ますます縮まっております！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "そして、後れを取ったアヴドーチャ選手もまだ諦めてはいません。彼女も未だに前方の二人にしっかりと食らいついている〜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "アヴドーチャ選手、そんなに頑張らなくてもいいからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ところで、三人は背後から近づいてくる脅威にすでに気が付いています──そう、ボートを操縦するスディチ選手だー！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "そうです！　機械の力はかくも偉大なり！　彼はこの短時間で、前方の三人に追いついたのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ゴールまであとたった百メートルほどまで、近づいて参りました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "いよいよラストスパートです！　ここから三人と一艘が最後の勝負に挑みます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "だが、イナム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私は彼女を説得するのを手伝わないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ガヴィルは首長にふさわしくない、そのポジションにつくべきでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "これについては、トミミに訊いても同じ答えが返ってくるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それは自分で考えてくれ、私は忙しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "そうだ。もし暇だったら、考えながらで構わないから、ボート作りの手伝いをしてくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……あんたってやつは、人の使い方をよくわかってるじゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ゴールまであと八十メートル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ボートによる激しい水しぶきで、アヴドーチャ選手がむせたぁ！　ここで彼女は戦線離脱です！　よっしゃ助かったぁ──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ゴホゴホッ、今のは残念だと言ったんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "残り五十メートル！　試合の中心はスディチ選手です！　船を持ち出した不届き者へエッジ先生が怒りの鉄拳を振りかざして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "おっと！　ここでエッジ先生の拳が、なんと船に登ろうとしていたエリジウム選手の顔面にヒットしましたっ！　もろに食らったエリジウム選手、水中に沈んでいく〜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "水中からブクブクと泡が立っていますが、彼は大丈夫でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "あと三十メートル！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "エッジ先生、ガヴィル選手の背中から思い切ってビール号へと飛び移ると、スディチ選手の頭を思い切り殴りつけたぁ〜！\n痛い！　あれはとても痛そうです！"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ちなみに「ビール号」とは、私がたった今思いついた、そのボートの名前です！　前回名付けた「どでかい水たまり」に続く、最高のネーミング！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "どうやら、最終的な勝者はやはりガヴィ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "いや、待ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "なんとエッジ先生とスディチ選手がもみ合いになった拍子に、うっかりボートのリミッターを壊してしまったようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ビール号のエンジンが強烈な轟音を発しています、そして！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "速い、速すぎる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "たとえガヴィル選手といえど、暴走するボートが相手では手も足も出ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "轟音を鳴り響かせながら、ビール号！　ビール号強い！　ビール号が一番にゴーーール！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "今回の水泳大会の優勝者は──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ビール号です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……なんですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "まだ終わってはいません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ゴールに到達した後も、ビール号はまだ満足していない様子です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "止まらないビール号はそのまま岸に乗り上げ、そして崩れた洞窟に向かって突っ込んでいきます！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ドォーーーーーン！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "あぁっ！　エッジ先生とスディチ選手が吹っ飛ばされたぁ〜！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "そしてビール号は、勇敢にもトンネルの出口を塞ぐ大岩に突撃！　大きな穴を開けて大破！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ビール号無念！　優勝者に贈られるクラフトビールをまだ味わっていないというのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの放送",
      "text": "ビール号への哀悼の意を表し、今回の優勝賞品の贈呈は自粛するということにいたします！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "……この人たち、一体何やってるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
