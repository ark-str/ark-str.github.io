{
  "server": "jp",
  "storyId": "act16side_level_act16side_04_beg",
  "groupId": "act16side",
  "stageId": "act16side_04",
  "title": "安魂教会",
  "storyCode": "GA-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16side/level_act16side_04_beg.txt",
  "sourceHash": "02f2c4b42321d33f9d880c90a793c0cc551fe1850e386792999eae7235f5048c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ひどい顔色だけど……徹夜でもした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あいつが帰ってきたの！　絶対に見間違いなんかじゃない……あの光はアンドアインのアーツよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あぁ……それで昨日の午後、急に連絡が途絶えたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "でもまさか、直接君を訪ねてきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……違うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "昨日あの混血の子を大聖堂に連れて帰る途中で……サルカズに会ったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "こんな時期にサルカズ？　ラテラーノの街中で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……そうよ。それで女の子を大聖堂まで連れて行くのはエゼルに任せて、私はサルカズを追った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ファボール区の端まで追いかけたんだけど……そのサルカズは、アンドアインのアーツに乗じて逃げていった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "しかもエゼルときたら、昨日のうちに大聖堂に着くと思ってたんだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "結局来てないでしょ。これがあいつの端末よ。使節の送迎車の裏に貼りつけられてたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "へぇ、あの見習いくんって君を騙せるくらい芝居上手なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……あれが演技だとは思えないわ。でも確かに姿をくらます理由はわからない……まさか、アンドアインにさらわれたとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フィアメッタ、冷静になりなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私は冷静よ。この八年間で今この瞬間が一番冷静だわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……あの日私が去ってから何があったのか、いつになったら教えてもらえるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ただの掃討作戦だったのに……予想よりも順調だったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私はただ、臨時支援要請を受けて……四時間ほど離れていただけなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あの廃墟に戻った時には、もう何もかも手遅れだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君に話せることは全部話したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "じゃあ錠と鍵はあいつに一体何を与えたの？　何があいつをレミュアンに手を出すほど狂わせたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それは、隠してるわけじゃなくて……私も知らないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フィアメッタ、私たちが今いるのはラテラーノ……ラテラーノの大聖堂だよ。ここはカズデルの廃墟なんかじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ちょっと休んだほうがいいよ。有給申請してきてあげようか？　使わないと期限切れになっちゃうからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……ふざけたこと言わないで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "明後日にはサミットが始まるのよ。アンドアインがサルカズを連れてラテラーノに現れて、混血のサンクタの少女をさらって……挙句の果てに執行人に手を出した可能性だってある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……うかつだったわ。あのサルカズもファボール区をよく把握していたし、きっとラテラーノに潜伏して長いはず……あの狂人ときたら今度は一体何を企んでるのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あのさ、一度冷静になりなよ、フィアメッタ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "迷い人の情報はもうヒゲ爺さんの耳に入ってるし、ヴェルリヴにも伝わってるよ。私だって昨日大聖堂でちゃんと仕事してたんだから――会議を仕事って呼ぶのはあんまり好きじゃないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "とにかく、ラテラーノは君が思ってるほど危険な状況じゃないよ。アンドアインも結局ただのサンクタであって、化け物なんかじゃないからね。本気であいつをどうにかしたいなら今は休みなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ちょっと休んで落ち着いたら、レミュアンのところに行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "どうやら完全に理性を失ったわけじゃなさそうだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "昨晩はよく休めたかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "よく休めました。泊めてくださりありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "君がここを重苦しく感じないのならば、安魂教会の扉は常に開かれているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "何せ、生者も死者もここを訪れるのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……一時的に身を置ける場所があるだけでもありがたいです。そういえば、セシリアは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "君が連れていた少女、だね？　シスターたちによると、あの子はとても深い眠りについていたそうだ。おそらく疲れていたのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "とても長い一日を過ごしたのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃん、修道士さん、おはようございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "おはよう、セシリア。元気そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うん……だって、今日はやらなきゃいけないことがあるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "やらなきゃいけないこと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……わたし修道士さんにお願いしたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ここに来た人……亡くなった人には、親しい人とお別れする儀式があるんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わたしもママと……ちゃんとお別れしたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "フェオリアさんの葬儀をお願いされてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……葬儀、ですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "旅立つ者に別れを告げることは、自身が再び歩み出すための荷造りにもなるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、僕も手伝っていいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "改めて感謝します、修道士さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "いいや、当然のことをするまでだよ。むしろ私の方こそ、光栄であると言うべきだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "この世で最も賛美されるべきは、道を踏み出す勇気なのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "この子はまだ若い。最も近しい者との別れの道は、大人ですら辛いと感じるというのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "入ってもよろしいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "あぁ、君か、ようやく来たんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "遠慮せず入ってくれ。あの子もここにいるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お歌の綿あめお姉ちゃん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "なにをっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "（小声）銃を下ろしなさい。これはただの感動的な再会の一幕にすぎない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "（小声）この大地における、数多の感動的な出会いのうちの一つでしかないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ女性",
      "text": "……あなたやっぱり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お姉ちゃん、昨日は時間がなかったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わたしお姉ちゃんといっぱいお話ししたかったんだ！　でもなぜか……みんな喧嘩し始めちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お姉ちゃんの角、わたしのパパとそっくり。きれいだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……わたしもパパみたいな角が欲しいから……ちょっと羨ましい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ女性",
      "text": "……ふふ、そう？　でもあなたの光輪もきれいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "まぶしくて夜眠れないんだよ！　ご本を読むのには便利だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ねぇお姉ちゃん、お姉ちゃんはパパと一緒の所から来たの？　どうしてパパは街に住めないの？　どうしてラテラーノにはほかにサルカズがいないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "あっ……わたしセシリアっていうの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ女性",
      "text": "……こんにちは、セシリア。私のことは……ロゼラって呼んで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……修道士さん、どうしてサルカズがここにいるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "そうだね。神聖なるラテラーノに……サルカズが足を踏み入れることは許されない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "では、セシリアは何者なのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "行こう。彼女たちにしばしの時間をあげよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……あなたたちの目的はなんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "私たちは……ただ自分の道を探しているだけさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "信心深い信徒",
      "text": "先導者様、おはようございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考える信徒",
      "text": "先導者様、あなたに敬意を表します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "微笑む信徒",
      "text": "先導者様、ご健康をお祈りします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "皆さんあなたを先導者と呼んでますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "……アンドアインだ。名前で呼んでくれて構わないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "我こそがと自惚れるつもりもないが、一人の先導者がいることで彼らが安らぎ、道しるべを得られるのなら、私は喜んでその責務を果たす……ただそれだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "だといいのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "君の懸念していることもわかるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ラテラーノに潜伏する異教組織、そして人の心を惑わす指導者が、入念に計画されたラテラーノの万国サミットで大層な陰謀を企てているのではないか……といったところかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "答えは否、私たちはただ門戸を開いているだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "忌み嫌われる者、傷付けられた者、侮辱された者、冒涜された者……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "安魂教会はあらゆる人を受け入れる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "しかし彼らは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "そう、君も私も「天使」だが、彼らは違う。サンクタの神殿や聖堂には彼らの居場所はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "あの棺桶に釘打ちをしているウルサスの老人を見たまえ。戦争で家族や友人、土地や故郷までをも失った彼は、何を頼り、何を信じ……何に安らぎと救いを見出せばいいのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼は聖歌の絶えない輝ける安楽の地の噂を偶然耳にし、長き旅路を越え、ラテラーノへたどり着いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "だがラテラーノは彼に何を与えてやれる？　非情な運命に腰を折られた異国の者を、この輝かしいラテラーノがどう癒やしてやれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "あちらで薬草に水をやっているキャプリニーの女性がいるだろう。彼女は貴族の恨みを買い、娼婦と冒涜者の汚名を着せられ、火を放たれた家から必死に逃げ延びてここにたどり着いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼女はただ平穏に暮らしたいだけなんだ。贅沢と言っても、ひとときの憩いの時間を手に入れる程度しか望まない――しかし大聖堂の偉大なる聖徒たちは彼女を姉妹と認めるだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "栄誉あるラテラーノ市民たちならば、彼らに同情の微笑みを向け、熱心に耳を傾けることもあるだろう。寛大にも財布の口を広げ、自らの慈悲深い美徳を示す者すらいるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "しかし彼らの身に起きたすべては――ラテラーノにとっては所詮対岸の火事にすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "サルカズに至っては、「呪われた魔族」、「狡猾で残忍な魔族」としか見なされず……初めから選択肢など与えられていないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼らと我々の対立は何千何百年にのぼり、有史以来、サンクタとサルカズは互いに殺し合ってきた。対立の根本原因はもはや塵に埋もれ、互いに敵視することが当たり前となっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "サルカズはサンクタのキャラバンを襲撃することに喜びを感じ、サンクタはサルカズの胸を撃ち抜くことを誇りとする。平穏な親子も異族の親子を屠り、仲睦まじき姉妹も異族の姉妹を殺すんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "我々は彼らの人物像を思い思いに浮かべる一方で、彼らの目に映る自分たちにはなんら興味を示さない。復讐に報復、それらは蓄積されて習慣となり、習慣は積み重なって伝統となる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "しかし、もし君が彼らと同じ空の下、共に暮らしていくことを厭わなければ、彼らの喜びや悲しみは我々のものと何も違わないことに気付くはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼らは再会に喜び、別れに泣き、友人をからかい、恋心に顔を赤らめる。酒を愛す者も、歌を愛す者も、信仰と共に歩む者もいる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "一体我々のどこが異なっているのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "このラテラーノでは、信仰深きリーベリの修道士がすべての戒律を遵守し、一つ一つの儀式を慎重に執り行い、聖賢と認められ、後に枢機卿に昇進したとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "教皇庁は一度として、彼らを真に受け入れたことはない。リーベリたちは俗事を解決するための小間使いであり、庶務を処理するための道具としか見なされない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "この光輪を持たない以上、彼らは……フッ、「選ばれし」サンクタではないとでも言わんばかりにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "平和で美しく、笑顔に満ちたラテラーノ……この「恩恵」は、我々サンクタだけが享受できるものなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……あなたの言葉は……信仰に背くと……言わざるを得ません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "若き執行人、君に問おう。なぜ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "なぜサンクタだけが、当然の如く祝福を受けられるのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……セシリアの正体を知ってるんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ああ、何年も前からね。サンクタとサルカズの混血……この世に本当に「恩恵」があるとするなら、まさにあの子のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……ではあなたたちがこのタイミングでセシリアをさらおうとしているのは、間もなくサミットが開かれるからですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "いや、あれは我々とは無関係だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "今になってやっとセシリアを迎えに来たのは、子供は母親のそばで成長すべきと考えていたからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "成すべきことを終えれば、我々はすぐにラテラーノを去ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……何をするつもりですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "警戒しているようだね……まず初めに、セシリアの母親の葬儀だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "あの野花が満開に咲いている場所が見えるかい。あそこが墓地だ。明日、フェオリアはあそこに埋葬される。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "すべての人間が死後平等であるなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "生前もまたそうあるべきだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "出てきてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "執行人のフェデリコか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "レガトゥス殿、あなたがサルカズにラテラーノ周辺に潜入するためのルートを提供したのではないですか？　事実ならば、あなたを教皇庁の関連機関に移送し尋問を受けていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……そんなこと言わずに仲良くしようぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "どうか公証人役場の規定に従ってください。どうしても連行を拒むつもりならば、関連規則にのっとり、一時的にあなたのラテラーノ公民の権益を剥奪します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それより教えてくれよ……法律や聖訓に基づくなら、今回の出会いをどう解釈すべきなんだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "試練か、それとも迷いか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あるいは、迷いも試練の一部にすぎないとも解釈できるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "明確な連行拒否と判断します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "残念です。どうやら平和的解決は不可能なようです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
