{
  "server": "jp",
  "storyId": "story_judge_set_1_story_1",
  "groupId": "story_judge_set_1",
  "stageId": null,
  "title": "あなたに傘を",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_judge_1_1.txt",
  "sourceHash": "83baa03cd0b0de2b0b4f0863407bb1f284e78cf2e40e094aa2f8a0179603784c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ただいま。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……ルナ？　いないの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "返事はない。しかし、ぐるりと部屋を見渡したラヴィニアは、隅のデスクにその姿を見つけた。\nラヴィニアの蔵書で埋め尽くされたデスクの上、一人の女の子がそうした本に囲まれて、突っ伏したまま眠っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "眠る少女",
      "text": "お父さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……ルナ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "ん……ううん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ごめんなさい、起こしちゃったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "あれ、私……寝ちゃってた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "そうだ、見て。この本、今日で全部読み終えたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "姉さんが残してたメモも読んで、自分の考えを書いてみたりもしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "すごいじゃない。私が学生の頃なんか一ヶ月はかかったのに、一週間で読んじゃうなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "今は学校に通ってない分、家で勉強しておこうと思ったからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ごめんなさいね……この都市はできたばかりだから、教育面を整えるのにまだ時間がかかりそうで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "出来るだけ早く、あなたを新しい学校に通わせられるようにするから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "学校がないのは姉さんのせいじゃないでしょ。気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんがあんなことをしちゃった以上、私も元の学校には通いたくなかったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "私を引き取ってくれたラヴィニア姉さんには、感謝してるんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "それは、娘の面倒を見てくれってルビオさんから頼まれてたもの。そうでなくても、あなたを路頭に迷わせることなんて私にはできないけれどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……あのね、私、本当は学校に行けなくてもいいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "だって、私があのルビオの娘だってこと、みんな知ってるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……一日中勉強漬けだったんでしょう？　そろそろ休憩しましょうか。ご飯を作ってあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "大丈夫、全然疲れてないから。私も手伝うよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……ねえ、ラヴィニア姉さん。私が料理できる理由、わかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "わからないわ。どうしてかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんは食品安全保証部長だったから、いつも市場で食材を選んでは、ファミリーの人たちにご馳走を振舞ってあげてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "だけどその時はお客さんの接待もしないといけないから、私とお母さんのご飯を作る時間はなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お母さんのほうは料理が好きじゃなかったから、お父さんが私にいろいろ教えてくれてたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "それで、家にいる時はいつも私がご飯を作ってたわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "でも正直、私は料理を作るたび、内心お父さんに怒ってたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "今もそう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まな板の上の野菜を切る、包丁の音が強く響いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんのバカ……どうしてあんなことしたの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……あなたはまだ、ルビオさんのことが許せないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "私が許そうが許さなかろうが、変わらないでしょ。お父さんはもう帰ってこないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……大丈夫よ、ルナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私がついているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "ごめんなさい……私、もう……よくわからなくなっちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……明日、サルッツォファミリーを訪ねてこの件を終わらせましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたは彼の娘なのだから、そうする権利も法的に保証されているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ただ、あなたがどうしても無理だというのなら強制はしないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんはバカだったけど、ずっとファミリーのところに置いておかせるのはかわいそうすぎるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "それに、ラヴィニア姉さんも、お父さんの件をうやむやにしたくないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "どうあれ、サルッツォファミリーには責任を取らせるつもりよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あら、今ウォルシーニで一番有名な裁判官さんじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ドン・アルベルトがいらっしゃるものと思っていたのだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ドンはもう、ウォルシーニにはいらっしゃいませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ですが、あなたがルビオ氏の遺体を回収しにいらっしゃるだろうと見越したドンから、きちんとおもてなしするようにと仰せつかっております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "とはいえ、まさか本当にルナちゃんを連れてくるとは思いませんでしたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……あなたのこと、知ってます。お父さんの部下だった人でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "覚えていてくれて嬉しいわ。遠慮なくテレサと呼んでちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "あなたはサルッツォファミリーの人なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ええ。ルビオさんもご存知だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "どうぞご心配なく、ラヴィニアさん。ドンからは円満に解決せよと指示を受けておりますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "こうして直接ルビオさんのご遺体を引き取りに来させることも、その「円満な解決」の一環だとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "そう仰らないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルビオさんの死は、サルッツォを悩ませてもいるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あらごめんなさい、ルナちゃん。あなたを傷つけるつもりはなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "私や大部分の同僚にとっても、彼は本当にいい上司だったわ。だから私たちも、彼が亡くなったことには心を痛めてるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そんな話をするために来たわけではないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ですが、あなたもこうは思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルビオさんの演説は確かに心動かされるもので、この耳には今もあの銃声が残っているけれど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あれからしばらく経った今も、結局何も変わっていない、って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "私には、すべてがこれまで通りに見えるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "一人の子供が、父親を亡くしてしまったこと以外は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ねえルナちゃん、あなたは元気にしていた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……ええ。ラヴィニア姉さんのおかげで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "そう、それは何よりね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "でも、裁判官さんは新都市の重要人物だから毎日お仕事が忙しいでしょうし、あなたとの時間はあまり作れてないんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "はぁ、ルビオさんもひどいわよね。あなたを一人残して、無駄死にしてしまうなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんの死は無意味だって言いたいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルナちゃんに嘘はつきたくないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "たとえ、新都市がベッローネの若旦那と、我らが裁判官さんに任されることになったとしても、それで何ができると思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "――裁判官さん。あなたたちは、本気でファミリーの存在しない都市を作り上げることができると思っているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私たちはあなたと議論するために来たわけじゃない。ルビオさんの遺体を引き取りにきたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ええ、それはもちろんそうよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "――お二人をルビオさんのところへご案内して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "じゃ、ついてきてもらおうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……テレサさんの言葉に耳を貸さないでね、ルナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "彼女はただ、私たちを怒らせようとしているだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "そうとも言い切れないんじゃねえか、裁判官さんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "テレサの言うことが理にかなってるかどうかなんて、当事者のあんたが一番よくわかってんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "あんたとベッローネの若旦那がどう考えてようが、俺たちにしてみりゃ、あんたらがやろうとしてることはバカげてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "くだらねえスローガンの一つや二つでファミリーを丸め込めるとでも？　ああ、それか本気でミズ・シチリアのお気に入りになれたと思ってんのかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんの死は無意味だって言いたいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルナちゃんに嘘はつきたくないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "たとえ、新都市がベッローネの若旦那と、我らが裁判官さんに任されることになったとしても、それで何ができると思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "――裁判官さん。あなたたちは、本気でファミリーの存在しない都市を作り上げることができると思っているのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "（小声）ごめんね、ラヴィニア姉さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたが理解できないのは当然でしょうね。「公平」なんて言葉、ファミリーに属する人間の辞書には、最初から載っていないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "それに、今はミズ・シチリアの力に頼らなければいけなくとも、いずれは彼女の考えも改めさせてみせるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "あんたには自信がありそうだが、お嬢ちゃんはそうは思ってないようだな。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ルナ……\nルナ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたたち、あの子に何をしたの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "いいからちょっと付き合ってくれよ、裁判官さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "一体何をしたと聞いてるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "誤解してくれるなよ。俺たちはお嬢ちゃんに何もしちゃいない。あの子が自分から離れてっただけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "で、俺たちの仕事は、あんたがあの子を見つけられないようにすることってわけさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "戻ってくると思っていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルナちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "さあ、ルビオさんの話を続けましょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "何を言っているの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "サルッツォファミリーがいつまでも現状に甘んじるような真似をすると思ってたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "俺たちは全員、ベッローネとあんた、そしてルビオを心底憎んでるんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "こんな真似をしたのはそのためだと言いたいの？　ルナを利用して私を脅迫するつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "脅迫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "チッチッ、まだ俺たちのことをわかってないらしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "あんたみたいな奴を相手にする時は、目の前で大事な人間を殺してやっても大した報復にはならねえんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "もっと特別な方法を使わないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "今頃、あのお嬢ちゃんはテレサのところへ戻ってるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "まさか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "よくもそんなことを！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "ハッハハ！　やっとやる気になってきたな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "私にはわからない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "あなたたちはどうして、そんな平気な顔でお父さんの死を語ることができるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "私たちにとって、一人の人間の死なんてごく普通のことだからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "昨日笑いあった人が、今日にはいなくなっているかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたもそのうち慣れていくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "私はそんなふうになりたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "だったら、あなたもいなくなる側の人間になるのかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたはあの銃声で、お父さんは英雄的な死を遂げたんだと誤解しちゃったんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "だけど――数日、数ヶ月、あるいは数年が経ったあと、そんなことを覚えている人なんて本当にいるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "遅かれ早かれ、それは雨音の中に消えてしまうのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "ラヴィニア姉さんは、自分が覚えているし、ずっと忘れない人たちもいるから、それで十分だって言ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたもそう信じてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "だとしたら、どうして私のところへ来たのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたも内心、相当疑問があるんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "仮にルビオさんの願いが実現できるとして、それはいつになるのかしらね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたはその日を待ち続けられる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "それとも、待ち続けたいと思ってるだけかしら？　ねえ、かわいいルナちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "さっきから、知ったような口利いちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたは、ルビオさんの言ったことを理解してなんかいないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "そもそも関心もないでしょう。まだ子供なんだから、本当の意味で理解できるはずもないものね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "私に言わせれば、あなたが本当に憎むべきなのはあの裁判官さんだと思うわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルナちゃんは騙されてるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "耐え続けるべきだとか、ルビオさんの考えは実現できるとか、彼女はあなたに嘘ばかりついているのよ。そもそもルビオさんがあんなことをしたのは、彼女にそそのかされたせいかもしれないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "正義に燃える我らが裁判官様は、一体自分の「正義」のためにあと何人の血を流させることになるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "ラヴィニア姉さんのことをそんなふうに言わないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "だけど、あなたも疑問に思っているんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "――それじゃ、取引しましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルビオさんの遺体は、裁判官さんに引き渡すわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "その代わり、今後の裁判で私たちに有利な証言をしてほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "ルビオさんの死は単なる自殺であって、サルッツォとは何の関係もないってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……あなたたち、一体どこまでお父さんとラヴィニア姉さんを侮辱すれば気が済むの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "侮辱？　私は事実を述べているだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたは、自分を置いていったお父さんを恨んでないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "それが何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "確かにお父さんのことは恨んでる。私を一人残して死んじゃったんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "でも、もっと恨むべきなのはあなたたち――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんを死なせた、ファミリーの連中でしょ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ルナはすさまじい勢いでリュックからクロスボウを取り出すと、テレサへと向けた。\nその矢を向けられてもなお、テレサは笑みを浮かべている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "最初から……ルナちゃんに、テレサさんを殺させようとしていたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そんなふうに仲間を使い捨てるなんて、どうかしてるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "どうかしてる、だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "そいつはルビオのほうだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "自分の叶いそうもない夢なんぞのために、ファミリーの全員を巻き込みやがったんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたたちはルビオさんのことを何もわかってない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "そりゃあな。だが、こういう時の対処法はわかってるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "あんたを殺すつもりはねえ。とはいえ、邪魔をさせる気もねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "事が済んだら、テレサの死体を片付けて俺らの仕事は終わりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "どうしてテレサが死ぬと確信しているの？　まさか、彼女は最初からファミリーのために死ぬつもりで……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "あいつは運が悪かったのさ。ルビオの部下だったせいでこんな目に遭ってるわけだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "だが、テレサが死ねば、あいつの弟と役立たずの父親は生き永らえる上に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "ファミリーに栄誉をもたらすこともできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "上手くすりゃ、あのお嬢ちゃんが将来テレサと同じような役割を演じてくれるかもしれないときたら、いい話だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あの子は何もしていないでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "かもな。だが、こっちは最初からあんたを狙ってこうしてんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "これまであんたはベッローネの庇護を受けていた。おかげで俺たちも、あんたのやることを見逃してやるしかできなかったが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "ベッローネがなくなり、ベルナルドも死んだ今、本気であんたの好きなようにさせるとでも思ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "恨むなら自分を恨むんだな。あのお嬢ちゃんをそばにおいとくべきじゃなかったのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そこをどきなさい――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "やれやれ、さすがは多くのファミリーを震え上がらせた裁判官だ。戦いの腕もバカにならねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "とはいえ、今はあんた一人だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そうでなかったとしたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "何――？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ラヴィニア、無事か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "レオン！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "これはこれは。ヌオバ・ウォルシーニの有名人、レオントゥッツォの若旦那じゃねえか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "それとも、レオントゥッツォ議員って呼ぶべきか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "好きにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "どうしてここに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ルビオの遺体を引き取りに行くと聞いたからな。状況把握のために人員を送り込んでいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "行ってくれ、ラヴィニア。事情は大体わかってる。こっちは俺に任せておけ。あの子供を救えるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "あんただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "レオントゥッツォ、お前一人増えたところで何ができる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "こうして来るからには、相応の準備をしてきたさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "チッ、テキサスまでいやがる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "過激なマフィア",
      "text": "奴らを止めろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "こっちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クロスボウの矢が、テレサの服の裾を釘付けにした。\nルナはじっとテレサを睨んでいたが、テレサはなおも笑みを浮かべ続けている。"
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "狙いは悪くないわね。この瞬間を何度も想像していたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "黙って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あら、いい顔するじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "その目を見ればわかるわ。あなたが本当はこちら側の人間だってことが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "いいえ、こちら側じゃない人間なんていないって言うほうが正しいかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あの裁判官さんは、本気で自分は他人よりも高潔だなんて思っているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "自分の手が、どれだけの人の血で汚れているかわかっているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "それに、あなたのお父さんだって、あの放送では随分と自分を美化して語っていたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "一体、どれだけの人を見殺しにしてきたのかしらね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "私には理解できないわ。手を汚していない人間なんて誰もいないというのに、そんな手で綺麗な家を建てられると思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんの手も、ラヴィニア姉さんの手も、汚れてなんかない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "これ以上二人を侮辱しないで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ルナがテレサにクロスボウを向け続けても、彼女は少しもひるまない。"
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "侮辱ではなく――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "事実を述べたまで、とさっきも言ったはずよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "あなたが本気で、ルビオさんを死に追いやったファミリーを恨んでいるのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "今こそが、その恨みを晴らす絶好のチャンスよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "できないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "お父さんへの気持ちはそんなものだったってことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "黙ってよ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ルナ、やめなさい！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鋭利な矢じりがラヴィニアの肩を貫いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "ラヴィニア……姉さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "どうして……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "ごめんなさい……私……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "どうしてあなたが！？　向こうの人たちは一体何をして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "職員テレサ",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "落ち着いて、ルナ。武器を降ろしてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラヴィニアは肩を押さえながらも、ゆっくりと、しかし着実にルナのほうへと歩いて行く。\nパニックを起こしたルナは後退りしたが、それ以上どこへ逃げればいいかはわからなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "……やだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "この人はお父さんを侮辱したの。お父さんの死はまるで無意味だなんて言ったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "それに姉さんのことだってバカにした。姉さんのやってることにも意味はないって言ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "こんな人、死ぬべきでしょ！　この人と同じファミリーの連中だって全員死ぬべきなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "この手の人間は、いずれ相応の罰を受けることになるものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "けれど、あなたが手を下してしまえば、すべてはそこで終わってしまうの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私からあの本を借りたのは、公正に人を裁ける人間になりたいからじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "手を下したらいけないことくらい、わかってるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "でも……それでも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "毎晩お父さんの夢を見るの！　それで、あの銃声が聞こえて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "もうどうすればいいかわからないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "勉強に集中して忘れようとしても、忘れられないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "どうしても忘れられないんだよ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……忘れられる人なんて居ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だけど、私たちが一時の衝動に任せて、すべきことや進むべき道を見失ってしまうのは、ルビオさんが一番望まないことだと思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あの人は、たった一度のチャンスを待って何十年も耐え続けた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "もしかすると、あなたには自分と同じ道を歩んでほしくないと思っていたかもしれない。でもだからといって、私はあなたの手が血に染まるのを見過ごすわけにはいかないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "だけど、私には我慢できない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "そんなに長くは待てないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "お父さんは皆が思ってるような人じゃないってこと、皆に知ってほしいのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "必ずその日は来るわ。私が約束する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "その日が来るまで、私がずっとあなたのそばにいるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "たとえこの大地に、ルビオさんの話を信じる人がほかに誰一人いなかったとしても、私は信じて戦うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だってそれは、私の一番最初の夢でもあるんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラヴィニアはルナに歩み寄り、涙を流す彼女をしっかりと抱きしめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "どうしても我慢できない時は、私が話を聞いてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "愚痴でもなんでも聞いて、一緒に泣いてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そうして大人になったら、一緒にお酒を飲んで、不満や文句を吐き出して、一人では背負いきれないことも分かち合いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "わたしに……本当にできるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "もちろんよ。ただし、忍耐強くあろうとすることを学んでいくと約束してね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "腹立たしいことがあっても、それを抑えて振舞えるように努めないといけないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "できるわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "そうしたいって思ってたの、本当に、そうしようって……でも、私……ごめんなさい、ごめんなさい……う、うわああん……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "わかってる。全部、わかってるからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クロスボウが手から滑り落ち、それを握りしめていた両手は今や、ラヴィニアに抱き着いている。\nその目からは涙が再び零れていたが、今度の涙は怒りを洗い流し、憎しみを少し薄めてくれるようなものだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "泣き声は、しばらく時間が経ってようやく止まった。\nラヴィニアはルナの涙を拭いて、気絶したテレサを担ぎ上げると、ルナと共にその部屋を出た。\nそして道中、ふと何かを思い出したかのようにこう言った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……本当にごめんなさい、ルナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "何のこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私もルビオさんも、意図的にせよそうでないにせよ、あなたに自分たちの理想通りでいるように求めてしまっているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "これまで色々な人に会ってきたから……正義や公正だけが、人々にとって唯一の道ではないということはわかっているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "けれど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ずっと昔、私が仕事を始めて間もない頃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "当時の私はあなたと同じで、ファミリーの連中に、何もかもが奴らの思い通りになるわけではないことをわからせてやりたいと思っていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そうしてある日、無防備に路地へ足を踏み入れたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "とある人が助けてくれなかったら、私はあの時そこで死んでいたのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だけど私は、このまま彼の背後に隠れているだけでは、今後の人生を自立して歩んでいくことはできなくなるかもしれないと思ったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そんな時に彼が渡してくれたのが、いま私が身に着けているこのガントレットとガベルなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だからこの武器を身に着けて、一人で路地の奥へ進むことにした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "今思えば、きっとそれが彼自身の望みでもあり、私に望んだことでもあったのだと思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ファミリーの人間というのはいつもこんなふうに、一人の人間の死や、一つの勢力の消滅を、問題解決のために起きた必然的な結果としか思っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "暴力に基づくこのサイクルが、彼らの存在の基盤なのだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "これまで長い間、多くの人が雨の夜、暗い路地裏へと入っては、そこで命を落とし、あるいは生き延びてもその手を血に染めてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そうして彼らは、さらに奥へと進んでいって、次第に自分が路地にいることすらも忘れ、ついにはこの狭い路地を開けた大通りであるかのように錯覚してしまうのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "シラクーザは、そんな狭い路地が迷路のように入り組んだ場所。たとえ出口が見えたと思っても、そこは別の路地でしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そして、この迷路の中にいる人々には与えられた選択肢は、そう多くはないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私のような人間かファミリーかのどちらかしか選べないのだとしたら、私はどんな手を使ってでもあなたをそばに置きたいと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だけど、あなたは私のようになる必要はないし、私もそんなことは望んでいないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたをこの迷路から連れ出すことが、私の望みなのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルナ",
      "text": "迷路の外には、何があるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "道よ。大きく開けた、たくさんの道が待っているの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
