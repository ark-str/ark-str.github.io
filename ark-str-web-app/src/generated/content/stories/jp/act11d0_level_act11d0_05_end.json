{
  "server": "jp",
  "storyId": "act11d0_level_act11d0_05_end",
  "groupId": "act11d0",
  "stageId": "act11d0_05",
  "title": "冬霊挽歌",
  "storyCode": "TW-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act11d0/level_act11d0_05_end.txt",
  "sourceHash": "fa90ce9551f929005233eacf5e7ba5d29b5247603146d6281718b89656be86b0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 5下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "早く！　こちらへ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "ありがとう、ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "フォリニックお姉さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "リサ！　住民たちを連れて先に行って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "きゃあっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "あの暴徒たち……街に無差別攻撃を仕掛けてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者A",
      "text": "おい！　やっとの思いでこいつを奪ったんだぞ、もっとしっかり撃てよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者B",
      "text": "黙ってろ！　こいつの操作はそんな簡単じゃないんだ！　クソッ、音楽学校で勉強したってのに――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者A",
      "text": "はぁ？　音楽学校でだと！？　おい、憲兵！　あんまり軽率なことはしないほうがいいぜ、こっちには人質がいるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者B",
      "text": "人質？　どこにいるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者A",
      "text": "*リターニアスラング*！　街で逃げ回ってる奴ら全部だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "チッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "フォリニックさん！　このまま街を破壊され続けるわけには！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "この周辺の家屋はどれも木造です。これでは一帯が火の海に――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "火だ！　早く消さないと！　他の人たちは早く逃げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "逃げ遅れた住民を助けなければ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "でもこの炎じゃ近づけない――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "――ううっ、この火力……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "フォリニックさん！　怪我人をお願いします！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ちょっと！？　タチヤナさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固な住民",
      "text": "冬霊人たち！　感染者たちめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固な住民",
      "text": "なんで俺の家を燃やすんだ！　俺たちがお前らみたいな害虫を養ってやってたってのに――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "上っ！　危ない！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固な住民",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "頑固な住民",
      "text": "う……あ、タチヤナ？　ぶ、無事か！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "ううっ……はい。彼らはあの自律式アーツユニットをコントロールしきれていません、ここは危険です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固な住民",
      "text": "一緒に戦おう、タチヤナ！　奴らを追い出すんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "今はまだ――その時ではありません！　ぐっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頑固な住民",
      "text": "えっ、お前、足を――！　わ、わかった、言うことを聞くよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "ありがとうございます。まずはここを離れましょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "（くるぶしが痛い……骨折してるかもしれない。なんてこと……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "（早く他のみんなと合流しないと……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "この、貴族の回し者め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "――！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……全員撤退したか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "は、はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "セベリン憲兵長、負傷者が多すぎます、もう手が回らなくなりそうです……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "医者はこちらのヴァルポのお嬢さんの指示に従え、怪我をしていない若者たちは手を貸すんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "わかりました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "ああ、もしフォリニックお姉さんがいてくれれば……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "待て……彼女たちはまだ戻ってきていないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "おい！　フォリニックさんとタチヤナはどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "ま、まだドデカフォニー通りにいるかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "――さっき「全員撤退したか」と聞いただろう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "はい！　す、すみません！　ですが、フォリニックさんもタチヤナさんもきっと無事です！　だって、これだけ多くの住民を救ったんですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "反乱者が市街防衛設備を占領したんだ、正規の武装戦力を持たない彼女たちが無事であるはずが――ゴホッ、ゴホゴホッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "――ゴホン、何人かガタイの良い者を集めろ。ドデカフォニー通りに行くぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "待ってください！　反乱者には火力の優位がありますし、既に人質がとられている可能性もあります。これ以上刺激せず、交渉のチャンスを待つべきです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "チャンス！？　敵がチャンスをくれると思うのか？　お前は戦場に出たことがあるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "も、申し訳ありません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "彼の意見が全部間違ってるとは言えない。ウォルモンドの基礎エリアには、大裂溝が残した活性源石が残っている可能性が高いわ。その源石に刺激が加わったらどうなるか……想像したくもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "誰だ、どこから入ってきた！？　関係者以外はここから出て行け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "今の状況では、憲兵隊を連れていない私たちの方が、出ていくべき存在なのかもしれん……君には会ったことがあるな、ロドスのオペレーター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "話を聞いてくれるのね。良かった。エアースカーペ、お願い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……簡単な現場検証の結果だが、もし彼らがあの装置で街を破壊し続けたら、ウォルモンドは十分から三十分程で座礁する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "一番良いのは、あの通りと市街エリアの連結を断ち切ってしまうことだ。しかしウォルモンドは移動都市と違って、自律的に移動する動力を決定的に欠いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ああ、牽引機を使えばなんとか動かすことは可能だろうが……それも街に反乱軍がいないことが前提だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "武装介入するには、何か手続きが必要？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……いや、必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "お二人とも……タチヤナとフォリニックさんの救出をお願いできないだろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "セベリン憲兵長――ここには――あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……リサ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "あ……グレースロート先輩……あの、こちらは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "オペレーターのエアースカーペ、天災トランスポーターレオンハルトの護衛だ。当人は別の任務があるとかで、俺だけがここに送られた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "リサ、アントとフォリニックは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "フォリニックお姉さんはまだ街にいます！　ア……アントお姉さんは……あの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "もうわかった、無理して言わなくていい。確認しただけだから……詳しい話はまた後で聞く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "……うう……せ、先輩たちが助けに来てくださって、本当に良かったです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "――ダ、ダメ、まだ気を緩めちゃダメです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "負傷者は私がお世話するので、フォリニックお姉さんたちをお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "ええ、任せて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "あんな小さな子どもも……オペレーターなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "アーミヤもリサと大して変わらないわ、忘れないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "今回の救援に関しては完全に想定外だ。何の防護設備も持ち込んでいないが、大丈夫か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "――意外だな。グレースロートは源石や感染者問題に関わりたがらないって聞いてたから、心配してたんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……何回も同じような悲劇が起きるのを見たくないだけ。とにかく今は救援が先よ。無駄話は止めましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "この状況でまだ突っ込んでくる勇気があんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "この二人、早いぞ！　さっさと片付けろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "現地の住民も多いようだが、いいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "極力急所は狙わないで。行くよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
