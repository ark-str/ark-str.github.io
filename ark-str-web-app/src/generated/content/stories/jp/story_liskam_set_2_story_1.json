{
  "server": "jp",
  "storyId": "story_liskam_set_2_story_1",
  "groupId": "story_liskam_set_2",
  "stageId": null,
  "title": "待つ",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_liskam_2_1.txt",
  "sourceHash": "b53c3404f3996002b54c65b767000451664f72685de38031871aa97ee70a8b59",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 雷蛇2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私の……出身部族について、ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん、もし気に障ったらごめんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "特別なことはないですよ。何か知りたいことでもあるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ええ。実は最近……少し調査をしているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私の部族と関係があることで、ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "でも、私の部族は、よそと関わりを持ったことはほぼないと思います……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私が家を出て外で生活している間、旅の途中に通りかかった傭兵や商人すらほとんどいませんでした。そもそも関わりを避けようとする他の部族は言うまでもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしが知りたいのは、まさにそのヴイーヴル連合管理区の外で、バニラがどんな生活をしていたかってことなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それについての文献の記載には限りがあって、混乱した情勢では、各部族のことを色々聞くのは難しい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "バニラが言ったように、これらの部族は世間とはかけ離れた環境で生活をしているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私は構いませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "でも、リスカム先輩はどうして、そんなことに興味を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私に思いつくのは、果てしない砂漠と、乾いた空気、少ない食糧、そして生き残るための技術だけですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そういうことを聞けるのも助かるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "えっと、他意は本当にないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ただ調査と記録をするために知りたいだけ……ヴイーヴル連合に関するすべてを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "まさか、リスカム先輩はヴイーヴルに帰るつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "い、今のところそんなつもりはないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "今後に関しては……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それはともかくとして、バニラの部族の食習慣や調理の方法、訓練のやり方、それと何か飼ってたなら目的や飼育技術を詳しく教えてほしい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ご、ごめんなさい。おケガはありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "大丈夫です、そう簡単にケガはしません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "って、あれ？　ジェシカ先輩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あっ、バニラちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "先輩はこれから任務ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そうじゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リスカム先輩にお借りしてた本を返そうと思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "本？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "いいなぁ……ジェシカ先輩やリスカム先輩はたくさん本を読むんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私は、こんなにたくさんの文字を読むのは、今でもなかなか難しいです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "どんな内容の本なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ヴイーヴルに関する本だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ヴイーヴル？　どんな話ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あっ、もしかして、大昔から伝えられている『ヴイーヴル耕作養殖方法』とか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "残念ながら違うかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "この本は、ヴイーヴルの戦争時代を舞台にした恋愛小説だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ヴイーヴルの……恋愛小説？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "戦火が飛び交う……停滞した戦況……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "傭兵組織の勢力が拮抗する混乱した時代、ヒロインが愛のために、恋人の傭兵部隊に一人で飛び込み、駆け落ちを認めてほしいと隊長に懇願する……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "それって現実にあったお話ですか？　だとしたら、どこの傭兵部隊でしょう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "多分、題材を借りてきただけだと思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "珍しいですね。皆さんの想像するヴイーヴル人って、だいたいが図体がデカくて頑丈な傭兵なのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ヴイーヴルの物語に興味を持つ人なんていないと思ってました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そんなことはないよ。わたし、この本はよく書けてると思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "機会があれば、実際にヴイーヴルに行ってみたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "バニラちゃん、ヴイーヴルに旅行に行くとしたら、何に気をつければいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ヴイーヴルに旅行に行くんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ……おかしいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "もしジェシカ先輩が「地獄」を体験したいっていうなら、護衛しないこともないですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ……そんなに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私が暮らしてた場所は「トイレ」や「バスルーム」、「キッチン」といった概念すら存在しないような、とてつもなく広い砂漠でしたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ううっ、そんな生活はちょっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あっ、そういえばリスカム先輩はヴイーヴル連合の管理区から来たそうなので、そっちの方だったら旅行にはいいかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ただ、私が住んでいた場所の敵は大自然でしたが、そちらはもっと混乱した社会が敵かと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "管理区が外よりも混乱している？　これは、小説に描かれてなかったことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "正直に言うと、管理区内で何が起きてるかは、私も知らないです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "この前リスカム先輩に尋ねられて、故郷の話をした時に、先輩もただ「あんまり平和じゃない」と言っただけでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "私は幼少期を部族で過ごして、生きるか死ぬかというのも経験しましたけど、基本的には割と自由だったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "大人たちは、ヴイーヴルの現状はひどく混乱しているって言ってましたけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "うーん……詳しいことは私も分かりません……こういうことはやはりリスカム先輩に教えてもらった方がいいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "少し前にも私のところに来て、部族のことを尋ねられたのでお話ししました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ、そうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "リスカム先輩なら私よりももっとわかりやすく話してくれると思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あ、でも、その本の「恋愛」に関する部分は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "機会があれば、また話していただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "バニラちゃんも興味ある？　そういうことなら喜んで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小説を読んだせいなのかな、ヴイーヴルに対する好奇心がいっぱいだよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（でも……バニラちゃんは、ヴイーヴルのことをあんなふうに思ってたんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小説で描かれているよりも、ずっと残酷な気がする。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（リスカム先輩は……自分の故郷を、どういうふうに思ってるんだろう？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ジェシカです。リスカム先輩、失礼します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "先輩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いるよ、入って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "髪を乾かすから、ちょっと待ってて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（前に来た時よりも本が積まれてる気がする……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（しかもレポートもこんなにたくさん……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（リスカム先輩は実力だけじゃなくて、知識の蓄積も際限がない。それにいつもすごく真面目だし……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あれ？　このレポートは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "『ヴイーヴル連合における各傭兵組織の知名度および評判の考察』……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あとこれ、『ヴイーヴル地域における各部族の概况』……これ！　見つけた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "え？　何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わわっ！　ご、ごめんなさい先輩、わたし勝手に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ふぅ――さっきトレーニングを終わらせて、ちょうどシャワーを浴びてたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカは……えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしは以前、お借りした小説をお返しに来ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そうだったんだ。テーブルに置いてくれればいいよ。自分で整理するから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ん？　この本は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "な、何か問題でも……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うーん……いや、きっとわたしの勘違いだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカがわたしから借りていって、返しに来てくれたのなら問題ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ありがとうございます、先輩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……まだ何か気になることでもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたし……あの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そんな堅苦しくつっ立ってないで、とりあえず座りなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ここはBSWじゃないんだから、そんなに礼儀正しく振る舞わなくても大丈夫だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしたち友達でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リスカム先輩……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "やっぱり、わたしの言葉は信じるに値しない、か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ、そんなことありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "プッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカはいつまでも変わらないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "頑張って変わろうとはしてるんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わかってる。昔と比べると、ジェシカは自分の強い一面をだいぶ出せるようになってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "驚いた時のオーバーリアクションってのは、やっぱり前のままだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ううっ、どうしてリスカム先輩までフランカ先輩と同じことを言うんですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしはあそこまでいい性格ではないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "確かに……あ、いえ、今のは違います！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "フランカ先輩も性格が悪いわけではないですよ？　ただいつも、急にイタズラをしてくるってだけで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――それに冗談もつまらないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……コホンッ、まあ、この場にいないフランカを悪く言うのはやめておこう。ジェシカも返しづらいしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "で、さっきはどの本に興味を引かれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "どの本というか……わたしは、ヴイーヴルのことについて知りたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ヴイーヴルのこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "この小説を読んだら、物語の背景をもっと知りたいって、そう思ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リスカム先輩も、ヴイーヴルの地域や組織については、前から関心を持っているんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "え？　どうして知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "すみません、さ、さっきテーブルにあるレポートのタイトルが見えてしまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それに、聞くところによると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……まあ、大して特別な資料でも何でもないんだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "これはわたしの個人的な……習慣かな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしはヴイーヴルの出身だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "故郷を離れてから、自分の故郷が直面している複雑な状況を、ようやく理解し始めたんだ。よその人から見て、それが何を意味してるかってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ただ、ヴイーヴルの現状に対して、今のわたしにはどうすることもできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "自分の能力を尽くして、より多方面から理解し、これから何ができるかを考えることしかできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "確か、リスカム先輩はBSWにいた時、わたしに言ってくれましたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ヴイーヴルには、他と異なる警備会社が必要だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "今思うと、BSWに身を置いているのにあんなことを言うなんて、我ながら本当に軽率で甘かったと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わ、わたしはとても立派な理想だと思いました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それに、リスカム先輩は装備部からわたしを見つけてくれて、お二人の小隊に誘ってくれたじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "先輩のアドバイスがあったからこそ、わたしはロドスに来て、こんなに変わることができたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "当時のわたしは夢どころか、心置きなく話せる友達一人を作ることすら難しかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしはずっと先輩に感謝してるんですよ。バニラちゃんがフランカ先輩に見つけてもらったのと同じように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "バニラはフランカが新米たちの中から見つけたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしはただBSWの人材データを簡単に選別しただけ。ジェシカは優秀だったからすぐに目に付いたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "こんなに優れた人材、装備測定部で遊ばせておくなんてもったいないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "過ぎ去った日々も、思い出の一部……ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "今振り返ってみても、やっぱり幼稚だったと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "BSWのやり方を完全に理解すれば、自分ですぐにでも警備会社を興せると思い込んでた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ここ数年、わたしはずっとBSWの発展だけを注視していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、そういった志があったなら、リスカム先輩はどうして生体部門に行ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……自分の中にネックがあったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "今はもう分かっているけど、当時はそうじゃなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "自分が理解している「平和」と、BSWの要求する行動の間に差があると感じてて、任務中ずっと戸惑ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ロングフェロー博士に生体部門に行くように言われてなかったら、いまだに矛盾を感じたままでいたかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカ、あなたは……ロドスに来たことをどう思ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わ、わたしですか？　わたしはとても光栄なことだと思ってます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リスカム先輩とフランカ先輩と引き続き一緒に仕事ができますし、それに、ロドスに来てから、わたしも随分と変われた気がします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "BSWにいた時は、腹を割って話せる人なんていませんでしたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ロドスにはわたしの話に耳を傾けてくれる人もいますし……支えてくれる人もたくさんいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ロドスに来たことはわたしにとって、絶対に、とてもいいことだったと思っています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん、そうならよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "先輩はどうなんですか？　そういえば、リスカム先輩とフランカ先輩は一番最初にロドスに来たBSWのメンバーでしたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ゴホンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そ、そうだね。当時は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの時は突然いなくなられて、わたしとても怖かったんですよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "先輩たちは、わたしたちを見捨てたんじゃないかって心配してました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "後になってから、リスカム先輩がフランカ先輩と同じように、ロドスに派遣されたと知りました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "仕方なかったんだよ。わたしのパートナーはあいつ一人だったんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それにあの時はBSWのああいうやり方を理解してなかった。きっとジェシカよりも戸惑っていたんだと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "自分の理想も……しばらくは保留にしてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "まさか、BSW内には知られざる何かが……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そんなことはないよ。BSWはいい組織だと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ただ……いつからかはわからないけど、自分の考えが変わり始めたんだと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "BSWの理念は他の傭兵組織とは全然違うと思ってた。ヴイーヴルで野放図になっていた傭兵たちをまとめ、生活状況を改善させる最善の方法だと思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも、理念と現実は別物だった。原則と行動が常に完全に一致するわけでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わ、わたしも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "BSWが受け持つ業務で、表面上は各地域の平和を維持できるのだと思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でもロドスに来てから、もっと深刻な状況がたくさんあるんだと知りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "だから、昔描いていた短慮な構想を、わたしはそう簡単に口に出せなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ただ単に就職の機会を増やすだけの警備会社よりも、使命と責任の方が重要だと気が付いたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカ、ヴイーヴルの今の膠着した戦況と、政府の横暴について聞いたことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "以前、噂程度に聞いたことがあるだけです。でも、この小説を読んで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしはもっと知りたいと思いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ヴイーヴルの現状に対して、周りが何もできないとわたしは思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも故郷を離れてBSWに入ってはじめて、ヴイーヴルがどんな状態にあるかを理解している人がほとんどいないと気付いた。そもそも……気にしている人がいないんだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも、自分の故郷には安全な場所になってほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ヴイーヴル人が自分の故郷に喜んで帰ることができて、よその警備会社の力を借りなくても、自分たちだけで団結して防衛できる場所にしたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "じゃあリスカム先輩が酔っぱらった時に「ヴイーヴルには平和をもたらす警備会社が必要だ」って言ってたのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あれは酔っ払いの戯れ言だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ヴイーヴルの資料は……最近になって整理し始めたものだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "資料を集めるのはただの習慣で、立派な夢なんて持ってやっているわけでは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……もう、からかわないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そんなことしませんよ！　リスカム先輩がやりたいことなら、きっとできるはずだってわかってます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……BSWでもロドスでも、わたしが先輩と知り合った日から今まで、一度だって先輩が怠けてる姿を見たことはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ロドスに来てから、フランカ先輩とお酒を飲んで騒ぐ回数は増えたみたいですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それに関しては全部あいつのせいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "融通の利かない性格を直してやるとか言って、結局あんな方法を使うなんて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、リスカム先輩、今は充実してませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "よく笑うようになった気もします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしは、フランカ先輩とロドスの環境が、とてもいい変化をもたらしてくれたんだと思ってました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あいつは、感染者にはなってしまったけど、それでも自分の人生を充実させようとしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "真剣になるべき時は真剣になり、楽しむべき時は楽しんでる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もしずっとBSWに残っていたら、感染者になったメンバーを、ロドスみたいに扱ってくれることはなかったと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ましてや誰かとコンビを組ませて任務に行かせるなんてね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "感染者になっても、フランカは自分の未来をいかに過ごすべきか、すぐに考えることができた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でもわたしは……まだまだ、未熟だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でも、リスカム先輩は目標を見つけたんじゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "故郷に帰って、ヴイーヴル地域に平和的な変化をもたらす……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リスカム先輩なら、きっとわたしよりもたくさんの考えをお持ちのはずです。わ、わたしはそう思います！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしはまだ……そこまで強くなれていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "今のわたしはフランカほど、目標が明確じゃないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "自分の力で組織を立ち上げ、リーダーとなる。これをどうやって実現すればいいのか、なったとして、それから何をすべきなのかまだ全くわかってない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも、わたしの力でヴイーヴルの現状を変えられる可能性は、きっとあるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしはそう思ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "きっとそうですよ！　わたしもそう思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "バニラちゃんが言ってました。ヴイーヴルには、たくさんの特別な踊りや食べ物があるって。僻地の部族での生活は、粗末だけど……皆さん生活に希望を抱いてるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どうやら、ジェシカは本当にヴイーヴルに興味を持ち始めたみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "だって……このヴイーヴルを舞台にした小説、ストーリーも主人公もすっごく印象的ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしは、ヴイーヴルの物語は、きっとこれからもっと多くの人に好かれると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わ、わたし、本当にヴイーヴルに旅行とか行ってみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もちろん……わたしが「護衛」してあげられる時間があれば、案内してあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リスカム先輩もそんなこと言うんですか……ううっ、ヴイーヴルは本当にそんな恐ろしい場所なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "今は、確かに危ないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "強盗程度ならまだなんとかできるけど、もし傭兵同士でやり合いでもしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ、そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも、ヴイーヴルはいつかきっと、ジェシカにとって行く価値のある場所になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "専属の護衛を雇う必要なんかなくて、気の赴くままに、村や、雄大な荒野や都市の中を歩くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そんなことができるような場所にするために……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "（あくび）ハロー、リスカム？　いる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカ、なに勝手に入って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "何を書いてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "勝手にわたしのレポートを見ないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ん？　この本は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "勝手にわたしの本棚をあさらないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "『ヴイーヴルの恋』……あっ、これって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "やっぱり、フランカのものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "これって、あたしが貸してあげた恋愛小説でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……やっぱりあなた、気にしてなかったのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "これは感動ものよ。誰かと感想を話し合いたかったのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "貸してあげたっていうのに、読んでくれなかったじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカがわたしのところから借りていって、さっき返してきたばかりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ならジェシカと話そーっと。もうあなたみたいなつまらない人にはお薦めしてあげないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フィクションなんて、絶対読まなきゃいけない理由はないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "これは今、大人気になっている女傑の愛の伝記なのよ！　しかも珍しくヴイーヴル地域を舞台にしてるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "うーん、確かに本場の人にクルビア人の作者が書いたヴイーヴルの本を読ませるなんて、少しおかしな気もするんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "でも、本の中の実際とは異なる部分に対するあなたの批判を聞いてやろうと思っていたのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "少なくとも、フランカの一番好きな、手紙のやり取りをするシーンは絶対にありえない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "チェッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも……ジェシカも小説を読み終わった後、ヴイーヴルの地名や苗字をいくつも言えるようになったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それにヴイーヴルでの出来事に興味を持ったとかで、わたしの研究レポートをたくさん持って行った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "小説にはそういう不思議な力があるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "新しい文化テーマとして、研究を検討してみてもいいかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなたにはやっぱりロマンの欠片もないのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ただ題材の好みが違うだけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もしSFが題材なら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "恋愛が登場しないやつね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……武器や装備の研究をして何が悪い！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "というか、今日は何しに来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "うーん……なんでだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "冗談よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "オリジムシ変異に関する新しい任務が来たわよ、リスカム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしが一人で行ったり、この件をあなたに黙ってたりしたら、あなたはきっとぷんぷんに怒っちゃうんじゃないかなーって思って、わざわざ誘いに来てあげたんだけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "どう、あたしと一緒に行く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "（スーッ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "（フーッ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "このレポートもちょうど終わったところだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "うんうん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "なら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "時間を無駄にはできない。すぐに出発しよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
