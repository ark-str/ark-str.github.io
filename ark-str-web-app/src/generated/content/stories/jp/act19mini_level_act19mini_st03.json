{
  "server": "jp",
  "storyId": "act19mini_level_act19mini_st03",
  "groupId": "act19mini",
  "stageId": null,
  "title": "石ころの一生",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act19mini/level_act19mini_st03.txt",
  "sourceHash": "0358d810fb0f2f65017092d3f0ebe347d6e7b8e8d64a29607de4cd738df38fac",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "わあ……綺麗な石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "模様がすっごくきれいで、つるつるしてる。持ち帰って彫ってみたら、市場でけっこう高く売れるかも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "ぼく……その石を返してはくれないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "返す？　これ僕が拾った石だよ、なんで返さなきゃいけないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "それは私が庭園の飾りに使うために、苦労して探してきた石なんだよ。持って帰る途中に、ここでうっかり落としてしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "それを返してくれたら、庭園の手入れが終わった後に君を招待してあげるよ。どうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "そんなの知るもんか……お兄さんが自分の物だって言ったら自分の物になるってこと？　この石は元々ここにあって、僕が先に拾ったんだ。だから僕の物だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "う～ん、困った子供だ。まるで話が通じないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "仕方ない。じゃ、これならどうかな？　他の良いものとその石を交換してあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "石を返してくれるのなら、値段は好きに言ってくれていいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "ほんと……？　じゃあ百……いや、千でも……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "それどころか、百万や一千万、一生遊んで暮らせる額でも構わないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "交渉成立かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "いや……やっぱりダメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "誰だってみんな、得をしたがるものでしょ。そんなたくさんお金を出してまで欲しがるなんて、きっとこの石にはもっとすごい価値があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "だったらなおさら大事に取っておかなきゃ。この石に一体どれだけ特別なところがあるのか、確かめてやらなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "君、存外賢いね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "ま、いいよ。それほど急いでるわけでもないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "君が売る気になった時に買いに来る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "バカげてる……まったくバカげてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "あのじじい、死ぬ間際にまで面倒事を残していきやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "そんなこと言わないで兄さん。父様の身体は日に日に弱っていて、もう長くはないんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "私たち、普段ろくに親孝行もできてないのだし。父様の最後の願いくらいは、なるべく叶えてあげましょうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尊大な男性",
      "text": "弟よ、今のは妹の言葉の方に理がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尊大な男性",
      "text": "百善、孝を先とす。お前は栄達したが、だからと言って人としての本分を忘れてはいかん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "ああそうかよ。お前ら今になって親孝行だなんだと言ってるが、親父が倒れてから、家であれこれ世話してやったのは誰だと思ってやがる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "たかが石ころ一つ失くしただけで大騒ぎしやがって。もし俺がそんなくだらないことで百灶の役所に訴えてみろ。大理寺に業務妨害でしょっぴかれるかもしれないんだぞ。それでもやれってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "そもそも……うちにそんな石なんてあったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尊大な男性",
      "text": "さてな。うちにどれだけ財産があるか、一番よく知ってるのはお前じゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "ハッ！　なんだ、まるで自分はさらさら金に興味なんてないって言い草だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "ここ何年もずっと音信不通だったくせに、親父が倒れた途端急に顔を見せるようになりやがって。腹の内がバレてないとでも思ってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "もう、ケンカはやめてよ。何もできないならせめて邪魔しないでくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "ちょうどあの天師が通りかかったから石を探してほしいとお願いをしてあるの。彼女が見つけてくれるのを待ちましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "旦那様、こちらは天師府の天師で、大理寺の少卿も務めておられた方です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "我が家の探し物に協力してくださるそうです。例の石について話していただけますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "……ふん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "うちの腑抜けどもときたら、真面目にやるということを知らん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "あいつらに言っておけ。私の石を取り戻せなければ、遺産はびた一文くれてやる気はないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "石を取り戻した者がいれば、その者に私の財産を半分やろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "あなたが万（ワン）さんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "失くされたのは、どのような石なのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "私が子供の頃に川の中で拾った、この世に二つとない石だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "お尋ねしたいのは、その石はどのような品かということです。玉石でしょうか、それとも別の宝石ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "どちらでもない……普通の石ころだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "では、その石を狙う人物に心当たりは？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "あるにはあるが……その者が盗みに来ることは天地がひっくり返ってもないだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "それはどのような方ですか？　なぜそれが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・チンイェンにはまだ尋ねたいことがあったが、病床に臥せた老人はそっぽを向いていて、これ以上話す気はなさそうだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "その石は普段どこで保管されていたのですか？　屋敷の方が最後に石を見たのは、いつ頃でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "旦那様が特注で作らせた箱の中に入れ、屋敷の一番奥にある倉庫で保管していました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "一昨日の夜、私が倉庫を掃除した際には、中身に異常はありませんでした。ところが翌朝になって箱が床に落ちており、中の石が消えていたのです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……倉庫へ案内していただけますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "さあさあ、皆さん中へどうぞ！　本日は皆様のご厚意に感謝するため、ささやかながら酒宴を設けました。もてなしに至らぬ点があるかもしれませんが、どうかご容赦ください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な農民",
      "text": "旦那様、ご転居おめでとうございます！　こちらは実家から連れてきた羽獣と二籠ばかりの卵になります……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "旦那様だなんてかしこまるのはよしてくれ。俺たちは元より同族同輩、これまで少し離れていただけなんだから、何もよそよそしくする必要はない。俺の方が年も下だし、ワンと呼んでくれればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な農民",
      "text": "……分かった。ワン！　これも受け取ってくれ……うちの母が夜なべして作った靴だ。気に入らんとは言わせんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な農民",
      "text": "母さんから聞いたよ。ここ数年、商売のために各地を巡って、苦労を重ねてきたそうじゃないか。市販の厚靴も丈夫なことは丈夫かもしれんが、手作りした靴の履き心地には敵わんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "落ち着いたら、おばさんに挨拶に伺うよ。子供の頃、うちが災害に遭った後におばさんが腰も悪いのに何百里も歩いて粟を二袋届けてくれたこと……今でも覚えてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な農民",
      "text": "はぁ……あの時、お前に残ったのはたった一つの石ころだけで、大人たちは皆、長くは生きられないと思ってたんだ。だがお前の命は石よりもしぶとく、見事に乗り越えてみせた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な農民",
      "text": "自分の一人で身を立て、どんな大変な仕事や重労働にも弱音一つ吐かなかった。片田舎から抜け出して、事業を立ち上げ、家庭を持った……俺は心の底からお前を尊敬するよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "全部、運が良かっただけだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "どうしようもないところまで追い詰められたからな。腹を括って進むしかなかったんだ。運命を受け入れて座して死ぬなんて無理だ。運良く拾ったこの命を、簡単に手放すわけにはいかないからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "青年が胸に当てた手の中には、首から下げられた石が強く握り締められていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "さあ、席についてくれ。これ以上ここで喋っていたら、せっかく用意した紅焼肘子（ホンシャオジョウズ）がみんな食べられてしまうぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "ご来客の皆さん、どうか焦らずに、席は十分用意してありますからね……あっ、あんたは！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "やあ、私だ。また来たよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "久しぶりだな。用件は何だ？　また例の石を買い戻しにきたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "よく分かったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "君も家庭を持って、事業も立ち上げ、衣食に困らない生活を手に入れただろう……そろそろあの石を譲ってくれる気になったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "もちろん……そんなのダメだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "この石が俺の命を救ってくれたのは置いといても、身に着けて寝るだけで、何だか心が落ち着くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "こいつはもうお守りみたいなもんだ。渡すわけにはいかない。無理なもんは無理だ、諦めてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "そっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意気盛んな青年",
      "text": "え？　本当に諦めてくれるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "もちろん、そんなわけはないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "私はその石のことを今もすごく好きでたまらないから。とはいえ、人の手中の玉を奪うのもよくはないか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "やはり待つことにしよう……君が手放してもいいと思える時になったらまた来るよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "ここが、屋敷の重要な財産を保管する倉庫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "ええ……旦那様の大事な帳簿や土地契約書は全てこちらに保管されています。余人の立ち入りは禁じられています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "石が失われた日の夜、誰かここへ来た者は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "生憎と……その晩は大雨が降っておりましたので、覚えている限りでは、この倉庫の明かりは一度も点かず、物音も聞こえませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "では、普段この部屋に出入りできるのは誰ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "部屋と棚の鍵は全部で四組あり、旦那様のお子様たち三名にそれぞれ一組ずつ、そして旦那様の分は私が預かっております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "しかし石の入った箱を開けられる鍵は一つきりで、その鍵は旦那様がいつも肌身離さず身に着けておられます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "その箱は、この棚の上に置かれていたのですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "旦那様は、自分以外の者が石に触れることを決して許しませんでした。病に倒れてからは、触れる時間も取れず、手の届かないこの場所にしまっておられました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "帳簿、土地契約書……それらの価値を知る者……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "外から来た盗人が、この場所を探り出せるでしょうか？　この屋敷には他にも目立つ値打ちものがたくさんあるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "すみません、今なんと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "いえ、ただ最近追っていた別の事件を思い出しただけです。今回の件とは無関係であるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "そうだ。ワンさんの三人のお子さんというのはどのような方々なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "私はあくまで一介の家令に過ぎませんので、若様とお嬢様については、申し上げる立場にありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "ご安心を。私も人柄についての評価を求めているわけではありません。どのような仕事についているのか、また日頃こちらの旦那様との付き合いはどういった具合かを教えていただければ十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "旦那様の最後の願いを叶えるためでもあります。どうかありのままをお話しください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "実のところ、若様もお嬢様も、それぞれの実績だけを見れば、いずれ劣らぬ立派な方々なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "一番上の若君は知識人で、常に成績優秀な方です。今は学宮に務めていらっしゃるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "次男の若君は旦那様の商才を引き継いでおられ、近年では多くの財を築かれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "一番下のお嬢様は俗っぽいものには一切興味を持たれず、専ら音楽を嗜んでおり、この付近では名の知れた琴奏者でもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "あなたの口ぶりから察するに、何か思うところがおありのようですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "とんでもございません……私のような奉公人は意見する立場にはありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "ただ……私のような部外者からすると、三人とも旦那様と仲が深くはないようで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "成人してすぐに家を出て行かれて、祝い事や正月にも滅多に帰っては来られません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "ワンさんはご子息たちとあまりうまくいっていないと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "はぁ……これも話せば長い話でして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "旦那様は一介の牧童から身を立て、幾多の辛酸を舐めて苦労に苦労を重ねて、ようやく今の家業を築き上げられた方です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "ですがその反面、三人のお子さんに構う気持ちはあっても手が回らなかったようで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "想像に難くありませんね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "リン天師、まさかあなたが疑っておられるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "事情を詳しく知りたかっただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "ところで、旦那様が件の石をそれほど後生大事にされていたのは、一体なぜでしょう？　石を売り払うことは考えなかったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "私の知る限り、そういったことは一度もありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "あの石は旦那様が最も大切にされている宝です。私どもは普段目にする機会すらありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "一度、玉石店に持っていって鑑定するよう提案したことがあるのですが、旦那様からこっぴどく叱られまして……それ以来二度と触れないようにしています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "ただ、旦那様から聞いたことがあります。妙な人物が石を買い上げようと狙っていると。それこそ何十年もの間ずっとだそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "何十年も……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "数十年前に河原で拾った石とのことでしたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "その場所は、まだ残っていますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した農民",
      "text": "旦那様、俺はこれで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "うむ。給金はすべて支払ったか？　不足があるなら、何とか工面するが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した農民",
      "text": "すべて受け取った。焼け残った梁や柱は上等な楠木だったから、棺桶屋の店主が買い取ってくれたよ。残ったお金は……竈の上に置いてある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "では、行きなさい――もう私を旦那様と呼ぶ必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した農民",
      "text": "なぁワン……お前は日頃から善行を重ね、他の誰にも劣らぬほど徳を積んできた。なのになんでこうも報われないのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "私が今までやってきたことは、徳だの功だののためではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した農民",
      "text": "善人として名を馳せるワンが、まさかそのせいで盗賊どもに目をつけられるとはな……天よ、見誤ったか！　悪人を裁かず、善人を苦しめるとは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "もういい……もういいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "この歳になって、財産は尽く失ったが、この命と……石は残った。それだけでも幸いだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "中年の男は、懐に収めた木箱をしっかりと抱きしめた。血で汚れた髪には幾筋かの白髪が混じっている――彼はもはや若くなかった。\n半生をかけて、苦労しながらその手でレンガを一つ一つ積んで手に入れた「家」も、今や彼と石を残すのみとなった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "……どうやら来る時を間違えてしまったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "今回はもてなすことはできんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "世とは無常なものだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "今日訪ねてきたのは、やはりこの石の話か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "元々はそのつもりだった……けど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "どう？　今なら、その石が単なる石ころだと信じる気になるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "これはごく普通の石で、私も平々凡々な只人だ。ひとたび風が吹き雨が降れば、容易く泥の中に埋もれてしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "私はたくさんの人間を見てきた。君のように、意地だけでどん底から這い上がり、あれだけの事業を興して成功する人間は珍しいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "さらに言うなら君くらいの歳になって、一夜にして全てを失いながら、なおも立ち上がれる人間はもっと……いや、皆無に等しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "おとなしく運命を受け入れて、諦めろと言いたいのか？　この石もろとも自分の人生を放り出せと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "いいや……逆に訊こうと思っていたんだよ――君は、もう諦めたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "……諦めるわけがあるか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "一度はどん底から這い上がったんだ。もう一度できないはずがない……必ずもう一度成功してみせる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は何かを決意したように、木箱を持ち上げると丁重にこう述べた――"
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "あんたはこの石をずっと欲しがっていたろう？　くれてやる。だが手放したわけではないぞ。必ずあんたから買い戻す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "つまり、質草のように私に預けたいと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "そうだ。その代わりに、あんたから金を借りたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "木が燃えたところに新しく苗を植え直し、壁が倒れた場所にレンガを積み直す――私は歳を取ったが、まだ死んではいない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "また一からやり直すだけだ。一度はできたことなんだから、今回も絶対やれる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "いいや、前よりももっとうまくやってみせるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "うん、気持ちは分かるよ。けど……やはりやめておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "今更一体なんだそれは。まさかタダでくれてやらねば、受け取らないつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "タダでくれても、いらないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "私が欲しいのはごく普通の石ころなんだ。君はまだ執着を捨てていないから、今のその石は私には重すぎる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "温厚な男は背負っていた籠を下ろし、中をごそごそと探る。しばらくしてようやく、磁器や玉器の山の中から純金でできた羽獣を引っ張り出した。\n彼は金の羽獣から、ごっそりと羽根を引き抜く――純金製のそれはずっしりと重く、ぶつかると澄んだ音を響かせた。"
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "失意に暮れる中年",
      "text": "……なぜ私を助ける？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "君のところへはもう通い慣れているからね。石がまだあるかどうか確かめたくなったら、少し歩くだけで辿り着ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "けど、もし君がこのまま、うだつが上がらずに、石を持ってどこかへ行ってしまったら、私はどこへ石を探しに向かえばいいのか分からなくなるじゃないか。面倒なんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "昨日のご老人の話では、例の石を拾った場所はここのはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "かつては川だったはずだが、今は墓地になり……土石流の後に生えた木も、見たところ樹齢数十年はありそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……誰かいるのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "ほら、だから言ったじゃないか。僕たちと一緒に行けばよかったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "僕を見なよ。とっくに偉い役人になったんだよ。界園の中じゃ花も草木も、壺や瓶まで、僕を見るとみんな恭しくこう呼ぶんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "なんて呼ばれてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "「司雨小郎君（しうしょうろうくん）」さ！　ふん、教えてあげるよ。雨を司る貴公子っていうこの名の通り、界園内のどこに雨を降らせるか、降らせないかは、全部僕が決めることなのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "僕が池に飛び込むだけで――ドボン！　すぐにザーザーと雨が降ってくるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "……かっこよく聞こえるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "君は？　君はどんな役職で、なんて呼ばれてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "私はなにも……ううん、あ、あるよ！　みんなには……そう「大侠客」って呼ばれてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "大侠客？　侠客って江湖によくいる強きを挫き、弱気を守る武芸者のことだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "私が言ってる「大侠客」っていうのは、大きな木箱のことだよ。私はその中に座ってるの。誰にも開けられやしないんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "そ、それはすごそうだけど……でも、僕が「小」郎君なのに、なんで君が「大」侠客なのさ？　ダメダメ、これから一緒に界園に入ったら、「小侠客」に改名しなきゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "そう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "その様子だと、目覚めたばかりなんでしょ？　いいか、僕たちは昔同じ籠の中にいたんだ。ご主人が僕らを背負って河原を通りかかった時、君が突然籠から転がり落ちて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "あのさ、あの時一体何を考えてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "それは……よく覚えてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "じゃどうやって「目覚めた」かくらいは覚えてるよね？　界園に連れ戻された仲間たちは、みんなご主人に起こされたんだ。まさか外にも石を起こせるような凄い人がいるとは思いもしなかったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "別に凄い人なんかじゃないよ……どんくさくて頑固な、ただの石頭なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "雨が降って休まなきゃいけない日にも、畑を耕しに行くんだよ。みんな仕事が終わったら家に帰るのに、ご飯も食べずにすきっ腹を抱えて河原に石を掘りに行くの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "新しい家を建てたいとかなんとか言っちゃってさ！　基礎工事を頼むお金もないから、自分で鋤を持って掘りに行くの。レンガも買えないから、自分で泥をこねて作ったりしてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "たった一人で、七、八年もかけて家を建てたんだよ。なのに建て終わったら、住みもせずに商売しに外へ出て行っちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "バカな奴だな！　本物の石頭だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "そんでね、ようやく商売が軌道に乗って成功したと思ったら、盗賊に襲われて、何もかも失っちゃったの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "はぁ、それじゃ骨折り損じゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "普通の人なら、おとなしく余生を過ごすところなんだろうけど。でもあの人は諦めずにもう一回やるんだって、わざわざもう一度自分を苦しめようとするの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "それで今は、病気になっちゃった……子供たちは面倒を見てくれないし、付き合いのある親戚や友人たちも財産目当ての人ばかり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "もっと気に食わないのは、本人が箱を見張ってなかったことをいまだに後悔してることだよ。石を失くしたのは自分だと思ってるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "なんか……怒ってるようでもあるけど、憐れんでるようにも聞こえるんだけど？　もしそうなら、どうして傍にいてやらないで、出てきちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "だって、分からないんだよ……なんでずっと諦めることを知らないんだろうって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "界園にいる時、外から来た友達が言ってたんだ。人っていうのは、簡単に穴に落っこちて、一生抜け出せないもんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "よし、君も界園においでよ。仲間たちに君のこと紹介してあげる。みんなすっごく物知りだから、きっと君の疑問にも答えてくれると思うよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぼんやりした子供",
      "text": "界園……一体どんなところなの？　面白いものはあるのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "すごく面白いところだよ。ついてきたら、絶対後悔させない！　あのね、あそこには――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい子供",
      "text": "まずい、人が来た。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "待ちなさい――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・チンイェンは隠れるのをやめ、木の下へ大きく踏み出す。先ほどまで聞こえていた子供たちの幼い声がぴたりと止んだ。\n木の背後には何もなく、子供たちの姿もない。しかし木陰に覆われた草むらの中には、丸く艶やかな石が静かに横たわっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "執念が形を取り、器物へと宿る……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "この石に宿っているのは、一体どんな執念なのでしょうか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "天師、俺たちを呼んだってことは、例の石を見つけたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "その通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "それだけでなく、屋敷に忍び込んだ盗人の正体も突き止めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "天師、もったいぶらないでくださいよ。一体何が起きたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "そう焦らずに。石がどうやって失われたか、また盗人とどのように関係しているかを示すには、ある方に協力していただく必要があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "次男殿、こちらに立っていただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "俺が……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は不服そうではあったものの、指示に従って大きな棚の横に立った。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "そうです。では、あなたの持つ鍵で棚の錠を開けてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "何のつもりだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尊大な男性",
      "text": "弟よ、天師の言うことに従いなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "兄さん、ぐずぐずしないでちょうだい。急いでこの件を片付けなければ、私たちも安心できないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "……ふん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は不満そうに鼻を鳴らしたものの、最終的には懐から鍵を取り出すと、指示に従って棚の錠を開けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "……開けたが、それで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "そう、ご覧のように普段ならば何も難しくない動作です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "しかし雨の夜に暗闇の中で錠を開けようとすれば、今のように手際よくはいかないでしょう。手元が狂うのも、仕方ないことです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・チンイェンがそっと棚を押すと、上から箱が落ちてきた。それはちょうど次男の頭にぶつかって床に落ちる。\n衝撃で開いた箱から、つやつやと輝く丸い石が転がり出た。リン・チンイェンは前に歩み出ると、石が外へ転がる前に拾い上げる。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "実のところ、盗人の狙いはこの石ではなく、棚の中にあるワンさんの財産でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "そして、この家で真に価値ある物がどこにしまわれているかを熟知していて、眼差しにも隠し切れぬ欲を宿す者と言えば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "い……一体何が言いたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "（小声）私は大理寺の官吏ではありませんし、ご家族の事情に口を挟む気もありません。ですが一つだけご忠告をいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "（小声）炎律の定める窃盗罪は、たとえ親子間であっても適用されます。遺言をみだりに改ざんし、その金額が一定額を超えた場合、重罪に問われることもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "（小声）自重なさることをおすすめいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "横暴な男性",
      "text": "お……お前……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "若様……お嬢様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家令",
      "text": "旦那様が――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワン家の子供たち",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……こちらの石を、ワンさんの元へ届けましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "君と私の目に狂いはなかったようだ。あれは良い石だったね。最後まで君を置いていきはしなかったのだから。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "老人がゆっくりと唇を動かす。言いたいことは山ほどあるようだったが、結局口にしたのはひと言だけだった――"
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "あんたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "うん、また私だよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "男の顔には、いつもと同じ笑みがあった。初めて老人の前に現れた時と変わらぬ笑みが。あの頃、老人はまだ子供だった。\n子供は川の中から石を拾い上げると、通りすがりの男の目の前に差し出した。石を透かして差し込む陽射しが、不思議な光を浮かび上がらせる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "初めて会った時から随分になる……あんたも何度も訪れたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "前回来た時は、君もまだ腰掛けを持ってきて玄関先で共に茶を飲めるくらいには元気だったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "あんたはいつもこの石のことで私を訪ねてきた。同じ回数だけ私はそれを断った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "それなのになぜ諦めることなくかよって来たんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "その石が本当に気に入っているからだよ。私の庭園にも、ちょうどこういう石が必要なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "最初から特別な理由などないよ。天地の狭間に生まれた奇跡のような自然の美しさには、元より理屈などないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "あんたって人は……本当に変わってるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "断られたあんたが帰って行くのを見送るたびに思っていた――次こそは来ないだろうと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "だが、十日なり半月、あるいは三年なり五年が経つと、あんたはまたやってきた。私はずっと不思議だったんだ。何の収穫もなしで悔しいと思わなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "山を下りるたびに、道中で何かを聞き、目にするものもあり、心に思うこともあるよ――たとえ石が手に入らなかったとしても、そうした経験があるなら、収穫がないなんて言えるはずもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "何かを聞き、目にする……ではあんたは何を経験したんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "清らかな風にたなびく雲や、細やかな花や羽獣の雛、そして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "興味深い人、興味深い事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "私も君のところからの帰り道に毎度こう思っていたよ。次に来た時は、石を譲ってくれるのではないかとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "ハハッ――ゲホッ、ゲホッ！　甘いな！　くれてやらなければ、あんたは一生私のところに通い続けることになるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "甘いとは言うけど、それはお互い様じゃないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "そうだな……お互い様だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "私が死ねば、あんたがここへ来る必要もなくなる。残念だが、この石はあんたの物になるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "そうとも限らないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "人の力には限りがあるものだ。かつて私が籠いっぱいに石を詰めて河原を通りがかった時に、細心の注意を払っていたにもかかわらず籠の内の一つを川の中へ落とし、それを君が拾ったようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "拾ったっきり、そのまま一生手放さないなんて誰が想像できるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "ハハハッ、ハハッ――私が手放さないことを、最初から分かってたんだな！　そうさ。あんたは分かっていたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "ああ、君が川の中に立っていたあの日から、知っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "ならば、あんたが私を訪ねてきたのは、一体……何のためだったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "ただ見に来ていた時が多い。この石のことはとても気に入っているから、なるべくたくさん眺めていたかったからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "石なんて、この世には山ほどあるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "興味を惹かれるものは多くない。巡り会えたのならば、それは縁という。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "幸い……あんたほど執念深い人間も、世の中には多くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "執念深さで言えば、君には遠く及ばないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "その思いの強さが、石さえも呼び起こしたのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "人は……意地に頼って生きるもんだ。私は土石流から……命を拾った。この石の……そしてあんたのおかげでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "私はこの命を……捨てるわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "ああ、君は意地で成し遂げた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "たとえ谷底に落ちようと、巨岩にぶつかろうと、決して諦めることはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "すべて、見届けさせてもらったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "この石は……やる……くれてやる。あんたに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "その石は、君の手で目覚めたんだ。あとは石自身に選ばせよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "石",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病床に臥せる老人",
      "text": "ハハッ……あんたは……この石のために、私を生涯煩わせてきた。これで……ようやく、逃れられる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温厚な男性",
      "text": "そうだね……手放しなさい。今なら、手を緩められるはずだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "得意げな子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少年が手の中の石をぼんやりと見つめている。石は陽射しに照らされて、不思議な輝きを放っている。静かに流れる川の水が、まくり上げたズボンの裾を濡らした。\n一緒に川の中へ入った仲間の姿も、いつも温厚な笑顔を浮かべる男の姿も見えない。\n風も、木も、空さえも……この川の流れ以外、少年は何一つ感じなかった。\n時間は、ちょうど彼が石を川の中から拾い上げた瞬間で止まっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "得意げな子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "得意げな子供",
      "text": "（寂しげに微笑む）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少年は手の力を緩めると、石をそのまま川の中へ落とした。落ちた石が川底へ沈むのか、それとも流れに乗って海へと向かうのかは考えなかった。\n彼が目を閉じると、雷鳴と、風の音、そして流れ落ちる土砂の音が聞こえてきた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
