{
  "server": "jp",
  "storyId": "act18d3_level_act18d3_06_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_06",
  "title": "拒食",
  "storyCode": "SV-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_06_beg.txt",
  "sourceHash": "c7c6c676e77063abbb8524dd989ddf80b3b2a6d14ecffc5d7cc01adad77c3f6d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "果てなく、限りなく……垂れ込める濃霧……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ふんふふ～ん……♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、起きたんですね！　おはようございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……今、歌っていたのは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌って……こ、これのことですか？　ええと、これはあなたが寝ている間、ずっと口ずさんでたものなのれす。だから真似して……でも、全然上手く歌えなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "きゃっ！　う、歌い手さん？　どうしてそんなに強く掴むんですか……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "お母さん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……かい、ぶつ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……怪物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "怪物！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "うう……歌い手さん、ケースが……ケースが食い込んで、痛いです……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "て、手が緩んだ……び、びっくりした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、私を殺したくなったのかと思いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたを殺すのは簡単よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "でも、あなたは私を殺したくないんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そんなこと、あなたにわかるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そう……でも、私にはわからないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ま、また急に飛び出して……もう！　歌い手さん、どこへ行くんですか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "……上官、じきに満潮です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "海の色が……あの辺りの色が変わりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "それに海中に何かが……あれは、貝に鱗獣？　でも、どうして急に……というか、一体どこから？　とにかくすごい数です。しかも、海岸へ近付いてきているような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "有り得べからざる海流に沿い、より深くからやってくるのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "そ、そのようなことが……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "私はてっきり……彼らの言う、海へ行けば食べ物が手に入るという話は、バカげた迷信だと思っていました。絶望の中で誰かに惑わされ、でたらめを言っているんだとばかり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "まさか……彼らは本当に海と取引していたの？　自分たちを怪物の餌にして、見返りに食べ物を受け取っていると……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "なんて恐ろしくいびつな共生関係なの……道理で恐魚が山ほどいるわけだわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "くっ……昨日であれば、海へ行くのを阻止できたというのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "是正に結果が伴うとは限らない。学びを得たな、審問官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "……ッ！　……私は……私は間違えたのでしょうか、上官？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "私は、ただ彼らを救いたかっただけなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "間違いを正すには、正しい道へと戻すか、あるいは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "ですが……彼らにとっての正しい道とは、一体何なのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "サルヴィエント……この土地は、そしてこの海岸は、もはや食料を生み出すことなどできはしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "そう、結末はとっくに……数十年前に決まっていたんです。どうあがこうと無駄なこと。移動都市とその文明、この地の人々、すべてが慢性的に死へと向かって進み続けています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "彼らは私に問いました。もし……もしも歩むべき道がなければ、どうやって正しいことと間違ったことを見分けるのか、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "――あるいは、間違った存在を消し去ることもまた是正だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "じょ、上官……！　その仰りようは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前は疑いを持ったのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "私は……いえ、そのようなことは。私はただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "確かに彼らは……今でこそ、この有様です。ですが彼らもかつてはイベリアの民でした。私は、彼らを守りたい。ここの住民たちを……いいえ、この国を良くしたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "ならば、お前は疑いを持つべきなのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "判決を下す時、頼るべきものはお前自身！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "は、はい、上官……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "この海を見ろ。お前は何を見た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "はい……脅威です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "丸暗記の回答はやめろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "はい、上官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "海は……流れ、打ち寄せ、絶えず変化しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "なら、目にしたすべてを記憶しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "変化は過去のものであり、現在起きているものであり、この先未来に起こるものでもある。己の目で確かに見定めることができなければ、道を失うことだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "じょ、上官……！　足元のこれは、一体……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前は、何だと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "恐魚……昨晩街を襲った奴らの生き残り？　……いいえ、多分違う……こいつは海岸を彷徨っていた……長い道のりの果てに這い上っていたんだ……昨日の奴らとは違う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "これは……ああ、私には恐らく、わかっています……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "そう……浄化しなければならない邪悪だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "……わかりました。……おかげで、取引の全容が見えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "海に入った人は、こうなってしまうのですね……ここは怪物の巣窟であるばかりでなく、それを生み出す温床でもある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "ああ、それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "つまり、ここの住民は誰もが怪物になってしまうということです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "私の剣よ、勇気をください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "……上官、私はもう一度、街に戻ります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はぁ……はぁ、はあ……う、歌い手さん……走るの……速すぎますよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "まだ十分とは言えないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "またあなたに追いつかれてしまったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はぁ、はぁ……あはは……歌い手さん、この街は、私の故郷なんですよ……この辺りのことなら、私の方がずっと詳しくて当然です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もう行かないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "行くって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ここを離れるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "えっと、それは……仲間のいる場所がわかった、ってことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……少なくとも、あなたたちから離れるべきだと思ったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "えっ？　な、なんでですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あの審問官は……一つだけ正しいことを言っていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ええと……色々話してましたけど……どれのことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたたちにとって、私はとても危険だってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "昨日の夜のことですかね？　けど、歌い手さんは私たちを助けてくれたじゃないですか。皆あなたに感謝してますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたたちを助けた……？　あなたはそう思っているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もし、あの恐魚を一匹でも仕留め損なっていたら……そいつは進み続けて、あなたをばらばらにしていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "いい？　あなたはあいつらに殺されるところだったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そして、あいつらを引き寄せたのはこの私。だからあなたは、私に殺されかけたも同然なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "そ、それは違うと思います……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "気休めは止して。……それにね、前にも同じことがあったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私のせいで多くの人が死んだの。だったら恨まれ、恐れられ、責められるのは当然の報いよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "それは……その人たち自身の問題ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "だって歌い手さんは、わざとやったわけじゃないんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "本当に……そうなのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "わからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あれ以来……私にはもう、わからないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "だからこそ、あいつを殺せば、答えを得られると思ってた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん……顔が真っ青ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ケガをしたばかりですし、体力も消耗したと思います。まだ万全ではないんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "やっぱり私と帰って休みましょう。少し寝たら、きっと良くなりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "どうしてあなたは、私を怖がらないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたのおばあさんは、私を化け物と呼んだ。あなたの仲間が私を見る目は、敵意に満ちていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "どこへ行っても……皆あの目で見てくるの。まあ、そんなものとっくに慣れてるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "でも、あなたは違う。あなたの目に、私はどう映っているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あなたは……あなたは歌い手さんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "「歌い手」、ね。私が言ったことを、あなたは信じるのね。あの審問官は信じなかったみたいだけど。それなら、今私が「自分は怪物だ」と言えば、あなたはそれを信じるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……信じませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなた、どうしてずっと私についてくるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "何でもあげるって言っても、あなたはいらないって言うし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "かと言って、私を殺したいってわけでもないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "こ、殺す？　歌い手さん、どうしてそんなこと言うんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "例えば、私が何かを成し遂げたとしたら、それに対し誰かが報酬を払う。あるいはその逆もあるけれど……陸地の人は皆そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "交換は、約束を伴うもの。そして……約束を交わすから、信用が生まれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "やくそく……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "約束が何かを知らないのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はい、聞いたことありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "それじゃ、よく聞きなさい。あなたは私を助けた。そのお礼に、私はあなたが欲しいものをあげる。これが交換のお約束ってものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……でも私、何もいらないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "嘘ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ハンター……じゃない、私は鼻が利くの。この目と同じくらいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "う、ううん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなた、言ったわよね。ここはあなたの家、だからすぐに私を見つけられた……って。これも嘘でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "本当のことを言わないのなら、私はあなたを信じない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "いや！　歌い手さん、行かないでください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "本当のことを言ってないんじゃなくて……私、わからないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、あなたは私たちにとって……ううん、私にとって気になる謎なんです。あなたは外から来た人ですし、あなたみたいな人は、その……初めて見ましたから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "どうしてあなたがここに来るってわかったか、知りたいですよね。ごめんなさい、本当のことを言わないようにしてたんじゃなくて……なんだかきまりが悪くて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ここは……この街の端。市街地から一番遠い場所なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あなたが私たちを避けてるのはわかってました。だから、街を離れるつもりなら、きっとあなたもこの場所に来るだろうと思ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなた「も」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "私、よくここに来るんです。もちろん、トタンたちには隠れて……私がこんなに遠くまで来てるって知ったら、機嫌が悪くなっちゃいますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "見てください、あの場所。とっても高いでしょう。時々あそこに登るんです。強い風が吹いてて、遠くの方までよく見えるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "外に興味があるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "そうなんでしょうか……時々、外はどうなってるのかなって考えることはありますよ。でも、そんなの意味がないってわかってます。皆そう言いますから。だから一人で隠れて考えるしかないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "物を拾う時だって、一番遠くへ行ったとしてこの辺りまでです……これ以上進んでも……外には、役に立つものなんて何もないですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "興味があるなら、もう少し遠くまで行ってみればいいのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "前に、一番西の方まで行ってみようとしたら、トタンが脅してきたんです。外は怪物だらけだから、一歩でも街を出たら死んでしまうぞ……って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "でも、歌い手さんは、その外から来た人ですよね。私があなたについていくのは、聞きたいことがたくさんあるからなんです……トタンが言っていたことって本当なんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "多分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "外に行けば、あなたは死ぬでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "そっか……本当だったんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "落ち込まないのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はい。チャンスがあったら、見に行ってみようと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "怪物がいても大丈夫です……私、そんなに怖いと思ってないみたいなので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "へえ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "審問官が言ってました。私が怪物を怖がらないのは、怪物の恐ろしさを知らないからだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "きっと……審問官の言う通りですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あんなのでたらめよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "え、ええっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "だって、私も怖いとは思わないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あははっ……それは、歌い手さんの前じゃ怪物は何にもできないから言えることなのれす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "でも、私は歌い手さんとは違います……あんな怪物をはっきり見たのは、昨日の夜が初めてなんです。あの時、何でかはわかりませんけど……今までにないくらい心臓がバクバクしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "今朝起きた時も不思議でした。これまで感じたことがないほど、空が綺麗だって気付いたんです。雲の流れに風が動いているのを感じて……近付いてくる波がよく見えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "こんな一日、これまで一度もありませんでした。これまで通り、朝から夜まで同じことの繰り返しじゃなくて……何が起こるかわからないからだと思うんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "それは興奮しているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "これが……興奮ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "恐怖と興奮は大して違わないわ。どっちも鼓動が速まって、血が熱くなるんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "私、病気になっちゃったんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "病気じゃないわ。それで生きていると実感する人もいるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "生きている……実感。それってこんなにいいものだったんですね。外での毎日は、いつもこんなふうなんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ここよりはいいでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……私、本当に外へ行けるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "私の箱……あの宝箱がいっぱいになったら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "私……食べ物をたくさん集めなくちゃ。ペトラおばあさんも一緒に安心できる場所に住みたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "私は……わっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "うっかりしてると、怪物に食べられちゃうわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん……また、助けてくれましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……あなたがここまで来なければ、こんな面倒ごとは起こらなかったけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あはは……ご、ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "え？　な、何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "私の足……何かが私の足を掴んでるみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ぬ、ぬるぬるする……それにすっごく重たい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……また来たのね。どこにでも現れて……本当、面倒な奴ら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "うぅ……歌い手さん、わ、私もう、限界です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "目を閉じて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そして手を離すの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……それって大丈夫なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "信じるか信じないかは、あなたが選んで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
