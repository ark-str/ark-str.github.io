{
  "server": "jp",
  "storyId": "act15d5_level_act15d5_st01",
  "groupId": "act15d5",
  "stageId": null,
  "title": "続かず",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15d5/level_act15d5_st01.txt",
  "sourceHash": "12a412e346d1e360f7faa4816826416298eeb1d85066ac479fd1b59f97523d8a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（あくび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "布団はきちんと揃えて畳んだし――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "財布と、鍵と、あとジャケット……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "通信機器は、まあいいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "盾……もやめるか。相棒、今日は休んでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "靴はこれに……いや違うな、これは色が合わない。やっぱりこっちの限定モデルにするか？　あぁ、こっちの方がいいな、今日の服にピッタリだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いや、でもデザインは、さっきの靴を合わせた方が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "（白目）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ああ、お嬢様、ちょうどいい。どれがいいと思います？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アタシに聞かないで。今はアンタのすべてが目障りだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ご機嫌斜めのようですが、どうされました？　体調が悪いとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そんなわけないでしょ*龍門スラング*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "朝っぱらから部屋に呼びつけて何のつもり！？　そんなに靴を数えるとこをアタシに見せたいの？　アンタの自慢のコレクションを見せられたところで、どの靴も全部同じにしか見えないわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "どれも同じなわけないでしょう。デザインも材質も全然違うんですから。見てください、この靴の革は……ああ、興味のない方に語っても仕方ないですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "とはいえ、隣同士なわけですし、ちょっとくらい隣人のよしみで助け合おうって気にはならないもんですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ならないわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "わかってるのかしら？　今日は休日で、まだ朝の六時にもなってないのよ！　そこの警報器を鳴らして、アンタを迷惑行為でしょっぴいてやってもいいのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "時間外労働したければ一人でやって。でもそんなに仕事ばかりしてたらいつかハゲるわよ。アタシを巻き込むのはやめてちょうだい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "時間外労働なんてしませんよ、折角の休日なんですから。近衛局はケチですし、手当だってそんなに出ません。ましてや小官はチェン隊長のようには働けませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それにお嬢様、人のことは言えませんよね？　ついさっき、勢いよくドアを開け閉めする音が聞こえましたよ。あなたも近衛局から今帰ってきたばかりなんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ああ、うっさいわもう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "最近色々と忙しすぎるのよ！　レユニオンの後始末に、ネズ公の件もあるし……あのアホ龍は大事な時にいないし、どれもこれも全部アタシが処理しなきゃならないのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アンタはアンタで、昇進したかと思いきや、どっかに異動するっていうじゃない！？　上はどういうつもりなの？　特別督察隊はどうするのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ほんとムカつくわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "まあまあ怒らないで。ウェイ長官も考えがあってのことですから。あなたを育てたいからですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "近衛局をあなたが背負う。遅かれ早かれそういう未来がやってくると小官も思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あなたならできますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……ア、アンタまたそんなこと言って……そんなの、アタシだってわかってるわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "で、でも本来近衛局を担うのは……担うはずだったのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はぁ……また泣くのは勘弁してくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "泣かないわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "あのバカ龍が戻ってこないなら、それでいいわ。見てなさい、近衛局を手中におさめるのはこのアタシよ。その時になってから後悔しても遅いんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ、それは楽しみですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ちょっと待って！　ていうかアンタさっき、扉を開け閉めする音を聞いたって言ってたわよね？　つまりアンタ、アタシが寝てないの知ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "知ってるならどうして呼んできたのよ。わざとじゃないなんて言い訳は通用しないわよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "まぁまぁ、落ち着いてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あなたが、自分を追い込みすぎているのではないかと心配だったんですよ。最近は色々なことが重なりましたからね……私たちだって随分と顔を合わせてなかったじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "朝ごはん、まだですよね？　小官が買ってきました。あなたの好きな焼きビーフンです。それを食べてから寝てください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "フンッ、余計なお世話よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はいはい、余計なお世話ですよ。それで、食べないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "食べるに決まってるでしょ！　寄越しなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "何で二人前も買ってきたの？　こんなに食べれるわけないじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "えっ、二人前？　……ああ、多分いつもの癖ですね。つい同じように買ってきてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "三種のキノコと細切り肉、沙茶醬味にビーフン多め。フンッ！　まるきりあいつの好みじゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ふん。この店のビーフン微妙よ。味薄いし、具も少ないし、ぎりぎり食べれるくらいかしら。次は近衛局の下の角を曲がって二軒目のにして。青い看板が掛かっている店よ。あっちの方が美味しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はいはい、次からはそうしますよ。今日のところは我慢して食べてください。ほら、慌てないでゆっくり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "（あくび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そういえば、アンタ今日はどこ行く予定なの？　どうせもう眠れないしアタシも一緒に行くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アタシ、あのスルロフスキーの新作を買いに行きたいのよね。JOKERシリーズの、先週出たばかりのやつ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あぁ、チェン隊長が前々から気に入ってたやつですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そう、それ。……あいつ、こういうのは結構見る目があるのよね。アクセサリーやファッションに関してはアタシよりセンスあるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あの人を褒めるなんて珍しいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "小官はどうかと思いますよ。あんなものを買ったところで碌に身につけやしないんだから。まぁあの人は高給とりで、近衛局宿舎のおかげで家賃も浮くから買えるでしょうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それにしても、お嬢様から外出に誘われるなんて珍しいこともあるものですね。初めてじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ほかに誰かいれば、アンタなんか誘わないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "でしょうね。さて、そろそろ出ないと……小官はもう行きます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ちょっと待ってよ、アタシ化粧するんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "化粧なんかしなくても十分お綺麗ですよ、「お嬢様」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "本日はご一緒できない非礼をお許しください。誘っていただいて光栄ですが、小官はバイクで風に当たりに行くだけです。わざわざついてきても何もありませんよ。今度乗せてあげますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "お嬢様は寝ててください。あんまり目の下のクマを残し過ぎると、なかなか消えなくなりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "本当にゆっくり休まないとダメですよ、スワイヤー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "ホシグマ隊長、おはようございます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "おはよう。朝からご苦労。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "まったく、休日の、しかもこんな朝っぱらから、どうしてこの建物にはこんなに人が多いんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "あの事件以来、ずっとこんな感じですね……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "ホシグマ隊長だってそうじゃないですか、さっき帰ったと思ったら数時間もしないうちにまた戻ってきてる。今日はオフだったんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "おいおい一緒にするなよ。私はお前たちとは違うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それより、お前、大丈夫なのか？　なんだかフラフラしてるようだが……何か腹に入れて、休憩室で休んでこい。それと、栄養ドリンクばっかり飲むなよ、身体に悪い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "あっ、ありがとうございます。でもまぁ大丈夫ですよ。手元の仕事が片づいたら家に帰って寝られるんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "（あくび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そうか、なら私もこれ以上は言わないが、自分たちでうまく調整しろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ここのところ、皆には本当に苦労をかけている。そのうち落ち着いたら、盛大にうまいものをおごるから楽しみにしててくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "飯もいいですけど、給料を上げてほしいっすね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "この前、ロドスの事務所の奴に会ったんですが、また昇進したって嬉しそうに……ケッ、自慢ばっかしやがって、俺よりちょっと休みが多いだけじゃねぇか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "……ロドス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "前にうちと組んでた――チェン隊長を連れてったあのロドスか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "あいつらとっくに消えたんじゃねぇのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あぁ……ロドスの龍門事務所のことを言ってるんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "確かあそこは人材募集もやっていたはず……前に何人か連れ立ってあの事務所に押しかけて、騒ぎを起こした街の連中、結局その場で説得されてロドスで働くことになってただろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼らの求心力は尋常じゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "お前もわざわざちょっかい出して迷惑はかけるなよ。今あの事務所にいるのはみんなこの龍門の市民だから、後ろ暗いものは出てきたりしないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あとでほかの連中にも言っておけ、バカなことはするなと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "しませんよ。みんなわかってますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "ロドスの奴らとの関係は……まぁそれなりですよ。たまに一緒に飲むことだってありますしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "しかしロドスってのは変人が多いですね。現地職員以外にも、たまに外からやってくる奴に出くわしますけど、なんだかタダ者じゃなさそうな奴ばかりで、目を引くんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "先週なんてラテラーノのナントカ修道会とかいうところの若い娘も一緒で……それがですよ、あいつらすげー酒強いんすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "えっ！？　こないだベロンベロンに酔って帰ってきたあれ、ロドスの人と飲んでたんですか！？　入ってくるなり俺にゲロまでぶちまけたあの時の！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "えっ……そんなことあったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "ありましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "わかったわかった、俺が悪かった。今度お前が彼女とデートしたい時に言え、休みの許可は出してやるから。それでいいだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "あと少しの辛抱だ……都市の再建スケジュールが決まれば、今の忙しさも落ち着くだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "それはもちろんわかってますよ……けど正直、落ち着く前に彼女の方が先にいなくなってそうですけどね……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "へっ、そいつは都合がいい。なら休みはいらねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "その辺にしてやれ、言い過ぎだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "大丈夫ですよホシグマ隊長。もう慣れましたから。こういう人なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "うるせぇぞ、ガキんちょが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した近衛局局員",
      "text": "隊長も隊長ですよ。今日はせっかくのオフなんですから、こんなとこで話してないで、早く帰って休んでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "そうですよ、ここは俺たちに任せてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "なんだなんだ、厄介払いか？　私も嫌われたもんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "ち、違いますよ、そんな意味じゃ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ、わかってるからそう慌てるな、冗談だよ。ちょっと様子を見るついでに、こいつを持って来てやろうと思って寄っただけだ。良い店を薦められてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "朝飯はまだだろ？　ほら、焼きビーフン。美味いらしいぞ。じゃあ頑張れよ、私はもう行くからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はぁ、疲れた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "数日徹夜しただけで、こんなにしんどく感じるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "歳か？　いや、まだギリギリ若者ってくくりに入るはずだけどな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "入ってるよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はぁ、まあいいか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "なぁ、相棒、お前はどう思う？　……お前を走らせるのも久しぶりだよな。今日はいい風が吹きそうだし、二人で外岡地区のサーキットにでも繰り出して、たっぷり浴びてみるか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ん？　排気音がちょっと変だな……まさかお前も歳か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いや、そんなわけない。70vvだ。型はまだ古くないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "確かに後継モデルは最近出たが……「――さながら波ひとつない穏やかな水面を吹き抜ける疾風。閃光になったかのような乗り心地」だったか？　あの会社の広告はいつも面白いよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "乗ってみたいとは思うが値段がな……安心してくれ相棒、お互いに我慢しよう。私の給料はそんなに高くないし、好き勝手に使っちゃダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "お前が時代遅れになるのはまだ先だし、私も定年にはまだ早い……私たちなかなかお似合いじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "なぁ、チェンはどうしてあんなに意地っ張りなんだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ロドスで上手くやっていけるんだろうか。ケンカしたりは……するだろうな。人付き合いが下手なわけではないけど、進んで関係を良くしようとはしない人だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さにあらず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "――誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "チェン殿は、そのような頑固な分からず屋ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "決して、意固地なだけの御仁ではありませぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ああ、誰かと思えば、シラユキ殿か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "（うなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "ホシグマ隊長、拝謁つかまつる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そう改まらずに、シラユキ殿はなぜこちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "姫にしばしこの場を見張るよう命じられたゆえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そうでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "シラユキ殿は先日、フミヅキ夫人に指示されロドスに派遣されたとお聞きしましたが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "アーミヤのお嬢さんはお元気ですか？　それと彼女のそばにいるドクター……あの時、遮蔽物に張り付いたまま指揮していました。見事な采配とはいえ、散々な姿でした。今はどんな様子です？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "両名とも活力みなぎり、意気軒昂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "日々ギャーギャーと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "騒々しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハハハッ、相変わらずのようで何より。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "どうやらシラユキ殿も、ロドスに対しては好印象のようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "ロドスは確かに良き所……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "チェン殿もまた然り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "……憂う必要は無し。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "シラユキ殿までそういうことを……それほど小官がチェン隊長を心配しているように見えますか？　本当に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そんなことはないですよね。もしそうだとしたら、お嬢様がみすみす見逃すはずがない。今朝会った時に、小官の顔の皮は引っぺがされていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ご安心ください、シラユキ殿。小官は本当にそこまでチェン隊長の心配はしていませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "本当です。チェン隊長は真っ直ぐすぎて折れやすいように思われがちですが、実はとても周到で、柔軟な思考を持っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "小官も最初、彼女と知り合った頃は気付きませんでしたが、一緒にいるうちに段々わかってきたんです。彼女はつまらないことに固執さえしなければ、どこでだってやっていけます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "チェン殿は聡明で機知に富む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "口が達者で、腕も立つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "並みの者では太刀打ちできぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ、その通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "チェン隊長は、不条理に対してありとあらゆる方法で立ち向かう。正当な理由があれば相手が誰であろうと糾弾する。彼女が臆する姿など見たことがありません。あんな人、他に見たことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "チェン殿は……質実剛健。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あの人は、会った時からずっと変わってません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "小官はいつも彼女のことを義侠心あふれる人だと思っていました。もし侠客漫画なら、きっと主人公になるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……立ち塞がる困難や負った怪我は、フィクションならば物語を面白くします。けど、その傷が現実に自分の身に刻まれると、痛いんですよね本当に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "時々、酷く傷ついて、痛みを堪える彼女を見ると、こうまでするだけの価値があるのだろうかと、思わずにはいられませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "実際、ないんですよ。正直に言えば、彼女が己を傷つけるだけの価値なんて、小官は全く、これっぽっちも、ないと思っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "でも、本人はあると思っているんです。小官はね、彼女がその真っ直ぐさから損することを心配しているわけではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "多少の損は、悪いことではないですから。しかしあまりにそれが大きいと、取り返しのつかない目に遭うこともあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼女は納得ができなくて、いつまでもそのわだかまりを捨て去れないんじゃないかと、ただそれが心配なんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "チェン殿は心も広い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "今では心の憂いも晴れ、誰にも遮ることはできぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "シラユキ殿はよくわかっていらっしゃるようですね。ウェイ長官やフミヅキ夫人は言うに及ばずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "ホシグマ隊長もまた、侠客なり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "小官が？　それは美化し過ぎですよ、自分のことは自分が一番よくわかっていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "若い頃は無知で、当たり前に夢も見ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "血気盛んでしたから、衝動に身を任せたことも一度や二度じゃありません。ですが、そうした夢を見る時間が終わったら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "少年が少年で、少女が少女でなくなってしまったらどうなるか。物語ではその後のことは書かないでしょう。書いても読者に非難されるだけで、徒労にしかならない。いっそ書かないほうがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "物語ならハッピーエンドで終えることができますが、現実の人生はそうはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もし侠客が私のような、そこらへんの一般市民と変わらない普通の者なら、誰にも好かれませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "自分をそう卑下するものではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "これを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "これは……漫画？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "太金通りの二つ目の路地にある書店で見つけた、今月の新刊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "差し上げよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……珍しいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ありがとうございます。でもシラユキ殿がどうしてこれを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "読めばわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "text": "では。シラユキはこれにて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（これは……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（新人漫画家、鮮烈のデビュー作。読者ランキング二位。人気連載漫画家が口を揃えてお薦めする……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（なかなか面白そうだ。表紙のこいつが主人公か？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（なんだか見覚えがある姿だな……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（この盾を持った大柄の奴は――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あっ！　……ハハッ、そういうことか。道理で――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "大した度胸だ。だがちゃんと描かれている、絵柄も悪くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "まぁ、いいか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "しかし今度チェンに会ったら、何と呼べばいいのかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "チェンさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "悪くないな、意外としっくりくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（スピードが足りないな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（コーナーは……だいぶ先か。よし、もう一つギアを上げられる。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一本角の鬼は、ふっと息を吐いた。\n激しい風の中を走るのは久々で、懐かしさを感じるほどだった。向かうあてのない疾走……跨った愛車が咆哮するたびに、彼女の中では、かつての命知らずな血が燃えたぎっていた――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "――突然、背後から、もう一台の獰猛な機械が、エンジン音を響かせるまでは。\n獣の唸り声にも似た音を耳に入れてすぐ、ホシグマは我に返って、過去の残像を振り切った。今の彼女はもう、龍門近衛局の特別督察隊隊長だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（何者だ……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（音が後ろから、近づいてくる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私に追いついてくるとは、なかなかのスピードだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "へえ、あのデザインとエンジン音……広告にあった最新モデルか。恐らくカスタムもしているなこれは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私たちも負けられない。気張れ相棒。もう一段上げていく。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（しかし、おかしいな。いつの間にこんなスゴい奴が？　しかも私が聞いたこともないなんて。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（これじゃ、なんだかまるで、あの都市伝説――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（「真夜中に無人の通りを疾走していると、コーナーで突然現れるという、亡霊のようだ。」）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "（……だが最新型のモデルに乗ってるなんて話はなかった。しかもあの亡霊、本当は……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……いや、まさか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……ふぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "すごいですね。私の負けです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "辛うじて勝たせていただきましたよ。先ほどのあのコーナリングは芸術的でしたね。もし、バイクの性能差がなければ、あなたを抜くことはできませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "ごきげんよう、ホシグマ督察。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "フミヅキ夫人には敵いませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "あら、驚いてないようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そう見えますか？　実のところかなり驚いています。あんなスピードでカーブを曲がるのを見て、ようやくあなたなんじゃないかと思い当たりました。しかし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "夫人の愛車は有名で、誰もがよく知っていますが……今日のこのバイクは初めて見ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "どうします？　私に切符を切りますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "まさか。そもそもこのサーキットは普通は入れない、レース専用のコースなんですから……これで切符を切るなら自分自身にも切らなくてはなりませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "フフッ、近衛局の皆にはいつも苦労をかけていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いえいえ、仕事ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "どうかしましたか、ホシグマ督察。何か言いたげに見えますが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いや……何でもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ただ、ここの風は気持ちがいいなと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "アクセルを力一杯踏み込んで、スロットルを全開にすると、素晴らしく爽快です。こういう日は特にね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "そう、まさにそれなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "すべきことが多くてどうにも気が塞いでしまう時に、ここで風に当たると、本当に解放的な気分になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "でも、あなたが言いたいのはそれだけじゃありませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ふぅ……やっぱり夫人は何でもお見通しですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私はただ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ウェイ長官がここ数日ビルの下に停めていたあの、彼の趣味に全く合わないストリーム-35LLモデルは、やっぱり彼のものではなかったんだなと思っただけですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
