{
  "server": "jp",
  "storyId": "main_11_level_main_11-08_end",
  "groupId": "main_11",
  "stageId": "main_11-08",
  "title": "この命でもって",
  "storyCode": "11-9",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_11-08_end.txt",
  "sourceHash": "3d119ec3fe1db2386de3845655fee2b77cc76211ac9c6b2439b6e5c95951a9f2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "ジョージ、行く気のある奴はみんなそろった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "トミーは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "見当たらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "いいさ、任意だからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ジョージおじさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "フェイストか。キャサリンがお前に残したものは見つかったみたいだな。望んでいたものだったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "ならよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "欲しいものを手に入れたなら、さっさと行けよ。さもないと、出られなくなるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "待ってくれ、何かあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "サルカズたちがキャサリンを何のために連れていったかわかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "さっきは妙と思ってな、ダイに工場を登らせて確認してもらった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "あの人は知り過ぎたんだ。奴らはあの人のような工員を秘密裏に処刑しようとしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "なん……だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "キャサリンは俺たちが何も知らないと思って、隠してたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "だが俺たちだってバカじゃない、多少は察するさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……そんでおじさんたちは何する気なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "大したことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "……俺たちはずっとサルカズに我慢してきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "大抵の連中が慣れちまった。このぬるま湯状態に、骨の髄まで浸かり切っちまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "もうちっと辛抱すれば、サルカズは俺たちを見逃してくれると思ってる奴だっていっぱいいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "だが、奴らは今キャサリンを殺すつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "あんたたちも死ぬぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "キャサリンが奴らに殺されるのを、黙って指くわえて見てるよりましだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "ここに集まったのは、もう後先なんて考えちゃいない奴ばかりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "もういい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "お前はもう自救軍の人間だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "お前らがやったことは、どれも聞いている。結構な奴らが実はお前らの行いに喜んでるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "お前は、もっと大事なことをやらなきゃいけないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "キャサリンの選択を無駄にするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ドクター、確かにばあちゃんが残してくれた情報は手に入れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "けどさ、この工場の代表者として、サルカズが何を製造して、どこに運んでいるかを一番知ってんのがばあちゃんなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ばあちゃんは戦略上重要な価値がある。だよな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "疑う余地はない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "否定はしない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "……だったら、ロドスに協力を仰ぎたい。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アスカロン、いるか？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "たしか君は自分を見張……ついてきていたな？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "ここに。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君ならきっとすでに敵の配置を把握しているだろう。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "このエリアの敵の配置を教えてくれ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "奴らは守りを内側に固めた。外側は隙が多い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "中心部以外を守っているのは、ほとんどが組織力のない傭兵団だ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "しばらくの時間が必要だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "傭兵の視線をそらし、斥候を片づけてくれ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "問題ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "ありがとう、ドクター、アスカロンさん。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "フェイストが深く息を吸った。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "彼は自分の社員証を胸に付け、工員たちの列に加わった。"
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "バカな真似はよせ、フェイスト。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "みんな、俺は自救軍メンバーとしてここに立ってるんじゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "俺はこの工場で育った人間として、工員頭キャサリンの孫としてここに立っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "俺はここの人間だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "あんたらと同じく、キャサリンに死んでほしくないと思ってる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "それに、俺はキャサリンを死なせないだけじゃなくて、あんたらも死なせない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "サルカズの情報の伝達なら、こっちのドクターの部下が阻止してくれる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "キャサリンとほかの工員頭を救い出せれば、俺たちがハイベリー区から撤退する時間は十分ある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "あんたらを自救軍に合流させる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "全員助かる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "……全員助かるべきなんだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "工員たちが互いに顔を見合わせた。\n彼らは、お互いの目の中に希望の火が燃え上がるのを見た。\n彼らは自ら歩みを進め、フェイストの後ろへと立った。\n彼らはフェイストを信じると決めたのだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "フェイスト、お、俺も行くぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "トミー……やっぱ来たのか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "だけど、あんたは残ってて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "なんでだよ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "親父さんの具合が良くないから迷ってたんだろ、違うか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "だけどよ――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "それに、頼みたいことがあんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "俺たちの行動がどういう結果になろうと、三十分後サルカズに告発しに行け。工員が勝手に騒ぎを起こしてるってな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "でも……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "これも大事な仕事なんだ。ここに残るみんなにまで危害を及ぼすわけにはいかねーから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "……わかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "そんじゃ、みんな、行こうぜ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "俺らのボスたちを助け出すぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員たち",
          "text": "オーッ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "キャサリンが黙ってタバコを吸っている。\n顔馴染みが一人一人、サルカズに臨時の処刑場へ引き立てられるのを見ていた。\nよく知る顔に浮かぶ感情は、怒りであったり、諦めであったり、あるいは嫌悪だった。\nそして、どれも最終的には凪いで落ち着いた顔つきになった。\n彼女はわかっていた。すぐに自分の番が回ってくる。\n心に、これまでにないほどの静けさを感じた。\nフェイストが言っていたことは正しい。\n妥協や服従も、問題を解決することはできない。\n彼女は自らの選択に代償を払わなければならない。\nしかし少なくとも、代償を払う前に再び孫に一目会うことができ、少しは役に立つものを残してやれた。\nそれで十分だ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "お前の番だ、ババア。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "連れてけ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "自分で歩けるよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "そうだ、パプリカ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "グリンはお前に人を殺させたことなかったろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "……そうっすけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "ならいい機会だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "殺すことも学ぶべきだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "サルカズは、子供をそんなふうに扱うのかい？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "お前の話は聞いていた。お前の言う通り、こいつは戦争が何かをまだ知らねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "可能であれば、俺だって知りたくはねぇさ。サルカズだろうが、みんなそうだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "だけど、お前らが俺たちに選択肢を与えなかったんだ。お前らの全員がだ。だから今、こいつは知るべきなんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "お前の目つきは嫌いじゃねぇ、ババア。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "死んでも死にきれねぇ戦友を見ると、そいつらもみんなそんな目をしている。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵",
          "text": "俺は多くの人を殺してきた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵",
          "text": "だが、抵抗する力のない奴を一人一人処刑する感覚は、どうも不思議だな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "……やりたくねぇなら、帰っていい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "昔こいつらの作った武器が、お前の同胞を殺すために使われたかもしれねぇだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "俺たちは戦争をしてるんだ。道徳なんてのは平和になってから引っ張り出すもんだろ。こんな話題を公平に議論する機会なんて俺たちにはねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵",
          "text": "そんなことはお前に言われるまでもない、俺はただ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "ん？　ドローン？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "今だ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "ドローンで周りは偵察した。ここで間違いない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "行くぞ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "えーっと……ほかの人にやってもらうのはダメっすか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "ダメだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "グリンはお前に教えただろう。隊長の命令は、傭兵にとって絶対だとな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "お前の選択肢は二つ。このババアを殺すか、武器を置くかだ。だが後者の場合は、俺がお前を始末する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "うちは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "やれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "けど……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "やれっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "うち……うちにはできない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "……だから言ったんだ、グリンはお前を甘やかしすぎだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "俺たちは、ヴィクトリア人に故郷を返せと説得しに来たんじゃねぇんだ。やれねぇなら、お前が痛い目見ることに――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "ん――ドローン？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵",
          "text": "隊長、工員の奴らが大勢突っ込んできました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "何だと？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "フェイスト、俺たちの方はドクターが指揮してくれる。他の傭兵を引きつけるから、キャサリンはお前に任せたぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "ああ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "……お前ら気でも狂ったか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "狂っちゃいねーよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "あんたたちが連れてったベテラン工員たちの経験が、どんだけ貴重なもんかわかってんのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "みんな欲しがってんだぜ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "フェイスト！　あんたたち――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "フンッ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "何も知らねぇふりしてりゃあ、もう少し長生きできたものを。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "あいにく、昔からばあちゃんに余計なことを言い過ぎだって叱られてたもんでね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "俺に勝てるとでも思ってるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "無理。でもそっちにいる人ならできるかもよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "なっ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵隊長",
          "text": "うっ……！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……くそったれだね、くっ、ほんと硬いよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "感謝するよ、ジョージ。少しは気が晴れた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "感謝するなら、まずフェイストにしな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "それと……こっちのサルカズは攻撃してこないのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……お嬢ちゃん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "あんたらの隊長は間違っちゃいないよ。今のあたしらは、正しい正しくないを議論すべきじゃない。そんなもん議論できやしないからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "でも、もしあんたが自分が何のために戦っているのかさえわからないなら……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "……ダメ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "あ、あんたたちは行かせない……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ傭兵",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "……しゃーねー。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "行くぞ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "何が起きた、他の奴は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "これ以上連絡が取れないのなら――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "うっ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "サルカズの戦士は自分の身体が軽くなるのを感じた。\n身体が制御できずに前へ倒れる中、次第にぼやける視界に、一つの黒い影が映った。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "それはサルカズだった。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "な……なぜ……サルカズが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "最後の一人。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "独り言でしかなかったが、アスカロンは確信をもっているかのように武器をしまう。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "彼女の位置からは、憤る工員たちがサルカズの傭兵たちを追い散らすのがはっきりと見えた。\n長年かけて積もり積もった怒りの前では、孤軍の暴力などたやすく崩壊する。\n強者と弱者が入れ替わり、とある過去が心に浮かんだ。\n彼女はすぐに視線をある方向へと向けた。\nそれはロンディニウムの中央だ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "……傭兵は全員拘束したぜ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "こっちの負傷者はどれだけいる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……多くはないよ。このお嬢ちゃんのとこの傭兵がすぐに手を出さなかったんだ。奴らみんなまごついててね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "戦う決心すらついてなかったよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "うちらは――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "うちらは……ただ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……少なくともあんたらは抵抗しようとしてたさ。狡猾なロンディニウム人に襲撃されただけだよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アスカロンが周囲の面倒を片づけてくれた。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我々の時間は多くない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……あたしら老いぼれが何人か死ぬだけでよかったものの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "今度は、あんたら全員がサルカズの刀の餌食になる瀬戸際だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "これはあんたの考えかい、お利口なフェイスト？　あたしらの長年の辛抱を全部無駄にする気かい？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "違う。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "もし、俺が今日黙ったまんま、ばあちゃんたちの死と引き換えに生き延びたとしたら、明日は、また別の犠牲者が出るだけなんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "……仲間の生死を本気で気にかける奴がいなくなるまでな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "それに……こんなのばあちゃん一人がいつまでも全部決められることじゃねーだろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "その通りさ、けどあんただってそれは同じだよ、フェイスト。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "でも、今回は全員、自分からばあちゃんを助けに来たんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "サルカズは何年も都市を占領してきた……俺たちの暮らしは苦しいものだった。だけど、俺たちにも絶対に失ってはいけない限界ってのがある。もし今日ここに来なけりゃ、俺たちは――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム工員",
          "text": "俺たちは、この混乱した状況の中で、サルカズにゆっくりとまとめて絞め殺されるだけだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "ジョージ……あんたたちまで、この子のおふざけに付き合ってるのかい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……全員がここにいるわけじゃないだろう。つまり、あたしが生きて帰るのを別に望んじゃいない人がたくさんいるんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "……現実の残酷さってのはね、あんたの想像なんて軽く超えるものなんだ、フェイスト。他人の道徳心に夢を見るんじゃないよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "でも事はもう起きちまった……はぁ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "キャサリンはしばらくの沈黙の後、パプリカを見た。\nだが、ついに何も言わなかった。"
        },
        {
          "type": "dialogue",
          "speakerName": "キャサリン",
          "text": "行こうか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
