{
  "server": "jp",
  "storyId": "act32side_level_act32side_03_end",
  "groupId": "act32side",
  "stageId": "act32side_03",
  "title": "仮面舞踏会",
  "storyCode": "CR-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act32side/level_act32side_03_end.txt",
  "sourceHash": "75000d089c49ff8599024a3e962c0441e56fd473559423a9041deb53dfdaf1f6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "……ううっ……頭がズキズキする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "やっとお目覚め？　はい、氷。おでこ冷やしとけば？　でっかいタンコブできてるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "お前は……さっき襲ってきた子供じゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "……次アタシのことを子供呼ばわりしたら、後ろ頭にもう一個タンコブ作ってやるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "……何があったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "ざっくり言うと、彼らは盗まれた薬を取り戻すことができて、そのおかげで私たちの誤解も解けた、って感じかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "薬とか誤解とか、何の話だ？　どうやって解決したんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Doc",
      "text": "とある不憫な運転手のおかげさ。なかなか口の堅い男だったが、吐かせるのはそう難しくもなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "わからん……余計に混乱してきた……ところで、ここはどこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Doc",
      "text": "肩を貸してやるから、自分の目で確かめてみろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "はい、あなたの分の薬よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "ああ……ありがとう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "名前は？　このリストの、自分の名前があるところに、チェックも入れておいて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "マイクだ……わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "あら？　終わったはずなのに、まだ二つ残ってるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "もう一度リストを確かめましょう。受け取り忘れてる人がいるのかも……チェックのない人は誰かしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "……最後の二つは、アタシのだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "そう。じゃあ受け取って、テクノ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "こほん……その、今日のこと、本当にごめんなさい。薬を盗んだのが本当に他の連中だったなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "気にしないで。薬を取り戻せてよかったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "ギュスターヴから話は聞いたわ。ここに住む人の多くが、特殊な病気に罹ってることも、この抑制剤がなかったら、きっと悲惨な結果になっていたことも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "ところで、例の運転手が言ってた大尉って、レイネルと揉めてた奴だよね？　それがどうして急にアタシたちの薬を盗んで、アイツのご機嫌取りなんて始めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "ミウォシュが言うには、奴の狙いはレイネルが持ってるこの近辺の開発権らしいから、それと関係あるのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "ふん、そんな物を手に入れてどうする気なんだか。持ち主のレイネルだって、ここ何年かはアタシたちに手出しできてないってのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "それならよかったわ。ここの文化はとっても魅力的だから、開発されてホテルだのカジノだのになるのはあまりにもったいないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "へえ？　ここに来てまだそんなに経ってないのに、いろいろわかってるみたいに言うじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "この半日の間だけでも、薬を受け取りに来た人が揃いも揃って、自分のアートを全力で売り込んできたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "生活かかってるからね……ところで、腕につけてるそれ何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "刺繍細工のブレスレットよ。買うつもりはなかったんだけど、あの子の針傷だらけの手を見たらね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "（小声）下手くそだなぁ、作ったの誰だろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "何か言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "えっと……その……アタシのアトリエに来てゆっくりするのはどうかなって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オークションの司会",
      "text": "ただいま五千万ドル、入札希望者はもういらっしゃいませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オークションの司会",
      "text": "では、五千万ドルで落札となりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "なんの話だ……？　物が盗まれ続けてる倉庫？　どこのことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "あなたが買収して半年後に倒産した製薬会社の倉庫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ああ、そんなこともあったかもな……つまり、あのコミュニティの薬を盗んだ何者かが、君たちに罪をなすり付け、倉庫にこっそり運び込もうとしたわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "正確に言えば、罪をなすりつけられたのはあなただけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "なるほど。では僕はどうするべきだと思う？　誤解を解いてくれた君に礼のひとつでも言えばいいのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "その必要はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "そういえばミウォシュから聞いたよ。僕が貸した家を離れるつもりだそうだね。探していた友人が見つかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "それはまだ。泊まる場所を他に見つけただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ほう、それはどこかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "例のコミュニティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "あの場所か。特に異論はないが、出ていく理由を聞かせてもらってもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "あの場所で面白い物を見つけたからよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "ここがアタシのアトリエ。かなり広いから、他のアーティストと一緒に創作したり、インスピレーションを得たりするののに皆で使ってんの。作品の展示もいくつかあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "そこに並んでる湿った画用紙は、ボツになった物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "違うよ、それも作品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "作品？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "絵を描き終えたら外に持ち出して、雨が降るまで待つことにこだわる画家がいるの。塗り終わった絵の具が雨水で溶けて、元の絵から変化して……それでやっと完成なんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "へぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "じゃあ、向こうで肉体美を披露してる彼は……？　まさに、インスピレーションを求めてる最中かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "厳密に言うと違うかな、彼自身が作品って感じ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "なるほど、パフォーマンスアートね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "前に説明パネルがあるから、読んでみるといいかも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "「作品名、ペピ・トゥリオン……制作者、ペピ・トゥリオンの両親……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "「作品紹介。制作者は作品が世に出て半年足らずで、当作品に経済的価値がないと判断し、ドッソレスの郊外に廃棄した……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "「しかし製作者は想像すらしていなかった……二十年後ペピ・トゥリオンが……ドッソレスが誇る稀代の名作になるということを……老いぼれどもめ、後悔するがいい！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "ワーオ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な顔の男性",
      "text": "やあ皆さん。私はここドッソレスで最も偉大なオリジニウムアーツマスターだ。我がアーツの妙技、見物していかないかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "なあテクノ、彼は君以上の実力者なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "オリジニウムアーツに関してなら、彼の右に出る人はいないくらいには。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "ほう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "披露するのはいいけど、お客さんを傷つけないようにしなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な顔の男性",
      "text": "もちろんだとも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男はポケットから、オレンジ色に鈍く光る黒い結晶体をいくつか取り出した。それを見た四人は、慎重な足取りで数歩後退る。\n大きな手のひらの上で、純正源石がころころと転がされている。しばらくして、それらが次々と放り投げられ――\n純正源石を使ったお手玉のパフォーマンスが始まった。\n何周かさせた後、男は純正源石を一度に全部、空中に放り投げ、顔を天井に向けると、落ちてきた一つ目の純正源石を鼻先でしっかりと受け止めた。\n二つ目、三つ目、四つ目……そしてラスト。すべての結晶が一つ、また一つと男の鼻先に積み上げられ、塔の形を成していく。\nそれから男が顔を軽く横に動かすと、純正源石の塔はまるで平行移動したかのように、手のひらの上に戻っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "オリジニウムアーツって……光とか、火の球とか、そういうのじゃなかった？　これも……アーツの一種なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な顔の男性",
      "text": "これはオリジニウム結晶だ、そうだろう？　そしていま私が披露したのは芸、すなわちアーツだ。となればまさにオリジニウムアーツそのものではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "そう……かもね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "やっと着いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "前の扉を開けてみな。これこそうちのとっておき、目玉になる予定のアートだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Doc",
      "text": "前にも言った気がするが、もう一度言わせてほしい――もう何を見ても不思議には思わなくなってきたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "これは……木製人形の頭が二つ？　ずいぶん大きいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "まだ頭しかないけど、身体が組み上がったらもっと大きくなるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "芸術祭初日の夜、この子たちは二人のダンサーとして出演するの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "双月がゆっくりと沈んだ後、日の光が人々を照らすにはまだ早い……そんな時間に踊り出すわけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "芸術祭の主役として脚光を浴びて、最っ高に綺麗なフォームで街を優雅に舞い踊って。アタシたちの代わりに、リズミカルにステップを踏みながら、コミュニティ中を踊り回ってくれるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "きれいな光景になるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "その時は、人もみんな一緒になって踊り出すんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "ううん、それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "……どうだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "どうかしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "……昔、ダンスホールで火事があってから、この辺の人は誰も踊りたがらなくなっちゃったんだよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "こうして語ってきたように、あそこには斬新な構成に豊かな感情、そして精緻な表現を持つアートがたくさんあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "面白いね……君の話を聞いていると、僕も彼らが作る物に興味が湧いてくるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "コミュニティに向かうつもりなら、いっそ僕の代わりに確かめてきてくれないか？　彼らが一体、何を成そうとしているのかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "あなた、芸術祭と開館式が同じ日に開催されることをよく思っていなかったんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "だからと言って、彼らがやろうとしていることに興味を持てないわけじゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "代わりに見に行くのは構わないけど、彼らとのゴタゴタに巻き込まれるのは御免よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "巻き込む気なんてないさ。無論、彼らに日程を変えるよう説得してくれるなら、とてもありがたくはあるけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……保証はしかねるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "それでも、やらないよりは、やってみるべきだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "なんにせよ、あなたに彼らのやることを理解しようとする気があるなんて驚きね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "君に僕を理解する気があれば、驚いたりなんてしないと思うが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "私はてっきり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オークションの司会",
      "text": "コレクションNo.257のオルゴール。1500万ドルから。入札希望者はいらっしゃいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "シッ……今は集中させてくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "（カードを掲げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オークションの司会",
      "text": "入札ありがとうございます。では、ただ今2000万。他の方は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "（カードを掲げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オークションの司会",
      "text": "えっと……同じ方から2500万……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "（カードを掲げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "ちょっと、もう十分でしょ。競り合う相手なんていないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "（カードを掲げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "そうじゃない。他人がつけた値段なんて関係なく、僕は僕の思う適切な価格まで値を吊り上げたいだけなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "申し訳ございません、私が軽率でした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "まさかあの愚か者どもが、連合政府の軍人に盾突き恥をかかせるほど大胆だったとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "はっ、承知しております！　次こそは成功させてみせますので――いえ、その次はないとお約束いたします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "もしまたこのようなことがあれば、解任でも懲戒処分でも受け入れます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "大尉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "黙ってろ。クソッ、上層部にもやらかした運び屋のことを知られてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "あのマヌケが丸裸でオフィス前に晒されていた件を、お偉方は連合政府への明確な侮辱行為だと考えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "レイネルと協力関係を維持できるかだの、あの土地をモノにできる可能性はまだあるかだの……この状況で、無理だと言えるわけがないだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "*スラング*！　能無しのマヌケどもめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "大尉、その……レイネルの秘書が来ていますが、お会いになられますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……ああ、通せ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "レイネルの代わりに俺を咎めに来たのか？　勘弁してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "まさか。レイネルはあなたの効率的な仕事に大変満足しています。強いて言えば、やり口がいささか無計画だったのは玉に瑕と考えているようですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "コミュニティには多くの感染者がいますから、薬を奪えば確かに彼らを無力化できるでしょう。しかし、もしそれで感染者が大勢死んでしまった場合……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "処理を誤れば、我々の立場がなくなります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……それはわかってる。他に……レイネルはなんて言ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "この間はリスクの高い行動をしてしまったことだし、今度はもう少し慎重に動いてはどうか、と。平和的解決の余地もまだ残っているはずですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "ハンッ、今さら交渉しに行けと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "早とちりなさらず。今回はあなたの手を煩わせはしません。既に交渉役を送り込んでいますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "交渉役？　誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "Elaさんと、彼女の小隊です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "彼女たちのことはご存じでしょう？　あなたの部下が交戦した相手であり、彼らと混同された人々でもありますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "俺たちは協力関係にあるということを忘れるなよ、ミウォシュ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "ご安心ください。レイネルには、あなたとの協力関係を反故にする気などございません。ただ、少々冷静になっていただきたいだけなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "土地の件については、落ち着いてからまたご相談しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "ところで、大尉の方からレイネルへお伝えになりたいことはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "なければ、これで失礼いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "そうか……レイネルの*スラング*野郎め、俺が掌の上で踊る姿を見て笑っているんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "*スラング*……俺があの土地を手に出来なかった時は、ぶち殺してやるからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "1億5000万？　たかがオルゴール一つの値段を、一人でそこまで吊り上げたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "彼は気まぐれな人ではあるけど、あの入札の仕方を見るに、自分が芸術と認めた物に対しては真摯なんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "なんだか、あの人のことを見直し始めてるように聞こえるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "端から彼に文句があったわけじゃないのよ、マイヤー。掴みどころがない人だから困ってただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "それが彼の面白いところでもある、ってことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "そうね……よく見る退屈な美術商じゃないというのは認めるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "あなたの口からそんな評価が出るなんて……それだけで充分すごいことよ。いつもならどんな雇い主だろうと気に入らないって言ってるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "それで、今後はどうするの？　彼との契約は続ける？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "まだ何とも……考えておくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "なんであれ、レイネルさんには感謝しなきゃね。彼の助けがなければこんなに早くここに溶け込めなかったでしょうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "でも命を助けてあげたのよ。遠慮する必要もないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "あのさ、Ela……ちょっと一緒に来てくれる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "いいわよ。何かあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "実は、おっちゃんが会いたがってて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "ディアスさんが？　何の用かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "直接聞きたいことがあるみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "わかった。すぐ行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "それとさ、その……おっちゃん、もしかしたらめちゃくちゃヤな感じの態度に見えちゃうかも……高圧的で怖いっていうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "へえ……強く出て主導権を握ろうって魂胆かしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "本人にその気はないだろうけど……まあ、そんな感じかも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
