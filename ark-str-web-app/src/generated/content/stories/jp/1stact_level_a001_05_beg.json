  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "入り口はこの洞窟だけ、そうだったよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "ええ。洞窟の中は分かれ道だらけで罠もあるけど、村の長老達に何回も連れてきてもらってるから。村長を継いだあの日も……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "……まさかとは思うけど、あの辺り、森から聴こえてくる叫び声が多くなってきてる気がする……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "このままだと、敵がここに来るのも時間の問題だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "キャロル、君は財宝までの道を知ってる。すぐに洞窟に入って財宝を取ってきて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "えっ？　じゃあグラニは……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あたしは洞窟の入り口に残る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "そんなのダメ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "えっ？　キャロル……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "一人だけであんなに多くの賞金稼ぎを相手にするなんて……危険すぎるよ！　そうなればグラニも無事じゃ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "でもキャロルが財宝を手に入れられなければ、村のみんなに申し訳が立たないし、君に合わせる顔だってないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "……でも私はグラニを失いたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "あなたがここで、私たちのために命を懸ける必要なんてない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あたしはあたしのために命を懸けるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "「例え蛮族の凶刃が己の心臓を貫きたとしても、我ら王室騎兵の真槍は地に落ちてはならぬ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あたしはここで逃げるわけにはいかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "グラニ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "それにキャロル。戦ってるのはあたしだけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "君だってちゃんと戦ってる。危険だってわかってて、何度も怖い思いだってしているのに…それでも村のために戦ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "なのに、あたしだけ逃げるなんて絶対にできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……お願い。財宝の回収は任せたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "でも……もしあなたを失ってしまったら……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "財宝を手に入れたって……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "キャロル、あたしを信じて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "君のことはあたしが守るから。何があっても！　あのとき君を助けた時に決めたんだ。もう誰にも君のものを奪わせない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "例えそれが髪の毛一本でも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "……本当にあなたって人は……まだ小さい子供なのに……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あ、あたしは子供じゃ……背がちょっと、ほんの少し低いだけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "フフッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "……うん、じゃあ待ってて、グラニ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "この仮面野郎どもめ、お前らまで邪魔するのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "なんだ烏合の衆か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前らなぞ我々と財宝を争う資格すらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "あぁん！？　なに言ってやがる。ここは俺たちがとっくに占領してんだ。テメエらこそ尻尾を巻いてお家に帰りな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "（この角度ならちょうど南側の戦場が見える。賞金稼ぎとレユニオンで混戦になってるみたいだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "（どこから敵がこの洞窟に向かってきても、あたしは――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "奴らが向こうで小競り合いをやってるうちに、俺たちは洞窟の中へ向かうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "おい待て、なんか小せぇ奴が入り口を塞いでやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ここは誰も通さない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "ぐわーーっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "お、お前――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたたち、黙って道を開けなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私は今、とても機嫌が悪いの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
