{
  "server": "jp",
  "storyId": "story_angel_set_2_story_1",
  "groupId": "story_angel_set_2",
  "stageId": null,
  "title": "変化中の不変",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_angel_2_1.txt",
  "sourceHash": "fc028013df5005fa79d1c0565241b3d56d257e299576fdcf0ca61044b9d4ca7c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "黎明破壊者",
      "text": "あなたねぇ。私ちょっとお手洗いに行ってきただけなのに、今度はまたどこへ行っちゃったのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "今命の危険に晒されてるって言ったら、信じるかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黎明破壊者",
      "text": "龍門は治安のいい街のはずだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そんな治安のいい街なのに、どうしてすれ違っただけの人間から命を狙われているのか、私も聞きたいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まあいい、理由は大体分かってるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君はとりあえずどっかでミルクティーでも飲んでて。できれば私の分も頼んでおいてくれるかな。それじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黎明破壊者",
      "text": "ちょっ、あなた手紙は──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "テキサス、君とは一応同僚のはずだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "街中で相手に剣を向けるなんて、同僚との付き合い方としてはどうなんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシアがずっとお前を探している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だが、お前は一筋縄ではいかないからな。眠らせてからエクシアに引き渡すほうが手っ取り早い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "はぁ、さすがはシラクーザ人。思考が効率的だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "認めたくないけど、さっきは危うくやられるところだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "けど、今なら君に捕まることはないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前についてエンペラーから少しは聞いている。だから別に一人で相手するつもりはない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "おーい、テキサス。配達の途中だったんじゃ？　アタシを急に呼び出したりしてどうし……\nってええ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "やぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "モスティマ！？　どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "たまたま出くわしてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "やるねー、テキサス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いつもの。私は正面から、お前は後ろに回って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "彼女を椅子に縛りつけておけば、お前が知りたがっている情報を聞き出す方法はいくらでもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "シラクーザ流のやり方で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "テキサス流のやり方で、だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "エル、まさか私を相手にするつもりなのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ボスは「企業ポリシー」ってよく口にしてるけど、その内容はころころ変わる。でも、あたしのポリシーは最初から変わってない。それはね──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "遊ぶなら楽しまなきゃってことだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "一緒に遊ぼう、モスティマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "じゃあ警察ごっこでもしようか。私を捕まえることができたら、君たちの勝ちだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どんな方法でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "手荒になっても構わないよ。その銃も使っていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "安心して、堕天使は戒律に守られてないから。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "そうだった……\nって、市街地で銃なんか使うわけないでしょ！　キミもそのアーツを使っちゃダメだからね！"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "オーケー、ここはハンデとしてひとつ……そして君は──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私もアーツの使用はなしにして構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "けど武器を下ろす気はない、そうだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "抵抗の度が過ぎなければ、ケガさせることはないはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "よーし！　それじゃ行くよ、三──（目配せ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（軽く頷く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "スタート！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ええっ、早っ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くにいるモスティマ",
      "text": "エル、もうその手は食わないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "さすがモスティマだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "テキサス、ごはんはもう食べた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ。お前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "適当に腹ごしらえしてきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "じゃもう行くか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ラジャー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "エクシアはん、今日も忙しそうやな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あ、クロワッサン。まあね。今日は露店？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやで～、今日は仕事もそないないし、露店でも出そ思て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうだ、青い髪の天使を見なかった？　ここを通ったのを、さっき遠くからチラッと見えた気がするんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あんたはんが探しとるあのモスティマっちゅう人やな？　あっちへ逃げたで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "サンキュー、助かった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "これでええか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "途中で私を売るんじゃないかと思ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ゲームしとるんやろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "おや、よく分かったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あんたはん、この街で今までずっと彼女の目をかいくぐって来れたんやろ？　そんなおひとや、自分から付きおうとる場合以外、そう簡単には見つかるわけない思てな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "へぇ。じゃあどうして手助けしてやらなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あんたはんのことが気になっとるからや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ほな、ごまかしてやったわけやし、売上に貢献してーな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ああ。じゃあフランクを一つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "おおきに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私から何を訊き出したい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやな……訊きたいっちゅーより、話したいことがあんねん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "エクシアはんはな、ここに来て、最初はひたすらあんたはんのことを探しとった。しばらくして、あんたはんが顔を出すのをただ待つようになった。そうこうしとるうちに、もう何年も経つんや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやけど、それが辛そうには見えへんかったな。そうじゃなかったら龍門であんだけ楽しそうには暮らされへんで。そんくらいはウチかて分かるさかい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あんたはんのことは何やらすごい奴やとか、言うたらアカン秘密があるとか聞いとるで。せやから、あんたはんにも何か事情があるんやろうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ただ、こんだけ時間も経っとるわけやし、ちゃんと説明くらいはせなアカンと思うで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "クロワッサン、彼女を引き留めて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "えー、今露店で忙しいねんけどー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そうか、じゃあ頑張れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "続けようか、テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "そのフランクはウチのおごりや。ゲームが終わったらちゃんと話すんやで～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "考えとくよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "雨か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "隠れるにはちょうどいいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "えっ？　会場変更？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "嘘でしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "こっちは雨だよ、今からじゃ間に合わないし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "自分で何とかしろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ちょっと、そんな無茶な──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "もしもし！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "もう！　あんまり売れてないからって扱いヒドくない……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "今からじゃタクシー拾っても間に合わないよね。テキサスさんに連絡したって無理そう……どうしよう、諦めるしかないのかな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君ってたしか、ソラ、だったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "え？　あっ、はい。あなたは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "待って、角のある青い髪のサンクタ……あなた、エクシアがずっと探してるっていうモスティマさんじゃ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "は、早くエクシアに知らせなきゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "急いでるんじゃなかったのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あっ、そうだった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "手を貸してあげようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "え？　でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "安心して、彼女には後で自分から会いに行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "本当ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "じゃあお願いします！　住所は──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "とりあえず出発しよう、しっかり掴まってて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ええっ、屋根の上を渡って行くんですか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ここまでで大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "予定より十分も早く着くなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "本当に助かりました、モスティマ……先輩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そんなに堅苦しくしなくていいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "わかった……でも、なんで急に姿を現したりしたの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ずっとエクシアを避けてたんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あ、待って。言いたいことがあるなら、あたしにじゃなくて、彼女に直接言って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "関係ないけど、ずっと訊きたかったことを訊いてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私に答えられることならね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "その、サンクタって……本当にみんなエクシアみたいに毎日屈託もなく生きられるものなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まぁ、結論から言うと、確かにほとんどのサンクタはそうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "へぇ……そっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "こんなこと言うのはアレかもしれないけど、アイドルとして最も重要なスキルの一つが人の心を読むってことなんだよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あたしが思うに、誰にでも心を開けるっていうのは、心の扉をたくさん持ってるってことじゃないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "誰とでも仲良くなれる人って、心の奥底に何かを隠しているに違いない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "だけど、エクシアにはそれが全然当てはまらないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "知ってる？　ペンギン急便に入ったばかりの頃のエクシアは、本当にひどいトラブルメーカーだったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "誰に何を言われてもすぐに信じちゃうんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "彼女が入社してから二日目の仕事は未だに忘れられないよ。ボスが試験として配達に行かせたんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "その日、テキサスさんは別件の仕事があったから、代わりにあたしがフォローに入ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "大した問題は起こらないだろうと思ってたけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "だから、エクシアは騙されたんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっ、そうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "そうだよー！　この業界ではね、配達物の中身が違うことになった場合理由はいろいろ考えられるけど、一つだけ絶対にあり得ないものがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "それはあたしたち配達員が間違えちゃったってこと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "状況を見る限り、あなたが新人だからって言いがかりをつけて、ペンギン急便の責任問題にしようとしてるに違いないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "へぇー、詳しんだね、ソラ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "まぁね、これも全部テキサスさんから教わ……\nって、言ってる場合じゃないや、なんとかしなきゃ！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "何かいい対処法はない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "一番手っ取り早いのはあなたを騙したあのヤクザのボスを取っ捕まえて直談判することだけど、それはつまり組織全員を敵に回すようなことだから現実的じゃないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いいじゃん、それで行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "だから現実的じゃないんだって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "えっ、テキサスさん……どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "噂を聞いて様子を見に来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "大丈夫そうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "うーん、状況はあんまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "今、「それで行こう」と言ってたが、できそうなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "分からない。けどあたしのミスだから、全力は尽くすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そう……ならついて来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "こうして、何故か単純な配達の仕事が、最後にはあの二人がヤクザの縄張りに突入してボスを引っ張り出すっていう大袈裟な結末を迎えたんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "それで、その日からテキサスさんはエクシアを色んな仕事に連れて行くようになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサスさんはエクシアにこの業界のルール――やるべきことやダメなこととかを、たくさん教えたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "今じゃ知っての通り、すっかりいいコンビってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それで、友達を横取りされた気分なのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "それもちょっとあるかな。でもそれよりも不思議に思ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "「こんな単純な人がいるなんて嘘でしょ」ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "今となっては笑い話だけど、一時期は本気で彼女の化けの皮を剥がそうとしていたこともあったくらい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "けどエクシアを深く知れば知るほど、本当に表裏のない人間だってことが分かったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "そしていつの間にか、あたしも友達になってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あなたの答えを聞いて、ようやく最後の疑問も解けたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あっ、そろそろ会場支配人のとこに行かないと。今度機会があったらお礼にケーキをおごるね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君はどうなの？　彼女を疑ったことはあるかい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "人の心を勝手に分析するのは好きじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私は他人が私に見せてくれる顔をただ信じる主義なんだ。裏切られるその日が来るまではね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "エルと似てるね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "何の話をしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前が能天気なバカかどうかって話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "それって議論の余地があったの？　まさか違うという意見が出てたりする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "この調子だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふふ、昔からこの調子さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "どうしたんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ここ、ちょうど配達先の近くじゃん。今気づいたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "配達の途中でテキサスに呼ばれてきたんだった。いっけない、先に配達してくるね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ここでハーフタイム！　二人とも待っててちょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それで、本当に手出ししてこないんだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "真剣に遊んでやってるようだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そう？　じゃあさ、あそこに良さそうなバーがあるから、行ってみない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "さっきから思ってたんだ。私にちょっと怒りっぽい友達がいるんだけど……私の見立てだと、君とは話が合いそうだなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私もお前と実際に会って、確かにエクシアが憧れそうな相手だなとは思った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "おや、そうだったのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "本人から直接聞いたわけじゃないが、私には分かる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "過去を誰かに押し付けたり、特定の思い出に囚われたりする気持ちというのは、非常に不本意ながら、身をもってよく知っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そしてお前は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシアにとっては追いかけていた過去そのものだ。お前がいるだけで彼女の今の生活を壊しかねない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "つまり、本気で私を殺そうとしてるんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "少しはな。できれば彼女の知らない場所で静かに死んでくれると助かる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あるいは、永遠に届かない後ろ姿になってくれれば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……いい友達を持ったな、エルは。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ヤッホー、みんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いい知らせと悪い知らせがあるけど、どっちから聞きたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いい知らせ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いい知らせはね……配達は無事に終わったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "なら悪い知らせは、「客を怒らせた」、だな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "その通り！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チンピラ",
      "text": "覚悟しやがれ、このクソサンクタ野郎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "話が途中だったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前にはいなくなってほしかったが、ついさっき気が変わった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふぅん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "単に機嫌がいいから少しお遊びに付き合ってやろうなんて上から目線であれば、後悔させてやろうと思っていたが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それとは違うようだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それだけは違うって断言できるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっと、もしかしてどシリアスな話をしてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "こっちは一人で相手しておこうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いや、話はもう終わった。ちょうど身体を動かしたいと思っていたところだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チンピラA",
      "text": "つ、強ぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チンピラB",
      "text": "は、早く逃げようぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "はぁ……ちょっと疲れたかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "チョコレートはいるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いるー。モスティマも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あれ、モスティマは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "どうやらどさくさに紛れてここから離れたようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっ、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "手紙が置いてあった。お前宛てのようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたし宛て？　まさかモスティマから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いや、姉ちゃんからだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なるほど、モスティマは手紙を届けるために来たんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でもこの場合、直接手渡したってことになるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "とりあえず読み進めたらどうだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "姉ちゃんを責めるわけないじゃん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "良さそうな人だね、お姉さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もちろん、最高の姉ちゃんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ほう、それで姉ちゃんが龍門に来るのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ボス！？　いつからいたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "さっきからバーテンダーとしてそこにいたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "正確にはお前らがバーに入って来た時からだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "このバーで間違いあらへんよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "間違いないよ。ほら、いた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あれ？　みんなまで、なんで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ボスに呼ばれたもんやさかい来たんやで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あの嫌な支配人をボスが何とかしてくれたんだよね。で、そのまま来ちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ボス、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "そうだ。今日は記念すべき日だ、パーティをしねぇとな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "何の記念なん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "もちろん、エクシアの姉ちゃんが手紙を寄越した記念だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "それは今わかったばっかりのことやん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "長期出張要員として活躍していた、モスティマが帰還した記念も兼ねてな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "それは悪くないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だけどモスティマは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "呼んだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっ！　だってキミは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "お手洗いに行っただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君のお姉さんは今、私の上司なんだよ？　その手紙を君に渡すことも直々の命令として言われたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっ、辞めてやるって抗議しなかったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "辞職届を出さなかったと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあ断られたんだ！　アハハ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "さぁお前たち、存分に騒げ！　ここの酒もデコレーションも音楽も今日は全部ペンギン急便の貸し切りだぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペンギン急便一同",
      "text": "イェ～イ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "何食べたいん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "チョコレート、コーヒー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ケーキ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ピザ、あと焼肉も！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "自分ら、ここはバーやで、バー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ええわ、聞いたウチがアホやった……キッチンに何があるか覗いて来るわ、あるモンで何とかしたる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "あっ、そうだ、ソラちゃんの新曲もうお披露目できるんだよ！　みんな、聞きたくない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "この前、こっそりあたしに聴かせてくれたあの曲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "そう！　テキサスさんにすら聴かせてないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ええー、あの曲、ロマンティック過ぎるよ。あたしの好みじゃないかなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "知ってる！　エクシアが好きなのは激しいヤツだもんね。バラードに関してはあなたの好みじゃない方がいい曲の証だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えー、でもなんでパーティでバラードなんか歌うの？　もっと刺激的な方がいいじゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "さっきの連中がちょっかい出しに来ないか見てくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あっ、ならあたしも一緒に行くよ。やらかしたのはあたしだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いい、すぐに戻る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "テキサス、戻ってくるときついでに酒を買ってきてくれ。ここにはロクな酒が置いてねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "何か私にできることは？　一応ペンギン急便の一員だし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "うーん──残念ながら、ねぇな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "なんならお前の杖の中にいる老いぼれを呼び出して、みんなにダンスでも披露してもらうってのはどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それはさすがに難しいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "モスティマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "手紙の内容は知ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いいや。でも大体想像はつくさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私はアドバイスできる立場じゃないと思うけど、少なくとも──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "エルにはいい友達がたくさんできたんじゃないかな。違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "手が足りへんわ、誰かー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私が手伝うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（姉ちゃん、ほら、これが今のあたしの生活。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（姉ちゃんとモスティマに避けられてたことについては、確かに少し文句を言うべきなのかもしれない。でも今の素敵な友達と楽しい生活を手に入れたのも姉ちゃんたちのおかげ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（あたしは今の生活をとても気に入ってるよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（一つだけ姉ちゃんの言う通りのことがある。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（龍門での暮らしが、あたしの生活を過去に囚われる日々から、ペンギン急便の楽しい仲間たちと過ごす日常へと変えた。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（うーん……それもちょっと違うかも。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（これまでの日々で気づいたのは、あたしはただみんなと毎日を楽しく過ごしたいだけじゃないってこと。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（あたしは知ってる。テキサスには過去がある。クロワッサンは商売を大きくする夢を見ている。ソラもきっといつか、もっと大きい舞台に上がることになるだろう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（そしてみんなも、あたしがまだ姉ちゃんたちを追いかけ続けているのを知ってる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（終わりのない宴なんてない。でも、あたしたちには終わりを恐れる必要もない。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（だって、友達の定義というのは、同じ生活を過ごす中で仲良くすることじゃなく……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（離れ離れになってもお互いを想い続けることのはずだから。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（だから、姉ちゃんが来たら、きっと驚くよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（なぜなら、あたしはきっと迷わずに、姉ちゃんにこう返事するから――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "何をボーッとしてやがるんだ、エクシア？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "一緒に盛り上げていこうぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "はいよー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "さあさあみんな、そこの巻き込まれた人たちもご一緒に！　せーの──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "アップルパイ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
