  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "glady"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 5:18 天気/曇天\nイベリア プリマヴェーラ 某教会内"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "あれ、いつからベンチに人がいたんだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "あの、ずっとここにいらっしゃいましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "さっき通った時は、気付きませんでしたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ええ。あなたがこの……何らかの植物の器官を加工した道具で床磨きに勤しんでいるのを見ていましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "えっと、ホウキのことですか？　そうです、掃除をしてるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "お仕事の邪魔になったのならば、どうかお許しくださいまし。あなたは随分とお忙しそうですし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "いえいえ、大丈夫ですよ、ハハッ。これは仕事とは言えないので。私はただの信徒でして、たまに教会の掃除を手伝いに来ているだけなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "初めてお会いしましたが、あなたもエーギル人ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……エーギル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "「あなたも」、はあまり正確ではないかもしれませんわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "す、すみません！　私の誤解です！　別にあなたを私たちと同じだと言ったわけではありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "生理学的観点からすれば、あなたは決して間違っておりませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "え……そ、そうでしたか。では余所の都市から来たのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そう言えますわね。ここに来て数ヶ月ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "他の都市からとなると、私たちエーギルにとってそう簡単なものではないですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "確かに疲れますわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "何か訊きたいことがあれば、何でもおっしゃってください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そうですわね。あなたがまだエーギルを自称するのであれば、少しばかりの疑問が浮かびますわ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方のかつての国では、清掃ロボットが一日中休みなく働き、街に少しの埃も付着することはありませんでしたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "では、目の前のこの汚れた環境と非効率的な生活に、どのようにして耐えていますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "はぁ、誰もこんな生活は望んではいませんよ。五十数年前のあの災いがイベリアを変えてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "イベリア？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "いいえ、私が言ったのはこの陸地の国のことではありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "では、あなたがおっしゃっているのは……かつてのエーギルの集落のことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "祖父から聞いたことがあるだけですが、ええっと……今はもうあの水中都市はすべて廃棄されました。私たち島民にとっても、イベリアにとっても、あの場所は危険だとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方は、あの鳥たちの話を聞き入れたのですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ただの上澄みであっても、あなた方はいまだ一部のエーギルの知識と技術を有していますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "なぜあなた方は、陸地の野蛮人たちよりも自分の方が劣っていると考えていますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "……劣っているとは言いませんが、しかし……あの、この話を懲罰軍に聞かれたら大変ですよ。私たちがこの封鎖線近くの都市にとどまることだって容易ではありませんし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "怯え、そしてためらい──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "エーギルでは、子供にそうした問題が生じれば、法律によって両親は子供を教育する権利を奪われますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "それは……恐ろしいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "恐ろしい？　どうやらあなた方は、自分たちが本来どのような生活を送っていたかを完全に忘れてしまったようですわね。陸地人に完全に同化されたのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "イベリアという地では、他の人と違う振る舞いをすることは、危険なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方の選択は理解できますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "……なんだか、失望なさったご様子ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "失望とは、その前提に希望があるものですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "しかし、あなた方が陸に持ってきたものは、これにとどまらないのかもしれませんわね。探すとなると、時間がかかることは明らかですけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "あの……あなたがおっしゃっていることの半分以上、どういう意味かわからないんですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "こうしたコミュニケーションの取り方に、まだあまり慣れていませんの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "あなたの言葉遣いも……とても不思議です。まるで、何十年も前に流行った風刺ミュージカルみたいですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そういった芸術作品はもう流行っていませんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "残念ですわ。私は気に入っておりますのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "好きだからその口調を真似てるんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "つまり、あなた方は映像記憶ディスクを使って未知の言語を効率的に身につけたりはしませんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "……しませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "なるほど、納得しましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "でもそれは、我々が愚かだからというわけではないと思いますよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ええ、理由などいくらでも付けられますわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "ええっと……あの、先に謝っておきます。もしまたあなたの気分を害してしまったら申し訳ありません……なんだか機嫌があまり良くないようですが、具合でも悪いのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "陸地の病原体では、私の生体機能に損傷を与えるに至りませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "機嫌が悪いのは、確かにそうかもしれませんわね。ここは乾燥しすぎていますもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "……この時期のイベリアでは、湿気がすごいという不満しか耳にしたことがありませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "いずれにせよ、病気でないなら安心です。もちろん、気持ちが落ち着かないようなら、宣教師さんに救いを求めることもできますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "信仰ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方は科学や技術を信仰せず、国を信仰してもいません。それなのに自らの理想を……信憑性に欠ける俗物に託すのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それが情報の非対称性を利用して相手を欺く有効的な手段であることに、私も最近気付きましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "あなたは恐らく誤解しています。私は教典を読むことや説教を聞くことで病が治るとは思っていません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それは予想外ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "ハ……ハハッ……あなたは本当にユーモアのある方ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "私が言いたいのは、教会の人はとても寛大だってことです。彼らは最近鉱……えっと、病人を受け入れてもいるんですよ。彼らも病人もみんなエーギルです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたのような「エーギル」とお喋りする意外に、あなたが今仰った教会の行為も、私がここに来た理由の一つですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "えっ？　誰か病人のお見舞いにでも来たんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "仮にここに私の会いたい人がいるとしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "アントニオ、どうして西側の窓に大きな穴が空いているんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "穴？　十分ほど前に突然大きな音がしたのは覚えています。懲罰軍が誰かを捕まえてるのかと思ってましたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ちょっとよろしいかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "何ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "すぐにここからお去りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "わ、腕章？　それは懲罰軍の？　あ、あなたは懲罰軍の方だったんですか？　気付きませんでした！　道理で不思議だったわけだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な青年",
      "text": "み、見逃してくれてありがとうございます！　すぐに行きます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "扉を閉めるのをお忘れなく。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "素晴らしいですわ。陸地の軍組織の形式は全く非効率的で、兵士の技量も哀れなほど低いですが、より弱い者を震え上がらせるには、存分に効力を発揮するのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それと、まだ全員残っていたことを、嬉しく思いますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "これで少し時間を節約できますわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "この匂い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "どうかもっとお近付きになって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "ハァ……ハァ……あなたは懲罰軍ではありませんね……何をしに来たのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方はもっと口が達者なのかと思っていましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方が使用している技術が、あの脱走者たちのものより完成度が高いことに気付いた時、私は少しばかり期待を抱きましたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "……技術？　仰る意味がわかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "源石。こんなに危険で可能性を秘めた特殊なエネルギーは、海には存在しませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "エネルギーに対する好奇心は、尽きませんわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "本来のエーギルを陸地に復元することは誰もできませんわ。事実、私はこのイベリアと呼ばれる国で、美しさとは全く無縁でつぎはぎだらけの混合技術を大量に目にしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "しかしあなた方は、エーギルの技術を用いて源石を純化していますわね。無理に陸地の生活に溶け込もうとしている脱走者たちとは明らかに違います。別の意図があるのは疑いようがありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "私たちは……救っているのです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "寛大にも救っていると？　そんな詭弁を信じるのは、救いようのない愚か者くらいですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "その病人たちが最終的にどこに消えたのか、彼らは気付いておりませんわ。ですが私はその不運な実験体たちの身体からエーギルの技術の痕跡を見つけましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "お前は……気付いたというのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ええ、容易いことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "一つの個体を別の形に転化させる、そのような技術には何十ものプロセスが必要になるはずですわ。あなた方は「どこまで」進めたのかしら？　第一段階、あるいは第二段階？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "どちらにせよ、あの接触以前に上陸した脱走者が、こんな技術を掌握しているはずありませんもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "海と大陸の通路はすでに奴らに占領されておりますわ。私ですら戻れないのですから、あなた方が正常な手段で出てくるなんて不可能ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "陸地を歩むことにとっくに慣れたあなた方が、どうやってまだ海との関係を保っているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それとも……海の最も穢れたゴミまでもを、誰かが陸に持ってきたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "お前は何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "こういった互いの正体を確認し合うような茶番はうんざりですわ。こんなお決まりの挨拶は陸地の劇中にすら登場しませんわよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "グレイディーアは矛を軽く振った。陸地には存在しない合金が肉眼では捉えきれない速度でレンガに触れると、彼女を中心に、教会の床全体が轟音を立てて陥没した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "予想通りですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "こんな低劣な実験場をわざわざ隠すように建物の下に作ったのは、陸地人の目を欺くためですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "しかも、こんな卑しいやり口で本当に成果が得られるなんて、意外でしたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "陸地国家の組織レベルについてもう一度評価し直した方がよさそうですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "ゴホッ……ゴホゴホッ！　その武器は！？　それにその力は……まさかアーツか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "フッ、アーツ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "あ、ありえない……お……お前は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "もし……お前が司教たちが言っていた奴だとしたら……お前は数ヶ月前に重傷を負ったはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方は三ヶ月前に海底で起こったことをご存じですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "いや、それは買いかぶり過ぎですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方が岸で見たのは、別の方ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それは、誰ですの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "そのスピード……ハァ……ハァ……さっきはなぜ動かなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "陸地での移動は疲れますもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方のようなお話にならないゴミなどは、突っ立ったままでも片付けられますわ。なのにどうしてそんな体力をわざわざ使う必要がありますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "わ……私は何も知らない……我々はただ守っているだけだ……ここを破壊させないように……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "確かに、あなた方はあまりに低レベルですわ。持っている情報には限りがありますわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "となれば、質問を変えるしかなさそうですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた方は陸地にあと何体いますの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "エーギルに対してあとどれほどの陰謀を画策していますの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それと、なぜあなた方は源石とエーギルの身体を人為的に結合させる研究をしていますの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "ハァ……ハァ……ハァ……匂い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "無駄な足掻きはお止しなさいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "恐魚になっても、ただ死を早めるだけですわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教会従事者",
      "text": "いや……いやだ……ああああ──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あら、それがお望みのようね。（エーギル語）私もあなた方には早く死んでほしかったんですのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "軽く払っただけで、バラバラになるほど弱いとはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "うっ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "この……胃の痛み……また始まった。上陸してから、ずっとこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "まともに恐魚にすらなれないクズ……この私がここでこんな獲物の相手をするしかないなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それにあの陸に上がったエーギルたち……彼らは皆、陸地人と同じようなものに成り果てた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "海を離れ、体内の水分が全て蒸発するまでに、どれくらいの時間がかかるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "どちらの結果になるとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "違う……私はあんな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "（嘔吐）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……ハァ……ハァ……でも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "立ち止まってる場合じゃないでしょう、この無能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "たとえエーギルに帰れなくても……いや、帰れないからこそ今はこうするしかないのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（咆哮）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それ以上の攻撃は中止することを勧める。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……あなたの力は強大なようですけれど、私は誰にも止められませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もう一度やれば、この教会は崩れるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君は懲罰軍を気に留めていないようだな……とは言えイベリアの審問官に目をつけられたくはないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "イベリアの審問官――陸地の鳥、ですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こういった無用な衝突は、君の仲間探しの進捗に悪影響を与えるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（エーギル語）海底の国にはまだ時間があるかもしれないが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（エーギル語）陸に打ち上げられたハンターはその限りではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あ……あなたはエーギルをご存知ですの！？　それに私たちのことまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "三ヶ月と七日前、イベリア南方の海域で再び強烈な海洋異常現象が発生した。この情報はすぐにイベリア当局によって隠蔽されたが、私には情報を入手するルートがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたは私を探していましたの？　それとも私と同じように、この場所に目星をつけたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こう理解して構わない。私は君を待っていた、それも永きにわたってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君は特殊な海流に運ばれ、岸に漂着した。これは君にとっては苦痛かもしれないが、我々とエーギルにとってはチャンスでもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたから敵意は感じられませんが、今語った内容は、私があなたの命を奪うのに充分なものですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ああ、君にはそれができるだろう。だが、その必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は海とは何の関係もない。君はもう嗅ぎ取っているはずだ。だが実のところ、陸地と海に隔たりなど存在しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "海はその傲慢さゆえに、大地に目を向けることは少ないかもしれないが、大地は今まさに海で起きている災いを見て見ぬ振りなどできないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……ここに来てから、私を驚かせたのはあなたが初めてですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "分かっていると思うが、この場所は話し合いには適さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それに、重傷の身体を引きずって見知らぬ地へとやってきたんだ。君はそう長くは持たない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ここに転がっているようなゴミを見つけ出して切り刻むには、これでも充分ですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "この戦いがあとどれくらい続くのか、君は分かっているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もし彼らがこれほど身を隠すのが得意でなければ、エーギルは今日まで彼らの存在を許していただろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "彼らの行為は、エーギルの脅威にはなりえませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君は彼らと「あれら」を区別したいようだが、彼らはそうは考えないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私に矛を向けここに残るか、あるいは一旦私と共にここを去り、協力の可否について話し合うかは──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君が選択して構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "エーギルの運命、君と仲間の運命、イベリア──ひいてはこの大地の運命は……すべて君の手にかかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "具体的な協力事項について議論する前に、あなたの名前をお聞かせ願えるかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "もちろんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
