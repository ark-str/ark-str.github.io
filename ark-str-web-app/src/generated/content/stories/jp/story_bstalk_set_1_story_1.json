{
  "server": "jp",
  "storyId": "story_bstalk_set_1_story_1",
  "groupId": "story_bstalk_set_1",
  "stageId": null,
  "title": "荒野への呼びかけ",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_bstalk_1_1.txt",
  "sourceHash": "0d3d3216c9f93ea742545f9bb9ae67badabe50cf40cfd8a696110869e0654f79",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "参加者A",
      "text": "なぁ兄貴、やっぱ開拓隊に戻ろうぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者A",
      "text": "確かに俺たちが育てた羽獣は狩りを手伝ってくれるが、都会のヤツらの好みには合わなくねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者B",
      "text": "そんなこと言うな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者B",
      "text": "試してみなきゃ分かんねぇだろ？　もしかしたら意外と連中の趣味に合うかもだぜ。それにあの嬢ちゃんを見ろよ……ハガネガニなんか連れて参加してんだぞ。もう少し余裕見せな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ちょっと！　全部聞こえてるんだけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "うちのぴーちゃんに嚙まれても知らないんだからね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（凶悪そうにハサミを振ってみせる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者B",
      "text": "す、すまねぇ！　俺はただこいつを元気づけようと思っただけで、わざとじゃなかったんだ。本当にすまん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者B",
      "text": "せっかくだし、お嬢ちゃんの意見も聞かせてくれよ！　芸のできる獰猛な羽獣は、確かに新しい市場を開拓できると思わねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "うーん……それについては、あたしもすごく詳しいわけじゃないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "キミの言っていたように、ハガネガニでも参加できるんだから、それよりもっとメジャーなペットである羽獣なら、ひょっとして本当に成功するかもよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "あっ！　今この瞬間いいアイディアを閃いちゃった！　聞きたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "今回のステージをもっと盛り上げたいなら、あたしと手を組むのはどう？　強いハガネガニを数匹貸してあげるから、羽獣と協力して迫力満点のバトルショーをやるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者A",
      "text": "えっ？　ずいぶんと太っ腹なんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "だって、あたしがここに来た目的は、この子たちのすごさをもっとたくさんの人に知ってもらうためだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "キミたちがここで有名になったら、この子たちも一緒に注目されるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "それに失敗したとしても、この子たちはキミたちのところで新しい技を覚えてくるし、どっちに転んでもあたしに損はないってわけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者A",
      "text": "ぐすっ……本当にありがとな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "さっ、この子たちと仲良くなるための時間は、まだたっぷり残っているし、あたしが色々教えてあげるよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "はーい注目～！　みんな、待機場所に着いたからそろそろ練習を始めるよ！　いい子にしてたら高級フードをあげちゃうからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "それじゃまず、具合の悪い子は名乗り出るように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者A",
      "text": "えっ？　そいつらしゃべれるのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トレイ＆ツイスタ",
      "text": "（左のハサミで頭を叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "あれ？　頭の花の調子が悪いの？　ちょっと見せてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハンマー",
      "text": "（その場でクルリと回り、足を上げる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "石で足を擦りむいちゃったの？　あっ！　石のかけらがこんなとこに挟まってる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "よくやったね、ハンマー。これからも具合が悪い時はちゃんと言うんだよ。アイスみたいにガマンしちゃダメ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アイス",
      "text": "（思いっきり足踏みする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ごめんごめん！　アイスも最近はすっごくいい子だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者B",
      "text": "すげぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ふふ～ん、すごいでしょ？　これは「カニ語」って言って、あたしたちだけの特別な交流方法なの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "たとえば……（右手を振る）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（時計回りに回る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（水を飲む動作）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（ミネラルウォーターを持ってくる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ざっとこんな感じ！　すごいでしょ？　普段のちょっとした指示以外にも、仕事の時はもっと細かい命令が出せるから、高難易度の戦闘にも参加できるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "だからショーの内容も、前半の三分間はこの子たちに色んな陣形を組ませて、正確に指示に従えることをアピールしたら、後半の二分間で審査員たちと実際に触れ合ってもらう予定なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "審査員に実際にこの子たちに指示を出してもらうけど、あたしの許可がない限り、他人の指示には従わないように教えてるの。その方が、この子たちのすごさをもっとアピールできるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者B",
      "text": "すげぇ……俺たちもうかうかしていられないな！　ピーター、さっそく戻って練習だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "フフーン！　伊達に何年も飼育員をやってないからね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催者",
      "text": "気になる参加者はいたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ハガネガニを連れた少女がいた。あれは珍しいかつ特別なペットになるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "市場はもうずっと、ふわふわの生き物たちに占領されている。そろそろ、風変わりで珍しいかつ、インパクトのあるペットの出番だろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "魅力的なキャッチコピーを付ければ、価格だって相当跳ね上がるはずだ。「飼い主の言葉を完璧に理解するペットガニ」とか、悪くないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "荒野で恐れられる存在が、今や花を咲かせて、可愛らしくそっと飼い主に寄り添い、言葉まで理解して指示通りに動いてくれる。完璧じゃないか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "こんにちは、ビーンストークさん。とても可愛らしい名前ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "あたしに何か用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "こちらは、私どもの広告に関する契約書になります。よろしければ先に目を通してください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ふむふむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ビーンストークさんの履歴書もすでに拝見させていただきました。ここに来られる以前、「ビーンストーク印の高級フード」の販売に挑戦したそうですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "そうなの！　それについて主催側の評価はどうだったのかな？　結構がんばったんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "えぇ、確かに一定の評価はされたでしょう。ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "まだまだ全然足りません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "えぇー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "商品名も宣伝テーマも曖昧で完璧には程遠い！　表現にインパクトも足りません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "キャッチコピーもイマイチ感情に訴えかけてこないし、商品詳細の説明もシンプルすぎる！　これでは購買意欲が全く掻き立てられない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "新商品を発売するのであれば、その名前やキャッチコピーには人の心を掴む特別なオリジナリティーが必要なんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "既存の文言はなるべく避けましょう。目新しさが一番重要なのですからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ほんの短い一言だけでも、人々の目を引き付け、購入意欲を刺激できるよう、細部までこだわる必要があるのです！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "おぉー……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "そうだったのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "コホン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "私どもの審査には、予選を通過するのと、こちらからスカウトする形式が存在しております。ビーンストークさんはなんと、その後者にあたるため――直接ステージでショーを披露していただけます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ビーンストークさんの名前が世に知れ渡れるよう、私たちも全力でサポートしましょう。その代わりと言ってはですが、私たちの宣伝PRの撮影にご協力をお願いいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "先ほどからずっと契約書を読まれているようですが、この提案についてはいかがでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "うん、すっごく魅力的な提案だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "なら、契約書の詳細について一緒に確認しましょうか。たとえば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "あれ？　ここの予算の数字が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "気付かれちゃ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "最初と全く変わっていない！　私たちが提示した数字ですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "へ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "フフーン、キミってなかなか気が利くじゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "いえいえ、とんでもございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "では、ビーンストークさん……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "はい、サインしたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ありがとうございます！　では、今後は何卒よろしくお願いいたしますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催者",
      "text": "何しに行ってたんだ？　酷い匂いだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ったく……汚ねぇカニどもめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "見れば分かるだろ？　捕まえてきたばっかのカニどもが、言うことを聞かないせいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "あまりにも反抗的ヤツを何匹か処分したら、服を汚されちまったんだよ。残ってるヤツらは指示に従ってくれるが、ショーの後の継続的な安定供給を考えれば、まだ数が足りない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "あの小娘は連れてきたカニたちから全く目を離さないから、なかなか手を出せないが、仮に数匹減ったところで気付かないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "……まぁいい、とりあえず着替えてくるよ。後でビーンストークのご機嫌取りに、あいつのハガネガニを褒めちぎってやらないといけないしな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（慌てて飛び出してくる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ストロング？　どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "みんな工場の中で休んでたんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（ハサミを首元に置いてジェスチャー）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "死んじゃった同類の匂いがするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（工場の方を指す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "しかも工場のすぐ近くから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "確かに工場の裏に小屋があるけど、あれはただの倉庫だよね？　この前通りかかった時は、鍵がかかっていて、中には箱のようなものが置いてあったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（ハサミで自分を指す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "え！？　ハガネガニが中に閉じ込められてるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（小声）待ってストロング、人目のない場所に移動しよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "なるほど……キミたちから目を離さなければ、何も起きないと思っていたのに、まさか荒野から野生のハガネガニを捕まえてきて訓練するなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "しかも、言うことを聞かない子を殺すなんて、許せない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ストロング、絶対にみんなを助け出そう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ここにいたのですか、ビーンストークさん。随分と探しましたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "あっ……えっと、どうしたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "時間になっても、練習を始めずにサボっているとなれば、様子を見に来るのは当然でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "あぁ！　ごめんごめん！　ついうっかりしちゃったよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（口笛）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "すぐに練習を始めるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ほら、みんな！　あたしの指示に従ってね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "いっち、に！　いっち、に！　全員位置について！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "まずは前回の練習のおさらい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "とっておきのポーズも忘れないように――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "うんうん、いいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "もう少しで本番です。ビーンストークさんは大変優秀ですが、くれぐれも気を抜かないように。肝心な時に失敗しては台無しですよ。それでは、私はこれにて失礼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（小声）みんな！　大事件だよ！　さっきストロングが工場の方で殺された仲間の匂いがしてるのに気付いたの。しかも、工場裏の倉庫には、野生のハガネガニがいっぱい閉じ込められてるみたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（小声）このことを知っているのはあたしたちだけ。だから、今から練習内容を変更するよ。新しいフォーメーションを組んで、みんなを助け出し、安全な場所まで逃がすの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（小声）みんな、お願いね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハガネガニたち",
      "text": "（やる気満々にハサミをこすりつける）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ぴーちゃん、新しいフォーメーションはちゃんと覚えた？　みんなで縦に繋がって、窓の下に置いてある倉庫の鍵を、ハサミで引っ掛けるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（ハサミを振ってみせる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ストロングとツイスタも、ちゃんと自分たちの役割を理解した？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "明日、リハーサルが始まって黒服たちがステージに上がったら、すぐにステージの柱を折って、アイツらを思いっきり地面に叩きつけちゃえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング＆ツイスタ",
      "text": "（頭の花を揺らす）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "よし！　でも、絶対に誰にも気付かれちゃダメだよ！　みんなの安全が一番だからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "今回のミッションが無事に終わったら、ご褒美に一番大好きな缶詰を開けちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（こっそり指示を出す）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（慎重によじ登る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（フォーメーション完成！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（仲間たちの体をつたって、机に置いてあった鍵を入手！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鍵",
      "text": "（ぶつかり合う音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "ん？　何の音だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（発見される前に鍵を持って流れる動きで壁の隙間に滑り込む！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（ミッション完了）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（仲間たちと共にクールに闇の中へと消え去ってゆく）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（せかせかとあちこちを駆け回る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツイスタ",
      "text": "カチカチ？　（任務はこれじゃないよね？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（焦ったようにハサミを振り回す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（目撃したことを訴えかける）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツイスタ",
      "text": "（助けを求める）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "！　（いなくなった隣の木のうろの子は、そこに閉じ込められていたのか！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "カチカチ。（待て……お前見覚えがあるぞ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "カチカチ？　（石の隙間んトコのハナの息子か？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング",
      "text": "（驚いて少し固まった後、嬉しそうに回り出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "カチカチ！！　（みんな武器を取れ！　叔父さんの隣に住んでる従妹の息子が困ってんだ！！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ぴーちゃん、ドアが開いたら野生のハガネガニたちにあたしの言葉を伝えてね。みんな、ヒドイ目にあったせいで、人間に対して攻撃的になってるかもしれないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "今急に外に出たらすぐに見つかっちゃう。だから、あたしが鍵穴を塞いでドアを閉じられないようにしておくから、ステージが崩れた音がしたら、すぐに荒野の方に向かって逃げてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（ハサミを振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ふぅ……それじゃあ、ドアを開けるよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "みんな！　助けに来たよ！　もう大丈夫だからね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "屋内のカニたち",
      "text": "（震えながら部屋の隅に縮こまる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "みんな、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "それでは、明日の本番の流れを確認しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "プログラムのリストは全員もらいましたね？　それでは、早速――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（そっと口笛を吹く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング＆ツイスタ",
      "text": "（ハサミを上げて了解の合図を取る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング＆ツイスタ",
      "text": "（他のハガネガニを連れてステージの骨組みに登る）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ハガネガニたちは当初の計画通りに、ステージの支柱部分に接近していく。ビーンストークが固唾を飲んで見守っていると、ステージがギシギシと音を立て始めた。\nここまでは完璧だ。\nしかし、ここで予想外のことが起こってしまう。\nストロングとツイスタはそのままステージのてっぺんまで登ると、風の吹く方に向かって体を真っすぐ持ち上げたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "……おい！　一体どうなってる！　なぜカニどもがあんな所に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ビーンストークさん、しっかり見張ってなきゃだめでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "あっ……うん！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ビーンストークは慌てて口笛を吹きハガネガニたちに状況を伺う。\nストロングとツイスタはクルリと向きを変え、ステージの後ろにある荒野に面した。\nステージはビーンストークの想定通りに主催者の方に向かって崩れ落ちるどころか、むしろ彼女の足元にある地面が震え始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "（もう一度慌てて口笛を吹く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング＆ツイスタ",
      "text": "（なだめるようにハサミを振る）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突如、遠くの地平線から砂埃が立ち昇り、続いてすぐに大地が激しく揺れ始めた。\n数十、いや数百……もしかしたら数千匹はあろう大小様々なハガネガニたちが、鋭利なハサミを光らせながら、こちらに向かってきていたのだ。\nステージのてっぺんにいたハガネガニたちは掲げていたハサミを降ろすと、振り返って下にいるビーンストークに合図を送る。\nレプロバの少女はすぐにその意味に気付き、そばに置いてあった空の箱に飛び乗ると、荒野に向かって大声で呼びかけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "お――い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "ビーンストークさん？　何をしているのです！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ストロング＆ツイスタ",
      "text": "（ステージのてっぺんで大きくハサミを振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ストロング！　ツイスタ！　コイツらのお尻を思いっきりつねってやれってみんなに伝えて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "参加者たち",
      "text": "うわっ、どっから湧いてきたうわああああ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者たち",
      "text": "すっげー数！！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ハガネガニたちは一心不乱にステージへ突進していく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "主催者は足で踏みつぶそうとしたり、手あたり次第に取った物で追い払おうとするが、数匹倒したところで意味はなく、次々に大量のハガネガニが押し寄せてくる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鈍く大きな音が鳴り響いたかと思うと、ステージはハガネガニたちのハサミによって倒され、土煙を巻き起こしながら崩れ落ちた。\n倉庫に閉じ込められていたハガネガニたちも飛び出してきて、大量の群れに加わる。\nハガネガニたちは主催者や色鮮やかなライトを吊るしたステージに押し寄せ、ついでに残っていた高級フードもかっさらっていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "参加者B",
      "text": "いててて！　お、俺の足を挟むな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "みんな、怖がらないで！　この子たちはあたしたちを助けに来てくれたの！　大人しい子たちだから、人を襲ったりはしないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "まぁ、野生の子たちについては保証はできないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "混乱に乗じるカニたち",
      "text": "（一心不乱に高級フードをむさぼる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "……とにかく、まずは逃げるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "話は逃げ切ってから――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "みんな、あたしに付いてきて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "おい、待ちやが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主催側のスタッフ",
      "text": "いってぇーー！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "はぁ……はぁ……みんな、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ケガしてる子はいない？　ステージが崩れた時、何かにぶつかったりもしてないよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "倉庫から逃げ出してきた子たちも、大丈夫かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ケガしてる子がいたら、ちゃんと教えてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "（ハサミで何か話し合っている）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "（ビーンストークの周りに群がり始める）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "みんな……あたしと一緒に来たいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野生のカニたち",
      "text": "（ハサミを振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "それじゃあ……あたし、今ロドスってとこで働いてるから、一緒に行こっか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーンストーク",
      "text": "ロドスに着くまで、普段どんな風に暮らしているのか、教えてあげるね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぴーちゃん",
      "text": "（嬉しそうにハサミを振る）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
