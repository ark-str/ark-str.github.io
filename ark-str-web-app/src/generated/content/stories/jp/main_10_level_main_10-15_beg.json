{
  "server": "jp",
  "storyId": "main_10_level_main_10-15_beg",
  "groupId": "main_10",
  "stageId": "main_10-15",
  "title": "そびえたつ城壁",
  "storyCode": "10-17",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_10-15_beg.txt",
  "sourceHash": "54a2c48bbcdb66d1de8b6be751cf396434fef166b1a3cd68a355afc2b337180b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "12-beg"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "来たか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……マンフレッド？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ブラッドブルードの大君は失望するであろうな。彼は暗く湿った場所を目の敵にしていながら、己の手で君を捕らえるために反乱軍の地下の巣穴へと乗り込んだんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "今頃は君たちの仲間に追いついていることであろう。地底の叫びは果たして壁の上まで届くか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "黙れ。この邪悪な……邪悪な……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "邪悪な魔族か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "いいや、私とて彼のやり方が素晴らしいとは思わない。あのような苦しみに比べれば、私の砲撃で死んだ反乱軍の方が随分と幸運であろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "あんたらに違いなんてない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君たちの目から見ればそうかもしれない。魔族という言葉で我々を一括りにする時、君たちの目は既に恐怖と憎しみに覆われているのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ヴィクトリア人の目には、サルカズとは殺戮を楽しむ愚か者たちとして映っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "かつてそう考えていた者は、今や殿下の玉座に首を垂れているか、城壁の外で野ざらしの白骨となっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたとテレシス……あなた方が率いる軍が、この都市を蹂躙しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "どれだけあなたがブラッドブルードとの差を強調しようと、どちらも両手を血で染めた侵略者であることに変わりはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君は誤解しているようだ、ロドスのコータス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "私はただ違いを主張したいのではない――確かにある面において、彼の好みは私を嫌悪させるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "しかし私は諸王や廷臣のような振る舞いをするつもりもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君の前に立つ時、彼らに見えるのはあの殿下の継承者だ。それにより彼らは君に疑いや好奇心、あるいは嫌悪を抱くであろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたからは警戒しか感じ取れません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "そうだ、コータス。私は君を――危険な敵としか見なしていない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "――俺たちに向かって手榴弾を投げやがった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "城壁にしがみ付いてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "これは彼のアーツです……彼は今アーツのエネルギーで衝撃を作り出し、私たちを城壁から落とす気です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "くっ……立ってるのがやっとだ。足元の至る所で爆発してるみたいだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ドローンじゃあいつに近づけないよ！　少しでも近づけば、機体がバランスを失っちゃう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "みなさん……私の後ろへ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ア、アーミヤちゃん、あいつのアーツが君のアーツを溶かしてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "彼はわざとアーツの衝撃を細かく鋭くして放ち、私が編み上げたエネルギーのバリアを砕いています……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "でもアーミヤちゃんはドラコの炎すら防げるんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼は我々の戦い方をよく知っている。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "彼のアーツはアーミヤへの対策だ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "君たちが来るのをわかっていながら、私が何もせずに時間を浪費していたとでも？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "うわっ、まただ！　足元だけじゃなくて、そ、空からも来てる！　赤く光ったと思ったら、急に爆発が――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "アーミヤさん、あんた……心を操るアーツが使えるんだったよな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "あいつの思考をジャミングしたりできないの……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……無理です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "彼はガードがとても固いうえ、至って冷静です。感情の縁に触れることはできますが……今彼の心の中には勝利への渇望しかありません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼は時間稼ぎをしている。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい……彼の心は目の前のこの戦場にはありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ただブラッドブルードと都市防衛砲が、自救軍の生きる望みをすべて破壊するのを待っているんです！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "時間稼ぎ？　素晴らしい推測だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "{@nickname}、ただの偶然で魔王の力を得られたそちらのコータスなどよりも、私は君にずっと興味があったのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "君は過去にこれよりも厳しい状況に直面したことがあるのだろう――そして常により良い結果を得られる選択をとれるようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "教えてくれ、次に君はどう動く？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "長期的な脅威を排除するために、ここで全力を尽くして私を殺しに来るか、それともほかの方法で私を避け、下のヴィクトリア人たちの命を救うか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "うぅぅぅわぁ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイディ",
          "text": "バリンさん、前方の道はどうですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドスオペレーター",
          "text": "通路が一部崩れた！　戦士の三人が下敷きに――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイディ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイディ",
          "text": "崩れた箇所を避けましょう！　引き続き前進します。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイディ",
          "text": "覚えておいてください。この道中、誰が犠牲になろうと、私たちは止まってはいけません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "上がって来い、早く。列車が見えたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "サルカズにはまだ勘づかれてないようだ。何とかして乗り込んで、制御権を奪わないと――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "ハマーさん、気を付けて！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "サルカズの狙撃兵だ！　待ち伏せされてるぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "ちょっとでも外に顔を出せばやられる！　ロックロック、すぐに地下に戻るべきだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "戻るのは……もっと危険だよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "あたしたちの唯一の勝機はサルカズに地下を破壊される前に列車を動かすことだって、指揮官が言ってたでしょ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "だけどハマーが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "ハマー隊長は犠牲になった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "今指揮の責任を負ってるのはあたし。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "聞いて。砲撃が止まったら、あたしたちはすぐに列車を動かさないといけない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "text": "あたしが倒れたら、次の人が代わって――たとえ最後の一人になったとしても、その人をここから送り出さないといけないんだ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "このゲート……また突破されちゃうんじゃない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "指揮官、俺たちがあいつを止めます！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "行くな、貴様らでは止められない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "ハハ……ロドスさんよ、俺たちにそれがわかってないとでも？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "第十三隊の戦士たち、俺に続け！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "おい、お前らなに戻ってやがる、バカはやめろ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "ゲ、ゲートが壊された！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "撃て、撃つんだ！　手榴弾！　一斉にかかれ！　この化け物とやり合うぞ！！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "うっ……うああ――！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "奴が……来た。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "煙塵が消え去り、漆黒の通路の先に一つの影が現れた。\nそれの見た目は化け物とは程遠かった。ねじ曲がった身体はなく、鋭い牙や歯もなく、ましてや余計な触手なども生えていない。\n新聞に掲載されていてもおかしくない、ロンディニウムの政治経済の情勢について悠然と語る若い貴族に見えた。\n……彼の足元の地面が血に染まっていなければ。"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "……ひどい臭いですねぇ。あなた方の戦い方は、あまりにも醜く汚らしい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "化け物……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "し……指揮官に近づくんじゃない……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "あれ、俺の手は？　まだ触れてないのに――あぁぁぁ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ふむ……この香りの方がずっと心地がいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "さてと……あなた方の身体で唯一価値あるもので地面を清めるといたしましょうか。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ブラッドブルードが軽く指を上げた。クリスタルのワイングラスを掲げるように、あるいは音楽のリズムに合わせるように。\n彼の足元から影が躍り出し、戦士たちの身体を捕らえて、その四肢にまとわりつく。\n悲鳴は噴き出す液体に完全に呑み込まれた。\n強烈な血腥さが鼻腔に入り込む。鮮血の色が視界を満たす。\n通路の向かい側に立つ者は瞬時に理解した。\n彼らが影だと思って追っていたものが実際には、極限まで濃縮された血液だったのだと。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "ワルファリンとクロージャって……あいつらも本当の姿はこんななのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "……あんた最初に言うセリフがそれなの！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "だったら何を考えりゃいいんだよ？　ビビりすぎてなんも考えられないよりはマシだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "早く逃げるんだよ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "「魔王」はどこですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "何言ってやがる――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "せっかくこんな場所まで謁見しに来たというのに、あなた方のような弱小生物の後ろに隠れて、私に会ってくれないというのですか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "あぁぁ――！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "……アーミヤ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "奴はアーミヤを探しに来たんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "それって、あいつがなんちゃら王とか言ってる人のこと？　　ほんとにそれがアーミヤちゃんなの？　だってアーミヤちゃんってコータスでしょ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "まあいい、今それは重要なことではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "でもアーミヤちゃんはここにいないよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "むしろちょうどいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "うーん、それもそうだね。アーミヤちゃんでも、この化け物を止められるとは限らないしね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "アーミヤちゃんとドクターの方は上手くいってるかなぁ……はぁ、吾輩は何を考えてるんだろうね。防衛砲を止められても、現状吾輩たちはすぐにボロ雑巾になるっていうのに。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "ヴィーナ、どうする？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "逃げる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "私たちはここで死ぬ気はない……死ぬわけにはいかない。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "このまま膠着状態でいるわけにはいきません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、少し下がっててください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "これから大量のエネルギーを集めます。できるだけ早くマンフレッドを倒さなければいけません……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ダメだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、私を信じてください。この前に指輪を一つ外してから、私は大分成長しました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "まだロンディニウムに入ったばかりというのはわかっています。こんな所で倒れるつもりはありません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼は君がそうすることを望んでいる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "うぅ……相手のエネルギーが集まっています！　まるで……まるで網のように、頭や、足元……いたるところに！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "空気中に……見えない源石結晶が紛れています！　彼はこうした散らばった結晶を攻撃のビーコンにしています！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "そういうことだったのか。そんなんステルスドローンがそこかしこから爆弾を投下してるようなもんじゃないか！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "フェイストさん、クロージャさんと一緒に離れてください……万一巻き込まれたら、あなた方では逃げられません！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "それで終わりか？　好きなだけ力を集めろ、コータス。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "このエネルギーの流れは……私のアーツを受けて強化されている……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "味わうがいい、これは君自らが作り上げた檻なのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あがくほど……捕らわれるということですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "コータス、私の心は君との戦場にはないと言っていたな。あれは、半分だけ正解だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "私は君を殿下のもとへと連れて行く。ロンディニウム内のサルカズたちは……異種族の者が君主の力を借りて放埓に振る舞うのを許す気はない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私には、彼らに号令を発することなどできませんし、したくもありません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "当然、君にできるわけがない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですがテレシスにもその資格はありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "カズデルにいた時、私はたくさんのサルカズの戦士を見ました。彼らの多くが傭兵でした。その後、チェルノボーグで……私は彼らに再会しました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "タルラに利用されている時でさえ、彼らは戦いの相手が誰かを、そして自分は命と引き換えに未来で役立つものを得ようとしていたことを理解していました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが今はどうでしょう？　あなた方は彼らを異種族の首都に閉じ込めています。私はこの都市に入った瞬間に、彼らの怒り、焦り、そして迷いを感じました……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "私の戦士たちの感情を読み取ったのか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "また……檻が小さく……あなたは怒っているのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "コータス、うぬぼれすぎだと誰かに言われたことはないかな？　君はただの感染者であり、サルカズの人生を身をもって体験したことはない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "はたから見ているだけの君が、何をもって我々の苦しみや憤りを真に理解できると思っている！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そうです、私は理解していないかもしれません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが……あなたたちの心の中で燃えるその火は、はるか昔から今に至るまで――始まりのカズデルから、今のロンディニウムまで絶えることなく燃え続け、今でも私の心の中にあります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "焼けるように熱いです。その熱さはこの上なく真実で、どんな言葉もアーツがもたらす幻覚もかないません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "何とでも言うがよい、感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "君の力の由来を私はよく知っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "嘘というのは、それを吐いた本人が真実だと信じたところで信憑性を増すものではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "サルカズ、感染者……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あなたがどう見なそうと、私たちは不公平な境遇の中で、生き延びたいと願うただの普通の人です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そしてテレシスは、あらゆる人々を絶望の戦争の中に引き入れました――都市の外にある大公爵たちの軍隊を見てください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いつの日か彼らの矛先が同じ方向へと向いたら……それがカズデルであれ、ロンディニウムであれ、サルカズに待ち受けているのは破滅しかありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "血統、権力、利益、あなたたちがどんな手で彼らを駆り立てたとしても……それこそすべてが嘘です！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "……一瞬でまたエネルギーを編み上げ、押し広げたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "私は間違っていなかったようだな、コータス。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "――君はとても危険だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "君の力、そして君の言葉は……我らの頼もしき戦士を揺るがすことは叶わぬが、我らの敵に希望の幻をもたらすであろう。奴らにはあまり長く足掻いてはほしくない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "君にはここで立ち止まってもらうしかない。これ以上君をこの都市へは踏み込ませない――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "その前に、私はあなたの檻を砕きます！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "こんなものはまだ檻とは呼べない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "え……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "何者かが私のアーツのエネルギー密度を変えている？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "ふむ、また君か……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "ドクター、少し遅れてしまったか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "城壁内で通路を見つけるのは……この俺でも、少々困難だった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "優秀な助っ人たちがいてくれて助かった。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ご苦労だった、Misery。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ、戦場を変えよう。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "クロージャ、ドローンで狙いを定めろ。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "フェイスト、ジップラインだ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "今すぐ、飛び降りよう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "数分前"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "ドクター、マンフレッドをロックオンしたよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "うーん、彼の周りは人が少ないね……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼は我々が近づくのを恐れていない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "マンフレッドってもしかして超強かったりする？　なんか見た目がいかついし、テレシスから教わってたりするんじゃないかな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "本当にあたしたち五分以内にあいつをぼこぼこにして、砲撃を止めさせるなんてできるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "いや、違うね。あたしたちじゃない。ここまで来たら、戦闘力の面で言ったらあたしとフェイストはお話にならない。後方勤務の奴が突っ込んだところで死ぬだけだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "アーミヤちゃん、君に頼るしかないよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "マンフレッドは強敵です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが私たちはこれまで……たくさん強敵に会ってきました。これからも、次々と現れるはずです。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ、マンフレッドの注意を引いてくれ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "クロージャとフェイストは壁から撤退する準備をしてくれ。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我々が待っている人はまもなく来る。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "同じ手を繰り返すか。二度も君に人を連れて逃げさせると思っているのか？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "まるで空中で位置を特定できそうなほどのエネルギーが、突如として襲ってきた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "その剣先が自分の足先に触れかかっているのをあなたは感じ取る。\n――と、気配が消えた。そして、あなたたちの目の前には盾が現れていた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "サルカズ、追わせないわよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "あなたの相手はここだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "白狼、まさか君がまた私の前に現れるとはな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "この通路は双方向に通れるのか。彼らを連れて行くと同時に、君を連れて来たと。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "……「君」じゃないわ、「君たち」よ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ホルンの後ろで、一人の兵士が立ち上がった。\nそして二人目、三人目。\n十数人のヴィクトリア兵がサルカズ将軍の前に立ちはだかる。\nもう変装している者は誰もいない。\n彼らの制服は様々である。そのほとんどに幾度とない戦火による焼けた痕跡が残っていた。土や埃だらけのもの、自分や戦友の血がついたものもある。\n手に持つ武器もバラバラだ。ある者はいまだ軍刀を、ある者は自作のクロスボウしか持っていない。\nだが、彼らの顔に浮かぶ表情だけは同じものだった。\n今回は、命ある限り、もう絶対に退くことはない。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "……敗残兵の集まりで、私に勝とうと？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "武器を持った君でも私の相手ではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "よもや忘れたわけではあるまい。前回君が私の手から辛くも逃れたのは、すべてあのロドスのサルカズのおかげだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "今目の前にいる相手も見なさい、サルカズ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "戦場においては、相手を尊重しない人が、真っ先に死ぬのよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "君は本当に強情で頭が固い。その盾の方が柔らかいと見える。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "くっ――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "敵の攻撃方向に注意、盾の後ろに集まれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "元々君のことは排除する予定であったが、まさか君自身がこれほど死に急ぐとはね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "少しくらい戦術の素養は備えているとばかり思っていたよ、白狼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "敗残兵を率いて私に対抗し、兵士たちを無駄死にさせるのが、君の言う忠誠とやらか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "あなた……今自分がどこに立っているか忘れないことね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "ここはロンディニウムの城壁よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "サルカズ、もうロンディニウムを征服した気になっているなら大間違いよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "――見なさい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "私たちはまだここに立っているのよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
