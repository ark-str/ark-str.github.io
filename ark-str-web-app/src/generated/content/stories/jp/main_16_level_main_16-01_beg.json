          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "衛兵",
          "text": "言いくるめようとしても無駄だ。俺は自分の仕事をするだけだから関係ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "衛兵さん……",
