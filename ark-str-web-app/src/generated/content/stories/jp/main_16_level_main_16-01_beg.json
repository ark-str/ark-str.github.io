        },
        {
          "type": "dialogue",
          "speakerName": "ためらう衛兵",
          "text": "うっ……うっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "衛兵",
          "text": "何をぼうっと突っ立ってる、かかれ！",
