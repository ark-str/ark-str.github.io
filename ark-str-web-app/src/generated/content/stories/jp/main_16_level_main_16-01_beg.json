        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我々にはあまり時間がない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アロイジウス",
          "text": "安心してちょうだい。あなたたちの目的を考えれば、決して時間の無駄にはならないわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アロイジウス",
          "text": "この辺りにしましょうか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ここは？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アロイジウス",
          "text": "打ち捨てられたアパートよ。私の知る限り、衛兵はこういうほぼ無人の旧街区までは手を伸ばさないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アロイジウス",
          "text": "都市区画が空いてるなんて贅沢に聞こえるけど、これが実態なの。『サンクト・グリファーブルクタイムズ』がどう隠そうと、この都市の人口が近年減少し続けてることは紛れもない事実なの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アロイジウス",
          "text": "もう少しすれば、この辺りも完全な無人地帯になって、建物は区画ごと取り壊され、荒野の上で朽ち果てるわ。他の廃棄区画と同じようにね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "アロイジウスさん、あなたが私たちに接触した目的を早く理解したいのですが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（警戒するように見つめる）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アロイジウス",
          "text": "ええと……皆さん、もう少し落ち着いていただいてもいいかしら？",
