{
  "server": "jp",
  "storyId": "act32side_level_act32side_07_beg",
  "groupId": "act32side",
  "stageId": "act32side_07",
  "title": "非常口",
  "storyCode": "CR-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act32side/level_act32side_07_beg.txt",
  "sourceHash": "4e74204814915b333337c03941ff7dc0f43a7e3b4bc1d8af530b400492a3044d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "報告です、大尉。観客は全員確保完了。レイネルもバルコニーに拘禁できました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "よし。増援の配置は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "トラック十五台、すべてギャラリー外壁の向こうに待機完了しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "このあと何をすべきかは……言わなくてもわかるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "美術品を車に積み込む時壊さないように、野蛮な野郎どもにしっかり言い聞かせとけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "壊した奴がいたら、壊した数だけそいつの指も切り落としてやるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "了解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "それと、富豪の皆々様の端末も没収しておけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "でしたら、奴らの身に着けている金目のモノも、ついでに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "ふん、抜け目のない野郎だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "奴らに何をしようと不問にしてやる。だが美術品については、くれぐれも丁重にな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "わかったら行け。俺はレイネルに用がある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "夜が明けたな。どうだ、日の出は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "おっと。お前ら文化人様の調子に合わせてこう聞くべきだったか。「どうです、美しい眺めでしょう？」ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "なんだ、だんまりか？　そうやって口を閉じていれば安全だなどと思わんことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "とはいえ、いまさら話すことなど何もないだろうがな。おとなしくここに座ってテロの被害者を演じていれば収まる話なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "――僕をテロの被害者に仕立て上げるつもりで、こうしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "どうやら、口がきけなくなったわけじゃないらしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ああ、すまない。僕の勘違いだったな。見破られたかと思ったが……どうやら、欲に目が眩んだ間抜けが偶然つまらん悪だくみをしただけらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "ハッ、さっきまでのスカした態度はどこ行った？　急に腹でも立ってきたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "いや、この「偶然」には何の不満もない。これなら、むしろ僕の最後の作品をさらに素晴らしいものへと高めてくれるだけだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "無論、これが君の狙いではなく偶然の賜物である以上、運命に感謝こそすれ、君に感謝などしないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "そりゃ結構。じゃあ、あとはもう黙ってろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "大尉！　大尉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "なんだ？　騒ぎを起こした奴でもいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "いえ、実は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "向こうでお話しさせてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "おっちゃん。アタシたち、日付を間違えたりしてないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "そんなはずないだろう。広場を見るに、さっきまでここに大勢がいたことは間違いない。きっとなにかあったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "アタシたちが来るのを見た誰かがレイネルに報告して、ギャラリーの中にみんな逃げちゃったとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "それはレイネルらしくないわ。私たちが来ると知れば、怒ったり興奮したりはするかもしれないけど、逃げるなんて絶対あり得ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "だったら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "あれ、端末が鳴ってる。あたしのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "もしもし、エルネスト？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "アリータ、繋がってよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "そっちはどう？　例の私用は順調？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "コミュニティの皆に伝えてくれないか。少なくとも今日の間は、絶対にギャラリーには近づくなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "え？　なんで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "ギャラリー内に、大量の源石爆弾が仕掛けられてるんだ。いつ爆発してもおかしくない。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "源石爆弾！？\nそれって……ふっ、あはは……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "それ、どういう笑い？　っていうか、今どこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "実はあたしもElaさんたちも、テクノちゃんもディアスさんも、コミュニティの皆も……全員揃ってギャラリー前の広場にいるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "だったらどうして逃げないのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "悪いけど、こっちからも質問していい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "そこまで中の状況を把握してるんだよね。そっちこそ、今どこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "オーケー、わかった。あんたが知ってる情報全部、今すぐあたしに教えて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "アリータ、ダメだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "教えてくれなきゃ、状況もわからないまま闇雲にあんたを助けに突入しちゃうけど、いい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "この穀潰しが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "美術品は壊さないよう伝えろと言ったそばから、お前が壊してどうする！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "大尉、どうかお聞きください！　その壊れた陶器の中に……その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "……源石爆弾が仕掛けられていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "源石爆弾だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "し、しかも――それひとつではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "先ほど階段を登っていた時、壁に違和感がありまして。どうやら直したばかりのようだったのですが、そこを調べてみたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "壁を壊したのか？　その中に爆弾があったと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "爆弾でこそないのですが……起爆装置の分配器が。これがあるということは、起爆地点は複数あるということです。つまり、想像を絶する量の爆弾が仕掛けられているかもしれません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "――僕をテロの被害者に仕立て上げるつもりで、こうしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "見破られたかと思ったが……どうやら、欲に目が眩んだ間抜けが偶然つまらん悪だくみをしただけらしい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "そういうことか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "爆弾が爆発したら、ギャラリーは木っ端微塵です！　しかも、あれが遠隔操作なのか、時限式なのかすらも、現状では把握できていません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "今ある美術品を積み込んで、投資家たちから金目の物を奪ったら、すぐに引き上げるべきです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "このままおめおめと逃げ去ることになってもいい、と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "爆弾は今まさに、このギャラリー内にあるんですよ！　そんなことを言ってる場合じゃありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "ここでしくじってみろ！　俺たちは連合政府とドッソレスを同時に敵に回すんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "上手く逃げられさえすれば、向こうだって何もできやしませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "どこへ逃げると言うんだ？　まさか荒野で取り分を山分けして、数百ドル程度のはした金を手に解散しようとでも？　そんなことのために危険な橋を渡ってきたわけじゃないだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "命がかかっているんですよ、大尉！　最悪、国外逃亡でもして、傭兵か野盗にでもなれば済む話です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "野盗だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "あ……いえ、そうすべきということではなく、こちらまで命懸けでレイネルの暴走に付き合う必要はないということです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "そうか、分かった。他に源石爆弾について把握している者は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "誰もおりません。下手に情報が広まればパニックになりますし、大尉に報告してご指示を仰ごうと思いまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "良い心がけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "全員に伝えろ。美術品の略奪は切り上げて、下に集めたお偉方から金目のものを奪い次第、直ちに撤退するとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "ああ、それと、くれぐれも焦らないようにな。爆弾のことは誰にも勘付かれないようにしろ。急がずゆっくりやれ、いいな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "隊長が身を翻し、下の階へ向かって駆け出したその時、弓弦の鳴る音がした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼が振り返る間もなく、大型クロスボウの矢がその胴体を貫く。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "若造が。ここまで周到に準備して、多くの決断を下した挙句、退路を断たれるまでしておいて……野盗にでもなるしかない、だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "もう後戻りなんざできねえんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "俺も、お前もな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "「継ぎ接ぎ」のテロ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "うん、エルネストが言うには、そういうことっぽい。爆弾を仕掛けたレイネルと、聴衆を館内に連行した大尉は、お互いに相手の目的を知らないみたいなんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "……狂った人間が偶然二人も揃っちゃったわけね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "そのようね。最悪の事態に備えて、巻き込まれた人質の救出を最優先としましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "具体的な行動方針を考えないと。すぐ動ける人員は五人ね。IanaにDoc、Fuze、私、それからカタパルト……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "俺も入れてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Doc",
      "text": "本気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "俺がどこで働いていたか、忘れてもらっちゃ困るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "それに、ギャラリーに閉じ込められてるのはレイネルの野郎と投資家連中だけじゃない。一般人だって大勢いるんだ。俺が行かない理由はないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "おっちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "止めても無駄だぞ。行くと言ったら絶対に行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "そんなこと言ってないでしょ？　アタシも行く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "お前がか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "ダメだ、中は危険すぎる。お前は他の奴らとできるだけ遠くへ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "おっちゃんときたら、何もわかってないんだから。消防士の経験は確かにないけど、アタシたちの想いはおっちゃんと同じなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "皆、聞いて！　今からアタシたちで、ギャラリーの中にいる人たちを助けに行くよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "もちろん強制はしないけど、一緒に来てくれる人は、Elaの指揮に従って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "その気のない人は無理せずに、ヤケになったマッテオの巻き添え食う前にすぐコミュニティに戻って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "お前ら、どうする？　付いて行くか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "正直死ぬのは怖いし、やめておくよ。まだまだ撮りたい写真が山ほどあるからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "でもよ、金持ちどもが怯えて小便チビってるとこ見たくねえか？　俺は見てえんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの画家",
      "text": "低俗だなお前は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "なんだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの画家",
      "text": "そんなの見てどうすんだよ。それよか俺は、レイネルが買い集めた美術品を拝みたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの画家",
      "text": "レイネルの野郎からチケットを買わなきゃお目にかかれないと思ってたが、人助けって大義名分がある今なら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "い、言われてみれば、確かに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "急にギャラリーのチラシなんか取り出してどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "……これだよ、これ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "クリスタウォワギャラリー第二ホール、展示品No.14。ミノスがサルゴンに占領される前夜、無名の詩人が残した手稿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "こんなに美しい詩が、こんなに貴重な手稿が、レイネルなんかのもとにあるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "俺はこの詩のために、ミノス語を学んだんだ！　その証拠に暗唱してやるよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの画家",
      "text": "やめろって。どうせ聞かされてもわからないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの画家",
      "text": "急に泣き出して、どうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "詩人の過酷な運命と、この手稿のことを考えてから、俺自身を見つめ直したんだ……俺は……俺は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "やっぱり行くよ！　手稿をひと目見られるなら、その瞬間爆発に巻き込まれたって構わない。絶対に行かなきゃならないんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "監禁されている人質の数を考えると、避難誘導に人手を割いた方がよさそうね。首謀者の制圧と爆弾処理の方は、私たちに任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "カタパルト、もう一度テキーラに繋いでちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "おっけー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "テキーラ、聞こえる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "Elaさんですか？　あなたまでアリータと一緒にギャラリーに突入するなんて言わないでくださいよ。ここはとても危険で――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "私たちはね、この手の現場のプロなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "カタパルトから聞いたわ。あなたはいまギャラリー東棟三階の、大量の爆薬が置かれた隠し部屋にいるのよね。加えて階下の騒がしさから、下に人質が大勢監禁されていると見ている。間違いない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "中に大尉の部下はいる？　彼らはもう爆弾を見つけたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "恐らくいると思いますが、騒がしすぎて会話がよく聞こえなくて……ちょっとお待ちを――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "テキーラ、大丈夫なの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "（小声）いま、兵士が二人、隠し部屋の入り口辺りを通り過ぎていきました。美術品をどうやって車に積み込むかを相談しているみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "オーケー、それを元にこっちで計画を立ててみるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "（小声）ねえ。こんなちっちゃいのでホントに中の奴らまでぶっ飛ばせるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "（小声）ギャラリーのガラス壁ならまだしも、この倉庫はマッテオが外の司令部代わりに使ってる場所だよ。もしかしたら補強されてるかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "（小声）問題ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "（小声）でも……わざわざロープで二階の外に張り付いたって、壁の外から爆破したんじゃ……そこまで行ったなら、いっそ窓を割って中に投げ込んだ方がいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "物陰から聞こえる声",
      "text": "何か物音がしなかったか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "物陰から聞こえる声",
      "text": "聞こえたな……ポン、ポン、ポンって感じの音。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物陰から聞こえる声",
      "text": "五回くらい鳴ったよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物陰から聞こえる声",
      "text": "三回だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物陰から聞こえる声",
      "text": "どっちでもいいだろ。なんにせよ、広場でバカみたいに突っ立ってないといけない奴らと違って、俺たちはわざわざ苦労しなくても、この建物の中を守ってれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "退避しろ！　爆発に巻き込まれるなよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "建物の中から、続けざまに爆発音が響く。\nぽかんと口を開いたカタパルトはFuzeに視線を向け、称賛の言葉を口にしようとしたが、Fuzeは首を横に振る。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その時、屋内でさらに激しい爆発が起こった。クラスターチャージが中の爆発物を正確に捉え、誘爆したのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "Ela、こちらFuze。じきに外の兵士が出てくるはずだ。応戦の準備をしてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "カタパルト、こっちも動くぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "動くぞって……さっきの爆発で全員倒せたんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "敵がどんなに愚かだろうと、相手を決して侮るな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの軍人たち",
      "text": "敵襲、敵襲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "あんたって……もしかして天才？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "そんなもんじゃない。俺には訓練で得た経験と、偵察で得た情報、仲間とのチームワークと、ほんの少しの技術があるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Fuze",
      "text": "ただのそれだけさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
