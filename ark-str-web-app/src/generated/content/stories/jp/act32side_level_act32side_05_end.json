{
  "server": "jp",
  "storyId": "act32side_level_act32side_05_end",
  "groupId": "act32side",
  "stageId": "act32side_05",
  "title": "消防用通路",
  "storyCode": "CR-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act32side/level_act32side_05_end.txt",
  "sourceHash": "2b394fdb234b7f060f7bbab5ff797e882d01263906d699b03a02c4ebc6a4b4c4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "ブッカーか。何か問題でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市長のボディガード",
      "text": "市長、大尉に我慢の限界が来ているようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "レイネルにあれだけしてやられても動かなかった奴らが、ようやく重い腰を上げたわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市長のボディガード",
      "text": "情報によると、大尉はコミュニティの武力制圧も辞さない考えのようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "私の土地でもめ事を起こすとは、ずいぶん肝が据わっているじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市長のボディガード",
      "text": "連合政府内には彼の行動を支持する者もおり、市内にいる連合政府軍の全てを動かせる権力が与えられているとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "やってくれる。奴らはますます手を伸ばしてきているわけか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市長のボディガード",
      "text": "阻止すべきでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "今はやめておこう。あのコミュニティの連中はいつも好き放題やっていて、市政に異を唱えることも多い。仮に大尉たちがこの件を片づけてくれるのなら、むしろ有難いくらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "だが警戒は怠るな。マッテオは浅薄で貪欲な男だからな。大きな権力を握れば、下心を抱かないはずもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市長のボディガード",
      "text": "承知いたしました。別件で、数日後に開かれるクリスタウォワギャラリーの開館式ですが、参加なさいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "ああ、災いの種はそちらにもあったな……私は欠席する。誰かに祝儀だけ届けさせなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市長のボディガード",
      "text": "畏まりました。では、失礼いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カンデラ",
      "text": "待った。エルネストに頼みごとがあるんだ。今から言うことを忘れずに伝えてくれないか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "物腰柔らかな投資家",
      "text": "レイネル君、私を覚えてくれているかな？　数年前に一度会っただろう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "あなたは確か……待った、答えはまだ言わないでください。もう少しで思い出せそうなんです。\n……そうだ、ノリスさんでしたね。三年前、オークションでミノスの彫像を競り合った覚えがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "物腰柔らかな投資家",
      "text": "そう、その素晴らしい記憶力には驚かされたよ。君は、彫像の製作者はもとより、以前手にしていたコレクターの名まで覚えていたからね。当時はそれについて随分と長く語らったものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ええ。物覚えの良さは……確かに、僕の長所の一つですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物腰柔らかな投資家",
      "text": "いやぁ久しいな。君はずいぶん変わったようだね。当時の青臭さが抜けて、ますます父君と似た風格が出てきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "だからこそ、父が早くに亡くなったのが残念でなりませんよ。僕がいま取り組んでいることの全てを、見せられたらよかったのにと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物腰柔らかな投資家",
      "text": "そう悲しむことはない。息子が父を超える偉業を成したとあれば、たとえその目で見られずとも、きっと誇りに思うことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ハハハ……そう願います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマをする収集家",
      "text": "コワルスキーさん、探しましたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "おお、チェティさん！　お元気でしたか？　実は下の展示スペースにイベリアのフレスコ画が届いたところなんですよ。昨年は、あちこち奔走してフレスコ画の名作を集めていらしたはずですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマをする収集家",
      "text": "それは去年の話ですな。今日は炎国の水墨画を、可能な限り買い付けてやろうと思っているところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "意外ですね。あなた方の投資トレンドが急に変わるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物腰柔らかな投資家",
      "text": "レイネル君は知らないだろうが、コロコロと変わるのは投資トレンドではなく、チェティ君の心の方なのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……興味深いお話です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物腰柔らかな投資家",
      "text": "（小声）彼は今年、再婚したばかりでね。新しい奥方は水墨画に目がないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマをする収集家",
      "text": "そこまで知られてしまったからには、単刀直入に言いますぞ、コワルスキーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマをする収集家",
      "text": "例のフレスコ画を全て、なるべく早く手放したいのですが、どこかいいルートをご存じありませんか？　マリーの奴、キャサリンの残したコレクションが気に食わんと言うものでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "それでしたらお役に立てるかと。力を尽くしてみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマをする収集家",
      "text": "そう謙遜なさらず。あなたはかのシュチェパン・コワルスキーの息子さんなのですからね。在りし日の父君が半月も経たぬ内に私のコレクションをすべて片付けてくれたように、君にも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "あら、ごめんなさいレイネルさん。そんなところに立っていらしたなんて、気付きませんでした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマをする収集家",
      "text": "なんだね、この女性は。大の男が三人も立っていて気づかなかったと言うのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "申し訳ありません、お二方。彼女は新しく雇ったボディガードなのです。後でしっかり言い聞かせておきますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "今すぐお着替えが必要でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "もちろん。酒が身体にかかったままでは不快だからね。それでは皆さん、失礼します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ありがとう、Ela。機転を利かせてくれて助かった。これ以上、息が詰まる相手には囲まれたくなかったからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "礼なんていいわ。当然のことをしただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "今日はここに来ないと思っていたよ。コミュニティの人形ショーは明日正式に開催される予定だろう？　やるべきことがたくさんあるんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "それでも、契約はまだ終わってないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "君のプロ意識には感服するよ……それで、契約終了後はどこへ向かうつもりなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "――その背中、どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ん、この傷跡か？　気にしないでくれ、ちょっとした反抗の代償とでもいったところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……契約終了後は、ドッソレスを離れて失踪した仲間の捜索を続けるつもりよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "となると、もう会うことはないかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "こんな我がままな雇い主なんて、契約がなければとっくに見限られていたんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "あなたの方こそ、こんな反抗的なボディガードによくもまあ耐えられたものね。正直驚いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "はい、これ。今までのお礼をこめて贈らせて。私たちを助けてくれたこと、感謝してるわ。今後も万事うまくいくといいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "おや、プレゼントを用意してくれていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "ええ。コミュニティのとある歌手が売ってくれたレコードよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "この名前……どこかで見覚えがあるような。ああ、思い出した。確か去年、僕を罵倒する歌をリリースした男だ。あれは27分も続く長い歌だったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "そうなのね……知らなかったわ。ちょっと聴いてみてほしかっただけで選んだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "いや、気にしなくていい。彼への仕返しはもう果たしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "仕返しって、何をしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "彼が以前契約していた会社から、曲の版権をいくつも買い取ったんだよ。そして彼が最も憎む流行りのポップバンドに権利を譲渡してアレンジさせた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……レコードはここに置いとくわ。聴くかどうかはご自由に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……はい。奴は確かに数日前、私が電話をかけた際、それを切りました……恐らく、電話線も抜いてしまったんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "いま少し時間をいただければ、何とかしてあの土地を奪ってみせますので……開発計画は必ずや予定通りに。お約束します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "私がどれほどあなたに忠義を尽くしているかはご存知のはず。気が緩んでいるなど、決してそのようなことは。ただ本当に、厄介な問題なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "開発権を持つ商人は協力を拒んでいますし、穏当な手段も強硬策も効き目がなく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "コミュニティの方に直接手を出してもみましたが、あそこの連中もかなり厄介で……こちらに損失が出ています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "い、いえ、決して言い訳ではなく、事実をご報告しているだけなのですが……連合政府内にもレイネルの肩を持つ者がいるようで……うかつに手出しができません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "私が無能なばかりに、敵の正体も探り切れておらず申し訳ありません……そこで僭越ながらお伺いしたいのですが……何か手がかりはございませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "例えば、あなたからドッソレスでの利益を奪おうとしているのが誰なのかであるとか。いえ、あなたの政府内での地位を疑っているわけではなく、そういう人物がいるかもしれないという話です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "構わずやれ、と仰るのですね？　そ、それで本当によろしいのですか……？　もしどなたかの不興を買えば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "わかりました。あなたのお力添えがあれば、私も心置きなく行動を起こせます。はい、必ずやご期待に応えてみせます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "大尉……もしやあの方にすら、敵の正体を掴めていないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "ああ、あの方もご存知ないらしい。それどころか、気にも留めていないようだ。ドッソレスにおける連合政府の最高指揮権を与える代わりに、一刻も早くこの件を片付けろと言ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "カンデラの方はどうしましょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "何とかしてくれるそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "あの方に全力で支援していただけるなら、解決するはずですよね……それなのに、大尉はなぜ不安そうな顔をなさっているのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "考えてもみろ。何かを成し遂げるにあたって、上司の全面的な支援が必要になる部下というのは、どんな奴だと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "深く信頼されている人でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "ふん、無能な部下に決まってるだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "当初はこの開発計画を成功させ、あの方にアピールするつもりだったが、こうなってしまえば、誰かに尻拭いしてもらうのを待つだけのマヌケとしか思われない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "例の土地さえ手に入れれば、あの方もきっと大目に見てくれるはずですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "そんな可能性に賭ける余裕なんてない。近頃頭角を現している若造があの方の傍についているようだからな。しかも、その若造がここに来るそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "若造に取って代わられたくなければ、土地を奪うだけでは足りん。何かもっと大きな「功」を立てなければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "何かお考えが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "当然ある。それも、長いこと温めていたアイデアがな。レイネルの野郎にはこれまでさんざん世話になったことだ。きっちり礼をしてやらないと、ナメられたまま終わっちまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "あのギャラリーごと手に入れるんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "開館式までもう時間がない。この短期間で事を成すには……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "荒っぽくなるが、一番危険なやり方しかなさそうだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "おかしい……絶対におかしい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "エルネスト？　ガレージの灯りがついてるから来てみたけど、まだ寝てないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "アリータ？　入りなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "こんな時間までコミュニティの手伝い？　確かにみーんな忙しそうだもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "はぁ。コミュニティ関係の話なら、やる気が出るからまだよかったんだけど……どうしても返さなきゃいけない借りがあってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "それって、この前の薬探しの時の？　何か手伝えることある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "違う違う。そうじゃなくて、これは個人的な事情だから。気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "一人でしょい込むのはよくないよー。あたしの力が必要だったら、いつでも言って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "大丈夫、ほんとに大したことじゃないから。もう遅いし、早く休んだ方がいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "あんたって奴はホント……いっつもそうやってなんにも言わないし顔にも全然出さないんだから。そんなんじゃ、助けたくても助けらんないじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "考えすぎだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "text": "考えすぎなんかじゃない。ずっとそんなことしてたら、他人からもそういう奴だとしか思われなくなっちゃうよ……はぁ、じゃあもう行くね。早めに休みなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "助けてもらうのと巻き込むのじゃ、違う話だからね。恨まないでくれよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "しかし、これだけ大量の爆薬が、都市に入った途端行方明になるなんて、一体何が起きてるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "二十八日に一度……そして翌月の三日にも一度……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "同時期に、酒の運送を装って、酒の原材料もいくつか運び込まれてる……？　いや、だとしたらルートに問題があるな。検問所が四つもあるのに、バレないはずがない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "……一切検査を受けない貨物でない限りは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "とても貴重なものであれば、誰も触れようとしないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "……贅沢品？　名酒かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "いや……そのレベルじゃ、チェックを免れることはないはずだ。となると、今のドッソレスで何千万、あるいは何億課の価値があるものと言えば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "まさか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキーラ",
      "text": "……クリスタウォワギャラリーに行って、確かめてみないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "おい、どうした？　さっきからそこでうずくまって泣いてるよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "今日一日、ずっと踏んだり蹴ったりなんだよ……まず、変な移調譜に出くわしただろ。トランペットの楽譜に、なんでへ音記号が書いてあるんだよ。作曲者は一体何を考えてるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "それでもリハーサルには出たけどさ……楽譜の中にしばらく全休符が続くところがあって、そこに時々音符がちらほら散りばめられてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "ああ、暇だけど練習してないと上手く合わないやつな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "うん……結局休符を数え間違えて、早く入りすぎちゃってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "すごい大きい音出しちゃったから、皆手を止めてこっちを見てきて……ああもう、なんであんなことに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "なんつーか、まあ……今日はもう休めよ。明日は大丈夫だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扉の後ろから聞こえる声",
      "text": "そうかな……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "芸術祭、いよいよ明日だね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "あんた、眠れないなら原稿の手直し手伝ってくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "あれ、とっくに描き終わってなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "うん、でも昨日仕上げの時にソフトがフリーズしちゃってさ。そのうち動くかなって思って晩ご飯食べに行ったんだけど、戻ってきたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "うわああっ――！　待って、もういいから、それ以上はやめて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "お願いだから言わないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "ちょっと！　大げさに頭抱えて暴れないでよ。私のタブレットがそこにあるんだから！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "窓の中から聞こえる声",
      "text": "き、消えちゃった……何もかも……どうしてこんなにツイてないの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "全身武装の軍人",
      "text": "報告。狙撃兵が高所を確保しました。誰にも見られていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "全身武装の軍人",
      "text": "いつでもご命令ください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "ふわぁ……一日中働きっぱなしでくたびれちまった。今何時だ？　よし、まだ時間はあるな。町に一杯引っかけにでも行くか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "痛ってぇ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "道端にこんなでかい岩を置きやがったのはどこのどいつだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "ったく……今日は一体どうなってんだか。何をやってもうまくいきやしねえ。明日占い師のとこにでも行って、運気を取り戻す手段でも聞いてみようかねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "正装の軍人",
      "text": "申し訳ありませんが、お戻りください。現在、外出禁止令が出ています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "誰だよお前？　なんで引き止められなきゃいけねえんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "正装の軍人",
      "text": "お戻りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "おい、何やってんだお前ら？　誰の差し金で来やがった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "正装の軍人",
      "text": "それ以上進まないでください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "制服の軍人が周辺の通りから次々と現れ、武器を手に、厳めしい表情でコミュニティの外に立ち並んだ。\nその間を黒く塗られたトラックが数台、砂埃を巻き上げながら走ってくる。\nよく訓練されているとわかる動きで彼らが車から降ろした物は、夕暮れ時の薄暗がりの中でも、ぎらりと眩しい輝きを放っていた。\n目の前で、ぐるぐると撒かれた有刺鉄線が広げられ、コミュニティ全体を包囲していく。"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "……あんたら……何しに来やがった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "正装の軍人",
      "text": "単なる定期消防検査です。慌てる必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "正装の軍人",
      "text": "どうかおとなしくご協力いただきたい。その方が我々としても……大変助かりますので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
