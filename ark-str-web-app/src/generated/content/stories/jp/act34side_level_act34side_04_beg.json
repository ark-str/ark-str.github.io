{
  "server": "jp",
  "storyId": "act34side_level_act34side_04_beg",
  "groupId": "act34side",
  "stageId": "act34side_04",
  "title": "犠牲と代償",
  "storyCode": "BP-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act34side/level_act34side_04_beg.txt",
  "sourceHash": "0107b89578cf6c9f16e0c12fc839a6bc5f88e3d50eff5cb49084b7d27a9f997e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "なぜここにいらしたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "君に会いに来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "まだ胚分離手術を受けたばかりなのだから、設備管理所もしばらく休暇をくれてもよかったと思うが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "ご存知のように、胚分離手術の肉体的なダメージはほとんどありませんから、そう長く休む必要もなかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "先生がご心配くださっているのが私なのか、それとも保育室の中のあの子なのかはわかりませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "無論君の心配をしているんだ。確かに、新しく生まれてくる子供は今のエーギルにとって気にかけるべき存在だがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "その子が生まれてきたあとは、自分で育てるのか？　それとも公共養育所に預けるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "それについては考えないようにしています。今はまだあまりに……遠いことですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "そうか。――ここに来る前に、病院へ行ってきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "なぜですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "昨日の戦闘のことは知っているだろう？　君はどんな情報も見逃さないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "二個艦隊、千人余りいた戦士の中で、生き残ったのはたったの二十六名だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "航路計画が重要局面を迎えた今になって、ミリアリウムは航行中最も大きな犠牲を払うことになった。さらには、都市内でも多くの異常が見られている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "何を仰りたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "海巡隊が君を訪ねてきたはずだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "失踪した技術者について聞くために……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "アウィトゥス先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "私、あなたが編纂なさった文献の中で、『生活の死』が一番好きなんです。あれに学術的な価値がなかろうとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "あれが世に出たのは偶然でしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "三百年以上前、四人の偉大な先史文明研究者がマントル遺跡群で大きな発見をし、貴重な技術資料が無数にエーギルへと持ち帰られた時の物でしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "その中の図面や理論を記した本に比べれば、日記のような音声ファイルなど、実際取るに足らないものだったのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "ゆえにそれは、科学アカデミーの資料庫で静かに眠っていました。あなたが好奇心からそれを解読し、大衆的な読み物とするまでは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "あれは、先史人類の中でも平凡な人間が、長旅の中で残した独り言に等しい本だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "ですが私は、そんな先史人類の物語が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "彼の目を通して見る真実が好きなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "かつて無数の星を統一していた体制が崩壊し、多くの種族を一つに繋げた信頼が崩れ去った時。物資は枯渇し、技術は失敗に終わり、哲学と芸術は沈黙して……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "どれほど憧れや想像を託そうとも、そうした偉業はやがて音もなく灰となって消え去っていくのです……ビーコン塔内にある、死んでしまったホバーマシンのように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "君は彼の絶望に共感しているのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "だが私は、これまで君の中に絶望の影を見たことはない。何しろ君は自らの子供を、いつ破滅に直面するかもわからない未来に産むことを選びさえしたのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "こんな選択は、絶望している人間にはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "確かに私は、絶望など少しも感じていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "あの生真面目で、意気消沈した中年男性の言葉には……どんな形であれ、感情移入することすらも困難に感じました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "私が素晴らしいと思ったのは、彼が残した記録によって、エーギル人すべての眼前を覆うこの美しいキャンバスを、あなたが巧みに引き裂いたことなのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "「我々は、かつて誇った物事や品性が今は何の役にも立たないという事実を受け入れねばならない。あるいは、元々欠陥や誤りが存在していたことが、災いの中で露呈しただけなのかもしれないが。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "生きていく上での不安がなくなると、人間は価値を気にし始めるものです。我々は自らの思想や行い、ひいては存在そのものに価値があることを期待しているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "エーギルの社会体制は、人々の価値を見出すことができるように設計されたもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "しかし、価値というのは脆いものです。別の角度から見るだけで、偉大なものはちっぽけになり、醜いものは美しくなりうるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "とはいえ、残念ながら、ある種の惰性によって、人々の大半は自らが慣れ親しんだ物の見方を脱しようとはしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "それゆえ人類は常に不変の価値観に依存して生きており、そうした価値観が崩壊した時には、それに伴って崩壊の時を迎えるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "そう、まさに今のあなたのように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "あなたの絶望はいつ芽生え始めたものなのでしょう？　ミリアリウムが本つ域を離れた時でしょうか。あるいは、「知己」を亡くした時からですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "……カシア？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "ともあれ、今日はおいでいただきありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カシア",
      "text": "あなたのおかげで、私にはまだやるべきことがあるということも、そのための時間はあまり残されていないということも思い出すことができました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "クレメンティア。まさかあなたが、自分の都市で悲観論が蔓延するのを許すとは思っていなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "『生活の死』は、アウィトゥスがまとめ、出版した先史時代の日記です。出版された年には、これが公民たちの間で大層流行したものでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "知りもしない生活を覗き見するだなんて、ナンセンスで愚かな怪奇趣味ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "グレイディーア。その本のうちのわずかな言葉だけでも、陸上の国すべてで大きな騒ぎをもたらすには十分なものだと知っておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "そのごくわずかな断片からでも、行間に滲む疲弊と絶望は、輝かしき先史文明がいかなる末路を辿ったのかをどんなデータより生々しく表すものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "エーギルの現状を前にして、それは本当に「知りもしない生活」だと言えるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "エーギルは先史文明の継承者だけれど、決してその従属者ではなくてよ。私たちはもとより、そうした疲弊や絶望に共感する必要などないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "エーギルが強く立ち続ける理由は、その不滅の理性にこそあるのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "まさにその理性こそが、エーギル、ひいては全人類の滅亡が現実に存在しうる可能性であることを人々に認識させてしまうのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "あの憎むべき堕落者たちでさえ、時には長き観察と慎重な検討を経て選択を行うことがあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "――軍にいた頃、あなたは多くの深海教徒を自らの手で仕留めてきたはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "あなたが暴走した狩人たちを自らの手で討たざるを得なかったのと同じように、そうしてきましたとも。私もあなたも、重い責任を負う以上は、感情で動くわけにはいかないのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "あなたがその理性に基づき下した判断は、エーギルへ戻ったばかりのアビサルハンターを、闇雲に航路計画の作戦に加えることだったと仰るのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ケルシー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "お二人とも、我々の背後にあるビーコン塔をご覧くださいますか。あれはかつて、先人たちが構想していた星間遠征計画の重要なピースでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "あの塔の内部には、何億というホバーマシンが搭載されています。最初に電子雲層を突破したエーギルの都市が、それを星の海へとまく予定だったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "そうなれば、ホバーマシンは自己増殖と自己修復を繰り返して、光り輝く航路網を形成します。この航路網を通じて、我らの艦隊は星間単位の自由な移動を実現していたことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "しかし、シーボーンによる危機が起こったことで、エーギルの星空への探究は停滞に陥り、十数の都市が共同で維持していた生物エネルギー供給システムも切り離さざるを得なくなりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "ホバーマシンは一般的なエネルギーでは動かないものでしたから、専用のエネルギーシステムを失ったことで、そのすべてが塔の中で「死んで」しまったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "ですがそれでも、技術アカデミーの人々による改造の結果、この塔は今も別の方法で我々の道を照らしてくれています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "ミリアリウムは本つ域を離れて以来、シーボーンの巣穴にビーコンを投下し続けてきました。その結果、膨大なデータがこの塔の中央制御室に集められています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "正確な位置を特定することで、第Ⅳ級兵器を用いて目標海域の主たる巣穴を滅ぼし、そこに巣食うシーボーンの群れを駆逐して……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "本つ域へと直接繋がる澄んだ海域を――その主力が進軍するに足る航路を切り開くのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "シーボーンはいずれ再び押し寄せるかもしれません。ですが、しばらくの間は奴らがもたらした養分もただ腐るばかりとなり、巣穴を再建せんとする試みは徒労に終わるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "あなたは今、我々に「航路計画」の中核を担う原理について共有してくださっているのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "ええ、そうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "昨日の戦いにおいて、アビサルハンターに救い出せたのは二十六名のみでした……シーボーンは明らかに、準備を整えてきたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "海の奥地から大陸棚に至るまで、この都市は長らくシーボーンと戦い続けてきましたので、奴らの第Ⅲ級兵器に対する適応も加速しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "しかしながら、第37号営巣地は航路の要衝にあり……放置すれば計画が失敗することは間違いありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "これは、航路開通前最後の一戦となります。アビサルハンターも含めて、全戦力を盛り込むほかないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "……たとえ彼女たちが帰郷したばかりであっても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "エーギルは、狩人たちを無事に帰還させることを保障できるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "今は新たな部隊を編成し、準備を進めている段階です。彼らがシーボーンと正面から刃を交えることで、狩人たちが巣穴へ忍び込み、ビーコンを投下できるだけのチャンスを作ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "けれども、ご存知の通りこれはあくまで通常の戦術配置にすぎません。万全の態勢だとは……言えないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "であれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたの懸念は理解していてよ……安心なさいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "狩人の身は、狩人自身の手で守るわ。同様に、私たちを運用するうえでのリスクは私たち自身が管理しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "総戦略設計士両名の決定とあれば反対はしない。だが、意見は保留させていただこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "グレイディーア……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "場違いにも、感情的な言葉がクレメンティアの喉までせり上がってくる。\n彼女は自分の罪悪感を、後悔を、謝意を示したいと思った。\nそして、彼女の帰還を出迎えた時のように、グレイディーアを抱きしめたいと思っていた。\nそれでも、彼女にはできなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "……グレイディーア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレメンティア",
      "text": "ブランドゥス顧問が、あなたたちの身体の再生手術を行います。準備はできていますので、出発の用意をしてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "アイリーニさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "ジョディ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "今日は一日中お見掛けしませんでしたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "海巡隊と一緒に、調査に当たっていたの……海にも向かったんだけど、いい経験ではなかったわ。あまり詳しいことは聞かないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "そっちは、何をして過ごしていたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "まだ慣れないのは当然だと思うわよ。元気を出して。ここはあなたの故郷なんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "その様子だと、ブレオガンの資料はもう調べたの？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "若きエーギルは一度頷き、それから首を横に振った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "断言はできないんですが、多分僕は、あの偉大な造船技師とは無関係な人間なんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "それがどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ティアゴおじさんは僕に、グランファーロを、そしてイベリアを去ることを望んでいましたが、どこに行くべきかまでは教えてくれませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "僕はエーギル人ですから、エーギルには僕の居場所があるはずだと思うんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "でも、人は自分のルーツをたどるために、確かな繋がりを必要とするものですよね。たとえそれがたった一つの名前や、一冊のノートであったとしても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "アウィトゥスさんが言うには、エーギルはシーボーンの危機に二百年以上も悩まされていながら、今なおミリアリウムと同じ規模の都市を百以上も有しているそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "そう思うと、僕がブレオガンの子孫ではないのなら、僕の祖父母は「島民」になる前、どの都市に住んでいたのかなって。あるいは、もう消えてしまった都市に住んでいたのかもしれませんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "二人はどんな仕事をして、どんなふうに暮らしていて……一体どんな人だったんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ごめんなさい、こんな話あなたにするべきじゃないですよね。一緒にエーギルへ来たのに、アイリーニさんはもう海巡隊の捜査まで手伝ってますし、それなのに僕ときたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "あなたは、本当に強い人ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "私だって、ここでは無力なイベリア人よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "ケルシー先生はこの都市の指導者と交渉をしているし、狩人たちは慣れ親しんだ戦いの中に戻っていったけど、私の灯りとハンドキャノンは、今のところ何の役にも立ってないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "エーギルは、一人のリーベリが船や港を見学することまでは許しても、彼らの軍団に加わってシーボーンと直接戦うようなことはさせてくれない。実際、私にはああいう形の戦争は理解できないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "この深海で私にできる唯一のことは、都市内で起きている異常を調べて、イベリアとエーギルの協力関係のためにできるだけ潜在的な危険を排除することなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "どうして、そんな話をしてくださるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "私の故郷は天災で滅んだの。今はもう、そこで暮らした記憶はほとんど残ってないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "私が見につけている経典は、今や私と故郷を繋ぐ唯一のものなの。この経典が私の命を救い、指針となり、私の信仰を築いてくれたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "でも、裁判所の地下牢を目の当たりにして、「狂人号」にも乗り込んで、師匠の犠牲を経たことで……私はようやく、信仰の何たるかを知り、その耐え難い部分を受け入れて、意義を見出すに至った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "それはつまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "私は、あなたが思うほど強い人間じゃないってことよ。あなたと同じように戸惑い、迷うことだって少なくないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "でも、多くの場合、その手のことは早急に解決すべき問題として目の前に現れるものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "害をなす深海教徒を捕まえるとか、潮に侵された灯台を奪還するとか、失われたはずの船を見つけ出すとか、失踪したデータエンジニアの調査を手伝うとかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "とにかく、故郷も信仰も、あなたが言う「繋がり」の一つなのよ。探し続けていれば、あなたにならきっと見つけ出せるわ。その過程はすぐには進展しないでしょうし、痛みを伴うこともあるけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "僕に、できるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "できない理由なんてある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "あなたはイベリアが最後の灯台に火を灯す助けとなった人で、三人の狩人たちを救ったことすらあるのよ。執政官直々に表彰されてもいいくらいだって、ローレンティーナさんも言ってたでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "text": "エーギル人としてであれ、裁判所の書記官としてであれ、あなたにはできることがたくさんあるのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "指揮官さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "もう戻ってたのね……その表情を見るに、調査は上手くいかなかったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "ルシーラ殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "申し訳ありません。今からクレメンティア執政官に事件の進捗をご報告しに行くところでして、具体的な状況をお伝えすることはできないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "そうじゃなくて、実はわたし、あなたに用事があって来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "この前、わたしたちのところに聞き取りに来てくれた時に思い出すべきだったわ。些細なことだし、もしかすると何の役にも立たないかもしれないことなんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "でも、どうしても気になっちゃって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……お伺いしましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "トゥリアさん、あなた以外の研究員はもう行っちゃったわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "ごご、ごめんなさい！　もう少しだけ時間をくれませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "古代毬藻と、団窓藻、それに石花膜と紫苔、千灯英……あと少しで数の確認が終わるので！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "別に急がなくていいのよ。わたしは見回りに来ただけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "私のこと、ご存知なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "ええ。わたしたち、同じ時期に展望研究所の転職評価を受けていたから。あなたは気付いてなかったかもしれないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "それで、この海藻を全部持っていくつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "な、何かの規則に違反してはいないですよね……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "大丈夫よ。この建物の引き渡し業務は完了しているし……残った海藻や培養設備は、あなたが持って行かなかったら廃棄されちゃうだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "そうですか、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "でも、こんなにたくさんあると、全部持っていくのは無理そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "ミリアリウムはこの先、陸に近付くために改造を行うわけだし、海藻を育てるスペースもリソースもなくなってしまうんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "はい、それはわかっているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "でも、できるだけ持って行って……皆さんにご迷惑をかけずに面倒を見る方法を考えたいと思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "だけど、火山の所にあった基地はもう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "エーギル最大の絶滅危惧植物の繁殖基地ですよね。私もあれがシーボーンに飲み込まれていくのを見ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "……こういう原始藻類は、海で一番単純だけど、一番強い生き物なんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "明るく浅い海でも、光の届かない深海でも、滑らかな海底でも、崖の隙間でも、一生懸命身体を伸ばして頑張っているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "藻類は海と同等の歴史を持つ、この星の生きた化石です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "私は軍人ではないので、シーボーンを倒すことはできませんし、残された海藻たちにはシーボーンの問題を解決する力なんてありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "だけど、この子たちがこのまま枯れていくのを黙って見てはいられないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "……あなたはこの仕事が大好きなのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "えっと、あなたは違うんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "あっ、リトル・ハンディが積載用のモジュールを持ってきてくれたので、そろそろ失礼しますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "手伝いましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トゥリア",
      "text": "大丈夫です、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "それはいつ頃の話ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "生態芸術創作所が移転する前日のことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "彼女に何があったのかはわからないし、トゥリアからすれば、ミリアリウムがあの火山エネルギーステーションと繁殖基地を放棄したように映った可能性はあるかもしれないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "でも、私にはあの子がそんな理由で悪いことをするとは思えないの……だって、トゥリアは諦めたりなんてしない人だったから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "彼女の自宅には確かに海藻プランターがまとめて置かれていましたが、すでに空になってから長い時間が経過していたようでした……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "お話しいただきありがとうございます。今の情報は、あるいは有用かもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "ただ、失礼ながら伺いたいのですが、貴殿がトゥリア氏の件にこれほど関心を寄せるのはなぜですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "以前のお話では、友人と呼べるほどの仲ではないということでしたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "あの子には……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "あの子には、わたしにはない何かがあったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "さてと、伝えるべきことは伝えたし、そろそろ仕事に戻らないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルシーラ",
      "text": "最近は色々あったから、都市ユニットのフレームの修復量が何倍にも膨れ上がって、インクが足りないくらいなのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "リトル・ハンディ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リトル・ハンディ」",
      "text": "はい、セクンダ指揮官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "設備管理所からミリアリウムの都市情報を取得して、閉鎖された場所の中から海藻栽培に適した所を探してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "それと、アイリーニ殿に連絡を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "すぐに合流しようと伝えるんだ。トゥリア氏は都市内に手がかりをまだ残しているかもしれないからな。",
