{
  "server": "jp",
  "storyId": "story_mostma_set_2_story_1",
  "groupId": "story_mostma_set_2",
  "stageId": null,
  "title": "旅の脚注",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_mostma_2_1.txt",
  "sourceHash": "adb864dad6a50c68ba7931d87ed9cb5b19487eced0c4693045c4e63ec1e30eda",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "五年前のあの天災によって、我々のディープルート町は一瞬にしてめちゃくちゃにされてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "だが、聖都の使者が手を差し伸べてくれたおかげで、我々はこの新たな地でもう一度生活を立て直す機会を得られたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "今や新しいディープルート町は、かつての姿を取り戻しつつある。これでようやく、この町の伝統芸術である彫刻の復興に取り掛かれるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "かつて、町の中央広場には最も腕の立つ職人の作品が常に飾られていたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "私はそうした伝統を復活させたいんだ。そのためにも、今のディープルート町にいる最高の職人に、天災の犠牲になってしまった町の皆を弔うための彫像を作ってもらいたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "スーザン、町一番の職人だったお前さんの父が天災で亡くなってから、お前さんが必死に腕を磨いてきたことは町の皆が知っている。どうだ、引き受けてくれんかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "でも――父さんならうまくできると思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "あたしにそんな自信なんて……自分がそのレベルに達してるかどうかもよくわからないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "亡くなってしまった町民たちを弔うなんて、あたしには荷が重すぎるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "ああ、お前さんにとっては厳しい挑戦になるだろう。だが、この町にはもう他の彫刻職人は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "スーザンが迷っているのなら、私に任せてもらえないでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "メリッサ！？　お、お前さん、ラテラーノから戻って来たのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "町長からのお手紙に、町に新しい彫刻を作るのだと書いてあったので。それを読んで、すぐにラテラーノを発ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "確かに五年前、私は使者と共に聖都へと戻りました。ですが、私の心はずっとディープルート町と共にあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "そうか、そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "それで、彫刻の制作を任せてほしいと言っていたな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "はい、ラテラーノへ戻ったあと、すぐに彫刻について学び始めたのです。いつか、もう一度この町の役に立てる日が来るようにと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "メリッサ、それほど私たちのことを想っていたとは……なら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "町が天災にめちゃくちゃにされる前、広場に飾ってあったのは、うちの父さんの傑作だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "あの彫像は……特別だってみんな言ってた。彫像の近くに行くと、この町の独特な香りがするって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "だから……父さんの作品を再現することが、何より弔いなんじゃないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "でも、あなたにその香りまで再現できるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "そ、それはわからないけど……あたし、やってみたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "いい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "町のみんなは、あなたがその「特別」な伝統を取り戻すまで、ずっと待っていられるわけじゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "「存続」させること自体が大事な場合だってあるのよ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "……それは、わかってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "（小声）父さんがいつも行ってたあの場所……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "（小声）ちょっと危ないけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "おい、スーザン、どこに行くんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "あっちは確か……はあ、言いすぎちゃったのかしら。今すぐ連れ戻しに――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "スーザンのほうは私に任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "あなたは――モスティマさん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "モスティマ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "町長、メリッサ、久しぶり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "アンドアイン隊長や他のみんなは元気かね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……ハハ、まあまあかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "モスティマ、あなた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "おしゃべりはまた後でね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "こんちはー、メリッサさんはいますかー？　あっ、たぶんキミだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "えぇと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "彫刻の材料をお届けに上がりましたー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "そうだ、ついでに聞きたいんだけど、モスティマっていうサンクタを見なかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "（小声）モスティマ……あなた、もしかしてわざとこのタイミングを狙って現れたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "へ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "それで、モスティマはどっちに行ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "山のほうへ向かって行ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "すぐには戻らないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "そっか……なら仕方ないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "じゃあ、あたしになんか手伝えることはあるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "あなたに関係ないのに、そうあっさりに引き受けちゃっていいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "んー、あたし、ずっとモスティマを探してるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "それで、新しい場所に辿り着く度に、絶対にモスティマ探しと同じくらいおもしろいことに遭遇できるんだ。だからなんでも積極的にやってみることにしてるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "どう考えても誰かさんが仕組んでるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "どうだろうね。でもモスティマは昔からそんな感じだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "小さい時、爆破に誘っても絶対についてきてくれなくてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "でも、モスティマが遠くで見守ってくれてる姿を、何回も見かけたことがあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "キミは？　何がきっかけでモスティマと知り合ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "五年前、当時住んでたディープルート町が天災によって壊滅状態になったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "生き残ったサンクタは、私と父だけだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "父の救援要請を受け、聖都は私たちを迎えに小隊を町まで派遣してくれたんだけど、その中にモスティマもいたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "（つまり、姉ちゃんが前にいた小隊が派遣されたってことか……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "でも、その小隊の隊長だったアンドアインは、そのまま私たちを連れ戻そうとはしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "彼は隊員たちと一緒に、生き残ったサンクタ以外の町民を、ここまで連れてきてくれたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "しかも、町民のために聖都に物資まで申請してくれたわ――あとから聞いた話だけど、小隊全員で給料を一年分前借りして、物資の費用にあてがったそうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そろそろエルがメリッサと作業を始めてる頃かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "メリッサの昔話なら、少しはあの子の好奇心を満たしてくれるだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あ、スーザン、見つけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "父さんはよくここに来てたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "ここからね、ディープルート町を一望できたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "だから、父さんはふさぎ込んでしまった時は、いつもここに来て町をじっと眺めてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "「心に刻み込まれる」というのは、ただ情報として頭の中にしまっておくだけじゃなくて、彫像に触れた時に懐かしい香りを感じることなんだって、父さんはいつも言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "でも――ねえ父さん、今のあたしに見えるのは、ガレキの山だけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あの彫像、まだ完全に壊れてはなさそうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ちょっと行ってくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "おおー、ずいぶんとでっかい石だねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "彫刻一体にこんなデカい石を使う――わけないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "もちろん。実は最初から決めてたの。彫像を何体か組み合わせて一つの作品にして、亡くなった人たちを弔おうって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ラテラーノで似たような作品を見たことあるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "あぁー、広場にあるやつとかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ええ、ああいう感じの彫像を作ろうと思っているわ。そして、上には犠牲者の名前を全部刻み付ける予定よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "教会の壁画みたいな感じ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "理解が早くて助かるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "えへへ。そういえば、さっき彫刻を学び始めたのは、ラテラーノに戻ってからって言ってたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ええ、かつてのディープルート町は彫刻で有名だったけど、町民全員が興味あったわけじゃないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "私も興味がなかったうちの一人よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "実はね、ラテラーノでの生活にはあまり馴染めていないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ディープルートでの生活に慣れすぎたせいかしら。ラテラーノの陽気すぎる雰囲気をあまり受け付けられないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "あぁー、わかるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "あたしも外に出てみたらさ、どこもかしこもラテラーノと全然違っててびっくりしちゃった。この二年間、モスティマを追ってあちこち見て回って気づいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "あのね、あたしの今の夢のひとつが、どっか新しい都市で生活をしてみることなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "てっきり、あなたも単純思考の楽天家かと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "とにかく、私が彫刻に興味を持ったのはラテラーノへ戻ってからなの。それで、本格的に勉強することにしたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "いつかこの町に帰るんだって、決めてたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "でもさー、ラテラーノの彫刻とここの彫刻って、違うよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "本格的に彫刻について学び始めてから、後悔しなかった日は一日もないわ――なんでディープルート町にいた頃に、彫刻を始めなかったのかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "だけど、今さら後悔しても仕方ない。私はラテラーノの技術でここの伝統を存続させるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "誰かがもっといい方法を見つけ出さない限りね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "えっ、もしかして、本当はスーザンに引き受けてほしかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "……まさか。せっかくこの五年間の苦労を形にできるチャンスを得たのに、みすみす逃すはずないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "その一番大きい石をここに置いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "おっけー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ほかに手伝ってもらえることといったら……そうね、まずは石を私の言った大きさに切り分けてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "まあ、ラテラーノのやり方じゃあ、切り分けるのではなく――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "爆破する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "はあ、そう言うと思った。粉々にしなければなんでもいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "まっかせて！　あたしは爆破の達人なんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "かつて道路だった場所は、歳月によってすっかり風化し、酷くぬかるんでいた。レンガやタイルが至る所に散乱しており、どこもかしこも天災の痕跡だらけだった。\nこのような危険な場所は、経験豊富なトランスポーターであっても慎重に迂回することを選ぶだろう。しかし、モスティマはフードを深く被り直すと、躊躇うことなく中へと踏み込んでいった。\nたったの二年で、彼女はこのような環境にすっかり慣れてしまったのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "五年前の自分であれば、こんなふうにお節介を焼くことはなかっただろう。いや、そもそも、ここにやって来ようとすらしなかったはずだ。\nだがこの二年間、レガトゥスとして、数多の見知らぬ土地に足を踏み入れ、今まで知らなかったたくさんのことを見聞きしてきた。\nこのガレキの山に踏み込んだ時には、モスティマはもう香りの正体についてあらかた見当が付いていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "香りの正体は実に単純だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "やっぱり君もそう思うでしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "モスティマは軽快な足取りで、廃墟の中心部にある彫像の前までたどり着くと、表面の破片そっとひと欠片だけ剥がし、においを確かめた。\n続いて、彼女はしゃがみ込み、土を手に取ると、また同じように鼻に近付けてにおいを確かめる。\n思った通りだ。\n「町の香り」の正体は実に単純――\nこの場所の土と彫刻用の石材のにおいが混ざり合い生まれる香り、ただそれだけである。\n町民たちが香りに親しみを覚える理由も至ってシンプルだ。土からはこの地に生育している植物の爽やかな香りが、石材からは鉱物特有のにおいが漂っている。\nどちらも町民たちが嗅ぎ慣れているにおいであり、その二つが混ざり合うことによって、この地で暮らす人々の懐かしさを呼び起こす香りが完成するというわけである。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "正直、そんないい香りじゃないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "でも……一緒にたくさんの場所を回ったけど、確かにこれは特徴的な香りだ。君もそう思わない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "よぉーし、爆薬設置完了っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "あたしの寸分の狂いもない計算によれば、確実に満足してもらえる爆破になるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "……見かけによらず手際がいいのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "へへ、さっきも言ったでしょ、あたしは爆破の達人だって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "それじゃあ、いっくよー！　ポチッとな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "レミュエルの計算は、確かに寸分の狂いもなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "爆発音が鳴り響き、それと共に巨大な石が適当な大きさに割れる。\nただ、問題点がひとつだけあった。それは――レミュエルが、石材の性質を把握していなかったこと。"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "あ、このタイプの石材は、爆破させると粉が大量に舞うのを伝え忘れてた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "目も開けていられないほどの大量の粉塵が、レミュエルを呑み込んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "うわわっ、何も見えないや！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "え、どういう状況……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "モス――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "しーっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "ねえ、目に粉が入っちゃった！　メリッサ、手ぇ貸してよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "あっ、危ない！　そっちには溝が――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "へ？　うわあああー！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "足を踏み外した感覚。一瞬にして体がバランスを崩し、レミュエルは溝の中に転げ落ちる――\n次の瞬間、誰かに腕を掴まれ、引き戻された。"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "メリッサ、ありがと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "エル、もっとちゃんと周りをよく見ないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "え、モスティマ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "よく知っているその声に、レミュエルは慌てて目を擦ると、無理やりまぶたを開いた。\nしかし、目の前には誰もいなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "ゴホゴホッ、ペッペッ、モスティマ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "メリッサ、モスティマを見なかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "あれ？　メリッサもいなくなってる！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュエル",
      "text": "どうなってんのさー！？！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "この香り……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "ああ間違いない、これは……おぉ……うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "かつてのディープルート町の香りだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "……ええ、間違いないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "こんなにシンプルな原理だったなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "シンプルなもののほうが、逆に記憶に残りやすいからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "……見つけてきてくれてありがとう、モスティマ、スーザン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "……お礼を言うのはあたしのほうだよ、メリッサ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "あなたのおかげで、あたしは前に踏み出せたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "……フン、喜ぶにはまだ早いわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "もう作り方を教えてもらったんだから、私だってその香りを自分の彫刻で簡単に再現できるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "なかなかに卑怯だね、メリッサ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "スーザン、香りの正体を突き止めたからって、みんなが自分を選んでくれると思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "そんなことないよ！　みんなに選ばれるような最高の彫像を作ってみせるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な町長",
      "text": "モスティマさん、あなたにどう感謝すれば良いのか……香りだけでなく、この町に活力まで取り戻してくれるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いやいや、褒めすぎだよ。別に大したことはしてないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "でも、ずっと気になってたんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "五年前のあなたは、最初から最後まで黙ってアンドアイン隊長の後ろに立っていただけだったじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "どういう風の吹き回しで、突然ここに現れてあれこれ助けてくれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "現場に駆け付けたモスティマが見たのは、狂気に満ちたアンドアインと重傷を負ったレミュアンだった。\n困惑と狂騒、解放と許容――一瞬にして、様々な感情が流れ込んできた。\nそれらは彼女の心に疑惑を生ませたが、体は自然と動いた。\nアンドアインを止めるために、モスティマは守護銃を使って、彼の手にあった錠と鍵を撃ち落とすしかなかった。それを奪うと、彼女はすぐにレミュアンを連れてその場を離れた。\nそして、フィアメッタと共にラテラーノへと引き返したのだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "錠と鍵はすぐに回収され、モスティマ自身も禁足を命じられた。\n堕天したことを、彼女が後悔したことは一度もない。それよりも気になって仕方がないのは、アンドアインが錠と鍵の中に何を見たのか、それだけだった。\nそこで、彼女は大胆な行動に出た――教皇庁への侵入である。\nこの機会を逃してしまえば、今後二度と秘密を明らかにできるチャンスはやって来ないからだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "教皇庁へ侵入するのは容易いことではない。だが、それでも彼女は成功した。\n今思えば、すべてはあの白い髭の爺さんが仕組んでいたのだろう。でなければ、錠と鍵を自分に預けるはずがない。\nとにもかくにも、彼女はもう一度錠と鍵を目にすることができた。\nアンドアインから奪い取った時、二本のアーツユニットは始終沈黙を貫いていた。\nだが今回、モスティマが問いかけを持ってそれらに触れた時、気がつくと彼女は幻の中にいた。\nそこで、彼女は見たのだ――\n過去の隙間を。未来の断面を。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "正直なところ、アンドアインが何を見たのかは、あらかた予想がついていた。\nそして、幻の中であのような光景を見た時、なぜアンドアインが狂気に吞み込まれてしまったのかも、一瞬にして理解できた。\n何しろ、アンドアインは常に未来に不安を抱えており、どんな些細な悲劇にも歯がゆさを覚え、ため息をつくような人なのだから。\nフィアメッタがアンドアインに対して、あそこまで激しい怒りを向けているのも、過去の彼を認めていたからこそと言ってもいいだろう。\nフィアメッタは正義感が強い。何に対しても他人事のような態度を取る自分よりも、この乱れた大地を悲しみ、人々に哀れみの心を向けるアンドアインのほうが評価が高いのは当然だ。\nしかしモスティマは、なぜアンドアインが狂気に陥ったのかにはあまりこだわらなかった。その理由は、あの瞬間に二人から伝わってきた感情だけに起因するものではない。\n最初――アンドアインの小隊に配属された時、あるいはアンドアインを初めて見た瞬間――から、なんとなく予感がしていたのだ。\nアンドアインと自分は、それぞれ真逆の方を向いているのだと。そして、遅かれ早かれ袂を分かつことになるのだろうと。\nあの時のように、目の前にある無数の欠片は、それぞれが一つの答えを示しているのかもしれない。そのすべてを確かめれば、究極の問いの答えも自ずと浮かび上がってくるのだろう。\nアンドアインならば、それらの欠片を確かめるために、迷わずきらめく漆黒の沼に足を踏み入れたはずだ。\nだが、モスティマは――引き返すことを選んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "五年前、天災でめちゃくちゃになったディープルート町を見た時に、私が思ってたことを教えてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "うわあ、ひどい光景だ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それ以上の感想は浮かんでこなかったし、誰かさんがあそこまで必死になってた理由も理解できなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "でも今は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ためらいがちな女性",
      "text": "その角……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "あなた、堕天したの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "この二年間、レガトゥスとして色んな場所に行って、ようやく結論が出たんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ああ、友よ、サンクタってなんて可愛らしいろくでなし集団なんだろうってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "今の私はただ、自分もろくでなしの一員だって気付いてから……この大地との付き合い方をもう一度学び直してるだけなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そうだ、エルに伝言をお願い。新しい任務が来たから、次は龍門にしばらく滞在するって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "半年前、旅の途中でエンペラーって人と知り合ったんだけど、彼もちょうど龍門にいるらしいから、会いに行ってみてもいいかもね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "山道を登っている途中で、モスティマは振り返った。\nここからは、ディープルート町の広場全体がぼんやりと見える。\n広場では、スーザンとメリッサがぞれぞれの彫刻の制作に取り掛かろうとしていた。二人の姿に引き寄せられるようにして、どんどん人が集まってきている。\nその中でも、赤髪のサンクタはひと際目立っていた。彼女はスーザンを手伝ったり、メリッサを手伝ったりと、両者の間を行ったり来たりしている。当初の目的などすっかり忘れてしまったようだ。\nモスティマは珍しくフードを被ろうとしなかった。そよ風が彼女の頬を撫で、髪を揺らす。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
