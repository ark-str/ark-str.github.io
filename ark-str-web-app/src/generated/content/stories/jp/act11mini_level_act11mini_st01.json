{
  "server": "jp",
  "storyId": "act11mini_level_act11mini_st01",
  "groupId": "act11mini",
  "stageId": null,
  "title": "ブラウンテイル",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act11mini/level_act11mini_st01.txt",
  "sourceHash": "493049528f0cfa31f8254b7e83cbcf3be510eb4a03b9c56fa89aec23ff23cb03",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ウース、準備は済んだのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ヴィクトリアはイェラグとは違う。提携を持ちかける側である以上こちらのほうが立場は弱くなるし、そこにつけ込まれてもおかしくないと思え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "とはいえ、私にも向こうの具体的な行動までは予測できないから、助言くらいしかしてやれない。ちゃんと自分で判断するんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "はいはい、よ～くわかりました！　もう、耳にたこができそうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "っていうか、そんなにあたしが信じられないならどうして自分で行かないわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "その錆びた脳ミソで考えてみな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あんたねえ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "さて、お前と喧嘩してる暇なんざないし、言っておこう。これを単なる旅行と思うなよ。お前が背負ってるのはブラウンテイル家だということを忘れないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ユカタン、お前もきちんと奥さんの面倒を見るんだよ。外で馬鹿な真似をして家の名に泥を塗ることがないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "はは……わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ちょっとユカタン、あなたどっちの味方なのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "こら、話が逸れるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "とにかく、今回はすべてにもっと気を配っておくことだ。周りをよく見て、話をよく聞いて、口数は減らせ。前みたく考えなしにお喋りして余計なことを口走るんじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "お前にも、外へ出て見聞を広めるべき時が来たんだ。イェラグの外の大地は、ヴィクトリアという国は、一体どんなところなのか……その目できちんと確かめてきな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ふん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ねえ、ラタトス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あんた、本当は自分が行きたいんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ウース、こっち来な。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "何？\n……あ、もう！　何のつもりよクソ女！　手をどけなさい、熱なんてないってば！"
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "だったら、今の寝言は何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "き、聞いてみたかっただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "もし、こういう機会があったら……あの当時のあんたは、ヴィクトリアに行ってみたかったのかなって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "ああ、お二人ともこちらにいらしたのですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "先ほどはお客様がたくさんいらしていたもので、なかなか抜け出せず……至らぬところをお見せして申し訳ありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "お気になさらず、ハリスンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "本日はお招きいただきありがとうございます。お陰様で素晴らしい時間を過ごしております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "おお、なんとご寛大な！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "ですが、遠路はるばるご足労いただいたのですから、精一杯おもてなしするのは当然というもの。そうそう、お酒や料理は自由にご堪能ください。何かありましたら近くのウェイターにお申し付けを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "お心遣い、痛み入ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "いえいえ。……と、よろしければ、こちらの食器の使い方についてご案内しましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……いえ、お気持ちだけいただきますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "それより、ブラウンテイル家と貴社の業務提携の件についてお話したいのですけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "おっと……なんとも率直でいらっしゃいますね、夫人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "しかし、提携の件はすでに一定の合意に達したものと思っていたのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ただ、細かい部分に関して、もう少し具体的に確認させていただけたらと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "ええ、もちろんですとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "秘書に正式な契約書を用意させましたので、お時間のある時にでもご覧いただけましたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "その契約書でしたら、読ませていただきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "おやおや……そうでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ですが失礼ながら、当家として承諾しかねる内容が含まれておりましたもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "夫人が仰っているのはどの部分でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "人材提供と利益の分配関係ですね。具体的な数字をもう少し見直す必要があるように思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "なるほど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "検討させていただきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "でしたら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "しかし、スキウース夫人。そちら様にもぜひ、もう一度ご検討いただきたく思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "この件の金額面においては、相当便宜を図らせていただいたつもりですしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ですが……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "我々はウィンウィンの関係ですから、どうかご安心を。私個人としてもイェラクには非常に好感を持っておりますし、この契約であなたのご一家に損をさせるようなことはいたしませんとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "僭越ながら、ハリスンさん。「イェラク」ではなく、「イェラグ」です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "え？　……あっ、ああ、大変失礼いたしました。いやはやお恥ずかしい。その発音がどうも苦手でしてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "そうでしたか。イェラグにいらしたことはおありですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "それは……まだありませんが、ここ数年お噂は色々と耳にしておりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "イェラクの宴席では肉獣を丸ごと一頭焼いて振る舞うそうですね。お酒は人の背丈ほどもある瓶で出される上に、余興として曲芸まで見られるとか。機会があればぜひ一度拝見してみたいものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……ご冗談を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "それでは、ほかのお客様のところにもご挨拶に伺わねばなりませんので、この辺りで失礼いたします。お二人も、今宵の晩餐をゆっくりとご堪能くださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ま、待ってください……！　話はまだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "そちらはまた次の機会にでも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "富裕層の女性",
      "text": "ハリスンさん、あちらのお二人はどなた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "イェラクからのお客様ですよ。現地では名のあるお家柄だとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "富裕層の女性",
      "text": "まあ、聞いたことのない場所ですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "辺鄙な山間の土地ですからね。あなたのお耳に入れるほどの場所ではないのですよ、レディー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "行くわよ、ユカタン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ウース……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ふー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "すー……ふー…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ウース。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ここなら、僕ら以外誰もいないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "すーっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ああ～～もお～～イライラする～～！！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ムカつく\nムカつく\nムカつく！！"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "何なのよ、あのふざけた態度に上から目線！　一体何様のつもりなわけ！？　あれでどんだけあたしたちを――イェラグのことを見下してるか、見抜けないとでも思ってんの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "な～にが食器の使い方についてご案内しましょうか、よ！　宴会で曲芸がどうとかの話もバッカじゃないの！？　あいつ、イェラグの名前すら覚えてないし、ビジネスじゃなきゃ一発殴ってるわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ほんっとにムカつく！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ほら、水だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "いらない。ムカムカしすぎて飲む気になんないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "少しでいいから飲んでくれ。また夜中に胃が痛くなるのは嫌だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あなたがさすってくれればいいでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "はいはい、仰せのままに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "それにしても、よく我慢したな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ふん、ほかにどうしろって言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あそこで怒ったら、あとでラタトスの奴にこっぴどく叱られちゃうでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……本当に、よく辛抱したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "それで、このあとはどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "パーティー会場へ戻るか、それとも今日はもう休むか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "当然、戻るわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ちょっとムカつくこと言われたくらいで、契約の話も終わってないのに引き下がれるわけないじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……本当に大丈夫なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "決まってるでしょ、大丈夫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ラタトスに言われなくたって、今回のヴィクトリアとの提携が、ブラウンテイル家にとって対外接触の第一歩だってことくらいわかってるわ。ヘマなんてできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ううん、ヘマをしないだけじゃなくて、なるべく利益を得られるように立ち回らないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そのためなら、我慢くらいしてみせるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ユカタン、あなたもこの数日で見てきたでしょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "この国で使われてる、見たことないほど大きな機械。重そうな見た目なのに、驚くほどスムーズに動いてたわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "市内の道だって綺麗に整備されてるし、そこら中に駅が建ってるし……ショーウィンドウに並ぶ商品はどれも目を惹くものばかりだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "今夜のパーティーも、照明にはろうそくなんて使わず、電灯を使ってて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "どれも、イェラグにはない光景だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "だけど、本当はあたしたちも持っているべきものだと思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "たかが列車、たかが綺麗な街、たかが色とりどりのお店でしょ！　全部作ればいいだけの話よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あたしたちの子供には、生まれた時からそういうものに馴染めるようにしてあげないと。それで大きくなったら留学でも観光でも、行きたいところへ行けるようにしておくのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "――今、子供って……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ち、違うの、そういう意味じゃないから！　へ、変なこと考えないでよね！　あたしはただ、イェラグの未来の子供たちについて話してるだけで……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "わかったから落ち着け、ウース。変なことなんて考えてないし、考えたことも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "何ですって？　じゃああなた、子供がほしいとか思ったこともないわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "そりゃあるけど……いや、そういう意味じゃなくて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……こほんっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "とにかく、未来のためにもっと頑張らなきゃいけないってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……もしかして、あのいけ好かないエンシオディスも同じことを考えてたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ああいう複雑で回りくどいやり方のことはよくわからないけど、あいつの提案で建てた工場や鉄道は……実際、イェラグを大きく変えたわけだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ウース、お前……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "何笑ってんのよ……\nって、ちょっと、どうして頭を撫でるの！？　髪が乱れるじゃない！"
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "まあまあ、動かないで。今整えてやるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "まったくもう……ここは外なのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ふふ……ごめん、つい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "何はともあれ、お前の言う通りだ。あの光景のどれもが、僕らも持つべきものだと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "きっと手に入れられるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "当然でしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "だけど、まさかお前があのエンシオディスを褒めるなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ふん！　バカなこと言わないでよ。あたしがシルバーアッシュ家の奴を褒めるわけないじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あたしはただ、本当のことを言ったまでよ。……エンシオディスのことは気に食わないけど、あいつがこの光景をずっと見てきたのなら、ああいうことをしたのも多少は理解できると思っただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "だから、あいつにもちょっとは実力があるって認めてやることにしたの。あたしだってそれくらいの度量はあるんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "確かに、エンシオディスは有能だしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "それに、エンシオディスなんかよりもっと気に食わないのは、その側近のノーシスよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あのクソ野郎が裏切るフリしてあたしたちをハメたりなんかしなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "当時の状況を考えれば、悪くない選択だったと思うよ。それに、誰もが自分のやり方で事に当たっていたんだし、彼を責めることなんてできないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "どうでもいいわよそんなこと！　あなた、まさかあいつの肩を持つつもりなの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "そうじゃなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "………………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……わかったよ。僕が悪かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "でも、あれから随分時間が経ったし、今後もシルバーアッシュ家と付き合いを続ける以上、どのみち顔を合わせることになるんだぞ……それなのに、いつまで恨んでるつもりなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "もちろん、来世までよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ラタトスのやってることを台無しにするつもりはないけど、それとこれとは話が別！　あいつらがやったことを忘れたりなんかしないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "お義姉様はもう気にしてないみたいだけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そんなわけないでしょ！　ラタトスって女は、表向き気にしてないように見えても、あたしよりずっと根に持つタイプなんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "子供の頃、あいつを誘わず二人でこっそり遊びに行った時のこと、忘れちゃったの？　帰ってきたらすぐおじい様に捕まって、罰として一週間本の書き写しをさせられたじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あれ絶対、誘われなかったラタトスが仕返しに言いつけたせいだと思うの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "あれは僕らが遊びに夢中になって、帰るのが遅くなったからだろ。お義姉様のせいにはできないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "も～……あなたはお姉様を信じすぎよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……けど、そういえば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ねえユカタン。お姉様って、エンシオディスのことをやたら高く評価してると思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "はっきりそうは言わないけど、なんとなくそんな感じがするのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "んー……そうかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "あの時も、エンシオディスのやり方が過激すぎるものでなければ、お義姉様はそこまで反対しなかったかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そうよね？　それじゃ……お姉様があたしをここへ来させたのは、この光景を見せたかったからなのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "出発前、「あの当時こういう機会があったら、ヴィクトリアへ行きたかったか」ってお姉様に聞いたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……あたし、本当はお姉様がどう思ってるかなんて知ってるの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ラタトス！　ラタトス～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ちょっと、ラタトス！　いるんなら返事してよね！　こんな大声で呼んでるのに、まだ聞こえないフリするつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "どうして無視すんのよ……って、あら？　何読んでるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ああ、悪い。「お姉様」と呼びかけることもできないようなおバカの相手なんかしてられなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "誰がおバカですって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "こそこそ抜け出して遊びに行って、私に庇ってもらってたお間抜けさんのことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "うっ、それは……ま、まあ、あたしが悪かったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "次は絶対連れてってあげるわ！　ね、ユカタンに見張ってもらえばいいのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "遠慮しとくよ。お前みたいに暇じゃないからね。おじい様の身体が……いや、何でもない。とにかく、今はトラブルさえ起こさないでくれたらいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "それと、ユカタンがお人好しだからって、あんまりいじめるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あたしがいついじめたって言うのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "私がいじめたって言ったらいじめてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "で？　私のことは何て呼ぶんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ラタトス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ん～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……お姉様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "よくできました、可愛い妹よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ふん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "じゃなくて……あんたまた誤魔化そうとしてるわね？　話をそらさないでよ、何を読んでたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ただの定期報告書さ。大したもんじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "おじい様はそんな仕事まであんたに引き継いでるの？　ほんと、あんたを頼りにしてるのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "可愛い妹と違って、私には実力があるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あんたねえ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……まあいいわ、口げんかはお終い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "それより、一体何が書いてあるの？　随分きちんと目を通してるみたいだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "なんてことないニュースばっかりじゃないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……「シルバーアッシュ家の長男がイェラグを離れた」、ねえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ヴィクトリアへ留学するとかなんとか言ってたけど、そんなの言い訳に決まってるわ。イェラグにいられなくなったから、ほかの場所へ逃げただけでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "……そう思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "だってみんなそう言ってるもの。この国に居られるなら、言葉も通じないような場所へ行きたがるわけないじゃない。少なくとも、あたしなら絶対に御免だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "どうしたの？　ラ……お姉様。顔色悪いわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "……やめろ、手をどけな。お前に心配されるほど落ちぶれてなんかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "何よ、このクソ女……人が親切に気遣ってあげたのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "はいはい、ご親切に感謝するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "単に少し感慨に浸ってたのさ。シルバーアッシュ家が今みたいな状況に陥っているとはいえ、躊躇いなくしがらみを捨てることができなければ、こんな決断はとても下せないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "こんな決断って？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "すべてを捨て去る決断だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "……エンシオディスは、本当にひどい男だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……そんなふうに言ってたのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "私はそれを聞いたことすらすっかり忘れてたんだけど、この前、火の中に座るお姉様とエンシオディスを見たら……不思議と急にそんなことを思い出したの。もう何年も前のことなのにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "それで思ったのよ。お姉様はあの時、あたしたちとは違うことを考えてたんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "もしかすると……ブラウンテイル家そのものが、お姉様にとっては足枷だったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……それって、当主様の件より前のことだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ええ。おじい様が亡くなる少し前の話よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あなたも知っての通り、その時すでにおじい様の容態は相当悪化してたけど、お姉様はそれをあたしたちには隠してたのよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ああ。あの頃はブラウンテイル家に目を付けている連中も多かったな……それに、お義姉様が相当お若いうちだったから、婿入り目当てで近付く人間も絶えなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そうね。当時のお姉様は忙しすぎて目の下にひどいクマを作ってたのに、あたしには気付かれてないと思ってて……その上ご機嫌斜めだから、あたしはいつも叱られてたっけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ねえ、ユカタン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あの頃のあたしって、へそ曲げてばっかりで、何かとお姉様に反抗して……ほんとバカだったと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "僕は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "やめて、いいから何も言わないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……ウース……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あたしだってわかってるのよ！　昔の自分が、何の役にも立てない上に、迷惑かけっぱなしの大間抜けだったってことくらい……！　全部わかってるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ほかの人には何を言われても仕方ないわ。でも……あなただけは、言わないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あなたに叱られたりなんかしたら、あたし……耐えられないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……僕はそんなことしない。最後まで聞いてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "お前はよくやってる。僕はお前をバカだなんて思ったことないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……よくそんな心にもないこと言えるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "えっ？　そんなふうに見えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "でも、お前をバカだなんて思ってないのは本当だよ。お義姉様だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あいつはそう思ってるわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……そうだとして、お義姉様はお前を責めたりしないだろ。お前はいつも役に立とうと頑張ってるし、お義姉様もそんなお前を信じようとしてる。それで十分じゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そのくらい、わかってるわ。だけど……ちょっと腹が立ってるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "自分にも、ラタトスにもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あたしはどうして、もっと早く気付けなかったのかって……それにどうして、あいつはあんなに強がりたがるのかなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "うーん……本当のことを言おうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "嫌な話なら言わないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "そういうわけにもいかないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "思うに、強がりはブラウンテイル家に代々受け継がれてる気質みたいなものなんだよ。そういう意味では、お前もお義姉様と似たようなものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "それで――負けず嫌いで強がりさんのスキウース夫人は、ハリスンさんを相手にどう交渉して、あの貪欲さを諫めるおつもりかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そうね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……？　何の音？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "なんとも貧相なパーティーだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "ハリスン氏は厚かましくも貴族の土地を買い上げる勇気はあるというのに、私を出迎える度胸まではないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "さて、君たち。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無愛想な男性",
      "text": "何なりとお申し付けを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "親愛なるハリスン氏に贈り物をしてきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "商人たるもの、貴族にどう接するべきか……遠慮なく教えて差し上げるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無愛想な男性",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "富裕層の女性",
      "text": "キャーッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "富裕層の女性",
      "text": "い、急いでハリスンさんを呼んできてちょうだい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）何が起きてるの？　あいつら、パーティー会場を壊し回ってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）あのヴィクトリア貴族の指示で動いてるみたいだけど、一体どういうつもりなのかしら……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "（小声）彼とハリスンさんの間に諍いがあったんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）でも、わざわざ家まで来て暴れ回るなんて、よっぽどのことよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "（小声）様子を見てこようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）いいえ、不用意に出て行くのはやめましょ。少なくとも、今はまだダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）けど、もしかするとこれはチャンスかも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "エヴァンズ子爵！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "よ、ようこそお越しくださいました！　どうして事前にご連絡をくださらなかったのですか？　てっきりまだリターニアで休暇を取っておられるものとばかり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "おやおや、ハリスン氏は私のスケジュールに随分お詳しいようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "では、私が予定より早く戻ってきて、あなたの素晴らしい計画を狂わせるとは夢にも思わなかったのでしょうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "そ、それは……な、何のことやら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "おお、どうかそんな顔をなさらずに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "あなたが躍起になって我々の協力会社の株を独占し、私が留守にしている隙を狙って裏で土地を買い叩いていた時には、それほど情けない顔はされていなかったと思いますがねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "エヴァンズ子爵……！　ここまでなさることはないでしょう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "我々の取引はまだ継続しているはずです！　利益関係の問題ならもう一度話し合うこともできるでしょうに……これがビジネスパートナーに対する態度ですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "無論、協定を忘れたわけではないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "だが、こうでもしなければ私の気が収まらんのだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）商人と貴族の間で起きた、利権争いみたいね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）ここへ来る前、ラタトスに山ほど読まされた資料にも書いてあったから、こういうことがあるとは知ってたけど……まさかこの目で見ることになるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）でも、これなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "（小声）何か考えでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）ええ。ハリスンさんとどう交渉するつもりか、さっき聞いてきたわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "（小声）いいこと思いついたの――今がチャンスよ、ユカタン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "な、何をなさるのです！　こんなこと、許されるはずが……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "ない、とでも言うおつもりかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "現実を見たまえ。私が君に手を下したところで、「可哀想なハリスン氏は子爵との決闘に破れ、不幸にも命を落とした」……そんな話が広まるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "君のような平民が死のうとも、貴族である私を裁ける者などいないのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無愛想な男性",
      "text": "（小声）……閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無愛想な男性",
      "text": "（小声）こちらの手勢が次々と何者かの襲撃を受けています。全員気を失っているだけのようですが、動ける人員はあと少ししか残っていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無愛想な男性",
      "text": "（小声）その上、招待客の誰かが警察に通報したようです。どういたしましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "助力はすでに求めておいた、というわけか。貴様もどうやらただの間抜けではなかったようだな、ハリスン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "とぼけるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "大人しく言うことを聞くなら今後も取引を続けてやろうと思っていたが、貴様にそのつもりはないらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "フンッ……今日のところはこのくらいにしておいてやるが、これで終わったと思うなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族の男性",
      "text": "行くぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あいつら、もう帰っちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……じゃあ、この人たちはどうしたらいいのかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "赤髪のザラックは、肩に担いでいた男を商人の前へと転がした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "放っておこう。誰かが面倒を見てくれるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "こ……こいつらは、子爵の部下の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "もしや、彼の言った助力というのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ほかにお心当たりがなければ、恐らく我々かと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "お怪我はありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "ええ、大丈夫です。しかし、お二人にはみっともないところをお見せしてしまいましたね。……ええと、その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "何はともあれ、心から感謝を申し上げます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "ですが、あの子爵の部下に手を出したとなると、この先どうすればいいのやら……うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ハリスンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "単刀直入に伺います。あなたと先ほどの方の取引が、この先うまくいかなくなることは明白ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "このことで向こうの機嫌を損ねたのは明らかですし、相手の身分はあなたより上……となると、どうしようもないでしょう。今の状況で協力関係を続けてもらえるとは到底思えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そして、聞くところによるとあなたの会社は今、事業拡大のための大事な時期だとか……そんな時に提携を打ち切られてしまえば、そのダメージは相当のものになるのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "ど……どういう意味だ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "まさか、わざとこうなるように仕向けたのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あらまあ、考えすぎですよ。私はただ事実を述べただけで、他意などございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "もし耳を傾けていただけるなら、あの貴族の方に頭を下げたり、新しいビジネスパートナーを見つけるべく奔走したりなさるよりも、ずっと良いご提案ができると思うのですけれど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリアの豪商",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "我々ブラウンテイル家は、イェラグ三大名家の一角。ヴィクトリアのちっぽけな貴族など恐れはしません。あなたさえよろしければ、我々が良きビジネスパートナーとなって差し上げますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "いかがでしょう？　ここは、我々の業務提携について――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "今一度、ゆっくりお話しいたしませんか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
