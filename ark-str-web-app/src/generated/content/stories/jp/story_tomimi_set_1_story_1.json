{
  "server": "jp",
  "storyId": "story_tomimi_set_1_story_1",
  "groupId": "story_tomimi_set_1",
  "stageId": null,
  "title": "新たな生活",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_tomimi_1_1.txt",
  "sourceHash": "d8e58009e9a212d1b38da98fe718ab2109941e2b116fd2e2253a33095b03ed4c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "ロドス本艦\n宿舎エリア ガヴィルの宿舎前"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさん、おはようございます。起きる時間ですよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（いない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（おかしいなぁ、ガヴィルさんは早起きしたのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（もう朝ごはんを食べてるのかも。食堂へ行ってみよう。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（ここにもいない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（寝てもいないし、ご飯を食べてるわけでもない。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（今日は何か大事なことでもあるのかも。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（直近で外勤任務はないはずだから、いるとしたら医療部かな。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えっ？　どうして！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そ、そんな！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "私も同僚が話しているのを聞いて初めて知ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "昨晩、付近の集落から緊急依頼を受けたらしいですが、どうも複雑な状況だったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "他のオペレーターの安全を確保するため、戦闘と医療の経験がどちらも豊富なオペレーターを派遣しなければいけませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "となれば、医療部を見渡しても適任者はガヴィルさんしかいませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "本当に急を要する任務でしたので、昨晩任務を受けたオペレーター全員が、すぐに出発したそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そんな……どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "書き置きやメッセージは残されていませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "見てみます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（通信端末を開く）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あ、ありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（ガ、ガヴィルさんはアカフラを去る時も、挨拶に来てくれなかった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさんまさか……まさかまた私を置いていったりしないですよね！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "えっ、考え過ぎですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すぐに手伝いに行きます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "えええ？　ちょっと、どうやって行くつもりです？　徒歩ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "く……車で行きます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "車の使用には申請が必要ですよ。それに目的地もわからないのに、どうやって向かうんですか？　無茶言わないでくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "そもそも、あなたは車の運転ができませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "で、できます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "う、ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ど、どうして泣くんですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "もう、泣かないでくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "あなたの不安な気持ちはわかります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "でもガヴィルさんなら心配いらないこともわかってますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "誰もガヴィルさんを傷つけられませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさんが……す……擦り傷を負うのだって心配です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "彼女は医療オペレーターですよ、その程度の傷は自分で治せます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "でも、万が一──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "はいはい、ここで泣きながら訴えても仕方ないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ひとまず休んで、落ち着いたら何か楽しいことでもしてみたらどうです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "確かに急な任務ではありましたが、それほど困難なものでもありません。三、四日ほどで悠々と凱旋してくるかもしれませんよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "何事も悪い方にばかり考えてはいけませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わ、わかりました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ご迷惑かけてごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ハハッ、大丈夫ですよ。さあ、戻って休んでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "まさかガヴィルさんがいなくなった途端、あんなに取り乱すとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "きっと、過去に何も言わずに去られてしまったことが、トラウマとして残ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "次からは出発前にちゃんとお友達に知らせておくようガヴィルさんに言わないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "もし次にまた同じようなことが起きたら、トミミさんの涙で医療部が水浸しになっちゃう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そんなに悲しいことですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "かもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "どうぞお座りください、アズリウスさん。どこか具合の悪いところはありますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさんが任務に行っちゃった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私もガヴィルさんと一緒に任務に行きたいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "「何か楽しいことでもしてみたら」かぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "何をしたらいいんだろう？　何ができるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私も強くなれればいいのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ここは、どこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "またロドスで迷子になっちゃった。ガヴィルさんに知られたら頭を叩かれちゃう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（人がいる。聞いてみよう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あの、こんにちは。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "こんにちは、アダクリスのお嬢さん。何かご用かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "（スカートをつまんで優雅にお辞儀をする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "う、ううっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（真似をしてスカートをつまんでお辞儀をする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すみません、ここがどこか教えてもらえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "具体的な位置なら、ここは格納庫への通路よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ありがとうございます、リーベリのお姉さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "どういたしまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "困っているご様子だけど、お手伝いしましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えっと、迷子になってしまって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "そうだったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "どこで道が分からなくなったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "ごめんなさい、バカな質問だったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "コホンッ……じゃあ、目的地はどこかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えっと……最新のファッション雑誌が買いたいんです。アカフラを離れてからずっと読んでなかったのですが、なんだか急に読みたくなってしまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "雑誌ね？　ええ、わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "雑誌を買うなら――そこのエレベーターで二フロア上がって、出たら右に曲がってまっすぐ進んで。それから小さな噴水が見えてきたら左に曲がるの。そしたら本屋が見つかるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "値段は都市で買うよりもいささか高いけれど、供給は安定しているから種類は豊富よ。取り寄せ注文もできるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうですか、ありがとうございます。行ってみますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "ちょっと待って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "行く前に、私のささやかな疑問に答えてもらえるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "え？　ええ、そんな畏まって確認されなくても大丈夫ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "そう、じゃあ次からはそうするわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "アダクリスのお嬢さん、その肩に担いだ荷物は重くないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "荷物？　このリュックのことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "よいしょっと……うーん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうでもないです、そんなに重くありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "中身はすべて厳選した大切な宝物なので、常に身につけてないと不安なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "宿舎に置いておくというのはダメかしら。宿舎はロドスでの家みたいなものでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "何かの拍子に失くしたりでもしたら、悲しいですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "一つだって失くしたくないんです。だから身につけておいた方がいいと思ってこうしてて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "つまりそれがあなたの思い出、あなたの心の拠り所なのね、うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "金庫に入れておくというのは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それはダメです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "箱に入れて鍵をかけるなんて、宝物たちが怒ってしまいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "なら、宿舎に飾って、あなただけの展示室にしたらいいんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "思い出を背負うことは良いことだけど、肩から下ろして飾ってあげた方が、より多くの意味を持つかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うぅっ……あの、よくわかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "気にしないで、単なるリーベリの無意味な独り言だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "私の疑問は解消したわ、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "私の案内が必要かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "大丈夫だと思います。お気遣いありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "それじゃあお先に失礼するわね、アダクリスのお嬢さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "だけど私たち、またすぐに会えそうな予感がするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "（サルゴン方言）あなたの前途が広い森のように広大でありますように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "（スカートをつまんで優雅にお辞儀をして去る）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（なんだか急いでたみたい。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（通路の向こうにいるリーベリは、あの人の妹かな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（とても仲が良さそう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（素敵だなぁ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小さな噴水に着いたら、左に曲がって……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ここだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うわぁ、ロドスにもこんなお店があったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "いらっしゃいませ、初めてのご利用ですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "スペースが足りなくて、品数が多い時は外にも露店を出すんです。もちろん、すべて事前に申請をしてありますから、何の規則にも違反していませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "何かお求めですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "最新のファッション雑誌を買いたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "ファッション雑誌でしたら、たくさん種類がありますよ。ほら、アクセサリーを紹介しているものから、流行の服装、芸能ニュース、それに──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "服装に関するものをください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "えっと……すみません、そちらの最新号はもう売り切れてしまったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（今日はなんだか運が悪いのかも……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "でも運が良いですね。最後の一冊を購入した方がまだ店内にいますから、もしどうしても読みたければ、彼女に見せてもらえないか頼んでみてはどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わかりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "どの人でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "あそこです、ピンク色の髪をしたあの人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "彼女はアズリウスさん。いつも雑誌を発売日に買いに来るんです。でも今日は先に用事があったみたいで、危うく買いそびれるところだったそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "話しかけてみてはどうですか？　彼女なら喜んで見せてくれるとは思いますが──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わかりました、ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "あ！　ちょっと、まだ話は終わってませんよ、彼女は──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "まあいいか、言わない方がいいこともあるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "これでアズリウスさんも友達が増えるかもしれないしね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あ、あの……アズリウスさんですか？　私はトミミといいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "（トミミですって？　なんて偶然かしら。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（手を差し出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あなた……私と握手をするつもり──ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あの、はい、それが礼儀かなと思って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "もし嫌なのでしたら──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "（トミミの手を握る）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ、私はアズリウスよ。お会いできて光栄ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ある理由で、他の人はあまり私に触れようとはしませんの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ですからあなたが手を差し出してくださった時、すこし驚いてしまいました。申し訳ございませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "それで何かご用ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "その雑誌をお借りして読みたいのですが、よろしいですか？　すぐにお返ししますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "雑誌？　この『Me Maze』のことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すみません、実は私ヴィクトリア語が得意ではなくて、あまり読めないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "では一緒に読みませんこと？　私も買ったばかりで、まだ読んでおりませんし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ここは人が多すぎますわ。どこか座れる場所を探してゆっくり読みましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい、お願いします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うーん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "読み終わりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ありがとうございます、アズリウスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "いえ、どういたしまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "トミミさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "トミミでいいですよ。さん付けだとなんだか変な感じがします……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ、わかりましたわ、トミミ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "今朝は……何かあったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "医療部のオペレーターが、あなたの涙で医療部が水浸しになってしまうと言っていましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それは……話すとなると恥ずかしいんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "話せば気持ちが楽になりますわよ、言ってごらんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "実は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "大体こんな感じです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "笑わないでくださいね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "笑いませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "けれど、アダクリスは涙を流さないと聞いたことがありますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "涙は弱さの象徴なので、絶対に人前で泣いてはいけないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "それでも、あなたはガヴィルさんのためなら泣けるのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "それは決して恥ずかしいことではありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うぅっ、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あなたはファッション系の雑誌に興味があるようですわね。あなたの故郷にもこのような雑誌はおありですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ありません、でもたまにイナムが私のために外から持ってきてくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "イナムは私たちの故郷で商売をやっている人で、よく外から面白いものを持ってきてくれたんですよ。それに、私に外の言葉も教えてくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "言葉を学んでからは、イナムから本を買うようになって、何冊かお気に入りもできました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "例えば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "『アーバンビューティー』とかです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あら、結構有名なファッション雑誌ですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ただ……最近はいつも同じパターンで、あの雑誌が有名になった当初の新鮮さは失われてしまいましたわ。はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あの雑誌の編集者やカメラマンは、会社を辞めて独立しようとしているという噂ですの。成功するかはわかりませんけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "アズリウスさんはファッションに詳しいんですね、すごいです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "そうでもありませんわ。ただ多くのものを目にして、自分のセンスとこだわりを持っているだけですわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あなたはどうですの？　トミミ。あなたにとって、ファッションとは何ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "よくわかりません……私たちの言葉にはファッションを表す単語がありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "人を殴ることを表す単語は、いくつも種類があるんですけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ハハ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私が考える「良いファッション」は、見た目が綺麗な服に、シンプルで美しいアクセサリーを組み合わせたものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "アカフラにはそういったものはありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あの雑誌を開いた時、服にもこんなに色があって、多種多様なデザインがあるんだということを初めて知りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "イナムから買う雑誌には、私には想像すらつかないような服が突然現れます。そして確実に言えることは──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "──私はそういう服が好きなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "よく理解なさっているじゃありませんの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "実は私が今着ているこの服も、雑誌で見つけて気に入ったものを、自分でどうにか作り上げて、それからアレンジしたものなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ちょっと雑な作りですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あら、なんだか見覚えがありますわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "えーと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "（ノートを取り出し、めくる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "マルテ……ワイルド……ハウル……水着シリーズ……コーラルコースト……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ありましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ご覧になって、この服ではありませんこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、そうです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "どうしてわかったんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "特に気に入ったデザインに出会った時は、切り取ってこのノートに貼りつけて、思ったことを書いておくようにしていますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "き、切り取るんですか？　それだと雑誌がボロボロになってしまいませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ、これは何と申しますか……個人的な習慣ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "切り貼りすることで確かに本の統一性は損なわれてしまいますわ。ですがこれは私にとって、ある種のショートカットですの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ショートカット？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "雑誌の中から自分が欲しい知識だけを、一つにまとめるのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "そのショートカットによって、ここに残りますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "頭の中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "私の手にあるこのノートは、もう六冊目ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "古い数冊は、今となっては懐かしさを味わいたいと思った時にだけ取り出して、パラパラとめくるだけのものになっていますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "そこにはもう思い出以外には、何も残っていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "本当に重要なことは、すべて私の中で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "それらが私の審美眼、センス、スタイルとなりましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "本当に、そんなたくさん覚えられるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "もちろん無理ですわ。残るのは自分が最も忘れたくない部分だけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "例えば、美に対する自身の選択と追求、といったものかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "あなたの場合は、えーと──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ガヴィルさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えっと、その通りです。確かにガヴィルさんを忘れることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "一番大切な思い出は、いつも頭の中にあるものですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "物というのは、それらの扉を開く鍵にすぎないこともあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "その扉が自動ドアになるまで思い出を強固にすれば、鍵なんて必要なくなりますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "た、確かに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "鍵……宝物……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "思い出……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "トミミ、コーディネートをしたことはあるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "コーディネート？　あ、ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "では今からショップへ行って試着してみませんこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "試着？　い、いいんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "品数は移動都市のショッピングモールほど豊富ではありませんが、まずは体験してみるのが良いでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "嫌でなければ、仕立屋さんをお呼びして、コーディネートのアドバイスをしてもらうのもアリですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そ、そんなこと、本当にできるんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ。もしお望みなら、ロドスで全身オーダーメイドだってできますわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "（小声）ただし、お値段はそこまでお手頃ではありませんけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わ、わかりました。私……ううっ、わ、私準備してきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "後で試着するんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "じゃあ、わ、わ、私まずは宿舎に戻ってリュックを置いてきます。その方が試着しやすいですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "そこに気付いたのは、とても喜ばしいことね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、さっきのリーベリのお姉さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりのリーベリ",
      "text": "さっきは自己紹介するのを忘れていたわ、許してもらえるかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "アステシア・ウビカよ、アステシアでいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あなたと知り合えて嬉しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "こちらこそ嬉しいです、アステシアさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（手を差し出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（軽やかに握手をする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "ごきげんよう、アステシアさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ごきげんよう、アズリウスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "今からトミミを連れてお洋服の試着に行こうと思っておりますの。もしよろしければ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ちょうど私も新しい服を何着か選びたいと思っていたの。ご一緒できるならこの上ない喜びだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "バイビークさんも、本屋さんで買い物をしている最中かしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "あら、予想通りね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "（本当に彼女は何でもお見通しですわね……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "私は先にバイビークさんにご挨拶してきますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アズリウス",
      "text": "また後ほど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小声）アステシアさん、アステシアさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小声）アステシアさんが言っていた、宿舎を展示室にするって、どうやればいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）ほら、あそこの小さな噴水が見えるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小声）はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）噴水に付いている彫刻は、美しいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小声）はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）もしあの彫刻があなたの大切にしているコレクションだとしたら、あなたは嬉しい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小声）は……はい、もちろんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）そういうことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）美しい思い出を、わざわざその思い出のために作られた台に置くことで、人は嬉しくなるものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）必要に応じて、その台にケースを取り付けたっていいわ。外からの力で壊れるのを防いだり、宝物の寿命を延ばすこともできるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小声）なんだかすごく素敵です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "（小声）あの……じ、時間がある時でいいので、その計画を立てるのを……ええと……て、手伝ってくれますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）いいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "（小声）お部屋の飾り付けは奥が深いの。お洋服の試着が終わったら一緒にゆっくり考えましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "まずはアズリウスさんたちと合流しましょう。あまり待たせるのは良くないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "トミミ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "何ですか、アステシアさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "少しは気分が晴れたかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "自分の好きなことをするのは、すっごく楽しいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "うん、それならよかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "行きましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい、アステシアさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ロドスとアカフラには、違いがたくさんある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ここではできないことも多くて、部屋も小さいけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "でも私はあんまり気にしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ここではたくさんの新しい知識が学べるし、新しい友達とも知り合えるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "こんな楽しいことはないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "もしかしたら、私はここでファッションリーダーや冒険家、術師になれるかもしれないし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "全部まとめて、冒険心のあるファッショナブルな術師になれちゃうかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "これから先、どんな面白いことが起こるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すごく楽しみ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさんもきっと同じような理由で、アカフラじゃなく、ロドスに留まる選択をしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさん、今頃何してるのかなぁ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "我慢しろ、痛ぇのは一瞬だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "クソ痛ぇな！　もっと優しくやれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "痛ぇだけだろ、死にゃしねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "手当は終わった。傷口を押さえとけ。アタシは客人に挨拶してくっからよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ハァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うぐっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おい、どうしてアタシのとこまで敵が来てんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤隊隊長",
      "text": "すまんガヴィル、一人入られちまった。ほかのは全部片づけたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤隊隊長",
      "text": "全員、その場で休憩。警戒を怠るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤隊全員",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ふぅ、やっと終わったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ああ、無事で何よりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ガヴィル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "うん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "今回の任務は急だったが、同郷の奴にはちゃんと連絡を入れてから来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "いちいち連絡する必要なんてねぇだろ、見知った仲なのによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ほかの奴らはどうか知らんが、よく医療部まで会いに来るあの同族の子くらいは、声かけといた方がよかったんじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "万が一お前が見つからないとなったら、ロドスが水浸しになるほど泣いちまうんじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "トミミはそんなに弱くねぇよ。アタシたちアカフラ出身の奴はどいつも強者だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "それに、前にアステシアを手伝ってやったことがあるから、もし何かあれば、あいつがきっと助けてくれんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "そうか。とっくに対策は考えてあったんだな、今のは聞かなかったことにしてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "無駄口叩いてねぇで、任務が終わったらどこでロドス本艦と合流すればいいのか早く確認しろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ああ、ちょっと待ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "うん……ここだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "本艦は、調整と補給のためにこの都市に停泊するみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "ここはリゾート都市らしいな。街のウォーターフロントビーチは、観光客に開放されているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "休暇をとるにゃいい機会だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そりゃいいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "（リゾート都市……ウォーターフロントビーチ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "（じゃあ、あいつへの土産に水辺用の服でも買っていってやるか。多分気に入るだろ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "（詫びの印としてな。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
