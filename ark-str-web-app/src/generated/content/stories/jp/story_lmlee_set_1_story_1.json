{
  "server": "jp",
  "storyId": "story_lmlee_set_1_story_1",
  "groupId": "story_lmlee_set_1",
  "stageId": null,
  "title": "一日三食",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_lmlee_1_1.txt",
  "sourceHash": "507c2de73c3ea456c419492b18f92ca7e4aca0fecf30f46233a025cdb07cc434",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "そこのあんた、さっきからうろうろしてるが、欲しい食材が見つからんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おれのことですかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ああ。市場はもうすぐ閉まるから、そろそろ出ないと中で夜を過ごす羽目になるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そいつは……しかし、まだ七時にもなってませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ふむ、見たところ地元の人間じゃないな。ここは夜になると、危ないんだ。そんな遅くまで店を開く度胸のある奴なんていないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……確かにおれは来たばっかりで、つい昨日近くの旅館に住み始めたもんですがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "龍門には他に行くところがたくさんあるのに、何でまたこんな小さい市場をぶらつこうと思ったんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "なあに、ささやかな習慣ってやつですよ。新しい場所に来たら、まず地元の市場に行ってみるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "その土地の空気、人情、食い物、みんなここに反映されていますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ただの市場にそんな違いがあるものかね？　行き交う人々で騒々しいだけだがなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "たとえば……尚蜀の市場なんかは、夜通し店を開けてますよ。こことは違ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "はあ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "……あんた、何か買う気はあるのか？　買わないんならもう店を閉めちまうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おすすめはありますかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "小暑（しょうしょ）の時期だしマコモダケで粥なんてどうだい。体の熱を下げてくれるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いやぁ、旅館の冷蔵庫が小さいもんでね。こんな長いマコモダケは入りませんや。ここらで退散します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "はぁ……変な人だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "店じまいが遅れてしまった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "店主さんよ〜、今日はずいぶん帰りが早いんじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "（くそ、チンピラめ……これだけ早めに出ても避けられんか。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "俺の金はちゃんと用意できてんだろうな？　先月の分も忘れてねぇよなぁ～。耳揃えて出しな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "こ、ここ何ヶ月か景気が悪いものですから、貴方様にお渡しできるほどの儲けはとても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "ならちょうどいいな。とっととこっから失せて、店の経営はもっと有能な奴に譲るんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ちょ、一体何を？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "やめろ、壊さないでください！　もう何日か待っていただければ、必ずその時までに金は用意しますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "ふん、もう遅ぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まあまあ、大目に見てやってくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "チッ、旦那よぉ、あんたどこのもんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いやいや、旦那だなんて恐れ多い。兄弟って呼んでくれればそれで結構ですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "……言葉に気をつけろ。俺のバックにいるのが誰か知らねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "もしやリンさんっていう御仁ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "知ってんなら、ちっとは弁えやがれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "（ったく、この街で出くわすチンピラの十人に八人が、自分はリンさんの手下だってうそぶくのは、一体どういうわけなのかね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いやあ、どうりで見覚えがあると思いました。確かリンさんのお屋敷でお会いしましたよねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "あー……あ、会ったっけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そうですとも、去年はリンさんのお宅の金木犀がちょうど満開だったもんで、シロップ漬けを作られてましたが、お受け取りになられましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "も、もちろんだとも。出て行く前にリンさんから十瓶以上も渡されたもんだから、食べきれなかったくらいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いや、ちーと待てください……記憶違いでした。リンさんの家に植えてあるのは金木犀じゃなくて、桃の木でしたっけね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "*龍門スラング*、てめぇはリンさんと知り合いか、そうじゃねぇのか、どっちなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "さぁて、おれ知っているかもしれないが、そちらさんは確実に知らないってところでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "とっとと、どこへなり行っちまいなさい。リンさんの部下への躾は厳格で有名ですからねぇ。誰かが自分の名前を騙って悪さしてるなんて知った日にゃ、そいつはきっと悲惨な目に遭うでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町のチンピラ",
      "text": "クソッ、ツイてねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "その……あんた、ありがとうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "なーに、口の運動をしただけですよ。次にああいう輩に出くわしてもビビるこたぁありません。デタラメを吹かすチンピラばかりですからね。本物の裏の連中ってのはあんな間抜けじゃありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "はぁ……私はただの商売人だ、人を見抜く力なんてないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "そうだ、ちょっと待ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "旅館の冷蔵庫がいくら小さくても、このライチなら入るだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "うちで採れたものだから、大した代物じゃないが、心ばかりのお礼だよ。持って帰って食べとくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "……どうかしたかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いえ、おいしいライチが食べられるってだけで、遠路はるばる来た価値があったって考えてたんですよ。どうもごちそうさんです、店主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "そうかい、気に入ってくれたんなら何よりだ。暇な時にでもぜひまた来てくれな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ええ、必ず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "リーさん、おーい、リーさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "やれやれ、蔡（ツァイ）さん。市場に着く前からあなたの大声が聞こえてきましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "あんたに取っといた冬筍の鮮度が落ちるんじゃないかと、ずっと心配してたもんでさ。大寒の時期に食うにはぴったりだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "数分待たせたくらいで、そんなすぐ悪くなるわけないでしょうが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "帰ったら塩水に漬けておくのを忘れないでくれよ。その方が長持ちするからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "大仰なのは勘弁ですよ。おれが借りてる部屋は、台所のスペースなんてほんのこれっぽっちしかないもんでね。ラップに包んで冷蔵庫に放り込んどきゃ十分でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ダメだ、こいつはなんと言っても上等な白眼筍（はくがんじゅん）なんだからな。あんたみたいなこだわりのある人だからこそ、取っておいたんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "心配いりませんよ。二、三日したら大事なお客さんを家に呼ぶ予定なんでね、どのみち長く置いとくわけじゃありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "リーさんも龍門で友人ができたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "まだ友人とは呼べませんがねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "では、どうすればリーさんの友人になれるかのう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おやぁリンさん、今日は奥さんに代わって買い物ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "筍のために十キロ以上も離れた市場に買い物に行かせるほど、うちのはえり好みの激しいタチではないわい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "（小声）リーさん、こ、この人は……まさかあの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "（小声）普通の客として扱えば大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "リーさん、まだワシの質問に答えてもらっておらんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "う～む、おれは俗っぽい人間でしてねぇ。誰かに大きな酒楼（しゅろう）で席を設けてもらって、飯でもおごってもらったなら、その人はもうおれの親友ってとこですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "部下からの報告とは異なるようじゃな。この一週間お主が出入りしていたのは、路地裏の小料理屋ばかりじゃったろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おれが現れる場所をそこまで知り尽くしているリンさんが、どうしてわざわざ家から十キロ以上も離れた市場まで探しに来たんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "筍には十数キロも遠出する価値はないが、友人に礼を言うためならばその価値はあるからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "またまた大袈裟な。おれはただ、ちーとばかりお手伝いをしたに過ぎません。おれがいなくとも、あの状況は何とかなったでしょうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "それは違う。お主がおらんかったら、たとえ何とかなっていたとしても、今と比ぶべくもない状況になっていたはずじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……ふっ、リンさん、おれの力量がどの程度のもんかは、おれが一番よく分かってますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ところで、お主はこの絶品の筍を、どう料理するつもりかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "かるーく炒め煮にしてやるだけで、十分滋味は堪能できますねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ワシとしては、そのような素朴な調理ではいささかもったいないと思うがのう。仕留めたばかりの羽獣と一緒に煮込んで、スープにするというのはどうじゃろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いやいや、それだと筍の新鮮な甘みが活かせませんや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "はっきり言ってくれて構わんよ、リーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "はぁ、それにこの筍ときたら、野生で自由気ままな質でしてね、他の食材と一緒にされるのはきっと嫌がるんじゃないですかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "となると、心配なのはすくすく育った筍というのは、たとえ山奥の林に生えていたとしても、掘りに来る者を次々と引き寄せてしまうことじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "平穏な日々なんて到底過ごせるはずもないじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ハハッ、まあそれは後になってみなきゃあ分かりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ウェイの奴が何の理由もなく人様の家のご厄介になるとも思えんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おれは自信がありますぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "何の自信じゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おれの筍料理にかかったら……ウェイ長官がひとたび箸を取れば、一言も喋る暇すらないだろうって自信ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ふん……店主さんや、ここはりんごは置いてるかのう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ありますとも、どうぞリンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "いくらかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "お、お金なんていただけません。もう何年もずっと、リンさんのおかげでみんな安心して暮らせているんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "商売も楽ではなかろう。取っておきなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "リンさん、買い物に来たんじゃないって言ってませんでしたっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "どうせ来たんだ。娘に土産を持って帰るのも悪くはあるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いやあ、所帯持ちはやっぱり違いますねぇ。来年あたり姜斉（きょうせい）で湖を回ったり花見をするのにご招待しようと考えてたんですが、こりゃあお流れですかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "お主もふらふらしてないで、早めに身を固めた方がよいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いんや、遠慮しときます。落ち着いた暮らしは、どうも性に合わないんでね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "奥さん、旬の青梅を見てくださいよ。この薄い皮の中に実がぎゅっと詰まっていて、種も小さめ。甘酸っぱさときたら、口に入れた途端によだれが止まらないほどですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "えーと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "四月を過ぎたらもう味わえませんよ。今すぐ買ってお酒に漬けておくのなんていかがですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "分かりました……少しいただけるかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "どうぞどうぞ。「青梅と酒は旬の内に煮るべし」なんて言葉もありますからね……学がないもんで、それしか覚えてませんが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ツァイさん、お客さんからお金をせびる声が、遠くから聞こえてきましたよ。あなたの口ときたら……どんどん達者になっていくんですからねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "まぁ、こっちも商売だからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "こんにちは。リーさんはここの常連客なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "お久しぶりです。夫人はまたどうしてこちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "龍門で一番大きくて、品ぞろえも豊富な市場ですもの。食材を買おうとなったら、ここより良い場所はありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "夫人自ら食材を買いに来るなんて、一体どういう風の吹き回しで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "もうすぐイェンウの誕生日なので、あの人に何か作ろうと思っているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "メニューは決まっているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "……それが、まだなの。どうせイェンウがよく食べている料理になるでしょうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ウェイ長官が好きな料理ですか……そいつはご夫人の腕の見せ所ですねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "こほん、その……手間暇は惜しまないつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そうでしょうとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "ですけど……市場に来たのは初めてで、どうやって選べばいいのか分からなくて。リーさんのお力を少し貸していただけると嬉しいのですけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "お任せあれ。たとえばトマト、生で食べるんだったら、ピンク色のやつがさっくりした歯ごたえでお勧めです。炒め物の具材なら真っ赤なのを買えば間違いないでしょう。濃厚で汁気たっぷりですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "なるほど、覚えておきます。こちらにあるお芋はどうでしょう？　肉の燻製と里芋のマッシュを作りたいのですけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "芋ですか。大きさに違いがなければ、少し重めのを買っておけばいいんじゃないですかね。水気もでん粉もたっぷりで、もちもちとした噛み応えがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "分かりました。では椎茸は干したものか新鮮なものか、どちらを買えばいいのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "それぞれ良さがありますからねぇ。どんな料理に使うおつもりで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "新しょうがと椎茸の肉詰めです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "それなら干し椎茸がいい。水で戻せば香りが更に濃くなりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "へぇ……そうだったんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そうだ、この先に豉油（チーヨウ）を売っている店がありますよ。羽獣と一緒に煮込むのにぴったりです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "（小声）あそこは最近値上がりしたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "（小声）ツァイさん、そいつはいらぬ心配ですって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "玫瑰豉油汁（メイグェイチーヨウジー）ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ええ。いつも食べてるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "確かにそうですが、イェンウがあれをよく食べるのは、私の好物だからです。付き合ってくれているだけですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ご本人も好物だと言ってましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "前にウェイ長官と食事した時に聞いたんで間違いないでしょう。夫人が好きな料理ってことで、ウェイ長官も好きになったんだと思いますよ。愛屋及烏ってのは、よくある話です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "……クスッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "なんだかリーさんって、商人さんよりも口が回るみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ハハッ、商人ですか。確かに近頃はそんな感じかもしれませんや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "リーさんはずっと気ままに生きてきたのでは？　かつてイェンウが近衛局の要職に就くよう度々お誘いしたときも、拒んでいたのに、急に商人だなんて、生活に不安を感じ始めたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "家にまた一人食い扶持が増えちまいましてねぇ。使い走りをして稼いでるってわけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "あら、ついに所帯をお持ちになられたの？　今度イェンウとお祝いの品でも持ってお邪魔しに行きますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いえいえ……古い友人が子供を一人残して遠出しちまって。おれが預かってるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "なんて無責任な……それで、その方はいつ帰って来るか言って行ったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いえ……でもまあ、本当にほったらかしにすることもないでしょうしね。何ヶ月か面倒見てやりゃ、そのうち戻ってくるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そいつにガキを返したら、おれも彼にならって、どっかへ遠出しようかなって思ってるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "龍門ではいけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いけないってこたぁありませんが、おれは気ままな男なんでね。どんな良いところでも、一か所に長くは留まれないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "text": "ふぅ、リーさんのおかげで買い物もほとんど済みました。そろそろ失礼しますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "お気をつけて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "リーさん、おーい、リーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ああ……ツァイさん、何かご用で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ずいぶん長いことそこに立ってるが、他にもお客さんがいるんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……おおっと失敬。この輸入物のサクランボはいくらですかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "リーさん、高い買い物は嫌じゃなかったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いやあ、家で待ってる娘っ子の好物なもんで、何斤か買って帰ろうと思ってね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ツァイさん、先週頼んでおいた食材は届いてますかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "届いてるよ。取りに来るのを待ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そいつはどうも。今日はちょっくら家で用事があったもんでね、待たせちまって申し訳ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "問題ないさ。まだ九時前でそんなに暗くもないし、店じまいには早いからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "しかし今日、あんたが来るとはねぇ。あのでっかい見習い君にお使いさせるわけにはいかなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "あいつは今日は仕事がありましてね。ちょうど新居に引っ越したばかりなんで、ワイフーとアと一緒に部屋の掃除をしてるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "引っ越し？　なんだ、前の家は不満だったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "部屋が少なすぎて、依頼人をもてなすのに不便なんですよねぇ。冷凍庫をもう一つ置きたいのに、台所も小さすぎて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "冷蔵庫二つじゃ足りないって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "大勢で食卓を囲むんでね。幸いウンが料理を覚えてきて、手伝ってくれるもんだから助かってます。あいつがいなかったら飯を作るだけでも一苦労だったとこだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "私に言わせりゃあ、あんたの他の才能はともかく、その料理の腕が誰にも受け継がれないで終わるのはあまりに惜しいよ。あの子がいてくれてほっとしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "まだ生っかじりで受け継いだと言えるにはまだまだですけどねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "じゃあ今日は、あんた自ら腕を振るうつもりかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ええ。ガキどもが一日働いてくれましたから、労ってやらなきゃならんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ははっ、じゃあこの金柑の鉢植えを持っていきな。開業した事務所の商売繁盛を願って、景気づけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おや。この金柑、何年も前からずっと店に置いてたやつで、売りもんじゃないでしょう。ずっと大事にしてて、気軽に触れてもいけないような雰囲気だったじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "寒露（かんろ）も過ぎたばかりで、ようやく実をつけたところだってのに……どうして今日はそんな、くれるなんて言い出すんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "リーさん、実はな、この八百屋はもう畳むことにしたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……どこかへ移るんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "いや、引退するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "もう十年以上にもなりますねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "あんたが来る前から数えれば、もう三十年にもなるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "来年になったらこの市場を取り壊して、大きなスーパーマーケットを建てるんだってよ。先月に通知が来てさ、店は残せるらしいが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ここ数年の龍門は……建て直しが多すぎますねぇ。家の近くの茶楼（さろう）も、カフェに変わっちまうらしいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "まあ、そういうことだ。私ら夫婦も長年働いてきたわけだし、ここらで足を止めてゆっくりするにはちょうどいいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ツァイさんとこの息子さん娘さんもすっかり自立して、家庭を持って家を出ていったわけですしね。もうこの店にこだわる必要はないのかもしれません。あちこち旅して見て回るのが一番ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "龍門にはもう長いこといるが、二人とも炎国の他の街には行ったことがなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "今までの蓄えと政府からの立ち退き料も合わせれば、私らが何年か遊んで過ごすには十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "リーさん、あんた色々なところへ足を運んだことがあるんだろう。どこかお薦めはないかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……おれも龍門に長いこと居座ってるんで。あちこち旅して回ってた頃のことを今思い出せと言われても、ちーと難しいですねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "でもよく考えてみると、嫌な記憶はもう煙のようにかすんじまってあんまり思い出せませんや。残ってるのは……地元の穏やかな風景と、暖かい人情ってやつですかねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "それと騒々しい市場もな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "あっはははっ……まだその言葉を覚えてたとはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "尚蜀へ行ったら、まず例の夜通し店を開けてる市場とやらを見に行くことにするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "あぁ……いいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "初めてこの市場で呼び止めてから、会うたびに、もうすぐ龍門を出て行くだなんて言ってたのに。十年以上経って結局、先に出て行くのは私の方だったなんてなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ほんと、何の因果でしょうねぇ。龍門から出て行こうとするたび、何かがおれの足に絡みついてきやがるもんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "はぁ……そうだ、ツァイさん、色んな人が、旅に出る前におれのところへ吉凶を占いに来るんですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "長年の友人ですから、お代はいりませんよ。一体ご夫婦の旅がどんなものになるか、ひとつ占いましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "そりゃあありがたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "どんな感じだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "世旺（せいおう）の卦象、つまり大吉の相ですね。旅の間は健康なまま、行き帰りも平穏そのもの、万事がうまくいくことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "ハハハ、相変わらず口が上手いな。ありがとうよ、良い風に言ってくれて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ツァイさん、今のは聞こえの良い言葉なんかじゃありませんよ。おれの、心底からの願いです。また……縁があったらまた会いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "八百屋",
      "text": "……ああ、いつかまた会おう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スーパーの放送",
      "text": "もうすぐ冬、冬のバーゲンセールです！　精肉を買うと、もう一つおまけでプレゼント！　もうすぐ冬、冬のバーゲンセールです！　精肉を買うと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ウンさん、もう長いこと並んでますけど、私たちの番まであとどれくらいかかるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "もう少しだよ。今日はセール中だから、人も多いんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "たかがもも肉のために立ち続けて、私の腿まで痺れてきました。武術の稽古の時だってこんなに疲れませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "しばらく前に先生から、誕生日はもも肉のねぎ油かけが食べたいって注文されてね。今日なら、スーパーで締めたての肉を売ってるけど、これを逃したら冷凍肉を買うしかなくなるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "リーおじさんも、いい歳なのに、食べたいものがあると少しも我慢できないなんて、ますます子供っぽくなっていくんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "誕生日ってのは、願いを叶えるべき日だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "そんなこと言ってるワイフーだって、だいぶ前から誕生日プレゼントを買って部屋に隠しているじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "え……何で知ってるんですか？　私の部屋は掃除しないでって言いましたよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "部屋には入ってないって……ゴミ捨てに行った時、袋一杯の包装紙が目に入ったからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "うぅ、私だってプレゼントの包装があんなに大変だとは思いませんでしたよ。何度も包んではやり直して、やっとのことで綺麗に包めたんですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スーパーの店員",
      "text": "いらっしゃい、何をお探しで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "もも肉をください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スーパーの店員",
      "text": "前足ですか、後ろ足ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "後ろ足でお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "ワイフー、アを見かけなかったか？　どうしてまだ戻ってこないんだろうな？　もも肉だけ受け取ったら会計済ませてすぐ帰るってのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "分かりません。スーパーに入った途端、姿を消しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "（あちこち見渡す）まったく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "いました。あれじゃないですか？　真っすぐにこっちへ来ますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "大分姿が見えませんでしたけど、何買ってきたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ア",
      "text": "何でもねぇよ。リー先生に買ってやるもんがないか、色々見て回ってただけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "何も見つからなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ア",
      "text": "へへっ、まぁな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レジ係",
      "text": "いらっしゃいませ。合計四百七十一龍門幣です。現金ですか、カードですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "店員さん……計算間違いじゃありませんか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レジ係",
      "text": "まさか。機械で計算していますので、間違えるはずはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "（おかしいな、俺の計算よりも多いぞ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "ワイフー、レジ袋を開いてくれ。もう一度確認してみる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "まあいいじゃないですか、ウンさん。そもそもあなたの勘違いかもしれませんし、早く帰りましょうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ア",
      "text": "そうだそうだ、一日歩き回ったおかげでワイフー姉もへとへとみたいだし、さっさと家帰って休もうぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウン&ワイフー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "……ワイフー、袋をくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "……どうぞ。よく確認してみてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ア",
      "text": "（しまった、話しすぎたな……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "もも肉、大根、かぼちゃ、蓮根……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "あっ、ウンさん、底の方に生薬の袋があるみたいですけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "うっ――クシュン！　ゲホッゲホッ……ひどい臭い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウン",
      "text": "ゲホッゲホッ、何だよこれ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ア",
      "text": "おいおい、あんたらがどうしても取り出そうと言うからだろ。俺は悪くないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ア",
      "text": "俺はただ、あんたらのリー先生へのプレゼントがさぁ、ヘッ、どれもつまんねーなって思っただけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ア",
      "text": "じゃ、先に帰ってるから。またなー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ゲホッゲホッ……こ、この……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "この悪戯好きが、戻りなさい！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
