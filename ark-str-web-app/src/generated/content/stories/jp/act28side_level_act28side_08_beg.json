{
  "server": "jp",
  "storyId": "act28side_level_act28side_08_beg",
  "groupId": "act28side",
  "stageId": "act28side_08",
  "title": "過去との決別",
  "storyCode": "CV-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act28side/level_act28side_08_beg.txt",
  "sourceHash": "024038bff8189ef9299341e06dfdefdaad725ef226998f019012cd87ce85ba67",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "BSWの部隊は10分もしない内に駆け付けると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "それじゃあエネルギータワーまで走るのも間に合わねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺がここに残る……お前たちは先に行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "どのくらい稼げる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "どれだけ時間が必要だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "最低でも……30分でしょうか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "腰からリボルバーを取り出し、ウッドロウは弾を数えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "……一時間でどうだ？　爆薬も仕掛けなきゃならんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それだけあれば余裕ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ウッドロウさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "……気を付けろよ、ウッドロウ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "早く行け。そうだ、ジェシカ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "何でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "ありがとよ……こいつを届けてくれて。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ウッドロウは帽子のつばを掴んで深くかぶり直し、大通りへと歩いて行った。彼の背中はすぐに夜の闇に吞まれたが、別れの言葉だけがその場にしばらく留まった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "次に会える時が楽しみだ、わが友たちよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "text": "ミスタークリフ、本艦のスラスター調整が完了しました。エンジニア小隊は現在ドッキング構造の安定性を再チェック中です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "text": "……ミスタークリフ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "出発はいつ頃になる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "text": "水曜日にはすべての準備が整います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "そうか……わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "し……失礼いたします、報告がございまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "text": "ではミスター、私は現場に戻ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "うむ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "区画に駐留していた小隊から本部へ支援要請がありました。それによると、強盗グループが銀行の地下金庫の扉を爆破し、中の準備金をすべて奪っていったそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "強盗グループは四人……身元は特定済みです。ウッドロウ氏とその友人、それから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "それから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "ジェシカさんもいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "……フッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "人員を送りますか？　銀行に配置していた警備員はすべて、数日前に撤退させてしまいましたので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "区画牽引の準備作業を優先とし、手元に仕事が残ってる奴は続けて構わん。残りは……全員送り込め。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "承知しました。それともう一つ、ジェシカさんは特殊な立場にありますが、いかが致しましょう……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "彼女にはケガをさせるな、ブリンリーのメンツも考慮しなければならんからな。ウッディに関しては……あいつを傷つけずに制圧するなんて芸当は、誰にもできんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "まあいい……あいつは命さえ確保すればいい、残りの奴は現場判断に任せる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "承知致しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "そうだ、奴らの中で金を持ってるのは誰か、確認は取れたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "まだわかっておりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「クリップ」クリフ",
      "text": "そうか。判明次第、ティラに見張らせておけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ねぇ、聞いた？　ジェシカたちが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "何とかしなくちゃ。上の話では、ジェシカとウッドロウさん以外は……各小隊の現場判断に任せるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……フランカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "メンバーに出発の準備をするよう伝えて。わたしたちの小隊にも捕縛命令が下った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……あなた、それに従うつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……フランカ、わたしたちに残された時間は少ない。ジェシカたちを助けるにしても……捕まえるにしても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ほかの小隊が駆け付ける前に彼女たちを見つけないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ヘレナさん、レオーネさん、すみません。見送りはここまでです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "大通りじゃない方向から車両の音が聞こえてきています。おそらく増援が派遣されたのだと。当初の想定通りですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "手はず通りでいいのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい、わたしは外に残って注意を引きます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "気を付けろよ……ゴールまでは安心して俺たちに任せろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ジェシカ、ここまで来たら、あなたも自分を信じるしかないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "どうやらBSWが区画を牽引して出発するのもここ数日中らしい。入口には数人しか残ってなかった。きっとほとんどの人員が出航準備のために接続場所の作業に回されてるんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あたしたちにとっては好都合ね……相手するのにさほど苦労しなくて済むもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "見張りの連中は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ぐっすり眠ってるわ。起きたら少し首が痛むでしょうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "俺たちも急ごう。動力炉を爆破して、あの隠し通路の入り口を完全に塞ぐには、この爆薬を残らず設置する必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "見て、あの車のライト……BSWの奴らがもう採掘工場の周辺まで近づいて来てるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ヘレナ……先に行け。残りは俺一人でもできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "……レオーネ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "あんたの仕事の方が重要だろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "まだ崩せてねぇのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "幹線道路に近づけた車両は一台もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "いったい何人残っていやがんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "一人……サンクタ一人だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "支援はまだなのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "まだだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "車はここに止める……残りの奴に武器を持たせて、俺たちは路地から回り込んで突破するぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な傭兵",
      "text": "この先に待ち伏せがいるようだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "弾痕からして……これはBSWのエッチング弾だな。グッドニュースだ、例のお嬢様を見つけたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な傭兵",
      "text": "……拡声器を貸してくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な傭兵",
      "text": "ゴホン。ジェシカ、お前がどんな理由でこの強盗事件に係わったにせよ、おとなしく投降してくれるのなら……俺たちも悪いようにはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "（小声）そのまま彼女の注意を引きつけててくれ。俺はドローンで痕跡をたどる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "近づかないで。わたしはおとなしく捕まったりしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "（小声）弾は前方のあのレストランから発射されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "（小声）先に配置につく。全員の準備が整い次第突撃だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な傭兵",
      "text": "強盗をすればどうなるかなんざ、あんたにはわかってないかもしれんがな。一生を獄中で過ごし、親戚や友人から見放され、社会からは冷たい視線を浴びることになる……本当に耐えられるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……わたしはBSWでみなさんと長い間共に仕事をしてきました。もう以前のような世間知らずのお嬢様ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "代償として何を支払うことになるかは……よくわかっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それでもやらなければならないんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "どんな代償を払おうと、やらねばならないこともありますから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "見えてきたな……あいつがそうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "ただの爺さんと思って見くびるなよ……あそこでひっくり返ってる車両が見えるか？　あれは全部あいつがやったんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "通りの中央に見える人影は、さながら彷徨う亡霊のように、明滅する明かりの下で静かに立っている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "若造……言いたいことがあるなら、面と向かって言ってくれたらどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "こんなに離れていても聞こえるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "昔ここよりももっと騒がしい場所にいたことがあってな、この鋭い両耳に頼って生き延びたのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "あなたのような伝説の傭兵であれば、きっと驚くような経験をしてきたんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "伝説の傭兵か……そんなふうに言われるのは初めてだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "BSWには長い廊下があり、創設者と戦友の写真が飾られている。そこであなたと社長が一緒に写ってる写真を見たことがあるんだ。あまり目立たない場所だが、俺はその写真を覚えてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "……残念だが、俺の経験したことはお前の想像しているほど劇的なもんじゃない。俺が経験した戦争は一度だけだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "そんなこたぁどうでもいい……俺はずっと社長に手合わせ願いてぇと思ってたんだよ。だが何と言ってもあの人は社長だ、ガチで銃を向けるなんてできやしねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "爺さん、俺らの社長と一緒に写真に写ってるなら、あんたの腕前は相当なもんなんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "いいや、ひどいもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "ひどいもんだと？　たった一人で我々十数個の小隊を振り回して、この通りから一歩も先に進ませないほどの腕前がか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "違う。かつて俺が救いたかったものは俺の前で無残な最期を遂げ、守りたかったものも儚く消えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺の愛したものは俺を捨てて去り、俺の憎んだものはこの手で殺せやしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺は伝説でも何でもない……ただの落ちぶれた循獣だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "足元に残ったわずかな骨を守るだけの、老いた循獣なのさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "眼前の老人の指先がかすかに動くのを見て、傭兵は即座に危険を察知した。\nだが最速で銃を構えてターゲットに狙いを定めた時には、既に肩を撃ち抜かれていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "うっ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "クソッ、動きがまるで見えなかった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "なんだか、楽しくなってきたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "頭を出すな、この馬鹿が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "気を付けろ、それ以上近づくんじゃないぞ、若造。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "……その骨を守るためなら、俺はすべてを懸けられるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "結局入ってきましたか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "ジェシカ、屋内では予測できない跳弾が起こるんだ。俺はお前を傷つけたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしもあなたを傷つけたくはありません……外の人たちを連れて立ち去ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "すまないが、これは上からの命令なんだ。みんながみんな金持ちのご令嬢で、わがままできるわけじゃないんでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "みなさんにご迷惑をおかけしてしまいました……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "少女の声がカウンターの向こうから聞こえてくる。声は柔らかく、ややためらいを帯びていた。傭兵が彼女に抱いた第一印象の通り、臆病で繊細なものだ。\n銃を顔の横で構え、傭兵が慎重に歩を進める。"
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "カウンターの中には誰もいない。テーブルの上には一丁の狙撃銃が置かれているだけで、引き金に仕掛けられた装置によって、遠隔操作が可能となっていた。\nそばには一台の通信機器があり、少女の声はまさにそのスピーカーから響いていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……本当にごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な傭兵",
      "text": "ターゲットは調理場にはいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "text": "二階にもいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "text": "外にもだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "彼女はここにはいない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "頭脳派の傭兵",
      "text": "急げ、すぐに撤退だ。これは陽動――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ですが、わたしのことをわがままだと言っておきながら……なぜそちらの思い通りに動くことなどを期待するんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な傭兵",
      "text": "いや、まだ出るな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "窓の外で、火の光が地面に落ちた。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な傭兵",
      "text": "全員伏せろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その言葉が発せられた瞬間、爆発音が鳴り響いた。\n車のタイヤが窓から室内へと飛び込み、火と煙を伴って何度か回転した後、最終的にガラスの破片まみれの床に横たわった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……爆破完了。車がなければ、動力炉にたどり着くまで……もっと時間がかかるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "これで充分間に合うはず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "さらに増援が来てる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "こっちも急がないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "計画では、あんたはこの隠し通路を進み、俺は動力炉を爆破するってことになってたな。そうなれば、この道も崩れて、もう誰にも見つけられなくなるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "レオーネ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "地図は持ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "この道は地下の下水道に繋がってる。中の構造は複雑で、区画外に通じている道は一本だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "すでにジェシカが出口に乗り物と物資を隠しておいてくれている。開拓地へ向かう道中は軍の駐屯所を避けながら行く必要がある……きっと野盗や暴徒も大勢いるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "レオーネ、もう何度もシミュレーションしたでしょ。道中の危険についても……ウッドロウから何度も言われたし、すべてわかってることよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "そうだな。それでも俺は心配だ……ヘレナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あたしは本来、簡単に約束なんてしないのよ、レオーネ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "でも、これだけは約束するわ。何が起きても、あたしは全力で約束の地まで向かう。たとえ途中で倒れても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "いいや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "そんなことにはならんさ、ヘレナ。俺が後ろにいるからな。あんたの邪魔をしようとするもんは、全部俺が食い止めてみせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "これは俺からの約束だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "あんたはただ、前へ向かって走ればいい。いいな、ひたすら前へ走り続けるんだ。決して振り返るんじゃないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "わかったわ、レオーネ……じゃあね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ああ、もう行け。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "狭く暗いトンネルがヘレナの後ろ姿を飲み込むのをしばらく見つめたあと、名残惜しげにしながらもレオーネは振り返り、部屋の中央に鎮座する動力炉に向き直った。\n区画にはもう人はほとんど残っていない。にもかかわらず、燃焼室の中の炎はいまだ赤々と燃え盛っている。\n炎が放つ光がレオーネの瞳に映り、絶えず跳ね、弾け、飛び散る。\nそれでも、彼の目の奥の冷たさを溶かすことはできなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "あとは……俺とお前だけになっちまったな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "遅かったな、あのサンクタの爺さんはもう行ってしまったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……どこへ向かった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "採掘工場だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなたたち大丈夫？　その怪我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気が早い傭兵",
      "text": "平気だ、あいつは手加減してやがったからな……くっ……もう少しで捕まえられたのによ、クソッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不本意な傭兵",
      "text": "……ひとつアドバイスだ。もし奴に遭遇したら、左肩を狙って集中的に攻撃してみるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "えっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……ありがとう。それじゃ、わたしたちは先に進むよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "……急げ……急ぐんだ、俺……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "爆薬を壁に貼りつけながら、レオーネはどんどん溢れ出す額の汗を手で拭おうとしたが、高温のせいでさらに多くの水分が皮膚からにじみ出る。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "急げ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼の唇はひび割れ、唾液程度ではもはや潤すことができなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "急げ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "また一つ、爆薬を壁に貼りつける。そしてまた一つ、さらにまた一つ……\n激しい炎が彼の目の奥に絶えず光を射し込ませる。彼の魂はまるで二つに分かたれたようになって、その半分は彼の体が動き続けるのを支え――\nもう半分は体を離れ、燃焼室の前で燃え盛る烈火を見つめている。\n次の爆薬を貼りつけた時、炎の中から何者かが近づいてくるように見えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "わしと一緒に行こう、レオーネ。開拓地へ行くんだ、そこにわしらの新しい家がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "マイルズ……待て、どこへ行くんだ？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "また一つ爆薬を貼りつけた時、マイルズは身を翻し炎の中に消え、今度は別の小さな影が現れた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベニー",
      "text": "僕はデイヴィスタウンを出て行くよ。ここに残りたくないんだ。ごめん父さん、もうそばにはいられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ベニー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "行かないでくれ……俺にはもうお前しかいないんだ……カールみたいに俺のそばから離れないでくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "また一つ爆薬を貼りつけた時、炎はベニーの姿を飲み込んで、揺らめきながら背の高い青年になった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カール",
      "text": "父さん、良いニュースだ。ある傭兵企業が俺を見込んでくれて、そこで働けることになってさ……数日後にはここを発つつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ダ……ダメだ、行くな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "戦場に行ったら、お前は死んでしまうんだぞ、カール！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "また一つ爆薬を貼りつけた時、その青年は火花と化して、周囲に飛び散った。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "やめろ……カール、戻ってこい！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "そして、最後の爆薬が貼り付けられた。\nまばゆい炎の中から、一人の女性が現れる。彼女の顔などもう覚えていなかったが、その声を彼は一度も忘れたことがなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "母さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性の声",
      "text": "レオーネ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性の声",
      "text": "もう行かないと。ごめんね……あなたを育ててあげられなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "母さん……謝らないでくれ、俺はここで元気にやってるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性の声",
      "text": "ごめんなさい……最後にあなたを一人でここに置いて行ったりして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "違うんだ、母さん。俺はここで家庭を持ったよ……ここのみんなが俺の家族なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性の声",
      "text": "さようなら、レオーネ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "母さん、行かないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "俺と一緒に……ここにいてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "レオーネさん、そちらの状況はどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "爆薬の設置は完了した……点火すれば動力炉は一瞬で爆破される。エネルギータワーが崩壊すれば、あの隠し通路はもう誰にも見つからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "了解です。レオーネさんはいつ脱出するんですか？　付近の傭兵は誘導しておきましたから、わたしも今そちらに向かっています。もうすぐ迎えに行けるかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ジェシカ……来なくていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "もう脱出したのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "いや、ただ……俺はもう、どこにも行きたくないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ジェシカ、シルヴィアに伝えといてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "嫌です……わたしは伝えません。自分で彼女に話してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "あの子は……賢くて、若くて、とても良い子だ。開拓地に行ったらいい男を見つけて、もう一度思いきり恋をすればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "彼女には幸せになってほしいんだ……ったくよ……なんで俺は今まであんな態度を取ってたんだ？　もっと早く知ってりゃな、まさかカールが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "カールさんが……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "いや……何でもない。彼女にこう伝えといてくれ。何年もカールのことを想ってくれて、愛し続けてくれてとても感謝してるって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "だが、カールはもういない……いなくなっちまったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "生きている人間には……違う選択肢があるべきだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "生きている人間は……死んだ奴に足を引っ張られるべきじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あなたにも違う選択肢があるべきですよ、レオーネさん。生き延びてここを離れ、新たな生活を始めましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "お願いだから馬鹿な真似はやめて、ウッドロウさんやヘレナさんのことを考えてください！　二人がどんなに悲しむかを……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それとベニーもです！　彼は進学できたそうですよ！　大人になった彼を見たくないんですか？　将来有望なあの子に……もう一度会いたくはないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "マイルズさんだって……あなたを待ってるんですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "でも彼女は……彼女は俺に残ってもらいたがってるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "誰がですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "♪彼女は両腕を広げ、僕を迎え入れた♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "♪僕の家も夢も、すべてはその腕の中♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "聞いてくれ、ジェシカ。俺はここを離れられない……あの人が、雨の降る春の日に、俺をこの場所に残していったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "あれは根を下ろすにはぴったりな日だった。俺はもう……あまりに深く根を張りすぎて、誰にも引っこ抜けなくなってるのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "レオーネさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "もう少ししたらでっかい音がするから、耳を塞いでおけよ。別に怖がる必要も、悲しむ必要もないからさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "俺の人生が始まったのは、生まれた日じゃなく、ここにやって来た日なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "そう思うと、この命も俺が死ぬ日じゃなく、ここを離れる日に終わる……そういうもんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "レオーネさん、お願いです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "心配するな、ジェシカ。俺は死なない。なぜなら俺は永遠にこの地に残り続けるからだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "彼女の抱擁の中で、永遠に生きていくんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ダメ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "頭上高くに爆音が轟いた後、強烈な衝撃波がジェシカを地面に押し倒した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は必死に立ち上がり、両足を動かして前へ走ろうとしたが、体がこれ以上ないほど重く感じ、進むことができなかった。\n遠くを見上げたジェシカは、タワーの巨大な裂け目から濃い煙がとめどなく溢れ出てくるのを目にした。\n火花混じりのがれきが、重いハンマーの如く容赦なく地面へと叩きつけてきて、付近の建築物は変わり果てた姿になっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "いや……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "遠くから吹く身を切るような冷たい風が、彼女の視界をにじませ、目尻を凍りつかせた。\nおぼろげな景色の中、彼女は指を伸ばし、何かをつかもうとした。\nまばたきをするうちに、視界が次第に鮮明になる。そして彼女はひとひらの雪を見た。\n雪が降り始めたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あれって……動力炉の方向？　急いでフランカ、もっとスピードを上げて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "わかってるわよ！　しっかりして、このオンボロ車！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "これは……うまくいったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ジェシカ……そっちの状況は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "レオーネ……応答して……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "……信号が受信できない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "くっ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ヘレナは足を止め、振り返ろうとした。\nしかし、ただでさえ脆い地下層の構造は地上の爆発による激しい衝撃に耐えきれず、壁の亀裂は彼女の視界の果てまで延々と伸びている。\nまるで、振り返るなと繰り返し彼女に警告しているかのように。\nそして彼女は、ついに振り返ることなく必死に走り続けた。\n深いトンネルへ――目の前の未知なる闇へと飛び込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "……つくづく、俺も歳をとったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "あの程度の爆発も避けられんとは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "あれは……エネルギータワーの方向か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "よう、ジェシカか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ウッドロウさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "エネルギータワーはどんな状況だ？　ヘレナはもう地下通路に入ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "何が起きた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "レオーネさんが……あそこに残ると……離れたくないと言って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "出てくるところも確認できていないんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ギリギリまで待ったんですが……結局迎えることは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "……ヘレナはもう知ってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ヘレナさんには……連絡がつきません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "泣いているのか、ジェシカ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……わたし、泣いてるんですか？　……ほんとだ、涙が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "はあ、これですべて終わったな。お前はきっと大丈夫だろう。お前はBSWの人間だし、ブリンリーの子だ。あいつらには、お前をどうにかすることなんざできまい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……どこかへ行くんですか、ウッドロウさん？　そっちに……合流してもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺にはまだやることがある……お前を連れて行くのはちと都合が悪いんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……また会えますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "かもな……きっとまた会うこともあるだろうさ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "壁にもたれかかったウッドロウはめまいを感じた。肩の火傷がズキズキと痛む。\n彼はポケットの中から弾を取り出した。暗い月明かりの下では何も見えず、ウッドロウは指の腹でその模様を撫でてぼんやりと感じ取るしかなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "（ラテラーノ語）「許し」か……まったくその通りだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "心が許せないものは、弾を使って許すしかない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
