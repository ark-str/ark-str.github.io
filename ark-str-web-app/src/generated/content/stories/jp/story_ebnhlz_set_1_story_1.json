{
  "server": "jp",
  "storyId": "story_ebnhlz_set_1_story_1",
  "groupId": "story_ebnhlz_set_1",
  "stageId": null,
  "title": "灯の隻影",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_ebnhlz_1_1.txt",
  "sourceHash": "6969425538a5117a5ff324ec8a94c6445cb9bad4348c852b95d7191aa594d477",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ウルティカ伯爵、明日の午前に予定通りヴィセハイムの移動が停止しましたら、私が市議会を代表して首都まで同行いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "今回アフターグロー区で発生した事件についての閣下に対する査問には、私が付き添うことになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "また、規定に則り、閣下は本日の日没までは、ヴィセハイム内を自由に行動することが許可されております。身辺整理や親しい方への挨拶などございましたらその間に済ませてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "なお閣下の身分の特殊性及び本事件の重大さを鑑みて、閣下のヴィセハイム内での行動には、常に私が随伴することになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "随伴？　貴殿ならば「監視」という、より直截的な言葉を使う程度の誠実さは持ち合わせていると思っていたがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "（肩をすくめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "どこへ向かうご予定でしょうか？　可能であれば、事前にお知らせいただけるとありがたいのですが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "知らせる義務があるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "僭越ながら、閣下の発言は一言残らず私が記録しておりますことをお忘れなく。今後の閣下の処遇に関わるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "もうよせ。こんな話はどこぞの密偵殿に言われた方が幾分マシだ。貴殿に比べたら、あいつの方がまだ人間味がある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アフターグローホールは変わらずそこにあったが、今は静寂のみが広がっていた。\nホール前の広場にはほとんど人気がない。周囲にはラフな服装に反して鋭い目つきで辺りを警戒する者が数名いる。"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "どうかお願いします、ホールの中に……少しの間でいいんです、見逃してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "私服警官",
      "text": "平民はダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "ギャレは、この場所で息を引き取ったんです……俺は、ただ彼が好きだった歌を――『明日の旋律』を歌ってやりたいと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "私服警官",
      "text": "ダメだ、立ち去れ！　今は音楽の演奏は禁じられているんだ、命令に違反する気か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "本当にただ歌うだけなんです。アーツなんてものは使えません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "私服警官",
      "text": "ただちにここから立ち去れ、さもなくば痛い目に合うぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "どこへ行くおつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "あの者は、平民は通さんと言ったな？　私は貴族だ、代わりに入ってやる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何だ、邪魔をする気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "お忘れですか？　閣下は以前、平民を連れて無理やり楽器店に押し入るという蛮行に及んだ前歴があるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "幸いにもその件は大ごとにはならず、深く追及する者もおりませんでした。それに、一度ならば若気の至りと言い逃れることもできましょう。しかし二度目となればそうはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "どうやら……閣下の心中においては、すでに貴族と平民の境目が曖昧になりつつあるようだ。決して許されぬことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "頭が冷えたようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "報告書にもきちんと記載しておきます。ウルティカ伯爵はご自身と平民との過度な接触が、悲劇の原因の一つだったと気づきつつあると――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "閣下！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "エーベンホルツさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "いや、ウルティカ伯爵と呼ぶべきでしたね、申し訳ありません。悲しさのあまりで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "よせ……そんな風に呼ぶな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ギャレのことは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "それ以上は言わないでください、わかってます。閣下に悲しんでもらえて本当にありがたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "ですがどうかそれを口には出さないでください。奴らの……監視の目がありますし、聞き耳を立てられていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "そうだ、ツェルニーさんは明日、このアフターグロー区を離れるらしいです。お会いになりますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ツェルニーが？　ここを出ていくのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "ご存知ありませんでしたか？　病状があまり芳しくないみたいで、ハイビスカスさんがロドスへ連れて治療するだそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そうだったのか、情報に感謝する。早速この後に訪ねるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "それと……お悔やみを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "ええ、ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "行くのならば急ぎましょう……あまり他者に迷惑をかけないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿らに迷惑をかけるのはむしろ本意だがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "あの感染者に迷惑をかけた自覚はないのですか？　本当に心から彼らを気にかけるのであれば、彼らと距離を置くのが最も賢明な判断かと存じますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "エーベンホルツさん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "今までどこにいたんですか？　私もツェルニーさんも、すごく心配してたんですよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "ハイビスカスさん、聞くだけ無駄ですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ツェルニーはエーベンホルツの背後を示すように顎を動かした。そこに佇む貴族は、ツェルニーの行動に口をつぐんだまま、なんの反応も示さない。"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ツェルニーはロドスへ向かうと聞いたのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はい、その通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "それは私の中の貴殿のイメージとは……かけ離れているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "さすがはウルティカ伯爵というべきでしょうか。着いて早々手厳しいお言葉ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "悪い方にとらないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "いえ、ちょうどよかった。私もあなたが軟禁されていたこの頃の話を聞いてみたいと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "無礼な平民め、言葉に気をつけろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "……ええ、気をつけましょう。それで話を続けても構いませんね、高尚なる貴族様？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "ともかく、私にはアフターグロー区を離れる理由が三つほどあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "一つは、身体の状況が思わしくないこと。ハイビスカスさんの仰る通りです。まだ寿命を引き延ばせるのなら、未来を簡単に諦めるべきではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今の言葉は記録すべきだろうな。本当に血を吐きながら曲を書き続けていたあのツェルニーの口から出たセリフか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "私らしくないとは自分でも思います。責任はハイビスカスさんにあるでしょうね。こういう話を延々と私に吹き込み続けて止まらないですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "まあとにかく、理由の一つは治療のためです。そして第二に――今のアフターグロー区にいては、私は何もできないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何もできないだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "市議会はすでに区全体を管轄下に置いています。奴らは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ンッ――ゴホンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "彼らは、私たちのことをとてもよく考えてくれております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "事件から二日目、彼らは公共の場における音楽演奏を禁じました。いわく「アーツによる犯罪行為防止のため」だとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "このごろ頻繁に、アフターグロー区の楽器店で抜き打ちの検査が行われていましてね。何件も、無期限の営業停止を言い渡されています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "市議会にも交渉に出向きたかったのですが、自宅でピアノを弾いているというだけでも彼らは……「ご丁寧にも」我が家へ踏み入りましてね。この前はウルズラにまで手を出す始末でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "なんだと。気が触れたのか、連中は！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "思うに、彼らは責任から逃れたいだけで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "憶測は慎みたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ウルティカ伯爵、この件は平民の前で議論するような内容ではございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "では二人きりの時にでも、また説明していただこうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "奴のことは気にするな、ツェルニー。三つ目の理由は何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "これこそが最も重要な理由です。私は、自らの作品にこれまでとは一味違う何かが必要だと考えるに至ったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "あの事件の後、私の胸中は言い表せない感情で溢れ返りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "今までにない……真新しい何かに触れることで、私の音楽の語彙がさらに広がり、それによってようやくこの感情を少しは表現できるかもしれないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "どうやら、今日初めていい知らせを聞けたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "応援しているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "エーベンホルツさんは、これからどうするつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "そちらのお嬢さん、話題を変えることをお勧めします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "では、どこか行きたい場所はありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "行きたい場所？　私が行ける場所などもはやどこにもないだろう。明日には移動都市も停止して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "閣下、機密漏洩は重大な犯罪行為ですぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "聞いての通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私が何とかします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何とかするだと？　バカな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "機密漏洩は重罪であるが、リターニアには星の数ほどの規定が存在する。今の私は、単に機密漏洩という一条に反しなかったにすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私への判決はまだ下されてはいないんだ、ただ待つことしか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "これは最後の警告ですぞ、ウルティカ伯爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "つまり、なんだ……そういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……方法はあるはず、きっとあるはずなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ロドスへ戻ったら、ドクターに尋ねてみます。あの人なら何か手を考えてくれるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ドクターというのは、それほどまでに優秀なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はい、とっても！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そんなに優秀な人物が、どうして私などのために労力を割くというのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "エーベンホルツさん、自分を卑下しないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もしも今回の陰謀に巻き込まれたのが誰か別の人だったら、ヴィセハイムはもっと大変なことになっていたはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あなたは覚悟を決めて、状況をくつがえすために戦ったんです。あなたがいなければ、大勢の人たちが……私も含め、今頃もう生きてはいないんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ありがとう。君の気遣いに心より感謝する、ハイビスカス。だが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ご事情がひと段落したら、エーベンホルツさんもロドスへいらしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私が？　ロドスへ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "忘れたんですか。あなたも今や感染者なんです。私やツェルニーさんと同じく、治療を必要とする状態なんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ロドスは陸上艦です。一か所に留まることはないし、規定のルートもありません。多くの国々を渡りますし、もしかしたらこの大地の果てまでも辿り着いてしまうかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "それに、ロドスはとても広いんです。色々な人がいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私の妹のラヴァちゃんを覚えていますか？　あの子も私の健康食が苦手だなんて言ってます。あなたとは話が合うと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ですからエーベンホルツさん……すべてが終わったら、ぜひロドスへ来てくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……それが可能なら、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "元気出してください。そんなに落ち込まないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "クライデさんの言っていたことを、思い出してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あんなにも、精一杯の言葉を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "彼の遺した言葉を、忘れてはいけませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "いや、忘れてはいない……忘れられるものか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "それじゃあ……彼の言葉通りにやってみてはどうですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クライデがよろよろと広場の中央へと向かう。\n一歩進むたびに、源石結晶が彼の体内からうねるように飛び出し、彼の血肉は皮膚の下で絶え間なく逆巻いていた。\n奇怪な旋律が広場で鳴り始めた。\n結晶はあっという間にクライデの全身を覆い、鎧となり、楽器へと変わった。\nそして、クライデと呼ばれていた存在は一瞬にして消え失せ、それに取って代わったのは――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハッ――！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私は……また気を失ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハイビスカス、ハイビスカス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ツェルニー、ウルズラ？　どこにいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ウルティカ伯爵、お目覚めですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハイビスカスは？　ツェルニーはどこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "あの平民と彼の使用人には、すでにここから出てもらっています。サルカズの女性も同じく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ここはツェルニーの家だぞ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "「雨風をしのぐため、陛下より下賜された家」にございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "これも閣下やあの者どもを思ってのことです。もしあのまま交流を続けていたならば、彼らが明日、このヴィセハイムを無事に立つことを保証できかねますのでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "この卑劣漢が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "他にまだおっしゃりたいことはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "話すことなど何も――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "いや、先ほど話した約束があったな、忘れるところであった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "なぜ市議会はアフターグロー区における音楽の演奏を禁じた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "それは市議会の法令が施行されたため――ただそれだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "彼らが進んでこのような法令を成立させるとは思わない。アフターグロー区とてヴィセハイムに税を納めているだろう。なのになぜ自らの財源を断つような真似をする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "無論、模倣犯を防ぐためでございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "もしそうだとしたら、先ほどツェルニーが理由を述べた際に、貴殿も満足げに鼻を鳴らしたりはすまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "彼が貴殿らの望み通りの言動を取ったからこそ、それに対して満足したのであろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……「女帝の声」がそうさせただろう、違うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "閣下、お戯れはほどほどに。言葉を慎んでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハズレか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "つまりどこかの選帝侯の仕業か。たとえば、かのゲルトルーデの領主あたりが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "貴様――閣下！　暴言が過ぎますぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "なんだ、貴殿も動揺するのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "どうやらその人物から相当の圧力をかけられているようだな。教えてくれ、その者は何を考えているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "よもやアフターグロー区の感染者たちには早急に消えてほしいが、おおっぴらに動いて女帝を刺激したくはないという、卑劣な思考でこのような手段をとったのではあるまい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "おやめください！　私は何も存じません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そうだな……たかが一介の市議会の行政だ。そこから選帝侯閣下の企みを見透かすことなどできるはずもないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "お話は終わりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ならば私からも一言述べさせていただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ただちにクリフィーパティオ区のご自宅までお戻りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "封鎖区画に立ち入り、平民を扇動して現場を混乱させ、部外者と接触して機密情報を流した……報告書にこれらのことを書かれては、格好もつきますまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿が私の身を案じてそのような提案を持ちかけるとは思えんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "まさかとは思うが……私についての報告書の内容がまずかったら、貴殿らの面子にも傷がつくと考えているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "とぼけても無駄だ。私は貴殿のような者のことをよく知ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ウルティカにいた頃、私が何か揉め事を起こすのを最も恐れていたのは、いつも私の「代理」や「従者」であった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "言ってみろ、貴殿らは私に残された時間をどう過ごしてほしい？　何かいいプランはあるのか？　腹の内を明かし合った方が、お互い都合がよかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ご自宅へお戻りください、私の要求はそれだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "日没までなら自由に行動してもいいというのは、貴殿自身の口から出た言葉であろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "規定ではそうなっております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "しかし本当に身の程をわきまえた人間であれば、私の言った通りに振舞うはずですよ。命令を受け入れることで、自分が心から反省していることの証明になるのです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ですが閣下は、死んでも従う気はないご様子だ。まるで脳内が妄想で満たされた平民の――いや、飼いならされることを拒む獣のようだ。ほとほと嫌気が差します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "いい加減に目を覚ましてください、ウルティカ伯爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "おとなしくお戻りください。報告書もなるべくあなたの不利にならないよう穏便に書きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "嫌だと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そうなれば私の悪口を延々と書き連ねるのだろうな。そして同時に貴殿は自分の管理能力の欠如を喧伝するわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "チッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "貴様と奴とは血が繋がっていると聞いてはいたが、どうやら貴様ら一族の狂気は代々受け継がれるようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ついに「貴様」と呼ぶか。身に余る光栄だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "尻が青い小僧が、思い上がるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "たかが傀儡の伯爵ごとき何ほどのものか。貴様は「貴族の報告」というものを知らんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "自分の責任を回避しながら相手を陥れる方法なんて山ほどある。私は簡単に貴様を終わりない苦しみに叩き込めるんだ！　自分の立場を理解したか？　ならとっととあの快適な牢獄に戻れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "生憎と、陽はまだ沈んでいない。行きたいところへは行かせてもらうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "付いてくるがいい、誰も見ていない所でしか牙を出せぬ臆病者め。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エーベンホルツは路地を駆け抜けた。\n追ってくる者を振り切ろうとは考えなかった。\n振り切れたとしても、また監視者として新たな「尻尾」が湧いてくるだけだ。付け回されることに変わりはない。\nそれに、たとえどうにか連中の干渉と抑圧を退けて、完全に解放されたとしても、もはや自分の行ける場所なんてどこにも……\nどこにも、ないのか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "知らず知らずの間に、エーベンホルツの両足は彼をその場所へと導いていた。\n見慣れた扉と、それを封鎖する見慣れぬ規制線の存在が彼を躊躇わせる。\n「尻尾」は離れた場所で息を切らしながら佇み、憎々しげに彼をにらみつけていた。エーベンホルツは規制線を乗り越えると、扉の中へと入っていった。\n彼が屋内へ消えていったのを目にした「尻尾」は、息せき切って後を追った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すべてがあのコンサートの前と何一つ変わっていなかった。\nグラス、食器、ヤカン。\n煤けたかまど、ぼろぼろの家具、ボロボロのベッド、それと……床に敷かれた粗末な寝床。\nエーベンホルツはふと、そこで寝るのがどんな感覚なのか知りたくなり、横になってみた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "痛み――体中が痛い。\n彼は硬い地面に拒絶されているかのように、背骨の一つ一つに圧力を感じた。\nほんの数秒横になるだけで、まるで脊椎が折れてしまうかのような感覚を抱いていた。\n「尻尾」は動物を見ているような軽蔑の眼差しを彼に向けた。彼もまた同じくらいの悪意で見返した。\nこの時、エーベンホルツの脳裏には「尻尾」の言葉が蘇っていた。そして「尻尾」の言う通り、自分は恐らく決して抜け出せぬ苦しみに叩き込まれるだろうと、彼は思った。\nだが彼は恐れてはいなかった。\nそれどころか、もはや興味もなかった。\n彼は運命が自分に用意した道に対して何も感じなくなっていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少年時代――他の子供たちが太陽の下で駆け回っている頃、エーベンホルツとクライデは、一歩一歩迫り来る死を前にして、平静を装う術を学んでいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "狂った実験の被験者として、何とか生き延びた後、彼らの一人は籠の中の羽獣として成長を遂げ、もう一人はドブの中のオリジムシにも劣る環境で生きることになった。\n彼は恐怖に苛まれる中で自由を渇望したが、クライデは衣食以上の何かを求める力すら与えられなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……そして数年後、彼らは再び巡り会う。\n二人はコンサートに向けて共に努力することを決めた。\n不幸はここで終わるべきではないのか？\nすべてが終われば、彼は元の傀儡伯爵の身に戻り、クライデは金と少しばかりの名声を手にして、祖父の病気を治すはずだった。\n自分たちは、この大地で決して独りではない。彼らはそう胸に刻み込むはずだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そうして、彼らはあのステージに立った。\n互いに、互いのため、すべてを捧げる覚悟を決めていた。\nこのような物語では、決まって主人公の二人が奮闘の末に、新たな人生を手に入れるものだ。\nたとえこれが悲劇で、運命が二人を虐げることは避けられなかったとしても、物語の幕引きは二人ともがこの世を去るという結果であるべきだ。\nだが運命はクライデに、彼のために死ぬことを強いた。自らが命を捧げようと決めた男の手によって死ぬことを。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "運命はクライデの命を奪い、なおも彼の死を、無価値なものに貶めようとした。\nツェルニーはアフターグロー区を離れ、治療を受けねばならない。\n自分はこうして生きてはいるが、すぐに首都へ向かい、沙汰を待つ必要がある。\nアフターグロー区は音楽を封じられた。亡くなった者たちへの哀歌を捧げることすら許されない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "クライデさんの言っていたことを、思い出してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "彼の遺した言葉を、忘れてはいけませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "クライデの言葉――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私は……忘れてしまったのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "エーベンホルツ、生きてください。あなたは長い夜を乗り越えなくてはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "不公平な運命に抗い、諦めることなく、他人のために手を差し延べてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "そうして初めて、腰を下ろした時に、僕を思い出すでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "僕はあなたに尋ねます。エーベンホルツ、今日はどうでしたかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "そしたら、あなたは胸を張って答えるんです。また充実した一日を過ごしたと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "あなたは、自分の良心にしたがって行動するときに遭遇した障害について僕にぶちまけて、運命はやはり自分の味方をしてくれないと文句を言うでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "でも大丈夫です。僕はあなたのどんな言葉にも耳を傾けますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "だってあんなに努力しているんですから。ふふ、文句を言ったって当然ですよ、罰は当たりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "これならあなたはこの大地が与える苦しみに負けることなく、日々の生活の中で安らぎを得られるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "覚えておいて、エーベンホルツ。僕たちはかつて共に不公平な運命に抗いました。しかも勝って、運命を乗り越えてここにいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "だから僕を思い出した時は、泣くのではなく、笑ってくださいね。絶対ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "さようなら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "いや、嫌だ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "嫌だッ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "うるさいぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ん？　泣いているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ようやく自分の境遇が理解できたのか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エーベンホルツが部屋のタンスを開けると、引き出しの中にチェロの弓がぽつんと仕舞われていた。クライデの先生が記念として彼に贈ったものだ。\n彼は弓を丁重に包むと、そのまま体に括り付けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿は事件現場に到着した時のことをまだ覚えているか？　あの時私が持っていたチェロを没収しただろう。あれはどこにある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "あれは重要な証拠品だ。すでに我々が保管してあり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿があのチェロを持ってホールへ入り、しばらく中にいた後、手ぶらで出てきたことがなぜか記憶に残っていてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "でたらめを言うな、貴様――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "戻れ！　もう日が暮れるぞ、これ以上どこへ行くつもりだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "先ほどの感染者がまだそこに残っていたが、もうホールへ近づこうとはしていなかった。\n魂が抜けたかのように広場の外に佇んでおり、吹けば飛んでしまいそうな様子だった。\n彼はエーベンホルツが来たことにすら気づいていなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "規制線を突破するつもりか！？　そいつはさっき貴様が越えたものとはわけが違うぞ、それは「女帝の声」によって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ギャーギャーとやかましいぞ、「尻尾」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "アーツユニット！？　貴様まさか――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "残念なことに、私は人を黙らせるようなアーツは使えん。この点においては貴殿らに及ばない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "だが貴殿をしばらくその場に留まらせる程度なら、私にも可能だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "はっ、私服警官までやってきたか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "これで誰にも邪魔できまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ところで、「尻尾」殿。もしかして貴殿は私のチェロをホール内に隠したのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "その中は完全立入禁止区域だ。むやみに入ったりしたら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "残念だったな。ホールの正門後ろに一挺のチェロが置かれていた。私がクライデに贈ったものとそっくりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "灯台下暗しというやつか、「尻尾」殿。貴殿も案外頭が回るじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "そのチェロを下ろせ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "聞けぬ相談だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "弓がどこにやられたのかはわからないが、ちょうど手元に代わりのものがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "さて、この『明日の旋律』をあの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "いや、違うな。すべての者に捧げよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（小声）そして君にもな……クライデ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（小声）明日を待つまでもない。今夜、私は君に文句を言ってやることにしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（小声）嫌というほどの文句を言うぞ。君が呆れるくらいに、私の声を聞いただけでうんざりするほどに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "これは……『明日の旋律』か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "ウルティカ伯爵、これは犯罪行為だぞ！　またアーツでヴィセハイムに災厄をもたらすつもりか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "違うぞ、「尻尾」殿。これはただの演奏だ。私はアーツなど使ってはいないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "続けて弾くぞ。貴殿らが聴きたくもないであろう感染者の歌を、一曲一曲、奏でていくのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "聴くのが嫌だというなら、耳を塞げばいい。なぜ他人の演奏を止めるために弦を押さえるのだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "うなだれる感染者",
      "text": "あれは……ウルティカ伯爵？　彼が演奏しているの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "伯爵様……いや、エーベンホルツさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ感染者",
      "text": "エーベンホルツさん、ありがとう、この曲を奏でてくれて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する感染者",
      "text": "いいぞ、エーベンホルツさん！　俺たちゃみんなここで聴いてる、聴き続けてやるんだ！　いや、むしろ俺も一緒に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "待て、そこの君。楽器を置くんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する感染者",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "市議会は許可なく演奏することを禁じている……私と共に弾くのはやめた方がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する感染者",
      "text": "でもよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今日の件は私個人の問題だ、みなが巻き添えになる必要はない。ただ聴いてくれればそれでいいんだ、わかってくれるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "エーベンホルツさん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "悲劇の後、音楽が禁じられたこのアフターグロー区で再び音色を奏でたのは……あなたでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "この区を代表してあなたに感謝の意を表します。だが今すぐ止めなさい！　あなたの立場はすでに危うい状態にあります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "気遣いに感謝する。だが止めるわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今日は私の特別公演なのだ。私の見せ場を奪うことは、断じて許さない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "エーベンホルツさん、早まらないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハイビスカス、それは違うぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君はクライデの言葉を忘れるなと言ったな？　君のおかげで、思い出したのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "運命はかくも不平等だ。これまでの私は、悲しみの中に耽溺しすぎていた。抗うことすら忘れるほどに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "だが今、思い出したのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "誰かが言葉を奪われているのなら、私が代わりに声を上げよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "誰かが弔うことを禁じられているであれば、私が代わりに花を供えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "誰かが私を貴族という名の高塔に閉じ込めるなら、たとえこの身が砕けようとも、忌々しい塔を打ち壊してくれよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "貴様――それは大逆罪だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "いい機会だ、「尻尾」殿。貴殿の報告書の中に、この言葉も書き加えておけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "どのような処罰が下されようと、この命が奪われない限り、私は必ずやリターニアを抜け出してやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "それから――私は貴族として生きることを拒絶する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "この先、牙を抜かれ飼い殺しに甘んじて貴族の生を送ることを唾棄する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷淡な貴族",
      "text": "血迷ったか、こんなことは前代未聞だぞ、貴様は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何とでも言うがいい！　熟考した末に、血迷った道を選んだとでも思え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "だが今、『明日の旋律』はもうすぐ奏で終わる……さあ、親愛なる感染者の兄弟姉妹よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君たちの顔をよく見せてくれ、君たちの好きな曲は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "『金の杯と銀の匙』だな。覚えているぞ、そこの後ろの髭の方、君はこの曲が好きだったろう。次に演奏する曲はこれに決まりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "その次、三曲目は――『真冬の旅』だ。そちらの気丈な仕立て屋のお嬢さんに捧げよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "四曲目は『ピアノソナタ第81番　ヘ長調「自由への賛歌」』を、あなた自身に捧げよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ビーグ――！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "いいだろう、私のチェロの腕前で弾ける範囲でよければ。四曲目はそれに決まりだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "では、まずは『金の杯と銀の匙』！　どうかご清聴を！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "............\n弾き慣れないチェロで、彼は一曲また一曲と弾き続けていった。\n市議会の者が現場に押し寄せてくるまで、感染者たちは狂ったように広場で泣き、笑い、弔った。\n彼も一緒に。\n目尻に涙を浮かべながら、笑っていた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
