{
  "server": "jp",
  "storyId": "act13d5_level_act13d5_07_end",
  "groupId": "act13d5",
  "stageId": "act13d5_07",
  "title": "ミェシュコグループ",
  "storyCode": "MN-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13d5/level_act13d5_07_end.txt",
  "sourceHash": "a91634187bae7d1681c591b1c735455beefc06e2c32620f7813c4774e0108db9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔 7下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 4:12 天気/曇天 ファイヤブレード競技場\n独立騎士マリア・ニアールと“レフティ”タイタス・トポラとの試合が始まってから1時間27分後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これは実に……珍しい局面です――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "何度打ちのめされても、どれだけ血と土にまみれても、諦めることなく立ち上がってきた！　我々の瞳に映る「光」は、まだ消えてはいません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "たった一筋の輝き――真夜中にぽつんと光るロウソクのように……タイタスの繰り出す、闘志ごと打ち砕かんとする猛撃の下で――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "今なお、その光は消えてはいないのです！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "はぁっ……はぁっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "貴様……まだ立ち上がれるというのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "最小限のアーツで傷口を塞ぎ、消耗を抑え、勝機を窺うなど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "長時間、心身をギリギリのラインで保つ感覚は、どんな味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "はぁっ……はぁっ……わるく、ないかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "強がりを――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "所詮、小手先だけの技に過ぎん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ふっ――防いだ！　ついに、ここに来て初めて、マリアがタイタスの攻撃を防ぎました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "バカな……私の攻撃が逸れただと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "いや、ど真ん中だったよ……ただ、最初ほど重くはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "はぁっ……あなたも、疲れるんだね。タイタス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "私が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "確かにな……貴様のせいで随分と時間を無駄にしてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "そろそろ終わりにしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "また左腕の攻撃だ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "やっぱり迫力がまるで違う……このままじゃ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "はぁっ、はぁっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "ふんっ、貴様の小細工はもう読めている。これ以上チャンスをくれてやる必要もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（間に合わない――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "タイタス、怒涛の連続攻撃だーーー！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "もうこれ以上、マリアに息をつく暇すら与えないということか？　残された微かな光も、ここでついに消えてしまうのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客A",
      "text": "あの子……生きて帰れるのか？　一方的でつまらない試合だ。こういうのはもう飽き飽きだってのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客B",
      "text": "……あの子、マリア・ニアールって、前々回の優勝者の妹だよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客A",
      "text": "そうなのか？　でも数年前にカジミエーシュでメジャー大会を見たときは、もっとレベルが高かったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客B",
      "text": "だけど、窮地に立たされてからの一発逆転は、レベルには関係なく見ごたえあると思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客A",
      "text": "それはそうだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア！　立ちなさい！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "目が、霞んできた。\n目を瞑るな、マリア。\n一度閉じてしまえば、二度と開くことはできない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マリア、お前はペガサスの瞳を持っているんだ。\nマリア、立ちなさい。ほら、おいで。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お祖父ちゃん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "泣くな、マリア。\nニアール家の家訓を覚えているか？"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "「苦難と闇を畏れるべからず」……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "わしは過去を後悔したことはない。マーガレットが違う道を選んだことも誇らしく思う。"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お姉ちゃんのことを……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "わしらの一族は代々、苦難と闇に立ち向かう選択をしてきた。\nそして、マーガレットは最も苦難に満ちた道を選んだ。\nあの子は……マーガレットはお前に、自分の騎士道を語ったことはあるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "「騎士とは大地を照らす崇高なる存在」だって……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ふはは、なんと若い……\n闇を打ち払う――\n――「光」そのものになりたいとはな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……あと一秒で、この無意味な戦いから解放されたというのに……なぜ立ち上がった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ムリナール叔父さんの言ってたこと……間違ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "なんの話をしている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お祖父ちゃんの最期は……ため息だけじゃない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "深呼吸……深呼吸して、マリア。\nこのまま消耗戦を続けても勝てない。相手の傲りを、その油断を利用するんだ――\nお姉ちゃんの動きを思い出して。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一瞬……たった一瞬のチャンスを見逃すな！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "くっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "突然、目映い光が！　一体何が起きたのでしょう！？　これからの騎士競技観戦にはサングラスが必須なのか――！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "おーっと！　タイタスが初めて後ずさりしました！　これはアーツです！　まさしく、マリア・ニアールのアーツに違いありません！　ここに来て、アーツで勝負しようということでしょうか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "おっと！？　マリアの数字に少しだけ動きが！　それでも、比率はまだ圧倒的です。まさか、企業からの献金額にも匹敵するようなこの賞金が現実となり得るのでしょうか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "耀騎士……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……いや、悪あがきだ。ただの模倣に過ぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "貴様……このような恥知らずの行為には対価を払ってもらうぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "がんばれ！！　ニアール！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "おおい！　マリア・ニアール！　がんばれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア！　余計なことは考えないで――！　思い切りやるのよ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ものすごい声援です！　会場中がマリアに声援を送っています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "しかし、それでも――！　タイタスは余裕綽々でフィールドを闊歩しています！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "貴様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（防げた……！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "奇跡が再び起きようとしているのか？　すでに限界のはずなのに、圧倒的な劣勢を覆すとは！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "会場の皆様、刮目してご覧ください！　この試合の迫力と賞金プールの数字を！　間違いなく今シーズンで最も価値のある一戦です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "さぁ、今以上に大きな歓声と多くの賭け金を積み上げましょう！　眼前の競技騎士二人に、皆様の情熱の証を届けるのです！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "貴様――私の攻撃を防いだだと！　その半人前のアーツでか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "傲慢ですね。ああいった手合いには嫌気が差しますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "簡単に勝てたはずなのに、タイタスはニアールの尊厳を踏みにじることに固執し過ぎたあまりに、油断し試合をおざなりにしました。それが相手に付け入る隙を与えたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "そ、そうなのですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "やはり耀騎士の妹。あの「ニアール」の孫娘。ふっ……これまで、ニアールと言えば、思い浮かぶのはあの老いぼれだけでしたが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "しかし、廃れた騎士一族の悲しき現実よ……企業利益に比べれば、騎士一族の階級など、無価値の極みですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "その階級でさえ、今では協会が全ての認証権限を担っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "そしてその騎士協会は、私たちの傀儡同然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "先ほど、競技場に協賛企業の方々から相次いで連絡がありました。早く試合を終わらせろと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "タイタスが負けるのを恐れているのでしょう。もしそうなっても、問題はありません。大事なのは話題性です。その点についてはすでに大満足です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "チャルニー様はこの勝負、どうなるとお考えですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "ふっ……タイタス・トポラは、ブレイドヘルム騎士団の主力騎士。傲慢ですべてを見下していますが、その実力は確かです。そして、相手の闘志を削ぐことに長けています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "さらにこれまでの戦歴において、相手の降伏による勝利というものに味を占めているでしょう。ということは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者チャルニー",
      "text": "この試合、彼の負けですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "はぁっ……はぁっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（無駄に動いちゃダメ……もう足元も覚束ないけど……このまま……もう一度息を整えて……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "もういい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "（マリア……もうとっくに限界のはず……イングラとの戦いのときでさえここまでの傷は負わなかった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "――ここまで血を流して、歯を食いしばって耐えて来たじゃない、マリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "勝つのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "なんという屈辱か……貴様のようなゴミのために、ここまで時間を無駄にするとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "手足を完全に動かせなくすれば、貴様も大人しく許しを請うのか？　あの“ウィスラッシュ”のように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "――覚悟するんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "今だ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これもお姉ちゃんの真似。まずアーツ、それから腕をひねる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "でも――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "貴様……また防いだだと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "これは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "こ、これは偶然などではありません！　マリアが再び左腕騎士の猛攻を防ぎました！　これは一体！？　まさか、後がないニアールのことを、この期に及んでタイタスが弄んでいるのでしょうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……ふっ、なかなかやるな。どのような奥の手を隠しているのかは知らんが……関係ない。貴様の輝きは私がこの手で粉砕してやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "来いっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "皆様、左腕騎士が初めて構えを見せました！　そして、初めて相手に攻撃のチャンスを与えた瞬間です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "相手がニアール家の御令嬢と言えど、少し油断しすぎでは！？　いいえ！　タイタスをよく知る人ならそうは思わないでしょう！　この場にいる彼のファンの皆様もそうです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "しかし、今日は一味違います！　マリアの闘志は、今なお衰えてはいません！　その不屈の意志には、私でさえ涙しそうなほどです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ここにお約束します！　本日マリア・ニアールに賭けた皆様にはもれなく事後抽選のチャンスを差し上げましょう！！　当選確率はなんと0.2%！　このチャンスをお見逃しなく！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "――これでいいのかな？\n疲れ、恐怖、悔しさ、そして屈辱的な思いなどが積もり積もって、ここまで高まった今――\n彼女の脳裏にあるのは勝利の二文字のみ。考え得る限りの方法で最後のチャンスをつかもうとしてきた。\nしかしこの瞬間、自分が今まで追い求めていた勝利というものに、疑問が生じたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "マリア・ニアール……貴様は何のためにこの騎士競技に参加した？　栄光のためか？　富か？　それとも一族のためか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……自分のため。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ただそれだけだよ……タイタスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……ふん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "瞬時のフェイント、そして盾にアーツを集中させるテクニック。確かに貴様には……ペガサスの血が流れているようだな……チッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "お見事、ニアール……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "今シーズンの予選にて最長とも言える対峙の末――倒れたのはなんと――まさかの“レフティ”タイタス・トポラ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "誰がこの結末を予想できたでしょうか――！　果たして誰が！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "常識を遥かに超えるオッズと賞金！　その額はもはや、小さな会社を起業できるほどです！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これは、奇跡――！　まさに、奇跡です！！　マリア・ニアール、ニアール一族が再び奇跡を起こしました！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "観客たちは、皆待っていた。\nマリアが傷だらけの宝剣を掲げ、勝利宣言をするのを待っていた。\n巨額のオッズ、そして魂を揺さぶる一発逆転による、誰も予想だにしなかった結末――"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（これで終わり？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "騎士競技とはこういうものなの？　一体何に勝ったの？　そして何を得られたっていうの？\n名誉、富、それとも一族の復興？　いや違う。何かが足りない……そう、何かが足りない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "考える時間はほとんどなく、マリアは結局、歓声に操られるように高らかに剣を掲げた。\n腕から伝わる鮮明な痛みが、歓声による慰撫を打ち消した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（もう、立っていられない――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お、おばさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア……マリア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ゾ、ゾフィアおばさん……て、手を放して、痛いよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "あ、ごめんなさい……骨が痛むの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "うん……でも大したことないと思うから大丈夫……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア、本当にごめんなさい……君の覚悟を私は軽く見過ぎていたのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マーガレットと同じで、君も立派な騎士よ。自分の道は自分で選ぶべき――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "違う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "きっと……私はお姉ちゃんとは違う。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……マリアが勝ったか。四都市中全ての放送端末でこの結果が報じられるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "しかし……事はそんなに単純じゃないぞ。ムリナール、マリアの力になってやってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "おかしなことを……本当にマリアが心配なら、私に力になれと言うのではなく、騎士になろうなどという愚かな幻想を捨て去るよう、マリアを説得するべきではないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ムリナール！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "無理だ……もし、代弁者と騎士協会が直接関与しているとしたら、私にも為す術はない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "だから、マリアが競技騎士なんぞになるのは反対だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "マリアは一族のために決断したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "誰も頼んではいない……もっともらしい大義を言い訳にするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "責任感も時には要らぬ負担になる。賢く生きていくには、理性的であらねばならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ムリナール、君は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "それを言うために来たのなら、もう帰ってくれ。私は忙しいんだ、主任にオーダーされた文書作成がまだ終わっていないのでな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "魂までは死んでないと思っていたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "勝手に決めつけないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ムリナール、確かに君の言う通りかもしれない。だが失望したぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "それはこちらのセリフだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "君が、マリアの身に迫る危険についても関知しないというなら……ニアールの旦那様に代わり、マリアのことは私たちが責任を持つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "そんなものは、マリアをより破滅に導いていくだけだ……わかっているだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "これ以上話しても無駄だな……今日のことは忘れてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……あの姉妹たちがしでかしたことは、自分たちで始末させればいいのさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "……いつまで隠れていればいいんだ、ソーナ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "そう焦らないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "ここに長く留まれば……感染者たちが飢えていくだけだ……救えたであろう感染者の同胞の数も減るかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "だからと言って、今競技場に戻るのは危険過ぎるわ。国民議会の動きもまだわからないのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "国民議会……カジミエーシュに公平な判断などできるものか。法解釈を含めてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "それでも自分から法を破っちゃ絶対にダメ。たとえ真実を捻じ曲げる人がいたとしてもね。もし国民議会に罪人とみなされたら耀騎士と同じになって、そこで終わりなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "でも……ふふっ、きっとあいつらもびっくりしてるわね。正直言うとあたし自身、ここまでできるとは思ってなかったわ。ねぇ、あいつらは次にどう動くと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "もしかしたら目を付けられたのは感染者全員かもしれないわよ？　あたしたちがお金で買った全員が、ね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "……競技場で死ぬか、追手に殺されるかなら、結局どちらも大差はない。だったら賭けに出るしかないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "あはは、それもそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "でも、もう少し待ちましょ。少なくともニアールちゃんとその周りの人たちを巻き込む必要はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "……わかった、お前の判断を信じよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "というかさ、なんかあたしたちって、最初からずっと危ない橋ばっかりじゃない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "カイちゃん……怖くなんない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "ソーナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "私たちは、称号を授かり自由になることだけを夢見てここまで歩んできた。この両手は血に染まっているが、決して力を前に揺らぎはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "……その通りね。あたしの考え過ぎだったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "あぁ。私たちが共にいる限り、そして抗えるこの両手がある限り、絶対に大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "へえ、ずいぶん口が達者になってきたわね。「灰色の呪い」が見る影もないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰毫騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焔尾騎士",
      "text": "あら、怒らせちゃった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
