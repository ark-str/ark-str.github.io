  "sourceHash": "0cff803d4a4475ddb579b734cd6f0084a0eff5764459ad8f9b7a38edb9d41016",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "数ヶ月前 レユニオンと接触後\np.m. 10:14 天気/晴天\nウルサス 郊外の名もなき砂漠"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……レユニオンのリーダーたちに会ってきたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "どうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしに聞いてるの？　それともそいつ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしの感想としては、想像通りってところ。想像通りの奴らが、想像通りのことをやってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "そうね……何て言うか……風変りな集団だったわ。残酷な子供みたいなリーダーもいれば、見た目よりもずっとタフな戦士もいて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "確かに。すごい奴もいたけど、つまらない悪役みたいな奴もいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "簡潔に言えば、他でも見てきたみたいな、いろんな奴らの集まりってことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ただ一人、とても気になる人がいた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あー、あいつのことでしょ。ずっと小ウサギの近くにいた奴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あの部隊は、他の感染者たちとは全然違った。ああいうサルカズの戦士こそが、戦争の象徴に相応しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "――サルカズ？　レユニオンの幹部に、サルカズがいたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ええ。だけどあんなサルカズは珍しいわね。本人はウルサス人だって名乗ってたから、カズデルとはとっくに縁を切ってるんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そんなに疲れる生き方をするなんて……可哀想に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "――可哀想？　彼が？　彼はおそらく、「戦士」を超えた戦士よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "私たちはみんな、彼と話してみるべきだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "特にヘドリー。あなたはいつもあれこれ考えすぎるけど、ああいう人と話せば、それがいかに無駄な時間かわかるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あんなすごい空気をまとった人だもの。きっとほかにも、色んなことを学べるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前たちが言ってるのは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "邪魔する。君たちと、話したい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……噂をすればなんとやらってやつね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私が、誰かは、ひとまず、重要ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今の私は、レユニオンの、リーダーの一人、として、会いに、来たわけではない。安心、してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は、ただ、聞きたいのだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "同胞たちと、故郷に、起きたことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "カズデルで、何が、あったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "噂は、よく聞くが、詳しいことは、わからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたはウルサス人でしょ。そう言ってたじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私が、ウルサス人で、あることと、サルカズで、あることは、矛盾しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "血脈は、変わらない。闇は、根深い、ものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "気にかけたことは、ないが、それは、揺るぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "じゃああんたはカズデルのことを知って、どうするつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もう随分前のことよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何も、しない。何も、できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ただ、かつて、私は、テレジアに、会ったことが、ある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――へぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君たちの、反応で、わかった。彼女はおそらく、君たちに、生きた証を、残した。君たちも、サルカズだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "泥に塗れても、血塗れになっても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "彼女は、英雄だ。少なくとも、そう崇め、られている。彼女は、偉大な戦士、そして、稀代の君主だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は、ウルサスに、忠誠を誓った。私の種族は、カズデルを、放逐された。だがそれでも、私が、サルカズであることに、変わりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "彼女の、カズデルに、何が起きたか、知りたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "噂ではない、真実を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "現在 チェルノボーグ移動中\na.m. 5:22 天気/晴天\nチェルノボーグ サルカズ傭兵駐在エリア"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……何か用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "サルカズ傭兵部隊の弁明が聞きたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "まずお前の部隊が逃げ出した話だが、お前は逃げた隊員を全力で追わなかったそうだな。追撃した者たちから報告が上がっているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "さらに数時間前、チェルノボーグに敵が潜伏したのも、お前たちのミスによるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "それに加えて、チェルノボーグへの攻撃が開始された後、お前がわざと敵を見逃したという報告もある。たしか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もう、うるさいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしたちはね、あくまであんたたちに「協力」してるだけなの。もしあたしが、あんたの小言がウザいから協力しないって言ったらどうするの？　タルラは喜ぶと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それともあんた……パトリオットの旦那様がいるからって、レユニオンは戦争に長けてるなんて錯覚してるんじゃないでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だとしたら大馬鹿だわ。誰のおかげであんたたちが勝ててるのか、よく考えてみなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "わかったらさっさと帰ってあの龍女に伝えて。あんたが知るべきことはあたしの口から伝えるから、慌てるなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……待て。もう一つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "先程、市内に潜伏していた敵集団と相打ちになり、サルカズ傭兵のイネスが死んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "戦いに加わったレユニオン側にも、犠牲者が出た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "全て、お前の失態によるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……まくしたてないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "さっき、東側で騒ぎがあったみたいだけど、それ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "じゃあ……死体は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "――残念だが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしが聞いてるのは、敵の死体のことよ。イネスは派手な殺傷性のアーツなんて使えないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "いや、こちらの術師も戦闘に加わったんだ。最終的には敵もろとも通り一面が破壊された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――ちょっと露骨すぎない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "何がだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……あんたは、この件にどう始末をつけるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……我々の主要戦力は龍門で起きるだろう戦いに備えている。こんなことに構っている余裕はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "始末は、お前たちでつけろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ふーん……それにしてもあんた、ウルサス訛りが強いわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……だから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……そんな適当な説明で言い逃れするつもりだなんて――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしたちを、馬鹿にしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "W、やめろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "（落ち着け。アーツユニットを下ろすんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……ふぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ごめんなさい、すこし熱くなっちゃったわ。……あんたも一息ついたら？　命拾いしたんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "どういう意味だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "誤解しないで。サルカズがたった一人死んだところで、これからの作戦に影響なんて出ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もちろん、レユニオンが一人死んでも同じだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……試してみる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……お前の態度はそのままリーダーに報告しておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "次はないぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "言いたいことがあるなら、はっきり言えば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……お前がロドスの部隊を逃してから、レユニオンは俺たちの単独行動に厳しくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そもそもあいつらが前線でもその慎重さを持ってれば、こんな劣勢には陥ってないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうだとしても、お前は裏切り者の刀術師まで逃しただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "わざとじゃないわ。あたしはただあの馬鹿な感染者たちに、自分の連れてきたサルカズを殺されたくなかっただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だが昔のお前なら、躊躇なくエンカクを殺し、レユニオンを欺いていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前の目的が何であれな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……エンカク？　あいつのコードネームは、そんな名前だった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "イネスは本当に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "彼女のことは言わないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……誰かに行かせて確認させるわ。彼女の……チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "本題に戻りましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……今回、気になる点は三つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "一つ目。イネスはお前に、タルラの様子がおかしいと伝えようとしていた。具体的に何かを見ていたようだが、俺にはわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だが、タルラには「二つの影」があると言っていた。イネスの反応から見るに、アーツが妨害を受けてそう見えているわけではなかったようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "なんでハッキリと説明しないのよ。あの臆病者はホンットに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "二つ目。大旦那が動いた。何かを取りに行く指示を受けたようだ。タルラに隠すつもりはなさそうだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "三つ目。トランスポーターがヴィクトリアに向かっている。摂政王はすぐに、ここで起きたことを知るだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "テレシスの情報網は広い。そして奴の下にいる怪物たちの数も少なくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "もし摂政王が、この戦況をかき乱す選択をすれば、これは単なるレユニオンとウルサス間の問題ではなくなる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "W！　聞いているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……うるさいわねぇ、どれもいいニュースなんだし、ちょっと静かにしてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ここに入ってきてから……あんたの手はずっと剣の柄にあるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "最初に会ったときもそうだった。いつでも剣が抜けるようにしてるんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "さっきはパトリオットみたいに冷静にしてたけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "本当は、何を考えてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "それは今、重要ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……ヘドリー、あたしたちはみんな同じよ。わかってるの。悪しき習慣は変えられないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "イネスは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そうね、彼女の言葉は覚えておく。その犠牲に敬意を払って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……お前たちはよく似ている。後先考えずに行動するところが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "我々の行動を、摂政王が黙って見ているはずはない。適切な答えを用意できなければ、ロンディニウムに招集され、これまでの全てが水の泡になるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だが皮肉なことに、俺は未だに、お前が何をしようとしているかわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……そんなの、誰にもわからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "一人で何もかも成し遂げられると思うな、W。お前には、俺のように後悔してほしくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……なら、あんたに質問する権利をあげるわ。一応あんたのおかげで面倒事に巻き込まれなくて済んだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうか？　では今のロドスには、誰がいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……なんでそんなこと聞くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前とトランスポーターが話しているのを見た。ロドス号の痕跡を調査しているのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あの製薬会社は……あの戦争にわずかに関わっているだけだと思っていたが、今の状況を見るに、そうではなさそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "特に、Scout……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……チェルノボーグの封鎖戦で、俺たちは皆、お前の指示に従い、奴とは別の地区を担当した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そうね、あんたたちはよくやったわね――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だが我々の部隊にも、バベルの亡霊を目撃した者がいる。――W、お前は自らScoutに会いに行き、奴を逃したな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "しかも、誰に隠すでもなく堂々と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そんなことをすれば、不信感を持たれて当然だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だって、隠す必要なんてある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "戦場は思いのほか狭いわ。多少名の知れた相手なら、面と向かって何回か戦えば、どこの誰かは自然とわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "結局、あいつらはまだちゃんと生きてたってこと。それは変えようもない事実よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だったらお前はこれからどうするつもりだ？　そもそも彼らと敵対すること自体、予想外だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "もしロドスが未だケルシーを中心に動いているのなら、それが突破口になるかもしれんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしの目的を勘違いしてない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だとしても、あんたたちにも力になってもらうけどね。そう約束したんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "約束を守らない傭兵の価値は、死んだ傭兵と同じよ。まぁあんたは特別に、あたしがこの手で死んだ傭兵にしてあげてもいいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "力になると言っても、イネスはもういない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そして俺も……もうすぐここを離れることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……へえ。それは初耳ね、どこへ行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "トランスポーターと共にヴィクトリアに戻る。三、四ヶ月ほどかかる予定だ。明日の日の出前には出発する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……まさか、イネスを追って心中するつもりじゃないわよね？　不正行為の罪を背負ってロンディニウムに行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それならカズデルに逃げ帰った方が、よっぽど良い未来が待ってると思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前がガルシンを殺し、傭兵部隊を再編成したことについて、誰かが摂政王に報告しなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうしなければ、俺たちは全員捨て駒にされるか、王が直接指揮する戦場に投入されることになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうなれば、もう逃げ場はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんた……あたしを庇うために命の危険を冒すの？　なんでそんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "昔、テレジア殿下は……俺の名前を覚えてくださっていた。俺の家族のことも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "殿下はもういない。だが俺は、殿下がこの無様な傭兵部隊に、大事なものを残していってくださったと思ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "大事なもの……？　全然わからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "いや、わかるさ。どれだけやり方や性格がひねくれている者でも、結果から見れば、皆その非現実的な考えのために戦っているのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……あんた、自分が何言ってるかわかってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺たちはもう知り合って長い、W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "じゃああたしも、その長い腐れ縁に免じて、一つ警告しておくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "カズデルの支配から逃れるには、今が一番のチャンスよ。ここを離れて、龍門とウルサスを避けながらずっと遠くへ行けばいい。あたしは見て見ぬ振りをするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど摂政王の下に戻ったら……あんたは死ぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "フッ……俺にも力になってもらうと言っていたのはお前だぞ、W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もしあたしの力になる方法がどれもあんたの命との引き換えなら、その命は大事にとっておいてほしいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "いつかあたしが改めて取り立てをするときに、しっかり回収できるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "――俺は、死にに行くわけではないさ。摂政王の態度次第で、事態はどうにでも変わる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "レユニオンの件は、我々の想像を遥かに超えた何かに操られているように思う。そう話せば、摂政王も考えを変えるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……それに今、俺に逃げるという選択肢はないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "カズデルやここを離れても意味がないということを、パトリオットが教えてくれたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "これだけ短い間に、随分影響を受けたものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あれだけ短い間に、お前もテレジアから多くの影響を受けた。同じことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……いざテレシスの玉座を前にしたら、黒鉄が映る床に跪くことしかできないかもしれない。だが少なくとも俺は、そこに行って、彼の目的を探る必要があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "目的のわからない道を歩み続けることは、死にに行くことと同義だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "摂政王に従おうとは思わないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そう考えたこともあるが……ガルシンのことが気になってな。彼はお前のことを疑い、俺に、お前を殺せと命令していたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あら？　その通りにやってればもっと面白いことになったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "悪いが、お前が面白いと思うものを、俺は面白いとは思えん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そろそろ決めるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "うーん……確かにテレシスが一体何を企んでるのかは気になるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど、あたしにも選択肢はないみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうだ、お前が俺の提案を拒んだところで、お前に全てを任せっきりにするつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "まさか、あたしのためなんて言わないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "当然だ。他人を気遣ってばかりのサルカズなんていないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……昔のあんたに戻ったみたい。つまらないわね。あんたはこのまま落ちぶれていくと思ってたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もう計画はあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "それはイネスに聞いてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "その冗談、全然笑えないんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "では、出発前にもう少し冗談を言わせてもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "イネスが前に言っていた。お前は見かけはどんどん狂人らしくなっていったが、逆にやり方や性格は、優柔不断になっていったと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――あたしが？　あんたもそう思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……最近使った爆弾が少なすぎたかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうかもしれないな。だがどれほど上手く隠そうが、俺たちは誤魔化せん。あまりにも長い付き合いだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺たちは、お前のことを信頼し続けている……のかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……一体どれが冗談なのよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……お前が、サルカズ傭兵のヘドリーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "ここを離れると聞いているが……我々に何か用か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "出発前に、少し確認したいことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "イネスが戦死する様子をハッキリと目撃した者はいるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "――いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "支援要請の信号を受け取ったときには、戦闘は終わっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "通りは広く破壊されていた。天災が残した源石が地表に露出し、強烈な連鎖反応が起きたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "それによって、たった数人の犠牲で敵を葬ることに――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ウルサス人よ、仲間が目の前で倒れたというのに、やけに落ち着いているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前には慣れ親しんだ「もの」が纏わりついている。陰謀と、戦火に塗れた影がな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "もしイネスがここにいたら、きっとそう言っていただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "なるほど、戦友を失った悲しみを感染者にぶつけに来たか。よくある話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "さっきまで、お前はWより頭が良いと思っていたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あのときは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "フッ、思い返してみれば、俺は彼女に気を使いすぎだな。これまでもずっとそうだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だがさっきは、彼女に面倒を起こさせないためだけに制止したわけではない。それ以上に、俺がこの手で始末をつけたかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺もサルカズだからな……混じりけのない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン兵士",
      "text": "貴様ッ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
