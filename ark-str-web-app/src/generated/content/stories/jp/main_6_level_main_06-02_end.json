  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ぐっ、ぐうっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ごめんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "君を殴ったからって、君のことを同胞じゃないと思ってるわけじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……まぁいいや。そんな言葉、自分でも信じられないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "こちらブレイズ。Blaze-4小隊全員に通達、十数人規模のレユニオン構成員を捕えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "余裕があれば回収に来てほしいところだけど、時間がなければ龍門当局に引き渡すよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そこの龍門人、そのクロスボウを下ろして。そんなに警戒しなくてもいいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "一体私のどこが信用できないのかな？　君たちの命だって救ってあげたじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "下がれ……！　分かっている。だ、だがお前は……感染者だ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うん、そうだね。その通りだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ドクター、行くよ。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "行くよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "ああもういい。Dr.{@nickname}、こっち来て。動かないでね、こっちの方が早いから。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "大丈夫か？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "へぇ、私に担がれながら移動するのにはもう慣れたの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "そんな眼で私を見ないで、大丈夫だって。これまでに同じようなことが何度あったか、もう覚えてないくらいだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "エリア十六の横山広場に向かおう。レユニオンが防衛線を破るつもりなら、必ずあそこを通るはずだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "うん……この機にレユニオンの主要戦力を壊滅させるなら、管制区画にいるレユニオンは一人も逃すわけにはいかないね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "アーミヤちゃんとあの石頭のチェン隊長の作戦によれば、大半のレユニオン部隊を私たちがこうやって少しずつ片付けていって、最後に殲滅戦を一回展開しておしまい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "まずは横山ビルから敵を引きずり出して、包囲網の中に追い込んでからアーミヤちゃんたちと合流しようか。途中でレユニオンに遭遇したらついでに叩く。簡単でしょ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……だからそんな顔しないでって。大丈夫だって言ったでしょ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "あのさ。これ以上そんな目で私をじーっと見てると、道のど真ん中に放り出すからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "しっかり掴まって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "待って……あそこにいるのは？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "あれはメフィストの「家畜」かな？　何でこんなところにまで……メフィストが直接指揮してるはずじゃないの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "いや、ちょっと待って？　あいつら……何で自分の仲間を攻撃してんのよ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……どういうことだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "ヘルスデータは一度も途絶えていないが、定期連絡が一つも届いていないのは何故だ？　緊急信号が発信された様子もない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "一体何があったんだ……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "ちょっと、戦闘の指揮をおざなりにして、そんなところに突っ立ってなに見てんのよ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "あなたには関係のないことです、「お嬢様」。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "ちょっと、ツンケンしすぎじゃない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "これはお前には見せられない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "まぁ、諜報員との連絡が取れなくなったってところかしら。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "その勘の良さは、必要なときのために取っておくんだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "当たったんなら続けなさいよ。感染者の諜報員？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "そうだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "……裏切った可能性は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "それは絶対にあり得ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "じゃあアンタはその「絶対にあり得ない」ってやつを自分で言いながら疑ってる、そうでしょ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "彼女が本当に裏切ったとしたら……その先に待つ恐ろしい結末は、考えたくもないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "もし彼女が龍門を裏切ったのなら、もう龍門には信頼できる者が誰一人残っていないということになる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "なるほどね。何となく誰だか分かったわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "でも待ってよ……あの人が諜報員なんて引き受けるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スワイヤー",
          "text": "あの彼女が？　そんな事を！？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
