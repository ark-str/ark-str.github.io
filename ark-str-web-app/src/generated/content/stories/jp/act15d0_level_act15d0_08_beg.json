{
  "server": "jp",
  "storyId": "act15d0_level_act15d0_08_beg",
  "groupId": "act15d0",
  "stageId": "act15d0_08",
  "title": "激戦の末",
  "storyCode": "MB-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15d0/level_act15d0_08_beg.txt",
  "sourceHash": "15d34cddd89337efbb773a39cabd91d3350467bb8c7b140bb52a7c4d734326b2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "大変な騒ぎを起こしてくれましたね、ミスター・アンソニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "もし、あなたたちの計画を事前に知っていなければ、いくら私でも阻止することはできなかったでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "貴方がジェッセルトンですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "その通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "この監獄内で何度かすれ違ったことはあるのですが、改めて自己紹介をさせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "私はジェッセルトン・ウィリアムズ、あなたの今回の脱獄における最後の障害になる者です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "ドゥーマさんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ここにいますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "囚人A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "text": "アンソニー、ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "text": "医務室であなたを待っていたら、この人が突然、囚人たちを連れて押し入ってきたの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ドゥーマ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "こんな薄暗い場所に、美しい女性を一人で寂しく待たせるなんて、非常に心苦しいじゃありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "なので、私が彼女を守ってあげていたんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "ジェッセルトンさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ああ、ミス・ロビン……どうやらあなたは失敗したみたいですね。実に残念です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "というより、そもそも暗殺を実行していないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "彼女は失敗したのですよ。彼女の力量では私を傷つけることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "だがあなたは彼女を生かしておいた……本当に素晴らしい紳士だと言わざるを得ませんね、ミスター・アンソニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "くだらない話はやめにしませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "わかりました。では直接本題へと移りましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ミスター・アンソニー、この女性を死なせたくなければ、こちらに近寄っていただけますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ミス･カフカ、あなたは大人しくそこでじっとしていてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたは混乱に乗じて行動するのが上手な方だとお見受けします。勝手な真似をして、ミス・ドゥーマを傷つけることがないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "チェッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "……これぐらい近寄ればいいですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "そうです、そこに立ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "君たち、彼を取り囲みなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "text": "アンソニー、そいつの言うことを聞いてはダメ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "安心してください、ドゥーマさん。必ず貴方を助けますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "危機に直面してもなお冷静さを保つとは、本当に感服致しますよ、ミスター・アンソニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "私が何をするつもりかあなたはわかっているはずです。そして私が同情心からあなたを見逃すことなどないということも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "提案致しましょう。この女性を見捨て、その偽りの教養に満ちた仮面を外して私と殺し合う、というのはいかがでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "くだらない話はやめようと言ったはずですが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "……その余裕がいつまで続くでしょうね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "それではミス・ロビン、よくお聞きください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ミスター・アンソニーを殺し、あなたの任務を完了してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "先ほどあなたがミスター・アンソニーとどんな合意に達したのか、そしてどんな心境の変化があったのかはこちらの知ることじゃありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "例のお金を手に入れたいのなら、お父さまを救いたいのなら、これが最後の、そして最高の機会です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "何をためらっているのです？　彼はあなたにどんな空手形を切ったのですか。それともここに来て情に流されましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "これは唯一の機会なのですよ、ミス・ロビン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "わ、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたのお父さまのことを……哀れにも転落したあなたの生活を、これからのあなたの未来を、あなたの願いをよく考えるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "もし私があなたなら、何一つためらうことなどありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "貴方は一体、何がしたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "私がしたいことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "そこまでわかりにくかったのですか……そうですね、ただあなたを殺したいだけなら、監獄の中でいくらでも機会はありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "でもそれでは面白くない……全く面白くありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "人を殺すなど、私にとっては別に楽しみでも何でもないんですよ、ミスター・アンソニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "私が最も楽しみにしているのは変化です。人が選択に迫られた時、それまでの顔を捨てざるを得なくなったその瞬間です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "だから今回、私はミス・ロビンを引き入れ、彼女の変化を、彼女の落ちぶれる様を待ち望んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "そしてあなたの変化も待ち望んでいます。今この時、あなたが一族のため、目的のために、これまでの紳士的な態度を捨て去り、牙を剥く姿を待ち望んでいるのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "さぁ、何も取り繕う必要はありませんよ、ミスター・アンソニー。これ以上自分を騙すのはやめにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたの一族、あなたに降りかかった災い、あなたが耐え忍んできた屈辱、あなたの脱獄の目的をよく考えるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ここで、このようなところで、終わりを迎えてもよいと、本当に思えますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたは本当に、たかが知り合って数年程度の女性一人のために、命を捨てて後悔しないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "立ち上がるのです、ミスター・アンソニー！　ミス・ドゥーマなど見捨て、ミス・ロビンを叩き伏せ、私へ突進し、私を殺すのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "誰もが貴方と同じような人間だとは思わないでほしいものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたこそ、自分が皆と違うなどと思わないでください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ではミス・ロビン、あなたには五秒を差し上げます。時間切れになれば、私は自ら手を下します。そしてあなたも恐らくここで屍となることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "五。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたのお父さまの手術費用は、まだまだ足りていないはずです。しかし今ミスター・アンソニーは一銭も持っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニー、私……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "四。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ミスター・アンソニー、あなたの両親は監獄内で排斥され、非常に苦しい生活を送っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "……父上、母上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "三。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "text": "アンソニー、私に構わないで！　あなたはこんなところで死んではいけない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "囚人A",
      "text": "ふん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "text": "ぐっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "囚人A",
      "text": "このクソアマ、俺が目を離した隙に自殺しようとしやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "text": "ロ……ビン……ダメ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "まさかミス・ドゥーマがこれほどまでの信念を持ち合わせていようとは……尊敬に値するレディです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "しかし残念なことに、彼女が望むように事は運ばないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "ジェッセルトン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "今のあなたの表情――素晴らしいですよ、ミスター・アンソニー。本当に素晴らしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "とても興味深いですね……あなたはどうして、そこまで固い決意をお持ちなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "まさかあなたは、自分が死ねば私が残った方たちに手を出さないとでもお思いですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたにとってのポリシーは、それほどまでに重要なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "それとも、まだ何か他に策があるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "……私はこの監獄の中で、自分のポリシーに背く多くのことをしてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "看守たちに媚びへつらい、バートンの味方につき、殴りたくない者を殴り、送りたくもない生活を送ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "だが今の行動は私のポリシーとは関係ない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "私自身の選択だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "単純な話だ。私は自分の目的のために、ドゥーマを犠牲にしたくはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "たとえまだ、家族があなたを待っているとしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "お前に私の家族を語る資格はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "たとえまだ、あなたに解き明かすべき真実と果たすべき復讐があるとしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "一人の友人の命と比べれば、そんなものは重要ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "たとえ、そのためにあなたが多大な犠牲を払うことになっても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "たとえ、そのために私が命を失うとしてもだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "辛いでしょうが、貴方は自分で考え、選択し、その選択に責任を負わなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "でなければ、貴方は自分の運命の手綱をとることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "貴方はもう一度自分を見つめ直し、自分が一体何をしたいのかを考えなければなりません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "そうですか。実に残念です｡",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ではカウントを進めましょうか……二。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ミス・ロビン。あなたの苦しみは痛いほどわかります。それでもあなたは選択しなければならないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "どんな選択をしようと、後悔しないでください、ロビンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "囚人A",
      "text": "グハッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニー、ドゥーマは任せて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "囚人B",
      "text": "チッ！　させるか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "へへ、ようやく動けたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "囚人B",
      "text": "いつの間に！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "囚人B",
      "text": "……ぐわぁっ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "おう！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "これが残しておいた策なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ミス・ロビンがあなたの味方をすると確信していたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "いや、単にお前の提示した条件が魅力的ではなかっただけなのかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "本当にこれでいいのですか？　ミス・ロビン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたが選んだのは、私から見れば全く未来のない道ですよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "父さんが今のようになったのは確かに最初はサイモン家が原因……でもそのあと、あそこまで落ちぶれてしまったのは彼自身の責任だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "私はこのことをずっと知っていながら、認めようとしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "そして私自身も……アンソニーを殺したくなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニーは、脱出したあとに父さんの医療費を何とかするって約束してくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "でも、そんなの本当はどうだっていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "私はもうアンソニーを殺さないって決めた……たとえ彼が助けてくれなくとも、私は別の方法を考える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "もしそのせいで父さんの病を治せなかったとしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "私は自ら命を絶つ。あっちで父さんに「役立たずの娘でごめん」って謝る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "これが私の選択。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "素晴らしい、実に素晴らしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "まさに感動的。涙を誘う覚悟です、ミス・ロビン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたがそのような覚悟を持って、我々が交わしたとるに足らない取引に背くことを選択するというのなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "私はあなたを責めはしません。むしろ拍手を送りたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "しかし私も一つ指摘しておかなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "さっき私が言った「未来がない」とは、あなたたちの「脱獄成功」後の未来のことではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "今、まさにこの瞬間のことについて言ったのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あなたたちに「脱獄成功」の未来はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "やってみなけりゃわからないことだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "残念ながら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ミスター・アンソニー。あなたの実力は、予想をはるかに上回るものであったと認めざるを得ません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "しかし私にとっては、殺人のみならず、暴力も特に面白いものではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ですからあなたが「やってみない」ための、一つ目の手段として私はミス・ドゥーマを用意しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "そして二つ目は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "ううっ……ぐあ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "うわぁっ！　拘束具が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "text": "アンソニー、カフカ、大丈夫！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "大……丈夫だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "まさか、自分の体に枷がついていることを忘れていたのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "くそっ、こいつ、なんて用意周到なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "お褒めの言葉感謝いたします、ミス・カフカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "お前、最初からロビンを騙してたんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "何を仰いますか、私は常に次善の策を用意しているのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "もしミス・ロビンが首尾よくやり遂げていれば、私は手を出す必要もなく、めでたしめでたしだったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ですがもし彼女が失敗した時のために……ご覧の通り、私は次の手も用意していたのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "私が彼女を騙していたなんて言いがかりはやめていただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "口先では綺麗に言ってるけど、彼女を巻き込んだのはお前だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "ハハハッ！　言ったじゃないですか。私の目的は彼女のもがく姿を見ることだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "しかしミス・カフカ、あなたも自分でビジネスをしている方です。よく考えてください。もし私がミス・ロビンを巻き込まなければ、彼女はお父さまの医療費を集める方法を見つけられるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "その可能性は実に低いと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "チェッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "反論できませんよね、そうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "フー……確かにロビンがお前に協力すれば……もっと楽になるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "だが、彼女はそうしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "それで、充、分、だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "フンッ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "この期に及んで、まだ抵抗する力があるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "やむを得ませんね。では私の手であなたの最後の幻想を打ち消して差し上げましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "アンソニー、私も手伝う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "クッ、カフカじゃアンソニーみたいな力尽くの方法は無理だよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "えっ……？　みんな気を付けて！　あいつの手が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "あいつの手が、黒くなっていく！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "あぁ、なんと涙を誘う一幕に仕上がったことか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "そしてこの舞台を私自ら打ち崩すことができると思うと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "text": "とても幸せで堪りませんよ、アンソニーくん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
