{
  "server": "jp",
  "storyId": "act35side_level_act35side_02_beg",
  "groupId": "act35side",
  "stageId": "act35side_02",
  "title": "館内特殊作戦",
  "storyCode": "AS-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act35side/level_act35side_02_beg.txt",
  "sourceHash": "4dc088c0c1da63fad60cc076d626d7756a9dee1823b783ecd2ebc98e74b17ab3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "本当に精巧だね。さっきは気づかなかったけど、まさか表情や口の形まで真似できるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "口を開けて見せて、あーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "（口を開ける）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "喉には明らかに声帯に似た部位があるね。どうして今まで一言も発しないんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "妙だな。普通に考えれば、発声も声帯と筋肉の動作によるものだから、模倣はできるはずなのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ペペはミイラに近づくと、手を相手の喉に当てた。するとミイラも彼女と同じ動作で、手をペペの喉に当てた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "き……み……は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "き……び……ば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "思わず手を引っ込めたペペは、信じられないといったように手で口を覆うと、目に驚きの光を浮かべた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "本当にしゃべれるんだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "なんて不思議なんだろう……まさかシャアの時代にここまで精巧な職人技があっただなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ご先祖様が『古歴紀工芸考証』の中で言及してたっけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "源石回路宝石を用いて人の意識を封印したり、黄金で体を作って、何千年も腐敗させずに動かすことのできる異人がいたって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "不死の軍隊……継承の途絶えた技術……陛下は君にものすごく興味を持つだろうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "宝物庫は、きっと君の記憶の奥深くに隠されているに違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "私が話す真似をするだけではいけないよ。宝物庫が一体どこにあるのか教えてくれないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "どれどれ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "「一つ目の貴石は心臓。それが脈打つ時、我らは存在する。二つ目の貴石は肺。我らが初めて呼吸する時、記憶が始まる。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "「三つ目の貴石は胃。食物が腹に収まり、舌が選り好みを覚え、我らの嗜好や性格が誕生する。四つ目の貴石は肝臓。我らは職責と義務のために、明確な意志をもって夜に向かう。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "五つ目の貴石は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "五つ目は何だろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ない。詩はここで途切れている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "どうやら前時代のアルサランの研究者も答えを持ってはいなかったようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "だけど君なら必ずその答えを見つけ出す力になってくれる。そうだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は再び手を伸ばし、指先をミイラの喉に押し当てた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "その通りだ、お嬢さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "その通りだ、お嬢さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "やあ、モノマネさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "やあ、モノマネさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女はゆっくり手を引っ込めると、今度はミイラの手を取って、力いっぱい握りしめた。するとミイラも握り返してくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "これで君も承諾したってことで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "アジャジ、扉の前に着いたんだけど、どうしてあなたの姿が見えないのかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "今どこにいるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "何だって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "（小声）自分がどこにいるかわからない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "通行証もないのにどうやって入れっていうんだ……チッ、館長のやつ、オフィスを金庫みたいにしやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いや、間に合わない。もうすぐ客は外に出される！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ねえ、アジャジ……廊下の窓と館長のオフィスの窓は隣り合ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……ああ、高さがあるのはわかってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "せいぜい気をつけるとするさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "一、博物館内では静粛に。二、無秩序は理性の大敵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "無理に押さないように。こっちに展示されている彫像と大型壁画はケースで保護されていない。下手をすれば──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "たった今見たように、この像は危うく砕けるところだった。これはとても由々しきことだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "歴史は過ぎ去ったが、決して我々と無関係ではない。我々が砕いてしまうのは、五百年前の人々が山を征服した歓声、あるいは彼らがワイングラスを高く掲げた時の笑い声かもしれないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "えっと、素晴らしい解説ですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "……でも本当にその像をこのまま担いでいくつもりなんですか？　手に持っている他のものも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "ああ、これらをあるべき場所へと持ち帰るのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "もうすぐ閉館だというのに、さすがはプロですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……閉館？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "ええ、突然緊急事態だって放送があって、ビックリしましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "さっきまで私たちを案内していたあのバカな職員は、左右の違いもわからなかったんです。左に曲がると言っておきながら右に行き、左に曲がる時は、次は右だとか叫んでいたんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私もそれには同意する。この博物館のいくつかの点については少々不満がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "その職員ときたら、私たちをこんなわけのわからない場所に連れてきておいて、自分はどこかへ消えてしまったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "それには同意しかねる。お言葉だが、ここはわけのわからない場所ではなく、ミノ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "道に迷ったと気づいた時、とても怖かったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "もし逃げられずにこのまま博物館の中に閉じ込められたら、きっと恐ろしい亡霊に遭遇してしまいますわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "見てください、あの将軍の鎧、あの生贄の祭壇を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衰弱した観光客",
      "text": "そうだよ……！　だから博物館に行くのはごめんだって……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然倒れ込んだ観光客の後頭部が床にぶつかる瞬間、アスパシアが彼を受け止めた。\nそのせいで彼女の手から彫像、壺、そして金杯がすべて転げ落ち、それらはイベリア人がボリバルの通商路を開拓する際に用いた大砲の横に雑然と並んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "ダーリン！　どうしたの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……恐らく過度なショックによる失神だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "気付け薬を持っているから、ひとまず覚醒を促すことはできるだろう。しかしここを出たら、すぐに病院へ検査を受けに行った方がいい。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アスパシアは慣れた手つきで綿にくるまれた薄いガラス管を潰し、湿った綿球を観光客の鼻に近づけた。\nそして、彼女は目覚めた観光客を担ぐと、落ち着いた様子で列の先頭へと向かった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "何か緊急事態が起きたのだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衰弱した観光客",
      "text": "お姉さん……すごい腕力だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "皆、私についてきなさい。何か起きたとしても、私が守ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "衰弱した観光客",
      "text": "お姉さん……素敵。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "はぁ、おチビさん、次からは所かまわず走り回っちゃダメよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "たしか、あなたはラズバールが飼ってたペットよね──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "こらっ、どうして引っ掻くのよ！　たった今人混みの中から助けてあげたんだから、抱っこくらいさせてくれたっていいでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "あなたの毛、ほんと柔らかいのね。ラズバールはどうやってあなたを手に入れたの？　私も前にあなたみたいな特別な子が欲しかったんだけど、品種もどこで買えるかも教えてくれなかったのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "最初あなたのどこがそんなに気に入ったのかわからなかったけど、最近になってようやく気づいたわ。あなたは暗闌時代の雲獣の像によく似ているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "ちょうどいいわね。職員への指示は全部終わったし、お客さんも順次退館している。ここであなたを逃がすわけにはいかないから、私の作業室へ連れて行って修復中の雲獣像を見せてあげましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "メジェティクティはいくつもの階段を下り、文化財を修復するための部屋にやって来た。\n巨大な室内を照らすのは白熱電球一つだけだ。文化財へのダメージを軽減するため、空調の温度は低く設定され、空気は冷たく乾燥している。彼女が息を吐くと、なんとその息は白くなった。\n普段修復を手伝っている職員は残らず館内の混乱対応に送り込まれ、地下は静まり返っていた。彼女は鼻をすすり、鼓動が少し早まっているのを感じる。"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "私の作業台はここよ……怖がる必要はないわ、おチビさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "テーブル上にはまだ樹脂のような金色の物質が残っている。それは文化財修復のためメジェティクティがアーツを使用した痕跡だった。\nしかし元々テーブルの上に置かれていたはずの雲獣の像がどこにも見当たらない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "えっと、雲獣なんて見てませんけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "たった今、あなたの額に陰りが見えたのです。これは良い兆しではありません。不運が訪れることを示しています。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "あ……あなた、もしかして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "まさかあなたもあのミイラみたいに、動き出したっていうの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "いやああ！　嘘でしょ！　あんなに苦労してあなたを修復したのは、アナトの研究対象みたいに走り回らせるためじゃないわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "ましてや不運を招き寄せるためでもないわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫保管員",
      "text": "何事だ！？　叫んでいるのは誰だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫保管員",
      "text": "ってあれ……メジェティクティさん。ど、どうしてこちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫保管員",
      "text": "つい先ほど一時閉館のお知らせがあったので、しばらく戻ってくることはないかと思って、修復中の文化財をすべてしまっておいたのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "えーっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……別に何でもないわ。今日は残業したい気分なの。先に上がってちょうだい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "何だって？　南東展示ホールから避難した観光客のグループがまだ見つかっていない？　ジヤアが連れ出したんじゃなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "すぐ入口のゲートを閉めなければならないんだ！　副館長が自ら緊急閉館命令を出したんだぞ。事態がどれほど深刻なのか想像もつかない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館チケット販売員",
      "text": "誰か中に探しに行ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "すでに何人か送り込んだ。しかし皆が見つからないと言っている。ジヤアは一体どこへ連れて行ったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館チケット販売員",
      "text": "急に黙り込んでどうしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "聞こえないか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館チケット販売員",
      "text": "何がです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "風の音だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "輝く日差しの下、人々が一列に並んでゆっくりとゲートから出てきた。\n先頭の女性は集中し落ち着き払った表情で歩いている。その後ろに数十人の列が整然と続く。\n風が彼女の服の裾を揺らし、頭髪を乱すも、彼女は全く動じることなく、衰弱した観光客を肩に担いで歩いている。それはまるで何年もそびえ立っていた像が命を与えられたかのようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "なんだかどこかで見たことあるような光景だな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館チケット販売員",
      "text": "……わかります。あの像は何度も見たことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "あんな姿の像あったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館警備員",
      "text": "はぁ、でもよかった。これでようやくゲートを閉められる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "本当にありがとうございました。これは私の名刺です。もしうちの宝石をごひいきにしていただく機会があれば、必ずや最上級の貴賓対応をさせていただきますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な観光客",
      "text": "ねえ、今度炎国に遊びに来てよ！　おばさんの家には若い男の子がいるんだけど、とびきりのイケメンなのよ。それに姉の家には天師府に勤め始めたばかりの独身娘がいて、その子にも会わせたいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "皆さんありがとう。だが礼は必要ない……私はただすべきことをしたまでだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "──",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アスパシアは勢いよく振り返った。\nシャッターがゆっくりと下がり、警備員が「本日閉館」と書かれた看板を扉の前へと引きずっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……私の金杯は？　壺は？　彫像は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優美な女性",
      "text": "ナナは一体どこへ行ってしまったの？　もうこんな時間なのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優美な女性",
      "text": "ベリーショップの「ガーネット」にはいなかったし、磁器ショップの「エナメル」にもいない。あの子がよく入り込むセレスタイトの壁の水道管にもいなかったわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "フンッ、あんな雲獣を探すのにこれほど時間をかけるなんて、まったく無駄だな。どうせ博物館で暴走したミイラにでも食われたのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優美な女性",
      "text": "やめてよ、そんなはずないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "ペットなんてしばらく可愛がってやれば十分だ。ほかにいいものはいくらでもある。お前が欲しいものなら何でも買ってやるさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "お前が首を縦に振れば、レアな宝石どころか、宝石取引所ごとお前に買い与えてやるさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謎の動物",
      "text": "（顔を上げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優美な女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "ん？　無言ということは受け入れたということか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優美な女性",
      "text": "いいえ、足元を見て……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の動物",
      "text": "（にらむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "……なんだ、ラズバールのとこの畜生か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "おい、何を偉そうにしているんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クールな市民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "……ゴホゴホッ。いたのか、ラズバール。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "ちょうどよかった。商売の話をしようじゃないか。実は彼女がこの宝石取引所に興味を持っていてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優美な女性",
      "text": "やめて、そんなこと言ってないわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "私はサルゴン東部に移動式プラットフォームを持っているんだよ。大規模な源石精錬所に、染料工場、食糧加工工場が建っている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "これらすべてに加え、金銀財宝もプラスすれば、この宝石取引所を買い取れるだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "断る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "あなたではこの宝石取引所の重みを担えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "ふんっ、重みか……若者よ、君は祖父から尊大さだけは受け継いだようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "一つアドバイスをしてやろう。君はあの祖父のように、数匹の狂暴な裂獣を従えてその場の状況を力で支配するか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "その小さな雲獣に私のような賓客のもてなしを任せ、愛想を振りまかせることだな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "ッ──痛っ！　畜生め、この私を咬んだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の動物",
      "text": "（歯をむき出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の動物",
      "text": "ワンッ──！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "着飾った男性",
      "text": "おい、やめろ、くるな──近寄るんじゃない──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の動物",
      "text": "ワンワンワン──！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "……ワオ、もう怒るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "失礼な奴は失せたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "ワウ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "ん？　撫でてほしいのか？　……ここか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "（嬉しそうに舐める）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "一羽の羽獣が飛んできて、宝石取引所の若き支配人の肩に止まる。\n支配人は金属でできた羽獣のいくつかの仕掛けをいじり、ゼンマイを巻き上げると、羽獣を再び空へ放った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "……あの方がだんだんと活発になってきたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "お前たちもきっと彼に会うのを楽しみにしてるんだろう？　ミオがここまで積極的に外へ出るなんてことはめったにないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "さっきの人が雲獣に重要な客人のもてなしをさせろと言っていたが、それも一理あるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラズバール",
      "text": "うーん……ミオは本当にあの方を誘導することができるだろうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
