{
  "server": "jp",
  "storyId": "main_1_level_main_01-07_end",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "暴君",
  "storyCode": "1-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_01-07_end.txt",
  "sourceHash": "eccb2a641ef5cf7c552e64ed6f6c6de77d9d50921914b3b1ba572a13a73f5632",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "はぁ、はぁっ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "よし……！　今のところ、順調に進んでいるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "我々はレユニオンを退けることに成功し……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "この天災も、収束傾向にあるようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "とはいえ、状況の悪さに変わりはない。……皆、改めて気を引き締めてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……それにしても、天災のせいで街中瓦礫だらけですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "建物が崩れて、道を塞いでしまっていますし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "その上、源石の増殖も見受けられるな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "脱出まであと一息だというのに、ここに来て邪魔ばかり入ってくるとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "もし、我々に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……待て、これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "来ているな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "えっ……？　来てる、って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "レユニオンですか？　まさか、もう追いついてきたとか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……あ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "れ、レユニオンが……あんなに、たくさん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……「追いついてきた」わけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "あの連中は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――至る所に潜んでいたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "見ろ、そこら中の廃墟から這い出してくるぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "クソッ、なんて数だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "しかし、これを見るに、あの連中が、実際に死の危険に晒されるまで天災を恐れなかったのも頷ける……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "仮に、この天災が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "奴らの半数以上の命を奪ったのだとしても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ここにはまだ、我々を十数回は討ち果たせるほどの戦力が残っているのだから……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――だが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "足を止めてはならない！　撤退ルート通りに進むんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "開けた場所で立ち止まっては、いい的になる！　隊形を整えるにしても、広場の出口まで到達したあとにするんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ニアールさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――こうなれば、戦闘は避けられん。突破口を開き、混乱に乗じて脱出するしかないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "本当に、うまくいくんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "望みは薄いかもしれないが、ほかに方法はない。それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "多勢に無勢の状況ながら、個々の力量でいえばその差は歴然だ。――我々ロドスにも、勝機はある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "総員、慌てず戦闘に備えよ！　防御陣形に移れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……それにしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "この人数を前にすると……チェルノボーグを落とすことも、確かに不可能ではないと思わされる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……本当に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "とてつもない数だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "レユニオンは……一体どこから、こうも大勢の感染者たちを集めてきたのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "しかし、ここへ来てこの包囲網とは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "どうやら連中は、我々の実力を相当買っているらしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ッ、報告！　レユニオンの大軍勢に……広場を包囲されました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……って、あれ……？　敵の動きが止まって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　あっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "しょ、正面から一名、レユニオンが接近中！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "なんで一人なんだ……？　どういうつもりで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "もしかして使者、か……？　いや、そんなはずが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの人は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "レユニオンの資料で、見たことがあります……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "このにおいは……彼女のほうからか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……ニアール……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "私にも、理由まではわからないが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "これは、鉄と硫黄のにおいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "まるで何かが燃えているような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "あたかも、彼女自身が焔であるかのような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――ロドスのみなさん……最大レベルの警戒を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "目の前の、彼女は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "レユニオンの「暴君」……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……タルラ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "大地のすべてを焼き尽くさんとする、焔そのもの……か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
