{
  "server": "jp",
  "storyId": "story_pudd_set_1_story_1",
  "groupId": "story_pudd_set_1",
  "stageId": null,
  "title": "彼方の雪",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_pudd_1_1.txt",
  "sourceHash": "d708ac907b0eee90cd5f74dc0d24f9e3ef3f70ff5f46f05655c63128b30f9523",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "大丈夫ですよ、今調節してますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部新任オペレーター",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "よし……ここはこれで大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "次は給電モジュールを繋げて……セリカさん、スクリーンを確認してもらえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "あっ……データが安定してきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "よかったです。これでもう直ったと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "ありがとうございます……私の設計が悪かったのでしょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "いえいえ、ちょっとしたアクシデントですよ。システムの動作環境が汎用の電圧安定モジュールの制御範囲をオーバーしちゃったせいで、一瞬電圧が上がりすぎて一部の部品が焦げちゃったんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "損傷した部品を取り替えて、モジュールの回路を調節したので、今後はもう同じことは起こらないはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "こんな初歩的な問題を、私は今の時間まで残業しても気付けなかったんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "セリカさんのせいじゃないですよ。複雑な機械だからこそ、単純な問題に気付きにくいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "そんなに落ち込まないでください……はい、ホットココアです。これを飲んで元気を出してくださいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "これ……コーヒーです……うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ああー、ごめんなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "プリンさん、私……電気エンジニアに向いてないのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "そんなふうに考えちゃダメですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "セリカさんは電気工学の分野においてとても才能があると、少なくとも私はそう感じています。それに、すごく努力もしているじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "だけど、しょっちゅう仕事中にミスをしちゃうし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "新人は失敗を繰り返して成長するものなんです。ドーベルマン教官もそう言っていましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "でも、この前は結合回路でトラブルを起こして、今回はこんな単純な故障にも気付けませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "考え方を変えてみてください。今回は結合回路でトラブルを起こさなかった、これだけでも進歩してるじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "だけど今回もミスを取り返すために残業しちゃったし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "大丈夫ですよ、私もよく残業しますしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "プリンさんのは違うじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "プリンさんが残業するのは、みんなの負担を減らすためでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "それに……プリンさんは技術の腕もすごいし、クロージャさんのとんでもアイディアですら、製作可能な図面に起こしちゃうし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "現地調査もせずに、資料だけを頼りに工程を隅々まで考慮した設備環境を室内に作り出せるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "私がすごく頑張ってやっと完成できる仕事も、プリンさんにとってはきっと一瞬で終わらせられたはずですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "セリカさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ごめんなさい、こういう時に気の利いたことが言えなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "でも、今のセリカさんは一時的にスランプに陥っているだけだと思いますよ。私も昔かなり悩んでた時期があって、祖父からこんなアドバイスをもらったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "何かの物事でくじけそうになった時は、それが一番楽しかった頃のことを思い出せって。続けていれば、必ずまた同じ楽しさを味わえるんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "だから……セリカさんも試してみてはどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "楽しかった頃なんて、あったのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "プリンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "その……プリンさんが一番楽しいと感じたのはどういう時ですか",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "私ですか？　そうですね……締め切りより前に仕事を提出できた時は毎回楽しい気持ちになれるけど、でも「一番」って言われると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "やっぱり学生時代に、クルビアのエンジニアチームとサーミへ行った時ですかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "サーミに行ったことあるんですか？　古の氷原と高くそびえたつ山脈がある、あの謎に包まれた北の大地のサーミですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "家の関係で、小さい頃から何度も行ったことがあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "サーミについては本でしか読んだことないんですよ。そこって、本当に想像を絶するような不思議な景色がたくさんあるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "家族とはほぼ毎回バカンスしに行っていただけなので、謎に包まれた奥地へは行ったことないんです。サーミへの印象と言えば……一面の純白景色でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "だけど、あの時だけは、エンジニアチームと湿地の中にあるサーミの集落へ行ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "リゾートと比べると、湿地は湿度が高くじめっとしていたので、快適な旅とは言えなかったのですが……すごく特別なものでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "すごい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "今でも、集落に最初の明かりが灯った時の光景は忘れられません。集落の人々の笑顔も鮮明に思い出せます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "科学技術には人々の生活を変え、皆を幸せにできる力があるんだって……あの時初めて身をもって理解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "だからあの時思ったんですね。自分も電気エンジニアになれたら、今と同じように、人々と未来を繋ぐ架け橋になれるんじゃないかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "未来を繋げる……架け橋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい、やりたいことが決まったら、あとはそれに向けて頑張るだけです。ほら、今の私はちゃんと電気エンジニアになれたでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あっ、そういえば。サーミに興味があるのなら、きっとこういうのも好きですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "サーミのリゾート地で買ったスノードームです。中に入っているこのミニチュアはですね、サーミの集落を再現してるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エンジニア部の新人オペレーターは、手の中のスノードームを見つめながら、物思いにふけった。"
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "……そうだよ！　そうですよね！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "えっ、何がです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "プリンさん、ありがとうございます！　私、やっと分かりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "えっと、どういたしまして？　私は自分の考えを述べただけですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "このセリカ・ウィルソン！　絶対にこんなところであきらめたりしません！　せめて一人前になるまでは、精一杯頑張ります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい……何はともあれ、元気になったようでよかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "そうとなれば、すぐに行動に移さなきゃ！　まずは残りの仕事を片付けてきます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "それなら私も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "そういえば！　ちょっと気になったんですけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "な、なんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "たしか、プリンさんってもうずっと本艦にいるんですよね？　加入したばかりの時と比べると、技術力がかなり上がったとクロージャさんも言っていましたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セリカ",
      "text": "そんな特別な思い出があったのなら、サーミにもう一度行きたいって思ったりはしないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "サーミにもう一度……ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "（手紙をテーブルに置く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "……まただよ。パパの手紙、昔サーミでバカンスした思い出話と、今度の休暇に一緒にサーミに行きたいって、今回も書いてあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ねぇピローちゃん、ピローちゃんもサーミを夢を見たりする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "昨日ね……こんな夢を見たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "私、すごく高い場所から、あの大地を見下ろしてた。湿地の沼に黒き森、どこまでも一面雪景色の冬牙連峰、そして果てしない氷原。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "どこを見渡しても、記憶の中にあるのと同じ光景。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "道端の草は雪を被って眠りにつき、夜空はオーロラのベールを纏っている。吹き荒れる氷原の風が、時間すらも吹き飛ばしてしまっていたようだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あとね、ピローちゃん、ピローちゃんと出会ったあのお土産屋さんも夢に出てきたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピローちゃんはお友達とくっつきあって棚に並べられていて、お隣さんがスノードームだったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "スノードームの中で雪が舞い散って、小さな集落の屋根に落ちた。私が手を振ると、小屋の明かりがパッとついて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ねぇピローちゃん、やっぱりサーミにもう一度行ってみたほうがいいのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "誰か……助けて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "お願い……誰もいないの……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "やっぱり怖いよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "パパとママが私の帰りを待ってるのは分かってる。でも、帰省してる途中だって、危険なことが起こるかもしれないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "えっ？　友達がおうちまで送ってくれるって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "だけど、もし途中でエンジンが突然発火したり、飛行ユニットに羽獣がぶつかって、空中で故障しちゃったらどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "それに一番怖いのは、私が本艦から降りた瞬間に石につまずいて、しかも転んだ先には尖った破片が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "無理！　絶対に無理だよ！　私、もう遠出なんて二度とできない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "夢だ……やっぱり夢の中のほうが安全だよ。ピローちゃんもそう思うでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ほら、もう一回一緒に夢を見よ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "俺らはそろそろ上がるよ。プリン、また明日な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい、お疲れ様でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "あんまりコーヒー飲みすぎるなよ。仕事熱心なのはいいことだが、少しは自分の身体を労わってやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "セリカが異動になっちまったから、ラボで残業するのは君ひとりだけになってしまったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "セリカさんが異動……？　言われてみれば、確かに最近姿を見かけませんでしたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "えっ、知らなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "あの子、外勤部の技術審査に合格したんだよ。二ヶ月前にはもう任務を受けて本艦を発ったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "セリカさんは頑張っていましたからね……新しいことにチャレンジするのは彼女にとってもいいことだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "憧れの任務に参加できるとかで、出発の前日は興奮して眠れなかったそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "そりゃあそうだよな。クルビアのエンジニアチームの同行顧問としてサーミに行けるなんて、俺だってはしゃいちまうだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "えっ、セリカさんはサーミに行ったんですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "プリンもサーミに行ったことがあったんだっけ？　あーあ、二人が羨ましいよ。物語の中の美しい光景を実際に見れるもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "ここだけの話、セリカのやつ、君を憧れのアイドルのように崇めてたぜ。サーミに向かったのも、君の背中を追いかけたかったかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "まさか……私はそんな大層な人間じゃないですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピローちゃん、知ってた？　セリカさんね、サーミに行っちゃったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あの景色を実際に見れたら、きっとすごく感動するんだろうな。なんだか私までうれしくなってきちゃった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "こんな夜遅くに誰だろう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "こんばんは、プリンさん。サーミからお手紙が届いています。差出人は……セリカさんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "えっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "それでは、良い夜を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "やっぱり読んでみよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "……もうサーミに入ったんだって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「サーミへ行く途中、私はこれから目にするだろう壮大な景色をたくさん想像しました。だけど、実際に足を踏み入れてすぐ、私はこの大地の雄大さが想像を遥かに超えていることに気付きました。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「灰色の尾羽を持つ羽獣が空を舞い上がり、枝から粉雪が花びらのように零れ落ち、太陽に向かって広げられたキノコの透き通った傘は、ガラスのようにキラキラと光っていました。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「その幻想的な数々の光景を眺めるたび、いつも時間を忘れて夢中になってしまいます。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あとは全部お決まりのあいさつだ。よかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピローちゃん、そんな目で見ないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "性格が悪いのは分かってる。でも、本当は見なかったことにして、読まずにどこかにしまっちゃおうと思ってたんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピローちゃんも知ってるでしょう？　パパとママの手紙は毎回サーミの話から始まって、今度一緒に行こうって締めくくられてるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "だから、セリカさんの手紙にも同じなんじゃないかって……怖かったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ごめんなさい、セリカさん！　返事は明日書きますね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あっ、便箋の下のほうにまだ何か書いてある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「そういえば、チームメイトが言うには、もう少しすればサーミに春が訪れるのだそうです。雪の中で何を見つけたと思いますか？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「答えは同封した写真に写っていますから、答えを出してから見てくださいね。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "写真……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ダメダメ、見る前にまずは答えを考えなきゃね、ピローちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピローちゃんはキノコだと思うの？　そうだね……私はきれいな氷のブロックだと思うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "それじゃあ答え合わせしよっか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あっ、雪解けだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "草原に積もる雪は薄く、所々から緑がにじみ出ていた。\n桃色のつぼみが一つ、纏っていた白い雪衣を脱ぎ去り、風の中でゆらゆらと揺れている。\n写真はそんな瞬間をしっかりと捉えていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "きれい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ねぇピローちゃん、そういえば私たち……サーミの春って見たことなかったよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピローちゃんも同じこと考えてるの？　でも無理だよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "手元にある仕事を終わらせてから外出申請をするとなると、かなり時間がかかるし、サーミに着く頃にはもう春は過ぎちゃってるよ。それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あんな遠い場所には行けない……何度も一緒に試したでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あっ、いいこと思いついた。セリカにたくさん写真を撮ってもらえばいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "やっぱり今すぐ返信を書くね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「親愛なるセリカさんへ……」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "プリン、セリカから返信はまだ届かないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "そうなんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "前回の手紙からそろそろ二ヶ月は経つし、もうそろそろ届く頃じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "あー、楽しみすぎて、仕事に集中できないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "あともう少し頑張れば退勤時間ですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "もうここに座って三十分も話してるけど、プリンは今日残業しなくていいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "せっかくだし、この後一緒にメシでもどうだ？　食べながらセリカの「旅行記」について語ろうぜ。焼肉でいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "えっ、私ですか？　なんでも大丈夫ですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "俺の一番のお気に入りのエピソードは、サーミ人たちが駄獣に与える餌を、セリカがビスケットと間違えて食っちまう話だ。アハハハハ、いつ思い出しても笑っちまうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "いやいや、エンジニアチームがサーミ人の意見を無視して設備を建てちゃったのを、セリカが自ら進んで仲を取り持って、衝突を見事に回避した話が一番でしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "プリンはどの話が一番好きなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "こんにちは！　皆さんお待ちかね……サーミにいるセリカさんからのお手紙ですよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "おぉー！　待ってたぜ！　早く見せてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "も、もう少し落ち着いて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "ハハハ、ここ読んでみろよ。笑いすぎて腹が痛ぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "エンジニアチームはまもなく黒き森を離れ、北東部の湿地へ向かう予定だと書かれていますね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「隊長が言うには、湿地での初の拠点となる場所は、過去にエンジニアチームが基本的な電力設備を設置した集落の近くにあるのだそうです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「私の予想だと、恐らくそこはプリンさんがかつて訪れた集落ではないかと思うんです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「電気が使えるようになったサーミ人の生活が、どのように変わったのか……きっとプリンさんも私と同じくらい答えを知りたくてワクワクしてますよね！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「今回の旅は、楽しいことばかりではありませんでしたけど、これでようやく願いが叶うと思うと、ついつい声を出して笑ってしまうんです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「あの夜、ラボでした会話をまだ覚えていますか？　あの時、決めたんです。私も自分が身に着けた技術を使って、人々の生活を変えたいと。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「だから、私の今の願いは、全力で集落の電気システムを最適化させること。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「プリンさん、そのためのアドバイスをもらえませんか？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "プリン？　どこに行くんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ごめんなさい、今夜の食事はキャンセルさせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "私……準備しなきゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "おはようございます、ボールさん。っ……廊下、寒すぎませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "俺も朝来て、あまりもの寒さに震えが止まらなかったよ。だけど空調制御システムを調べたら、廊下のクーラーはオフになってたぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "この冷気は、通気口から吹いてきてはいないようです……あっちから来てるみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "あの方向にあんのは……電気エンジニア実験室か！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "うわっ、寒っみぃ……なんだこりゃ！？　床が水浸しじゃねーか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "実験室が浸水しちゃったんでしょうか？　すみませーん、誰かいますかー？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "驚かせてごめんなさい、床に防水処理は施してありますので。防水用のシューズカバーはドアのそばに置いてあります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "プリンの仕業だったのかよ。また施工環境のシミュレーションでもしてたのか？　この環境は……もしかしてサーミ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい、正確にはサーミの湿地ですけどね……実験室内で湿地環境をシミュレーションしたのは、今回が初めてです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "コーヒーの袋が大量にある……まさか徹夜でやってたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "これは気にしないでください……それよりも、すみません、手伝ってほしいことがあるんです。少し厄介な問題が起きてて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "どれどれ……ん？　何かが靴に絡みついたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "気を付けてください。多分水草に見立てたケーブルです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "これは……サーミの湿地で最新の送電技術を試そうってか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "確かにこのやり方なら、長距離送電の安定性と制御性を大幅に向上させられるが……実行可能なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "以前立ち上げた源石変電所と電力設備パラメーターに基づけば、理論上は問題ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "それにセリカさんもこの技術の開発に参加していたので、設備の改造とケーブルの敷設は、彼女にとってさほど難しいことではないはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "問題は負荷制御ですね。ここを見てください。潮流計算の結果によれば、ここの部分は改造後も正常に使用できますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "将来的に到達する可能性のある消費電力のピークを考慮すると、負荷が基準値を大幅に超えてしまうんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "色々考えているのですが、いい解決策が思い浮かばなくて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あの、プリンさん……実はぼくも前に似たような問題に遭遇したことがあります。ちょっと待っててくださいね。その時の資料を持ってきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "グレイは書類の束を抱えながら、水の中をおぼつかない足取りで進みながら戻ってきた。\nその後、三人は足首まで浸かっている「沼」の存在も忘れてしまうほどに、工事について夢中で議論を交わした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "資料を発送してきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "よし、ならあとはセリカに任せるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "二人とも……わざわざ時間を割いて手伝ってくれて、本当にありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "いやいや、やっとプリンの力になれるチャンスが巡って来たんだ、むしろ嬉しいくらいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "だけどよ、サーミの環境は流石に複雑すぎたな。妨げになる要素が多すぎて、隣で見てるだけでも頭が痛くなってくるぜ。現地に行かずにあそこまであらゆる状況を想定できるのは、プリンだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "セリカ、ヘマすんなよ。必ず完成させてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "だけど、見落としがあるんじゃないか、どうしても心配で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "プリンさんが提案した改造プランは、現代的な村の給電ニーズを完璧に満たしています。あまり心配しなくても大丈夫ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "そうだぜ、プリンはもう十分よくやったんだから、もうあれこれ考えんなって。実地調査ができない以上、多少の見落としがあっても仕方のないことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "環境ってもんは常に変化してんだ。頭の中だけで、全部の問題を想像することは到底無理さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "……やっぱり、実際に現地に行って考察を行えたほうがいいってことですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "そんな顔すんなって。プリンが外出が苦手なことは、みんな知ってるよ。無理やり嫌なことをする必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "でも今のままじゃ、みんなの助けになれないから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "そんなわけないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "でも外に出たら……また何かやらかしてしまったり、何かの危険に巻き込まれたりするんじゃないかって、怖くて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "それについては……心配いりませんよ、プリンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "もしプリンさんが外に出たいのなら、そこがどこであれ、必ずぼくたちもそばにいます。今みたいに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピローちゃん、セリカさんからの手紙、まだ届かないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "うん、そうだよ。今日は残業じゃなくて、ただここにいたいだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "コーヒーでも飲もうかな……でも、残業しない日の夜は、ホットココアの味が恋しくなっちゃうのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "なんだか元気なさそうだねだって？　ここ最近ずっと悩んでるの、ピローちゃん知ってるくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "思い返してみれば、ロドスに来てからやったことと言えば、みんなのアイディアを図面に落とし込むことと、シミュレーション実験だけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "そのせいでちょっと夢を見ちゃったのかな？　このままずっと引きこもっていたとしても、優秀な電気エンジニアになれるんじゃないかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "でももしかしたら、風に吹かれ時間が流れていくうちに、たくさんのことが私たちの知らないところで、ひっそりと変わっていったのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "セリカさんが羨ましいよ……あの子が何を見たのか、すごく知りたい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "プリンさん、こんばんは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "セリカさんからの手紙ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "ええ、どうぞ。では、よい夜を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "早く開けようぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "もう待ちきれないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "うん……って、いつの間に来てたんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "俺らは……たまたま通りかかっただけ。そう、たまたま！　ホットココアを取りに行ってたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "ほら、お前の分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "さあさあ、俺らのことなんてどうでもいいから、早くセリカの手紙を読もうぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「プリンさんへ。これから書くことを読んだら、プリンさんはさぞかしショックを受けることでしょう。実際に私も最初に見た時は、驚きを隠しきれませんでした。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「どうやって説明すればいいのか、少し考えさせてください……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "これしか書いてないようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "次の便箋にまだ文字が書いてあるみたいだぞ。めくってみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「例のサーミの集落に到着した時、驚いたことに彼らは私たちの想定とは大きく異なり、電力や現代設備を使っている痕跡は全くありませんでした。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「彼らは未だに昔ながらの方法で明かりを灯していたんです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「この集落の生活は、数年前にクルビアの探検隊が初めて訪れた時とほとんど同じでした。現代の科学技術は彼らに大きな変化をもたらすことはなかったようです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "そんな……でもあの時見た笑顔は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "プリン……まだ落ち込むには早いって。続きがあるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "えーどれどれ……「ですが、驚いたのはそれだけではありません。彼らは何も科学技術を不要なものだと一蹴してたわけではなかったんです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "「それどころか、彼らはサーミ特有の、私たちには思いつかない方法で技術を日常に融合させていたのです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "封筒の中に写真も入ってるみたいだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "光。\n涙で視界がぼやける前に、プリンは光を見た。\nその光源は紛れもなく、現代技術が生み出したものだ。源石から供給された電力が発光ダイオードを灯し、柔らかな白い光を放っている。\nだが、写真のどこを見ても、照明器具は写っていなかった。\n彼女は角の生えた生き物が、ゆったりとした足取りで森の中から現れるのを見た。\nその毛皮は、まるで枝から落ちた最初の氷の結晶のように、月のごとく静かにキラキラと光り輝いている。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "氷像だったのかよ！　本物かと思ったぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "へぇー、サーミ人は照明管を氷像の中に閉じ込めて、体から光を発しているように見せてんのか。すげーきれいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "たった今、これが一番お気に入りのエピソードになったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "一番下にまだ何か書いてあります……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "手紙の最後に、セリカはこんな一文を残していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「写真、見てくれましたか？　サーミ人にこのような習慣があるなんて、どの本にも書かれていません。でも私たちは確かにこの目で見たんです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「プリンさんの努力によって、彼らの生活が変わることはありませんでしたが、この結末は……同じくらい素敵だと思います。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「プリンさんも同じことを感じたかどうかは分かりませんが、この光景を見た瞬間に、私は全く新しい、だけど常にそこに存在していた物事に触れたような気がしたんです――」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「これまで感じ取ろうとしていなかっただけで、ずっとそばにあった何かに。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「サーミは静止したスノードームなんかじゃありません。この大地は常に私たちの想像を超えていくんです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「プリンさん、私はこれからも前へ進み続けますが、それは決して何かを変えたいからではありません。何をしなくとも未来は自ずと生まれるものですから。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "「私はただ見たことのないたくさんの景色を見るために、歩み続けるだけです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "私だって……立ち止まってなんかいられない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "えっ、見間違いじゃないよね……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "船の外……デッキに立ってるの、本当にプリン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "よぉ、調子はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "プリンの付き添いで船外設備の電子回路を点検して回ってんだ。プリンが船を離れんのは、今回で初めてじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療部オペレーター",
      "text": "あんたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "違うから！　プリンが自分で言い出したんだよ。俺が無理やり引っ張り出したわけじゃないから、そんな目で見んな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部オペレーター",
      "text": "ここに来るまでやる気満々で、すっげー意気込んでたぞ。信じられないなら見てみな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "だけどプリンさん……なんだか震えてますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "怖い……怖いよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "ピ、ピローちゃん……私やっぱり、外なんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリン",
      "text": "絶対に無理だって！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
