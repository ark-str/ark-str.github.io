{
  "server": "jp",
  "storyId": "act15d5_level_act15d5_st02",
  "groupId": "act15d5",
  "stageId": null,
  "title": "荒野悠々",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15d5/level_act15d5_st02.txt",
  "sourceHash": "0433852a24c05e6c374d57b62351117a10bdc25eccbd876ed71538c82c21a652",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "果ての見えない荒野。赤い髪のヴァルポの男が地面にしゃがんで何かをじっと見つめている。\n彼の背後には一台の車が停まっていた。白髪のループスの男と黒髪のフェリーンがその車の点検をしていた。\nどうやら三人は共に旅をしているようだ。そしてその道中で、車が故障してしまったのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おーい、アオスタ、ちょっと来てくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "何です？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "見てみろよ、この虫――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "一列に並んで歩いて、めっちゃ規律正しくね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "それにこの列かなり長いぜ。どこに行くつもりなんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……元気が出てきたみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おうよ、だいぶ良くなったぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ですがキアーベ……あなたの体調に関する自己判断は、あまり信用できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "オメーは俺の母ちゃんかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "あなた三十分ほど前まで、吐血してたじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そうだっけ？　ハハッ、でも今は大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "あっ！　やっべ、お前と話してたら虫が行っちまったじゃねえか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "はぁ……僕は車の修理に戻りますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おっ、何が問題かわかったか？　俺も手伝ってやろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "パイプに不具合があるようです。それでエンジンがかからないんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "僕とブローカの二人で対応できます。あなたはどこかへ行ったりしなければそれでいいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "どっか行くったってここにゃ何もねぇぞ。どこに行くってんだよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しばらくして、ようやくエンジンのかかった音が聞こえてきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ふぅ……ブローカ、キアーベを呼んできてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おい、ブローカ、どっちの方がションベンを遠くに飛ばせるか勝負しようぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……今は出ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "そんな質問に真面目に答えなくていいんですよ、ブローカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "……んだよ、もったいねぇなぁ！　立ちションするのにピッタリな天気だってのによぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "極寒の地を除いて、ショ……用を足すのに不都合な天気なんてないと思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "わかってねぇなぁ、アオスタ、こういうのは気分の問題なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おぉ、見ろ、完璧な曲線を描いてるぜ――あ！　*シラクーザスラング*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "どうしました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "急に風が吹いてきて俺の完璧な曲線が靴にかかっちまいやがった！　くそっ、ついてねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……ふざけてないで、早く出発しますよ。日が落ちる前に集落でも見つけないと、今日は荒野で野宿ですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "荒野じゃいけないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そういえば、俺まだキャンプってしたことねぇんだよな。そうだ、今日はキャンプにしようぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "荒野は危険です。加えて、そもそもこの盗んできた車にはキャンプ道具なんてありません。車で寝るしかないですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "それに、燃料の問題もありますしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "チェッ、使えねぇヤツだなぁ、コイツの持ち主は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "都市に住んでいて郊外に出る予定もないのに、車にキャンプ道具なんて普通積みませんよ。ましてや予備の燃料なんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "だけどよ、準備したとこで損はねぇだろ？　いつ誰がキャンプ用に借りて行くかわからねぇじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "じゃあキアーベなら準備しておくんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "うーん……しねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "だったら黙って出発の準備をしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "へいへい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "出発できるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "はい。僕が運転します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なに？　次は俺の番だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベはゆっくり休んでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "アオスタ、俺気付いたんだけどよ、お前最近どんどん母ちゃん化してきてるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なぁ、ブローカ、お前もそう思わねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ちょっとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……あなたたち二人が鉱石病に感染したからですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "生活習慣の改善が、病状の抑制に役立つと聞きました。キアーベ、あなたは毎日もっと早く寝ないといけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おいマジかよ……知ってるかアオスタ？　俺の母ちゃんですら、そんなことは一度だって言ったことねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "*シラクーザの慇懃なご挨拶*、うるさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アオスタはそう言い捨てると、エンジンをかけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "音楽かけようぜ。何がいいかな……っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おぉ、この車の持ち主は結構色んな曲聞いてんだな……アハッ！　これなんか、ジャケが結構イケてんじゃねぇか、これにしよう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "キアーベが見つけたディスクをカーオーディオに入れると、軽快な曲が流れてきた――\n「♪Saturday 俺の駄獣にまたがって」\n「♪Like a star プレゼント持って君の家に行くよ」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "（口笛）結構いいよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "確かに。では、行きますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そういえば、アオスタ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "俺たちって、今どこに向かってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "その質問の答えは、出発する時にすでに言ったはずですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "忘れちまったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "そもそも聞いてなかっただけでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "目的地はロコモティヴァシティです。逃げ出す際に僕が持ち出した地図によれば、そこが一番近い街です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "あそことうちのファミリーの仲はあんまり。規模的にもうちのファミリーがようようと手を出せるところではない。運次第ですが、彼らに拾ってもらってもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "もしダメでも、少なくとも足を休められる場所はあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "……なぁ、シラクーザの西の方に、奇妙な町があるって聞いたぜ。そこにゃよくお化けが出るんだってさ。ちょっと行ってみねぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "バカ言わないでください。どこにあるかもわからないんでしょ？　そもそもそんなもの、誰かの作り話に決まってる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "じゃあ、ほかの十三家の連中がいる都市に行くってのはどうだ？　まあ、期待はできねぇけどな。古巣の例もあるしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ケッ。シチリア連合なんて名前だけは立派だけどな。あいつらも一応は「十三家」の端くれだってのによ、年がら年中、身内で揉めてるだけじゃねぇかよ。なーにが連合だ、クソが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "シチリア連合は本物の大ファミリーとは違って、中小規模クラスの寄せ集めのファミリーで構成されてますからね。決定的な強者がいなければ、誰が上に立つかで揉めるのも仕方ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "平和な小競り合いですよ。大ファミリーの連中は、僕たちみたいなシチリア連合の無名の者を相手にしませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "チッ、まあそのうち向こうから加わってくれって頼みに来るだろうけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "とにかくヴァイトシティにはしばらく戻れません……いや、もしかしたら永遠に戻れないかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "それに、トリンファミリーの怒りも買ってしまいましたからね……もはやヴァイトに僕たちの居場所はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハハッ！　あんなでっけー騒ぎを起こしたんだ、ボスのツラを拝んでやりてぇぜ。ペッ、あのリントンの汚ねぇ顔は今どんな表情してやがんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……まったく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "どうした？　ハッ、ここまできて後悔しても遅いぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "後悔……とまではいきませんよ。リントンは確かにクソ野郎でしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "僕たちを馬鹿にしても限度というものがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。俺も後悔はしてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "肥溜めのことなんて忘れようぜ。そういやよ、ファミリーのために罪を被ることが、一員になるための儀式だってとこもあるだろ？　苦難を背負うことで本当の家族になれるんだとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "だが、俺たちはファミリーに逆らって、あの都市から逃げ出した。つまり、俺たちは共に苦難を背負ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "つーわけで、俺は今ここに宣言するぜ。お前たちは二人とも、このキアーベファミリーの一員だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "アオスタ、お前はファミリーの第一参謀だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ブローカ、お前はファミリーの特攻隊長だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "フッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「♪でも君が床に向かって微笑んでるのを見てわかったんだ――」\n「♪You don’t know――」\n「♪君はわかってないね、自分がブサイクだってことを！」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ってか、こんなに走ったのに人っ子一人見当たらねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "もともと少数の集落や村以外は、都市の外に人なんてほとんどいませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "都市ではやっていけない一部のファミリーが、荒野で好き勝手してますから。何回かファミリーの商隊についていったことがありますが、いつも万全な対策をしてましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "今の僕たちみたいに何の準備もないまま荒野に出るなんて、普通に考えたら死あるのみです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、「死あるのみ」か……その表現、俺は好きだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "まぁでもそうだな、俺が修理工場にいた頃も、外に行く奴らは色々と準備しに来てたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "はぁ……逃げ出す時にもっと食い物を持って来りゃよかったな……なあ、アオスタ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "トランクの食料はダメですよ、緊急用なんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "チェッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "逃げられただけでも御の字ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "もしも昨晩の見張りがマンデルじゃなければ、僕たちは今頃暗い部屋の中で、目隠しされて椅子に縛りつけられてますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ブローカ、次にこういうことがあった時は、食い物多めに持ったか俺に確認してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "はぁ……まったく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "でもつまんねーよな、こんな広い土地があるのに使えないなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ほら見ろよ、この場所。ここにこーんなでっかい修理工場建てて、車の改造なんかできたらどんだけ気持ちイイだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "場所があっても、長く住める場所ではありませんからね。天災には抗えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "はぁ、天災に鉱石病……この大地には良いことなんて何もねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ブローカ、何か面白いことねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……読むか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なんだそれは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "読み終わったばかりの本だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "どんな内容なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "対立するファミリーに所属していたことで、最終的に引き裂かれたある恋人同士の小説だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……結末に感動する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "俺はいいや。しかしお前、なんでそんなの持ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "アオスタが道中暇だろうって言ってたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なぁ、ブローカ……前から気になってたんだがよ、お前そういう本が好きなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "すごく好きというわけではない。ただ暇な時に読むのは悪くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そうか……そいえばアオスタ、お前って彼女いたことあんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ブローカは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハハッ、俺もねぇや。恋愛って何が面白いんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なぁ、アオスタ、お前もこういう本が好きなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "僕は政治や歴史に関する本の方が好きですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "チッ、お前に聞くんじゃなかったよ。そういう単語は、聞いただけで眠くなっちまう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「♪彼女はヴィクトリアのバンドでハーモニカを吹いてた」\n「♪だけど彼女はクルビア人に恋をした――」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "はぁ、なんか刺激的なことねぇかな――ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なぁ、アオスタ、あそこ見てみろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "あれは……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "商人",
      "text": "お願いします、どうか許してください……私はまだ家に母と子供がいるんです……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "うるせえ、俺様だって同じだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "黙って大人しくしてろ、俺様を怒らせたらメッタ刺しにするぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商人",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おい、アオスタ、ブローカ……俺に考えがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "彼らに加わって一緒に略奪するなんて言わないでくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "あ？　あの強盗をやっつけて、その礼に商人から何かもらおうぜって話をしてんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "まあ、お前のその提案も悪くないけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "いえ、あなたのプランにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "本当か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "本当です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……もし何もくれなければ、その時に奪えばいいだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "よーし！　そんじゃ全速前進だ、あのアホどもをぶっ飛ばすぞ！　ブローカ、ケンカの準備だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗A",
      "text": "おい、あれを見ろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "なんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、これでもくらえ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗B",
      "text": "ふん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "チッ。防ぎやがったか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "（小声）僕がチャンスを作ります。あなたはその隙に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商人",
      "text": "（小声）わ、わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "それと、ブローカ、あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ、ベストを尽くそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗A",
      "text": "なにコソコソしゃべってやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "消えろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "チッ、手強いな……お前ら来い、こいつから抑えるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗C",
      "text": "おう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "フンッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗B",
      "text": "おいそこのガキ！　どこへ行く気だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "今のうちです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商人",
      "text": "わ、わかった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アオスタの策略により、強盗たちの脳裏から商人の存在がほんの一瞬消えた。商人はアオスタの指示のもと、その隙を突いて車に飛び乗った。\nそして、大きな音を立てて、車は走り去って行った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "*シラクーザスラング*！　てめぇら、よくもやってくれたな！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おい待てよ、これじゃ俺たちがもらう物資はどうなるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "まずはここを生き延びるのが先決です！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "強盗たちが逃げ出した商人の車に気を取られている隙を狙って、アオスタは自分たちの車に飛び乗り、エンジンのキーを捻った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベ、乗って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おうっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "キアーベの反応を待たずに、アオスタは車を急発進させて強盗たちに向かって突っ込んでいく。\nキアーベも慣れた様子で、二人の強盗の間を素早くすり抜けると、車が加速する前にドアノブをつかんで車内に滑り込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗A",
      "text": "逃げるんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ブローカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ブローカが手にしていたドリルを振りかざして、強盗を怯ませる。そしてアオスタの運転する車が近くを通り過ぎようとしたその時、ひらりと身を翻して車に乗り込むのだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "しっかりつかまってください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "チッ、逃がすな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "強盗たちは三人の乗った車を止めようとするも、すでに動き出した車をそう易々と止めることはできない。最終的に、三人の車は強盗の包囲を突破し、地平線に向けて走り去っていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "なにボケっとしてやがる！　お前とお前、それからお前はあの商人を追え。残りはあのクズども三人を追うぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗頭領",
      "text": "あいつらは必ず今日この荒野でぶっ殺す！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗たち",
      "text": "おうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "わーお、見ろよアオスタ、あいつら追って来るぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "わかってます。シートベルトしてください、スピード上げますよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「♪Put your hands up！ 胸に抱いたまま」\n「♪Breathe and jump！ 忘れないで力強く」\n「♪Dive into the crowd！ まだ始まったばかり」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アオスタが限界までスピードを上げても、強盗たちは食らいついて離れない。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、マジで諦めの悪い奴らだな――ゲホッゲホッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベ、窓を閉めて。連中を見なくてもいいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "な――んだ――って――？　風が強くて聞こえねぇよ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ブローカ、キアーベを引っ張り込んで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ゴホッゴホッゴホッ――なんだなんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "アオスタが窓から顔出すなと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "どうしました？　急に咳き込んだりして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "わかんねぇけど、風が喉に吹き込んだんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ならいいですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "さて、良い知らせと悪い知らせがありますが、どっちから聞きたいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "うーん悪い方が先かな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "燃料があとわずかです。もうすぐこの車は動かなくなります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、じゃあ良い知らせは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "燃料が底をつく前に、奴らを振り切れそうです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なるほど、こっからでも移動都市の壁が見えるぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ええ、おそらくあれがロコモティヴァシティです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "へぇ、結構立派じゃねえか。ヴァイトより――ゲホッゲホッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベ、本当に大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "へーきへーき。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……ならキアーベも車を推してください。近いように見えますが、徒歩では丸一日かけてもたどり着けませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "もう燃料はないんだろ？　だったら車を捨てて歩いた方が速いぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "実は少しだけ残してあります。都市に近づいたら――もしくは奴らが追いついてきたら乗るつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "それと、この車は今僕たちが持つ唯一の財産です。これを捨てたら無一文で見知らぬ街に入ることになりますよ。どうするんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "（口笛）わかったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "至ってどうでもよさそうな顔をしていたキアーベであったが、それでも彼は車の方まで歩いて行くと、二人と一緒に車を推し始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なぁ、アオスタ、音楽流すくらいは構わないだろ？　燃料も消費しないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……まぁ、それくらいならいいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "よっしゃ！　どれにしようかなぁ――こいつはどうだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「♪Hey light, my old friend」\n「♪君とまた話がしたいんだ」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "――チェッ、全然盛り上がんねぇ曲だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "僕はいい曲だと思いますけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "俺もだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "わかったよ、二人が気に入ったならこれにしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なぁ、アオスタ……俺たちがどうやって知り合ったか覚えてるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "え？　もちろん覚えてますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "あの頃、まだあなたは修理工場で働いていて、うちのファミリーの人間とトラブルになってそいつをぶちのめした。それで僕はあなたを始末するよう命じられたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ！　それで俺たちゃ、散々やり合った挙句、最後に打ち解けて仲良くなったんだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "フッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ゴホッゴホッゴホッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "大丈夫だって。ブローカは、覚えてるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "もちろんだ、永遠に忘れない。お前たち二人が俺を救った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハハッ、お前はほんっとにバカだったよなあ。自分のファミリーに裏切られても気付かないなんてよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "でも安心しろ、俺は絶対お前を裏切ったりしないからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……考えてみれば、僕たちは知り合ってかなり経つんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そうだな、ゴホゴホッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベ、やっぱりあなたは車で休んでてください。無理をしてはいけません、車は僕とブローカで十分推せますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、無理なんかしてねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ブローカ、俺たちゃ多分、一緒に鉱石病にかかったよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "わからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "違いますよ、ただ二人ともほぼ同時にそう判明しただけで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ブローカはおそらく、ファミリーの抗争中に源石製の武器によって傷つけられたせいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "あなたに関しては、普段から感染対策を怠っているので、いつ感染したとしてもおかしくありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "へいへい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ゴホゴホッ！　アオスタ……お前も一日中俺たちと一緒にいたら、いつか感染するんじゃねぇの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "かもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "でも感染したとしても別に。悪いことだとは思いませんし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "あ？　なんでだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "二人が辛い思いをしてるのを、一人見ているよりはましです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハハハッ、さすがは俺のダチだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベ、今日はほんとに無駄話が多いですね。やっぱり車の中で横になって休んでてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ゴホゴホッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "アオスタ、俺は嫌いなものリストに一つ追加することにした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "何をです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "鉱石病だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……ブローカ、キアーベを車に乗せてあげてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これまでずっと物静かだったブローカは、言われてキアーベを抱きかかえると、そのまま彼を後部座席に乗せた。それから戻ってきて引き続き車を押し始めた。\nキアーベは車のシートに横たわると、太陽が眩しすぎるのか、腕で両目を覆った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "だってよ……この病気のせいで、俺たちはリントンの野郎に捨て駒みたいに扱われたんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おまけに呼吸までしにくい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "アオスタ……俺たちが十三家のボスになった暁には、ぜってぇこの鉱石病をどうにかしてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……ええ、その時には大勢の医者にこの病気を研究させましょう。もしくは優秀な病院に金を積んで研究でもさせましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、そうだな。そんで俺がでっけー病院をぶっ建てて、感染したせいで、他人に踏みつけられた連中を全員ぶち込んで、みんなまとめて治してやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そんで見下した奴らを全員ぶちのめす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "俺も手伝おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ！　当たり前だろ、アオスタもだぞ。忘れんなよ、お前らは俺の第一参謀と特攻隊長なんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ええ。わかったから、もう黙って休んでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "なぁ、アオスタ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……何です？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "荒野で死ぬのってどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "何を言ってるんですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "十三家のボスになるんじゃなかったんですか？　こんな場所で死んでどうするんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "だが、よく考えてみたんだけどよ、こうやって荒野で死ぬってのもそんなに悪くないんじゃねぇかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "どんなにすげぇ奴でも死んだら墓に入る。荒野で死ぬのも何百万もするベッドで死ぬのも大して違いはねぇだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "石を何個か拾ってきて、穴掘って入って、横になって目を閉じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そんで、一人で静かに死ぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "そんなに悪かねぇよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "待ってください、キアーベ、一体何を言ってるんです！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "俺が言いたいのは……今日の空は、マジ*シラクーザ式感嘆*青いよなって――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「♪私を埋めてくれ、果てなき荒野に」\n「♪さらば友よ、さらば永遠に――」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "バッテリーが尽きたのだろうか、カーオーディオから流れていた曲が突然止まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "キアーベ、キアーベ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "こんなところで死んだらダメです！　キアーベ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ブローカ、車に乗って付近に集落がないか探しましょう、誰かしら人が見つかるといいのですが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "スー……スー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "アオスタ、キアーベは眠っただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "……まったくこの人は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "しかしキアーベの病状は予断を許しません。できることなら感染者を進んで診てくれる医者を見つけたい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "おーい！　お前らの車、故障してるのか？　助けは必要か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "できやした、刺身盛り合わせ三人前です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハハッ、やっと来たぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "どうも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "つまり、キアーベさんたちはその時ロドスに助けられて、そのまま加入したってわけですかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "いえ、そのスケールというオペレーターは、ロコモティヴァにあるロドス事務所に連れて行ってくれたんです。キアーベはそこに駐在していた医療オペレーターの治療を受けました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おぉ、ジェイ！　お前の料理やっぱウマいな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ありがとうございやす。てっきり皆さんはそのままロドスに入ったのかと思いやしたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ちげぇよ。あの時はまだロドスをよく知らなかったしな。しかもアオスタは薬と交換に車まで渡したんだぜ？　ケチ臭い奴らだと思ってたくらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "けどロドスの薬はすげぇ効いたんだぜ。なっ、ブローカ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "確かにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "僕たちがロドスに加入した理由を簡単に言うと、キアーベが、ロコモティヴァのとあるファミリーのボスを怒らせて、またも追われる身になったからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "その時に助けてくれたのもスケールさんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "そして彼の紹介で、僕たちはロドスに来たんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "そうだったんすね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "でもよ、アオスタ……あれは俺のせいじゃねぇだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "わかってますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "こいつはまた、訳ありみたいっすね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ！　ジェイ、お前時間あるか？　じっくり聞かせてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "もう夜中っすね、明日は任務もないですし……ちょっくら龍門から持ってきた酒を取ってきやす。飲みながら話しましょうや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "ハッ、そりゃあいいな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "あれはな、夜のことだったんだが、俺とアオスタがちょうど――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "深夜の食堂にて、男たちの語り合いはまだまだ続く……"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
