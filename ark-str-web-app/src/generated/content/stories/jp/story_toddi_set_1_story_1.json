{
  "server": "jp",
  "storyId": "story_toddi_set_1_story_1",
  "groupId": "story_toddi_set_1",
  "stageId": null,
  "title": "装甲と重弩",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_toddi_1_1.txt",
  "sourceHash": "5bf57dbce9819368ccb83c6ee1f20ecb40ba330a2bf84f66070ded31da7feb8f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……はっ……はっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……ふぅ……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あんた、左！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ふッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "おい、フィディア──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "もう向かっている！　左は私とアイアンハイドがカバーする！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あたしが言ったのは、破城矢の落下地点が左って意味──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……射線上に入ってるっての。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ちょっとフィディア、生きてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "こんなにやりにくいケンカ、生まれて初めてだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ふーん、あんたのそのデカブツけっこう頑丈じゃん。見たところ爆発の衝撃を受けただけで、大きな損傷もないみたいだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "その分じゃ破城矢の火薬量をもう二十パーセントくらい増やしてもいいかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ならば今後、お前と同じ任務に出るのは絶対にお断りする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "むぅ……第三関節の油圧システムがガタついている、この修理費はお前に請求するぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あたしのせいにしないでよね。あんたのメカは視界を圧迫して邪魔なの。それに、そんなデカい的がうろちょろしてたら打ちたくなるもんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "そのうち本気で打ってみようかな、貫けると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……次にお前の部署が武器予算の申請をした時には、ティアカウの名誉にかけて反対票を投じさせてもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ちょっと、ふざけたこと言わないでよ！　あんたには攻城武器の重要性もわかんないわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ロドスはいかなる攻城武器も備えることはないと、師匠が言っていたぞ。我々の中立の原則に反するからだそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ただ、お前のその大きいだけの弓では、攻城武器の内にも入らないのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "なっ……！？　携帯攻城用弩も攻城武器のカテゴリーだっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "その弓矢にはエンジンすらついてないじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "弓矢にエンジンなんてついてるわけないでしょ！　それにあたしのこれはバリスタだし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私の部族の弓矢にはエンジンがついていたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……フィディア、ケンカ売ってんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私の名はズゥママだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団",
      "text": "おいコラァ！　俺たちのこと無視してんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二人同時",
      "text": "黙れ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団",
      "text": "ぐぉー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "上等じゃん。あんたのそのガラクタが、この破城矢の一撃に耐えられるかどうか、確かめてみようじゃないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "望むところだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の男",
      "text": "あのー……ちょっといいかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "殺されたいの？　こっちは今忙しいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の男",
      "text": "お二人はロドスの方かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あなたは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の男",
      "text": "先にニ、三言わせてもらおう。そのバリスタだけど、右側のトルクがかかるパーツがさっきの戦闘で摩耗してしまってるから、続けて使うと精度に影響が出るかもしれないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……チッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の男",
      "text": "あとそこの……えーと……黄色いトラクター？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "この子のことはアイアンハイドと呼ぶといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の男",
      "text": "それ、冷却システムの状態をチェックしてみた方がいいと思う。これ以上放っておくと、そのうちエンジンがガタガタ鳴りだすぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……本当にそうみたい！　助かった、えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の男",
      "text": "ジョーとでも呼んでくれ。初めまして、ロドスの方々。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "私が今回の任務の依頼人だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "作戦メンバーは……君たち二人だけなのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "文句ある？　あたしたちのプロとしての腕が信用できないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "いやいやとんでもない。君たちはシェーシャのお墨付きだろう？　それにロドスの勇名は……荒野の住人の間にも轟いているからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "ただ、だからと言って、二人だけというのはさすがに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ハハッ……実は少しトラブルがあってな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "あと一時間ほどで、情報に該当する廃棄区画に到達します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "トギフォンス、ユーネクテス、装備のチェック終わりそう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ふぅ、今しがた積み込みを終えたところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "アイアンハイドは状態良好。この前師匠と全面的なアップグレードを施したから、運転席の座り心地もだいぶ良くなってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あー、今回はあの妙なリーベリを見かけないと思えば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいやが操縦をいつまでも任せっぱなしにするのは良くないと言っていた。これは私のメカなわけだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "私からすれば、むしろ君が操縦してたほうが安心かな……それとトギフォンス、攻城用弩の調子は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あのさー、あたしはドクターから廃棄区画の攻略だって聞いて来たんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "それが、どうして救援任務なわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……今更それ聞く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "はぁ──この任務のために三日間徹夜して、特製の超大型破城矢をこしらえたってのに！　それで荒野の住人の救援！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "トギフォンス……次からは任務の前にブリーフィング資料を最後までちゃんと読もうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "敵がすでに当該地点を占領していて、防御施設を盾に反撃してくる可能性があるの。それで万一のことを考えて、強襲戦に適した君たちをドクターに指名してもらったわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "現在向かっているのは廃棄区画ということだが、元々は移動都市の一部だったんだろう。重火力の兵器を用意しておくのは間違いじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あーあ、つまんない──こんなことなら、買い物にでも行っとけばよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "情報によれば、その荒野の住人たちは移動都市を追って長い距離を渡り歩いてきたとか。ようやく廃棄区画が出てきて、補給物資なんかを漁ってしばらくそこに落ち着くつもりだったんだろうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でも実は、そこの所有者だったパーディシャーは「ママジョンズ」ととっくにリサイクル契約を交わしてたってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ふん、奴らの商売のやり方は昔っから「ストレート」だから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "前方のカンニング交差点で落ち合おう。南西の方角から……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "お話の途中すみません、ブレイズさん。なんだか視界が悪化してるような気がしませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "風の音……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "前方に異常気象発生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "こっちの車両からも砂煙が見えるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "くっ……すごい密集速度！　車に乗り込んで、早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "text": "本艦より受信、前方に雷砂嵐が急速に発達中！　本艦がナビゲートしてくれるそうです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "全速前進！　急いでここから離れなくちゃ！　トギフォンスたちも早くついてきて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "とっくにアクセル全開だっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ダメ、そのスピードじゃ間に合わない！　装備を捨てて負荷を軽くするしか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "時間がない、早く装備を捨てて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "正直、この攻城用弩を買うための予算を、もう一度クロージャに承認してもらえる自信がないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……アイアンハイドも先週メンテナンスしたばかりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "聞こえ……（ザザー）返事をし……（ザザー）急い……を捨て……本艦（ザザー）……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "エネルギー伝導システムの調整も面倒だし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "エンジニア部の人たちが心血注いでようやく改良することができたモデルなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……艦──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "チッ、通信が途絶えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "左前方の山肌に洞窟がある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "フィディア、賭けてみる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "いけるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "目測じゃ車幅は大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それ以外は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "だから賭けだって言ってるでしょ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "掴まって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "で、運が良かったってわけだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "更に言えば、雷砂嵐も小規模だったのが幸いだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ただ、途中で出くわした砂トカゲ団とかいう奴らを片づけるのに、だいぶ手間が取られた。あたし一人だったらまだ対処も楽だったんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "どの口が言ってるんだ！　お前が無闇に矢を打つからだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "落下点は教えてあげたし、避けない方が悪いんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前ってやつは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "お二人さん、着いたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "ただ、少し遅かったようだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "よく聞け、貴様らはママジョンズ傘下の資源リサイクル会社に帰属する固有財産を不当に侵害している。我々は貴様らをママジョンズの規約に則り制圧、及び法の下に排除する権利がある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の人A",
      "text": "隊長さん、私たちは道理に反することなど何もしておりません！　ぐわぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の人B",
      "text": "か……勘弁してください！　子供がまだ中にいるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あのクズども……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "体表に源石結晶が見える……ほぼ全員感染者ね。気をつけて、向こうも大砲の類で武装してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私はアイアンハイドで左側からの突入を試みる。そっちのほうが人が少ないようだから、誤射のリスクも抑えられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "了解。こっちも攻城用弩の設置が終わったとこ。試射用意──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "第一射命中せず。着弾点を元に弾道調整、射角3.2度上昇、第二射は爆発矢をセット！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "奴ら、本部の言っていた腕利きどもだな！　総員反撃、反撃だ！　あのトラクターを近づけさせるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "知らないようだからもう一度言おう！　この子の名はアイアンハイド──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "弾薬を惜しむな、持てる砲弾を全部ぶち込んでやれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "おい、そっちの嬢ちゃん！　気を付けろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ズゥママ、停まって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "その程度の火力しか出せないのか？　我々エンジニア部開発チームが心血注いだ魂の結晶を見くびってもらっては──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "えっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "なぜ動かない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "一旦退いてズゥママ、あたしが援護射撃する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "今エンジンをかけ直してる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "嬢ちゃん、エンジンの第三吸気弁が炎上してるぞ。予備のパーツをそちらに持っていくから、私を援護してくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "最後の警告だ。貴様らの行為は、ママジョンズの契約履行妨害にあたるんだぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団メンバー",
      "text": "チッ、隊長、こっちの大砲が全部やられちまいやしたぜ。あの赤髪の女、狙いが正確すぎる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "なんだと、おいお喋り野郎、あのバリスタをぶっ壊せ。俺たちはあの蛇女を片付けるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "第四射、爆発矢装填！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "させるか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "ハッ！　赤髪女、お前のそのデカい弓は厄介だからな、没収させてもらうぞ！　そこを動くんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……面倒ね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "よく聞けよ。貴様らが一体何者で、荒野の雑種どもに何を吹き込まれたかは知らんがな。我々があのゴミどもを「清掃」するのは法に則った行為なんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ふーん、じゃあ契約書でも出しなさいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "……ヘッ、そらよ。我々は荒野をうろつくチンピラとは違う、れっきとした資源リサイクル業者だ。資源とは即ち価値である。ここのパーツやくず鉄のように、利用されるべき物のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "資源として還元できない物に関しては、残念だが我々が適切に処理させてもらう。この荒野の雑種どもに私怨があるわけではないぞ。これは規則なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "「リサイクルこそが文明の本質」。これが我が社のスローガンだ。オフィスの壁にも掲げてある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "力こそ正義ってのがあんたらの信条だって素直に言ってくれれば、少しは評価してあげたけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "誰が喋っていいって言った！　俺がありがたく教えてる最中だぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "ぐっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "バカ言わないでよね。あんたらはこの殺戮を「文明」だと……喉笛を切り裂いて黙らせることを「リサイクル」だと言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "テメェ！　砲兵のくせに、なぜこんな──ぐわぁ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "荷物を抱えて逃げるじいさんを、あんたらはもてあそぶために追い回した。子供の助命を乞う女の人を、あんたらは髪を掴んで引きずり倒した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あんたらはただ運よく武器を手にしただけの腰抜けだよ。弱い人たちばかり狙って、ただ威張り散らしているだけのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "テメェ、ナメるなよ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "へぇ、ようやくね。少しは度胸を見せる気になった？　どっちの力が上か確かめたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "教えてあげるよ――あたしの方が上だってね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "トギフォンス、無事か？　助太刀に来たぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "安全運転で頼むぞ！　その鉄塊は一時的に動かせるようにしただけだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "この雑魚どもで全員？　フン、ちょうど虫の居所が悪いし、ちょっと体を動かしてみるか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "クソッ、何て奴らだ！　退け、退けー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "えー？　やっと到着したところなのに、もう終わり？　私とも遊ぼうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "砂トカゲ団隊長",
      "text": "ヒイッ──急げ、逃げるんだー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "これでおしまい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "ああ、残りは逃げて行ったよ。奴らが言ってたパーディシャーとママジョンズとの契約の件は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ママジョンズはきっと認めないから。でもあなたたちも早くここを離れた方がいいよ。感染者の何人かは容態があまりよくないみたいだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "トギフォンス、さっきは危なかったな、無事か──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "何をする！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "あー、この攻城用弩、弦の固定装置が壊れてるな。おそらくさっきの戦闘でトラクターが参戦したどさくさで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "おとなしく拳を食らっときな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "こっちもお前に油圧システムをやられたばかりだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "それとこれとは話が別！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "止めなくていいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "えっと……トギフォンスさん。手元にある素材じゃこの程度が限界だが、一応は直した。調節の方は自分で頼むよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ふーん、まぁこれで十分だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "ユーネクテスさん、エンジンの調子はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ほとんど直ったよ。パーツを分けてもらって助かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "ブレイズさんは後始末があるそうだから、お二人さんとは本艦の方で直接落ち合うだとさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "OK。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "了解した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "何だか空気が気まずいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……あんたたち、ホントにロドスで治療を受けなくてもいいの？　かなり重症の人もいるみたいだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "これが私らの生き方さ。土は土に、灰は灰に。荒野へ来たのなら、荒野に還るのが定めというものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "鉱石病にかかって死ぬのも、賊どもの手にかかって死ぬのも、大した差はないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あなたたちは……移動都市の文明に憧れを抱いたことはないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "……はっ、文明ねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "私ら荒野の住人というのは、元よりその文明に見捨てられた者たちなんだ。今更戻ることはできないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "しかし、これほどの優れた技術を持ちながら、あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "おっと、そいつは訊かないでくれ。荒野の住人の過去を探るのはご法度だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "私はこの集落に助けられたことがある。今度は私が報いるのが礼儀というもの。ただそれだけのことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "前方の砂丘を二つ越えればもう本艦だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "そろそろお別れの時間だな。ここまで乗せてくれてありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "なぁ、赤髪の嬢ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョー",
      "text": "なかなかの腕だったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "戻ってきたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ロドスの中にいるときは大して感じないが、ここから見るとつくづく思う――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……奇跡だな、本当に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私はサルゴンのジャングルで育ったから、機械とは長らく無縁だったのだ。周りの者たちも腕っぷしだけで充分に生活できていた。だがある日、たまたま移動都市が通りかかるのを見たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あれは薄暗い朝だった。ぼんやり浮かぶ巨大な影と、遠くから響く轟音を、私は一生忘れないだろう。あれこそまさに文明と進歩の音だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "そして今、我々はそんな中で生活している！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ロドスは移動都市じゃないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "だが移動都市にもない会話できるロボットがある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あのさ、ズゥママ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "もしあたしが今この距離で大型破城矢を一発ぶっ放したら、ロドスの外部装甲を破れると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "トギフォンス、もし今後も師匠に予算を申請する予定があるなら、そんなことを試すのはおすすめできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あーあ、つまんない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "……あたしはヴィクトリアで生まれたんだ。サルゴンのヴイーヴルの移民家族出身だから、あんたとは一応同郷かな。母さんは時々それっぽいサルゴン料理も作ってくれてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "プランテンと鱗肉のローストとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "そこまで本格なものじゃないよ。レッドペッパーティーとか、その程度……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ヴイーヴルがヴィクトリアで生きていくのは簡単なことじゃない。軍に入るか、なんとかして現地に溶け込むか。あたしの家は、工場を経営して……滑車を作ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "大したノウハウもなくて、拾い集めたくず鉄を、適切な温度で鋳直して、最後は円形に固めるだけ……そういう誰でもできる仕事だったけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "それである日、おじいちゃんが旋盤機を一台買ってきたんだ。出どころ不明の古臭い中古品。バカでかくて、重たくて、使用年数すらわからない代物だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "初めてそれを動かした時の様子、想像できる？　目も当てられない有様だったね。だけど、あの凄まじい音と振動……あの古めかしい機械が動き出した時、自分の胸の鼓動も聞こえなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ケンカするよりスカッとしただろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "そうだね、その通り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "さっきあんたは文明やら進歩やらって言ってたけど……あたしたちは旋盤機を「文明」だなんて思ったことはなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あれは、あたしたちによりいい暮らしを送らせてくれる道具、ただそれだけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "で、それが今回の外勤任務だったってわけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "いいじゃねぇか！　聞いてるだけで興奮してきたぜ！　その赤髪のヴイーヴル、トギフォンスっていったっけ？　なかなかの腕利きとみたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "いい友達ができたみてぇじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "うおっ、なんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "ズゥママ、あたしの攻城用弩MK30の調整が終わったから、今すぐ訓練場に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前がトギフォンスだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トギフォンス",
      "text": "あれ、あんたは……ガヴィルだっけ？　ユーネクテスと腕比べしようと思って来たんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おっ、こいつもちょうどさっきアイアンハイドを「マニックアイアンハイド」に強化したって話をしてたぜ。よーしお前ら、好きなだけ戦いな。ケガは心配すんな、アタシは今日非番だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
