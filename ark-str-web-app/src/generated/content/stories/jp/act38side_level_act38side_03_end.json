{
  "server": "jp",
  "storyId": "act38side_level_act38side_03_end",
  "groupId": "act38side",
  "stageId": "act38side_03",
  "title": "悪客万来",
  "storyCode": "PV-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act38side/level_act38side_03_end.txt",
  "sourceHash": "f59df6a2ad8a937b720fe8f9463a7584822a5f5261ed0fdc559b0df203657577",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=2>1100年11月6日 p.m. 8:20</>"
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "この「レッドタンモスサワー」ってカクテル、サーミから伝わってきたらしいぞ。試してみようぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官B",
      "text": "マネ、正気なの？　ワイナリーでカクテルを注文するなんて、ほかのお客さんに見られたらいい笑いものよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "まあまあ、先月クルビア旅行に行った時だって似たような酒を飲んだだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "俺はハネムーンを懐かしみたいだけさ、ハニー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "（小声）警察学校で受けた潜入捜査の授業で習っただろ。時には敢えて目立つことで、ほかの人を目立たせなくするテクニックだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "（小声）裁判官が無関係の人間をここから立ち去らせるのには、まだ時間がかかるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官B",
      "text": "（小声）……自分が飲みたいからじゃないでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "誓うよ、ハニー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官B",
      "text": "も、もう……大声出さないでよ、マネ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あいつのヌオバ・ウォルシーニは、もっと寛容な街だと思ってたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "よかったら一杯ご馳走させてくれ、レディ。もちろん、カクテルをな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "郷に入っては郷に従え、だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官B",
      "text": "（小声）来たわよ、マネ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "ご厚意は有難いんだが、ご馳走してもらう筋合いは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "勘違いするなよ、警官殿。俺が誘ってるのはあんたらじゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "久しぶりだな、ラヴィニアさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "さっきから、随分長いこと隅の暗がりに突っ立ってるだろ。座って一杯飲まないか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "誰のせいだと思ってるのかしら。あなたはいつになったら、お会計を済ませてここを離れてくれるのかと思っていたところなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "悪いが、俺はここでは会計なんざする必要がないんだ。サルッツォは招待客の扱いを心得てるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "それに、俺がここへ来る前に、アルベルトは自分の持つワイナリーすべてに話を通してるのさ。「自由にテイスティングしてもらうように」、とな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたがサルッツォファミリーとそこまで懇意にしていたとはね。アルベルトとどういう協定を結んだの？　まさか、ここでバーテンダーをやるなんて内容ではないんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "今日はあんたに尋問されに来たわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "俺はレオンの状況が気になってるんだ。今夜ここであんたと顔を合わせた唯一の理由はそれだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "どういう答えを期待して――あるいは、危惧しての問いかしら？　「昏睡状態」だとか、「まだ危険な状態」だとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "今日会いに来てくれたことからして、最悪の状況じゃないのは確かだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……やっぱり、あいつには会わせてもらえないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "わかりきった質問はしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "レオンは俺の兄弟だ。あいつには無事でいてほしい。簡単なことだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "兄弟、ね。ベッローネファミリーの裏切り者じゃなくて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "確かに、ベッローネファミリーに残った人間は、誰であれあいつを憎む理由がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "俺だってそうだ。レオンの当時の選択も、今のやり方も認めちゃいない。だが、俺はこんなゲスいやり方はしないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "その言葉は、あなたの疑いを晴らす証拠にはならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "レオンはあなたと会う直前に事故に遭い、その時あなたは事故現場からさほど遠くないレストランにいた。あなたの嫌疑は極めて濃厚よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "だったらどうするつもりだ？　裁判官殿。俺を連行して、じっくり尋問でもするか？　ここに座ってる「客」の大半は警察だってことは知ってるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……明確な証拠がないうちは、逮捕はしないわ。これが法律の持つ意義なの。ファミリーの「ルール」とは違ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "けれど、だからといってあなたへの疑念が消えるわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私は、あなたが何かをしていようといなかろうと、関わっているのが誰であれ、必ず真相を明らかにしてみせるわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ラヴィニアの揺るぎないまなざしを見て、ディミトリはため息をついた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "あんたはちっとも変わらないな、ラヴィニアさん。裁判官になったばかりの頃、ドンを相手に面と向かって問いただしたあの時と何も変わらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "昔から、あんたのことは好かないが……レオンの面倒を見てくれてることには感謝してるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "それと、これだけは言わせてもらおう。レオンの事故については、俺もあんたと同じくらい、犯人を知りたいと思ってるんだ……だからこっちでも確かめてみるとするよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ディミトリはそばにずっと置いていたボトルを手に取ると、そっとコルクを抜いた。\nボトルの中身が揺れ動く。半分しか残っていないようだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "こいつは人にもらった酒なんだ。本当はレオンのために用意したものだった。本来、ここに座ってるのはあいつのはずだったからな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "何にせよ、この一杯はあんたにご馳走しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "本当にあいつには会わせてくれないんだな？　ラヴィニアさん。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼はテーブルにもたれかかり、ラヴィニアの回答を待った。\nしかし、裁判官はグラスの中の赤ワインを見つめるばかりで、何も答えない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "そうかい。だったら、ここに居たって意味はないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "今ここを離れる分には、あんたらも止めやしないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "それとも、『新都市管理法』の対ファミリー特別審査手続きでも適用して、俺を拘束するか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "この場所にはもうファミリーなんて存在しないのよ、ディミトリ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……それなら、ここを出て行っても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ご自由にどうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前は相変わらず気ままな野郎だな、ヴェネツィア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "港までお前を迎えに行った部下どもは、ドンが今こんな普通のレストランで飯を食ってるなんて知らないんじゃねえのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "私はただ、ここの料理が恋しかっただけさ。ヌオバ・ウォルシーニに来て最初に私を迎えに来るのがお前だなどと、誰に想像できたと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ははっ、いいから早く座れ、わが友よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ここは「普通の」レストランじゃないぞ。私がシチリアから連れてきたシェフがいるんだ。お前も、本場のラグーソースを味わってみるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "若者は未来という言葉を好んで口にする。それ自体は悪いことでもないが、捨てられるべきでない伝統もあるものだ。特にシラクーザ料理にはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "たとえば、サルッツォのワインの製法に異を唱え、新しい提案をする人間がいようものなら、ブドウ畑の肥やしとして埋められるのは当然だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "フンッ、そりゃあな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "この貴腐ワインは、うちで新しく出したヴィンテージワインの一本目だ。お前への歓迎を表して贈ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ふむ……1069年か。当たり年だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "うちのワインラックには、サルッツォ酒造の作ったサブブランドのワインとヴィンテージワインが揃っているが、最後にお前から直々に酒を送ってもらってからはもう随分と経った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "近頃は我々の繋がりも薄れてしまったな、アルベルト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "たかが十年だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "あの時、モレッティファミリーは都市の源石貿易を独占するため、十二家間の争いを禁じたルールを顧みず、俺たちを思うさま弾圧した……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ヴェネツィアファミリーがその仲裁役を買って出たことは、無論サルッツォから尊敬を置かれるに値する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "「思うさま弾圧」か。私も、年のせいで記憶違いをしているのかもしれないが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "あの紛争は最終的に、シラクーザにおけるモレッティファミリーの完全な消滅を以て終結したはずだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "お前が奴らの源石事業を飲み込んで、グレイホールの椅子を手にしたことで、サルッツォファミリーはシラクーザでの今の地位を築いたんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "その手のことは、お前も経験してきただろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ともあれ、俺たちの繋がりが薄れてるのは良いことだ。でなけりゃミズ・シチリアにどう思われるか、わかったもんじゃないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "そうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "かつて彼女が自ら禁止したカルネヴァーレでさえも、今や復活を遂げたんだ……我々やグレイホールの誰もが想像するよりも、彼女はシラクーザに対して寛容なのかもしれんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "最新の都市で、最古の祭りをやるとなれば、見逃せないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "シティホールの若造どもは、ああいうやり方でこう伝えたいんだろうさ。シラクーザは、抜本的な改革の時を迎えようとしている……そしてそれは、ここから始まるんだ、とな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "なんとはなしに、死んだベルナルドを思い出すな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……バカで独善的な野郎だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "亡くなった旧友をそんなふうに言うのは、いささか礼に欠けると思うが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "時に、先ほどまで外を眺めていたんだ。警察が交通整理をする中、外を行き交うトラック……通行人はマスクをしていない状態でも、どれがマフィアでどれが一般人か区別がつかなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ここはほかの都市に比べて、天気までもが良い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "実のところ、ファミリーはベルナルドが望んだ通りに消えることはないのかもしれん……だが、お前が私の前に現れていなければ、ここがシラクーザであることを疑ってさえいただろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "そうは言うが、ヴェネツィアファミリーはうまく溶け込んでるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "新区画の建設から新政府の準備に至るまで、徹頭徹尾表に顔を出してこなかったお前らは、ヌオバ・ウォルシーニが正式に機能し始めてから急に動きを速めてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "そういうことは全部、アントンが受け持っているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前んところの婿殿は確かに有能だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ヴェネツィア自工は今まで『新都市管理法』に違反した記録もないうえに、奴はシティホールに協力してほかのファミリーの違反行為調査までしてると聞く……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "若者というのは常に、我々よりも積極的に新しい時代に溶け込むものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "だが、ファミリーの根底にあるものは、時代の変化で消えるようなものじゃない。お前らの会社が陰でどういう商売をやってるかなんぞ、お前のほうがよくわかってんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "世間話もここまでか。私は、いつになればお前はたまりかねて用事を切り出すのかと思っていたところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……俺の用件はわかってる、と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "シラクーザには新鮮なことなど、そうたくさんは起こらんからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "しかし、お前が誰から何を知り、何を企んだとて、私のような老体に手を出せるようなことではないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "シティホールを訪ねようと、アントンを訪ねようと、そして脅迫を選ぼうと、協力を提案しようと、私には関係のないことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "時代は確実に変化している。その好き嫌いはともかくとして、私にはこの流れを止められないことは確かだ。ならばいっそのこと手を放して、未来を若者に委ねたほうがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "若造ともども、泥沼に沈んでもいいって言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "しばらく様子を見てからでもいいだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ヴェネツィアファミリーがわずか三代で台頭したのは、上の世代の努力に頼ってのことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "うちのファミリーにはヴァルポも、ペッローも、血の繋がりのないループスもいる。志のある人間なら誰でも気にせず受け入れてきたからこそ、今までやってこられたのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "私が今やっていることは、当時うちのドンがやっていたことと何も変わらんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "今回、私がここへ来たのは、単にお祭り気分を味わうためだ。とはいえ、最初に会えたのがお前だったことは、それはそれで嬉しく思うがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "けれども、我々のような老いぼれには結局のところディチェンテが必要なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "「ディチェンテ」か。相変わらず、その言葉を口にするのが好きだな、お前は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "ヴェネツィアファミリーが一つにまとまっていられるのは、この言葉あってのことだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェネツィア",
      "text": "我々が、していいことと悪いことを心得ているのは、自分とファミリーのディチェンテのため。そうだとは思わんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ほかの奴の発言なら、バカバカしいと言ってるところだ。だが、お前がそれを言う分には――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "「確かに、それはシラクーザでは貴重なものだ」と認めるしかないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ラグーソースのパスタをもらっても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "この貴腐ワインもモンテルーペに持ち帰らせるより、ここで開けたほうが良さそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前が美味そうに食べるのを見てたせいで、こっちも小腹が空いてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "こうしてお前と静かに座って食事ができる機会なんぞ、今後は多くねえだろうしな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウンベルトは仕事中に時計を見ない。\n過去の生活に別れを告げてからというもの、ミシンの針の上がり下がりを静かに数えることこそが、彼にとって一番好きな一分一秒の過ごし方だった。\nしかし今、彼はこの音が恐ろしいと感じるようになっていた。\n苦しく長い一日を終えて、老人の目はひどく疲れていた。だが彼には、針仕事をして自分の精神を奮い立たせる必要があった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "ルキーノかい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "ウンベルトさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "ああ、アンナさんでしたか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "はい。先月注文したスーツを取りに来たんです。明日から正式に、シティホールで働き始めるので！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "あら、ルキーノはお店にいないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "あの子は……用事があって、出ているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "少々お待ちください、アンナさん。今スーツを取ってきますので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "一度袖を通してみてください。……いかがですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "す、すごくぴったりです！　ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "お代は頂いているのですから、お礼など結構ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "ですが、お代以上の生地を使っていただいてますし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "あなたはあれほど長い間、シティホールからの連絡を待っていらしたでしょう。そう簡単に就ける仕事ではないのですから、あなたは上等なスーツを身につけてしかるべきです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "引っ越しのご挨拶代わりとでも思ってください。今後も、近所の皆様にはお世話になるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "ウンベルトさんのような腕利きのサルトリアとお近づきになれて、私たちは恵まれていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "そうだ、ルキーノにあげたいものがあるんです。カルネヴァーレのコンテストリハーサルの鑑賞チケットなんですが、良い席が取れたもので、あの子にと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "今いないのであれば、あとで渡しておいてもらえますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "ふふっ、ウンベルトさんがあの子のためを思っていらっしゃることはみんなわかっていますが、あまり神経質に目を光らせすぎても良くはないんじゃないでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "たまには気を緩めさせてあげましょうよ、ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "……ありがとうございます。あとで渡しておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "お願いします。話は変わりますけれど、あの子は本当に鋭い子ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "先月私が採寸に来た時、あの子は試着に来たお客さんについて楽しそうに話してくれたんです。どの人が政府の高官で、どの人がさるファミリーのために働いているか、なんてことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "ルキーノは、あなたがそうした大物のために服を作っていることをとても誇りに思っているようですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "あの子は確かに聡明な子です。しかしデ・モンターノの――いえ、シラクーザのこうしたサルトリアにいらっしゃるお客様のほとんどは、実のところ普通の方なのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "そうした方々が、スーツを仕立てに店を訪れる機会はそう多くありません。得難い仕事や、めでたい縁を得た、あるいは格式ばった葬儀があるといった理由で、いらっしゃるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "彼らはこうしたディチェンテを得るに相応しい方々ですし、デ・モンターノからしても、良い評判をいただけばこそ、こうして商売を長く続けられるというものですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "ウンベルトさんには頭が下がります。あなたのような良き師がいれば、ルキーノは将来素晴らしいサルトリアになるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "……すごくお疲れのご様子ですね。何かお手伝いしましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "いえ、年のせいですよ。しっかりと休みを取れていないもので。それよりも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "明日は初出勤でしょう。良いスーツを着ても、目元に隈ができていては台無しです。早くお休みになってください……それと、この服にアイロンをかけたい時はいつでも持ってきてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "私も……今日は早めに店を閉めて、休むことにします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な隣人",
      "text": "わかりました。では、また。何かあったらご連絡くださいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウンベルトは、ルキーノにと隣人から渡されたチケットを手にしたまま、ただ無力さを感じながらミシンの前に座っていた。\nしばらくの沈黙の後、彼はある番号に電話をした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "あなたに連絡すべきでないことはわかっていますが、今はほかに方法がないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "ルキーノは今日一日、帰ってきませんでした。警察に捜索を頼むことはできません。あの子が本当に、ファミリーの人間に関わってしまったのではないかと思うと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウンベルト",
      "text": "このメッセージを受け取ったら、どうかあの子を探すのを手伝ってくださいませんか。ルキーノはこの老いぼれにとって、唯一の気がかりなのです……イングリッドさん、お願いします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=2>1100年11月6日 p.m. 9:00</>"
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "ラヴィニア裁判官、ディミトリは去っていきました。我々も撤退しますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "もう少し待っていて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "飲みすぎです、顔が赤くなってますよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "我々はこのまま、容疑者の捜査を行うわ。ほかの同僚には、事故車両を引き続き追うように伝えてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "ですが、今の状況で容疑者を特定するのは難しいですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そうね。ディミトリにアルベルト、そして「失踪した運転手」……この件に関与した疑いのある人間は多くいる。けれど、事件の背後にはまだ隠された事情があるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ヌオバ・ウォルシーニの建設から今に至るまで、私たちに視線を注いでいる人間は山ほどいるわ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "たとえば、まだこの場を離れないそちらのお客様とかね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ラヴィニアの視線が隅へと投げかけられる。\nワイナリーの照明は暗くはない。だが、壁際のワインラックが影を落としており、その中にはヴァルポがたった一人で座っていた。\n彼女はすでにボトルを半分ほど空け、周囲の客と常に適度な距離を保っていて、テーブルの上に彼女の剣が置かれていることには誰も気づいていなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "変装した警察官A",
      "text": "もしや撤退をお命じにならないのは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "ラヴィニア裁判官だね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "正直なところ、貴方の今日の行動や、この少々おつむの足りない警察官たちにはほとほと困らされたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "本来は、口が軽くなった酔っ払いから気になる情報を聞こうと思っていただけなんだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "今や、当てにできる情報源は貴方だけになってしまったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "なぜ私の名を？　それと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "まあ、とにかく座ってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "悪いね、盗み聞きするつもりはなかったんだ。ただ裁判官とファミリーのドンというのは、実に古典的な組み合わせだからさ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ヴァルポの女性は自身の少々大きすぎる耳を指さして、仕方ないだろうと言うように唇を丸めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "この耳のおかげで便利な思いをしていると言うべきか、それとも悩まされていると言うべきか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのヴァルポ",
      "text": "おっとそうだ、伝えておこう。イングリッド――私の名前だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "これでおあいこだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "この剣をずっと見ているようだけど――これは単なる工芸品だよ。必要とあらば、すぐシティホールに申請をしに行っても構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "久しくこの地を離れていたから、新しいルールに不慣れでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……イングリッド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "この取り囲んできた新人さんたちでは、私をどうすることもできないことは、貴方ならよくわかっているでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "彼らは貴方の部下なのかな？　ヌオバ・ウォルシーニでは、警察と裁判官は同じ組織に属しているの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "特殊な時期には、特殊な方法が適用されるものです。それと、彼らは皆、自らの職にプライドを持つ方々ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたが身分登録をされるのなら、我々は喜んで同行しましょう、イングリッドさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "いいとも。ただし、私の用事を済ませたあとにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "それほど時間はかからないよ……今の私は、ただの客として来ているから。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "イングリッドはワインを一口飲むと、向かいの裁判官に自分の剣を好きなだけ確認させた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "カルネヴァーレに参加するためにいらしたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "娘のために来たんだ。あの子、怪我をしてしまってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "それで鉱石病だ。不慮の事故だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "ほかに聞きたいことは？　協力は惜しまないつもりだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "誤解しないでいただきたいのですが、これは尋問ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "どっちでもいいさ。裁判官とは以前にもやり取りしたことはあるけれど、その職業に対しては特に何とも思っていないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "私は、事件解決を急ぐ裁判官ではなく、病人の安否を気遣う心優しい人に尊敬を示しているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……あの事故のことをご存知なのですね。外部には公表していないはずですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "言ったでしょう、私は耳が良いんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "「昏睡状態」になっているのは貴方の家族？　それとも大切な友人かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "申し訳ないのですが、お答えできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "へえ、どうやらシラクーザという場所は、つくづくアクシデントが起こりやすいところのようだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "そんなに警戒しなくても大丈夫だよ。私が今回帰ってきたのは、決してファミリーの仕事に関わるためではないと断言しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "そうだね……もしかしたら、お互いに情報交換することもできるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人の会話はドアの開く音に遮られた。入口には新たな客が立っており、ソムリエはその人物へ足早に歩み寄ると、お辞儀をして相手の脱いだコートを受け取った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ふぅ、やっぱりここにいたのか、イングリッドさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "見つけるのに苦労したぜ……デ・モンターノであんたを見たことをお伝えしたら、ドンがあんたに会いたいって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "っ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "客は、ラヴィニアのいるほうを見て、急に言葉を止めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラヴィニアとイングリッドが同時に、このそそっかしい客人を見やる。周囲の、客に変装していた警察官たちも一斉にその招かれざる客に目を向けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソムリエ",
      "text": "いらっしゃいませ。ワインの準備は整っておりますので、こちらへどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "あっ、い、いや、今日は帰る。用事を思い出したから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソムリエ",
      "text": "では、少々お待ちください。ワイナリーの新作を一本差し上げますので――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張したマフィア",
      "text": "それが、うちの牙獣が今日子供を産んだところなんだよ！　すぐ見に行かないと！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ソムリエの手から慌ててコートをふんだくり、再び着るその男を、ラヴィニアは眺めていた。去り際、彼はラヴィニアに向けて忘れず脱帽し、一礼していった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "今の人、今年の前半に悪事を働いて懲役三ヶ月の判決を受けたはずですが、もう出所していたとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "もちろん、あれは彼自身の衝動的な行いであって、ヴェネツィア自工とは「全くの無関係」でしたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "貴方には、もっと敬意を持って接するべきじゃないかと思い始めたよ、裁判官さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "昔は、シラクーザでああいう人間がこんなにも裁判官を恐れていたことなんてなかったからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "いえ、実のところ私からすれば、あなたの「裁判官という職業に対しては特に何とも思っていない」という態度のほうが好ましく思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "シラクーザが畏敬の念を持つべきなのは法律そのものであって、特定の個人ではありませんので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "フフッ、とても斬新な考え方だね――さて、残念だけど私はそろそろ行かないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "以前のドンに会うのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "私のスケジュールを逐一裁判官に報告する義務はないけれど、貴方を困らせたくはないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "さっきも言っただろう？　今回帰ってきたのは、決してファミリーの仕事に関わるためじゃないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "私にはもっと大事な用事があるんだ。身分登録は、締め切りまでには終わらせておくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "そうだ、お酒はほどほどにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イングリッド",
      "text": "貴方、お酒は弱いほうでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ラヴィニアはヴァルポが去るのを見送ると、後を追おうとする警察官たちに座るよう目配せした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたたちの顔は覚えられているわ。ほかの人に任せておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "それより、ヴェネツィア自工の調査に誰かあてがってちょうだい。彼らのドンもヌオバ・ウォルシーニに到着しているはずだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……レオン、事態はだんだんと厄介なことになってきたわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る警察官",
      "text": "ラヴィニア裁判官。技術部門からつい先ほど、事故現場付近のデータが送られてきましたので、ご確認いただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あの周辺の監視カメラは故障してたんじゃなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る警察官",
      "text": "それが、監視カメラのデータではないんです。あの付近で故障して何日も停められていた自家用車がありまして、ドライブレコーダーにたまたま当時の映像が残っていたそうで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る警察官",
      "text": "その映像を見ると、事件当時、路地に不審な人物が現れているんです。ご覧ください。体型から判断して、恐らくヴァルポだと思います。しかも、剣を所持していて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る警察官",
      "text": "どうなさいました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "その人、たった今ここを出て行ったところなのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
