{
  "server": "jp",
  "storyId": "act35side_level_act35side_08_beg",
  "groupId": "act35side",
  "stageId": "act35side_08",
  "title": "黄砂の果てに",
  "storyCode": "AS-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act35side/level_act35side_08_beg.txt",
  "sourceHash": "b364d4747e47340c3fea7eb5043aeac8f07a99f79c36b9a61320dd64b12d10fb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "これは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "――あっ、あたしの出発の儀式だね！　きっと踊りがあまりに楽しすぎて、目が回って気を失ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "明るい元砂漠の盗賊",
      "text": "ナラントゥヤ、あなたに祝福を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "明るい元砂漠の盗賊",
      "text": "私の知り合いのキャラバンが定期的にあの輝ける都市に向かうのよ。もし本当にあそこにたどり着けたら、その人たちを訪ねるといいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ハッ、やっぱりね！　あなたならきっと役に立つコネがあるってわかってた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "友人が多ければ、面倒事も減るってもんさ。ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ためらう元砂漠の盗賊",
      "text": "ナラントゥヤ、やはり心配だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "何が心配なの？　何度も言ったでしょ。あたしがいなくなっても、皆があなたに仕返しすることはないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "全部あなたとは無関係だよ。あなたがあたしの手下になったのは、あたしに魅力があるからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "アシムの老いぼれはそれであたしを恨んで、あちこちで悪口を言っているけど。それはあいつは心が狭くてちっぽけな奴ってだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ったく、あたしに嫉妬した奴らめ。寄ってたかって罠を仕掛けてくるなんて……恨むならあたしの運の良さを恨むんだね。金にも人にも好かれちゃってしょうがないんだからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらう元砂漠の盗賊",
      "text": "だが、ナラントゥヤ、俺が心配しているのはお前だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらう元砂漠の盗賊",
      "text": "そんなに軽い荷物で砂漠を行くなんて、水が見つからなかったり獲物に遭遇できなかったりしたら、どうするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "はぁ？　確かに皆の財布は前よりずっと寂しくなったけど、干し肉や果物の砂糖漬けすら用意できないほど落ちぶれたわけじゃないでしょ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "なんでそんな考えになるの？　まさかあなたたちの中にあたしに黙って苦しい思いをしてる奴でもいるとか？　誰か言ってごらん？\n今金貨を出してやるから――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ナラントゥヤの手が腰の財布の中をまさぐった。\nそれから、彼女はゆっくりと目を見開き、革の袋を外すと、裏返して振った。\n数粒の砂が果てしない大砂漠に落ちた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "おかしいな、乞食や浮浪者に会った記憶はないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "金持ちならたしか何人か会ったような？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらう元砂漠の盗賊",
      "text": "ナラントゥヤ、色々考えたが、やはり水源を見つける秘訣をお前に教えてやるべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ためらう元砂漠の盗賊",
      "text": "俺はもう暴徒のリーダーに生贄として選ばれる心配はしなくていいし、全員の生死に関する秘密を握っておく必要もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "――いいだろう。その祝福気に入った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "それなら金貨数枚くらい、流砂に呑ませたところで構いやしないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャジ",
      "text": "ナラントゥヤ、私も心配だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "おかしな奴だね。何を心配してるの？　あたしがまた奴隷の子供を車から奪ってきたりしたら、自分の読み書きできないランキング一位の座を奪われちゃわないかって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャジ",
      "text": "あなたのあの二本の黒い刀が長い間使われてなくて、手入れされてないことが心配なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "手入れが面倒だから、あの骨董品はずっと使ってなかったのさ。今はむしろ現代の素材と機械鍛造の方を崇拝して――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "――あたしの刀は？　短剣は？　あたしがためておいた麻痺毒と胞子ボトルは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "はぁ、ナラントゥヤ、あたしはあなたが常に新しい手下を迎え入れようとするのが心配よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "あなたが一人で旅に出て、誰か上手く補佐してくれる手下に出会えるんならいいけど、でも大抵の人はあたしとアジャジみたいにあなたに助けられちゃうでしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "「一人で旅に行く」？　あなたたちは一緒にあの「輝ける都市」へは行ってくれないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "だからあたしとアジャジはジャングルの伐採場に二ヶ月間働きに行って、稼いだ金貨を全部輝ける都市に流れつくと言われてる川に投げ入れたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "川があふれた時にそれを拾って、あなたの天路が無事にいきますようにって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いいね。その祝福も気に入ったよ。ジャングルは川の下流にあるけどね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……待って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "天路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャジ",
      "text": "そうだ、天路だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "ナラントゥヤ、もう準備はできたのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いや、いつの話をしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……今のあたしは確かに「ただ一人、両親から贈られた武器以外にその身に何もなし」……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……やっぱり輝ける都市に行くのはやめる。行かないよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "若きナイツモラは振り返り、大股で自らの駄獣の隊列に向かう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一瞬のうちに、砂漠の中から高い壁がそびえ、まぶしい日差しの一端がかき消されたようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……あたしの駄獣は？　あたしのテントは？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナラントゥヤは目をこすった。\n自ら作り出した悪夢に陥ったかのように、彼女の視野は次第に狭まり、まっすぐな一本道だけが残った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "嫌だ！　天路なんて怖すぎる！　死んじゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "助けてぇーー",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "おかしい。ここの使いの人形はピクリともしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "人があそこで倒れてる？　もしもし、聞こえるか？　頑張るんだ、すぐに行く――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "――どけ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "何だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ついさっきまでここに寝転がってて、巨大な循獣が足であたしの頭を踏みつけてたって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "循獣だったと思うが、捕まえる前に砂ぼこりの中へと消えてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "道理で夢の中で頭が少し痛かったわけだ。それに「ウウ」って話しかけてくる声が聞こえてたよ。ねえ、あたしの顔は何ともない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ならよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あなたはどうやってその循獣を追っ払ったの？　夢の中でどれだけ怒鳴り散らかしても言い聞かせられなかったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "緊急事態だったため、暴力的手段を用いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "はぁ、どうして思いつかなかったんだろうね？　ナイフが役に立つ時もあるもんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "やっぱりあなたは見込んだとおりの頼れる手下だよ。ありがと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いや、もう違ったね。手下じゃなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……早く行くとしよう。あの金属人形たちはいつまた動き出してもおかしくない。ここは安全じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしにとっては安全だけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "はぁ、川の神が勇敢に自分を示すチャンスを与えてくれたっていうのに、どうして道端で寝ちゃったのかね……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "しかも、とびきりいい夢まで見た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……街が混乱している中、あなたは砂の中で寝転がって、しかも……いい夢まで見たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうなんだ。自分の出発の儀式の夢を見てね。とても賑やかで、皆の拍手も一段と揃ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ミナトハマイに行くと言ったあの時に、昔の手下が夢に見たみたいに応援してくれてたらどれだけ良かったことだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あなたがホテルを去った後、アジャジとアジャニと少ししゃべった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしが白昼夢を見てるとほとんどの人が思ってるって、あの二人は言ってたんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "でもさ、夢っていうのはどうせ覚めるんだ。だったら最高の夢を見るべきだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……ぷっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私たちは、お互いに理解していないことがまだまだたくさんあるのかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あなたが無事でよかったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アスパシアがナラントゥヤに手を差し出す。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なら仲直りってこと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "――ちょっと待ってて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "アジャニ、どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "ナラントゥヤ！　助けて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "博物館は、ちっとも、安全じゃない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "――誰ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "ティティ、今何か言いましたか……？　少し耳鳴りがして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……それに私も聞こえたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "うぅ。嘘ですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "この文化財たちはしゃべれるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "うわ……どうしてこれまで黙っていたんですか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貴石の使い",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴石の使い",
      "text": "永遠の守護者よ、答えよ、答えよ、答えよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "何に答えろって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴石の使い",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴石の使い",
      "text": "かの者は船をこぐ異国人にここから地に下り歩むことを教え、黄金の剣でもって訪問者の冒険的好奇心を守った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴石の使い",
      "text": "かの者の杯の中の甘みと苦みは通行人の袋から搾取したものであり、足元の砂粒ははるか遠く北西の骨と石炭を埋めた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴石の使い",
      "text": "教えよ、かの者が世に残した「名」とは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……アナト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "この子たちは「しゃべれる」とは言えないと思うわ。少なくともコミュニケーションが取れるとは言えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "ただ謎解きを出題しているだけ。金庫を開ける時にパスワードを入力しなきゃいけないみたいにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "で、ですが！　こんな複雑な謎解きなんてありますか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴石の使い",
      "text": "残り、三分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "うわああーー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "わたしたちのせいで、使いが時限爆弾になってしまいました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "――待って、アナト、落ち着きなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "まだ博物館の職員に連絡できる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "ど、どうしたんですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "もしかしたら、これは歴史に関する謎かもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "たしか……あなた、あの『大地を巡る旅』が一番お気に入りだったわよね？ あの本はどこにあるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "ティティ、第五章を開いて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "ここよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "……答えはパーディシャーのベヤードです。彼はイベリア、サルゴン、そしてボリバルを繋ぐ貿易ルートの開拓に同意し、その後ボリバルのサトウキビとコーヒー豆を取り入れました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「大地の膿腫と共生し、革のベルトに吊るされた小さな頭が一斉に悲しげに鳴く」……\n付箋によると、第三章のはずです。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "サンドビーストのことですね。六世紀のサルゴン北部にはサンドビーストを狩猟する風習がありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "以前所蔵品の中にサンドビーストの頭を繋げて作った魔除けの装飾品があり、わたしたちはこれまでそれを特に理由のない自然崇拝だと見なしていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "ですが……歴史を目にしたあなたたちならきっと知っていたはず。サンドビーストを狩猟していたのは、高濃度活性源石環境が引き起こした少量のサンドビーストの変異が起因であると。間違いはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "よし、では次の質問をどうぞ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "「湖底の遺跡、先祖は百代の子孫を増やし、子孫は先祖の頭を斬り落とした」……\nこれは付箋を探す必要もありません。第四章です。"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……これは考古学の謎の一つね。千年前の古代集落の住民が集団処刑されたけど、発掘された刑具は近代の合金材料が使用されていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "でも答えはここに書かれているわ。ほとんどの人がその目で見たことのない種族、ペートラム。彼らは古より独特な製錬鍛造技術を伝承していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "よし、次です……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ページをめくるたびに、謎は一つ一つ正しい回答を得られ、ざわついていた使いも次第に静まる。\n停止した使いはまるで沈黙する聴衆のように、アナトを取り囲む。\nアナトは初めて舞台に上がり演説した時のことを思い出した。観客を博物館の文化財だと思えば、緊張することはないとティティが教えてくれた。\n「自分が正しいと思うことを話し続ければいいのよ、アナト。」"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……うーん、これはタブーな発言だけど、サルカズは確かにかつてサルゴンに足を踏み入れたわ。古の呪いが歴史の注釈にどれだけ残っているかは今に至るまで分かっていないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "そうだ、ティティ、それに気付いたのもあなたのおかげなんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "え？　呪いのこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "いえ。ただずっとわからなかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "サルゴンには、他国が未開の地であった先史時代にまで遡ることのできるほど文字の記録による歴史があります。それでもあなたはサルゴンを離れて留学を選びました。そこで何を見たのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "そんな思いから、わたしは『大地を巡る旅』を開いたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "それで、有限の命の中で、わたしたちはこの大地に対する誤解や偏見があまりにも多いことに気づきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "わたしたちの持てる最大の勇気は、短い命を使い果たし、無限の時間を模索することです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "そうよ。私たちは永遠の守護者なんかじゃないし、すべてを経験することはできないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "ところで、もしそんなチャンスがあるなら、あなたもズバイルさんみたいに永遠に生きて、より長い歴史をその目で見届けたいと思いかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "実はずっと考えていたんです。この使いたちは歴史の問答を通して、わたしたちが使いを操る資格があるその人であるのか確認しているのではないかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "この仮説が正しいのであれば、どの言葉が使いたちの認証モードを起動したのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "その人は一体どのような気持ちを抱いて、パスワードを「ハラヘト」にしたのでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "暗い……ここはどこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "私は……あの化け物のお腹の中にいるのか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "風の音……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "うーん……この先は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "砂漠の中の湖……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "黄金色の砂漠の中、エメラルドグリーンの湖がその中央にある。そよ風が岸辺のシュロの木をそっと撫で、ペペが先ほど耳にした葉擦れの音を発している。\n一人の男の子が半身を水に突っ込んで潜り、しばらくして突然体を起こすと、その手には美しい金色の鱗獣が握られていた。\n彼は鱗獣を慎重に捧げ持つようにして、ペペに近づく。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "えーっと……ねぇ君、ちょっと聞きたいんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "姉様見て、何を捕まえたと思う！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "姉様って、誰が君の姉様なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "な……何バカなことを言ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "父様が、母様をここに、母様の故郷に埋葬するつもりだって言ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "母様のためにきれいなお墓も建てるんだって。きれいな池、それにスイレンがたくさんあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "この金色の鱗獣をその池に入れようと思ってるんだ。そうすれば余の代わりに母様のお供をしてくれるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それと私に何の関係があると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "姉様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "いい加減姉様と呼ぶのはよしてくれ！　私の弟は君にまったく似ていないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "父様……父様は征伐をまだ続けるんだって。母様が去ったからって歩みを止めたりしないみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "父様は姉さまと余に、ここの宮殿にとどまりたいか、それとも一緒に東に進みたいか聞いてきたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "えーっと……ボク、さっきから何の話をしてるのかな？　さっぱりわからないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "余は父様と一緒に東に行って、もっと遠くの土地を知って征服したいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "一緒に行こうよ、姉様。パピルスのスクロールとイグサのペンを持ってさ。きっと記録する価値のあるたくさんのことに遭遇するよ。余はきっと父様みたいに偉業を成すから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "姉様が書く主人公になるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い男の子",
      "text": "一緒に行こうよ、姉様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "えーと、ボク、申し訳ないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女の子",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女の子",
      "text": "あなたと共に父様についていくわ、ズバイル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "誰……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ペペが振り返ると、そこに白いスイレンを持っていた女の子がいた。女の子の額にある金のスイレンを象った飾りが太陽の下で輝きを放つ。\nペペはその額飾りに見覚えがあると感じ、自らの額にそっと触れた。\nその瞬間、彼女は日差しを眩しく感じた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
