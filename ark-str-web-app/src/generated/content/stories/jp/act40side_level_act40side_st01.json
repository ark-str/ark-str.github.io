{
  "server": "jp",
  "storyId": "act40side_level_act40side_st01",
  "groupId": "act40side",
  "stageId": "act40side_st01",
  "title": "陳皮菊花茶",
  "storyCode": "OR-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act40side/level_act40side_st01.txt",
  "sourceHash": "59cdc849e858b3724a8fef484b1449b0881010767f07a3f6a6f7e73e76b841a1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=2>1062年4月21日 穀雨</>"
    },
    {
      "type": "dialogue",
      "speakerName": "客引きする店員",
      "text": "お客さん、お客さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客引きする店員",
      "text": "こんな大雨ですよ！　うちで雨宿りはいかがですか！　温かいお茶でも飲んでってくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた男性",
      "text": "無用だ。この雨はすぐに降り止むものでもないだろう。先を急ぐ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客引きする店員",
      "text": "ははっ、どうでしょうねぇ。雨が止むように望む人もいれば、少しでも長く降ってほしいと望む人もいますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客引きする店員",
      "text": "傘売りなんかは儲け時で大笑いですよ。道を急ぐ者は困るでしょうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた男性",
      "text": "なかなかに面白いことを言う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "客引きする店員",
      "text": "お客さん、やはり休んで行ってくださいよ。ある方からお客さんに言伝を頼まれてるんです。この先は道が悪くて歩きにくいから、水たまりで靴が濡れてしまわないか心配しておられるとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた男性",
      "text": "言伝……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "客引きする店員",
      "text": "中へどうぞ。あなたに会いたいと望まれている方がお待ちになってます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "尚書殿か。久しいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "いや、今は……太傅と呼ぶべきだったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "玉門での一別以来か。確かに久しいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "此度の都への報告では、まず司歳台と兵部に会うことになると思っていたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まさにそうであるからこそ、その前にお主に会いに来たのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……陛下が崩御された。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "いつのことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "半月前だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "そうか……陛下が天寿を全うされたのであれば、太傅もわざわざ会いには来ないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "もしや。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "影の中に座す者が手を伸ばした。彼の掌には、黒石が一つ転がっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "六十年前、あやつは例の古寺から逃げ出し、己の身を百八十一の黒石へと分けて各地へと散らばせた。大半は今もって行方知れずである。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "そして、ちょうど半月前、司歳台は都にてこの黒石の痕跡を発見した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "……あいつは何をしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "まだ知れぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "ただ一つ確かであるのは、あやつが禁城に入るのは不可能だということだ。必ず自発的にあやつに会った者がいるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "そやつの身分は、調べるには都合が悪い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "あいつの望みは、他者を巻き込むものではないはずなのだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "本来であれば、わしは今日お主に会うべきではなかった。しかし過去にかの罪人が動乱を引き起こした際に、お主が自らの手であやつを制圧したのは事実である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……宗師、この件について何か知ることは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "……何も。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "あの事件以来、一度も会っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "では宗師を信じるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "私に望むことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "留まることなく、即刻玉門へと引き返すのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "ウルサスの不穏は変わらず、玉門の守りの要は入れ替わった。今この時において、これ以上、人心に不安を広めてはならぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "司歳台と兵部には、わしが話を通しておこう。お主が盤外にいてこそ、わしは重責を委ねることができるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "……承知した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "彼の者が仕掛ける棋局の件も、引き続き司歳台に秘密裏に調査させる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "特殊な状況ゆえ、宗師が再び人前に出るのは具合が悪い――わしには会わなかったと思ってくれてよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "真龍は一体なぜ……炎武（イェンウ）殿下は無事か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "今頃、彼は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "イェンウか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "陛下が崩御された晩は、イェンウが陛下に拝謁をしていた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "殿下にご報告申し上げます。叛臣の一族二十八名は全て収監いたしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "しかし名簿を突き合わせた際、一族には一ヶ月にも満たぬ赤子がいるのを発見しました――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "禁軍が本日太師府を捜索し、家中をくまなく探しましたが、その赤子の行方が分かりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "……まだお包みの赤子が、ひとりでに逃げ出すことなどなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "まだ彼女を気にかけている者がおるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "殿下が気を揉む必要はございません。禁軍が赤子を見つけることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "ふん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "今朝方、刑部尚書から謁見の申し出がありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "一連の事件についていかに審議すべきか、殿下に意見を求めたいとのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "……炎律に基づき進めよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "畏まりました。伝えておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "私のあの兄は、今いずこまで離れたのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "守備隊の報告によりますと、半刻前に都を発ったばかりとのことです。一部の禁軍が従い離反しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "警備兵は軍令がなく、阻むこと叶わず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "ああ……百灶（バイザオ）に留めておくよう命を下してはいなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "兄が留まることを望まず、皆を捨てて去っていったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "離反した禁軍は……いかほどか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "十八名です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "我が兄よ。天地に悖る大罪を犯しながら、自らの代わりに太師に死なせ、あまつさえ十八名の死士の追従を受けるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "朝廷百官のうち、どれほどの者が未だ兄に心を寄せている？　玉座に座ることを望んでいるのはまた、いかほどだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "今この時、その席に座しておられるのは殿下です。炎国の万世にわたる繁栄と安寧の責は、殿下の御身にございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "炎国の誰もが、迷い惑うことを許されておりますが……唯一、殿下だけは揺れ動いてはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "私は久しくこの宮殿から足を踏み出していない……太尉、聞くが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "百灶の春雨は降り止んだか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "殿下が望みさえすれば、この雨は止みましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "……殿下のお考えが変わったのであれば、まだ彼らを引き止める間はあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "……くたびれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "侍従",
      "text": "温かいスープをお召し上がりになってはいかがでしょうか？　御膳司が八宝攢湯（バーバオザンタン）と筍の細切りをご用意いたしております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帳の後ろの声",
      "text": "もて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "いい子……いい子だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ほら、泣かないのよ、帰りましょう……すぐにおうちだから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "もっと速く……お願いします、もっと速く走れませんか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "雨がひどくて道がよく見えないんです。これ以上の速度を出すのは無理ですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "次の宿駅まではどれくらいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "どう見積もっても三十里はあります……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "お客さん、どれだけ急ぎの用だってんですか……家族まで連れて、わざわざこんな夜中を選んで移動しようってのは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "……どうか急いでください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "ああ……！　うわぁ！　何だ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "何事だ！　荒野にどうして人が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "男が辺りを見渡すも、視界は連綿と続く雨の帳に遮られている。夜の闇がどこまでも広がり、何も見えない。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "このまま乗り続けることはできません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "ご苦労をかけました。この金は全て取っておいてください。引き続きこの先の宿駅に向かって、もし誰かに尋ねられても、今宵子供連れの客人を乗せたことはくれぐれも口外せぬようお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "では、私たちはこれで。礼を申し上げます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "ですが……こんなのって、お客人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "こんな大雨で、どちらへ向かうというのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "小道を行き……北の林を抜け――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる女性",
      "text": "きゃああ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "どうした――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる女性",
      "text": "子供が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "うろたえる女性",
      "text": "子供が見当たらないわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる男",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な老人",
      "text": "これが……例の子か。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "お包みの中の赤子はすやすやと眠っている。顔に泥と血が付いていることなどまるで気にせぬ様子だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "ご依頼の件は、全て完了いたしました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "彼らの手管はよく承知しており、対処法も存じています。どうかご心配なく、あなたのお体を汚すようなことは起きません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な老人",
      "text": "かような大義……老いぼれには、どう報いたらいいやも分からぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "いいえ……感謝など無用です。あなたのために行ったのではございませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "あの方には大きなご恩がございます。私が今回行ったことでは、彼女の冤罪をすすぐことは叶わず、復讐など語るべくもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "私に親族はおりませんゆえ、死後の憂いはございません。閣下に願いたいことも一つだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "どうか……この子を引き取ってはくださいませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な老人",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "この子に何も伝える必要はございません。ただ無事に成長し、平穏に一生を暮らせればそれでよいのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な老人",
      "text": "……貴殿も分かっているであろうが、この子がここに留まれば、危険が増し、この件が蒸し返される可能性も高まる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "それが、あなたが望んでいたことではないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "時勢のしからしめるところにより、今の我々にはなす術がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "しかしいつの日か、三十年でも、四十年でもいい……いつの日か、真相が白日の下にさらされるのであれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "手が血だらけの者",
      "text": "流された血は……無駄ではないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な老人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な老人",
      "text": "よかろう。引き受けよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
