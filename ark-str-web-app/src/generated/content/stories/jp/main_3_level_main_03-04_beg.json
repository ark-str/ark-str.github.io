  "storyId": "main_3_level_main_03-04_beg",
  "groupId": "main_3",
  "stageId": "main_03-04",
  "title": "亀裂",
  "storyCode": "3-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_03-04_beg.txt",
  "sourceHash": "66e2f0755e49598f506278aa384e0fe4fcfa95398155862515a0696c5c4bfa43",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十六关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "アーミヤ、どうだった？　ペンギン急便ってすっごいでしょ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい、とってもすごかったです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "おっ、おお～う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "自分より若い子に直球で褒められると、なんかちょっぴり照れちゃうなあ。へへっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "彼女は依頼主だぞ。礼儀をわきまえろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "おっと、ごめんなさ～い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "いえ、お気になさらず。お二人には、感謝してもしきれないほどですし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そうか。ともあれ、これでロドスとは合流できたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "次はどう動く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今回は共同作戦ですし、まずは近衛局の判断を仰いでみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ならば、彼らにも合流を呼びかけてみよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "この地形を見るに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "レユニオンは、あえて我々を誘い込んだのかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "荒れ地に広がる砂と岩……野外作戦にはうってつけの条件が揃ってるものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ここに足りないものなんて、あとは敵影くらいじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――ホシグマ、お前にはロドスのサポートを頼む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "なるほど？　了解です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私は近衛局の部隊と共にポジションを移動する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "このまま膠着状態が続けば、レユニオンを見失ってしまう可能性もあるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "では、どうかお気をつけて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "――うんわあ～、それにしてもすっごい風！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あーあー、視界最悪、何も見えないでありま～す……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "これ以上は進めそうにないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "レユニオンとしては、こっちが包囲網に入るのを待って仕掛けてくるつもりなのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "だけど、思い通りにはさせられないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それじゃ、こうしましょうか。――アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしとリスカムたちで迂回して、敵方を偵察しつつ、高台に陣取れないかやってみるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だから、こっちから連絡を入れるまで、ほかのみんなにはここで待機しててほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もちろん、私たちがどんなに派手にやりあってようと、飛び出してきちゃダメよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "わかりました。とはいえ、状況に合わせて判断しますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はいはい。ドクター、あなたもちゃ～んと見ててあげてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "それでは、また後ほどご連絡します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "この辺りには誰もいないみたい。高台を守ってる様子もないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まったく、お笑いぐさね。レユニオンにはまともな指揮官がいないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "というと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ここはどう見ても、守りやすくて攻めにくい地形なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "つまりあたしならここに伏兵を置くけど、あの連中ときたら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――かかったな！　死ねっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あ～あ、言ったそばから……恥かかせないでちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――フランカさんっ！　側面にも注意してください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "建物の下に、レユニオンが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ぐっ……た、太刀筋が、見えない……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "どう……して……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そこに隠れれば、足元から奇襲できるとでも思ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だとしたら、あたしをちょっと甘く見すぎじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……く、そっ……ブラック……スチール……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン",
      "text": "っ、退却だ！　全員、撤退しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "やれやれね。レユニオンが大勢待ち構えてるだろうと思って、こっちも慎重に進んできたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "待ってたのは小物のザコばっかりなんて、正直がっかりだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "がっかりしてる場合じゃないよ、フランカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そう簡単に逃がすわけにもいかないでしょ。追いかけないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "アーミヤさん、追跡の許可をお願いできますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "いえ、やはりここは堅実に。リスクは回避して動きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "まずはペンギン急便のお二人にお願いして、態勢を整えてから行動すべきだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "エクシアさん、高台の確保を優先してもらってもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "りょうか～い！　今すぐ行ってこよっか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。できる限り、牽制もお願いできると嬉しいです。レユニオンに反撃の機会を与えないようにしたいので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "――待った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あの連中、一度退いた先で陣形を立て直しているようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それに……先ほどは見なかった人員を連れている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "注意してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの人たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "普通の戦闘員ではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "どうして、レユニオンに彼らの姿が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……あれって、もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もしかして、何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……あっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "まさか……あの構成員たちは、サルカズ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "恐らく、そうかと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "（小声）リスカムさん。今は近衛局との共同作戦中ですから、こうしたデリケートな問題に触れることは避けておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "（小声）了解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "（小声）ありがとうございます。私の推測については、また改めてお話ししますので！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……構えろ。来るぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい！　みなさん、準備をお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今回は……厳しい戦いになりそうですから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
