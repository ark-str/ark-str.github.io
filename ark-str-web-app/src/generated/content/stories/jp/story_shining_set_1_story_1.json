{
  "server": "jp",
  "storyId": "story_shining_set_1_story_1",
  "groupId": "story_shining_set_1",
  "stageId": null,
  "title": "雨降る夜",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_shining_1_1.txt",
  "sourceHash": "f16e839bb2c5c43ab6ffe8650e7576fbe7dd4975524b046dbd293207525d369a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "通りすがりの傭兵です。雨があまりにひどいので、少し雨宿りさせてもらえないでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "村には宿屋がある。そこに行けばいいだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "少しの間だけ、雨をしのげればいいんです。先を急ぐ旅ですので、すぐにお暇します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "あんたひとりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "仲間がもう一人います。ただ、彼女はあまり体の自由がききません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "サルカズか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "何もしません。ただ雨宿りを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "魔族と関わるのはごめんだ。出ていってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "男は脅迫のつもりか、彼女の首に剣をかけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "二度は言わん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "せめて……仲間だけでも屋内で休ませてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "どこか悪いのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "あなたと同じです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "感染者、なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "あんた、自分のことを傭兵だと言ったな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "玄関先だけだ。勝手にうろつくなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "パパ、お客さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "お前には関係ない。部屋に戻ってなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "はあい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん、目を覚ましたのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "運よく雨宿りさせてもらえる場所を見つけたので、しばらくは休憩しましょう。もう少し進めば、ヴィクトリアから出られます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "よかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "シャイニングさんも……休んでください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "はい、もちろんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "……お姉ちゃんたち、タオルいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "娘がサルカズに近付いていることに気付き、家主は無意識に剣に手を伸ばす。\nしかし彼が心配していたような出来事は起こらなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "タオルを受け取ったシャイニングは、ナイチンゲールの髪を拭いてやったりと、一通り丁寧に世話を焼いてから、やっと自身のフードを脱ぎ、水の滴る長髪を乾かし始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "まだ何か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "う、ううん、ただお話がしたいなって……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "チチチッ。\n青くて小さい何かが、ナイチンゲールのポケットから顔をのぞかせたかと思うと、ちょこんとその肩に飛び乗った。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "わっ、羽獣だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "なでてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナイチンゲールが女の子のほうに手を伸ばすと、羽獣はぴょんぴょんと肩から降り指先へ移動した。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "うわあ、すごい！　羽獣ってこんなにお利口さんだったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "えへへ、はじめまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "きみはどこから来たの？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "羽獣は女の子の問いかけに答えるかのように鳴き返した。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "ねえ、羽獣さん、一緒に遊ぼうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "パパがオモチャをたくさん作ってくれたのに、村の子たちは誰もわたしと遊んでくれないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "オモチャとは……どのようなものですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "お姉ちゃんも遊ぶ！？　ちょっと待っててね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "女の子はいそいそと部屋へ向かって走っていく。\nそして、何かを探しているような物音がしばらく聞こえると、小さな箱を抱えて戻って来た。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "この中におもしろいものが、いっぱい入ってるの。全部パパが木で作ってくれたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "一番のお気に入りはこの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "あれ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "女の子は箱の中をひっくり返しながら、細長い木製のブロックを見つけては取り出す。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "バラバラになっちゃってる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "手伝いましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "うん、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "同じ形のブロックを見つけたら、一段三本で縦横の順番で積み上げていってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "シャイニングは女の子と一緒に、箱の中のブロックを探し始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "ねえ、お姉ちゃんの角、すごくきれいだね。お姉ちゃんはエラフィアさんなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "いいえ、サルカズですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "あっ、たしかにモフモフのお耳がないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "さっき部屋にいた時に聞こえちゃったんだけど、ヴィクトリアから出ていくって言ってたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "ヴィクトリアが嫌いなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "そうではありません。ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ヴィクトリアは私たちには合わなかったんです……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シャイニングは箱から見つけ出した数本のブロックを手に取り、一本ずつ丁寧に積み上げていく……\n数段も積み上げないうちに、目の前の景色がぼやけはじめ、混ざり合いはじめた。\n久しぶりに感じる優しさに満ちた空気に気が緩んだのか、突如の眠気が彼女を襲う。\n思考が円を描く光に引きずられ、グルグルと空中で回る……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すぐ先に光が見える。出口はもうそこだ。\nシャイニングの背後の暗がりには、聴罪師の衛兵の死体がゴロゴロと転がっていた。\n彼女は振り返ることなく、自身の背中に縛り付けたナイチンゲールの体をそっと撫でた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "まだ朦朧としている状態にもかかわらず、ナイチンゲールは無意識にシャイニングを強く抱きしめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "もう少しだけ辛抱してください、リズさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵",
      "text": "あそこだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "行きましょう。ここから抜け出すのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……どこに行けばいいのかは、私にも分かりません、リズさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "もしかしたらこの大地には、私たちの居場所などもうないのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "だけど少なくとも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "あなたをここに残していったりはしません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一筋の光が洞窟の中を駆け抜け、頑丈な岩や柱に次々と傷を残していく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シャイニングが洞窟を出るよりも先に、青い羽獣が一羽、待ちきれないといった様子で太陽に向かって飛び立った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵A",
      "text": "さっきの音はここからだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵B",
      "text": "チッ、逃げられたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵B",
      "text": "俺は奴らを追う。お前はリーダーへ報告を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵A",
      "text": "なんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵B",
      "text": "洞窟の入り口が崩れる！　下がれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵A",
      "text": "う、うわああああーー！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ああっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然の大声に、シャイニングがハッと目を開けた。\n女の子がうっかり完成間近の木のタワーを倒してしまったようだ。そのせいで、ブロックが床一面に散らばっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "もう少し眠っていても大丈夫ですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "いえ、十分休めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "ぐすん……またやり直しだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "でしたら、もう一度やり直しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "あの……私も手伝ってよろしいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "もちろん！　一人でも多いほうが助かるもん！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "三人でもう一度ブロックを積み上げながら、シャイニングは家主を横目で一瞥した。\n彼は先ほどの長剣を手にしたまま、窓辺に座っている。\n対照的に、娘のほうは自分たちのそばに座り、散らばったブロックの一部をナイチンゲールの前に寄せると、またタワー作りの作業に戻った。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "これで最後……できた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "じゃあ、さっそくあそぼ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "ルールは簡単。サイコロを振って、出た目の数だけブロックを抜いて、タワーの一番上に重ねるの。それで、タワーを倒しちゃった人が負けだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "まずサイコロで順番決めをしよっか……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "三人はサイコロが床を転がるのをじっと見守る。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……私からでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "うん！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナイチンゲールはサイコロを拾い上げ、滑らせるようにして床に落とした。\nうまく手に力が入らないが、幸運にもまだ一本目のブロックだったため、難なく引き抜きてっぺんに積み上げることができた。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "次は黒いお姉ちゃんの番だよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "シャイニングはサイコロを受け取り、床に転がした。\nそして、出た目の数を確認すると、タワーのほうに向きなおる。\nブロックを一本引き抜くだけなら、そう難しいことではない。しかし、ゲームが進行するにつれ、タワーのバランスは徐々に崩れはじめる。\n過去の選択とめぐり合わせが積み重なり、未来の自分にのしかかる大きな圧力へと変わっていくのだ。\nシャイニングは、そんな感覚に不快を覚えた。\nだが、ルールである以上、途中でやめるのも気まずい。\nこうしてまた一本、タワーの頂上にブロックが積まれた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ふぅ……大丈夫ですか、リズさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ええ……問題ありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "実験室からここまで、かなり距離を稼ぐことができました。すぐには追いつかれることもないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "先はまだ長い。ここで少し休むついでに、食事にしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "まだお腹は空いていません……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "シャイニングが荷物を確認すると、残っている食料は果物が一個だけだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "携帯食がまだ少し残っています。先に果物を食べてしまいますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "あの橋を渡れば村があるはずです。そこで食料をもう少し買い足しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "さあ、皮が剥けましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村に足を踏み入れると、まるで牙獣でも襲ってきたかのように、村人たちの驚いた声と囁き声が二人を包み込んだ。\nだが、シャイニングはそんな声をまったく気に留めていなかった。食料さえ手に入れば、彼女たちはすぐにでもヴィクトリア人の前から姿を消すだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "いらっしゃい。何をお求めで……\nま、魔族！？"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "こんにちは、パンを買いたいのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台のパン売り",
      "text": "あっちへ行ってくれ。魔族に売るパンはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "値段はいくらでも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台のパン売り",
      "text": "ハハッ、あんたの金なんか受け取っちまったら、誰もうちのパンを買ってくれなくなるだろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台のパン売り",
      "text": "どいたどいた。後ろにお客さんがいるんでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "失礼します……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シャイニングは剣の柄に手をかけた。\n一筋の閃光がひらめく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台のパン売り",
      "text": "ひぃっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台のパン売り",
      "text": "ひ、人殺し！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "待ってください――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "聴罪師の護兵による尾行をいち早く察知したシャイニングは、騒ぎにならないようにと、あえて人の多い場所を避けて行動していた。\nしかし、パン売りが大声を上げながら人混みに向かって走っていったため、どんどん人が集まって来る。\n「魔族が人を殺したらしいぞ！！」\n「早く騎馬警察を知らせないと！！」\n「村長の息子って術師だったよな？　今すぐ呼んで来い！！」"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ただ空腹を満たすための食べ物がほしかっただけなのに、結局は慌てて村から逃げ出す羽目になってしまった。\nナイチンゲールが自分の服をきつく握りしめ、ガタガタ震えているのが、背中越しに伝わってくる。\n村が遠ざかっても、自分たちを罵る叫び声や怒声は、いつまでも背後で響いていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "シャイニングさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ハッと我に返る。いつの間にか、ゲームはかなり進行していたようだ。\nほとんどの段は一本のブロックのみによって支えられ、タワーはグラグラと揺れながらも、絶妙なバランスを保っている。\nあと少しで勝負は決まるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "手伝いましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "いえ……自分でやってみます。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "だが、ナイチンゲールが狙いを定めたブロックは、上に積まれた重みによるせいか、力を込めるたびに上に乗った他のブロックたちも一緒になって動いてしまう。\nナイチンゲール、そしてそばで息をこらし見守っている女の子も、そのブロックに集中するあまり、シャイニングと家主が同時に立ち上がったことにまったく気付かなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "外にサイフを落としてしまったみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "あんた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "すぐ戻りますので、少しの間、彼女のことを見ていてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "なんでもありませんよ。さあ、続けましょう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "タワーの重心に変化が生じることを期待しつつ、ナイチンゲールは試行錯誤を繰り返した。\nしかし、やはりブロックは上にのしかかる重みから、抜け出すことはできなかった。\nこんな時、シャイニングならどうするのだろうか？\nきっとタワーが反応するよりも前に、目にも留まらぬスピードでブロックを引き抜くはずだ。\nなら、自分も彼女のやり方を試してみよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "がんばって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナイチンゲールは深呼吸をし、ブロックをつまむ。そして力を込めて一気に引き抜いた――\n窓の外で閃光が走ったと同時に、タワーが崩れ落ちた。"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "わたしと黒いお姉ちゃん勝ちだ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナイチンゲールが負けたはずなのに、女の子はなぜか彼女も勝者であるかのように、その手を取って小躍りして喜ぶ。\nその純粋無垢な思いが、凪いだナイチンゲールの心にさざ波を立てた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "戻ったか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "全部見ていたぞ。あんた、一瞬で全員を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "あんたらも追われているのか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "シャイニングは窓の外に目をやった。雨足はもうずいぶんと遠のいており、暗闇が屍を上手い具合に隠してくれている。\n聴罪師の衛兵が八名に、得体のしれない刺客が六名。異なる二つの集団が、同じ家にやって来たのである。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "つまり、あの六人の刺客は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "ああ、俺と娘を殺しに来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私たちが家で雨宿りをするのを許してくれたのは、このためだったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "そうだ……あんたがサルカズだったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "時間に余裕がなかったせいで、俺が依頼した護衛はまだ到着していないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "あの傲慢な貴族がサルカズを雇うはずがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "それに、あんたはそこそこ腕が立ちそうだったから……でも、まさかあんたらも俺たちと同じで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "気にしないでください。お気持ちは理解できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "とにかく、あんたのおかげで本当に助かったよ。もし先を急がないのなら、ここで一晩休んでいってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ありがとうございます。ご厚意に甘えたいところですが、これ以上時間を無駄にはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "待ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "道中で食料を手に入れるのは大変だろう。パンと干し肉がまだ少し余ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "これは……本当にありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "それはこっちのセリフだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "誰かとあんなに楽しそうに遊ぶ娘の姿を見たのは久しぶりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "あの子は昔からあんな調子でな。警戒心というものを知らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "でも俺たちはずっと逃げ回り、人目を避けて引っ越しを繰り返してきた。そのせいで、あの子は俺以外の人ときちんと交流する機会もなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "だが、こんな生活もあと少しで終わる。これから来る傭兵に、あの子を親戚のところへ送り届けてもらう予定なんだ。そうすれば、落ち着いた暮らしがやっとできるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "あなたは一緒に行かないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "あの貴族のクソ野郎は妻を殺し、俺を感染させた……娘の安全が確保できたら、代償を支払わせるつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "俺は必ず自分の役目を果たす。逃げたりはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "雨が止みましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "雨宿りをさせてくれて、ありがとうございます。私たちはもう行きますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん、行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "でも、もう外は真っ暗だよ？　お姉ちゃんたち、本当に泊っていかないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "すみません。機会があれば、また一緒に遊びましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "あっ、ちょっと待って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "これ、お姉ちゃんたちにあげる！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "女の子は箱から二つの石を取り出すと、シャイニングの手に押し付けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "幸運を呼ぶ石だよ！　川のそばで拾ったの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "幸運を……呼ぶ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "うん！　二つの石をぶつけて鳴らすと、幸運がおとずれるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "前に鳴らしたら、パパが大きな羽獣を捕まえてきて、二人でごちそうをお腹いっぱい食べたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村人の子ども",
      "text": "もしかしたら、お姉ちゃんがいつか石を鳴らしたら、またわたしたち、再会できるかもしれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "その日が来ることを楽しみにしていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "じゃあな、サルカズ。またいつか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "はい、またいつか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "来たか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こんばんは、エドモンドさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の村人",
      "text": "わざわざありがとうございます、ニアールさん。どうぞ中へ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "どうしました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "この石、一つはあなたが持っていてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "先ほどは楽しかったですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "楽しい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "よくわかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ただ……とても温かかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "誰かに尊重され、気にかけられ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "剣を突き付けられるのではなく、差し伸べられた手を握り返せる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "もしいつか、それが当たり前になれたら……楽しい……ええ、きっと楽しいんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "次に村を通りかかったら、そこで一休みしませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "すべての人が善意をもって私たちに接してくれるわけではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私たちはサルカズです。しかも、あなたは鉱石病を患っている。私たちは、大多数の人間からは歓迎されない存在なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "あの家の主人が偶然感染者でなければ、屋根のある場所で雨宿りするチャンスなんてなかったかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "でも、チャンスは必ず巡ってくるものでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私たちは時折、誰かの苦痛を癒してあげることができます。ですので、きっと他者から親切にしてもらえることもあるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "たとえその可能性がほぼゼロであっても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私はシャイニングさんを信じています。あなたのまっすぐで誠実な心に、きっと応えてくれる人が現れますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "では、村やキャラバンを見かけた時には、声をかけてみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "白い目で冷たくあしらわれる覚悟をしておいてくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "でも運が私たちのほうを向いていれば、手を差し伸べてくれる親切な人に出会えるかもしれませんね。もしかすると近い将来、安心して落ち着ける場所を見つけられる可能性もあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "運ならもうとっくに私たちの元にあるじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナイチンゲールは、先ほどシャイニングから受け取った幸運を呼ぶ石の片割れを取り出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ふふっ、そうでしたね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "シャイニングも自分の石を取り出す。\nカン――二つの石がぶつかり、澄んだ音が響いた。\nこうして、二人のサルカズは幸運を引き連れ、月明かりに照らされながら、ヴィクトリアを去った。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
