{
  "server": "jp",
  "storyId": "story_skfire_set_1_story_1",
  "groupId": "story_skfire_set_1",
  "stageId": null,
  "title": "昔の学友",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_skfire_1_1.txt",
  "sourceHash": "8cb60ccc8971be9d53ccd39bbf8fd4358275d54c2522e4d62234278a67a50bbe",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おい、聞いたか。モンベラン家のお嬢様がヴィクトリアに帰って来たらしいぜ。しかも今、ここカレドンにいるんだと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "カレドンに？　都会じゃなく？　なんでまた……ここは感染者も多いし、前にレユニオンとかいう連中ものさばってたんだぞ。お嬢様はやつらと因縁があったんじゃなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さあな。こっちの議会に勤めてるらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ふ～ん――議会ねぇ。モンベラン家のご令嬢ともあろうお方が、こんな田舎町で役所勤めか、仕事もさぞ楽なんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "なんだい、その反応は。てっきり大喜びするかと思ったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何を喜べっていうんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前んとこの工場、商機を伺ってたんだろ？　ああいう驕り高ぶったお方なんか、丁度いいじゃないのか。それに、あの事件のこともあるしさ。お嬢様はきっと感染者が憎くてしょうがないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "しかも、今は議会で仕事してると来た。ここまで言えばもうわかるだろ。さっさとお近づきになって、甘い汁でも吸わせておけば、お前の工場なんてすぐ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "あら、何かしら？　これは……招待状？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "「……つきましては、ぜひともご出席を賜りたく存じます。その際には……見学と、シャンパンを振る舞いたく……開催時刻は今夜八時となりますので、ぜひともご参加くださいませ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "同窓会のお誘い、か……まったく、どうしてこんな時間の無駄なうえに断りにくいものに対応することを「礼儀」と呼ぶのか、理解に苦しみますわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "まあ、仕事が終わった後に行って差し上げてもいいでしょう。ご老人どもが今日も厄介ごとを押し付けてこなければね――\nふぅー、いけませんわ。イラつくことは仕事にとっては不必要ですものね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "さて、仕事の時間よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "仰々しい貴族",
      "text": "おぉ、これはこれは。先週のパーティでもお見かけしたが、やはりあなたの美貌には息を呑んでしまいますなぁ。ぜひもう一度お会いしたいと、皆さんも口々に言っておりますぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自信溢れる貴族",
      "text": "ハッ、美貌ですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自信溢れる貴族",
      "text": "心にもないようなことを、私の所有する事業がお目当てなのはお見通しよ。なにせ、数ヶ月で一年分の利益を生み出せるってもっぱらの評判ですものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自信溢れる貴族",
      "text": "アダム伯爵だってそうよね？　あんな養分不足のトウモロコシのヒゲみたいな寂しい頭をしていたって、皆さん口をそろえてハンサムだって褒めていらっしゃるでしょう。同じことですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "仰々しい貴族",
      "text": "オッホン！　はっはっ、いやぁ～相変わらずのユーモアですな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "仰々しい貴族",
      "text": "しかし、事業規模の話となれば、私が所有してるワイナリーこそ、勝るとも劣らない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "（互いに見栄を張って、財産を自慢して、この場にいない人を嘲る……フンッ、ここにいる連中は相変わらずね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商機を伺う商人",
      "text": "アンビュラス伯爵様、おかげさまで私の工場もようやく軌道に乗りました！　ただ貴方様により多くの利益をお届けするには、もう少しばかり追加の資金が必要でして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "あっはっは、私のことを覚えていてくださって光栄至極でございますよ。同じ講義を受講してた頃は、座席がちょうど貴方様の後ろでしたよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "つきましては私が所有する事業をぜひご覧いただけたらと思っているのですが……あっ、そうですか、失礼いたしました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "（パーティを出世の土台にする人たちと、こんなことでチヤホヤされて承認欲求を満たしている人たち。まったく……なんの新鮮味もないですわね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "（これ以上の長居は無用ね。カレドンに帰るには時間もかかるし、もう出るとしましょう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさん、やっぱりモンベランさんですよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "よろしければこちらのシャンパンはいかがですか？　ぜひぜひ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "まさかここでモンベランさんにお会いできるとは！　私のことは覚えてらっしゃいますか？　ほらあの時、あなたの後ろに座っていた者ですよ！　いや～随分とご出世なされたようで、何よりです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "申し訳ないのですが、もし急用でないのならそういうのはまた今度にしてくださらない？　まだやることが残っておりますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ええとですね、実はモンベランさんが議会でお仕事をされているのを小耳に挟みまして。私、小さな工場を経営してましてね、規模はまだまだですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "イザベラの事業と同じくらいの利益を生み出すポテンシャルを秘めているのは保証できます！　ということで、ご支援をいただけるのなら――ご満足いただけるお返しを差し上げられるかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "例えばですね、議会からの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "興味ありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "（これだからお嬢様っていうやつは……オレの工場をよく知りもしないくせに……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "（ケッ、世間知らずの貴族め……自分の血統にしがみついて人を見下しやがって……こっちはこんなに腰を低くして話してやってるってのに――！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ご存じないかもしれませんが、私の工場はカレドンにありまして、あなたと議員の方々のおかげで立ち上げることができたんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさんだって、あの低俗な暴徒どもを嫌悪されていましたよね？　あなたの愛するペットのために、ヤツらも相応の代価を支払ったと言えますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ともかく、今の政策にはとても感謝してるんです。議会は私たちの味方ですよね？　あの低俗な連中も、私たちに使われるためにあるようなものです。そこで私は上手く利用する方法を学びまして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "もしここで、さらに一歩前に進むことができるのなら、必ずやもっと素晴らしい成果を挙げられるでしょう。その暁には、必ずモンベランさんのご協力に報いますよ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "（いっそこの場で彼を燃やしてしまおうかしら――\nいや、ダメよ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "それにしても、なんだか部屋の中が少し熱いような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさんもそう思いませんか？　どうでしょう、よろしければ続きは外に出てお話ししても？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "（やっぱりここで燃やしたほうが……\n――いや、ダメだわ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "こちら、私の名刺になります。どうぞお受け取りください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……では、一応いただきますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "「バロン工場」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ええ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "あぁ、バロン工場でしたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "なんと、ご存じでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ええ、もちろん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "以前、議会で貴方の工場をモデルケースにして、新しい議案を策定したことがありますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "プライベートでも、わたくしや恩師も貴方の工場に注目しておりましたわ。送られてきたリストにも、「バロン工場」の名が上の方に載ってましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ほ、ホントですか！　それはなんとも光栄の至り！　でしたら、私にも何か……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "わたくし、機密保持契約書にサインしておりますのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ああ、ご心配なく、内密な話を聞き出そうだなんて無粋な真似はいたしません！　議会関連の雑談に、ほんの少し参加させていただければ結構です。私も単に話のネタを充実させたいだけですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "例えばですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "いま議会で話し合われている労働時間に関する新しい規定のこと、などかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "そうです！　まさしくそういったことです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "いかがでしょう、私どもの工場までお越しになって実情を視察していただけましたら、大変光栄なんですが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "いや～こんなところまでお越しいただけて、誠にありがとうございます！　前もって一通り掃除させておきましたので、チリ一つありませんからご安心ください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "普段の様子を見せていただくと言ったはずですが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "いやいや、不用なホコリを払っただけですから、工場の運営状況へのご理解に差し障ることはありませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "さぁさご覧ください！　自慢ではありませんが、このような規模は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "カレドンで一二を争うとまでは言えませんが、確かに立派ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "設備も防護措置もしっかりと備わっておりますのね。既存の条例をよく守り、きちんと整備されていますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "安全管理もしっかりと規定通りになさっているようですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "もちろんですよ、モンベランさん。こういった基本をしっかり行うのは当然です。見くびってもらっちゃ困りますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "作業場のほうもご覧になりますか？　でもこの奥は感染者の作業場ですので、防護措置は整っておりますが、あまりご興味がないようなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "見させていただきますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モ、モンベランさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "あっ、分かりましたよ！　きっと例の事件のせいでまだ気がかりなのでしょう。工場にレユニオンとかいう連中が潜んでいないか、ご自分で確認されたいのですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ああ、そうですわね。そう、レユニオンよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ですが安心してください。うちの従業員は全員身分審査を済ませていますから。もしご機嫌を損ねるような者がいれば、この私が必ず――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "それは直接見てから判断いたしますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "え、ええ、もちろん……では防護服をご着用ください。モンベランさんが行きたいのであれば、たとえ命の危険に晒されようと、どこまでもお供いたしましょう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ここですか？　従業員たちは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "いや～まさかこんな所にこれほどのご興味をお持ちになるとは。モンベランさんを感染者と同じ空間にいさせてはなりませんので、彼らを追っ払いました。浄化装置も最大出力で稼働させていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "しかし、それでも私たちはここに長居しないほうがよさそうです。正直、私も初めて……あぁいや、しばらくここに来なかったものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "そう……軽くひと回りするだけですから、そんなに時間はかかりませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "なんと言っても、ここは貴方の稼ぎ場所ですから、わたくしも関心を寄せているのです。お忘れですか？　わたくしも恩師も、以前から貴方の工場に注目しておりましたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "もちろん覚えておりますとも、私にとっては光栄の至りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "感染者は給料が安いですし、社会保障もそんなに与える必要はありませんからね。こんなに使いやすい労働力を手に入れられたのも、すべて議会のおかげです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "あれは何かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "あぁ、監視装置ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ほら、しっかり見張っておかないと、サボりたがるヤツが出ちゃいますから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "これらのライオットシールドは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "あぁ～それはお気になさらず、感染者は扱いにくくて小賢しい連中ばかりですからね。そこに関してはモンベランさんのほうがお詳しいかと。多少は脅してやらないと、大人しくなってはくれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "暴動鎮圧用の装備が置かれているのを見たら、感染者たちがかえって恐怖心に駆られて混乱を引き起こすのではありませんこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "えっ……はは、それは心配のしすぎですよ、モンベランさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "どうせ連中には見えないんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "見えない……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "――さあ、モンベランさん、そろそろここから出ましょう。防護措置は万全とは言え、万が一ってこともありますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "このエレベーターで外に出られますので、ささ、早く外へ。マスクを外して一息つきましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさん、ここでは昔の同級生同士、二人っきりですので、少し正直な話をしましょう。これを聞けば、より私の工場に興味を持っていただけるに違いありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "今ご覧になったものに失望なさらないでほしいのです。それにあなただって気付いているんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "監視カメラに鎮圧用の警備員、そして武器……ご存じの通り、金儲けの方法は全部を公に晒すもんじゃありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "本物は、この下にあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "ただ、あまりにも汚い場所でしてね、モンベランさんがじきじきにご覧になる必要はありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……なるほどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "今のお話――とても満足いたしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "すごーく、興味深いですわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "元同級生は再び周りの温度の上昇を肌で感じた。\nそれはスカイフレアが金の匂いを嗅ぎつけ、またあの感染者たちを虫けらのように踏みつぶせることに興奮しているのだと、彼はそう理解した。"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "荒野の獣は獲物をよく観察してから狩りを始めると言います。もし私が本当のことを話さなければ、モンベランさんも興味を持ってくれないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "似たような工場はもうごまんとあるんですから、のし上がっていくには、目玉になるようなものが必要になります、違いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ふっ。ええ、確かにその通りですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "はははは、いや～ご理解いただけたようで何よりです。さて、こちらに私のコレクションからとっておきの銘酒を用意してあります。ぜひここで乾杯といきましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさんが高いリターンの可能性を秘めた投資先を見つけたことに！　そして私も更なる高みを目指せることに！　乾杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "うふふ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "乾杯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その時、スカイフレアの足元からは陽炎が立ち上っていた。\n瞬きをする時間さえあれば、彼女はこの工場を焼き払い、地下に閉じ込められている人たちを救出することができる。\nだがそれも束の間で、彼女は心に燃えたぎる怒りを抑え込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "先生、お呼びでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "「『レユニオン』を名乗る感染者の暴徒たちが『王の杖』という団体から重大な被害を受けた」――これが私の耳に入った情報だ。どういうことか、説明してもらってもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "それは……あの者たちは、フィルを殺したのですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "そうだとしても、君のやっていることが唯一の解決策というわけでもないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "暴力をもって暴力を制す……モンベラン君、その考えは私の教えと完全に乖離しているように思えるのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "最初に何と教えたのか、忘れてしまったのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "レユニオンの問題は単純に感染者問題と割り切れるようなものではない。君がこの道をそのまま進むつもりであるのなら、私が紹介した場所へ行きなさい。そこでよく学び、視野を広げてみるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "どうか失望させないでほしい。君は自分の考えをしっかり持った子だが、物事というのはその本質を正しく見極めてから判断するべきだ。決して己の感情に吞み込まれないようにな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "炎ですべてを燃やし尽くしたとしても、問題解決には至らない。\n彼女は手にしたワイングラスを握りながら、工場でしばし佇み、自分の昂った呼吸を落ち着かせた。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "次の議会が開かれる日時はご存知ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "良い知らせを楽しみに待っていてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "はははは！　ええ、感謝いたします、モンベランさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "以上がことの経緯ですわ、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "バロン工場。以前感染者の権利調査を行った際もリストに上がっていた工場ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "当時にはすでに先生のご意見を伺い、スパイを放って潜入調査も終えておりますの。ここの内情についてもファイルにまとめてあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "それと、これはつい数日前に知ったのですが、ここの経営者はなんとわたくしの元同級生でしたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "本当はあの場ですべて燃やしてやりたかったのですが――無論そんなやり方が通じるわけもなく、むしろ余計なトラブルを増やすだけということは分かっております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "しかし、彼の所業をそのままにするのも耐えかねますわ。パーティで媚びを売り議会の情報を探るのも、議員であるわたくしに向かって自慢げに工場の実態を見せびらかすのも、思い返せば反吐が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "あのようなことを当然のようにやっているということは、すでにああいった下劣なやり方で利益を貪っている人間が無数に存在しているに違いありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "これは明らかに現行の条例に違反した事業ですのよ？　なのに、彼らは何の罰も受けてこなかったどころか、むしろ利益を得ていますわ。だから次から次へと手を染めて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……実を言えば、彼のことは覚えていますの。わたくしにすり寄ってた時に言った「後ろに座っていた」というのは、あながちウソではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "彼はあの場にいた貴族全員にそう言っていましたが、確かにわたくしの後ろに座っていたこともありましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "昔の彼は……あんな人ではありませんでしたわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "ほう、昔はいい子だったと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "そういうわけでもないのですが、少なくとも今のような人ではありませんでした……彼はああいう本性だったから、こんなことをしたのでしょうか？　わたくしはそうは思いませんわ、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "条例の抜け穴を利用して不正な利益を得ても、誰にも咎められることがなかったから、彼は少しずつあんな人間に変貌してしまったのだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "わたくし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "迷っているのかい？　モンベラン君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "いいえ、迷ってなどいませんわ、ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "どう言ったらいいのか分かりませんが、やるべきことははっきりとしておりますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "アンモス、先生にもう一度あの闇工場のことを説明してもらえるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情報提供者",
      "text": "承知いたしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情報提供者",
      "text": "自分はモンベラン様から頂いた情報をもとに、調査を実施するべく工場の近くで身を潜んでいましたが、地下施設へ入ろうとしたところ、装備していた通信機の信号が強制遮断されてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情報提供者",
      "text": "おそらく地下にはジャミング装置が設置されていると思います。中にいる感染者たちは外部との連絡を完全に遮断されているのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情報提供者",
      "text": "数日間観察したところ、秘密裏に工場から亡くなった感染者が運び出されて処分される現場も目撃しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情報提供者",
      "text": "中にいる武装戦闘員も地下を監視するために配備されていると思われます。上階の感染者たちは本当のことを知らず、何か重要な製品を見張っているのだろうと思っているようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情報提供者",
      "text": "モンベラン様が提供した資料から推測すると、おそらく地下には、ここ最近行方不明になっている重症の感染労働者たちが収容されているのではないかと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情報提供者",
      "text": "治療の必要がないのをいいことに、彼らは使い捨ての労働力として死ぬまで地下工場で働かされる。亡くなればすぐに処分して、また新たな感染者を補充する、といった仕組みかと思われます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "そうか……分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンスト議員",
      "text": "ではモンベラン君、この一件をどう処理するつもりかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "わたくしからの報告は以上ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族議員たち",
      "text": "ご苦労だった。しかし、なぜ我々がこのような他愛ない工場の話に――十数分もの貴重な時間を費やさなければならないのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族議員たち",
      "text": "これは我々が議論するほどの問題ではない。そのことをよく理解してくれたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族議員たち",
      "text": "アンスト議員が君をここへ寄越したのは、そんなちっぽけな工場の問題を解決するためだったのかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "今回の一件について、皆様にご理解いただきたいのは、失踪した感染労働者が暴力により無理やり地下に閉じ込められ、死んでも秘密裏に処分されているということです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "なおかつ、彼らは源石粉塵の濃度が高い環境で労働し、十分な防護措置や通信設備も備えていません。これらはどれも現行条例に違反しておりますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "感染者に寛容な政策が実施されているからこそ、多数の労働者が集まり、カレドンもそれによって発展を遂げられましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "もしこの件が世間に知れ渡ってしまえば、カレドンのこれまでの評判も地に堕ち、二度と感染者がここへやってくることはないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "この場にいらっしゃる皆様におかれましても、そんな事態は好ましくないと思いますが、いかがでしょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貴族議員たち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族議員たち",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "今回の件は議案ではなく、あくまで工場の処分とお考えください。カレドンの名声を守るために、議会の名のもとに感染者たちを救出し、その後で相応の対処を行う必要があると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "見せしめとして、差し押さえも議会の名のもとで行いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "この場にいらっしゃる皆様の立場から見て――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族議員たち",
      "text": "結構だ、ここらで採決を取ろうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族議員たち",
      "text": "皆様、どのようにお考えかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三日後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "こ、これはどういうことだ！　誰だお前たちは！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "何しに来た！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "あっ、待て！　この中にいるのは全員感染者だぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア将官",
      "text": "お前たちは地下に向かえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "地下？　いや地下は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵A",
      "text": "報告します！　無許可で武装した人員が多数配備されているのを確認しました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵B",
      "text": "報告します！　違法の通信遮断端末を発見し、撤去を行いました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵A",
      "text": "地下で大量の感染者を発見しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵B",
      "text": "地下で違法な工場を確認しました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア将官",
      "text": "うむ、報告通りだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア将官",
      "text": "では議会条例に基づき、この工場は閉鎖処分とする。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア将官",
      "text": "そしてお前には条例に従い、今後五年間いかなる関連事業への関与の禁止を言い渡す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア将官",
      "text": "――感染者たちの移送を開始しろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "モンベランさんッ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "おや、貴方ですか……どうされましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "私の、私の工場が……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "今朝大勢の兵士が私の工場にやってきて、地下まで……これは一体――どういうことだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "あぁ、差し押さえの件ですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "この前わたくしに支援してほしいと仰ってましたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "これがその支援ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勧誘をする同級生",
      "text": "なっ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "どこでわたくしのことをお調べになったのか知りませんが、詰めが甘かったですわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "今のわたくしは議員だけではなく、ロドスのオペレーターも務めておりますの。まだ事態が理解できないのであれば、ここではっきりと教えて差し上げましょう――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "わたくし、感染者の問題を解決するために働いておりますのよ。\nさらに言えば、感染者たちが自分の権利を行使できるよう、お手伝いをさせてもらってますの。これでもう、お分かりかしら？"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
