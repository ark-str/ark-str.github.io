{
  "server": "jp",
  "storyId": "story_strong_set_1_story_1",
  "groupId": "story_strong_set_1",
  "stageId": null,
  "title": "勘違いを押し通して",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_strong_1_1.txt",
  "sourceHash": "25e1eedeedb557a38f957134ee93f0194f78cdd58f36dea448894c85ff7cf700",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "本当にあいつか？　間違いねぇんだろうな？　違ってたらシャレになんねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "仲間がここしばらく見張ってた。聞いてる話と全く一緒だ、間違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ヒィ……確かに危ねぇ匂いがプンプンするぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どうする？　やるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "取られたブツはデカいんだ、四の五の言ってらんねぇよ……合言葉はなんだったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "確か……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "ほぅ、繁盛しとるな。正月でも休まんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "夜は通行人が多いでさぁ、商売時なんでい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "お姉さん、麻辣（マーラー）鱗獣団子スープ、お待たせ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性観光客",
      "text": "うわぁ、いい匂い！　はい、お代。置いておきますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性観光客",
      "text": "（モグモグ）……美味しい！　さすがB級グルメおすすめ百選に入る鱗獣団子ですね。ごちそうさまでし──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ちょっと待った！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性観光客",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性観光客",
      "text": "ど……どうかしましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "払いすぎでさぁ。はい、お釣りどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性観光客",
      "text": "あ……ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性観光客",
      "text": "もう……行っても大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "あ？　まだ何か入り用で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性観光客",
      "text": "ひっ……だ、大丈夫です！　さよなら！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "……また客を怖がらせちまったみてぇだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "俺、何か変なこと言ったか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "ホッホッ……ここ最近はずっとお主が屋台を出しとるようじゃな。董（ドン）はどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "最近は冷えるから、親父さんは脚が痛むんで、俺が代わりに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "爺さん、親父さんのこと知ってるんですかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "もちろん知っておるさ。龍門で鱗獣団子といえば彼じゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "一つくれ。通り掛かったついでに、ちょいと売上を足してやろう。それと、彼から学んだお主の腕前を拝見させてもらおうかの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "あいよ、ちょいとお待ちを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "おい、鱗獣団子スープ四つくれ。カレー味三つ、きのこ入り一つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "あいよ、少々お待ちくだせぇ。前の方の分を作り終えたら、すぐに作りやすんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "ゴホンッ……！　だから、鱗獣団子スープ四つくれ、カレー味三つ、きのこ入り一つ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "へい、わかってやすよ。カレー味三つ、きのこ入り一つですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）どういうことだ！？　これが合言葉じゃなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "（小声）間違いねえって！　あのフェリーンの女殺し屋は、いつもそう言ってたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "爺さん、鱗獣団子スープお待たせ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "おお、いくらじゃったかの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "いいっすよ爺さん、親父さんの知り合いなら、お代は結構でやす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "そうはいかん。払うべき金は払う、やるべきこともやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "そうじゃろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "（小声）なんだ？　あのジジイ、なんかこっちの方睨んでねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）チッ、めんどくせぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "お客さん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "鱗獣団子スープはどうしやす？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "えっと……その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "何味がいいか悩んでんなら、試食もやってるんで──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "何手ぇ出してんだ！？　まだ早ぇよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "油断してるとこ襲わなきゃ、やられんのが俺たちだっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "つべこべ言ってんじゃねぇ、こいつ連れてさっさとずらかるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "すぐ滷水幇（ルーシュイパン）んとこに知らせないとな。てめぇらのボスはこっちで預かった、今夜ブツを持って交換に来いってな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "おい若いの、手加減ってもんを知らんのか？　龍門の掟を破るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "何だジジイ？　外野は引っこんでろ！　筋モンのやり方にカタギが余計な口を出すな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "……面白い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "頭が痛ぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "何があった……？　ここはどこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "よぉ、目が覚めたか。まぁ水でも飲め。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ありが──誰……？　何だこりゃ……なんで俺は縛られてんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "アンタのような大物にゃ、こういう手を使うのも止むを得んだろ。今まで滷水幇を仕切ってるのがアンタだって知らなかったよ。失礼なことをしたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "しっかし今回の件はよぉ、滷水幇が俺たちからブツを横取りしたのが悪いんじゃねぇのか？　そこんトコどうなんっすか、えぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ブツって何のことだ？　鱗獣か？　漁船はみんな埠頭に停まってるから、新鮮な鱗獣は早い者勝ちに決まってるじゃねぇか。横取りってどういうことでい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）あいつ「埠頭」って言ってるぞ。ブツを取られたのはまさに埠頭だったよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "（小声）わかったぜ！　「鱗獣」は隠語だ。つまりあいつは、ブツは早い者勝ちだって言ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "ゴホン……まぁ、確かに一理ある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "しかしこの界隈にはルールってもんがあってな……この手の商売は今までずっと我々叉焼幇（チャーシューパン）のシノギだった。新規参入をご希望なら、一度相談するのが筋なんじゃねぇっすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "長ぇこと水産物屋やってっけど、アンタらのこたぁ知らないぜ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）「水産物屋」も隠語か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "（小声）つまり最初に始めたのはあいつで、後から入って来たのは俺たちの方だって言ってんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "……ああ、そりゃもちろん分かってるさ。アンタが龍門じゃかなり名の知れた人物だってこともな……だからこそこうやって相談してるんじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "このシノギをやりたいってんなら話し合いには応じるぜ。しかし、アンタが奪ったブツは、我々叉焼幇にとって大切なんだ。富は和から生まれるもんだろ、まずはブツを返してくんねえか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "龍門で……名の知れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "えーと……それ、人違いなんじゃ？　俺関係ないんで、もう放してくんねぇかな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "おい、こっちは歩み寄ってんだ、状況をわきまえろよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "アンタの顔に免じて交渉してやってんだぜ？　あんま叉焼幇をなめんなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "本当に何の話だかさっぱり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "まだシラを切るってのか？　おい、アレを見せろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "この写真に見覚えありますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "これは、ワイフーさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "とぼけないでくださいよ。この女が滷水幇の殺し屋で、アンタの用心棒ってことぐらい、調べがついてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "先月末に、この女がアンタんところで鱗獣団子スープを買った。その翌日、滷水幇のライバルがボコボコにされた。やったのは妙な技を使うフェリーンだったってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "これがアンタの指図じゃねえって言うのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ワイフーさん……なんてタイミングで勧善懲悪すんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "それとこいつに見覚えは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "近衛局の鬼の姉御？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "我々だけじゃねえ……どうやら近衛局もアンタらに目を付けていたみてぇだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "うちの連中が、何度もアンタの店で鬼の姉御の姿を見てるんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "近衛局特別督察隊のお役人さんが、どうして鱗獣団子屋なんぞに興味を持ってんのか、説明してみろや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "それも誤解だっつの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "フン、滷水幇の猿芝居に俺たちが騙されると思うなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "いい加減認めなって。アンタら滷水幇の名義上のボスはただの操り人形……本当のボスはアンタだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "（もう黙ってた方がいいな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "だんまりか？　話はここまでってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "いいぜ、それならアンタんとこのモンたちが、果たしてボスを助けに来てくれるのか、確かめてみるんだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "同時刻──"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "兄貴、ボスの行方がわかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "なにぃ！？　どこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さっき叉焼幇から連絡が来て、ボスを預かってるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "住所も送られてきて、今夜ブツを持って交換に来いとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "クソッ！　やっぱりあいつらだったか！　うちのモンを集めろ！　全員で叉焼幇にカチ込むぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "じゃあブツは本当に持っていくのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "持ってくわけねーだろ！　うちをなめやがって……行くぞ、やつらのタマぁ取ってやんよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "考えはまとまったかい、「ボス」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "滷水幇に伝えといてやったぜ。今ならブツをよこせば、まだ穏便に済ませてやってもいいと。やり合いになっちゃお互いのメンツもかかってくることだし、色々と収拾つかねぇだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "伝えといたって、本当に乗り込んできたらどうすんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "てめぇ、そりゃ脅しか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "いやそうじゃねぇって……はぁ、もういいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "（小声）どうする？　あいつの言うことにも一理あるぜ？　本当にやることになったら数では負けてんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）なんでもっと連れて来なかったんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "（小声）今回は隠密行動だって言ったのはお前じゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）マジで何も吐かないなんて思わねぇだろ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）……まぁいい、こいつを見張っといてくれ。できればブツの場所を訊き出しとけ。もう何人か呼んでくっから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "オホン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "どうだい、「ボス」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "考えてもみなって、今ブツをよこせば無事に帰れるんですぜ？　ヤクザ同士の抗争になってみろ、そんなの誰も得しねぇでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "なぁ、「ブツ」って一体なんのことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "まだシラを切るつもりで？　埠頭でケンカ吹っかけてうちのモンを何人もボコったのは滷水幇でしょうが、あれはまさにブツを奪うため。知らねぇでやったは通用しねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "フン、こんな危ねぇシノギに手ぇ出そうなんて考えるのは、確かにアンタら滷水幇ぐらいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "「危ねぇ」だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "とぼけやがって……アレがどんだけ危ねぇモンかアンタが知らねぇわけねぇでしょう？　近衛局に捕まるリスクを冒してまで俺らのシノギを奪おうなんざ、アンタらも一攫千金を狙ってるんっすよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "……そういや、ここはもう俺とアンタしかいねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "もういいや、メンドくせぇから、ブツの場所を教えてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "おお？　もー、最初っから素直にそうしてりゃ早く済んだのによ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "もうちょっとこっちに寄ってくれ。こっそり教えっから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "はいはい来たぞ、ちゃっちゃと言っちゃってくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "もうちょっと手前だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "ったく、いちいち細けぇな──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "――親父さんの言う通り、時にゃ拳より頭突きの方が効くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "こんなにきつく縛りやがって……悪りぃが、ちょいとナイフを借りるぞ。いつか返すわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "誰から何を取り戻そうとしてんのかさっぱりだが、本当に人違いなんだって。俺ぁボスなんかじゃねぇから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "まったく、言っても聞いてくんねぇし。さ、とっとと出よう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "くっ、頭が痛てぇ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "手紙の通りだとここだな……叉焼幇の連中は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おい見ろ、ナイフを持ってるやつがビルから出てきたぞ。あいつがその叉焼幇の連絡係じゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "待てよ……あいつどっかで見たことねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "思い出した！　水産物屋に偽装した手練な殺し屋だ！　こないだ刺身包丁で二十人も殺したのを見たぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まさか叉焼幇の人間だったとは、マズいな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "焦るな、とりあえず話を聞いてみよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "誰も追ってこないな、これで大丈夫か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "はぁ……正月早々、店もまだ畳んでねぇのに、何て目に合うんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おい、そこのお前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "あ？　俺か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ここは叉焼幇のシマか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "（さっきのやつら、叉焼幇とか言ってたな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ああそうだ、ここは叉焼幇の縄張りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な滷水幇",
      "text": "捕まえろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な滷水幇",
      "text": "うちのボスはどこだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "知るかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な滷水幇",
      "text": "フン、叉焼幇め、頭数そろってるからって、俺たち滷水幇をナメてんじゃねーぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "だから人違いだって──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激怒した滷水幇",
      "text": "いきなり二番手の兄貴を倒すとは、さすがチャーシューピカイチの殺し屋だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "またとんでもない二つ名が出てきたぞ、おい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激怒した滷水幇",
      "text": "イモ引くんじゃねぇぞ！　こんだけの人数だ、負けるわけがねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激怒した滷水幇",
      "text": "ついて来いてめぇら！　ボスを助け出すんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "うわ……こりゃ逃げた方がいいな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激怒した滷水幇",
      "text": "逃がすな！　追え！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "へえ、本当に増援を呼んで来るとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "てめぇら、やるぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激怒した滷水幇",
      "text": "ほう、待ち伏せか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激怒した滷水幇",
      "text": "ビビるな、かかれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "ブツをよこせ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激怒した滷水幇",
      "text": "ボスを返せ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ちょっ、どうなってんだ？　話せばわかるって、ケンカすんなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "はぁ……とりあえず戻って店を畳んどこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "にしても、「ブツ」って一体なんなんだ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "王（ワン）のおじさん、どうもこんばんは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "おう、ジェイ坊じゃねぇか。どうした？　こんな時間にゃ新鮮な鱗獣はねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "違うんスよ、おじさんにちょいと訊きたいことがありやしてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ここんとこ、誰か埠頭でケンカとかしてやせんでした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "ケンカぁ？　この埠頭でケンカしてる奴ぁ、鱗獣を買いに来る人よりも断然多いんだ、いちいち覚えてられっかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "いや普通のチンピラのケンカじゃなくて、こう……見た目からしてヤバそうな、二つのグループの奴らがドンパチ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "うーん、それもちょっとフワッとしてんな……とにかくおじさん、最近埠頭付近で知らねぇ顔を見やせんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "おいおい、だからいちいち覚えられねぇっつってんだよ。この広い埠頭で、毎日何人が行き来してると思ってやがんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "……いや、でも言われてみれば見たかもしんねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "確か先月、何日か連続で、夕方になると箱に入ったものを埠頭まで運んでくる奴らがいたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "普通の荷物だったら別に気にも留めねぇんだがよ、その箱は全部黒い布できっちり包まれてて、なんか妙だなぁって思ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "そいつらの顔を覚えてやすか？　箱はどこ行きのもので？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "あんときゃ店じまいしてる最中だったからあんまり覚えてねぇな。誰もかれもおめぇさんみたく記憶力がいいわけじゃねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "（おそらく叉焼幇が言ってたブツってのはそれだな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "（一体何を企んでやがんだ……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "おっと、いま気づいたが、その顔どうした？　またケンカか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "ほれ、氷でも当てとけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "すいやせん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "おめぇ、大人しそうに見えんのに、なんでいつも傷だらけなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "はぁ……そりゃ俺が訊きてぇっすよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "長年の付き合いだ、おめぇのことはよく分かってる。人がいいし、性格もまっすぐで、理不尽を見過ごせねぇからいつもあのチンピラどもと喧嘩沙汰になるんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "いや、おじさん、そいつぁ全部誤解で──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン",
      "text": "正義の味方もかまわねぇが、自分のことはちゃんと守れよ。ここいらはどうせ始末付けてくれる人らがいるんだし、任せればいいさ。世の中にゃ首を突っ込まねぇ方がいいことだってある、分かるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ああ、ありがとうおじさん。だが、今夜はどうしてもやんなくちゃならねぇことがありやして……それに、どうやるべきかもわかった気がしやす……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "そうだ、電話を貸してもらえやせんか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "叉焼幇め、やるじゃねぇか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "他の連中も……足が早ぇな。どこ行きやがった……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こいつはいい、逃げ遅れがいるみてぇで助かったぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "お、お前は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ああ、俺だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "「チャーシューピカイチの殺し屋」だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "ひぃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "い、命だけは……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "さっきまでのこたぁ、とりあえず忘れてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "だがよーく聞くんだな。これから質問をするが一度しか言わねぇ。そいつにちゃんと答えられなきゃ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "分かってるよなぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "言います！　知ってることなら必ず言います！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "先週、滷水幇が俺らから奪ったブツは今どこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "分かりません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "滷水幇は何の目的で俺らからブツを奪ったんだ？　誰かに売るつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "分かりません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "とぼけてんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "本当に知らないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "お、俺は組織に入ってまだ二ヶ月……機密情報とか、本当に何も知らないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "じゃあ知ってることを吐け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "せ、先週のことですが、埠頭でうちの人間が叉焼幇から何かを奪ったみたいで、ボスは大喜びだったんです。けど数日も経たないうちにボスは失踪しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "うちは大勢を使って探してるけど、まったく見つからなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "（滷水幇のボスが行方不明なのは本当だったんだな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "それで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "そ、それで、今日叉焼幇から手紙が届いたみたいなんですが……よくわからないまま、ケンカだと思って他のやつについてここまで来ました。他は何も知りません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "（うーん……確かにこれ以上聞き出せそうにねぇな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "おい、てめぇらのボスは今叉焼幇が預かってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "だからてめぇらのボスに……違った、いま組織を仕切ってるやつにこう言え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "もう一度だけ示談のチャンスをやる。今夜零時に、叉焼幇から奪ったブツを持って、埠頭で待ってろってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "てめぇら滷水幇の誠意が見えねぇ場合、ボスの命もねぇって思え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケガした滷水幇",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "信じたみてぇだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "悪役ってのは、難しいモンだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "落ち着いて落ち着いて……次は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "クズが！　この役立たずめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "せっかく捕まえたのにみすみす逃しやがって！　人質がいなけりゃどうやって滷水幇と取引するってんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "お前が言うな！　あれだけの数連れて来といて捕まえられなかったくせに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "てめぇ──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "俺に用があると聞いたから、来てやったぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "叉焼幇たち",
      "text": "お前は！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ああ、そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "フン、俺の正体に気付くとはなかなかいい目をしてやがる。褒めてやるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "その通り、この俺が滷水幇のボスだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "やっぱり……な、何をするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "簡単さ、滷水幇が叉焼幇から奪ったブツは全部返す。その代わり、叉焼幇が俺を拉致したことについてのケジメはつけてもらう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "今夜零時、滷水幇は奪ったブツをすべて用意して埠頭で待つ。お前ら叉焼幇は、構成員全員で来てもらおうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "返すべきものは返す。だが、潰れた面子も取り戻させてもらうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "（小声）どうする？　ブツを取りに行くか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "（小声）ま、待て……今はあいつ一人だ、一度は襲えたんだし、うまくいけば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "余計な真似はさせないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "あ、あの女は……例のフェリーンの殺し屋だ！　本人だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "フン、さっきは油断して不意打ちを食らったが、二度目も成功すると思ってんのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "どうやら自分たちが誰を相手にしてんのか、まだわかってねぇようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ゴホン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "（小声）次は何するんでしたっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "（小声）壁だ、壁！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "（小声）あっ、そうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ていっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "壁を……一撃で打ち破った！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "二時間後、埠頭にて待つ。そん時に叉焼幇のモンがそろっていない場合……あとでどうなるか覚悟するこったな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い叉焼幇",
      "text": "どうする……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強面な叉焼幇",
      "text": "どうもこうも、どうせ逃げられねぇんだ、行くしかねぇだろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "待って待って待って、なんでそんなに走るんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "あとそろそろ聞かせてくださいよ、なんだったんです？　さっきの小芝居は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ふぅ……ここならもう大丈夫か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "まぁ、正直俺もどういうことなのかよくわかっちゃいねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "とにかく助かった、今度鱗獣団子をおごらせてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "いいですよ、この程度ならお安い御用ですし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "でもさっきのジェイさんは、本当にヤクザのドンみたいでしたよ……一瞬リアルにそうなのかと思ってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "そんなに悪者に見えるってか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "実は、本当に裏の職業があるんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "からかわねぇでくんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "はぁ、そろそろ埠頭に行くとするか。零時になりゃ、すべてがわかるはずだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "叉焼幇",
      "text": "よぉ、時間ぴったりじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滷水幇",
      "text": "ふん、そっちもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叉焼幇",
      "text": "ブツは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滷水幇",
      "text": "俺らのボスは？　ブツはその後だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叉焼幇",
      "text": "ふざけんじゃねぇぞ、いつまでバカにするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叉焼幇",
      "text": "黙ってブツをよこせや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滷水幇",
      "text": "言ったろ、先にうちのボスと合わせろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叉焼幇",
      "text": "ナメやがって、やんのかテメェ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "滷水幇",
      "text": "やってやんよ、ビビってんじゃねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そこまでだ、武器を捨てろ。詳細は局でゆっくり聞くとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "叉焼幇＆滷水幇",
      "text": "クソッ、やられた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "全員、ご同行願おうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "通報したのはあなたですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ええ、俺っす……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "どうして今夜、埠頭で取引があることを知ってるんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ええと、説明するのは非常に難しいんですが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "俺もまだいろいろと分かってねぇような気がしやすが、大体のことはこんな感じです……信じてくれやせんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ、そんなに硬くならなくても大丈夫ですよ。実はこの件については近衛局も前から探りを入れていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ここだけの話ですが……実はあの動乱の後、大量の武器が龍門の街のあちこちに取り残されていました。近衛局は回収に尽力しましたが、それでも一部は叉焼幇の者たちに拾われてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "た、大変じゃないっすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ええ、まぁ……でもさすがの彼らも、武器をそのまま密売するほどの度胸はなかったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼らは武器に付いているまだ使えそうな源石装置を取り外して売りさばくつもりでした。当然それも違法です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "数日前、近衛局は滷水幇の頭領の身柄を拘束しました。当時、彼は叉焼幇から奪った源石装置の買い手を探している最中でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ところが彼は口が固く、我々もなかなか情報を引き出せなかった。今夜一網打尽にできたのはあなたのおかげですよ。しかしよくこんなやり方を思いつきましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ですが、次からはこんな危険な真似はしないでくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "そういうことだったのか、ようやく合点がいきやした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ホシグマさん、他に何もなけりゃ、もう行ってもいいっすかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ちょっと待ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "実は……あなたのことは前から目をつけていたんですよ。これほどの能力を持つ者を、龍門でただの行商人にしておくのは実にもったいないと思いましてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もっといい仕事があるのですが、考えてみませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "あの……ありがとうございやす、ホシグマさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ですが、龍門にはアンタのような警官も必要なら、俺みたいな水産物屋も必要だと思いやす。もったいないってこたぁねぇでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "えーと、うまく言えねぇが今のままでも別に悪かねぇっつーか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ、わかりました。もちろん、あなたの考えは尊重しますよ。ただ、もしそのうち気が変わったのなら、いつでも小官のところに来てくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "ご迷惑をおかけしやした。では帰りますんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あっ、そうだ……近衛局の正月休みが明けたら、表彰状を受け取りに来てください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "へい、そのうち行きやす。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "さすが董のところの若い衆じゃ。ワシの目にも狂いはなかったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数ヶ月後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ねぇ、あそこの鱗獣団子スープの屋台、知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "へぇ、人気ありそうじゃん、食べてみる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おっと、あれはただの屋台じゃないぞ？　あの店主の正体は、なななんと、龍門埠頭を張ってる大親分さ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "大晦日の夜、たった一人で、叉焼幇と滷水幇の二百人以上を相手にして、全員ぶっ倒したんだ！　しかも──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "しーっ！　声が大きい、聞こえてるみたいだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェイ",
      "text": "そこのお客さん、鱗獣団子スープはいかが？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
