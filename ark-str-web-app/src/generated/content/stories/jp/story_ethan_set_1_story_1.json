{
  "server": "jp",
  "storyId": "story_ethan_set_1_story_1",
  "groupId": "story_ethan_set_1",
  "stageId": null,
  "title": "異郷の旧友",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_ethan_1_1.txt",
  "sourceHash": "55694ff25f07df6147fae5956c393e8790854ab9035f67357a10f862d11b623d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 伊桑"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "おっ、来ましたか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "待たせちまって悪いな、鬼の姉御。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こちらにはいつ着いたんですか？　昨日？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ああ……トランスポーターの車隊と一緒に来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ロドスのトランスポーターからは先月出発したと聞いていましたが……ずいぶん遅かったですね。何か問題でもありましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "来る途中でちょっと面倒事に巻き込まれてな、感染生物に遭遇したんだよ。だがツキに見放されたってほどじゃなかったわな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そういうことでしたか。無事ならよかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それで、あなたが遠くからわざわざやってきたのは、この資料のためでしたね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こちらがあなたが探している人物のはずです。どうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大柄な警官は小柄なサヴラに分厚い書類を渡した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "おう、サンキュー。どれどれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "確かに、この人ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……そうだ、間違いねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "これまでに随分と探してたようですね。リー探偵事務所にも依頼したと聞いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼は、あなたとどのようなご関係で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "昔からの仲の良い友達だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もう一度確認しますが、本当に彼で間違いないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "鬼の姉御よ、そう何回も聞かなくてもこの程度のこと、間違えるわけねーだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あなたは、問題の深刻さにまだ気付いていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もし彼が本当にあなたの言う「ケヴィン」という人物だとしたら、どれだけの面倒事が絡んでるか、わかっているのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "わかってるよ、わかってるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はぁ、チェン……さんは本当に厄介事ばかり寄越す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "龍門におけるロドスの立場は非常に微妙です。あなたが今探しているその人物、彼の事情もかなり複雑です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "名目上は民間事務所が取り扱っていますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "万が一のことがあった場合、私がほとんどの責任を負わなければなりません。わかっていただけますね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "何回も念押しされなくてもわかってるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "鬼の姉御よぉ、今回は俺の個人的な依頼で、ロドスとはなんの関係もねぇから安心してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ジン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "はい、ホシグマ督察。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こちらはジン警官です、彼があなたを案内します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "よお、ジン警官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "（うなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "何かあったらすぐに私に連絡するように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ありがとよ。面倒かけて悪いな、鬼の姉御。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "くれぐれも慎重に、面倒は起こさないでください。あちらに長居もしないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "はいはい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "ホシグマ督察に伺いました、あなたはロドスの情報提供者だそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "そんなことになってんのか……まあ、それでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "そういえば、チェンさんは最近どうされていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "あっ、言えないならいいですよ。ただ聞いてみただけですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "いやぁ、俺もチェンさんと親しいわけじゃないんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ただ、忙しくしてるのは知ってるし、誰かと組んでもうまくやってるみたいだし、問題はないんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "そうですか。ならよかったです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "着きました。ここです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "小柄なサヴラが市街区を見渡す。\n襲撃と戦いの痕跡は依然としてこの市街区に残っていた。砲火を浴びた建物は修復されている最中のようで、継ぎ目の色が妙に鮮やかだった。損壊した路面を覆うセメントはまだ乾いていない。\n早朝の街道は相も変わらず騒々しく、スラム街の住民が背の低いビルの群れの間を行き交って、店先の物売りの声と、道端の工事の音とが波のように鳴り響いている。\nこの街は、今まさに復興している。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "炎国の公用語か龍門の方言は話せますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "少しだけなら話せる。勉強したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "中に入る前に二つ、注意しておくことがあります。一つ目、中ではなるべく口を閉じて、私の指示通りに行動してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "ここの住人は、よそ者に対して友好的とは言えませんので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "二つ目、勝手にどこかへ行ったり、路地に入らないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "一部の路面はまだ修繕中で、半壊していて取り壊すしかないような建物もあります。解体が間に合っていないので危険な状態で放置されています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "肝に銘じとくよジン警官、安心してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "三龍門幣！　一本たったの三龍門幣だよ！　よーく冷えたサイダーだよ！　龍門でこれ以上安いサイダーはないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "運搬人",
      "text": "ハイ、一本くれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "はいよ、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "彼です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "サイダー売りのハイ。少なくとも今、ここの者は彼をそう呼んでいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……サイダー売りか、あいつが客商売できるとは知らなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "私は通りの入り口で待ってます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "通信機を渡しておきます。何かあれば使ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "高価な物ですから、壊さないようにお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "いらねぇよ。あいつとは付き合いが長いし……そこまでのことにはならねぇって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "用心に越したことはありません。ちゃんと持っていてください。くれぐれも慎重にお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "まもなく安魂祭ですので、今の時期は警察の業務が山積みで、ほとんどの者がそちらにかかりきっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "あなたはこの辺りに詳しくないでしょう？　それに感染者地区の状況は非常に複雑です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "もし本当に問題が起きた場合、周囲の警察の助けはおそらく間に合いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "わかったわかった。俺からは何も起こさないって約束するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "……はぁ……とにかくお気を付けて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "冷えたサイダーだよ！　一本三龍門幣……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……よお。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "繁盛してるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "……お前か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ああ俺だ。またあんたと会えるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "ついに来たのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイダー売り",
      "text": "この日が来るとは思っていた。こんなに早いのは予想外だけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あんたのその反応は……少し予想外だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "久しぶりだな、ケヴィン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あんたがチェルノボーグに行ってから、俺たち少なくとも三年会ってなかったよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "これまでに何があったかは聞かねぇけどよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "見たところ、うまくやってるみたいじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……ぼちぼちな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "そりゃよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "おい何か言えよ。気まずいじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺たちの仲はそこまで悪くはなかったはずだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……俺に遺言はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "なんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "散歩中の老人",
      "text": "ゴホンゴホンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "散歩中の老人",
      "text": "お邪魔かのう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……あっ、大丈夫ですよ。リンさん、おはようございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リンさん？",
      "text": "いやはや、喉が渇いてのう、サイダーを一本もらおうかのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "どうぞ。三龍門幣、いただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リンさん？",
      "text": "年をとると足腰が弱くなってのう。ここで少し休ませてもらってもよいかのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "大丈夫ですよ、どうぞお座りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "プッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "なんだ。何を笑ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "なんでもねぇよ。あんたのそんな姿は想像すらしたことなかったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "前に一緒にゴミ拾いしてた頃は、あんた毎日流れ者たちとケンカしてたろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "こんなに穏やかな奴じゃなかったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "それで？　お前はそいつをネタにして、こんな時まで俺をからかおうってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "いや、そんなつもりはねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "この小屋、あんたこんなところに住んでんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "ここは龍門のスラム街だ、ほとんどがこんな感じだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "居場所もなくさまよってた頃と比べりゃ、少なくとも雨風をしのげる家だよ、十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あぁ、確かにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "身を落ち着かせることのできる場所があるってのは、俺たちみたいな奴にとっちゃそれだけでありがたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あのさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あんた一人だけか？　他の奴は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あの後、何が起きた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……まだ気にしてたのか。本当に知りたいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "他の奴は……あいつらはあの後どうなった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "みんな死んだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "おかしいか？　感染者は最後にはみんな死ぬ、それは変わらないだろうが。戦場で死ぬか、人目のつかない隅っこで死ぬかの違いだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "もっと知りたいのなら教えてやる。あいつらのほとんどが無様に死んでいった。これで満足か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "もう話は終わったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……手を下すにしても、ここではやめてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "手を下す？　何の話だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "ここの奴らの暮らしは、楽じゃねぇんだ。もしお前がここで俺を殺せば、近衛局がまた通りを封鎖して、この辺の住人にも迷惑だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あんたが何を言ってるのかよくわからねぇんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "俺を殺しに来たんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "違う。待てよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "どうして俺があんたを殺す必要があるんだよ。何を言ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "そんな態度はやめろ……わかってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "お前はレユニオンを去り、どこかへ行った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "お前のそのご立派な服を見れば、きっとどこか身を寄せるのに良いとこを見つけたってわかるさ。違うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "こんなご時世だ。感染者がまともな生活を送れる機会なんてめったにないこった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "だけどよ、お前がそうしたまともな生活を維持するためには、一つだけ問題があるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "それが、俺たちだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "俺は、お前の過去を知っている。お前が、以前はレユニオンの一員であったことをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "もし俺が死ねば、お前がかつて、極悪非道な悪党の仲間だったと知る者がいなくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "（沈黙）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "こんな日が来るんじゃないかと思ってたさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "言っちまえば、三年前にレユニオンを去るつもりだってお前の口から聞いた時に、すでにこの日が来ると予想はしてたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "どうせ感染者の命は長くない。あいつらはみんな死んだ。俺だけがこんなふうに平穏に生きてられるとは思っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "（沈黙）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "どうした？　なぜ何も言わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……一年前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "一年前、レユニオンの一部の奴らが龍門に留まったと聞いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "そしてこの一年、俺は有り金をはたいて、至る所を聞き回った。あんたたちを探すためにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あんたたちが無事に生き延びていることを願った。何とか耐え切ってくれてることをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "どうやら俺の祈りは無駄だったみてぇだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "待て。お前は……本当に俺を殺しに来たんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "そんなの……ありえねぇだろうがよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ここ数年あんたに何があったのかは知らねぇ。だがあんたはずっと俺にとっての兄貴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "カジミエーシュじゃメシがなくて、あんたは缶詰をくすねてきて俺たちに分けてくれた。その結果あんたはボコボコにされたっけな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ボーンヤードじゃ、あんたはパッキーを連れてならず者たちとやり合った。そのおかげで俺は命拾いした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺はあんたに感謝してる。もしあんたたちがいなければ、俺はとっくに荒野でのたれ死んでいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "それが、俺があんたのところに来た理由だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "でも今は後悔してるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺は来るべきじゃなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "そういうことだ。あんたはまだ生きてる……それで十分だ。俺も安心した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "これをやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "これは何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "鉱石病の抑制剤だ。これが説明書だから、書いてある通りに飲めばいいからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "どういうことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺はもう行く。元気でな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "待て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "待ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "悪かった……俺の勘違いだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "俺がいけなかった、許してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "本当にわざとじゃないんだ、俺はただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "ここ数年に色々あったから、疑心暗鬼になり過ぎてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの客",
      "text": "ハイ、サイダーを一本くれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "はいよ！　三龍門幣、確かに！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ケヴィンはボロボロの工業用手袋型アーツユニットをはめ、後ろの小屋から薄黄色のサイダーを数本取り出す。ガラス瓶を両手でしっかりと握ると、瞬く間に瓶の表面に霜が浮かび上がった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……あんた、いつの間にそんなアーツを覚えたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "あの時、北から来た戦士たちを覚えているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……スノーデビルのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "お前が去ってから、俺は他の奴らと空挺兵小隊に編入された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "長い間、俺たちはスノーデビルと一緒に行動してた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "これは彼らが教えてくれた。俺にはアーツの才能がなくてな……せいぜいサイダーを冷やすのがやっとだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "みんな良い人だったよ、フロストノヴァの姐さんも良い人だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "だがその後、みんな死んじまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "なら、他の奴らは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "パッキーは龍門に来る途中で死んだ。鉱石病の病状はあいつが一番深刻だったからな。お前も知ってただろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "ワルツは……他の奴をかばって、龍門の部隊にやられた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "俺が生きてるのは、ただ運が良かったってだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "俺のジェットパックが途中で制御不能になってな。市街地でドンパチやってる時、ゴミの回収口の中に落っこちてたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "目が覚めて気が付いた時には、戦争はもう終わっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "一番皮肉なのは、龍門スラム街の流れ者が俺を救ったってことだ。そいつにゴミ溜の中から掘り出されて、俺は命拾いした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの女の子",
      "text": "ハイのお兄さん！　サイダー一本ちょうだい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "おう、三龍門幣だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ケヴィンは後ろを向き、また数本のサイダーを取り出した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "ここの人を見てみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "彼らはみんな普通の人だ。ここにも感染者はいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "彼らにはみんな自分の生活がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "でもあの頃は、そんなことを考えもしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "武器を手にしていた頃は、俺は感染者のために戦っているのだと本気で信じていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "今思えば、俺は多分、武器を持って荒らし回って略奪する暴徒の一人でしかなかったんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "最終的に、自分がここ数年一体何をやっていたのか、自分でもわからないありさまだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "今思えば、お前はすべてをわかってたみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺だってわかってたわけじゃねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺はな、高い志を持った奴でもなんでもねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺にとっちゃ、腹いっぱいメシが食えて、住む場所がある。そんな生活がありゃ十分だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "だが他人の家に押し入り、住人を引っ張り出し、殴り、傷つける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "たとえ俺が感染者であろうと、生活のためであろうと、そんなのは受け入れられねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "俺はそれらしい道理を人に言えはしないけどよ、そんなのは絶対に間違ってるとは思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "だから俺はレユニオンを去った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "だがさっきも言ったように、あんたはまだ生きてる。これで良かったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "そろそろ戻らないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "もう行くのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ああ……実は俺も仕事の合間に抜け出してきたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "お前がくれたこの薬……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "この薬は……いくらするんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あんたが気にすることじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "市販の薬じゃねぇんだ。あんた一人で飲めばそれでいい、他の誰にも知られるなよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "おい……ちょっと待って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "ほら、サイダー何本か持ってけよ。俺が自分で作ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ありがとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "もう会えないかもしれないからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケヴィン",
      "text": "達者でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……あんたもな、元気でいろよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "こんなに早く出てくるなんて……用は済んだんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "まあな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "そうですか、何か問題がありましたら督察にお話しください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "よお、ジン警官ではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "……おはようございます、リンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "朝早くからお勤めとは、ご苦労じゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ほう、お主は先ほどハイを訪ねておったあの若者ではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "ああ、そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "何があったかは知らぬが、ハイはいい子じゃて。あまり困らせるでないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "まあそんなところじゃ。取り込み中にすまんのう、ワシはもう退散するわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "……リンさん、お気を付けて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あのじいさんは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "聞く必要はありません、行きましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "小柄なサヴラは最後にもう一度振り返ってこの街を見た。\n戦争と衝突が街に残した傷痕は、人々の営みの中に埋もれ、幾重にも覆われて、その色を薄くしていく。\n時が流れるにつれ、傷痕もやがては龍門の一部となる。今はるか遠くにある歴史と同じように。\n破壊を経たこの街で、人々は懸命に生きている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "終わりましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "終わったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "大丈夫さ。あいつはもうレユニオンとは何の関係もないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "レユニオンのケヴィンはもういない。今のあいつはサイダー売りのハイだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "わかりました。余計なことには関わらない方が賢明ですし、この件はこれでおしまいにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ジン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "はい、ホシグマ督察。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "この件を片付けろ。報告書は任せる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "つまりこの件の……結論は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ただの普通の感染者だった。特殊事項は何もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "他に残しておく資料はありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "必要ない。余計な問題は起こさないようにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジン警官",
      "text": "……わかりました、そのように処理します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それとこれを、ご自分でお持ちください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あなたに対する調査報告です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "いや、まあそうだろうとは思っていたけどよ……近衛局は俺のこともやっぱり調査してたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こう見えて小官も龍門近衛局の督察ですから、不安要素を潰しておくのも仕事ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "平和はそう簡単に手に入るものではありませんし、こういったことはしっかりと調査する必要があります。手間で安全が買えるなら安いものですから。たとえロドスが相手でもそれは同じです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ですが今のは、私個人の行動で得た情報にすぎず、近衛局の活動とは何の関係もありません。この報告書の内容は存在していないものと見なしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼は龍門市民のハイ、あなたはロドスのオペレーターのイーサン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "これでいいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……ありがとよ、鬼の姉御。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もうひとつ、その呼び方はやめてください。あなたとつるんだ覚えはありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "おっと、それはすまなかったな。ありがとよ、ホシグマ警官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "いや違った、督察。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そうだ、ロドスに戻る手立てはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "来週、事務所の車隊について帰るつもりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そうですか。なら送る必要はないですね。ドクターとチェンさんによろしくお伝えください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "半月後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "（ここに置いとくか。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミッドナイト",
      "text": "うん？　これは……サイダー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミッドナイト",
      "text": "今日のメニューにサイダーが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "あぁ、それは俺が持ってきたんだ。遠慮なく持っていってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミッドナイト",
      "text": "こいつはいい。じゃあいただくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スポット",
      "text": "遠慮するなと言われたからって、本当に遠慮しない奴がいるか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "大丈夫だ。それは俺の友達がくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "普通の友達がくれた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーサン",
      "text": "……ただのサイダーなんだけどよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
