{
  "server": "jp",
  "storyId": "act9d0_level_act9d0_st01",
  "groupId": "act9d0",
  "stageId": "act9d0_st01",
  "title": "生存",
  "storyCode": "DM-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act9d0/level_act9d0_st01.txt",
  "sourceHash": "f743a64962f4598c050afdb2296ba9ead3cd87d53b8be60fb75c38cec804524f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "このまま進むつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "治療しないと、間違いなく感染するわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "――魔族の話なんて信じるもんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "魔族……魔族ねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "周りが「魔族」だらけだから、その呼び方自体忘れかけてたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "クソッ、ついてくるなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "十分離れてるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "殺したいなら今すぐ殺せばいいだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ル、ルブレフ君、あまりあの人を刺激しないほうがいいよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……ああもう！　わかったよ。行くぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あんな奴、気にするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ご、ごめん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "魔族と関わるより、病気になるほうがマシなんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ふーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そう言えば、この近くに廃病院があるわよ。チェルノボーグの地区病院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どこにあるか、教えてあげましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ルブレフ君……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "無視しろ、俺たちを騙そうとしてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……あいつを撒こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あの街道が見えるか？　そこの角から走っていって、一分以内に逃げ込むぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "――よし、走れ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "へえ、なかなか速いじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あ、あいつはなんでこんな早く追いついて来るんだ――うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ルブレフ君……足が！　血、血が黒くなってる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "クソッ、お前を助けてなけりゃ、あんな奴簡単に撒けるのに……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ごめんね、ごめんね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "もういい！　静かにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "隠れるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "この先の道を左に曲がると、廃墟になった広場があるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "広場の西側に見える、一番大きな白い建物が病院よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "打ち捨てられた病院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "……僕たち、見つかってるみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "お前が言うこと聞かないからだろ――もういいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "おい、魔族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……なんで俺たちにそんなこと教えるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ただの気まぐれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたたち、どんな関係？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……食べ物を探してたら、こいつを見つけたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ルブレフ君は、僕を助けてくれた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "へぇ……だからその子の言うことを聞いてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そしたら今度は、あんたが恩人を助ける番じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "こいつに何をさせるつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ルブレフ君……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "別に何もさせないわよ。ただ、この先のそう遠くないところに病院があるなあっていうだけで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "レユニオンは医療物資をただ放置しておくほど馬鹿じゃないわ。だから、もしあんたがそのルブレフ君を助けたいなら……奪うしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あそこは暴徒と化した感染者で溢れてる。あんたらの家族や親戚、友達を殺した奴らよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど、鉱石病の初期症状を抑える薬があるのはあそこだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "奪うのが無理なら、盗んでもいいと思うけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あそこにいる人が手を貸してくれるなんて、甘いことは考えないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "行くなよ！　こいつの言うことなんて聞かなくていい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "で、でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――行くな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ルブレフ、この子はあんたの名前を知ってるみたいだけど、あんたはこの子の名前を知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "そんなこと、お前に関係ないだろ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "おい、絶対に行くな！　お前には無理だ！　あそこはみんな――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "僕は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "僕は……やってみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ルブレフ君以外にも、天災で怪我をした人はたくさんいる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "みんな痛い思いをしてるんだ……だから、僕が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "クソッ、こんな悪魔にそそのかされて！　何で俺の言うことを聞かないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "この子に、あんたの言うことを聞く義務なんてないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "みんなを助けたい。いい考えね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "教えてあげる。あの病院の医療物資は、地下倉庫にあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "駐車場の通気口から忍び込んでもいいし、科学廃棄物だらけになってなければ、排水溝を進んでもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もしかしたら、死んじゃうかもしれないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "ほら、足が震えてるじゃないか！　やめとけ！　こんな魔族の言うことなんて聞かないほうがいいんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "さっさと行くぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "待ってよ、ルブレフ君！　僕は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "うわっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "な、何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "龍門で色々あったから……ここにも影響が出てるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "天災が起きて、怪我人が溢れて……今のチェルノボーグでは医療物資は貴重よ。みんな放っておくわけはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "魔族のあたしが、ここの病院についてこんなに詳しいのは……どうしてだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "この――うっ、ああ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "僕は……僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――あの子、苦しそうね。このままの勢いで悪化すれば、いずれ薬も効かなくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もしあんたが今、決断しないんだったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "二人とも、ここで死ねばいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "おい、お、お前、何するつもりだ！　近づくな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "行かないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ああ……でも今から行っても遅いかもね。もう暴動が起こってるみたいだし、盗み出すのもきっとかなり難しくなった――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "で、でも……ぼ、僕は行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――へぇ……死ぬわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "な、なんでそいつの言うことを聞くんだ、せっかく俺が助けてやったのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "で、でも……僕は、やってみたいんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "そんなこと……お前にできるわけないだろ！　大丈夫、このまま薬局と食べ物を探して歩いてれば、きっとどうにかなる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "でも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ごめん……ごめんね！　ルブレフ君！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "おい……おい！　待てよ！　行くな！　おい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あの子の名前すら知らないあんたが、止められるわけないのよ。可哀想に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "お前……あいつを騙したな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "騙す？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嘘は一つも言ってないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もちろん、信じる信じないはあんた次第だけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あの子を信じるかどうかも、あんた次第よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……クソッ、俺が、あいつを止めに行く、うぐ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どうして？　あの子を信じられないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あ、あいつは、俺がいなきゃ何にもできないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あの子が逃げないか心配してるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたはこう考えてるんでしょ……あいつはどうして俺をこんな魔族のところに残していったんだ、俺が殺されてもいいのかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "デタラメ言うな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "*ウルサススラング*！　この化物め――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――黙って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……ここで一歩も動かず、あの子を待ちなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そうじゃなきゃ、今すぐにでも殺すわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "うう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたは知らないだろうけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしは殺人鬼よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "この街を破壊し、あんたの両親や友達を傷つけた殺人鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……ああ、アハハ、そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたはまだその刀を持ってるんだったわね。その血に染まった柄の装飾は、サルカズのものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "血は、誰のだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "う……うう、し、知らない……お前はあいつを……クソッ、こっち見るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……泣けばいいわ。子供は泣くものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "これからの生死は……あんたたち次第だけどね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あいつには無理だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そうかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "だって、俺が瓦礫の下から掘り出さなかったら、あいつはとっくに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……だからあいつは、俺なしじゃダメなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "誰にも……その人がいないとダメなんて相手はいないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そう、誰にもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "静かになってきたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あの大虐殺以来、抵抗する奴は減ったわ。いい傾向ねぇ。楽ができるし、死人も減る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "病院の方も静かになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あいつは……もしかしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あいつはもしかしたら……行ってないかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "もうこんなに……うう、時間が経ったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そうね、逃げたのかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど、あんたがあの子を助けたんだから、あの子もあんたのために頑張るはずでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それとも、あんたはあの子を救えるけど、あの子はあんたを救えないと思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あいつは……ずっと何をさせてもダメだったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "食べ物を探しに行ったときもそうだ！　あいつは店の中に人がいることにも気づかなかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あいつのせいだ！　あいつのせいで俺の足が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どこに行くつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……一人で帰る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "言ったでしょ、ここを離れたら死ぬって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "でもあいつは逃げたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "へぇ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "その目……あんた、あの子を恨んでるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "ち、違う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "だって、もし……本当に行ってても……こんなに時間が経ってる……きっともう……あいつは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――黙りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あの子が戻るまで、あんたに本当のことはわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あの子が帰って来るって思っててもいいし、帰ってこないって思っててもいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけどあの子じゃ無理だなんて思ったり、恨んだりするのは、あんた自身に問題があるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……あんたはどうして、あの子が失敗するか、逃げるに違いないって決めつけてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたがあの子を助けたから？　あんたの方が上だから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……うう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "うわああ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "まだ泣く元気があるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "安心して、すぐに痛みで泣く余裕すらなくなるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたはまだ小さいしサルカズでもないから、ホントに耐えられなくなったらあたしに言って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "楽にしてあげるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "う……ううん……うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "意識が混濁してきたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あーあ……間に合わないかぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "やめろ……俺はまだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あいつを……待……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "死ぬのが怖いから、あの子を信じることにしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "子供は人の顔色を窺うのが上手ね。そうやってあたしの機嫌をとっても、何にもならないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけどあの子……確かに時間がかかりすぎね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……最後に、もう十分だけ待ってあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "安心して。いくらあたしだって、子供を苦しんで死なせるなんてことはしないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……大人しくなったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……泣く余裕もなくなったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしを恨んでる？　それともあの子を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もしかして、お節介で人を助けて、怪我したことを後悔してる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……して……ない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "まだ喋れるのね。ちょっと感心したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ルブレフ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あの子の……人の行いを決めるのは、何だと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "出身？　立場？　過去？　それとも約束？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……どれも違うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "答えはね、あの子の人生があの子にもたらす影響の全て、変化し続けるあの子自身の信念と考え方よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それと、あの子がどれほど自分を信じてるか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたはあの子を助けた。でも心の奥ではあの子を信じてないし、見下してるでしょ。自分があの子の救世主だなんて思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "でも、あの子はどう？　すごく単純よ。あんたに助けられたから、あんたのことを助けたい、ただそれだけだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "その点で言えば、あの子はあんたより強いわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "刀をしっかり持っておきなさい。それはサルカズの刀だけど、持ち主に代わって、あたしがあんたにプレゼントするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それを使いこなすもよし、売ってお金に換えるもよし、好きにすればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――それだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "お前……何を言って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ル、ルブレフ君！　大丈夫！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "見て！　見て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "医療キットを盗んできた！　痛み止めも、包帯もあるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "えっ、なんで返事しないの？　ルブレフ君、まさか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "うるさい、なぁ……生きてるよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "よかった……！　じゃあ僕、傷口の手当をするね……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "えっと、包帯はどうやって使うんだっけ……これが抑制剤？　あ、開けてみよう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……お前の親、医者じゃないのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "そうだけど……使い方は教わってないよ。でもやってみる……痛っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……怪我、してんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "うん……でも大丈夫、大したことないよ……鉄パイプでちょっと殴られただけだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "全然……ちょっとじゃない……だろ。この、ばかやろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "……ヘヘ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "あの……サルカズは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "あれ……僕が来たときにはいなかったよ……ずっと一緒にいたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ルブレフ君？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……えっと、その……お、お前の名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "えっ？　……アンドレイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "フルネームは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "アンドレイ・フョードロヴィチ・オストロフスキーだよ……へへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "何笑ってんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "やっと聞いてくれたね、ルブレフ君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "……ごめんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "そ、そんなつもりじゃないよ……謝らないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "これでよし。少しは楽になった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "よかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "じゃあ支えるから、一緒に戻ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "みんな、この医療キットを見たら喜ぶよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "あの二人の子供を見ながら、あたしは微笑んでいた。\n不安の種が消えたとき、あの子たちは本当の意味で、この街で……この大地で生きていくことができるようになるだろう。\n生きなさい。生きてこそ、苦しむこともできる。\n炎に向かう虫のように、罠に飛び込む獣のように。\n代価を払ってでも、何かを追い続けなさい。"
    },
