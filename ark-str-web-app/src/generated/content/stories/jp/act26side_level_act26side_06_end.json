{
  "server": "jp",
  "storyId": "act26side_level_act26side_06_end",
  "groupId": "act26side",
  "stageId": "act26side_06",
  "title": "夜半の歌声",
  "storyCode": "HE-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act26side/level_act26side_06_end.txt",
  "sourceHash": "f753817c459bff9fa9d5c6c87c8846ab8f7c80b0ac4ec3db3c1dae3c78ce4a02",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "ライムント、待ってよ……ライムント！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "何をする気なの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "お前をここから連れ出すんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "事情はもう聞いた。お前をあいつらに引き渡すわけにはいかねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "だからお前は怖がらずに俺についてくりゃそれでいいんだ。みんなお前のために──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "え？　私……怖がってなんかいないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "ライムント、何か勘違いしてるって！　とにかく手を放してよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "悪かった！　つい焦りすぎちまって……痛かったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "ううん、大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "聞いてよ、ライムント！　私は……私は自分の意志でラテラーノに行きたいって思ってるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "なんだと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "バカ言うな！　あいつらに脅されてんのか？　あんなとこに行ったらお前は殺されちまうんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "だとしても、それは私が受けるべき報いなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "私のことは気にしないで、ライムント。誰にも無理強いされたり、脅されたりなんてしてないから。フィーナを傷つけた私が、こんな形で逃げ出すなんて許されないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "デルフィナのことは……ありゃあ単なる事故で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "違う！　あなたまで「単なる事故」って言わないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "事故……確かにそう！　フィーナに銃を向けるなんてこと、私がわざとやるはずがないじゃない。あれは事故だった……だけどフィーナは本当に、本当に死んじゃったんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "フィーナはもう二度と目を開けてくれないんだよ。あの子とお話することだって、もう二度とできないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "落ち着け、フォルトゥナ……そんな風に爪を立てるな、自分を傷つけるんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "私だってできることなら落ち着きたいよ……こんな風に泣いたり叫んだりするのも嫌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "だけど、どうして誰も私を責めないの！？　どうしてみんな「あれはただの事故だった」なんて言うの！？　まるでフィーナの死んだことが、「事故」なんて簡単な一言で片付くみたいに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "フィーナは、フィーナは私が殺したんだ！　たとえ事故だとしてもその事実は変わらないでしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "……息が詰まってるぞ、深呼吸してみろ、ほら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "ふぅ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "少しは楽になったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "ごめん、こんなんじゃダメだよね私……でも、どうしたらいいのか分からなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "私に分かるのは……このまま逃げ出して、何も起きなかったように振舞うなんて……あれが単なる事故だったと認めるなんて、絶対にダメだってことだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "これは私の罪だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "もう、それ以上言うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "私のことは心配しないでライムント。もしかしたら、それほどひどい罰にはならないかもしれないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "スプリアさんは……今日ラテラーノからここに来た使者の女の人のことだけど、あの人すごく優しいんだよ。一度もひどいことなんてされなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "でも、ひょっとしたら、ラテラーノに着いた後はどこかに閉じ込められちゃうのかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "この角が生えた今の私が……サンクタと呼べるかどうかは私自身もよく分からないけど、でもそうじゃなかったとしても、私にとって大したことじゃないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "とにかく、私なら大丈夫だから。ライムントは──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "ダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "やっぱそういうわけにはいかねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "フォルトゥナ、このままお前を放っておくなんて俺にはできねぇ──",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ライムント？　どうしたの……\nきゃっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "（小声）静かにしろ！　口を塞ぐんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "（小声）……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "（小声）……誰か来た！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "通信切れちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "あなたがリケーレを寝返らせてたなんてね。どうして気づかなかったんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "別に寝返ったわけじゃねぇよ。あいつは自分に利のあることにしかしないタイプの人間ってだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "自己保身って点に関しては、俺よりあいつの方が一枚上手かも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "なんだか誰かに見られてる気がするんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "なぁに？　あなた、疑り深すぎてついに幻覚でも見るようになったんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "幻覚じゃなく、実際誰かが物陰から盗み聞きしてるってパターンを信じたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ハハッ、そんな目で見んなよ。軽い冗談だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "そういや、お前が見張ってるっつーあの堕天使の女の子はどうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……あの子ならおとなしく眠ってるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "話をそらさないで。本題に戻りましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "計画を早めるって言ってたよね？　可能っちゃ可能だけど、約束と違うじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "どうしていきなり計画変更する気になったの？　理由を教えてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "お前にとっちゃどうでもいいことだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "そうね。だから私には加担しないって選択肢もあるってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……俺の記憶が確かなら、今回の作戦の動員権は俺にあるはずじゃなかったか？　スプリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "私は別に、戻って反省文を書いたって構わないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "なんか焦ってるみたいだけど、一体何があったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "今回の作戦はそもそも隠密作戦でしょ。教皇聖下が聖徒だか何だかの件に気を取られてなければ、部隊を動員するのもこんなに楽にはいかなかったはずだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "それでも教皇聖下は何かをお察しになったのか、フェデリコをわざわざ遣わされた……まったく、彼の目をごまかすのがどれだけ大変か、あなたには分からないはずないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "マジでごまかせてると思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "多分バレてるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "けど私だってフェデリコの性格くらい見抜いてるつもりだよ。深入りさえしてこなければ、特に問題にはならないはず。どのみちこっちの目的は、逃げる奴らを全員食い止めることだけだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "とはいえオレン、あなたが手を出したら、この件はもう隠し切れなくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "フェデリコは手段にこだわらねぇタイプだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "それはどうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "先に言っておくけど、あいつが本気であなたに手を出そうとしてきたら、私じゃ止められないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "同僚だってのに、冷てぇなぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "こんな時に連絡寄越すなんて、どこの誰よ……うっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "誰からだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……自分で見てみれば。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "完全にバレちゃってるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "お前がさっき話した件についてはこっちで対処する。スプリア、今は俺の言う通りに動け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "動かせる部隊を全部こっちへ向かわせるんだ。今すぐ俺たちでこの修道院全体を接収するぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……そこまで急ぐ必要あるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "この修道院と六十年も生死を共にしてきたあのご老人は、サルカズのために独断専行し、ラテラーノの使者を拘留するなんてことまでやってのけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "だが彼は追い詰められた挙句、突然折れて、更には「最後の別れ」なんつー儀式じみたことまで行うつもりらしい……なぜだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "それに、何やら訳ありのサルカズどもに加えて、暗がりに潜んでいる「客人」たちまで動いてる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "こうなると、グズグズしちゃいられねぇだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "嫌な予感がするぜ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "接収……？　どういうこと……？　どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "まだ分かんねぇのか！？　あのサンクタの女はずっと俺たちのことを騙してたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "ジェラルドの旦那に知らせねぇと！　あのラテラーノ人どもめ……最初から何か企んでると思ってたんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "フォルトゥナ、今は俺と一緒にいるとかえって危険だ。どこか安全な場所で待っててくれ。奴らも今すぐにはお前に手を出したりしないはずだ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "待って、ライムント！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "気が変わった。私も一緒に行くよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "奇遇だな、二人とも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "レミュアンさんも、ご無事でよかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "何か収穫はありましたか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "何か気がかりなことがあるみたいね、執行人リケーレ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ちょっと気になる件を追ってましてね。あの司教と関係のあることなんですが、ただ……その、とにかく引き続き調査が必要で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "フェデリコ、お前の方は何をしてるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "仕事です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "えーと、お前が仕事に勤しんでるのはもちろん知ってるんだが……何か見つけたのか？　サルカズと関係のあることか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "例の火事は、不満を持ったサルカズの誰かによる放火だったと聞いてるが、それは確かなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それって新しい芸か何か？　あなたたち、即興劇でもやってるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "冗談はここまでです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "冗談？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "オレンとスプリアが間もなくここへやってきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "あー、その口ぶりだと……オレンがわざと身を隠してたことは最初から知ってたみたいだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "すぐに分かることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "あいつも不運な奴だよ。前の万国サミットの時にお前とやり合ってからいくらも経たない内に、よりによってまたお前と出くわすんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あー……オレンが自分の判断で動いた時は、私も黙認することにしたのよ。アンブロシウス修道院の状況は複雑だし、できるだけ手札は残しておくべきでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "けど今は、少しお灸をすえてやらなきゃって思ってるわ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "誰かさんから早く来いって連絡受けたかと思えば、オレンを連れてこいだなんて。一体どんな緊急事態？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あら？　ようやく素直に姿を見せる気になったのね、オレン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ははっ、久しぶりじゃねぇかレミュアン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "お互い任務達成のために協力する仲間同士じゃねぇか。そう冷たいこと言うなって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "仲間同士じゃなかったら、今頃あなたはここに立って会話することさえできてないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたが何を企んでいようとも……そういった強引なやり方は今の修道院には相応しくないのよ。オレン、あなたはそろそろ手を引くべきだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "はぁ……お前とフェデリコも、ちったぁ横の奴に倣って見ないふりくらいできねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "俺まで巻き込むなよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "リケーレの関与については、当然公証人役場に戻った後で追及することになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "どうも、おかげ様で、オレン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "オレン、あなたに関してですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "もしも単独行動を取る必要があったとあなたが確かに判断したのであれば、弁解をしても構いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……ここには部外者もいねぇから、率直に話すが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "スプリア、お前が子供二人をこっそり逃がそうとしたことに、俺が本気で気づいてねぇとは思ってねぇよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "堕天したサンクタにサルカズの二人組だぞ？　気づかねぇフリをする方が難しいくらいだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "あなたって人は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ぶっちゃけるとな、俺はそういうチンタラしたやり方にはとっくに嫌気がさしてんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "何だか私のやり方を責めてるみたいね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "いやいや、まさか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ただ、俺には俺のやり方があるってことだ。もうずいぶん時間を無駄にしちまってる。だったらなるべく手抜かりがないよう迅速に仕事を片付ける方法を考えて然るべきだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたのやり方とは、独断で特殊部隊を動員することですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "簡単なことみたいに言うなよ。「部隊を動員する」ことと、「作戦命令を下す」のとじゃ訳が違うってことくらい分かってるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "教皇聖下も反対できないような妥当かつ適切な行動理由を見つけるのに、ずいぶん長いこと頭を悩ませたんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "だが今は都合の良いことに、お誂え向きの口実が向こうからやってきたってわけだ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "サルカズの、ライムントとか言ったか？　聖堂を燃やした大罪人があろうことかサルカズときた。俺たちが引き継いで拘留するなり取り調べするなりしようが、やりすぎってことにはならないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "彼は聖堂に放火した犯人ではありませんので、あなたのおっしゃる理由は成立いたしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私が真相を明らかにするまでは、あなたの部隊の介入は不要です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "真相ねぇ。ハッ、何が真相かなんてそんなに重要なことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "俺たちでここを接収し、すべての段取りを上手に整えるってのが、最も効率的かつ合理的なやり方じゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "フェデリコ、お前がそれを考えなかったはずはねぇよな？　まさか本気で真相とやらを優先するつもりなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたがそうすることで、住民たちの反抗を招いてしまうのが怖くはないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "レミュアン、お前がそんな間の抜けたことを言うとはな。サルカズたちが反抗してきたとしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "そっちの方が都合がいいとは思わねぇか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突如静まり返ったホール内に、扉を叩く音がこだました。\nギイ──と耳障りな音がして、扉の開いた隙間から、異様なほどに明るい月の光が静かに差し込んでくる。\nその月明かりの中に、男が一人立っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "フェデリコさん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "クレマンさんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "……ようやく見つけました。フェデリコさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "ある人が、「これ」をあなたに渡してほしいと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "誰に頼まれたのですか？　それは──",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "喉元まで出かかった言葉が、ピタリと止まった。\n光を背に、一つの人影がゆっくりと近づいてくる。背の高い細身の男は、終始深くうつむいていた。\nこの瞬間、ホール内の光がすべて彼一人に集束しているかのように見えた。しかしそのまばゆい輝きは、かえって重苦しく、おぞましい影を男の身体に落としていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼が持っているのが何なのか、フェデリコはようやく確認することができた。\nある人物がクレマンに託したという、「それ」を。\n一本のナイフ。\n古びてはいるものの、その鋭さは失われていない。かつて、ある人物が背中に忍ばせていたもの。\nそしてそのナイフの横には……\n布に包まれた物体があった。下部は赤に染まっている。皆が見つめる前で、そこから真紅の液体が滲み出て、ぽたりと床に落ちた。\n……あれは何だ？\nあれは……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "これは……「罪人」ホルスト・ティフィンダルが自ら差し出した、彼自身の首です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "かの「罪人」は、すべての悪事が自分一人の手によるものであると……あらゆる罪を彼一人が引き受けることを、認めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "今や諸悪の根源は断たれ、残っているのは取るに足らない難民たちの集団だけです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "ラテラーノの使者のみなさん、どうか……どうかこれで情けをかけてはいただけませんか。これ以上の追究を、やめていただけませんか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "フェデリコさん、彼は──ジェラルドは、あなたにこう伝えてほしいと言い残し、旅立っていきました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "どうか、指名手配犯ホルストの首と武器を引き換えに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "フォルトゥナやライムント、そして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "他のサルカズたちのことは、見逃してやってほしいと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
