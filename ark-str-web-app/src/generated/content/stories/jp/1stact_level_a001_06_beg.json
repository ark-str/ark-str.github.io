{
  "server": "jp",
  "storyId": "1stact_level_a001_06_beg",
  "groupId": "1stact",
  "stageId": "a001_06",
  "title": "黄金三角",
  "storyCode": "GT-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/a001/level_a001_06_beg.txt",
  "sourceHash": "bdb7ab2b0972804d2bece4e623ece3f9208cede0a599d895b63c0bfaaa170a5e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "数年前のことだ。我々は感染者となった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "日の目を見ない生活では、平穏な一夜ですら以前では考えられないほど贅沢なものと思えるようになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "そしてはじめは、レユニオンが我々の生活を変えてくれると信じていた。しかし……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "だが結局は何も変わらなかった。我々に夜露を凌がせてくれる宿はもちろん、パンのひとかけらを売ってくれる店すら無かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "だから私は兄弟とも呼べる仲間たちを連れレユニオンを離れ、あてもなく彷徨った。この村の財宝の噂を耳にするまではな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "この財宝を我々が手にできれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "我々はクルビアへ向かうことができる。遥か彼方の地だが、あの場所では感染者も自分の家や田畑を持つことができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "だから、グラニ、私は兄弟たちのためにこの財宝を手に入れなければならんのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "財宝は目の前にある。そうだろう。君はよくやったが、残念ながら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "女！　貴様――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "道を開けなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "うわぁぁぁぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私はあなたが何者か、何をするつもりかも興味はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "だけど目障りよ。すぐに全員私の視界から消えなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "スカジといったか、君と戦うのが必然なら……我々は死を賭して最後まで戦う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "グラニ、こんな人たちとあなたは一緒になにしてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "おじさん、あなたが全て財宝を奪ったら、滴水村はどうなるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "悪いがどうなろうとも、村自体が生きていくことはできるはずだ。しかし我々にはもう生きるための残された道がないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "君とはまだ知り合って浅いが、君がどんな人間かは私なりに分かったつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "君はその隣の怪物とは違う、我々感染者を差別しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "（いや、スカジだって、誰も差別はしないと思うな……そう、むしろあたしもボブおじさんも平等に消しちゃうつもりだ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "グラニ嬢ちゃん、キャロルがどこにいるか教えてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "財宝が我々にとってどんな意味を持つか分かって貰えたはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ボブおじさん、ごめんなさい。あたしはもう約束したの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あたしのやるべきことは、財宝をキャロルに渡し、村に平穏に戻す…これだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "グラニ、キャロルを渡しなさい。それ以外の物はどうでもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "あの子を手に入れて何をするつもりだ、怪物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "皮を剥ぎ、生き血をすすりでもするつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "このお嬢ちゃんの言葉を聞いているだろう？　何があってもキャロルは渡さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "だが私は違う。私に必要なのは財宝だけだ、彼女を傷つけることなどしない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "いい加減、辟易するわ……グラニ、キャロルはどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "なんでこうなるかな……キャロルは村を守りたいだけなのに…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "私たちだって財宝を元手に平穏な生活を手に入れたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたがレユニオンだろうが賞金稼ぎだろうが、どんな理由があるかだってどうでもいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "私とお前たち賞金稼ぎは全く違う！　一緒にするな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "確かに私もかつてはスカジのように色々やってきた、幻想にすがりついて許されないことだってやった。しかし今はもう全て悟ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "我々感染者にとっては、富も名誉も、何もかもが意味をなさない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "だから今、我々に残されているのは、この財宝を糧に感染者でも生きられる場所を目指すことしかないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "だからなに？　グラニ、もう一度言うわ。キャロルを渡して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "二人とも言ってることは結局同じじゃないか。自分たちの欲求だけ押しつけて！　キャロルは誰のものでもないし、財宝はキャロルの村の人たちのもの。どちらも誰にも渡さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "これは私が受けた依頼なの。そしてキャロルとの約束だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "グラニ！　そんな意固地になるな！　私だってこんな無益な戦いはしたくないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "財宝を私に渡してくれれば、誰も苦しまずに済む！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "誤魔化さないで。協力関係を破らなかったら、そもそもボブおじさんの取り分だってあったはずじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "すまない……。私は兄弟たちのために、少しでも多く財宝が欲しいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "戦うつもりなの？　実力の差はもう分かっていると思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "確かにあまり自信はないけど……そんなの、やってみないと分からないでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "なぁ、グラニ嬢ちゃん。私と君との問題は、話し合いで解決できるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "だけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "私と兄弟たちだけでは厳しいが、君だけでもなんとか力を貸してくれれば……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "いつまでお喋りを続けるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "みんな、動かないで！　いまここで戦いを始めたら、もう戻れなくなる。それは絶対にダメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "我々は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "グラニ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "やったわ！　財宝を見つけた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "何とかこの宝箱を引きずってきたの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "ボブさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "無事でよかっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "キャロル、来ちゃダメ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……クッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "はあ……はあ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "我々は……もう戻れないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "キャロル！　おじさん、なんてことを！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "えっ…？　スカジがキャロルを庇った…！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "こんな威力の無い爆弾に何の意味があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "借りを返すだけだ。言ったはずだ、彼女を……傷つけるつもりはないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "だが、私の要求が通らなければ、次は本物を使わせてもらうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ちょっと待って、スカジ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ようやく分かったよ。実は君は財宝には興味ない。そしてキャロルを傷つけるつもりだってないんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "そうじゃなきゃ、爆発する瞬間にキャロルを守ろうとせずに、財宝と一緒に彼女を奪って逃げればいいんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そうよ財宝なんか必要ない。私が欲しいのは彼女が持っているあるものだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "やっぱり！　なんでそれを先に言ってくれないの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "まさかわざと悪役ぶってたの？　最初から目的を正直に話してくれればいいのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "他の人を私の……任務に巻き込みたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "今回の目標は、私にとって本当に重要なものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "言いたい事は分かるけど…。でも内容が違っても、任務の方向性はほぼ同じじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "オペレーターとして目標が同じなら連携して動くのは、ごく当たり前のことだと思うけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "分かった、どうしても話を聞かないなら、本当に武力行使で解決するしかなさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "でもお願いだからおじさんたちの動きを止めるだけね。絶対に殺さないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "グラニ嬢ちゃん、決着をつけようか！　兄弟たち、やるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ボブおじさん、ごめんね…。ちょっと痛いかも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
