{
  "server": "jp",
  "storyId": "main_6_level_main_06-07_end",
  "groupId": "main_6",
  "stageId": "main_06-07",
  "title": "上から跳ぶだけ！",
  "storyCode": "6-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-07_end.txt",
  "sourceHash": "a502bc23a8041dcf4d6cc5160664db57c1ee26240587c288b1cda841e9103e74",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はぁっ、はぁっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ブレイズさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "私は大丈夫！　なかなか……やるじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そっちは氷漬けにされてないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。エリア内の空気を加熱して、あの冷気をせき止められるのはブレイズさんくらいです。そのおかげで私たちは皆無事です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "これぐらい、なんてことないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ねぇ氷使い、どうして致死性のアーツを使わないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホッ、ゴホッ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "なるほどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……フロストノヴァさんの、あの様子は……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ふーん、フロストノヴァって言うんだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホッ……私の……姿を奴らに見せるな……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "姐（あね）さん……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "このスキに行くよ、アーミヤちゃん。途中まだレユニオンが潜んでる可能性もあるから気をつけてね。怪我人はいる？　私が引っ張ってったげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ここで、むざむざ逃がすと思ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "一言忠告しとくよ。もう戦わないほうがいいよ、白ウサギさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それ以上無理してアーツを使えば、死期が早まるだけ。その力は命と引き換えに絞り出してるようなものでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それか、君もロドスに来ればいい。少なくともその命を永らえさせる方法はあるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "この私を……哀れむつもりか？　お前たちの哀れみなど不要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そう？　私が哀れんでるように見える？　君は強いって認めているんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "だがお前たちを逃しはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホッ……ゴホゴホッ……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "Dr.{@nickname}、早く行くよ、あの子に構ってる暇なんてない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "外側からこっちに移動してくるレユニオンもいる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "逃げられると思うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "姐さん、その位置は危険だ！　アレは使うな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "奴らを逃がすわけにはいかない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "このまま逃せば、ロドスが龍門にいる同胞たちに何をするか分かったものではない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "温度差をつくり物体構造に作用させる。脆弱化せよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホッ、ゴホッ……凍結！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……♪……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホッ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "効いてきたか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "我々が埋めた源石の力で下層部の構造体を歪めたんだ、地面が傾き始めているぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "姐さん、その位置は危険だ。早くこっちに掴まってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "姐さん！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……ブレイズ、あなたにも聞こえる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "これは、建物がきしむ音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "埋め込んだ源石で熱を急激に吸収し、温度差を……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "壁にもヒビが……まさか……彼女のアーツはこんな風にも使えるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "これはマズいよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "辺りの地面が変形してる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "レユニオンはこんなこともできるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "わからないけど、でも……このエリアごと沈んでいってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "早く！　変形していない安定した場所まで避難してください、こちらの地面はもう飲み込まれそうです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……ドクター？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ドクターの足元が……ひび割れてます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ヤバい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "Dr.{@nickname}！　こっちに跳んで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "跳ぶ……？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "アーミヤちゃん、行っちゃダメ！　Dr.{@nickname}、まずそこの電柱に掴まって！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクターを助けて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "地面が崩れるのが早すぎる、私のとこからじゃ間に合わない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "それなら私が！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "ダメだって！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "どうして——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……大丈夫だ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "周囲の建物が自重で崩れ始めてる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "メテオリーテ、この子、受け止めて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "分かった、アーミヤを連れて退避する！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "イヤッ、放して！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "アーミヤちゃん、先に行ってて。私がドクターを助けるから！　ロドスオペレーターとしての私の実力を信じて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "ちぇっ、やっぱり血を流すことになるんだね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "ドクター、気流と真空圧で君の落下速度を抑制する、ついでに周りの瓦礫を吹き飛ばすよ。安心して、絶対に潰されないから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "怖がらないで！　怖がらなくていいから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……また後で！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "また後で。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "どうしたの？　フロストノヴァは？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……君たちの指揮官も落ちちゃったんだね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "……ああ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "なぁ、このタイミングで言うのもなんだが、俺たちは戦わなくていいんじゃないか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "ロドスのウサギさんよ、一時休戦とするのはどうだ？　俺たちだって最初はお前たちと戦いたくなかったんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが皆さん……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "姐さんはメフィストからお前がアレックスを殺したって聞いてな。だからお前たちがこれから何をするつもりか心配してたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……アレックス？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "スカルシュレッダーだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ごめんなさい。スカルシュレッダーさんは確かに私が……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "……そうか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "感染者はお互いに敵意を向け合うべきじゃないのに。ごめんなさい……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "謝ることなんてないさ。どうせお前たちはその時、戦いになってたんだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "じゃあ俺たちは一時休戦といこう。ビッグベアー、どうだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "ああ？　*ウルサススラング*！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "ビッグベアーも問題ないと言ってるな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "そうは言ってないように聞こえたが……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "まぁとにかく、今は殺し合う理由なんてないだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "どうしてあなたは……休戦なんて考えたんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "ほら、俺たちとお前たちのリーダー、どっちもウサギだろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "……えっ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "頭の中で何かが音を立てて崩れた気がする。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジェシカ",
          "text": "えっ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "雪原の悪魔と呼ばれた者たちが、まさかそんなことを言うなんて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジェシカ",
          "text": "ど、どういうことですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "氷みたいに冷血無情な奴らだと思っていたからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "なかなか受け入れられないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "……そいつは偏見ってやつさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "ロドスのウサギさんよ、聞いてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "戦いの勝ち負けとか、お前たちの行き先とか、俺たちには全く興味がない。それよりも姐さんの命の方がずっと心配だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "お前たちも今は仲間の安否を案じてる、そうだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……はい。私たちは誰かを傷付けるために廃都市の奥を目指したわけではありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "少なくとも、「レユニオンの感染者狩り」なんて考えてここに来たわけじゃないんだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい、それは絶対にありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "むしろ俺たちの方こそ……「それは絶対にない」なんて断言はできないかもしれないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "パトリオットの大旦那が「レユニオンは団結すべきだ」なんて言い出さなかったら、今すぐにでもメフィストとその小隊を全て始末しに行きたいくらいだからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "もしそうなれば、それも一種の「レユニオン狩り」ってことだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "それは……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スノーデビル隊員",
          "text": "まあいいや。それよりさっさと一緒にここを掘り出そう、どうだ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
