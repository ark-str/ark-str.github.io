{
  "server": "jp",
  "storyId": "story_vigil_set_1_story_1",
  "groupId": "story_vigil_set_1",
  "stageId": null,
  "title": "訪れる未来",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_vigil_1_1.txt",
  "sourceHash": "1a04a3f369a65ee354efe9e7bea624c71634d0d02eb289b393c82524177de84f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "やれやれ、今日の法廷は随分と賑やかだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "一般公開された上でライブ中継までされてるから、野次馬が多いんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "へえ。違うファミリーを代表する陪審員たちがこうもきちんと並んでるのは初めて見たぜ。これじゃ裁判っていうより報道会見だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "ま、今日法廷に立つのは他でもないレオントゥッツォ・ベッローネだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "ミズ・シチリアはマフィア全員に「新都市には介入するな」と命令したが、その意図にまでは言及してない状況だ。お陰で誰もが頭を悩ませ続けてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "そんな時に、ミズ・シチリアの意思を体現する裁判所がようやく動きを見せたとあれば、注目されるのも当然だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "しかし、奴を裁くのはあのラヴィニアだぞ。あいつとベッローネの関係は周知の事実だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "ベッローネはもう除名処分を受けたわけだし、今さら何の関係もないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "むしろ、一刻も早くベッローネとの関係を断って潔白を表明するために、レオントゥッツォの裁判を進んで買って出たんじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "ふむ。ミズ・シチリアがこの街に現れたのは明らかだし、ボスに対するパフォーマンスも兼ねてるのかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "計算高いこった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "さて、どうだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "何にせよ、あの騒ぎの首謀者がベルナルドである以上、その息子が責任を逃れることなんざできない。今日の裁判は、一つの答えを示してくれることだろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "それもそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "そら、裁判官のお出ましだぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "静粛に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "恐らくは、多くの人が本日の裁判に当惑していることと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "大多数の方が知っているのは今日裁かれる人物だけで、審理で扱う内容は知らないのですから、それも当然のことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "皆さん、どうぞご清聴願います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "一週間前のあの日のことは、誰もがよく覚えていることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あの日、多くの事件が起こりました。食品安全保証部長だったルビオ氏の放送。そしてその後発生した、全都市を巻き込んだ混乱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "その中で大勢の人が亡くなり、またパニックに陥った人も数多くいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "幸い、混乱は最終的に鎮静化しましたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "すでによく知られている通り、それを引き起こしたのは、まさにその渦中で命を落としたベルナルド・ベッローネでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "けれど、その目的と動機は謎のままです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "この事件において、重要な役割を果たした人物はほかにもいます。それというのはベルナルド・ベッローネの子、レオントゥッツォ・ベッローネです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "彼をこちらに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "静粛に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "この場には、初めて会う人間も、前から面識のあった人間もいるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "まずは自己紹介させてくれ。俺はレオントゥッツォ・ベッローネ。今は単なる一般市民だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陪審員",
      "text": "一般市民？　ベッローネの跡継ぎじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "前はそうだったが、今はどのファミリーにも所属していない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "疑問が多くあることは理解しているし、俺自身一つ一つ説明していくつもりだが……最初に、父が何をしたのか、そしてなぜ事態は今の状況に至ったのかというところから話をさせてもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "このすべてを語るには、建設部長カラチの死のことから話さなくてはならないだろう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "人々の視線が注がれる中、法廷の中央に立つレオントゥッツォは少しも緊張していなかった。\n彼は暗殺事件の話から語り始め、理路整然とこの事件の全貌をつまびらかにしていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "新都市の所有権に関しては、すでに各ファミリーの元にも通達が届いているようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "「新都市に対するマフィアの介入を禁ずる」という通達だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "こうして意欲的にマフィアたちを抑え込んでいるところを見るに、あの対話で彼女は嘘などついていなかったのは明白だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だけど、私の知る限り、彼女は新都市の管理を誰に任せるかということにも、その理由にもまだ言及していないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "グレイホールはずっとそんなふうに動いてきただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ミズ・シチリアにすべてを説明する義務などない。あの人の命令は常に絶対だしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "でも、私たちにはその義務があるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "今は新都市に関する色々な噂が飛び交っているし、皆にきちんと説明しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そう、それが最初の課題でもあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "何もかもが突然のことだし、俺が演説台に立って「ファミリーの存在しない都市を作ろう」などと言うわけにもいかないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そんなことをしたところで、人々を困惑させるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そして、もし新都市にあんたと俺とチェリーニア、そしてルビオを信じる役人たちしかいない状態になれば、俺たちは最初の一歩でつまずくことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "察するに、ミズ・シチリアは俺たちがこの問題をどう解決するかを見たがっているんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……どうやら、あなたには何か考えがあるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺を逮捕してくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "何ですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "どんな思いでそうしたにせよ、親父の行動があれだけの混乱を招いてしまったことは確かだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "誰かが説明しないとならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それに、俺のしたこともそれと同じだ。そうだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カラチの暗殺、サルッツォとの結託、ロッサティのドンに対する暗殺未遂、そして第二中枢区画の分離システム起動に至るまで……\nどれも秘密の出来事でこそないが、その裏で糸を引いていたのがベルナルドだと明かされると、やはり法廷は騒然となった。\nレオントゥッツォは、彼の持ちうる情報を元に、父の計画をできる限り客観的に包み隠さず伝えていく。\nそうして一時間もの間語られた物語は、ついに終わりを迎えようとしていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "陪審員たちがそれぞれのファミリーを代表してここへ来ていることはわかっている。お前たちも、すでにある程度噂を耳にしていることだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "その噂は真実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "すべては父の計画であり、そしてその動機は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "「ファミリーの存在しないシラクーザ」を実現することだった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "懐疑的な傍聴人",
      "text": "いちファミリーのドンが、すべてのファミリーを滅ぼそうとするなど信じがたいことだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そうだな。息子である俺でさえ、すべてを理解した時には衝撃を受けた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だがその考えは、父の心の奥底に何十年も根付いていた。それが今になってようやく実を結んだというわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "しらばっくれるなよ、レオントゥッツォ。お前の父親は死んだが、お前自身はまだ生きている……だからそんな戯言で罪を逃れようとしてるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "なにせ、新都市の所有権がどこにあるのかは、こちらもわかっているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……ファミリーを代表して俺を非難しようというのなら、一向に構わない。それでお前たちの気が済むならな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懐疑的な市民",
      "text": "すべての黒幕がベルナルドなら、どうして彼まで死んだんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "狼の主。\nレオントゥッツォは喉まで出かけたその言葉を、結局胸の中に押しとどめた。\nというのも、狼主に関するすべてはひどくばかげているからだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "父は、マフィアを存在すべきでないとする以上、自らも排除されるべきだと考えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だからすべてをやり遂げたあとに、自殺することを選んだんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "ハッ、こいつは傑作だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "まさかお前は、奴が無私無欲の人間だとでも言うつもりか？　あの男が仕出かしたことはすべて、シラクーザの一般市民のためだったとでも言いたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……その逆だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺は父を利己的な人物だと思っている。父のしたことはすべて、その思い出の中のシラクーザのためにあったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そして、だからこそ父は失敗した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "……なるほど、読めてきたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "道理でベルナルドが死んだのに、お前はまだ生きてるわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "どんな手段を使ったかは知らんが、恐らくお前は親父を止めたあとこの事件を収めたという手柄を用いて、ミズ・シチリアに報酬を求めたんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "そうして新都市の管理権を譲り受け、挙句ここに立って堂々と話を語り聞かせて、同情を得ようとしたんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "図星だろう？　父親殺しめ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "レオントゥッツォは深く息を吸い込んだものの、結局は反論せずに目を逸らした。\n心の奥では、彼自身それを否定できなかったからだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "見ろ、あの表情！　やっぱりな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "一つ質問なのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "仮にその荒唐無稽な話を信じたとして、それと今日の裁判に何の関係があるんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "死んだ人間の行動に対して判決を下し、それを以て彼の量刑を決めるなどということはできませんよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "確かに、彼は父親について何かを語り、その行いについて議論するための証人としてここに立っているわけではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "本日の審理は、実のところ新都市の所有権に関することなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "彼は、この新都市とシラクーザの未来に関して独断で決定を下しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "では、レオントゥッツォ。ミズ・シチリアがあなたを選んだ理由について述べてもらえますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "あの事件において、俺は父の協力者であると同時に、阻止できる立場にもあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そして、すべてを知ったあと、俺は父を止めることを選んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "父は間違っていると思ったし、父のやり方ではシラクーザの新しい時代を切り拓くことはできないと思ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "すべてのファミリーを争いに巻き込んで、たとえマフィアが本当にいなくなったとしても、それは人々が新しい生活を選んだことにはならないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だが、その上で俺は、これはチャンスになりうるとも思った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そこで、事件が終わったあと、俺はミズ・シチリアの元を訪ね、都市を一つ借りたいと申し出たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "「ファミリーの存在しない都市」をな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "短気なマフィアの陪審員",
      "text": "笑わせるな！　ミズ・シチリアがお前の要求を受け入れる道理がないだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "これが単なる要求ではなく、シラクーザに対する挑戦状でもあるからこそ受け入れられたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "父が選んだ手段は、彼女からすればルール違反であり、容認できないものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だが俺が選んだ手段は……こう言うのもなんだが、ミズ・シチリアに許された範囲のものだ。そうでなければ、俺はここで発言の機会を得ることすらできなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "レオントゥッツォは、サンクタの神父がいる方向へと目をやった。\nアイマスクをつけたその神父は、今進行している審理には何の興味もなさそうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "なるほど。そういうことなら、ミズ・シチリアからの命令にも説明がつく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鋭いマフィアの陪審員",
      "text": "それどころか、そうでなければこんな決定を下したことへの説明がつかないとすら言うべきだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "……レオントゥッツォ。それが本当なら、お前が今日やったことは紛れもなくただの茶番だったということになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "これは裁判ではなく、お前が新都市の所有者になることを発表するための場なんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "いいや、あの都市は俺のものにはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それに、新都市に必要なものはすべて導入するつもりでいるが、ただ一つ――ファミリーの存在だけは受け入れはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なマフィアの陪審員",
      "text": "本当にそんなことができると思うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それは、マフィアと一般人との境界が本当に尊重されたことなどあるのか、と問うに等しい愚問だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "マフィアたちがミズ・シチリアの掟に従う理由は、単に彼女が自分たちよりはるかに強大だからというだけのものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "いわゆる暗黙の了解と呼ばれるものも、お互いを平らげることができないからこそ成立しているだけだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "お前たちが当然入ってこようとするのは知っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だがその時、お前たちは知ることになるだろう。自分たちが相手を見くびっていたことをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "無論、変革を求めるファミリーが新都市への協力を望む分には、俺も歓迎しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "「ファミリーの存在しない都市」にせよ、「ファミリーの存在しないシラクーザ」にせよ、想像上のものでしかないことに変わりはないと思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それは非現実的だからか？　あるいは達成困難に思われるからか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "……もちろん、非現実的だからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "父のやり方が間違っていたことは疑うべくもない事実だが、俺はその二つが実現不可能なものだとは思わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "お前たちは目の前にあるすべてを当たり前のことだと信じ込んでいるから、それを非現実的に感じるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "この地に深く根付いているファミリーの存在を根こそぎ滅ぼすことなど、あなたのみならず誰にもできませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だがファミリーを変えていくことはできる。彼らは、より文明的になることもできるはずなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ファミリーが決して滅びないのなら、自分たちの望む形に変えていけばいいだけの話だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "……本当に、成し遂げられると思うのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "失敗するかもしれなくても、やってみる価値はあると思わないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着きのある陪審員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な傍聴人",
      "text": "君が勝ち取ったものは、ミズ・シチリアからの施しでしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な傍聴人",
      "text": "マフィアは依然として存在しているし、どれだけ揺れ動いて見えても簡単に崩れ去ることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な傍聴人",
      "text": "今日君が見せた行動がパフォーマンスであろうと、真剣な気持ちによるものだろうと、どちらにせよそれはミズ・シチリアの許しがあるからこそできたことなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な傍聴人",
      "text": "このすべてには、本当に意味があるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……悲しいことに、こういう進め方でなければ、俺たちはテーブルクロスの如く取り換えられていただけだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺は自分の成功が必然だなんて思っちゃいないし、正直、あの日あそこで死ぬ覚悟を決めていたくらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それでも、たとえそれがただの施しだとしても、目の前のチャンスを掴まずにはいられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "仮に、ここでないほかの場所で同じことが起きたとしたら、その地の当事者たちはより高潔な姿勢を以て施しを否定し、拒むこともできるのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だが、このシラクーザでは――現時点のシラクーザにおいてはこう進めるしかないというのなら、喜んで受け入れよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ルビオ部長も、ほかに方法があったならあんな手段は選ばなかったはずだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "これがどんな結果をもたらすか、ちゃんとわかっているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "いいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺たちは前例のないことを成そうとしているんだ。やる前から結果なんてわかるはずがないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "とはいえ、俺はこう思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "一口にこのウォルシーニすべての人にというだけでなく、あんたとその周囲の人々に対しても、俺は説明責任を果たさなければならない……と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "あの日以来、俺たちはなんとなく互いの考えを察しているだけで、深く話し合ってはこなかったよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……俺たちは本当に同じ道を歩んでいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺が望む新都市は、あんたが望むものと本当に同じなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "実際のところ、俺たちはお互いの考えを理解できてはいないんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……私はあなたを信じているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それなら、なおさら俺を裁くべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "あんたのためだけじゃない。ルビオの遺志に応えて、あんたの元へ集まってきた役人たちのためにも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そうでなければ、元はマフィアの跡継ぎだった俺を彼らが信じるはずがないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……あなた一人で何もかも背負おうとしなくていいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私もあなたと一緒に背負うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……いや、俺は今、あんたの言っていたことを身に染みて実感しているところなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺たちの立場は違っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ファミリーの跡継ぎとしての俺では、本気であんたの境遇や立場に共感できるはずがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "今の俺が耐えているのは、前の自分から脱却するための通過儀礼のようなものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それに、実利的な側面で言うと、これは市民からの信頼を得ているあんたがそのイメージを確立する絶好の機会でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……それを言うなら、この裁判を茶番とみなす人だってたくさんいると思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そう思われても構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "たとえパフォーマンスだと思われようと、喜んでそれを演じることがある種の意思表明になることもあるだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺が思うに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺たちは、偉業を成し遂げようとしているわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "いつの日か、互いに疑い合う時だって来るかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "あるいは、過去を振り返って、自分たちはしくじったんだと悟る日が来るのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それでも――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "レオントゥッツォ・ベッローネ。あなたがそこまで固い決意を抱いているのはなぜですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ファミリーの中に生まれた人間でありながら、今この瞬間、彼らに対して最も強く敵対する立場を選んだ理由は何ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "なぜ、か……俺自身、よく自分にそう問いかけている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺自身が効率を追求しているからか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "正義を追い求める人の理想に影響されたからか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "尊敬に値する役人の行動に、知らぬ間に感化されたからか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "変わりゆくファミリーを観察して得た結論のためか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "おそらく、理由はそのすべてにある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そして、こうした理由を総合すると、結論を導き出すこともできるだろう。それはつまり――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "時が来た、ということだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "もしもカラチがあの暗殺を回避できていたら、建設部長としてさらなる高みに立ち、これと同じような目標に向かって邁進していたのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "もしもルビオがなおも己を抑え込むことを選んでいたら、建設部長の地位に安住しつつも裏で志ある人々を束ね、シラクーザを変えるべく努力していたのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺は別に、長年この計画を立てていたというわけではない。ただある時突然目が覚めて、運良くここまで来られただけなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺が死んでも、また次の人間が現れる。そして、その次も同じように……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "このすべては、俺の努力や個性によるものではなく、単に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "シラクーザに変革の時が訪れたというだけのことなんだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "次から次へと、レオントゥッツォに向かって疑問が投げかけられていき、法廷は問いただす声と罵倒で満ちていく。\n法廷の中央に立った彼は、真剣に、疲れも見せずに、答える価値があると見なしたすべての質問に答えていった。\n次第に多くの人々が、この青年の思慮深さと――\n彼がどれだけ真剣なのかを感じ始める。\n最後には、法廷内はすっかり彼に圧倒されていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "この場に揃った陪審員、そして傍聴席と、様々なメディアを通じて視線を注ぐ市民たちよ、聞いてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "事ここに至れど、俺の心は不安に満ちている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "確かに俺はミズ・シチリアからこの都市を借り受けたが、ここを俺のものだなどと思ったことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "未来のためにこの新都市を共に作り上げようとする人々や、このシラクーザからファミリーを真に淘汰するべく努力する人々のためにこの都市を借りたにすぎないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺は皆に代わり決定を下してしまった。だから、俺を裁くのはお前たちであるべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だが、一つだけ大きな口を利かせてもらうと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "今のシラクーザに、俺を裁く権利はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺を裁けるのは、お前たちだけだからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "お前たちはいずれ新都市を築く力を得るのと同じように、その力を手にするだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "いつの日か、シラクーザの未来を決める力さえも、お前たちの手に渡るかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "新都市は、ファミリーに不満や疑問を抱く者、あるいは俺に疑いを持つ者すべての参入を歓迎する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "以上だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
