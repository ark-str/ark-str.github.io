{
  "server": "jp",
  "storyId": "act17side_level_act17side_st10",
  "groupId": "act17side",
  "stageId": "act17side_09",
  "title": "甲板室",
  "storyCode": "SN-ST-10",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17side/level_act17side_st10.txt",
  "sourceHash": "be4226d1d1552f1880a638cb91e02e22eb60e1d6e235a846e5060deefb738cee",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "お前は好機をふいにした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "何ですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "事に当たったのが俺であれば――言葉を話すシーボーンをサルヴィエントで捕らえた時、エーギルに関して奴が知る限りの情報をすべて吐かせていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "陸で数年暮らしていたお前は、エーギルの情報を一つとして得られはしなかっただろう。だがその一方で、海は常に繋がりを持ち続けている。ゆえに、奴は有用にもなりえたはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "しかし、お前は奴を無価値のまま死なせた。非効率的な判断だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ゴミクズからの情報提供なんて、私には必要ないの。獲物が出す答えは低劣な思考に満ちているもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "その様子では、陸で見つけた協力者に相当の信頼を置いているようだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "最後の騎士",
      "text": "ギィッ……星、々……墓……場……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "奴に情けをかけたのか？　まだ立っているようだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "思っていたよりも、ほんの少し相手が丈夫だっただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "最後の騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "騎士は反撃せず、呆然と立ち尽くしたかと思うと、顔を上げ、ふらふらと辺りをうろつき回ってから上を見上げた。\nこの隙に追いかけっこを終わらせようと考えていたグレイディーアにも、その時、かすかな予感がよぎった。"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……シーボーンの匂いが、変化している……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "それを捉えられるほど、感覚が鋭くなってきているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "気付いたようだな。そう、問題はそこにある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "他人や自分をどれほど慰めようと、いずれ俺たちが直面する難題――それは、自分自身だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "……ガルシア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガルシア副船長",
      "text": "ゥ、あ……ア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "……そうか、そうか……深手を負わせたんだな！　それならば、血痕をたどって奴を見つけ出し、すぐに戻ってこようとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "――待て。この焼け跡は何だ？　奴め、俺の船に何をした！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……これはあの怪物の仕業じゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ええ、うちの可愛い小鳥ちゃんがやったことみたいね。こんな短い間にここまで成長するなんて、びっくりだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "こういう人間とシーボーン、本当に怖いのはどっちでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "……あの旧イベリア人がやったと言うのか？　ありえん……かつてここにいた船乗りたちの誰一人として、奴に実力で劣る者はなかったというのに、なぜあの小娘にこんな真似ができる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガルシア副船長",
      "text": "（船長の袖口を軽く噛む）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "……わかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "あの娘が何をしたにせよ、まずは先を急がねばな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "ついにこの数ヶ月にもわたる狩りを終わらせる時が来たのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "船長さん、なんだか嬉しそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "ハッ、当たり前だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "長い狩りの終わりを喜ばん奴などいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "貴様らはこのまま追い続けろ。俺は別のほうから行く。幸い、奴にこの壁は破れん……もっと海に近い場所へ向かうはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルフォンソ船長",
      "text": "安心しろ、ガルシア……お前の傷は命に関わるものではない。気を強く持て、すぐに戻る！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガルシア副船長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "怪我を負った以上、回復のためには時間が必要だ。\n副船長は、黙って船長の顔を見つめる。そこには、喜びと隠し切れない興奮、そして長く失われていた活力があった。\nそれを見たガルシアは、安心して微睡みに落ちた。愛する人の狩りを手助けすべく、回復に専念することにしたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そうして、ささやかな夢を見た。短く、ぼんやりとしていたが、身体が大きく変化したあとには滅多にないことだった。\n夢の中のそこは、イベリアの海岸だ。空を彩る花火が見えて、鳴り響く汽笛が聞こえてくる。傍らには意気軒昂のアルフォンソが立っていて、こちらに言葉を投げかけてきた。\n「ガルシア。」\n「岸辺に子供たちがいるぞ。俺もお前も子供は好きだし、こうして見かけると元気が湧いてくるな。」\n「子供はイベリアの未来だ。俺たちの名誉も、戦功も、そして技術すらも、命が尽きればそれまでだが……」\n「しかし、子供たちは――イベリアが育んだ命というものは、そうしたすべてを受け継いでくれるだろう。」\n「ガルシア。」\n「あの子には――俺の帽子とお前の帽子、どちらのほうが似合うと思う？」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "（傷を負っても、まだこんなに速く動けるなんて……これじゃ追いつけないわ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "（それに……無理やりハンドキャノンを使ったせいで……少し、身体が……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "ッ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "船の中にも溟痕が……！？　さっきまで、こんなに広がってなかったのに……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "光を帯びた溟痕は、黄金の広間を飲み込んでいた。\n意匠の凝らされた丸天井が、青く淡い光を反射する。その光の中心には、どこか場違いな一人の女性が立っていた。\n彼女は両手を組んで黙り込み、目の前の玉座をじっくりと観察している。その足元には溟痕が広がり、黄金は彼女のせいで色彩を失っていた。\n女性が振り返る。その瞳には、憐憫と期待だけがあった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "……こんばんは、アイリーニ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "（深海教徒……！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "っ、外した――！？　いえ、違うわね……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "アーツを使ったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "ええ、その通りです。今のあなたを見ることがかなえば、きっとダリオは喜ぶでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "――なぜ、私と上官の名を？　あなた、一体何者！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "私はただの翻訳家です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "くだらない冗談ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "冗談ではありませんよ。事実として、私は多くの著作を翻訳してきましたので。あなたの本棚に並ぶガリアの小説も、私が手がけたものかもしれません。翻訳者の名前に着目したことはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "それより、その足元……！　あなたが溟痕を持ち込んだの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "その言い方は、少々正確性に欠けますね。より正しく言うのなら、私は溟痕を持ち込んだのではなく……輝ける海との繋がりを築き上げただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "もちろん、その一部となれたことは大変光栄に思いますけれどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……どうやってこの船に乗り込んだわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "そうしたことは重要ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "あなたがシーボーンに勝てるかどうか、私がここで死ぬかどうか、この船がエーギルとの繋がりを再建する鍵となりえるかどうか……何もかも、重要とは言い難いことばかりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "無論……ダリオや懲罰軍の犠牲、グランファーロの崩壊、イベリアの眼そのもの、そして長きにわたる時間も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "すべては、壮大な進化という変容の中で、命が生んだほんの小さな波しぶきに過ぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "我々は皆、その一部でしかないのですから、私はそれを尊重しています。しかし、全体から見れば、やはり取るに足らないことなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "――え……？　どういうこと……！？　上官に何があったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "ああ、可哀想なアイリーニ……私はいかなる質問にもお答えしますけれど、敵を目の前にした今、本当にそれを知る必要があるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "いいから答えなさい！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "――残念ですが、彼は無意味な死を迎えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "潮風が訃報を伝えてくれたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "っ、そ、そんなはずない……！　ありえないわ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "……ありえないことなど、存在しないものですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "神託が下った瞬間に、この大地の行く末は決まっていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "我々は皆、地面を這いずる虫けらなのですから、運命に従うべきなのです。垣根も、区別も、国家や容姿の違いもない生命となることの何がいけないというのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "……抵抗をやめてくださるなら、それが一番ですが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "――本当に何もかもどうでもいいと思ってるなら、怪我した小さな獲物のために時間を稼ぐのはやめてくれない？　アマイア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "……あら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "目が覚めたのですね、ローレンティーナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "まだ完全ではないけれど、あなたの名前くらいは思い出したわ。こんな調子で、失礼な人だって思われないといいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "アイリーニ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……彼女に何かしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "いいえ、何も。少しお話ししていただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "スカジ、先に行っててちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "さっきのあれは、あなたの獲物だったんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "だって、それより懐かしい人に会っちゃったんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……わかったわ。気をつけてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "アイリーニ、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……深海教徒。あなた、嘘をついたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "潮風は嘘などつきませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "いいえ。言ったでしょう、そんなのありえないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "上官の死には、きっと意味があるはずよ。裁判所に「無意味な死」なんて存在しないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "あなたはそう思わないって言うなら……私たちが、その意味を叩きつけてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "いいでしょう。……あなたは、本当に強い子ですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "っ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "行くわよ、アビサルハンター！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "……ハンドキャノンを扱えるようになったからといって、やたらと威力を見せびらかしたがるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "またそんな乱暴なやり方で溟痕を焼いてしまったら、アルフォンソ船長がお怒りになりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "はぁ……仕方がないですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "あら、追いかけないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "ふふ……クイントゥスと違って、私はそうせっかちではありませんから。そもそも、同時に二人のハンターを相手取るのは、寿命を縮めるようなものですしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "「一瞬」と「刹那の間」に違いなんてあると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "いいえ。ですが、こうして昔のような性格に戻ったあなたを見ていると本当に懐かしい気持ちになりますね。何しろ、最初の実験が始まる前にはもう、あなたは昏睡状態でしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アマイア",
      "text": "私たちの元を去ったあと、どうしていましたか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "スペクターは微笑んだ。\nそれは、この夜に彼女が見せた中で一番美しい笑顔だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あいつ、どんどん素早くなってるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "はぁ、はあ……二つも風穴を開けてやったのに……なんなのよ、あの化け物……！　どんなに血が流れても平気なわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "穴を開けた？　それって、どうやって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "その話はあとにしましょ……私も、あまり体力が残ってないし――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "――！　あいつ、逃げる途中で仲間を食べてるのね！　道理で倒れないわけだわ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "来るわよ、気をつけて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "――ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "Ishar-mla。あノ方は、どコだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "答えヲ、知リたイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "待ちなさい、怪物！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シーボーンは、アイリーニが発砲する直前に身をかがめた。\n壁が砕け散る音と共に、衝撃を利用して跳躍したスカジが、瞬く間にシーボーンの目の前へと現れる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし、その渾身の一太刀すらも、それに届きはしなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "（今のを、全部躱したっていうの……！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "……足り、ナい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "栄養、時間、足リな、イ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "Ishar-mla。我々ニは、答えガ必要ダ。けレどモ、あノ方の存在ハ、感じテいル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "言葉ヲ、求メる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "Ishar-mla。答エ、なくトも、あノ方の存在、否定でキ、ナい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "あノ方、いナくトも。一族、目的ヲ見失う、コとはナい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "方向、一族が把握しテいる。自ラ、把握しテいル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "唯一の目標ハ、生存、ダ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたたちって、本当にぶつぶつ言いながら殺し合うのが好きみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ゴチャゴチャ考えたところで、どうせあなたは海に戻れないのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "――まダ、足リない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "デも、もウすグだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "――！　アイリーニ、耳を塞いで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "えっ、わわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーボーン",
      "text": "（鋭いおたけび）――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "最後の騎士",
      "text": "――ロシ、ナンテ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロシナンテ",
      "text": "――！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "最後の騎士",
      "text": "大波が、近イ。我らハ、待つ。外へ出テ、武器を手ニ、引き裂クのダ――行ク、ぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシナンテ",
      "text": "（応じるようにいななく）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "シーボーンの低い鳴き声が遠くで響き、グレイディーアは眉をひそめた。\n単なる陸の人間が軽率に海と接触し、永久に心を病んでしまうこと自体は理解できないでもない。\nだが、あれに付き従うもう一匹のシーボーンのほうは……？\nとはいえ、彼女は深く考えはしなかった。何やら嫌な予感が、彼女の神経をかき乱して――\n――首元にぞくぞくとする感覚が走っていたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "向こうで何が起きているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "――この船は六十年以上の間、海上を漂ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "連中がこの船の存在を疎んでいたら。あるいは、船上の人間を敵と見なし、船の破壊を試みていたら、「狂人号」はとうに沈んでいたことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……つまり、奴らはこの船を受け入れていたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "これまで、奴らはここを環境の一部と見なしていた。その目的はわからんが、海上を進むこの船を許容していたのは間違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "だが、今は状況が変わった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "っ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "溟痕？　一体いつの間に……しかも、この速度は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "もはや船が沈むのも時間の問題だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "――グレイディーア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "なぜブレオガンのような才あるエーギルが、最後の最後に、鍵をこの形にすることを選んだのだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "これは彼が心血を注いだ作品であり、エーギルが夢にまで見た秘密の鍵であるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "だというのになぜ、誰の血を用いても開くことができるようにしたのか？　そしてなぜ、これが軟弱な騎士の手に渡ることを許したのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "確かに、我々は「あれ」を黙らせた。だが、そもそも奴らには神など必要ないのかもしれん。手を合わせ、やたらと海に祈りを捧げて慰めを得るのは、弱く偽善的な人間たちだけなのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルピアヌス",
      "text": "我々が勝ち得た時間は少ないと思え。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "まだティアゴのことをお考えのようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聖徒カルメン",
      "text": "正確には、それだけではないがね。彼の件は、私が経験してきた数多の悲劇の中では、特別な一件というわけではない。浜辺の砂の一粒に等しいものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聖徒カルメン",
      "text": "しかしその浜辺には、どれだけの砂が積み上げられていることか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聖徒カルメン",
      "text": "――この船は、懲罰軍が用意した物ではない。多くの船が懲罰軍の管理下に置かれた中で……忘れ去られ、海岸に置き去りにされた数隻のうちの一つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "懲罰軍の誰かの不注意が、今にしてみれば、我々の手間を大きく省いてくれたようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聖徒カルメン",
      "text": "だが、我々はどれだけのものを忘れ去り、置き去りにしてきたのだろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聖徒カルメン",
      "text": "ケルシー女史。テラの大地が一隻の船だとしたら、それはどのような船だと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……もうじきに、イベリアの眼へ辿り着きますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聖徒カルメン",
      "text": "……ああ、そうだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
