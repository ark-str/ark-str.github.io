{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_08_end",
  "groupId": "act12d0",
  "stageId": "act12d0_08",
  "title": "ガヴィルの拳",
  "storyCode": "RI-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_08_end.txt",
  "sourceHash": "e7a57fb99111afb0d92dfdac35ebaba1ecd2a947e2eeced47e7a8d04f5ff3817",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "のわああああああ！　うーむ、いまいちじゃな。次は別の叫び声にしようかのう、少々飽きてしまった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おい、あいつは大丈夫なのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "心配ない、じきに戻る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "じゃあいいけどよ。つーかあれって本当に普通のヤツなのか？　あんなヤツがいるなんて聞いたことねぇんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私にもわからない。本人からは、ずいぶん長くここで生活していたという話しか聞いていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ふぅん。それよりも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "本当に大したデカブツだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ガヴィル、頭から血が出てるよ！　大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "平気平気、こんくらい掠り傷だよ。トミミ、アタシの救急箱を持ってきてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ん？　トミミのガキンチョはどこ行ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ほい、救急箱だよ。トミミなら、あいつを倒す寸前に慌ててどっかに走ってったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "サンキュー。まさかあいつ、ちびったんじゃねぇだろうな。まあいいや、先に手当しとくか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そうだ、お前らはほかにケガ人がいないか見てきてくれねぇか。いたら全員ここに連れてきてくれ。アタシが診るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "text": "おー、おいらにまかせろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ハハッ、了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "えー、めんど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ほらほら、文句はその辺にしときや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ドクター……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ビッグ……アグリー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ズゥママ、わりぃな。バラバラにブッ壊すしかなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "わかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "確認した限り、お前のエンジンは無事のようだ。あとで返そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そうか、そりゃあ助かるぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ガヴィル、ここに残るつもりはないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前と同じように、アタシにもやりたいことが見つかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "医者か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "医者をやるのは楽しいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "うーん、機械を作るのは楽しいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "楽しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "だが、やはり大族長はお前しかいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ハァ？　なんでだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ビッグ・アグリーを倒したからだ。ガヴィル、お前の勝利だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "見ろ、また人が集まってきた、皆お前を見ている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "チッ、どうすんだ、ドクター？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分で決めてくれ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "答えになってねぇ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ドクター、狸寝入りはやめろ！　医者のアタシには通用しねぇぞ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "大族長ガヴィル万歳！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ドクターてめぇ、マジで一発殴ってやろうか？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさん、大丈夫ですか！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ん？　ああ大丈夫だ。どこに行ってたんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "え？　あっ、その、急にトイレに行きたくなっちゃって！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "そうか……ん？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "どうしたんですか、急にじっと私を見つめて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ハハ、この手があった！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "みんな聞いてくれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "アタシはビッグ・アグリーに勝った！　だからこれからはアタシが大族長だ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "そこで、お前らに言いたいことがある。それは――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "拳こそがすべてだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "えっ、ガヴィルさん、大族長になってくれるんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "しかーし！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "アタシには、まだ大事な用がある！　だから、やっぱりしばらくここを離れなきゃならない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "だが心配すんな！　アタシがいない間、トミミがここをまとめる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "お前ら全員、このトミミをアタシだと思え！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "えっ、えええ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "えっ、そんなので大丈夫なの？　ここの人たちって、実力至上主義なんじゃないの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ガヴィルはすべてに打ち勝ち、大族長になった。ヤツの言葉は当然受け入れられるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ハハッ、ズゥママ、機械も面白ぇけど、やっぱりアタシは拳の方がいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ふんっ、私はまだお前の考えを認めたわけではない。いずれもっと強い機械を作って、お前に再挑戦する。それを忘れるな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "いいぜ、待っててやるよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "おっとその前に、アタシと一緒にロドスに来い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "なぜだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "お前の鉱石病を診てもらうんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "断ってもいいか？　私はまだビッグ・アグリーを……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "こればかりはダメだ。それに今はアタシが大族長だ。お前がなんと言おうが、引っ括ってでも連れて行くからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "わかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "……ガヴィルさん、やっぱり行っちゃうんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ。飛行ユニットにエンジンをつけ直したら、すぐにでも出発するつもりだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ダメです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "い、行かせません！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
