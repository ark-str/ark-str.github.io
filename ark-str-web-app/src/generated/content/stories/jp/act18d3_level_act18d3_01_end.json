{
  "server": "jp",
  "storyId": "act18d3_level_act18d3_01_end",
  "groupId": "act18d3",
  "stageId": "act18d3_01",
  "title": "侵入者",
  "storyCode": "SV-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_01_end.txt",
  "sourceHash": "8b0ff8f56a4012676a8b05beab2c3feda66d0a98df140d76f5e15e0fff1ec53c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "スカジ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "腕が鈍ったんじゃないか？　前までの君なら、あんな連中簡単に八つ裂きにできたと思うがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私はそんな血生臭いことしないわ、ホセさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "どうだか。まあ、それなら君は変わったんだろうな。逃げるチャンスまで与えてやるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……かもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "さて……君が訪ねてくるとは、どういう風の吹き回しだ？　彼らが君を待っていたのは、何か私にも関係のある用事かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "さあ。知らないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "聞いたところじゃ、君はもう足を洗ったらしいじゃないか。その後は確か……製薬会社に入ったとか？　真っ当な仕事を放り出してまで、こんな荒野に何の御用かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……よく知ってるのね。今回はあなたみたいな情報通の助けが必要なのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "もう数年が過ぎた。君は手を引いたものと思っていたよ。君には、カジミエーシュのバウンティハンターが大勢やられたらしいな。遠く離れたこの土地にも噂が流れてきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "だからこそ、君は騒ぎを起こさずにはいられない人だと思っていたんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "今は妙に大人しいじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "ミノス辺りからこの場所まで、トレーラーみたいにそこら中を更地にしながらやってきたのは、私を探すためかい？　何を求めてここへ来たのか、言ってみるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "サルヴィエントに行きたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "サルヴィエントに……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "まさか、知らないなんて言わないわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "ああ、知った場所さ。この辺の情報屋でもその名を知っているのは私だけだろうな。しかし君は、なぜそこに行きたいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "あの場所には何もない。数十年前……何もかもがなくなったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "海のすぐ傍のあの土地に、何が残っていると思う？　かつての都市の亡骸さ。既に呼吸を止めて久しい、がらんどうの骨格だけが……そこに残っているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "そして多くのバウンティハンターがあの廃都市に近付こうとする。まるで腐った駄獣の骨に飛びつく小さな獣みたいにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "奴らはまだ死骸から肉をほじくり出せると思っているのさ。そうして腹に入れたものが、ただの毒虫だとも知らずに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "イベリアを……声すら上げることのない、あの静かなイベリアを、奴らはカジミエーシュやガリアのような宝の山だと勘違いしてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "何もないように見えたとしても、可能性だけは転がっている……とでも言うかのようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "それで？　あなたは、彼らに何を伝えているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "奴らが求める情報を、言われた通り売ってやるさ。私からすれば、連中が戻ってこようとこなかろうと、どの道商売になるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "実際、彼らは一人として戻らないがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "そういや半月前、「ダガーボーン」の一派が訪ねてきてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "今地面に転がっているこの連中に比べて、彼の装備は遙かに優れていたし、彼自身の経験も豊富だった。彼は十数人を連れてあの場所に向かったが、今となっては彼らを見た者は誰もいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "彼らがどこへ行ったのか、興味を持つ奴は大勢いる。懲罰軍に捕縛されたのかもしれないし、あるいは国防軍に連行された可能性もある。だが私にはそれ以外に一つ、気になる噂があってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "あの場所には――怪物がいるんだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ふうん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "怪物がいるんでなければ、裁判所送りになったのかもしれないな。どれが最悪の結末かは知らないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "人も怪物も大差ないわ。私の剣からすればね。行く手を阻む奴か、そうでない奴か、それだけだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "はいはい。それで、サルヴィエントにはバカンスを楽しみに行きたいわけじゃないんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そうね。人探しだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "君の怒りを買った不運な奴がいるらしい。一体どこのどいつかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "今回はそういうのじゃないわ。あの人は……昔の知り合いよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "昔の、ね……私よりも古い付き合いなのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ええ、随分とね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "彼らは皆ここを去ったか、あるいは死んだのかと思っていた。少なくとも、当時の君からはそう聞いた覚えがあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "だから探すのよ。はっきりさせないといけないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "……何年も探し続けてきたんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "この間の大きな騒ぎを起こしたのも、騎士の財宝を手に入れるためなんかじゃないんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたが教えてくれたのよ。生きている限り、前へ進むべきだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "……宝の地図は持ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……宝の地図？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "多くの人々が――この道のベテランすらも、荒野を行き、歩き続けるうちに目指す行き先や探していたものを忘れ去ってしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "それでも、彼らはひたすら歩いていくんだ。飢えや、疲れまでもを忘れてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "……荒野が彼らを殺すまで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "その人たちが弱すぎるだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "どんなに屈強なハンターでも、果てなき荒野を征服することはできない。多くのハンターが道半ばで野垂れ死ぬんだ。探し物すらわからないままな……そんな結末、君には似合わないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "どうして私にそんなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "言わなかったかしら？　彼らはエーギルのおもちゃみたいなロボットすら、満足に相手できないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "ああ、君は強い。だが、その強さで私の息子を救えたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "よせ！　別に君を責めたいわけじゃないんだ。考えてもみてくれ、君を許せないのは私じゃなく、君自身だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "私の後悔はたった一つだ。君とは関係ない。私はあいつの足を折ってでも、己と同じ道など歩ませないようにすべきだったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "君は、海の中から来たと言ったな。イベリア以外の海のことなど、私はそれまで聞いたことがなかった。私にとって君は想像も及ばない存在だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "君にだって、そんな人くらいいるだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "私の息子を殺したのはそういう奴だった。君にすら想像の及ばないような相手だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……私は、それが怖いのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "……さて。何はともあれ、少なくとも君の尋ね人に殺される心配はせずともよさそうだな。しかし、どうしてサルヴィエントなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "友人がそこに連れ去られたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "そいつは妙な話だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "何にせよ、これを……地図だ。持っていきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "役に立ちそうね。お礼に何をあげたらいいかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "お礼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そういうものでしょ。情報には見返りが必要になるはず。あなたがくれた情報の分は、あなたの欲しいもので返すわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "そうだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "あの時、君はファンの遺体を私の元へ連れ帰ってくれた。五体満足の状態でね。だから、これで貸し借りはなしだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……ホセさん、本当にありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もう行くわ。体に気をつけてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "待った！　死に急ぐつもりか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "……なあ。君にこういうことを言う人、他にいないんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ええ、あまり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "なら、誰かが君に言ってやらなきゃダメってことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "では改めて問うが、君はバウンティハンターの服装のまま、イベリアの都市で堂々と歩き回るつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "本当に変わらないな、スカジ。どんなに語気を強めたところで、君からすれば大したことには聞こえないらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "しかしな、その格好のままでは、国防軍に十数回は捕まるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "連中を相手にしている時間なんてあるのか？　君の尋ね人はどれだけ待ってくれるんだい？　イベリア人は三下のバウンティハンターほど楽な相手じゃないんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "つまり……何か考えがあるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "ああ。このハープを貸そう。持って行きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ハープ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "まだ弾けるかい？　昔弾いていたと思うが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ええ、弾けるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "そうか、それはよかった。まあ、弾けなくとも大して問題ない。適当に誤魔化せばいいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "それから服も、こっちに着替えなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……何、これ？　変な服ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "君には馴染みがなくとも、イベリア人にとって馴染み深いものであればいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "さあ、今から君はさすらいの歌い手スカジだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "お行きなさい、歌い手よ。地図の通りに水路を行けば、そう何日もかかるまい。君ならできるさ、エーギル人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "さよなら、ホセさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "スカジ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホセ",
      "text": "あんな場所で死ぬんじゃないぞ。死ぬならせめて、知った人の傍でないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "た――助けてくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "何なんだよこれは……い、いつまでも付きまとってきやがる！　いくら斬っても死にやしねぇ。海にはこんなのがうじゃうじゃいるってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "おい――離せ、離せよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "俺も知ってりゃ来なかったっての！　クソ、*カジミエーシュスラング*！　「イェモーク」、あのクズめ！　あの時あいつが騙されてなけりゃあ、こんなとこでゴミ拾いせずに済んだのによ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "イベリアの幽霊都市ってのは幽霊どころか化け物が住んでるもんなのか！？　この*カジミエーシュスラング*、もうおしまいだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "な、何だ？　一瞬で化け物がバラバラに……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "ハァ……ハァ、何だっていい、命拾いしたぜ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "うおっ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そこのお前。立ち去ることは許可しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "そ、そう言うお前は誰なんだよ！？　なんでこんな化け物にばっかり出くわすんだ……イベリアってのは化け物の国なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もう一つ言っておく。このイベリアでは、噂話は禁物だ。次に口を開く時は注意すべきだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "何なんだよ、その格好、その武器――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "お、お前はまさか……ま、マジかよ……！　終わった……俺はもうおしまいだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "上官、海辺の方は片が付きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "生き残りはいません――ああ、この不快な悪臭と共に座り込んでいるよそ者を除いて、の話ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "言え。お前は何を見た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "俺……俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "お、俺は何もしてません！　誓います……俺は道に迷っただけなんです。偶然ここに来てしまっただけで、わざとじゃなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "み、見てください！　俺、金貨を持ってるんです。他にも色々……クソッ、ほとんど落としちまった……金も武器も、なんだって全部差し上げます。だから、どうか見逃してください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そのゴミを仕舞いなさい、よそ者。上官は質問をなさっているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "ししし、質問？　質問なんてありません！　俺から質問するなんて滅相もない……ほ、本当に大丈夫ですから……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "お願いします、どうかお許しを……捕まえないでください……つ、捕まるくらいなら死んだ方がマシだっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "海に身投げでもするつもり？　私の目の前で？　間に合うと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "け、剣……！？　いや、それより……手……俺の手……あと少しでもズレてたら……俺の……手が……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どう、目が覚めたかしら？　あんたたちよそ者ときたら、欲深い腹黒のくせに、ちょっと脅かしただけでビビっちゃうんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "ううっ……もう逃げ出したりしません、なんでもお答えします……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それでいいわ。私は何度も同じ質問をするのが嫌いなの。だから、これが最後のチャンスよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "海辺で何を見たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "お、俺は……ええと……化け物を見ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そう。あんたたちは何人で来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "元々は十二人……あっ、ガイドを入れて十三人です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "上官、嘘はついてないようです。死体はすべて、海辺の方で確認しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ねえ、今泣いて何の役に立つっていうの？　あんたたちがわざわざ侵入しなければ、こんな目に遭うこともなかったのよ。法律を破ろうとするのなら、予めその代償を考えておくべきだったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "結果として、十二人が死んだ……そしてここへ来る間にも、道沿いに進む度に、あの怪物は数を増していたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "つまり、奴らが巣穴から遠く離れることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "上官のご判断が正しいことの証左ですね。近付けば近付くほど、奴らの数も増えていく……あの都市には何かがあるはずです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "行くぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "このよそ者はどのように処断致しますか？　見てはいけないものばかり、目にしてしまったようですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "ど、どうかお許しを！　知っていることは全部お話ししました！　お願いです、上官様……！　――あぁ、母ちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前は、何を見た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バウンティハンター",
      "text": "俺は……俺は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "私たちは、約束しましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "その行為が持つ意味。理解不能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "あなたは応じてくださったではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "応答？　承諾、グ、ギゅ……約束？　取り決めた通り、時来たれば果たすもの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "否。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前が求め、私が応じる。約束、承諾、有り得ぬもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "応じる……ええ、仰せの通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "尊きお方、やんごとなき使者よ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "あなたが応じてくださることこそ、この上なき栄誉でございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
