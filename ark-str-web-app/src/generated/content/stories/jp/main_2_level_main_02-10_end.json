  "sourceHash": "3a56b2f51617f87fa83870aa6d8c8ffa04e489a5ea8ef76dd39306c03122511e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ぐ、っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はぁ、っはあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "スカルシュレッダー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "おい、大丈夫か！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "っ、平気だ。……こいつら、実力はあるらしいな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "動けそうならいいんだが……Wから連絡が来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ターゲットは確保済み、向こうの仕事は済んだとよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……本当か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ああ！　奇襲がうまくいったんだろうさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "なあ、こうなったら俺たちも退くべきじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "まずは……タルラに、信号を送れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……撤退だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "覚えてろよ、ロドスのクズどもめ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "次に会った時が、お前らの最期だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――レユニオンが、退いていく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "やたら手際いい退却ね。最初からこうするつもりだったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まったく……あんな大口叩いといて、逃げ足だけは一級品ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "この状況……どこか、変ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "？　それは、どういう――",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "やはり、レユニオンの目的はロドスではないんだろうな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "つまり、彼らはあくまで私たちを足止めしていただけ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ということは――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "狙われているのは、近衛局……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "みなさん、今すぐ支援に向かいましょう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "フランカさんは、周囲の偵察部隊にコンタクトを取ってください！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "それと、リスカムさん！　チェン隊長にも連絡を！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "なぜ援軍が来ないんだ！　督察隊の主力部隊はどうした！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "text": "先ほど、レユニオンに足止めされていると連絡が……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "馬鹿な……！　あんな寄せ集めの連中に、足止めなどできるはずがないだろう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "text": "っ、それが……向こうは、たった一人とのことでして……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "まさか……！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
