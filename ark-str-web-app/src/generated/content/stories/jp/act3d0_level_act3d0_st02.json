  "stageId": "a003_st02",
  "title": "ブレイクフリー",
  "storyCode": "OF-ST2",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act3d0/level_act3d0_st02.txt",
  "sourceHash": "73578693689ed756008f8455085a19fbd5c405ba89c2a1a116b415050f3f4bb6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "最後に、同位元素との比較と、複数のサンプルの最終分析から、概ね皆さんの予測が当たっているものと判断できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "火山が活性化している頻度は、確かに異常な増加傾向にあります。今すぐに噴火を引き起こすとは言えないまでも、全く楽観視はできない状況です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "火山の活動は、おおよそ二週間から四週間以内に臨界点を迎え、その後噴火し天災を引き起こすものと予測されます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "可能ならば、すぐにでも市民の皆さんに避難の準備を始めていただくべきかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "……以上が、皆さんから頂いた情報から導き出した結論です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "さすがエイヤフィヤトラちゃん。通信越しでも40分も話すなんて……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "ドクター、話はわかった？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何も言っていないのと同じだな。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "プロヴァンス",
              "text": "僕も同じだよ、気付いたら話が終わってた。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "結論だけは理解できた。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "プロヴァンス",
              "text": "わー、さすがドクター！　僕は何にも分からなかったよ……。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "あの二人が感心しながら熱心に話を聞くのを見て、理解できてないのは僕だけかと思ってた……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカイフレア",
          "text": "さすがエイヤフィヤトラですわね。わたくしですら学生に戻った気分になりましたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "そういうことでしたの。さすが専門家ですわね。あのデータをこのように読み解くなんて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "ここでこんな素晴らしい知識が得られるなんて、全てノートに記しておくべきでしたわ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイヤフィヤトラ",
          "text": "現状得られている情報には限りはありますが、私の判断も皆さんと同じです。この火山は休眠状態から、活動状態へ移行したものと思われます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイヤフィヤトラ",
          "text": "ですがこれ以上は私が直接現地を調査しないと、火山が活動を開始した原因に関しては、解析は難しいです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイヤフィヤトラ",
          "text": "……ごめんなさい。もし現地でさらに多くの情報が集められれば、火山活動の原因も、正確な活動周期も調べられるんですが……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイヤフィヤトラ",
          "text": "そうすれば市民の皆さんをより計画的で安全に避難させられるのに……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "みんなエイヤフィヤトラちゃんの火山に懸ける思いはよーく分かってるよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "これだけ分かっただけでも、すっごく助かったよ。お疲れ様！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "貴方がたのような専門家のチームが分析してくださって、本当に助かりましたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "ですがシエスタの観測ステーションでは、何の異常も観測されていませんの。観測器に何か問題が起きているのかもしれませんわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "わたくし、あちこち駆けずり回った甲斐がありましたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "いち早くこの情報をシティーホールに持っていきましょう。手遅れにならないうちに……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカイフレア",
          "text": "まさかシエスタ市の行政は、この時期にこれだけ大きなイベントを開いておいて、天災に対する備えが全くないとでも言うつもりですの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "備えどころか、天災が起きる可能性があることすら市民は知らないはずですわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "わたくしのお父様は、三ヶ月前に新開発区画へ出張に行かれましたから、あと数日は帰ってきません。シエスタのことはお父様の秘書であるクローニンさんに一任されてますわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "そしてクローニンさんは、この都市の天災トランスポーターでもありますの。今すぐシティホールにデータとサンプルを持ち帰り、状況を確認していただきましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "わたくし、市長の娘ではありますが、シエスタ市の行政に関わることには、あまり携わっておりませんの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "ですがこれだけ確実な証拠があれば、皆さんきっと力を貸してくれるはずですわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "ドクター、僕は気になるから、火山に入って、エイヤフィヤトラの言う火山活動の原因ってのを確かめようと思うんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "セイロンさんの方は、ドクターたちに任せていいかな？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "火山に入る？　危険すぎる！！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "天災トランスポーターの仕事は、もともとそれなりに危険なものなんだ。安心して、僕だって素人じゃないんだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "通信を受信するのはホテルじゃないと難しいと思うけど、こっちはいつでも連絡を取れるようにしておくから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカイフレア",
          "text": "わたくしも一緒に行きますわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "ええっ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカイフレア",
          "text": "何か異存でもあるの？　貴方が重要な研究データを破壊してしまわないか、心配してますの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカイフレア",
          "text": "当然、見張り役が必要なのではなくて？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "いやいや、異存なんてないない……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プロヴァンス",
          "text": "そう言えばこの件、アーミヤには言っておく必要はある？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカイフレア",
          "text": "必要ありませんわ。大したことではありませんし、ドクターが知っていればそれでいいでしょう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "では決まりね。ドクター、資料を用意してくださいますか？　午後2時にシティホールへ向かいましょう。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "わかった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "ふぅ……方針が決まって、少しだけ落ち着きましたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "ドクター、ヴィクトリアから取り寄せたお茶ですわ、一杯いかが？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ありがとう。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "セイロン",
              "text": "必ず気に入るはずですわ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "遠慮しておく。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "セイロン",
              "text": "あら？お茶を淹れるのが苦手でしたら、わたくしが淹れてさしあげますわ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ありがとう。",
          "value": "4",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "セイロン",
              "text": "ええ、必ず気に入るはずですわ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……遠慮しておく。",
          "value": "5",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "セイロン",
              "text": "もう！面倒な方ですわね。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "セイロン",
              "text": "こちらはヴィクトリアで一二を争う茶葉ですのよ？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "負けた。",
          "value": "6",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "セイロン",
              "text": "ええ、初めからそうすればいいのに。必ず気にいるはずですわ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "…………遠慮しておく。",
          "value": "7",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "セイロン",
              "text": "わたくし、これでもお茶を淹れる腕前は誰にも負けない自信がありますの。味わっておかないと、一生後悔しますわよ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "………………わかった。",
          "value": "8",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "頑固な方ですわね、ここまで言わないと受け入れないなんて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "では、少しだけお時間をいただきますわ。",
          "portraitKey": null
        }
      ]
    }
  ]
}
