{
  "server": "jp",
  "storyId": "main_1_level_main_01-08_beg",
  "groupId": "main_1",
  "stageId": "main_01-08",
  "title": "意志",
  "storyCode": "1-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_01-08_beg.txt",
  "sourceHash": "98a8aacf09d870184b076ca20029d236a19a962f410d881fbead24d8bc5268fb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十一关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "アーミヤ、ドクターを連れて離脱してくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "急げ、今すぐに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そんな……そんなことできません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "君も感じ取っているだろう！　このままでは、全員ここで命を落とすことになりかねん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "あのタルラという人物は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "彼女は、まさしく怪物だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それでも、一緒に戦います！　そうすれば、きっと可能性は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――ドクターのことはどうする？　安全を確保できるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……そ、れは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "E4小隊！　これより、この場にとどまり、奴らを足止めするぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "アーミヤとDr.{@nickname}、そして医療班が撤退する時間を稼ぐんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "――待った。その役目、俺たちに任せてもらおうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "Ace、何を言って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "任せてくれと言ってるんだ。俺は本気だぞ、ニアール。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "だが……！　周囲のすべてを融かしてしまう相手に、どう対処しようというんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そうですよ！　あなたたちを残して、撤退なんてできません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ロドスは……絶対に、みなさんを見捨てたりはしませんから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "アーミヤ、もう時間がない！　撤退するんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "――頼む、俺たちを信じてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っ、ですが……！　ロドスの仲間が犠牲になったらと思うと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "作戦目標を忘れるな！　何のためにここへ来たのか、思い出せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もとの目標が何であろうと、これだけは譲りたくないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "なんだ……？　彼女の手に、何かが集まって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ま、周りの空間が……歪んでるような……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――いや、あれは陽炎だ！　熱された空気のせいで、景色が揺らめいて見えるのだろう……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　気をつけてください！　あのアーツは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "待って……ダメ！　ニアールさん！　戻ってください！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あれは、ただのアーツなんかじゃ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――少し、静かにしてもらおうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ぐ、あっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……っはあ、はぁ……ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "まずいッ――ニアール！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "が、はっ……来るな！　この程度……大したことは、ない……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……こんな……火傷、くらい……で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "火傷くらい、だと……？　バカを言うな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "鎧をそこまで傷つけられておいて、強がるんじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "これ以上戦うのはよせ、すぐに離脱を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――来るなと、言ったはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "っ、この頑固者め……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――ふむ、面白い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "伏せろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ぐっ、ごほっ……今のは、一体……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "辺り一帯が融け落ちていく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "まるで、見えない炎が頭上で広がっているような……あんなものを喰らえば、ひとたまりもないぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "こうなれば全員、撤退だ！　無駄な犠牲を出すわけにはいかん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "我々は……何を、相手に……しているんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "とにかく、あのアーツを止めないことには打開できんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "――狙撃オペレーター！　奴に照準を！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――確かに……抵抗とは、大地に希望を芽吹かせるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "しかし、その抵抗が貴様らの運命を変えることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "撃てッ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――チェルノボーグは解放された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "それを以て、我らはすでに目的を果たしていたが……貴様らに、少し興味が湧いてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "何……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "まあ、あくまで興味をそそられただけ、なのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "何しろ、貴様らは選択を誤ったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ロドスよ。――真の意味で、感染者側に立つべきだったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "何が……起きたんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "どうして、広場中が焼けて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "今のは、一体――けほっ、ごほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "い、息をするだけで……喉が、焼けて……しまいそう……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "な……何もかも、燃え尽きちまった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "奴のそばには、弓矢どころか、石ころすらも残ってない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "この一瞬で……周りのすべてを、焼き尽くしたのか……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――貴様らが、解放者にふさわしい粘り強さを持っていることは認めよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……こんなふうに、塵も残さず燃やしてしまえるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "……アーミヤ。これでわかったはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――誰かが残って、奴を止めなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――だが、それにはもう飽いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……っ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "アーミヤ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "貴様らは同胞を殺めたのだ。報いを受けさせねばなるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "さあ、私好みの結末へと導いてやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――滅びよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ッ、まずい……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "退避しろ！　行け、早く行けッ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "あんな攻撃を喰らったら終わりだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "急げ、アーミヤとドクターを守れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "いや、これでは間に合わん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "私が奴を足止めする！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "きゃああっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……あ、れ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "あ……アーミヤさん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――誰一人、傷つけさせはしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "絶対に……止めてみせます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――ほう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ぐ、っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私が……守ら、ないと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "たった一人で……あのアーツを、押しとどめているのか……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "だが、あれほどの規模だ……受け止めきるのは無理があるぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "たとえアーミヤでも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "彼女のアーツを以てしても、長くはもたん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "そんな……アーミヤさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……問題、ありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私は……大丈夫、ですっ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "みなさんを……守らないと、いけませんから……！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……黒い障壁が……アーツを、阻んでくれてる……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "く……う、ああっ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ま、まずい……！　障壁が燃えていくぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "アーミヤ、もうよせ！！　このままでは、お前の指輪が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――ごめんなさい、ドクター……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "たとえ……そうなったとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それが厄災を招くことになったとしても……そして、私自身がどうなろうとも……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私は、二度と……目の前で、大切な人を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――ふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "良い覚悟だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っあ……ああああっ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "アーミヤ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "くっ……これ以上、黙って見てはいられん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "何をするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "あの厄介な龍のアーツを止める！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "お前、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――「カジミエーシュの光芒よ、この耀騎士が身を捧げよう」！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "っ、ドクター！　早く行け！　我々がアーミヤをサポートする！　だからお前は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "――はァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "う、ああああっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……っ、え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "もう大丈夫だ、アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――Ace、さん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "お前は十分頑張った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "だから、一人で重荷を背負うな。俺たちにも少しは分けてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "アーミヤ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "――ドーベルマン、皆を連れて先に行け！　それと、ニアール！　この場は俺たちに任せてもらおう！　……なに、すぐ追いつくさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……Ace、お前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そん、な……Aceさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っ、絶対に……帰ってきて、ください……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "お前さんは、きっと俺のことを覚えちゃいないんだろうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "俺のほうは、お前のことを覚えてる。昔どんな奴だったのかってこともな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "……いつの日か、お前には……アーミヤと一緒に、この残酷な大地と向き合うべき時がくるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "だからどうか、あの子を守ってやってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "――さあ、行くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "幸運を祈る！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
