{
  "server": "jp",
  "storyId": "act26side_level_act26side_04_beg",
  "groupId": "act26side",
  "stageId": "act26side_04",
  "title": "命を懸けし者",
  "storyCode": "HE-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act26side/level_act26side_04_beg.txt",
  "sourceHash": "ab03565476572b1b40ecbe9fe7d34a17ad90b0174311d2a96ff67530fccbac38",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "少しばかり驚いたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "それは、私がとうとう信仰に背いたからか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "君が逃避を選んだからだ、ステファノ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "何らかの外的な力に影響を受けたかどうかは、私には分からない。だがもしも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "仮定の話など無意味だ、アウルス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "私がアーツの影響を受けるはずがあるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "我々の考えを曲げるものが、常にアーツであるとは限らない。我らに影響をもたらし得るものはあまりにも多いからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "……異教の宣教師よ。私に再考を勧めているようだが、なぜだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "私が下そうとしている決断は、お前の望むものではないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "否定はしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "だが私とて認めざるを得ないことがある。かつて、この素晴らしき建造物がまだイベリアにあった頃、私は幸運にもここで学ぶことができた。あの日々は、当時の私にはかけがえのない時間だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "私はこの場所に愛着を抱いているのだよ。ステファノ、この点に関しては君と同じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "君と一緒にラテラーノからやって来たあの修道士のことも、いまだに覚えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "私の脳裏には、多くの人の姿が焼き付いているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "お前が覚えているという者は、六十年前、銃を手に当時の国教会と共に行く道を選んだ。だが私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "私はここに残り、残った者たちを守ることを選んだのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "君はそれを信念として、今日に至るまで耐えたのだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "お前はそれを分かっていてなお、私に待ち続けろと、耐え続けろと言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "まさかお前は今、これまで自分が説いてきたことを否定するつもりなのか？　その上で私によく考えろと、意志を固めろなどと、そう言うつもりではあるまいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "そうじゃないさ。ステファノ、もちろん違うとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "ただ私は今、己が正しいと思う道を歩んでいる。だから君にもそうであってほしいと望んでいるだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "明日の朝になっても考えが変わっていなければ、それが君の選んだ答えだと判断することにしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "君の求めるものを、私は用意しておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "まだ考えがまとまっていないのなら、よく検討するといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "いずれにしても、君が自分の心に正直に決断を下すことを願っているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "……アウルス、お前は一つ思い違いをしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "何だね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道院司教",
      "text": "私にはもはや、選択の余地などないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "そうか。そういうことなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウルス",
      "text": "歓迎しよう、ステファノ……我が新たなる同胞よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "入ってもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……どうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "お邪魔するね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "落ち込んでるみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……一つ訊いてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "もちろん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……フィーナは、ひょっとして、もう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "もう、死んでしまったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……できれば、違う質問にしてほしいんだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "あなたに嘘はつきたくないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "実は最初から、そうじゃないかとは思ってたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "あの時、突然フィーナの気持ちを感じ取れなくなっちゃって……あの子、あんなに怒ってたし、苦しんでたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "すぐ目の前にいるのに……探しても見つからなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "もしあの時、私が銃を直したりしなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "やめて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……それ以上は言わないで、お願い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スプリア",
      "text": "……分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "……私の頭には今、角が生えてる。ライムントたちと同じような角が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "もう銃を握って祈りを捧げることはできないけど、少なくとも今は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "ようやく、ライムントやカロリンさんたちと同じに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォルトゥナ",
      "text": "みんなと同じになれたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ハッ、去年の今頃はまだ咲いていなかったってのに、今年はやけに都合が良いな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "せめて最後に花を咲かせようってわけか。それも悪くねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "これで……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライムント",
      "text": "これで大丈夫だ……きっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "今……サンクタが堕天したと言ったの？　あのフォルトゥナという子が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "そんなことが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "堕天に関しては……戻って教皇聖下の判断を仰ぐしかないわ。今、私たちだけで解決できる問題じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "だけど、私の部屋に侵入してきたあの招かれざる客については話が別よ。質問には後で答えるわ……今はなによりもまずあれを見つけ出さないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それにはあなたの協力が必要だわ、執行人フェデリコ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "侵入者の機動力は侮れないわ。どうにかここまで追ってきたんだけど見失ってしまって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あら、あなたともあろう人が、すぐに返事をしないなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "珍しいわね。そんな顔をされたら、何か大変なことでも起きたのかと思っちゃうじゃない……あっ、眉をひそめたってことは、もしかして本当に何かあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……チェロの音色が聞こえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "チェロ？　そう……かしら？　何も聞こえないけれど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私の推測では、音の発生源は最上階の聖堂です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "そう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "正直に言うと、もう公証人役場でのあなたの仕事ぶりは理解しているわ。だからあなたの判断には比較的信頼を置いているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "そこであらためて質問させてもらうのだけど──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "中庭公証人役場の執行人フェデリコ。あなたは出処不明で、影響も定かではなく、全くの無害という可能性すらあり得るそのチェロの音色が──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "私があなたに伝えた協力要請よりも重要だと考えているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "いえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "当然、そうでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "チェロの音が聞こえたのは偶然であり、それに対し私はある疑念を抱いています。ですが現状、その音色と今起こっている事件との間に直接的関係性は見出せません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "その状況を鑑みるに、現在優先すべきはあなたに同行し、協力することだと判断いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ふふっ、それが結論でいいのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "はいはい、別にいじめてるわけじゃないの。あなたの考えを確認しておきたかったのは事実だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "今のでもう納得したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それじゃあ、侵入者の向かった先を教えてちょうだい。私は追跡を続けるから、チェロの件はあなたに任せることにするわ。それでどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……本作戦における優先事項は、あなたとオレンの安全を確保することです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "責務を果たそうとするのは美徳だけど、優先順位は自分の頭で判断すべきよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "フェデリコ、私にはあなたの気持ちは感じ取れない。でも他人が何を考えているか推測する術を持っているのよ。共感ができないリーベリの友人がいるから学んだの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あの子とあなたはタイプが違うけど、それでも共通点はあるから、全く効果がないわけじゃないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "これはちょっとしたアドバイスよ──時には、自分の直感を信じなくちゃいけない時もあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "じゃあ、二手に分かれるので決まりね。あまり時間を無駄にはできないから……私も、この身体に鞭打ってでも動かさなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それじゃ行きましょうか。行動開始よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "急ぎます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "フェデリコさん！　ま、待ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "この上に一体……何があると言うのです？　ただのチェロの音ではありませんか。それに今はもう聞こえませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "ほ、本当に一人で行かせても良かったのですか？　しかも車椅子でしか移動できないのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "心配は無用です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "そう言われましても……さっきのあれは化け物でしたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "レミュアンは第七庁の枢機卿から直々にスカウトされて教皇庁に加わりました。その実力は確かです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "彼女を見くびってはいけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "よく分かりませんが、つまりその、とんでもない凄腕だということでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレマン",
      "text": "ですが……万一のことがあったらどうするのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "急ぐか、もしくはここで待つかです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたには後者の選択をお勧めします。その方が安全ですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "（誰もいない？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "（いや、違う。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "がらんどうの聖堂内に小さな音が響く。それに合わせ、弾丸を込める音がした。\n執行人は銃を素早く構えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "出てきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "もう一度だけ警告します。姿を見せなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "あちゃー……見つかっちゃった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "照れ屋な子供",
      "text": "見つかっちゃった。お姉ちゃんの言った通り……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "うん、早かったね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "照れ屋な子供",
      "text": "ほ、ほんとにお姉ちゃんが言ってた、あのお兄ちゃんかな……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "翼も輪っかも真っ黒だし、間違いないと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "text": "お兄ちゃん、ぼくはエレンデル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "照れ屋な子供",
      "text": "あたし、エスタラ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたたちに私のことを話した方というのは、どちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "お兄ちゃん、怖い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "表情が全く動かないし！　それに自分の名前も言わないなんて……失礼だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "ママが言ってた。知らない人に、訊かれても何も答えちゃダメだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "フェデリコです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "怖いフェデリコお兄ちゃんは、良い人なの…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "きっとそうだよ！　お姉ちゃんが物語で言ってたみたいにさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "じゃ、じゃあ、話してもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "いいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "うーん……じゃあ話す……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "あるお姉ちゃんが、教えてくれたの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "すっごい怖い顔してて、お姉ちゃんみたいに真っ黒な輪っかをしたお兄ちゃんが来るから、ここで待ってなさいって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "そ、それに、そのお兄ちゃんなら、あたしたちをママのところまで連れてってくれるって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "そうそう！　それから、あんまり長い間待ってちゃダメだって！　もしお兄ちゃんが来なかったら、自分たちで出て行きなさいって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "うん……ここにずっといちゃいけないって、お姉ちゃん言ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "それから、それから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "二人",
      "text": "わあっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ&エレンデル",
      "text": "お、お兄ちゃん！　あそこ……燃えてるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エスタラ",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレンデル",
      "text": "わわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ひとまずここを離れましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "口と鼻を押さえてください。どうやら火災が起きたようです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
