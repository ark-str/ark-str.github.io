{
  "server": "jp",
  "storyId": "act30side_level_act30side_02_beg",
  "groupId": "act30side",
  "stageId": "act30side_02",
  "title": "同乗異心",
  "storyCode": "RS-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act30side/level_act30side_02_beg.txt",
  "sourceHash": "424e5a94b76557005826f25ba4d0b2dc68c6af211fb7d5221c831cc6ac4b982c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……そのハチミツドリンクさぁ、甘いんだけど後からめっちゃガツンと来るんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "つっても、普通にイケるけどな。私のダチは、私がハチミツ酔いしてるとか言ってきたが、結局最後にはこっちだけケロっとしてて、そいつは先にぶっ倒れちまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あれ？　おーい、おっさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なあ、聞いてっか～？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ううむ……\nおっと、失礼。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "何のお話でしたかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ダチがハチミツ酔いしたときの話だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おお、そうでしたそうでした。ハチミツ酔いの話でしたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……ちぇっ、しらけるぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なんか気になることがあんなら、さっさと片付けてこいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そんなふうに上の空じゃ、何話してもつまんねーじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いえいえ、今はあなたのお話以上に気になることなどありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ハチミツ酔いのお話、どうぞ続けてください。っと、そういえば確か車内でもハチミツ入りの特製ドリンクが販売されていましたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "いいって、嘘つくなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "私の眼は誤魔化せないぜ。さっき帽子被った奴が来たあとから、あんた様子がおかしいだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あいつとは友達……じゃ、ねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "敵同士か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……そうとも言えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "我々の関係性を表すのならば、「同僚」という言葉が近いかもしれません。とはいえ、会社のたとえで言うところの、同じ部門に所属しているわけでもないのですがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ほーん。じゃあ、休暇中にあんまり仲良くねぇ同僚と鉢合わせた感じか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "まさしくそういう感じです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ともあれ、その同僚が首尾よく仕事を進められるかが少々心配であることは認めましょう。ゆえに、お言葉に甘えてしばし席を外させていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "その代わりと言ってはなんですが、ハチミツドリンクをお持ちしますよ。あれの主たる原料はイェラグ特産の高地ハチミツです。一滴一滴がイェラガンドの恩恵であり、混じりっけなしの天然物で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "正直私はもう、そのイェラガンドがどうこう言うキャッチコピーは見飽きてんだけど……マジでいいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ええ、いいですとも。必ずお持ちしますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ですが、ご友人のお話では、貴方はハチミツ酔いをされるそうでしたね。であれば、一つ約束をしましょう。ハチミツドリンクは一日一本まで。旅行中に悪酔いしてはもったいないですからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "我々が睨み合う必要はないでしょう、デーゲンブレヒャー女史。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "公爵様はカランド貿易を気にかけ、イェラグの発展を注視しておられます。それゆえ、この地の各方面に目を配ることが私の仕事なのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "今回もその一環ですので、そう警戒なさる必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "列車の個室を見て回るのもあなたの仕事だってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "この地の変化は驚くべきものです。あなたもそうは思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私の知る限り、このカランド麓から銀心湖へ至る路線で使われている列車は、すべてヴィクトリアから輸入されたものと同モデルですが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "導入された当初に比べ、今や大きく変化を遂げています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ですがここに至るまでにはたったの三年しか掛かっていませんし、カランド貿易の技術的発展には、この件にいち早く関わっていた公爵様も大変感心しておられるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "仮にノーシスがそれを成し遂げていなければ、彼のためにほかの大多数の意見を退けたエンシオディスは頭を痛めていたでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "それで？　そういう技術の話でもしたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だったら、相手を間違えているわね。直接ノーシスを訪ねたほうがいいと思うわよ。彼なら少しは興味を持つかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……私は気になっているのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "この場所で、それもこのような状況であなたにお会いするとは思いませんでしたので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あなたが自ら手を下すほどの人物となると、何者なのでしょう？　その血まみれの手袋を取り換える暇もなかったことを思うと、よほど差し迫った状況だったのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ちょっとしたトラブルを片づけただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "その場違いな好奇心はしまっておくことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "私はただ、ある人を探しに来ただけなの。今のところ、これ以上手袋を汚すつもりはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "失礼、悪気はないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "貴方の行動に干渉するつもりなどございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ですがそうなると、車内には誰かしら重要人物がいるのでしょうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だったら何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "差し支えなければ、教えていただけませんか？　お役に立てるかもしれませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "何しろ、「人探し」は……我々の日常業務の一つですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "何か勘違いしているようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "と仰いますと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あなたたちがエンシオディスの周囲をコソコソ嗅ぎまわっていても彼は黙認しているし、私もそこに文句を言うつもりはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だけど、私自身はそこまで辛抱強くないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "カジミエーシュよりもイェラグのほうが優れている点はどこか、わかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ここは少し寒いけど、その分、虫も少ないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ああいう目障りな羽虫って、ついつい握りつぶしてやりたくなるのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "くれぐれも自制しなさい。でなければ、エンシオディスの代わりに手を下すことも辞さないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……ご忠告痛み入ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "これは警告よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "さてと、無駄話が過ぎたわね。あなたの時間稼ぎはもう十分？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "――ちょうど良かったわ。私が探していたのは、さっきからドアの向こうで盗み聞きしているその人だから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "デーゲンブレヒャー女史――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼が言い終える前に、一筋の冷ややかな白い光がその目の前をかすめた。\n「グレーシルクハット」は制止の言葉を思わず飲み込む。彼が被ったトレードマークのシルクハットは、つばが音もなく切り裂かれ、その下には公爵の密偵が見せた恐怖の一端があらわになっていた。\n女はその手を武器の上へと無造作に置いているようだった。しかし彼女の眼光は、「グレーシルクハット」にはっきりと意識させてきた――\n今この時、自分がまさに猛獣の目に映る獲物となっていることを。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "私も、この列車を廃車にするような真似はしたくないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "二度と同じことを言わせないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "どきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "床に転がって道を譲りたいのなら、それでもいいわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（なんだこの状況は……冗談だろう！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（本物の黒騎士が……手を血みどろにしてるだなんて、ここがカジミエーシュならレアなシークレットキラカードとして発売されかねない事態だぞ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（まさか「グレーシルクハット」のみならず、黒騎士までもがこの列車に現れるとは……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（ああっ、そのうえ黒騎士のご指名を受けた私――ヴィクトリアの子爵まで揃ってるじゃないか。いわばスター揃い踏みとでも言ったところか？　やれやれ、盛り上がってきたな！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（誰でもいいから今すぐに、これは即興ドッキリだと言ってくれないだろうか……！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "リスバーンか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "カランド貿易に妙な動きがないかを即刻確認して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いや、その前に、まずはうちの人員の安否を確認してくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "text": "うちの人員って……駐屯地の奴らなら全員何ともねえぞ。お前を駅まで送ったあとは普通に帰ってきたし、特段異常は起きてねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "text": "ああ、だがそういやジェファーソンたちが飲み比べからまだ帰ってねえんだったな……連絡取れるか、すぐに確かめさせよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "text": "しかしどうしたんだ？　その口ぶりじゃ何かあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "問題はない。今のところはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "私の考えすぎならいいんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "とにかく、まずはジェファーソンたちの状況を確かめて、すぐに報告させてくれ！　酔い潰れて死ぬにしても、起き上がって何か答えてからだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "text": "……わかった、すぐやるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おお、イェラガンドよ。イェラグの民の言うように、あなたに知らぬことなどなく、何処にでもいらっしゃるのなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "今こそ、御業を示す時ではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "誠実な観光客を追いやるような真似はどうかおやめください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "仮に私が良き客人となることかなわぬその時は、好ましからざる客人となるより他にないのですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……ってわけで、今んとこそんな感じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "この辺は電波がちょっと悪いみたいでな。個室は基本的にダメだ。通路ならまだマシなんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ほんと、来る前にオーロラたちに準備を頼んどいてよかったぜ。でなけりゃ今頃そっちに連絡取れなくなってるところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おいおい、私の心配か？　大丈夫だって、ピンピンしてるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おう！　本艦への連絡は任せたぞ。ほかの奴にもよろしく言っといてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "んじゃ、こんなとこだな。もう切るぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "よし。これで大丈夫だろ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ロザリン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おわっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "な、なんだおっさんか、ビビったじゃねぇか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "っつーか、なんで走ってきたんだ？　誰かに追われてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "大変申し訳ありませんが、今はそれをお話しする余裕がなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それにしても、なぜ個室から出ていらしたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "えーっと、ちょっと気晴らししたくてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ダメだったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いいえ。気晴らしであれば何の問題もありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ただ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……残念ながら、やはり説明している時間はないようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "さあ、先に個室へ戻っていて――いや、お待ちを。そうもいきませんね。すでに「グレーシルクハット」は貴方に気付いてしまっていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（それに、奴の「どこかでお見掛けした」という言葉も気にかかる……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "「グレーシルクハット」って、さっきの帽子被った同僚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ええその通り、彼のことです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "実は少々トラブルに見舞われておりましてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "あらかじめお断りしますと、貴方を巻き込むのは大変不本意なのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "私が外している間に貴方が妙な人にナンパでもされてしまったら、良くないことになりますからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "はあ？　ナンパ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そんなくだらねぇ奴なんざ、相手にしなきゃいいんだよ。それでもしつこくしてくんなら、鼻っ柱に一発お見舞いしてやっから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "悪くないですな。次の機会にはぜひともそうなさってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ですが、若きレディの拳を受けても簡単には引き下がらない厄介な手合いも、中にはおりますので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ここは再びエスコートをさせてください。共に先頭の食堂車まで向かい、ハチミツドリンクを堪能しつつ、ついでに厄介なナンパ師をやり過ごそうではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "んーと、つまりは一緒にハチミツドリンク引っ掛けようぜってことでいいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ええ、まさしく。一杯引っ掛けましょうというお誘いです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "それも走っていかなきゃなんねぇんだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はっはっは！　その通り、走って参りますぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ハッ、おまけにそろそろ追手が来ちまうんだろ？　足音聞こえてきてるしよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あんた、追われてるのを少しも誤魔化さねぇんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "言ったでしょう。私は決して、レディに嘘はつきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "いいぜ。あんたらがモメてる理由は知らねぇが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なかなか面白そうじゃねぇか。乗った！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "光栄の至りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "では善は急げということで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "参りましょう！　走りますぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
