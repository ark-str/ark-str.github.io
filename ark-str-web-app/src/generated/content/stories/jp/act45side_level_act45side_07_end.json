{
  "server": "jp",
  "storyId": "act45side_level_act45side_07_end",
  "groupId": "act45side",
  "stageId": "act45side_07",
  "title": "永遠に輝くアルバム",
  "storyCode": "SS-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act45side/level_act45side_07_end.txt",
  "sourceHash": "b71ed72260cc57af8dc5bd0750e2728ce4468c4c1d31de2c5503523ee52dfa61",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お母様、少しここで待っていてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃん、気をつけるのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "大丈夫ですの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "うぅ……大丈夫、大丈夫。ちょっとお尻が痛いけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "一瞬アイリスさんの姿も見えたような……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "む……う……むぐ……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "藁の山の下から聞き覚えのある声が聞こえてくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "くっ……早くアイリスを助けなきゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わ、分かりました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "……ぷはぁっ！　も……もう少しで窒息するところでしたわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "子供たちからお話を聞いて、お願いを集める任務でしたわよね。どうしてこちらにいらっしゃるのです……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "ふふん、仕事が順調だったの。ここの子たちは意外と素直だったから、早めに終わったってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "田舎道を走るのってどんな気持ちなのかなと思ったんだよ。それで運転を代わってもらったんだけど、まさか途中で壊れちゃうなんて……ねぇ、直りそう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "この手の乗り物は修理したことあるから、なんとかなるかもしれないわ。ヴィグナ、やってみましょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "はぁ、今日は運がいいのか悪いのか分かりませんわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "何か起こるのではないかとどこか心配はしていましたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "意外と仕事は順調に終わりましたのに、車の故障のような予想外のトラブルで足止めされてしまうなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "早く動くようになってほしいですわね……そうすれば今晩にはここを離れられますもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "今晩には……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子は後ろを振り向いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少し遠いところから、母が微笑みながら祥子と同僚たちを見つめている。\n母は娘の視線に気付き、軽く首を縦に振った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "あの方は……あなたのお母様ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "そっくりですわね。特に目元と口元の、穏やかでいて芯のある雰囲気が。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……そうでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "あら、祥子さんも芯のある方ですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ですが、わたくしは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アイリスさん、あなたは妖精さんですわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ええ……それがどうかいたしまして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "妖精は人の願いを聞いて、それを夢の中でひとときだけの「現実」にしてしまう……そうおっしゃいましたわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "……そうですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ですが、もし夢の中から出られなくなった人がいたとしたら、どうなさいますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "真の妖精なら、そのような事態を見過ごすはずがありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "あまり夢の中に長く居すぎると、最後には現実と夢の区別がつかなくなってしまいますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "もしそのまま目覚めなかったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "祥子さん、一番の問題は、夢から覚めないことではありませんわ。夢の中の全てを現実だと思い込み、夢から覚めた時に今までの人生が全て幻だったと気付く――それが問題なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "夢の中で幸せな生涯を終えた後、再び現実に帰ってくると、何もかもが振り出しに戻っているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "若い肉体に、老いた魂。夢の中のものを全て失って、たった一人で孤独に生きていく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "そのような夢は、本当に幸せかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "現実で上手くいかなかったからといって、夢に逃げてはいけませんわ。本来出会うべきでなかった人には、きちんと別れを告げなければいけないのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子はもう一度背後を振り返った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "少し話しすぎたかしら……お二人の邪魔をしてしまいましたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……いえ、そんなことありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ごめんなさい。昔、とても大切だった方に、同じことを尋ねられましたの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "あのとき私がちゃんとした答えを返せなかったせいで、取り返しのつかない事態を招いてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "以来、どうしてもその件は気にかかってしまいますの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "おーい――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "車がやっと直ったわよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "ヴィグナ、アンタは一切運転禁止だから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "むぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "あんたたち、早く乗ってよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "祥子さん、あなたもご一緒にお帰りになりますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子はもう一度背後の「母」を振り返った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「母」は何かを待っているように、変わらずそこに立っている。\n祥子が約束を切り出すこと、あるいは決断を下すことを待っているのだろうか。\nただそこに立ち、娘に温かい微笑みを向けていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "大丈夫だよ、祥子。家族水入らずでゆっくりしてて。最近すごく疲れてるみたいだったし、ちょうどいいお休みになると思う。人事部にはあたしから言っておくからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "分かりましたわ……ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "もう一度――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "祥子ちゃん、もうここまでにしましょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "疲れてるんじゃないかしら、紅茶でも淹れてゆっくり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "疲れている……のでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ちょっとお話しましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "さっきの子たちは、祥子ちゃんのお友達？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ええ、皆さんロドスで知り合った同僚で、仲良くしてもらってますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ロドス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "製薬会社で、とても大きな陸上艦を所有してますのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしたちは船で生活と仕事をしながら、この世界の様々な場所に足を運んでいるのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "……世界？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……テラ、ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "面白い言葉を使うのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "そのロドスには、ピアノが弾けるところもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ええ。巡航期間はそれほど娯楽がありませんから、楽器を弾いて過ごすオペレーターもたくさんいますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしもたまに宿舎で小さな電子ピアノを弾いてますの。ヴィグナさんなんて、自分のバンドまで組んでいらして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "祥子ちゃんはバンド、組んでいないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "組んでいますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "そのヴィグナさんと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "いえ。別の方々と……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "お母さん気になるわ。祥子ちゃんとバンドを組むって、どんな子たちなのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ドラムの方は、わたくしと意見がぶつかることも多いですが、とても向上心があって努力を惜しみませんわ。友達と言うより、共に高みを目指す戦友のような方ですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ベースの方は、プロレベルの腕前を持っていますのよ。それに、メンバー全員のスケジュール管理のような裏方の仕事もこなしてくれる、とても仕事のできる方ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ギターボーカルの方は、わたくしの幼馴染で、とても人気のあるアイドルですわ。それにギターも上手で、素敵な歌詞も書いてくれて……忙しい中でいつもわたくしを支えてくれますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "もう一人のギターの方も、小さい頃からの友達で……わたくしが家を出て一人になった時、ずっとそばにいてくれましたわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ふふっ、なんだかとても仲が良さそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "いえ、実は喧嘩が絶えなくて、解散したこともありましたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "まあ、そうなのね。今は仲良くやっているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……皆さんとはぐれてしまいましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "今、メンバーはわたくしには手の届かない場所にいるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "どれくらい遠くにいるの？　ヴィクトリアからウルサスくらい？　それとももっと遠くかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "その……探しには行きたいのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "どうして迷ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "それは……その……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……わたくしが皆さんを探しに行くと、お母様、お父様と離れ離れになってしまうような気がして……。それが怖いのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "もう二度と、お母様と会えないんじゃないかって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "もう、何を言っているの。お母さんはずっとここにいるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "でも、お母様はわたくしを置いていったでしょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "あたたかい体温、はっきりと聞こえる呼吸。\n目の前には、優しい母の瞳があった。"
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ごめんね、祥子ちゃん。お母さん、あなたに嘘をついてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "私は本当のお母さんじゃないって、祥子ちゃんはとっくに知ってたのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ごめんね。お母さん、ずっと本当のことを言えなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "さっきの、高校の入学式のお話も咄嗟に嘘をついてしまって……私の中の祥子ちゃんは、中学生の姿で止まっているわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "今の祥子ちゃんは、楽しそうに笑っているように見えても、どこか辛そうで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ねえ祥子ちゃん、いつからそんな表情をするようになったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "私の知らない間に、一体どんなことがあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "そ……それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ごめんね、何も分かってあげられなくて。一番辛い時に、一緒にいてあげられなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "祥子ちゃんに会えて、お母さんは本当に、本当に嬉しかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "どうしても、あなたの成長をこの目で見届けたかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ステージの前で、あなたのライブも見てみたかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "新しくできたお友達にも……とっても会いたかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "お母さんは欲張りだから、祥子ちゃんのことを全部知りたいし、祥子の傍にずっといたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "だけど私はあなたのお母さんだから、あなたを心から愛しているからこそ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "ここを出て、あなたの本当の人生を見つけてほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "行きなさい、祥子ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "あなたの「世界」に帰りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お母様……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "とどめていた感情が堰を切って、祥子は母の胸に顔をうずめ、声を上げて泣き出した。\n母は昔と同じように、ただ祥子の背中をそっと撫でながら、静かに優しい言葉をかけていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「父」",
      "text": "ん？　祥子、また出かけるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "祥子ちゃんは大事なことをしないといけないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「父」",
      "text": "帰ってきたばかりじゃないか。もう少しゆっくりしていけばいいのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「母」",
      "text": "……清告さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「父」",
      "text": "……うん、分かってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「父」",
      "text": "祥子、お父さんも、お母さんと同じ気持ちだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「父」",
      "text": "（涙声）ただ……その……ご飯はしっかり食べるんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ええ、分かってますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "では……行ってまいります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母&父",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母&父",
      "text": "行ってらっしゃい――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
