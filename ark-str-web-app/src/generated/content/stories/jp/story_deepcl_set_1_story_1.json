{
  "server": "jp",
  "storyId": "story_deepcl_set_1_story_1",
  "groupId": "story_deepcl_set_1",
  "stageId": null,
  "title": "深き青の追想",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_deepcl_1_1.txt",
  "sourceHash": "4929636825859d200013caac65c328b5d23da217278e97652b31a2ef31306030",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "お客さん、うちは午後からなんです。すみませんね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "時間外にお邪魔して申し訳ありません。ただ私は画廊ではなく、店主のあなたに用があるんです……少しだけお話を聞かせていただけませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "こちらは迷惑料です。どうかお受け取りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "（袖の下から金貨を取り出し、ドアの隙間に押し込む）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "なっ……これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "ほんの気持ちです。ご協力してくだされば、それ以上のお礼をさせていただくつもりですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "ああ、お会いできて光栄です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "オホンッ……どういったご用件ですかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "人を探しているのです。先月のことなのですが、命同様に大切にしていた絵画が湿気にやられ、顔料がボロボロと剥がれてしまいまして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "それで途方に暮れていたところ、この地には技巧に優れ、修繕にも長けた画家がいらっしゃるという噂を耳にしたものでね……お心当たりはありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "なるほど……確かに心当たりならありますが、彼女に会うのは少々難しいかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "遠方にお住まいということでしょうか？　金貨ならまだまだありますので、どうか足の手配を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "（袖の下から数枚の金貨を出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "そうではありません。町に住んではいるのですが、相当な変わり者ですから誰も近づきたがらないのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "ふむ。気性が荒く暴力的な方なのでしょうか？　それとも、近寄り難い高嶺の花、といったところでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "いえ……実際のところ、活発で人当たりのよい子ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "では一体？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "……絵のモデルになりたくないからです。変わり者と言っても、家にこもっている間は、せいぜい中からおかしな音が聞こえてくるくらいのものですが……モデルにされるとなると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "彼女の目に留まったが最後、どれだけ逃げようとしても無駄なのです……たとえ大事な用事があろうとも、彼女が描き終わるのをただ座って待つしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "一枚の絵が仕上がるまでに、どれほどの時間を要するかはおわかりでしょう。モデルにされたが最後、丸一日が無駄になってしまうんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "断ればいいのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "断る……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "そうだ……どうして誰も断らないんだ？　なぜ誰一人として……断れないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "なぜ……なぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "ふむ……大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "な、なんともありませんよ……以前彼女が私に言った言葉を思い出そうとしていたんですが、頭が混乱してしまって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "それはまったく奇妙な話ですね……ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "まぁ、元々おかしなことばかり言う人ですから、思い出せなくても問題はないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "ただ、もし彼女がなにか気を悪くすることをしたとしても、どうか許してやってください。きっと悪気はありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "ふふっ、まさかあちらの肩を持つとはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "確かに彼女はおかしな振る舞いが目に付きますが、一度も人を傷つけたことはありませんから。それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "――それに、うちの画廊に飾ってある絵画は半分以上が彼女の作品ですし、お客さんからの評判もすごく良いんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "なんとも精力的な画家なのですね……ふふっ、ますます興味が湧いてきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "やれやれ……そこまで会いたいのであれば、彼女の家まで案内いたしましょう。ついてきてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "こちらの屋敷です。私は画廊の営業もありますし、この辺で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "挨拶だけでもご一緒していただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "それは……色々と準備もありますので、申し訳ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "そうですか。ではここまでにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "（袖の下からたくさんの金貨を取り出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "こちらが報酬です。お受け取りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "い、いやぁ、ありがとうございます！　本当に気前のいい方だ！　他に何かお手伝いできることがありましたら、お気軽に画廊までお越しください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "それでは、さようなら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "え？　はい、ではまた……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "まったく……素晴らしい「隠れ家」を見つけたものだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "本来ならば、今は真昼時の明るい時間帯であった。\nしかしその部屋の扉や窓は固く閉じられており、ただ窓に打ち付けられた木の板の隙間から差し込む陽光だけが、室内が完全な暗闇に陥るのを辛うじて防いでいた。\n部屋の隅の暗がりから、何かが擦れるような音が訪問者の耳に響いてくる。\n訪問者はローブを正してその音の方向へと進むと、巨大なイーゼルの前で、一人の女性が絵筆を持ってキャンバスに色を重ねている姿を目にした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "もっと筆先をぎゅっとして顔料を落とした方がいいってこと？　でもそうすると筆跡がはっきり出るからあんまり好きじゃないんだよね……\nていうかこんな色の出し方、アタシらしくないでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "ほら、これならもっと良いんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "もっともっと色を広げられるはずなんだ……一筆で最後まで塗り切らなきゃ。途中で途切れないように……絶対に、途切れちゃわないように……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "やあ、久しいね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "ん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "あれ、誰かと思えば……まぁ座って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな訪問者",
      "text": "随分と掃除をしていないんだろう。この鏡など、もはや鏡の意味を成さないほどにくすんでしまっている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アハハッ、宣教師さんったら、汚いから掃除しろって苦情かな？　ここにいると数えきれないほどのインスピレーションが湧いてくるんだけどなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "君は何も変わらないね。相変わらず、自分の芸術以外のことは何一つ気に留めていない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "ふーん、でもアンタはずいぶん変わったみたいだね。眉間のしわも随分深くなってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "そうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "何か悩みでもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "まあ、言いたくないなら別にいいけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "……初めて君を見た時も、そうして絵に没頭していたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "……へ？　それっていつのこと？　昔のことなんていちいち覚えてないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "君が使者と初めて会った日……私も岩礁の後ろにいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "へぇ、そうだったんだ……でも記憶に残ってるのは使者さんの美しさだけかな。あんなに美しい生物は初めて見たからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "ああ、使者も君の敬慕の念を感じ取ったのだろうね。たった一度の接触だけで、君を群れに導き、我らの同胞に引き入れる決定をしたのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "……それに関してはずっと感謝してるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "だが君は、海まであと一歩というところで引き返した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "そうだね。弁解するつもりはないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "まさか君は……ただその作品を完成させるためだけに、群れの意思に背き、同胞を傷つけたとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "（指でキャンバスを撫でる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "かくも美しく、それでいてかくも罪深い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "本当に申し訳ないとは思ってるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "申し訳ないと思いつつも、絵筆を止めはしないのだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "はぁ……君はあまりにも頑固で、あまりにも了見が狭い。自らをそのキャンバスの中に閉じ込めてしまえば、遙か先にある未来を見ることもできないというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "群れの意思を理解しようとせず、溶け込むつもりもないのなら……君は狩られ、群れの養分となる他ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "それは君に相応しい結末とも言えるだろうね。残念ではあるが、喜ばしいことでもある……我らはやがて一つとなるのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "（袖口を震わせる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "それ、もう少しだけしまっといてくれる？　終わりが来る前に、これだけは完成させたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "（袖口を整える）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "構わないよ。ここにたどり着くまでに費やした途方もない時間を考えれば、ほんの些細なものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "よかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "ちょうどいい。私からも訊きたいことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "描きながらでよかったらどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "なぜ……我らの下から離れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "群れと共にあれば、永遠の生を得られるだけでなく、互いに深く結びつき、喜怒哀楽のすべてを共に分かち合えるというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "フンッ……アンタたちの言う「分かち合う」ってのは、あらゆる感情を剥ぎ取って、群れの生存の意思を復唱するだけの存在にするってことでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "個人の感情をぶちまけることに意味はないからね。そうしたところで怒りは静まらず、悲しみを消し去ることもできない……そんな感情によって人は、一歩一歩破滅へと向かっていくのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "群れのために、余分な感情は封じ込めるべきなんだ。いつまでも心にわだかまりが残っていれば、群れの存続に悪影響しか与えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "だから君も自らその感情を捨て去り、私たちと共に平穏と安寧を受け入れるべきだったんだ。そうすれば、もう己が感情に左右されることもない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "でもね……いち芸術家としては、自分の悲鳴も、叫びも、怒号も、すべてが創作の種になるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "なにより、アタシがアンタたちに加わったのは、別に平穏とか安寧が欲しかったからじゃないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "では……一体なんのために？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アタシが追い求めてるものはずっと変わらないよ。アンタたちの仲間になろうが、抜けようがね。それは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "美しさ、だよ。永遠の、すべての生命の中に潜む美しさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "それが得られなかったとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "使者の美しさをほんの一瞬目にしただけで君の人生は一変したというのに、それでもまだ足りないと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "そればかりか使者は、君の身体に種を残し、我らの同胞とすることでその美しさを共有したのだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "確かにアンタたちの身体の中にあるのは、あらゆるものを超越する究極の美かもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "でもさ、アンタたちはそれを気に留めたり、楽しんだりしたことはあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "一つ一つの選択が、アンタたちを永遠の芸術へと導いてるのに……アンタたちはその芸術自体には目もくれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "つまりアンタたちは、生存と進化のために、美意識を捨て去ることを選んだんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アタシ自身、群れに溶け込む過程でどんどん麻痺していった。いつの間にか……創作活動もやめちゃって、美に対する喜びも感じられなくなってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アタシがほこりまみれの筆に気付いた時の気持ちなんて、アンタたちにはわからないでしょ……群れから去るのを決意するには十分な苦しみだったんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "なるほど……やはり君は人間の欲望を捨てられないんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "人間が芸術に打ち込むのは、単なる自己表現の一種に過ぎない。そしてその芸術を楽しむことも、自分探しの一環でしかないのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "とどのつまりは、鏡に映る己を憐れんでいるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "なんと利己的で、なんと悲しいことか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "（絵筆を置く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "完成したんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "うん、できたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "青――一面の青か。君も海の深遠さを目の当たりにしたのなら、その小さなキャンバスでは荒れ狂う大波を囲えないことなど百も承知だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アンタはこの中に海を見たんだね……だけどアタシが描いたのは、ただの水たまりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "水の運命は海より始まり、そして最後には海で終わる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "それは水の運命であって、海の運命じゃないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "……描き終えたのなら、そろそろ旅立つ時間だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "せっかくこのアタシが何ヶ月もかけて、寝る間も惜しんで仕上げたんだから、まずは一人目のお客さんとしてよーく味わってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "私たちからすれば、それは一面に色を塗りたくったただの布に過ぎない。何の意味もないものだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "「ただの布」？　違うよ。アタシにはよくキャンバスに囚われてるだとか、本当に偉大なものが見えていないだとか言うくせに……自分はどうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "何だと？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その時、室内のあらゆる物体の表面が剥がれ落ち、次々とその下の色――奇妙な青が露わになっていった。\nより正確な表現をするとすれば、「まるで生物のように周囲の色を呑み込んでいく青」だった。\nほどなくして、その青は室内全体を染め上げた。濃厚な青は窓に打ち付けられた木の板の隙間すらを埋めつくし、陽光を完全に遮断した。\n陽光を失って完全な暗闇に陥ると思われた室内は、かえって異様な明るさを放った。そこにはただ一面の青だけがあった。\nちらちらと不吉にきらめく、殺意に満ちた青だけが。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "ほう……なるほど、これが君の作品の全貌というわけだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "どうやら君を見くびっていたようだ……たった半年で随分と進歩したものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アタシとは出会わなかったことにして帰ってくれないかな。どのみちもう捕まえるなんて無理でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "残念だよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "ご丁寧に絵が完成するまで待たなきゃよかったのにね。狩りと捕食に言葉なんていらないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "というかそもそも、一人で来たのが間違いだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "そうか、そういうことだったのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "私はこの数年、この身に次の変異が訪れないことに悩み、その原因を探ってきた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "今やっとわかったよ……私にも人間の欲望がまだ残っていたというわけだ。私が変異を遂げられぬ原因は、この「好奇心」が故なのだろうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アンタもアタシと同じところで踏みとどまったみたいだね。どんな願いや理想があろうと、人間の名残を全部を捨てられるわけじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "ふっ……嘆かわしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "宣教師さん、もう行ってよ。アンタは真の意味で奴らの同胞になることはできない。だから逃げるしかないんだよ――アタシと同じようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "……いいや。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "――ッ！　まだ諦めないんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "でも、そうやってかすり傷を負わせるのが精一杯でしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "……ちっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アタシの身体に……何をしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "「目印」を刻んでおいたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "私一人では君を始末できないが、それができる同胞もいるということさ。その「目印」は、君が呼吸を続ける限り煌めき続け、同胞を呼ぶ目印となる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "せっかく逃げるチャンスをあげたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "逃げることを選んだのならば、君は逃げ続ければいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "しかし私はもはや人生の末路に至り、これ以上進むことはできないのだよ。ならば永久に、道半ばに留まり続けるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宣教師",
      "text": "そうすれば私の遺体は後に続く者の養分となり、彼らをより遠くに導くことができるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "そっか。アンタの選択を尊重するよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "宣教師の視界に映るすべての青がねじ曲がり始めた。それらはのたうちながら、元いた場所から抜け出し始める。\n大量の粘液が床に飛散し、身をくねらせながら宣教師に接近する。やがてそれらはローブの端を濡らし、そしてローブを伝って上へ上へと這い上がる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一筋一筋の粘液が、宣教師の体をきつく締め上げながら細い線状に収束していく。それは徐々に太さを増して、最後には何本もの触手を形成し、身動きの取れない男を呑み込んだ。\n段々と薄れていく男の視界に最後に映ったのは、憐れむような女性の双眸だけだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "ほんの一瞬道が交わっただけで、アンタはアタシのことを同じ道を歩む同志だって思い込んだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "そして群れから去ったことを、逃げたって決めつけた。だけど本当のところ、アタシはただ分かれ道に差し掛かって、アンタたちの逆側を選んだってだけだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "アタシの道は、まだまだ続いていく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "さようなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "……もうここにもいられないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な画家",
      "text": "誰にも邪魔されない場所はないのかな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "今の物音はなんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "おっと、お前も聞こえたか。家の中まで響いてきたもんで慌てて出てきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "ああっ、あそこの家が崩れてる……絵描きさんの家か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "なんで急に崩れたんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "しかも今日は……外で絵描きさんを見かけてないぞ。もしかしたら下敷きに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "瓦礫をどけるぞ！　急いで応援を呼んできてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "あ、ああ、わかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "おーい、絵描きさん！　いるか！　俺の声が聞こえるか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "はぁ……はぁ……な、何があったんですか……？　い、家が急に崩れたって聞いて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "画家さんは？　それと絵を修繕してもらいに来たお客さんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "質問はいいから！　一緒に瓦礫をどけるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "おい、人を連れてきたぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "何か見つかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "いや、そっちは？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "その他の町民",
      "text": "（揃って首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "何もありません……このままでは、生きているのかどうかすら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "いや、もう二人でここを離れたという可能性も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "人を呼ぶついでに聞いて回ったけど、みんな絵描きさんは見かけてないらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "……！？　こ、これはなんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "……絵かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "変だな……この絵、しばらく土砂と瓦礫の下に埋まってたのに、汚れ一つねぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "それにしても、何が描いてあるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "画廊のオーナー",
      "text": "外にはみ出してる部分だけ見ると、一面真っ青ですね……これは空かな？　それともまさか、海――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "お、おい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "何をうだうだ言ってんだ？　いっそ掘り出して見てみようぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "うわっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する町民",
      "text": "どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "度胸のある町民",
      "text": "何なんだよこりゃあ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "太陽の光に照らし出された男の掌には、ぬめぬめとした薄い粘液がへばりつき、それが無数の糸を引いてキャンバスの表面へと繋がっていた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
