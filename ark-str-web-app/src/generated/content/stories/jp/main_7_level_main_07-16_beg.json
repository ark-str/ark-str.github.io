{
  "server": "jp",
  "storyId": "main_7_level_main_07-16_beg",
  "groupId": "main_7",
  "stageId": "main_07-16",
  "title": "愛国者の死",
  "storyCode": "7-18",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_07-16_beg.txt",
  "sourceHash": "c4a6c18edcfa3dded7e0ffd5aa5062ec58515c1211589759977637ac70840293",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "久しぶりだな、ボジョカスティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "貴方は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "ケルシー、士爵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "何故、貴方は……歳を取って、いない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "盾兵。遊撃隊、そこで、待機。全員ここに、来る必要は、ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "士爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "その話し方……病変は喉か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "いや。ただ、長引いた、結果だ。うまく、話せなく、なっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "士爵……まさか、再び、貴方に会える、とは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "なんとなく、覚えている。私と一族が、離れようと、した時、貴方と殿下は、止めなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ずいぶん昔の話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "当時の、私の行動は、若気の、至りによる、ものだ。全てが、勢い任せの、行為だった。私は、殿下のことを、誤解していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……まだ彼女のことを殿下と呼ぶのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "王は、王だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私がかの地を、離れた時、彼女が、まだ王座に、君臨して、いなくとも。そして今、既に亡くなっていると、しても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "カズデルの君主とウルサスの皇帝を、今でもはっきり別物と考えているのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私なりに、考えは、ある。この考えは、戦争に左右、されるもの、ではない。私が仕えた、者たちは、皆この世を、去った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "私は既に、ウルサスを、祖国と思って、いる。私の陛下も、ウルサスの、広い大地に、還った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "遠い昔だ、士爵。私たちが、離れた時……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "あの頃はまだ、我が一族は、ここまで、没落して、いなかったが、虫の息も同然だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "だが貴方は、変わっていない。歳月は、貴方を、変えられぬのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "いや、私たちは変わったのだ、ボジョカスティ。私はもう過去の私ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ボジョカスティ……何故カズデルを離れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "離れた、理由か……それを言えば、笑われる、かもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "カズデルを、離れたのは、人を殺すのが、嫌だった、からだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "……しかし、それからの、私の一生は、皮肉にも、人を殺し、続ける日々、だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君の意志は世情に左右されず、血管には熱い血が流れ続けている。笑われるようなことではない。君は尊敬に値する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "買い被り、過ぎだ、士爵。私の犯した、殺人について、否定する、ことはできない。確かに私は、大勢の人を、殺した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "士爵、知っているか？　私のこの呼び名が、どういう理由で、つけられた、ものかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君の部下は、君こそがウルサスのために戦う戦士だと思っている。君はウルサスの未来のために、不公平、迫害、暴虐と戦ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そうじゃないとでも言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "（首を振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "たとえ戦いが、必然のもので、正義の名を、冠したとしても、忌々しいものに、変わりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "多くの、虐げられた者、のために、我々は戦争を、起こす。だが、戦争は、また多くの、人を殺す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "戦争が、終われば、もし本当に、終わることが、できれば、我々は全員、死罪だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが、戦争は永遠に終わらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "それでも私は、死ぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "ただ、価値のある死、を望む。感染者と、ウルサスの、今とは、異なる未来、少しでも、マシな未来の、ために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "何度か、同胞に、カズデルのこと、を尋ねた。貴方と殿下は、長く共にいたと、聞いた。彼女は、貴方を信頼、していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "ならば、私も貴方を、信じよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "貴方が、ロドスを、ここまで、導いたのは、血を流す、ためでは、ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリオット",
      "text": "……後ろの、二人から、私の娘の、死の匂いが、するとしても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分と……アーミヤから……？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "パトリオットさん……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "フロストノヴァは自分たちに試練を――",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "いい。それ以上、言うな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ロドスに報復するか、「パトリオット」？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "いや、士爵。そのような、ことを、するつもりは、ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "何故、彼女の、個人的行為の、ために、他人に報復、する必要が、ある？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "あれは、彼女自身が、選んだ道。それが、どこに続くと、しても。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "貴方の娘は全力で戦った！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "彼女は強かった。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "フロストノヴァの意志は固かった。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼女は我々を認めてくれた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "黙れ。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……何？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……パトリオットさん？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "あの子の、年齢では、誰彼構わず、無闇に信頼を、寄せるような、愚行を犯して、しまう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "事実、私たちが、信じてきた、ものは皆、最終的に、馬脚を現した……全て、善人の、皮を被った、悪党だった。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何だと……！？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "でもパトリオットさん！　フロストノヴァさんは、アーツも、自分の命までも、全部、全部……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "彼女は全てを投げ出してまで、自分自身を……その怒りを、理想を証明しようとしたんです！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "彼女の命には価値があるんです！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "言うな。君にそんな、ことを、言う資格は、ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "（アーミヤ、やめるんだ。これ以上は言うな。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "君に、何が、わかる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "娘の病が、重症でなければ、諸君を、簡単に殺せた。鎌で稲穂を、刈り取るよう、に。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "だが、諸君と娘の、間に、何が起こった、のかは、興味がない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "そんなことは、どうでもいい。何の証明にも、ならない。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "タルラが、この中枢区画を龍門にぶつけようとしてるんだ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "そして、この移動都市が、ウルサスの領土、だと、主張している、のだろう？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "なぜそれを知っている！？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "…………",
          "value": "2",
          "blocks": []
        },
        {
          "label": "わざわざ教える必要はなかったようだな。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "パトリオットさん……じゃあどうして……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "策略家の、やり口は、幾つも、知っている。そして、策略家の、考えは、どれも大して、変わりがない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "だが私は、道を譲る、わけには、いかない。レユニオンは、自壊しては、ならないのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "私まで、裏切り者に、なっては、いけない。私が裏切ったら、全ての感染者、全ての、闘争から、大義が失われ、敗北に、終わる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "タルラが、既に、狂気に陥って、いるとしても……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "感染者たちに、どう伝えると、いうのだ？　私たちを、導く者は、狂人、あるいは、裏切り者だ、と？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "かつては、正しかったが、今は、間違っている。今まで、従っていた者を、処刑しろ、と？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "未来の、歴史書の、レユニオンの、説明に、「感染者が、内乱を、起こし、後に、消滅」、などと、記される……そんな、ことは、許さない。許すわけには、いかない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "だがその前に、レユニオンは自身の重みを支えきれなくなるのだ。既にタルラは、裏でレユニオンを内部分裂させてしまった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "貴方の、言う通りだ、士爵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "だから、貴方はここに、来ている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "私は、あらゆる敵と、向き合う準備が、できていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "だがまさか、その敵が、結局、感染者だとは。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……本当にそう決まったと思うか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ボジョカスティ……君には命を投げ出すという選択肢以外にも道はあるはずだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "選択肢？　私の選択は、一つのみ、だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "貴方たちを、殺す。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "パトリオットさん、今は無駄な犠牲を増やすべきではありません。この戦い……フロストノヴァさんの時と違って、どちらが負けても敵の思惑通りになってしまいます！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "違うな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "コータス人の、娘よ、これは、戦争だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "私にやめろと、言うが、何故私が、やめなくては、ならない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "あまりに、多くの戦争を、経験してきた。ウルサスの、ウェンディゴとして……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "野蛮な種族、骨肉を、食い尽くす、畜生の、群れを、我々は、浄化した。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "生臭い、手足、百の眼、千の指、醜い怪物を、我々は、殲滅した。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "ヴィクトリアの、蒸気の甲冑。カジミエーシュの、銀槍の天翔馬。ラテラーノ城の、教皇が擁する、銃騎士。無数の戦士に、我々は、全勝した。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "しかし、我々は、自身には、勝てない。帝国の、貪欲さには、勝てない。同胞の死には、勝てない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "我々、ウェンディゴは、サルカズの中で、最も死に、近い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "貴方たちは、私の娘に、死を与えた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "この大地には、死よりも、残酷な運命が、ある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "何故私は、戦いを、やめるべき、なのだ？　人としての、道徳を、誰が私に、求めている？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "私は、正義だと、評されて、いるから、素直に、受け入れる、べきだという、のか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "私は、運命に、弱者とされて、いるから、全てを、受け入れる、べきか？　それとも、強者と、されているから、全てを、背負うべきなのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "裏切り者、反逆者、虐殺者、守護者……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "呼び名など、全て、「パトリオット」と、同じ、ただの、戦争の、残滓だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "ロドスよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "諸君は、私の娘を、殺した。私も、諸君を、殺す。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "報復のため、ではない。復讐心など、私には、ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パトリオット",
          "text": "私の娘は、抗うことを、諦めた、だけだ。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "違う！",
          "value": "1",
