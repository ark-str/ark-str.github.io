{
  "server": "jp",
  "storyId": "act35side_level_act35side_08_end",
  "groupId": "act35side",
  "stageId": "act35side_08",
  "title": "黄砂の果てに",
  "storyCode": "AS-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act35side/level_act35side_08_end.txt",
  "sourceHash": "85abee46a5f2d091c826cfcd2b170d0c0f89600b573e17ad0717ca33c3d3559c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "今度はどこなんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "滝！？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "滝のそばで、先ほどの男の子が下を向き、何かを洗っている。\nペペは足早に近づいて、男の子の注意を引こうとした。だが、その子はいくらか背が伸び、顔からはもう子供らしい幼さが抜けていることに気がついた。\n今の彼はすでに少年になっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ほら、君が誰だっていいからさ、もう十分だ！　早くここから出して……って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "怪我してるの？　君の顔……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した少年",
      "text": "姉様、心配いらないよ。ほとんど敵の血だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した少年",
      "text": "戦場の状況は想像以上に複雑だった。でも奴らは余の敵じゃなかった。ちゃんと勝ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "ズバイル、アルサランのジャングルの霊殿であなたのために護符をもらってきたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "あなたが傷つくことがないよう、これが守ってくれることを願っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した少年",
      "text": "余は怖くないよ、姉様。受けた傷は全部成長の証だからね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "下を向くと、ペペはひざまずく少年の膝の横に一本の長剣が横たわっているのを見た。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "幾筋かの血が刀身を伝って池の水に流れ込み、水面がピンク色に染まる。\nペペが振り返ると、背後の少女は口元に優しい笑みを浮かべているが、その目には憂いをたたえていた。\n彼女がまた前を向くと、周囲の景色が再び変わっていることに気づく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジャングルの中、少年が短剣を掲げ、それをひっくり返したりしてじっと見つめ続けている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "おめでとう。明日からは父様の護衛部隊を指揮することになるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "あなたが夢にまで見た地位でしょう？　どうしてちっともうれしくなさそうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた少年",
      "text": "余にもわからない。でも余がしてきた努力と苦労に比べたら、この指揮官の短剣は少し軽すぎるように思うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた少年",
      "text": "姉様は？　喜んでくれないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "ズバイル。あなたがうれしくないと私も喜べないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた少年",
      "text": "姉様は書物に数え切れないほどの時間を費やしてきたよね。そこに何か見つけられた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "ズバイル、サルゴンの歴史は私たちが想像するよりはるかに悠久よ。でも現存する写本や記録ではいずれもそれらを完璧に記述できていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "だから史書を編纂して、抜け落ちた前時代の事跡を記録するつもりよ。できることなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた少年",
      "text": "できることなら……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "できることなら、それをサルゴンの歴史が漏れなく記されたものであるようにしたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた少年",
      "text": "きっと長い文章になるだろうね……たくさんの人について書くことになるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい少女",
      "text": "父様は私の考えを認めて、援助すると約束してくれたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた少年",
      "text": "そうか。よかった。姉様も余もどっちも自分の望むものを手に入れたんだね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "少年が短剣をしまい、姉に対して笑みを浮かべた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "また別の場所？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "今度はいつのことなんだ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ズバイル……なぜ浮かない顔をしているの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "あの東方より来たクランタが、父様を別人に変えてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "これまで幾度各部族の反乱や挑戦が起きようと、父様の顔色が変わることはなかった。繰り返し繰り返し、父様は部隊を整え、旗を掲げた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "父様の長剣に切り伏せられた敵の首から噴き出した血をもってしても、父様のマスクの奥の冷たい視線をほんのわずかでさえ溶かすことはできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "だがあのナイツモラ……父様と彼が戦った時、武器がぶつかり合い、放たれる火花が父様の瞳の炎を焚きつけたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "父様がかようなまでに一人の人間を熱心に注視するのは見たことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ズバイル、わかるわ……私たちの父様はこの国に対する情熱がとうに薄れてきているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "気がかりな噂を聞いたの。父様はハランドゥハンを出迎えて、共に南へ軍を進め、そこの形なき敵に挑みに行くつもりらしいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "あなたも行くよね、ズバイル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "……例の気味の悪い敵はすでに我々の土地を一歩一歩と侵している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "シャア……君たちはシャアの子供なんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "青年の視線に沿って遠くを眺めると、突然、はるか遠くの土地が引力によって目の前に引き寄せられた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ペペは草一本すら生えない砂漠を目にした。風に混じる砂粒が彼女のまぶたをはたく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……フェーンホットランド……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "何が起きたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ズバイル、気分はどう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "余は問題ない、姉様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "すぐに薬を取り換えてあげるわ。包帯を外す必要があるけど、我慢して。すぐに終わるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "痛くはない、大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "痛くないはずないでしょう。運び込まれた時、あなたは全身黒焦げで、無事な皮膚なんてどこにもなかったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "私はどうしたらいいの、ズバイル……父様は行方知れずで、あなたは私の最後の家族なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "兄様がすでに即位したけれど、私たちとは腹違いだから、彼はあなたの軍での功績を恐れている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "あの史官は……姉様に良くしてくれているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ええ……あの方の協力のおかげで、史書の編纂も半分近く進んでいるわ。私の生きているうちに完成させられるかもしれないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "あまり無理しないでほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "これは父様との約束……たとえ私がやり遂げられなくとも、お腹の中の子が継いでくれるわ……いつの日か、今この瞬間に起こるすべてを史書が後世の者に伝えることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "それは遥かなる時を隔てて一本の橋を架け、記録された人物と読み手とが長い歴史の川の中で互いに知り合うのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "兄様たちは父様の遺品を埋めた墓を建てると聞いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ええ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "父様は去る前、世の貴重なもので満ちた宝物庫の場所を教えてくれた。父様にはナイツモラの末裔を待ち、そこにあるすべてをその末裔に与えるよう言われた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "兄様が知ったらきっと喜ばないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "姉様、貴女は筆にて父様の言動を記すことで父様を偲び、余は父様が残したすべてを守ることを選択したのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "父様が去ったばかりであるのに、すでに南西部の各部族が再びのろしを上げた……誰かが鎮めに行かねばならぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "あなた……こんな状態でどうやって行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "アルサランからやってきたとある宝石職人曰く、特殊な回路を刻んだ宝石を用いて余の意識を保存できるらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "そして不死隊を作った職人たちも別の肉体を製造してくれると言った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ズバイル、あなたはとっくに決意を固め終わってから、私に話をしているのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "姉様、余は永遠にベッドの上で寝ているなどできぬ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "ズバイル、私はただあなたに幸せであってほしいだけよ。ほかに望むものは何もないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい女性",
      "text": "この言葉を決して忘れないと約束して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた青年",
      "text": "わかった、約束する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（ここは……どこなの？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（暗い……誰かいるの？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（ど、どうして声が出せないんだ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（くそ、全く動けない。手足を縛られてる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "準備はいいか？　脳を取り出すぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（脳？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "麻酔薬を追加するんだ。脈拍がまだ速い。落ち着かせる必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（誰の脳を取り出すつもり！？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "目の前の遮蔽物がどかされ、光が外から差し込む。ペペは自分が石の台の中央に寝かされていることに気づいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "周りでは人が行き来し、彼女の体にどろりとした刺激臭のする薬を塗りたくる。体は湿った麻の布できつく包まれている。これこそ彼女がずっと動けなかった原因だ。\n観察を続ける間もなく、ペペは一人の老人が細長いナイフを持って近寄ってくるのを見る。本来パニックに陥るはずだった彼女は薬の作用でむしろ段々と気持ちが落ち着いていた。\n彼女は頭を押さえつけられ、刃がゆっくりと額に当てられるのを感じる……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（これはズバイルの体験？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（意識を引き抜かれる時……彼はまだ生きていたんだ。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "終わったの？　これが君が見せたかったものなのか、ズバイル？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "教えてくれ、このあとに君は何を経験したの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "君はそうして千年近くの歳月を待っていたのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ズバイル、教えて。君の長い一生の中で、きっと耐えがたい苦しみを味わっただろうけど、君は一瞬でも自分の姉を、そして父を忘れたいと思ったことはあるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それが私の答えでもあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "――忘れるべきでないのなら、ずっと覚えておくんだよ。たとえそれに苦しみが伴うとしてもね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "戻って……きた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巨大な猛獣も、湿ったジャングルも、灼熱の砂嵐もない。\nあるのは通りの真ん中にしゃがみ込み、自分の毛をそっと舐めている一匹の小動物だけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "どうして私をズバイルの記憶の中に引き込んだんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "これはズバイルがお前に課した試練さ。合格しなければ、奴に会うことはできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "さっき幻の中で私と受け答えをしていたのは彼かい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "いいや、あれは僕だよ。でも質問は確かに彼が用意していたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "なら私は合格かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "不合格だね。どこへなりと消えちゃえばいいよ、小娘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "でも彼は幻の中で私の答えに満足してなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "してない、そんなのはお前の錯覚だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "でもどうしても彼に会わないといけないんだ。街の騒動の原因だから、止めることができるのはズバイルだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それに……黄金の都市に入るには、彼の助けだけが頼りなんだ。この最後のチャンスを諦めたくないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "バカな小娘だな。黄金の都市に行って史官になることがいい仕事だとでも思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "王のそばに仕えるから、秘密を洩らさないようにって、あいつらはみんな舌を切り落とされちゃうんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "史官が記述するのは諸王の王が記述することを望むものだけだ。そこに行ったら、お前はお前自身じゃなくなって、王の代弁者でしかなくなるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "本当にそんなものになりたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "そんなことどこで知ったんだ？　黄金都市は君のような動物が勝手に行けるような場所じゃないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "これだからバカだっていうんだよ。僕が飼ってた最初の人間は、ルガサルグスの娘なんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "あの可哀想な娘が自分の兄に舌を切り落とされるのを、この目で見たんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "何だって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "その辺にしておきなよ、ミオ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "彼女はすでにズバイルの試練に合格した。これ以上は余計なことを言わないで、行かせてあげるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "彼は三つ目の路地の奥から二番目の家屋にて君を待っている。入ったらまず左側のドアを三回ノックし、それから右側のドアを直接押し開けるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "そしたら彼に会えるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "ワオ！　こいつは試練に合格していない。何を勝手なこと言ってるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "彼女は合格したろう。これ以上いちゃもんをつけてはいけないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "不合格だ！　僕が不合格と言ったら不合格なんだ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "バカワオ！　お前まさかこの娘があんな風になるのを黙って見てるつもり……\n放せ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワオ",
      "text": "わたしらの任務は終わったんだ！　早く行くよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "ニャオ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ミオの首の後ろをくわえると、ワオはそのまま路地に引きずり込む。ペペに残されたのは砂ぼこりの中の引きずられた跡だけだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ふぅ……三つ目の路地の奥から二番目の家屋……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "まずは左側のドアを三回ノックして……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それから右側のドアを直接押し開ける……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "また会ったな、ペペ殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ちょっと気になるけど、もしあの動物の言葉に従わずに先にノックしてドアを開けてなかったら、それでも君に会えたのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "実際のところ、そなたがどのドアを押し開けようと余には会える。重要なのはそなたが会いたいかどうかである。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ズバイル、私はハンマーを持って君に会いに来たよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "武力で余を脅迫するつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "使わない保証はできかねるかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "時間がないんだ。質問に答えてほしい。嘘はつかないでくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "問うがいい、ペペ殿。誠意をもって全てに答えよう。されど余はそなたの脅しに屈しているのではなく、答えたいから答えるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "君はもう四つ目の宝石を見つけたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "左様。余のためにこの貴石をずっと保管してくれていた者がいた。その一族が代々受け継いできたのは、いつの日か余が目を覚ますのを待って、貴石を返上するためであったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "では君は、その宝石を手にするなり都市全体を滅ぼすことに決めたの？　外はもう貴石の使いのせいでぐちゃぐちゃだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "ペペ殿、都市で起きたことは申し訳なく思う。されど余はそうせねばならない。これが余の責務なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "「四つ目の貴石は肝臓を表す。我らは職責と義務のために、明瞭な意識でもって夜に向かう」、君の責務に関する記憶はついに全て戻ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "左様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "シャアの宝物庫は一体どこにあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "我らの足元、ミナトハマイの下だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "この都市の確立、豊かさや繁栄は、すべて父様が残した無尽の宝に依存していると言ってもよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "父様が去った後、余は父様の墓を宝物庫の最深部に建てた。この宝物庫は父様の陵墓でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "数百年の時間の中で、人々は地底を掘り続け、陵墓の中で獲得した遺産や宝はすべてこの都市の養分となった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "これは余の失態だ。されど今ならまだ遅くはない。いまだ挽回の機会はある。彼らはまだ最深部の……決して他人が触れることの許されぬ宝には至っておらぬのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それは一体何なのさ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "焦るでない、ペペ殿。まさにそれこそがそなたに見せたいものだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一筋の陽光が窓から差し込み、ズバイルの足元を照らす。\nズバイルが杖を高く掲げ、杖の先端のシストラムはどこからか起こった狂風に吹かれ、澄んだ美しい鈴の音を発した。\n鈴の音と共に、ズバイルが何故か耳に懐かしい歌を口ずさむのをペペは聞いた。だが歌詞の意味はとても難解だった。\n続けて、少女は自らの足元の硬い地面が柔らかくなるのを感じた。それは流れる砂地のようで、彼女のくるぶしは早々にその中に深く沈んでいた。\nズバイルの歌が終わりに至ると、彼は杖を重々しく地面に突き刺した。\n一瞬のうちに、砂塵が辺りに巻き上がり、二人の姿を覆った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "水！　水を持ってきて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "早く！　アナト館長が無理やりに話し続けたせいで、熱中症になったわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "悪いニュースだ、メジェティクティさん。博物館はとっくに断水しているよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "正確には、今はどの蛇口からも砂が流れていて、止まらなくなっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……あなたは博物館の職員だったかしら？　見覚えがないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "いえ、待ってよ。すべての蛇口から……砂しか流れない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "その通り。ついでに、これはあたしたちがここに来た時、あなたの職員から渡しておくよう頼まれた休暇申請と本の山ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "彼がどこへ行こうとしていたかは知らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "川の水は今非常に濁っていて、くむことができず、付近の浄水路も砂で満たされている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "全部たった今あたしたちが来る途中で起きたことだ。まるで洪水が堤防からあふれ出すみたいな速さだったさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ははっ、まさに湛水祭だ。あふれ出てきたのは砂だけどね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……あれ？　どうして黙り込むの？　そんなにつまらなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "アナト、アナト、早く目を覚まして！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "わ、私たち……死んじゃうわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "今日はこんなにたくさんのことが起きたっていうのに、今さら死にそうなことに気づいたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "メジェティクティさん、具体的な状況を教えてくれるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "簡単に言うと、もしこの都市のすべての宝石が取り外されたというのなら、川の中の浄水用の宝石も例外ではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "大量の宝石が取り除かれれば、浄水システムは停止し、圧力が変化して、砂が逆流することになってしまう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "……このままだと、貴石の使いには石柱と壁を築き、都市の現在の姿を破壊できるだけの材料が絶えず湧き続けます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "それにティティ、もっと最悪な状況を懸念しています……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "これほどまで急激な圧力の変化は古代の地下河川にダメージを与えるんじゃないかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……本当は口に出したくなかったのよ、アナト。言ったら本当になっちゃうかもしれないじゃない！　今は本当にこの都市が恐ろしくなってきたわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "続けて。地下河川がダメージを負ったとする、そしたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "大量の水が浸透すれば、ここら一帯の砂地は柔らかくなり、流砂になってしまうわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "そうなったら、都市全体が沈み、使いでは消化できない現代材料が砂の深くへと埋もれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "それに私の推測だと……使いは何の理由もなく通りに柱や壁を建てているわけではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "記憶の中のこの地の光景を復元しているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "そして私たちの全員が、数百年の都市文明の痕跡ごと砂の下に埋もれるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "……もう少しわかりやすく説明する必要がある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いや、完全に理解したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "この都市が砂に埋もれたら、あたしたちは死んで、あなたたちも死んで、あたしの手下も死ぬ。",
