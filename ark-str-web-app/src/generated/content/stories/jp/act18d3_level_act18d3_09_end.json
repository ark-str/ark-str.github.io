{
  "server": "jp",
  "storyId": "act18d3_level_act18d3_09_end",
  "groupId": "act18d3",
  "stageId": "act18d3_09",
  "title": "信仰者",
  "storyCode": "SV-9",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_09_end.txt",
  "sourceHash": "20a32014329988e7d18dfd2d4d9ba93eda6939e5a18d932327df9552a63d6d56",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "どこもかしこも、ひどい水漏れだこと。「それ」を仕留めたら、この場を離れましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "ナぜ、あなタたちのよウな……愚かな凡人ガ生き長らエ……なゼ、私のようナ、為すべキことに命ヲ投げ打チ、偉大なル目標にすべテを捧げてキた者ガ……失敗するノ、ですカ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "エーギルの、盲目なル、家畜どモめ……あナたたちは、科学に、そシて未来に対しテ……何の利益モ、もタらすことはナい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "私は……真理に近付いテ、いた！　なゼ、私が……こコで死なネばならナいのです！？　アなたたちはナぜ……然るべキ厳刑かラ、逃れらレるというノですカ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "こコに至ルまで歩みヲ止めズ、私ノ意志と肉体は、人体ノ束縛を引キ裂こうトしてイたのに！　なゼ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "ナぜ？　どウして！？　なゼだ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "お黙りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "エーギルは……間違いなク、滅びヲ迎えル。あなタたちには何モ……何も、残りハしナい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "どこまで愚かなのかしら。生きていく限り、私はエーギルなのよ。私が生きている限り、エーギルは生き続けるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "……あナたは……しかシ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "皮肉ダ……皮肉なもノです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "アなたは違うデしょう。アア……あなタは、違う運命にあル……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "あナたは、わかっテいルはず。アなたの運命ハ、定められていル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "無駄話はやめて、大人しく死になさい。あなたのためにこそ「申し上げてますのよ」。心の底から、真心をこめてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "呪っテやる……呪ッてやル……陸が海に飲マれルその日まデ……あナたたチは塩粒ノ如く海かラ逃げおオせたとシてモ……最後にハ、再び海によッて溶かサれるこトでしょウ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教？",
      "text": "アなたたちノ骨が積み上ガる、痩せこケた荒野デ……私たチのやまナい潮騒が、青白い夜空ノ下、大陸ヲ海に沈めルのダ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "やっと死んだわね。これでようやく一件落着ってところかしら……それにしても、自分の手で「あれ」を殺したっていうのに、思ったほど嬉しくはなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "彼らの仕打ちに比べたら……これくらいじゃ軽すぎるもの。一人殺したとはいえ、まだ二人も残ってるわけだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "はあ……頭が、ちょっと……くらくらしてきちゃったわ。どうやって……ここまで来たんだったかしら……？　なんだか、ずっと夢でも見てるみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ちょっと……サメ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "結局……ずっと目を覚ましてはいられない、ってことみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "私たちは、奴らの尻尾を掴んだのよ。あとはそれを手繰り寄せて、奴らを根こそぎ始末すれば……きっと、あなたを治す方法も見つかるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "心配しなくても大丈夫よ、平気だから。今なら彼らにコントロールされることもないし……それにね、今すごくいい気分なの。自由って、こういう感覚なのね……気持ちよく浮いてるみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ところで、隊長？　あなたたちの話、私にも全部聞こえちゃってたんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "「あれ」は、私たちもシーボーンになる、って言ってたわよね？　もし隊長がそうなっちゃったら、すっごく強いんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あいつらとは違いすぎるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……私の独断的な行いが、あなたたちを傷つけていなければいいのだけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そうね……ところで、いくつか質問に答えてくれるかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ええ、何でも聞いて頂戴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "本当に……私たちの体には、シーボーンの血が流れているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ええ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたがここへ来たのは、スペクターの身体の問題……その原因を特定するため。そしてあなたが敢えて攻撃を受けたのは、シーボーンが私を探していた理由を探るため……合ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "どちらも、その通りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ここにいるシーボーンが、司教だけじゃないことも知ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "勿論。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あの自殺じみた決戦の最後に、私が何をしたのかは知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "いいえ、知らないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私たち……勝ったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "さあ、どうかしら。わからないわ。私はエーギルとの繋がりを失ったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……エーギルにとって、私たちは捨て駒なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "いいえ、捨て駒などではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そう。それじゃ、行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "切り替え早いわね、気持ちいいくらいだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あれこれ悩んでも無駄でしょ。私はアビサルハンターだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……まさか、第二隊の人はそうじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "アビサルとは、皆そういうものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……ここはもう崩れるわ。それに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ちょっと……多すぎじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "ほらほら、スカジ！　もっと踏ん張って！　無事なあなただけが頼りなのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "何をどう踏ん張れっていうのよ……私だって手が痺れてるのに。そう言うそっちこそ、もっと踏ん張ったらどうなの？　あなたが最後に奴らの口から手を突っ込んで真っ二つにしたのはいつかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "私は三秒前だけれど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ああ、ちょうど「今」になったところよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "まずいわね。あの死体がここにある限り……恐魚は止まらないわ。あいつが引き寄せ続けてる……奴らのアンカーになってるのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "埋めるだけじゃダメそうね……死体を壊しちゃわないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "なら、私が行くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "text": "その大穴が空いた体で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "平気よ。だから、あなたたちは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "走れ、ハンターたち！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "どうしてあなたがここに！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "話はあとだ！　Mon3tr、行け！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
