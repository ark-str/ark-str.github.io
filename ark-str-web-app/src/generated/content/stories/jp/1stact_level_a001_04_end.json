  "storyId": "1stact_level_a001_04_end",
  "groupId": "1stact",
  "stageId": "a001_04",
  "title": "共犯証言",
  "storyCode": "GT-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/a001/level_a001_04_end.txt",
  "sourceHash": "f09aabe56258f76e84713a7f3891fd0efdc049fdfce43f9009b2529ffe01941a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ぐっ……やつらめ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "こいつは脚を怪我してる！　こいつから先にやっちまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "グラニ嬢ちゃん！　このままだとここで消耗しきってしまう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "そんなこと言っても！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "キャロルを連れて先に行け！　早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "怪我をした私と一緒だと足手まといになる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "後で何とかして私も合流する！　だから早く行け！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "わかった、じゃあ約束だよ。君の取分を残しておくから…必ず後で合流だからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……フッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "さぁ、行くんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ガキどもが逃げるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "おい、待てよ。お前たちの敵はこの私だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……戦いの音が…収まったみたい…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "でもキャロル、ちょっと大変だけど休んでる時間はないみたい。急ごうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "私は大丈夫……でもボブさんがどうなったのか心配で……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "たぶん…大丈夫。時間が必要なだけだと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "時間が必要……？　それはどういう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "キャロル！　大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "ごめんなさい、木の根につまづいちゃって……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "大丈夫？　はい、あたしの手をつかんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "歩ける？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "……大丈夫、かすり傷だから。グラニが言った通り、はやく行かないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "この森を抜ければ、もうモティカ山の麓。そこから山の中腹にある2つ目の洞窟に入るの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "入り口はその洞窟だけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "ええ。中は分かれ道だらけで、しかも隠された道を通る必要があるけど、私は進み方を知ってる。財宝は洞窟の最深部に眠ってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うん。それなら……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "きゃあ！！　な、なんなのこの音……遠くで何かが爆発した……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "これは……爆発音に叫び声と悲鳴も混ざってる…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "誰かが戦っている音だね……。まだ終わってない…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……キャロル、怖い？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "私――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "……すごく怖い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "でも、私はどうしても村の平穏で静かな生活を取り戻したいの。そのために私もやるべきことをやらないと……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "そうだよね…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……キャロルは強いんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "えっ？　なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ううん、なんでもないよ。さぁ、進もう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
