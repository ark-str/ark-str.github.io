{
  "server": "jp",
  "storyId": "act15side_level_act15side_05_end",
  "groupId": "act15side",
  "stageId": "act15side_05",
  "title": "荷と人と",
  "storyCode": "IW-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15side/level_act15side_05_end.txt",
  "sourceHash": "fbb38624066cb5b16921053105839b901a6c0ec547b9b5ac6b068238450d0a16",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "5下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "正午茶を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "はいよ、シャンの旦那！　すぐにお持ちしますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "今日は登ってくるのが随分と遅いじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "朝っぱらから昔馴染みに会ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ほお。再会はどうでした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "……あんたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "いやはや、今日もまたお会いできるとはねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "どうした、まだ東屋を探しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ある程度見当をつけてもらってだいぶ楽にはなったんですがね、おれが探してるのは人であって東屋ではないんです。だからちーと難儀なんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "そっちに座ってるのは、あんたの恋人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "……なっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ゴホンッ、おれにそんな度胸はありませんよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "ほう、もしや娘さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おれが親なんてやってる顔に見えますかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "それもそうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "ちょっと！　あんた今何て！？　あたしとこの龍門のペテン師が何ですって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "男女が春先のこんな時間に登山だなんてな、暇でやることない奴らと相場が決まっているのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あたしは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "シャンの旦那、正午茶だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "正午茶？　まだ昼じゃありませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "尚蜀の山を行く担夫なら、中腹や麓の茶館で茶を二回タダで飲めるからな。午前には正午茶、午後には日没茶、しかもちょっとした料理付きだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "タダで飲む茶は、きっと美味いでしょうねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "茶は茶だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "けど山の上ですよ？　茶の値だって下に比べりゃ張るもんです。タダだっていうなら、なおさら儲けもんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "あんたは計算ができる人だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "けどなんでまた、そんな親切なんですか？　みなさん慈愛に溢れてるとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "お役所が補助してるに決まってるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "……知ってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "うちも飲食業やってるのよ、もちろん知ってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "……ほう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "尚蜀の役所はそんなに面倒見がいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "リャン様が就任してからずっとこうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "前任の人たちは土木事業を重視して、山林開発を進めてたの。都市を復興させただけでなく、より活気ある街にした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "それを引き継いだリャン様は、インフラはそこそこ整ったと考えたんでしょうね。民心を安定させる政策に重点を置いたの。こういうお茶とかは、その中でも最も些細な政策よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "……若いのによくわかってるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "父が商売やってるもんでね、見聞きしているうちに覚えたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "いい父親を持ったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "ごちそうさん、俺はそろそろ行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "じゃあまた、シャンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "text": "またな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "――ちょっと！　どうして彼があの酒杯を持ってるのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "さぁねぇ。でも全く隠すつもりはないみたいですよ。あんな大っぴらに腰にぶら下げるとは、まるで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "取りに来いとわざと誘ってるみたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……まぁいいでしょう。おれたちも茶でも飲んで、事の成り行きを見守るとしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "店員さーん、お茶二つと爛肉麺（ランローメン）も二杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あたしは食べないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おれが二杯食いますとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "はいよ、お茶お待ちどう。麺は少し待っておくれ、今日は客が多いんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "どうも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "グォ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "どうしてここまでついてきてるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "ヴゥ……グォッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "ねぇ、リー、一つ聞くけど、笑うんじゃないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "その茶壺、もしかして自分で動いてるの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "爛肉麺二つ！　お待ち――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "あぶねっ、転ぶところだった！　お客さん気を付けてくださいよこちとらあつあつの麺を運んでるんですから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "グゥ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "……こりゃなんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "――ちょっと、あんた大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あっ、みて。鍋にお椀に、布に絵も……みんな部屋の中から出てきてるわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おびえる客",
      "text": "キャッ――！　何これ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茶館の店員",
      "text": "火！　火だ、この化け物燃えてるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……おれたちが目的っぽいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "ちょっと、リー！　これは一体どういうことなのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "霊魂を与えるっていう酒杯の噂は本当だったってわけですねぇ……ここは人が多い、ひとまず離れましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "船頭",
      "text": "リーさんへの連絡方法は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……リーさんの手紙には、私たちが合流した後、取江峰の山頂まで彼を訪ねるようにって書いてあったよぉ。もしいなかったら、日没まで待ってだってぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船頭",
      "text": "……わかりました。なら急ぎましょう、酒杯をほかの者の手に渡らせてはいけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "恩人様、この前に会ったあの墨魎に似たあやかしは、どうされるのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "多分あの酒杯と関係してるだろうからぁ……まずはリーさんと合流しよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "えっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "グゥ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "恩人様、あやつらなんだか、増えてません？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船頭",
      "text": "これは……なんという生き物でしょうか？　ここ数日よく見かけますが、一体……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "囲まれたよぉ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "グォッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船頭",
      "text": "おぉ、怖い怖い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "――ああもう、仕方ない！　恩人様、シェンさんと先に行ってください。私がこいつらの相手をします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――大丈夫なのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "墨魎と似たようなものでしょうし、お任せあれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "シェンさん～！　こっちだよぉ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "text": "どうされたのです？　落ち着かないご様子ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……何でもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "text": "あなたは人の心配をする時、いつも眉根を寄せますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "そうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "text": "そうです。リャン様にそんなに心配してもらえる方とは一体どこの誰でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……私は例の友人の心配をしているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "text": "彼がどうされたのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "面倒事に巻き込まれてたようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "text": "あなたが巻き込んだのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "text": "今になって後悔したのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……それでも私はこれが最善の選択だと信じています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "text": "あなたは聡明な方です、リャン様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "聡明とは言えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "愚鈍な方法を選択しただけですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "text": "……炎国の獣は、みんなこんな感じなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "……グォ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "text": "……ん？　ライト？　あっ、緊張しなくていいよ……うん、あんたたちがいれば私は大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "text": "ドリル！　そのままそいつを捕まえて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "text": "見たことのない炎国の獣か……罠に使えるかも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "はぁ！　どういうことなんだよ、最近どこかで妖怪の怒りにでも触れちまったのかな？　なんでこんな風変わりな生き物ばかりの相手をしなきゃならないんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "――よよよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "グォッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……よく見てみると、こいつら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "ヴゥ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "（しまった――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……危なかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "お怪我はございませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "あなたは、あの日の――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "聞くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "タイホーさん、そう冷たくしなくても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……あなたたちはこれが何かご存じなので？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "あの酒杯が通った場所に器鬼が現れているとすると、司歳台の推測が正しいことを証明しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "これはつまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "慎重に発言されるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……そうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇妙な物体",
      "text": "グォッ――ヴゥ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "（このあやかし、器鬼は……この二人を恐れている？　違う、この少年を恐れているのか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "器鬼の発生は、どのくらい起きてきたのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "十年前に一度、二十五年前に一度、さらに六十年前に数度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "アーツを使って悪人が騒ぎを起こすことはままありますが、状況は今と負けず劣らずですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ですが歳は結局は歳、獣も結局は獣。あなた方が炎に害をなそうとするなら、どれだけの災いをもたらすことになるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "器鬼",
      "text": "グォ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "司歳台はそれを許容できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ですから我々は、この千年来の負の遺産を清算しなければならないのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "器鬼",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……いずれにしろ、たかが残りかすにすぎないのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "器鬼が……普通の器物に戻った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ウユウお兄さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "クルースお姉さんに、私が言ったことをもう一度考えてみてくださいと伝えておいてもらえますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "取引が成立せずとも仁義は消えない。クルースお姉さんには彼女なりのお考えがあるでしょうけど、私の方にも身分に関係なくロドスにお願いしたいことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "お伝えする分には問題ありませんが、どうしてあの時ご自身で恩人様に伝えなかったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……はは、あの時はですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ちょっと緊張しちゃって、言いそびれてしまったんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "公子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "では……我々も時間が惜しいので、ウユウお兄さん、これで失礼させていただきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……緊張？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "副監察御史を連れ回すお坊ちゃんも、緊張するのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
