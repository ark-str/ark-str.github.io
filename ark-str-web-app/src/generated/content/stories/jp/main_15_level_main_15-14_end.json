{
  "server": "jp",
  "storyId": "main_15_level_main_15-14_end",
  "groupId": "main_15",
  "stageId": "main_15-14",
  "title": "哀悼を拒んで",
  "storyCode": "15-15",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_15-14_end.txt",
  "sourceHash": "916fdf3b256bc50a2ac87ad7820ed77154e7c5610feb93ec37f85d6201640b22",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "ターゲット排除。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "Stormeyeちゃん、四時の方向へ二連射して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "壁の支柱に？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "Stormeyeは不思議に思ったが、躊躇うことなく矢を二本続けて射った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "放った瞬間に地形が変化して障害物がタイミングよく消え、敵に命中した……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "クロージャさん、一体どうやったんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "へへ、あたしじゃなくて、ZOOTが計算したんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "今度は六時の方向だよ。そのまま飛び込んで。空洞の下の源石クラスターに怖がる必要はないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "ハッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼が真っ直ぐ飛び込むと、地形が再び変化した。終わりのない落下を始めるも、呪文で編まれたロープが彼を引くのだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "クロージャの計算は正確である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "ここで長らく待っておったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "ではこれからは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "指示に耳を傾け、目を閉じ前進する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "視界範囲内の敵は全部排除したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "隔離エリアの防衛線は確立できた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "やるぅ、小猫ちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うーん、でも私にもっと残しておいてくれてもよかったけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "次はどうしたらいい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あと三十秒後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "敵が正面から現れるから、全力で排除して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "そっちの方向でドクターが通らなきゃいけない道に通じる新しい通路が開くから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "オッケー！　これで諸悪の根源にもう一回悔しい思いをさせてやれるね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "小猫ちゃん、今回は私に先にやらせてよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "だめだ！　クロージャ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "周囲の建築構造が収縮し始めた。押し潰そうとしてきている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "放ったドローンも通行可能なルートを発見できず、補強設備も長くは持たない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "今計算してるとこ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ZOOTが膨大な情報を同時に処理してるから、もうちょっと待ってあげて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "6、5、4、3、2……1！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "Mechanistちゃん、上見て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "影の中の天井が歪み始め、冷たい光を放つ切っ先が、未知に通ずる通路を切り開いた。\nするとそこから手が伸びてきた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miseryの声",
      "text": "あんたが助けを求めていると聞いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miseryの声",
      "text": "時間がなくて、非常手段を用いるしかなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miseryの声",
      "text": "しっかり掴まってくれ、Mechanist！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Miseryの声",
      "text": "皆があんたを待っているぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（怒ったような雄たけび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（咆哮）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（エネルギーを溜める）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（焼けつく光線を放つ）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "激しく放たれた光線は源石結晶体が集まってできた包囲網に巨大な突破口を作ると、そのまま遠くまで伸び……さらに多くの源石結晶体を倒す――\nしかし突然、それは何かの力に遮られた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "すっごい力だね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でもドクターを傷つけないようにね、Mon3tr。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "みんな位置についたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "あなたが皆を率いて暗闇の中から現れる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシーはここにいる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（嬉しそうに体を揺らす）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Mon3trの支援を。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "石棺周囲の敵を排除するんだ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "随時私に合わせられるようにしてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Misery",
          "text": "安心しろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "呪文が随行する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "あれが……石棺か？　本艦内にずっと隠されていたのか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分が最初に目覚めた場所……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "ケルシーの信号が弱まってるのをZOOTが検出したよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "急いで確認しないと。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Touch",
          "text": "ケルシーさんが中に？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Touch",
          "text": "Raidianさんによれば、彼女の状態はあまり楽観視できないようです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "Dr.{@nickname}、できるだけすぐに彼女をそこから出してあげないと。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Raidian",
          "text": "このままだと……彼女の身が心配だよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "軽率な行動はできない。ケルシーと石棺の状況をしっかり把握できているわけではないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "当時の作戦記録によると、チェルノボーグにおいても石棺に接触した者がおり、最終的に我々の想定していなかった異変が起きた。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシーは違う。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ここは任せてくれ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "援護してくれ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "あなたは何一つ躊躇うことなく石棺へと向かう。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "あなたは冷たい石棺に触れた。それは……あなたに応えている。\nいや、ケルシーが応えているのだ。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "まだまだ、これからも我々は共に進まねばならない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ケルシー先生――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "弱々しい声",
          "text": "……ちょうどいいタイミングに来たな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "弱々しい声",
          "text": "ロドスは……どうなった……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "あなたは石棺の中の人物に手を伸ばした。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "みんな無事だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "君の努力のおかげだ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "おかえり、ケルシー。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "彼女があなたの手を握る。あなたはかつてないほど彼女が弱っているのを感じた。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "調子が悪そうだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "何が起きたんだ？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "私を気にかける必要はない……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "石棺を通じてPRTSに介入することは困難だった。だが思いがけずある贈り物を受け取った。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "PRTSとプリースティスに関するさらなる情報を、すぐに君たちに共有する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（緊張した雄たけび）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "恐れることはない、Mon3tr。私はまだ君の前に立っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "君を置いていきはしない。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Dr.{@nickname}、Abyssに通じる道はすでに見つけた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "この混乱を終わりにしよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ここは干渉が非常に強い。Abyssのかなり近くまで来ている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですがここには道がありません。Abyssは完全に隠れてしまっています――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "この距離ならば、Abyssの位置ははっきりと推測できる。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ケルシーは最も奥深くにある壁の前に立ち、しっかりと息を吸い込んだ。\n彼女はここまで奥に来たことはない――"
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（焦ったように低く唸る）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "心配いらない、Mon3tr。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "自分が彼女のそばにいる。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "あなたはケルシーの傍に歩み寄った。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私もいますよ、ケルシー先生。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ロドスは共に脅威に立ち向かう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "……今回は、本当に違う結末になるかもしれないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "石棺を通じて一部の権限を残しておいた。私が道を開こう。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ケルシーがあなたたちとAbyssとを隔てる壁に触れた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "「ゼロスオーダーオイルタンク」……ありがとね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "本艦もついに止まったよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Mon3tr、ドクターを守れ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "今後全ての行動はドクターの状況を鑑みて独自に判断していい。未知の敵の脅威からドクターを守るんだ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "またドクター自身に何か異常が起こった場合にも、君はドクターを止める必要がある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（信頼するように低く唸る）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "アーミヤ、Dr.{@nickname}の状態に常に気を払っておいてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ひとたびAbyssに入れば、現実に対する我々のあらゆる認識に衝撃が与えられる恐れがある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "常に危険と隣り合わせであるが、君とドクターの安全が最優先事項だ。最終的な脅威に対応できるのは、君たちだけなのだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい……気をつけます。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ほかに注意すべきことはあるか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "君の本心を信じていればいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Dr.{@nickname}、この局面がこんなにも早く訪れるとは思っていなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかし内なる宇宙とトリマウンツでの経験で、私は多くのことを考え直した。君はすでに別の可能性を見せてくれたからだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "これから起こる全てが君にとって、私にとって、またロドスの全員にとって未知数だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "だから、Dr.{@nickname}、教えてくれ――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "直面するであろう危険に対して、君にはまだ躊躇いがあるか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ある。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "ない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "だがこの先の危険を恐れてはいない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君はまだ緊張と躊躇いを隠そうとしている。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "一人で全ての重荷に耐える必要はない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（同意してケルシーをつつく）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "今回、自分もロドスも君の傍にいる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君たちがいるから、待ち受けるものを恐れてはいない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "むしろ君の方が心配だ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "このエリアに入ってから君は極度に緊張している。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（不安げに低く唸る）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシー……",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "信じてくれ、自分とロドスが君と共にある。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "次に何をすべきか教えてくれ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Abyssを開くためのプログラムはすでにアクティベートし、船室を起動するために必要なエネルギーも準備は整っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかし私はAbyssに入るための完全な権限を持ち合わせていない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "えっ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "じゃあじゃあこじ開けなきゃいけないの？　それならMiseryが何とかできるかも。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "（首を横に振る）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Abyssの秘匿性と安全性はテラ全体においても最高レベルだと言える。現状ここを開くことのできる権限を持つのは一人だけだ。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ケルシーの視線が自身に向けられているのをあなたは感じた。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ドクター？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……自分の力が必要であれば。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "決して退かない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "十七年前、ようやく「ロドス・アイランド」号を見つけた時、そのほとんどの構造が長い歳月の中で侵食により破壊されていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "唯一コアに位置するAbyssとその周囲のエリアのみが完璧なまま保たれていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "Abyssの中の未知のエネルギーによって、PRTSは止まることなく稼働し続け、その後我々が頼りとする指揮システムの根底たるフレームワークとなった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかしAbyssは誰にも開かれたことがなく、今ではもう……万年を超える。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "三年前、「アナンナ」が完全に降臨して以来、危機が訪れる速度はすでに予想を超えていると私は悟った。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "あの混乱は我々の多くが身をもって体験した。あの時に感じた遺憾と悲痛が、あの出来事を今も記憶を新しいものとしている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "アスカロンが黙したまま仕込み刀を構え、あらゆる突発的な危機に備える。\nRaidianがアスカロンのわずかな異常を察知し、いつものようにアーツでアスカロンを、そしてその場の同僚一人一人をなだめた。"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ここ三年、我々は本艦の防御を強化し続け、ロドスを内部から瓦解させようとする脅威にいかに対処するかの訓練を行ってきた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "各オペレーターが一丸となって協力したおかげで、予期せぬ事態が発生した際、危機の根源を迅速に特定できるようになった。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかしながら、我々はすでに濃霧の縁に来ており、この先は完全なる未知だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "私にも躊躇いはあった。しかしドクターの言う通りだ。これまでそうしてきたように、我々であればこの危機を解決できる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "なぜならば我々は常に共にあるからだ。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "Logosは骨筆を軽く振り、言葉が彼の口から出ると、庇護がそれに続いた。"
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "ここまで足並み揃えて行動するのは随分と久しぶりだな。どんな気分だ、Logos？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "集中せよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "これまでの情報から判断するに、AbyssにあるのはPRTSのコアアセンブリだけではないはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "その中の石棺にて「プリースティス」という名の個体が休眠している可能性が極めて高いです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "もしプリースティスが目覚めたなら、彼女を最速で排除することに全力を注いでほしい。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "これは想定外の事態を避ける最善の方法だ、Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "目覚めた瞬間こそが彼女の最も弱っている時だ……今の環境に適応するにも時間を要するだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター……？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "目の前の壁に触れたあなたは、不思議な感触に鼓動が早まる。\nあなたには直感があった。この場所はあなたを待っている。あるいは……この場所はそもそもあなたのために存在していると言うべきかもしれない。\n壁が震えている。警報音が聞こえた気がした。それは鼓膜を突き破ろうとしているかのように思えた。\nあなたは一瞬ぼんやりとする。その耳障りの音は現在からやってきているのか、それとも過去からか？"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "Abyssが変化しています！",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "壁面が不規則に動き始め、一本の亀裂が生まれた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "そこから気流が噴き出した。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "「ベール」。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "バンシーの呪文が形なきバリアとなり、荒れ狂う気流を遮った。"
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "下がれ、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "全員警戒しろ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（高ぶった雄たけび）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ピンク色の糸がアーツユニットから渦を巻いて昇り、黒い王冠が彼女の頭上に浮かび上がる。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Mantraの声もあなたの心の中で響く――"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "いいや、予感がする……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ここには何も脅威がない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分が先に入る。ついてきてくれ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "共に行こう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "あなたたちは亀裂の向こうの空間に踏み込んだ。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
