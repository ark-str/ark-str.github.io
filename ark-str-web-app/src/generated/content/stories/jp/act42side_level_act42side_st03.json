{
  "server": "jp",
  "storyId": "act42side_level_act42side_st03",
  "groupId": "act42side",
  "stageId": "act42side_st03",
  "title": "再会",
  "storyCode": "MT-ST-3",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act42side/level_act42side_st03.txt",
  "sourceHash": "84c179b543cd3cc944b47178744730b188d5ef6f9006db9251277785bbc763f3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "……来たか、フェデリコ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "教皇聖下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "そこのテーブルを見てみなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "新作の「イヴァンジェリスタⅪ世アイスケーキタワー」だ。十一個のアイスクリームに十一種のサボテンタルトミックスフレーバー、そして教皇の名にちなんで命名された十一種類目のケーキ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "執行人の業務に比べますと、新作スイーツへのフィードバックの専門性は保証できかねるのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "いやいや、あれは感謝の印として用意したものだ。あの場から避難する時に、この死にかけの老人を置き去りにしないでくれたことへのな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "とはいえ無論、今後都市全体に広めていくことも考えている。皆が一日でも早く、いつも通りの日常を取り戻せたらと思ってね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "味という側面から考慮すると、このスイーツはむしろ不要な論争を引き起こす恐れがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ですが確かに、ラテラーノ公民には早急に日常を取り戻してもらわねばなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "この三ヶ月の間、公民の自殺率は高い数値を保っており、暴力事件も後を絶ちません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "小規模な暴動から、大規模な公民の出国に至るまで……公証人役場が記録した事件は千を越え、都市再建の着工も今に至るまで後回しにせざるを得ませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "災厄はあまりに多くを暴き、そして変えてしまったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "我らの法は冷たい機械に過ぎず、我らの聖徒は醜い怪物で、我ら一人一人が魔族と同じルーツを持っていた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "そうした真相は、どれを取っても、一人の人間の信仰を崩すには十分なものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "此度のラテラーノ再建は、大仕事になるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "第三庁、第四庁の被災地再建事業は始まったばかりです。その傍ら経済復興も進行しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "……ラテラーノという国が、これほど多忙になるのは久しぶりのことだ。この忙しさの中で、皆が心の傷を癒す方法を見つけてくれると良いのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "ところで……フェデリコ、君は此度の一件をどう見ている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "サンクタも、ラテラーノも、信仰も、共感も、交流も、我々の社会も……聖都が長きにわたって下してきた数多の大きな決断も、果ては君が聖徒に任じられたことまでも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "すべては——機械の演算によって導かれた結果だった。聖霊の光とは最初から冷ややかなものだったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "生理的な共感能力の欠如を抱える君は、それゆえ極端に合理的な人間となった。アレが君を選んだのは、その演算ロジックを誰よりも理解できる個体が君だったからこそなのだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "君とアレとの対話は、おぼろげながら断片的に聞こえていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "アレと数十年の間対話してきた私とて、認めざるを得なかったよ……アレと語り合うに相応しい人間は君なのだとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "もし、私が君たちの話し方に慣れていなければ、どちらがどちらの言葉なのかすら区別できなかったことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "法が機械であり、システムである以上、最も有効的な交流方法はそのロジックに従って思考し、その言語で会話することですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "だが、君は最終的にアレとは真逆の結論を出した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私は法に記された一字一句をすべて記憶していますし、任務の中で関わってきた名前もすべて覚えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ラテラーノにとってすれば、機械が築く秩序というのは、あくまでも生命に必要な秩序に近しいものに過ぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "生命は存在自体が奇跡であり、強さと弱さが表裏一体となって構成されています。生存し、生活するためにこそ我々は秩序を構築し、改良し続けているのです。法はそのうちの一つに過ぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "秩序とは、人が人として……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フェデリコはふと言葉を止めた。「機械のように冷酷」と称された執行人が、言葉を選ぶなど滅多にないことだった——"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "かけがえのない弱さを守るためにあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "「かけがえのない弱さ」か……ふっ、面白い言葉を組み合わせたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ゆえにこそ、我々はアレを拒絶しました。これは我々の共通の決断と認識しております、教皇聖下。ただし、それが正しかったかどうかは、検証に時間が必要でしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "何かね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "ほう、そんなことが？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタのシスター",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタのシスター",
      "text": "レミュエル、何をしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "へへっ、スプレーアートだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "この場所暗いし冷たいし、この岩もむき出しでつるつるじゃん？　みんなここに来るたびに、すんごい風邪でも引いたみたいに元気なくしちゃうのも無理ないよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ずっと我慢してたけど、もう限界！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だから、これに新しい服を着せてあげようと思うんだ。見た人が元気出るように……一緒にやる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタのシスター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ちょっと、そんな目で見ないでよ。あたしは一昨年の龍門創作グラフィティ大会で三位取ってるんだから大丈夫だって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタのシスター",
      "text": "ねえ、それが何だったかは忘れてないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあさ、これは特別な願掛けってことにしよう！　モヤモヤしてることとか、まだ叶えられてないお願いとかを全部この岩に吹きつければ、ひょっとしたらどうにかなるかも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタのシスター",
      "text": "願掛け……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だって、昔聖徒がこれに願い事をしたから、サンクタとラテラーノが生まれたんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタのシスター",
      "text": "でも、それはもう壊れてるんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いやいや、こんな石ころに壊れるも壊れないもないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "それに、願掛けを見てるのはこの岩だけじゃないよ。キミも、あたしも、後ろにいるアイス売りの子も、そっちにいる製銃士のお兄さんも、ここにいるサンクタみんなが証人になれるんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "別に、願いを叶えてくれるのはこの岩じゃなくたっていいでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタのシスター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "この三ヶ月で、信じられないようなことがいっぱい起きたよね。前だったら全部大ニュースになってそうな事件ばっかり！　聖都の底まですっかり暴かれちゃってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "それでも、こんなにたくさんの人がこのボロボロの都市に残ることを選んだんだから……あたしたちの光輪もまだ光ってるし、人生終わったわけじゃない。でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だから、新しく願い事をしようよ！　そんな難しいことじゃないって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まずはあたしからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "教皇庁の援助を受けた初の民間物流会社、あたしの「アップルパイ急便」が来週ついに事業をスタートさせるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "このチャンスを生かして注文をドサドサもらって大繁盛して、父さん母さん姉ちゃんたちと一緒に過ごす時間がいっぱい取れますように……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イディダ",
      "text": "レミュエルお姉ちゃん、あたしも無糖アイスクリームについてお願い事してもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "も、もちろんオッケー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イディダ",
      "text": "ラテラーノ人の遺伝子が変化して、みんながあたしの食生活研究を心から応援してくれるようになって、歯も光輪も絶対に虫歯にならなくなりますように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタ通行人A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンクタ通行人B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "新たな一日の訪れを告げる朝日が、粘り強くラテラーノの最奥へと差し込んで、塗装の緑とくすんだ岩を照らし出す。\nサンクタたちはそうして顔を上げ……光の中で、埃が舞う様を見つめていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……第七庁は当該地域の封鎖と通信規制法案を提案しましたが、現実的には実施は不可能とのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "あそこまで破壊されてしまっては、確かにどうしようもないだろうな、はっはっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "今や大聖堂は崖際に立っているかのような有様だ。あれでは、通りすがる者が下を覗き込むことなど止められようもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "何よりも、最初の聖徒はすでにラテラーノの人々に真実を明かしたのだから……今の同胞たちは、それと向き合うすべを学んでいるに過ぎないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "公証人役場の記録によると、本日午前、ファボール区中央病院光輪外科に入院していた最後の重症患者も、軽症経過観察室へ移動したとのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "つまり、三ヶ月の時を経て、此度の災厄で光輪を与えられてしまったサンクタ以外の人々全員が、二度と頭上の蛍光灯に悩まされずに済むようになったというわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "それに加えて、サンクタの壊れた光輪も徐々に回復しつつある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "共感は依然として存在している。昔と少し感覚は変わっているが、これは変わらずサンクタ同士の繋がりとして在り続けているのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "アレは確かに死んだ。そうだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アレは、私とアンドアインに自らを壊せと指示を出したあと、自らの最も脆弱な部分をさらけ出してきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ゆえに我々は、この手でアレを破壊しました。完全に機能は停止していましたし、後日私が再確認を行っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "だが、光輪のプログラムはいまだ消えてはいない、と……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "法は依然として機能しているということでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "言い方を変えよう、フェデリコ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "君は法そのもののパラドックスを指摘した。そしてそのパラドックスとは、本来相容れない二つの事柄が結び付けられていることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "アレが最後に下した指示が、パラドックスを是正することなのであれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "我々が破壊したのは、法の本質ではなく、その誤った結び付き……「パラドックス」そのものに過ぎなかったと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "論理的には正しく聞こえますが、理解は困難です。機械自体は確かに動作を停止していますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "それも当然だ。これは、昨日サボテンタルトを噛んでいて偶然思いついただけのアイデアだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "だが、私が思うに、アレは恐らく我々のために何かを残していったのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "もしかすると、ラテラーノの法が真に完成されたものであったことなどなかったのかもしれない。アレは、空白のプログラムを残し、我々との対話を待っているのではないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "ゆえに私は、大聖堂の地下を公共スペースとして改造し、全公民が訪れて娯楽にも利用できるようにすると決めた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "ラテラーノがどこへ向かい、法が新たにいかなる意義を生み出すのか……それはサンクタ一人一人の関わりによって決まるのかもしれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "君の言う通り、その検証は「時間」に委ねてみるとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "おかしいわね、どこにいったのかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "グレネードランチャーの修理キットの予備なら、一番下の引き出しじゃ。映画のディスクなら、ソファーの下の収納にしまってあるぞい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "荷造りは後にして、サボテンジュースでも注いでくれんかのう——病院から戻ったばかりで、喉がカラカラなんじゃよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ところで、今日はとんでもないことが起きたぞ。なんじゃと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "立て続けに五回もの葬儀を執り行ったサンクタの修道士が、悲しみのあまり突然失語症を発症してしもうたのじゃが、それと同時刻、修道士の妻が胸の痛みを覚えたという事例があってな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "この件で重要なのは、その修道士が郊外の安魂教会にいた時、妻は遠く離れた都市内の銃工房にいたということじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "似たような事例は他にも多く起きておる。先週などは、名だたる病院と教会が共同で、サンクタ千人以上もの異常診断報告書を教皇庁へ提出したばかりでな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ワシらの頭上には再び蛍光灯が輝き始めたが、共感の度合いや有効範囲は、どうやら人によって変化しておるようじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "見知らぬサンクタ同士の場合は、依然としてお互いの感情をぼんやり感じ取ることしかできん。じゃが、血縁者や親友などの近しい関係であれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "何が言いたいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ラテラーノは一見して、すべてが元通りに戻ったように見えるが、大きな災厄を経たことで、根本的な変化が起きておるということは周知の事実じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィアよ、このような時にここを離れてはいかん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ロドスについては……前にもお話ししましたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "今回はDr.{@nickname}もラテラーノに来て、裏で色々と問題解決のために手を回してくれていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "そのドクターが、聖都の災厄は偶然ではなく……本艦で起きた重大な事件と、深い繋がりがあるはずだと話していたんです。それに対処するために、ドクターはもう別の場所へ向かいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私もモスティマも、ロドスのオペレーターである以上、同行しないといけません……これはラテラーノのためでもあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私の外勤任務の申請にはあなたの許可が必要ですから、こうした理由はもうお読みになったはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィアよ、おぬしはもうワシがしたことを知っているのじゃろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "教皇聖下が罪に問わないと決めたからには、私からも何も言う気はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それに、最後の最後には、みんなが隊列から抜け出せるよう導いていたんでしょう……あなたは、銃騎士としての務めを果たしたんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "やれやれ。皆、年寄りには甘いのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "夢の中でも、外でも、あなただけじゃなく……サンクタのほぼ全員があの化け物を支持していましたしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "共感に影響されたとはいえ、ラテラーノを良くしたいという思いが皆根底にあったんでしょう。今となってはバカげて聞こえますし、歳を取るほど強情になることには文句を言いたくもなりますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "「別れ」に対して思うところがあるのは……理解できなくもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "うむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "前にもお話しした通りですけど、あなたからすると心配に思うことでも、自分で経験しないといけないこともあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "すぐに戻ってきますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "フィア、ワシはただ、こう言いたかったんじゃよ。おぬしが持って帰ってきた『オクトパス・チェーンソー』を、まだ一緒に観ておらんじゃろうと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ワシは、パガニーニの奴の言う通りだと思うたんじゃ。何かが起きるより前に、少しでも後悔を減らしておかなくてはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ねえ、おじいちゃん。そろそろ引退するんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それなら、一緒にどこかへバカンスにでも行ってみない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "ふぅ、これでやっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヴァンニーニは銃工房の前でしばし立ち尽くしてから、「営業休止中」の札を外して扉を押し開けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "し、師匠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何だよ、騒ぐなって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "光輪の再検査だけで、なんだってこんなに時間がかかったんだ？　俺の怪我より深刻な状態ってわけじゃないんだろ、げほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "チャンドラー先生が、言ってたんです。私の、言語能力が、少しずつ……だけど、良くなってるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "それで、研究対象になってくれないかって、聞かれました……言語障害と、光輪の——よ、よくわからなかったんですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "お前らサンクタのことはいちいち複雑すぎて、理解しようとも思えんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "そういや、お前の守護銃、返しとくぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "何か問題でもありましたか？　あ、あの時は師匠がいなかったので……自分で考えて、作ったんですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "そりゃ、問題はあるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "こいつはグリップが細すぎる。これじゃ威力を伸ばすにも限界があるだろう！　それ以外の、パーツの組み合わせだの発射機構だのは特に問題ないがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "それとこの書類。さっき誰かが入口に置いていったんだ。ほら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "教皇庁の紋章……まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "おいおい、もうあの夢は終わったんだぞ。銃工房を閉鎖されたりなんてしないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "これは教皇庁からの注文書だ。新任の銃騎士向けに、大型重火器を設計してほしいとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "パ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "待った。連中がこの小さい工房を指名してきた理由くらい、俺もわかってるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "ヴァニー、お前はあの時本当に、あいつに向かって引き金を引いたんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "いい子だ。お前は、俺の代わりにケリをつけてくれたわけだな。となれば、過去のことはもう終いだ。これ以上蒸し返すことはしないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "だから、この発注を受けるかどうかは、お前が自分で決めな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァンニーニ",
      "text": "わ、私が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "俺が決めるわけにいかんだろ。まさか命拾いするとは思ってなかったもんで、今でも胸の辺りが痛みやがるし、げほ、ごほっ——パーツもまともに見えやしないし、銃身だって握れないんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "お前は人生で初めての銃を作ったし、「主」が口に貼り付けた封印だって引っぺがした……一番難しいことをやってのけたんだから、この先は自分の足で歩いていくんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "そうそう、俺の看板に泥は塗るなよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パガニーニ",
      "text": "できるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ええ、エルはもう行っちゃったわ……ちょっと、言ったでしょ？　この件は教皇庁が決めたことだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ラテラーノにとってもほかの国にとっても、今回の災厄は始まりに過ぎないの。だから私たちは体勢を立て直して、今後も他国との連携を強めていかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……龍門でのエルの勤務経験と、ロドスとの関係を考えれば、この任務に一番向いてるのはあの子なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "エルから伝言を預かってるわ——「父さん母さん、レミュエルの冒険の始まりを盛大に祝ってね」だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それより、エルがお腹壊さないように祈ってあげてほしいんだけど……あの子、用意したのを飲まずにいたら怒られるかもと思ったのか、出発前に冷蔵庫のミルクを全部飲んで行っちゃったのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "はいはい、それじゃ仕事に戻るわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "その端末……またアモスさんの遺品を見てたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "聞いたよ。あいつは死ぬ直前まであんたと行動してたんだってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ええ。アモスさんの最期の言葉を聞いたのも私。だから私は、メールボックスの履歴を復元したのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "バカな男だっただろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "本題に入ろうか、レミュアン枢機卿。あんたらは私の新たな罪を、どう裁くつもりなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ということは、先日聖都西側の郊外でキャラバンが襲撃され、ヴィクトリアに追い返された件は……あなたの仕業だと認めるのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "奴らはプロの偵察兵だった。それを見抜けなかったとは言わせないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ええ、ゴドズィンの手の者でしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "だから私たちは、あなたを「裁く」つもりなんてないわ。実質的にあなたの行動は、第七庁の問題を解決してくれたことになるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "偶然虫の居所が悪い時に、あの連中と出くわしただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それと、あのヌエダというシスターと、あなたについてラテラーノへ来たボリバル人たちも、教皇庁が責任を持って保護するわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "加えて、どんな意図があったにせよ、あなたがパトリツィオさんを止めたことは結果的に私たちの助けになった。それを加味して、無断で聖都へ戻ってきた件については不問ということに決まったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "ハッ、なんだ？　夢から覚めた今も、ラテラーノはまだ純粋で寛容なフリをするのか？　だから、地獄に落ちた罪人すらも許してやろうって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "あんたらはそこまでバカだったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "あの化け物がラテラーノの街を闊歩して演説をして以降、天使と悪魔が同じルーツを持ってることはもはや秘密じゃなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "この街を覆う気持ちの悪い「聖なる」ベールは剥がれ落ちたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "そうして神聖さを失った「聖都」は、今や単なる弱小独立都市に過ぎない。そのまま偽善ぶってたところで、リターニアやウルサスの同情を買えるとでも思うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたは誤解しているわ。ラテラーノは、誰かに向かって寛容さをアピールしたことなんてないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたへの追放命令は撤回されていないし、聖都への帰還を許すこともしない。だけど、教皇庁はあなたに雇用契約を提示しようかと検討しているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "雇用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "この前してくれたようなことを頼みたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "ハッ、ラテラーノ人には汚れ仕事はできないとでも言いたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "もちろん、そんなことを言う気はないわ。銃騎士も、枢機卿も、護衛隊も、レガトゥスも……罪とは無縁だなどと胸を張る資格は誰にもないもの。ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "情勢が変わったという点については、あなたの見解は間違ってないわ。次に誰かが聖都の郊外に現れたとして、その時相手はただの偵察兵じゃなくなってるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ある時代においては最も過激な悪行とされたことが、別の時代でなら生きるために必要な手段になることもあるかもしれないわ。少なくとも、あなたの手段には迷いがないというのは確かね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "あんたらは、何を根拠に私が乗ってくると思ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "そうね……それに答える前に、失礼を承知で、一つ聞かせてもらえるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたは、ラテラーノを離れる前にアモスさんと口論したのよね。彼はずっとそれを後悔していたのだけど……その当時、何を理由に口論になったか教えてもらえない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アモス",
      "text": "な、なんだってまたその話を持ち出すんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アモス",
      "text": "確かにパトリツィオさんは結婚式にも来てくれなかったし、祝福の言葉もくれなかった。だが……それでも彼は、君の師匠だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "さて、どうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アモス",
      "text": "そ、それに、だからと言って何も問題はない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "確かにそうかもな。呪ったところであの爺さんが死ぬわけじゃないし、何か言えばお前は調査員の仕事を下ろされるかもしれない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "だが、そんなことさえできないなら……お前は本物の臆病者だ、アモス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "私はもう行く。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "何度もやってきたような、くだらない痴話喧嘩さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "アウレラさん、端末の書類は見たわよね。私が思うに、アモスさんは当時、こう言いたかったんじゃないかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたがどんな人だろうと、二人の関係が祝福されていようといなかろうと何も問題はない——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "二人ならお互いの救いになれるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウレラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたがこの提案に同意してくれるかはわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "誰しも、共感ですら感じ取れない問題を抱えているものよね。整理のつかない過去や、不確かな未来への不安……私自身、これからいろいろなことをゆっくり考えていかないといけない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "憎しみを原動力にするのがしっくり来ているなら、それがあなたには合っているのかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "思うに、それはきっと……アモスさんが見届けたかったことでもあるんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "オマケ、あと少しよ、頑張って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オマケ",
      "text": "ううっ——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オマケ",
      "text": "感じるわ……あなたの鼓動と、体温を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オマケ",
      "text": "あなたの恐怖と、喜びを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オマケ",
      "text": "もし、私が法に祝福されているのなら、主はあなたの命も祝福してくれるはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "祈ってるの？　そんなことしてる場合じゃ……そもそも、サルカズのあなたがいつからそんなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "って——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "順調？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "え、ええ……でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "だったらどうしてそんな顔してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "……こ、光輪が。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "オマケの赤ちゃんに……あの子はサルカズなのに、光輪が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "オマケは旦那もサルカズだって言ってたよね？　そう思うと、あの子はセシリアみたいな混血児じゃないはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "ここはあの忌々しい夢の中でもないし、この移動修道院もラテラーノから随分離れてるのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "アンドアインさんはどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "修道院が停まった途端に出かけたわ。みんなのために食糧を探しにいくついでに、新しい奇跡の誕生を祝うためにお花を摘んでくるとか言って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "きっと……何かが起きる予感があったんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "こうなるとつい思い出すよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "災厄が収まった後、私たちはあの穴の近くでアンドアインさんを見つけたよね。その時彼はほとんど失明しかけてて、大聖堂で何が起きたのかも教えてくれなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "それから教皇庁の第一庁、第五庁、第六庁、第七庁が合同裁判を開いて、彼の罪をすべて裁いた。裁判の詳細は誰にも知らされなかったけど、最終的に……彼は流刑になった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "助産士",
      "text": "永久にラテラーノに戻ることはできなくなった代わりに、この移動修道院に乗って国を離れることは許された……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "やめましょ、あれこれ考えるのは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "求道者の解散はアンドアインが決めたことなのよ。あの人が言った通り、あたしたちはもうラテラーノに何かを求める必要はないしね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "仲間の中には、ラテラーノに残った人もいれば、故郷に帰った人もいた。ここまでついてきたのは、自分でそう決めた十数人だけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "あの人がこの修道院に何を期待してるかは知らないけど、一つだけ確かなことがある——それはあたしたちが今、もっと多くの人を救おうとしてるってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "彼、そろそろ帰ってくる頃かしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "あの聖堂で、あのサルカズは祈りを学び、法との繋がりを自ら築いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "その一方で我々はと言えば、信仰が滅びようという時になって、初めてアレと対話する始末だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "信仰が命に呼応するものなのだとしたら、新たな法は今この瞬間ようやく生まれたと言えるのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "危機はいまなお去ってはいない。それどころか、我々が一つの可能性を拒絶したことで、その危機はより予測不能で差し迫ったものになりすらした——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "だが幸い、新たな可能性も目の前にある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "アンドアイン、お前はそれを携えてどこへ向かう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
