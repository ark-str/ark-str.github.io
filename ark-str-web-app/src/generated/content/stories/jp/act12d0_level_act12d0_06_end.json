{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_06_end",
  "groupId": "act12d0",
  "stageId": "act12d0_06",
  "title": "邂逅",
  "storyCode": "RI-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_06_end.txt",
  "sourceHash": "3402d015c2cb6adbd5c752eb5c34102ef363388a3ab8d7b8dc6a68812b7a79c1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたたちだけですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "族長A",
      "text": "ジャイアントウッド族のヤツらは出てこねぇ。どうやらリーダーが余所者に倒されたらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペータ",
      "text": "ファイアストン族とシィクテイル族は、武器をいっぱい背負った知らないヤツにやられた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "族長A",
      "text": "あとは、いくつかの部族がズゥママの部族に加入することにしたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "族長B",
      "text": "ズゥママの軍勢は大したもんだ。オレももしガヴィル派じゃなかったら、ズゥママに下ってたかもしれねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたがたがいてくれれば、十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "族長B",
      "text": "……本当にオレらでズゥママに勝てるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ガヴィルさんなら絶対にズゥママの巨大機械を倒せます。それから私が大族長になって、ガヴィルさんを引き留めます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペータ",
      "text": "ペータは、それはよくないと思う。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": ".......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ですが、これがガヴィルさんを引き留める唯一の方法なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "皆さん、どうか忘れないでください！　私たちがなんのためにこの部族……「ガヴィルウィル」を結成したのかを！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "「ガヴィルウィル」はただの部族ではありません。ガヴィルさんが大族長になることを望むすべての人たちの同盟なんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "族長B",
      "text": "オレはトミミに賛成だ。大族長はガヴィル以外ありえねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "族長A",
      "text": "そうだ、ガヴィルこそオレらを導くに相応しい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "族長C",
      "text": "へっ、やる気じゃなきゃオレはここに立っちゃいねぇぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペータ",
      "text": "……ペータはこういうの気に入らない。でも、やる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "では、あなたたちはズゥママの部族の集落の外に着いたら、そこで私が来るのを待っていてください。いいですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "他の族長",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "すべてはガヴィルさんのために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "他の族長",
      "text": "すべてはガヴィルのために！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ドクター、それにみんなも！　よかった、やっと会えたね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はぁ、心配したんだから、ドクター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ん？　ブレイズ、お前なに水着着て――てかその背負ってるヤツはなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ああ、途中で会った子なんだけど、顔を合わせるなり、いきなり殴りかかってきてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "私もやられっぱなしは嫌でやり返してたら、この子の部下も含めて全員倒しちゃったってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それで君に、なんで殴ってきたのか聞いてもらおうと思ってさ。なかなか強かったし、結構タフだったから気になってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あぁ、よく見りゃクマールか。単純にお前が強そうに見えたから、一回やり合ってみたくなっただけだろうな。そいつぁ根っからの戦闘狂なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "へえ、君に戦闘狂って言われるなら相当だね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "アタシゃ別に戦闘狂じゃねぇだろ。ただ、どっちかと言えば直接的な方法で問題を解決するのが好きってだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はいはい、わかったわかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "……ここは……どこだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おうクマール、起きたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "ガヴィル！？　なぜお前がここにいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前はアタシの仲間に手を出して、返り討ちにされたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ハーイ、目が覚めたかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ちょっと、ガヴィル！　この子なんで私にお辞儀してるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "クマール、何してんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "この人から、ズゥママにすらなかった純粋な強さが伝わってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "ガヴィル、お前への興味ももう失せた。言葉がわかるなら、この人の元で修行させてほしいと伝えてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おう、お前に教えを乞いたいってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はい！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "まぁお前が強すぎたから、舎弟になりたいって感じだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……ドクターどうしよ！　こんなの初めてなんだけど！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分で決めた方がいい。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "しーらない。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "えっと、じゃあ、とりあえずついて来てもらうってのは？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "いいんじゃね？　おい、クマール、とりあえずついてこいってよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フリント",
          "text": "わかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フリント",
          "text": "だがその呼び方はやめろ。今はフリントと呼べ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "そういえば、祭典はどうなったの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ドクター、ブレイズにも説明してやってくれ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "部下が鉱石病に罹るのも構わずに機械を作ってる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "へぇ、それは放っておけないね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "じゃあこんなところで話してないで、さっさと行かないと！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "でもその前に、行くところがあるんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "え？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
