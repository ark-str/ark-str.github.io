{
  "server": "jp",
  "storyId": "act29side_level_act29side_02_beg",
  "groupId": "act29side",
  "stageId": "act29side_02",
  "title": "序曲「歩哨」",
  "storyCode": "ZT-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act29side/level_act29side_02_beg.txt",
  "sourceHash": "0a93bd038887fedb770366d82f4c536e05f92bd82282a6e0a65b6557e6d182c7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "かつて、とてもとても古い高塔という籠に囚われた可哀そうな子供がいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "生まれた時には、彼の人生はすでに書き終えられていました。まるでオペラのように、一つ一つの旋律、そしてストーリーが用意されて、彼は台本に沿って演技をするしかありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ある日、その子供は、自分が劇の登場人物であることに気が付きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "嘘、そう、何もかもが偽りだったのです。周囲の人々は揃って精巧な仮面をかぶり、愛も憎しみも全ては演じられたものでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼は困惑し、恐怖し、怒りました。そして、その楽譜を「運命」と呼び、抗おうとしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ついに、舞台から逃げ出したことで、彼は自分が成功したと思いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "しかし彼は忘れていました。与えられた自由が、果たして真の自由となり得るでしょうか？　運命の糸が再び引き寄せられれば、どこへ逃げても、彼はまた舞台に戻るしかありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "今回、彼は真正面から向き合い、戦うことを決めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "未だ劇は続き、自分の足掻きは依然として観衆の視線に晒されているのだと気付いていました。そして、舞台上から真っすぐに見返すことで、運命を押し付けてくる相手を嗤ってやれると考えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "しかし、彼は時折思うのです……もし自分がまだその登場人物であるなら、舞台がどこにあるか、観衆はどこにいるのかを、どうやって判別すれば良いのでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "仮に我々が彼のように劇中に身を置いているなら、劇はいつ本当に幕を閉じるのかをどうしたら知ることができるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの子供",
      "text": "この物語の主人公は可哀想だね。無事逃げられる？　悪い人をやっつける英雄になれるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "英雄……英雄とは誰もがなれるものじゃないわ。それに、たとえ英雄であっても、長い時間の中で普通の人に戻ったり、悪党になったりしてしまうこともあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの子供",
      "text": "何さアルトリアお姉ちゃん、僕たちはそんなお話聞きたくないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そう。なら、そうね……もっと昔のことから話しましょうか。そうすれば、今日だけじゃ結末まで話せないし、あなたたちも聞きたくない展開まで聞かずに済むわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの子供",
      "text": "お姉ちゃん早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたたちはこの密林公園で遊ぶのが大好きなのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "実はこの公園、元々は巫王に抵抗し亡くなった「英雄」を悼むためのものじゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "グスタフ公園は、ある君主の偉大な功績を称えるために建てられたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼を主人公とした物語の中では、彼自身もまた偉大なる「英雄」の一人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ふぅ……ふぅ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "なんだ、「昔馴染み」か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "女帝たちが送り込んだ処刑人だとしたら、なぜわざわざ回りくどい真似をして私をリターニアに帰らせ、さらにはここ何日も生かしておくのかと思っていたところだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "ウルティカ伯爵、あなたは計画の鍵です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "またそれか。飽きないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ゲルトルーデがお前たちに証明しなかったか？　彼女があれだけのものをつぎ込んでなお、コンサートホールの爆破未遂にしかならなかったのだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今度は私に何をさせようとしている？　頭上の公園の爆破か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "ストロッロ伯爵は自らの無知によって敗北しました。彼女と最初の実験者たちは、ただの烏合の衆にすぎなかったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "彼らは陛下の旋律を手にしたにも関わらず、正しい「演奏」方法を知らなかったがために、源石の災いを振りまく兵器として無駄遣いしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "あのような荒々しい暴力は芸術を汚す行為です。仮に陛下が当時お目覚めになっていたら、必ずや彼らに死刑宣告していたでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハハ、つまり、ゲルトルーデはまがいものであり、お前たちの方が本物であると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "では私が代わりに……女帝陛下方に芸術家勲章を申請し、お前たちの正統さを証明してやろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "我々が望むのはあなたの理解です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "あなたは陛下の継承者であり、陛下の栄光の証明、血肉の化身、旋律の延長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "我々は……あなたなら栄光をウルティカに、リターニアに取り戻せると信じています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……ならば持っていくがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "栄光、血肉、旋律。全てくれてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ずっと興味があったのだ……そうしたら「エーベンホルツ」という名の個体には、一体何が残されるのかとな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "感染者になったからか、あるいは、あのロドスという組織があなたを鍛え上げたからか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "少し強くなったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "だが残念……あなたはまだ陛下に遠く、万分の一にも及ばない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強情な学生",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強情な学生",
      "text": "い……行かないと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "動くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強情な学生",
      "text": "なんでお前がいるんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "それ以上進めば、逮捕する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強情な学生",
      "text": "俺はまだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "まだあの頭のおかしい連中に正式に加入していない、そうか？　運が良いと思え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強情な学生",
      "text": "頭がおかしい？　違う。お前たちからしたら、かの陛下の統治は恐ろしいものかもしれない。だがかの陛下が手を下したのは向上心のない貴族ばかりだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強情な学生",
      "text": "どうしてかの陛下に憧れを抱いちゃいけないんだよ？　なんで……俺みたいな奴でも世に認めてもらえるようなリターニアを望んじゃいけないんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……なぜなら私は、お前よりもあれがどういう時代であったかを、よく知っているからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "聞け、若造。リターニアに来たばかりの頃、私は誤って道に落ちていた肖像画を踏んでしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "あの通りはスパイだらけでな、私はすぐに監獄にぶち込まれた。当時の私はまだラテラーノの商人で、奴らは「外からの反対分子」という罪で私を処刑しようとした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そのような場面では、公証人役場あるいは第七庁の者に連絡を試みるのがいいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ああそうだな、執行人殿。あなたなら確実に恐ろしいアーツの牢獄に単騎で乗り込んで、当時の私を引きずり出せただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "だがあなたの羽は多くのサンクタ同様、見ることができるだけで、飛ぶことはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ラテラーノとリターニアの距離を考慮すると、あなたでも翌日処刑される哀れなリーベリを救うことはできないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ですが、あなたは生き延びただけでなく、リターニア人になっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "救ってくれた人がいたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "彼は足が不自由な老いたリーベリだった。戦場に赴き、何人ものガリア兵を殺したことのある方だ。その後彼は憲兵となり、当時、この職位は巫王の秘密警察に相当するものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "彼は私のあまりの運のなさを見かね、死刑執行隊の者にコレクション用のシガレットケースを渡し、私を見逃してくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "数日後、巫王がまた反体制派の者たちを処刑したと聞いた。まさにあなたの目の前のこの公園の中でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "人だかりの中、私は恐る恐る顔を上げた……あのねじ曲がった像の中心で私は誰の顔を見たと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強情な学生",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "怖がっているな。それは当たり前のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "早く行くといい、若者よ。ティームの所へ帰り、今後はこうしたことに関わるな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "我々も戻ろう、執行人殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アーツが激しく揺れ動いています。あなたも感じ取ったでしょう。何者かが戦闘を行っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "女帝の声に対処させておけばいい。後で知らせておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それでは、犯人逮捕の機会を逃してしまいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "なぜわからない？　私はそんな機会など求めていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ここから公園に入れば、マスクをかぶった奴らに会うことになる。そいつらは「ヘーアクンフツホルンの余韻」と名乗っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "両陛下のご期待に沿うのであれば、私は即座に武器を抜いてそいつらを逮捕し、あるいは彼らを殺すべきだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "で、それから？　知っているか、マスクを外した彼らの正体を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "あっという間にどこぞの伯爵に、いや、それどころかいずれかの選帝侯の継承人に早変わりする可能性すらある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "そしたら私はどうなる？　仮に運良く生き延びたとしても、再び監獄にぶち込まれるだけだろうな。ハハ！　公園内のその激しい戦いも個人的な恨みによる殴り合いになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ユリア、ヤンの姉がまさにそうだ。私は彼女と最後に会った野郎を捕らえてやりたい、だができないのだ！　そいつの一族と女帝との関係のせいで、髪の毛一本すら傷つけることができないからだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "法の執行者であれば、法の導きにのみ従うべきであって、個人的な損得勘定を勘案すべきではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "法律が人一人の損得や生死を気にしたことがあったか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "法はあなたが遺言を残すことを認めています。もし、これからの戦闘であなたが犠牲になれば、あなたの生前の願いを私が厳格に執行しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……あなたは本当に独特なユーモアのセンスがあるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "だがあなたのおかげで思い出したよ。巫王に反対する部隊に参加してあの高塔に突撃した時は……たとえ死んでも、何かを残せると本気で思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "だが見てみろ、今の私は一体どんな姿だ？　酒に浸り、賄賂を受け取り、より地位の高い貴族にへこへこと頭を下げている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "あなたの言う通り、私は法の執行者に相応しくない。私を救ってくれたあの年寄りも、きっと後悔するだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "過去の事件の結果が、現在の判断に影響を及ぼしてなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたはそのユリアという少女を救うことはできませんでしたが、今さっき彼女の弟を救いました。さらにはまだ他の者を救う機会もあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "あなたが羨ましいよ、執行人殿。ラテラーノを去る時、私はサンクタのことを、なんと理解しがたい人々だろうと思っていた。今思うと、あなたたちはむしろ最も分かりやすい人種だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "しかし……ラテラーノの法律であっても、一つも誤りがないなどあり得るのだろうか？　本当に常に正しいのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そうした事件については、私も経験があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "現在追っているこの事件は、私にとって特殊なものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "彼女の行いはラテラーノの秩序を著しく脅かしています。しかし結果として、その明らかな過ちに対して、法は彼女を裁くことが未だにできていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "なら疑問や失望などを抱かないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私の経験から判断すると、失望というのはある物事に一定以上の前向きな感情を寄せることを前提として発生します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "しかしあなたにはない、そうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ハッ……執行人殿、あなたは私が見てきた他のサンクタとは全く違うな。あなたはラテラーノを心から愛したことがないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "任務執行のために、感情が必要だと認識したことはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "かもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "それか、あなたが私のように自分を疑い、迷いや動揺を感じざるを得なくなった時に……力や理由が必要であることに思い至るかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "その時に気付くだろう、法ではあなたを導けないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "チェロの音。ターゲットは前方にいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたが進むことを拒否するのであれば、これから私は単独で対象の所在地へ向かい、逮捕任務を執行します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "行くといいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私は引き続き憲兵隊に協力してもらいたいと思っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "それはもう私の管轄ではない。帰ったらすぐに市政府に辞表を提出する。ツヴィリングトゥルムを去る前に、後任の者に以前あなたから送られた書類を渡しておくとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ロリス・ボルディンさん、私はかつての「英雄」がすでに死んだとは思いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたは私の目の前にいます。職業柄、私が生死の判断を誤ることはありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……そうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ハハ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ターゲットはここにいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あのチェロの旋律は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "水を噴き出してる像に気付いてないんですか？　術式はすでに変えられ、彼女の演奏を再現するものになっています。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "サンクタさん、なぜ僕に狙いを……気は確かですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "カレンデュラ小路、密林公園。あなたは事件に関連する場所に毎回現れています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "また言動が同年代の平均的なリターニア人のそれと合致しません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "以上の証拠は、身元が非常に疑わしいことを示しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "それで僕に銃口を向けるのですか？　僕があなたたちの味方である可能性を考えたことはないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "素性を隠そうとする者に対しては、制圧してから尋問するのが、より効率的な選択です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "……壊滅的に不器用な術師が調節した像でさえ、あなたよりは融通が利きますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "さっきまで、こんな罠に何の意味があるのか不思議に思っていたんです。リターニアでは、この旋律が人が演奏したものではないことくらい子供でも分かります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "罠を仕掛けた人は、きっとあなたをよく理解しているのでしょう。このチェロの曲を聞けば、長い間腹を空かせた牙獣が肉を見るように襲い掛かって来ると、その人は分かっていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "そうすれば、本当の標的に手を下すことができる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……ロリス・ボルディン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な学生",
      "text": "誰ですか？　あの事なかれ主義の憲兵隊長官ですか？　彼が何か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたの言う通りです、アルトリアはあえて私を誘い出した。彼女が探している人物はロリス・ボルディンです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ティーム、私だ。聞きたいんだが、ヤンは帰ってきたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ならいい。安心した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "伝えておいてくれないか。あいつの姉……ユリアのことは、本当にすまなかったと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "私は早めにリターニアを去ることにする。ここ数年で集めた手がかりは、全てボーデン区の家に置いてある。鍵はお前に渡した財布の中にある、ヤンに渡しておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "私が去った後……誰かがこの事件を引き継いでくれるといいが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "これだけ長い間ずっと追ってきたんだ、結果は必要だ。私には成しえなかったが、他の誰かならできるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……さっきよりも激しい物音だな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ピム、今密林公園の近くにいるんだが異常事態が起きている、部隊を一つ寄越してくれ。いや、一つじゃ恐らく足りない、呼べる奴は全員寄越してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "そうだ、恐らくまたマスクをかぶったバカどもだ。尻に火をつけた鉗獣を放って、下水道をめちゃくちゃにしようとしている程度ならいいんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "罪のない不幸な者が奴らに鉢合わせなければいいが。もしそうなれば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "チェロの音、どこからだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "誰だ？　誰がそこにいる……サンクタ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "執行人殿、あなたか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「フェデリコ」",
      "text": "過去の事件の結果が、現在の判断に影響を及ぼしてなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「フェデリコ」",
      "text": "あなたはそのユリアという少女を救うことはできませんでしたが、今さっき彼女の弟を救いました。さらにはまだ他の者を救う機会もあります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……幻覚？　いや、ただの記憶か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "何でもない、ピム。こっちは私一人だ。ふとさっき起きたことを思い出してな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "そうだ、騒ぎを起こした連中は足元にいる。アーツビーコンを残しておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "危険なのはわかっている。今すぐに離れ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「強情な学生」",
      "text": "ほら尻尾を巻いて逃げろよ、上官。当時の勇敢さなんてどっかに失くしちまったくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「強情な学生」",
      "text": "「最初に巫王の塔に足を踏み入れた兵士」――お前は自分がまだあの英雄だと本気で思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "クソガキめ、また頭の中でちらつきやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "お前に話してるんじゃない、ピム。そろそろ動かないと。話はこの辺にしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "……自分が意気地なしだってことは誰よりもよく分かっている。ユリアの死因すら見つけられず、あの子のために復讐もしてやれない腰抜けだってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ユリア……ユリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "もしお前が今の私を見たら、何と言うだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "優しいお前のことだ、多分失望を表に出さないんだろうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「憲兵」",
      "text": "小僧、そう気を落とすな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "あんただったか、ジジイ。あんたまで私の記憶の中から飛び出してきたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「憲兵」",
      "text": "お前さんは確かに間抜けだ、だがなかなかどうして勇気はある。近頃じゃ絵の巫王に向かい合おうとする者はおらん。ましてや足で踏みつける者などな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "でも私はただ通りかかったツキのない男にすぎない。私のような者のために命を張るなんて、本当に価値はあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「憲兵」",
      "text": "わしに義理を欠いているなどと思わなくていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「憲兵」",
      "text": "巫王の下であれだけ長い間働いてきたわしの末路が、良いわけなかろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「憲兵」",
      "text": "お前さんを逃がして、少なくともこの人生の最後の数日は安らかに眠ることができた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「憲兵」",
      "text": "お前さんもだ、小僧。気が晴れないなら、何とかしてより多くの人を救ってみればいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リーベリが足を引きずりながら去り、すぐに日差しの下の影の中に消えた。\nその影は長く引き伸ばされ、まるでかつてのあの高塔が落とした影のように地を覆っていた。\n多くの命が、誰も見ていない影の中で消えゆく。過去そうだった、今もそれは変わらない。\n耳元のチェロの音が次第に消えていく。\n残ったのは足元から伝わる振動だけだ。これまでの経験から彼には分かっていた、それは罪なき命がもがいている響きだと。\nもちろん彼はその場にとどまっても構わない。\nあるいはラテラーノを去った時のように、ここを、リターニアを去ることもできる。\nただ踵を返して、背を向けて離れるだけだ――過去十数年彼はずっとそうしてきた。先頭を切って突っ込むよりはるかに簡単だ。そうだろう？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "ジジイ、私は本当に疲れたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "生きたいよ。それだけでなく、毎日できたてのビールを飲んで、仕事終わりにはピムたちとジャズを聞きに行きたい。来年の夏には、サーミにバカンスも行きたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "結局……私はあんたみたいに英雄らしく死ぬことはできないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "なのになんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "なんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロリス",
      "text": "こんなにも失望しているんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "すでに疲れ切っていますね、伯爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ふぅ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "鉱石病があなたの体を蝕んでいます。これ以上アーツの使用を続ければ、結末は自滅のみです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そうなれば……お前らは怖いのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "申し訳ありませんが、そのような行為を許すわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "うっ――くっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "あた……頭が……痛い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "我々はあなたを傷つけたくはないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "しかし「首席」は、あなたの体の中の旋律は、あなたの頭よりも価値があると言っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "必要であれば、あなたには暫しの……眠りについていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私の意識を……排除するつもりか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "させ……るか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ぐあぁぁ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "リーベリ……憲兵隊の制服？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "たった一人か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "英雄気取りが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「早く行け。私の部下がすでにこちらに向かっている。」\n面識のないその人物がそう言ってきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "感謝……する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "気を付けろ、ターゲットを逃すな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エーベンホルツは、自分に残されたチャンスが多くないことを理解していた。\n血がぽたぽたと口元から流れ落ち、彼の頭は張り裂けそうなほど痛んだ。\n背後では未だに戦闘が繰り広げられている。救い主がどんな姿をしているのか、炸裂する炎の光を借りて知りたかったが、影はあまりに小さく、すぐにアーツの光に飲み込まれてしまった。\n彼は走り続けるしかない。\n前へ前へ。足を止めず進み続ける。\n足元の道がどこへ伸びているのか、どれだけの力を振り絞れば、とうの昔に定められた結末から逃れられることができるか――彼には分からなかった。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
