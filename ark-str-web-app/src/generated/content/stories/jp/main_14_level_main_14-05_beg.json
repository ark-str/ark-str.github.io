{
  "server": "jp",
  "storyId": "main_14_level_main_14-05_beg",
  "groupId": "main_14",
  "stageId": "main_14-05",
  "title": "交戦視野の確認",
  "storyCode": "14-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_14-05_beg.txt",
  "sourceHash": "0dc7339aab1ee1a585f2edb08b867887e28fc638abfef0b3dcc5b03a3365a5a5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "パプリカ、パプリカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パプリカ",
      "text": "ちょっと！　勝手にうろちょろしたらダメっすよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "いいからさっさと逃げるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パプリカ",
      "text": "何言ってんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "さっき、Wのところの傭兵たちが全員出ていったのに気づいたんだよ。きっと、軍事委員会の人たちが攻めてきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パプリカ",
      "text": "だったらなおさら隠れてなきゃダメじゃんか。飛んでくる砲弾に当たっちゃうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "俺たちは軍事委員会に雇われてるってことを忘れんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "軍事委員会が攻めてきたってことはな。ここの奴らはどうせもうおしまいさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "逃げるには今が絶好のチャンスなんだ。うまいことマンフレッド将軍に会えりゃ、説明したら、きっと分かってもらえるって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パプリカ",
      "text": "将軍のとこに戻るって……まだヴィクトリアに残って人を殺し続けるつもりなんすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "んなこと知るか！　俺たちが投降したのを将軍に知られたら、それこそおしまいだろうがよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "まずは生きることが先決だろ。輸送を任されりゃ輸送をするし、人を殺せと言われりゃ俺は殺すぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える傭兵",
      "text": "ここに残りたけりゃ勝手にしろ！　俺はもう行く！　あばよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "作戦開始から五十時間後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナディーン",
      "text": "本当に運の良い方ですね、ウルスラ軍令長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディーン",
      "text": "極めて重要な戦争兵器を失った挙句、反乱軍に捕虜にされたというのに、五体満足で戻ってこれるなんて、あまりないことですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディーン",
      "text": "元スカーモールの傭兵同士、仲良くやっているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "黙りなさい、若きナハツェーラー。私の失態をあんたごときにつべこべ言われる筋合いはないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "どうあれ、ウルスラ軍令長の生還は軍事委員会にとっては朗報だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "マンフレッド将軍、私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ブラッドブルードの大君の戦死は知っている。釈明は後で聞く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "だが、ここに現れたからには、何か価値あるものを持ってきたのだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "骨骸の現在位置と……骨骸内部を守る傭兵の具体的状況は把握しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディーン",
      "text": "それだけですか？　傭兵どもの元に留まっていた方がまだマシだったように思えますけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君の考えを聞かせてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "巨獣の骨骸は起動不能の状態にあり、傭兵たちは現在あれを再起動する方法を探っているところです。奴らの今後の計画では、骨骸が欠かせないと思われます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "具体的な計画は不明ですが、骨骸内部に駐留しているのは、なぜか少数の模様です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "それで、ヘドリーもそこにいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "例の峡谷を包囲するよう通達しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "いかなる犠牲を払おうと直ちに「ライフボーン」を奪還するのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナディーン",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "マンフレッド将軍、これから戦いには――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "参戦は不要だ。後方に控えていたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "承知しました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "将軍……念のため、一つお伺いいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルスラ",
      "text": "もしも敵の抵抗が激しく、骨骸の奪還に苦戦したとしたら、いかがなさるおつもりでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "そのような仮定を聞きたくはないな、ウルスラ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "マンフレッドの軍隊はやはりやってきたか。予想より少し早い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "王庭軍の情報は？　ウルスラはまだ何も話さないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "取り逃した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺の不注意だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ケジメをつけてもらうのは、あとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "Wは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "外の戦場の様子を調べに向かったわ。最悪の場合、もう敵軍と遭遇してるかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ウルスラがマンフレッドの元へ戻ったなら、我々の位置や守備の状況は、全て漏れている可能性が高い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "我々と敵の戦力には大きな差がある。持久戦に持ち込まれたら、こちらに勝算はない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ドクターたちが出発してからもう五十時間になるな。連絡は来ていないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "まだ何も。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "何にせよ、約束の時間まで持ちこたえなければならん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "こっちの人手からすると、軍事委員会の大軍を丸一日食い止めるには、マンフレッドの頭上に天災でも降り注ぐのを期待するしかないわ。だけど今や天災は奴らの言いなりよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "自分たちの制空権を脅かすような兵器がこっちの手にある現状を軍事委員会は決して許したりしないでしょう。何が何でも私たちを潰しに来るわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……賭けに出るしかないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "マンフレッドが、この骨骸の破壊を望んでいないことに賭ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……奴が本当にあなたの思っているような男だといいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "それと、問題はもう一つあるわ。約束の時間になっても、ドクターからまだ連絡が来なかった場合はどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "その時は骨骸を放棄する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "命を懸けてまで戦う意味はない。いついかなる時も、より多くの人が生き残ることこそが俺たちの最優先事項である以上、撤退を優先するまでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "合理的な判断だ。私に異存はない。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "それと王庭軍の進攻を食い止める方法がもう一つあるかもしれん……\n敵の指揮官の首を直接取ればいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "アスカロンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "私が、奴を仕留めよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ねえ、そこの腐った木偶の坊さん。悪いけど、グズグズしてる時間はないの。今からいくつか質問するけど、この爆弾をあんたの顔面にぶち込むかどうかは、答え次第で決まるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ここは聴罪師の祭壇よね。あんたは聴罪師なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガンッ――ガンッ――\n斧を叩きつける音は変わらず、まるで太古の昔からそうであったかのように、身の毛もよだつリズムで鳴り響き続けている。\n怪人はゆっくりと口を開いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我は、魔王クイサルトゥシュタの従僕である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "魔王の血脈は生と死の中で続いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "聴罪師が魔王に仕える者であるならば、我もまた聴罪師である。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "回りくどい言い方……あんた、人の言葉を喋れるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "引き金を引く前に、自己紹介の時間くらいはあげるわよ。この場所は何？　聴罪師と何の関係があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "Qa……lid'čoa……クァリドチョア……「鍵」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "だが、この鍵に開き得る扉はもはや存在せぬ。今や我はこの幽玄たる墓所の……墓守に過ぎぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "何言ってんのあんた……墓所ですって？　誰の墓なのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "カズデルにかつて存在した数多の英雄と、かの者らの手によって葬られた仇敵どもの墓だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "「負碑者」、「八英傑」、「十一勇士」……かの者らはみな歴史の中に没した。我がこの目で見送った者もまた少なくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "この地に埋蔵されるは、かの者らの武器と甲冑であり、昔日の余燼である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "冗談でしょ？　そいつら全員と付き合いがあったって、あんたまさか、あのクソババアと同世代じゃないでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたら老いぼれのバケモンどもってほんと退屈よね。そうやって過去のことにしがみついてるなんて、昨日の夕飯に何を食べたか忘れたら、今日は歩けなくなるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "かの英雄の時代に頭角を現した者らは、一人、また一人と、サルカズを救う希望と見なされていった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "だが、その誰もが敗れ、墓の中の一すくいの灰と化したのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "お前の足元に転がっているのは魔王クイロンの「蒼き怒火」と呼ばれる剣だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "その剣を帯びることを拒んだテレシスは、剣をこの地に残した。しかれども、お前がそれを踏みつけるべきではあるまい。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "クイロン？　それって神話に出てくるやつじゃ――\n適当言ってんじゃないでしょうね？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "お前の問いには答えた。次はお前が、我の問いに答えよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "なにゆえ、この地に踏み入ってきた？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガンッ――\n斧が再び振り下ろされ、押し寄せる衝撃に、Wはまた一歩後ずさった。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしは聴罪師の邪魔をしに来たのよ。ここの祭壇は何に使うものなのか、素直に吐きなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "祭壇はすでに役目を終えている。迷い込んだ愚者を除き、他にこの地を訪れる者はおらぬ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ちょっと、聞いてるの――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "攻撃は無意味だ。もはや我が肉体に、変化はあり得ぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "出来損ないの器は、王冠を迎える道具として永遠を生きることもなく、また死の安らぎを得ることも叶わんのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "へぇ？　それじゃあんたも聴罪師の実験が生んだ失敗作ってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "きっと自分が憐れだと思ってるわよね。じゃあ、あたしが解放してあげてもいいわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "無用。また無意味である。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "怪人は石斧を振り上げると、煩わしい虫けらを払うようにWの放った爆弾を弾いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "聴罪師が作り出した不死身の肉体だったっけ？　この距離からぶっ放しても、あんたの頭が弾け飛ばないかどうか、確かめてあげるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "実験大好きな聴罪師のことだし、あのデカい面した蛾もあんたらが作り出したんでしょ？　バケモンを生み出すためだけの巣窟だなんて、吐き気がするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "訳の分かんないポエムはいいから、聞かれたことにだけ答えて――あんた、テレジアを知ってる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "流刑者たる我は、幸いにもかの魔王にまみえたことがある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "この地は、悲哀の魔王の蘇りし地だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ここで……奴らは……どうやって？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "聴罪師はかの魔王の血染めの躯を持ち帰り、サルカズの魂から彼女の魂を裁断した。だがその魂同士はすでにへその緒で固く結びついており、もはや彼女が彼女として存在することは叶わなんだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "Wは振り返り、洞穴中央に置かれた祭壇に目を向けた。\n凶悪な造形をした施設は不穏な気配を醸し出しており、かすかに漂う血生臭さが鼻を突く。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どうして……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "サルカズの現在は彼女の死を欲していた。サルカズの未来は、彼女の生を欲していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "彼女は魔王として、自らの全てを捧げると決意した。魂と識を、血と骨を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "傭兵よ、お前は魔王の配下として、彼女を追うべくやってきた。だが今の彼女はお前の知る人物ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "我は見た。この地で呼び覚まされた彼女の悲しげな面持ちを、その背負う魂の重さを。彼女の魂に、安らぎは永遠に訪れぬであろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……黙りなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "彼女は供物なのだ。サルカズの魂に、カズデルに、過去と未来のあらゆるサルカズに、捧げられるためのな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "黙れって、言ってんでしょうが！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "洞穴全体に、煙がもくもくと立ち込める。その爆発はWの怒りを晴らすには不足だったが、古びた施設は一面の廃墟と化した。\n洞窟の奥深くには扉のような形をした祭壇がまだ一つ残っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "澄んだささやき声",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "何よ……これ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "澄んだささやき声",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Wは扉を押し開けた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
