{
  "server": "jp",
  "storyId": "act16d5_level_act16d5_10_beg",
  "groupId": "act16d5",
  "stageId": "act16d5_10",
  "title": "夕",
  "storyCode": "WR-10",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16d5/level_act16d5_10_beg.txt",
  "sourceHash": "238ff8a139367d4f462225e4b2ea382d5a9595443c3cd92e27a472be292648bb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "（ここが……龍門か。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "（急がなければ――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ご老人、ちょっと、ちょっとよろしいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うむ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "その……ちょっと聞きたい事があるんですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "この近くに董家鱗獣団子というお店はありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お主……龍門の人間ではなさそうじゃな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "噂を聞いてやって来たのかの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "はぁ、その通りです。噂を聞いて来たんですよ、有名ですからね。ははは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今何時だと思っておる？　とっくに店じまいじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もし本当にありつきたいなら、朝八時には列に並ぶんじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "店じまい？　じゃあ店主の董さんがどちらにお住まいかはご存じですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ふうむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ご老人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もし団子を食いたいだけなら、あやつの名前――ましてや住所など関係ないじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "う……ははは。確かにそうですね。はは……じゃあやはりまた明日にします――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "待て、若いの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "うっ――？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ご、ご老人、何するんです？　杖をどけてください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何ゆえ董を探しておる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "わ、私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "誤魔化しても無駄じゃよ、若いの……正直に話すんじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "一晩中、随分たくさんの人間に声をかけておったな。隠居した老人から灰尾香主まで訪ねて、最後に鱗獣団子屋か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "真夜中にこんな所まであやつを探しに来る者など、普通おらぬわ。しかもお主の持っておるその扇子……ワシは知っておるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……あ、あなたはいったい！？　うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "動くでない、若いの……まずは答えよ。他に誰を訪ねるつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "その人たちだけです！　董さんとはどうしても会わざるを得ない状況で――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お主……廉家の者か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "いいえ違います！　聞いてください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "動くなと言うたじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お主、武術家じゃな？　ワシは目だけは耄碌しとらんのじゃよ……そして、その陰晴扇は廉家のものじゃ、廉子虚（レン・シキョ）はお主の何なんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "――私のお師匠です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ほう……彼女に何かあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "し、師匠は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どうしたのじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "死にました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……なにゆえじゃ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "わっ……私のような出来の悪い弟子のせいで、むざむざと殺されてしまいました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……惜しい者を亡くしたわい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "リン殿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ほう……なぜその名を知っておる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "し、師匠からお話は伺っておりましたが、まさかこんな所でお会いするとは……お願いです、どうか私を匿ってください！　私はまだ捕まる訳にはいかないのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "お主、無様に生き長らえるために龍門に逃げてきたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ここで廉家の炎を絶やすわけにはいかないのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "近衛局へ行った方がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "役人の手には負えません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "分かった……お主の師匠と董の旧友の仲に免じ、ワシがお主にチャンスをやろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "三発以内にワシの杖を折れたなら、共に来るが良い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "――で、できません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "やるのじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "師匠は、董さんは龍門のリン殿に恩がある――すなわち彼女もあなたに恩があるのだと言っていました。どんな状況であれ、師匠の恩人に不敬を働くことは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "いいからやれと言っておる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "――いえ！　できません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "臆病者め！　その扇子は飾りか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "私は廉家の人間ではありません！　この扇子を使う資格などないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "だがその手に握っておるではないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ダメです！　私ごときが廉家を代表などできません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "それでは、お主の師匠は無駄死にしたことになるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "私は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "うむ、鋭い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "申し訳ありません、リン殿……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ワシがやらせたことじゃ。這いつくばってまで謝る必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "五年じゃ……龍門でお主を匿ってやろう。五年後、お主を勾呉城へ送り返す。その後のことは、自分で決めるがよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "――――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "付いて参れ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "ウユウの兄貴、本当に行っちまうのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "ずっと龍門にいなよ。いいところだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "やるべきことは、やはりやらねばならないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "引き留めても無駄みたいだな……これが最後の一杯になるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "いやいや、この酒は残しておいてくれよ。もし私が生きて帰って来られたら、また一緒に飲もう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "その時は、私ももう偽名を使う必要などなくなってるはずさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "――ああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "待ってるぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "本当に戻って来るとはな……予想外じゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "またまた。そんなつれないこと言わないでくださいよ。あなたには恩があります。どうして何の義理も果たさずにいられましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "フン……相変わらずペラペラと調子の良いことをほざきおって……最初に会った時はガチガチに緊張しておったくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "あ、あはは。やめてくださいよリンさん、人を叩けど顔は潰さず、相手の面子を立てるべしと言うではありませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "で、今後はどうするつもりかの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……事は済ませましたが、多くの人の恨みを買ってしまいました。故郷に戻って暮らすのは現実的ではありませんので――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "店を一件譲ってやろう。市場の中心で、そこそこ良い物件じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "そんな、悪いですよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "――これがその店か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "うむ。曰く、「和気は富をもたらす」。ということで、この店の名前も「和気」だ。どうだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "老人ホームみたいな名前だな……しかもその名前でフィットネスジムなのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "今の時代、お金が稼げればそれでいいだろ！？　老人向けのフィットネスジムだと思われても良いじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "来る人なんているのかな……え、しかも年会費制だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "あはは……閑古鳥が鳴くのが悪いこととは限らないよ……最近こういうのも流行ってるらしいし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがり",
      "text": "あの〜すみません、ここはフィットネスジムですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "おお！　お客様こちらへどうぞ。私どもは正統な炎国武術のジムでございます。こちらに通えばたくましいお身体が手に入ること間違いなしです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがり",
      "text": "ああ……そうなんですか。待ってください、今クレジットカードを出しますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "お前は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "兄貴！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがり",
      "text": "龍門に来たから安心できるとでも思ったのか？　お前は決して逃げられない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "死ね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "ウユウの兄貴！　兄貴！　大丈夫か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "おいおい……これが大丈夫そうに見えるかい……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "だ、大丈夫だ、落ち着いて。今救急車を呼ぶから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "いやいい。ゴホッ！　ゴホゴホッ――もうダメだ、分かってる……開店初日に流血騒ぎなんて、まったく縁起が悪いな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "おい……ゴホッゴホッ、泣くなよ。男だろ、泣いてどうする。人が一人死ぬだけだ、この街じゃよくあることさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "い……嫌だ、俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "誰かに看取られる最期も……まぁ……悪くない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰尾メンバー",
      "text": "兄貴！　兄貴！！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "よう。お前、人生の後半は、師匠の仇討ち以外に何もしてないじゃねえか。それにせっかくの夢だってのに、そこでも死んじまうなんて、もったいないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "え？　私はさっき死んで……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "まったく何やってんだか。もし私が来てやんなきゃ、また勾呉城を逃げ出した所から生き直さなくちゃなんなかったんだぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "さっさと起きて働け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "クルースちゃん！　来てくれたんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……ビーグルちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "どうしてまだ……ロドスの服を着てるの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "へへ、長期休暇とはいえ、結局この服が一番落ち着くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "それより見て、ここはいい場所でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……ここが新居なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "そうだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "何日か泊まっていかない？　たっぷりおもてなしするから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……うん～！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "本当にこんなところから進むのぉ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "しっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "あれ見て……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "……ちっ、面倒くせぇ。あのキャラバン、目ぼしい物は何も持ってないくせに、俺たちを総動員させやがって。知ってたら俺は付いてこなかったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "いまさら言っても仕方ないだろ。おい、荷物を持ってこい。ここもアジト代わりにできそうだ！　印を付けておけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――強盗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "うん。前にトランスポーターのお姉さんが言ってたけど、最近山の治安が悪いらしいから……こういう山中に隠れてたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "クルース、早く戻って警備隊に通報しよう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――どうしてぇ？　私たちで片付ければいいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "クルース、冷静にならないと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "おい、また車の隊列が近づいてきたぞ！　きっと他の商人だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "のんびりしてたら間に合わなくなっちゃうよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "えええ、クルースがそんなことを言うなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……私だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "あっ、盗賊たちが動き出した！　わたしが守り――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――それぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "お前――！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "おい！？　どうした？　どうしてあいつは倒れたんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ここだよぉ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "わ……一瞬で全員倒しちゃった……しかも全部急所を外して、動けなくしただけだなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "いつの間にそんなに強くなったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "それじゃあ、警備隊の人を呼びに行こっかぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "うん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ふあ……おはよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "おはよう、クルースちゃん。よく眠れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "急に早寝しろって言われたから、逆になかなか眠れなかったよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "はは。でもトランスポーターのおじさんたちは出発が早いからね。一緒に乗るなら、早起きしなきゃダメだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "もう、そんな顔しないでよ。しばらく別々になるだけでしょ。いつでも遊びに来てよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "あ、それとフェンさんにもよろしく言っておいてね。今頃どうしてるのかなぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "わかったぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "えへへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "はい、荷物だよ。わたしが整理しておいたからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "そんな暗い顔しないでよ。ほら、笑って！　フェンさんのところに行くのに、暗い顔してたら心配掛けちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "次回はクルビアのお土産を持ってきてね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……うん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "じゃあまたね、クルースちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "またね、ビーグルちゃん――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "互いに「またね」と挨拶を交わした。\nそうはならなかったことを知っているくせに。\nもっともっと苦しむことになったのに。\n......\n「わたし……あなただろうなと思ってました。ごめんなさい。道を譲ることはできません。絶対に。」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……え？　私はさっき何を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……目が覚めましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "もうここで身動きが取れなくなってかなり経ちましたね……良い夢は見られましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "謝らないでください、クルースさん……ですが食糧がもう底を尽きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "一か八か、山を越えてみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ボリバル本軍の情報が途絶えて随分経ちますから……もしかすると彼らもルートを変更したのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ビーグルちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "とにかく、ここを離れなくてはなりません。任務の期限はとっくに過ぎてしまいましたし……ロドスに報告もしなければ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……どうして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "どうして……こんなの変だよぉ……ここまで来て緊急通信の応答がないなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "さ、作戦マップでは、彼らの野営地はすぐそこのはずなのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ねぇ――！　どこにいるのぉ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "こ、これは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……ビーグルちゃんが……？　ねぇ、あなたは本当にビーグルちゃんだって言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "な、なんで？　どうしてぇ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……詳細の報告は後日上がってくるそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "それに……クルースさん、私たちはこの件に深入りすべきじゃない……もしボリバルの件がこんなにも複雑なら、私たちでは……私たちでは彼女の力になれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ロドス本艦に戻るのが先決です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "でもビーグルちゃんを見捨てるなんて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――いや、私が……私がビーグルちゃんを止めないと！　どんな手を使ってでも……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "よう、クルース。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……ニェンさん、ごめんなさい、今話してる余裕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "そうかそうか。まぁシーの力じゃ、オメーらに本当に夢のような人生を作ってやることはできねーしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "だからオメーらの人生を水面に映った映像みてーに再現してるってわけだな……けどオメーらもよぉ、どうせ偽物なんだし、ちったぁ良い結末を選べねーのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "何を言ってるの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "なんでもねーよ、心配すんな。私がいるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "私はアイツの姉ちゃんだぜ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "クルース！　ウユウ！　どこだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……真っ暗だ……どうなってるんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "さっき煮傘さんが……せっかく点けた火を消してたような……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "いったい何が起こってるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "うーん、サガの方がどうなったかも分からないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……地面が消えたってわけじゃなさそうだが、うかつに動けないな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "ラヴァ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "うああ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ニ、ニェン！？　どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "慌てんな。私は正真正銘の本物だからよ。お前らを助けに来てやったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "ただな……なんつーか、はぁ……こりゃアイツの仕業か……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "何も見えないんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "――いや待て、少しだけ何か見える……あそこに誰かいるような？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "……こいつは罠だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "アイツは私がお前に渡した物の正体に気づいた……そんでもって、すぐにお前たちにそれぞれ別の夢を作って、そこに落としたんだ。だが――残念ながら少し遅かったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "夢を作る？　どうやってそんなことを！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "知るか。でも普通の人間の巡り合せを作ってやるのは簡単だ。別に人生そのものを作ってやるわけじゃねーからな。夢って言ってるけど、本質上は……自問自答を繰り返す走馬灯みてーなもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "一面の鏡、一つの湖、もしくは深く遠い星空。一度絵の中に入れば二度と抜け出せない。そういう能力なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "しかし何でラヴァだけが例外なんだ？　……あ、もしかしてお前と一緒に火鍋を食べた回数が多いからか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "そんな理由でアタシを面倒事に巻き込むな、早くどうにかしろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ニェン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "……ん？　ああ、なんでもない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "もう一つ話を聴いていかねーか？　私は絵の中に人を閉じ込めるような陰険ヤローとは違って、難しい話はしねーからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "こんな状況だぞ。先にどうやって脱出するか考えるべきだろ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "おいおい、工業や人口の規模、源石の技術が今ほど伸びてなかった古代で、みんなどうやって本物の巨獣と戦ってたか聞きたくねーのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "オマエ、こないだもそうやって語り始めて、しまいにゃ玄極巨兵が出てきたじゃないか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "お前が興味あることを話してやってんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "興味なんて……もういい。わかったから話せよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "よし……遙か昔、炎国の広大な領土には神が住んでいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "ある代の炎国皇帝は、自らの繁栄した国土で、人々が天災の苦しみに喘いでいるのを見て、悲しみ哀れむと同時に考え込んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "歴史に残る論争を呼んだあの皇帝は、当時はちょうど青年で、気力に溢れる真龍だった。そして奴は自身の腹心の大臣にこう言ったんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "「溥天の下、王土に非ざる莫く、率土の浜、王臣に非ざる莫し」と言うが、ならば、なぜあの高みにいる蛮荒の者は、炎国臣民の願いを聞き入れず、炎国臣民の国土を守らないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "……お前も知ってるだろ。一部の国家の民俗伝承や歴史上の「神」は哲学概念上のそれとは違う。だが別に奴らは「高み」にいたわけじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "真龍はそのうちの一柱を深い岩山の奥地で見つけた。傲慢で、人を見下した神だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "炎国の壮大な歴史も、神から見ればちっぽけなもんだ……当然真龍の意見になんざ耳を貸さねー。人間の生死なんて、気にする必要がねーからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "しかし、真龍は国と臣民をとても気に掛けていた……あまりにも気に掛けすぎてたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "真龍は自ら兵を率い、国の総力を挙げて大討伐に乗り出した。真龍の命により、空前絶後の奇才たちも、この空前絶後の大討伐に投入された――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "そして……予想外だったのは、真龍が最初に見つけた神が、自身の同族や親しい者を裏切り、自身の力をいくつかに分散すると、この稀代の大討伐に参戦してきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "大討伐の結果、真龍の逆鱗に触れた数柱の「神」が殺され、真龍に楯突く存在は全て炎国から駆逐されていった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "だが炎国も痛ましい代価を払うことになった。屍山血河っつーのはああいうのを言うんだろうな。真龍の功罪に対する論争も、そこから始まったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "だが奴自身はどんな論争が起きようと全く気にかけず、一生をかけてその大討伐を続けた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "奴が老いた後、ようやく炎国の地に残る神は最後の一柱となった。それは、かつて親族を裏切って真龍に手を貸した、最も偉大で最も古き神であった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "その時にはすでに、その神は然るべき報いを受けていた。同族たちが炎国を去る前にその威勢を砕き、傲慢な本質を皇帝率いる大軍の前で晒し上げたからだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "だが真龍は、功績と罪科を相殺する形で、神の命を取らなかった。その代わり炎国に仕えるよう命じた。天地の為に心を立て、生民の為に命を立て、往聖の為に絶学を継ぎ、万世の為に太平を開けと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "そうして炎国の繁栄は、真龍の手、炎国臣民の手にのみ握られることとなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "その後、「神」――つまり諸国王朝の勃興に先立って台頭した者たちは、隠遁を選んだ。分割した自らの種の欠片に権限と機能、そして魂を与え、それらに大地での役割を代行させたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "……そいつらは依然としてテラの大地に色んな形で存続してる、まあ数はだいぶ減ったけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "だが皆賢くなった。今じゃ大地のあちらこちらで家族仲良く暮らしていますとさ。ううむ、ハッピーエンドってやつだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "オマエ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "……テラ各国の悠久の歴史を紐解いても、「神を臣下にした」なんて言ってのけた国や人間は、未だかつて一つもないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "炎国はやっぱり怖ぇところだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "はぁ……とりあえずここを離れるぞ。これ以上こんなところに居たくねーからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "この絵はシーの切り札だ。幸いアイツに迷いがあったおかげで、それにつけ込めるんだけどな。ヘヘッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……つけ込むって、どうするつもりだ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "私たち……一体どうしちゃったのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "う、頭が重い……ん？　クルース嬢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ウユウくん……？　ラヴァちゃんや、サガさんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "分かりません……お、恩人様、私たちは灰斉山に戻ったのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "……ここから立ち去りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "あなたはぁ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "一度しか言わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "もしかして……あなたが、シー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "ニェンの差し金でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "帰りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "私は別に、あなたたちが誰だとか、あいつとあなたたちがどんな関係かなんて知りたくもないから。私には関係ないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……もしかして今までのことは、全てあなたが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "だったらなに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "何度も私の静寂をかき乱した無礼者に対する懲罰よ。これでも軽いくらいだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……まさか「爆竹」のことを言ってるのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "それなら誤解だよぉ。あれはわざとじゃない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "誤解？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "あんたたちがニェンに騙されたとしても、私は騙されないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "あいつがどう言おうと、私は会わないわ。そう伝えておいて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "それじゃあ、ラヴァとサガさんはどうしたのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "彼女たちは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "なに……どこだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "な、なんだ！？　どこから聞こえてくるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――早く伏せて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ゲホゲホッ、ゴホゴホゴホッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "――オマエ、いきなり何をしやがったんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "ん？　特大のロケット爆竹だ。全長八尺幅三尺。テラにはない科学技術の起爆方式を採用した！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "こんな至近距離でぶっ放すなら、事前に一声かけろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "時間なかったんだよ。そんなことしてたらまたアイツに逃げられるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "……だよなあ、私の可愛い妹よ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "――あんた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "あんた……私の絵を燃やすだなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "絵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "ああ、そうか。扉を開けた瞬間から、実はもうお前の絵巻に入り込んでたってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "それとも、山登りの途中からか？　あるいはこの山そのものが、夢幻の泡影にすぎないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "ハッ、道理で全然見つからなかったわけだ。この偏屈ヤローが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ど、どういうことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "それもそうだな。でなきゃ、あんな小せえオンボロ小屋に、あんだけ物が置けるはずねーもんな。お前ら誰も気づかなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "いや、それも当然か。大部分の人の思考や感覚器官も影響を受けるみてーだし、気づけなくても仕方ねーな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "お前らが普段どんな浮世離れした夢を見ても、目覚めるまではその夢の変なところに気付かないのと同じだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "おっと、お姉ちゃんに隠し事をバラされて怒っちゃったか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "お礼にあのお墓へとぶち込んであげるわよ、「お姉ちゃん」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "ハッ、あそこはもうなくなったんだ、随分前にな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "ああそう。ちょうど良かったんじゃない？　作り直してあげるわ。今度はもう少し趣向を凝らしてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "へぇ、やっぱ変わってねーな。カッとなると口が達者になるところなんかも……そういや、さっきお前も私を「お姉ちゃん」って呼んでくれたな。可愛いとこあるじゃねーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "……ええ。死ぬ運命の奴には、多少親切にしなくちゃね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "そんな心配いらねーよ、愛しの「妹ちゃん」。小競り合いは数え切れないほどしてきたが、私に何回勝ったことあるんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "やけに自信たっぷりね？　空威張りのお姉ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "text": "空威張りとも限らねーぞ、いい気になってる妹ちゃんよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "――クルース、ウユウ、離れろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
