{
  "server": "jp",
  "storyId": "act16side_level_act16side_02_end",
  "groupId": "act16side",
  "stageId": "act16side_02",
  "title": "散歩の時間",
  "storyCode": "GA-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16side/level_act16side_02_end.txt",
  "sourceHash": "a5a68e8bb99f67457eefc28be9281588b60638158fba4d2a0b091d0d6dcac818",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "もうすぐだよ……セシリア、この辺の道はわかるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うん……この辺のおうちは見たことあるよ……けど、おんなじおうちがたくさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリアはこの辺りに引っ越してきたばかりなのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "引っ越し？　わたし引っ越したことないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うーん……ごめんなさい、エゼルお兄ちゃん。ママと一緒にお外に行くのはいつも夜だったから、街の感じがちょっと違って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "だけどわたし、いつもこっそり窓からお外を見てるから……きっとわかると思う！　わたし頑張るから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "大丈夫、きっと見つかるよ。それに、まだ君に会った場所にも着いてないから焦らないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ごめんなさい……おうちを見てたから、気付かなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "あれ？　あなたは朝倒れて病院に運ばれた子？　大丈夫だった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "おっと、しばらくぶりです！　はい、この子は……元気ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "そうだ、あの後この子の親御さんは来ましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "ああそうそう！　お昼までずーっと見張ってたのに誰も来なかったのよ！　変よね、ご両親は一体何をしてるのかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "この子が言うにはこの辺に住んでるそうなんですが……本当にこの子を見たのは初めてですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "こーんな可愛い子、もし見てたら絶対覚えてるわよ！　知ってる子なら最初からあんなにあたふたしてないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "あ、あの時他のご近所さんも言ってたけど、役所の出張所まで行ってみましょうよ。もし越してきたばかりなら、出張所にきっと登録があるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "あら、いいところに……ポーラさんじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "ポーラさん！　こっちこっち！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "ん？　どうしたの？　急いで事務所に戻らなきゃだから、歩きながらでいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "ええ。それで聞きたいんだけど、最近この辺に越してきた家族っているかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "そりゃもちろんいるけど……最近ってどのくらい最近の話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "ねえ、あなたはいつ引っ越してきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……引っ越してきてないよ……ずっとここに住んでるよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "え？　じゃああなたのお名前を教えてくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "セシリア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "セシリア、セシリア……うーん、変だなぁ。ここで十年以上働いてるけど、そんな名前聞いたことないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "セシリアちゃん、あなたのお父さんとお母さんのお名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママの名前は……フェオリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "！！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "え？　えええ！？　フェオリアってセルヴァティウス通りの？　でもあの人って独り身じゃなかった？　いつの間にこんな大きな子供ができてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "でもよく見ると……確かにフェオリアさんにそっくり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "絶対変よ……もしかして隠し子？　セシリアちゃん、ずっとここに住んでるって言ってたけど、それはお母さんがずっとここに住んでるって意味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "そうだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "じゃあお母さんを探しに来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……うん、ママを探したいの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "あらら、じゃあお兄さんはフェオリアさんの親戚か何か？　この子は田舎に預けられてたとか？　この子をお母さんに会わせに来たって感じ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "どうりで前にフェオリアさんにお相手を紹介してあげたら断られたわけだ……まさかこんなに大きなお子さんがいたなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "お兄さん、黙っちゃってどうしたの？　もしもーし？　大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "あ、喋ってるうちにもうすぐそこよ。フェオリアさんのお家はあの辺りだけど、まず私が挨拶してあげましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……セルヴァティウス通り7-265。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知的な市民",
      "text": "あら？　住所も知ってたんじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃん、どうしたの？　怖い顔してる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "何でもないよ……ま、まずは、お家に帰らないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "さぁセシリア、帰ろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "名前。\nセシリアと会ってから予想外の出来事が続き、母親の名前をまだ聞いていないことすら忘れていた。\n名前……\n病気の母親、白い服を着た執行人、マントのような服を着た――おそらく、安魂教会のローブを着た修道士……\n......\nセシリアにどう伝えればいい？\nこの子をどこに連れて行けば母親に会わせてやれる？\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "リーベリのあなたが、どうしてサンクタの子をさらおうとするの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "じゃあリーベリのあんたが、どうしてサンクタの子を守ろうとしてるのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私が守ろうとしてるのはラテラーノの戒律よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "戒律？　サンクタの戒律が一体いつからリーベリに適用されるようになったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "フィアメッタ、あんた本当にラテラーノのリーベリはこの国の一員だと思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "違うの？　私はこの地で生まれ育ったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "パティア、あなたこそ自分が何を言ってるかわかってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "もちろんわかってるわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "わかってないのはあんたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ラテラーノのリーベリは、考えなしにラテラーノの戒律をあがめ、言われるがまま「ラテラーノ教」を信仰と見なし、しまいには思考停止して……サンクタを神の使いと信じてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "銃、戒律、光輪、共感……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "神はサンクタにそれだけの恩恵を与えたのかもしれないけど、それがラテラーノのリーベリと何の関係があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "どうしてリーベリには恩恵を与えない神を私たちが崇めないといけないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ラテラーノのすべてはサンクタだけのものなのよ。それがどうしてわからないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "あんた本当に、自分があいつらの一員になれたって思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "もらった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……あんたでも意志が揺らぐ時はあるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ねぇ、フィアメッタ、もっとちゃんと考えてみてよ。お願い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "昔も話したと思うけど、あたしはイベリアから来たの……あそこがどんな場所か知ってる？　……あたしに言わせれば、イベリア人の方がラテラーノ人よりも信心深いわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "でもそれで何を得られたっていうの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "イベリアは遙か遠くにある。あそこの人がラテラーノに幻想を抱くのは……まだ理解できる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "でもどうしてラテラーノにいるリーベリまで、平和ボケして好き放題してるサンクタたちに喜んで奉仕しなきゃいけないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "どうしてよ！　フィアメッタ、どうしてか教えてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……あんた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……どきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "何を言っても無駄ってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……あなたにはあなたの考えがあるんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "だけど、私にも私の考えがあるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ならどんな考えか教えてよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "どうして何も言ってくれないの？　どうして……絶対に手の届かない背中ばっかり追いかけて……一度も振り返って……こっちを見てくれないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "言ってることがよくわからないわ、パティア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それに、多少説明したところであなたの考えは変わるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "もしそんな簡単に変わる考えなら、それには何の価値もないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "どきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "時間稼ぎが目的なのはわかってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "私を止められないのはわかってるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "やるべき仕事があるのはお互い様よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それとも、あなたはその周りの……一般人と大差ない仲間たちに代償を払わせるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "パティア、あなたはそんなこと望まないでしょ。だからお互いのためにも、そこをどくのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……着いたよ、セシリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うん……でもわたしカギを持ってないから、ドアを開けられないよ……エゼルお兄ちゃんは開けられるの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ねぇお兄ちゃん、ほんとに大丈夫なの？　具合が悪いの？　さっきからずっと顔色悪いよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "大丈夫だよ、ドアも僕に任せて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃん……さっきのお姉さんに「住所も知ってたんじゃない」って言われてたけど、お兄ちゃんはどうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、この銃に見覚えはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……それは、ママの守護銃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "どうしてお兄ちゃんが、ママの守護銃を持ってるの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……ごめんね、セシリア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "どうして謝るの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わたしわからないよ。どうして……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お兄ちゃん……もしかしてママがどこにいるか知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……うん、実はそうなんだ……ごめんよ、セシリア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "ごめん……何を謝ってるのか僕にもわからないけど……ごめんね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、君のママは、もう亡くなってしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "だから、ここにはいないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ここにいない、ならどこにいるの？　「なくなって」って……どういう意味……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……あ、思い出した。朝、ママは行くところがあるけど、わたしを連れて行けないって言ってたの……もしかして、お兄ちゃんがママと一緒に行ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "それなら、わたしも連れて行って……ちょっと会うだけでいいから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わ、わたしわがままは言わないよ、ママの言うことも、お兄ちゃんの言うこともちゃんと聞くし……帰らないって駄々こねたりもしないよ……だから……だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お願い……もう一回ママに会いたいの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "まだママにいってらっしゃいって言ってないもん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "なんだよ、べそかいてんじゃねぇか。おいおいエゼルくん、まさかイジメてんじゃないだろうな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "あなたは誰ですか？　いや、その制服は……レガトゥスですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "さすが鋭いな。いやぁ、エゼルくんの今後の活躍が楽しみだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "教皇の命により、セシリアを大聖堂に連れて行かせてもらうぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "………………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ああすまねぇ、自己紹介がまだだったな。俺はオレン・アルジオラスだ。身元を確認したけりゃ、公証人役場の端末を使ってくれて構わないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "おっと、忘れてた。電源切ってるんだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……それなら、どうしてこの場所がわかったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……エゼルくん、レガトゥスをなめちゃいけねぇよ。俺たちにお前の動向が読めないとでも思ったか？　それとも、ここまでまったく痕跡を残さずに動けてたつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "オレンさん……セシリアを連行するのなら、いくつか質問をさせてもらってもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ハハ、面白れぇ奴だな。俺に質問に答える義務があるとでも思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "まぁ俺も悪人ってわけじゃねぇし……言うだけ言ってみな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリアは一体何者なんです……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "この子は……生まれつきの堕天使か何かですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……想像力豊かだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "だけどお前の想像ほど突拍子もないモンじゃないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "セシリアは混血なんだ、それだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "え……？　あり得ません……サンクタの混血が、サンクタでいられるはずがありませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "サンクタと他種族の混血の例が少ないことは知ってます……ですがそれ自体は、教皇庁を動かすほど珍しいものではないはずです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "そうだな、理由は単純明快――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "サンクタと他種族の混血の子はサンクタにはならねぇからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "サンクタとフェリーンの子供ならフェリーンに、サンクタとフォルテの子供ならフォルテになるって具合だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "サンクタとの混血は、生まれて初めて言葉を発した時にも光輪と光の翼を得ることはないし、サンクタ同士の共感も得られない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "要するに、混血であればサンクタの特徴は現れない。例外なくな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "少なくとも、ほとんどの奴がそう思ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……つまり、セシリアがその例外ということですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ああ、その子はサンクタであるべきじゃないサンクタなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……二つ目の質問です。セシリアが大聖堂に連れて行かれたあと、教皇庁はこの子を……どうするおつもりですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "さぁな、知らねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "おいおい、そんな顔すんなよ。俺は本当のことを言ったまでだ。嘘をつこうと思えばいくらでも話をでっち上げられたんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "とにかく、お前も目にしてる通りセシリアは「例外」だ。教皇がこの件をどう処理するかは、ここで明言することはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "だが今の教皇聖下なら……お前があの人にどんな印象を抱いているかは知らんが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "少なくとも、俺の知る限りあの人は過激なやり方を好まない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "それに、こんな可愛らしい子を傷付けようとする奴なんていないと思わねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……三つ目の質問です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "僕はあなたの回答を完全に信じることはできません……セシリアが大聖堂へ向かうなら僕も同行したいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ああ？　それは質問なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "残念だが、その「質問」にだけは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "オレン？　どうしてあなたがいるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
