{
  "server": "jp",
  "storyId": "main_14_level_main_14-05_end",
  "groupId": "main_14",
  "stageId": "main_14-05",
  "title": "交戦視野の確認",
  "storyCode": "14-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_14-05_end.txt",
  "sourceHash": "9febb05b568c66cdbe69ee6db2b0ba2e15150511fe711ee0e262015c0909a8e4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "見つけたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "狂人め……噂通り、お前はイカれてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "よく分かってるじゃない。だったら、あたしの手にかかった奴がどんな結末を迎えるかも、知ってるわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたら、カズデルの近くで他に何を企んでるの？　このあっけなさすぎる戦いの裏には、どんな秘密が隠されてるってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "テレシスが一体何を企てカズデルを捨てたかなんてめんどくさいから知りたくもないけど。だからってあたしをバカ扱いはしないことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "お前こそ、俺の巫術からは逃れられなかった。あとどれだけ耐えられるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたがあたしの前に跪いて許しを乞いながら、言うべきことを全部説明するまでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "ハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "傭兵……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "お前は、自分は結局のところ死にはしないと考えているな……誰でも死ぬ前はそう考えるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "死から忘れられた寵児などこの世にはいない。サルカズの魂は待っている。お前も、彼女も、そこからは逃れられん……お前らの成すことは全て無駄なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "じゃあ、あんたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "俺か？　喜んで舞台を下りるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "聞け、サルカズ。軟弱さを捨てろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "新たな時代は幕を開けた。それこそが我々の時代だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "たとえ、その「我々」の中から、俺自身の存在がなくなっているとしてもな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "W！　今のは一体――お前、その手……医療オペレーター、こっちに応急処置が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "クソッ、こいつ、自分でグレネードを起爆するなんて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "泥沼はようやく干上がり、腐臭は強風に吹かれて散った。それなのに目の前に広がる荒野は、どうして暗いままなの？\n不安がどんどん強まっていく。\nあのサルカズ戦士どもが死の間際に見せた表情は、なんだか……敬虔っていうか、そんな顔をしてた。\nあんな奴らが、どうしてそんな表情をするの？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ねえ、本艦と連絡は取れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "部隊間の通信は一部回復してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "だが本艦との通信には、いまだにノイズがかかってる。恐らく、近くで広がりつつある活性源石環境のせいだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "安心しろ、本艦が襲撃を受けたって報告は入ってない。なによりあそこには殿下本人と、あのドクターが守備に当たってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "この戦争は、じきに俺たちの勝利で終わるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "車はどこに停めてるの？　今すぐ戻るわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "しかし、次の作戦指示はまだ受けてないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "勝手に動いたら、ドクターの計画の邪魔になるんじゃ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "待て、W、通信が入った――Scoutからだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "彼が言うには……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベル小隊隊員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "バベルは単なる一時的な滞在地点に過ぎない。過去に同じように身を置いてきた場所と大差はない。Wはずっとそう考えてきた。\n強いて言うなら、ここは清潔な食料と水をいつでも提供してくれるし、自力で動けない負傷者を簡単に見捨てたりもしないし、少しは面白い仲間たちも何人かいる。\nだが結局のところ、足を休めることさえできれば、どこだろうと一緒なのだ。\nヘドリーやイネスと行動を共にするまでにWが身を置く場所を失ったのは、一度や二度ではない。\n野営地に戻ってみると辺り一面が火の海だったこともあれば、自らの手で火を放ったこともある。\n彼女にとってはそれが当たり前だった。自分は平穏と安寧が得られるはずだなどと、本気で思い込むサルカズはいない。破滅こそが日常であり、混乱こそが楽しみをもたらしてくれるのだ。\nしかし、倒壊した天井と廊下に広がる乾いていない血、叫ぶように指示を出す医者を目の当たりにした時――\n彼女ははっきりと感じ取った。自分の胸の中で……何かが崩れ落ちるのを。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ここは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バベルメンバー",
      "text": "どいて！　皆どいてください！　こっちにも怪我人がいるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベルメンバー",
      "text": "急いで！　救急室は全て使えるように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベルメンバー",
      "text": "そこをどいてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下はどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バベルメンバー",
      "text": "分かりません。セキュリティシステムが全てダウンしてしまってるんです。ケルシー先生が今――あっ、危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……あんたらの、仕業なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "サルカズ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "もう終わったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ふざけたこと抜かさないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "彼女の血も……我々と同じだったのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "この――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "視界が再び暗闇に蝕まれる。呪いってやつは、いつもしつこく纏わりついてくる。\n闇夜はあらゆる光を包み込む。闇夜はあらゆる光を呑み込むのだ。誰もそこからは逃れられない。"
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "戦いは終わった。争いもまた幕を閉じた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "聞け、サルカズ。勝利を手にしたのは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "角のない刺客",
      "text": "……ぐっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鋭い刃が、角なき刺客の胸を貫いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "バベルからお前への指示は出ていないはずだ。なぜここにいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "開口一番にそれ？　あんたが今話したいのは、あたしの規則違反についてなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アスカロンは彼女を見つめたまま、一言も発さない。\nアスカロンとは付き合いの長いWも、このような表情を見たのは初めてだった。冷然とした暗殺者の眼差しは、まるで似つかわしくない哀しみに沈んでいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……アスカロン、Scoutの話は全部本当なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "お前は今、戻って来るべきではなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下はどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "W、船内を一掃するぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ロドスはいまだ窮地に立たされている。ケルシー先生には緊急に処理すべき案件があり、動けるのは我々だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "テレジア殿下はどこにいるのかって聞いてるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "まずは動力エリアに向かってくれ。奴らが最初に忍び込んできたのは恐らくあそこからだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "耳が聞こえないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下が、亡くなったって聞いたのよ。この目で確かめないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "よく聞け。サルカズの傭兵、W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "彼女の努力を……全て水の泡にしたくないのなら。ここでバベルが崩れ落ちるのを望まないのなら、成すべきことを成せ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ハッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あははっ！　ゴミね。揃いも揃って、使えないゴミクズばっかり！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ほんと自分が笑えるわ。こんな奴らを信じてたなんて。あんたたちなら、もしかしたら何かを――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "あたしの目の前に広がっていたのは……\n議長室の床を埋め尽くすほど大量の血と、入り乱れた足跡だけだった。\nそれ以外には何一つ残っていなかった。\nまるで、最初から何もなかったみたいに。\n暗闇はいつもこんなだ。どろっと澱んでる。\nテレジア殿下は亡くなった。\nあたしは、彼女にさよならを言うことすらできなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下、なの？　どうしてここに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "このドア、まだここにあったのね――いつ直ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ハッ、クロージャも完全に無能じゃないみたいね。少しは役に立つじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あのクソババアだって……殿下がいなくなってからも、ロドスはなんとかバラバラにならずに持ちこたえているわ。ババアも、子ウサギも、必死に頑張ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それとあたしは……あたしは……あなたに会いたかった。ロンディニウムに来てからずっと、いつ会えるんだろうって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下、あたしずっと分からなかったの……どうしてあなたはいつもそうやって……自分を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どうして、あの壊れたドアをあんなに気にかけてたのか、分からなかったのと同じで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "テレジアは、もう行ってしまったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "それじゃ、今ここに立ってるのは一体……いえ、きっと夢でも見てるのよね。殿下があたしに話しかけるなんて、そんなことあるわけないもの。あたし、独り言を言ってるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "けれど、サルカズにはまだ成し遂げるべきことが残っているわ。その道に、私はこの身を捧げるつもりよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "――全ての人が、安らかな眠りに就ける未来のために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしにはよく分からない。けど、殿下のことは信じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "でも、あなたはどうなるの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "テレジアは身を翻すと、その扉にかけた手に力を込めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "扉が押し開かれる。\n足を踏み出すテレジアの後に、無数の影が付いていく。\n影の声がこだまし、叫び声が響き渡った。\n「サルカズが救われることなどない。」\n「何人も苦難からは逃れられぬ。なぜなら、かつて我らは苦しんだのだから。誰も憎しみからは抜け出せぬ。なぜなら、かつて我らは憎んだのだから。」\n「積み上がった無意味な死、そして潰えた希望……楽園などどこにある？　安寧などどこにある？」\n前に進むテレジアの足取りは重く、緩慢だ。\nWは声をかけるために口を開きかけて、そこで自問した。殿下に何を言うべきなのだろう？　何が言えるというのだろう？\nそこでようやく気が付いた。先ほどのあれは対話ではなく、殿下の残響に過ぎなかったということに。\nそれでも彼女は我慢できず、遠ざかっていく背中に向かって問いかけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下、もしもあなたがまだ生きているなら、どうすれば救ってあげられる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "前へ進み続けなさい。あなたたちなら、私よりも遠いところへ辿り着けるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あなたより遠くって、どうやってそんなもの測るのよ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あなたを殺せば、あなたを救ってあげられる？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "返事はない。\nテレジアも、影たちも、振り返りはしなかった。\n足取りは緩やかであっても、彼女たちが進む方向は決して変わらない。\nテレジアの姿が、段々と小さくなっていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "抑えてきた声がついにこぼれ出た。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "何がサルカズの魂よ！　何が苦難よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしがきっとあなたに、安寧を取り戻してみせるわ。いえ、殿下は本物の安寧なんて得たことなんてないかもしれないけど――ああもう！　そんなのどうだっていいのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "いい加減……全部終わらせましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "殿下、あたしが終わらせてみせる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "テレジアは一瞬、足を止めただろうか。Wには分からなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "進んでいく背中が段々と朧げになり、光と溶け合って消えていく。\n暗闇が再び襲ってきた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "今のは、何だったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "お前は、かの魔王の残響を聞いたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんた、まだ生きて――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "いつの間にか、クァリドチョアがWの背後に立っていた。爆弾と落石を浴びても、相変わらず傷一つ付いていない。\n彼はWの元まで歩み寄ると、扉をゆっくりと閉じた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "かの殿下は、今や遠くへ行かれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "巣穴を吹っ飛ばされたってのに、随分穏やかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "古き遺跡は、いずれ土へと還るものだ。いつ崩れようと大した違いはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "器が広いことで――面白いじゃない。あんたにちょっとだけ興味が湧いてきたってことは、認めざるを得ないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたって結構すごいんでしょ？　歴代の魔王たちの中に、あんたにもっと有意義なことさせようと考えた奴はいないわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "我がお仕えする殿下……クイサルトゥシュタは、歴史を超越せし偉大なる君主であらせられる。時の長河において、かのお方はまさしく巨人である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "かのお方は、我を従えて征伐に赴き、その意のままに我が兵刃は動く。この身も、元よりかのお方の延命に用いられるためのものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ハッ、どんなにイカれたやつにも、忠実な下僕ってのはいるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "実験は失敗に終わり、使命を果たせなくなった我は、己を流刑に処す他なかったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "無能なる者が成し得るは、英雄の残片を集めて取り置き、偲ぶことのみ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "我はそうして待ち続けてきた……未来への扉を開く者を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "その者はおそらくテレジア殿下であろうと、かつてはそう思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんた……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "痩せぎすの男は地面から祭壇の残骸を拾い上げると、細かい粉末にすり潰した。それから、くすんだ粉のべっとりと付いた指を頬に這わせて力いっぱいに塗りたくる。\nまるでその顔に、涙の痕を残すかのように。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "テレジア殿下はすでに去った。彼女の最後の残響は、お前が拾い上げた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "魔王の配下よ、若きサルカズよ。お前がここに現れたのは、偶然ではあるまいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そうね、あたしもそう思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "聴罪師の巣窟を見つけた以上は、何かしら残していかなきゃね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "クァリドチョアは地面を見た。いつの間にやら、爆弾がいくつか足元に設置されていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "お前、なぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたがあたしの知ってる老いぼれの中じゃ、なかなか面白いってことは認めるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど聴罪師と関わりのある奴には、「プレゼント」を残して行くのがあたしの主義なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "傭兵、名は何と申す？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "テレシスの墓石に刻んでおくわ。運があれば確認しなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
