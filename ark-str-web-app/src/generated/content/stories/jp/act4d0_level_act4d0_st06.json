  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "a.m. 08:30　天気/暴風雪\n北地、インフィ氷原、ライン生命420号臨時観測ステーション"
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "システム、アンロック。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "年数照会：未知",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "時刻の設定にエラーが生じました、マニュアルコントロールに切り替えます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "次の操作を行うには、使用者の権限認証を行ってください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うーん、えっと……うん、ライン生命科学考察員、マゼラン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "認証中――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "認証完了、声帯サンプル確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "ピピッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "指紋確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "（活発な女性の音声）ハァ～イ！　マゼランちゃん、おかえり！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "変なの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "もう、メイヤーちゃんの新しい認証システムのテストなんて引き受けるんじゃなかった、気が抜けちゃうよ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ふぅ、とにかくお仕事開始！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "今年最後の実地調査ポイントでは、新しい発見はなかった――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "これにて、本年度に予定されている実地調査は全て完了した。その他の任務を全て完遂後、帰還フェーズに移行する――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ふぅ、これでよしっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "報告書を書くのは苦手なんだよー、音声でも聞いてみようかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "（活発な女性の音声）ご機嫌いかが、マゼランちゃん。あなたの実地調査は今日で百、八十、七、日目よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "わぁー、今回はもうそんなになるんだね、全然実感湧かないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "装置",
      "text": "（活発な女性の音声）もう出発してから長いわね、そろそろ帰る頃でしょ？　みんなあなたのことを想ってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えーっ！？　こんなの初めて聞いた……メイヤーちゃんがこっそり条件を満たしたら流れるように設定してたのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うわー、これにこんなサプライズがあるなんて思わなかった。嬉しいなぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも、帰る頃なのは間違いないけど……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "このブリザード、まだあと一週間は続きそうなんだよね。幸い物資の備蓄はたくさんあるけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "まぁいいや、任務一覧をもう一度チェックしておこう。まだ何個か書いてないのがあったはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えーっと、うん、周辺のサンプル採取は……完了っと。遺跡の手がかり探索は……発見できず……これも完了扱い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "去年と比べて何も新発見はなかったな。一昨昨年みたいな発見があれば良かったんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "いつも通りと言えばいつも通りだけどさ……。課長さんがいたら欲張りすぎって怒られちゃうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "これでもうないよね……あれ？　もう一つ空欄の項目がある。新素材の低温性質テスト……あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "しまった！　すっかり忘れてた！！！　というかあの新素材、どこに置いたんだっけ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "マズイマズイ、もし失くしちゃってたら、殺されちゃう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ふぅ、危ない危ない……。コートのポケットに入れっぱなしだった……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ポケットの温度は氷点下43℃、6時間経過しても弾力性を保持している……っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "次は硬度のテスト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "それっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん、これも問題なしっと……。よし、あとは試験瓶に入れておけばオッケー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えーっと、試験瓶もコートのポケットの中に入れてあるはず……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "よし、せっかくのブリザードだし、思い切って外にまる一日出しておいて、低温疲労試験もやっちゃおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "外の気温はきっと試験に最適なはず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "マゼラン、いい？　まずは深呼吸、ゲートを空けた瞬間に素材を投げて、すぐにゲートを閉じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "必要なのは、速さ、正確さ、思い切り！　ブリザードが入ってきたら大変なことになっちゃうからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "1、2、3！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あの……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "いやあぁぁぁぁぁぁ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "マゼラン、ちょっと落ち着こうか。あなたは幽霊を見たのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "マゼラン、あれはキレイな女性だったけど、きっと幽霊よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも、ここは北地。他の人なんているはずないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ま、まさか本当に雪の幽霊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "だっ、ダメダメ、もう一度ゲートを開けてみよう、科学的視点から分析しないと！　！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そもそも幽霊なんているはずない！　あたしの体温だって幻覚を見るほど下がってないし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "これがもし新しい種族なんかだったら、大発見だよ！　頑張れ、マゼラン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あの、入ってもいいかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっ、えっ……君は……えっと……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "怖がらないで。私は幽霊なんかじゃないわ。信じられないなら、顔を触ってみて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっ？　えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "わ、わかった……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うわっ、温かい！　どうして！？　外はあんなに寒いのに、こんなに温かいなんて……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……もしかして、君はサーミ人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あーっ、えーっと……なるほどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何をそこまでガッカリしているのかは分からないけど……確かに私はサーミ人よ。こんにちは、お嬢さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "こ、こんにちは。どうやってここまで来たかは知らないけど、まずは入って。外は普通の人が生きてられる気温じゃないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "いくらサーミ人だって、さすがにこんなブリザードには歯がたたないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ではお邪魔するわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "はい、あつーいお茶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "なんて呼べばいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "シモーネ、そう、シモーネよ。あなたの名前は、お嬢さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えーと、コードネームはマゼラン！　ライン生命の専門観測員で、この420号観測ステーションの責任者……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "って言っても、この観測ステーションは今はあたし一人しか使ってないんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさん、どうしてこんなとこに来たの？　ブリザードに巻き込まれてまで……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "依頼を受けて人探しをしているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "人探し？　そんな…ここは北地だよ、人なんか居るはずないよ。この一ヶ月間、生き物だって何匹かしか見てないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "でも依頼者は、彼女がこの一帯で活動していると言っていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "その彼女を探してどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "このブリザードはすごく長く続くわ、彼女はしばらく動けなくなるはず。だから迎えに来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "え、そうなの！？　もしかしてあたしを迎えに来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "わからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そ、そうなんだ、あたしを迎えに来たわけじゃないんだ。でも、今の天候は本当にひどい状況だよ、シモーネは大丈夫なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "サーミ人は……いえ、私は雪のことはよく理解しているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "でもブリザードがこの調子で酷くなっていけば、私ですらどうなるか予測できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたしもこのブリザードがしばらく続くのは分かってたけど、こんなに過酷な状況になるとは思わなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "風が弱まるのを待って出発しようと思ってたけど……そういうことなら、逆に急いで出発しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "スケジュール表とこれまでの観測結果からすると、明日の朝が出るのにピッタリのタイミングみたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん、物資の備蓄も足りるよね、流石あたし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "こんなに多くの物資、あなた一人で使うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "違う違う、これはこの観測ステーションで生活する人が来年の観測時期まで暮らせるように置いてあるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "……そうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "もしシモーネさんがここにしばらく留まるなら、この物資を使っていいからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん、でも実験器具は触っちゃダメだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "ええ、わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "よし、そうと決まればあたしは荷物の整理をしないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさん、ごめんね、あたしは準備に行ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "ええ、構わないわ。私に構わずいってらっしゃい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "トランク、トランク、トランクはどこに置いたっけ？　あ、思い出した、先月踏み台代わりに使ったんだった、キッチンにあるはず！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "測量機器とドローンも……うん、問題なし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも先に充電しないとね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "何か手伝えることはあるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あ、大丈夫だよ、一人でどうにかなるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "この手の仕事はいつも一人でやってるし、慣れてるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "あなたは、ずっとここで仕事をしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうだよ、あたしはここで研究と観測の仕事をしてるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "何を観測しているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "北地の氷原全体！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "ここには、あなた一人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん、それがあたしの仕事だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "寂しくないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "もちろん寂しいよ！　でも寂しくても楽しいことだってあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "同僚たちが、みんなあたしの帰りを待っていてくれているし、この氷原にはまだまだたくさんの秘密が眠ってる。だから、そんなに辛くないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "だから、すごく寂しい時もあるけど、でも楽しい時間の方がずっと長いんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "一人は……本当に恐ろしいわ。私、そんな生活を想像したら、言葉を失いそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "まぁ確かに、誰でもあたしみたいに楽しくできるってわけじゃないよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも探検家を目指すなら、こうじゃなくちゃダメなの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あ、コホン、探検家じゃなくて専門観測員！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "あなた……本当にすごく楽天的なのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "へへん、とある先輩の言葉を借りるとね「探検家の一番の友人は孤独である」ってことだからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも課長は、あたしが“無意識に独り言を言うようになった”なんて言ってたなぁ。独り言なんて言ってるかな？　言ってないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "いいわね、マゼランちゃん。あなたは素晴らしい人よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うっ、うん、はは……そうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん。観測ステーションのエネルギー備蓄も問題なさそう。休眠状態に入るタイマーを先にセットしておけばオッケー。あとは……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん。もう一度言っておくけど、研究設備以外は、シモーネさんが自由に使っていいからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "そうなのね、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "でも私は感染者よ。ここの物資や設備を感染者が借りて問題ないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "あなたも気付いてるんでしょ。マゼラン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん、さっき見えちゃった……。シモーネさんもあえて隠したりはしなかったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "怖くないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "最初に見えたときは、ちょっとびっくりした……ホントに！　そんな風になってる結晶はすごく珍しいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも、シモーネさんはすっごくキレイだから、その結晶もミステリアスでカッコいいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "私の眼にそんな気を使わなくていいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "え、眼まで……なの？　ちゃんとお医者さんに見せなきゃ、危険な場所だよ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "それは私が聞きたいことではないわ。私が聞きたいのは、そう、あなたは感染するのが怖くないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あっ、それは心配要らないよ。鉱石病の人から人への感染は、ちゃんと法則があるからみんなが言うほど怖くないんだよ。ライン生命の研究で何回も証明されてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "まぁそれを信じる人が少ないってのはあるけど……ハァ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でもあたしの友達も同僚にも感染者はたくさんいるから大丈夫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "……そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ライン生命の人たちは、みんな自分達の医学研究に対して誇りを持っているけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも鉱石病の研究領域では、「ロドス」っていう製薬会社にはまだまだ及ばないんだ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "同僚たちに言うと怒るけど、認めざるを得ないの。あの会社は鉱石病に関する問題解決のプロってとこだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "それで結局、ライン生命はロドスと協定を結んで、私もロドスに派遣されることになったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "楽しみだなー、ロドスがどんなところかは知らないけど、観測のお仕事を続けられるみたいなの！　ずっと研究室に缶詰にされるかと思ってたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "お喋りが好きなのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "もちろん！　他の人とお喋りするのは、すごく楽しいよ！　あっ、でもあたしが喋りすぎてたら言ってね、静かにするから……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "大丈夫よ。あなたが私の知らない話をしてくれると、楽しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "う、えーっと、ちょっと恥ずかしいけど……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あっ、そうだ！　シモーネさんが希望するなら、ロドスで治療もできると思うよ！　そうだ、一緒に行こうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "私に下心があったらどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "下心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "つまり、私が悪い人だったらどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "じゃあシモーネさんは、悪い人なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "……どうかしらね……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "マゼラン、室温が低下してきているのを感じない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "室温？　あれっ、そう言われてみれば確かにさっきより寒いかも……待って、もしかして……。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "警告、室温コントロール設備に異常を感知しました。まもなく外層のヒーター供給機能が停止します。\n警告……。"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ヤバッ、シモーネさん、どいて！　制御システムを見てみる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "まずい、素材が老朽化して外部ヒーターの供給管が漏れてるみたい……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ごめんね、ちょっと出てくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "何が起こっているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "もし外層のヒーター供給機能が止まっちゃったら、観測ステーションは次の観測時期を迎える前に機能停止しちゃうの。少なくとも、中で生活できなくなっちゃう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "あとどれくらい保ちそうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "保ってあと二ヶ月ぐらいだと思う……シモーネさんがいくら雪に慣れてるって言っても、こんなところじゃ生活できないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "問題ないわ。私もすぐに北地を離れるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "……どうするつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そ、外に出て修理しないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "でもあと二ヶ月は保つのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうだよ、でもそれじゃダメ！　絶対に次の観測時期までヒーター供給機能を維持しないとダメなの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "外のブリザードは、もう常人が耐えられるレベルではないわ。あんな環境下では、あなたの命が危ない。出ないほうが良いわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でもダメだよ。観測ステーションは私一人のためにあるわけじゃないの。ずっと拠点として機能するようにメンテナンスして維持させないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "でもこの天候だと、しばらく誰も来れないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさんはこのブリザートの中、歩いてきたんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "私は他の人とは違うわ。それに探検家でもないのよ、マゼラン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うぐぐ……加熱器の機材が重い……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "とにかくこの観測ステーションはすごく大切なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "探検家にとって、観測ステーションみたいな拠点こそが命綱なの。ステーションの機能が止まれば、中の物資もダメになっちゃう。そうなれば、ここにたどり着いた探検家は死んじゃうかも知れない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "じゃあ、この観測ステーションができてから今日まで、私以外に客人はいたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "いないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "それなら、あなたがそうまでする意味はあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "どうしてそう断言できるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "きっと誰かがいつかここに来るから。それは明日かもしれないし、次の観測時期かもしれないし、ちょうど二ヶ月後かもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "何の根拠もない考えじゃない。マゼラン、外は危険なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "誰もここには来ないわよ。少なくとも乾季までは探検家たちも来ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさんは……探検家じゃない、そうだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "探検家には探検家ごとの考えがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "一番落ち着いた時期にここに来る探検家もいると思う。この北地を踏破するためにね。まだ達成した人はいないけど、たくさんの人が挑戦し続けてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そして一番危険な時期にここに来る探検家もきっといる。この大地の変化の全てを見届けるために、ここにあるたくさんの記録や情景を文明世界に持ち帰るために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ボリバルの黒流樹海、カジミエーシュの環山高地平原、イベリアの水中火山……そんな場所には、ずっと誰も行ったことはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも今は、もうどれも踏破されて、そこには探検家たちの旗が立ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "この大地には、まだまだ未踏の地ってやつがたくさんある。でもそれは、「今のところ」未踏ってだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "今日、私はこの氷原に足を踏み入れてる。となれば未来には、もっと多くの人がここに来ることになるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そしたらその人たちが、どんな状況下でここに来るかなんてわからないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "もしあなたが最後の一人で、誰もその後に来なかったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "もしあなたが帰った後、この観測ステーションが破棄されたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたしは二ヶ月後のそんな可能性を信じて、一人の探検家を見捨てるなんてことはできないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさん……あたしマゼランは、探検という事業を、探検家という人たちを信じてるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "きっといつの日か、あたしたちの足跡が、この大地の全てを覆い尽くすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "……そんな希望を、存在し得ないかもしれない未来に託して、失望させられるかもとは思わないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "大丈夫、探検家をやってるとね、一生発見の連続で、一生失望の連続だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "どの探検家の発見だって、自分一人の力だけで成し得たものじゃないよ。みんな先人の肩の上にまたがって少しずつ高みに登ってる。どんな重大な発見も、遠く遠くの過去とつながってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "例えばあたしがこの氷原に来たのも、一番最初のきっかけは小さい頃に聞いた昔話なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "その昔話がウソか本当かだって関係ないんだ。どっちにしろあたしのやってきたことにはどれも意義がある。そう信じてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "たとえその意義が、おぼろげなものであっても、誰かを失望させる存在しないものであってもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うわっこの加熱器、やっぱりパワフルすぎるかもなぁ……この前は髪の毛を焦がされちゃったし。まぁいいや、無理にでも担いで……よいしょっと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "……わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん！　じゃあ行ってくるね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "じゃあ、私が代わりに行くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさんは人探しに来たんでしょ？　観測ステーションはまだ新しい観測員の求人は受け付けてないはずだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "その人はもう見つかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "まさか、やっぱりあたしのことだったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "この天候で、あなたへ連絡する予定だったトランスポーターが来られなくなったの。だから私がここに来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "改めて自己紹介するわ。私はロドスのオペレーター、コードネームは「サンタラ」。あなたを迎えに来たの。もちろん、これからもシモーネと呼んでくれてもいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "ここからの仕事は私に任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうだったの……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でもダメだよ。外は危険すぎる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "その言葉、さっき私もあなたに言ったんだけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ダメダメダメ、あたしは専門観測員だから、これはあたしの責任でもあるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "私を甘く見ないことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "修理の方法を教えなさい、オペレーターマゼラン。外のことは私に任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "わ、分かったよ！　これ、持ってって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "これは何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "このボタンを押したらあたしがすぐに助けに来るから！　あとこの装備も、あっ、もう一つこの装備も……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "フフ、ありがとう……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "本当にあなたで間違いないみたいね。マゼラン、でも私にはこれは必要ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ダメだよ！　あたしだってシモーネさんをこんな危険な……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "いいえ。マゼラン……私を信じて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "この氷原も、同じように私を信じてくれている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "一生発見の連続で、一生失望の連続、ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "愚かなサーミ人め、そんな抵抗に何の意味がある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "確かにとんでもない力だ、我々はこのブリザードを抜けられないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だがそれがどうした？　ウルサスはそれでも貴様らを押しつぶし、その都市を飲み込み、土地を全て喰らい尽くすだろう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "魔女め……我々はお前を殺しはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我々は死ぬが、貴様は生かされる！　生きて、この大地が血に染まるのをその目に焼き付けろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これは我々死にゆく者たちからの餞別だ、受け取れ！　お前のその目でな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "叫べ、泣け、そして生きよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我々は栄誉の死を遂げ、お前は醜く生きていくのだ！　それも……いつまでもな！　！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "魔女よ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "本当に。これまでどうして私はこの大地が枯れゆくばかりだと思っていたのかしらね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "あんな子がいる限り、大地は必死にもがきながら繁栄していくに決まってるじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "安心して、マゼラン。あなたにとって難しいことは、私たち大人に任せておけばいい。私たちはそれで幸せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "「……聞け♪……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "「白き命は咲き乱れ～漆黒の種はその土深くに沈みゆく～……♪」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "「嗚呼、歌え可憐なる少女よ～嗚呼、泣け可憐なる少女よ～♪」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "「風雪がお前の歌を聞き届き～その胸深くに抱くだろう～♪」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "――北地の吹雪よ、この歌声が聞こえるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "ねぇ、マゼラン……あなたには自分の夢を追い続けて欲しいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シモーネ",
      "text": "もう……この雪もじきに止むでしょうから……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
