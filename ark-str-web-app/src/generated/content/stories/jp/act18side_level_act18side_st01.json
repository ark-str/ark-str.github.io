{
  "server": "jp",
  "storyId": "act18side_level_act18side_st01",
  "groupId": "act18side",
  "stageId": "act18side_st01",
  "title": "華麗なる大円舞曲",
  "storyCode": "LE-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18side/level_act18side_st01.txt",
  "sourceHash": "5934403db9865cec1e53766cc4c507719aba900a820ab8fc309724838909fdd1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（地図通りなら、もう少しでロドスの事務所に着くはず。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（ヴィセハイムに入るのに少し手間取っちゃった……でも急げば、まだ約束の時間に間に合うよね……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "そこのお嬢さん、待ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "え……私？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "もちろん君さ、美しいお嬢さん！　見ない顔だが、アフターグロー区に来るのは初めてかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はい。あ！　怪しい者じゃありませんよ。私はロドス・アイランドという製薬会社の者です。このアフターグロー区へは感染者の異常回復現象の調査で来ました――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "おおっとそうなのか。まあまあ仕事なんて一旦忘れてさ、俺と一曲演奏しようじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "演奏？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ですが、このフルートはアーツユニットとして使っているもので、演奏の方は全く心得がないのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "構わないさ！　音を出してくれさえすれば、俺がそれを曲にしてあげるよ！　君に巡り会えた今日という素晴らしい日を記念して、曲を贈らせてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でも人と約束をしていて、もう遅れそうなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "大丈夫大丈夫。こんなにうららかで良い日なんだ、ちょっとくらい遅れても誰も怒らないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "ほら、すぐに終わるからさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "じゃあ……適当に吹きますよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "ああ、頼むよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（よかった、ちゃんと音が出た……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "ド……ファ……ラ……ソ……ファ……ミ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "ブラボー、希望に満ちたモチーフだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "エマ、俺が演奏するから、君はお客人とダンスに興じてみたらどうだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ダンス？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい感染者",
      "text": "さぁ、美しいお嬢さん、一緒に踊りましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でも本当に時間がないんです。踊りも得意じゃ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい感染者",
      "text": "心配しないで、最初っから上手に踊れる人なんていないんだから。誰も笑ったりしないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "よし、じゃあ三拍子で行くぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "ワンツースリー、ワンツー――はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ごめんなさい、何度も足を踏んでしまいました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "明るい感染者",
      "text": "平気よ、あなたと踊れて楽しかったわ！　ありがとね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な感染者",
      "text": "それでは、またねお嬢さん！　良い一日を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "明るい感染者",
      "text": "ようこそアフターグロー区へ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーター姿の女性",
      "text": "おはよー、ハイビスカス～",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あなたは……事務所のアンダンテさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "そうだよ！　ヴィセハイム市、アフターグロー区へようこそ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "迎えに来ていただいてありがとうございます。わざわざご足労いただくなんて、お手数をかけてすみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "迎えに来ただけじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "聞いたよ、本艦でずっと根を詰めてたんだってね。出発直前まで、毎晩夜更かしして論文を読んでたらしいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "だから今日の任務は、リラックスすることだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私なら大丈夫ですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "ダメだってば。そんなに張り詰めてると、いつかプツッといっちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "それにさあ、実はすっごく良い時に来てくれたんだよね。一週間後にツェルニーさんのフェアウェルコンサートがあるんだけど、今日が参加申込日なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "それでツェルニーさんがアフターグローホール前の広場で演奏するんだって。早く行かないと終わっちゃう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でも任務が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "言ったでしょ！！　今日の任務はリラックスすることだよ！　ほら急いでってば、めったにない機会なんだからね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "着いた！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "これがアフターグローホールだよ。アフターグロー区の名前は、このコンサートホールが由来なんだってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "これは……建築物でしょうか、それとも巨大な楽器でしょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "ほらほら、鑑賞するのはまた後で。ホールは逃げないからね。今日のメインはツェルニーさんの演奏でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "そのツェルニーさんって……ここに来る前に資料を読みました。彼は確か、アフターグロー区出身なんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "そう、彼は今のところリターニアで唯一、みんなに認められている感染者音楽家だよ。国内の一部区域でコンサートツアーも行ったことがあるんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "見つけた！　ほら、あそこ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "音楽家はコンサートホール外の階段に立っており、傍に人の背丈ほどの巨大な楽器があった。\nそして彼が立っている場所を中心に、直径五メートルほどの弧を描いて、ぽっかりと半円状のスペースが空いていた。\n半円の外は詰めかけた人々で溢れかえっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "うわ。人出がやばいね、アフターグロー区の少なくとも半分はここに来てそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "半分もですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "うん、でも仕方ないかな。ツェルニーさんは昔よくこの辺りで路上ライブをしてたんだ。でもここ半年は体調を崩してて、今日は久しぶりに帰ってきたんだよ。だからみんな興奮して――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "（小声）演奏が始まるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ピアノの音が鳴ると、波が引くように広場は静まり返る。\nその場の誰もが話すことを忘れたかのようだった。\n先程までずっと声を張り上げていた物売りの声すらも消えている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "曲はあまり長くはなかった。\nツェルニーが最後の一音を奏で終わると、山のような人波から万雷の拍手が巻き起こる。\nしばらく続いた拍手が収まり、ツェルニーが次の曲を演奏しようとした時、身なりの整った人物が群衆をかき分けて、彼のそばへと近づいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄な貴族",
      "text": "ミスター・ツェルニー、ゲルトルーデ様の代理としてご挨拶を申し上げます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "あぁ、あなたでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄な貴族",
      "text": "ゲルトルーデ様より、ミスター・ツェルニーにお知らせするようにと仰せつかっております。本日もコンサート当日も、このような路上ライブは予定されていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "それが？　だからどうだというのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "ほかの地区でしたら、どなたかの許可というのも必要でしょう。ですがこのアフターグロー区においては、私が皆様のために演奏するのを止められるなどと思わないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄な貴族",
      "text": "お身体の状況も芳しくないご様子ですし、無理は控えた方がよろしいのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "自分の身体の状況は、私が一番よく理解しています。具合が悪かったら、ここには来ませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "ゲルトルーデさんにお伝えください。私のやることにあれこれ口を出す暇があったら、ご自身のするべきことをしなさいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄な貴族",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あの人はどなたですか？　皆さんどうして何も言わないんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "あれは、ゲルトルーデ・ストロッロさんの従者だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ゲルトルーデ・ストロッロって……ヴィセハイムの領主のストロッロ伯爵ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "でもツェルニーさんに軽くあしらわれちゃってさ、見ててすっとしたね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……そうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "もう少ししたらホールに入ろう。すぐに参加申込会が始まるよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "貴族の姿が人混みに消えたのを見届けると、ツェルニーは咳払いをした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "紳士淑女の皆様、お集まりいただきありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "本日は、久方ぶりに皆様のために演奏を贈るために、そして、一週間後に控えるコンサートの先駆けとして場をあたためるために参りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "皆様におかれましては、どうぞ奮ってご応募いただいて、ステージ上で存分に音楽に対する愛を表現してください。私はここで皆様にエールをお送りいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "また明日は、選考会にて審査員も務めさせていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "では、これより皆様のために数曲奏でさせていただきます。どうぞお好きな楽器をお持ちください。私に合わせるもよし、自由にお弾きいただくもよし。ご参加を歓迎いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "それでは、お楽しみください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ツェルニーがお辞儀をすると、ようやく重苦しい沈黙が破られて、群衆からさらに熱烈な拍手が沸き起こった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "よう、お前もここへ商売しに来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "今はアフターグローホールの前が一番人出が多いですから。他にどこへ行くというんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "けど、お前のコーヒーを飲みたがる奴なんていないと思うがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "そうとも限りませんよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "おやじさん、ザワークラウト一つ、大盛りで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "はいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "期待に胸を膨らませる群衆、病気を押して気丈に振る舞う音楽家、冷たくあしらわれる貴族……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "（小声）まったく心を揺さぶられますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "クライデや、どうしてもコンサートに申し込むつもりかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "はい、やっぱり参加したいんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やつれた老人",
      "text": "まぁよいだろう、お前がこれほどまで人の言うことを聞かぬのは珍しいことだ。行きたければ行きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "ありがとうございます、お爺さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "申し込みを終えたら、すぐに戻ってきなさい。道草を食ってはならんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "はい、できるだけそうします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "できるだけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "今回の参加申込会は、参加希望者がその場で演奏して、自分の実力を見せる必要があるそうなんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "だがお前のチェロはとっくに壊れておるではないか。弓は辛うじて使えるが、弓だけで一体どうするというのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "大丈夫ですよ、楽器は主催者側が貸してくれるそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "はぁ、本当にあの者らは準備がいいことだな。どうして誰もわしにそういったことを教えてくれぬのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "お爺さん、その……怒っていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "そうではない、少し心配なだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "約束します。参加申込会が終わったらすぐに帰ってきますよ。寄り道はしませんから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "お茶を淹れて台所のそばに置いておきました。冷める前にちゃんと飲んでくださいね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "少し年増な貴族",
      "text": "まもなく参加申込会が始まりますわよ。そろそろ、出発なさいませんと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "いまだに信じられないのだが。わざわざウルティカから私を呼び寄せた目的は、この感染者だらけのコンサートに参加させることだけなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少し年増な貴族",
      "text": "感染者相手でもこの程度の接触でしたら、危険はありませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "その程度は言われなくてもわかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "たかがこれしきの規模のコンサートに、なぜわざわざ私を招く必要があるかわからんと言っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少し年増な貴族",
      "text": "ずっと「自由」の空気を吸いたいと思ってたんじゃありませんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "それは確かにそうだ、だが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少し年増な貴族",
      "text": "あれこれ考える必要はありませんわ、平民気分でお祭りを楽しんでくださいまし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "（肩をすくめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少し年増な貴族",
      "text": "車を回してありますから、使ってくださいまし。アフターグロー区までは遠いですし、申込会で十全なパフォーマンスを発揮するつもりなら、徒歩で行くのはお勧めしませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "気遣いに感謝しよう。ではまた、ミズ・ストロッロ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少し年増な貴族",
      "text": "お忘れですかしら？　私は、名字より名前で呼ばれる方が好みですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "失礼した。ミズ・ゲルトルーデ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "すごい行列ですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "そっちは参加申込者の列だね。あたしたちみたいな見物人は、ここから行けば大丈夫だよ～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "あの、すみません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "申し込みね？　最後尾はあっちだから、並んでちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "――こんなに長いんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "明け方から並んでる人もたくさんいるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "でも急いでるんですよ。早く申し込みを終わらせて、家で待ってるお爺さんの世話をしないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "ダメよ。ここはアフターグロー区なの、世話をしなきゃいけない人を家に置いてきてるのは、あなただけではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "そんな……でも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "早く並んだ方がいいわ、すぐに列がどんどん長くなるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "本当にどうしても無理なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "ダメったらダメ、これは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "待って――あなたは貴族の方ですか？　コンサート参加の申し込みに来たのですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "ご覧の通りだ、私とこちらの青年に融通を利かせてくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "ですが規則では……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "それとも、君は貴族が心から懇願しているのに無慈悲に断るつもりなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った感染者",
      "text": "……いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "理解に感謝する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "聞こえなかったのか？　通してくれるそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "は……はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "ですが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "あれ……もう行っちゃった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "次の方どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "お名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "皆さんからはクライデと呼ばれています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "演奏される楽器は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "チェロです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "ご自分のチェロはお持ちではありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "それが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "なくても構いませんよ。演奏者の方には楽器の貸し出しを行っています。ご自分でお取りください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "よろしいですか？　それでは始めてください。一分を超えないようお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "何か質問がおありでしたらどうぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "その、お訊きしたいのですが、コンサートに参加した際の報酬についてはどうなっているのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "報酬？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "コンサートの情報を教えてくれた方から、合格すれば、多額の報酬を得られると聞いたのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "祖父が深刻な病気で、治療にお金が必要なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "あなたの境遇は気の毒に思いますが、今回のコンサートでは金銭に換算可能な報酬は何もありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "報酬はないんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "ええ。とはいえ大半の人々にとって、ツェルニーさんのフェアウェルコンサートで彼と同じステージに立てることこそ、最高の報酬でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "参加するかどうかはあなた次第です。ですがもしお帰りになるとしても、せめて美しい演奏を聞かせてほしいと我々は願っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "わ……わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クライデが少し落胆した様子でお辞儀をした。\n彼はゆっくりと座り、チェロを両ひざの間に挟んだ。\n片方の手で弓を持ち、もう片方の手の指で弦を押さえた時、彼の顔から落胆の色はすっかり抜け落ち、波紋ひとつない水面のような静かな集中だけが残っていた。\n滑らかなメロディーが弦の間から流れ出して、コンサートホール全体にゆっくりと満ちていく。\nそれから数小節の後、クライデの演奏がまさに佳境へと入ろうかという時に、彼のチェロの旋律に合わさるようにステージ下からもう一つの音が響き渡った。\n音色の主人は黒衣の貴族だった。優美な佇まいの男は、一分の狂いもなくクライデのチェロに合わせてフルートを奏でながら、ゆっくりとステージへと上がる。\n突然の乱入にクライデはぎょっとしたが、動揺を演奏に出すことなく一曲弾き終えた。それに続けて、黒衣の貴族は美しいカデンツァを短く奏でた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "……時間です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "今日聴いた中で、最も美しい演奏でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "若いお二人に敬意を表します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "ところで、こちらの方もコンサート参加の申し込みに来られたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "単独で申し込むつもりだったが、ミスター・クライデの演奏がとても印象深いものだったのでな。それにちょうど先程出会ったばかりで面識もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "これほどまでに素晴らしい奏者と共演する機会を逃したくはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "わかりました。お名前を伺ってもよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い貴族",
      "text": "エーベンホルツ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "あなたのような方の名が……エーベンホルツですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "ご本名ですか？　たった今ピアノを見て思いついた、ステージネームではなく？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "随分と疑い深いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "それに、黒檀はピアノだけに使用されるわけではないぞ。フルートにだって使われるだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "そうだとしたら、ご家系とご領地は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "もう一度言うぞ、私の名はエーベンホルツだ。何か問題でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "ですが、ペアで出場されることに関しての合意はなかったようですので、あなた方がペアで申し込むかどうかは彼次第ですが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "クライデさん、あなたのお考えは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "でも僕がコンサート参加に申し込んだ目的は……祖父の医療費のためで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "もし私と組んでくれるのであれば、君のお爺さんに経済的援助をしても構わないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "――本当ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "この手の援助には条件が付き物です。よくお考えを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "昨年、とある音楽家が騙され、極めて不公平な契約を結ぶよう迫られた例もあります……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "発言に気を付けてもらおうか。私がそのような不心得者だとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "やります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "ならば私はこれ以上何も言いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "もしお二人がフルートとチェロで選考会に参加されるのであれば、選べる曲は『夕べの夜明け』しかありませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい感染者",
      "text": "これはピアノ伴奏のフルートとチェロの二重奏、ツェルニーさんの代表作の一つでもあります。いかがですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "その曲は私がフルートを学ぶ契機となったものだ。ツェルニー氏のステージで演奏できるのならば、非常に光栄だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "僕も問題ありません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あの貴族の方は、どうしてクライデさんを助けるのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "音楽家に貴族のパトロンがいるのは、別に変なことじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "自分じゃ才能がなくて無理だから、素晴らしい音楽家を見つけて親しくなろうとする貴族もいるからね。そうすることで自分を飾り立てるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "でもこのエーベンホルツさんに関しては、あたしもわかんないな。何か通じるものでもあったんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "なんだか少し不安です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "そうだ、私たちがクライデさんのお爺さんを治療すれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "ハイビスカス、感染者の異常回復現象の調査に来たんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ううっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "それに、うちの事務所じゃ小さすぎて、入院患者なんて受け入れられないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "検査と診断、軽症患者への投薬に、入院が必要な患者さんに代わって他の医療機関に連絡をとること。これがあたしたちにできる限界だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でもやっぱり……心配なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "だったら……クライデさんの申し込みも終わったみたいだし、何か手伝えることはないか、今から彼に聞きに行くのはどう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "検査結果が出たよ。源石融合率8％、血液中源石密度0.23u/Lか。どうにもならないほど深刻ってわけじゃないけど、良いとは言えないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "一般的に、各指数がこのレベルまで達してるなら、患者さん自身がどう感じているかにかかわらず、きちんと専門家に治療を受けるよう勧めているよ。入院して静養した方がいいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "専門家の治療と、入院……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "ロドスも営利団体だと聞いておる。さすがにすべての治療が永久に無償ということはないのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "さすがにね。でも、ヴィセハイムにもいくつかパートナー機関があるから、その人たちに紹介することもできるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "ロドスと協定を結んでるから、ほかの所と比べたら値段は安いし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "事情を考慮して、さらに値引き交渉もできるし、もしくはこちらで一部の費用を負担するとか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "もし、クライデがわしのために申し込みに行くと知っておったら、何があろうと行かせはしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "わしはこれで失礼する。クライデ、もう一度言う。金をその貴族様にお返ししなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "何の理由もなく貴族が金を渡してくるなんて。後で何が待ち受けておるか考えたことはないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "エーベンホルツさんは、コンサートで僕が彼と一緒に演奏をすることを望んでるだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "たとえ彼に悪意がなくとも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "はぁ、たとえそうだとしても、わしは凡庸な根無し草の老いぼれにすぎん。高貴な身分も、権力者の友人も持たん。利用の価値なんぞないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "病院もだぞ。受け入れはしたとしても、良い顔はせんだろう。わしとてそんな者たちの顔色をうかがいたくはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "貴族様に悪意がないと思うのなら、その金でお前が身を立てる算段をしなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "ダメです。エーベンホルツさんともう約束したんです！　彼はこのお金をお爺さんの治療費としてくれたんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "わしのことが煩わしくなって、病院に放り込みたくなったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "そんな、僕は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "入院したくなければ、ここで静養するのはどうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "ハイビスカス、気持ちはわかるんだけどね……ここにはベッドがないし、薬のストックだって有事のときの備えなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "お爺さんにここで静養してもらえば、健康状態の変化をより詳しく観察できます。これは私たちの調査に役立つに違いありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ベッドについては、私が使用する予定だった来客用のものを使ってもらいましょう。薬もパートナー機関と同価格で提供ができます。後ほど状況説明の報告書を書いておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "これで手続き上は問題ありませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "まぁ……筋は通ってそうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "では、私たちの方の問題は解決しました。お爺さんどうでしょう。受け入れていただけますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あなたの治療を最優先におき、研究事項については事前にご説明した上で同意をいただいたものだけ進めます。あなたの健康を損ねるようなことは絶対にしません。お約束します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "それでお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "僕はしばらくエーベンホルツさんとの練習があるので、祖父の世話をする時間が少なくなるかもしれないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "それにここの環境はうちよりもずっといい。ここにいてくれれば、僕も安心できます……お爺さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "お爺さん",
      "text": "今夜はうちに戻って荷物をまとめ、明日の朝また来ることにする。それでよいのだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
