  "sourceHash": "bde7a3b2b6a5373a69ee5574dc2cd8dec4927aa16aa58200642ce94ea64c820a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 5-1"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凋零騎士",
      "text": "ぐっ――ぐぁ、アアッ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腐敗騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凋零騎士",
      "text": "あァ――ァアアッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "……ご報告します。凋零騎士は薬の服用後、明らかな拒絶反応を示しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "いえ……ほかの騎士には、同様の反応は見られません。現場の薬剤師の推測によれば、サルカズが服用した場合アレルギー反応が出る模様とのことで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "は、はい？　で……ですが、それでは少々もったいないかと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "現在の濃度は既に……鎧の修理に使われるような、通常のゲル修復液とほぼ同値です。このまま注射を続けた場合、人の脳では耐えきれません。そうなれば、不可逆的な損傷を与えることに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "……わかり、ました。彼らはサルカズであって人ではない、ということですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "はぁ……聞こえただろ？　さらに0.3%濃度を上げろ……サルカズの限界をテストするぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "貴様らは、何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凋零騎士",
      "text": "グァア……あァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腐敗騎士",
      "text": "……ナイツ、モラ……死ぬが、いい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "若きナイツモラはため息をつく。空を仰げば、馴染みの闇夜は街明かりに追いやられていた。\nこれも文明の誇る栄華の象徴なのだろうか？　カジミエーシュは、ネオンの光で闇夜を征服しているとでもいうのか……？\n彼は突如、少しばかり感傷的になった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "みんな～っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "よかった……よかったわ。無事だったのね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "わわっ、ゾフィア姉さん？　な、泣かないでってば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ふふ……本当に無事で何よりだよ、マリア。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "お主に何か起きてしまっては、この老ぼれたちはニアールの旦那に合わせる顔がないからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ま、今だってそんなもんねぇけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あははっ……冗談やめてよ～。みんなまだまだ長生きするんだし、会いに行くのは当分先でしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "えっと、ところで……ゾフィア姉さん？　そろそろ離してもらってもいい……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "あーっと、失礼？　お二人さんの感動的な再会に水を差すのは忍びないんだが……マーガレットは不在かい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……やだ、いつからそこに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "お前さんが泣いてマリアに抱きついてた辺りからだな〜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "も、もう……！　そもそも、どこのどちら様？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あっ、この人はね、さっき私を助けてくれた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "お主……！　ま、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "人違いだよ、騎士の爺さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "で、話は戻るが……マーガレットは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "まさか、こんな一大事のあとなのに、まだメジャーで武勇を振るってるってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……私……お姉ちゃんに言うべきかどうか、わからなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "ほーう？　ってえと、理由は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "考えてたんだ。無冑盟はきっとおとなしく引き下がってはくれないだろうし、そのうちまた、攻撃してくるのは間違いない。でもそうなったら、みんなが危険な目に遭うことになる……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "でも……でも、お姉ちゃんにこのことを伝えたら。それこそ相手の思うつぼでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "確かに、この大騎士領じゃあお前さんたちに逃げ場はない。いつかはあいつらの追手が来るだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "しかも、今日という日が過去とは違うように、今こうしている瞬間にも商業連合会は刻一刻と強大になっていくってのは事実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……マリア。君の安全のためにも、マーガレットはこの件を知っておく必要があると思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "だけど……お姉ちゃんが知れば解決するようなことなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お姉ちゃんがメジャーを諦めたら、向こうは本当に手を引くのかな……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "（わ、私ったら何考えてるんだろう……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "……迷うこと自体は、悪いことじゃないさ。誰かさんみたいにならなけりゃ、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "さてと……マーガレットがいないようなら、この辺でおいとまさせてもらおうか。実はまだ用事が残っててなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "待って！　君は一体――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "ゾフィア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "心配無用じゃ。それ以上聞かず、行かせてやれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……そう言うなら……わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "だけど、マリアを助けてくれたことにはお礼を言わせて。何か手伝えることがあったら……私たちに言ってちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "おう、ありがとよ。――ああ、そうだった。マリア、お前さんの太刀筋だが……剣を向ける時、方向がちょっとズレてるぜ。バランスも崩れちまってるし、振るう速度もあれじゃあ遅い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "見た感じ精神的な問題らしいが、残念ながら乙女心ってやつは俺にはとんとわからねえからなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "精神的な……問題？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "――いいか？　競技場だけが騎士の戦場ってわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "借り物の夢じゃ、遠くまでは羽ばたけないぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "聴罪師、ねえ……マジで言ってんのか？　名前を聞くだけでも嫌～な予感だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "「マジ」かどうかを疑ってるなら、クロガネに直接聞けば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "……やめとくよ。あのクロガネもサルカズなんだろ？　あいつは伝説の傭兵かなんかだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "まあいいや。にしても、カズデルから来たサルカズに、耀騎士、それからあのロドス、か……面白くなってきたなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "面白くはあるけど、面倒でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "理事会に対応しつつ、騎士協会への対応もして、ついでに感染者の処理もコツコツ進めないとなんねーなんて。あ～あ。こんな生活、いつになったら終わってくれんのかねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "……もうすぐ終わるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "……そうだったな。もうすぐ、終わりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "クロガネの旦那たちは、まだ姿を現すつもりはないようだしさ、そうなると、最後の汚れ仕事も含めて、俺たちのほうで全部やれってこったろ？　ったく……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "待った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "その辺にしといてやったらどうだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凋零騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……彼奴らは私に敗北した。ならば、勝者には敗者の処断を決する権利がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "そう言うがよ……こいつらは俺の同族でな。カジミエーシュでこんな末路を辿るところなんざ、見ちゃいられないんだよ。頼むから、ここは俺に任せてくれねえか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……同族……か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "不浄なるものは、天路の戦利品には値せん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "戒めに、彼奴らの腕を一つずつ落とす。済めば貴様が連れていけ。目障りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "おっ、意外と話がわかるじゃねえか。お前とはやり合わなきゃならんだろうと覚悟してたんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "おいおいおい、待てって、長刀を下ろしてくれよ！　悪かった、今のはナシだ、ナシ！　な！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの音声",
      "text": "耀騎士が燭騎士を相手に勝利を収めてから、メディアや都市間ネットワークでは大きな騒ぎが起きています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの音声",
      "text": "加えて大騎士領ではこのところ、不法居留感染者の暴動事件が多発しており、民衆のパニックを激化させる要因となっております――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの音声",
      "text": "この件について、零号地の責任者及び商業連合会の代弁者が、近く記者会見を開く予定とのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……ドクター様、アーミヤ様。要するにですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "これからしばらくの間……零号地は恐らく、安全とは言い難い状況になります。これまでに都市内で起こった暴動が、感染者の仕業だと思われているようでして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……極めて特殊な状況ではありますが、我々も感染者収容治療自体を機能停止させたくはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "ですので、ロドスの皆様におかれましては、大変申し訳ないのですが……当分不用意に出歩かれることのないようお願いいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……ドクター……このニュースは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "残念だけど、全部が全部捏造ってわけでもないのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "実際に感染者騎士が起こした騒ぎもあったのよ。特に耀騎士が燭騎士に勝ったあとなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "その晩だけでも、十一件の暴力事件が起きてるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "もっとも恐ろしいのは、人の言葉だ。そしてメディアはその道を熟知している。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "だが、これは真実ではない。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ハイビスカス",
          "text": "……えっ……理事会の重役さんたちが、襲撃されたんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイビスカス",
          "text": "うわわ……デモまで起きてるなんて……あの騎士さんたちに影響が及ばないといいんですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイビスカス",
          "text": "昨日診療した騎士のお姉さんが、話してくれたばかりなんですよ。試合に勝ったら、弟と妹におもちゃを買ってあげるんだって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……では、ニアールさんは……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する群衆",
          "text": "感染者を追放しろ！　大騎士領に奴らの居場所はない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する群衆",
          "text": "感染者収容治療エリアは、鉱石病の温床だ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "仕事帰りの職員",
          "text": "この辺で何かあったんですかね？　会議が終わって外に出ていた間に騒ぎが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "道を急ぐ職員",
          "text": "ん？　向こうの区画を見てみろよ。感染者収容治療センターがあるだろ？　そのせいだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "道を急ぐ職員",
          "text": "まあ、こんなもん単なる抗議活動の範疇さ。午後なんて、もっとひどかったぞ。馬鹿でかい横断幕なんか掲げてさ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……何か用向きでも？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する騎士",
          "text": "……おい、耀騎士……あの感染者たちが大手を振って行動できる理由が、わかってるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する騎士",
          "text": "奴らは街で暴力事件を引き起こし、罪のない市民を巻き込んでいる……連中にそんな度胸がある理由が、お前にはわかってるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する騎士",
          "text": "――お前が連中に勇気を与えちまったからだ！　お前と血騎士が――お前たち感染者騎士が！　奴らに抵抗する力を与えてしまったんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する騎士",
          "text": "……俺は……あんたが悪人じゃないことくらい知ってるよ、チャンピオン。元々は、あんたのファンだったしな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する騎士",
          "text": "だが、あんたがメジャーで活躍すればするほど……ほかの感染者たちが錯覚を起こしちまうんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する騎士",
          "text": "自分たちは……現状を変えられるはずなんだ、ってな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "抗議する騎士",
          "text": "だからこの辺りでやめておけ耀騎士。後悔してからじゃ遅い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "…………",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "どうかされたのですか？　ニアールさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "大勝利を収めたばかりの騎士とは思えない表情ですが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "いや……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "ニアールさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "思うところがおありなら、言ってみてください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "うん……感染者のことで、少しな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……その件であれば、アーミヤさんも既にご存知ですし、いくつか手がかりは得ています。あれらの背後に、何者かの意図があることは確かでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "ですが、あなたがそれに気を取られる必要はありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "私のことを、そしてロドスを信じてください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……わかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "あなたは安心して、その光で照らしていけばいいのです、ニアールさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "ただ……無理はしすぎないでくださいね。あなたは本当にお強い人ですが……疲れが溜まっているようですので。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "たまには、リラックスも必要なのでは？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……カジミエーシュは、私の家なんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "成長したマリアが騎士になりたいと話すのをみて、そしてゾフィアやマーティンおじさんたちが自分の人生を歩んでいる様を目にして……私は本当に安心した。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "けれど今、君たちが共にいてくれることで、より深い安心を感じていることも確かだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……では、私たちもニアールさんの家族と言えるのでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "そうかもしれないな、リズ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "さて。冬はまだ遠いがカジミエーシュの夜はいつも冷えるものだ。そろそろアーミヤの元へ戻れ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……あなたが一人でロドスを離れてカジミエーシュへと発ってから……皆、あなたを心配しています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "わかっている。しかし、だからこそ、私の事情に巻き込むわけにはいかないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……私たちを巻き込むことは、いいと思ってくださるんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "二人が嫌なら、無理にとは言わないが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "おや。耀騎士が冗談を仰るなんて、珍しいこともあるものですね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……音楽？　近くのバーからか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……確か、ここは昔、出版社だったような……思えばこの辺りは、以前ならオフィスビルが立ち並ぶばかりの通りだったな。見ないうちに随分変わったものだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "そもそも大騎士領自体が、元はこれほどの規模ではなかったはずだが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "この数十年、メジャー開催のたびに「競争入札」を通じて三つの都市を選び、合併してきた以上、こうなるのも道理か。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "――四都連合、カヴァレリエルキ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……都市は変化し続けている。お陰で、私は己の故郷に……少しばかり、馴染めない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "あなたがここへ戻ってきてから、まだそれほど時間は経っていないでしょう、ニアールさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "そうですね。その上あなたは戻るなり、すぐさま騎士競技の中に……あなたの理想の中に飛び込んでいきましたから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "この場所で地に足をつけた生活を再開したわけでもないですから、当然かと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "確かに。いずれは感覚を取り戻すだろう。今ではないだけかもしれないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……あなたが、本当にお疲れになっているのを感じます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "少し、歩きませんか？　もしかしたら、夜風が疲労をさらっていってくれるかもしれませんよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……そうだな。ではリズ、手を繋いでも？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "はい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……燭騎士は、手強い相手でしたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "ああ。カジミエーシュに、今もあのような騎士がいようとは夢にも思わなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "彼女の実力は確かなものだ。しかし、その迷いが弱点となっていた……彼女がまだ全盛に達していない時期に勝負を決することになったのが残念でならない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "では、あの試合は楽しかった、と……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……かつての私は、騎士競技を何よりも忌み嫌っていた。いや、今この瞬間も、現在のカジミエーシュに対して深い悲しみを感じているのもまた事実だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "けれど、我々は……これまでに多くを目にしてきただろう？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "三人は、夜のカジミエーシュをゆっくりと歩いた。\n街の喧騒から離れたこの路地には、都市の熱気の余韻だけが漂っている。\n街の空気に混じる温もりは、ワインと歌声に姿を変えて、急ぎ足の通行人が残したパンの香りと共に、通りをほんの少し彩った。"
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "私の使命は変わらない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……たとえ、その先に待つ運命が――荒唐無稽な冒険にすぎないのだとしてもな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "――夜風に舞い遊ぶ羽のように♪\n――夢に満ちたる旅人のように♪\n――騎士は果てなき道へ踏み出す♪\n――ただその愛を見つけ出すために♪"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……胸が震えるような歌……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "おそらく、経験豊富な旅の歌い手なのでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "カジミエーシュにも、こんなにロマンチックな場所があるものなのですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "ええ。これこそが、人々が根づく土地であることの証とも言えますから。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "――運命はコーンフラワーのように脆く♪\n――嵐の試練を身に受けるだろう……♪"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……ふん、ふふん……♪　ふふん、ふふん……♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……リズ。踊りたくはないか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "え？　私ですか？　けれど、私のような……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "大丈夫だ。私の手を握ってくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……そう仰るなら。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "わっ……ニアールさん、ゆ……ゆっくりお願いします……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "ああ、わかった。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "青い鳥が、穏やかな深い空へと飛んでいく。\nネオンの光がビルの隙間から抜け出して、ゆったりとした時間の中を行き交っている。\n騎士がサルカズの手を引いて、薄明かりの下を歩いていく。\nその姿は、ラテラーノで最も崇高な聖像のようだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……リズさん、綺麗ですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "ほ、本当ですか……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "うむ。君にはいつかきっと、本当に踊れるようになる日がくるのだろうな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……もしも、そんな日が来たとして、その時、あなたはまた私たちのそばにいてくれますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "ああ、もちろんだとも。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "騎士は踊りを止めると、ランプの貴婦人の前にこうべを垂れた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "ここで、それを誓おう。リズ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……はい。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……ニアールさん。私たちは、あなたをずっと待っています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "その道の果てで、あなたが自らの光を燃やし尽くすその瞬間まで、私たちは必ず、あなたのそばについていますから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "もし、その時――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "ニアールさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……",
