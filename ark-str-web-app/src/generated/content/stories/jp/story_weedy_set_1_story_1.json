{
  "server": "jp",
  "storyId": "story_weedy_set_1_story_1",
  "groupId": "story_weedy_set_1",
  "stageId": null,
  "title": "同舟",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_weedy_1_1.txt",
  "sourceHash": "32a669992d10b94a66e15b41101c33399683b61f2241c45e73cf1e55068552e1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "ロドス バイオテクノロジー研究室\na.m. 10:00 天気/晴天"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ウィーディ、いる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "おっと、ごめんごめん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ドア前に置いてあったスプレーで消毒もしたし、ここに来る前は実験もしてないからね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "入るよー？　オイル臭いとか言わないでよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "そろそろ契約期間が終わるから、規定通り、更新前の面談をしに来たよ。新しい契約書のひな形も持ってきてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "特に変更はないんだけど、人事部が早く出せってうるさくてさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "え？　誰もいないわけ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あ！　忘れてた！　10時はブレイズと体力トレーニングしてる時間だったっけ。じゃあ今は訓練場にいるのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ルーリー、こっちこっち。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "遅れちゃってごめんね。それにしても、ずいぶんと雰囲気が変わったじゃない？　パッと見じゃ誰だか分からなかったわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そう？　ルーリーこそ、もうすっかりクルビア人って感じだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ずっとトリマウンツで過ごしているんだから、当然でしょう？　こうして会うのはイベリアを離れて以来かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "前の「トリマウンツバイオテクノロジー新学術討論会」で、ライン生命を代表してルーリーがステージで発表していた時、私も下で聞いていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "そうだったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "討論会の後にあいさつをしようと思ってたんだけど、医療部から緊急呼び出しが入っちゃって、途中で退席しちゃったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "あぁ、あの「諸事情により棄権」したロドスの代表はあなただったのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "あの時、重症患者が急に大勢運ばれてきて、技術的なサポートが必要だったから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "討論会の発表枠は限られているのよ。どれだけの大学や技術開発企業が喉から手が出るほど欲しがっているのか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "一気に温度を上げたら、敵を特定のポイントまで追い込んで、あとはチェーンソーで真っ二つにすれば終わり……っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はぁ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ブレイズ！　ストップ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あっ、クロージャ！　私の今の一撃、どうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "いい感じいい感じ。だけど、どうして一人っきりでドタバタしてるわけ？　ウィーディは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "今日のトレーニングがキャンセルになったからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "え？　なんで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "最初は昨日のことのせいかなって思ってたんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "昨日のことって……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "気を付けて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "この温度はさすがに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "手加減はいらないよ。カスタマイズ後の蓄水砲の威力上限をテストしておきたいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でも撃った時の反動に耐えられるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "たぶん大丈夫。それに、体力トレーニングの成果もちょうど確かめられるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "オッケー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "リーフ、構えるよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウィーディを吹っ飛ばしたの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それとは関係ないんだって！　ウィーディに外出する用事ができたからそれでトレーニングがなくなったの！　地元の知り合いに会うらしいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "地元の知り合い？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ライン生命の職員なんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "そんな知り合いがいたなんて、聞いたことないけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ってライン生命！？　それってなんかヘンだと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "（首を振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ウィーディは初期のロドスに加入したメンバーなの。もうすぐ契約の更新が必要だから、ここ数日ずっと探し回ってるんだけど、どこにもいないのよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "なのに、こんなタイミングで、ライン生命に勤めている古い知り合いに会いに行くなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "そして極めつけには、前日のトレーニング中に、とあるエリートオペレーターにケガをさせられた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ケガはしてない！　あの時は私もびっくりして、すぐに医療部に連れて行って精密検査を受けてもらったし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "それぞれの予兆を組み合わせれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そんなこと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ないといいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ただのトレーニングなのに何で本気出しちゃったのさ？　自分の力がどんだけ強いのかくらい、ちゃんと分かってるでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でも、私だってあの時は吹き飛ばされたんだよ……ウィーディの身体能力と戦闘スキルはかなり上がってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "店員",
      "text": "お話の途中失礼いたします、お客様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "店員",
      "text": "そちらの、その……大砲が通路を塞いでしまっているので、少しだけ移動していただいてもよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "あっ、すみません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "店員",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ウィーディ、それ何なの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "蓄水砲だよ。水を十分に溜めれば、異なる威力の高圧水流を調節して放ったり、高温の蒸気を噴射させたりできるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "移動式のエネルギーポッドのような物だと思って。ロドス本艦の自動化技術の改造や改良には、狭い範囲での検証が頻繁に必要になるの。そこに蓄水砲を応用することでかなりの手間が省けるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "元は武器だったんじゃないの？　高圧水流も高温の蒸気も、誰かを攻撃するのにピッタリだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "確かに設計された当時は、戦場での使用も想定していたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "研究者だって武器は必要だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ロドスのバイオテクノロジー研究室の責任者は、研究以外にも、戦闘にまで参加しなくちゃいけないの？　研究者を守るための武装すら備わっていないなんて驚きね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "いや、そういう意味じゃなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "蓄水砲の構想は、イベリアにいた頃にはもうすでに出来上がっていたの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "今でもたまに思うんだ。あの時、こんな武器を持っていたら、裁判所の人たちを祖父の実験室から追っ払えたのにって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "蓄水砲じゃ裁判所相手は無理よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "幼稚な考えなのは分かってる。だから、今も基本は建設の道具として使っているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そうだ、そろそろ本題に入ろうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "クロージャさん、お呼びですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "君たちのとこの責任者はまだ戻ってきてないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "はい、ウィーディさんは本日……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "それはもう聞いた。ここに来る前、研究室の方まで探しに行ったんだけど、いなかったからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "バイオテクノロジー研究室でしたら、現在一時封鎖中ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "クロージャさん、覚えてないんですか？　前回、消毒せずに入室したせいで、細菌測定システムのアラートが鳴っちゃったでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "でもすぐに消毒したじゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "はい、作業台の蛇口で手を洗ったせいで、無菌用水のシステムが丸ごとダメになりました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あれはウィーディが、AIの判定基準を厳しくしたせいでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "そういうわけで、ウィーディさんは研究室全体を完全消毒した後、一週間ほど時間を置いてから、使用を再開することに決めたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "こりゃ改めて、ウィーディの潔癖症と研究室の使用基準について、すり合わせをしないとダメみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "でも待って！　研究室が封鎖されたら、そっちの新プロジェクトに支障が出ちゃうんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "だってつい先週もウィーディから、新しいプロジェクトの報告と予算申請が来てて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ああああ――！　承認するの忘れてたかも……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "訓練場の武器システムのアップグレートに……支援部の仕入れリストに……これはブリッジの外面補修申請……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "絶対ここに入れたはずなのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "どうしよう、ウィーディが提出した申請書、なくしちゃったかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "研究室はしばらく使えないし、新しいプロジェクトの承認も降りないしで、きっとウィーディはがっかりしちゃったよね……じゃあ、あの子は最近、何してたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "少し前に、研究資料の入った荷物がウィーディさん宛てに届いたんです。地元のお知り合いから送られたもののようで、最近は宿舎でそれの処理をしていましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "その知り合いって、今日ウィーディが会いに行ってるライン生命の職員？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "つまり、ウィーディはもう他の企業のプロジェクトに参加してるのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "もうとっくに心を決めていたんだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "グスン……ケルシーとアーミヤちゃんにどう説明すれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "思い返せば、ロドスの自動化プログラムの大半は、ウィーディが開発と設置を手伝ってくれたんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あの子はロドスの初期メンバーなのに、いつも後回しにされてばっかり。これじゃあ、辞めたくなるのも無理ないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ロドスに入ってくれたのも、他よりも採用通知が早く出ただけだったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "今になって思い返せば、私は上司としても仲間としても失格だよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "クロージャさん？　何をブツブツ言っているのです……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ウィーディたちがどこで会ってるのか、知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サポートオペレーター",
      "text": "確かバーだと聞きました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そうだ、そろそろ本題に入ろうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "送ってくれた資料の整理は終わったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "エーギルの技術を使用した沿岸工事に関する部分については、念入りにチェックしておいた。一部のモデルケースや理論演算は祖父の原稿に書かれていた内容だったからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "本当にありがとう、ウィーディ。この分野に関して力になってくれそうな人は、あなたくらいしか思いつかなかったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ライン生命には専門家はたくさんいるけど、海とエーギルに関する分野を扱っている人は、滅多にいないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "気にしないで。大したことはしてないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "でもイベリアを離れてから結構経つし、既存のモデルケースや理論演算に新しい変数を入れる必要があると思うし、完璧に正しい保障はできないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "実地調査も行う予定だから問題ないわ。ただイベリアに戻る前に、できる限り既存の資源を集めて、研究の現状をある程度把握しておきたかっただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "イベリアに戻る！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "どうして急に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "先月、裁判所のトランスポーターが訪ねて来たわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "裁判所の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "彼らは海洋工学に関する研究計画と裁判官直筆の手紙、そして裁判所が発行したイベリアの入国許可書を持ってきたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "あなたに整理をお願いした内容は、その研究計画に関わっている過去のデータよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "裁判所が自主的に海に関する研究を許可するなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "そうね、今のイベリアは変わろうとしているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "それで、もう決めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ライン生命であんなに頑張っていたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ライン生命はもうすぐ退職するわ。引継ぎ作業とか、競業避止義務とか、退職の手続きが面倒なのは、いかにも大企業って感じね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "でも、しょうがないじゃない？　私は結局はイベリア人なの。どれだけ離れようと、空気に漂う湿った潮の匂いを感じ取れるし、その匂いを辿ってイベリアへと帰れるわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "今回この場所に訪れたのは、前に担当していたライン生命の派遣プロジェクトの引継ぎをするため……そして、あなたに会うためよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "一緒にイベリアに戻ってほしいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ごめんなさい、ルーリー。その頼みは聞けない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "それはロドスのせいかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ウィーディ、率直に言わせてもらうわね。ロドスは理想的な職場だとはとても言えないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "あそこは臨床試験に重きを置いた製薬会社だし、常にテラ各地で起きている危険なトラブルに巻き込まれている。そんな場所が提供できる研究資源は限られているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "討論会の時だって、せっかく発表枠を勝ち取れたのに、緊急事態で棄権だなんて……しかも、戦闘要員として駆り出されることもあるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "いや、それについてはさっきも説明したけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "それに、ロドスとの契約もそろそろ終わるのよね？　タイミング的にもちょうどいいじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "あのねルーリー、ロドスはあなたが想像しているような場所じゃないんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "お祖父様の件で、まだイベリアを許せない気持ちがあるのでしょう……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "「科学に限界を設けるのは、いつだって人だ」と、あの頃よくこう話していたわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "あれは祖父の言葉よ。一緒にイベリアを離れようと、祖父を何度も説得したけど、結局断られてしまったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "科学とは未知への探求よ。だけど、情熱をもって身を投じた者たちはいずれ、目の前の引き出しはどれも閉ざされていることに気付くの。海、エーギル、そして大いなる静謐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "そんなイベリアが好きな研究者はいないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ウィーディ、海面はすでに陸まで上昇し、イベリアはもう踝まで海水に浸かっている。そのうち、丸ごと海に飲み込まれてしまうかもしれないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "その話、最近ロドスに入ってきたイベリア出身のオペレーターたちからも聞いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "今回イベリアに戻れば、あの時のお祖父様の研究を解禁するよう、裁判所に申し出ることもできるのよ。あの研究は元々裁判所が送ってきた海洋工学の計画とはかなり関連性が高いから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "今のイベリアは変わろうとしている。閉ざされた引き出しが開かれようとしているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "分かっているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "それでも、ルーリーとイベリアに戻ることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "さっきも答えようとしたけど、私はロドスに残る必要があるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "祖父はイベリアも裁判所も大嫌いだった。だって長年の努力が一瞬にして水の泡になったのだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "だけど、研究資格を剥奪されてもなお、祖父はイベリアを離れようとはしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "もうかなりの高齢だったし、今更不慣れな土地に移るのは嫌なんだろうって、ずっとそう思ってたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "それに、科学の自由を制限していない場所なんて存在しないしね。亡命した先の国で亡くなった科学者の話なんて、あまりにもありふれている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "でも、後になってようやく分かったんだ……祖父は自分の愛した研究を見守りたかったんだって。引き出しが開いた時に、すぐに研究を再開できるようにずっと待っていたんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "おめでとう、ウィーディさん。これですべてのテストは合格。今日から晴れて私たちの一員だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "すべてのテストって……面接を一回しただけだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "それはしょうがないよ。ロドスはできたばかりで、全然人手が足りてないんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "バイオテクノロジー研究室だって、あたしが頑張ってアーミヤちゃんを説得してようやく設立できたんだよ。今のところ所属メンバーは君だけだし、今後の発展もすべて君次第、ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "もちろん、予算とか設備とか実験についての要望があれば、遠慮せずに言っていいからね！　エンジニア部の責任者として、全力でサポートするよ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "でも……この「研究室に三時間以上滞在する場合、手洗い消毒を十回以上行う」っていう使用ルールについてだけ、もうちょっと相談できないかな……？\nえっ、なにその顔！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "手術は成功です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "よかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ウィーディさんが一晩中かけて医務室のセミオートシステムを修理してくれたおかげですよ。でなければ、手術なんてできませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "でも突然呼び戻してしまって、大丈夫だったのですか？　ずっと討論会のために論文を用意していたくらいですし、ウィーディさんにとっては大切な場だったんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "気にしないで。新しく受け入れた患者は、五名とも危険状態を脱したの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ふぅ……それならよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "そういえば、ウィーディさんのシードラゴンとおしゃべりしたい子がいるんです。手術前にウィーディさんと約束したらしいのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "うん、そうなの。それじゃあ、お見舞いに行ってくるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "少し休んでからの方が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "本当にごめん、もっと力を加減するべきだったね。ケガはない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "平気だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ねぇウィーディ、こんなことをしなくても、君は研究に集中するだけでいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "私に体力がなさすぎるから、マンツーマンでトレーニングをしてあげるって言い出したのはブレイズでしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "私が言いたいのは、戦闘に参加しなくてもいいってことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "手術や実験だけで解決できる鉱石病の問題は、ほんの一部だけだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はいはい、そういう小難しいことはなし！　とにかく戦闘の時は私の後ろに隠れてて。あんまり気にかけてはやれないけど、敵を全員やっつけさえすれば、ウィーディが危険な目にあうことはないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "蓄水砲の威力を甘く見ないでよね。ブレイズだってさっきは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "私がロドスに残るのも、祖父が自分の研究所を離れようとしなかったのも、ルーリーがイベリアに帰ることを決めたのも、理由は全て一緒なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "遠くの方に見えている限界が怖いからじゃない。今いる場所には私の情熱と、ずっと続けたいことがあるからなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "店員",
      "text": "ちょっと、お客様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "クロージャ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ねぇウィーディ、やっぱりもう一回考え直してよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "考え直すって……何を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "ブレイズの戦い始めたら周りが見えなくなる性格は、ウィーディもよく分かってるでしょ。本当にわざとじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "それに、あたしだって色んなことを一気に任されちゃうと、頭が回らなくなるの知ってるでしょ？　だからさ、ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "先週提出してくれたプロジェクトの報告書と予算申請の返事がないのは、申請を却下したんじゃなくて、書類をうっかり失くしちゃっただけなの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "表題はちゃんと覚えてるの！　「異質アーツユニットに関する共同制御の試みについて」と「灯台部品の解析によるエーギルの海洋技術の分析」！　めちゃくちゃ有意義な研究じゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "（海洋技術……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "失くしたってどういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "あの場でサインして返してくれたよ？　忘れちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "え、そうだっけ？　……と、とにかく！　もう一回だけ考え直してほしいの！　ロドスを辞めるなんてイヤだよぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "えっと……なんで私がロドスを辞めるって思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "だって契約更新について話したいのに、どこにもいないし、さっき研究室まで探しに行ったのに、やっぱり留守だったから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "知り合いがイベリアに帰るから、見送りに来ただけだよ。あっ、紹介するね。こちらはルーリー、ライン生命の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "あはは、だからライン生命はもうすぐ退職するんだってば。初めまして、ルーリーよ。ウィーディとは地元が一緒なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "退職？　じゃあ二人は本当にただ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "コホン。えー改めまして、私はクロージャ。ロドスのエンジニア部責任者にして、ウィーディの上司兼友人であります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "あれ？　あたし邪魔しちゃったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "大丈夫よ。そろそろ話し終わる頃だったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ウィーディ、あなたの考えは大体理解できたわ。その選択を尊重するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "それに、あなたもちゃんと考えていたのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そう。でも今じゃないの……とにかく、会いに来てくれてありがとうね。道中気を付けて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルーリー",
      "text": "ええ、またいつか会いましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "うん、またね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……ちょっと待って、クロージャ。さっきバイオテクノロジー研究室に入ったって言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "……そうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "研究室は消毒したばかりで一週間封鎖中なのを知らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "クロージャっ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
