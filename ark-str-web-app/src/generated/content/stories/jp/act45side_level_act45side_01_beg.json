{
  "server": "jp",
  "storyId": "act45side_level_act45side_01_beg",
  "groupId": "act45side",
  "stageId": "act45side_01",
  "title": "窓際で見る夢",
  "storyCode": "SS-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act45side/level_act45side_01_beg.txt",
  "sourceHash": "f72adc2727e5f71d06e0360d037cc05d55487372496476901958a3cb40567255",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=1>ヴィクトリア辺境の町</><p=2>p.m. 9:37</>"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "予定の時間より丸々四時間も遅れていますわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "もう、時間が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "通りには誰もいないし、こんな場所に地図なんてあるはずないし……厄介なことになったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "手分けして探しましょう。なにかあったら通信機でご連絡いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "それが良さそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "ちょっと待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "他の人は大丈夫だと思うけど、祥子は単独行動の経験なんてないでしょ。一人にするわけにはいかないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "そのようなことを気にしている場合ではありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "彼女の手紙に書かれていたのでしょう、「これが最後の手紙」と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "もし彼女の身に何かあったら、その方は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "でも……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……ヴィグナさん、大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ウィスラッシュさんもおっしゃっていたでしょう？　今のわたくしの能力なら、作戦小隊にも参加できると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "何かありましたら、真っ先にあなたにお伝えしますわ。ね、いいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "あたしたちにもね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "……分かった。くれぐれも気を付けてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "その方のお名前と……念のため住所をお伺いしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "名前は「アン」……住所は「ガーデンストリート33番地」よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ありがとうございます。ではこの十字路で分かれて探しましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "はぁ、はぁ――この町、道が複雑すぎますわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "あそこに人が……あれはお花屋さん……？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "どうしてこんな時間に……\nでも、何か知っているかもしれませんわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "御免ください……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ガーデンストリートがどこにあるか、教えていただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花売りのおばあさん",
      "text": "ここがガーデンストリートさ。お嬢ちゃん、お花はどうだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "いえ、お花は結構です……ガーデンストリート33番地へは、どう行けばよいのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花売りのおばあさん",
      "text": "ほら、あっちの夕陽に向かって、西にまっすぐ突き当たりまで行けば、奥の家が33番地さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "おばあ様、今はもう夜ですわよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花売りのおばあさん",
      "text": "おやまあ、あたしもすっかりぼけちまったねぇ……どおりで誰の足音もしないわけだ。じゃあ、そろそろ店じまいして帰ろうかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "おばあ様、目が……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花売りのおばあさん",
      "text": "あたしのことはどうでもいいよ。行くとこがあるんだろう？　早く行きな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "花売りのおばあさん",
      "text": "夜道は暗いから、気をつけて行くんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ありがとうございます……おばあ様も、お気をつけて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=1>ガーデンストリート33番地</>"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ここが33番地……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子が古びたドアをゆっくり押すと、ドアは軋んだ音を立てながら開いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "うっ、お酒くさい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "床一面が泥のついた足跡で埋め尽くされており、その奥にはボロボロの格好をした男がいた。\n男は部屋を見回し、片隅にきれいに並んだ酒瓶を一本一本確かめるように拾い上げる。"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "空っぽだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "空っぽ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "これも空だ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "アンナ……アンナ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "アンナ、一体どこにいるんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "うぅ……お前もあいつみたいに、俺を置いて行くのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "うぅ……アンナ……アンナ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "もう酒はやめる！　今日から頑張るから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男が苦しそうに跪くと、続けて部屋に悲鳴が響いた。\n先ほど砕けた酒瓶の破片が、深々と彼の手を貫いていたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "ああ！　アンナ、床に……血が……血が止まらないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "死ぬ……アンナ、帰ってきてくれ！　俺はもう死ぬんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "アンナ……帰ってきたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしはアンナではございません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "いや、お前はアンナ……アンナなんだろう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった男",
      "text": "父さんのことがわからないのか？　ほら、お前の父さんだ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は這うように祥子へと向かっていったが、すぐにまた叫び声を上げた。\n祥子はどうしてか、悲しみとともにある種の懐かしさを覚えた。\n祥子は欠けたドアノブに手をかけ、部屋を後にした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ボロボロの服を着た少女",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボロボロの服を着た少女",
      "text": "あの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "行きましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "その未発表のお話というのは、実際のあなたの人生を元にしていますのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "私、童話が大好きだったの。お母さんが家にいた頃は、私に本をたくさん買ってくれたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "あの頃は家族三人で、本当に幸せだった。私も、お母さんも……お父さんも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "でも、お母さんがいなくなってからは、そんな幸せな日々が壊れてしまったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "私は自分が経験してきたことを全部文字にして、誰かに読んでもらいたかった。でも、そんな抑圧と絶望の物語を読みたい人なんているわけない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "だから書いた言葉を全部反対にして、素敵な童話に作り変えたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "私は、とっくに童話なんて読まなくなっちゃってたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アンナさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "（身体を震わせる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "そ、その名前で呼ばないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "あっ、ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "あなた、とても優しいのね。今まで会った人の中で一番かも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アイリスさんもあなたのことを心配していましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "アイリスを知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ええ、わたくしは彼女と一緒にあなたを探しに来たのです。先ほど連絡しましたから、もうこちらに向かっているはずですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "アイリス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "彼女とお会いしたくないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "私と会ってほしいなんて、とても……いつも忙しそうで、毎日たくさんの仕事にかかりきりだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "あなたは彼女にとって、とても大切なお友達なんですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "実は……今日、何度も高い建物に上って、縁から地面をじっと見下ろしてたの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "でも、ポケットにはアイリスからもらった手紙がいっぱい詰まってて、私はずっとそれを握り締めてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "あの子は、頑張って生きていこうって私を励ましてくれてたの。私の物語の素敵な夢がいつか必ず来てくれるからって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "私はあの子を信じていいのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "彼女はきっと信用に応えてくれますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "だって、あの方は本物の妖精さんですもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "妖精さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "彼女が来たら分かりますわ。あの方は言っていましたもの、あなたが成人になる前に――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子はハッとして時計を見上げた。\n大きな古時計が高い壁に掛けられていた。その長針がゆっくりと短針に近付き、重なり合おうとしている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "いけません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アイリスさんは、成人になるまでにとおっしゃっていましたわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "誕生日まで、ってこと？　もしかして、アイリスは私の誕生日をお祝いしてくれる予定だったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ええ。ですが、もう時間が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "大丈夫。誕生日なんてもうずっとお祝いしてないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "それに私はもう子供じゃない。大人になったら、お祝いなんて必要なくなるわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "祥子が辺りを見回すと、ある物が目に留まった。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしから、アンさんのお誕生日のお祝いをさせていただけないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子の視線の先に、ピアノがあった。\nそこには月明かりが差している。まるで今夜のために用意された舞台であるかのように。\nアイリスの夢が間に合わないとしても、祥子は自分のやり方でアンに何かをしてあげたかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "あなたが「大人」になる前の最後の瞬間に、子守歌をプレゼントいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アン",
      "text": "……うん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子はゆっくりと段を上がり、アンは教会の椅子に腰を下ろした。\nカウントダウンを刻む針のように、二人の鼓動が少しずつはっきりと響き始める。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "とくん、とくん。\nカチッ、カチッ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子の両手が白鍵と黒鍵の間を軽やかに渡り歩く。\n音符が時の流れの中を跳ね回り、少女が生を受けた奇跡の日に心からの祝福を捧げた。\nこの大地に生まれてくれてありがとう。\nどうかあなたの未来が明るいものでありますように。\nあなたの童心が、決して消えませんように。\n最後の音が鳴り止むと同時に、教会の鐘の音が響き渡った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "誕生日おめでとうございます、アンさん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子が振り向くと、少女は教会の机に伏し、とても安らかな表情で眠っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "誕生日おめでとうございます、アン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ベナは教会でアンを見てくれていますし、私たちは外を歩きましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "なんとか間に合いましたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ええ、危ないところだったけれど、本当によかったですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アンさんは、どのような夢を見ていますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "まず、真っ白な部屋にご案内しましたわ。現実の場所とは思えないほど、美しいところに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "私はそこで尋ねましたの。「今から私は夢を見せます、でも嫌なら夢に入らなくても大丈夫」と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "確かに、貴族らしいやり方ですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ベナの言ったことを真に受けないでくださいまし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "「夢を見せる前には、必ず子供の同意を得ること。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "それが夢のお城の決まりですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ええ、そうでしたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "それで、アンさんとお話はできましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "夢の中でアンに伝えましたわ。あなたの紡ぐ美しい言葉で、これからもお話を書き続けてほしいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "どんな作風でも、どんな物語でも。童話である必要なんてありませんもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わたくしも、同じことを考えていましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "その後、あの子の書いた登場人物を、ひとりひとり目の前に呼び出しましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "果物が大好きで虫歯ばかりのおじさん、逆立ちで歩く人形の女の子……彼らと一緒にお茶会も開きましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "素敵ですわね。アンさんがその夢の中にずっといられたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "夢は溺れるためのものではありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "どんなに素敵な夢にも、いつか目覚める時が来ますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "現実の人生がどれほど厳しくても、目覚めなければなりませんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "あなたとベナさんの、強いアーツがあれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "祥子さん、あなたは童話と夢のお城の力を少し誤解していますわ。現実と比べれば、私たちの力には限りがありますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "私たちにできるのは、子供たちの心の一番奥底に種を蒔くことだけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "その種は、幼い頃に一番大切に思っていたことや、大切だった物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "それは普段は奥底でひっそりとしている。でも肝心な時――人が最も弱くなる時に、力を与えてくれますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "……す、少し真面目に話しすぎましたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "いいえ。お話するあなたの眼差しから、とても強い意志を感じました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "これから先、あなたの作った美しい夢を思い出すたびに、きっと彼女は生きる希望を取り戻せますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ええ、私もそう信じています。でも少し違う理由で、です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "というと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "夢を作る前に気付きましたわ。あの子の心には、すでに小さな種が蒔かれていたことに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "信念の種は、夢によってのみ蒔かれるわけではありません――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "あなたのおかげですわ、祥子さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そうだよ！　祥子のピアノ、すごい素敵だった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "前から言ってたでしょ、祥子は音楽の才能があるって。ロドスでライブやる時は絶対参加してよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ヴィグナさん、無茶をおっしゃらないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "はしゃぎ合うヴィグナと祥子の隣で、アイリスは小さな箱からある物を取り出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "祥子さん、前に不思議な夢を見たとおっしゃっていましたわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "このネックレスを身に着ければ、悪夢を見ることは少なくなるはずですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "これは……本当にいただいていいんですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ちょっとしたアーツが施してあるだけで、貴重な物ではありませんわ。安心してお受け取りになって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "えーっ！　あたしも欲しい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "あなたも悪夢を見ますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "多分……そうかも？　覚えてないけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "いいえ、見れば分かりますわ。あなたは子供の頃からずっと寝つきの良いタイプでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "もう――あんたたち妖精との付き合いってほんと大変ね、隠しごとしてもすぐバレちゃうじゃない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人が話している間に、祥子はネックレスをそっと首にかけた。\nひんやりとした心地よさが、全身へと染み渡っていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "わあ、綺麗……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アイリスさん、ヴィグナさん、いかがかしら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子が振り返ると、そこには誰もいなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ヴィグナさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アイリスさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子は辺りを見回した。\n誰もいない。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "皆さん……どこへ行きましたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "祥子は急いで先ほどの教会へと向かった。無意識に足取りが早まっていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ベナさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "アンさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "え……？　どうしてロドスに……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訝しむオペレーター",
      "text": "祥子さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訝しむオペレーター",
      "text": "大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だ、大丈、夫、ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "――！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こ、こんにち、は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角初華",
      "text": "そうだね、何もかも前と同じで……まるで夢みたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "えっ……夢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "祥子、祥子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "うん……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "もう朝だよ、そろそろ起きて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "寒い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "頭が痛い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さ、き、こ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "祥……子……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "うっ……ここは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そこは、巨大な城の中だった。\n大きな窓から空を見上げると、双月が夜空に浮かんでいる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "冷たい空気のおかげで少し意識がはっきりして、祥子は部屋を見渡した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（探るような鳴き声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "何ですの、この怪物たちは！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あら、誰か目覚めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "影の中でヒールと地面がぶつかり、軽やかな音が響く。\nその足音は、祥子に向かってゆっくりと近づいてきた。\nコツン、コツン。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ふん、つまらないわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
