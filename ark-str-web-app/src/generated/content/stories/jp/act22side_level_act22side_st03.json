{
  "server": "jp",
  "storyId": "act22side_level_act22side_st03",
  "groupId": "act22side",
  "stageId": "act22side_st03",
  "title": "悲鳴が一つ",
  "storyCode": "FC-ST-3",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act22side/level_act22side_st03.txt",
  "sourceHash": "2e9af2c9155a588aa180ec75c0a98d9639695f2069afd5f472b8d6495b15fff8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "放送局通信音",
      "text": "前方は小雨、航路確認済み、途中の観測所は通過を黙認とのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送局通信音",
      "text": "ドーソン子爵からの電報を受信しました。先方は今回の通過を機にダブリンの代表との面会を希望しています。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "また我々に寝返った貴族か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "安心なさい、リーダーは彼らに施しなんてしないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あんなふうにすり寄ってくるだけでダブリンからの庇護を得て、領地内で高まっているターラー人の不満を抑えようとするなんて、あまりに浅はかだと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "どんな代価を支払えば十分な誠意だと見なしてもらえるか、彼らは学ぶべきよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "リーダーは、相変わらず君を交渉に行かせるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "……まずは、みんなが私を忘れるだけの時間が必要だけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "それは朗報だ。私に言わせれば君の失態はあまりにも多い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "フフッ……一人で乗船して報告しに来たってことは、あなたもまだラフシニーを捕まえられてないようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "わざわざ聞かずともわかるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "私の隊が捜索し続けるのを妨害したかと思えば、彼女が去った後の場所を私の兵士にほのめかしてくるとは。このような救出方法は、君にとって賢いやり方とは思えんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あら、救われたのはあなたの方かもしれないわよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "私の記憶だと、リーダーがあの子を処刑したいなんて言ったことは一度たりともないはずよ？　そんな勝手なことをしたらどうなっていたんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "リーダーは、彼女をどのように扱うかを判断する権限を私に与えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "私が君の旧友に対し酷な扱いをしても責めないでくれ、アルモニ。今のヴィクトリアで、ドラコが好き勝手に行動するのを容認できる者はいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "気にしなくていいわ、私と彼女の関係はそこまで深いってわけじゃないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "でもほら、私は彼女が前に身を寄せていたあの医療会社に行ってみるつもりだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "フフッ、先に彼女を捕まえるのは私かもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "……おい待て、航路上に建物が？　視界が悪すぎて発見が遅れた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "ここら一帯の航路計画を定めたのは誰だ？　一昨日の観測チームはどの班だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "今から全艦隊の進路を変えても間に合わない、建物内に人がいるかどうかの確認が最優先だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア士官",
      "text": "……よし。レンガと木材構造の家屋、体積は小規模、戦艦の履帯に対する脅威なし。元のルートに沿って走行を継続。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "……あら、また小さなミスね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "戦争においては、常にある程度の犠牲を我慢する必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あなたの言いたいことはわかるわ。でも私にも「私なりの判断」があるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ラフシニーを犠牲にする？　その代価は恐らくあまりに高くつくと思うわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "だって、あれはドラコの血が流れている戦士なわけだし、鉱石病に冒されていたとしても、まだ有用なことに変わりはないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "ああ、確かに私は彼女を連れ帰ることはできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "戦う意思もなく、逃げ足だけは一人前だったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "それから……彼女がターラー王城の旧跡に入った痕跡を見つけた。遺跡内の火は消し止められた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "感染者になったことで、彼女のアーツには変化が生じているのかもしれん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "お前は、鉱石病が彼女の力を増幅させたと思っているようだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "フフッ……それは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "あれは私の妹だ。もし私に拮抗する力が少しもないようであれば、それこそ失望というものだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "教えてくれ、彼女のそばには誰がいた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "数人の流民だ。その者たちの前で彼女はリーダーを名乗っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "ならば、彼女を追い回す必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "彼女がようやく目を覚まし、自らのドラコとしての力に気付いたというのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エブラナ",
      "text": "彼女はすぐに私の元へ戻ってくるだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "本当にここから長距離輸送車に乗ることができるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うん、前にヴィクトリアから逃げる時に乗ったことがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……バグパイプ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……私が以前、キミが求める真相とは何か、そして知った後でキミは何をしたいかと尋ねたのを覚えているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミは、この現実にもっと早く気付くべきだった。ヴィクトリアの多くの出来事は、結局大抵がこのような権力闘争なのだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うん、それはそうだけどさ……でもどの事件も、巻き込まれるのは違う人だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うちの考えはやっぱり変わらない。うちは自分の報告書を絶対に届ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "でも、いつになったらこの報告書を受け取る場所をヴィクトリアにできるんだろうって考えてたんだべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "早くヴィクトリアをそんな場所にするために、うちは一体何ができるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "これだけ多くの経験をしても、キミはまだヴィクトリアを変えたいというのか？　まったく本当に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "本当に何？　本当にバカ、それとも本当に頑固？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……本当にタフだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "だからうちらはずっと親友なんでしょ。決めた目標は簡単には変えない者同士さ。チェンちゃん、うちやおめーさん、隊長だってみんな同じだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ハッ。キミの口から言われると、褒められているとは思えないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "それに、ここ最近ずーっと考えてたのは……他人の夢を否定する権利なんて誰にもないでしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "（ノイズ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ヴェンがくれたラジオか。今は音を拾えてなさそうだが。まだ持っていたんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "えっ、別にいいでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……調整なら任せろ。そのラジオは古いものだからな、キミの手の中でスクラップにならないか心配だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ほら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "……領民の皆様は充分ご注意ください、ヴィクトリアとカズデルのロンディニウム周辺における衝突は激化し続けており……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "戦争が……ジジッ……勃発……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "ウェリントン公爵……ジジッ…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "戦争への対応準備をしてください……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "はい、現在車で戻っているところです。偵察任務はすでに完了し、異常な動きは見つかっておりません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "以前あの身分で使用していたオフィスですか？　戻った後で速やかにすべての痕跡を消去しますのでご安心を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "もし何事もなければ、公爵からいただいた昇進の話を拝受します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "そういったことを隠すつもりなどございません。その時が来れば、私個人の身分と姿は捨て去られます。ですから、今の身分で貴方に何を言おうと、さして重要ではありませんよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "車を降りて少し歩くとしますか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "こんにちは、木の人形はいりませんか？　川の向こう側の集落から仕入れたんです、おばあさんの作品なんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "結構です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そうですか……あの、あなたはこの辺りの人ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "……何かご用ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "えーっと、どこかでお会いしたことが？　すみません、ここに来たばかりで、まだこの辺りの人たちを覚えられてないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "私はヴェンと申しまして、しがない物売りです。もし買いたいものや売りたいものがあれば、私にお申し付けください。ついでに仕入れ販売もしておりますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ほら、あれが私の家です。昨日建てたばかりで、集落からは少し離れていますが、大通りのそばなので、悪くない立地でしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "あの、これはあなたの車ですか……人違いだったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "お邪魔して本当にすみませんでした、それでは──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然の巨大な轟音に、二人は同時に振り返る。\n大きな影が地平線から姿を現し、彼らの足元の地面が揺れ続ける。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……この音、一体なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "いや、それよりあれは何なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……軍隊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "……昨日私は、四百キロ離れた地点であの部隊に対する偵察任務を終えたところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "何の話ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "私はずっと、強硬な軍事姿勢で知られる鉄公爵が、我々の最大の敵であると信じていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "彼の支持の下、ダブリンは民衆の恨みを扇動し、無辜な一般人たちを暴動へ、さらには全面戦争へと引きずり込む。我々は必ずや彼に対抗するすべを見つけなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "私のすべての行動が、数千数百の一般人たちの命に関わります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "ですが今……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は自分が声を出せなくなっていることに気付いた。\nゴォン──ゴォン──\n高速戦艦が率いる艦隊は定められた航路を行く。\nここはカスター公爵の領地である。彼女はこのすべてを──戦争が彼女の道を横切って前進し、ヴィクトリアの土地を轢き均していくのを黙認した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "……お逃げなさい、ターラー人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "貴方は家を建てる場所を間違えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ど、どうしてですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "この周辺は未だにカスター公爵の領地であり、貴方がたはまだその曖昧な境界線を越えてはいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "ここしばらくの交渉の結果、トレント侯爵はウェリントン公爵に寝返ることはなく、その上、ターラー人に対する締め付けはさらに厳しくなりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "数日後に、貴方はまたあの粗暴な巡回隊に遭遇することになるかもしれませんし、彼らは事件記録の中に貴方の顔があったことをまだ忘れていないかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "トレント侯爵は、公爵の思惑を読み間違えたのでしょうか？　彼もこの戦争の中で犠牲となる駒なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "誰にも答えられないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "……もし我々にその答えがわかれば、あの孤立した小屋が間違った場所に建てられることもありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ううっ、何を言ってるんですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "──待って、思い出した、き、君はあの時、私たちを捕まえに来た人だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "な、何をするつもりなんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フィッシャーは答えることなく、ただ振り返って車に乗り込むと、再びエンジンをかけた。\n彼の背後では、レンガの小屋が崩れ去る音と村人の悲痛な叫びが、すべて高速戦艦の駆動音にかき消された。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
