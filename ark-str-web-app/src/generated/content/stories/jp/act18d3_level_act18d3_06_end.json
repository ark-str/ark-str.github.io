{
  "server": "jp",
  "storyId": "act18d3_level_act18d3_06_end",
  "groupId": "act18d3",
  "stageId": "act18d3_06",
  "title": "拒食",
  "storyCode": "SV-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_06_end.txt",
  "sourceHash": "1255a7593a92a113ef31ea33cd0923eeb8ec537b635e50ff174c9709165b4494",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "きゃっ！　いたたた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……人相手だと、力と角度のコントロールが難しいのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "だ、大丈夫、大したことないですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あいつら、何を嗅ぎつけて来たのかしら。私から、血の匂いは……しないみたいだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "傷口からも……もう血は出てないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "それに、どうしてまだ興奮してるの？　この辺りの恐魚はこんなにも数が多いものなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "昨日の怪物たちのことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "まあ、そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あれは今まで、一度も見たことなかったものなのれす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そう。それなら、数日はここには来ないことね。早く帰りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……スカートを引っ張らないで。そこまで子供じゃないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "えっと……私、何が欲しいか決まったんです。あなたの歌を聞かせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……私の歌を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "だって……私は歌を知りませんから。あなたが夢の中で口ずさんでたのは聞きましたけど……でも、うまく聞き取れなかったので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "今、「わかった」って言いました？　これが「約束する」ってことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そうなるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……私のハープ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "え？　あれ？　そういえばそうですね。歌い手さんのハープ、どこに行っちゃったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……探しに戻るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "わかりました、じゃあ私も一緒に探しますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あっ、これって……もしかして、私と一緒に戻ってくれるってことですか？　や、やったあ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そこまで……喜ぶことかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ハーイ、ほこり！　おはよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "トタン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あれ、言われてみれば……トタンったらどこへ行っちゃったの？　あなたたちいつも一緒なのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "トタン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あなたが見てる方向って……海……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "まさか、昨日赤い貝殻を引いたのって、トタンなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "木枠、俺の病気、ひどくなったみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "俺の胸、はちきれそうだ。まるで、爆発するみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "何も、食べたくない。放って、おいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、私たちの家へようこそ！　また来てくれて、とっても嬉しいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた住民",
      "text": "ううっ……あぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ねえ、あなたのおばあさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ペトラおばあさんはまだお休みしてるんです。昨日一緒に帰ってきてから、ずっと目を覚まさなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "きっと、おばあさんもたくさん体力を使って、疲れちゃったんだと思います。まさかおばあさんが出てきて、審問官にあんなこと言うなんて……普段の様子とは全然違いましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……ええ。彼女は……すごい人だわ。審問官を追い払ったのは彼女だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた住民",
      "text": "ふぅ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "審問官を……追い払った！？　歌い手さん、そんなこと言って……もし審問官に聞かれたら、きっとまた怒っちゃいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "好きにさせたらいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "それで、また彼女が手を出してくるのなら……その時は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "審問官はもう、あなたにはちょっかい出さないと思いますよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……誰へのちょっかいだろうと同じことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……あっ、そうだ！　そろそろハープを探しに行きませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "待って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "頭の上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "わっ！　緑のねばねばがたくさん……な、何でしょうこれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "海藻でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "さっきくっついたんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "多分ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "これ、何かに使えますかね？　見た目は、海で採れる他の草にも似てますし……乾燥させたら、ベッドに敷けるかな？　ペトラおばあさんは腰が悪いので……ちょうどいいかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……貸して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "貝殻を使って、この海藻をすり潰すの。この粘液は、洗い流しちゃダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "すり潰したら、海水を加えて。全部ひたひたに浸かるようにね。そうしたら、この小瓶に入れて、蓋をする。あとは半年放っておけばいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "瓶の中の液体は、初めは緑色だけど……色が薄くなってきたら、発酵したってことよ。そうなれば完成。飲めるようになるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "う、歌い手さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "どうしたの？　わからないところでもあった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "初めて……初めて、私にたくさん話をしてくれましたね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ああ、それと貝殻も捨てないで。洗って乾かせば、海藻で作ったお酒の器に使えるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "おさけ……って、何ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そこに書いてある文字が「酒」よ。ここは元々酒場だったんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "この字……「さけ」って意味だったんですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "お酒を飲めば幸せになれるし、悩み事も忘れられる……って、知人たちがよく口にしていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "それって本当なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "でも、味は悪くないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あなたの故郷では……エーギルでは、よくそれを飲んだりしてたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "まるっきり同じものを、ってわけじゃないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……けど、似たようなものなら、時々一緒に飲むこともあったわ。踊りの前とかにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "きっとすごく楽しいでしょうね……あっ！　わかった気がします。それってお酒で幸せになるんじゃなくて、幸せな時にお酒を飲むんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あれ？　でも、外で生活してる人たちは皆お酒を飲むんですか？　もしそうなら皆幸せなんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そうとも限らないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "そうなんですか。それならきっと、今の私の方が幸せですね。私に酒の作り方を教えてくれてありがとうございます、歌い手さん。早くあなたと一緒に飲みたいです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……あなたのやり方、ちょっと違うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そんなふうにすると、潰しにくいでしょ。角度を変えるの。貝殻の一番とがった場所で、海藻の筋を狙うのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "リズムを掴んで、呼吸を整えて……あなたの手、あなたの身体を、肌に触れる海風と一つに溶け合わせるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "こうして――こう。一発で潰して。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "何見てるの。まさか、またちょっかい出してくるつもり？　まぁ、あなた一人なら、昨日より早く片付きそうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "いいや……違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "これ、やる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "うん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私の……ハープ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "トタンが、拾った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "昨日の夜……お前が、落とした。それ、あいつが、見つけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "わあ、よかったですね！　これで探しに行かずに済みましたよ、歌い手さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "トタンは、これを……こっそり、家に持ち帰った。そして、俺に……これを、お前に渡せと、言った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "そのあと、トタン。行ってしまった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そう……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "あ、あぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "少し、聞かせてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あっ、その音……寝ているあなたが口ずさんでいた歌ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私の頭の中でよく流れる歌なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "これって、歌い手さんや仲間の人たちが、前に歌ってた歌ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そうね……私に家があった頃、こんな歌がたくさんあったわ。私たちは歌を通じて……話をするの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "けど、家を離れたあと、他の歌声はすべて消えていった。私は一人になって……残ったのはこれだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "だからこの歌は、どこか悲しい感じなんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、約束でしたよね！　ハープが返ってきたんですから、私たちに歌を歌ってくれませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "みんな待ってるのれす！　ね、ペトラおばあさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた住民",
      "text": "ううっ……ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "おばあさん、今日は話せませんけど……でも、きっとおばあさんも一緒に歌いたかったに違いないのれす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた住民",
      "text": "あ……あぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、ペトラおばあさんも聞きたいって言ってますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "わかったわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "狩人が一人、陸へと上がる……♪\n彼は故郷を背にして遠く、行くべき道は前にのみ……♪\n父母と娘とはとうに逸れて……♪\n恋人は既に海へ葬られた……♪"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "おや、少し表情が変わりましたね。何か感じ取りましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……いえ、何でもありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "まあ、あなたの神経は未だ鈍いままですからね。目の前の水をご覧なさい。水位の昇降、波紋が生まれる頻度、乱反射する光の躍動。これらすべてが海からのメッセージなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "もうすぐ、潮が満ちる時です。私たちも上がるべきでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "狩人が一人、陸へと上がる……♪\n彼は故郷を背にして遠く、その手に残るは哀嘆のみ……♪\n彼の道は果てなく限りなく……♪\n彼の道は霧が垂れ込める……♪"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "彼女が歌っている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "この荒れ果てた家で、人々の前で歌っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "そして人々も……彼らも歌を聞いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "だけど、俯く人は俯いたままだし、話せない人は舌も動かないまま……そんな彼らの固まった肉体に歌声は入っていけない。でも、彼らの目は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官",
      "text": "まさか……彼らは、この歌を理解しているの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ペトラおばあさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "おばあさんが、どうかしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "おばあさん……寝ちゃったみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "こんなに穏やかに眠っているのは、珍しいです。いつもは目を閉じたかと思えば急に叫んで、じたばたしてましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "私……てっきり、あなたの歌を聞いたら、おばあさんは踊り出したくなるんだと思ってました。おばあさんったら、いっつも踊りたい踊りたいって言ってるのれすから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ほこり……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "死にそうだ。目に……海水、入った。それに、塩からい。少しも、おいしくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "わっ、あなた……泣いてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "ないてる？　ないてるって、何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……身体の奥底から流れ出てくる感情が、そうさせるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "text": "そう……なのか？　俺には、やっぱり、よくわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……歌い手さん、あなたの歌、私はとっても好きです。あなたはあんまりお喋りじゃないですけど……でも、あなたの歌には言葉がたくさん詰まってるんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あの、もう一回歌ってくれませんか？　もっと聞きたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もう一度だけよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "食いもん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "食いもんが来た……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "海岸、行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "宣教師！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
