{
  "server": "jp",
  "storyId": "main_12_level_st_12-02",
  "groupId": "main_12",
  "stageId": "st_12-02",
  "title": "時は待たず",
  "storyCode": "12-11",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_st_12-02.txt",
  "sourceHash": "3220286a23c0c728d5f4599dd2c91904643f4b9b0a8d7cd5143403fb30cc1117",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "私はしばしば思うのだ。時代の流れは間違いなく等速ではないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "人々が概念を発明する手段はかくも優れており、社会を築き上げる方法はかくも多様だ。なんとなれば目が眩むほどにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "私はカジミエーシュで何度も暮らした経験がある。離れたこともあるが、その都度戻ってきた。包み隠さずに言おう……バンシー、あの騎士の国の中には今なお我々の影がいるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "あの国は、確かに魅力的であると認めざるを得ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "うぬは、我にあのネオンに沈む都市を描き出すよう乞わなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "ただ……此度の背景としてこの凡庸な村を選んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "この村は静かであるからな。私が初めてカジミエーシュを見た時、あそこもこのような姿だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "黄金に染まる田畑と果てしなき平原……残念だが、そういうものは今のカジミエーシュにとって、価値がなくなったのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "あなたから見て、ここはカズデルと比べてどうなのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "カズデルは見渡す限りの廃墟である。しかし廃墟というのは、無数の可能性を内包するものでもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "あの地に対する我らの想いは異なるかもしれぬ。されど、我らは共に次のカズデルに希望を持つことができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "翻ってカジミエーシュの変貌は、かくも凄まじい早さで行われた。ペガサスは瞬く間に自らの道徳と栄光もろとも四散し、凋落したのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "であるのに、あれは以前よりもなお甘く、なお震い付きたくなるほど魅力を増している……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "神民と先民の末裔は、カジミエーシュは、我々サルカズが彼らの血肉を貪り、彼らの魂に隷属を強いていると非難した。そのため新たな方法を見つけ、我々を出し抜いたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "自身が統治する者たちが、進んで糧としてその身を差し出すように……怪物が膨張し成長し続けるための養分となるように仕向けたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "統治者がその見返りとして用意したのは、享楽の約束だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "私はかつてカジミエーシュの統治者を探し出そうとしていた。その者たちが作り上げたネオン色の全てに興味をそそられたのだ。だが私は最終的に気付いた──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "ここには統治者など存在しないのだということに。企業の代弁者、商業連合会のメンバー、ひいては監査会や大騎士長たち、彼らの中の誰一人として、今のカジミエーシュの統治者とは言えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "膨れ上がった欲望がその役目を担っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "生への渇望は、うぬのそうした探求を支えるに足るのであるか、変形者よ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "うぬは、我が想像していた以上の不安に苛まれているようだ。うぬは何を恐れておる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "私は零落を恐れている。過去と歴史の中に零落することを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "私はただ知りたいのだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「カジミエーシュ人」",
      "text": "いかにして己と向き合えばいいのかを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ハーイ、ケルシー。とんだ災難だったわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "二度寝がおススメなんだけど、もう一回寝たりしない？　実はまだあんたの枕の下に爆弾を詰めてないのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "目覚めて最初に見たのがあたしの顔で、さぞがっかりしてるんじゃない？　奇遇ね、あたしもよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたにつきっきりで涙を流しながら、目を覚ますのを祈ってたなんて誤解されるくらいなら、死んだ方がましだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "言っておくけど、完全なる偶然よ。あたしはこの部屋に水を飲みに来ただけで、あんたが邪魔な位置にいたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ドクターとアーミヤは、どこにいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どこだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたがぐっすり寝てる間に、あたしが二人とも殺しちゃってるかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "どうやら無事のようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嫌な信頼ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私たちは今どこにいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ロンディニウムの外にある、あたしのセーフハウスよ。今は中庭まであんたの可哀想なお友達でぎゅうぎゅうと詰まってて暑苦しいったらありゃしないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしからこーんなでかい恩を受けるのも、あんたの偉大な計画には織り込み済みだったかしら？　誠心誠意感謝してくれてもいいのよ。受け取るかどうかは検討してあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "確かに、アスカロンと検討した方策の中には最悪な状況において、元バベルメンバーの一部の力を借りることを想定したものも存在した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "でしょうね。あんたは一人一人の使いどころをきっちり計算してるに決まってるから──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが、それでも君に感謝しよう、W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君の言う通り、誠心誠意感謝している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……はぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "テレシスに頭までやられたの？　シャイニングを呼んでくるべきかしら？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "いや私は、\nうっ──"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "冗談よ、呼んだりしないわ。頭がやられたってのは、あんたに限れば必ずしも悪いことだとは言えないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……支えてくれないか。体を起こしたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……いいわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "はい、お水。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ロンディニウムからの撤退は非常にリスクの高い行動だ。我々の現在の状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "本気でそれをあたしに訊く気？　クロージャは仮設小屋を建ててるから、戻ってくるまで待ってれば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私は君の判断を聞きたい。傭兵は危険に対して誰より鋭い嗅覚を備えているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……はいはい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたの自救軍のお友達は、マンフレッドにこっぴどく弄ばれたみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ようやくあんたたちを相手する暇ができたらしいわ。のほほんと暮らしてた一般市民たちは、端っから死と背中合わせで生きてるサルカズのクソどもの相手じゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "可哀そうな市民たちはロンディニウムを追い出されたけど、あたしに言わせれば、運が良かったのよ。道端で無駄死にするよりはるかにましだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "唯一の良いニュースは大公爵どもが動き出したことかしらね。イネスからの連絡では、ドクターと子ウサギは攫われてある大公爵の手足になって働いてるそうよ。二人と一緒だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "大公爵……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ということは、戦争はやはり勃発したのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "残念だったわね、刺激的なイベントをたくさん見逃して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "後悔してるのかしら？　その賢いおつむでも、あんたの望む結果は得られなかったようだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私は今まで一度たりとも後悔したことなどない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが時折感じることはある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……疲れたと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "珍しいこともあるものね、あんたもそんな表情をするの？　その辺にカメラはないかしら。是非ともこのとびきり可哀想なケルシーと一緒に写真を撮って、記念に残さなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私は、自分のことを陰に隠れて歴史の行方を操作しようとする人間だとは思っていないんだ。確かに物事が自分の望む通りに展開してほしいと願うことはあるがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私……そしてかつての私は、非常に多くの手段を講じた。そのうちの一部は成功し、残りはその後、まだ再考の余地があることが証明された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "しかし今なお変わることなく、私は断言できる。あらゆる選択は、理性に基づいて判断されたものであり、その選択がなされた時点で採り得た最良のものであると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "フンッ、最良ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……ああ、「最良」だ。この言葉は、その選択をすることで全ての問題を解決できるような錯覚をもたらす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが実際にはそうではない。私はただ、事態が最悪の方向へと発展しないよう押し留めることしかできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そして私が何度試みようと、どう足掻こうと、最終的に訪れる結末は往々にして、一個人のもたらす影響には限りがあることを示すものであった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "その「一個人」が誰であろうとだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ケルシーという名とケルシーの持つ記憶が、この大地を長く歩いてきたとしても、私にできることは……微々たるものという言葉が相応しい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "W、私は……かつての私は一度、カズデルを滅ぼしたことがある。その時の私は、それが平和をもたらす唯一の手段だと信じていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "我々は当時の魔王の首を落とすことに成功した。完全なる勝利に爪をかけ、計画に基づき、魔王の権力は回収されるはずだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私は生じうるあらゆる可能性への対応策を用意し、潜在的な魔王の継承者を全員自分の監視下に置いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だがテレジアは、あの瞬間……黒い王冠を拾い上げることを選んだのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……フンッ、歴史には興味ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけどずっと気になってはいたのよね、ケルシー。あんたと彼女はどうしてバベルを設立しようとしたの？　あんたにとってサルカズは一体何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もし、あたしたちの命をただ弄びたいだけだとしたら、彼女が……テレジアがあんたの味方につくことはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私たちはただ、サルカズと他の者には、我々が思うほど違いはないのだと気付いただけだ。いかなる種族にも劣っていない。同時に、高尚でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "どこから来たにせよ、我々はすでに源石によって似たような姿に変えられ、似たような感情と欲望を有するようになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "今のこの大地はとても醜い。サルカズの魂の囁きによると、彼らはかつてこの世界の支配者であったが、虐殺され、抑圧され、寄る辺がない状態が何千年も続いているということだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが私はかつて、あれよりも更に遥かなる過去の光景を見てきた。サルカズだけがこの大地を歩く時代の姿を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "「サルカズ」という呼称は略称であり、加害者たちの傲慢極まりない自称だった。そして被害者たちの団結のスローガンにもなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ジャールとゴリアテの差はあのように大きい。サイクロプスと炎魔の外見も全くといって共通点はない。であるのに、彼らはなぜ同じ「サルカズ」として括られているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ブラッドブルードが自らの国家を樹立したとして、その国家は傲慢なヴィクトリアとどう異なるというのだ？　ナハツェーラーが文明を統べた時、その文明は冷酷なウルサスとどう違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私とテレジアは答えを出した。こうした争いは、不毛で決して未来に繋がるものではないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "テレジアは魔王の記憶の中に深く潜り込むことができたゆえに、私がずっと憂えていたその可能性を理解してくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私たちに……この大地に残された時間は、多くはないのだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……なんであたしにそんな話するの？　言ったでしょ、歴史には興味ないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "まさにW、君が歴史に興味を持たないからこそだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "歴史は君たちを……ブラッドブルード、リッチ、ナハツェーラー、変形者、アンズーリシックたちを「サルカズ」と定義したが、それと同時に「サルカズ」は過去に囚われる奴隷となった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "カズデルは再建される。だがそれは一体何の上に再建されるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "W、君のような人間であれば、異なる回答を持ち合わせているかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "フェイスト、まだキャサリンさんの心配してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "負傷者たちはひとまず問題ないよ。あのWっていうサルカズの傭兵……確かにすごいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "自救軍はもう再編成を始めてるから、きっと、すぐにロンディニウムへ戻れるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ロックロック、昨日の夜、怪しい奴を見かけなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "怪しい奴って、サルカズの軍隊のこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "いや、ちげーんだけど。知らない奴かな……俺もよくわかんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "どうしたの？　何かあった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "手紙がさ……今朝、俺の工具箱の中に入ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "自救軍の戦士の誰かが書いたんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "確かに字には見覚えがあんだけど、思い出せねーんだよな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "その手紙に、ばあちゃんは今ロンディニウムにいて無事だから心配いらないって書いてあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "それと……住所が幾つか書いてあって、それがこっから遠くねーんだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "そんなことができるのって、どっかの大公爵くらいでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "そうだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "でも大公爵はロンディニウムの市民じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "心配すんな、誰と共に戦うべきかは分かってるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ここを権力闘争の場としか見てない連中が俺たちをどう思ってようと……俺たちは奴らの駒じゃねーかんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "連中にとっちゃ自分たちは永遠に指し手で、この戦争も盤上遊戯みたいなもんだ。俺たちには自ら選択をする資格なんかねーと思ってやがる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "自救軍はそういう連中の目を覚まさせてやるんだよ。あんたらの考えは大間違いだってな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
