{
  "server": "jp",
  "storyId": "act15d0_level_act15d0_01_beg",
  "groupId": "act15d0",
  "stageId": "act15d0_01",
  "title": "密会",
  "storyCode": "MB-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15d0/level_act15d0_01_beg.txt",
  "sourceHash": "336dbc84d82730c1fae7d2de38da3b51b773efe7b8caba7ede77de176032abd5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "場所は……ここで合ってるよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うん、間違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーん、でもサイレンス、その人は本当にここを待ち合わせ場所にしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ここってバーだよね？　別に廃棄された場所ってわけでもなさそうだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "でも人っ子一人いないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "確かに。でもお酒はちゃんと並べられてるし、店内も綺麗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "何か変だよ……ねぇ、もう帰ろうよ。もうすぐ出発の時間でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "だめ。向こうはアンソニーの脱獄の件を知っている。彼が私たちのところにいるってことも。それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それに？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今夜には出発しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もう一度荷物をチェックしておこう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ん？　通信？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "この都市には、私の連絡先を知ってる人はいないはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いや、これは……ロドスの内部通信から！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "サイレンスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あたしが誰かは重要じゃないわ。重要なのは、アンソニーがあなたたちと一緒にいることをあたしが知っていて、そしてあなたが、彼の脱獄の協力者だってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……何を言っているかわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そんなに警戒しないでよ。証明できるものは何もないけど、あたしには悪意があるわけじゃない。でなきゃ内部回線を使うなんて危険を冒してまであなたに連絡しないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "何が目的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたと、エンジニアのメイヤーさんと三人で顔を合わせてお話がしたいだけよ。いいわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "同意したと解釈するわ、場所は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それに、電話での第一印象は性格が悪そうだったから、無視すれば何をしてくるかわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "着いた途端に悪口言われるだなんて、傷つくわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "誰？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ハ～イ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "このバーは貸し切りにしたから、今ここにいるのはあたしたち三人だけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こんなことしないで、普通にあなたたちと一杯やりながらお話したいとも思うけど、ほかの人に聞かれちゃまずいこともあるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だからごめんなさいね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "君は一体……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そうね。じゃあ、まずはお互い自己紹介しましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あたしは生態課の主任、ミュルジス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたのことは知ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あら、あたしを知ってたの？　それは光栄ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "先生からあなたの話を聞いたことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ふーん……じゃ、これだけでいいかしら。あなたたちの番よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "知ってるのにわざわざ聞くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もう、こういうのは雰囲気が大事なのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……構造課、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "エンジニア課、ラボ・ルトラのメイヤーだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "二人は今ロドスっていう組織にいるって聞いてたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "どうしてあなたたちが今回の件に関わっているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……あなたには関係ない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "私たちを呼び出すって、まさか君が今回の件の黒幕なの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "フフッ、どう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いえ、きっと違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あら？　どうしてそう思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私たちを見つけられるくらいだから、アンソニーがもうクルビアを後にしたことは知っているはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もしあなたが黒幕なら、今更私たちを訪ねる意味はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そうね、その通りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もしあたしが黒幕だとしたら、今頃アンソニーさんの行方を探して慌てふためいてるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あの人たちがおとなしく引き下がるとは思えないし、きっと今頃さらに追手がかかってるわよ。あなたたちのつけた護衛の実力はどれくらいなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……あなたが心配する必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あらそう、ならとりあえず安心したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれ？　でも、サイレンス、黒幕じゃないとしたら、彼女は一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私もまだ正確には分からない。だけど、彼女がこの件に関係する人物で、私たちから何か情報を得ようとしているのは間違いない。この状況から、仮説はいくつか立つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もしかして、あなたもアンソニーの身柄を確保しようとしていたのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "さすがは構造課パルヴィス主任自慢の弟子ね。本当に頭がいいわ、あなたみたいな人とのおしゃべりは好きよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "話をそらさないで、ミュルジス主任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "アンソニーはすでにクルビアを離れた。彼を暗殺する計画も失敗に終わっている。今の私とメイヤーは、たまたまクルビア国境に来ていた一般人にすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そんな私たちに、あなたが求める情報はなに？　それを使ってどうするつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あらあら、そんなに警戒しなくていいのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしだって一介の研究者にすぎないんだから、あなたたち相手に何もできやしないわよ。言ったでしょ。お話がしたいだけだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ここのお酒、結構美味しいのよ。ほら、座って。一緒に飲みながら話しましょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "えっ、本当にいいの、サイレンス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "仕方ない、私も知りたいことがあるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "じゃあ……私はこれにしようかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あら、お目が高いわね。このシャトーが生産してるリースリングのワインはあたしも好きなの。度数もそこそこだし、香りがとっても芳醇なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そうなんだ、私あんまりお酒強くないんだよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "なら、この果実酒をお薦めするわ。アルコールはそんなに含まれてないし、すごく美味しいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ほんと？　じゃあそれ飲んでみようかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "OK。サイレンスさんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "お水でいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あら、せっかくこんな場所に来てるんだから、もっと面白いものを試してみるべきじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "興味ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "はいはい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "さあどうぞ、お二人さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "どうも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わぁ、これ美味しいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "気に入ってもらえてよかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それじゃ、本題に入ってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "いいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そうだ、一つ提案があるんだけど。お互い疑問を抱いてるでしょうから、最初は代わりばんこに質問し合わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もちろん厳密に一問一答というわけではないわ。聞かれなかったから答えなかったなんて、言葉遊びのようなことになるのはお互いごめんでしょう？　柔軟で実のある話し合いにしましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしの誠意を示すために、一問だけサービスで訊かせてあげる。何でもどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……どうやって私たちを見つけたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "それが最初の質問？　……意外と軽めね、それでいいの？　もっと核心的なものが来るかと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "答えてください、ミュルジス主任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "いいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "まず最初に。あなたたちが信じるかどうかは別として、あたしはハイドブラザーズの追っ手とは無関係よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ハイドブラザーズ……今回アンソニーに手を出した会社だよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そうよ、彼らについては、そんなに説明はいらないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ハイドブラザーズ……かつてバンカーヒルシティの建材業界でトップに君臨していた企業。突如業界に参入したサイモン社とシェアを争っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "へぇ、サイモン社は突然参入したんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うん。もともとサイモン社は物流専門会社だった。でもいつだかの取締役会で、建材業界に参入することを決めたらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "会社の名前が表しているように、この会社の上層部の半数はCEOのスミス・サイモンの血縁者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今回の事件の中心人物――アンソニー・サイモンは、そのCEOの一人息子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "当時、この二つの会社は表でも裏でも激しく競争を繰り広げて、流血沙汰にまで至ったという噂もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "結果から言えば、両社の争いはサイモン社の敗北に終わった。それ以来、ハイドブラザーズは、バンカーヒルシティやその周辺都市の建材市場を実質独占している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "うんうん、その通りよ。よく勉強してるわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "とにかく、あなたたちはアイアンフォージシティで合流した後、ハイドブラザーズの追手を撒いた。お見事と言わざるを得ないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……でもあなたに嗅ぎつけられた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "アハッ、そうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "わざわざ追手とは無関係だと断ったってことは、ハイドブラザーズ自体との関係は否定しない、ということでいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ええ……きっとあなたなら想像はつくでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしは確かに彼らの情報網を使ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "仕方なかったのよ。そうでもしなきゃ、今回の一番の敗者はあたしになっちゃうところだったんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "こんなとこでいいかしら？　じゃあ、今から一問一答にしましょ。あなたから始めていいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いえ、あなたから始めて、ミュルジス主任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あら、いいのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたの目的が何なのか知りたいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "OK。あたしが知りたいのは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "サイレンスさん、あなたの仲間はどうやって監獄内でアンソニーさんに接触し、彼を脱獄させたのかしら？　その経緯を教えてもらいたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もう終わったことなのに、どうしてそんなことが知りたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしが、今回の救出事件の全貌を把握できてないからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしが知ってるのは最初と最後だけ。つまり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "――マンスフィールド監獄に収容されていた、サイモン家唯一の生存者、アンソニー・サイモンに対し、ハイドブラザーズが前々から準備していた暗殺計画を実行に移したことが事件の発端。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "――アンソニーさんを含む数名の収監者が、マンスフィールド監獄から逃げ出し、あなたたち二人と合流した後、クルビアを離れた。それが事件の結末。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "その間に何が起きたのかは、残念ながら知らないのよね。もともと知る機会はあったはずなんだけど、今はもうなくなっちゃったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "というわけで、あなたからその過程を聞きたいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それは不公平な話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "安心して、一つの質問ですべてを聞こうなんて思ってないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あなたが、適切なタイミングだと思った時点で質問してくれれば、あたしはできる限り答えるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もちろん、あたしもほかの質問をするかもしれないけど、そんなに多くはないわ。多分ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そもそも厳密な一問一答ではないっていったことからもわかると思うけど……ぶっちゃけ交互に質問し合おうっていうのは、あたしたちの関係がまだ深くないから提示したやり方であって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もっと親密になれば、気兼ねなく色々と話せるようになるんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……私はあなたと親密になるつもりはない。それに、そうするためには時間がかかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "今のあなたたちは「たまたまクルビア国境に来ていた一般人」じゃなかったかしら？　時間ならたくさんあると思うけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "もちろん、今すぐ立ち去ってもらっても構わないわ。でも、二つだけ忠告しておくわね。その一、あなたたちが本当にこのまま無事にここを去れるか、あたしには保証できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "その二、今回が恐らく唯一の、生態課主任のこのあたしから情報を引き出すチャンスよ。あなたがどれだけ把握してるのかはわからないけど、その機会を棒に振っちゃっていいのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……私を脅す気？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "最もあなたを傷つけないと思われる選択肢を差し出しているのよ。これはあたしの誠意よ、サイレンス研究員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "わかった……確かに私たちは急いではいない。あなたがどうしても知りたいというのであれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ねえ、私は用がなさそうだから、隣で設計プランを作ってていい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いいよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "カフカ……これがあなたの協力者の名前？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あたしの知る限り、あなたに関係する職員リストの中にそんな名前は見たことないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "彼女はライン生命の者じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ライン生命は彼女を雇わない。彼女も科学研究には何の興味もないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "えっ、じゃああなたたちはどうやって知り合ったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ただの偶然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でもそれはまた別の話。あなたはただ、彼女が私の友人だってことだけ知っていればそれでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "サイモン家に関する情報はすべて彼女が集めてくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "へぇ？　随分と優秀な人みたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "それにあなたたち、かなりの信頼関係を築いてるのね。友達のために進んで犯罪者になって監獄に入ろうなんて人は、そうそういないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それなりの報酬は与えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それに監獄に入ったのは彼女なりの目的もあったから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "目的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "本物の監獄生活を一度体験してみたかったらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "彼女にしてみれば、お金をもらって夢を叶えたようなもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "……変人ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "確かに、私も彼女のああいったところは理解できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "彼女はミナという大工を見つけてきた。そしてミナに作業員として先に監獄に潜入してもらい、自分自身は囚人として監獄に入った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ミナ、ってあなたたちのチームにいたリーベリの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "聞いた感じではミナはこの件とは関係なさそうだけど、どうして彼女を巻き込んだの？　人手が必要だった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私もよく知らない。カフカが言ってたのは、ミナは以前アンソニーに助けられたことがあるから、アンソニーを助けるためなら喜んで一緒に監獄に入ってくれたってことだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いずれにしても、カフカは私の要求を受け入れ、マンスフィールド監獄に入った……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ロイヤルフラッシュ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "イェーイ、また勝った！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "チェッ、また負けた。ツイてねえぜ……おいカフカ、お前イカサマしてんじゃねぇだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人B",
      "text": "人のせいにすんじゃねえよ。カフカの手には何にもねえだろ？　どうやってイカサマするんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "そうだそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "（小声）君たちのカードの持ち方がダメなんじゃん……それじゃあ簡単に見えちゃうよ。ま、カフカにとっては有難いけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "しかし、まさかとはこのことだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "新顔は、ただのちびっこいお嬢ちゃんだと思ってたのによ。こんなに上手くやれてるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "しかも俺の母ちゃんの伝言まで預かってきてくれるなんて、お前は最高だぜベイビー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ねえねえ、何度も言ってるじゃん、カフカはもうオトナだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人B",
      "text": "ハハッ、そうだな。頭にミスを付けるべきだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人C",
      "text": "ヒューヒュー、ミス・カフカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "text": "おいそこの、休み時間は終わりだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "text": "さっさと仕事に戻れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "text": "でなきゃ今日の飯はないと思え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "へいへい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "チッ、たかが看守が、なに威張ってやがる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "text": "何か言ったか？　もっと大きな声で言え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "はっ、トイレに行きたいであります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "text": "我慢しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ここの看守って態度ひどいよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "おいカフカ、お前はいい子だからな、お兄ちゃんが一つ忠告しといてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "お前が外でどうやって過ごしてたかは知らんが、このマンスフィールドでは、おとなしくしといた方がいい。周りに気を付けて、看守には逆らうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "なんで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "お前も知ってるだろ、ここは移動監獄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "物資の補給や囚人の収容のために都市に接近する時以外、基本的にこの監獄は荒野を走る。その間、職員を監査する奴は誰もいねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "だからここでは、どんな道理も通用しねえ。あの看守たちこそが、唯一の法律だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "なるほどねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "へっ、でもこんな場所でも良い部分はある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "それはな……外じゃ俺たち感染者だけが人として扱われないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "だけどよ、ここに入っちまえば、誰であろうと人として扱われないんだ。Aエリアのクズたちも、俺らと大して変わらない扱いなんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "それを思うと俺は愉快でしょうがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "Aエリアって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "そうか、お前はまだ来たばかりだから知らねぇよな。この監獄は、非感染者と感染者で収監されるエリアが分けられてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者囚人A",
      "text": "俺たちは普段、非感染者がいるところをAエリア、俺たち感染者がいるここをBエリアって呼んでる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "へぇ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "おい、言っとくがカフカ……お前さん、超いいタイミングで入って来たんだぜ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "今日は一大イベントの日なんだ。ツイてるぜお前、これに間に合うなんてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "一大イベントって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "そいつはあとでのお楽しみだ。すぐにわかるさ。ま、期待して待っとけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "えー。まあいいや。わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "そういえば、あっちにあるあの部屋はなに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "あれも工場に見えるけど、なんでこっちと隔ててあんの？　中には誰もいないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "ああ、あれか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "ありゃ、Cエリア専用の工場だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "Cエリア？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "中央にあるあの塔のことだ。俺たちはCエリアって呼んでる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "あそこは人が少ない。中にいるのは全員、重罪を犯して、よっぽどのことがなけりゃ残りの一生をここで過ごすのが決まってるような奴らだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "あいつらも労働はするが、俺たちと一緒になることはねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "全部あの中でやることになってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "へぇ……あっちにアンソニーって人いる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "アンソニー？　なんだ、お前あいつの知り合いか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "えーっと、知り合いってわけじゃないよ。アンソニーって人がここに入れられてるって噂を聞いただけでさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "そうか。ああ、そりゃもちろん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "text": "おい、おしゃべりはその辺にしとけ、準備はできたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "お、始まるのか？　もう待ちきれねえぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "なになにどうしたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人たち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Aエリア囚人たち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "あれ、なんでみんな集まってきてんの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "カフカ、お前は参加しなくていいぜ。今日来たばっかりだし、怪我しちまうからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "得物でも持って隅っこに隠れとけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "今日はお前に、マンスフィールドで最もポピュラーなイベント――バトルロイヤルを見せてやるよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
