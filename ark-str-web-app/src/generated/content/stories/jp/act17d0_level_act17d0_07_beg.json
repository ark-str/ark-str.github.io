{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_07_beg",
  "groupId": "act17d0",
  "stageId": "act17d0_07",
  "title": "最終防衛線",
  "storyCode": "OD-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_07_beg.txt",
  "sourceHash": "3804f9f58e9fe79ecdfb710ba78585c47538cffc86c51c3f336ceda2f965fc6b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "クソが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "ボス、これからどうしますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "ボス、やっぱり撤退しましょうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "撤退？　俺はまだ負けてねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "領主の衛兵隊は全員死んだ。次の反撃のチャンスを待ってればいいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "ロドスの傭兵ごとき、俺の敵じゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "あの科学者はどこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "どうして誰もいない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "これは何のにおいですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "見張ってた奴はどこ行きやがったんでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "どうやらうまくいっていないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "強大な力を有した私の造物を連れて行ったにも関わらず、何もなし得なかったというわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "予想はできていたがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "お前のひねくれた見解を聞いてやる必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "これまでの君の行動から鑑みるに、また新たなおもちゃが欲しいとねだりに来たんだろう？　その調子だから父に愛されないのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "黙れ！　俺は今……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "それは、私に話しているのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "ならば、少なくとも敬意を払いたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "あ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君は私の手助けを求めている。それが人にものを頼む態度かね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "てめえ！　俺をバカにしてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "私はいたって本気だよ。冗談を言っているように見えるかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "おい、この老いぼれ！　痛めつけられてぇのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "うあああああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "な、何だ！　これは何だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "あ……頭！　頭が破裂する……俺の……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "お前！　何をしやがった！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君たちのような暴力で解決することしか知らない蛮族には、本当に知性も教養も備わっていないのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "そして君……まさか本当に、こんな低能ども数人で、科学者を閉じ込めておけると信じていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "行け。私たちのスポンサー様の頭と肝を冷やしてやれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変異感染者",
      "text": "グオォ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変異感染者",
      "text": "グアァ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "こ、これは何だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "わからないのか？　君の手下だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "もちろん、今は以前よりもより恐ろしく、より私の指示に従うようになっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君もすぐその仲間になるのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "どうしてお前がこのモンスターたちを操れる？　お前はアーツを使えないはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "こいつらを操れるのがアーツとやらだけだと思っているのか？　君の思考はそれほどまで狭いのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "どうしてその「アーツ」で「感染生物」をコントロールできるか、その点を考えた、いや、考えようとしたことすら無いのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "もちろん、考えたところで君程度の知能では、その問いに答えを導き出すことなどできないだろうがね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "簡単なことだよ。こいつらの同種になりさえすれば、自然とこの生物たちとコミュニケーションを取ることができるのだ。打ち解けることさえできる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "……救えない狂人め。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "俺はトゥラ一家の跡取りだ。俺はトゥラ一に流れる神民の血筋を受け継いでるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "バイエル首長の領土で、お前は貴族を殺せるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "首長？　貴族？　神民の血筋？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "ハハッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "ハハハハハハハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君は実に面白いな、ドラッジ君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "今のジョークは少し時代遅れだがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "「私はブタを侮蔑せず、高き枝に掛かる金冠だけを憎悪する」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "私の祖国では、人々が司教を焼き殺し、国王を吊り殺し、皇帝の首を斬り落とした。過去の一切の権力は砕け散り、いわゆる王侯貴族というものを、人々はそれ以上恐れなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "首長がなんだというのかね？　貴族や血筋など……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "私からしたら、君などカスに過ぎんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君のそのクソ袋程度にしか役に立たない体より、鉱石病患者たちの方がよっぽど役に立つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君たちの言葉で、あの鉱石病患者たちを、何と呼んでいたかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "おぉそうだ……感染者だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "感染者は私の実験に貢献できる。だが君は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君の身分など全くの無意味だよ。このような状態で、君の身分がどんな役に立つというのだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "そして無能の上に強欲ときては実に度しがたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君のような卑劣で愚かなクズが、まさか「貴族」を名乗れる立場とはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君のどこに「高貴で他人より優れている」美点があるというのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "だが心配しなくていい。私と君の考え方は全く異なる。科学者たる私が追求するのは、客観的な真理だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "お前は何がしたいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "科学はあらゆる人に対して公平である。君の出自によってそれが変わることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "貴族、平民、全てが手術台の上に横たわるのだ。メスで皮膚を切開されれば、その価値はすべて同じものとなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君の場合、科学に身を捧げるとするなら、少なくとも今よりは少しばかり高貴な存在として扱ってやってもいいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君は私に相手をしてもらっていることを光栄に思うべきなのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "この裏切り者が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "裏切り者？　裏切り者だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "ハハハハハハハハッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "君は自らの姉に対して姑息な手を使い家族を裏切った。君は外国の傭兵と結託して父親を裏切ってその財産をかすめ取った。そうして生まれ育った土地とそこに住む人たちを裏切った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "そんな君が、よくも私のことを裏切り者だと言えたものだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "お前はもう終わりだ。俺の後ろに誰がいるのか、どんな存在があるのかを、全くわかっていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "この半年、お前が費やした金は、すべて奴らが提供したものだ。俺を裏切るということは、奴らを裏切るということだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "ヴォルヴォート・コシンスキーの奴らはお前を許さない！　奴らがお前を見つ出し、お前を殺すだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "text": "お前はもう終わりなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "それに関しては、私がそのときに適切に処理しよう。君に心配してもらう必要は無い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "さらばだ、愚か者よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "その格好は何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "領主の倉庫で見つけた。悪くないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "……似合ってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "今までで一番狂った作戦計画だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "じゃが、説得力はあるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "源石を爆発させればモンスターたちを地面からおびき出せると、どうして気付いた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "先生のおかげさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "モンスターたちはずっと術師の指示に従っていた。ただあの夜だけは違った。あの夜、制御を失ったモンスターたちは辺りに飛散した源石の欠片を追っていたのだと、思い返して気がついた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "つまり、お前はこれが必ずうまくいくと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "必ずとは言わないが、かなり分のいい賭けだとは思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "この源石エンジンはどこから調達した？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……これは……前に色んなことがあってだな。要するに車を一台手に入れたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……この車、見覚えがある気が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "この車って……あたしたちが盗まれたやつじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ふむ、今はそんな些細な事は気にするでない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "では、どうして坑道を最終ターゲットに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺たちが捕らえた傭兵が全部自白した。お前の弟がモンスターを作らせていた工場は坑道の奥深くだ。奴はまだ諦めてないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "そうだったのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ああ。俺たちがここまでモンスターをおびき出せれば、コーエンたちが坑道を爆破するチャンスを作ってやれるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "簡単だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どこがですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "大胆で計画性のかけらもない作戦じゃのう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "じゃが儂は気に入った。今回に関して言えば、戦うことこそが唯一の解決策になり得よう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "レンジャーさんがそうおっしゃるなら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "よし、友たちよ――それぞれ持ち場につけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺の狙い通りなら、源石エンジンを点火することで、必ず大量のモンスターがおびき出されてくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "厳しい戦いになるだろうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "一緒に残ることを選んでくれたこと、ロドスの各位に感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "いいのよ、汚染生物の掃除もあたしたちの仕事のうちだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "へえ、給料も出ないのにやる気だなんて珍しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "いちいちうっさいわね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "……皆ありがとう……どうやれば感謝の意が伝わるものか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "まだ成功したわけではないからの。感謝の言葉は最後にとっておくがよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "よし、では各位に問題がないのであれば――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "来た……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ちょっと、多過ぎない！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "どれくらいいる？　百できくか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "いや、それ以上かもしれん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "しかも……後ろにまだまだいやがるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "コーエンたちがうまくやってくれることを願うばかりだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
