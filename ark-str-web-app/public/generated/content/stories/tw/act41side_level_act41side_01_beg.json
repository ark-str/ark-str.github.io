{
  "server": "tw",
  "storyId": "act41side_level_act41side_01_beg",
  "groupId": "act41side",
  "stageId": "act41side_01",
  "title": "扉頁所見",
  "storyCode": "EA-1",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act41side/level_act41side_01_beg.txt",
  "sourceHash": "b3b6d037ccf897a54f5124e67405b99b5db57eee3c8564812a0a29aac60db723",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "報童的聲音",
      "text": "號外，號外！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報童的聲音",
      "text": "維多利亞人不戰而退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報童的聲音",
      "text": "塔拉領土全部收復！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報童的聲音",
      "text": "夏末節前，塔拉全境即將恢復和平！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性的聲音",
      "text": "停車。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍人的聲音",
      "text": "我接到的命令是護送您直接去見殿下，沒有逗留的時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性的聲音",
      "text": "在和她會面之前，我需要先用自己的眼睛看。姐姐的城市、戰後的塔拉、那些倖存者和普通人……他們的生活終於開始了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍人的聲音",
      "text": "……如果您執意如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軍人的聲音",
      "text": "但塔拉人還沒有做好面對兩條紅龍的準備——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性的聲音",
      "text": "我當然明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "你就——你就收下這些吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "這些砍刀、斧頭……碗盆，都是鐵做的，是上等的原材料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "求求你了，庫林。哪怕你把這些熔掉，幫我們的雕像做隻眼睛呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "提奧，提奧！來幫忙，把東西送去工坊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "提奧，你現在過來，晚上我就能抽空教你把你的小刀再磨亮一點——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "這孩子只知道偷懶，你真的是白寵他了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "不，我是說，不管提奧那個小子在不在，你就收下這些東西吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "不行，這些都是吃飯的工具，更不用說你這條假腿了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "我——\n我這樣不是還能好好站著嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "涅梅絲做的木頭假腿只能救急。等城裡來了更好的工匠，他們會修好你的鐵假腿的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "你在打造的是紀念整個戰爭勝利的雕像啊！到夏末節時會擺在城市中心的廣場上的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "讓這條鐵假腿沾沾勝利的光，這樣都不行嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "不行就是不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "你就收下吧，庫林。這些東西都是大家打掃房屋清出來的舊東西，用不到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "怎麼可能用不到碗盆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "鐵碗沒了還有陶瓷的，至於斧頭砍刀，大家輪流用就行了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "剛打完仗，城裡什麼都缺。我們不來幫你一把，難道眼睜睜看著雕像不能完工？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "無論如何，只有舊義肢我不能收。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "我的大英雄，你什麼都好，但你就是一個死腦筋！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "拉芙希妮緩緩走入人群。\n不知為何，她覺得自己和這些人中間隔著什麼，彷彿在看篝火對面的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "請問大家是在做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "新面孔？最近很少見呢！瓦伊凡，你從哪裡來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我從很遠的地方回到塔拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "庫林，你看，你早點收下這些東西，也不至於在遠道而來的同胞面前丟臉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "還是那句話，別的沒關係，假腿不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "為什麼大家連鍋碗瓢盆和……義肢，都拿出來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "因為我們要在夏末節的時候在廣場上立起一座雕像，慶祝塔拉的新生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "你們要過夏末節？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我只在塔拉的傳說中看過這個名字，一個在秋天豐收後、冬天到來前慶祝的，連通此岸與彼岸的節日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "瓦伊凡，你懂得很多啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "原本大家只知道秋收之後要慶祝豐收，還是深池的人告訴我們，這是有來歷的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "打掃房屋，設宴待客，最重要的是點起篝火，在生與死交會的這一天款待所有赴宴的人……能做的事情真的太多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "加上這是塔拉重獲新生以來的第一個夏末節，就更需要隆重慶祝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "多虧這一點，不然庫林就算把自己家拆了，也不會願意收下我們的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "這麼說來，你要不要也拿點鐵做的東西，讓英雄幫你熔了鍛進雕像裡呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我身上只有一枚書籤，似乎是鐵製的，可以嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "歸鄉的同胞，她說了不算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "哈哈……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "你們想鍛造什麼樣的雕像？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "紅龍的雕像，為了慶祝塔拉的新生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "紅龍……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "庫林，我告訴你！你不收下我的義肢，我今天就——就待在這裡，不走了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "我可以把你扛回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "唉，你這個人！你想一想，等夏末節過完，雕像真正建起來，我們的好日子就來了，到時候想做多少新的假腿都行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "巨大的紅龍雕像佇立在黑夜裡，即使到了冬天，火焰也像傳說裡的一樣永不熄滅，足以驅散所有吃人的霧氣……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "我們也不用再遵守該死的宵禁——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "宵禁是紅龍批准的命令，為我們所有人的安全著想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "我明白，我當然明白！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "說話間，更多人朝他圍攏過來，懷中抱著各種能被投入鍛造爐的物品，直至小巷堵塞，水泄不通。\n庫林耐心地一一應答，腳下的東西越堆越多。看樣子，即使一個人的雙臂再怎麼張開，也難以一口氣把這些熱情全都帶走。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "庫林，我來幫你吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "沒事，不用，我的學徒提奧——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "你還想讓提奧幫忙？那個小子早就不知道去哪裡偷懶了，人前裝模作樣，背後好吃懶做，純正的維多利亞人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "庫林",
      "text": "父母死的時候他才幾歲，哪裡知道什麼是維多利亞？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "這位同胞，你叫什麼名字？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "葦草。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "葦草，找到落腳的地方了嗎？不介意的話可以去我家住一晚，這樣就不用宵禁時還在街上遊蕩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "落腳的地方，應該是有的。但宵禁……是說城裡還有熄火鐘嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "維多利亞的熄火鐘是為了壓制塔拉人，現在納斯爾紗的宵禁卻只為了保護，區別就在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "黑霧盤踞在黑林之中，保護著整個納斯爾紗，但有些時候，黑霧也會進入城市街道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "宵禁就是為了避免任何人遇到黑霧。黑霧不允許任何人冒犯，要是有人未經許可闖進霧中，就真的再也回不來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "難道霧氣真的會吃人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "……你看，你大老遠回來，聊這種事幹嘛？反正很快就會好起來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "跟我來，我帶你看看納斯爾紗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "可鍛造雕像的這位……庫林？他怎麼辦呢？我會一些源石技藝，也許能幫上忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "別管他啦！他是那個在黑林裡隻身幹掉一整支維多利亞先遣隊的英雄，可惜最後心軟了，要不然怎麼會有提奧那個小子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "一個人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "畢竟是在黑林裡，黑林一向是幫著我們塔拉人的——唉，葦草，你老是打斷我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "跟我走，喝點麥酒，吃點燉肉，先暖一下身體——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "你一定得知道，現在回來，時機剛剛好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "呼，還好還好，至少店裡還有馬鈴薯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "糟了，已經這個時候了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "誰啊，走路橫衝直撞的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "提奧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "抱歉、抱歉，我急著趕回去，不是故意踩到您的，先生。我現在就幫您擦乾淨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "……連你也敢瞧不起我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "什麼？不，不是的，我可能不太會說話，我是想問，您需不需要幫忙——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "別過來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男人揚起手裡的拐杖，戳中提奧的前胸，用力將他撞出去。\n清晨的水霧早在地面石板不平的凹處匯聚成飽含髒污的水窪，提奧毫無防備地向後倒去，摔落其中。"
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "維多利亞壞種，你以為你是什麼東西，也敢向我施捨？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "呃……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "把你手裡的東西放下！你們在做什麼？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "提奧，你怎麼樣——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "我、我沒事，布莉吉姐姐。是我先撞到他的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "一個四處晃蕩的遊牧民，和一個成天東奔西跑的維多利亞雜種，混在一起，臭味相投。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "布莉吉，你還真是會丟你的祖先的臉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "你說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "哼，這個維多利亞壞種就算了，你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "明明是那位放逐王的後裔，身為幫塔拉人傳遞消息、預警天災的族群，竟然和他混在一起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "打仗的時候也是，不管自己人贏了輸了，你們都只是冷著臉把戰報往堡壘一丟，然後就挨家挨戶地送那些一點都不重要的家書……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的居民",
      "text": "你們這些人，還算得上是塔拉人嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "所以，你就只有這個地方能來？為什麼不直接回去庫林那裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "我……我得把衣服洗乾淨再回去。我很快就好，你現在可以不用管我啦，布莉吉姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "我不管你要管誰？我就是來找你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "你也是，這個在戰爭裡被打爛了又沒人修的地方，到底有哪裡比庫林的工坊好？至少庫林的工坊有火爐，有熱騰騰的飯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "不，我只是……不想再給他添麻煩了。求求你不要把今天發生的事告訴庫林先生，好嗎？等衣服乾了，我馬上就回去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "我不去找他，提奧，我是來帶你走的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "帶我走？是庫林先生……跟你說什麼了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "這到底跟他有什麼關係？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "今天如果我不來，你就這樣不還手，白白挨打嗎？我的直覺從不出錯，你要是繼續待在城裡，他們只會變本加厲地欺負你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "今天是把你推進水坑裡、用拐杖打你，誰知道明天是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "總之你跟我走吧。我帶你去原野上，想去哪就去哪，怎麼樣都好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "我們不是這座城市裡的人，哪怕你不知道該去哪裡，也可以先去涅梅絲原來住的地方，去守靈人的聚落裡待一陣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "涅梅絲小姐跟我講過許多守靈人的故事，我確實想去看看……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "但是，既然不是庫林先生讓我走，那我就不能走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "涅梅絲小姐現在分身乏術，紅龍雕像也還沒完工，如果我這個學徒也走了，庫林先生一個人要怎麼辦呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "不管怎麼說還是謝謝你，布莉吉姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "那我送你回庫林那裡，然後我就離開城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "不，布莉吉姐姐，現在天氣變冷了，衣服乾得比較慢，我晚點再回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "實在不行，那邊沒人住的房子裡可以避風，還有不知道是誰剩下的棉被，我之前也在這裡住過，沒問題的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "……如果你實在不想跟我走，待在這裡確實比在城裡其他地方安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "很多時候就連庫林也沒空照顧你，是不是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "提奧",
      "text": "庫林先生還有不少更重要的事，我應該為他分憂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布莉吉",
      "text": "再見了，照顧好自己，小傢伙。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "我們到了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "你來的時間剛剛好。今天我們有新鮮的麥酒、燉肉、燕麥粥……只可惜沒有篝火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "夏末節還沒到呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "按照過去的傳統，夏末節前幾天就可以點燃篝火了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "不過戰爭剛結束，城裡確實沒有多餘的燃料，也不能隨隨便便砍伐黑林，晚上還有宵禁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "不管怎麼說，反正天還亮著，太陽不就是我們的篝火嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "先別說了，快入座吧，我讓他們空一個位置出來給你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "拉芙希妮走上前去。濕潤的冷空氣中，桌上看似豐盛的食物都飄蕩著同一種香氣。\n溫熱、質樸、簡單……卻名不副實。\n她壓下驚愕，左右看了看，意識到似乎沒人覺得這有什麼異常。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……這就是，燉肉嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "友善的居民",
      "text": "是啊，這是燉肉，這是烤鱗，你手邊杯子裡的是麥酒。對了，還有燕麥粥，我去幫你盛一碗——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "可是……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "可是這些菜式，不都是用同一種原料……\n不都是用馬鈴薯做的嗎？\n雕像是碗盆，篝火是太陽，宴席是馬鈴薯。\n趁那位居民去盛“燕麥粥”的工夫，拉芙希妮沉默地站起來，走向一直在等待著她的馱獸車。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "殿下很快就會回來，請您在此稍候片刻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "這裡是……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "納斯爾紗的堡壘。整座城市的制高點就在您身旁的台階上，這也是殿下蒞臨納斯爾紗後最常停留的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我很慶幸這裡沒有燭光、樂師和豐盛的宴席。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "我已經向您解釋過了，城內物資短缺的主因是維多利亞與塔拉之間的商貿往來仍未恢復。我們已經在盡力緩解這些問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "而城內居民的反應完全是出於理解和善意，以及對塔拉的熱忱——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "愛布拉娜殿下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "你可以走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“校官”",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "拉芙希妮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "姐姐，這座城市到底怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "人們在慶祝一場沒有豐收、沒有篝火，甚至連宴席都只能吃馬鈴薯的夏末節！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "如果你來見我，就是為了讓我能把“校官”說過的話再重複一遍，看在久別重逢的分上，我也不是不能接受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "與之相比，我更關心你的槍。它在哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "槍？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "如果你說的是你送我的那把，它現在躺在羅德島的倉庫裡。我已經不需要它了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "但手無寸鐵之人，又該如何爭取自己的那份權柄？甚至不必說權柄，這樣的人隨時都有可能失去性命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我說的是“你送我的那把”，姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……而且，你不會殺我的，至少現在不會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "一個好不容易找回靈魂的牽線木偶，你不可能會在玩膩之前就把它毀掉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "這句話真讓人傷心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "誰都可以是牽線木偶，只有你不是，拉芙希妮。你只是一個寧可當我的影子，也不願陪我跳一曲的舞伴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "然後，差不多一年之前，你終於厭倦了，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "……我不太記得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "至於權柄，我不是來爭奪權柄的。那權柄理應屬於你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "你在塔拉各處點燃星火，燒斷了塔拉人身上的鎖鏈，這是事實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "那你又回來做什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我來見證。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "如果你真的願意用權柄讓塔拉人的生活重新開始，我會為之竭盡所能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "就讓我假定你暫時無暇處理城內的匱乏吧，既然這樣，我願意去做我能做的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "無論是作為另一條紅龍拋頭露面，還是像剛才那樣隱去身分，我都無所謂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "一如既往的高尚，拉芙希妮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "但我不知道……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……你是否真的會滿足於此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "我所知道的姐姐，並不是一個為了紙醉金迷的生活而追逐權柄的人，她絕不會止步於此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "而她過去邁出的每一步，都以無數屍骸和鮮血鋪就而成……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "但我希望那只是因為你不得不這麼做，姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "但我希望我永遠不必帶著我的槍來找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "真不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "看來這段遊蕩生活教會你的，比你當我的影子時學會的更多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "姐姐，我們別再拐彎抹角了。我已經說明了我的來意，你接納我回來，又想從我身上得到什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "你馬上就會知道的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "在那之前，不如先跟我來，看看這座紅龍的巢穴吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "傳說設計師刻意仿照塔拉王城的樣子，將地塊呈現高低起伏。\n傳說塔拉石匠偏執地在建築中揮灑他們精妙的技藝，卻又不願為即將迎來傀儡的堡壘做絲毫裝飾。\n拉芙希妮聽過許多這樣的故事，而故事從來不保證自己究竟是跳動的火，還是映照在岩壁上的影子。\n於是她跟著姐姐走上一旁的台階，用自己的雙眼去看這座城市。\n她看見下方廣場上空著的台座，似乎正等著安放什麼巨大的東西。\n她看見自廣場一路蜿蜒出去的石子路，以及那些質樸到令人心生憐愛的石造房屋。\n但當她試圖看得更清楚、更用力時，她終於望見了此前一直隔在她和居民中間的東西。\n絕不該在這裡出現的東西。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "火？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火。\n仔細觀察可以發現，在城市各處，在交談、奔走、吆喝、休息的居民身上，都有星星點點的火。\n紫色的死火。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "你對城裡的人做了什麼？把他們變成了死者？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "你剛從他們之中回來，你比我更有發言權。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "火是會蔓延的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "你的死火不該蔓延到生者身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "很可惜，不論戰場還是喧囂的城市，有人的地方就有死亡，火也只不過是將其提前而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "但必須承認的是，我對此並不滿意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "死者憑著生前的慾望在曠野遊蕩，沾染了死火的生者則永遠無法重新開始真正的生活……生與死不可能永遠這樣混淆，相互褻瀆彼此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "這難道不是你一直都在做的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "死亡理當供我驅策，而非自行毀去我不願讓其染指的部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "那麼，拉芙希妮，我親愛的妹妹，我現在要徵詢你的意見了。你希望塔拉走向何方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "是讓生者留存、死者安眠，還是讓整個塔拉都淪為死亡的國度？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……不要明知故問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "那麼你要做的事情就很簡單了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "殺死我，拉芙希妮。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "你？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "在你帶著人群跋涉的時候，我已經做了不少準備工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "在你的槍尖直抵我的心臟、喚來死亡將我擁抱的那一刻，被死火沾染的一切也將隨我離去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "然後，你將成為塔拉從數十年前到現在，獨一無二的領袖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "……我不會再成為你的影子，紅龍之間也不該像被污衊的那樣，病態地自相殘殺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "自相殘殺與高尚的品德往往並不矛盾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "還有那些沾染了死火的生者，他們真的能像你許諾的一樣，重新開始自己的生活嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "我從未保證過任何與生活相關的東西，拉芙希妮，連沒沾染死火的人也是一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "至於城裡這些人，既然已經被紫火纏身，他們就只會一點點化作你曾見過的行屍，然後和我一同離去，沒有第二種可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "他們是活生生的人！他們在你的驅策下為你打贏了戰爭，他們有權開始新的生活！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "這是他們不幸的宿命，僅此而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉芙希妮",
      "text": "絕不，愛布拉娜，絕不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愛布拉娜",
      "text": "那麼，你又要怎麼辦呢，拉芙希妮？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "拉芙希妮還想說些什麼，但愛布拉娜已經轉身走向長廊，縹緲的腳步聲甚至讓拉芙希妮都沒意識到她的離去。\n在姐姐的身影徹底沒入黑暗後，拉芙希妮再度望向城市。\n她多麼希望一切都是愛布拉娜製造的障眼法……但火就在那裡。\n她握緊拳頭，戴起帽兜，轉身走下台階。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
