{
  "server": "tw",
  "storyId": "act5d0_level_act5d0_06_end",
  "groupId": "act5d0",
  "stageId": "act5d0_06",
  "title": "10:26P.M.",
  "storyCode": "CB-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act5d0/level_act5d0_06_end.txt",
  "sourceHash": "75953b8cd8167fc6aa6d56d47108303db6ba52f5518a85faa59eb14a057b0ace",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "晚上好，敘拉古的喪家犬，弩彈打完了？可我怎麼還活著呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "真不愧是大帝，槍林彈雨裡還端著酒杯，運氣不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "......龍門從來不會縱容真正的廝殺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不按遊戲規則來，可是會被驅逐出局的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "規則？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "當龍門員警到場的時候，只會看到你們幾個支離破碎的屍首，企鵝物流。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......街道上都是他們的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "連後門都堵上了，唉，看來這位先生一直懷恨在心嘛，做得很徹底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "卡彭那個懦夫太過忌憚鼠王和魏彥吾了，後者興許值得關注......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "至於你和那隻裝腔作勢的老鼠，除了讓人作嘔的本事一流之外，一文不值。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "嗯，你是真這麼覺得？還是單純想放狠話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "誠心實意，“大帝先生”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "可頌，幫我撿瓶酒，我來幫他修理一下大腦皮層。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "但是老闆，不瞞你說，我們已經砸掉了上百萬龍門幣的紅酒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "......那他們的命值多少錢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "怎麼看也不值這個數字吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "要動真格的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "怎麼會呢。我們一定會恪守和小魏的約定，在龍門之內，不打真架，不鬧人命，一切生意上的糾紛，在商言商。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "只是今天我們總計逃亡了五個小時，超出了我日常工作時間的兩倍，兩倍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "不僅如此，我們還炸掉了整整一年份的行動補貼！汽車，紅酒，還有我的珍藏黑膠！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "現在，在我的酒吧發生了一些預料之內的意外死亡，這總沒什麼問題吧？嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "德克薩斯，你的名字就讓我感到不快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "我不記得自己認識你這樣的敘拉古人。但你會再次夾著尾巴逃離龍門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "你會後悔詆毀我的家族，德克薩斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "到底誰才是逃來龍門的喪家之犬，你心裡清楚。你根本不配與西西里人為敵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "這才是像樣的表情，德克薩斯！這才有點敘拉古人的樣子！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "真是意料之外呢，你也是被叫過來的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "算是吧。不過能從商務酒會脫身的感覺也不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "唔，這些黑手黨的小打小鬧，值得這麼興師動眾的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不值得。而且我只是想從麻煩的社交裡脫身，找個機會喘口氣罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "可頌為她的錘子定製了新的配件。能天使讓我幫忙保養她的守護銃。總之，還有很多事情要做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "嗯，也許我也得麻煩你一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "沒關係。除了本職工作，為同事們處理這些雜務，也是我的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "這把法杖，能幫我保管一下嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "白色的這把。你明白這其中的含義吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "至少今晚，就讓我輕鬆一點吧，只是一場狂歡而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我總不能真的帶著它跳進舞會現場，那會失控的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我知道了。交給我吧，這也是工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "呵呵，說來說去，不還是工作嘛，你也真是辛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "結束之後要不要去喝一杯？我請客好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "十分贊同。同事之間的酒會比無趣的應酬要好得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "但很可惜，看這動靜，也許大地的盡頭很難保全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "......那麼，你是剛回來龍門？對今晚的事情知道多少？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "全部。這次狂歡的來龍去脈並不複雜，一切情報昭然若揭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你不打算去幫個忙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我拒絕。體力勞動就交給年輕氣盛的孩子們吧，我就保管著你們幾個人的貨物，喝一杯茶，等著事情結束好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好了。既然鼠王已經在等著你，那就玩得開心一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "——你也是，伊斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "難得的安魂夜，就不要這麼辛苦地工作了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "那麼，我先走一步。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "......安魂夜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "糟糕，安魂夜應該放假來著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "我為什麼習慣性地加班了......嗯，虧大了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "但至少，她把你留給我了，我們可以難得敘敘舊了，老朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "嗯，把你握在手上的感覺還不賴，抱怨也沒用。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "你無路可退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "哈啊，哈啊，德克薩斯，你的身手倒是對得起你的名字......所以你的家族——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "住口。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "德克薩斯小姐~我比你多解決一個人哦~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "但壓制頭目的人是德克薩斯，至少要算三個人吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "欸？所以算我輸嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "不，沒人和你比這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "唔，這裡還有一瓶完整的，我看看價碼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "一，二，三......七、七個零？謝天謝地！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "不要怕！這些傢伙不過就五個人而已！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "不許說這種爛俗的台詞！哦噠——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "又、又砸頭......呃....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "而且算上我，是六個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "六名物流公司員工和一整支武裝黑手黨正面衝突，贏家竟然是前者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "——這也太奇怪了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "沒什麼奇怪的喔？論打群架的本事，人數差不太多的話我們就是龍門第一！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "你們輸了，投降吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "輸？投降？哈，你真的是那個“德克薩斯”嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "一旦拔劍相向，西西里人之間就不存在“輸贏”，只有“生死”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "你應該後悔沒有痛下殺手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "引爆！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "——！注意掩護！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "呃——又是炸彈——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......嘖，又讓他們逃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "要追嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "不，我也稍微有點，低估敵人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......就算只是逃來龍門的失敗者，畢竟也是以西西里人自居的黑手黨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "德克薩斯，你受傷了！？我、我來給你包紮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "傷口不深，別緊張。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "這可不行！先坐下！我去找一下醫療箱......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "西西里人......西西里人是什麼意思？是敘拉古人的某種稱呼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "敘拉古十二家族起源之一的西西里聯合，是最開始透過暴力取得戰果的城邦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "這也是敘拉古語中“西西里人”的詞源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "但現在......這個詞有了別的某種含義......已經很少有敘拉古人以“西西里”自居了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "雖然他們也許因為各種原因......不再強大，但既然他們如此自稱......唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "算啦，德克薩斯，一口氣說這麼多話很累吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "總之！他們真的是一群很危險的黑手黨！雖然是自稱的，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "那就更不能讓他們繼續這樣突然襲擊了，損失只會不斷擴大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "我們得反擊，我們需要一個——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "......等等，都先等等，你們覺得我該找什麼藉口，向那位酒精過敏的白癡調酒師解釋？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這還有的解釋嗎......啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "至少老闆你坐著的高腳凳還是完好無缺的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "就剩這張高腳凳了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "......嗯，就剩這張高腳凳了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "——啊，破碎的酒瓶和殘垣斷壁也有一種別樣的美感，沒錯，這正是本人獨特的風格化改造！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不不不，這再怎麼扯也太牽強了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "還是準備好全額賠償吧，唔啊，企鵝物流的經濟寒冬要到來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "而且酒味好重，身上也黏黏的，不過正好可以給傷口消毒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "別胡鬧了，哪有用葡萄酒消毒的！這裡有醫用酒精......為什麼有個吸管？不、不管了，德克薩斯，我來幫你消毒......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "......我改主意了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "既然他們執意要在安魂節這一天找麻煩——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "那就只好讓他們此世安息了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
