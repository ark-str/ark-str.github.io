{
  "server": "tw",
  "storyId": "act11d0_level_act11d0_04_beg",
  "groupId": "act11d0",
  "stageId": "act11d0_04",
  "title": "復仇之魂",
  "storyCode": "TW-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act11d0/level_act11d0_04_beg.txt",
  "sourceHash": "0e3667c28e31b318765247b23c4d3156f7871560077386052270fef5c089f152",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 4上"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......怎麼會......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "......這真是......慘不忍睹......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "火災，現場已經處理過了，時間也過了很久。但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "這裡，羅德島的物資箱，編號，日期，一應俱全......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "這裡的灰塵很規則，曾經有個某個方形的物體放在箱子上吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......也許是安托的工作牌，她不喜歡掛在身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "卡達幹員，斷崖幹員，現在情況有變。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "這、這我也明白的啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "既然灰喉姐和艾爾斯把我從山上救下來了，我一定會好好幫忙的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "不要叫我艾爾斯......唉，萊恩哈特到底和你們說了些什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "天災造成的後果很嚴重，沃倫姆德現在不會好過，那裡的天災信使在做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "如果是萊恩哈特或者地靈小姐在的話，至少情況不會這麼糟糕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "假設是無意義的......我們應該做好最壞的打算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "駐紮在城鎮外，你們倆會有困難嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "完全沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......我畢竟是天災信使的專職護衛，而這一位幹員是為了拍攝影片素材深入冬靈山脈然後迅速遇難的“天才兒童”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "都這個時候了你也要損我的嗎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "只是開開玩笑，不然......灰喉不會希望我們現在就衝進鎮上砸開議事廳的大門，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......抱歉，忍耐一下，我去確認一下安托的情況。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "去去就回。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......饑荒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "饑荒。饑荒會毀了所有人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "我知道你想問什麼，沃倫姆德這樣規模的城鎮，當然有自給自足的能力——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "前提是大裂谷出現的那天，沒有那麼多源石從地下刺穿構造區，割裂地塊，炸毀農田和供給設施。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "事實上，沒有在商業區和城鎮中心發生爆炸，已經是萬幸了，但即使如此我們依舊損失慘重......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "季節也很糟糕，已經入秋，我們的航線正在向冬靈山脈進發，今年的冬天會來得很早。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "我們沒有把這一事實告訴所有人，是不希望引發不必要的恐慌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "然後，我們被不知情的自己人捅了刀子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "那些叛徒......怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "塔佳娜帶著年輕人去排查了，如果沒有人帶路，沒人能夠碰到動力爐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "各個街道應該有自己的備用拖拉設備，情況如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "......這樣行進速度太慢了，頂多只有其他城鎮的八分之一，我們無法在冬天之前離開山脈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "糧倉不能出任何問題，加派人手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "人手......哪怕是老人和孩子，只要還願意拿起武器的，都已經......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "對糧倉出手，等同於殺死沃倫姆德所有的人！他們，他們再怎麼也不至於......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "別把他們想得太好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "那個......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——請說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "十二音街道，也就是隔離區，之所以那麼蕭條，也是因為......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......如果我說，單純是因為感染者的人數問題導致配給縮水，你們信嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "不，你們信不信根本不重要，他們信嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "他們要拆掉倉庫的門，仔細檢查每一顆穀穗，才會相信我們說的話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "那麼，難道我們就要讓他們拆嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "如果真的只是檢查檢查，我倒也樂意開誠佈公，但不是每個人都打算看看就算了的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "即使官方沒有公告，聰明人也能從路線和時令推算出沃倫姆德將在冬天遭遇的大饑荒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "他們煽動，他們掠奪，今天的所作所為，只是為了部分人自己活下去，而讓另一部分人餓死，說白了，就是在找藉口搶劫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "羅德島是感染者問題對策專家，我當然信，安托醫生的專業和你們的戰鬥足以說明一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "但是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——這片大地上的難題，就只有礦石病而已嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......即使在這個場合，我也必須為安托發問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "那是一場謀殺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "——無關人士都出去！長官和羅德島的二位有要事想談！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "塞弗林。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民代表",
      "text": "那麼，交給你了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......看來，這不是個可以放在檯面上進行的話題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "哪種有關謀殺的話題可以放在檯面上進行？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你們的隱瞞會招致惡果——不那麼正式的用詞，我現在就看你們很不爽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "羅德島幹員安托在沃倫姆德捲入一起謀殺事件殉職，我需要得到一個答覆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......還有，根據那位清醒過來的感染者居民的證詞，他們也在尋找“兇手”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "也許兇手就在他們之中，常見的挑撥伎倆，賊喊捉賊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......也許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "但在我們討論兇手之前，我想——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——打住，你沒必要說出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "即使是我也有良心不安的時候，如果你提出請求，會讓我感覺很難受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "但沃倫姆德還要靠羅德島解圍，事到如今，已經沒有難為你們的必要了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......跟我來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "這裡是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "如此草率的處理我感到很抱歉，但他們大都是感染者，只有擺放在這樣的地下才能讓其他人安心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......很冷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "無論何時何地，我都會確保這些製冷裝置的運行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "很精緻的法術，不虧是萊塔尼亞的士官長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......受害者，八名。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "沃倫姆德的四位居民，安托醫生，還有三個來自外界的感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "......塞弗林長官的兒子......托爾瓦爾德先生也在其中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......塔佳娜把這件事也告訴你們了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "因為我的失職......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "安托......你在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你......你可真難找啊......蠢貓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "奇怪......她是怎麼辨認出......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "（塞弗林長官......我們，讓她們獨處一會吧？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": ".......好吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......她的強勢時常讓我忘記，她也只是個努力前進的小女孩，和塔佳娜差不多的年紀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "塔佳娜姐姐......她在強撐著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "啊——！您不該再抽煙了！我說過的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......也許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "吸煙會讓您的支氣管疾病更加——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "您、您難道——？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......你想到了。小狐狸，你比我想的還要敏銳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "但是現在，先幫我保密吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "亞葉姐姐......好受點了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "以你的年紀來說，很了不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "我知道現在我眼睛腫了，你是在諷刺我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "痛失好友還能保持這樣的冷靜，我沒有什麼可嘲笑你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......事情還沒完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "沒錯，事情還沒完。現在，希望我們是一條戰線了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "這是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "城防法術發生裝置L-44“留聲機”的自律施術單元，簡單來說，這就是兇器了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "這種程度的破壞力在民間當然是非法的，但反過來說，只要是受過高等教育的萊塔尼亞人，就有辦法驅動這枚核心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "超載，升溫，爆炎，畢竟是城防設備的一部分，源石技藝工程很複雜，不是誰都能用得來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......就是這個東西，就是有人用這個東西，把安托給......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": ".......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......我們要找出兇手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "那之後呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "那之後......我要他付出代價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......真意外，原來不安和悲傷過去了之後，你選擇的是復仇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "亞葉姐姐......我們不應該......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "我當然知道，作為羅德島的幹員，凱爾希醫生的學徒，我應該比誰都清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "但唯獨那個人——那個人必須接受審判！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "安托做了什麼？她在幫助感染者，她在幫助他們！安托為什麼要遭受這一切！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "至少——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "至少......至少我想問問他......為什麼要這麼做......憑什麼這麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......我明白了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "塞弗林長官，鈴蘭小姐，亞葉小——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "啊......亞葉小姐已經......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "她們已經見過面了......你的樣子很慌張，又出什麼岔子了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "是的。在搜查的過程中，感染者又和普通人發生了衝突......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "又一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "但這次......代表們出面都安撫不了大家的情緒，他們嚷嚷著要和那些武裝感染者宣戰......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "城鎮的移動手段被大幅度控制，這意味著什麼很多人都明白......他們忍無可忍了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "但是、但是我們有新的發現......串通感染者的居民裡有很多人並不是感染者，他們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......我已經猜到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "冬靈人，該死的部族，他們又來糾纏沃倫姆德了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
