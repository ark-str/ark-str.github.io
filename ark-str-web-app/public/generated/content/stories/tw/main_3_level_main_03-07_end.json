  "groupId": "main_3",
  "stageId": "main_03-07",
  "title": "轟鳴",
  "storyCode": "3-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_03-07_end.txt",
  "sourceHash": "52772ffc3b45d1c6a4271e2b13020aaf82d32d91001f0f08a8681770a5a8a36f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十九关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "不能讓他們過去！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "W應該帶走米莎了——————！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "不能讓這些傢伙得逞！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "——給我讓開！別急著尋死！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "呃，呃啊！！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "哦，哦哦......這麼粗暴的作戰方式，讓我想起了羅德島的一個人。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "她和星熊長官大概，大概會很有共同話題吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "不要光站在那裡，芙蘭卡！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "快做點什麼！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "好啦，好啦。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "哈，龍門的督察傳說看來是真的啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "別分心。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "沒光是——"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "在看別人哦！砰！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "speakerId": null,
      "text": "唔啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "廢墟二樓的那些火力小組，可是我發現的哦？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "很棒。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "嘿嘿。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "......我們走。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "不能讓雇主孤身奮戰。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "芙蘭卡，有沒有找到米莎？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "到處都沒有她的蹤跡。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "W可能，已經把她帶走了——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "嘖，動作也太快了——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "哪裡發生了......爆炸？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "芙蘭卡，集合各個小隊，支援近衛局！"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "speakerId": "char_015_lmg",
      "text": "羅德島的各位，千萬小心！"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "speakerId": "char_015_lmg",
      "text": "這個敵人，它，它......"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "speakerId": "char_015_lmg",
      "text": "它......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "——發生什麼了？為什麼不說話？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "敵人——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......咦？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "那是......？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "怎，怎麼會......!"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "————什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "嘁，這是什麼把戲？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "是奇蹟，奇蹟啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "為什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "別發呆！找掩體！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "奇蹟發生了！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "————是你嗎......是你嗎！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "——他沒事！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "他，他沒事啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "碎骨還活著！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "碎骨！真的是碎骨！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "萬歲！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......難道......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......不......"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "整合運動......因為領袖的出現士氣大振了嗎。"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "要拿下他們變得更難了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "......形勢很嚴峻，碎骨。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "但至少......你回來了。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "——太好了......真的......太好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "米莎她也應該離開了吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "這樣，我們就能放手一搏了！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "——我會在這裡，擋住他們。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "你們，快走。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "我會保護你們——"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "說什麼呢碎骨。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "我們不是早說過，要一起回烏薩斯，給那些傢伙點顏色看看嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "好好照顧自己，別死了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "不，不可能......"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "愣在那做什麼！"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "星熊，立刻向週邊的近衛局成員發出通訊！"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "陷阱和埋伏已經基本被我方排除，沒有發現敵方領袖W和任務目標的身影。"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "現在，更改作戰目標！"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "立刻收攏包圍圈，合力夾擊整合運動！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "為什麼......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......為什麼會這樣......."
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "不......"
    },
    {
      "type": "sceneBreak"
    }
  ],
