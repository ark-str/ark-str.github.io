{
  "server": "tw",
  "storyId": "act21side_level_act21side_03_end",
  "groupId": "act21side",
  "stageId": "act21side_03",
  "title": "萬箭所指",
  "storyCode": "IS-3",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act21side/level_act21side_03_end.txt",
  "sourceHash": "9801ee6abd281aaf6827997ec33cb348870294bfe76a9eefbe59352380e30ce4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "......她為什麼會出現在這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "是、是德克薩斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "我們的人損失慘重！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "嘖，不該放任拉維妮婭和那個廢物聊那麼久的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "算了，看到徹底墮落的同行，那女人的精神也完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "只要能熄滅萊昂那點幼稚，過程怎麼樣不重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "text": "招呼我們的人，走了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "書記員",
      "text": "他......他們已經離開了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "他已經死了，箭頭貫穿了他的心臟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "感謝你們，否則死在這裡的就是我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "闔上眼睛吧，殺手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "這是......?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "一個本子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "敘拉古的法官證，放在他胸口的口袋裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "已經被剪了角，上面寫，它的主人在三年前因為瀆職而被吊銷了法官資格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "瀆職，哈，瀆職。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "他們當時就不能找個更體面的藉口嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "你還好嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......我似乎應該先問你為什麼能從監獄裡出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "企業機密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "好吧，現在我也沒有力氣追究這個了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "你很需要休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但我還不能休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "這條線索斷了，我還要去找別的線索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "炎國有一句諺語，叫“欲速則不達”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......我當然知道這個道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但是，我沒有那麼多時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "卡拉奇對你來說，是個很重要的人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我和卡拉奇部長並沒有見過幾次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "畢竟我是法官，和他在職能上相差很遠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但是，凡是沃爾西尼的居民都知道，他是一個非常具有活力的人，圓滑地處理著和家族的關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "他花費了全部的精力在新城區的建設上，用盡各種手段來保證市民們能有一個比較安全的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "因為調查他的死，我開始真正瞭解這個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "戰戰兢兢，如履薄冰，絞盡腦汁用手頭上能交換的一切，來博得一點點能做事的空間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "比如，在遠離家族利益紛爭的區塊多建幾所學校，多建幾所醫院......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我不知道該怎麼評價他，或許，只是個有點良心的好人吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但好人在敘拉古的結局是註定的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......和這個揣著法官證的殺手一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "敘拉古是有正規的法律學校的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "使用的是哥倫比亞出版的教材，畢業後，不僅可以在敘拉古本地的法律機構任職。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "也擁有被哥倫比亞承認的資質。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "如今，我們和龍門的來往也越來越頻繁了，再過一段時間，炎國可能也會承認這方面的資質。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "聽起來是一件好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "是啊，當然是好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但是，這不會影響任何事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我的母校曾經邀請過我回去為學弟學妹們演講，給他們一些信心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但是，當我站上台的時候，我發現，我沒有辦法告訴他們，相信自己學到的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "法律之所以生效，在敘拉古，竟然是因為一個人的存在，而不是它真的基於一種被認可的公平。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "某種意義上，這比無法之地還要荒唐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "而敘拉古人居然真的在這種環境下生活了將近六十年，以至於當所有人都習慣之後，沒有人再敢質疑這一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我是公正的化身嗎？不，我是一個化身，但連我自己也不知道，我的背後是什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......要去吃點東西嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......要的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "謝謝。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我沒想到你會在這，萊昂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "我聽說你遭到了襲擊，就趕來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "沒出什麼大事，德克薩斯幫了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "只是線索斷了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "收手吧，拉維妮婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......萊昂，我們應該有過約定，不在吃飯時聊會吵架的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "現在不是說這個的時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "不，這是我們唯一能無視各自的立場坐在一起吃飯的方法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "如果你打算打破這個約定，那我就先告辭了，萊昂圖索閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "你這是在拿你自己的性命開玩笑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......從當上這座城市的法官那一刻起，我就在拿自己的性命“開玩笑”了，閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "我打算去和羅塞蒂談。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "無論他們對切利尼娜的存在怎麼反應，他們都必須要和我們談。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "主動權在我們手上，只要能牽制住他們，無論是內鬼也好，還是其他家族也好，都會被壓住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "問題並不出在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "城裡現在局勢十分緊張，所有人都在猜是誰下的手，如果不穩住局勢，情況也會變得越來越糟糕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "說實話，如果你真的能找到兇手的話，我會不遺餘力地幫你推進下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "但是現在，對方明顯有備而來，你今天遇到的事，毫無疑問是一次警告。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "再繼續下去，你的調查也不會有任何進展，只會遇到更多危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "所以我應該聽從你的安排，中止調查，讓這件事不了了之？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "拉維妮婭，你不是一個會意氣用事的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "萊昂，你跟卡拉奇部長共事過，你應當更加瞭解他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "無論他是以什麼樣的原因坐到了那個位置上，他都是一個能讓城市變好的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "這樣的事，每天都在發生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "所以，在敘拉古，想做一個好人就一定會死嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "對我來說，你比他要重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "卡拉奇部長的死，對你來說，或許就像一場稍大的雨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "雨淋不到站在室內的你，你只是會奇怪，雨為什麼會下這麼久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "如果你足夠好心，還會想去給雨中的人送傘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但對我來說......我已經不想再問自己，我要站在屋簷下等到什麼時候了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......但你只有一個人，要怎麼阻止一場雨？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "至少這一次，我不希望眼睜睜地看著卡拉奇部長那樣的人平白死去而沒有作為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我已經做過太多違心的事情了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "如果，我是說如果，萊昂，我的生命能夠用來換些什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我或許還會覺得好受一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "我從哥倫比亞人身上學到的事情是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "想要別人聽我的話，有的時候，利益比暴力更有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "但這並不意味著我不會行使暴力，拉維妮婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "而這正是我說的，你我之間最大的差異。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "你坐擁暴力，你以教養和自制讓自己不去使用，而我甚至要為你的仁慈而感謝你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......我不是這個意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "而我也不是在責怪你，萊昂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "你願意去想雨為什麼會下這麼久，已經非常難得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "但是，你是貝洛內家族的下一任家主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我只是一個身不由己的法官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "我們的立場始終是不同的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "就這樣吧，萊昂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "如果你真的想幫我，那就繼續做你該做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "你真的能和羅塞蒂談妥，對局勢也一定會有幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "只是，除非你現在將我關起來，否則，誰也不能阻止我，找到真正的兇手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "餐廳裡寂靜無聲。\n萊昂圖索想要再說些什麼，但他發現自己能想到的一切語言都是蒼白的。\n喉結翻動了兩下，他沒有說出一句話。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "等等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "德克薩斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "對了，你也回去萊昂身邊吧，他和羅塞蒂的談判會需要你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "不，我有一個更好的辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "你不是需要一個兇手嗎，我來做這個兇手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......你知道自己在說什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "這是能穩定局勢最快的方法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......我不用別人來憐憫我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "不要誤會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "我是為了我自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "你們都是對的，再這樣下去，局勢只會更加糟糕，幕後黑手也會更加難找到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "在局勢進一步惡化之前找到兇手是最理想的辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "而對方顯然也會千方百計地阻止。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "你是說，你來當誘餌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "其他人份量不夠，我來正合適。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "將德克薩斯真的推作犯人，透過犧牲一點名譽，將過錯都推到自己家族的識人不明上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "然後，你們就可以放我離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "這能夠最快速度穩定局勢，並且，還能借此引出幕後黑手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......很冒險，但或許有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "不過......你是德克薩斯最後的血脈，而這裡是敘拉古。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......對我來說，最無所謂的東西，就是德克薩斯這個姓氏帶給我的名譽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "我說過，我的目的只有一個，那就是完成和貝洛內的約定，離開敘拉古。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "你......為什麼要做到這一步？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "我也有不少想要讓事情變好的朋友，在一個叫羅德島的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "我同樣不會接受她們輕易死去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "這個方法如果順利的話——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "甚至可能直接反將幕後黑手一軍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "我現在開始慶幸，你願意站在我們這一邊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "既然這麼決定了，那這場審判，肯定動靜要鬧得大一些，最後才能鎮住其他家族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "我會安排下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "接下來，輪到我們反擊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "那麼，你能給我一個讓我離開敘拉古的承諾嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "我向你保證，等我們的計劃成功，沒有人會追究你的去向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "那些關注著你的人，羅塞蒂也好，其他家族也好，只會知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "“切利尼娜·德克薩斯越獄了，如今已經離開了敘拉古。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "抱歉，拉維妮婭，這或許有損法律的尊嚴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......我沒那麼古板。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "如今......只能做下去了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
