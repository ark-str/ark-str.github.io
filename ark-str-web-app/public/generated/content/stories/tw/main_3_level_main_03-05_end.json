{"server":"tw","storyId":"main_3_level_main_03-05_end","groupId":"main_3","stageId":"main_03-05","title":"呼叫","storyCode":"3-5","avgTag":"行動後","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_03-05_end.txt","sourceHash":"ec54d79e4dec9af5c1db5d57197fa5d0195c19ec535ded3fac66569508b9baf8","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二十七关（后）"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"後撤！重整隊形！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"讓他們走吧！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"再這樣下去，我們的隊伍會被敵人分隔！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"如果敵人還有後續的戰力增援，後果不堪設想......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"這些整合運動......不是在針對我們！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"優先保證我方幹員的安全！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"狙擊幹員，暫時停止對撤退的整合運動的攻擊！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"優先支援星熊警官！"},{"type":"dialogue","speakerName":"星熊","speakerId":"char_136_hsguma","isRemote":false,"text":"真煩人！"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"不錯不錯，居然被你撐住了~"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"不過，你還能撐幾發呢？"},{"type":"dialogue","speakerName":"星熊","speakerId":"char_136_hsguma","isRemote":false,"text":"那要看你的命有多硬了！"},{"type":"dialogue","speakerName":"星熊","speakerId":"char_136_hsguma","isRemote":false,"text":"——————老陳！快！"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"包圍那個女人！"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"哦哦，近衛局的後援嗎？"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"放下你的武器！"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"陳長官，我們又見面了~"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"油腔滑調不能救你的命。"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"你對龍門做的，我會加倍在你身上討回來。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"哎呀~真可怕~"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"但我這次不是來找你的。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"阿米婭，接好~"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"我？這是......行動電話......？"},{"type":"dialogue","speakerName":"W","speakerId":"char_002_amiya","isRemote":false,"text":"是的，有人想和你說點事~"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"————————？！"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"好，這樣我的任務就完成啦。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"另外這個，不是給阿米婭的，而是送給你們的。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"後會有期囉~"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"小心！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"——近距離爆破——？！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"不對，是閃光彈！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"別被她迷惑——"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"——來不及了。"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"已經讓她跑了。"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"跑起來可也真的是快，趁著近衛局還沒穩定陣形，一瞬間就溜走了。"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":false,"text":"你也要小心你手上的東西，如果是炸彈的話......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......這個，倒是普通的行動電話沒錯......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"只是......莫非......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"——————"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"喂？"},{"type":"sceneBreak"},{"type":"narration","text":"————"},{"type":"background","backgroundId":"bg_1_call"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"你是......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"阿米婭......？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"米莎！告訴我你在哪！我——"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"阿米婭......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"少女的聲音","speakerId":null,"isRemote":false,"text":"......優先......處理重傷人員！！給他輸血！！快啊！！"},{"type":"dialogue","speakerName":"青年的聲音","speakerId":null,"isRemote":false,"text":"......可惡......為什麼......明明都是感染者......"},{"type":"dialogue","speakerName":"青年的聲音","speakerId":null,"isRemote":false,"text":"羅德島......這些傢伙為什麼會做這種事？！"},{"type":"dialogue","speakerName":"女性的聲音","speakerId":null,"isRemote":false,"text":"......我們從一開始就被他們遺棄了！！沒有出路的......沒有......！"},{"type":"dialogue","speakerName":"男孩的聲音","speakerId":null,"isRemote":false,"text":"別死！別死啊！我們說好，說好要一起回家的......！"},{"type":"dialogue","speakerName":"女孩的聲音","speakerId":null,"isRemote":false,"text":"......嗚......哥哥......不......"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_1_call"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"聽到了嗎，這些聲音......？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"是整合運動的感染者......嗎？"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"我想起來了。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"不，我一直忘不掉。我只是......不願想起。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"沒錯，是整合運動毀了我們的家，我爸爸也......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"但......這是我們，自作自受。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"當年，我眼睜睜地看著我的弟弟被拖走......他哭著叫我的名字，我卻轉過頭——"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"——躲進了自己的房間。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"當他又來找我的時候......他放棄了許多東西。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"他依然愛著我，我卻害怕了，逃跑了......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"但我明白。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"這一切只是要讓當時迫害他們的人，都嘗嘗感染者遭受的痛苦。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"如今我是感染者了。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"......也到了，我該償還自己罪孽的時候了。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"米莎，別做傻事！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"無論過去的人們怎麼對待感染者，只要你現在改變——"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"沒用的。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"我又能，改變得了什麼呢？"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"因為我，就是當年視而不見的人之一......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"成為感染者之後，我看得......更加清楚了。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"普通人是怎麼對待感染者的，感染者也會那樣去對待普通人。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"這是他們應得的。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"不......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"這一切，不過是我自己種下的殘忍種子所結的惡果......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"我理應受到這樣的折磨。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"但是，為什麼，為什麼——"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"他明明，什麼錯也沒有啊？！"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"他只不過是突然被發現是感染者而已......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"當時的他，才剛剛開始要我幫他寫作業啊！"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"如果我，如果那時候，保護了他的話......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"米莎！冷靜點！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"傷害無辜市民的並不是你！這些都不是你的錯！"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"在最開始，誰又不是無辜的呢？！！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"——"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"錯的，錯的就只有感染者這個身份而已......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"如果這只是互相報復的話，是誰，是誰導致了這悲劇呢......！"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"如果烏薩斯沒有把感染者當作可怕的牲畜一樣對待......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"又有誰會恨烏薩斯入骨呢！"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"為什麼感染者，就一定要遭遇這些折磨呢！！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"米莎......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"碎骨已經死了，你可以回到我們這裡，我們一定會......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"......阿米婭。我已經有了答案......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"我是一個感染者。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"我站在感染者這邊。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"不————"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"是的，阿米婭，你也是感染者......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"你應該能夠理解。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"是的，我也是......羅德島大家和我，都知道你的想法......我明白的。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"但是，米莎，僅僅是將自己從普通人置換到感染者的身份中，是什麼都不會改變的！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"請等等我，我立刻來找你！"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"別過來。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"——米莎！你在——"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"你說得對，阿米婭，你說得對......我只是愧疚而已。我只是......太過軟弱了而已。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"但我已經決定了。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"即使只有一步，我也要......踏出這一步。"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"對不起，阿米婭，對不起......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"整合運動是感染者......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"他們，也是感染者啊......"},{"type":"dialogue","speakerName":"米莎","speakerId":null,"isRemote":false,"text":"再見了......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"米莎？米莎？！米莎！！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["W","阿米婭"]},{"speakerId":"char_010_chen","aliases":["陳"]},{"speakerId":"char_136_hsguma","aliases":["星熊"]},{"speakerId":"char_1504_cqbw","aliases":["W"]}]}
