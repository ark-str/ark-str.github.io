{
  "server": "tw",
  "storyId": "main_7_level_main_07-07_end",
  "groupId": "main_7",
  "stageId": "main_07-07",
  "title": "沉默者之怒-2",
  "storyCode": "7-9",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_07-07_end.txt",
  "sourceHash": "97324d66e85b88754faad7483e6cb0b725c866a63fe5fe7427b89bf55d432816",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "切爾諾伯格倉庫  12:40  a.m."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "大量的倉庫和儲存設備......這裡應該是倉庫區。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "循著這條路，我們就可以直達中央區。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "阿米婭！過來看看。倉庫裡面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這是......啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "尖銳的刃形法術和打鬥痕跡。迅速解決了兩三個整合運動，都被丟在這邊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......還有氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "凱爾希醫生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嗯，拜託你和醫療幹員。這幾個整合運動也許有我們需要的資訊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這裡也能看到陳長官的痕跡......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是血跡。她受了傷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "在這裡，血跡在這裡有沉積，但只到這裡為止。她給自己止了血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "離開現場的只有一個人，只可能是陳長官了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......千萬要撐到我們來，陳長官......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "又要我們做這種事？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "怎麼感覺以前也發生過。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "哈哈......在切城時，嗯，也是這樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "只不過那時候，陳長官可以一人處理一支鬆散的整合運動小隊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但現在的形勢已經完全不同了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那時我們還只是單純的合作關係。我只是剛剛開始瞭解陳長官是怎樣的一個人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但這裡已經是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那是......平民？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅德島幹員",
          "text": "......哪裡出來的？我們居然沒找到他們的藏身處......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "這裡是烏薩斯人的墳場！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（保持戒備......但別攻擊！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們是中立的感染者查驗組織！女士，我們是本著為你們提供救助的原則進入這座城市的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "作為普通感染者，我們對你沒有敵意——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "感染者？呿，我是烏薩斯人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "救助感染者......？！哈，笑話......你們感染者對我們做了什麼，你們自己難道不清楚嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "女士，如果你感到不安全，我們就保持現在這個距離。二十米的距離。我們不會再移動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "不，不對，我也是感染者了。我罵不了你，是不是？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "你們還救助感染者？！呵呵，呵呵呵......所有感染者都該死！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "我也該死。我也該死！沒有感染者，我根本不會染病！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "想著害人，想著報復......感染者就是這樣嗎？！我也該這樣嗎？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "（阿米婭，安撫她，好嗎？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（不，現在不好。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（......讓她先發洩吧。一個月來所有的慘痛回憶都刺在她的意識裡。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（現在也是她......面對這些事，把這些事都拔出來的機會。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "你知道這裡有什麼嗎，感染者？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "和你一樣的感染者，活的感染者還有死的感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "因為整合運動只能在這裡苟延殘喘的感染者，因為整合運動死在這裡的無數感染者......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "但我們之前沒有人感染。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "切爾諾伯格的市民，被他們四處驅趕，四處找出來！最開始是屠殺，然後是折磨，最後是像丟垃圾一樣隨意處置活下來的人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "不知道多少人缺衣少食，死在這裡......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "活下來的，也因為不斷接觸源石，全都感染了！到現在，我已經沒看見任何還沒被感染者的人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "你們感染者......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "你們感染者！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "相信我們......不用帶我們去救治其他人。我們會把必要的醫療援助交給你們。之後，我們立刻就離開。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "我不信。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "烏薩斯感染者",
          "text": "你們是烏薩斯派的，還是龍門派來的？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "如果真的是他們，我們應該都已經死了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你是......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "阿米婭。掃一下他的識別碼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "醫生......？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Guard，解釋一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅德島近衛幹員？",
          "text": "許久不見，阿米婭，凱爾希醫生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅德島近衛幹員？",
          "text": "以及，Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
