  "blocks": [
    {
      "type": "narration",
      "text": "第十四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "進來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......凱爾希醫生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "——阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......{@nickname}。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你來了。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "咳咳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "魏長官，羅德島的另外兩位代表也到了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "哦，正好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "請坐。凱爾希小姐正向我說明現在的局勢呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "那我就繼續吧。關於現在的局勢，我想魏先生也已經很清楚了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "龍門的情報網每天都在蒐集大量針對整合運動的資訊，想必也對這件事情極為重視。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "不過僅憑這樣，龍門仍然還缺乏一些關鍵資訊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "簡單的感染者檢疫是不能對抗整合運動的，想必龍門近衛局再清楚不過。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "整合運動不會乖乖過檢，更不會等到當局反應過來才行動。所以————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "如果沒有羅德島的協助，龍門依靠目前對待感染者的策略，抵擋接下來整合運動的攻擊會面臨巨大損失。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "抱歉，我需要插一句。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "關於龍門的防衛情報，龍門近衛局方面比羅德島更瞭解。對於整合運動的滲透，也已經做了相應準備。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "只是龍門目前沒有將相關機密行動的方針通知羅德島的義務。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "凱爾希小姐，請繼續說。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "龍門的確有對付手無寸鐵的感染者的經驗，但恐怕龍門目前沒有面對集團化感染者暴徒的經驗，這可能會讓龍門造成不必要的損失。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "以羅德島目前的經驗來說————只有感染者，才能更好對抗感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "那麼，羅德島是否已經從針對整合運動的行動中獲得了有效的經驗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "僅僅是有而已，大概是不敢自稱專家的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "哦——？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "我聽說，羅德島曾捲入過切爾諾伯格事件，並且從中也獲得了不少整合運動的其他情報。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "無論魏先生是從哪裡得到這條消息的——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "這都不是現階段能與龍門交換的資訊。這只是履歷，只是站在這裡與魏先生交談的資格。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "決定是否要和你們進行利益交換的是龍門。如果這種程度的資訊羅德島都無法提供的話——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "龍門將無法信任你們的真實實力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "魏先生，我的言辭可能不夠清晰。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "不過需要強調的是——羅德島提供的資訊，本身就是用實力換來的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "但，無論怎樣，龍門都無法信任同樣是一群感染者的羅德島。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "如果陳小姐認為龍門的安危，尚不如對感染者進行盲目的懲罰來得重要————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "那我會立刻服從本地法令，任由陳小姐逮捕我，然後在監牢裡看著龍門被整合運動焚燒殆盡，默默惋惜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "這次，龍門別無選擇。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "——龍門既不是因為有人出言不遜就拒絕善意的城市——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "卻也不是收留無用說客的慈善機構。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "陳警官。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "魏長官，讓外來的感染者參與龍門的機密事務，我認為並不妥當。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "冷靜些，陳警官，他們是客人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "——我的客人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": ".....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "在他們違反龍門法律之前，我會容忍，長官。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "啊，不好意思。我想起來了，有這麼一句——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "——沒錯，呣......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "我所看重的就只有一點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "實力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "據我所知，羅德島也參與清剿了附近的感染者吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏彥吾",
          "text": "陳警官，以目前確切瞭解的情報，羅德島在軍事力量的實力如何？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......請容我簡要描述一下我所見的羅德島的行動情況。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "——詳情如下——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
