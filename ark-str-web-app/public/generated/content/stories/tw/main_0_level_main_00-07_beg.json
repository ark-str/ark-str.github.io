  "sourceHash": "9a0edab3063426c2cbb8a5d52912faa888eddb116195ef4213c1836f553b92d7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——天空越來越暗淡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "天際線仿佛被雲層捏住了一樣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "明明空氣很通透，烏雲卻靜止不動，好像在把各處的壓抑感通通抽出，凝聚在一處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "連風都停下了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "天災確實，即將降臨在這座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "看來，切爾諾伯格已經被整合運動徹底癱瘓了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "不過，哪怕是要拆分移動城市，也應該提前數周就完成準備工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "難道在那時候，整合運動就......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "不太現實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "現在的整合運動，並沒有體現出秘密接管所需要的精英部隊素質。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "整合運動的大多數成員......不過是在街頭遊蕩，向切爾諾伯格人尋仇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "僅僅是在各處重複著殺戮和戰鬥，使整個城市陷入戰火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "天災降臨時，就連無比堅固的切爾諾伯格都會被撕得粉碎——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "變成佈滿源石的巨型廢墟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "無論整合運動想要的是資源還是名望，都只會一敗塗地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "他們真能和烏薩斯軍方正面對抗嗎？即使烏薩斯的指揮系統陷入了混亂......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "烏薩斯的軍事力量，怎麼還沒有集結反攻？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "從我的經驗來說，一般暴亂發生後，不出片刻，暴徒就會被全副武裝的軍警清剿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "雖然，我們剛才也見證了一小撮軍警被整合運動圍攻的景象......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "那個蒙面的整合運動頭目，即使是有一點不同......但她也沒有能夠吞沒一城的水準。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "除非......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "除非什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "我以前經歷的戰爭中......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "也有行為與整合運動的掌控者如出一轍的領袖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "於他而言，士兵不過是棋子，達到目的後就可以隨意丟棄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "既合理高效地運用兵力，又在不需要的時候放縱其自生自滅......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "因為訓練與管理的成本太高了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "所以，他只是放養他們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "對。大多數時候，他只要把仇恨和恐慌當做口糧，餵養他們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "只需在必要時，輕輕地推一下——追隨者就會振臂高呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "如果整合運動的運作，真如他們宣傳的那般......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "穿上衣服，戴上標誌，所有的感染者都可以是整合運動？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "他們確實......將源源不斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "被壓迫、想要呼喊的感染者太多了。這時候，無論整合運動給出的是怎樣的出路......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "只要在鐵屋子上鑽個口，哪怕外面就是一片火海，裡面的人依然會互相推搡著探出身子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "Dr.{@nickname}.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這和你我不同。即使我還沒有完全信任你，但至少我信任你的能力。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "與你完全不同......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "這種領袖並不是指揮官。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "踐踏敵人，同時也踐踏同伴，又或者說，“隨從”，的生命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "也許連隨從都算不上，整合運動的暴徒，不過是領袖的棋子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "這樣的人，是暴君。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "無論敵人是誰，我們都會完成任務。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "以前有人訓導過我和我的隊友——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "“如果是棋子，那就吃掉；如果是堡壘，那就攻陷；如果是王權，那就推翻”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "Ace......稍等一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "Dr.{@nickname}，正前方，盤踞著敵人的輕裝甲部隊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們被發現了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "還沒有。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "但是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "我們避不開。這是這條路徑中的最短路線，如果我們迂回，就會損失時間。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "那沒什麼好說的了。無論他們是棋子還是暴徒，只要從戰場上趕出去就好！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
