      "type": "dialogue",
      "speakerName": "慌張的幹員",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "祥、祥子小姐！可以請你幫忙一下嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的幹員",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "醫療部新接收了一批病人，現在急需人手幫忙安置……"
