    {
      "type": "dialogue",
      "speakerName": "豐川祥子",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "在她去世前，我曾天真地以為，自己每天都能無憂無慮地生活。"
