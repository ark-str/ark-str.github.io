    {
      "type": "dialogue",
      "speakerName": "豐川祥子",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "沒關係啦，我自己簡單調整一下就好了……"
    },
    {
      "type": "sceneBreak"
    },
