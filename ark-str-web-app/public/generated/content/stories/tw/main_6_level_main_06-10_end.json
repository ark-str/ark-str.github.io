{
  "server": "tw",
  "storyId": "main_6_level_main_06-10_end",
  "groupId": "main_6",
  "stageId": "main_06-10",
  "title": "“這種事”",
  "storyCode": "6-11",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_06-10_end.txt",
  "sourceHash": "360aa04f30d4db445284e518168aff119cccc098300b5b392f1d5ae33ef4a37d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "（呃，呃......！哈，哈......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "（......中計了？！剛才的襲擊居然只是佯攻？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "（再讓她切分我的隊伍，整支大隊都會失去作戰能力......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "（不行，得立刻聯繫上他們才行！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "（可惡，為什麼我的手指不聽使喚？為什麼我在打冷顫！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "（不能......不能被她追上！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "嗚，咳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（低沉咆哮）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "紅，別殺她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "咳，咳......！咕！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是她嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "肯定沒錯。紅聞到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "（嗅嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "惡，假的。她不是狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "但氣味是真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "這個氣味，是真狼。是第一匹真狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "真狼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你這......該死的狼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "不要動。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "唔，怎麼會......？我竟然使不出力？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "居然......居然能壓制我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "她還想發力。是狼的技巧。她從狼那裡學過撕咬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "她想反擊。紅能刺穿她的脊髓，讓她癱瘓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "應該不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "等等，你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......是你。是你。我終於找到你......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "叛徒......叛徒！找到你了，叛徒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "伊利亞的女兒，柳德米拉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "閉嘴！你怎麼配說我父親的名字！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "整個研究所和所有的科學家，都被烏薩斯滅口了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你是這麼認為的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你還敢這麼說？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "就因為你，因為你這個卑鄙的叛徒和謝爾蓋一起出賣了我的父親，出賣了所有其他科學家！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你的髮色和你父親一模一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......你在說什麼？你為什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "別動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你想問，為什麼我沒對你的指控做出反應？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你這人渣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "人渣。你希望我是怎麼樣的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我是該膽小懦弱，貪圖錢財和安逸......還是說，我應該殘忍冷酷，為達目的不擇手段？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "現在的我，滿足你的想像了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "我沒想過......沒想過你是個徹頭徹尾沒心沒肺的冷血女人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你在殺謝爾蓋的時候，他是不是懺悔了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......你怎麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你知道他是亞歷克斯和米莎的父親？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "哼，哈哈哈......就是亞歷克斯帶我找到了他！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......整合運動吸納了亞歷克斯，殺死了他的父親，追捕他的姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "紅。給她一次機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......你要做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "給你一個殺掉我的機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "給我機會？你真知道自己說了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你想放棄生命？也想和那個靠出賣同事混到切爾諾伯格高層的謝爾蓋一樣，懺悔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......你當然會後悔。你會為自己的做過的一切後悔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "平常我都會說，“我從來沒有後悔過”......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "今天我卻可以坦然地告訴你，我有一件非常後悔的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "——但這和你父親的事情沒有任何關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......我要殺了你。我要殺了你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "嘶，哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "“吞下死難者的苦”......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "起霧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "是法術。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "霧......不，本質是煙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "利用口腔內的發煙器官，神經指令性應激發煙。的確是依賴感染器官的特殊化源石技藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "站在那裡說個不停......沒救的傢伙，你難道嚇得連怎麼表達恐慌都忘了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你為什麼要背叛我的父親？為什麼要背叛科學家們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "為什麼！告訴我為什麼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "“凱爾希所長”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "柳德米拉，我只是僥倖逃脫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你想我信你的鬼話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "呵。你的父親教你讀過《正當與正義》，對不對？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "給五歲的你看這本書......伊利亞也真是缺乏常識。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "他真的很喜歡這本書。那是盛夏的某天，他抱著你和書經過窗戶，灌木叢映著陽光的橘色。他讓你向我招手，你賭氣別過臉去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "夠了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "當天晚上他問我——如果我們封鎖了石棺，不把石棺內機械結構的存在透露給烏薩斯，能不能拯救更多人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "能不能阻止烏薩斯把這些機械運用在戰爭之中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你想用這些，這些......這些花言巧語干擾我？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "伊利亞是石棺封鎖行動的發起者之一，他信奉的理念影響了他一生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你繼承了你父親的鬥志，但你父親的身上不只有鬥志......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "柳德米拉，你認定我是背叛者，你想殺我。你可以這麼做。只不過——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "既然選擇了暴力這條路，就必定會面對比你更有力的事物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你可以再囂張一點。無論是什麼術師，都沒法看穿這片濃霧，也沒法分辨出我的位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "你會死的很慘。我一定，一定要你死得很慘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "......（吐舌聲）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "為了科學家們，為了感染者，我當然要殺了你，烏薩斯豢養的惡鬼，渣滓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我看起來像個術師？雖然我是感染者沒錯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "出來，mon3tr。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......啊？什麼......怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "怎，怎麼？你的脊椎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "看來你自己並不受迷霧影響。你看得到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "怎麼會......怎麼會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "嘔......！什麼，你是什麼，你......你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "那是什麼！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我不是術師。我從不依賴源石技藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "去，mon3tr。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（歡快的嘶鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "唔，呃呃呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "什麼東西！這是什麼東西！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "啊啊啊啊，鬆手，鬆手啊，放開我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "為什麼它的殼我刺不穿？咿！別碰我，別碰我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "湮滅她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......頭上的墜落物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（不滿的尖嘯）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你鬧太大了。樓要塌了，別讓她被砸死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（低聲嗡鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "殺了我吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......你明明能輕鬆地殺掉我！你難道也喜歡玩弄獵物？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "殺不掉你，我還活著做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "不過你記著，就算死了，我也會永遠詛咒你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......你真準備好受死了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你想死嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......呿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "如果我是背叛者呢？殺了我以後，你是不是會好受些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......不要......再說了！我會殺了你，我一定會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "伊利亞是我的學生，也是我的朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你父親是我帶過最好的研究員之一，他的無私和專注本可以將烏薩斯前推五年。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "別說了！為什麼要和我說這些，為什麼，我不想聽，我不關心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你想。因為你一直在懷疑自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你沒有給謝爾蓋解釋的機會，所以我替他說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "——我不會出賣任何人，哪怕是謝爾蓋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "謝爾蓋是個優柔寡斷的人，但他並不貪婪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "他剛出生的兒女被烏薩斯掌握在手裡，他為了拯救自己的親人，把你父親他們的行蹤告知了當局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "時至今日，米莎和亞歷克斯都死了。他出賣了秘密，卻誰也沒能保住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "如果......如果之前是我去救米莎，也許她和碎骨......都不會死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "不......不對，不對！你明明擁有這種力量，為什麼不救我父親？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（威脅的低鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "因為我做不到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我沒法說服你父親離開研究所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "柳德米拉，我在離開切爾諾伯格前把你送去了敘拉古，你卻自己回到了那座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你看，你就像你父親一樣，有時候，意志連時間都能戰勝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你總會回到切爾諾伯格，就像你會在這裡遇到我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "所以，這一切一點意義都沒有？我父親和我做的一切......都毫無意義？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "不。研究員們用他們的死保守了秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "烏薩斯至今都無法解析石棺內的裝置，他們放棄並封存了研究設施。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "現在，只有些微的能量被回收利用，用於驅動切爾諾伯格的核心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "“叛徒”，如果我真的配得上這個稱號，那我就是烏薩斯的叛國者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你父親的努力是有意義的。即使烏薩斯已經掩蓋了一切，你也還記得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我也會記得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "（哈欠）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......但你做的一切，又是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "烏薩斯清洗了整個研究所，屠殺了科學家天性裡稀少又珍貴的悲憫。真正的背叛者是貪得無厭的帝國本身。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "看看你現在的樣子，你殺了謝爾蓋，殺了一個連自己兒女都沒法保護的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "現在你來到了龍門，如果你和你的感染者同胞們真的奪下了這座城市，接下來你會怎麼對待它的普通市民？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "是殺光他們？是奴役他們？又或者是把他們趕到荒野裡，讓他們自生自滅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弑君者",
      "text": "......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "讓他們全部感染上礦石病，成為感染者，把你們的痛苦傳播給他們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......還是說，你會和他們和平共處？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "你們能嗎？柳德米拉，現在的整合運動能嗎？你是想用這樣的方式建立感染者的國家，還是說你想用這種方式去對抗烏薩斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "如果你想去對抗烏薩斯，為什麼要來龍門？想用恐怖對抗敵人，你該怎麼做才能比烏薩斯更恐怖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "（凱爾希，她在疑惑。她很害怕，她想逃跑。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "Mon3tr，回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "這樣好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "她能聽得見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "“弑君者”，整合運動的仇恨與你的仇恨，已經被人玩弄在股掌之間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "想一想你的父親，想想伊利亞他對你的教育吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "想一想，你究竟想向誰復仇？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "引你走上這條用刺殺與恐怖鋪成的道路......你的領袖並不是什麼心性正常的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "真正理想主義的人，不會放任別人為自己而死，更不會讓別人代自己行兇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "離開這裡。走吧，離開這裡，換一條路走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "去換一條真正能改變這片大地的路......如果你真的想的話。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "她的氣味消失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "凱爾希是不是一直想見她？現在為什麼不殺她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我們該不該殺死一條沒家的鬣狗，即使這個家是虛假的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "問題好難。紅不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "那麼，紅，她會為殺了我這件事感到喜悅嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "不會。她現在也很痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我們不代表法律，也無權審判別人。我們有能力去殺害別人，卻沒有任何權力宣稱殺戮是正確的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "如果她對謀殺感到興奮與快樂，我會立刻殺死她。我一定會這麼選。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅知道。她不開心，她的呼吸很亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "現在的她會成為一株病毒毒株，在狂熱的切爾諾伯格感染者中散佈“不安”這種病毒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......一個人能活多少年歲，又能走過多少路？我們被蒙蔽的時間，總比我們看清事實的時候更多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "何況認清事實和做出選擇又是另外兩回事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "在她從集體復仇心理中清醒過來的那天，她會離開整合運動。即使如此，謝爾蓋的血，切爾諾伯格人的血，永遠在她指縫間流淌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "紅......做出選擇以後，就沒辦法再回頭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅明白。紅會努力，只殺狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "好孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "那種味道你記下了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅記下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "是什麼樣的味道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "......不討厭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "雖然有血腥味，但不是凱爾希你剛才說的那種，什麼心性什麼常的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "真傻，塔露拉是德拉克人，狼怎麼會是她呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "唔唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "走嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "嗯，走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "......氣溫下降了。時間很緊迫，是時候提高效率了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
