  "stageId": "act18d0_01",
  "title": "赤角小鎮之圍",
  "storyCode": "WD-1",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act18d0/level_act18d0_01_beg.txt",
