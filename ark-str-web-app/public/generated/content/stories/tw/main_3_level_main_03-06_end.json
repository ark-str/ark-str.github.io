{"server":"tw","storyId":"main_3_level_main_03-06_end","groupId":"main_3","stageId":"main_03-06","title":"決定","storyCode":"3-6","avgTag":"行動後","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_03-06_end.txt","sourceHash":"c6b0cb89a53dac9d4b2ce98e4fa99f087df36b47835357f89e29ae1311b4eeb6","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二十八关（后）"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"不......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"不可能！不可能......！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"怎，怎麼會這樣！碎骨，碎骨！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"別，別讓米莎看見，這......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"快讓那幾個懂急救的過來！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"可惡，梅菲斯特為什麼不肯來，他在幹什麼！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"說什麼另有計劃......究竟在搞什麼鬼！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"如果有他在的話，我們能救回很多人啊！"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"指望那個不重視同伴的傢伙，有點不太現實吧。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"沒辦法的事情，別太自責。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"謝謝你掩護我們，W......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"至少，我們把他帶回來了。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"感謝要用實際行動哦。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"當然。我們會掩護你撤退......只是，有一個請求——"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"請一定保護好米莎。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"那是當然，畢竟——"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"畢竟我還有利用價值，是嗎？"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"......我們......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......讓我和碎骨單獨待會兒吧。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我來......照顧他。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"可是......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"............"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"......好。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"W，說好了。你一定要做到。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"好的好的~"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我說的是—————"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"讓我和碎骨單獨待會兒。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"可是你該走了。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"過不了多久，龍門和羅德島就會攻進來。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"這些殿後的整合運動也會死去吧。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"啊呀啊呀，真麻煩。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"米莎，因為你，會有那麼多人死去......"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"真遺憾呢。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"你開始讓我感到厭煩了，W。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"你是沒法從我這裡得到任何東西的。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"哇哇，好可怕~"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"那隻小兔子，還挺在乎你的呢？"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"不過那個龍門的陳長官可就不一樣了。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"她可不會對任何人手下留情哦。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"也許她會為了利用你而留你一條命——"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"但那之後會發生什麼事，你在烏薩斯也看的夠多了吧？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"現在和我走，還來得及。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"儘管——要放著這些整合運動自生自滅......"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"他們的下場，大概已經定下了吧。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"真的很可憐哦。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"對了對了。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"雖然你目睹了全過程——"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"但是，唉，不好意思，我可沒有餘力把碎骨帶回切爾諾伯——"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"住口！"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"我只是說了實話。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"畢竟這裡已經毫無希望了呢~"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"想清楚以後，就早點告訴我哦？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"不。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我一定會......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"讓碎骨活過來。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"碎骨不會死......碎骨是不會死的。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"如果是他，他一定會保護大家......保護所有人。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"如果是他的話，一定會的。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"大家都和我一樣，大家都是感染者。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我也是......感染者。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我們已經無處可去了......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"大家都是......需要被保護的人。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"碎骨的......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我必須......"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_012_misa","aliases":["米莎"]},{"speakerId":"char_1002_nsabr","aliases":["整合運動成員"]},{"speakerId":"char_1504_cqbw","aliases":["W"]}]}
