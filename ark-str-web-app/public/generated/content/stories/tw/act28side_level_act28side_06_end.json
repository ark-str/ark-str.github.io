{
  "server": "tw",
  "storyId": "act28side_level_act28side_06_end",
  "groupId": "act28side",
  "stageId": "act28side_06",
  "title": "獵人之夜",
  "storyCode": "CV-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act28side/level_act28side_06_end.txt",
  "sourceHash": "f356ddc497eb9f29d119228076f6f5bda75ba47c953defc37f691eedec7a4efe",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "訪談嘉賓",
      "text": "廣袤的拓荒區還潛藏著相當的發展潛力，我們衷心歡迎那些才華得不到施展的公民前往拓荒區。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訪談嘉賓",
      "text": "而對那些堅守自己家鄉的人，我們也為他們準備了地塊再開發計劃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "地塊再開發計劃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訪談嘉賓",
      "text": "對於一些產業落後的地塊，我們制定了令其煥然一新的再開發計劃。州政府吸引的高科技企業將利用這些寶貴的地塊發展高新產業。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "令人振奮的消息！我想這些地塊的居民已經迫不及待要見證光明的未來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訪談嘉賓",
      "text": "州政府已經為數個地塊制定了再開發計劃，例如貝斯伍德鎮、戴德霍斯鎮、達維鎮……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "不知道這些地塊上有沒有我們的觀眾呢？這對他們來說應該是新年的第一個好消息！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "克里夫先生，一想到此時能有機會親眼目睹巴倫基地的壯觀，我的心情就很激動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "您太客氣了……和貴行這樣的企業合作才是我們的幸運。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "哈哈，克里夫先生，如果可能的話，有些在拓荒地的業務，我們依然想要繼續雙方的合作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "這也正是我們的想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "和您談話的過程總是很愉快，希望這種狀態能一直保持下去。畢竟拖拽也是個漫長的過程，直到春天徹底雪融，我們才能互道分別。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "那可真的是太短暫了，我會為此感到遺憾——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "克里夫先生！克里夫先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "克里夫先生，請開開門，我有很緊急的事情要向你匯報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "如果您有任何合作上的需要，可以隨時聯繫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "開開門，求你了，事情真的很緊急！克里夫先生！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "……看來您有些要緊事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "請您稍等。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "潔西卡，你來做什麼？誰讓你在我門口大吼大叫的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "抱歉，克里夫先生，潔西卡小姐要匯報的事情的確緊急。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "那就快說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "那位先生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "克里夫先生，請問我可以借用一下您的洗手間嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "請用。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "到底出了什麼事，要你來敲我的門？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "銀行拿著州政府的授權書，要求我們對人群動手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "那你們動手了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "至少在我離開時還沒有，現在的情況我、我不知……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "不……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "不，我們不會動手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "好，我知道了，出去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "那些居民要怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "這和你沒有關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "但您至少可以……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "如果你聽不懂，我可以再說得更明確一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "這和你、和我，都沒有關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "是嗎……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "那什麼與您有關係呢……銀行回報給您的高額酬勞，軍方額外賦予您的特殊權力？還是肆意將別人踩在腳下時，給您的那種……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "高人一等的快感？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "克里夫眯起眼睛，上下打量著眼前突然有些陌生的傭兵。"
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "我九十多歲了，不會那麼輕易就感到快樂，潔西卡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "那為什麼呢……與那些人為伍您能得到什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "我很難不為此感到疑惑，在我看來……您為了得到那些，幾乎喪失了一切人性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "人性……這詞對我來說是有些遙遠了。作為黑鋼這家傭兵公司的老闆，那些美好的詞彙有什麼用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "反倒是你，潔西卡小姐，如果你那樣看重這些品質……那你來黑鋼做什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "我記得你父親曾經和我講過，你留在這裡是想解決一些問題，保護一些東西……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "既然如此，你為什麼不去做警察、法官或者治安官？再不行入伍也可以，做個士兵保家衛國不好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "可你選擇了做傭兵，你選擇了一份用武力換取金錢的工作，一份伴隨著殺戮與暴力的工作，一份稱不上光彩也得不了榮譽的工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "你也不缺錢，潔西卡，那你到底是為了什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "如果你沒想清楚，我可以作為過來人，給你一個答案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "野心……為了我自己的野心，為了證明我自己不比哥哥姐姐差，為了證明我不是家族裡的……平庸之輩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "所以我來到了這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "不錯，非常清醒的自我認知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "所以不要站在這裡指責我做生意的方式了，你的父親也是位優秀的生意人，你作為他的孩子，應該向他多學學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "成熟些，理智些，少感情用事些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "讓她離開，秘書，以後但凡是她來找我，恕不接待。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "……幾十年前你坐視朋友被俘虜，幾十年後你坐視一群人被趕出自己的家園。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "如果這是你口中所謂的成熟的、理智的、不感情用事的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "那我寧願一輩子幼稚……一輩子只是平庸的傻瓜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘書",
      "text": "潔西卡小姐，現在請你離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "潔西卡",
      "text": "別動我……我會自己走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "看來您的事務已經處理好了，克里夫先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "沒錯，行長先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "不過，我剛剛聽說了個消息，一個很不好很不好的消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "你的屬下，在銀行門口，給我的屬下，下達了開火的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "未經請示，未經許可。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "這有什麼不對嗎，克里夫先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "我們有政府的授權，那支小隊又是您派給我們的，在事態緊急，需要強硬處理的時候，我想，一些詳細手段沒必要一一向您匯報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "您放心，我們的人有分寸。但情況緊急，我們也肯定是將自己的需求放在首位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "行長先生，你沒明白我在說什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "這消息很不好，不是對我來講，而是對於你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行行長",
      "text": "您……您在開玩笑。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“橋夾”克里夫",
      "text": "沒有誰能越過我去指揮我的人，如果你還想我們以後能和睦相處的話，這句話我希望你能牢牢記住。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "銀行經理",
      "text": "那一疊文件你分類好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "我正在看……馬上、馬上就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "那個……我剛剛看到了一份股份質押文件，明明里昂·特雷門的股份是不久前才賣掉的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "但是這份為他準備的空白合約卻出現在十幾年前的一堆文件裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "而且，這樣的文件不止一份，很多都放錯了……上面也沒人簽字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行經理",
      "text": "不是放錯了，它們是提早準備好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "可十幾年前……有很多人甚至都還沒踏入過銀行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行經理",
      "text": "西爾維婭，我們有一套專業的精算系統，一點貸款利息我們可不會放在眼裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行經理",
      "text": "我們的目標是這裡的所有，一直以來都未曾改變。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "這、這和當時說的不、不一樣……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行經理",
      "text": "也是，你離我們的核心業務是有點遠，不知道很正常，你應該更上進一點的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行經理",
      "text": "不過現在我想……機會擺在面前，你應該沒有不珍惜的道理。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "伍迪……你去哪裡了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "你的胳膊怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "當了出頭鳥……最後挨教訓了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "海倫娜，如果……我要離開這裡，你會和我一起走嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "……那傢伙和你說什麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "沒說什麼……那些對話只不過再一次證明他依然是個面目可憎的混蛋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "但你當年卻為了那樣一個混蛋義無反顧離開拉特蘭，踏上哥倫比亞的土地，加入一場幾乎讓自己失去一切的戰爭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "海倫娜，他描繪給我的理想太誘人了……成為英雄，帶領人們結束戰爭，在拉特蘭之外建立一片全新的樂土。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "何況，在一群腦袋混沌的青少年裡，那傢伙總是意志堅定，思緒清晰，難免會讓人想要追隨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "伍迪……我明白，我都明白，我並不是說你是受騙了還是怎麼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "我只是想說，你並不需要為自己的過去而感到羞恥，無論你的旅途因何而始，最終都將你導向了如今。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "伍迪，那些錯誤鑄成了現在的你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "偶爾可以回頭看看，但不要後悔，千萬不要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "海倫娜……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "想不想跳支舞，伍迪，我可以教你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "在我十八歲的時候，一個傻乎乎的傢伙教會了我舞步，那傢伙是個徹頭徹尾的傻瓜，卻不妨礙我愛這支舞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "其實，我會跳舞……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "嗯……我怎麼一直都不知道？你什麼時候學的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "……很年輕的時候，我沒有告訴過你，你當然不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "在哪學的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "……在回宿舍的路上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海倫娜",
      "text": "那你想跳一支嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "……請吧，女士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "剛剛接到撤離通知時，你為什麼不走？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "一次違抗是違抗，兩次也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "嘖……逞什麼能，連後來的那些小隊都知道，你是為了保證他們不對人群做出格的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "額頭還痛嗎？沒想到我們的同事對人群倒還好，對自己人真是一點情面也不留。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我沒事，只是小傷口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "說到底也是我們抗命在先……我也不知道自己能做什麼，那就做些最基礎的事，保證每個人的安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "你已經做得很好了，優等生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "……對了，我今天一直想和你說的，但是沒顧上……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "新年快樂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "讓我看下錶……很遺憾，十二點已經過了，芙蘭卡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "又有什麼關係呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "確實沒關係，我大概只是不爽你搶先說了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "新年快樂。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "厚重的鐵門緊緊闔起，機關彈動，發出沉悶的碰撞聲，隔絕了從門後揮發出的油墨味。\n那是一種令人如痴如醉的味道。\n嗅到它，人們便會產生美妙的錯覺，一切渴望將唾手可得，一切遺憾能彌合補償。"
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "你想要的……到底是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "而你又在為了什麼……而感到遺憾呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "……西爾維婭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "期末又是第一……哎呀，我是怎麼生出你這樣聰明的孩子的，西拉，我真是太為你驕傲了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "真的嗎，西拉？那可是哥倫比亞最好的金融系啊……天吶，我的女兒居然考上了！西拉，我為你自豪，說多少遍都不夠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "西拉，你確定你要回家鄉的銀行工作嗎？你知道……媽媽不想因為自己的身份影響你的選擇，尤其是在這樣重要的事上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "……我為你驕傲，我的孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "咳咳……咳咳，西拉……離開那裡吧，你可以找到別的工作的……媽媽……媽媽沒關係的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "無論，無論你做什麼……媽媽，都會為你驕傲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "就算……生命的盡頭，也是……一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的聲音",
      "text": "永遠……永遠為你驕傲。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "媽媽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "西爾維婭",
      "text": "我……我希望，你能永遠為我驕傲。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "那是一種極具魔力的氣味，能將時間撥亂。\n在它的包圍中，稚嫩的嬰兒拿起了幾十年後才能放飛的風箏，垂垂老矣的人看見了三歲時朝思暮想的蜜糖。\n沒人，能拒絕它的誘惑。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
