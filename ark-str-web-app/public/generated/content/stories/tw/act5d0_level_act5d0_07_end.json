{"server":"tw","storyId":"act5d0_level_act5d0_07_end","groupId":"act5d0","stageId":"act5d0_07","title":"11:08P.M.","storyCode":"CB-7","avgTag":"行動後","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/activities/act5d0/level_act5d0_07_end.txt","sourceHash":"74584ec4dd0d82b4175088d78e1c8c123e4e50b99e1f88ffbfd18a6b2098913d","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二关（后）"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_lmstreet_2"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"哈啊，哈啊......"},{"type":"dialogue","speakerName":"卡彭","speakerId":"avg_npc_027","isRemote":false,"text":"再來啊，企鵝物流！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"你們這不是關係挺好的嗎？"},{"type":"dialogue","speakerName":"卡彭","speakerId":"avg_npc_027","isRemote":false,"text":"嘁！"},{"type":"dialogue","speakerName":"可頌","speakerId":"char_201_moeshd","isRemote":false,"text":"幹嘛要衝著我來！？吃我一錘！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"呃！你到底是幫哪邊的！？"},{"type":"dialogue","speakerName":"黑幫","speakerId":"avg_npc_031","isRemote":false,"text":"不、不是我動的手！是那個天使！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"誒嘿，打歪了，也沒差啦。"},{"type":"dialogue","speakerName":"黑幫A","speakerId":"avg_npc_031","isRemote":false,"text":"趁現在——危險！你往我這兒砍做什麼！？"},{"type":"dialogue","speakerName":"黑幫B","speakerId":"avg_npc_031","isRemote":false,"text":"對不起，我還是覺得應該忠於首領！！"},{"type":"dialogue","speakerName":"黑幫A","speakerId":"avg_npc_031","isRemote":false,"text":"但我也是啊！"},{"type":"dialogue","speakerName":"黑幫B","speakerId":"avg_npc_031","isRemote":false,"text":"呃。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"都躺地上幹什麼？沒死的都爬起來！"},{"type":"dialogue","speakerName":"黑幫","speakerId":"avg_npc_031","isRemote":false,"text":"是、是！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"這麼勉強部下可不好哦，有醫療補貼嗎？"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"......有點混亂，但總之把穿黑衣服的全部打趴下就行了吧？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"真是亂成一鍋粥啊。"},{"type":"dialogue","speakerName":"拜松","speakerId":"char_325_bison","isRemote":false,"text":"是啊——欸！？莫斯提馬小姐？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"但是看你們還挺有活力的。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"......你什麼時候來的？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"老闆喊我來的嘛。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"卡彭","speakerId":"avg_npc_027","isRemote":false,"text":"嘁，是那個奇怪的薩科塔人。"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"給我滾開！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"好了好了，冷靜一點。"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"在這裡打贏了又能有什麼結果？各退一步吧。"},{"type":"dialogue","speakerName":"黑幫A","speakerId":"avg_npc_031","isRemote":false,"text":"她把首領給擋住了！？"},{"type":"dialogue","speakerName":"黑幫B","speakerId":"avg_npc_031","isRemote":false,"text":"不對！那是法杖！首領小心！她是個術師！"},{"type":"dialogue","speakerName":"卡彭","speakerId":"avg_npc_027","isRemote":false,"text":"......看來沒有和她正面作戰是正確的選擇......喂，先不要靠近他們！"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"......我從沒見過你這樣的薩科塔，不，你是薩卡茲？你到底是什麼？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"普通的信使啊，不然呢？"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"故弄玄虛！"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"該死——"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"中場休息一下......你們大概是不會聽的吧。"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"你在小看我！？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"avg_npc_028","isRemote":false,"text":"別來無恙，各位，上次見面是多久以前了？"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"你在看哪裡！？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"可頌","speakerId":"char_201_moeshd","isRemote":false,"text":"有個幾年了？還是幾個月？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"黑幫","speakerId":"avg_npc_031","isRemote":false,"text":"咕呃！"},{"type":"dialogue","speakerName":"空","speakerId":"char_101_sora","isRemote":false,"text":"日子過得太充實，就會讓人忘記時間呢。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"......差不多四年零三個月哦，莫斯提馬。"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"嗯，那還真是好久不見。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"別擺出那種表情嘛，你有那麼一點點嚴肅我都會覺得你生病了的。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"不是感人的重逢嗎！？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"感人與否先不論，但現在不是時候敘舊呢。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"你真的打算在這裡動手嗎？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"只是適當運動一下。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"......那好吧，記得手下留情。"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"沒問題。"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"而且，還有另一位客人在等著我呢。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"——？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"空","speakerId":"char_101_sora","isRemote":false,"text":"無論看幾次都覺得，莫斯提馬小姐輕描淡寫地揮舞法杖，結果總是會很誇張呢。"},{"type":"dialogue","speakerName":"可頌","speakerId":"char_201_moeshd","isRemote":false,"text":"那些黑手黨已經嚇傻了耶。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"嘿咻，是不是該趁現在多敲暈兩個？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"怎麼了？不繼續了嗎？"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"......也許你的確有些實力，但我發誓不會讓你輕鬆離開。"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"別總是這麼殺氣騰騰的，就當是飯後運動吧——唔。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"黑幫","speakerId":"avg_npc_031","isRemote":false,"text":"怎、怎麼了，剛才這些火焰是不是凝固了？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"......看來伊斯正好路過這附近，還是速戰速決吧。"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"你在自言自語些什麼？面對我！"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"你變得越來越焦躁了，作為一名家族領袖，這樣可不利於控制戰局。"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"嘁！你那副遊刃有餘的樣子真是讓人惱火！"},{"type":"dialogue","speakerName":"黑幫","speakerId":"avg_npc_031","isRemote":false,"text":"法術！快躲開！"},{"type":"dialogue","speakerName":"黑幫","speakerId":"avg_npc_031","isRemote":false,"text":"別去幫倒忙了，我們去對付企鵝物流就行！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"......我們好像被小看了，讓他們見識見識吧。"},{"type":"dialogue","speakerName":"可頌","speakerId":"char_201_moeshd","isRemote":false,"text":"得令！嘿——！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"拜松","speakerId":"char_325_bison","isRemote":false,"text":"這就是信使，莫斯提馬......"},{"type":"dialogue","speakerName":"拜松","speakerId":"char_325_bison","isRemote":false,"text":"信使......外面的信使都是這樣的嗎？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"拜松","speakerId":"char_325_bison","isRemote":false,"text":"——起風了？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"——風？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"德克薩斯，撤退，快！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"——明白！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"黑幫","speakerId":"avg_npc_031","isRemote":false,"text":"喂！怎麼開始地震了！？那個術師做了什麼？"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"真是，老年人總是這麼心急。"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"別想跑——"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"呃——"},{"type":"dialogue","speakerName":"卡彭","speakerId":"avg_npc_027","isRemote":false,"text":"嘁，這是法術，先撤退！"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"沙塵暴？在這裡？"},{"type":"dialogue","speakerName":"可頌","speakerId":"char_201_moeshd","isRemote":false,"text":"情況是不是有點不太妙！？"},{"type":"dialogue","speakerName":"空","speakerId":"char_101_sora","isRemote":false,"text":"德克薩斯！這邊是出口！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"拜松和莫斯提馬人呢？唔！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"他們被沙暴隔開了，我去一趟！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"等等，能天使！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"真是的，每次和莫斯提馬有關，這傢伙就頭腦發熱。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"拜松","speakerId":"char_325_bison","isRemote":false,"text":"德克薩斯！莫斯提馬！你們在哪兒！？"},{"type":"dialogue","speakerName":"拜松","speakerId":"char_325_bison","isRemote":false,"text":"啊，眼睛裡進了沙子——"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"不要慌。"},{"type":"dialogue","speakerName":"拜松","speakerId":"char_325_bison","isRemote":false,"text":"莫斯提馬小姐！"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"遮住風沙，跟著我走就好。"},{"type":"dialogue","speakerName":"莫斯提馬","speakerId":"char_213_mostma","isRemote":false,"text":"......話說回來，這麼近距離感受一番，的確是一位不該隨便招惹的老先生呢。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"黑幫A","speakerId":"avg_npc_031","isRemote":false,"text":"地面、地面塌陷了！是流沙，後退！不要被捲進去！"},{"type":"dialogue","speakerName":"黑幫B","speakerId":"avg_npc_031","isRemote":false,"text":"首領！請下指示！"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"其他人呢！卡彭呢！？"},{"type":"dialogue","speakerName":"黑幫A","speakerId":"avg_npc_031","isRemote":false,"text":"趁著沙塵暴離開了，有一些我們的人混在他們的隊伍裡......"},{"type":"dialogue","speakerName":"黑幫B","speakerId":"avg_npc_031","isRemote":false,"text":"首領！這裡也要塌了！"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"......走，我們還有機會。"},{"type":"dialogue","speakerName":"甘比諾","speakerId":"avg_npc_028","isRemote":false,"text":"該死！到底發生了什麼！？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"鼠王","speakerId":"avg_npc_034","isRemote":false,"text":"機會，機會......啊......"},{"type":"dialogue","speakerName":"鼠王","speakerId":"avg_npc_034","isRemote":false,"text":"奇怪......我怎麼不記得，你們剩下什麼機會？"},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[{"speakerId":"char_101_sora","aliases":["空"]},{"speakerId":"char_102_texas","aliases":["德克薩斯"]},{"speakerId":"char_103_angel","aliases":["能天使"]},{"speakerId":"char_201_moeshd","aliases":["可頌"]},{"speakerId":"char_213_mostma","aliases":["莫斯提馬"]},{"speakerId":"char_325_bison","aliases":["拜松"]}]}
