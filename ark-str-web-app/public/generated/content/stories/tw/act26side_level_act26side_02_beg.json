{
  "server": "tw",
  "storyId": "act26side_level_act26side_02_beg",
  "groupId": "act26side",
  "stageId": "act26side_02",
  "title": "生命運河",
  "storyCode": "HE-2",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/activities/act26side/level_act26side_02_beg.txt",
  "sourceHash": "441e1a41299a6d9ab650cebea572b28c3db246a69adeefd162f1c4464574e91b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "在一個很遠很遠的地方，有一個小村莊，那裡生活著一群幸福的村民。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "他們中的一些人為大家建起遮風避雨的小屋，並開墾出農田。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "另一些人則外出打獵，尋找礦石，順便還打跑那些想要將村子占為己有的壞蛋。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "這些村民不分你我，誰都離不開誰，他們共同生活在小小的村莊中，都認為這裡是自己的家園。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "但是好景不長，農田裡的作物逐漸減產，打獵也越來越艱難，可以吃的食物越來越少，大家都餓得肚子咕咕叫。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "天氣也變得越來越冷，可是能用來取暖的燃料卻怎麼也不夠分......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "這可怎麼辦才好呀！大家都說，“這一定是主給予我們的磨練，我們必須祈求寬恕！”"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "就在這時候，一群好心人來到這裡，見到村莊中的情況，就同領頭的村民說......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "“來吧，你們可以來我們的城市生活。”"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "“但是，我們只能帶走你們之中和我們更相似的那一部分人。”"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "“來吧，來過更好的生活，只要拋下你們之中的一小部分人就可以了......”"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": "avg_npc_928_1",
      "text": "阿爾圖羅姐姐，不要講這個故事！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "嗯？你們不喜歡這個故事嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": "avg_npc_928_1",
      "text": "不喜歡！餓肚子，會很難受......！"
    },
    {
      "type": "dialogue",
      "speakerName": "害羞的孩子",
      "speakerId": "avg_npc_929_1",
      "text": "嗯，很難受。而且，不可以丟下其他人......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "這確實是很“正確”的集體主義觀念，或許還帶有英雄主義......甚至浪漫主義的色彩。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "浪漫的故事自然有其動人之處，只是，浪漫與傲慢有時也會迷惑他人，以及我們自身。"
    },
    {
      "type": "dialogue",
      "speakerName": "害羞的孩子",
      "speakerId": "avg_npc_929_1",
      "text": "唔，好難，聽不懂......"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": "avg_npc_928_1",
      "text": "阿爾圖羅姐姐又說奇怪的話了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "哎呀，對不起，是姐姐不好。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "我們換一個故事。你們想聽什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": "avg_npc_928_1",
      "text": "想聽......英雄的故事！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "你們想當大英雄嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "害羞的孩子&活潑的孩子",
      "speakerId": "avg_npc_928_1",
      "text": "當大英雄！和媽媽一樣！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "好厲害，你們的媽媽真了不起！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "好孩子們，稍微等我一下。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫和的教士",
      "speakerId": "avg_npc_941_1",
      "text": "我好像來得不是時候。打擾到你了嗎，阿爾圖羅？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "明知故問，奧盧斯閣下。"
    },
    {
      "type": "dialogue",
      "speakerName": "奧盧斯",
      "speakerId": "avg_npc_941_1",
      "text": "請你原諒。無意惹你不快，我是來向你辭行的。"
    },
    {
      "type": "dialogue",
      "speakerName": "奧盧斯",
      "speakerId": "avg_npc_941_1",
      "text": "因為多了一位計劃外的旅伴，我準備儘快啟程，護送我的同胞回到家鄉。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "我會為這位可悲的人稍作祈禱。"
    },
    {
      "type": "dialogue",
      "speakerName": "奧盧斯",
      "speakerId": "avg_npc_941_1",
      "text": "我無意在這裡與你爭執......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奧盧斯",
      "speakerId": "avg_npc_941_1",
      "text": "......尤其是在這兩個孩子面前。"
    },
    {
      "type": "dialogue",
      "speakerName": "奧盧斯",
      "speakerId": "avg_npc_941_1",
      "text": "不過，任何與生命相關的決心都不應用“可悲”來形容。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "決心......決心。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "我們對自己的控制，往往並沒有我們自己想的那樣完美無缺，在事情真正發生之前，誰也無法斷言。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "想著絕不能做的事，有時回過神來，就已經那麼去做了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "責怪行動偏離內心嗎？可又有誰能斷言，我們自以為的決心，不是自己用來說服自己的某種謊言？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "這樣的時候，我們最真實的情感與意圖究竟藏在何處......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "人們的思想、情感、行動，什麼時候才會有真正統一的一天？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "這不正是你的疑問嗎，閣下？"
    },
    {
      "type": "dialogue",
      "speakerName": "奧盧斯",
      "speakerId": "avg_npc_941_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "今天似乎是會發生很多事情的一天，我聽到外面很吵鬧，像是有我認識的客人上門。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "如果我是你，奧盧斯閣下，在如今這樣的時刻就不會急著離開。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "久等了。"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": "avg_npc_928_1",
      "text": "姐姐好慢！"
    },
    {
      "type": "dialogue",
      "speakerName": "害羞的孩子",
      "speakerId": "avg_npc_929_1",
      "text": "好慢......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "原諒我吧。作為賠禮，我再給你們講一個特別精彩的故事，怎麼樣？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "你們想聽英雄大戰壞蛋的故事嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "害羞的孩子&活潑的孩子",
      "speakerId": "avg_npc_928_1",
      "text": "想！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "好，那你們要好好地聽哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "speakerId": "avg_npc_490_1",
      "text": "很久很久以前，在一座城堡裡，住著一個沒什麼表情，也不愛說話，但是打起架來十分兇狠的小男孩......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "如果我是個獵戶這樣的說法無法讓你接受，那換一種也可以。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我只是個普通的，有點上了年紀的薩卡茲。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "我不認為這是全部事實。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "你隨身帶著武器，就在身後。你在行動中有意遮掩，這是雇傭兵的習慣。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......防身罷了。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "你們之前也看到了，那些強盜時不時就會前來騷擾，這裡並不是一直都那麼太平。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "你沒有就雇傭兵的習慣給出解釋。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "現在你看到的這雙手，握著農具的時間比握著武器的時間要多。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我在這裡靠打獵為生，我會下田種地，有必要時也充當礦工。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "這不是一雙值得你警惕的雙手。我只是個為生活所困的普通人。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "費德里科，想想我們的首要任務。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "我認為現在不是追究一個可能性的時候。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "......合理的判斷。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "現在可以說明一下情況了嗎，主教閣下？"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "抱歉，斯特凡諾。給你添麻煩了。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......不，你沒有需要道歉之處，杰拉爾德。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "就像兩位看到的這樣......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "在十餘年前，杰拉爾德帶著一小群薩卡茲來到修道院附近，他們那時候已經彈盡糧絕，在荒野上迷失了方向。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "在發現修道院之後，嘗試與我們接觸幾乎是他們唯一的選擇......"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "你們並未驅逐他們，於是他們選擇在此定居。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "驅逐一群走投無路的人，與把他們逼上絕路有何區別？"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "呃，那倒也是......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "起初，並非所有人都能夠接受這樣的一群鄰居。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "可那些無根的仇恨與隔閡，在生活面前實在不值一提......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "我們為這些人提供一處安身之所，他們反過來幫助我們處理那些我們亟待解決的問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "短缺的食物、來自強盜的威脅，還有逐漸耗盡的能源......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "他們依靠我們，我們也依賴他們。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "但你們還是選擇派出信使聯繫拉特蘭。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "這是別無選擇的選擇......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "拉特蘭願意為我們提供援助，也願意接納我們回歸拉特蘭本土。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "只是，就算是願意給出最大程度讓步的蕾繆安特使，也提出了一個絕不容動搖的條件——"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "“樂園不容薩卡茲。”"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "為何不容？！"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "只因種族？只因他們是薩卡茲？！"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "他們與我們有什麼不同？如果沒有這些善戰的兄弟姐妹，我們早就難以為繼！"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "在我們相互扶持著活下去的那些歲月裡，拉特蘭又在哪裡？！"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "我在這裡再一次懇求兩位......！"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "我懇求智慧的教宗閣下，我懇求你我的信仰......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "枯瘦的老人抬起雙手。\n好似要將信仰高舉，又好似已不堪重負，搖搖欲墜。\n薩科塔的信仰無形無跡，無處可尋。\n手指徒勞地抓過頭頂的光環，老人的手逐漸滑落，覆住自己的臉。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "蕾繆安並沒有說錯。拉特蘭不會有薩卡茲。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "拉特蘭城也不允許薩卡茲進入。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "唉，費德里科，有點太直白了。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "這是事實。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "已經夠了，斯特凡諾。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "斯特凡諾，我說過，我們可以接受那個條件。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "你們去拉特蘭，我們找個地方重新開始。那個叫蕾繆安的特使也答應給我們一定的支援，只是名義上我們......必須分割罷了。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......這本來也是事實，他們能提出這種條件已經超出我的預料，已經足夠了。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "不，這不該是事實！也絕不足夠！"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "你難道不明白？正因這可笑的名義上的分割，我才越來越感到荒謬！"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "抱歉，斯特凡諾。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我們放棄了。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "什麼......？"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......你的意思是......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我的意思是，如果你是因為我們，才把自己逼到這個地步，那實在沒有這個必要。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "不要對你自己這麼苛刻。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我已經問過大家的意見。我們決定......離開這裡。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "你說什麼......？"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "這樣就沒有問題了吧，執行者閣下。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我們離開。只是放過一群朝不保夕的流民，這樣可以嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "公證所並不會將無罪名的平民列為攻擊對象。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......那太好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "真的嗎，費德里科？"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "我不說謊。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "嗯......該怎麼說......唉，算了，你是領隊，你判斷沒問題的話，我也沒意見。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我可以向你們保證，拉特蘭的聖堂內從來沒有出現過任何一個薩卡茲。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "這並不構成任何罪名。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "怎麼說呢，這確實不是什麼明文禁令。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "斯特凡諾·托雷格羅薩主教，根據你的供述，我將繼續追查奧倫·亞吉奧拉斯的去向。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "我是否可以認為你已確認接受拉特蘭方提出的條件，同意修道院內除薩卡茲以外的居民擇日轉移前往拉特蘭？"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "如繼續沉默，是否可以解讀為你已默認同意。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "斯特凡諾。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......時間......"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "我需要一點時間......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "我希望能夠在這裡完成最後一次布道，再度過最後一個夜晚。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "請你們......最後再給這裡一點時間。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "明天的晨會之後，我會給你們一個答覆。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "你覺得呢，費德里科？"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "可以。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "現在我希望見到樞機輔佐官蕾繆安。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "蕾繆安特使是我們的客人，你們想見的話，自然可以去見。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerId": "avg_1032_excu2_1",
      "text": "明白了。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "speakerId": "avg_npc_372_1",
      "text": "那麼兩位，我們先告辭......哎，等等，費德里科，你好歹打聲招呼......！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "我還保留著雇傭兵的習慣嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "這麼多年了，有些習慣看來還是改不掉。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "杰拉爾德，你真的確定了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "當然，斯特凡諾。你知道我不會拿這種事開玩笑。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "......我們所有人都為生活所困。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "這確實不是謊言。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "有人在嗎？我來送冬衣！"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "咦，奇怪了，今天怎麼到哪都找不到人......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲居民",
      "speakerId": "avg_npc_935_1",
      "text": "小菲娜？你傻站在這幹啥呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "啊，卡洛琳！你來得正好！"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "我來給大家送點冬天穿的厚衣服，今天怎麼回事？我走了半天一個人都沒遇上......你們都忙什麼去了？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡洛琳",
      "speakerId": "avg_npc_935_1",
      "text": "我們......今天都有點事。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡洛琳",
      "speakerId": "avg_npc_935_1",
      "text": "辛苦你特地跑一趟，但是這些衣服，呃，我們過冬的衣服其實夠穿了，小菲娜你還是拿回去吧。也告訴其他人，不用替我們操心。"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "你在說什麼傻話啊？最近幾年哪一年過冬我們東西是足夠的？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "卡洛琳你不是到現在都還穿著那件薄外套嗎？很快就要大降溫了，總該給你準備件更厚實點的......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡洛琳",
      "speakerId": "avg_npc_935_1",
      "text": "小菲娜？你怎麼了......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "卡洛琳，你手上拿著的那是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡洛琳",
      "speakerId": "avg_npc_935_1",
      "text": "這......沒什麼。就是點乾糧。"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "不對，你讓我看看！"
    },
    {
      "type": "dialogue",
      "speakerName": "卡洛琳",
      "speakerId": "avg_npc_935_1",
      "text": "哎......等一下！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薩科塔女孩伸手奪過對方藏在身後的所謂的乾糧，她幾乎是憑藉直覺，在被阻止前將那又乾又硬的東西從中間掰開。\n填充在乾糧內部，某些一直被隱藏起來的真相，就此暴露在她的眼前。"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "這是......什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "糠皮？還有......這是木屑？！"
    },
    {
      "type": "dialogue",
      "speakerName": "卡洛琳",
      "speakerId": "avg_npc_935_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "卡洛琳？！"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "你不是和我說你們不缺吃的......不缺，你們就吃這個？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡洛琳",
      "speakerId": "avg_npc_935_1",
      "text": "不是的，小菲娜，你聽我說。我們、我們只是......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "只是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "告訴我吧，卡洛琳。"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "告訴我吧......我們這日子，到底已經過到什麼樣的地步了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚。\n咚。咚咚。咚咚咚。\n門被敲響了。\n門其實並沒有鎖。但門外的客人在得到回應前，依然只是敲門。\n這是曾經在學校裡，幾個好友之間約定過的暗語。時間過去太久，蕾繆安原以為自己已經忘記，但事實證明，她並沒有忘。\n客人敲擊出的暗語的含義是：\n“解救成功。”\n以及：“第一個到達。”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "請進。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "您好，客房服務。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "謝謝，餐品請放在桌上就好。需要小費嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "哪有問別人要不要小費的，這種事不都是看心意給的？"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "唔，說得也是呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "你好像一點也不驚訝，蕾繆安學姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "看到是我會失望嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "怎麼會。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "你會來，就證明這邊的消息已經傳回拉特蘭了吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "嗯？嗯......差不多吧。奧倫那傢伙竟然把學姐你一個人丟在這，我回頭就把這事告訴莫斯提馬和菲亞梅塔她們。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "啊哈哈，還是放過他吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "沒意思——"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "好了，言歸正傳。教宗閣下不會安排你一個人來這裡，這點我還是可以確定的。那麼......"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "我需要你彙報你的任務，以及隊伍構成。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "變成公事公辦的口吻了，好吧，蕾繆安樞機輔佐官閣下。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "本次任務由教宗閣下直接派遣，由公證所執行者費德里科帶隊，成員有同是執行者的里凱萊·科倫波，以及主動申請加入的本人。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "我們接到的首要任務是找到你和奧倫，次要任務是調查這座修道院。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "哦對了，費德里科還有個維穩的任務，我覺得教宗閣下這次真是找錯人了。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "彙報完畢。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "嗯......原來如此，教宗閣下竟然派了那個費德里科來嗎......"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "情況我大致瞭解了。辛苦了，莉雅。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "欸，這時候又喊名字。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "所以學姐接下來打算怎麼辦？你看起來像是被限制了行動，不過實際上只是你本人不願意走吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "要是你想走，這裡的人可攔不住你。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "我的腿還沒好全呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "那也一樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "太相信我了哦，莉雅，雖然也可以啦......好吧，確實是我主動留下來的。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "如果費德里科要以非法拘禁之類的罪名逮捕這裡的主教閣下的話，就麻煩你幫我和他澄清一下了。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "以及，抱歉，我暫時......還不打算離開。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "我能問問理由嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "理由......嗯，因為外交並不是那種只靠銃和子彈就能解決的事情。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "論射擊的話我是隨時都有勝算啦，但如果坐下來協商談判，說不好就是對方說服我。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "正好我和這裡的居民還挺聊得來的，我也想看看，最後改變想法的會是誰。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "欸，說得好像學姐真的會讓步一樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "讀書的時候學姐可是蹲守了我一整個學年，就為了抓我去學校上課欸！"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "呵呵，我只是覺得如果莉雅因為蹺課拿不到畢業證書的話，就太可惜了。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "至於這裡的問題......至少我現在態度還很友好哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "我知道奧倫一定會把這裡的情況彙報回去，所以我選擇留下。我不想再刺激主教閣下，我總有種不太好的感覺......"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "在掌握了這麼多修道院的情報後，如果有機會再談判一次，或許我能夠讓主教閣下的態度緩和一點，接受我的方案。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "唉，我就猜到會是這種理由。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "你能理解那真是太好啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "我可沒這麼說......"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "但我知道你是這麼想的。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "我有點討厭共感了。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "別這麼說，你對這裡的情況瞭解多少了？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "知道一些。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "除去有一群薩卡茲以外，沒什麼特別出奇的地方。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "你知道嗎，他們一共派出了三位信使。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "......莉雅。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "我記得你並不喜歡出外勤任務，你為什麼會主動申請？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "......就不能是為了學姐才來的嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "說謊~"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "總之我先去和費德里科他們會合，把你這裡的情況告訴他們。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "不過說實話，我不覺得你的努力真的能有什麼效果。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾繆安",
      "speakerId": "avg_npc_925_1",
      "text": "......總要再試試。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "唉，蕾繆安學姐越來越可怕了。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "不過也無所謂......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "熟悉的男聲",
      "speakerId": "avg_4015_spuria_1",
      "text": "終於有工夫和我聯絡了？"
    },
    {
      "type": "dialogue",
      "speakerName": "熟悉的男聲",
      "speakerId": "avg_4015_spuria_1",
      "text": "我還以為你見了蕾繆安一面，就要放棄你的任務了。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "誰知道呢，搞不好哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "熟悉的男聲",
      "speakerId": "avg_4015_spuria_1",
      "text": "......別開玩笑了，饒了我吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "這可是你自己先說的。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "行了，我沒時間和你廢話，說點正事。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "呼......應付這種人真累人......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "好麻煩的任務，嘖，早知道就不接了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "嗯？什麼人在那裡！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯普莉雅",
      "speakerId": "avg_4015_spuria_1",
      "text": "欸，你居然真的跟過來了啊，小妹妹。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "我、我不能放你一個人在修道院裡亂跑！我得監督你不會做什麼壞事！"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "......還有......"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "還有，我有一件事想拜託你......我會準備好報酬的！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "唔，讓我看看......"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "麵粉，蛋......"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "還有，還有......上次剩下來的那點糖被我放哪了......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "......唉，明明每天都有努力節省晚飯的食材了，怎麼還是只有這麼一點啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "要給斯普莉雅的，給斯特凡諾爺爺的，給菲娜和萊蒙德......還有杰拉爾德叔叔，克萊芒叔叔，卡洛琳姐，還有......"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "不管怎麼分都不夠嘛......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "小福？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "我進來了哦？有點事想和你說......你這是在幹什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "啊，菲娜！你來得正好！"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "你還記得之前我幫妮娜嬸嬸幹了一個月的農活，換來的那些白糖放在什麼地方了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "那都是多久前的事了，現在到哪裡找去？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "你找白糖幹嘛？還有這些食材，你從哪弄到的......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "......等會，小福，你該不會這時候還有閒心做甜品吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "呃，菲娜，你怎麼了......你生氣了？"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "我不是有意背著你偷藏食材的，我只是想給大家一個驚喜。菲娜，你別生氣，好不好？我做好了一定第一個讓你嘗嘗！"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "小福，你......算了，先把東西放下吧，現在不是做這些事的時候！"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "欸，可是......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "還有什麼好可是的？"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "可是，我還答應了別人，要做青草格子餅給她當謝禮......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "......謝禮？"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "嗯！有人幫我修好了守護銃！我得好好謝謝對方才行！"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "菲娜，真的好神奇啊，當這把銃被修好，我握上它的那個瞬間，一切都感覺很不一樣！我好像......好像天生就知道該怎麼使用它！"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "你看！它變漂亮了好多，今後我們就可以一起用這把銃了！"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "你知道嗎，小福。"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "我其實沒有那麼在乎是否有自己的銃，也不在乎斯特凡諾爺爺總說的什麼信仰。"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "我甚至不在乎我從來沒見過的拉特蘭。"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "欸？"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "菲娜，你在說什麼......？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "我是個不合格的薩科塔嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "或許我確實是。"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "但我在乎你，我在乎萊蒙德，我在乎斯特凡諾爺爺和杰拉爾德叔叔，還有克萊芒叔叔，妮娜嬸嬸，卡洛琳......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "我在乎這裡的所有人。我只有這一個家，只有這麼點家人。"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "你到底在說什麼啊，菲娜！我當然也在乎大家，我和你一樣——"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "不！不一樣！"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "如果你和我一樣......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "如果你知道萊蒙德他們過的是怎樣的日子，你怎麼還能在這樣的時候有心情做這種玩笑一樣的甜點，說那樣天真的話？！"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "有時候我會覺得，自從拉特蘭的人來了之後，你就有點變了。"
    },
    {
      "type": "dialogue",
      "speakerName": "福爾圖娜",
      "speakerId": "avg_npc_927_1",
      "text": "......什麼？我沒有......"
    },
    {
      "type": "dialogue",
      "speakerName": "德爾菲娜",
      "speakerId": "avg_npc_936_1",
      "text": "小福，你的那把銃，是那個叫蕾繆安的拉特蘭人幫你修好的嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克萊芒",
      "speakerId": "avg_npc_924_1",
      "text": "主教閣下，我按您的吩咐，讓兩位客人在修道院內自由行動了。"
    },
    {
      "type": "dialogue",
      "speakerName": "克萊芒",
      "speakerId": "avg_npc_924_1",
      "text": "這樣真的好嗎？您......您看起來好像不太舒服，還是先休息一下吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "克萊芒啊，我沒事，不要擔憂。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "去敲鐘，這周的布道提前到今天，去通知大夥......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "杰拉爾德，你們會來嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "杰拉爾德",
      "speakerId": "avg_npc_926_1",
      "text": "抱歉，斯特凡諾，我們還有不少準備要做，我不能保證有多少人會來。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......可以理解。"
    },
    {
      "type": "dialogue",
      "speakerName": "克萊芒",
      "speakerId": "avg_npc_924_1",
      "text": "可是......"
    },
    {
      "type": "dialogue",
      "speakerName": "克萊芒",
      "speakerId": "avg_npc_924_1",
      "text": "我們真的要接受他們的條件嗎？難道真的就要這麼拋下其他人......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "不要多問。"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "去吧，克萊芒，快去吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "克萊芒",
      "speakerId": "avg_npc_924_1",
      "text": "我知道了......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "......若信仰背叛了其自身，我也當，做出選擇......"
    },
    {
      "type": "dialogue",
      "speakerName": "修道院主教",
      "speakerId": "avg_npc_923_1",
      "text": "我需為此懺悔......"
    },
    {
      "type": "sceneBreak"
    }
  ],
