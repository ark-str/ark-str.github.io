{
  "server": "tw",
  "storyId": "story_cerber_set_1_story_1",
  "groupId": "story_cerber_set_1",
  "stageId": null,
  "title": "特大號烤餅",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_cerber_1_1.txt",
  "sourceHash": "ebb6786ef0ec11d030379ffb08241c3223deda2337e3bc686985677a57bee8de",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "羅德島主艦\n火神的工坊"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小刻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "怎麼了大姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是不是要我幫忙呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "裝備有多久沒保養了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我想想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "一......二......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（扳手指頭）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大概十五天，吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是時候了，今天維護一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "給你畫的保養示意圖還在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "在的！我把它貼房間裡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那房間裡工具和消耗品夠不夠？用完的話可以現在就拿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "夠的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "先收拾一下吧，等爐火暗下去我們就可以走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "走？大姐是要出去嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是，今天要去鍋爐房幫忙檢查和維護，然後要去倉庫收訂好的胚料，顧不上爐火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小刻可以看爐子的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "照看火爐不適合你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "而且你也有自己要做的事情，對不對？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "差不多了，走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "午餐給你做好了，離開的時候記得拿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我忙完就回來找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的大姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那麼，一會見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "一定要快點回來啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊......走掉了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我......做什麼比較好呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "先回房間保養寶貝吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "宿舍區\n刻俄柏的房間"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "這個......圖上說要用植物油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "植物油?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是......這個?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "標籤上寫著——植......物......油！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "猜對啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "下一步要做什麼來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "用小抹布沾一點油，然後慢慢塗滿寶貝上亮晶晶的部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "對就是這樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我記得超級清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不知道弄完以後大姐會怎麼表揚我呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "上次一點都沒做錯的時候，大姐手打了一個陀螺給我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "這次會是更好玩的東西嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "說起來，我還沒嘗過油的味道呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "既然是寶貝的食物，應該味道不錯吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（用手指沾點油，舔了一口）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嘔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "看來寶貝喜歡吃的我都不能吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "本來還以為能和她們有一點共同愛好呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "繼續繼續。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好，塗完啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "接下來要做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦，其他地方也要上油啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "還要用不同品種的油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "過了好久"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好像做得差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "肚子有點餓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔，吃飯吃飯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "今天的午餐是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "香煎肉獸排耶！還有淋上醬料的馬鈴薯泥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊嗚啊嗚！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哈——吃完啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不愧是大姐，手藝真好呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "就是——肚子還有點餓——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯，現在幾點來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦，十......十一點一刻......到中午了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是大家吃飯的時間沒錯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "也就是說——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "衝呀！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "11:30 A.M.\n羅德島食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "果然這個時候人就變多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "讓我看看有些什麼菜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔，唔喔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇哦！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "你好，小刻俄柏，要吃什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我就看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（這裡好吃的那麼多，裡面肯定有更多吧！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（好，我要想想怎麼溜進去。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "不來點什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不用不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "再見！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "再見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "訊使先生，一會您櫃檯前的菜會來，還請注意一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "訊使",
      "text": "（小聲）她來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "（小聲）我知道了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐說只有細心觀察才能發現機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "上次我沒好好看，被門口的大叔提出來了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "這次就不一樣了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我一定能進去的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "這是高湯澆菜吧，如果我沒記錯，應該是中間，訊使站著的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（離我藏起來的地方不遠就是門。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（門旁邊有個好看的姐姐，進去的時候不要被她發現。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（小熊在和她講話。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（她旁邊有一整排好吃的，但是都有人看著。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（再遠點的地方有個小開口，好像是放盤子的，我進不去。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（還是只能走門。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（門口還有好多人走來走去的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（嗯，再等一會。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（門口的人好像越來越少了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（沒人了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（機會到了！！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（衝呀！！！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃的我來啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嗚啊啊小刻你不能進去！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不行嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "不行！你看到門上那個貼紙了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "看到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "一個紅的圓圈裡有根斜著的紅線。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "還有小刻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "這是“小刻禁止入內”的意思，明白嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "明白為什麼還要往裡面走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "餓了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "餓了可以去那邊排隊買東西吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "餓了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "總，總之，小刻不能進去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "餓了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好好好古米想想辦法！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "如果......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "如果古米把這塊餅乾給你，你能答應古米不進去嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（嗅嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "給......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "謝謝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沒過多久"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊給的餅乾好好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "但是還是餓......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不好意思啊小熊，我還是要進去吃好吃的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "剛剛可能是我太開心發出聲音被發現了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "這次不會再犯這樣的錯誤了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔，讓我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（除了門旁邊那個站在檯子後面的大姐姐，基本上沒有人了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（門還開著？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（哇！！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（裡面那個籃子，有麵包！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（好像還是現烤的耶！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（我要吃！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃的好吃的我現在就過來！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊嗚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "怎麼了，急急忙忙的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（糟糕，被發現了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "呃，嗚嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（怎麼辦怎麼辦！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我，我想上廁所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "這裡不是廁所，那邊有塊牌子，牌子上有藍色和粉紅色小人的才是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊是這樣啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "謝謝姐姐！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "不客氣，下次可不要走錯了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（哎呀總算是沒有被發現，要是被抓住，讓火神大姐知道就麻煩了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "遠山，最後一鍋菜來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "啊，辛苦了，這鍋在最裡面黑角站著的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "沒事，被古米咬了一口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "哎呀，我還不知道原來你們關係那麼好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "別笑我了，疼著呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "哼哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "哦對了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "一會在廚房門口的準備區放兩套標準份的飯食吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "餵佩洛的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "好，我進去和師傅們說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "啊疼疼疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "一會說不定還會麻哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "不要啊，饒了我吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "只是開個玩笑~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "你開玩笑，是不是就代表我沒救了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "怎麼會呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "快去吧，一會我們就可以收工吃飯了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "這次一定能成功的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "讓我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "這不是什麼人都沒有嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "門口的大姐姐也不見了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "耶！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嘿！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嘿嘿，門也沒鎖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我進來啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦噢！果然有吃的！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "讓我嘗嘗看——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇哦，好吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不錯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊嗚啊嗚啊嗚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，吃到了，好開心！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "該回家繼續保養寶貝啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "剛剛，小熊的肚子是不是也在咕咕叫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "她把餅乾給我，是不是她就餓肚子了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "感覺有點對不起小熊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐說，別人幫了你，你就要加倍回報他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊給了我一塊小餅乾，那我就要還給她一塊大大大——餅乾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好，等大姐回來就做！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "現在先回家，把今天佈置的任務做完。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "刻俄柏的房間"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "武器都保養好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "插武器的袋子和背包也都清潔過了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "現在就剩下最後一件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐你早點回來啊，這樣小熊能少餓一會肚子啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊大姐我這就給你開門！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐你回來得好快啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "今天的工作比較順利，所以就早點回來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "能讓我看一下你的保養成果嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小刻正好剛做完，武器都整整齊齊放在桌子上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好，我看一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（我都是按照畫來做的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（對自己有信心！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（不會錯的！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "怎，怎麼樣呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "油上得很均勻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "（湊近聞一聞）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "也沒有用錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "鞘也都清潔過了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "做得不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "謝謝大姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哎嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我現在要回工坊，你一起來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火神的工坊"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "這批胚料成色不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "希望能做出些令人滿意的作品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（說啊，快說啊，小熊還餓著呢啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（但是，好，好緊張，有點不敢說......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "怎麼了，有什麼想說的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，是這樣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐能教我做大餅乾嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "哦？你終於要自己做吃的了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，是，是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐快教我，小熊要餓死了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小熊......是，古米嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，呃，嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "中午......對，中午！我中午碰到了小熊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊請我吃了塊好吃的餅乾！所以我想還小熊一個更大的，更好吃的，但現在我既不會做餅乾，也不知道小熊住在哪裡，我，我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "所以我，呃，我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐，我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "再說下去你就要結巴了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "對不起......我，我有點急......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯，好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "現在，聽我說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我知道她住在哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我來教你做吃的，然後帶你去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "真的嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "只要你想學，就可以教。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我要學！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "正好我這裡有點發好的麵團，我們就做個大號的餅，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "你想做多大？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "越大越好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "幫我把工作台收拾一下吧，我先讓爐火重新旺起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "準備得差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小刻，手洗好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇，這是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "麵團。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "那我要做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "很簡單，揉麵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "你先試試看，要是錯了我會告訴你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "揉麵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "對，繼續。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "不用怕揉壞，用力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "再揉個幾分鐘。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好，差不多了，把它攤在板上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "用刀分成兩份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "然後把每一份都按扁成餅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "這一次我們先不用餡料，等以後你熟練了，我再教你調配餡料的方法和餡餅的做法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "這裡邊角上還有一點沒壓下去，對，就這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好，不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "把餅連著板一起放進火爐吧。來，這是手套，先把它戴上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是放進火爐裡的架子上嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好——放好啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "做餅還是蠻簡單的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我還要做什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "看著時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好難哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大概十分鐘左右"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小刻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "該把餅拿出來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好了嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "噢噢哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "當心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "先把手套帶好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "放在桌上，然後就完成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好——啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（嗅嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好香啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "肯定很好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我嘗嘗看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（撕下一塊放入嘴中）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "果然餅還是要熱的才好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我得趕緊給小熊送過去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那這塊我先幫你用木板夾好，這樣能冷得慢些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "這次我帶你認路，下次你就要自己去了，明白嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "宿舍區\n古米宿舍門口"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "到了，就是這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（按門鈴）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "叮咚"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "進來吧，門沒關。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（探頭張望）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊你在啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "你好呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "中午吃了你的餅乾，現在來還你一塊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "火神大姐教我做的，剛剛做完就送過來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "是不是......有點大？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "快吃吧，冷了就不好吃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "拜拜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊好像很開心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是嗎，那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "謝謝你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "沒什麼好謝的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "趕緊學好，以後就能自己做餅吃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "甚至有一天能自己做蜜餅，也說不定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇，好像很不錯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "但是我還是會吃大姐做的蜜餅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "哼，那也挺好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我們回去吧，爐火沒人看著可不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "再說，你剛剛做的餅還沒吃完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "對哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "急著給小熊送餅，我自己還沒吃夠呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那樣的餅，充饑是不錯，但要稱得上好吃，還得要一些其他東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "還記得上次的肉醬嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "想不想用它沾著餅吃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "想！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那麼快走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我也有點餓了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃的我來啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
