{
  "server": "tw",
  "storyId": "main_14_level_main_14-02_end",
  "groupId": "main_14",
  "stageId": "main_14-02",
  "title": "破解錘砧戰術",
  "storyCode": "14-3",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_14-02_end.txt",
  "sourceHash": "8076abe619f5ca178961115db12bfd3fe3ba7f3238b4f408de3072032d3b092a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "行動開始後二十三小時"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "前進路線清掃完畢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "我正在偵察薩卡茲的動向，暫時沒有發現他們留下的痕跡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "感謝你，Misery先生，請繼續布置哨位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "摩根，你那邊有沒有發現活著的維多利亞士兵？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "除了源石結晶，什麼都沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "在進入西途林地以後，我們沒有遇到哪怕一支維多利亞人的隊伍，連屍體和載具殘骸都幾乎見不到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "因陀羅",
      "text": "見鬼！明明看起來打得這麼激烈，人都上哪去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "達格達",
      "text": "這裡的地形還在一刻不停地變化，也許是……大地吃掉了一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "我們不能低估人們的頑強。正因為有不願放棄的人，才會有典範軍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "我們也才會在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "希勒少尉，請繼續讓醫療兵做好接收殘軍和平民的準備。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我們的物資還算是有些富餘，這方面可以放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "但，壞消息是，鑒於現在隊伍裡感染者的數量，我們就快區分不了感染者士兵和非感染者士兵了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "我需要你的專業意見。登記感染者還能不能幫到我們的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "哈哈。“登記感染者”……這幾乎是我在軍校學到的第一課。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "但情況擺在這裡了。我得說，意義不大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "好。那就別再登記了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "所有人，無論是否已經感染，都盡量按照羅德島的建議做好防護。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "剩下的……就不是我們當前能決定的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "先活著打贏眼前這場仗。未來的仗，未來再說。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "啊，我的無人機回來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛克十八",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "……糟透了，整個動力系統裡都卡滿了結晶粉塵。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "看監測儀的數據，環境中源石濃度的漲落還是非常劇烈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "洛洛，把最新的數據發給我，我們又更新了一版活性化源石發展趨勢的模型，看看這次的演算結果能不能擬合得上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "嘖，看來數據量還是不夠，這個曲線的走勢……等維克多他們那裡衍射儀的分析報告出來，我們應該就能即時計算出安全區的位置了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "這片鬼地方，也許上一秒看起來風平浪靜，下一秒就會從地裡長出什麼恐怖的源石大山。安全區的位置一直在變化。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "現在雖然短距離的通訊已經勉強恢復，但是距離稍微長一點，通訊還是會有干擾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "多虧我有先見之明，在來倫蒂尼姆之前，找Raidian討了她的施術單元，稍微仿製了一下……效果雖然不如正版，但夠幫上忙了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "等到我們的幾座便攜通訊塔都豎起來，安全區的地點就能發送給戰場上每一個有需要的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "這個訊息能救很多人的命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "當然，我們羅德島就是幹這個的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "號角小姐，情況怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我們已經成功登陸吉布森鎮。這裡是我們進入銀石崖前線之前的最後一個補給點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "偵察小隊進行了初步的探索，確認有公爵聯軍殘留的痕跡，他們應該是在數天前途經這裡開赴前線的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "“灰禮帽”之前同步給我們的行進方向確實是安全的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "鎮上有停留人員嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "街道上是空的，但我能察覺到晃動的人影和食物的氣息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我們沒有貿然接觸，以免產生不必要的誤會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "知道了，我們會盡快與你們會合。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "天快黑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "看來，如果一切順利，我們的戰士還能稍作休息，喝上一碗熱湯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "記得給我的人留點，他們忙完再趕回來還要點時間。洛洛和我也還得去費斯特那裡一趟……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "今天晚上說不定能把通訊範圍再擴大一倍，我們想辦法盡早完工。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "放心，我們一定把最好的菜留給你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "……反正也就是罐頭軍糧吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛洛",
      "text": "要不要抽點戰車裡的機油給你當佐料？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "喂！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王＆洛洛",
      "text": "哈哈哈哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "各隊伍注意，繼續前進，進入吉布森鎮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "希望這一夜……可以和現在一樣平靜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "所有的房子看起來都沒人，原本的居民都躲起來了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "吉布森鎮離公爵們的防線不遠，應該沒有被薩卡茲完全佔領過，更何況聯軍幾天前才通過了這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "但號角小姐的謹慎是對的，也許有之前掉隊的公爵殘部因為想追上大部隊而進入這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我們雖然收到了“灰禮帽”的建議，但維多利亞向來不是鐵板一塊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "而且，典範軍內部的情況還相當複雜，有些古板的軍事貴族未必能容忍我們的存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "展示出我們的規模能讓居心叵測的人先掂量掂量自己，也能讓需要援助的人知道我們來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "戰車行駛的聲音迴盪在沉默的夜色中，引擎的低鳴沉穩而有力。\n戰士們小心地前進著，觀察著四周，所見的依然只有一扇扇漆黑的窗戶與門洞。"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "看來他們不想主動與我們接觸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "也好，如果能相安無事……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "等等，有聲音，左前方的建築裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "是炮彈彈殼落地的聲音！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "埋伏？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "大家戒備，我帶人去探路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "第一、第二小隊，跟上！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "已經廢棄的工廠裡，沒有半點人影。\n彈殼落地的聲音消失後，也沒有預想的爆炸聲傳來。"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "號角小姐，你確定那是彈殼落地的聲音嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我很確定，而且，那是維多利亞精銳部隊才會配給的特殊型號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "這裡沒有發現有人生活的痕跡——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "推進之王，停步。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "推進之王剛抬起的腳又小心地放回了原地。\n號角指向地面上微不可察的，一條細細的絆線。"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "藏得很好，這條絆線剛好被管道擋住，很難發現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "詭雷？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "不……沒有連接爆炸裝置，是個簡易的報警系統。但看設置的手法，是專業的軍事人員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "嘗試交流看看？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "嗯，站在我們後面，其他人，做好作戰準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "你好，我們沒有惡意——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我們這支部隊的番號是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "暗門！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "準備進入，跟住盾牌！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "站住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我們不是……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞士兵？",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞士兵？",
      "text": "幫、幫幫我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "受傷的士兵",
      "text": "我就是在觀察的時候不小心碰掉了樓上的廢彈殼，這他們都聽得到！你設置的報警器他們也沒撞上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "受傷的士兵",
      "text": "這支隊伍，恐怕不是那些一般的——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "受傷的士兵",
      "text": "她……她能擋開你的破城矛？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "隊長？還有推進之王？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "……菲奧娜，真的是你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "紅色長髮的女孩猛然撲進她的隊長的懷中。"
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "原來，你們都還活著……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "太好了，真的太好了……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "號角輕輕鬆開了風笛，卻又捏了捏她的肩膀。"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "還好，沒受傷，也沒瘦多少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "報、報告隊長！我做到了，我把鬼魂部隊的情報帶了出去，我還查清楚了他們到底想幹什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "我活了下來，帶著記憶，帶著真相，一直活著！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "你的命令……我一個字都沒忘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "很好，我知道你能做到，從來都知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "——風笛，歡迎歸隊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "受傷的士兵",
      "text": "這是……？你們到底——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "各位，都請出來吧，我們沒有惡意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一個個人影從黑暗中走了出來。\n老人，孩子，傷患，病人，平民。\n成百上千雙眼睛帶著畏懼與好奇打量著推進之王等人。"
    },
    {
      "type": "dialogue",
      "speakerName": "受傷的士兵",
      "text": "你們不是公爵的部隊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "受傷的士兵",
      "text": "你、你們不少人沒穿維多利亞的軍裝，怎麼還有工人打扮的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "是的，我們不隸屬於任何一位公爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "這支部隊的番號是，“典範軍”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "希勒少尉正在統計藏在工廠裡的平民的人數和身體情況。只能說，比我們預計的要好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "除了和你一起過來的那些法夫公爵的感染者殘兵，還有一小隊諾曼底公爵的工兵，其他都是本地的平民，沒跑得掉的那些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "明明公爵的聯軍前幾天剛經過這裡，他們卻寧願放棄可能被救援的機會，也不願意尋求大公爵們的幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "達格達",
      "text": "軍人們還好理解，無論是擔心自己的感染狀況，還是擔心軍事條令的處罰，都算是有個理由。可是平民們……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "達格達",
      "text": "這一年，也許倫蒂尼姆周圍的人們，被迫重新認識了自己的國家和那些掛著勛章的上位者們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "風笛，你是怎麼獲得他們的信任——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "……你在聽嗎，風笛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "啊，隊長！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "開戰術會議的時候需要聚精會神。地圖在那裡，不在我臉上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "抱歉，隊長！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "號角輕輕嘆了口氣。"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "……唉，這問題我不該問，畢竟你可是菲奧娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "我就是……有點高興。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "“典範軍”，風暴突擊隊的前身。原來那些傳言是真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "……我比較驚訝的是，你居然沒忘記軍史課的內容。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "當然啦！以前在駐地受訓的時候，三角鐵可是監督我把這條罰抄了好多遍呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "駐地的操場邊上，岩槭長得很茂密，擋太陽正好，外面崖壁上的石頭很硬，磨得手疼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我記得，有一回大提琴和雙簧管打賭，誰能更快完成攀岩訓練，輸的人做一百個單手伏地挺身。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "雙簧管太傻了，誰會跟大提琴打這種賭啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "你那時候可沒提醒他。他做伏地挺身的時候，你還坐他背上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "嘿嘿。我那是，幫他加練。效果不是還不錯嗎？他後來差點就打敗大提琴了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "早在風暴突擊隊成立的時候，那支四國戰爭時期的傳奇部隊就連一個空番號都不剩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "但是現在，它又回到了這片戰場上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "風笛，我們現在都是典範軍的一員了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我們的隊伍還在，我們就不會停止戰鬥。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "裡面不是在開作戰會議嗎？你怎麼在外面的冷風裡站著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "嗯……不差這幾分鐘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "……想起誰了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "貝爾德，還是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "誰都沒想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我信你。要是這夜霧裡突然走過來一個人，我也並不會有什麼期待。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "不是誰都有號角小姐那麼幸運，還能和自己最想見的人……重逢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "“幸運”嗎？真是個奢侈的詞啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "……傷感的時間到此為止，我們也該進去了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "……等等。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "維多利亞的軍人？是留在這裡的殘兵嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "不，不對，在他們接近之前，我居然都沒發現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "這種素質……精銳中的精銳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "開斯特的人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……呵——真冷啊，手都凍僵了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "這天啊，真是越來越冷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "只是散了這一下子步，披肩就差不多濕了一半。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "高多汀公爵",
      "text": "年輕的朋友們，真的不準備邀請我進去暖和一下嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "……既然您願意親自出馬，那我們也該有些禮貌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "戴菲恩——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "維娜小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "我們來為公爵大人引路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
