    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "speakerId": "avg_npc_357_1",
      "isRemote": false,
      "text": "......很遺憾，並不是。"
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "speakerId": "avg_npc_357_1",
      "isRemote": false,
      "text": "你的母親不會回來了，塞茜莉亞。"
