  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act5d0/level_act5d0_02_beg.txt",
  "sourceHash": "16d3b452d7d2cac6cdee4a3e2fd44559609228fc54296cf57f67fed2347f67bf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "咳咳，咳，大家還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "勉強，擋住了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "及時的反應，二位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哎呀，這可......炸得真徹底啊。嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "————*難以名狀的企鵝尖嘯*————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（怎、怎麼了？老闆發出很奇怪的聲音喔！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "（喂！剛才那箱黑膠唱片是不是老闆從黑市上淘來的哥倫比亞珍藏品？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（好像是的，怎麼辦，我已經很久沒有見過老闆這種萬物皆空的表情了......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "什麼怎麼辦——啊！他們上車了！那群穿黑衣服的傢伙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等等！如果他們一開始就設好了陷阱，為什麼不埋伏我們？情況古怪，我們應該定制一個具體的計畫再去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "德克薩斯！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "上車。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "......你們，給我聽好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "今晚的所有違章罰單全部報銷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "我要讓他們，給我的黑膠陪葬啊啊啊——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "看見了，就是前面那輛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "能天使！把我的老夥計拿來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "得令！老闆！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "那是把銃槍！？但您要怎麼扣扳機......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "啊哈！見識不小嘛，小少爺，讓我們的銃械專家來介紹一下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "總計四十二層運輸紙板，工業膠水無縫黏貼，高品質橡皮筋驅動，嗯，真是一把不錯的銃槍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......就是說，玩具？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "其實就是彈弓——痛！不對，是和平銃槍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "在龍門市區不允許使用實彈，這是規矩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "每次我都在想，老闆只有在這個時候遵守規矩呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "如果連我們都不守規矩了，龍門立刻就會被炸上天，明白嗎？打開車篷，德克薩斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "注意點。不要像上次那樣撞在信號燈上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "我有那麼高嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "二號狙擊位準備就緒，老闆~！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等、等等，路上還有其他的車輛，我們難道就直接——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "開車的黑幫",
      "text": "那幫傢伙開火了！喂，還擊啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後座的黑幫",
      "text": "開什麼玩笑，車開得這麼顛簸怎麼瞄準！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開車的黑幫",
      "text": "你、你中彈了！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後座的黑幫",
      "text": "血，我流血了，快給我繃帶——不對，這是什麼，橡皮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開車的黑幫",
      "text": "只是橡皮！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後座的黑幫",
      "text": "但這橡皮能打穿玻璃！快甩開他們、啊，好疼！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "準頭不錯，老闆！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "咬緊他們，德克薩斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "要加速了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "慢點，小心前面的貨車——噫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "抓穩點喔，德克薩斯姐飆起車來是不講情面的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "阿能，打爆他們的車胎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "用橡皮彈打橡膠車胎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大帝",
      "text": "只要我想，就能做到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "德克薩斯小姐，就不能阻止他們一下嗎！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "（撇開頭）......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "算啦算啦，他們玩得很開心嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "看招看招！給我表演一下原地大迴旋！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "開車的黑幫",
      "text": "喂，方向盤打不動了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後座的黑幫",
      "text": "廢話，趕緊跳車！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等等！車速這麼快，我們也會被捲進去的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "好了，連環追尾就交給你了！德克薩斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "嘖，盡給我找麻煩。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
