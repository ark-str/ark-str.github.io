{
  "server": "tw",
  "storyId": "main_3_level_main_03-08_beg",
  "groupId": "main_3",
  "stageId": "main_03-08",
  "title": "黃昏",
  "storyCode": "3-8",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_03-08_beg.txt",
