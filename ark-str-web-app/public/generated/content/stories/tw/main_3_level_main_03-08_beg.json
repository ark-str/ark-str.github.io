{
  "server": "tw",
  "storyId": "main_3_level_main_03-08_beg",
  "groupId": "main_3",
  "stageId": "main_03-08",
  "title": "黃昏",
  "storyCode": "3-8",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_03-08_beg.txt",
  "sourceHash": "645c59a806ce4faa41ab71423d830438f99d0a14eeefbaf0b3d76574a451559c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "咕！他們還在反擊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "碎骨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "只要現在擊退他們，我們就能勝利了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "現在......只能戰鬥。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "這些人......有點難纏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "呃——！那面盾，可惡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "沒錯，她，她是龍門近衛局的......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "如果你們現在放下武器投降，你們還有機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "除非想白白送命的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "我們怎麼可能會相信你的話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "別騙人了！烏薩斯......不是沒有勸降過感染者。一個接一個的，最後都被處決了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "而我趴在死屍堆裡，苟延殘喘，最後活了下來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "你們這些傢伙為了消滅我們......做出來的事情有多卑鄙都不稀奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "不就是要把我們感染者，趕盡殺絕嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "那就戰鬥到最後一刻吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "個子很大的小姐，無論你現在說什麼，他們可都是聽不進去的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "畢竟他們可沒法分辨龍門的好人和烏薩斯的惡人啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "在那個地方——不，在很多地方......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "普通人和感染者之間，就是只有互相憎恨而已，沒別的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "看來......已經無法交流了。明明出路就擺在眼前。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "出路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......我們，能做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你，又能做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "不要和她廢話了！碎骨！我們一起幹掉他們！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "爆炸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "他打算從各個地方包圍我們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "再這樣被動下去側翼會頂不住的......組織反擊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "碎骨！我掩護你！拿下他們戰鬥就結束了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "碎骨——————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我必須......和你們一起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我必須————！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "————————————",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們沒多少時間了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "星熊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我準備好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "謹慎行動，別在敵人面前暴露弱點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "不會給他們機會的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "小心敵人的衝鋒！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "阿米婭！別接近敵人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那，那是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士，博士......我該怎麼辦......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你該做的事，阿米婭。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可是我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "對不起，博士......我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "阿......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "阿米婭......？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "為什麼............",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "會變成這樣......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "text": "阿米婭......大概這就是命運吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "阿米婭！你在做什麼？快......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "嘖......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "陳長官？我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "夠了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "還是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "這一切該結束了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......陳長官......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "我需要告訴你一件事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "從現在開始，你最好對所有感染者一視同仁。那些都是你的敵人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "命運是不公的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "要恨，就恨我吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "近衛局！進攻！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
