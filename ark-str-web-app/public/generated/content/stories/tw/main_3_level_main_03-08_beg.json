  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "咕！他們還在反擊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "碎骨！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "只要現在擊退他們，我們就能勝利了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "沒錯。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "現在......只能戰鬥。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "這些人......有點難纏！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "呃——！那面盾，可惡......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "沒錯，她，她是龍門近衛局的......！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "如果你們現在放下武器投降，你們還有機會。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "除非想白白送命的話......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "我們怎麼可能會相信你的話？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "別騙人了！烏薩斯......不是沒有勸降過感染者。一個接一個的，最後都被處決了......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "而我趴在死屍堆裡，苟延殘喘，最後活了下來。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "你們這些傢伙為了消滅我們......做出來的事情有多卑鄙都不稀奇。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "不就是要把我們感染者，趕盡殺絕嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "那就戰鬥到最後一刻吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "個子很大的小姐，無論你現在說什麼，他們可都是聽不進去的。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "畢竟他們可沒法分辨龍門的好人和烏薩斯的惡人啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "在那個地方——不，在很多地方......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "普通人和感染者之間，就是只有互相憎恨而已，沒別的。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "看來......已經無法交流了。明明出路就擺在眼前。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "出路？"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "......我們，能做什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "你，又能做什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "不要和她廢話了！碎骨！我們一起幹掉他們！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "爆炸？"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "speakerId": "char_015_lmg",
      "text": "他打算從各個地方包圍我們！"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "再這樣被動下去側翼會頂不住的......組織反擊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "碎骨！我掩護你！拿下他們戰鬥就結束了！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "text": "碎骨——————！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "我必須......和你們一起......"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "我必須————！！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "————————————"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "我們沒多少時間了！"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_010_chen",
      "text": "星熊。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "我準備好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "char_136_hsguma",
      "text": "謹慎行動，別在敵人面前暴露弱點！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "不會給他們機會的！"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "speakerId": "char_015_lmg",
      "text": "小心敵人的衝鋒！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "阿米婭！別接近敵人——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "那，那是......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "我......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "博士，博士......我該怎麼辦......"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你該做的事，阿米婭。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "可是我......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "對不起，博士......我......"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "speakerId": "char_1500_skulsr",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "speakerId": "char_1500_skulsr",
          "text": "阿......"
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "speakerId": "char_1500_skulsr",
          "text": "阿米婭......？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "為什麼............"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "你......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "會變成這樣......"
        },
        {
          "type": "dialogue",
          "speakerName": "碎骨",
          "speakerId": "char_1500_skulsr",
          "text": "阿米婭......大概這就是命運吧。"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "阿米婭！你在做什麼？快......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "我......"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "嘖......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "陳長官？我......"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "夠了。"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "還是......"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "這一切該結束了。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "......陳長官......"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "我需要告訴你一件事情。"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "從現在開始，你最好對所有感染者一視同仁。那些都是你的敵人。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "char_002_amiya",
          "text": "......"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "命運是不公的。"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "要恨，就恨我吧。"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "speakerId": "char_010_chen",
          "text": "近衛局！進攻！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
