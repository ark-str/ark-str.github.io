          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#6",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "我聽著，說吧。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "——快醒醒。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#6",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "白金！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#4",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#4",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "！"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#3",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#1",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "你好，博士。"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#8",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "氣色不錯呢，發生了什麼好事嗎？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "怎麼了，在我辦公室門口打瞌睡。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你醒啦，找我有事嗎？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#1",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "沒什麼特別重要的事情。"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#1",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "我現在意識到了一件事情，夢和現實還是十分容易辨析的。"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#3",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "唉......總之，喏。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "休假申請？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "還請假？這個月第幾次了？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#3",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "不行的話，其實也無所謂......"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#1",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "還有另外一個事想問你一下。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "呃，先聽聽第二件事吧。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "又怎麼了？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#1",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "你現在......有空嗎？"
        },
        {
          "type": "dialogue",
          "speakerName": "白金",
          "speakerToken": "char_204_platnm_1#1",
          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "{@nickname}？"
        },
