          "operatorId": "char_204_platnm",
          "portraitKey": "char_204_platnm",
          "text": "怎麼了？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "白金——",
          "value": "1",
