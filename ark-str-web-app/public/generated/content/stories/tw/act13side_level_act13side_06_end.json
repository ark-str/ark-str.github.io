  "stageId": "act13side_06",
  "title": "被包圍者",
  "storyCode": "NL-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/activities/act13side/level_act13side_06_end.txt",
