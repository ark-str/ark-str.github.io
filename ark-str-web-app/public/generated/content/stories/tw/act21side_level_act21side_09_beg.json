    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "avg_1028_texas2_1",
      "isRemote": false,
      "text": "我想為他做點什麼。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "avg_103_angel_1",
      "isRemote": false,
      "text": "正合我意。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "speakerId": "avg_npc_683_1",
      "isRemote": false,
      "text": "我沒聽錯吧，德克薩斯。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "speakerId": "avg_npc_683_1",
      "isRemote": false,
      "text": "你打算留下來，是嗎？"
