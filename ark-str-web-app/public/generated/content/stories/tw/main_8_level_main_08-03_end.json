{
  "server": "tw",
  "storyId": "main_8_level_main_08-03_end",
  "groupId": "main_8",
  "stageId": "main_08-03",
  "title": "麥稈，極易燃燒",
  "storyCode": "R8-3",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_08-03_end.txt",
  "sourceHash": "89a8828edb47f17d1fed4c6b1ca4c5be631cff0132ffeddc51351ccd39c44970",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "感染者糾察隊",
      "speakerId": null,
      "text": "呃呃呃呃呃呃！！"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者糾察隊",
      "speakerId": null,
      "text": "啊啊......啊啊啊啊！！"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "塔露拉......！你......唔......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "這把火是你放的嗎！他們是你燒......呃！"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "阿麗娜，抱歉。這一定會給村子帶來很大的災難。但是我無法忍受。"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "我無法忍受這種事......"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "......阿麗娜？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "塔露拉驚訝地看著阿麗娜。阿麗娜用塔露拉從沒見過的眼神望著她。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "你眼裡有一團火。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "從你來這個村子的時候我就知道，你不會甘心在這個村子裡待下去的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "你有你的來處，你從哪裡來就要回到哪裡去，這個村子容不下你。"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "我不會回去。別這麼看著我......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "但你眼裡確實有那一團火。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "你想要點燃什麼，你想燒掉什麼，你覺得這一切都不對，你在忍受，你忍到了極限......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "不該是現在，塔露拉。不該是現在。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "村民是無辜的。你一時的怒火只會害了他們。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者糾察隊",
      "speakerId": null,
      "text": "發生什麼事——天哪！發生什麼了！誰！是誰幹的！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老婦",
      "speakerId": null,
      "text": "塔露拉！塔露拉！！走啊，走！！別回來了！！別回來！！"
    },
    {
      "type": "dialogue",
      "speakerName": "老婦",
      "speakerId": null,
      "text": "陛下保佑，保佑我這個女兒一樣的女兒吧，保佑她活下去，保佑她好好活下去啊！！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "塔露拉，我們快走！"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "不行......那些可恨的糾察隊！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "我們是感染者，村子裡的人可不是！"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "......你說什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "我也是感染者，塔露拉。我也是。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "呼，呼......這裡是......我們準備遷移過來的地方。地方已經建好了......可是......"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "他們......爺爺他......"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "不能讓他們再這麼做.......不能讓他們......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "他救了你，救了我，救了全村的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "你卻......搞砸了老爸爸他的計畫。"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "你在說什麼？那些村民，他們舉報了——"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "......等等。你是說，舉報爺爺他的，是......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "是爺爺他自己。因為這樣，糾察隊就不會再查下去，情況理想的話，就是這樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "你再有實力也對抗不了糾察隊。"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "我能。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "這之後呢？要是憲兵來了呢？城市駐軍和貴族老爺們的士兵來了呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "我們只是沒有足夠的力量，等我們累積了足夠的實力......"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "那並不對。不對，這事情不該這麼看！"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "看著邪惡的事情在眼前發生卻視而不見，只求自保，這並不對！"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "......這是自私，甚至無情的行為。"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "如果公義需要更多暴力才能伸張，那還怎麼能被稱得上是公義？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "我還回答不了你這種問題，塔露拉。你讀的書比我多，我知道的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "但這個村子今天已經死了一個人了。今天不應該再死更多人。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "你是很聰明的，你能想明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "走吧，塔露拉！"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "speakerId": null,
      "text": "......我會回來。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿麗娜",
      "speakerId": null,
      "text": "和自己說吧，塔露拉。和自己說。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
