{"server":"tw","storyId":"main_0_level_main_00-10_beg","groupId":"main_0","stageId":"main_00-10","title":"困境","storyCode":"0-10","avgTag":"行動前","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_00-10_beg.txt","sourceHash":"8a02c74ea83b7f9d642344015cd74bbc9935bb0f6aa68d69d8ce2d0b488b433f","bodyAvailable":true,"blocks":[{"type":"narration","text":"第六关（后）"},{"type":"background","backgroundId":"bg_cher_5"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"這女人......怎麼回事......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"————你。"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"壓制切爾諾伯格軍事據點的整合運動像機器一樣高效——"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"而你領著的這批各個都像神經錯亂的暴徒。"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"屠殺，縱火，圍獵......只不過是為了滿足你自己殘忍的趣味而已吧？"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"會在這時煽動如此不堪之事的人，不可能策劃出足以擊潰整座城市的方案。"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"你的指揮官大概是命令你製造混亂，而你，順應著自己低劣的品味肆意妄為。"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"——浮士德。"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"把她那張嘴給我打穿。"},{"type":"dialogue","speakerName":"浮士德","speakerId":"char_1508_Faust","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"咳，咳......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"臨光！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"敵人的狙擊手......很強！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"臨光再被擊中的話，一定會失去防禦能力！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"臨光，快退後！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"不行......威力太大了。如果擊中我方小隊，後果不堪設想。"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"我必須防住他的炮火！"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"擋開了浮士德的弩炮？憑盾牌——？！"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"不可能......不可能！"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"再來！！把她......打成碎渣！"},{"type":"dialogue","speakerName":"浮士德","speakerId":"char_1508_Faust","isRemote":false,"text":"————！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"居然......右側？！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"糟了！快閃開————"},{"type":"dialogue","speakerName":"Ace","speakerId":"char_014_riope","isRemote":false,"text":"不會讓你得逞！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"Ace！"},{"type":"dialogue","speakerName":"Ace","speakerId":"char_014_riope","isRemote":false,"text":"狙擊幹員，準備！"},{"type":"dialogue","speakerName":"Ace","speakerId":"char_014_riope","isRemote":false,"text":"——目標，南側高台，齊射！"},{"type":"dialogue","speakerName":"浮士德","speakerId":"char_1508_Faust","isRemote":false,"text":"......！"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"什麼！你們居然敢，居然敢......！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"打中了嗎？"},{"type":"dialogue","speakerName":"Ace","speakerId":"char_014_riope","isRemote":false,"text":"沒那麼容易，這只能......稍稍壓制他而已。"},{"type":"dialogue","speakerName":"Ace","speakerId":"char_014_riope","isRemote":false,"text":"沒時間再去瞭解敵人的構成了！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"兼具機動性和威力，越拖下去，我們安全擋下他弩彈的機率就越小！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"別給他喘息的機會......！趁著E3小隊狙擊幹員干擾他們的時候，阿米婭！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"瞭解！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"E1小隊射手，和我一起，壓制整合運動！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"E2小隊，用最大火力，撕開整合運動的防線！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"你們這些傢伙......"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"為什麼不肯老老實實地去死？"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"你們的命運，為什麼就不能在這裡落下帷幕？"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"——————我要把你們，通通————"},{"type":"dialogue","speakerName":"Ace","speakerId":"char_014_riope","isRemote":false,"text":"臨光，趁現在，快！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"E4全體，隨我衝擊敵方陣形！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"一次性擊潰前方的阻擋目標！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"狂奔起來！！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"射擊！射擊！別讓她靠近......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"啊......？"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"啊？？她剛剛不是還在二十米之外......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"咕咳——唔啊啊啊啊！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"想要對抗卡西米爾騎士——再去訓練個幾十年再說！"},{"type":"dialogue","speakerName":"臨光","speakerId":"char_148_nearl","isRemote":false,"text":"杜賓！跟上我！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"瞭解！"},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米婭"]},{"speakerId":"char_014_riope","aliases":["Ace"]},{"speakerId":"char_1002_nsabr","aliases":["整合運動成員"]},{"speakerId":"char_130_doberm","aliases":["杜賓"]},{"speakerId":"char_148_nearl","aliases":["臨光"]},{"speakerId":"char_1507_Mephisto","aliases":["梅菲斯特"]},{"speakerId":"char_1508_Faust","aliases":["浮士德"]}]}
