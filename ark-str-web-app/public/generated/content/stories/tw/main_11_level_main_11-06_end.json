        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "......嘖，你只有十分鐘時間。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "足夠了。",
