        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "但是，凱瑟琳，既然費斯特回來了，他是不是就不用走了？",
