      "options": [
        {
          "label": "我們只需要一些線索。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "對，我們不會給工廠添任何麻煩的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "你為什麼覺得，我會幫你？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "說不定，我剛才已經讓帕特去找那些薩卡茲雇傭兵了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "如果是這樣......那我也只能和其他人一起逃跑了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "告訴我，你們四天前在薩迪恩區鬧出來的那番動靜，死了多少人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "你都記得他們的名字嗎？你記得他們的臉嗎？你記得他們每一個人死前是什麼表情，說的最後一句話又是什麼嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "先別回答，費斯特。別臨時想一個答案來糊弄我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "我不知道這位“博士”是怎麼想的，但我瞭解你。你覺得自己很聰明，而小聰明並不總能騙過死亡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "凱瑟琳！不好了，門口出現了很多薩卡茲......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "博士，我們馬上離開這裡——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "倫蒂尼姆工人",
          "text": "他們說，城防軍的長官，萊托中校要見你，他們是來接你的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "費斯特",
          "text": "......什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "喬治，看好這兩個外人，別讓他們亂走。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "抽煙嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲雇傭兵隊長",
          "text": "別跟我套交情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱瑟琳",
          "text": "萊托長官要見我？",
