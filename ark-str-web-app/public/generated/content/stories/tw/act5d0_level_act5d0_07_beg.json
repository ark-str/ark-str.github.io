{
  "server": "tw",
  "storyId": "act5d0_level_act5d0_07_beg",
  "groupId": "act5d0",
  "stageId": "act5d0_07",
  "title": "11:08P.M.",
  "storyCode": "CB-7",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act5d0/level_act5d0_07_beg.txt",
  "sourceHash": "dec2c03ea6a8d8fbd73a3a2602039075075766c42a90c29e75c5168b57b315cd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "首領，企鵝物流有動作了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "......意料之內，只是給她留下了點皮肉傷......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "但我更在意的是，卡彭呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "其、其實在一個小時前就徹底聯繫不上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "......最後一次例行聯絡是在哪裡？貧民窟嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "啊，是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "那還真是可惜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "您的意思是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "先通知所有小隊，按原計劃攔截企鵝物流——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "但我猜，不出意外的話，大概會有那麼兩三個小隊掛斷聯絡吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "您這是什麼意思......啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "難道——卡彭先生背叛了家族？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "我理解他，太理解他了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "我們從小一起長大，親手為父親解決叛徒，那是我第一次殺人，是我們第一次殺人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "敘拉古的慘敗改變了我們。唯一的區別是，他變得更加懦弱，而我選擇了更明確的道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "他打算出賣家族，或者說，給家族換個姓氏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "那我們應該如何是好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "......企鵝物流比想像中棘手，我們也不能同時樹敵太多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "也許，我們應該先解決叛徒的問題。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "這裡是三道口，沒有異常。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "明白了，那麼一切照常行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "——等、等等！我們的計畫是什麼來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "啊？你小子沒搞錯吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "呃，我只是確認一下，對龍門不太熟悉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "安魂節的午夜過後，龍門會按例舉辦狂歡活動，我們的任務就是趁著萬人空巷時候解決企鵝物流，就這麼簡單！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "那關於首領的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "別問那麼多，這是要求，照做就是了！快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "......就是這樣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "不會殺我的，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "當然，多謝小哥啦，小睡一會吧~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "德克薩斯，聽得見嗎~？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "和這裡的情況一樣。他們打散了小隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "但既然首領親自參與了戰鬥，他們一定有另一個指揮塔負責調度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "找到那裡，一了百了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "喂~？德克薩斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "我們已經到市中心啦，但是人真的很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "注意敵方小隊的動向。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "知道啦~會拜託街上的熟人們留意的......等等，老闆？你要到花車上面去看看？欸，等等我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......可頌，拜松，聽得見嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "你說的那個指揮塔，我們稍微有點意外發現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "......拜松，壓低身子，躲到那邊的箱子後面，不要被發現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "好，德克薩斯，一會聯繫。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "我們，以後會怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "不知道，從我們掛斷首領......掛斷甘比諾·里奇的通訊開始，我們就沒得選了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "嘆什麼氣，卡彭先生在龍門為我們準備了這麼多，結果呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "甘比諾從敘拉古轉移過來就開始胡攪蠻纏，沒一件好事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "本來按照卡彭先生的計畫，根本不需要這麼大費周章。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "都和鼠王聊好了，為什麼非要大開殺戒？這裡可不是敘拉古！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "唉，首領，我是說前首領，可能只是在洩憤吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "呸，幼稚。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（他們好像起了點內訌？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "（似乎是，這是大好的機會，我們——）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "——！誰在那裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "欸？哪兒來的槍聲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "又是那個狙擊手——！他暴露了我們的位置！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "是企鵝物流的人，別放走他們！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "管家",
      "text": "......少爺，對不起。這是老爺交代的工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家",
      "text": "唉，但我竟然對少爺動了手，還讓少爺陷入了危險......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家",
      "text": "等事情結束之後，不如告老還鄉吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家",
      "text": "唉，唉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......他們好像遇到麻煩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "能天使，確認完黑幫的路線之後去和可頌會合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "明白~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "空。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "誒......今天可疑人物的動向非常複雜，不過他們好像分成兩隊行動了，可能是陷阱——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "沒有那麼複雜。敵人內部出現了問題。這是機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "哇！嚇了我一跳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......你也回來了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "為什麼要駭進自己人的頻道，就不能正常通訊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "這樣比較快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "那你現在在哪兒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "傷心咖啡館。我突然想起來今天應該放假，所以來湊個熱鬧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊斯",
      "text": "可頌和那個新人的座標已經發送給你們了，龍門城際網路的速度真是令人愉悅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......既然如此，解決完各自的任務，就去支援他們吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "這是反擊的好機會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "卡彭先生，首領突襲企鵝物流的計畫似乎失敗了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "廢話，那個莽夫能成什麼事，不用管他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "......這樣真的好嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "家族需要的是一個立足之地，至於姓甚名誰，根本無關緊要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "還沒找到鼠王嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "沒有，鼠王實在是太不留痕跡了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "有點耐心，他就像是這座城市的一部分，像是龍門的影子，雖然我們的時間已經不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "可要是不夠謹慎而被鼠王察覺到的話，我們會同時面臨三方的壓力......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "對誰來說都是如此，如果處於劣勢，我寧可讓場面變得更混亂些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "有甘比諾的消息嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "為什麼不說話？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "真是見外，有什麼事情直接聯絡我不就好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "......你是怎麼進來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "不是每個人都能像你一樣，毫無愧疚地違背在父親墓前立下的誓言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "誓言？那僅僅是因為我們走在同一條道路上，但是今非昔比了，甘比諾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "現在是我說了算，你讓我很失望，但我願意給你一個機會解釋，老兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "哼。七年前，前首領遇刺身亡，那時我就被你派到了龍門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我千里迢迢趕來，為的是建立一條史無前例的商業橋樑，作為家族的後盾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "但結果，你在敘拉古還是失敗了，而且逃了過來，轉眼就接手了我辛苦運作的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "省省吧，你不是會為了這點蠅頭小利就動怒的人，否則你早就死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "隨你怎麼說，我只是到了今天才發現，家族最勇猛的獠牙才是真正妨害家族的罪魁禍首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "所以你想掰斷自己的爪牙，再給自己戴上項圈？哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "繼續讓你在龍門肆意妄為，我們遲早會被那些不可阻擋的大勢泯滅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "原來如此，我都感動得要哭了。想不到你為了家族竟然如此深思熟慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "彼此彼此。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "你身手變得遲鈍了，卡彭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "你在敘拉古留下的傷也不好受，甘比諾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "放棄吧，我不想殺你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "不，你想得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "呵！你可真瞭解我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "什——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哎呀？本想著破牆離開的......似乎撞到了不得了的現場？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "沒關係喔，你們繼續，我們換條路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "快追！別讓那兩個人溜走了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......好像不太有機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "正好，攪局者都到齊了，那就把你們——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "這次又怎麼了！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "喂~我們來啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......真巧，全都在這兒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "唔，這架勢是要最終決戰了嗎？是不是早了點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "沒關係，越早解決這齣鬧劇越好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "就按老闆的意思，把他們扔進江裡吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "哼，越混亂，越合我意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "看來，誰能從這裡站著出去，誰就會成為今晚的贏家。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
