{
  "server": "tw",
  "storyId": "act35side_level_act35side_01_end",
  "groupId": "act35side",
  "stageId": "act35side_01",
  "title": "節前熱身",
  "storyCode": "AS-1",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act35side/level_act35side_01_end.txt",
  "sourceHash": "1375f3bc44c07af800c5a83d44c4f10d5cbda6be5f8d7e9b8bec1904ebc54f8b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "慌張的觀眾",
      "text": "啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚恐的觀眾",
      "text": "屍體……屍體動了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚恐的觀眾",
      "text": "快，快離開這裡！這裡鬧鬼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚恐的觀眾",
      "text": "那具古屍是不是朝我看過來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的觀眾",
      "text": "我就知道！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的觀眾",
      "text": "我就知道一個城市歷史太悠久遲早有天會發生這種事！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "諸位請冷靜下來，不要著急，不要慌張！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "請大家從安全出口排隊離開，往這邊！不要擠！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "喂，讓一下，讓我們過去一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "不好意思，抱歉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "*薩爾貢粗口*，阿娜特！阿娜特！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "擠過擁擠的人群，梅捷緹克緹看到阿娜特面色蒼白癱倒在地，嘴唇無力地張合，似乎有話要說。\n但後方歪著頭的屍體讓她心生恐懼，不敢湊上前。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "緹緹，辛苦你確保參觀者們的安全，我想辦法將阿娜特和這具古屍帶到別的地方去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你是一點也不害怕嗎？那玩意在動啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "也……還好吧，咳咳，我今年參與了兩座古曆紀時期墳墓的考古工作，兩位墓主人我都親眼見過了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "比起它們，這位老先生已經算是慈眉善目的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你這幹過考古的膽量就是不一樣……你一個人可以嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "放心，我們幹過考古的體力也很不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "緹緹……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "阿娜特她……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……她應該沒大礙，只是昏迷中的囈語。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "館長辦公室離這裡不遠，你們從側門出去，盡量避開人群，等我將遊客疏散完畢再過去找你們。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "發生什麼了？我還沒到埋伏的地點呢！你們提前啟動發煙器了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左邊的耳機",
      "text": "沒啊，我們還沒有行動呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "右邊的耳機",
      "text": "好像是會場中有其他人引起了騷動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "真是……我沒在人群中看到目標，她去哪裡了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "好吧，狀況有變，我們的計劃提前進行。找到她，盯緊了，隨時向我彙報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "右邊的耳機",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "盡快，等得手後我們需要混入人群才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "等到人都疏散乾淨，一切都晚了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "很好……這裡人都走光了……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "靠上前去，佩佩看見古屍胸腔內正流動著螢藍色的光芒。\n而那顆寶石早已消失在光芒中，再也看不見。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "哼，果然是因為寶石的原因……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你這個姿勢……也不是很好扛啊……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "圍著屍體觀察幾秒後，佩佩決定將古屍抬起的左臂按下去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "（按下左臂）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "（抬起右臂）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "嗯？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "（按下右臂）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "（抬起左臂）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "佩佩皺起眉頭，歪著腦袋思考該如何讓這具古屍乖乖聽話。\n但她驚訝地發現，它竟然也歪過腦袋，做出思考的樣子。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "等一下，你這……是在學我嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "佩佩向左邁出一步，下一刻，古屍也照著她的樣子邁出一步，步伐相差無幾。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然，佩佩向後一跳，古屍也跟著往後一跳，但後面就是牆壁，撞出好大一聲。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "噗嗤——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "看來你是光會動手腳，腦筋是一點也不會動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "等等，如果我們動作一致，那豈不是……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "看向一旁昏睡的阿娜特，佩佩心中有個念頭冒了出來。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "哎呀，好……馬上就要到館長辦公室了，你好好學我，轉彎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "（向右轉）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "得讓它把阿娜特的肩膀抓緊點，剛剛差點就掉下去了，這樣……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "（動動右手）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "（捏緊阿娜特的肩膀）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "（無意識地皺眉）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "好，接著跟我走……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "（無意識的呻吟）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不不，不行，它步伐邁得太大可能會讓阿娜特不舒服……我們這次邁小步一點啊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "就當你答應了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "這不就對了……\n哎呀，不不不——！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "因為步伐太小，佩佩看著古屍踩到自己長長的衣擺，向前倒去，狠狠砸在嬌小的阿娜特身上。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "（無意識的悶哼）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "這臉上的紅印要什麼時候才消得下去……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "唉……你還真是腦袋不靈光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "冷靜，這次要抱穩她，抱緊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "（無意識地皺眉）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "來，跟我一起走，步伐不要太大也不要太小，很好……往前走……再走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "對，不要著急，我們慢慢來，離辦公室就差幾步了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "側過頭，佩佩看到冰冷的地板上躺著一枚通行證，正是從自己的口袋掉出來的。\n她看了看舉起的雙手，又看了看古屍抱住阿娜特的雙手。\n那具古屍很高，如果對方鬆手，阿娜特的後腦勺一定會摔得很慘。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "這要怎麼進辦公室……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "一隻手都鬆不了啊……只能用腳去撿了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "（伸出一隻腳）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "（伸出一隻腳）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "很好，保持平衡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不行，還是搆不到，柔軟度太差了，早知道就不翹掉體育課了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "加油，你可以夠到的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "可惡啊……唉——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "儘管已經拚盡全力，但佩佩的腳尖依然搆不到近在咫尺的通行證。\n而擺出扭曲姿勢的她也再無法保持平衡，腳下一歪，便摔倒在地。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "屍體也學著她的模樣，鬆開了阿娜特，以相同的姿勢倒在地上。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "就這麼眼睜睜地，佩佩看見阿娜特的腦袋砸向地板，發出悶聲。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "text": "（無意識的哀鳴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "……對不起，阿娜特，你下個研究計劃我一定全力支持。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "女士，請問您需要幫忙嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "啊，謝謝，你能來真是太好了，你們的館長身體不適，可以幫我把她扶進辦公室嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "女士，我將館長放在沙發上了。您的姿勢看起來非常彆扭，真的不打算站起來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不用，這是我舒展筋骨的特別方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "呃，那展品呢，也需要我幫您搬進去嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "不用，我自己一個人搞得定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "好……您有需要再隨時叫我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "呼……終於能動了……差點被發現。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "看我幹什麼，一起進來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "娜仁圖亞，好消息……目標位置確定了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "是的，我剛剛在四號展廳附近遇到了她，幫她將昏迷的館長搬進了辦公室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "我確定，她就在辦公室中。裡面除了昏迷的館長外只有她一個人，我拿到了她的通行證。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "好的，沒問題，我就在這裡等你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "吉雅阿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "呃，梅捷緹克緹女士，我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "博物館裡都亂成這樣了，你怎麼還在這裡閒逛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "我們馬上就要閉館了，快將這些迷路的遊客帶出博物館。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "到底發生什麼了？我們現在要去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "我們會有危險嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "諸位請放心，只要跟好我們的員工，她會將你們帶到安全的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "可、可是……我還有其他的事情……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "好吧，那我——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "——危險！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "我、我們有危險？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "是誰把雲獸放進博物館的？館內禁止攜帶寵物！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "呃，我沒看到雲獸……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你的工作疏忽我們等會再討論，我先去抓牠。人這麼多，牠會被踩到的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "……看來只能由我來帶遊客離開了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "（小聲）算了，應該來得及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "諸位，請跟我來吧，這邊右轉就是安全出口。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "等等，這不是左邊嗎……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "她都是這裡的員工了，應該也不會有錯吧……喂，小姑娘你別走那麼快啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一扇沉重的展廳大門被推開又合上。\n沒有人想起它應該開著，沒有人擔心它被隨意推開，也沒有人來維護門上寫著“東北部分支展廳”的銘牌。\n展廳肅穆寂靜。\n阿斯帕齊婭的心臟劇烈地跳動起來，幾乎蓋過她小心翼翼的腳步聲。\n經過覆滅部族灰黑的界碑石，五色線的謝拉格織毯，她的視線投向展廳昏暗的深處。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……終於。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我們的歷史就在此處靜靜等待著我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我應當承認，瞻仰歷史，正是要有這樣莊重寧靜的氣氛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "唉。在我面前展開的畫卷，是哪一座覆滅神殿的浮雕牆？如此潔白無瑕的石材，取自米諾斯的哪一座山峰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "還有用文物堆砌出的家庭一角，對古代米諾斯生活場景的重現，多麼精彩的想像力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "只是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "這一切都弄錯了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "因為我認得你，曾擺放在神殿正中的金杯。許多年前，我的外祖父來這裡看過你，我的母親亦然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我的家族曾因為遺失了你而受苦無數。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……這座博物館為什麼把它放在裝發酵乳的陶碗中間？無論依據材質還是裝飾風格，都應該能判斷它們不是成套的物品！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "與它成對的另一隻金杯又去了哪裡？當年薩爾貢人將它們全部擄走，為什麼不知道妥善保管？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "甚至展品介紹也——",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "她久久地凝視展籤，繼而將金屬片從牆上拔下，檢閱背面。\n無論哪一面都無比光滑平整，只映出她自己的影子。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "抱歉，這個只是沒寫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "——但這些文物出現在這裡，才是最大的錯誤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "百餘年前，米諾斯人受盡屈辱，看著薩爾貢的軍隊踏入米諾斯的領土，肆意踐踏我們的文明與歷史。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "本不該如此……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我必須拿走它們。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "諸位，順著階梯往下，你們就可以順利離開博物館了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "那個，我還有事，先走了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "我還是感覺哪裡怪怪的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑惑的遊客",
      "text": "來的時候我們走的好像不是這條路啊……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "她是這裡的員工……應該不會錯的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "我們真的能從這裡出去，然後回家嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我應當帶你們回家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我應當把你們交給米諾斯的祭司，由他們進行研究，由他們保存。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿斯帕齊婭莊重地走向展台，捧起金杯。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "米諾斯的諸多文物就不該躺在這間不見天日的展館中，不受重視，無人問津。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "別擠，別擠啊！我都看不到前面的路了，安全出口怎麼連指示地燈都沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "喂，那邊有個工作人員在擺放展品，她看起來比剛才的人可靠！趕快問問！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "你們是來參觀——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "——請問這裡是離開展館的路嗎，女士？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我有什麼可以幫上你們的嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
