{
  "server": "tw",
  "storyId": "main_13_level_main_13-03_beg",
  "groupId": "main_13",
  "stageId": "main_13-03",
  "title": "傭兵一日",
  "storyCode": "13-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_13-03_beg.txt",
  "sourceHash": "e65c9a8dde7ceb0a5004335969b116c89346f0e63d2e072b3652b217c67c047d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "將軍，市長死了。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "你的佩劍上還沾著血。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "希望軍事委員會的劍和傭兵的劍一樣順手。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "只要是武器，都沒什麼區別。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……了解。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "僱傭兵剛剛發來消息，參與策劃刺殺攝政王的十四名議員已經被逮捕。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "其他的議員什麼態度？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "他們沒有態度。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "我原以為你的做法會更直接。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "如果軍事委員會需要，我會立即處決所有議員。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "對於現在的處境，這就夠了，飛空艇的建造還沒有完成，我們還需要一點額外的耐心。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "把你的人撤下來吧，食腐者之王閣下的軍團到了。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……軍團？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "什麼時候？怎麼做到的？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "卡茲戴爾的部隊無論從什麼方向進入維多利亞，都必然會穿過大公爵的領土，無論怎麼隱藏，這麼大的一支部隊都不可能——"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "閣下已經抵達倫蒂尼姆近郊，直屬他的兩支整編王庭軍已經在城外駐紮。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "我明白了。我會命令僱傭兵撤出。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "那位萊托中校已經和攝政王殿下談過，接下來，他和他的城防軍會接管倫蒂尼姆的所有行政事務。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "表面上，因為“駐軍叛亂”，倫蒂尼姆會進入城防軍主導的半軍事管制狀態。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "這恐怕瞞不住大公爵們，他們在城內的情報網很發達。在接下來的幾個月內，他們一定會開始戰爭動員。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "不會那麼久，最快的一支部隊很可能在二十天內出現在倫蒂尼姆的城牆之下。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "但不用擔心，無論最先抵達的是誰，他們都不會輕舉妄動。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "任何膽敢單獨進軍的公爵都會成為其他所有人共同的敵人，就像兩年前溫德米爾公爵的那次失敗的奔襲一樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "她的高速軍艦甚至沒有成功開出自己的駐防地，就被自己人攔了下來，真可笑。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "溫德米爾公爵……她是一個敏銳的人，她在攝政王剛與維多利亞有所接觸時，就一直在警告議會。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "邀請我們進入倫蒂尼姆的不僅僅是卡文迪許一位。所有公爵都希望攝政王殿下能作為“軍事附庸”幫他們處理一些棘手的問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "懂嗎？這位溫德米爾公爵也不例外。鐵腕軍人的身份背後，依然遵循著王公貴族們的遊戲邏輯。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "她只是最急著把我們放回工具箱的那一位。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……我聽說，維多利亞威名赫赫的蒸汽騎士，已經不復存在了。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "你很會打探消息，赫德雷。對軍人來說，這不是一件好事。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "我是個僱傭兵，將軍。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "攝政王和軍事委員會的謀劃很成功。匪夷所思，薩卡茲竟然真的在維多利亞的首都站穩了腳跟。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "公爵們需要一支容易切割的部隊來彈壓異己，議會也同樣急需一支“恰當”的防衛力量，以免再有人效仿那兩位愚蠢公爵的軍事冒險。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "在他們看來，剛結束內戰不久的薩卡茲就正巧適合，開袋即食，用完即棄。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "如今，我們控制了工業區，控制了議會，乃至碎片大廈也很快就能被我們掌控。攝政王真的拿下了倫蒂尼姆。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "但是我們搬不走這座城市。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "我們可以挑起紛爭，然後呢？跟著倫蒂尼姆一起被其他國家的聯軍埋葬？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "軍事委員會的計劃到底是什麼？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "傭兵的問題也很多嗎，赫德雷？是不是我太過優待你了？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "我只是需要知道任務目標是什麼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "我所認識的傭兵，更喜歡打聽哪裡的雇主更大方，思考怎麼搶劫薩科塔的商隊。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……只是個人習慣不同。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "“個人習慣”。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "你的眼睛還好嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……會稍稍影響揮劍時的距離判斷，我會盡快克服。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "我收到了你的審訊記錄，刺客是一名叫伊內絲的女人，也是僱傭兵。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "我們確實沒有預料到，伊內絲這樣的薩卡茲會被議會買通，刺殺攝政王。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "伊內絲死了，你為此瞎了一隻眼睛。你會獲得軍事委員會的嘉獎。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "我並不需要嘉獎。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "那你會獲得報酬，像個僱傭兵一樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "畢竟你和伊內絲，還有個代號W的瘋子，你們領導傭兵小隊活動了很久，疤痕商場的老薩卡茲對你的評價很高。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "殺她，你很果斷。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "傭兵就只會這樣生活，為了活下去，我們什麼都會做。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "哪怕殺死同僚？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "哪怕殺死同僚。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "那你總有一天也會來殺掉我。是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "你剛才問我，軍事委員會的計劃到底是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "我們的計劃只制定到戰爭爆發，接下來的，就是……他們的計劃了。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "這裡是仇恨的中心，這裡也會被仇恨埋葬。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "一如你寫的那些小冊子，一如我們經歷的所有戰爭。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "您原來……"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "沒什麼。繼續寫下去吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "text": "任務很重，你要承擔起責任。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "記完你的筆記了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "不，我什麼都沒寫。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_npc_393_1",
      "text": "我只是重新打磨了下這把劍，僱傭兵的重劍……我已經很久沒用過了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "你可真絕情。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "如果你想要的話，我可以轉贈給你。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "劍？效率低，沒興趣。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "唉……你居然還抽空修了修頭髮？"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "也是，接下來你可沒有時間像在倫蒂尼姆那樣，每天給頭髮抹護理膏。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "只是這樣更方便。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "你該留著那套衣服，說不定可以繼續扮演飽受將軍器重的傭兵領袖呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "軍隊裡的人是怎麼說的？服從是天職？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "僱傭兵的天職是拿報酬，別拿撫恤。好了，你們兩個省點口水吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "這裡是防線偵察範圍的缺口嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "在還沒打起來之前，是。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "至於現在嘛……他們都開始進軍了。就算公爵們的關係再差，這條陣線合圍也是遲早的事。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "你確定你說的那個人會從這裡走？從這個位置可還能看見碎片大廈那一炮的天災雲呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "天災的落點是威靈頓公爵和食腐者之王交戰的前線。鐵公爵恐怕會收縮陣線。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "至於溫德米爾，在她把她的女兒送回移動要塞之前，恐怕沒有餘力馬上部署自己的兵力。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "那個人要從倫蒂尼姆離開，能選的路線可不多。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "等等。來了。"
    },
    {
      "type": "narration",
      "text": "陰影的速度很快。像是……\n呃，多邊形的……線團？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "多邊形線團？"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "形狀總體呈多邊形，但很不規則。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "是源石技藝，用肉眼是幾乎捕捉不到的，否則她也來不了這裡。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "確認目標。只能粗暴一點了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "W——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "唉……跟上！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "……僱傭兵？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "很巧。非常巧。那就追上來吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "奇怪的感覺就在這附近才是。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "人跑了？我就說，炸彈炸不死巫妖。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "不，還在附近。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "我們得追上她。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "情況不太對，我們剛才沒有到過這樣的區域。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "……這裡的東西都沒有影子，幻覺？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "好像有群大個子，就在山下。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "……好誇張的劍，這些人怎麼舉得動的？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）那座灰白的城市就在前面了，加把勁。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）那裡會收留我們，土石之子們已經在哀愁之地修建起了城牆。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）卡茲戴爾，每一個音節都是一段苦旅。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）它在哪裡？我們從夢中離開，尋覓至此。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）流亡時代已經結束了——"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "他們在說什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "……很古老的薩卡茲方言。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "“哀愁之地”，“灰白的城牆”。別的聽不太懂，只能猜。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "好像還提到了卡茲戴爾？哪一座？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）譴罰氏族的炎魔霸邇薩，遊俠領主奎隆都在接我們的路上了。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）哦，還有他也在這裡……"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲旅人？",
      "speakerId": null,
      "text": "（古老的薩卡茲語）戈瀆，“魔王”——"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "這些影子所訴說的，是第二座足以被稱作城市的卡茲戴爾。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "在最初的卡茲戴爾被神民和先民們摧殘殆盡之後，上千年的時間裡，卡茲戴爾都不過是籬笆和茅草堆積成的小小聚落。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "脆弱，易毀，在殖民者的意志下，被一次又一次蹂躪，薩卡茲們也一次又一次流亡。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "直至此刻，薩卡茲又一次累積了力量，又一次重建……一座真正的城市。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "他們離開如今被稱為哥倫比亞的那一片荒原，來到泰拉的腹地，以此為生，以此為死。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "然後……是背叛。是又一次東遷。沒走出多遠，青色的怒焰再一次遭到背叛。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "薩卡茲的歷史彷彿自那時起就被詛咒了一樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "歷史奔騰往復，直到今天，不斷毀棄和重建的城市依然在這附近兜兜轉轉。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_869_1",
      "text": "而他們口中的這些名字，是那座城最初的幾位魔王。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "七千年前的，魔王們。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "你們——"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "你們是怎麼弄出這些東西的？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "鑑於這一座卡茲戴爾的歷史意義和對後世的影響，這些魔王的傳說確實傳唱甚廣。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "但這些流浪者？就連我們也沒有這麼細微末節的……呃，記載。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "這甚至不是巫術……絕不是巫術，任何源石技藝都沒辦法達到這樣的效果。唔，也不好說，但至少得是個歷史學家。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "那是物理手段？利用霧氣成像的投影儀？那對兄妹什麼時候有這種技術了？藏私可不好！"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "嗯……也不太對。這些畫面太接近記載的真相了，就算是技術手段，哪來的資料呀……"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "那這確實是某種法術……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "但不屬於已知的任何源石技藝範疇……甚至很有可能，不是源石技藝。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "很奇怪——巨獸嗎？維多利亞要是想馴服巨獸參戰，早該動手了吧……"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "這女人在幹什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "看來你們不是施術者。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "你們只是單純炸了我心愛的小方塊。坐在裡面很舒服的。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "巫妖王庭的信使，埃芒加德女士，很抱歉用這種方式和您接觸。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "……我不知道你們對巫妖是不是有什麼誤會，我真的沒那麼老。別這麼畢恭畢敬。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "speakerId": "avg_4088_hodrer_1",
      "text": "這恐怕也並非您的法術。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "我可沒這樣的本事，變出一群七千年前的流浪者出來。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃芒加德",
      "speakerId": "avg_npc_869_1",
      "text": "嗯……如果用法術刺激一下會怎麼樣呢？就用最基本的，一些小小的、一般的能量刺激……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "……這是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "這片區域我三天前確認過，那時候可沒有這些東西。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "speakerId": "avg_4087_ines_1",
      "text": "你們……喂，赫德雷，W，你們怎麼了。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
