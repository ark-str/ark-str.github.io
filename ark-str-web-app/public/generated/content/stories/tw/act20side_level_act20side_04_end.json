{
  "server": "tw",
  "storyId": "act20side_level_act20side_04_end",
  "groupId": "act20side",
  "stageId": "act20side_04",
  "title": "“大水坑”",
  "storyCode": "IC-4",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act20side/level_act20side_04_end.txt",
  "sourceHash": "752da2fe97e63ac0041a0e75420a4ea45e48d7ceaacbdb63f8923f5e7870217e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "根據大家表決的結果，陪伴了我們半年多的“大水坑”即將完成它的歷史使命。它會被爆破拆解，重新回歸為工程材料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "市民們，這場稍微延長了一點的夏日狂歡恐怕即將結束了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "嗚嗚嗚，我會永遠記得這段美好的時光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "超級旋轉大滑梯真是怎麼玩都玩不夠，居然就要和它告別了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "不過！取代“大水坑”的，會是更新的，更美的，更不一樣的建築！！畢竟這裡可是際崖城，是最棒的建築設計師們締造的城市！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "斯第奇·畫布和卡奇·敘光是際崖城新生代裡最引人矚目的建築設計師，他們會在未來的幾個月裡交出自己的設計方案......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "到那時，又會是一場怎樣的強者對決呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "呼呼，簡直讓人想起幾年前，他們初露鋒芒的時候，圍繞著穹頂的那場競標大賽！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "當年的穹頂之爭沒有勝利者，那麼這次，誰會取得下一個際崖城地標的設計權呢？讓我們——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "我先喝口水。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "克羅綺，你今天這個狀態，不會是喝了酒來的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "暫時沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "這風格可不像你啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "依娜姆給我看的錄影裡，地上的比賽中有一個職位叫做主持人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "我打算拓展一下職業路徑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "總之！建築設計師們的設計雖然暫時還等不來，但是，市民們，這個夏天的尾巴可是稍縱即逝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "就讓我們在滑梯消失前的最後時間裡，去玩它個爽吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜林人",
      "text": "哦！！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉維爾！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "特米米，小心！你慢點！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "之前你們在阿卡胡拉的大瀑布玩水，我聽說了以後可是羡慕了好久呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘿嘿，這次我也可以加入啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "你這孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "嗯？平常你都小心翼翼地藏著尾巴，這麼一看，是不是又變粗了點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "欸？才沒有！我來之前才剛用卷尺量過！已經好幾個月沒有變粗了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "哦，看來真的很在意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗚嗚嗚，看我的潑水攻擊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "很大膽嘛！來就來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "她們似乎比你更像杜林人呢，斯第奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "你也未必知道什麼叫“杜林人”，魯珀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "你好像有點緊張，在擔心和卡奇的競標嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "擔心他？笑話！我還沒淪落到擔心比不過卡奇的境地。不過是他的方案一向比較招外行人的喜歡罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "也有些人是比較看好我的方案的，或許我該拿出點不同的風格，好贏過那傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "要不然乾脆......唉！現在還是別想了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "......說實話，如果不論美學，僅從可玩度上而言，這“大水坑”也還算湊合吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "原來你也會享受這些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "偶爾的話。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "斯第奇，你在這啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "想不想感受下流速全開滑梯的威力？因為會對設備有損耗，平常可沒這機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我剛和極境哥試了幾次，那種速度感！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "不過掉進水裡的時候會有點疼，你要不要試試？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "不用，我對這種玩法可沒有一點興趣......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "喲吼，小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "卡奇老弟，這衝擊力，沒的說！水花居然能濺這麼高！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我們要不試試換種玩法，比如說......比誰的水花小？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "壓水花？好思路！聽起來不會那麼疼了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "我的沙堡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "（卡奇老弟，我們是不是惹禍了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "（呃，就算是斯第奇，也不至於為了沙堡生氣吧？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "（可他看起來就是生氣了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "（要不然我們......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "就這麼跑了？你們兩個，給我回來！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "嗯，情緒調動相當不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "這都是我學習的成果，感謝這些錄影帶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "接下來，我們可以用一系列的比賽，維持住“競賽”這個概念的熱潮，再借著幾個月後卡奇和斯第奇的競標，把氣氛推到最高點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "我們是不是可以印發一批小紙片，讓觀眾們可以借此表達自己對某一方的支持，最後如果猜對了會有點獎品之類的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "我們管這東西叫獎券，克羅綺你真是無師自通。地上的商人們可是把這東西當做自己斂財的手段呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "杜林人對這樣賺錢可沒興趣......不如讓輸的那一方承包勝利者一個月的酒吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "唔，刺激一點承包兩個月也行。這個可以由投票決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "然後關於輸幾個月酒的競猜或許也能再發一批獎券......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "......我開始擔心際崖城市民的未來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "唔，這種其實沒派上什麼用場的感覺真是難得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "怎麼？你一定得揍些什麼才滿意？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "也不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "不過，如果順利的話，阿卡胡拉能收獲些杜林的技術，這就不算白回來一趟了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉維爾雖然很早就離開了家，但其實還蠻關心阿卡胡拉的吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "嗯，就算看過了各種各樣的地方，還是雨林裡最讓我安心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "那你會回來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "暫時還沒這個打算。我在羅德島上還有病人呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "相當多提亞卡烏希望你回去，你甚至可以考慮成為王酋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "他們還希望地上會直接長蕉果。這片大地總不會遂了每個人的願。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "嘉維爾，你來擔任阿卡胡拉的王酋是最合適的，只有你才能鎮住所有提亞卡烏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "所有人都在期待著你的回歸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "而如果你實在不願意，那麼，最後結果可能會變成薩爾貢宮廷派一個王酋來管理阿卡胡拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "到時候，阿卡胡拉一定不會再像如今這麼自由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "依娜姆，不是還有你這個大酋長嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "......不，有些事情我是沒辦法做的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "我可以想辦法幫大家從外面倒一點破爛回來。但真正能夠把提亞卡烏緊緊擰成一條藤蔓的，不會是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "依娜姆，我也並不是在逃避責任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "只是，我還沒想好怎麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "嘉維爾居然在“想”，真難得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "喂，祖瑪瑪，想打架嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我的意思是，嘉維爾一般都是做了再去想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "關於我自己，或許可以。但如果關於這麼多提亞卡烏......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "該結束的總會結束，不是嗎，就像是這大滑梯一樣，拆掉，然後會建新的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "其實我剛才沒聽見你們在聊什麼啦，我只是想說，朋友們，趁它還沒消失，我來給你們拍張合照吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "哈哈，也好，複雜的東西暫時放到一邊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "眼下先要盡興！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "特米米，你也笑起來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "看來你們已經學會杜林人的哲學了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "畢竟休個假可不容易，怎麼能浪費呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "說得好，我該敬你一杯！想嘗嘗漿果番茄酒嗎？我請。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "不，這個還是算了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "嗯，消失得很輕盈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "我還以為你會喝得爛醉如泥，然後錯過目睹這玩意被炸掉的美好景色。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "哈哈，我只是比較擅長享受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "但是，在這種時候，我更傾向於保持清醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "這是我對正在消逝之物最基本的尊重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "哇哦，難道你其實是個深藏不露的聰明人？這種人設就算是在際崖城的圖書館藏書中也算是爛俗了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "你這小子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "斯第奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "......卡奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "接下來就是要動真格的了，我們公平競爭，各憑本事吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "不介意的話，握個手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "......好吧，出於對另一位際崖城公民最基本的尊重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "我說，你們是不是其實關係蠻好的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "你用哪隻眼睛看出來的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "接下來就是要動真格的了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯第奇·畫布",
      "text": "......克羅綺什麼時候又喝上了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "預熱的預熱，前奏的前奏，際崖城大競技系列第一季！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "恰卡恰卡恰卡恰卡——咚咚！游泳大賽！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "幾位，有沒有興趣？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
