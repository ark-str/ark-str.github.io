    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "60_g8_rhodeslowerdeck_origin"
    },
    {
      "type": "narration",
      "text": "煌撓了撓頭，有些無助地看著迷迭香。"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "speakerId": "avg_017_huang_1",
      "isRemote": false,
      "text": "呃，小貓，這應該怎麼處理？"
