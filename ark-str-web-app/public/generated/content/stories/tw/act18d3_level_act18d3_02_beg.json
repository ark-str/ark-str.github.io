{
  "server": "tw",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "歌手",
  "storyCode": "SV-2",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "50d6ed4755bd04a80b701ebfebfb008792866ffb8e97a59e26e20e31c86e9a71",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "3:23 P.M. 天氣/陰\n伊比利亞，鹽風城"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "地圖上的地方，就是這裡。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "......空氣中的味道，算不上好。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "你好。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "請問——"
    },
    {
      "type": "dialogue",
      "speakerName": "另一個男性居民",
      "speakerId": null,
      "text": "（垂頭不語）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "......怪物？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "都是人類。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "（伊比利亞語）"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "現在不這麼說了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "（口音稍變的伊比利亞語）"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "......況且，我現在是歌手。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "歌手不這樣做事。何塞先生說的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "九十九......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "有人在說話。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "九十九。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "一個......孩子？他在念一個數字。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "我不會聽錯。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "你——"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "我的項鍊被......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "你不能走！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "speakerId": null,
      "text": "九十九，九十九......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "你跑不掉。"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "speakerId": null,
      "text": "嗚......嗚嗚......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "為什麼偷我東西？為了把我帶到這裡？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "嗯？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "一個坑，幾條繩。外面的埋伏至少比這像樣得多。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "你們，出來吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "我本來也找你們有事。麻煩快點。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "她很古怪。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "是的，鐵皮，這樣的人，我沒見過。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "我也沒見過。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "原來你們會說話。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "你是誰？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "流浪歌手。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "流浪歌手，我不知道是什麼。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "鐵皮，不要跟她說話。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "你的臉，陌生。你的打扮，奇怪。你不是這裡的人。你來做什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "我想問一個問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "你的衣服，很新。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "你見過我的同伴嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "你很強壯。你能吃飽飯。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "她在我之前來的。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "你的箱子，很重。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "樂器都不輕。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "你手裡拿的，很怪。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "你們這裡的琴，長得也差不多吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "（撥琴）"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "耳朵，難受。是武器。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "可以不是。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "鐵皮，這人，怪。不要理她。說話，好累。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "長凳。你放開。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "長凳......你是說這孩子？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "我沒想對他做什麼。他拿了我的一樣東西。那樣東西，很重要。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "你是來搶東西的。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "我只想拿回我的東西，並且找個能聽懂我說話的人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "speakerId": null,
      "text": "嗚......嗚嗚......"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "我們的孩子，你不許碰。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "我們的東西，你不許搶。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "我們的規則，不許打破。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "鐵皮，你越走越近了。你想做什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "她要傷害我們的孩子，搶我們的東西，破壞我們的規則。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "她不是我們的姐妹嗎？是的話，也有她的一份。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "她一定不是。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "......你們聽不懂我的話。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "我去問別人。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "不許走。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "等等，鐵皮......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "哎呦！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerId": null,
      "text": "這、這裡有個坑。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "木框的坑。你忘掉了。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": null,
      "text": "哦，原來真的有用。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerId": null,
      "text": "外面來的人，我們的地方，你不應該來！"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
