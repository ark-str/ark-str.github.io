    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "speakerId": "avg_npc_196_1",
      "isRemote": false,
      "text": "你用什麼來抓我，前，龍門特別督察組組長，陳暉潔小姐？"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "speakerId": "avg_1013_spchen_1",
      "isRemote": false,
      "text": "用公道。"
