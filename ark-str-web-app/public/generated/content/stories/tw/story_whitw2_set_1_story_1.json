{
  "server": "tw",
  "storyId": "story_whitw2_set_1_story_1",
  "groupId": "story_whitw2_set_1",
  "stageId": null,
  "title": "氣味遊戲",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_whitw2_1_1.txt",
  "sourceHash": "5e013b073464d88a0926945976373661ccb476cdf3f2ef3566c615cfec7f49d5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "瓦古，你也來了……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "我的嗅覺應該比你差嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "我的意思是，看來我們找對了地方——那個東西就在這間病房內。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "狼群搜遍這艘陸行艦的每一個角落，只為了找拉普蘭德不知什麼時候弄丟在哪裡的信物……你不覺得滑稽嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "別抱怨了，凱撒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "頭狼有資格驅使狼群做任何事情，這是我們共同的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "趕快結束這一切吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "那是，你的獠牙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "……紅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "（輕微的鼾聲）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "（痛苦的囈語）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "拉普蘭德的氣味……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "紅緊握的那把匕首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "拉普蘭德弄丟的信物，怎麼會是你獠牙的匕首？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "哼，哪怕成為了頭狼，白狼終究只是個幼稚的人類。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "喂，扎羅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "剛剛那陣煙塵，只是野生馱獸為了躲避羅德島鬧出的動靜，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "荒野就在眼前，何必問我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "耐心點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "這不像是你會說的話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "一艘偶然偏航的陸行艦短暫闖入荒野的深處，和那些漫遊的神秘存在擦肩而過，我們因為恰好在甲板上，得以和其中的個體打個招呼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你知道為了幫你們和你們的同類安排這麼一場別開生面的會晤，我費了多大力氣，幹嘛要急於一時？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "你原本沒有必要折騰這些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "我們可以直接去到龍門，或者阿卡胡拉，那幾個傢伙的行蹤更好掌握。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哈哈，扎羅，狼群確實越來越像人類了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "我當然可以約德克薩斯的老闆去聽地下饒舌，或者和那個叫鴨爵的傢伙相會在賭桌上，還在敘拉古時，我沒少做這樣的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "但他們這樣的在獸主裡只是少數，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "如果所謂的“危機”真的那麼可怕，你的第一反應竟然是找到同樣泡在人類社會裡的同類，然後像人類那樣湊在一起開會？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "叫其他狼回來吧，再過不久，你們的那些同類就會經過這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "凱撒還在幫你找信物……等等，你沒有弄丟信物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "根本沒有所謂的信物，扎羅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "那……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "你故意讓凱撒見到那個被她拋棄的獠牙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哈哈，我可沒說。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅看見了，外婆……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "她沒有醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "你只是靠近，她仍在睡夢中都會情不自禁地顫抖……這個孩子對你的恐懼已經深入骨髓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "夢境……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "停止你無聊的惡趣味，凱撒。我們拿了匕首走就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "那把匕首，是我送給紅的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "那個孩子剛懂事時，我找來一支獸牙，教她將其打磨成最鋒利的匕首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "什麼意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "還不明白？拉普蘭德故意支使我來到這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "她希望我拿回這把匕首？不，她希望我抹除這個人類的恐懼和痛苦，她希望我消弭我之於這個人類的影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "嗯，這不像拉普蘭德的作風。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "幫一幫可憐的同事，或者向自己正掛靠的醫藥公司示好……她的心思不難猜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "所以我說，哪怕成為了頭狼，她終究只是個幼稚的人類。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "在這裡等著，瓦古，我很快就結束這無聊的“任務”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "紅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆……真的是你……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "除了外婆，還能是誰呢……真是個可憐的孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "嘖，自從我登上這艘船，這是你第五次跟蹤我了，紅幹員。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "味道……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅聞到了熟悉的味道，從你身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "如果你說的是狼味，我身上可不只一種。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆她來了這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "你是外婆找來取代紅的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "聽起來，你想殺了我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "如果博士和你那個愛藏在煙霧裡的上司不追究，我倒是很願意活動活動筋骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "不……紅不要和你戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅不知道怎麼解釋……外婆找上你，你會像紅一樣，到最後，被……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哈哈，感謝你的關心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "……你在發抖，紅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆對紅說，說……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅和被紅殺死的那些傢伙一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅只是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "只是為她贏得了一場索然無味的勝利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅聽了外婆的話，紅沒有聽凱爾希的話……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅做了一件錯事，一件又一件錯事……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅既是獵狼人，也是真狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅的心，很亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "（痛苦的嗚咽）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "紅，你恨那隻狼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你想要忘記她嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "別怕，這裡是羅德島，你的羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "我非常願意幫你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "就是這樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "就是這樣。凱爾希不在島上，你說我怎麼能置之不理呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "拉普蘭德，你希望我誇你熱心，還是誇你善良？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "扎羅，你希望我認為你諂媚，還是認為你陰陽怪氣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆，這次你要去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "外婆沒有要離開，外婆在等你跟上來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "紅色的幼狼無意識地抬了抬腳，但她很快反應了過來，最終沒有動。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "別懷疑，孩子，你覺得外婆還有欺瞞你的必要嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "你的疑惑、你的痛苦，外婆都會給你回應。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "過來，來外婆身邊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "熟悉的聲音、溫柔的語調，微風吹過草地，颳起泥土裡隱隱的腥味……很安全。\n彷彿一切從來沒有改變。\n良久。\n幼狼終於還是情不自禁地邁開了步伐。"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "這是夢嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "是夢，也是真實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "跟上就好，紅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "為什麼不說話？以前每次分別後重逢，你都會纏著外婆問東問西……儘管連話都說不流利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "我知道了，你心裡有恨，你責怪外婆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……外婆欺騙了紅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅信任外婆，外婆不該。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "若說“不該”，孩子，你我之間不該有這些無聊的情感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "畢竟，你也欺騙了外婆，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "狂歡節的那個夜晚，你沒有真正殺死阿涅塞的獠牙，那個幼崽叫什麼名字來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "子、子月。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "你留了一手，你想要試探外婆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "那是因為……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "狼主確實會折斷獠牙，但母獸不會遺棄她的孩子，儘管謊言是她給的襁褓，但荒野中生命的關係總會因純粹而牢靠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "但羅德島上的人也好，那個裁縫也好……他們並不理解荒野，你卻輕易聽信了那些說辭，你讓我們的關係有了裂痕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "真相已經不重要，遊戲的輸贏已經不重要……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "如今這一切，是外婆應受的屈辱，也是你應受的懲罰，孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅記得這裡……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "外婆說過，這是夢，也是真實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "這簇草叢……外婆教紅隱藏氣味，安靜等待獵物……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "這棵樹……外婆教紅製作陷阱，把它藏在枯葉下……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "那邊，那塊石頭……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "你曾在上面打磨獸牙，直到它變成鋒利的匕首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "我們剛剛路過的每一片樹林、每一個山洞、每一具骨骸……都是你的來路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆在帶紅往回走……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "我們會在哪裡停下來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "你會知道的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "你還在想剛剛的話嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅必須想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅的心很亂，紅想不明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "老實說，雖然漫長的歲月裡，狼主間的遊戲已經更迭了無數輪，但你仍是我最為特別的獠牙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "唯有你，真正在以狼的方式生存，以狼的方式思考，儘管留在了這艘陸行艦上，也永遠無法真正融入人群……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "你太純粹，你無限接近於，真正的狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "真正的狼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "所以，孩子，忘記外婆剛剛說的話吧，忘記我們彼此間的仇恨與責怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "因為這些情感對你來說太過複雜……因為這並不怪你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "我們終於到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "這、這是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "這是你我相遇的地方，外婆在那邊的草叢裡撿到了被遺棄的紅。那天晚上暴雨如注，你的哭聲差一點消散在雨裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "這是此行的終點，也是一切的起點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "外婆會燒掉那個草叢，然後，我們剛剛途經的一切便將不復存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅不理解……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅會忘記外婆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅會忘記和外婆有關的所有事情？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "你將忘記我帶來的困惑、痛苦和哀傷，彷彿我從未存在過……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……紅不會再做惡夢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "沒錯，真是個聰明的孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沉默。\n紅色的幼狼低著頭，緊握著的手骨節發白，她沒有再說話，看起來極為痛苦。\n優雅的狼主沒有緊逼，她決定給幼崽一點時間，儘管……自己的耐心早已所剩無幾。\n終於，幼狼抬起了頭。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆，紅不願意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "紅，你恨那隻狼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你想要忘記她嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "別怕，這裡是羅德島，你的羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "我非常願意幫你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅不知道……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "不知道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "那就說明你不想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅不想？沒有人教紅該怎麼處理……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你的直覺很準，紅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "背叛和欺騙編織了你的人生，痛苦讓人想要遺忘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "但忘記是沒有用的，那等於抽了筋扒了骨，將自己變成一具空殼……那是更殘忍的暴力，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你熟悉荒野，惡夢同樣能幫助你活下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "嗯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哈哈，我突然有個主意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅不需要忘記。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "外婆告誡過紅，紅記得外婆的話……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "必須牢記仇恨，盯緊仇人，紅才不會迷路，才揮得動刀……紅才能夠活下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅以前為外婆報仇……報不存在的仇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "text": "紅現在為自己報仇！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "紅跟腱發力，高高躍起，那是狼的狩獵技巧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "極短的一瞬，紅已經一刀將狼主劈成了兩半。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "神秘的黑霧散開，淋漓的鮮血沖刷著紅的身體，讓她看起來彷彿鬼魅。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "紅的手劇烈地顫抖，彷彿不敢相信自己剛剛做了什麼……她暈了過去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "但下一個瞬間，黑霧再次聚攏，狼主重新來到紅的面前。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "夢境給了你冒犯我的勇氣？但這一切毫無意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "既然不願意遺忘，那就帶著關於我的一切活著吧，讓惡夢疊加惡夢，讓痛苦纏繞痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "也好，也好……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "舊的遊戲已經結束，但我對拉普蘭德能為我們帶來多少新樂趣，並不像扎羅他們那樣有信心……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "就留你作為一個時代的烙印存在吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "但多半下一個轉眼，我就會將你徹底遺忘，幼崽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "畢竟，你和那些被我折斷的獠牙，其實沒有任何區別。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "瓦古，出來吧，我們該走了，這裡的氣味可真難聞。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "不對……這個氣味，不對不對……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "拉普蘭德，是你搞的鬼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "瓦古，我剛剛沒有聽錯吧，凱撒是不是質疑了頭狼來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "我身上，怎麼會有紅的氣味？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "是嗎？竟然有這樣的事情？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "我想想，剛剛到底發生了什麼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "紅用刀劃傷了你，你的血淋在了紅身上……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哈哈哈哈，難道說，你和你的獠牙交換了氣味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "這只是我賜予她的夢境！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "灼燒？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哈哈，好大的雨……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你指望這些方式能夠消除身上的異味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "沒有用的，我親愛的狼之主。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "阿涅塞告訴我，遙遠的歲月前，這片大地唯有荒蠻，狼群各自出沒，你們會透過交換氣味來識別、交流和標記領地……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你們以此合作狩獵，也以此獵殺彼此……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "直到生命終結，你們都無法抹除身上沾染的其他狼的味道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "紅的匕首……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "那把匕首確實是我的信物……它受到了“頭狼的賜福”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "阿涅塞，是你教拉普蘭德……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿涅塞",
      "text": "她不只問了我，我並不知道她要做什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "糟糕，我忘記了一件事……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "狼之主不死不滅，狼之主永恆存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "呃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "凱撒，看來。未來你只能帶著紅的氣味行走在這片大地上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "儘管你從未正視過這個獠牙，儘管你早已將她拋棄，但這份氣味會始終提醒你她的存在，讓你永遠無法將她遺忘……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "因為不死不滅，所以永無盡頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "（淒厲的呼號）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "當然，你也可以隨時報復我，這會為我的新遊戲提供一些靈感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "為什麼要做這一切？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "身為頭狼，你居然只是為了幼稚的同僚之情，而如此算計、羞辱自己的狼群？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你是說我只是因為同情紅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "嘖，幼稚的狼之主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "凱撒，我可不單單只是為了紅而羞辱你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "扎羅、瓦古、阿涅塞，還有那邊的幾隻……我希望這件事能讓你們警醒——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "狼群正變得越來越像人類。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狼之主們",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "原野蒼茫，蠻荒無序，我並不在意你們對人類或是同類有多殘忍……這本就是荒野的常態。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "只是凱撒，你連對獠牙殘忍的方式都像極了人類。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "欺騙、背叛、粉飾，扭曲認知，種下惡夢……你在玩弄最粗淺的權力，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "（嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱撒",
      "text": "（無奈的喘息）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "你們告訴我，那場所謂的“危機”已經近在咫尺，狼群需要接觸眾多同類……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "從薩米的雪原到玻利瓦爾的黑流樹海，從薩爾貢的黃沙到伊比利亞的鹽漠……習慣和人類廝混的獸主只是少數。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "那麼，我當然要向他們證明，新的狼群，將會更純粹。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "喂，拉普蘭德。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎羅",
      "text": "他們快到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "離開這個夢境吧，讓這個叫紅的孩子睡個好覺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "我們回甲板……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "狼群，該去赴荒野的約了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
