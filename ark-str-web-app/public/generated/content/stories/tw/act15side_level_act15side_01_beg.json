    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛絲",
      "speakerId": "avg_1021_kroos2_1",
      "isRemote": false,
      "text": "怎麼二話不說就動起手來了......"
