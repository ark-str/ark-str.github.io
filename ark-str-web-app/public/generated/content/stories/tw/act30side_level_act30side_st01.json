{
  "server": "tw",
  "storyId": "act30side_level_act30side_st01",
  "groupId": "act30side",
  "stageId": "act30side_st01",
  "title": "候車大廳",
  "storyCode": "RS-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act30side/level_act30side_st01.txt",
  "sourceHash": "f02f2db19d9ed969e76f3693513ba637acc2c3383d8eaacd0a5f29b828cc19ec",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "1100年冬，謝拉格佩爾羅契家族領地內，聖山腳下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "加快步伐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "別忘了我們是來做什麼的，後面的都跟上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "立定！靠攏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "原地列隊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "報告長官！第二小隊已整隊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "嗯，很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "第三小隊還沒有到？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "報告長官！還沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "長官，第三小隊那邊恐怕情況不妙……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "我們還等不等他們過來會合？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "不等了。我早料到可能會有這種情況，誰先抵達，誰就先一步發動攻擊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "關於接下來的作戰計劃，想必不用我再多說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "這是一場遠征，是屬於我們維多利亞人的戰鬥！是榮譽的戰鬥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "時刻保持警覺！不要小看任何一個敵人！這一仗……只能成功，不能失敗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "很好，保持士氣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "第二小隊聽令，繼續進軍！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "目標——山下牧獸老頭的酒館！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "領頭的士兵",
      "text": "絕對不能在酒量上輸給那群牧獸佬！這次一定讓他們輸得心服口服！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "是！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格平民男性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格平民男性",
      "text": "那群維多利亞人又在幹嘛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格平民女性",
      "text": "拼酒量吧？他們都跟萊利大叔他們拼了好幾場了，聽說這群人每次都喝到吐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格平民女性",
      "text": "耶拉岡德在上……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格平民女性",
      "text": "維多利亞人……平常都這麼閒，都沒事可做嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "唔……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "不好，這個不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "“卓默密”……嗯，好像還不錯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "尤卡坦，你說呢？你覺得叫“卓默密”怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尤卡坦",
      "text": "很好聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "哎呀，你就沒有別的評價了嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "之前我每次問你，你都這麼說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尤卡坦",
      "text": "……是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尤卡坦",
      "text": "可是，我真的覺得得你取的名字都好聽，露絲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "不行，你說了不算，我得再仔細考慮一下，這可是我們第一次……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "總之，我一定要選一個最好的名字！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "“卓默密”可以備選，“塔米亞斯”好像也不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "對了，我們還可以另外再取一個綽號，就叫……“小堅果”！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "毛毛躁躁，我在門外都能聽到你的大嗓門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "什麼“小堅果”？你這是在為你們未來的孩子取名？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尤卡坦",
      "text": "日安，大夫人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "我才沒有……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "你、你別胡說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "好了，不逗你們了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "耶拉岡德像已經建成，過兩天就是舉辦落成典禮的日子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "這段時間，我恐怕都抽不開身。領地這邊的事，你們倆多看著點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "交給我你就放心吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "就是交給你，我才放心不下，我的好妹妹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "呵，這次我可沒出岔哦，你罵不了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "尤卡坦，你老婆在外面該不會也是這副蠢樣子吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "尤卡坦",
      "text": "哈哈……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "隨你怎麼說！我告訴你菈塔托絲，這次我也有自己的安排！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "休露絲",
      "text": "一旦我這邊的事成，就連那個恩希歐迪斯也得欠我們布朗陶家一個人情，你就等著看吧！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "哦？\n那我就等著對你刮目相看了。"
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "我姑且相信你，不過還是要提醒你，謹慎一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "耶拉岡德像完工，維多利亞人的動向，還有恩希歐迪斯的計畫……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "呵，哪一件都不是小事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "這段時間……恐怕是要不太平了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "豈有此理！這群維多利亞人真是欺人太甚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "只要聖女大人您下令，我立刻就清點人手，保證把這群人趕出謝拉格！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "請冷靜一些，阿克托斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "維多利亞的隊伍是為祝賀耶拉岡德像落成而來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "什麼樣的祝賀需要來兩千人？這就是個幌子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "他們甚至在聖山腳下紮營，毫無信仰之心！讓這樣的人參加兩天後的儀式，我看反而會觸怒耶拉岡德！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "聖女大人！我們真的就這麼任由這群人在謝拉格如此行事？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "您說得沒錯，我很清楚他們並無敬仰耶拉岡德之心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "既然如此——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "正因如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "阿克托斯大人，難道我們的耶拉岡德像僅是為了造與信徒瞻仰嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "這……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "您看一看，看一看這座像。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "三年之前，我們通過了希瓦艾什家的提案，決定在銀心湖上建造一座耶拉岡德像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "它應當莊嚴偉岸，它應當慈悲寬仁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "它將成為謝拉格人的精神寄託，將成為謝拉格面向外界的最顯著標誌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "那時各位應該就已預想過，未來將會有更多的人來到謝拉格，很多事情我們無法避免。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "話雖如此，可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "沒有可是，阿克托斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "於謝拉格人而言，耶拉岡德是不可動搖的信仰，這是其他外來之人無法體會的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不論是否擁有虔誠的信仰，人們都將來到這座代表耶拉岡德的雕像前，沐浴耶拉岡德的榮光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "但是聖女大人，如今的情況並不像您所描繪的那樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "如果只有普通遊客，我當然不會多說什麼！可現在我們面對的是維多利亞的軍隊，這不一樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我們面對的是“軍隊”，還是“貴族的護衛”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "又或者，是“維多利亞”本身？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "他們以慶賀為名請求進入謝拉格，阿克托斯大人，我們找不出拒絕或阻撓的理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "這……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "可是他們明顯來者不善，萬一……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我至今，仍不贊同恩希歐迪斯大人某些太過冒險的決定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "儘管這確實為謝拉格帶來了發展……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "恩希歐迪斯他這三年到底都在做些什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "他在礦產的出口問題上小動作不斷，這次維多利亞人的事，是不是也是他惹出來的禍？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……我不清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "您不清楚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我必須要“不清楚”，阿克托斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不論恩希歐迪斯大人在暗中如何籌劃，一切皆是他的一意孤行，我與蔓珠院自然毫不知情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "有時，知道得太多並不是一件好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "您的意思是……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "只是陳述事實而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "接下來的儀式不容任何閃失，我們現在該做的，是做好我們能做的一切準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不必如此擔憂，阿克托斯大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不論如何……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "耶拉岡德會庇佑祂的子民。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "聖女大人，您在想什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我在想，阿克托斯提到耶拉岡德像……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "兩天後的儀式，希望能夠一切順利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "會順利的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "“耶拉岡德會庇佑祂的子民”，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……我還是希望，這一次能不用打擾祂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "您希望祂一直看著就好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "謝拉格總要學會面對風險和挑戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "雅兒，孩子總不能一輩子在母親的攙扶下走路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "……您說得很有道理。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "啊，話題怎麼又變得沉重起來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "說到耶拉岡德像，這個阿克托斯，我真想給他一巴掌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "那個大雕像的臉，會整成現在這個樣子，就是他從典籍裡找到的根據吧？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "還堅持說什麼“耶拉岡德的尊貌古有記載，絕不可變”呢，我的……\n咳咳，耶拉岡德的臉哪有那麼寬？"
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "真該打！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "聖女大人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "恩雅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "你怎麼不說話……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "……不會吧，肯定是你又在逗我了，這不可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雅兒",
      "text": "難道我……不對，耶拉岡德的臉真的……很寬？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "兩日後的清晨，聖女大人將在銀心湖舉辦祝福儀式，以慶祝耶拉岡德像正式落成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "這是您的邀請函，子爵閣下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "哎，恩希歐迪斯老爺，哈哈，謝拉格人是這麼叫的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "您太客氣了，我們本就是為此而來，哪裡敢勞煩您特地準備邀請函。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "請放心，當天我和我的士兵們肯定準時到場，慶祝我們的耶拉岡德像完工……敬耶拉岡德！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "……看來您很適應在謝拉格的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "謝拉格風景好，菜餚有特色，老鄉們也熱情，我怎麼能不喜歡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "不枉公爵閣下時常盛贊謝拉格是風水寶地，果然名不虛傳啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "……公爵閣下過獎了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "能讓遠道而來的客人如此誇讚，是謝拉格，也是我希瓦艾什家的榮幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "恩希歐迪斯老爺不必過謙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "雖說我們這次來，是為慶賀耶拉岡德像落成，但這段時間下來，我可算是真心實意被謝拉格的魅力俘虜啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "想必以公爵閣下一貫的體恤，應當會允許我在儀式結束後，在謝拉格再多遊玩一段時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "恩希歐迪斯老爺，該不會不歡迎我做個觀光客吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "……怎麼會？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "子爵閣下有心深入了解謝拉格，我當然求之不得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "只不過謝拉格天寒地凍，這個季節，山間看不見的危機不在少數。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "您與貴軍團的士兵們還是要注意防寒，即便是觀光，也請避開一些危險之處，以免被風雪凍傷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "……這可真是貼心的提醒啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "謝拉格確實是太冷了一點，不過不勞恩希歐迪斯老爺掛心，這不是什麼大問題，一件外套就能解決。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "當然，就我個人而言，比起去冰天雪地中體驗登山，我更愛在溫暖的房子裡點燃壁爐，然後吃上一口乳酪鍋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "那滋味，嘖嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "聽您這麼說，我就放心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "放心？不，不不不，這話不對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "恐怕恩希歐迪斯老爺不能放心，反而要更用點心才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "……願聞其詳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "哎，恩希歐迪斯老爺，憑您與公爵閣下的關係，許多事情恐怕不必我說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "那位雖說體恤部下，對謝拉格也是一片親近、喜愛有加，但大人物的耐心嘛，總是有限的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "與您在謝拉格的合作若是一直不順，萬一公爵閣下失了耐心……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "我想你我都不希望事態最終發展到那般境地，恩希歐迪斯老爺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "子爵閣下的意思我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "關於貴方提出的“合作”，近日內我會給出一個答案。不會讓公爵閣下等待太久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "唔……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "希望能從您那裡聽到點好消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "您會聽到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "邀請函已經送到，就不打擾子爵閣下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "兩日後的儀式，恭候您的到場。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "這謝拉格的小子走的時候連個招呼都不打，太狂妄了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞子爵",
      "text": "他這是做樣子給我看呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "做樣子？你們這些聰明人，整天就會打啞謎……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "哈洛德，我看你這兩天心情不怎麼樣，他沒給你找麻煩吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "亂想什麼！這毛頭小子是有點本事，但還沒到能讓我睡不著覺的地步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "……可以了，別胡思亂想，該來的躲不過，該幹嘛就去幹嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "那好，你心裡有數就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "好啦，那我就先忙去了，嗝，應付那群老爺就靠你了，哈洛德！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "哎，等會，別走，你們是不是又喝酒不帶上我了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "給我站住！酒就算了，我剛剛吃到一半的乳酪鍋你們給我端到哪裡去了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "呼……哈……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "（謝拉格語）你好……再見……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "呼……呼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "媽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "放心……呼呼……我一定會替你……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "*含糊不清的謝拉格語*。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哈……呼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嚇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "什麼人？！什麼人膽敢偷襲——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "……呃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我什麼時候睡著了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嘶……屁股痛。這車真夠晃的，坐得我全身骨頭都快散了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗯——呼啊，舒服多了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少女坐直身體，把之前用來在車上打發時間，不知道什麼時候滑落到椅子下方的書籍撿起，塞進包裡。\n她伸了個大大的懶腰，將視線轉向車窗外。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "這就是謝拉格的景色啊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "都是雪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "還有山。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "除了山比烏薩斯多點，其他的不都差不多？到處都是雪，又乾又冷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "到底有什麼好的，讓你們都這麼念念不忘……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "各位旅客，本次列車即將抵達終點站——謝拉格聖山腳下。\n請到站的旅客收拾好行李，有秩下車。\n想要前往城區的旅客，可於二號月臺轉車，或選擇搭乘巴士。\n想要前往銀心湖，遊覽最新落成的耶拉岡德像的旅客，請前往三號月臺轉車。\n謝拉格歡迎各位旅客的到來！祝您旅途愉快！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哦！終於到了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "借過，不好意思，借過一下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "呼，終於出來了……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "太恐怖了，這下車的人也太多了吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "讓我看看，下了車之後先往左走，從檢票口出去，然後……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "……這地圖畫的什麼鬼啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的馱獸",
      "text": "哞——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哇！什、什麼東西！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的馱獸",
      "text": "哞——！哞哞——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哈？馱獸？車站裡怎麼會有馱獸……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "長得還挺壯的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "嚯嚯，小姐，我看你是第一次來我們謝拉格吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "老伯，你看得出來啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "欸，第一次來的外鄉人，我一看就知道啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "這馱獸，可是我們這的特色項目，聖女大人親自取的名哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "叫、叫什麼來著，哦，對啦！這叫“跑跑馱獸”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "“跑跑馱獸”……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的馱獸",
      "text": "哞、哞哞——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "對啦，就是這個名啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "小姐，你看這個，這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "你要是想騎馱獸啊，就按一下這個按鈕，把這隻馱獸放出來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的馱獸",
      "text": "哞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "欸，聽話，聽話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "我們這馱獸都是馴養了好久，一個個挑出來的，聰明得很勒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "小姐想去哪裡都可以，到了地方，直接把錢放到這馱獸身上的袋子裡就好了嘿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哈哈哈好玩耶！真的能騎馱獸上街嗎？也太酷了吧，我喜歡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "欸老伯，那要是有人到了地方賴帳怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "嘿，小姐，在我們謝拉格，想賴帳可沒那麼容易！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "你看見這裡貼的這張聲明了沒有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的馱獸",
      "text": "哞——！哞哞哞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "讓我看看……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "“如顧客有違約行為，遭受提供服務的馱獸攻擊，產生的一切人身傷害與財產損失，本公司概不負責”……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "馱獸還會自己討帳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的馱獸",
      "text": "哞哞！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的馱獸",
      "text": "哧——！嘖——哞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "真不錯！就應該這麼對付賴帳的傢伙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "回頭有機會我一定要試試！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "嚯嚯，真是個好小姐，喜歡就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "text": "我不耽誤你趕路了，歡迎來謝拉格啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哎，等等，老伯……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "走得真快，我還想問個路呢……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "這邊從這裡穿過去……嗯，應該沒走錯吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "三號月臺，三號月臺……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "立定！靠攏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "原地列隊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的女性",
      "text": "為什麼會有士兵出現在車站？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的女性",
      "text": "是最近出了什麼大事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "立正！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大膽的男性",
      "text": "放心，沒什麼事，上次我還看到他們一起來買紀念品，搞不好也是來觀光的呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大膽的男性",
      "text": "不過他們這身衣服看著是不怎麼暖和，你看，那小伙子都冷得流鼻涕了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "（……丟臉，還不趕快擦擦！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "（上次在特產店買給你們的厚外套呢？怎麼不穿上？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "（拜託，哈洛德！你買的那外套……每件上面都繡著“我愛雪山”啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "（怎麼了，我覺得很好啊。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "（我也覺得挺好的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "（……好，那你留著自己穿吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "（等一下，哪來的小女孩啊？！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我？別在意我，你們繼續討論啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我就是看這塞了這麼多人，一時好奇過來看看……聽到你們在討論忍不住加入。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "請不要道歉，您真是一位非常有品味的女士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "有品味……說我嗎？哈哈，大叔你看人很有眼光嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "特產店賣的大衣剛剛我也看到了！雖然衣服上繡“我愛雪山”俗了點，但確實很保暖！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "咳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練的士兵",
      "text": "我承認你說的，哈洛德。這位女士確實很有品味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "大叔，你們不是普通人吧？你們是來謝拉格幹嘛的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "大叔？好吧，我勉強可以接受這個稱呼，我家的不孝女確實和女士您差不多年紀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "至於我們，哈哈，我們只是來觀光的，就和女士您一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "我可不是單純來觀光的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "對了，大叔，你知道三號月臺該從哪走嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "三號月臺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "對，我要轉乘去銀心湖的那班列車。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "唔……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "大叔你也不知道？那算了，那我再去問問別人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "且慢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哦？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "要問三號月臺……這您可就問對人了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "要說誰最熟悉這車站內外的環境，我哈洛德·克雷加文稱第二，沒人敢稱第一！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哦，哦！真的假的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "千真萬確。本人從不對女士說謊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "從一個月前走下列車的那一刻起，我就已經成為這片熱鬧的俘虜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "這裡的每一家店，我都花時間逛過，對面新開業的那家紀念品店，當初還邀請了我來剪綵呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "我敢說，就連這裡的馱獸，對我和我的兄弟們，都比對其他遊客更和善！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哈……你確定這的馱獸對你們更和善？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "喏，你看，你說的馱獸正在啃那邊那個兄弟的衣服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不客氣的馱獸",
      "text": "呣，哞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不客氣的馱獸",
      "text": "（咀嚼）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嚴肅的士兵",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "看看，我沒說謊吧，這小傢伙和我們多親近啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "啊哈哈哈哈！我看著你的兄弟好像不怎麼想要這種親近！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哈……笑死我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "行了，說正經的，我急著趕路，最好天黑前能到銀心湖……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "聽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "您聽到了嗎，女士？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "聽到……你指什麼？月臺提示？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "沒錯，這正是三號月臺的列車進站的訊息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "而我，很巧，正好與您同路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "同路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "更加準確地說，我的目的地是銀心湖上的耶拉岡德像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "不只是我，在這裡的所有人，最終都會搭上這趟列車。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "兩日後，所有人的目光都將匯聚在那座雕像上……我們都是為此而來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "哦……哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "text": "建這個耶拉岡德像，原來是這麼了不起的事啊……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "或許吧！作為一介遊客，我認為它也確實是不錯的觀光景點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "text": "那麼——請問我是否有這個榮幸，邀請您一起踏上這趟觀光之旅，女士？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
