  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "格拉尼，你要走了嗎？那位斯卡蒂小姐呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "嗯，我該回羅德島覆命了，會找時間回來看你的。斯卡蒂說喜歡獨處，一個人先走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "有斯卡蒂的名聲在，不會有賞金獵人再來騷擾你們了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "嘻嘻，是啊，恢復生產可能還需要一點時間，但......這是新生活的開始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "路上小心。下次就到豐收的季節再來吧，讓我好好招待你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "嘿嘿，那說定了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "對了，信使剛剛送來這封信。雖然說是發給滴水村的，但收信人寫的是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "啊，這是羅德島的信封，應該是從聯絡處的通訊轉錄過來的吧。這裡幾乎收不到訊號，也難為大家了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "我看看......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "（格拉尼啟，斯卡蒂已擅自前往滴水村，未任命其任何任務，小心對待。）\n（祝一切順利     臨光）"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "哎呀，這個，我早就清楚啦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可蘿爾",
      "text": "唔，你在幹什麼，格拉尼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "折紙飛機啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "羅德島的信紙材料很好，能飛很遠呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
