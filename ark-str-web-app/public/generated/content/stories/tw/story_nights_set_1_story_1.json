  "groupId": "story_nights_set_1",
  "stageId": null,
  "title": "“貓貓”",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_nights_1_1.txt",
  "sourceHash": "316676347b3da5bad01dc26402c7a3839545f04446e776d5b4358ae46eb383d5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 夜烟"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "“貓貓”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "各式各樣的“貓貓”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "該怎麼說呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "假如說，街頭巷尾出現了些可愛的小東西......嗯，假設你也喜歡可愛的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "它們會突然出現在你身邊，無聲無息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "但是它們就是會在某一天走進你的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "貓貓和人不一樣。它們不會因為你是個正人君子就黏著你，也不會因為你是個小偷就拋棄你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "咖啡廳裡享受陽光的貓貓？有的。夜晚嚇守夜人一跳的突然竄過的黑貓？有的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "就連監獄，那麼嚴密的監獄......貓貓也可以躡手躡腳地走進去，然後輕鬆離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "唔，可能我真的很喜歡它們。不論是哪隻貓貓，我都能感覺到它的心情。不想起床。餓了。溫暖。突然想惡作劇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "一切都是貓貓的隨心所欲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "人又怎麼能學得來貓貓的那種隨性呢？貓貓可不會合起來欺負一隻貓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "啊。和牧畜和寵物不一樣。別想著餵養貓貓，或是把它關起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "據說，想傷害貓貓的人，最後連一隻貓貓都看不見了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "......夜煙，夜煙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "喵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "你沒事吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "嗯......我剛才又在說些什麼了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "你剛才突然埋下頭嘀咕著什麼，然後又和沉睡似的完全不說話了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "......真是的，這頂帽子還是一如既往，瘋瘋癲癲地說些深邃的話嚇到別人，和我的風格完——全不符啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "凱爾希醫生說過，幹員出現這種失去自主意識反應的時候，一定要及時告訴醫療組......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "沒事、沒事啦喵，我可不想到那張不知被染紅過多少次的病床上過日子。只是腳邊的貓貓們太可愛，忍不住沉迷欣賞罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "哈哈，因為，有慕斯在的地方總會有很多貓貓聚集呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "就是說喵！對於我這種“嗜貓如命”的傢伙來說，慕斯就是我生命中不可或缺的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "嘿嘿，因為大家都很善良，從還在維多利亞開始就一直保護著我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "......夜煙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "（怎麼又發起呆了......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "夜煙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "......夜煙小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "喵！......我、我沒事啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "你一直在意著什麼嗎，夜煙小姐？從剛才開始就一直更關注周圍的環境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "（小聲）難、難道說，羅德島基地裡混進了什麼危險的氣息？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "不是啦，我剛才只是......看到“那位”女士正巧走過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "“那位”......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "女士......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "......啊！是在說Miss.Christine？我完全沒有察覺到呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "明明附近的貓貓都聚集在這片廣場曬著太陽玩樂，Miss.Christine看起來興趣缺缺呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "因為Miss.Christine是特立獨行的貓貓呢，大概更加偏好安靜地獨處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "說起來，之前也是這樣，夜煙平時和我們嬉嬉鬧鬧的，面對Miss.Christine卻十分安靜呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "因為......在Miss.Christine身上，有種讓我熟悉的敬重感，不由得會注視起對方來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miss.Christine",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慕斯",
      "text": "難道說，夜煙從前就遇見過Miss.Christine嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "我這樣的逃犯怎麼會有機會認識那種身份的貓貓呢。只不過......她那優雅、從容和隨性的樣子實在和曾經幫助我的“恩人們”如出一轍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄綠",
      "text": "夜煙是在說......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "哎呀......已經是過去的事了......喵哈哈，這頂帽子又在瘋瘋癲癲地發出雜亂的聲音，稍不注意就會被它騙走注意力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "嗯，慕斯和薄綠就全當這些是我的玩笑話吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "......但是我知道，這不是玩笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "對他人來說，我這樣擁有逃犯身份的人，不論是死是活都無所謂......甚至會遭人詛咒吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "社會上，也有喜歡將他人的生命劃分價值的一類人，從以前開始我就沒少受過那些人的欺負。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "好不容易逃出了那座監獄......病情卻越來越嚴重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "但受這麻煩的病所賜，我卻擁有了以前從未奢望的、施展源石技藝的能力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "......只不過，在一開始完全沒有帶來任何好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "看到身上只屬於感染者的傷口以後，連最好心的老闆娘也不會施捨給我一點過期的麵包了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "本想用法術的力量威脅一下其他商店的老闆......法術卻完全不受自己控制地破壞了一大片房屋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "這種野蠻的力量是不可能將我再帶回到維多利亞的普通生活中的，我完全明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "可是，我這樣的“麻煩”，對別人來說是生是死都無所謂的可恨之人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "如果連我自己都嫌棄自己的生命的話，還有什麼活著的必要呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "但是，我不想死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "......花費了那麼大的力氣才終於從那座監獄勉強逃脫，卻發現整個維多利亞都沒有一個人再掛念自己、願意接納自己......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "甚至......給予一點施捨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "這樣的我，如果不是遇到了“它”，不是遇到了“它們”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "大概連自己當初逃出來的理由都快要忘記了吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......\n......"
    },
    {
      "type": "dialogue",
      "speakerName": "夜煙",
      "text": "喵，你站在這裡很久了嗎，博士？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你看著像“貓貓”一樣，在閒逛嗎？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "哈哈，我可沒有偷懶哦。現在是換班後的休息時間，四處逛逛也是允許的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "博士，知道嗎，太關注某件事的時候，可是會忽視掉重要大事的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "比如博士口袋裡的這支筆，今天是不是有幸歸我使用一日呢？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "啊！......又來了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "先說好，我這可不是意圖掩蓋什麼，只是和博士普普通通地打個照面。嗯，普普通通嘛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Miss.Christine",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "......啊。看吧，Miss.Christine都察覺到博士的氣息，換到更高的樑柱上休憩去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "喵？是啊，我剛才就是在看著Miss.Christine沒錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "只是遠遠地駐足觀賞，在對方不會警戒的距離外觀察一會，直到博士您路過之前，我和Miss.Christine的相處都十分融洽呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "嗯？為什麼不試著和Miss.Christine交談？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "過去，還在維多利亞躲躲藏藏的日子裡，就有像Miss.Christine一樣的貓幫助過我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "給我食物飽腹，贈我衣物保暖，帶我尋找到能夠躲避追緝的暗巷和倉庫......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "後來，我終於學會一點法術，想要找回那隻貓進行回報。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "我把更好的食物、更暖和的衣服搶來給予它，隨後卻落得自己被棄之不顧的下場。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "哎......博士，為什麼烏鴉要像寫字台呢？為什麼相遇要在下午三點？為什麼不壞的傢伙要替惡人頂罪，為什麼好人不幸福？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "為什麼......我無法像貓那樣活著？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "夜煙......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "過去那些不公平的經歷，那不是你的錯。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "哈哈......失禮了喵，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "和你抱怨的那個可不是夜煙喵，如果剛才你聽到誰朝你說了些奇怪的話，已經沒事了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "那個多愁善感的傢伙，在剛才已經被夜煙親手扼殺了喵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "畢竟，如果夜煙我是那樣喜歡抱怨的性格，應該從很——早以前就堅持不下去了吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "但是我可是經歷了所有，跟隨自己的心做出決定，懷抱自己的信念來到羅德島的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "這也算是一件了不起的事吧？喵哈哈。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "好了，筆還給你，呼哈——我差不多也該找個地方，搖著尾巴好好睡一覺了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "嗚喵？呀啊——！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......夜、夜煙？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "慕斯",
          "text": "啊！發現夜煙了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薄綠",
          "text": "夜煙，沒事吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "小事情，只是不注意摔了一跤而已。放心啦，薄綠、慕斯、博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "慕斯",
          "text": "果然，每到檢查身體的時候你就愛逃到大家找不到的地方。醫護幹員可是對我們下達了任務，一定要帶著夜煙你一起去問診室的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "嘖......直面自己的健康狀況可是很殘忍的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薄綠",
          "text": "夜煙？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "不，沒關係，羅德島的醫生們保守隱私還算做得不錯。我們還是先午睡一會，再去那討厭的、滿是消毒水氣味的房間吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "薄綠",
          "text": "可、可是你剛才差點暈倒......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "不是還有薄綠和慕斯在嗎，等真的昏倒再送我過去也不遲啦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "博士正好也在呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "慕斯",
          "text": "不——可——以——保持健康的身體是很重要的！呃，雖然我們不能算是“健康”的人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "詳細的說教等找到那些可愛的貓貓們，好好地一起休息一陣再說吧。慕斯，那些貓咪今天會在哪裡休息？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "慕斯",
          "text": "嗯？我、我猜，或許會在庭院裡......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "那就事不宜遲，現在就召集貓貓們一起去庭院觀光囉！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "......啊，博士，你還在啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "如你所見，之後我要懶懶地睡個午覺，簡單完成出發前的身體檢查，然後去小隊報到集合，開始今天的“行俠仗義”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "......從以前的竊賊、逃犯嘴中說出這句話，聽起來有些諷刺啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "但是博士，現在對我而言，這是一件好事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "事到如今，這樣的我竟然還有為拯救他人的使命去戰鬥，從而被越來越多人認可的機會......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "博士，你不同於那些可愛又受人喜愛的貓，也和Miss.Christine那樣只顧自己的自由、舉止優雅的貓天差地別。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "反正我是搞不懂你啦......可是我知道，現在的你樂於和我一同玩耍嬉戲，也願意以驕傲、自信的態度將任務託付於我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "對我而言，能夠從你這裡得到這些，就完全滿足了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "......喵哈哈，你剛才是想說這些吧，瘋帽子？拜啦拜啦！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Miss.Christine",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Miss.Christine",
          "text": "喵。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "午安，你還在這呢，Miss.Christine。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Miss.Christine",
          "text": "喵！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "剛才的那個孩子，很喜歡你。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Miss.Christine",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "是啊，與其說我“喜歡”貓，不如說尊重。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "或者說......羡慕吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "這種羡慕，有時也給我帶來了更多的煩惱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "人類啊......總是這樣。任何欲望的產生都會帶來不可預測的危險。稍不注意，就會使自己落入煩惱的困境之中。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "不過......可不要憑自己的心願來預想貓的行為。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "她們是貓。自由的貓，快樂的貓，幸運的貓，不幸的貓，憂愁的貓。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "更重要的是，無拘無束，來去自如，沒有人類那些複雜的社會使命感，單純地享受著生活而已——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "夜煙",
          "text": "畢竟，人們又能指望從貓貓那裡奢求什麼呢？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
