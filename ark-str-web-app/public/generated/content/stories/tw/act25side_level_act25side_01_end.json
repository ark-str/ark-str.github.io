    {
      "type": "dialogue",
      "speakerName": "塞雷婭",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "這句話滿懷他對於天才科學家殞命的惋惜，卻被斷章取義成“精準的同行評議”，成為許多人攻擊萊特夫婦的武器，真是諷刺。"
    },
    {
      "type": "dialogue",
      "speakerName": "錫人",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
