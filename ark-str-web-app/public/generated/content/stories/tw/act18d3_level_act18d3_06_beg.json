  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "沒有盡頭......濃霧彌漫......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "哼哼~哼......♪"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手，你醒啦！早上好啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "誰在唱歌？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "這、這是歌嗎？我不會唱。你睡著的時候，嘴裡總在哼著這幾句哩。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "哎唷！歌手你......你抓我抓得太用力啦......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "你......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "媽媽......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "怪物......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "怪物。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "怪物！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "咳咳......歌手，你的箱子......壓得我胸口好疼......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "鬆、鬆手了？剛才嚇死我了......"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手，我還以為你想殺了我。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我是可以殺死你。很簡單。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "但你不想殺我呀。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你知道？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "我知道。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "可是，我不知道。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "欸？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "又、又來？突然就衝了出去......歌手，你要去哪裡啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......長官，快漲潮了。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "海的顏色......那一塊顏色變了。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "水裡有什麼東西......是、是貝殼和鱗類？為什麼海水裡突然有這些？而且還在不斷向岸邊靠近？"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "沿著不該存在的洋流，從更深處來。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "什麼？！"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "我還以為......他們去海裡，宣稱這能換來吃的，只是一種荒誕的迷信。我以為，他們是在絕望之中受人蠱惑，胡言亂語......"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "沒想到，他們、他們竟然真的與大海交易？他們把自己人當作餌料，餵養大海裡的怪物，然後怪物也餵食他們？"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "這可怕的畸形的共生關係......難怪，這裡的恐魚會有這麼多！"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "可是昨天......昨天我以為我阻止了！"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "不是所有的糾正都有結果，你該學到。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我......"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "是我錯了嗎，長官？我只是想救他們。"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "要糾正一處錯的，要嘛使錯的走回正道——"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "可是......對他們來說，什麼是正道？"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "鹽風城......這片土地和海岸，再也無法孕育任何食物。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "結局早在幾十年前便已註定，一切掙扎都是徒勞，移動城市、文明和這裡的人，都在慢性死亡的路上。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "他們問我。如果......如果已經無路可走，如何才能分清對錯？"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "——又或者使錯的不存在。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "長官......！您的意思是要我......"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "你在懷疑。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "我......不，我不敢。我只是......"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "雖然他們......現在變成了這樣。他們也曾經是伊比利亞的居民。我想保護他們，我希望我能使這裡的人......使這個國家變好。"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "你該懷疑。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "要作出判決，你需靠你自己！"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "是，長官......"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "看看這片海。你看到了什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "是......威脅！"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "不要背誦答案。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "是，長官！"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "海水在......流動。在不斷地變化。"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "記住你看到的一切。"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "變化已然、正在、將要發生。如果無法看得更清楚，你將會迷失。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "長官，您腳下是？！"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "你認為呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "一隻恐魚......是晚上攻擊街道的漏網之魚？！不，好像不是......這一隻在海岸上徘徊......它爬了好長的一段路......不大一樣......"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "是......我，呃，我應該知道......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大審判官",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "是必須淨化的邪惡。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "......我明白了。我看清了......交易的全貌。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "原來，走進海裡的人會變成這副樣子……這裡不僅僅是怪物的巢穴，還是溫床。"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "呃......"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "這麼說的話，這裡的所有人都會變成怪物！"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "（握緊劍鞘）"
    },
    {
      "type": "dialogue",
      "speakerName": "審判官",
      "speakerToken": "avg_npc_182#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "長官，我再回城一趟。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "呼......呼呼......歌、歌手......你跑得太快了......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "看來還不夠快。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "又讓你追了上來。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "哈......哈哈......歌手，這裡可是我家......我對這個地方，可比你熟多啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我該走了。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "走？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "離開這裡。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "咦，你知道去哪裡找你的同伴了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......至少，離你們遠一點。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "啊？為什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "那個審判官，她有一件事說得很對。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "她話說挺多的......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "對你們來說，我很危險。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "因為昨天晚上的事？你救了我們呀，歌手，我們都很感謝你。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "救了你們？你是這麼覺得的嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "如果，那些恐魚，有一隻我沒有殺掉。它可能就會在行進的路上，將你絞碎。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你會被它殺死。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "它是我帶來的，所以你是被我殺死。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "不，不是這樣的......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "怎麼不是？這樣的事，不是沒發生過。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "他們因我而死。他們恨我，怕我，責怪我。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "那是......他們不對！"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "這又不是歌手故意的。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我不是故意的嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我不知道。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "呃......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "在那之後......我就不知道了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我以為，殺掉它，我會有答案。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手......你的臉色好差。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "你剛受傷，還消耗了那麼多體力，還沒有完全恢復吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "你還是跟我回去好好休息，等再睡一覺，你會好些。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "你為什麼不怕我？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "咦？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "你奶奶叫我怪物。你的同伴看我的眼神充滿了敵意。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "到哪裡......都是這種眼神。我早就習慣了。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "你呢？在你眼裡，我是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "你是......你是歌手呀。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手。我說了，你就信。那個審判官就不信。現在我說我是怪物，你信不信？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......不信。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "你到底為什麼老跟著我？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我能給的東西都可以給你。你卻不要。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你也不是想殺了我。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "殺、殺你？不，歌手，我怎麼會有這種想法？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我做事，你給報酬。或者相反。陸上的人都是這樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "交換，就會有約定。有約定，才有信任。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "約定？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你不知道什麼是約定。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "（搖頭）"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你聽好。我說的，你幫了我，我會給你你想要的。這就是約定。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "......我什麼都不要。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "說謊。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "獵......我的鼻子和眼睛一樣靈。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "呃......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你說，這是你家，所以你能很快找到這裡來。你也在說謊。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你不說實話，我就不會信你。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "不，歌手，你不要走！"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我沒有不說實話。我只是......不明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手，你對我們......對我來說是一個謎。你是外面來的人，我從來沒見過你這樣的人......"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "你想知道，我為什麼猜到你在這裡，我不是不說實話，我是......不好意思。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "這裡是......邊緣。離城區最遠。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我明白你在躲著我們。我想，你要走的話，你大概也會來這裡。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "也？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "我經常偷偷來這裡。當然，瞞著鐵皮他們。他們發現我總跑這麼遠，會不高興。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "你看那一塊，很高。我有時候會爬上去。因為風更大，我能看得更遠。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你好奇外面。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "我不知道。我......我有時候會想外面是什麼樣子的。這很沒意義，我懂，他們都這麼說，所以我只敢一個人偷偷想。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "我出去撿東西的時候，最遠也就走到這裡。再外面......外面沒有什麼有用的了。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "好奇的話，再走遠一些就知道了。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "以前我去最西邊，鐵皮會威脅我。他說外面都是怪物，我們一出去就會死掉。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手，你是從外面來的。我跟著你，其實我有許許多多問題......我想知道，鐵皮他說的是真的嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "或許。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "去外面的話，你會死掉。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "呼......原來是真的啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你並沒有失望。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手，我想，有機會的話，我要去看看。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "就算有怪物也沒什麼......我好像並沒有那麼怕。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "審判官說，我不怕怪物，是因為我不知道怪物會對我做什麼。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我覺得她說的對。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "她胡扯。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "咳咳......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我也不怕。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "哈哈......那是因為，歌手你知道，在你面前，怪物什麼都做不了。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "我不一樣。昨天夜裡，我第一次看清楚了那些怪物。我不知道我會怎樣，我的心臟怦怦直跳，跳得從來沒有那麼——劇烈。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "再後來，今天早上我醒過來，我竟然發現這天氣從未感受過的美好。我能感到風在流動，看到海浪在靠近。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "這樣的一天，和過去的每一天都不一樣。就因為我不知道可能會發生什麼，而不是一眼從天亮望到天黑。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你很亢奮。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "這是亢奮？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "害怕，亢奮。沒什麼差別。都是心跳加快，血液變熱。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我是病了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "這不是病。對有些人來說，這是活著。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "原來活著的感覺這麼好。外面的日子，是不是每一天都能這樣？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "總比這裡好些。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......我真的可以到外面去嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我的盒子......等我的盒子裝滿。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我要......多存些食物。我要安頓好佩特拉奶奶。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我......哎唷！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "這麼不小心的話，是會被怪物吃掉的。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手......你又救了我。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......要是你不跑來的話，就不會這麼多事。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "哈哈......抱、抱歉啦......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "咦？咦咦？"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "我的腿......好像有什麼東西抓著我的腿。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "滑、滑滑的......好重！"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......又來了。到處都是。煩人的東西。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "嗚......歌手，我、我快抓不住你了......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "閉上眼。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "咦？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "然後鬆手。"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......可以嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "要不要信我，你可以選。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
