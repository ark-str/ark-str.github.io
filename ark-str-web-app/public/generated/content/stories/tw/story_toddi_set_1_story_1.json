    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "熔泉",
      "speakerToken": "avg_363_toddi_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "第一發射失，根據著彈點調整位置，抬高3.2度，第二發將使用爆破矢！"
