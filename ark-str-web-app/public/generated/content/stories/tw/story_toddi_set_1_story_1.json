    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "speakerToken": "char_416_zumama_1#2",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "我會和暴躁鐵皮從左側突入，那裡荒地人比較少，不容易誤傷。"
    },
    {
      "type": "dialogue",
      "speakerName": "熔泉",
      "speakerToken": "avg_363_toddi_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "好的。攻城弩已經架設完成了，準備試射——"
