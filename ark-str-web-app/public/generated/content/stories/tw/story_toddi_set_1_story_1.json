      "speakerName": "熔泉",
      "speakerToken": "avg_363_toddi_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "斐迪亞，賭一把？"
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "speakerToken": "char_416_zumama_1#4",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "沒問題嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "熔泉",
      "speakerToken": "avg_363_toddi_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "目測車身寬度沒問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "speakerToken": "char_416_zumama_1#4",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "其他的呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "熔泉",
      "speakerToken": "avg_363_toddi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "所以是賭一把——"
