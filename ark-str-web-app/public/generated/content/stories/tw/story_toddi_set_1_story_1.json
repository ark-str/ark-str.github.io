      "type": "dialogue",
      "speakerName": "外勤幹員",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "收到本艦發來的聯絡，前方雷沙暴正在急速形成中！本艦會幫我們導航！"
