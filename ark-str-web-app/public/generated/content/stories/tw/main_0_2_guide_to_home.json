  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "引导2到主界面"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "最後一個！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "呃啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "剩餘目標已清除。敵方小隊潰退了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "......Dr.{@nickname}的指揮確實和阿米婭說的一樣，讓人放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是吧，輕輕鬆鬆吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士曾經經歷的，可不只是這種程度的戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "咳......怎麼會出現......烏薩斯人以外的阻礙......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "不會......讓你們阻撓我們的事業！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "別想得逞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "杜，杜賓教官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "你在發什麼呆！差一點，你就要被打成篩子了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "對，對不起！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "快！重整隊形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "杜賓！你來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "情況緊急。我的小組也遭到了攻擊，敵人同樣是整合運動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "所以我才立刻趕過來跟你們會合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "整合運動為什麼會攻擊我們......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "一個感染者權益組織......本來我覺得他們只是有點盲目激進————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "————現在居然開始使用暴力，還是在烏薩斯的城市？真是自尋死路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "接下來，這裡只會變得更加混亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "阿米婭，我們必須立刻撤離切爾諾伯格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好的。我們已經成功救出博士，之後按照計畫撤退就可以了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "——這位就是Dr.{@nickname}？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是，是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "Dr.{@nickname}，你可能不認識我，但你認識阿米婭，為了你的安全著想——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "唔，杜賓，博士目前的狀態並不是很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "簡單地說，博士......失憶了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "失憶？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......這怎麼辦？你還準備將指揮權交給這個......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士依然有能力指揮小隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......至少，在剛才的戰鬥中，我已經確認了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "我還是不能這麼簡單就相信一個陌生人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "但我相信你，阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......我知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "Dr.{@nickname}， 我是行動組E1組長，杜賓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "我們將把你從這座烏薩斯的城市——切爾諾伯格，護送到羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "身處切爾諾伯格城的核心區廢棄設施，現在的我們理應向西撤退。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但......和凱爾希醫生通訊中斷時，我和杜賓教官都需要先帶領著各自的小組，去西邊的集結地會合然後確認撤出信號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "按照計畫，原本是這樣的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "如果能這麼順利就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "今天是我們從石棺救走你的最後機會，Dr.{@nickname}。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "只是......我總有種不祥的預感。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "阿，阿米婭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "怎麼了?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "是......是來自羅德島的對話請求！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "通訊接上了嗎！難道說，是凱爾希醫......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "很抱歉，並不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "PRTS......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "應急神經連接請求被意外觸發了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "羅德島號方面也受到干擾，只有神經連接可以勉強進行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "無法用電波通訊聯繫到尚未回到羅德島的凱爾希。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "已經確認過阿米婭您的安全，那麼我的任務就已經完成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這東西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "現在真的是時候嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "不需要使用您的神經連接操作羅德島的話，我將在稍後中斷連接。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "如果打擾到了您的派對，萬分抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不不！別掛斷......我需要你幫個忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "杜賓，博士需要這些幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "瞭解了，抓緊時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "博士，PRTS也是我們的......同伴，它會指導你下一步的動作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "雖然時間很緊張，但現在，我要為你重新連接至羅德島的後勤系統。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這樣在我們作戰的時候，你也能利用它為我們取得優勢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可能會很難習慣，和說話不太一樣，但只要好好使用，就一定能使整個救援作戰更加順利，所以請你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......相信我吧。按你想要的那樣，按你熟悉的那樣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "PRTS......開始吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "需要確認管理員身份，請選擇識別方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊，博士......請你說句話。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（說話）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "雖然不知道為什麼你不說話，反而觸碰了一下螢幕中央——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "——不過我已經找到了相匹配的指紋。身份確認，許可權水準：8。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "——歡迎回家，Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
