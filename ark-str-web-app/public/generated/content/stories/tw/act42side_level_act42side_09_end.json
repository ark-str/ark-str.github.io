{
  "server": "tw",
  "storyId": "act42side_level_act42side_09_end",
  "groupId": "act42side",
  "stageId": "act42side_09",
  "title": "解經",
  "storyCode": "MT-9",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act42side/level_act42side_09_end.txt",
  "sourceHash": "80bc3d09318ec62c5ce4b699e20ac444058ef59a14c980fa8a61dfb1c4cb12ec",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "（嘶——）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……暫時只能進行一些緊急處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "安多恩，毫無節制地使用光學類源石技藝，已經對你的視神經造成了無法修復的損傷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我沒有修復這種創傷的權限和能力……條件允許的話，你需要就醫。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "無妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "路已經在腳下顯現，雖然看不到，但也不影響我們前進。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "請沿著地面上的指引光走吧……這座迷宮的構造太過複雜，我的源石技藝撐不了多久。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "就是這裡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "無論災異是否由此而起，門後的事物或許都能給我們答案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "跟上，阿爾圖羅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "費德里科沒有得到回應。\n從在育嬰聖堂外追到阿爾圖羅以來，對方一直都很配合他的種種安排。\n但此刻，黑髮的薩科塔就站在幾步之外，優雅地撥弄著琴弦，並沒有跟上來的意思。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "這一次，我真的要越獄了，費迪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "安多恩受了傷，你只有一個人，沒有比此刻更好的時機了，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "阿爾圖羅，我們已經抵達真相的門口，你應該清楚此行為缺乏意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "真相……意義……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "……或許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "費迪，你是最優秀的執行者，“行走的條律”，除了教宗以外第一位受封的聖徒……你是“送葬人”啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你的“理性”、你的“冷酷”，甚至你對這兩種品質產生的懷疑，都指向律法的存續本身。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "如果聖城本身即是如此，或許只有你能聽懂祂會說什麼，哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "至於安多恩先生……很抱歉，雖然並非我的本意，但剛剛在你施放源石技藝的時候，我無意中觸摸了你的心聲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "很複雜，比我認識的許多人都複雜。但……又確實沒有多特別。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "太過偏執的主旋律，讓它們統統變成了同一首曲子的改編或重複循環。它們訴說著——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你的起點和終點都在拉特蘭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "只不過，那時你或許將孤身一人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "啊，請原諒我的冒犯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "（頷首）阿爾圖羅小姐，您所謂的“冒犯”，何嘗不是我趁機進行了一次別樣的告解呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "至於您最後的話，我更願意視之為祝福……那說明，我真的抵達了終點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "哈哈，有趣的回答。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿爾圖羅轉身過去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "但不是每個人都如此執著於拉特蘭的“真相”和“意義”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "起碼，那對我毫無吸引力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "剛剛我已經窺見了祂的一角，門後面……是一台機器，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "既然如此，答案注定是無聊的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "想想我們在崔林特爾梅的經歷，費迪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "一場同等級的災異正在侵襲城市，人們在其中迷失或掙扎……此刻，拉特蘭有幾百萬值得傾聽的心聲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "阿爾圖羅，你現在轉身，代表你將獨自面對迷宮裡的敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "本來也需要有人幫你們把那些傢伙引開，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你的守護銃已經遺失了，此時的你缺乏基本的防衛手段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "或許，我可以想辦法讓他們成為我的聽眾？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "別緊張，費迪，我也是拉特蘭欽定的危險分子啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "現狀評級，高風險；存活機率，低；執行者決定……放行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "時間不等人，兩位。沒想過轉身的話，就不用為我送別了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "那麼，再見，我親愛的弟弟。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "離群的薩科塔",
      "text": "……說了半天，你想讓我們去幫教皇廳？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "理解能力滿分哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "離群的薩科塔",
      "text": "拒絕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "離群的薩科塔",
      "text": "我們沒有這個義務，莫斯提馬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "離群的薩科塔",
      "text": "你眼前的這群人裡，有一半是被教皇廳親自趕出拉特蘭的，也許是因為墮天，也許是因為礦石病……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "離群的薩科塔",
      "text": "還有一半，是主動選擇了離開拉特蘭，也許是因為失望，也許是因為疑惑……無論具體的情由究竟如何。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "哈，那你們為什麼選擇在這個時候回來呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墮天使",
      "text": "因為光環毫無預兆地碎了啊，很難理解嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墮天使",
      "text": "我們已經不屬於拉特蘭了。起碼，算是異類。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墮天使",
      "text": "無論主動還是被迫，我們和這座城市的連繫已經中斷了，然而過了這麼多年，它的變化依然影響到了我們，沒完沒了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墮天使",
      "text": "*拉特蘭俚語*，這該死的光環！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "聽起來，哪怕把公證所全部的執行者都叫過來，也沒辦法處理你們的投訴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墮天使",
      "text": "所以啊，我們回來只是為了做個了結！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我說過讓你們去拯救什麼了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墮天使",
      "text": "唔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我呢，在一次執行任務的時候意外墮了天。後來成為萬國信使，更多也是因為，這樣就可以不用一直待在拉特蘭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "對這個國家來說，我也是個十足的異類。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "沒人比我更理解你們現在的心情了，朋友們。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "離群的薩科塔們",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "或許是光環的異狀催化了你們對拉特蘭的負面情緒，促使你們回到這裡……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "如果你們回來是因為恨、因為痛苦、因為失望……那你們更應該跟著我去阻止那支隊伍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "因為那些讓你們恨、讓你們痛苦、讓你們失望的人，都在隊伍裡。炸藥、銃彈，隨便什麼報復手段，千萬別讓他們好過！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "離群的薩科塔",
      "text": "……你只是在耍嘴皮子而已，莫斯提馬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "哎喲，被你發現了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "不過，總得做點什麼吧——不管怎麼樣，你們已經回來了，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "喂，努艾達。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾達",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "沿著這條巷子繼續往前走，然後找個空房子躲起來。你一個人帶著這麼多小孩，不適合到處亂跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "這裡離那支隊伍的行進方向已經有一段距離了，怪物或許不會跑到這邊來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾達",
      "text": "帕蒂亞，你們也要去救拉特蘭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "哼，尋路者沒那麼高尚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "但引領我們的人已經選擇走進了這場災難的最深處，我們要怎麼袖手旁觀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "既然他說自己所去的地方不適合太多人前往，那我們就做點力所能及的事情吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "至於你，修女……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾達",
      "text": "我會保護這些孩子，無論他們來自拉特蘭還是玻利瓦爾。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蒙恩的生物們",
      "text": "（急切禱告）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "啟示石塔的大鐘一安靜下來，就到處都是這些傢伙吵吵鬧鬧的動靜了……好煩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "無論你們推銷多久，我也不想要你們的光環！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蒙恩的生物們",
      "text": "（急切禱告）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "該死，越來越多了……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "菲亞梅塔，三秒鐘，從現在的位置撤離。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "三秒？！喂喂，我要怎麼——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "怎麼樣，我動作夠快吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "……你還真當所有人的動作都跟你一樣快？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "算了。前面的情況很糟，連啟示石塔的鐘都不響了，伊卡萊西亞區算是徹底失守了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "他們要不了多久就能進入米迦萊昂區……如果那隻怪物一腳就能踩扁我們的路障，那公證所的防禦設施恐怕也沒什麼用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "攔路不是辦法，如果想不出更具破壞性的手段，我們恐怕連短短幾秒都無法拖延。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "同感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "所以，你找的救兵呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我們上吧，朋友們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你們肯定每個人都來過米迦萊昂區，也許是為了去銃械工坊，也許是為了去公證所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你們當中很多墮天使被趕出拉特蘭之前做的最後一件事，搞不好就是被帶來這裡上繳守護銃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "那你們也一定見過每家銃械工坊門口的那些扛著銃的聖像……哦，公證所門口還有兩座扛著炮筒的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "等等，我們根本沒有控制這些聖像開火的權限……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "這就交給蕾繆安那邊解決啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "朋友們，把這些聖像統統推倒，把它們手裡的銃都對準街道！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "把這幾年沒聽到的銃響，一口氣補回來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "嗯……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我的天，你的皮膚竟然能卡住子彈？也太厚太硬了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "真是的，所有的銃輪流使用了一遍，還是沒辦法傷害到你嗎……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "上一次有這種感受，還是跟老闆玩遊戲的時候，他透過後台把難度調到最高，害我一整晚沒過關……真令人灰心啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "灰心？不，我看到的是，哪怕光環破碎，也沒有影響你的狀態和情緒……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "孩子，你應該站在我的肩頭上看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "從啟示石塔開始，到米迦萊昂區的公證所，沿途每一盞路燈都亮起來了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "新生的同胞正在一點點地點亮這座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "這像極了千萬年前的那次遠行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "為一個真正的家園，我們穿越最兇險的峽谷、最貧瘠的荒原，去尋找沉睡的銀色山脈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "唯一不同的是，這一次，我們無比確定祂就在那裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "救贖是必然達成的終點，拉特蘭永遠不會墮入黑夜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "孩子，前進，是拉特蘭此刻唯一的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "而你仍想孤身一人阻擋整支隊伍、整個種族、整座城市嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "終於聽到這令人安心的聲音了，這才是拉特蘭嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "喂，如果我真的是孤身一人，請問這些爆炸聲是從哪裡冒出來的？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "雖然不知道並肩作戰的人是誰，但解決怪物的任務就交給他們了。而我要做的……\n就是和你糾纏到底！"
    },
    {
      "type": "dialogue",
      "speakerName": "“聖徒”",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "到底什麼是災異？到底什麼是未來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "到底憑什麼是你決定，你們在做的事情，就是救贖，就是唯一的選擇？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "唔，要去幫助她嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "不用。於她而言，那只是一個頑劣的孩子罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "誰在阻止隊伍行進？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "莫斯提馬和菲亞梅塔聯合了一些剛剛返回拉特蘭的人，暫時沒有發現安多恩和費德里科等人的行蹤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "……小菲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我再一次和自己至親的人站在了對立面……世事總是這樣無常啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "帕特里奇昂閣下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "專心做你自己的事情就好，薇爾麗芙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "我已經與蒙恩的生物們建立了連繫，為牠們指明了路線。我們的共感在變得越來越強烈和清晰，越來越，不像共感……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "如牧首——不，聖徒，如她所言，這本是共感應有的作用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "所以，她之前向我們呈現的都是真的。災異確實存在，而唯有依靠如此極端的方式，才能拯救拉特蘭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "只是眼前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "畢竟夢境已經崩毀了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "眼前的亂象只是暫時的。往前走吧，我們已經不可能停下來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "確保聖徒能夠抵達大教堂，這樣，她被迫中斷的“降生儀式”還能夠繼續。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我們還來得及建立一個更好的拉特蘭……去解決困住我們的所有問題。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "未知的通訊",
      "text": "（滋——滋滋——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "未知的通訊",
      "text": "好久不見，老傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "未知的通訊",
      "text": "你最好停下來，我瞄準你的喉嚨了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "好久不見……奧羅拉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大教堂最深處，迷宮的盡頭，最後一扇門向費德里科與安多恩敞開。\n門後，正中央的平台上，冰冷的環形機械矗立著，詭異的紅光從內部透出，逐寸掃過房間內每一個角落，伴隨著清晰可聞的嗡響……\n那是“運算”的足跡。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "教宗閣下？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊萬杰利斯塔十一世",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "平台的正下方，老人沉默地站立著。\n他緊閉雙眼，法衣上已經積起厚厚的灰塵。費德里科和安多恩的靠近沒有引起他的任何反應，他紋絲不動，彷彿一塊不視不聽的礁石。\n唯有……\n唯有乾裂脫皮的嘴唇仍在顫動，他喃喃自語，卻發不出哪怕一個音節。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊萬杰利斯塔十一世",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "現任教宗，伊萬杰利斯塔十一世，在神前沉默。"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "明顯的失語與神經退化性症狀。初步判斷，教宗閣下的體力與神智在崩潰的邊緣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "覆蓋全城的夢境已經崩毀，為何他仍未清醒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "或許，他懷著與你我相同的目的來到這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "只不過，他仍未得到渴求的答案。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "“適格”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "這和你的聖徒身分有關嗎？但我為什麼也……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "教宗閣下曾數次與我談起我的聖徒身分，每次都語焉不詳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "他或許也不清楚聖徒真正的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "但若律法視我們為“適格者”，賦予我們明確的職責……那麼不論是聖徒與否，我們都應在此刻對律法負責。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "機械聲在房間內迴盪，它穩定、等速，沒有任何情感波動，甚至聽不出性別，卻又蘊含著難以言喻的威壓。"
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "我最終，還是要向祂尋求答案嗎……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "或是祂向我們尋求答案，既然我們是“特殊個體”，是祂的“樣本”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "現狀評級，未知；風險評級，未知；執行者決定……執行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "兩位薩科塔越過伊萬杰利斯塔十一世，並肩走向冰冷的機器，走向那兩個閃著光的接口。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
