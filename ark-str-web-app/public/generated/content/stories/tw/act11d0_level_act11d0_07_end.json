{
  "server": "tw",
  "storyId": "act11d0_level_act11d0_07_end",
  "groupId": "act11d0",
  "stageId": "act11d0_07",
  "title": "群巒崩塌",
  "storyCode": "TW-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act11d0/level_act11d0_07_end.txt",
  "sourceHash": "d5973d6b9bd62498b7dbd321a1c4dec6e920189e6e23b170479eedbd58b0cb76",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 7下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "快點，這裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "這附近的痕跡......更像是單純的發洩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......塞弗林認為，這是一次有謀劃，有規律的變節計畫。但事實上呢？這的確就是一次單純的暴力宣洩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "卡達，發現什麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "沒錯，但是、但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "灰喉姐你快過來吧，我......我也不知道該怎麼說......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "房間裡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "你的瞳孔......別怕，控制住自己，斷崖，在外面陪著她，警戒周圍的暴徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......在這裡面？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "（......一片狼藉，真是慘烈的混戰......呃......這是......凍裂的肢體？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "（等等，這個人是——？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "呃——！這個醫生怎麼！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "你要是堅持不讓開，我連你一起殺！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......剛才撒在你們身上的藥劑，具有揮發毒性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "啊！？你、你對我們做了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "趕快說！不然我就讓你——讓你......讓你.......呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "難受嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "告訴我畢德曼在哪裡，我可以給你們解藥，否則接下來的三個小時裡，你們會在幻覺和嘔吐之間度過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "你這個惡毒的......我......我不知道......什麼畢德曼......我只是......貴族都得......死......唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......那很抱歉，你們都要去監獄裡待著了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "唔......？蘑菇？好大的蘑菇......怎麼回事，怎麼在動，怎麼在咬人——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "長官......很多人都受傷了......！他們已經佔領了轉角商業街和梅普樂廣場......但是，更多的人都被困在了十二音街道.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "我們沒法制止他們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......從第一個人受傷開始，我們就無法阻止任何事情了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "現在我們面對的結果有兩種，一，投降。二，組織進攻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "我們該怎麼做？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "投降，把控制權交給整合運動和叛亂分子，然後在凍土上餓死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "帶領民眾發起進攻，兩敗俱傷，死傷慘重，苟且偷生的人在凍土上餓死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......或者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "如果傷亡不可避免，至少少死幾個——咳咳，咳咳咳——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "呃......咳咳咳，咳咳咳——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "長官——伯父？伯父？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——！伯父，血，你的嘴角都是血......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "抱歉！讓一下！塔佳娜小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "伯父他，他說不出話來——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "您還好嗎？調整呼吸，肺部病變導致失聲，這種時候......這種時候應該......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "——怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "塞弗林長官他、他其實——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......你應該聽醫生的，戒煙。你的肺部頑疾不需要檢查就能看出來有多糟糕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "讓我檢查一下......先把領口打開——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "喂！別亂動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你......你是感染者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "欸！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......這是礦石病的症狀，源石從他的肺部擴張到了咽喉......你喉下那些黑色的粉末狀固體是......體表源石結晶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "嘖，體細胞已經開始與源石融合，這就是你根本不在乎健康的理由嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "難道是在剛才的戰鬥中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "這不是早期症狀或是急性病變，他早就已經被感染了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "是天災的時候......不對，那也太快了......感染時間還要更早......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "咳咳——咳咳咳——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......黑色的血塊，鈴蘭，取樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "好的——！抱歉，長官，忍耐一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "現在的醫院——肯定沒在運作了，嘁，先把他抬回議事廳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——沃倫姆德，不能，沒有長官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你再強撐下去沃倫姆德就真的沒有長官了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "你——這種時候表現得，還真像個醫生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "咳咳，咳咳咳——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "唉，吐了口血好像就可以說話了，還挺方便的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "嘴硬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "亞葉小姐，我有一個請求。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "你說你的，但我還是會把你帶回去，麗薩，扶著點他，塔佳娜，我們把他扛回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......各位，請，咳咳，隱瞞我的感染者身份......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "然後，我會承認我是火災的兇手，我是導致沃倫姆德行差踏錯的元兇......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "那真凶呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......顧不上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "啊......至少，至少這樣很多人就失去了廝殺下去的藉口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "但這樣還不夠......沒有足以鉗制他們的外力，他們依舊會前仆後繼地互相報復下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "我請求......羅德島的協助......即使我們現在，難以支付報酬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "如果沃倫姆德能挺過這次災難......我們會報答你們的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......我們不是慈善組織。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "請答應我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "我無權代表羅德島向你做出承諾......拯救一個近萬人口的城鎮，這超過了我們任務的範疇，也超過了阿米婭委任我的權限。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......但是，為了安托，“我們”是不會拋棄沃倫姆德的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......謝謝。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "抱歉讓一下，緊急傷患——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......灰喉？你怎麼一個人回來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "鈴蘭，把塞弗林長官抬進樓上的客房裡......不要讓其他人發現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "雖然很殘酷，但等塞弗林長官穩定下來後，他必須再次出現在眾人的視野中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈴蘭",
      "text": "啊，好的！交給我吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "塔佳娜......你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "......鎮上的每個角落都在發生暴亂，哪怕此時此刻，也在出現傷亡......我，我不能坐在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "我會去組織沒有參與暴亂的民兵，至少......至少縮小暴亂的規模。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "嗯，加油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——謝謝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......現在可以說了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "我們找到畢德曼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "那我們立刻就去抓住他，結束這場暴亂，為安托報——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "——不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "他已經死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "我們在B2座標位置的“留聲機”找到了他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "他的後腦部有明顯傷口，皮膚表面有冰晶殘留，有受到源石技藝襲擊的痕跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "在場幹員做不出準確判斷，但其他屍體的傷口和血液表明，至少在數個小時前畢德曼就已經死於暴亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "畢德曼已經死了，但是暴亂並沒有停止。這意味著什麼，我們都明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "卡達和斷崖正在搜尋他的住所，不出意外的話——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "等等......！你說，你說他已經死了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......如果你需要我重複一遍的話，對，他已經死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亞葉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我看著亞葉臉上的笑容逐漸凝固——笑容，嗯。\n因為安托幹員的犧牲，她的情緒變得很不穩定，直到我們得知了畢德曼的情報。\n不用被殖民問題，感染者問題和階級問題困擾，她簡單地快樂地找到了復仇的對象。\n她短暫地感到安心了嗎？因為明確的目的而釋然嗎？\n那接下來，我該怎麼處理她現在的這副......表情呢？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......果然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "這是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "這是危機合約的行動協議......畢德曼是簽訂了危機合約的天災信使。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "所以呢，難道這一切都在規劃之中？包括你自己的死，畢德曼......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "唔......但他這麼做是為了什麼？那個危什麼的，會是幕後黑手嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "讓人們喪生在天災中不符合他們的行事理念......危機合約也不至於幹出這麼喪心病狂的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......可如果......他打算幫助叛亂者以確保更多人生存下來？為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "說到底這樣真的能讓更多人活下去嗎？我聽灰喉姐說過，現在沃倫姆德的處境很糟糕喔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "不......危機合約只是一個平台。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "利用危機合約的信使中的確有少部分道德和常理不起作用的傢伙，他們只想“救下”盡可能多的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "......當時沃倫姆德已經遭遇天災，難道......為了讓外界勢力介入，他放了火......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "真慶幸萊恩哈特和羅德島的其他天災信使們並沒有和他們牽扯過多......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "可......不對......有什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "斷崖！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "看那頭！那家樂器店的那頭！好像有什麼奇怪的東西！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "奇怪的東西？那是......山？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "不對，是移動的岩石巨像......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡達",
      "text": "這個源石技藝，難道是那個傢伙在操縱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "那不是一個人的源石技藝能做到的——快，回去找亞葉她們！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斷崖",
      "text": "普通的民兵不可能攔得住一支身經百戰的作戰小隊——一支薩卡茲作戰小隊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "怎麼了？這個震動是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "喂！又是那個石頭巨像！快！快啟動“留聲機”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者",
      "text": "整合運動來幫助我們了！他們來了！他們來解放我們了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者A",
      "text": "整合運動萬歲！進攻！把那些腐朽的貴族趕出去！進攻！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武裝的感染者B",
      "text": "——整合運動萬歲！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "......掩護其他人撤退，回到城鎮中心區域，啟動“留聲機”，注意防守！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鎮民",
      "text": "塔佳娜，街道盡頭的那個......那個是？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......停，稍息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "是......我們現在，僅一步之遙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......一步之遙，就可以毀滅這座城鎮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "但我們的背後亦沒有留下希望與存續，他們高呼解放，解放的只有怒火和仇恨。這只是常見的，齷齪的進軍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "是嗎？我其實沒所謂的，事情到了這一步，已經不可能圓滿收場了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "這是最後的機會......在我們踏出這最後一步前，給他們的機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "......投降的機會？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "不......反抗的機會。彰顯信念的機會，讓我們和他們來代替所有人......分出勝負。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "吃力不討好，作為一個雇傭兵，你永遠是最吃力不討好的那個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "算了，還是聽你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "那麼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "——沃土磐石，站起來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
