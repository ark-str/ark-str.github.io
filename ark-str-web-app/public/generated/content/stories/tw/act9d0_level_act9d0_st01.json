{
  "server": "tw",
  "storyId": "act9d0_level_act9d0_st01",
  "groupId": "act9d0",
  "stageId": "act9d0_st01",
  "title": "求生",
  "storyCode": "DM-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act9d0/level_act9d0_st01.txt",
  "sourceHash": "c440e135e2f706968b3dc1970152a9cc8ab9b62b722fe178a07fbbc1beea184d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你們還要往前走嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不進行治療的話，你會感染的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "——我憑什麼相信一個魔族？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "魔族、魔族呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "身邊盡是些魔族，我都快忘記這個稱呼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "嘁，你不要跟在我們後面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我已經離得很遠了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "別這麼假惺惺的，要是想動手的話，現在就動手啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "盧、盧布廖夫，別刺激她比較好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......行了，我們自己走就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "別管她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "對、對不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "感染就感染，我們不要魔族幫忙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嗯哼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "這附近有一家廢棄的醫院。切爾諾伯格區級醫院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你們想知道在哪裡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "盧布廖夫......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "別聽她的，肯定都是騙我們的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "咱們甩掉她......走快點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "看到那邊的巷子了嗎？你從那個拐角跑進去，一分鐘之內跑到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "——跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "跑的還挺快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "她、她怎麼這麼快就跟上來了——唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "盧布廖夫......你的腿！血、血變成黑色了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "嘁，要不是剛才救了你，我怎麼會跑不過她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "對不起、對不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "算了！小聲點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "別讓她發現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "前面的街道，左拐，能看到一處被毀掉的廣場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "廣場西邊，那座最大的白色建築，是醫院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "廢棄的醫院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......我們，好像已經被發現了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "都是你不聽話——算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "喂，魔族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......你為什麼要告訴我們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "一時興起啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你們兩個，什麼關係？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......我只是出來找吃的，遇見了他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "是盧布廖夫救了我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嗯......所以你聽他的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "算了，隨便吧，現在，輪到你幫幫你自己的救命恩人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "你想讓他做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "盧布廖夫......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "沒什麼。我說過，前面不遠，就有一家醫院。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "當然，整合運動也不傻，不會乾放著那些醫療物資視作無物......所以，如果你想救這位盧布廖夫小朋友......就去偷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那裡都是感染者暴徒，是殺了你們的家人、親人、朋友的暴徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "也只有那裡有抑制礦石病早期症狀的藥劑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "去偷，去搶，怎麼都好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "但是不要指望那邊的人會幫你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "別去！沒必要聽他的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "但、但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "別去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他知道你的名字，盧布廖夫，你知道他的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "這和現在有什麼關係！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "別去！你做不到的！那裡都是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......我想試試......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "不光是盧布廖夫哥哥，好多人都在天災發生的時候受了傷......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "大家都很痛......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "你怎麼能不聽我的話！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他沒有義務聽你的話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "想要救那些人，想法很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "記住我說的那家醫院，醫療物資已經被集中在了地下倉庫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你可以從停車場的通風管道潛進去，或者從排水溝裡走，只要化學廢料沒那麼多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "說不定，你會死在那裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "看吧，你的腳都在抖了，別想了！我們就不該聽這個魔族的話！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "趕緊走吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "噫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "發、發生什麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "龍門發生了不少事......也讓這裡出現了一些缺口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在如今的切爾諾伯格，那可是難得的戰地醫院，怎麼會沒有別的人打它的主意呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你們覺得為什麼......身為魔族的我，會對那裡有一家醫院這麼清楚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "你這個——唔，啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他很痛苦，而且照這個情況發展下去，他無藥可救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "如果你不做決定的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你們就死在這裡吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "你、嗚、你到底想做什麼！別過來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "還是不去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "啊......不過你現在去說不定也晚了，既然已經發生暴亂，去偷東西就更難了吧——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我，我去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——嗯......會死哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "為什麼要聽她的話，是我把你救出來的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "可我、我想試試......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "你哪能做到啊！我們繼續去找藥店和食物，這樣就好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "對不起！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "啊......等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "連他的名字都不知道，想出聲阻止都沒辦法，真可憐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "你......你騙他！你這個魔鬼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "騙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我可沒有說一句謊話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "當然，信不信我，由你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "信不信他，也隨便你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......我，我要去找他，嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "他、他沒有我什麼都做不到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在擔心他會逃跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在想......他為什麼要把你一個人留給我，留給一個魔族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "我沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "*烏薩斯粗口*！你這個怪物——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "閉嘴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......就在這裡等他。一步都不許動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "否則，我現在就可以殺了你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "嗚——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你以為我是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我是兇手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是毀了這座城市，傷害你父母和朋友的兇手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......啊，哈哈，對了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "忘記你還有這把刀。那刀柄上的是薩卡茲的配飾，還染著血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你猜猜看是誰的血？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "嗚......嗚嗚，我，我不知道......你讓他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哭吧，孩子是可以哭的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "至於之後的死活......就要看你們的表現了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "他做不到的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "如果不是我把他從廢墟地下挖出來，他早就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......他不能沒有我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "沒有誰......是不能沒有另一個人的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "又安靜下來了，這座廢城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "自從那場屠殺之後，反抗者就少了很多。不錯啊，這樣才能少費點力氣，少死點人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不過，醫院的方向，好像也沒動靜了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "他......他沒有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "他也許......根本就沒有去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "都已經......嗚，這麼久了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他逃跑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "但是你救了他，他也會為了救你而努力，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "還是說，只有你才能救他，他不能救你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "他......他一直以來什麼事都做不好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "去找食物的時候也是！他連店裡有其他人都察覺不到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "都怪他！我的腿才會——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你要去哪兒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "我......自己回去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我說過，離開這兒你就會死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "但是他已經逃走了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "嚯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你的眼神，你在恨他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "我，我沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "就算......就算他去了......已經這麼久了......他肯定已經......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——住嘴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在他回來之前，你什麼都不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你可以覺得他會回來，也可以覺得不會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "但覺得他不會，懷疑他，恨他，是你的問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你假定他的失敗，他的逃走，為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "因為你是救了他的人？你是強的那一方？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......嗚嗚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "嗚啊啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你還有力氣哭啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "放心吧，很快你就會痛得哭不出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "念在你年紀小，又不是薩卡茲，如果你真撐不下去的話，可以告訴我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我來幫你解脫。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "嗚......呃嗯......嗚嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "已經意識模糊了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "算了......看來是真的來不及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "不要......我還能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "他......等他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你重新信任他，只是因為你太怕死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "小孩總是善於察言觀色的。想這樣從我這裡博好感，可沒戲呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不過，的確已經耽誤太長時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "最後十分鐘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "放心，真到了那個時候，我倒也不至於讓一個孩子在痛苦中死去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......已經連嗚咽的力氣都沒有了嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在想什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你在恨我嗎？還是在恨他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "又或者，在後悔自己要多管閒事，救一個人，害得自己負傷？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......我沒有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你還有力氣說話，倒是讓我刮目相看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "聽著，盧布廖夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "決定一個人所作所為的，是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是出身？身份？還是過去？一直以來扣在他身上的行為枷鎖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "都不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是他生命中的一切對他產生的影響，是時刻在改變的，他自己的信念和想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "以及，他到底多麼相信自己的這個信念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你救了他，但你自己心底裡都不相信他，瞧不起他，因為你把自己當做了他的救世主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "他呢，也很單純。你救了他，所以他想救你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在這方面，他的確比你強一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "收好你的刀，那是薩卡茲的刀。我替它的主人把它送給你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "使用它，學會使用它，或者拿去賣了換點錢，隨你喜歡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那麼，就這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "你......你在說什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "盧、盧布廖夫！你還好嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "你看！你看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我把一整個醫療箱都偷到手了！有止痛劑，還有繃帶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "盧布廖夫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "吵死......了，我還沒死......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "好、好的，我這就給你包紮一下傷口......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "這個繃帶是怎麼用來著......這、這是抑制劑？我、我來打開......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......你的父母，不是醫生嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "欸......他們沒教過我，我試試......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......你受傷了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "沒關係的，輕傷而已......只是被人用鐵棍敲了一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "笨......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "......嘿嘿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "那個......薩卡茲呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "啊......我進來的時候，就沒見到她人了......她剛才一直和你在一起嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "盧布廖夫哥哥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......呃，那個，你、你叫什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "嗯？啊......安德列。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "全名呢......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "安德列·費奧多爾·奧斯特洛夫斯基......嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "笑什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "你總算問我了，盧布廖夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "......對不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "沒、沒有那個意思......你不用道歉的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "好了，現在好點了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅強的孩子",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "我來扶著你，我們先回去一趟吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孱弱的孩子",
      "text": "大人們見到這個醫療箱，也會高興的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我看著那兩個孩子笑了。\n當不安的種子消散之後，他們才可能在這座城市裡......在這片大地上生存。\n活著吧，只有活著才能受苦。\n就像飛蛾撲火，就像蟲子紮進深坑。\n即使付出代價，也總要追尋點什麼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
