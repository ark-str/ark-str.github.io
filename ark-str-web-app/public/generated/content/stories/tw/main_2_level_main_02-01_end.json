{
  "server": "tw",
  "storyId": "main_2_level_main_02-01_end",
  "groupId": "main_2",
  "stageId": "main_02-01",
  "title": "龍門之行",
  "storyCode": "2-1",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_02-01_end.txt",
  "sourceHash": "59935b8a4fb9f4a6fe9282ea7cf77817df989d6a4e86184b66d1e6be863a4666",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十三关（后）\n10:14 p.m. \\ 晴 \\ 能見度 19公里\n龍門5區外 檢疫口"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "長官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "他們來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "請注意——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "受天災影響，龍門全域處於停航狀態。龍門5區所有入城關口將於2小時後關閉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "請積極配合工作人員進行礦石病檢疫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "一旦發現任何未經登記的感染者，請廣大市民立刻向最近的警員通報，",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "近衛局將依照《緊急處理法案》依法對其進行拘捕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "請注意——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "和傳聞中一樣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "走吧，博士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "羅德島與近衛局約好在十點見面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "現在是十點十四。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你們遲到了十四分鐘，無謂地浪費了我十四分鐘時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......抱歉，陳長官，這片區域剛才有整合————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "行了，我知道。不過這些都不重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "——這個人是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "Dr.{@nickname}是羅德島的顧問。凱爾希醫生應該通知過龍門的各位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "哼.......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "好了，人已經到齊，現在你們需要跟我去見——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "陳長官！不好了！不好——感染者——那又——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "慌什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "一隊，戒備！狙擊隊員，就位！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "普通市民",
      "text": "發生，發生什麼了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "放開我！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "嘖......怎麼回事，彙報情況。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "讓我過去！！為什麼要抓我！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "我們不是怪物！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "有感染者——不服從管理——我們——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......我自己都看到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "把他們全部拘押。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "立刻疏散人群，半小時後通過複查流程後，再開放關口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "還有，把檢疫口檢查線向前推四十米。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "羅德島的，除了你和Dr.{@nickname}，其他人不需要一起同行，留在這裡協助龍門邊防進行駐守。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "要是連這點小事都處理不好，無論是什麼任務，我可都沒法交給你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "PC94172，你給這些人安排一下任務，今晚不要再出亂子了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "明白，陳警司！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "諸位，請注意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "（陳長官真的很嚴格......比我想像的要嚴格......）",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......（點頭）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "你們，",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "跟我來。——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "到了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "好，好高的建築！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "唔......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "對，對不......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "——羅德島的身手還算不錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "謝謝陳長官誇獎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "只不過——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "切爾諾伯格事件發生之後，什麼人都瘋了一樣地向龍門跑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "感染者就該清楚，來龍門會有什麼下場。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我再提醒你一次。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "龍門就是下一個切爾諾伯格。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是凱爾希醫生......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "你們羅德島的代表已經和魏長官先行接觸了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "在這裡等著。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "我一會兒通知你們。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "呼......那個陳警官，真的很難應付呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士，接下來的交涉就交給凱爾希醫生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "請相信她吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
