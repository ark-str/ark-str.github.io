    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "isRemote": false,
      "text": "看來她的謀劃已經到最後的關鍵階段了，死魂靈在回應她的呼喚。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_1035_wisdel_1",
