    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……你們有沒有感覺到……飛空艇在加速？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "飛空艇在試圖掙脫骸骨！",
