{
  "server": "tw",
  "storyId": "act13d5_level_act13d5_04_end",
  "groupId": "act13d5",
  "stageId": "act13d5_04",
  "title": "輝煌盾工業",
  "storyCode": "MN-4",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act13d5/level_act13d5_04_end.txt",
  "sourceHash": "5e6d7e236c8d7626c29e2bda5be4fa885f48ccc1fedc41394f6a204650161c63",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔 4下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "還剩——八名——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "不，是該說“還剩”八名，還是該說竟然已經有近半數騎士負傷退場！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "等等——說話間，“灰髮”騎士就在“泉水”騎士身上奪走了一個積分——啊！！“穿岩”多爾克偷襲了二人！卓有成效！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "處處都是爾虞我詐——這就是炎刃混戰賽的魅力，純粹的暴力！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "光——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "就這點能耐，你是怎麼打贏英格拉的！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "你的劍術......也完全比不上姑母！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "嘁，我一定會把你從那個積分榜上拽下來的，“臨光”，看招！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "啊——背後！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "啊——！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "唔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "又見面了，小臨光，這次你可沒地方去了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "“樹枝”之後是“焰尾”嗎！！喂喂喂，這是比賽開始後第幾次針對小臨光的襲擊了？這可不是你的個人秀啊，瑪莉婭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "那個傢伙真吵啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "不過剩下的傢伙越來越少了，這下我們總算可以比試一下了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "——比試的話，我樂意奉陪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "哦哦，不錯嘛，比起你和“塑膠”打的時候，眼神好多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "嘿——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "眨眼，一睜，一閉。"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "（下面！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "呃——！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "唔哦？這都躲開了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "（剛才她是什麼動作......與其說快，不如說靈巧得過分......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "哎，這下我明白為什麼你能從英格拉和瑟奇亞克手下堅持那麼久啦......比想像中要扎實嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "都是“鞭刃”教你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "嗯，警惕性也不錯，學習速度也挺快的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "但是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "這下，你就少了一分了，我倒是挺喜歡這個新賽制的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "再這樣下去，你贏下“塑膠”存的那點分數，很快就沒有了喔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "嗚——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "唔哦哦！！該死的松鼠——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "你就不能好好躺著嗎！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "哈，武器都被打飛了，看你怎麼辦！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "撿回來不就好了！蠢貨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "少廢話！你現在就要死在這裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "——小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "怎麼發動的源石技藝——不可能，你明明沒有武器！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“樹枝”騎士",
      "text": "不對，你......你......你難道——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "睡吧你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "哎呀......又白賺了幾分，真是個好日子......那我們繼續吧，小臨光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "（要來了——！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "知道嗎，其實我是感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "欸？感染——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "又是一分，太容易分神啦你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......但是感染者，不是騙人的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "你剛才直接釋放了法術......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "很可惜不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "血騎士奪冠之後，感染者就被公開允許成為騎士了——耀騎士卻因為感染者身份被逐出了卡西米爾，不可惜嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "姐姐她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "你啊，出道第一戰是在呼嘯競技場，對吧？只要帶著文件去騎士協會註冊，申請參賽資格，然後就可以全副武裝地等在後台啦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "你知道感染者要怎麼樣才能走到那個地步嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "首先，要從裝滿鉗獸的籠子裡活下來，然後，踩著其他感染者的血，一步一個腳印......贏回自己正常人的身份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "說到底，他們可不是打算尊重感染者，只是打算把感染者變成更進一步的觀賞器具而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "......會不滿也是理所當然的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "我們的目標是那些自以為是的貴族騎士......在他們制定好的規則裡，狠狠剮他們一刀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "我是不會真的在這裡把你踢出局啦......畢竟我是打心底裡尊敬那個耀騎士的，和感染者的立場無關。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "至於從你那兒搶來的分數，就當我替“鞭刃”給你上一課吧，從你和英格拉的對局中就能看出來，你還是不明白騎士競技意味著什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "無知的熱情和自欺欺人的努力放在其他理想道路上，頂多摔慘一點，但放在騎士競技場裡，是會死的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "所以，繼續加油吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......等等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "光？是打贏英格拉的那個時候......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "——喝啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "來真的！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "我可搶回來一分了！“焰尾”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "哎呀，沒想到你還挺好勝的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "——不過，這樣才有耀騎士妹妹的樣子！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "再度拉開距離，我們劍刃相向。\n......奇怪的感覺。\n明明只是聊了幾句，從她身上卻感受不到瑟奇亞克和英格拉那種令人作嘔的壓力......是性格的原因嗎？\n但她應該很強吧，嗯，很迅速，很精巧。"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "你在笑喔，這麼有自信？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "......有嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的粉絲",
      "text": "欸，試試不就知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "那麼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "時間——！結束！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在主持人喊停的瞬間，我們同時停下了動作。\n只差毫釐——雙方都只差毫釐，就能觸及對方的盔甲。\n“焰尾”半開玩笑似的輕輕敲了敲我的盾。"
    },
    {
      "type": "dialogue",
      "speakerName": "“焰尾”騎士",
      "text": "說不定你能從我這兒再搶回一分來著，瑪莉婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瑪莉婭",
      "text": "也許是兩分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“焰尾”騎士",
      "text": "哈哈哈哈——光在觀眾席上看著，可感覺不出來你這麼執著啊，小臨光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "我們的裁判已經做出了判決！在這場戰鬥中站到最後的，只有四人而已！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "哦，各位觀眾，決定你們錢包悲喜的時刻到了，就算支持的騎士在剛剛開戰就遭圍毆致昏迷也不要氣餒，競技場隨時歡迎各位再次光臨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "第四名！獲得十點競賽積分，始終遊走在戰場上，幾乎避開了所有正面對決，聰明的存活者，“樹枝”丹尼爾！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "第三名！從比賽開始就被全場追著跑，幾乎沒有喘息的時間，分數起伏可能是場上第一位！楚楚可憐的獨立騎士，瑪莉婭·臨光！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "第二名！在開賽的混亂中靠一己之力連奪三人，之後一直利用厚重的盾牌固守賽場一隅！人形堡壘，“石灰”馬爾高！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "以及，本日賽事冠軍，共斬獲二十二點積分，幾乎屢戰屢勝，毫不拖泥帶水的超級新人——“焰尾”索娜！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "讓我們為她創造出的巨額獎金而歡呼吧——！接下來！我們將公佈各個獎池的開獎情況！騎士一夜登頂，看客一夜暴富！盡在炎刃競技場！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "發言人恰爾內",
      "text": "啊，歡迎您，小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人恰爾內",
      "text": "有幸得見卡西米爾無胄盟有史以來最年輕的一位白金大位，在下恰爾內，深感惶恐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "text": "客套辭令就免了吧，發言人先生。而且說到底，本來就是你們喊我來的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人恰爾內",
      "text": "哪裡的話，我只是聯合會的喉舌，代行董事們的意圖，我怎敢僭越指揮白金大位呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "text": "說是這麼說，只是因為那兩位太忙，再上頭那三位又使喚不動罷了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "text": "唉，這可真是......加班命啊，本來任務就不少了，還要特地被喊過來......特錦賽結束之後我想去薩米旅遊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人恰爾內",
      "text": "只要聯合會同意，我現在就可以著手為小姐準備一套薩米鄉野別墅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "text": "還是要等工作結束啊，那——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "text": "——你要無胄盟做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人恰爾內",
      "text": "我們的問題有很多，小姐。不聽話的感染者，奇怪的傳言，過於引人注目的騎士......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "發言人恰爾內",
      "text": "但既然得到了無胄盟白金大位的首肯，我相信這一切——都不是問題。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "我回來了！廚師長呢？快讓他開工了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "今晚讓廚師長做頓大餐，瑪莉婭一會就到......好好犒勞她一下，別說是我吩咐的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "僕人",
      "text": "佐菲婭小姐，您有一位客人，說是有急事相商。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "客人？現在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "等瑪莉婭回來之後再——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "啊......抱歉，佐菲婭，我擅自進來了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "你是上次那個......哈......我記得以前你有一家自己的小公司，那時為了搶到我的贊助權，你也是這麼闖進來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲婭",
      "text": "現在呢，又有什麼事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "我，呃，是這樣......我這裡有一些情報......可能有一些是傳言......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "請不要聲張！無論真假，這些賽事安排都是機密中的機密......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "不過我覺得也許你該知道......就當我還你一個人情......還有，呃，希望你們能有一個好結果......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業員工",
      "text": "我太久沒有看到過好騎士們......能有一個好結果了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
