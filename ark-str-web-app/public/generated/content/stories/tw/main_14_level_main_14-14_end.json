    },
    {
      "type": "choice",
      "options": [
        {
          "label": "痛痛痛！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我的背才剛受傷！",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "她看著你，彷彿正試圖從你身上找到過去熟悉之人的影子。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……為什麼用……這種眼神看著我？",
