        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "小怪物，給我忍住！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "她朝著黑色幽靈聚集的地方丟出數顆炸彈。"
