      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "speakerId": null,
          "text": "（高昂的咆哮）"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "……"
