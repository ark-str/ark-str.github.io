      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "這樣就能確保他們沒辦法進來？這麼簡單……就是你天才的計劃？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "簡單……嗎？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "簡單的辦法也總是很有效啊。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "等等，那是……結晶化？"
