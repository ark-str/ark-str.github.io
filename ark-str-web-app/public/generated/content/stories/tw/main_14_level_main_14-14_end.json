        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "船艙中的影子",
          "speakerId": null,
          "text": "異族的魔王，我不會再為你多費口舌！"
        },
        {
          "type": "dialogue",
          "speakerName": "船艙中的影子",
          "speakerId": null,
          "text": "因為特蕾西婭，我已經容忍你們一次又一次冒犯了。"
        },
        {
          "type": "dialogue",
          "speakerName": "船艙中的影子",
          "speakerId": null,
          "text": "你們可知，你們試圖阻止的到底是什麼？"
        },
        {
          "type": "dialogue",
          "speakerName": "船艙中的影子",
          "speakerId": null,
          "text": "薩卡茲需要的不只是這場戰爭！"
        },
        {
          "type": "dialogue",
          "speakerName": "船艙中的影子",
          "speakerId": null,
          "text": "你們想掐滅的，是足以扭轉我們命運的火焰！"
        },
        {
          "type": "dialogue",
          "speakerName": "船艙中的影子",
          "speakerId": null,
          "text": "你們無法得逞——"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "淹沒阿米婭的黑色潮水正在退去，陰影中拉扯她的力量也在逐漸減弱。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "他在收縮自己的力量？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "所有的陰影……都消散了？"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "看來其他人先找到了死魂靈盤踞的地方。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "博士還好嗎？不知道凱爾希醫生和W小姐現在在哪……"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "我能感受到憤怒情緒最激烈的地點，那裡應該就是我們要找的地方。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "博士，凱爾希醫生，撐住啊……"
