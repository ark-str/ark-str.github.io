          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "——！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": null,
          "text": "如此強烈的痛苦和憤怒……"
