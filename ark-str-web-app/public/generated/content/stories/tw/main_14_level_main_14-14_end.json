        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "你一開始就做好了獨自堵門的準備？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不是還有Mon3tr和你嗎？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我相信你和Mon3tr。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "相信……我？呵。"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "在那件事弄清楚之前，我——"
