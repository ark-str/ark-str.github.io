      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerId": null,
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "她沒有反駁，下意識地扔出了隨身的爆炸物。"
