    {
      "type": "dialogue",
      "speakerName": "塞爾蒙",
      "speakerToken": "avg_npc_724_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "走。拿上維多利亞人的刀，路上看到的武器，我們都拿上。"
