{
  "server": "tw",
  "storyId": "story_meteo_set_1_story_1",
  "groupId": "story_meteo_set_1",
  "stageId": null,
  "title": "一星螢火",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_meteo_1_1.txt",
  "sourceHash": "eea8c5f90c02b09b8282bf8cf045614786a87d853b2ce1d92fa6e4578f58de91",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "樺樹、椴樹、杉樹、松樹......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "車前草、地團花、接骨木、懸鉤子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "夕陽、暮色、傍晚、黑夜......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "怎麼樣，這些生詞都念熟了嗎？接下來，我們試著朗讀一整篇文章吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "嗯，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "“......花園裡新栽的兩排接骨木開花了，甜美的香氣讓人暈暈的。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "“在我模糊的雙眼中，懸掛在天幕上的夕陽好像變成了兩個......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "“這真是、真是一個......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "怎麼停下了？是遇到什麼問題了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "隕星老師，這裡有一個生詞我不會念。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "來讓我看看......\n不好意思，是我的錯，應該是昨天準備的時候看漏了，沒有標記它。"
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "來，先和我一起念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "（薩卡茲語）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "（複述隕星的話）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "很好，你念得很標準。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "隕星老師，這個詞它是什麼意思啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "這是一個時間名詞，也可以用作副詞，它對使用情景有特殊的要求，只能是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "哎，前面的，快走啊，堵在路中央幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵A",
      "text": "他媽的，又一個要飯的過來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "要飯的？在前邊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵A",
      "text": "你這丫頭，怎麼還伸出腦袋往外看，小心他看到你就纏過來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵A",
      "text": "媽的，他還真的過來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "那有什麼？不理他繼續朝前走就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "先生女士，有人需要代寫書信嗎，價格不高，幾個銅錢就夠，或者給些吃食也可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵A",
      "text": "喂，小薩利，要不要老子讓這要飯的給你搞封信！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵B",
      "text": "放你媽的屁，老子根本不識字！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵A",
      "text": "哈哈哈，這不是更好嗎，他還可以給你念信，那麼這個要飯的就有兩份活幹了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵B",
      "text": "滾蛋吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵A",
      "text": "看到了吧，要飯的？快滾開，我們沒有閒錢，也沒有寫信的必要，那些我認識的人，還活著的，都在這個隊伍裡了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "先生，別走，等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "喂！先生，別走啊！哪怕給口水喝也行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "唉，真是的......喂，你過來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "小姑娘，你需要寫信嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我沒有興趣，我這裡有塊餅，你拿了快走吧，這裡是戰場，用不到你那些玩意兒。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "（肚子咕嚕作響）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "我不是乞丐，小姑娘，我不能白拿你的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "你要學讀寫認字嗎？那些大頭兵年紀大了，頑固得不行，意識不到字詞的價值。你還年輕，以後會有大用處的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我不能停下，我得趕路，我沒時間聽你講課。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "我可以跟著你的隊伍一起走，如果你決定做我的學生，在教會你之前我不會離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "唉，這塊餅還給你吧，小姑娘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "收著吧，勸你趕緊吃掉，到我們要去的地方還需要走很久，你可以一邊走一邊講。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "哎，好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "你會寫自己的名字嗎？我可以先教你寫這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我們沒有名字，只有代號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "那你的代號是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "鈍鏑，是之前的一位團長給我取的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "這是個很好的代號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我沒看出哪裡好，那位團長告訴我這個詞的意思是沒用的箭頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "哈哈，薩卡茲有一句俗語“繡蝕箭頭蹭破皮，小命立刻就歸西”。破傷風可不是鬧著玩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "噗嗤......你在戰爭開始前到底是做什麼的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲過路人",
      "text": "教書，那時候我在教書。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "兩個月後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "唉，這場仗不知道打到什麼時候是個頭啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（包紮自己的傷口）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "你的傷口怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "沒有大礙，我已經消過毒了，拿繃帶纏幾圈很快就能恢復。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "沒事就好啊，這太陽曬得真舒服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "你上次借給我的書我就要看完了，你還有其他書嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "剩下的書都是詩和散文，你又不感興趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "那還是算了，你自己收著吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "喂，鈍鏑，你傷口包半天了，好了沒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "沒有大礙，已經處理過了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "大礙？這啥意思？嘖，聽不懂的話少說，趕緊來分錢了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "二、四、六、八、十......一共十四顆人頭，哼，收獲蠻多嘛！媽的，要不是跑了幾個，大伙能賺更多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（皺起眉頭）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "喏，這是你該得的報酬和乾糧，我先走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "等等，先別走，東西少了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你在胡說些什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我這次擊殺的目標中有兩個狙擊手和一個裝甲擲彈兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "按照當初的約定，他們的價格分別比普通目標高百分之三十和百分之五十，所以你還欠我十二個金幣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你什麼時候能把帳算得這麼清楚了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（伸出手）十二個金幣，不信的話，可以和我一起去找團長，算我酬勞的同時也好好清點下你的小金庫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "鈍鏑，你什麼意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "都是同行腥風血雨裡賺的錢，自己暗藏也就算了，裝糊塗沒必要吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "......拿了就把嘴閉緊，鈍鏑。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（聳肩）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "哈哈，你學得很快嘛，這才短短兩個月，基本的算數你就掌握了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "是你教的東西太簡單了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "是啊，你該學的已經都學會了，我也該離開了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "給你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "半袋金幣都給我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "是這兩個月的學費。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "哈，那我就不客氣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "離開後你要去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "東面吧，聽說那裡的戰事不是很頻繁，或許還可以找到一兩所殘存的學校。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "你有武器，身手也不差，加入傭兵團完全可以填飽肚子，為什麼非得選擇用更艱難的方法活下去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "哈哈，卡茲戴爾有那麼多靠武力吃飯的人，也不差我一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "嘖......你們這些文化人最麻煩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "那本書你什麼時候能看完？我離開前記得還我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "明天吧，就差一個結尾了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "“馬黛拉覺得窗子透過來的月光過於明亮，於是她揉揉眼睛，拉上窗簾，在......中她沉沉睡去。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "嗯，這個詞是什麼意思？以前沒有見過......算了，繼續讀下去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "“與同伴們圍坐在篝火旁，馬黛拉撥弄著火中的栗子，它甜蜜的氣味是這......的饋贈。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "呃，怎麼又是這個詞，煩死了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "“馬黛拉闔上門，拿起腳邊的行李準備上車，臨行前她再次回想起自己在這裡度過的無數個......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "無數個什麼啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "“別了，那些......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "馬黛拉你到底在和誰告別啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "“或許在以後的日子裡，她還會再遇到......但不會有......像這裡的......一樣，令她如此難忘。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "啊啊啊——為什麼這句裡面有這麼多這個詞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "這個破詞到底是什麼意思啊啊啊！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "哈哈，你看完的時間比預計的久啊，怎麼樣？要是喜歡我可以送給你，就當作離別贈禮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "不了，比起小女孩在農莊裡扮家家酒，我還是更喜歡冒險小說，而且讀它的時候我一直很煩躁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "遇到問題了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "是的，那本書出現了一個詞，我從來沒有見過，我試著跳過它繼續讀，但是它出現的頻率實在是太高了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "給我看看......啊，原來是它，這個詞是個時間名詞，有特指的情景。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "它指的是一個令人心生歡喜，悠閒寧靜的夜晚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "什......麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "一個快樂的夜晚，也可以這麼理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "那是什麼意思？夜晚不可能快樂，也不可能寧靜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "怎麼不可能？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "夜晚都是漫長的、黑暗的、寒冷的，它還是危機四伏的、讓人提心吊膽的......總之，我討厭夜晚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "之前有很多次我都覺得自己會死在某一個深夜，變成一具被野獸啃食的屍體，再也沒法見到第二天的太陽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "你能理解“一具被野獸啃食過的屍體”這種複雜的名詞，卻沒法理解“一個悠閒寧靜，讓人愉悅的夜晚”？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "那些屍體我們這一路上見過很多啊，你一解釋給我聽，我立刻就能聯想到那些場景。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "唉......既然你提到了聯想，那不妨讓我們靠進行聯想來理解這個詞，你先閉上眼睛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "那時你還小，一個晚上，你依偎在母親的身邊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "停，我從沒見過她，想像不出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "那在你的成長過程中有沒有其他......比較有份量的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我之前的團長，是她從戰場上撿到我並撫養我長大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "對，你依偎在她身旁，聯想一下這個場景，是不是有了一些感覺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我靠向她，然後她會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "她一把推開我，告訴我傭兵團中不需要柔弱的孩子，隨即遞給我兩桶水，讓我繞著營地跑十圈，還不許灑出一滴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我感覺肩膀酸了起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "行行行，我們換一個場景去想吧。要不這樣，夜晚你和夥伴們團團圍坐在森林中，支起了篝火，一個湯鍋架在火上，發出濃郁的香味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "你聯想下，是不是感覺到了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我探出頭，想要靠近湯鍋去細細品味那香氣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "對，就是這樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "然後我回過頭，發現一隻手不老實地伸向我的背包，試圖從裡面拽出錢袋。該死，為什麼當時團長要招一個慣犯進來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我現在感覺非常氣憤，想要痛打他一頓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "......算了算了，重新來過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "那麼，一個夜晚，溫柔的月光鋪在地面，你把被子裹在身上，眼皮逐漸闔上，馬上就沉入夢鄉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "你感覺到......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我感覺到恐懼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "會有炮火......炮火隨時會降下來，發出震耳欲聾的爆炸聲......我捂著耳朵，躲進行軍床底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "唉......看看戰爭都對你們這些孩子做了什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "抱歉，你說了這麼多我都不能理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "沒關係，不著急，我再想想辦法，你肯定能明白的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "就是一個詞而已，你根本沒必要這麼費盡心思來教我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "小姑娘，你知道嗎？每年都會有很多新的事物出現在我們的生活中，同時也會有很多用來描述它們的詞彙不停湧現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "其中的大部分詞彙會隨著事物的消失一同被人們遺忘，不再被提到，不再被使用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "但是有些詞彙，它們是特殊的，在口口相傳的過程中，它們會被一直銘記。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "那是因為，它們所描述的東西是永恆不變的，它們也代表著這個民族最核心，也最有價值的精神。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "它們值得你的理解，值得你將它們保存在心裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "萬一......我就是不能理解呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "哈哈哈，耐心，給它點時間，它會在你心裡扎根的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "小心腳底下的枯樹幹，剛下過雨上面長了青苔，很容易滑倒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "知道了，你話太多了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "走了這麼久，你現在可以告訴我，半夜把我叫起來是為了什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "你起床氣真的很大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "不好意思，請告訴我，您帶我來到此地有何貴幹？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "（抖開一塊布鋪在地上）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "請坐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（一臉疑惑地坐下）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "請用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "這是......桃子罐頭？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "我就猜到你會喜歡這個，前幾天你看你們團長吃，看得眼睛都直了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "哼，也沒有那麼好吃嘛，你從哪裡搞來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "我用一本書和你們團長換了兩罐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "什麼書那麼貴重？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "沒什麼，一個古老的手抄本，挺破的，沒啥用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "別騙我，團長一直在收集珍貴的古董書，然後倒賣給哥倫比亞人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "我沒騙你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "......這還有半罐，你要吃嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "哈哈哈，你吃吧，那是給你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "謝謝......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "看這周圍的一切，你有感覺到什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "啪——"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（嫌棄地看著自己的手心）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "這裡蟲子有點多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "事實上，你可以不用拍死它們，它們不咬人......算了，不提這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "尋找這些飛舞的小傢伙花了我好幾個晚上，我帶你來看是因為它們很特殊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我看到了，它們的屁股在發光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我之前在水潭旁邊見過這些飛蟲，我當時並不知道它們是蟲子，我以為......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "以為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "以為它們是鬼魂，就是那些在戰場上死去的人留下的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "的確，很多地方會把這些小蟲子和墳墓周圍的鬼火聯繫在一起，但是二者的發光原理並不相同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "鬼火是因為屍體腐爛分解後會生出一種氣體，燃點很低，常溫下和空氣接觸就能燃燒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "那這些蟲子呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "這些蟲子它們自身就能分泌出一種獨特的化學物質用來發光，它們還可以透過呼吸來控制體內的生化反應，從而調節螢光的明暗程度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "你來看，這是它們的臀部，尖尖的，裡面儲存著大量的螢光色素和發光細胞......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鈍鏑看向男人的手心，一隻飛蟲斂起翅膀，停在上面，尾部閃爍著藍瑩瑩的光芒。\n它吸引了更多飛蟲的靠近，直到將男人的整隻手都包圍在螢光中。\n關於這些小蟲子，男人似乎有講不完的話，裡面夾雜著一堆複雜拗口的單詞，鈍鏑一個也不懂。\n可鈍鏑並不苦惱，她的內心溢出了陌生的感覺，說不清道不明。\n就像一隻小蟲在她心裡微微振動翅膀，盤旋著向上飛舞，它尾部的螢光渺小、微弱，但極富生機。"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我似乎感覺到了什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "這些小傢伙喜歡把卵產在水......什麼，你感覺到了什麼？！快說說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我覺得——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然，女孩正欲吐露的剩下半句話被響徹夜空的爆炸聲無情打斷。\n那些聚集在兩人周圍的小蟲也被傳來的響動驚起，四散逃開，螢光幾次閃爍，最終沒入昏暗的樹林。\n遠處滾滾濃煙升起，將夜空中僅有的幾顆星星遮蔽。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "糟了，是營地的方向！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "鈍鏑，等等！你還沒有說完，告訴我，你感覺到的是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "別問了，我們得趕緊回去，現在不是說這些的時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "這對我很重要，告訴我，求你了，我必須知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "說點什麼，求你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "什麼都沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我什麼都沒能感覺到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "對不起，它們飛走得太快，我沒能抓住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "不，你感覺到了，對嗎？我知道，我能從你的表情看出來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（慌亂地搖頭）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "如果你什麼都沒有感覺到，那為什麼、為什麼你落淚了呢？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "（胡亂擦去眼淚）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我想，或許在我的心裡，找不到可以讓它扎根的土地。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "鈍鏑，你剛剛去哪裡了？團長到處問你為什麼不在場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我去林子裡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "大晚上你跑那麼遠幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "她在巡邏，她一直不是很放心前幾天那些逃跑的目標。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "是、是的，我覺得他們有可能回到這裡實行報復。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "你還真沒猜錯，就是那些傢伙偷襲了營地，守夜的傢伙因為睡著了沒發現，被抹了脖子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "今天守夜的是小薩利？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "沒錯，他死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "這一把大火燒得，估計物資也剩不了幾樣了，忙活幾個月，還得繼續餓肚子，他媽的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "有受傷的人嗎？傷情如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "好幾個人燒傷了，但藥品損失也很嚴重，看他們自己能不能撐過去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲雇傭兵",
      "text": "我先走了，建議你趕緊去找團長，不然他肯定會朝你發脾氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "你該動身前去找你的團長了，鈍鏑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "你......還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "明明遭受不幸的人是你，為什麼反而要詢問我的感受？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "你看起來很痛苦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "別擔心，那不是因為你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "那是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "為了一片焦土，一片再無生機的焦土。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "夜深了，我先離開了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "好了，就送我到這裡吧，接下來的路我自己一個人走就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "再一起走一段吧，以後就沒什麼再見的機會了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "這些天，我一直很想找個機會謝謝你，你教給我的很多東西，都令我受益匪淺。至於那個詞......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "雖然我始終不能理解，但我相信有人可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "好了，這些不必再提了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "......抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "別道歉，這不是你的錯，從來都不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "在遇到你之前，我見過很多孩子，就像你一樣，顛沛流離，見慣鮮血與屠戮，從一處戰場奔赴下一處，永不停歇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "但只有你，只有你放緩了腳步，為了我兜售的那些......知識。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "許多年來，我一直堅信，靠傳授知識與文化可以改變糟糕的現狀，抵禦野蠻的侵襲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "現在看來，是戰火勝利了，它將我所學的變成了滑稽無用的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "你要放棄了嗎？如果你都不再堅持了，還有誰會去教授那些詞彙的真正含義？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "如果沒人能理解，沒人會保存，它們會從我們的生活中徹底消失啊，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "那些詞彙代表的美好轉瞬即逝，這片土地唯有苦難永存。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "鈍鏑，我無力對抗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "可是、可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "好了，別哭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "我把這本書給你，這些年我走遍卡茲戴爾，收集各地語料，一直想要完成它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "薩卡茲語詞典？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "那個詞我還沒有收錄進去，如果未來某一天有人讓你理解了它，就代我把它寫上去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鈍鏑",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲教師",
      "text": "把眼淚擦乾，小姑娘，我們就此別過吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "老師？老師？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "哦，對，它指的是一個令人心生歡喜，悠閒寧靜的夜晚。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "啊，原來是這樣，我明白了！謝謝你，隕星老師！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "（摸摸孩子的腦袋）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "不過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲孩童",
      "text": "不過隕星老師，你為什麼在哭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "因為你很聰明。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
