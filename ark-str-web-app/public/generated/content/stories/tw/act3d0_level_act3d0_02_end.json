  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錫蘭",
      "speakerToken": "char_348_ceylon_4#7",
      "operatorId": "char_348_ceylon",
      "portraitKey": "char_348_ceylon",
      "text": "快！博士！我們往沙灘那邊走！"
    },
    {
      "type": "dialogue",
      "speakerName": "錫蘭",
      "speakerToken": "char_348_ceylon_4#7",
      "operatorId": "char_348_ceylon",
      "portraitKey": "char_348_ceylon",
      "text": "沙灘上有大量遊客聚集，混進人群裡面他們就追不上我們了！"
    },
    {
      "type": "dialogue",
      "speakerName": "保鏢",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "站住！"
    },
    {
      "type": "dialogue",
      "speakerName": "錫蘭",
      "speakerToken": "char_348_ceylon_4#7",
      "operatorId": "char_348_ceylon",
      "portraitKey": "char_348_ceylon",
      "text": "就憑你們！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "char_340_shwaz_2#2",
      "operatorId": "char_340_shwaz",
      "portraitKey": "char_340_shwaz",
      "text": "......"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "欸，你是——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "speakerToken": "char_348_ceylon_4#4",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "黑！太好了你終於來了！"
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "speakerToken": "char_348_ceylon_4#4",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "還好有你在，克洛寧這是怎麼了！？"
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "speakerToken": "char_348_ceylon_4#4",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "博士，她就是我之前跟你說......"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "speakerToken": "char_340_shwaz_2#2",
          "operatorId": "char_340_shwaz",
          "portraitKey": "char_340_shwaz",
          "text": "小姐，老爺不在城裡，你得聽克洛寧的。"
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "speakerToken": "char_348_ceylon_4#8",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "黑？你在說什麼？"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "speakerToken": "char_340_shwaz_2#2",
          "operatorId": "char_340_shwaz",
          "portraitKey": "char_340_shwaz",
          "text": "快跟我回去找克洛寧，把這些人都交給他。"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "speakerToken": "char_340_shwaz_2#2",
          "operatorId": "char_340_shwaz",
          "portraitKey": "char_340_shwaz",
          "text": "我不想對小姐動手。"
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "speakerToken": "char_348_ceylon_4#8",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "......黑？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
