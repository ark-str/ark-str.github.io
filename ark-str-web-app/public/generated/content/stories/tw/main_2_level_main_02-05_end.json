  "blocks": [
    {
      "type": "narration",
      "text": "第十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "阿米婭！走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "米莎小姐！請跟上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......怎麼......會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "這邊，快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "區域clear！小心敵方追擊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "他們也是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "整合運動......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "他們確實是......感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "為什麼感染者之間要......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "碎骨......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "你......你放他們逃了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "沒關係......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "他們逃不了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......但我找到她了——不，不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我是......等到她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "我們到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "——你認真的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "標記是這麼寫的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "可這......這是向上啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "縱向移動，真的會有用嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "阿米婭，阿米婭！上來，對對，就是上面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——能天使！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你......確定嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "相信我，不會有錯的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "龍門的路，我實在是太熟啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "爬樓梯吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "這豈不是......等著敵人來包圍我們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "快點，要是被整合運動發現就真的難說了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "嘖，等等，你們先進去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "我會焊死入口處的大門，堵住整合運動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這裡樓梯的牆上，有一個企鵝的標記，是這裡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "沒錯，前方左轉，沿著樓梯向上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "進入建築——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們不是要從地下走嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不是不是，剛才就說了，往上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "......往上？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我們真的......可以相信她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "企鵝物流的宗旨之一是，只要能抵達目的地，什麼路都可以走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "先試一次我們的服務吧。你會喜歡上的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "呼......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "米莎，對不起......我也沒想到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "喂，你。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "德克薩斯",
          "text": "你就是羅德島的那位Dr.{@nickname}？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "德克薩斯",
          "text": "看起來你不太喜歡爬樓梯。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
