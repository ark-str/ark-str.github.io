  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十七关（后）"
    },
    {
      "type": "background",
      "backgroundId": "bg_indoor_2"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "阿米婭！走！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "米莎小姐！請跟上！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "......怎麼......會......"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "這邊，快！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "區域clear！小心敵方追擊！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "他們也是......？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "......是。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "整合運動......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "他們確實是......感染者。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "為什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "為什麼感染者之間要......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "碎骨......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "你......你放他們逃了？"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "沒關係......"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "他們逃不了。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "......但我找到她了——不，不......"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "我是......等到她......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "我們到了。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "——你認真的？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "標記是這麼寫的。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "可這......這是向上啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "縱向移動，真的會有用嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "isRemote": true,
      "text": "阿米婭，阿米婭！上來，對對，就是上面！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "——能天使！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "你......確定嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "isRemote": true,
      "text": "相信我，不會有錯的~"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "isRemote": true,
      "text": "龍門的路，我實在是太熟啦！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "啊哈......"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "爬樓梯吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "這豈不是......等著敵人來包圍我們？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "快點，要是被整合運動發現就真的難說了！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "嘖，等等，你們先進去......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "我會焊死入口處的大門，堵住整合運動。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "這裡樓梯的牆上，有一個企鵝的標記，是這裡嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "沒錯，前方左轉，沿著樓梯向上。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "進入建築——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "我們不是要從地下走嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "不是不是，剛才就說了，往上。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "......往上？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "我們真的......可以相信她？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "企鵝物流的宗旨之一是，只要能抵達目的地，什麼路都可以走。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "先試一次我們的服務吧。你會喜歡上的。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_indoor_2"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "呼......呼......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "米莎，對不起......我也沒想到......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "呼。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "喂，你。"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ]
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "你就是羅德島的那位Dr.{@nickname}？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "看起來你不太喜歡爬樓梯。"
    },
    {
      "type": "sceneBreak"
    }
  ],
