        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "別露出那副驚訝的表情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "阿米婭對從烏薩斯救出來的那批難民十分上心不是秘密。",
