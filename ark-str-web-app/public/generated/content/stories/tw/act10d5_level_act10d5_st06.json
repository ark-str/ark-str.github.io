        },
        {
          "type": "dialogue",
          "speakerName": "烈夏",
          "text": "是~",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "格瑞斯，你看著點。",
