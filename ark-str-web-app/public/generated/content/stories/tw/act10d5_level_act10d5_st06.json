{
  "server": "tw",
  "storyId": "act10d5_level_act10d5_st06",
  "groupId": "act10d5",
  "stageId": null,
  "title": "一切照常",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act10d5/level_act10d5_st06.txt",
  "sourceHash": "aa732cf5e64efcdad0a5c139fb8e7a8ce6caec5c5ac0975b27766fbf7ca3235d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "总集篇 太阳照常升起"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......米婭",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "誒？啊，抱歉，博士，我不小心發呆了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你的臉色不太好。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊，嗯，有些稍微在意的事呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士，你看，這裡有一份內部的調職申請。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "申請人是，娜塔莉婭·羅斯托娃。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "意向是從後勤部門調往前線。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "是烏薩斯自治團的......",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "是的，她是唯一一個在後勤部門工作的自治團成員。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "她似乎因為工作能力出眾，在後勤部門風評非常好呢。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "博士果然也會在意吧。老實說，這一次，我也不是很想通過呢。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "呃，是誰來著？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "烏薩斯人的名字都有些難記，博士不記得也很正常呢。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "她是我們從切爾諾伯格營救出來的難民之一，也是凜冬的烏薩斯自治團中的成員。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "其實也是我們救出來的難民中，唯一的貴族。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士你還記得吧，凜冬她們之所以能夠成為幹員，是因為她們本人的要求。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我一開始其實是很反對的。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "畢竟她們才剛被救出來沒多久......",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "是的。原本，即使是她們本人的意向，我也會說服凱爾希醫生否決掉的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "只是......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "她們有定期接受心理方面的輔導，從報告來看，她們雖然有一定的陰影，但總體是健康的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "只是......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我相信你的判斷。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "謝謝博士。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "但是......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不知道該怎麼說比較好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......博士，你可以去看一看娜塔莉婭小姐嗎？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "好。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "那就拜託博士你了。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "博士，雖然這件事會有些麻煩，但也只能拜託博士你了。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "好麻煩。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "博士，這可是非常重要的事，不要偷懶啦。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "而且，也不用非常嚴肅地去觀察，就當做是工作之餘的轉換心情去看一看就好了。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "啊，午休時間也到了，博士也不用太急，吃完午飯後去找她吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凜冬",
          "text": "喂，博士。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "有什麼事嗎？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "凜冬",
              "text": "沒事，我只是看到你叫你一聲。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "凜冬",
              "text": "喂，別裝作沒聽到，你明明停下來了吧。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "凜冬",
              "text": "你這傢伙不是工作很多嗎，怎麼在這裡閒逛。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "嘿，凜冬。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "凜冬",
              "text": "你看起來很閑的樣子。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凜冬",
          "text": "我接下來要出任務，可沒你這樣的閒工夫亂逛。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "凜冬，我說過，出發前不要隨便走動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凜冬",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "午安，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "好了，凜冬，快回休息室去，該出發了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凜冬",
          "text": "哼，總有一天我也要當隊長對你發號施令。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凜冬",
          "text": "還有你，博士，我總有一天會超過你的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "志氣不錯，不過等你贏得過我一隻手之後再說吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "至於博士，嗯，贏過全力的我再說吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凜冬",
          "text": "嘖。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "哦，博士，你應該知道，最近輪到我帶新人小隊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "那麼要是沒有什麼事的話，我也先離開了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你覺得凜冬怎麼樣？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "嗯......首先正如你剛才看到的，不服管教，目無尊長。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "而且，作為戰士，在這個年紀，往往不知道自己在和什麼戰鬥，也不知道自己該為什麼戰鬥，這很正常。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "但在她身上這一點尤為明顯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "她有著很重的迷茫，我不知道那是什麼，但這是一個很不好的現象，是我接下來要重點糾正她的地方。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你是說，她只是看上去很兇狠？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "臨光",
              "text": "沒錯。外露的暴力是一種保護殼。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "臨光",
              "text": "我不敢說她外殼下的內心就是脆弱的，但我至少敢說，她的兇狠在我面前不堪一擊。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "臨光",
              "text": "別擔心，博士，她還是個孩子。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "臨光",
              "text": "我聽說她來自切爾諾伯格，在那裡她恐怕有一些不好的回憶，但她還有未來。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "唉，我還挺想跟她搞好關係的。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "臨光",
              "text": "哈哈，博士，不要急。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "臨光",
              "text": "你也知道，她並不是討厭你或怎麼樣。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "臨光",
              "text": "倒不如說，她對於親近自己的人才會下意識地去攻擊。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "不過，我必須要說，我並不討厭這孩子，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "其實我挺喜歡她的，她身上有一種純粹的正直，即使迷茫，這股正直也會帶領她不至於走偏。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "這是一件很難得的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臨光",
          "text": "啊，要到出發時間了，那麼，我先失陪了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "咦，是博士！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "中午好，古米。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "古米",
              "text": "博士中午好！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "古米",
              "text": "難道是古米太矮了嗎？！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "古米",
              "text": "博士，喂，看得到古米嗎？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "咦，是古米！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "古米",
              "text": "博士今天心情看起來不錯呢！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "博士來食堂吃飯嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "古米我這幾天沒有什麼任務，正在給廚房幫忙呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "調香師",
          "text": "古米，我送香料來囉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "啊，謝謝調香師姐姐！放在那邊就好了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "調香師姐姐要在食堂吃飯嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "調香師",
          "text": "我就不用了，我更習慣在自己的工作室裡自炊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "誒誒，我可以來吃嗎，我也想向調香師姐姐學習香料的運用！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "調香師",
          "text": "呵呵，當然可以。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "古米，有空的話來幫把手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "來了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "吽出任務去了，人手有點不夠，這面鍋就交給你了，我有點顧不過來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "交給我吧，角峰大叔！啊，調香師姐姐，我下次再來，博士也吃好哦！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "調香師",
          "text": "好的，隨時歡迎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛幹員",
          "text": "今天能吃到古米做的飯？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "後勤幹員",
          "text": "哈哈，今天真走運！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "後勤幹員",
          "text": "我靠，我剛吃完！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛幹員",
          "text": "哈哈，那我再來一碗！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "古米",
          "text": "各位不要急，都有份的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "調香師",
          "text": "古米真是個有活力的孩子，對吧，博士？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "確實。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "確實！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "調香師",
          "text": "有一次她在我的工作室裡睡著了，說了一些夢話，讓我稍微有些擔心。",
