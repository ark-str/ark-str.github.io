{
  "server": "tw",
  "storyId": "act35side_level_act35side_02_end",
  "groupId": "act35side",
  "stageId": "act35side_02",
  "title": "館中特別行動",
  "storyCode": "AS-2",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/activities/act35side/level_act35side_02_end.txt",
  "sourceHash": "fb79f1ff96856ebf673b3fde5553004b5d2230964f902669a19f4cd38183ea0f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "唔……"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "你醒了，阿娜特？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "嘶……好痛。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "你暈倒的時候撞到了後腦勺，可能是因為這個。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "但我不只後腦勺痛，我全身都痛，咦，我肩膀上為什麼會有淤青？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "怎麼我的膝蓋上也有……？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "嗚……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "啊——！！你不要靠近我！"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "冷靜！冷靜！阿娜特！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "誰看到古屍復活都不能冷靜吧！那傢伙剛才是不是扯了我的耳朵！我的耳朵還在嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "它不過是一具只會模仿人們動作的古屍，對你並無惡意，對其他人也沒有。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "就當它是個會動的擺設吧，阿娜特！"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "嗚……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "……你為什麼絲毫不緊張，佩佩？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "請不要用這麼犀利的眼神看我，拜託！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "你到底做了什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "……我昨天將我挖掘到的寶石放入了它的胸腔，上面的源石迴路可以將它喚醒。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "昨天？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "如此重要的考古發現，你肯定不會拱手讓人，法爾賈萬達巴德博物館在陛下心中地位特殊，就算我是帕夏之女也無可奈何。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "所以……只能背著你偷偷進來了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "佩佩，我不想把它借給你是有理由的。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "什麼理由？放心好了，論文上加個署名的事情，沒問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "不是這個……"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "投資？贊助？哪怕是翻修整個展館都可以！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "你這是什麼眼神？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "我只是不懂……你為何如此執著地要成為沙爾-阿加德的史官？就算繼承了你父親的帕夏頭銜，你依然可以繼續自己的研究。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "你明知道作為史官進入黃金之城後，就再也無法離開那裡了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "學院中學習到的一切，為深入沙漠尋找遺跡而承受的訓練，四處遊歷的見聞，在你成為史官後將再也無法派上用場。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "或許，你只是不甘心那個被選中的人是你的弟弟？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "……我不是逞一時意氣才想要成為史官的。這是我們家族中每個成員的夢想。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "在小的時候，誰不期待著長輩將那支金色的燈芯草筆交給自己。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "他們會告訴你，拿起這支筆，你便要承擔非凡的責任，記述所有曾經發生的事情以供後人閱覽。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "你所記載的、所傳遞的是屬於時代的真相。是不會被深埋進黃沙與泥土，不經猜測與考察便能得出的最為完整的真相。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "這就是我從小到大一直想要做的。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "我想要參與記述薩爾貢的歷史！我想要沙阿的榮光在我的筆下煥發出永恆的生命力，持續照耀著每一個讀到它的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "在千年萬年後，有一個我注定無緣得見的傢伙，他會從那些文字中，與我，與沙阿產生共鳴，我們三人由此而連結。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "想想，阿娜特，這不是很浪漫的事情嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "唉……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "你的堅持，我都看在眼裡……你從來都是不到黃河心不死。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "我就是這種執拗的人嘛，我還以為你和緹緹早就習慣了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "……好，我可以代表博物館出借這件文物，以及……另外一顆寶石。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "那是多年前一位私人收藏家贈送給我們的，研究時我們發現這具古屍與寶石有關聯，但具體的使用方法我們毫無頭緒。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "在博物館裡也有一顆寶石？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "這不重要，重要的是我也會一起將它交給你研究。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "就這麼輕易地給我嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "怎麼可能？除了署名、投資、贊助，還有新展館的冠名費，一個都不能少喔！"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "都是小錢！都是小事！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "佩佩……"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "我還是希望你能接受，有些時候，沒結果也是一種結果。"
    },
    {
      "type": "narration",
      "text": "阿娜特打開抽屜，拿出一個層層裹好的布包。\n掀開布料，一顆四角錐體的寶石躺在其中，和放入古屍胸腔中的別無二致。\n接過寶石，佩佩難以抑制內心的驚喜，簡直就要驚呼出來。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "“第二顆代表肺，當我們初次呼吸，記憶便開始。”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "可別讓我失望喔。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "佩佩將手探入古屍胸腔內，寶石才剛靠近，便被古屍胸腔內那片流動的螢藍光芒吸納進去。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "塵封在黃沙中的守墓人，我將流失於時光中的記憶找回，送還於你。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "為我指出前往沙阿寶庫的道路吧，來自過往的旅人！"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "怎麼第二顆寶石放進去，他連動都不動了……？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "這……又算什麼結果？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "啊————————！！"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "我沒叫，是誰在叫？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "是緹緹的聲音？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": null,
      "text": "這是……怎麼了？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿娜特",
      "speakerId": null,
      "text": "我去看看，展品你看好！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "什麼嘛，為什麼不早告訴我，你只是普通的小雲獸！"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "……普通的小雲獸確實聽不懂人類在說什麼就是了。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "看來遊客已經順利疏散了，我們可以安安全全地出去了。等出了門，我就把你放下來，你自己回拉恕爾那裡，沒問題吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "哎呀，別再拍我了！被人抱著不用自己走路還不舒服嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "摸摸毛，摸摸毛……來，我讓你看別的小雲獸。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "你看這個化妝盒上面的圖案，雲獸居然和官員是平起平坐的。順帶一提，這個是我修復的喔。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "還有這邊的壁畫。這是一件極其罕見的，從黃金之城流出的文物。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "為了更加準確地修復壁畫上的圖案，我翻閱了所有我能接觸的、有關黃金之城的典籍，還去問了好幾個進入過那座城市的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "……欸，我這樣是不是很容易被人誤會？他們不會以為我在覬覦黃金之城的祕密吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "算了，不想了。還好，你只是一隻小雲獸，博物館裡現在也沒有其他人，我剛才那些話不會給我招來什麼麻煩。"
    },
    {
      "type": "narration",
      "text": "突然，女孩的耳中捕捉到了一絲細微的碎裂聲。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "不會吧……？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "啊啊啊啊——！這個節骨眼怎麼還有玻璃爆開？"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "阿娜特知道我就死定了！"
    },
    {
      "type": "narration",
      "text": "快步跑向展覽台，梅捷緹克緹為一地的碎玻璃而感到震驚。\n展櫃的玻璃是特製的，博物館的環境也很穩定，不應該會出現這樣的事故。\n女孩急忙抬起頭，去查看展櫃內的展品，卻發現蒼白的照明燈光下，空無一物。\n就在她想要仔細檢查玻璃碎裂的痕跡時，突然感覺有冰冷尖銳的物體抵在背後。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "如果是惡作劇的話，現在可以停下了。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "現在還在工作時間，少跟我開玩笑！"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "哪個部門的？裝聾作啞幹什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "再不說話……扣你薪水喔……"
    },
    {
      "type": "narration",
      "text": "話音剛落，梅捷緹克緹感覺到抵在背後的東西被拿開，她鬆了一口氣，回過頭。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "真是的，也不知道你是哪個部門的實習生，連副館長都敢作弄，大人有大量，我……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "啊——————！"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "你……你……"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "speakerId": "avg_npc_1478_1",
      "text": "你怎麼從櫃子裡出來了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "…………"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "都等了這麼久，怎麼一點反應也沒有？阿娜特也沒回來……算了，到處轉轉吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "阿娜特這傢伙愛低調的性格真是沒變，都做了代理館長，這間辦公室看著還是如此簡樸。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "我記得以前在宿舍，她的書最多，怎麼到了這裡一本都沒看到。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "肯定藏在哪裡……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "喔，我就說嘛，怎麼可能沒有書架，原來是裝進牆體裡面了。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "正好家裡的書房要重新翻修……到時候要讓她把設計師推薦給我。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "讓我看看你都放著什麼好東西，嗯，《西南部落信仰調查》、《沿河地區出土首飾考》，還有……"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "《大地巡旅》？E.E.埃里克森博士著，這名字有點耳熟……對了，不就是之前來學院做過演講的那位維多利亞學者嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "好多標籤，想不到阿娜特這麼喜歡他的書。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "薩爾貢……在二百七十二頁……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "（呼……那位礙事的女士終於走了。）"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "（這房間未免有些太豪華……嘶，這沙發上的抱枕是拿金線繡的嗎？）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "（這不是海報上的古屍嗎，就這樣擺在房間裡也不嫌晦氣，有錢人的品味真是不一樣。）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "（她在那裡……很好，她很專注……）"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "（對不起了……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "緩步上前，娜仁圖亞將手伸入口袋，取出那支藏了很久的針劑。\n她曾花費無數日夜刻苦訓練，直至腳底磨出血泡，才學會如何走過一片沙丘而不留下任何腳印。\n現在如果她願意，可以帶著鈴鐺穿越鬧市中的人群而不激起一聲鈴響。\n那位帕夏的女兒就在眼前，房間內除了她們兩個以外再無別人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "但就在娜仁圖亞抬起手準備將針劑刺向女孩的瞬間，她的手突然被人捉住，停在空中動彈不得。"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "——？！"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "（難道……有暗衛跟隨在旁？）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "speakerId": "avg_4138_narant_1",
      "text": "（你——！）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "娜仁圖亞說不出話。\n方才在沙發上一動不動的古屍不知何時來到她身後，緊緊抓住她的手。\n她想要掙扎，但沒有任何作用，只能驚恐地看著針尖逼近自己的脖頸。\n而它的另一隻手，正牢牢捂住她的嘴巴，直到整支針劑都被注射進娜仁圖亞的血管中，它才鬆手。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "意識逐漸模糊，她感覺到自己像個羽獸幼崽般，被拎著衣領提至窗外。\n雙腳懸空之際，她的腦海中只剩下一個念頭——\n要是有個可靠一點的手下就好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "幽暗角落裡的蟲子。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "嗯……？"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "好像有聲音……發生什麼了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "你、你怎麼又能動了……"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "我的頭腦……不再混沌，周圍開始清晰，需要語言表達自身的認知。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "你、你是活著的嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "我的生命早已逝去，你所見到的，只是一具經過良好處理的軀殼。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "你的身分？告訴我。"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "興盛之時，我是萬王之王路加薩爾古斯身邊的御前護衛軍官，在戰役中為他保駕護航。"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "衰敗之時，則甘心化為不朽之物，寧願承受時光磨消，守衛陛下所建之寶庫不受侵擾，捍衛陛下所宣之誓言得以實現，等待……"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "等待陛下所去之身影終能回還。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "speakerId": "avg_4058_pepe_1",
      "text": "那我、我該如何稱呼你？"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "祖巴伊達姆-亞努爾-阿尤蘇，我的名字。"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "speakerId": "avg_npc_1479_1",
      "text": "你可喚我——祖拜爾。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的孩子",
      "speakerId": null,
      "text": "媽媽，那個姐姐一直坐在水池邊低著頭做什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的母親",
      "speakerId": null,
      "text": "看衣著打扮，那個姐姐應該是米諾斯人，據說米諾斯人善思考與哲辨。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的母親",
      "speakerId": null,
      "text": "我猜她應該是在思考什麼了不起的道理吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的孩子",
      "speakerId": null,
      "text": "了不起的道理？那是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的孩子",
      "speakerId": null,
      "text": "不過她的樣子……好好看……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "speakerId": null,
      "text": "女士，博物館已經關門了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "speakerId": null,
      "text": "我知道，所以我正在等待開門。"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "speakerId": null,
      "text": "這……我想短時間內是不會重新開門的。"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "speakerId": null,
      "text": "一般來說，得等到館長處理完緊急情況，評估完風險，報告給投資人，然後公布開館日期……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "speakerId": null,
      "text": "我知道，另一位工作人員已經說過一模一樣的話了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "speakerId": null,
      "text": "如你所見，我正在等。"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "speakerId": null,
      "text": "……您剛才說自己有東西遺落在館內了，是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "speakerId": null,
      "text": "是的。"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "speakerId": null,
      "text": "是很重要的物品嗎？不能等我們的工作人員撿到後聯絡您來認領？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "speakerId": null,
      "text": "不能。"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "speakerId": null,
      "text": "……這樣吧，女士，我悄悄把門打開，聯絡同事陪您一起回去找。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "speakerId": null,
      "text": "多謝——"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的孩子",
      "speakerId": null,
      "text": "媽媽……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫柔的母親",
      "speakerId": null,
      "text": "怎麼了？"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇的孩子",
      "speakerId": null,
      "text": "看，有人從博物館樓上跳下來了！"
    },
    {
      "type": "narration",
      "text": "聽到孩子大聲的呼喚，阿斯帕齊婭猛地抬頭，看到一個女人正從高樓上墜落。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "來不及細思，阿斯帕齊婭便邁開步伐，不顧博物館即將開啟的門，向前伸出雙臂。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
