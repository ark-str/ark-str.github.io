      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": "avg_npc_402_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "抱歉，你暫時沒有選擇的權利。請乖乖跟我走吧，看不見臉的朋友。"
