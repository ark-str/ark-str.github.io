  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "12:21 P.M.\n切爾諾伯格分城“14區”廢墟\n區塊地面"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "搞什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "雪怪小隊，為什麼停火了？你們還在等什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "......把這些廢墟挖開啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "你們不是佈置好了源石嗎？為什麼不直接弄塌地塊，把羅德島一網打盡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "開啥玩笑，霜星大姊還在這底下啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "那就由我們來消滅羅德島，你們繼續挖。我們馬上趕到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "別來這條街區！這區塊的地面結構已經破破爛爛的了，沒受過訓練的隊伍在這裡進行戰鬥，一不小心就會誘發大崩潰！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "剿滅羅德島是優先事項，你們自己動手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "指這指那的煩不煩啊......該打的肯定要打，你這個優先事項是誰制定的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "自然是最高戰略目標。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "你們對著烏薩斯人泄私憤的時候考慮過戰略目標嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "行行好，我們儘量，你們能不能寬容下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "你們難道......和羅德島進行了交流？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "你在背叛我們的運動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "（你們那怎麼回事？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "（感覺得打一場，逃不掉了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "如果你們覺得只要有交流那就是背叛，行啊，那就是了行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "就這種戰術思想，也難怪被人牽著鼻子走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "......雪怪！你們要做什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "我們的人數可是比你們多了好幾倍，別犯蠢！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "......等等，我們可是和烏薩斯常備軍交手過無數次了，烏合之眾有什麼好囂張的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動術師",
      "text": "你們等著！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "（掐斷）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "這樣，羅德島。我們可能要教訓下這幫不懂規矩的傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "勸你們別插手，我們可不想被判通敵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "啊，通敵？你在說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "阿米婭，在廢城發生了什麼，羅德島的官方口吻會怎麼說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......什麼都沒發生。我們和雪怪小隊交戰，從未有其它整合運動插手過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "演戲？演戲我最擅長了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "我們一會兒裝裝樣子，然後趁亂把這些人全都解決了，你覺得怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "我沒意見。你們隊長怎麼說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "請問先生，我該怎麼稱呼你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "......呃，嗯，小姑娘你長得很可愛，但我們見面時間那麼短，我還沒做好準備......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "準備個頭啊！想什麼呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "抱歉，抱歉！就，就緩和下氣氛。就叫雪怪1號怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那麼雪怪1號先生......我們都有要救的人，對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "就讓我們一起制服那些可能干擾到救援進程的整合運動吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪1號先生",
      "text": "好。我現在非常有幹勁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "......你的幹勁究竟是從哪來的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
