  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "啊......！小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "抱，抱歉，我不是有意撞過來......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我沒事的。你很有禮貌呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "嘿嘿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "咦，姐姐你在這裡做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "這裡還在下雨呢，為什麼不躲一躲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊......嗯......我只是......出來走走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你是在找人幫忙嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "啊！姐姐是怎麼知道的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不能告訴你！這可是姐姐的秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "唔唔......不管了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "姐姐，能不能請你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "好像......不太行。姐姐，你的個子，太小了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可不能這麼說別人！你明明比我矮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "哇哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "那，那我們試試吧......嗯......能不能幫我抬一下那塊板子？一起來吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "那個鐵架下面，有台留聲機，我想拿回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "1......2......3！嘿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "成功了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "哇，姐姐力氣還蠻大的呢！謝謝姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "可是......這個留聲機......還是壞了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "沒關係！因為它最開始就是壞的呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "總有一天可以修好的。我給大家收集了不少唱片，雖然從來都沒聽過——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "————但總有一天，我會放給大家聽的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......如此輕鬆的說著這些艱難的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......我到底是為了什麼......又能做什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "姐姐不怕我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......怕什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "我可是感染者哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "哈哈......我也是呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "什麼！太可惜了，姐姐長得這麼可愛，居然是感染者......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "感染者不是什麼問題。無論是健康人還是感染者——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你如果是個好孩子，就一直是個好孩子哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "唉——？我聽不懂呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "（咕嚕......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......餓了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "......嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......給你，我只帶了這些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "太好了！謝謝你，兔姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "不過你.....為什麼來這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "因為......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "因為我答應過一個人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "姐姐再見！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好的，再見！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "就連那樣的孩子，最後，最後也只會......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "被剝奪了身份的人。感染者。你們早已不是人。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我能做什麼呢，我又能，再多做些什麼呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "為什麼......我不能保護大家呢......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你不能。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不......我......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "饑荒......迫害......死亡......\n感染者終究只有這樣的結局。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不是這樣的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "只要羅德島還在為了感染者.....",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你只是少數幸運兒。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不，所有人都聚在一起，向著共同的目標，不斷地努力。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "這片大地已經麻木。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "還沒有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "感染者絕不能就此陷入絕望......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你。\n被憤怒吞噬吧。\n只有———————"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不......我不會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我答應過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我答應過她——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那是......?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "一個姐姐和我說過，這個布偶，只有親手做的才有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "所以所以，這個送給你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "另一個少女的聲音",
      "text": "——————。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "剛才那個聲音是 ......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那個背影————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "是陳小姐？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "——————。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "————————————。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "——————————————————————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "另一個少女的聲音",
      "text": "——————。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "陳長官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "陳長官，你來這裡是要做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我以為......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "不關你的事。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "龍門的事情，我會處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "陳長官......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這是我第一次看到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "她是那樣的眼神......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
