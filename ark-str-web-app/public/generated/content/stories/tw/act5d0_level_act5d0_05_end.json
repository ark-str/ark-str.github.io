  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act5d0/level_act5d0_05_end.txt",
  "sourceHash": "92cec988dfab90203fee7701199628ccb6a186f90c60aca8b35d088aa56a5a81",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "8:52 P.M.  天氣/多雲\n龍門貧民窟"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "嘖！想活命就告訴我們，鼠王到底在哪兒！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "我、我不知道啊！什麼鼠王......真的沒聽說過啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "敬酒不吃吃罰酒——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "喂，卡彭先生說過不要隨便對平民動手......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "這種下三濫的貨色能算市民嗎？遮遮掩掩的，說不定就是個感染者垃圾！還敢裝糊塗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "等、等等！別打了！我真的不知道啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "嘴硬！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "唔——呃，嘔——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "走吧，別管這傢伙了，噁心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "看名單，下一個老東西似乎就住在這裡不遠，是個賣魚丸的，就在生鮮賣場對面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "嘁，浪費時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "咕，哈啊——骨頭都斷了，這幫——該死的——下手真重，嘎哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "必須得......告訴他們......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "那邊的，站住。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": ".....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "......你們有什麼事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "（等等，注意旁邊那個男的，我總覺得這傢伙不好惹。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "（龍門當地的幫派？不用擔心，按照卡彭先生的報告，都是小角色。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "我有點事情要問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "誰也不想惹上麻煩，對吧？乖乖回答我們，我們就走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......你的拳頭上有血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "不好意思，只是些不配合的垃圾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "但是像你們這樣的好市民，當然會配合我們的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "這是威脅？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "大家心裡清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "那我拒絕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "......拒絕？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "小姑娘，你好像弄錯了什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "還是說，你也想變成那邊巷子裡的垃圾，被打得半死不活？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "槐琥，我剛才聽到的慘叫聲......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "——你們剛才說了，“垃圾”，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "以防萬一我多問一句，你是指這裡的居民嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "我沒那麼多時間陪你廢話，趕緊——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "敢、敢還手！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "都給我上——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "呃！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "下一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "不，算了，反正你們也就只是一群不入流的嘍囉，一起上吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "古往今來，邪不勝正，你們這些濫傷無辜的下九流，何足掛齒。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "什麼情況！？這女人的動作——？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "那就嘗嘗弩彈——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......慢著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "咕！鬆手！你這混帳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "唉，你這種人，屬於冰箱斷電餿了三天的海膽，差不多那個感覺吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "你、你在說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......算了，我不該學槐琥咬文嚼字的，還是直接點好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "好、好大的勁，等！等等！要斷了！要斷了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "把武器放下，滾出這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "我、我知道了，你先放手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "......但果然還是應該弄脫臼比較好吧。畢竟你拿著那麼危險的武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "呃啊！你，你真下的了手——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫B",
      "text": "這、這兩個人怎麼回事？我沒聽說這附近有什麼注意目標啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "嘁，先走，回頭再說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫A",
      "text": "不管你們是哪個幫派的，都不會有好下場的！該死的龍門人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "不，都說了我不是黑社會，為什麼都喜歡以貌取人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "先別管這些，救人要緊，我去那邊看看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "啊，好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "——別動，我來幫你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "阿孑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "還好，都是皮外傷，別急，我這就去叫醫生，他們離這不遠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "阿孑！別管我，先去找你董阿伯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貧民窟居民",
      "text": "他們下一個目標就是他！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孑",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
