{
  "server": "tw",
  "storyId": "story_mlyss_set_1_story_1",
  "groupId": "story_mlyss_set_1",
  "stageId": null,
  "title": "無根之雨",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_mlyss_1_1.txt",
  "sourceHash": "fef7862643d2a242dd64a2086881170e0ac3e20c853b3bf1aa40ee8ff939f194",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "生態科研究員A",
      "text": "凱麗，怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員B",
      "text": "極地區的植物監測數據我剛剛錄完。五十三種新入園植物，大部分性狀正常，算是度過了初始觀察期。但你也看得到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員A",
      "text": "門口這兩棵鞘葉櫸的葉片出現了嚴重的捲曲現象，這是脫水的表現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員A",
      "text": "那一片冰原棉草，明明還在生長期，但絨團數沒怎麼增多，絮量也低於正常值。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員B",
      "text": "那棵方形葵表現是最明顯的。方形葵應該永遠向著太陽的方向伸展花盤，但它的花盤垂拉得快要挨著泥土了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員A",
      "text": "意料之中。畢竟生態園極地區才剛剛開始規劃，我們的數據整合和經驗積累都不足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員A",
      "text": "趕快去問問繆爾賽思主任吧，她一定知道問題出在哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員B",
      "text": "（說起來，繆爾賽思主任挺神奇的，她真的太懂植物了。大家都在私底下猜......繆爾賽思主任是不是能和植物說話。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員A",
      "text": "（別亂說。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "凱麗，試試重新設定這個區域循環系統的參數，培養基裡再增加一部分菌根菌來促進水分和養分的吸收。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員A＆B",
      "text": "繆爾賽思主任！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員B",
      "text": "......可我是嚴格按照麥哲倫小姐發來的數據進行配置的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "這批植物是麥麥託人從薩米送來的沒錯啦，但麥麥畢竟只是科考學者，對植物學並沒有那麼瞭解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "只有這些植物身在薩米時，她採集到的每一份生物數據才是準確的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "生態園對它們來說還是太“溫暖”了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "試試把溫度和濕度再調低一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員B",
      "text": "好的，繆爾賽思主任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "接下來是要檢視高原區對吧，一起走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "（痛快的指部活動）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "（奮力地伸懶腰）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "鞘葉櫸，你小心點。手指一直蜷著，猛地伸開，小心葉脈勞損。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "我還沒說你呢。動作別那麼大，你的棉絮都飛到我臉上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "剛剛那個傢伙說什麼來著？再過去一點是高原區？我讓棉絮飛得再遠些，說不定還能和傳說中的針茅聊一聊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "你是剛離開薩米，什麼都新鮮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "欸，方形葵，你為什麼不說話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "蔫巴巴的，一點精氣神都沒有。應該是還沒適應新環境吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "不，我看他不吃不喝的，估摸著是有情緒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "原來是有情緒啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "誰在說話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......下雨了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "室內也會下雨？還是說這就是所謂的循環系統？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "這是什麼雨？水珠怎麼黏在我的枝幹上，抖都抖不下去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "你們好呀，重新認識一下吧。我叫繆爾賽思。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "你又來啦，繆爾賽思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "抱歉抱歉，剛剛去找娜斯提改裝了些設備，那傢伙可不好說話了，花了些時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "你們今天的狀態比之前好了不少喲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "普普通通吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "鞘葉櫸，你起碼沒故意把葉子蜷曲起來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "在下個月第二批植物到園之前，極地區都由我親自負責啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "下午我會更換你們的培養基，新的培養基是按照薩米土壤樣本重新配比的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "你們所需的營養成分，接下來我也會以“雨”和“露”的形式進行隨機補充，不再那麼“規律化”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "還有什麼需要可以隨時跟我說。地形、空氣、土壤、水、氣候......怎樣的條件才最適宜你們生存？無論多古怪，生態園都能滿足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "你還真是有耐心啊，繆爾賽思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "其實最開始規劃生態園的時候，我就有建極地區的打算了，但生態科沒有人去過薩米，這事也就一直擱置著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "這幾年我一直在萊茵主持生態實驗，自認為底子已經打得足夠紮實了，就想著......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "為什麼是薩米呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "在許多人的眼裡，它就是個人跡罕至的苦寒地帶，封閉隔絕，神秘危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "其實不止是薩米啦。我對泰拉的每一處特殊生態系統都很感興趣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "薩米又是這裡面最為特殊的。沼澤、森林和冰原依次排布，這種怪異的地貌組合有些......怎麼說呢，有些“強行”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "而且，雖然相比核心圈確實苦寒，但薩米的生物種類與數量異常豐富，這本身並不符合生態學的規律。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "所以我猜想，薩米應該很“乾淨”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "“乾淨”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我提取了你們的生理樣本......你們的根系中，源石顆粒含量遠低於平均值。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "你說的我們聽不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "截至目前，薩米是我最為理想的實驗環境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "所以，你想要在這個很大的玻璃房子裡複製一個“薩米”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "玻璃房子......是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "繆爾賽思，為什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "因為我是萊茵生命最年輕最厲害的生態學家啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我有能力、也有責任把這座很大的玻璃房子建成全泰拉最乾淨的地方，它會有最清新的空氣、最適宜的氣候、最有營養的土壤......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "它會有最豐富的生態系統，每一種脆弱的生命都能夠在其中自由地棲居。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "這是我一直以來的......怎麼說呢，追求。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "（用力脫落棉絮）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "（暢快抖動枝葉）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "哈哈，謝謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "有什麼值得拍手叫好的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "方形葵！你一直不說話，突然開口嚇我一跳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "來這半個多月了，他一直都是這樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "哎呀，他這傢伙，總是有點情緒化。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "從薩米森林被移植到了一座莫名其妙的城市，他還是對這件事有些耿耿於懷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "來都來了，看開一點嘛。我有團棉絮飄進了隔壁館的水域，還感受了一把“海水的鹹”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "待在薩米，你說不定早就化成糞便了。你花盤裡的種子那麼特殊，羽獸拿你當食物，那些大胃口的肉食動物拿你助消化......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "好好吐你的絮，哪裡那麼多話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冰原棉草",
      "text": "嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "繆爾賽思，你不是好奇為什麼我到這後一直蔫巴巴的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "方形葵的花盤會一直尋找太陽。你的生態園也的確配備了專屬的光照系統，甚至能模擬出太陽在不同時間的光照變化。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "用你們的話說，很“先進”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......但那畢竟不是真的太陽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "太陽就在玻璃房子外面。但拆掉了這層玻璃，房子裡的土壤、空氣、溫度、水分、微生物群集也就都不成立了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "你即使百分百地複製出了薩米的每一粒土壤、每一縷寒風、每一塊堅冰，這裡依然跟轉移我時用的標本箱沒有區別。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "唔，相比大多數植物，你的趨光性還是太特殊了，這確實沒有辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "我不是這個意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "不，我知道喲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "海洋、灘塗、森林、荒漠、黑流樹海......每一次掀開大自然的面紗，總有驚喜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "無論是四季分明、溫暖宜人，還是苦寒酷熱、惡劣極端，無論是何種生態，都是千萬年來自然演化的結果......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "而不是被設定好的“實驗環境”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "這裡不會是“薩米”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "呀，我真想把你們帶出生態園，讓你們看看萊茵的總部大樓，看看整座特里蒙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "對我而言，薩米是神秘的。對你們來說，科學同樣是神秘的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "科學能幫我們打破自然的界限，形塑新的環境，科學能幫我們......尋找答案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "你是在自欺欺人，繆爾賽思。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "有家科技公司的勘探平台在哥倫比亞北部的山區發現了最後的淡杉群......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "這和你有什麼關係？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那附近有座山村，但相關的人口備案早就已經過期了......似乎和特倫多鎮的失蹤人口有部分重疊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我想就是雅拉主任，也不會那麼關注員工在下班之後的活動吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "你的行為，可談不上紳士哦，小賈斯汀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小賈斯汀",
      "text": "嗨，別介意。我沒有別的意思，況且我也並不知道你一直在追查的是什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小賈斯汀",
      "text": "我只是在和對方洽談商務合作的時候多看了兩眼而已，想著如果繆爾賽思主任感興趣的話，或許會答應我的約會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "長袖善舞的商務科主任居然會這麼膽小嗎？生態科的工作，其實沒有那麼忙啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我現在就過去找你。你在總部大樓？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小賈斯汀",
      "text": "我在樓下的咖啡館。繆爾賽思主任上次可是吐槽過我辦公室的裝潢風格，站在門口進都沒進去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "那這次就在你的辦公室見吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "你回來了。你突然離開已經有半個月了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "嗯啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "冰原棉草她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我看到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "生態園裡下雨了。\n雨滴滲進鞘葉櫸的葉脈，雨滴打濕方形葵的花盤，雨滴落在一旁已經枯萎的植物根莖上。\n雨不大，也不急，但似乎沒有要停的意思。"
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "繆爾賽思，你在哭嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "也不怪你啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "那個叫凱麗的研究員已經在盡力照顧棉草了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "補充營養液也好，更換培養基也好，終究和薩米自然的生態補償系統沒法比。但極地區的生物群落甚至都還沒有成形......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "喂，別哭了，哭得人身上濕淋淋的，難受死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我在想，下個月的第二批薩米植物是不是應該再遲些進入生態園。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "嗯，你是這種輕易就會動搖的人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "唔，科學探索困難重重，偶爾被打敗一下也很正常......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "你在為什麼哭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "和小賈斯汀聊完之後，我去了一趟哥倫比亞北部的山區。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "很遠嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "不算遠，三四天就到了......我只是在那裡多待了一周。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "既然不算遠，為什麼現在才過去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "因為很難找，我找了很久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "從特倫多鎮的孤兒院，到人去樓空的老房子，到特里蒙的大學，再到萊茵生命的實驗室......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "從圖書館卷帙浩繁的典籍，到無名的碑刻，到進展寥寥的實驗報告——是的，我甚至拿自己的生理樣本進行過實驗......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我找了很久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我終於找到了那裡。我以為那裡有我想要的答案，關於我的父母、關於我的族群、關於我自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我必須把這座很大的玻璃房子建成全泰拉最乾淨的地方，它必須有最清新的空氣、最適宜的氣候、最有營養的土壤......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "它必須有最豐富的生態系統，每一種脆弱的生命都能夠在其中自由地棲居。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......包括我自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "所以，我必須要找到這些答案，我必須知道為什麼自己的生命如此脆弱，自己對源石環境如此敏感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我必須知道我是什麼，“精靈”是什麼，我必須知道我如何孕生，這片大地上是否還存在我的同類，我的未來......在哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......你沒有找到答案，你是空手而回的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "那裡只有一個殘破的山村、一片正在死去的樹叢、一個簡陋的墓園......時間埋葬了一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我甚至無從得知，葬在淡杉叢的那些精靈，是能給我答案的人，還是同樣在無望地尋找著答案的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "繆爾賽思，你還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鞘葉櫸",
      "text": "你看起來很累，可以在我的樹幹上靠一靠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "方形葵，你說的沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "生態園裡的雪山不是雪山，生態園裡的冰原不是冰原，我永遠無法復刻一個“薩米”......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "因為連我自己也不清楚，我所尋找的，是怎樣的一片土地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "雨依然在下。\n無根的水滴在生態園扯出一張淅淅瀝瀝的雨幕。"
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "別哭了，繆爾賽思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "薩米可從來不會下這樣的雨，你再哭就是在破壞極地區的生態了，到時候其他植物也生病，你又有得愁了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "其實吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "其實冰原棉草的生命週期本來也不長，冰原上冬風最緊的時候，沒有一絲絨絮能在根莖上掛住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "前兩天，棉草的白絮幾乎鋪滿了整個極地區，有那麼一瞬間我還真以為這裡就是薩米的冰原。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......謝謝你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "也怪棉草自己好奇心太重。你不在的那幾天，她讓自己的絨絮飛遍了極地區、高原區、海洋區，也算得償所願了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "她把整座生態園的植物都數了個遍......接近一千種，其中有不少還是因為種種生態問題本應絕跡的物種。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "雖然你說自己只是想建造一個理想的棲息地，但你在做的事情，其實遠不止這樣......呃，這麼說起來，你和那些傢伙挺像的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "我說我見過和你差不多的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "其實我一開始就發現了，只是不太確定......你們都能“感受”到我們，你們都在做差不多的事情，只不過你是在實驗室，他們是在森林裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "植物是他們的繃帶，雨露是他們的止痛劑......他們應該，是在縫補薩米的傷口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "方形葵，你確定？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "當然了，我還幫助過他們呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "雨停了。\n繆爾賽思站在生態園的中央，望著面前的植物若有所思。"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "我進行了兩次對比實驗，答案都是一致的。也就是說，基於你們的植物樣本解剖與篩選結果所得到的推論基本正確。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "你花盤中種子所包含的化學成分迄今不為學界所知，它們為我的推論帶來了決定性的證據。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "你確實是一種極其特殊的植物。你具有某種“療癒”的作用，只不過療癒的對象是某種我們不得而知的自然物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "方形葵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "但植物本身並沒有去療癒什麼的主動性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "也就是說，有人在使用你們。那些人本身，也是薩米自然生態補償機制的一部分。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "薩米，那裡有我的族人嗎？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "陽光穿透玻璃，方形葵垂著的花盤微微動了動。"
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "謝謝你，我想像中的朋友。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "繆爾賽思主任......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "那個，您......節哀順變！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "您不是能和植物對話嘛，冰原棉草......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "凱麗，這比老山羊已經把自己變成超級改造人，經常深夜和塞雷婭對拳的八卦更離譜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "......對、對不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "哦對了，我是來給您送信的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "這是《特里蒙理工大學學報》《生物評論》《自然通訊》三家頂級期刊的邀稿來函，他們都對您近期的成果很感興趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "您的植物訊息實驗，在植物生理學和系統植物學的角度都被證明可行。這對生態學來說，是重大的路徑突破。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "也多虧了大家幫忙啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "那期刊那邊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "都接下來吧，但請幫我回覆各位主編，交稿時間可能會遲一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "生態科研究員",
      "text": "您要休息一陣嗎？也是，畢竟您遠行剛回來就投入工作了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "繆爾賽思",
      "text": "不。我要去一趟薩米。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
