{
  "server": "tw",
  "storyId": "act35side_level_act35side_02_beg",
  "groupId": "act35side",
  "stageId": "act35side_02",
  "title": "館中特別行動",
  "storyCode": "AS-2",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act35side/level_act35side_02_beg.txt",
  "sourceHash": "aef67d44652c94ab335fbe63e961f9c923d56a025f8ecd0300539b6477e800c5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "真是精細啊，剛剛沒注意到，這個傢伙居然連表情與口型都能夠模仿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "張開嘴讓我看看，啊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "（張嘴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "咽喉處很明顯有類似聲帶的發聲裝置，那為何到現在你都一言不發？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "奇怪，照理說，發聲也是聲帶與肌肉的動作，你應該能夠模仿才對啊……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "佩佩靠近古屍，把手搭上它的喉嚨，而古屍則依著她的樣子，將手按在佩佩的喉嚨上。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你知道……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你……知……道……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "你……滋……得……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "迅速抽回手，佩佩不可思議地捂住嘴巴，眼中透出驚喜的光彩。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "真的能說話啊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "太神奇了……想不到沙阿那個年代真有如此精巧的工匠技藝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "先祖曾在一本《古曆紀工藝考證》中提及......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "有異人可用源石迴路寶石封存人的意識，然後用黃金為其重塑軀殼，可供人行動千年而不腐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "長生軍……失傳的技藝……陛下會對你很有興趣的……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "寶庫肯定藏在你記憶的深處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "你可不能僅僅是學我說話，你還得告訴我它到底在哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "讓我看看……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "“第一顆代表心臟，自它跳動，我們便存在。第二顆代表肺，當我們初次呼吸，記憶便開始。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "“第三顆代表胃腸，食物進入肚皮，舌頭變得挑剔，我們有了喜好、個性。第四顆代表肝臟，我們清醒著進入夜晚，為了職責與義務。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "第五顆……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "第五顆是什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "沒有，詩歌到這裡就斷了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "看起來那位阿爾薩蘭的前代研究者也沒有答案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "但你一定能幫我找到答案，對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "女孩再次伸出手，將手指按在古屍的喉嚨處。"
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "是的，女士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "是的，女士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "嗨，學人精。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "嗨，學人精。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "緩緩抽回手，女孩又握住屍體的手，用盡力氣握緊，而屍體也回握住她。"
    },
    {
      "type": "dialogue",
      "speakerName": "無名古屍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩佩",
      "text": "我就當你答應了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "阿雅吉，我已經到了，為什麼我沒在門前看到你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "你現在在哪裡？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "（小聲）你說你不知道你現在在哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "沒有通行證我要怎麼進去……該死，這裡的館長把辦公室搞得像保險櫃一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "不，來不及了，現在人都快疏散完了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "告訴我……阿雅吉，走廊上的窗戶和館長辦公室的窗是相鄰的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "……是，我知道很高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "娜仁圖亞",
      "text": "我會小心的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "第一，博物館內禁止喧嘩。第二，無序乃是理性的大敵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "不要推擠，這裡陳列的雕像與大型壁畫沒有展櫃保護，很容易——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "就像我剛剛說的一樣，這尊雕像差點就摔碎了，這很不好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "歷史雖然已經過去，但絕不是與我們無關，可能我們摔碎的，是五百年前的人們征服山峰的歡呼，或他們高舉葡萄酒杯的笑聲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "啊，您解說得真好……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "……但您確定要一直扛著這個雕像嗎？還有您手裡的其他東西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "嗯，我要把它們帶回它們該在的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "都要閉館了，您真敬業。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……閉館？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "唉，廣播突然說有什麼緊急事件，嚇死人了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "那個帶我們離開的糊塗蛋員工一路上左右不分，嘴上說左轉，結果把我們往右邊帶，左轉的時候，她又喊著接下來往右邊走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "這一點我認同，女士，我也對這座博物館在某些方面的處置略有不滿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "那個員工莫名其妙把我們帶到這個鬼地方來，自己又跑得無影無蹤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "這一點我不認同，女士，容我申辯，這裡並不是鬼地方，而是米諾——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "你不知道，發現迷路的時候，我們都嚇壞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "要是沒來得及離場，被關在博物館裡面，肯定只能見到兇神惡煞的亡魂啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "你看那將領的盔甲，看那活祭的祭壇……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的遊客",
      "text": "對……！這就是為什麼我一直不敢來博物館……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "遊客的後腦勺即將撞到地板的一瞬間，阿斯帕齊婭拉住了他。\n雕像、陶罐與金杯都被暫時放下，與伊比利亞人開拓玻利瓦爾省商道所用的火炮並排。"
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "寶貝！你怎麼了？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……應該是受到過度驚嚇導致的暈厥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "我這裡有嗅鹽，能夠救急，但出去之後需要及時去醫院檢查。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "阿斯帕齊婭熟練地壓碎裹在棉花中的薄玻璃管，將濕潤的棉球湊近遊客的鼻子。\n隨後，她扛起甦醒的遊客，平靜地走到隊伍最前面。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "發生了緊急事件，是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的遊客",
      "text": "姐姐……你的手臂好有力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "大家跟好我，出了事情，我會保護好你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虛弱的遊客",
      "text": "姐姐……好棒。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "唉，小傢伙，以後不要亂跑了好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "我有印象，你是拉恕爾養的寵物——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "——哎喲，你怎麼抓我！我可是剛從人潮裡把你解救出來，讓我抱一下不好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你的毛真軟，拉恕爾到底是怎麼把你弄到手的？我之前也想要一隻這麼特別的，但他死活不肯告訴我你是什麼品種，去哪裡能買到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "我一開始還不明白自己為什麼這麼喜歡你，最近才恍然大悟，你長得特別像暗闌時代的雲獸雕像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "正好，現在工作人員都安排好了，遊客正在撤離，既然不能讓你亂竄，我帶你去我的工作室看看正在修復的那尊雕像吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "越過層層向下的階梯，梅捷緹克緹來到了用於文物修復的房間。\n為了減少對文物的影響，空調溫度很低，空氣又冷又乾。巨大的房間內只有一盞白熾燈照明，她吐了一口氣，發現竟然能夠凝成白霧。\n平時協助修復的員工都被派去維持館內秩序了，地下層一片死寂。抽抽鼻子，她覺得心跳得有些快。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "不要怕，小傢伙，我的工作台就在這裡……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "桌台上還殘留著一些類似樹脂的金色物質，那是緹緹使用源石技藝輔助修復文物的痕跡。\n但原本放在桌上的雲獸雕像卻不見蹤影。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的員工",
      "text": "呃，我沒看到雲獸……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "異鄉的遊客",
      "text": "剛剛，在你的額頭有一片陰影掠過，這不是什麼好徵兆，它預告著你會遭遇厄運。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你……你到底是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "你難道也復活了？和那具古屍一樣？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "啊啊啊！我辛辛苦苦把你修好，不是為了讓你和阿娜特的研究對象一樣亂跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "更不是為了給自己招來厄運！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫保管員",
      "text": "發生什麼了？！！誰在尖叫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫保管員",
      "text": "咦……梅捷緹克緹女士，您、您怎麼在這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫保管員",
      "text": "我剛剛接到要暫時閉館的通知，以為您短時間裡不會回來了，所以幫您把修復中的文物收起來了……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "那個……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅捷緹克緹",
      "text": "……沒什麼，我今天想加班了，你先走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "什麼？從東南展廳疏散的那一批遊客還沒找到？不是說叫吉雅阿帶出來了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "我得關門了！是副館長親自發布的緊急閉館指令，我都不敢想像事情有多糟糕！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館售票員",
      "text": "有人去裡面找過了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "已經派人去了，但都說找不到，吉雅阿到底把人帶去哪裡……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館售票員",
      "text": "你怎麼突然不說話了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "聽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館售票員",
      "text": "聽什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "是風的聲音。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "陽光下，一列隊伍緩緩走出了大門。\n為首的女人神色專注寧靜，幾十人的隊伍井然有序，跟隨在她後面。\n風帶起她的衣角，吹亂她的髮絲，她毫無動搖地扛著肩上虛弱的遊客，猶如一尊屹立多年的雕像被賦予生命。"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "我總覺得這個場景在哪裡見過……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館售票員",
      "text": "……我明白，我看過那尊雕像很多次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "還有這種姿勢的雕像？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館保全",
      "text": "哎呀，謝天謝地，終於可以關門了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷路的遊客",
      "text": "太感謝了，這是我的名片，您如果有空照顧我們家族的寶石生意，我一定為您提供最高等級貴賓服務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱情的遊客",
      "text": "哎呀，你到時候來炎國玩啊！阿姨家裡還有個兒子，長得可帥了。我姐家還有個單身的女兒，剛去天師府上班，你也可以見見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "謝謝各位，不必……我只是做了我該做的事情……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "阿斯帕齊婭猛地回過頭。\n鐵捲門緩緩放下，保全人員正在將“今日閉館”的牌子拖到大門前面。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿斯帕齊婭",
      "text": "……我的金杯呢？我的陶罐呢？我的雕像呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "風姿綽約的女人",
      "text": "娜娜到底跑哪裡去了？都這個時候了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風姿綽約的女人",
      "text": "石榴石漿果店裡沒有，琉璃琺瑯瓷器店裡沒有，就連她最愛鑽的天青石貼片水管裡也沒有……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "嘖，找了這麼久，簡直是浪費時間。我看，那隻雲獸就是被博物館暴走的古屍吃掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風姿綽約的女人",
      "text": "討厭，怎麼會！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "寵物，寵一時就算了，好東西多的是，你想要什麼，我都買給你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "只要你點頭，別說那些名貴寶石了，就連整個寶石交易所，我也能買下來送給你！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "神祕的動物",
      "text": "（抬起頭）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風姿綽約的女人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "嗯？你這是默許了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風姿綽約的女人",
      "text": "不，你看你腳邊……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "神祕的動物",
      "text": "（瞪）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "……怎麼是拉恕爾養的崽子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "喂，裝什麼威風？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷傲的市民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "……咳咳，你在啊，拉恕爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "正好，我們做個買賣吧，我的姑娘對這間寶石交易所很感興趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風姿綽約的女人",
      "text": "別鬧了，我可沒這麼說……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "我在薩爾貢東部有一座移動平台，建有規模龐大的源石精煉廠、染料廠、糧食加工廠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "把所有這些都加起來，再附贈些金銀財寶，夠買下這間寶石交易所了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "我拒絕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "你承擔不起這間寶石交易所的重量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "哼，重量……小夥子，你倒是繼承了你外祖父的高傲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "聽我一句勸吧，要嘛像他一樣，養幾頭兇惡的裂獸來鎮場子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "要嘛讓你的小雲獸來迎接像我這樣的貴客，至少牠還會賣賣乖……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "嘶——好痛！你這畜生，你咬我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "神祕的動物",
      "text": "（呲牙）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "神祕的動物",
      "text": "汪——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穿金戴玉的男人",
      "text": "喂，滾開啊，別追——別追上來啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "神祕的動物",
      "text": "汪汪汪——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……沃奧，別生氣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "不懷敬意的人已經跑遠了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沃奧",
      "text": "汪嗷！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "嗯？想要讓我摸摸？……這裡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沃奧",
      "text": "（開心地舔舔）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "一隻羽獸飛來，停落在年輕的寶石交易所監管人的肩頭。\n監管人撥弄了金屬羽獸身上的幾處機關，隨後上緊發條，將羽獸重新放飛。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "……他越來越活躍了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "你們想必也很期待和他見面吧？米奧很少這麼積極地外出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "剛才那人說要讓小雲獸來迎接重要的客人，或許也有道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉恕爾",
      "text": "嗯……米奧真的能把他吸引過來嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
