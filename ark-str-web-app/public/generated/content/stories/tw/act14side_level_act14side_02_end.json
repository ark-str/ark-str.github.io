      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "瓦萊絲",
          "speakerId": null,
          "text": "抱歉......阿克托斯老爺不允許在佩爾羅契家的領地內修建鐵路，我們也沒有使用車輛的習慣。"
        },
        {
          "type": "dialogue",
          "speakerName": "瓦萊絲",
