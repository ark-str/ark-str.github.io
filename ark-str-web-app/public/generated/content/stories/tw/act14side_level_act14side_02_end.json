      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "魏斯",
          "speakerId": null,
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "魏斯",
          "speakerId": null,
          "text": "在下不明白您的意思，博士。"
