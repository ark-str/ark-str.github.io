    },
    {
      "type": "choice",
      "options": [
        {
          "label": "恩希歐迪斯先生會滿意的。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你不會只是為這種事被派來的。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你也有份嗎，訊使？",
