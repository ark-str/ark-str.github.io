        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "啊，嘉維爾在和那個人爭論尾巴的粗細呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "這在我們這裡很常見哦，尾巴是一個阿達克利斯人最自豪的部分，大家經常互相比較，也有因為尾巴粗細而聚集起來的部族。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "和嘉維爾爭吵的那個人應該就是粗尾巴部族的吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人A",
          "text": "*髒話*，弟兄們，都出來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人A",
          "text": "今天我非要讓你們知道粗尾巴的好才行！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "啊，他們人好多，博士，我先去幫嘉維爾了。",
