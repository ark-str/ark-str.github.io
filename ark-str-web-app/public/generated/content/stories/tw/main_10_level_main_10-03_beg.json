  "stageId": "main_10-03",
  "title": "鳴銃示警",
  "storyCode": "10-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_10-03_beg.txt",
