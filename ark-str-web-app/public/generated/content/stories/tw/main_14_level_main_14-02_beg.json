{
  "server": "tw",
  "storyId": "main_14_level_main_14-02_beg",
  "groupId": "main_14",
  "stageId": "main_14-02",
  "title": "破解錘砧戰術",
  "storyCode": "14-3",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_14-02_beg.txt",
  "sourceHash": "bd5d5b6ed2a0240102d21f2d949e0ad2a3b48e8e1b70da00af0dd9490df36c2d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "行動開始後十三小時"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "情況正變得越來越糟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "新生的峽谷，改道的河流……曾經供巨型城市通行的航道，已經被撕碎、重組，變成了無人能知曉全貌的樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "曾經的地圖成了一張廢紙，每一條小徑都需要重新尋覓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "但“提卡茲之血”無疑就在這個方向，我與它之間的紐帶正在顫動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "越靠近戰場中心，一切“訊息”與源石的結合率就越高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "岩石，泥土，水源與生靈……在泰拉，源石的影響無處不在，可也許早沒有人能記起，它作用的根本機制是什麼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "凱爾希，你剛剛提到了“訊息”？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "也許，你很快就會知道了，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "又或者……不，沒什麼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "這一片還在蔓延的、被源石充分浸染的土地在客觀上確實有利於特雷西斯的軍事行動，維多利亞人的陣線幾乎被徹底摧毀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "但如今這些源石活性化的程度遠非之前看似可怕的“天災打擊”可以相比。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "特雷西斯絕不可能僅僅為了一點點的戰術優勢，就選擇如此魯莽地利用源石，他知道這會帶來的後果。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "聽起來我們這一路上會遇到很多困難。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那邊開過來一輛載具？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "“停止”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "貨車跌跌撞撞地停了下來，從上面走下來幾個熟面孔。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "女妖老爺……還有，“魔王”大人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“礦工”",
          "text": "我就讓你別開這條路！這下徹底跑不掉了吧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "可他們又不是什麼壞人……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你們……不是應該留在“生命脊椎”上嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "哎喲……我，我就坦白了吧……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "女妖老爺，魔王殿下……我們實在是太害怕了，留在那個骨頭架子上，不知道還會碰上什麼事，我們就逃了出來……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "我知道這是大罪！可是……我們也派不上用場，對吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "求求您，別……別處決我們，我們願意挨鞭子！挨多少都行！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……我不會處決你們，也從未打算過讓你們為我戰鬥。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "如果你們想要離開，就離開吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "謝謝您，謝謝您！果然，魔王殿下都是智慧又慈悲的——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "可以讓我們和你們一起走嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "噓——別說啦！魔王殿下饒我們一命已經是大恩大德了，你還想怎麼樣？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "別傻了老財，就靠我們三個，還有這輛破車，說不定就在哪被炸彈炸死了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "魔王殿下，懇請您，帶著我們離開這片戰場吧。我會獻上我的所有，只要您能讓這兩個傢伙活下來，我會……我會對您效忠。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你們……不，不是這個問題。如果你們跟著我們，同樣會很危險。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士，你覺得我們該怎麼辦？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他們恐怕很難靠自己活著走出這片戰場。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "嗯……",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        },
        {
          "label": "他們有可能會向軍事委員會透露我們的行蹤。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "“老財”",
              "text": "不不不！怎麼會呢？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "“老財”",
              "text": "我發誓，我們真的不再幹傭兵這行了，再也不了！",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "考慮到這一點，還是讓他們與我們同行比較穩妥。",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        },
        {
          "label": "他們的貨車不錯，可以搶過來。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "博士……我們真的要這麼做嗎……？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "不……博士又在和我開玩笑了。",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "好吧，司機小姐，我們可以帶你們走一段。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "穿過這片戰區後，你們就徹底離開維多利亞吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“礦工”",
          "text": "謝謝你們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "感謝……這輛載具還能載你們一程。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "哎喲，這這這，魔王大人這樣仁義，我真的是不知道怎麼報答您了——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "硬幣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我交予你的硬幣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "我都忘了，哈哈，幸好沒丟。來，給您！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "我知道錯了！為女妖大人服務應當是我的榮幸，我怎敢再收您的好處？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你好像嚇到他了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你很想要回自己的硬幣。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "希望我在你心中並非如此吝嗇的形象。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我需要確保，他們還是“他們”本人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "不必緊張，我無惡意。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Logos動了動手指，躺在掌心的硬幣瞬間消失了，轉眼間，硬幣又出現在了老財的手裡。\n老財盯了會那隻往常一抬起來就地動山搖的手，看了看自己手中的硬幣，又看了看女妖一本正經的面容，頗有些不知所措。"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "這、這是變魔術？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "……哈哈，這可太精彩了，女妖大人還真是多才多藝！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "我……那個，我去幫司機發動車子！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "很有意思的表演。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "表演似乎沒能起到效果。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "嗯。我只見Scout和Outcast示範過幾回，可能動作不夠純熟，所以沒起到很好的效果。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "沒想到你還有這樣的一面。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "難不成，其實你很喜歡開玩笑？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "博士，有時候我也會遺憾於我們之間相處的許多記憶消散無蹤。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我們很少聊起往事……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "總是找不到恰當的時機聊這些。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "倘若我們之後有時間閒談敘舊，或許您也會對自己過去的逸聞感到驚喜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "現在，我們出發吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這附近……什麼聲音都沒有。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這裡安靜得出奇。我聽不到我們的呼吸聲和載具行進聲，我甚至感覺不到……自己的心跳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是某種源石技藝嗎？有人想要隱藏自己的行動，於是小心地遮蔽了這裡所有的聲息？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "不，阿米婭，仔細去聽。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "並非是聲音棄絕了這裡，只是另一種轟鳴太過龐大，以至於再沒有其他任何存在可以與之匹敵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "這裡的死亡……震耳欲聾。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你們看，那裡——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那邊的葉子……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "有一枚葉片，極低處的一枚葉片，正染上一種詭異而絢爛的色彩，像是畫家隨意塗抹的顏料，也像是油脂在陽光下奇異的反光。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "像是某種法術的痕跡。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "像是某種真菌感染。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "它在腐敗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "衰朽張開巨口，啃食著它所能看見的一切，只留下斑斕的齧痕。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "只是幾句話的工夫，明快卻反常的色澤就蔓延到了整棵植株，乃至整片灌木叢。\n原本肥厚的葉片化為泛著白沫的液體滴落，只剩下交錯的葉脈微微顫動。\n如同鱗肉被享用殆盡後殘存的鱗骨，被棄置一旁。\n風更緊了，彷彿扯著皮肉。\n那是食客因仍未滿足而發出的嘆息。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "Logos先生，沼澤裡！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "銀白色的咒文流瀉而出，湧向沼澤的深處。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "解決掉了嗎？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "……不。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "一道窒塞的水聲蕩漾開來，在死寂的空間中打著轉。\n有人從淤泥中拔出腳，再踩下。渾濁的水波翻湧，直抵岸邊。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "做好戰鬥準備。博士，不要離開我的視線！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "黑色的法術被投入沼澤的深處，轟鳴轉瞬即逝，彷彿被人咽下。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "那雙腳再度抬起又踏出，仍是之前的節奏，仍是之前的水紋。\n破碎的衣角漂浮於濁流之上，波紋與波紋相撞，化為雜亂的線條。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Mon3tr。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（謹慎的低吼）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "耀眼的光芒從Mon3tr的口中噴射而出，仿若長矛的光束卻迷失在了沼澤之中。\n水聲終於起了變化。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "嗬——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "一連串急促的腳步聲乍然響起，所有丟失已久的聲音猛然重回這片土地之上，這麼地鮮明，這麼地刺耳。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "死亡……追上你們了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "什麼鬼東西，別過來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "當心！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "“牢籠”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Sudaram……“靈幛”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "纏裹已死之軀的衣袍。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "他的軀體早就朽壞了，普通的攻擊並不能造成決定性的影響。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "這是一種食腐者與生俱來的巫術，或者說……一種古老的傳統。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "食腐者們吞噬生命，滋養肉體，但普通肉體的成長終有盡頭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "在達到臨界點後，強大的食腐者會用自己的身體給養弱小的同胞，換來極致的速度與令人恐懼的力量，以及凡軀所無法承受的巫術能量。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "他們將成為更強大的生物，食腐者的社會也得以發展。就像落葉滋養土地，土地供養新的生命，死與生，構成循環。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "“漲潮”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "沼澤中的泥水飛速揚起，如幕布般，當頭罩住了食腐者的軀幹。\n與此同時，咒文纏繞在所有人的身側，抵擋住了腐敗在這一刻的入侵。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這邊，快，我們進林子裡去！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "別踏入泥濘。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "黑濛濛的地面像是張開了一張嘴，沼澤在上升，或者是空中繚繞的霧氣在下沉。人們的行動變得遲緩，就連喘氣都費勁。\n一個念頭開始佔據所有人的大腦——“活著”竟是一件很費勁的事，轉過頭去擁抱“死亡”，則將獲得一場安眠。"
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Mon3tr——護住博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（急促的低吼）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "他過來了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "唯一的聲響，來自那把突然落下的生鏽長刀。\n與死亡同行的食腐者已來到跟前。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“靈幛”",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（尖銳的嘶鳴）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "Mon3tr……也感到了痛苦？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "任何生命，都會凋零。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "一旦被食腐者的巫術捕獲，我們的生命力會化作養分，不斷地流失。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "好快……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "他是從泥裡鑽出來的嗎？還是從樹上結出來的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "都有可能。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "從生到死，從榮到枯，整個循環過程都可能被食腐者汲取，變成孕育食腐者的種子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我能感覺到，源源不斷的巫術力量正在向我們湧來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "並不僅僅來自這一名敵人本身……沼澤裡，樹林中，哪裡都是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我們已經身處食腐者的輓幛中。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "他將死亡懸於我們頭頂。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "只有撕開這層巫術屏障，才能擊敗他。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "呼……呼……礦工，我是不是要死了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“礦工”",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "他太累了，老財，拉著我，我們不能分開。我……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "司機小姐！抓著我的手，不要倒下去！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "她的意識在下沉，我快抓不住她了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "普通的治療缺乏意義。食腐者的巫術正在吞噬所有人。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "放開……放開我吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我不能……害你……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "哈……你可以丟下我們的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我知道的，要不是我們，你和女妖大人可以更加輕鬆地……戰鬥。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我承諾過會帶你們走出戰場，我們是一起的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "這樣……嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "也好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "血的味道，正在彌漫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是司機小姐他們受傷了……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "不。是血的……巫術。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是……血魔嗎？這片樹林裡除了食腐者，還有血魔？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "薄薄的血霧在四周浮起。\n和他們見過的，鮮血之主的法術完全不同。它是微弱的，像是從鋪天蓋地的腐敗之霧中硬擠出來了幾縷絲線。\n但這些絲線，輕輕挑動了凝滯的空氣。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "阿米婭，感受風的流向。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我會令這層“輓幛”的編織痕跡暴露出來，找到最脆弱的部分。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……我明白了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "黑色的法術在阿米婭身前凝成一支長矛。\nLogos抬起手，指向濃霧深處。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "“穿刺”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“靈幛”",
          "text": "（沉悶的低吼）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“靈幛”",
          "text": "報喪者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“靈幛”",
          "text": "你……抵擋腐敗的蔓延。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“靈幛”",
          "text": "但，無力逆轉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“靈幛”",
          "text": "死亡……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“靈幛”",
          "text": "會為你收殮。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我從未懷疑過這一點。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "“散落”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "長刀插進泥土，宛如墓碑。\n食腐者身上的衣袍獵獵作響。\n幾乎只是一瞬間，那高大的身軀就崩解了，只留下數十條殘缺的布條緩緩地飄落。"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "他、他死了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "終於可以喘口氣——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "咔咔。\n骨頭與骨頭之間的摩擦聲。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "一隻枯槁的手從泥地裡伸出來。"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "啊？啊——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "小心。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "爛了……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "至少看起來是這樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "呼……司機，你什麼時候變得這麼厲害了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "魔王殿下，我們是不是該走了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯，在食腐者再次醒過來，追上我們之前……我們最好離開這裡。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這裡居然有一座血魔的法陣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "它依然在運作。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們和“靈幛”作戰的時候，憑空出現的血魔法術……是不是就是它的作用？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "恐怕沒有那麼簡單。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "阿米婭，你很清楚。剛剛的法術，就來自血魔。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是……血魔的子裔？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我設想過，血魔大君已經離開了這片戰場，但他的恩賜不會輕易消失。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "沒關係，和之前一樣，我會盡我的力量，讓這些被扭曲的生命安息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "Logos先生，請和我一起——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "……阿米婭。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "響動越來越清晰了，就來自那些布滿血痕的巨石背後。這是肢體與地面摩擦的聲音，在之前的戰鬥中，他們聽到過無數次。\n阿米婭注意到Logos的眼神。\n他沒有看向石柱，他看的是阿米婭，眼底飛快地掠過了一絲情緒。\n那是悲傷。阿米婭一下就辨認了出來。\n這場戰爭開始以來，她已經感受過太多次。有的時候來自敵人，更多時候……都是來自身邊的同伴。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……司機小姐。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "魔王殿下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "什麼時候的事？是在……我們和食腐者戰鬥那會嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "離開骸骨的時候，我帶了一塊……先前軍事委員會叫我們運的石頭在身上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我想，之前它讓我們變厲害了，說不定真打起來了也能派上用場。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "你看，的確起了點作用，對吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "能跟著你一起打贏那個古怪的敵人，換作以前，我想都不敢想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你使用了血魔遺留的血色結晶。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "是用它刺破了你的身體嗎？不，那還不至於催生這麼激烈的變化。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你吞服了一部分碎屑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你主動接納了杜卡雷的鮮血和法術。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我本就有血魔的血脈，雖然稀薄得很……但我還是能感受到大君的召喚，哪怕只是微乎其微。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我見過那些蠕蟲從死去的薩卡茲雇傭兵身上爬出來。所以，你們不必擔心我不知道後果。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "只是，與其跟一條真正的蟲子一樣，無聲無息地陷在爛泥裡死掉，我寧可接受更強的力量，作為一個不那麼丟人的薩卡茲，死在戰場上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "那個時候我也是這麼想的。幾個月前，我正在荒野裡漫無目的地開著車，從廣播裡聽到了倫蒂尼姆的事……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "不知怎麼就朝著這個方向一路開過來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "老財說我騎士故事讀多了……他胡說。誰都知道，卡茲戴爾不需要騎士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我不過是想確認，自己的人生是不是也可以在某條路上行進，會有一個終點，而不是被單純地浪費掉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "直到我遇見了你。“魔王走過的地方就是道路”——我們一起，呃，在這條路上並肩戰鬥過了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "現在，戰鬥暫時結束了。我的同伴也大多活了下來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "魔王殿下，你可以處置我了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "處、處置？這是什麼意思？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "司機，你怎麼變成了這副……這副……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "是不是很可怕？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "魔王殿下，求求您，幫幫司機吧！還、還有，女妖大人，我把這枚硬幣還給您，這是我身上僅剩的財產了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "她的狀態是巫術誘發，卻並非巫術導致。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "即便是我和阿米婭，乃至凱爾希醫生，都做不到逆轉你們所見的結果。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老財”",
          "text": "那怎麼辦啊？你們難道要殺了她，就像殺了那些紅色蟲子一樣嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "老財，讓開吧。這是我自願的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "魔王殿下，我聽說……在過去，薩卡茲最英勇的戰士，在死前有資格得到魔王賜予的“願景”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我不知道，呃，不知道自己算不算。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阿米婭抬起手。\n黑色的法術在她指尖積聚。\n司機絕望地笑了起來，下意識看向卡特斯的頭頂，尋找那頂傳說中的黑色冠冕。"
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我的……魔王……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "我會看到什麼呢？但願……不會是在卡茲戴爾開我的破車吧，哈哈。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "司機小姐，能不能告訴我你的名字？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "這也是儀式的一部分嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "唔……知道名字，會方便很多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "……瑪瑞拉。很普通的名字。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "（卡西米爾語）瑪瑞拉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我在卡西米爾待的時間不太久，可能發音不夠好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "不，很好。媽媽死後，已經很久沒有人這樣溫柔地叫我了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嗯，瑪瑞拉，我拒絕你的請求。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "你拒絕為我賜下慰藉？也是，我本來就算不了什麼戰士……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不是的，瑪瑞拉。我拒絕讓你死在這裡，死在我手上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你並沒有變成血魔的造物。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你只是，外貌發生了一些變化。我並未感知到你變得更邪惡，或者更瘋狂。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "就算多了一點……遠古血脈留下的痕跡，你也依舊是你自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你無需被懲罰，也不該由我來嘉獎。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“司機”",
          "text": "你是魔王……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "請叫我阿米婭吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "瑪瑞拉小姐，我是有過一些苦惱，因為你們……呃，並不是羅德島的幹員。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我剛剛也在想，究竟該以什麼方式與你們相處。但其實，這根本算不上什麼問題。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "如果你願意為我們的共同目標戰鬥，那我就歡迎你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你在看阿米婭？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "這些年，阿米婭的變化很大。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭變得更成熟了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "阿米婭從來都是合格的領袖。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "血魔儀式的核心發生了改變。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "不再僅是薩卡茲力量的增幅器，也不再單純收集能量。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "它在將薩卡茲的血脈與源石……與“阿喃那”進一步相連。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "“提卡茲之血”正以某種形式發揮作用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "薩卡茲血脈的力量將直接催動源石擴散，寄宿於源石之中的“訊息”也將反向強化血脈……不僅是力量，還有一些表徵。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這法術效果有些熟悉。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那個薩盧斯就融合了很多血脈。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "赦罪師擅長用這種方式催動血脈力量。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我們要做好準備。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "“阿喃那”……帶來的威脅極有可能超出所有人的預期。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
