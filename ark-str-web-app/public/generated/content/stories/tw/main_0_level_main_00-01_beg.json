  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "可惡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這裡，究竟怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "這邊的屋子，也都給我搜乾淨！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "放開他......不！你們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "反抗？太遲了！可恨的切爾諾伯格人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性",
      "text": "快跑！不要管我......孩子就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "媽媽......媽媽......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警",
      "text": "別管平民！先把陣線守住！這些面具混蛋，人實在是太多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "別讓軍警閒著！繼續打！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警",
      "text": "增援怎麼還沒到！我們要......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "上啊，上啊！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "怎麼回事......？！為什麼，為什麼整合運動會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "遮遮掩掩這麼多年，還是露出本性了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "感，感染者......在襲擊烏薩斯人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "為，為什麼！感染者這樣去騷擾烏薩斯政府的話，會死無葬身之地的......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "不，他們的攻勢相當猛烈。這絕對是有預謀的行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "之前我們救出博士的位置，相當機密......就連那裡都被他們滲入了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "可能切爾諾伯格各處，都已經遭到了整合運動的襲擊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "啊......這，怎麼會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "噓！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員A",
      "text": "還有逃脫的切爾諾伯格人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員B",
      "text": "我在搜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員A",
      "text": "一個也別漏掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員A",
      "text": "切爾諾伯格的冷血動物......刻在我父輩身上的痛苦，這次，就讓我全都還給你們！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "（咳......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員A",
      "text": "什麼聲音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員B",
      "text": "在那裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "（唔！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "（他，他們，發......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（安靜！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "（唔......！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "......嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員A",
      "text": "在這兒！找到了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "......嗚哇哇哇！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "啊！不，別......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員B",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員B",
      "text": "躲在巷子裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員B",
      "text": "出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "啊，啊啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員B",
      "text": "躲在那裡，就有用嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "對，對不起！對不起啊！！至少，至少饒了我的兒子！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員B",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......我們應該，立刻突襲整合運動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......阿米婭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我知道有風險，杜賓教官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "只是，等這些整合運動解散後再行動......會耗費大量時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "何況，誰知道現在的狀況，會持續到什麼時候......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那麼，就應該迅速擊潰敵人並轉移。我說的，沒錯吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "——————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "明白了，我服從你的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "各小組，聽好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "這些整合運動，還沒有意識到我們的存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "記住，果斷、迅速地解決掉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "Dr.{@nickname}，調集隊伍吧，現在是你證明自己的時候了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "現在的局勢，可不允許我們有所保留。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "早就該交給我了！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "簡單，我會輕鬆解決的。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜賓",
          "text": "阿米婭，看你的了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......“如果爭端能夠避免，那我們應當沉默——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "——如果戰鬥是必要的，那就戰鬥到最後！”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "羅德島的信念......從來沒有改變過！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
