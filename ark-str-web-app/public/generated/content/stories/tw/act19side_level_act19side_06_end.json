{
  "server": "tw",
  "storyId": "act19side_level_act19side_06_end",
  "groupId": "act19side",
  "stageId": "act19side_06",
  "title": "掙脫美夢",
  "storyCode": "DV-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act19side/level_act19side_06_end.txt",
  "sourceHash": "0dadb3b8e6f92cd3a122aa87d7bd6625bedd19d217bc39195afe470f47fd7918",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "......桑尼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "我們是自願的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "摩爾醫生，我不明白......您是在代表誰發言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "信息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "我接收到了訊息，不同於過去的訊息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "喬伊絲，是不是頭又疼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "我的身體沒有問題，赫默醫生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "一些未經允許的數據湧入了系統中樞。需要額外處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "......數據？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "嗯......桑尼，我們都知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "這是一場......冒險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "結果......難以預料，但這是我們的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "數據傳輸中斷，系統判斷以上訊息的接收者應為桑尼先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "摩爾醫生，您說話的語氣就好像您是我們......不，躺在那裡的受試者之中的一員一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "無法確認上述假設。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "數據來源未知，我只是感受到了它們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "這是真的嗎，赫默醫生？摩爾醫生能聽到我們的同伴們的聲音？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "......喬伊絲，你選擇了感受這個詞語？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "是的，赫默醫生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "夢境的內容發生了變化。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "你看到了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "無法解析。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "你的眼神和平時差別好大......你是感受到悲傷了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "檢測到邊緣系統信號強烈波動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "......戴拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "戴拉蕾德？你又想起了她......難道九號裝置和弗蘭克斯主任的實驗也有聯繫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "動機，情感，而非邏輯聯繫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "赫默醫生，我能感受到，這是我們的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "你們的......選擇？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "桑尼先生，假如我向你保證，我會盡一切努力讓所有錯誤都得到糾正，你是否願意暫時放過多蘿西·弗蘭克斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "......赫默醫生，我們感激您一路上的幫助，更感激您為我們揭示了實驗的真相。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "我願意相信您會站在我們這邊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "但您真的能保證這個人不會重啟實驗嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "我不能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "可萬一她真的這麼做了，我會替你解決她。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "呼......實驗暫停，多蘿西沒有受傷，受試者們也正在逐漸恢復意識......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我還有些不敢相信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "請不必擔心，情緒起伏是正常現象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "喬伊絲，你醒得太及時了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我從來沒見過奧利維亞那麼生氣......我真怕她會不管多蘿西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "但我還是搞不明白，你為什麼能聽到受試者們的聲音......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "他們的意識是被多蘿西的“中樞”連在一起的，可你明明在外面，你到底是怎麼被捲進去的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "你不是說，九號裝置與“中樞”無關嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "有效資訊不足，無法做出判斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "但是，在夢醒的時候，我聽到了邁爾先生的聲音。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "夢醒的時候......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "那場發生在走廊上的衝突？就連之前的戰鬥都沒能起到作用，為什麼那會喚醒你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "好奇怪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "不過事情解決了就好，多虧了奧利維亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "赫默醫生做到了，符合預期。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "現在想想......她變化真大啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我剛認識她的時候，她還是個......唔，就大學裡很常見的那種好學生，文靜靦腆，不太愛說話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "以上描述與我的記憶相符。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "剛剛她逼問多蘿西又力保多蘿西的時候，我都快認不出她來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "就彷彿看到了......另一個人的影子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "烏比卡研究員，你聯想的對象是否是塞雷婭主任？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "你、你怎麼說出來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "你可別告訴奧利維亞我說了這樣的話啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "赫默醫生並不會因此質疑你與她之間的友誼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "......我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "只是作為她的朋友，我也不想讓她在這麼麻煩的時刻想起不太愉快的往事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "走吧，我也該繼續完成工作了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "通訊......通訊還沒有恢復嗎？糟了，老闆那邊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "還有姐姐，真不知道她會給我發多少消息......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "弗蘭克斯主任，麻煩你跟我一起離開實驗區。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "......請等一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "既然實驗停了，他們一定不會讓這間實驗室留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "有一樣東西......我必須帶走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "這是......照片？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "照片上這些都是拓荒者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "這孩子是......你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "......赫默醫生，我對桑尼說的話，都是真心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "我的母親，我所有的親人......曾經都是拓荒者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "我從小就聽他們訴說自己的夢想，見過他們的奮鬥，也目睹過他們的掙扎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "是他們的付出令我有機會去追逐我自己的夢想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "可是我所擁有的幸運......大多數拓荒者都不可能擁有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "你的家人們，他們現在......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "......他們之中的大多數都已經離開了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "就在我得到鑄鐵城理工大學的邀請，回城參加他們為極少數所謂“天才”舉辦的夏令營的時候......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "一場天災摧毀了我母親所在的臨時基地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "成為一名研究者......曾經也是她的夢想。可她再也沒能等到我得到獎學金，被破格錄取的好消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "你一定非常難過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "赫默醫生，停下這個實驗，真的是正確的選擇嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "那些拓荒者，那些被生活逼得走投無路的人們，他們或許明天就會遭遇厄運。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "而我本可以救他們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多蘿西",
      "text": "他們不必像我的親人們一樣，絕望地被沙暴吞噬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕爾維斯",
      "text": "赫默，為什麼要問我這樣的問題？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕爾維斯",
      "text": "沒有我們的實驗，那個孩子在離開海頓一號實驗室之後根本活不了幾天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕爾維斯",
      "text": "我們救活了她，我甚至讓你照顧她的起居，她不僅能享受衣食無憂的生活，還能為推動科學進步做貢獻——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕爾維斯",
      "text": "相比在荒野上因為礦石病而悄無聲息死去的孩子們，她是多麼幸運啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕爾維斯",
      "text": "我那麼信任你、器重你，你竟然......在這麼細枝末節的操作問題上指責我、指責科學本身？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "......我不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "這個答案也不應該由我告訴你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "喬伊絲提醒了我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "即便我永遠不會贊同你們......你的行為，我也不該用我的標準來評判一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "被自我懷疑與不確定性折磨，難道不正是我們選擇的命運？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "text": "身為研究者，我們只能自己去找答案。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "都佈置好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "我們的人已經進入基地，正在靠近實驗區。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "好，做好準備。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "上校先生，我明白現在已經有些遲了，請再給我一些時間......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上校的聲音",
      "text": "......克魯尼，你沒有告訴我，有其他人進入了基地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "您是指......那家醫藥企業？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "您不必擔心，他們是萊茵生命的合作方，我一定......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上校的聲音",
      "text": "你的保證沒有意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上校的聲音",
      "text": "結果——我們要的只有結果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "我很抱歉，只是一點小小的延遲......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上校的聲音",
      "text": "沒有結果的話，至少別給我們惹麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上校的聲音",
      "text": "記住這句話。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "還要繼續行動嗎，斐爾迪南主任？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "......我並不認為眼前還有其他選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "對了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "替我接通特殊通訊頻道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "咦......通訊？突然通了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "......埃琳娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "主任？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "太好了，我一直都想聯繫您，可惜連不上......您收到我的資訊了嗎？我把基地裡發生的事情都寫進了簡報裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "多蘿西......弗蘭克斯主任的實驗出了點意外，不過沒關係，我和赫默研究員處理好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "還有拓荒者，他們也被安撫好了，正在離開實驗區......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "......我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "您......您知道？這麼快......不愧是您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "你做到了你該做的事，接下來會由其他人過來清理現場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "您是說防衛科的同事們？他們終於進來了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "呼......那我更放心了。我還在擔心實驗區儲存的那些遞質......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "他們知道該怎麼做，你可以撤出來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "主任，我還是留下幫他們吧，除了多蘿西，基地裡只有我對實驗內容最熟悉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "埃琳娜，我此刻就在監控站，難道兩位主任還控制不了局面？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我不是這個意思......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "那就聽我的話，立刻撤出實驗基地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我能問一下為什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "別用這些沒有意義的提問浪費我的時間。馬上來監控室見我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "......是，主任。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "有什麼問題嗎，烏比卡研究員？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "主任......斐爾迪南讓我立刻撤離。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "撤離？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "喬伊絲，你先去通知奧利維亞吧，防衛科的人就要到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白面鴞",
      "text": "那你呢，要離開這裡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我......主任的反應不太對勁。如果說......他並不知道多蘿西走到了哪一步，那他為什麼對實驗出的狀況毫不關心？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "斐爾迪南主任，埃琳娜小姐並未離開實驗區。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "是否中斷計畫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "......不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斐爾迪南",
      "text": "我們繼續。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "其他人都撤出去了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拓荒隊成員",
      "text": "是的，領隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "下一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "他們在做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拓荒隊成員",
      "text": "說是什麼預防程序，大概是想給我們打什麼鎮定劑吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拓荒隊成員",
      "text": "我們也算是大鬧了一場，是吧，頭兒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "......別忘了我說過的，等他們問起來，事情都是我做的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拓荒隊成員",
      "text": "放心吧，不會讓你一個人擔著的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "你這傢伙......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "下一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "......我叫桑尼·羅馬諾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "我沒問你姓名。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "麻煩你跟你們頭領說一聲，綁架的事情都是我的個人行為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "右手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "打完針以後，你們總該處理這件事了吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "怎麼回事......烏比卡博士？你為什麼要撞我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "不要接受注射！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊茵防衛科成員",
      "text": "研究員，你妨礙了我們的工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "正好，你的注射器裡裝著的，是我的工作成果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "需不需要我給你解釋下這東西的適用對象？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "啊？他們不是你和赫默醫生的同事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "你......怎麼該相信的時候胡亂懷疑，該懷疑的時候這麼容易相信別人啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "把你手上的環也拿下來，快——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "......緊急醫療環？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我看到他們給你注射才想起來，喬伊絲為什麼會醒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "醫療環，就是這東西！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "發給你們的醫療環都被改造過，上面有和多蘿西實驗室裡的儀器類似的感受器，只要和遞質一接觸就會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我得彙報給主任，從始至終都有人在背後利用......利用......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "該死，通訊......通訊又斷了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "原來......原來是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "我一直都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "桑尼",
      "text": "烏比卡博士，你看起來怎麼像要哭了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "......哭？不，我只是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "這不重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "text": "危機根本沒有解除，桑尼，你們的敵人從來都不是多蘿西！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
