{
  "server": "tw",
  "storyId": "main_6_level_main_06-09_end",
  "groupId": "main_6",
  "stageId": "main_06-09",
  "title": "解開鈴鐺",
  "storyCode": "6-10",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_06-09_end.txt",
  "sourceHash": "665757496307425d7ab1bbd9ba753b352d6740329269cec57c86d49959024542",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "哈，哈......厲害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "擊退那些穿黑雨披的了！你們，趁這個機會，趕緊走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "謝謝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "別謝，有餘力的話，最好能和我們一起戰鬥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "你看到他從四層樓上蕩下來，從我頭頂上劃過去那招嗎？要不是我用背包裡大姊的源石凍住了他的武器，我已經沒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "真厲害啊，感覺和烏薩斯的防毒面具軍刀人一個意思了，不，可能更強！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "差點就沒命，怎麼還這麼興奮？你說的面具軍刀可是烏薩斯皇帝內衛！我們那次也只是碰巧遇上五個！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "現在，你數得清有幾個雨披嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "這說明我們比以前更厲害了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "現在不是開玩笑的時候，他們的戰鬥技巧和那身裝備，肯定要一個城邦......甚至幾個城邦的工業支持才能夠成立。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "沒其他小隊的幫助，我們根本不可能擊退他們，別說讓他們減員了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "我就......就覺得自己還挺努力的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "但現在的事態明顯超出我們的掌控範圍了......我們也沒法撐太長時間！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "安靜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "報到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "大姊。這幾位是......浮士德的隊員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳咳......我記得你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......霜星。我們收到了你的通訊，就......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "梅菲斯特怎麼在你們這？他怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "梅菲斯特他似乎......精神受到了一點創傷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "他？會精神受創？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "等等，浮士德呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德他為了讓我們和其他小隊順利撤退，留在了貧民區之外。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "那種情況下，很難生還。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "浮士德是個好戰士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "霜星，如果可以，我們想和雪怪一起戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "可以。我們必須讓剩下的同胞都順利逃生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "去狙擊位待命，之後的戰鬥，我們一定需要你們的援助。我們不知道敵人會在什麼時候再發動進攻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "通報，把我們的位置傳給各個小隊！讓他們迅速從這裡撤退，我們會保證行進路線的安全！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "繼續去疏散人群。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "他們和烏薩斯士兵一樣，完全不顧及周圍的地形和人群啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "我覺得不一樣，烏薩斯可是敢在上城區裡調用艦炮的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "早知道他們很冷酷，但居然還有這種事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "我們真遇見過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "這些穿雨衣的確實不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "平民在他們眼裡不是障礙，而是同樣的目標，因為沒法分辨誰是感染者誰不是，他們也不知道我們是不是裝扮成了平民的樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "那烏薩斯是不管不顧，這些人則是一個都不放過！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "逃難的人很多，已經快維持不住秩序了！霜星還真是會給人出難題啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "大姊是絕對不會見死不救的，這不分整合運動不整合運動的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "本來是打算來龍門加入作戰的，怎麼一來就淨救人了，夠奇怪的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "還作戰呢，已經徹底玩完了，沒你們來支援，我們就全死這裡了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "很嚴重啊。真就全指望我們了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "別用這種很了不起的口氣說話......以前我還覺得你們很可怕，現在，完了，像個街頭喜劇演員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "你對我們有誤解，我們只是沒怎麼說過話，可怕應該說不上啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "就一點，別說指望不指望，我們不是在和你們一起在這防守的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "說得對！兄弟，讓我們守住這裡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "是......我們在這裡發現了被困在室內的本地人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "一對母女。我們打算把這裡佈置成火力點，但不知道怎麼和她們溝通......她們似乎被我嚇到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "（當地語言）！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "（當地語言）......（當地語言）......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......她是你的孩子，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兒童",
      "text": "哇......哇......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "真是健康的孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "嗯，別怕，別怕。不哭，你媽媽在你身邊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "有媽媽在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兒童",
      "text": "嗚，哇......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兒童",
      "text": "唔，哎......唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兒童",
      "text": "嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "啊，這小孩居然笑了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "快帶她走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "......（當地語言）？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "你們幾個，咳，護送她走。去安全的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "她們母女是非感染者，我們還有很多同胞沒撤出，沒多少時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "......也是，都這時候了，還分什麼我啊你的。明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "嗯，呃，女士，嗯......zhebianzou？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "nimen，nimen......hao。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員",
      "text": "霜星姊，記得等我們回來。可別再強撐著了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "別小看大姊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......快走！他們來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "還有穿其他制服的部隊在部署進攻......可能那些才是龍門近衛局！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳咳，咳咳，嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "已經把區域溫度降到最低了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "穿制服的不是我們的對手，但還是得小心那些雨披！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "大熊呢？現在的火力太小了，炮火壓制，搞大點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "他說他知道了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "我感覺大姊的身體快到極限了，不能再繼續降溫了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "不能破壞現在的路面結構嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "不行，破壞了道路，整合運動和本地人就沒有別的通道抵達這個出口了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員B",
      "text": "確定這是唯一出口？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "是......所有的其它出口全都被毀了。只有我們破開的這個出口還能用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "......我們還剩下多少時間？不，霜星姊還剩下多少時間？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "為什麼都到這個時候了，還要這麼折磨她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員A",
      "text": "這批已經差不多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "我去找大姊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "大姊，這批感染者已經全部撤出！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "戰況......呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "我們完全壓制住了近衛局。地形很適合我們，近衛局沒辦法運用他們的數量優勢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "沒什麼好隱瞞的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "穿雨披的龍門部隊絲毫不在乎地形和居民。他們......他們是要徹底摧毀這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "他們在蕩平貧民窟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "我們之前看到那些非感染龍門人的......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪怪小隊成員C",
      "text": "恐怕也是他們做的。",
