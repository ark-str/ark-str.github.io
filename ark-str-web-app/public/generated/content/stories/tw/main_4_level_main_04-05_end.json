  "title": "官僚主義",
  "storyCode": "4-5",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-05_end.txt",
  "sourceHash": "cf20e2a5f5a65b0efe7de817774f77c5e2e9be59f88e4263f5152048b6f9e24e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "事已至此......我們已經沒有別的選擇。如果陳長官拒絕——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那麼羅德島就會單方面出動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "況且這一行為，並不破壞羅德島與龍門之間的合約。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "近衛局當然會去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......是，是嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那我代表羅德島感謝陳長官——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我知道，感染者對於龍門而言......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "這是小事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "只不過，我對於近衛局各個小隊是否能突入分城內部還有一定的疑慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我們將見機行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "如果可能的話，我們一定會幫助你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "但近衛局依然會以處理整合運動這一任務為最優先。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "這樣......這樣就夠了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......謝謝你，陳長官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "抱歉，我有自己的使命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "設備另一頭的那個醫生，聽到了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "我會與羅德島一起行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "阿米婭，小心點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "事情並不單純。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我會小心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "對了，我陸續建立了一些綜合情報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "羅德島已經派出了救援小隊，協助其他參與任務的偵察小隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "只不過隕星他們所在的地方，我們無法深入，無能為力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "這要靠你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "只有隕星她們嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我明白了。我會去找她們的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "我會將把座標發送給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "記住，一切以安全為最優先。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "所以，什麼時候出發？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "現在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我去整備。你通知一下近衛局的其他人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陳",
      "text": "阿米婭，十分鐘之後，我們一起出發。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "你們一定要平安無事......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
