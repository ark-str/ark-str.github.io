      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......別哭。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "至少現在......先忍一忍吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "以前有個人這麼對我說過......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "眼淚......要留到戰爭結束之後。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "現在......還不行。"
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "嗯......嗚......嗯......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "走吧......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
