      "speakerName": "牧群",
      "speakerId": null,
      "isRemote": false,
      "text": "（詭異的哭號）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "isRemote": false,
      "text": "為、為什麼！為什麼要傷害同胞，醒醒啊！"
