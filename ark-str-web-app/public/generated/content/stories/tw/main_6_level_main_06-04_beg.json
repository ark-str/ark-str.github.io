    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_038",
      "isRemote": false,
      "text": "感染者流竄群體，發現於十三區、六區交界。四十四人。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_038",
      "isRemote": false,
      "text": "預計完成時間小於五分鐘。"
