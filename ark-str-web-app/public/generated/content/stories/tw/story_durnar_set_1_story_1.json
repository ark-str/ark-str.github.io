    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "愣著幹什麼，碰到敵人不需要警戒嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "啊是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "警戒！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "好，反應不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "既然是初戰，就由你們先發起攻擊吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "互相之間要注意配合，要是不當心，那就和我一個個對付你們沒區別了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堅雷",
      "text": "明白了嗎？",
      "portraitKey": null
    },
