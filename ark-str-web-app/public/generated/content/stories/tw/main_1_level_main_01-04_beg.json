  "stageId": "main_01-04",
  "title": "先兆",
  "storyCode": "1-4",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_01-04_beg.txt",
  "sourceHash": "89443faee2c5aad7d2b019ae13755746268d22f00bde005fde7b2402b3c2a324",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第九关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "呼......甩開他們了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "按這個速度，我們很快就會離開中城區，抵達南面出口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "周圍也變得越來越嘈雜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "可能是切爾諾伯格的居民想要逃出城市，反而和整合運動發生了衝突吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "似乎有幾個城區已經撤離了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "而沒來得及逃出切爾諾伯格的本地居民，卻依然被整合運動攔在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "這個開闊區域，曾經是個大廣場吧。如今......只剩下些廢墟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "虐待感染者的城市，遭到了感染者的報復嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "你似乎——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "很有感觸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "呵，曾經......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "天色......越來越暗淡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "好像連空氣中......都彌漫著一股......燃燒的味道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "平民",
      "text": "你們在幹什麼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平民",
      "text": "......啊啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "————!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "平民？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "聽不到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "——這個距離，沒法確認身份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "整合運動在攻擊他們——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "在這種地形沒有優勢。我們沒有能力去顧及他人的生命安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "生命很寶貴，阿米婭。每個人的，都很寶貴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "不管怎麼樣都來不及了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "畢竟我們已經有更大的麻煩找上了門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "不好的事情還是發生了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "——————殺了他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "開闊區各個出口同時出現大量整合運動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "準備作戰！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
