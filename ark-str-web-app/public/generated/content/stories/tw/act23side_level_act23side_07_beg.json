    {
      "type": "dialogue",
      "speakerName": "山海眾首領",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "到此為止吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "秋夜......？"
