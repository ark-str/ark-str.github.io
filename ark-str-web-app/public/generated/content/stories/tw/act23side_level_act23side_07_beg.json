    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "別再提了......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "幫我一把，先解決掉這些人。"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "好說。"
