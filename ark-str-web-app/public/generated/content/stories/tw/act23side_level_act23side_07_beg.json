    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "昨晚鑄劍坊，我趕到的時候看到你被官兵帶走了......你現在......？"
