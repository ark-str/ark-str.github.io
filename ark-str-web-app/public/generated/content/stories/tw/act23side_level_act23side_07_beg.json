    {
      "type": "dialogue",
      "speakerName": "杜遙夜",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "幫我。我有很重要的東西要交給平祟侯。"
    },
    {
      "type": "dialogue",
