    {
      "type": "dialogue",
      "speakerName": "仇白",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "平祟侯在外城城樓鎮守。你的箭傷很重，還跑得動嗎？"
