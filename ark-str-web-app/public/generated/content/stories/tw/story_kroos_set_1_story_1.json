    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米格魯",
      "text": "啊對了，隊長，周年快樂！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芬",
      "text": "啊，嗯嗯，謝謝你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米格魯",
      "text": "唉？",
