{
  "server": "tw",
  "storyId": "main_9_level_st_09-01",
  "groupId": "main_9",
  "stageId": "st_09-01",
  "title": "風暴突擊",
  "storyCode": "9-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_st_09-01.txt",
  "sourceHash": "577e7e915258c01e32c9eae30015eb1b65879044db8c6d07a93c2e31f2253533",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我們已進入倉庫。偵查組，報告情況。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "隊長，東南角有生命體徵。距離你們七排貨架，活動範圍一米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "人數？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "一人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "有沒有源石反應？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "暫時沒發現。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "好，各自就位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "風笛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "你在找什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "隊長，是不是有人在唱歌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "別分心。這說明目標不在警戒狀態。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "按照作戰計畫，等我信號，你來突入。現在，繼續前進。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "五、四、三......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "準備——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "掩體已破壞！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "咳咳咳......怎、怎麼回事？突然好大的煙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "不許動！待在原地，舉起雙手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "我、我......你們是......維多利亞士兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "為什麼你這樣稱呼我們？你不也是維多利亞人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "他要逃跑。大提琴，注意攔截！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "隊長，他沒有往出口去，他折回來了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "三角鐵！目標撲向了後排貨架！只要監測到源石反應，立刻發射弩彈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "其他人，到我盾後集合！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "快！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "風笛，你在做什麼？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "我捂住了！大家快跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "隊長，沒有源石反應，風笛身下不是炸彈。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "啊！虛驚一場嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......目標呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "不好意思，撞得有點狠。他一時半會站不起來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "那這些箱子裡......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "我看看啊，全都是馬鈴薯和胡蘿蔔，還有花椰菜欸！被我壓壞了。好可惜，看起來都挺好吃的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "不要放鬆警惕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "這排，這排，還有這排......都一樣。隊長，這倉庫裡全是果蔬糧食啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "三角鐵，注意周圍有沒有其他人靠近。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "雙簧管，你和風笛一起搜查倉庫。有發現隨時給信號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "大提琴，把這位癱倒在地的先生綁起來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "唔呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "現在，先生，麻煩你回答幾個問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "我、我什麼都不知道，我每天都會在這裡分揀馬鈴薯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "你是小丘郡的居民？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "你聽說過鬼魂部隊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "鬼......什麼？呵、呵呵......部隊說的不就是你們這些當兵的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "把洛瑞、朱利亞和克里斯他們抓走......現在是不是、是不是也輪到我了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "請你冷靜一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "聽好。有人看到，昨天半夜有一批源石製品被送進了這個倉庫。而如今它們不在這裡。你需要對此作出解釋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "解釋？你們真想要這個，而不是直接吊死我？我、我......呸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "嘿！你怎麼亂吐口水？也太不注意衛生了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "有線索嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "沒有，隊長，到處都是馬鈴薯。如果消息沒錯的話，他們的動作有夠快的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "帶走他。他一定知道些什麼，只是還不願意開口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "我就說......你們都一樣！費盡心思地找我們的錯處，折磨我們......你們這些維多利亞的吃人惡獸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "啊？又來？他覺得把一個維多利亞同胞叫作維多利亞人算是種辱駡嗎？真是搞不明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "隊長，有人來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "幾個？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "（準備散開。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "（是，隊長。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "報告，隊長，他們好像是自己人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "人在這裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞士兵",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "（隊長，我們被包圍了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "（從人數上來說，是。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "（聽聲音的話，留在外面的人好像不是很多。從我手邊破牆的話，我們有機會欸！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "（稍安勿躁。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "看起來這裡剛剛發生了一場激烈的戰鬥。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "麗塔·斯卡曼德羅斯，第七前線步兵營，第二風暴突擊隊隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你好，斯卡曼......斯卡曼德羅斯中尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我的名字不算好記。您可以叫我號角，上尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好的，號角女士。我叫凱利，路易士·凱利。抱歉，我們這裡不流行代號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "凱利上尉，您和您的部下想必也是為了追查這個倉庫而來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "是的，我們也收到了情報。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "那您應當能理解事件的嚴重性。一批數量不少的非法源石製品，兩個月前就被人從軍用運輸路線上竊走，最後消失在這一帶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "不需要我來提醒您，上尉，這麼多武器，加上周邊各郡近期失竊的那些，如果全部落到不法分子的手裡，受到威脅的可遠不止小丘郡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "......好，謝謝你說這些。我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我們也很感謝您的配合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "希爾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希爾",
      "text": "長官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "把這個年輕人......這個可疑分子抓回軍營。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "啊？這人是我們好不容易找到的線索！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希爾",
      "text": "長官，她的矛在妨礙我執行任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "風笛，鬆手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "可是我們的任務——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "——我們現在在小丘郡地界上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "凱利上尉從口袋裡掏出一塊手帕，擦了擦額上的汗。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "很高興你想通了，中尉。你與這位年輕的瓦伊凡女士，還有其他諸位......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "咳咳，你們一路從倫蒂尼姆趕過來，想必路途艱辛，累得不輕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "這是我們身為維多利亞軍人的職責。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "是啊，沒錯。接下來，如果你們還想在小丘郡活動的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我們必須繼續追查源石製品失竊案，這是來自倫蒂尼姆的命令。我想漢密爾頓上校也會理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "當然，當然。你們可以隨我一塊回軍營。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "隊長，我們真的要把人讓給他們嗎？他們絕對是故意的！從我們進入郊區地塊開始，他們就跟了上來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "直到現在我們抓到了人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "“帝國駐軍有責任對駐地發生的危害公共安全的事件進行響應。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "他們沒有違反規定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "唉......好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "上尉，人是你們的了。按照規定，我們也可以參與審訊——希望您還記得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "哈、哈哈......這確實符合規定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "不、不要......放開我！不要抓我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希爾",
      "text": "呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "救我......救救我！我什麼都沒幹......我不知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的青年",
      "text": "啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "希爾......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官希爾",
      "text": "這些塔拉渣滓總是這麼聒噪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凱利上尉",
      "text": "......帶走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "欸欸，這人怎麼這樣啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "風笛",
      "text": "（隊長，我覺得......那個年輕菲林在向我們求救。他很害怕跟他們走。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "（......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "（三角鐵？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "我在，隊長。我還在外面樹上老位置，他們沒注意到我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "（那就好。你帶著偵察小組，繼續沿附近運輸路線調查。有線索立刻彙報。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "三角鐵",
      "text": "好。隊長，需要向駐軍通報嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......注意保護自己。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
