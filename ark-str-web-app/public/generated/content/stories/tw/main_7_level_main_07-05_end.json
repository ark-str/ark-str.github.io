{
  "server": "tw",
  "storyId": "main_7_level_main_07-05_end",
  "groupId": "main_7",
  "stageId": "main_07-05",
  "title": "遺忘之地",
  "storyCode": "7-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_07-05_end.txt",
  "sourceHash": "573f71cd574c7f8fee365bed0dc49670b9e0b48291fbe87a2a830583846cb31b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "流血。刺穿。撕裂。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這不對。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "我們。敵人。人。\n哀嚎，慘叫，呻吟。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這不對！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......！",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我不能接受。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你想問問題。你可以問。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅德島幹員",
          "text": "博士......是第一次看迷迭香戰鬥嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅德島幹員",
          "text": "我知道你不好受，但——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "交給我。去照看失去戰鬥能力的敵方傷患。以及，他們中有負責發佈消息和接收命令的傳令兵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "他們的逃脫會對我們的行動造成巨大威脅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅德島幹員",
          "text": "......明白。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "她多大年紀？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "14歲。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你允許她......？！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "諸位幹員......請讓我過去！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......這裡發生什麼事了？我才剛處理完現場......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......怎麼了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "博士，你剛才是叫我了嗎？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "是誰把你推上戰場的？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "是誰把你推上戰場的！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這麼殘忍的事情！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......可怕......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "這絕不是你該承受的。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......為什麼要讓你來做？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "凱爾希！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......！",
          "value": "2",
          "blocks": []
        },
        {
          "label": "不該這樣。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "是我自己。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你在說什麼？！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你自己是什麼意思......？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我選擇了戰鬥。我想要戰鬥。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "有些感覺只有在戰場上才能找到。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "保護了朋友和家人的時候才會感覺到滿足。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......羅德島需要我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "為了阻止更多像我一樣的人生出來，這片大地在叫我的名字。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "即使如此，你也不......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你不能——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......死亡有把誰當作小孩嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "戰爭和感染，會因為它們看見的是小孩，就讓他們活著嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我和阿米婭站在戰場上......看到我們，誰的第一印象是“孩子”呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "博士，我們是“怪物”吧？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不！！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "這只是你自己的看法。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "博士，不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "Dr.{@nickname}，不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我自己是什麼，沒什麼關係。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我只想和我的家人一起做有意義的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "你知道Scout嗎？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那是......？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......你知道Ace嗎？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我知道。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......我已經有幾天沒有看他們的事情了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我已經忘了許多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "但是，我只是忘掉，我和無論什麼全都丟掉的博士不一樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "迷迭香。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......不，不是這個意思。但你明白的，阿米婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......我明白。但可以......別這麼說。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "嗯嗯......好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我丟掉的只有零零散散的，許多看到的，許多句子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "那些感情，那些......我說不出來，只有阿米婭能懂的感情......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "卻從來沒有離開過我。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "博士......我覺得你很複雜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "比他們說的都要複雜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "有人說我也很複雜。有人看見我就會害怕。有人說我不該這樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "但他們也不知道我為什麼會這樣，不知道我感受到了什麼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "為什麼在這時候突然心痛？為什麼在這時候會想要哭呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "明明什麼事情都不記得了......為什麼眼睛還是很酸，嘴唇也會變乾呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "走廊裡那塊污漬是誰留下的，為什麼沒被擦掉？為什麼在打碎瓷瓶的時候既擔心，卻還有點開心？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "看到花朵就感覺很討厭，看到蟲子反而很好奇，又是為什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "在我不記得的那些事情裡，到底發生了什麼？為什麼這一種種感情都湧了上來？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我感覺到的幹員們身上有著各種各樣的不同。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "到了失去大家的時候，那些感覺，當然全都消失了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "可為什麼......為什麼，會有情感這種東西啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "為什麼已經感受不到了，眼淚卻一直在流、一直停不下來呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我不是都已經，忘記了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "但是迷迭香從來不想我拿走這些感情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這些突然纏上來的情感，無論它是什麼樣子，它都屬於迷迭香。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......也只屬於迷迭香。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我不能干涉它們。只要在迷迭香的腦海裡還有美好的希望......我就不會這麼做。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "因為，要做什麼，是迷迭香自己決定的，要忘記，也是迷迭香自己去忘記。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "真正地忘記。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "迷迭香身上發生了什麼？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我還沒有那麼瞭解她。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "Dr.{@nickname}......羅德島會嚴格甄別每一個幹員。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "許多幹員申請前往戰場，都被我們拒絕了。羅德島會從種種角度判斷一個幹員是否適合作戰任務。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "作戰能力，戰術考慮，紀律和身體素質，都是考察的要素，但這都是淺層次的條件。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "在實際的任務中，許多人並不知道如何去信任彼此。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "迷迭香在這裡，是因為她相信我們的指揮和目標，而我們相信她的能力和她的判斷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "請相信我，博士。不，請相信我們......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你會慢慢看見她......感情的顏色。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "博士。謝謝你和煌一起戰鬥。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "為什麼？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "沒什麼好謝的。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "煌需要更多人和她一起戰鬥。我也想看她笑的樣子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我也想看看你的樣子。我想看看，Ace和Scout一直在說的你，到底是什麼樣子。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你在這。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "輪到你來找我了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......使用沉重的大型器械迅速而有力地摧毀敵人，同時兼具驚人的自制力和極強的應變能力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "迷迭香是羅德島最出類拔萃的殲滅戰要員之一。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "相應的，她的待人方式和說話語氣可能會讓你感到擔憂，她戰鬥的姿態，相較她的外表，也的確很殘酷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "也許手持電鋸四處大鬧的煌還算能讓人接受，迷迭香戰鬥時飛濺的碎片，則的確會讓一些人感到不安。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "如果能使你稍微感到平靜一些，我可以給你一點保證作慰藉。假使你確實能被說服的話。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "——迷迭香很少擊殺敵人。雖然看上去相當直接，但她的戰術旨在解除敵人的戰鬥能力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "譬如說，剛才的戰鬥中，所有敵人都被成功解除了武裝，且並沒有人因為迷迭香的攻擊而死去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "她對武器的操控能力比起過去，已經進步了許多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "當然，我們擒獲的敵人是否能得救，取決於我們能否及時擊潰整合運動的指揮核心。直到那時，我們才有可能派遣救援隊進入核心城。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "以及，當我們必須實施致死性打擊以達成戰術性目標的時候，傷亡不可避免。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......你還是皺著眉頭。是不是還是覺得這些表面現象依然超過了你的想像？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我不能接受。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我不能理解。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "事實可能也超乎你的想像。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "令人膽寒的源石技藝和令人驚訝的感知能力，並不是迷迭香成為精英幹員的理由。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "——迷迭香正是因為成為了精英幹員，才表現出了這樣的素質。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我們不是判斷“我們應該把她送上戰場”，而是判斷“如果不讓她成為這樣的戰士，後果將不堪設想。”",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "什麼樣的後果？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "說嚴重一點吧。她身體裡滲透出的源石技藝可能會無意識或有意識地屠殺生命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "人類的互相毀滅已經成為了一種常態，即使現在這種事已經相當頻繁地發生在這片大地上，大多數人卻依然還是自己握著兵器和法杖的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "失去自我意識的人，是否還算是人這一話題，我並不想討論。但人類面臨的正是這個問題的應用延伸。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "“當剝奪了人類個體的自我意識時，剩下的是什麼？誕生的又是什麼？”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "“當它剝奪我們的生命時，有罪的究竟是誰？”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "是造出武器的人，是使用武器的人，還是被當作武器的人？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "又要我猜謎？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我會自己查明的。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "隨著之後戰鬥的繼續，我也許能為你更多地解釋一些事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "順便，年齡的問題。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "阿米婭的假裝成熟也許讓你產生了一種錯覺。當然，也許有，也許沒有。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "被當作武器的幼小生命，並不會因為表現稚嫩，就可以被看作是普通孩童。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "——何況她們已經經歷過太多了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......整理一下你的必備物品。我們差不多要向地面進發了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那阿米婭呢？她也是武器嗎？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......你可以自己去問她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "而且，這也該由她自己告訴你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "凱爾希！站住！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "華法琳。我馬上就要出發了，無論要說什麼，你都可以直奔主題。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "你知道那個預言吧？不對，沒有什麼是你不知道的，你肯定知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "預言？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "你是不是因為這個原因允許阿米婭去的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......阿米婭才是這場行動的總指揮和發起人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "可阿米婭只有一點點大，怎麼能做總指揮——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "華法琳，我們離開卡茲戴爾多長時間了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "給我個準確的回答，否則我走了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "......兩個月？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "華法琳......別開玩笑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "我知道你的意思。她長大了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "是的，華法琳。歲月如梭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "卡特斯人的生理變化和血魔生理變化有著難以估量的差別。到現在為止，我們已經離開卡茲戴爾三年了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "也許你的時間只過去了一點點，但阿米婭已經成長了許多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "你還是先回答我的問題。預言。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......“最後的溫迪戈將會死在魔王手中？”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "就是這個。我知道那個遊擊隊，以及領袖。是他沒錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "預言原本的句式是“胡爾提克茨之子，薩卡茲的背叛者和血脈末端的不榮譽者將遭薩卡茲的君主出手處決。”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "那甚至算不上個預言。無論他們所謂的“血脈”是否得到了延續，迄今為止，依然有許多溫迪戈還在烏薩斯和哥倫比亞生活著。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......如果你允許我把幾十個算作“許多”的話。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "而且，結合當時的語境，你應該將它看作是一句威脅。很多人不希望溫迪戈們離開卡茲戴爾。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "最開始說出這句話的可不是你我，既然你也記著，就說明你也覺得很重要。對不？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你是不是上年紀了，怎麼會相信“預言”這種薩卡茲巫術般的說辭？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "——年紀？你，你好意思說我？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我感染了礦石病，死亡永遠立於我身側，只等時機成熟。華法琳，我的生命一定比你想像的更短暫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "欸！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "我們一定要說得那麼嚴肅嗎？我不是那個小丫頭可露希爾，有些事情我可沒法讓你輕描淡寫過去的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你提出的議題相當的嚴肅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "......不管了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "凱爾希，聽好了，其他人可能不會和你說，但我會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "他是我們裡最後的幾個之一了。我不是慈善家，也沒那麼老好人，但......我們是薩卡茲人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "即使我是血魔，那個老頭是溫迪戈，也一樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "......薩卡茲人在這片大地上已經過得夠難了。可能的話，我希望他能回到卡茲戴爾。來我們這裡也行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我不是。華法琳，我不是薩卡茲人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "所以你不答應？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "不......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我盡力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......我甚至記得他，華法琳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "有你的承諾比什麼都強。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "別指望事情能有那麼順利。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "但這次是你試著去做。只要是Dr.凱爾希去做了，什麼樣的結果我都接受。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "也許你還沒得到消息，但是你的建議提出得太晚。有一些事情已經不幸地發生了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "前些時間切爾諾伯格的感染者診所“阿撒茲勒”已經與我們交換了資訊。我得知的不僅僅是他正服務於整合運動這件事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "此外，你該清楚，如果你與他交戰，你甚至可以嘗出烏薩斯最暴虐時的刀鋒是沾著鹹味還是鏽味。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "沒有人該有意識地置羅德島幹員於險境。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "華法琳",
          "text": "有些患者的生命有限，但限度的高低取決於主治的醫師。事在人為。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "......事在人為。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "以及我以前提醒過你......可能你又忘了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我不會因此懲罰你，卻可能做些一勞永逸的事情來永絕後患。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "不要說我可怕，華法琳。我們說好的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "“不許在任何場合——哪怕是羅德島——再提起‘魔王’二字。”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "永遠不許。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "等等。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "全員，稍息！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "迷迭香......是我的錯覺嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "嗯，不。我也感覺到了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
