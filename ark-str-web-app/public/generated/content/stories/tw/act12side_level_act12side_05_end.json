    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "speakerToken": "avg_npc_196_1#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "......陳暉潔，沒有人會主動給自己找罪受。"
