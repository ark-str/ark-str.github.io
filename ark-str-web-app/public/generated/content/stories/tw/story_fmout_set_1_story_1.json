{
  "server": "tw",
  "storyId": "story_fmout_set_1_story_1",
  "groupId": "story_fmout_set_1",
  "stageId": null,
  "title": "占卜",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_fmout_1_1.txt",
  "sourceHash": "a4009b10b9aa3f24bf60a03f8daf9077803f9f79613a260b72e8595360609af1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 远山"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "周末\n羅德島食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "總之，只要像這樣——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "牌就能很自然地從手中像水一樣落下——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "掉在手上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "學會了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "還沒有！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "遠山姐姐再表演一下嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "哼哼，那，看仔細了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "好——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "都看清楚了沒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "沒有——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "但是很遺憾，今天的牌藝課已經結束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "嗚——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "再玩一會好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那一會下一位在這裡上課的老師就要對我生氣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "大家也不想我被別的老師罵吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "就一會，就一會嘛，不會有事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "規矩可是很重要的，不能因為自己的欲望就隨意捨棄它哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那麼，給大家佈置一個作業吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "如果有人可以在下周上課的時候給大家表演一下自己的練習成果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那麼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "就能從老師的百寶箱裡抽一個獎勵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "百寶箱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "真的嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "真的哦，老師前兩天剛剛在百寶箱里加了點好玩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "只要能鼓起勇氣給大家表演，每個人都有份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "好啦下課，別忘了帶好自己的牌和玩具。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我們下周見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "再見老師！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "呼——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哎呀，真是辛苦您了呐，課程還順利嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "說是上課，其實也就是陪孩子們玩樂而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "倒是你身上的擔比較重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "要教孩子們算清楚加減乘除，也是件費腦又費力的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "其實也沒那麼麻煩，算久了就懂了嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "而且我教的也不算數學，嗯，當初取的什麼名來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "“經營興趣班”？好像是叫這個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哎呀其實和你一樣的啦，只管玩不管學。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那可是件好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "畢竟做生意可是很殘酷的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "你可真瞭解啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "雖然並非本意，但占卜本質上也是種生意啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "你說的是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那我就不打擾你佈置教室了，再會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "對了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "遠山老師，請稍等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "還有什麼事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "是這樣的，您看，博士最近好像要和嘉維爾他們一起出趟遠門，去薩爾貢的一個角落裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "嗯嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我呢，準備跟著一起去逛，看看能不能順帶做點買賣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "瞭解了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "所以啊，那個，能不能通——融一下，幫我算算？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你應該知道——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這個自然會有的，只是，嗯，那什麼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "錢都拿去進貨了，現在手上真的沒有餘額。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我不取錢財當報酬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "真的？太好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "但是我需要你一個承諾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你要向我承諾——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "上課的時候不可以給孩子們推銷東西。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "即使是零食，也不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "啊，哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哎呀怎麼會呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "就算上課是玩，但我也有好好教學的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "有，或沒有，都與我無關。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我只是需要你的承諾作為代價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "如果反悔的話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "誰知道呢？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成懊恼"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "意下如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你的代價，我收下了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "不用契約書......之類的東西嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我們的約定建立在彼此的信任上，不需要契約。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那麼，開始吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "考慮到一會還要上課，我們就用簡單點的占法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "（取出塔羅）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哇，這，這工藝？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "感覺每一張都能賣個好價錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這個把牌在桌上攤開以後轉啊轉的，是在洗牌嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "啊啊，請稍等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "直接像你課上那樣花洗也可以吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "有些占卜師的確會這樣行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "但那太傷牌了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "就像在暴風雪中執拗前行的旅人，無論身體如何健壯，衣物如何保暖，溫度終究會被一絲一絲抽掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "等到失溫的那刻，再行補救終究無濟於事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "啊哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "只是個薩米人比較常用的比喻，我想你能理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "是是，我懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "嗯，好了，它們應該能為你解開些迷惑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "把牌收攏好，切一下，然後從你切的位置放三張牌下來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "切記，先別翻開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那遠山你豈不是啥都沒做嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我只是為你解謎，自己的命運難道不應該由自己揭開嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "還是說，你樂意將命運交予他人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好吧我知道了，我自己來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "收攏好......切牌......把三張牌背面朝上放在自己面前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這樣就行吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "動作很乾脆，看來你並不迷茫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那當然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那麼，請吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "以自己的想法翻開卡片。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "總覺得你一本正經的，我也要有壓力了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "沒什麼好怕的，來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "翻開第一張。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（翻牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "金杯的騎士，逆位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我不太懂，正逆有什麼關係嘛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "簡單來說，逆位牌表明你現在受到了阻礙。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "放輕鬆，所謂阻礙，並不是一件全然的壞事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "只是現在無法成功繼續下去而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "突破阻礙，成功或許就在不遠處了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "是這樣啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "讓我仔細看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你是在經營上遇到問題了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "呃，算是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "基本上每個月都是這樣呢，有時候決策做錯了就沒錢賺，很頭疼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "可能看見過機會，但沒抓住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這種事對於做買賣的人來說天天都在發生啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "所以這次準備孤注一擲了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我相信直覺，去嘉維爾老家一定能賺筆大的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "原來如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "根據我的瞭解，羅德島採購業務方面其實一直缺人手，只要你肯幫他們幹些活，錢不成問題，風險也大多會由羅德島分擔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "為什麼要選擇獨立經營呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這個嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "習慣自己單幹啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "看來你的決策並非完全逐利呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "也沒你說的那麼大，就是見識下世面順便賺些錢補貼家用啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好東西總是要花錢的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那這個，這個牌，簡單來說，是不是就是不太好啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "是過程不會太輕鬆。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那我會不會就——遠山——救救我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "別急，這只是一個開端。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "來，翻開第二張。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗚嗚，好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（顫抖著翻牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "權杖一，正位。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "會，會是什麼呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你抓住了機會，準備從中再次獲得自己於生命中的優勢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "雖然很危險，但是你信心滿滿向生活發起了挑戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "聽上去像是好事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "以前我為自己占卜的時候也曾翻到過它。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "唉——你們也會為自己占卜的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "在某個靈光閃現的時刻，占卜師完全可以窺探一下自己的道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我還以為占卜師只會收錢給別人辦事呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "金錢終究解決不了所有問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "並且，有些道路，外人是無法干涉的，只有透過與自己的談話，去摸索，去探求，才有機會尋到端倪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "還挺複雜的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "就像可頌你選擇以自己的力量做買賣。所有決策，任何選擇，都是多年商業經驗的結晶，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "他人能給出的只是建議，決定權永遠在自己手中——就像現在這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "即使三張牌都是最壞的結果，你真就會改變決策嗎？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成懊恼"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "錢都花了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "所以你只是來求個安慰，希望我能說出一個聽上去舒服的結果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "啊不用回答我，很多人都是這樣的，我非常理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "大家在舉棋不定的時候，總會希望有什麼不實在的東西來解決一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "可惜，我並不是你們所期盼的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我所能做的，只是淺窺前路，並奉上力所能及的幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你支付了報酬，我就有義務竭盡全力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "僅此而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "遠山......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "讓我們繼續吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你會經歷冒險，但旅途似乎並不會平靜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "至於結果，我們可以期待最後一張牌所揭示的答案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "盡頭說不定連一張龍門幣都沒有。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "感覺越來越危險了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我只是說了一種較壞的可能性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "真的賺到缽滿盆滿也並不是沒可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "真是這樣就好啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那我到時候要去調香師那裡做一整套的香氛助眠療程。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "帳單就拜託你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "賺到錢我就幫你付款！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "哼哼，一言為定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那麼，讓我們來探索你這次旅途的終點吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "最後一張牌，請。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（唰地翻開塔羅牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "雙月，正位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "是正位啊，還好還好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "這可......不好說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你......有沒有瞭解過嘉維爾老家的情況？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我調查過薩爾貢市場，這些絕對好賣的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "如果是這樣，那最好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "（會不會有不是尋常薩爾貢市場的可能性呢......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "（正位雙月......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "旅途不會平靜，前面的牌也都預示了這一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "小心被蒙蔽、小心被欺騙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "我的意見是，如果可以，請謹慎行事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你喜歡月亮嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "喜歡也算不上吧，不過煩悶的時候在甲板上看看月亮，心情是會好些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那月影呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯，有人會特別去看影子嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "在月亮的光輝之下，經常有東西會被忽視。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "這張牌揭示的東西，也是如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "總有東西會被光輝遮蓋，會被刻意隱藏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "是福是禍，需要自己仔細斟酌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好，我會注意的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "這張牌所要展示的，應該就是這些了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "結合三張牌向你揭示的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "可頌，你的未來並不輕鬆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "至少跟著博士一起出發的這次旅行，阻礙很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你自己有這樣的感覺嗎？比如心裡隱約的不安和迷惑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "有一點吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "但，撐一撐應該能過去。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這個，牌裡有說我投資必失敗嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "沒有，再者塔羅也從不會出現言之鑿鑿的未來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那我應該還有救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "實在不行，敲個儲蓄罐應該還能撐幾天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "但願如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "占卜的話，到此就結束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "還有什麼需要我做的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "遠山，你也抽一張吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "你剛剛不是也說了嗎，占卜師自己也會占卜的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我想看看你運氣怎麼樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "但那是在我準備——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "來嘛來嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "塔羅可不是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哎呀別管了抽嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（“請”遠山抓了張牌。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "來嘛，翻開吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "等等，我準備一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "（翻開塔羅牌）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "聖杯十......逆位......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這個是不好的意思嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那我把它倒一下——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "等等別碰牌！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哦好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "對不起啊遠山。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "不對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "牌的正逆以翻牌者為準。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "所以這張牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "是正位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "對喔！你坐我對面！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那這個牌，是不是好的意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "對我的職業和人際關係來說，很不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那麼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "（抓住遠山的手蹭了幾下）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "讓我向你借一點好運吧，這樣我就能回本了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你要是這樣堅持的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "請隨意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗚嗚一定要讓我回本啊啊啊啊。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我突然想到一件事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "如果我借了你的運氣，那剛剛的占卜是不是全都不算數了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "誰知道呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "原來沒有這種規矩的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "需要再占卜一次的話，可要重新支付報酬哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "那還是算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我多蹭幾下，應該不收錢吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "哼哼~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "就算給你打個折，不收錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "謝謝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "五分鐘後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "可頌老師，我來啦！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "上課的小幹員",
      "text": "遠山老師也在啊，您好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哦噢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "你們好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "那麼，我先走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "祝你賺到的龍門幣能填滿整個羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "下次有東西要買記得找我啊，我給你打個大折扣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "時運可是千變萬化的，到時候再詳談吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "（揮揮手離開）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠山",
      "text": "（希望我的運勢真的能幫到你，可頌。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
