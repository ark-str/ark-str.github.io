          "text": "！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "avg_npc_394_1",
          "text": "博士，站在我身後。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerId": "avg_npc_394_1",
          "text": "你是誰？"
