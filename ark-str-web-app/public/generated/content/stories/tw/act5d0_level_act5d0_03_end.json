{
  "server": "tw",
  "storyId": "act5d0_level_act5d0_03_end",
  "groupId": "act5d0",
  "stageId": "act5d0_03",
  "title": "7:22P.M.",
  "storyCode": "CB-3",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act5d0/level_act5d0_03_end.txt",
