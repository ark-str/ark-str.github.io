    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "speakerId": null,
      "isRemote": false,
      "text": "馬上到。"
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "speakerId": "avg_391_rosmon_1",
      "isRemote": false,
      "text": "我在，博士。"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "speakerId": "avg_017_huang_1",
      "isRemote": false,
      "text": "好久沒一起幹架了！"
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "speakerId": null,
      "isRemote": false,
      "text": "“壞傢伙”號已返回本艦，馬上集合。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerId": null,
      "isRemote": false,
      "text": "稍等片刻。"
    },
    {
      "type": "dialogue",
      "speakerName": "Pith",
