    {
      "type": "dialogue",
      "speakerName": "冷靜的居民",
      "speakerId": "avg_npc_937_1",
      "isRemote": false,
      "text": "東西基本都燒沒了，不過還好，至少沒燒到下面的屋子。"
    },
    {
      "type": "dialogue",
      "speakerName": "驚慌的居民",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "還好？哪裡好了！"
    },
    {
      "type": "dialogue",
      "speakerName": "驚慌的居民",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "聖像都燒成這樣了，還有花圃......呃。"
    },
    {
      "type": "dialogue",
      "speakerName": "克萊芒",
      "speakerId": "avg_npc_924_1",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "謹慎的薩卡茲居民",
      "speakerId": "avg_npc_932_1",
      "isRemote": false,
      "text": "人沒事就是好事。"
