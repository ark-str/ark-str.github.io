  "stageId": "act11d0_06",
  "title": "怒意漫延",
  "storyCode": "TW-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/activities/act11d0/level_act11d0_06_end.txt",
