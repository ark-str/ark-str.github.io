    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "isRemote": false,
      "text": "知道就行。要是這炮能打死血魔大君，倒是會讓我......非常意外。"
    },
    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "isRemote": false,
      "text": "至於另一位......"
