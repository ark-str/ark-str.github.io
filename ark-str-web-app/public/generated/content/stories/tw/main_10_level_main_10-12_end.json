    {
      "type": "dialogue",
      "speakerName": "曼弗雷德",
      "speakerId": "avg_npc_404_1",
      "isRemote": false,
      "text": "我好奇很久了，假如他盡全力和大君打一架，贏的到底會是誰？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
