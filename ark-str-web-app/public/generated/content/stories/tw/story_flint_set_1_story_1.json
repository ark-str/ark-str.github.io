{
  "server": "tw",
  "storyId": "story_flint_set_1_story_1",
  "groupId": "story_flint_set_1",
  "stageId": null,
  "title": "合格的戰士",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_flint_1_1.txt",
  "sourceHash": "aab650e80edb834ee8a7031c90da8b408fcb4deea86874eef37450d3a66eccf3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "打啊！給他一拳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "呵！打他右臉！右臉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "沒錯，就是這樣！嘿，打這個外頭來的傻大個！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "好樣的！讓外頭來的瞧瞧咱們提亞卡烏戰士的厲害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "這、這打得這麼凶，是有什麼仇啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "啊？什麼仇？管他呢，打完就知道了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "就是說，不就打一架嘛，有什麼大不了的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "哎老兄，之前沒見過你，新來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "對，對，我就是個四處做點買賣的小商人，今天剛到這。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "聽說這片有不少部族，想著能做成生意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "哦！商人！就是那個啥......賣東西的是吧！好啊！咱們這可歡迎賣東西的了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "不過老兄你別急，有啥好東西，等先看完熱鬧再說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "可是，這......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "哎快看！打中了，打中了！漂亮啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "提亞卡烏戰士必勝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "你們就這麼待客？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哈，笑話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "是你挑釁在先，現在還說什麼待客？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "我說了，當時是真沒看見你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "載具門有點高，我以為你已經上車了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......回頭我會把門改裝成透明的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "廢話少說，動手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "今天我一定要和你比出個高下，我可是部族最高最強的戰士......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "上啊小個子！拿出你當時掀翻我們的氣勢來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "就是說啊小個子！跳起來用你那超級快的拳頭打他！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "不然你先收拾他們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......少囉嗦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "嘶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "你空手，我有武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "那又如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "你贏不了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "先說好，我是不會丟掉武器的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "隨你的便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "贏不贏得了，不是你說了算！先問問我的拳頭答不答應！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......野蠻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "出去這麼久，你除了通用語什麼都沒學會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "確實是這裡......這種地方......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......最適合你這種一根筋的傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "喂，這小子好像是在誇咱們啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "說的一點都沒錯！只有我們阿卡胡拉才能養出這麼小......但拳頭又這麼大的勇士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "啊？他誇咱們？那、那還打不打了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......咳咳，我不覺得這是誇獎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "一群野蠻人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......哼，隨你怎麼說。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "提亞卡烏戰士的語氣稍顯僵硬，目光掃過周圍的人群。\n她在某個人身上略微停頓了片刻。"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "今天的事我記下了，之後再找你算帳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "既然你們外頭來的這麼看不起我們提亞卡烏戰士，就早點離開阿卡胡拉的土地！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "求之不得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "要不是你們一群野蠻人扎堆的地方，連個修車工具都找不到......呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "（我們也不至於在這裡耽擱時間！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......我們也不至於在這裡耽擱時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "誰知道你們那些鐵皮玩意還會中途出故障？真靠不住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "喂，那邊那個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "別東張西望，就是喊你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "我，我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "對，就是你，你不是那個什麼商人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "啊，對，對，我是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "有能治傷的玩意嗎，給我來一點，要那種見效快的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你需要什麼，我和你交換。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "這個......商品是需要拿錢買的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "麻煩......之前來的商人明明都同意用東西交換了，怎麼這次就不行了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "不是被你們拿拳頭威脅的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你別插話！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "真不能交換？我還有不少好東西，要是能換我就帶你去我住的地方拿，那裡是我們阿卡胡拉最熱鬧的地方了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "如果這位客人確實能拿出好東西，這以物易物自然也是可以商量的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "還真行？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "這做生意嘛，當然要靈活些，哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "那我們現在就出發？這個阿卡......阿卡霍......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "阿卡胡拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "對對，阿卡胡拉，這阿卡胡拉最熱鬧的地方，我可要見識見識，說不定能多談成兩筆生意啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哈哈，肯定沒問題！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你跟我來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "怎麼回事，真就不打了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "他們這是往哪走呢？那方向平常也沒啥人去啊，要幹啥，打獵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮的阿達克利斯人",
      "text": "誰知道......哎沒打架可看了，走，咱們去看看那個紅頭髮的外頭人把“叢林七號”拼好了沒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "起哄的阿達克利斯人",
      "text": "快走快走，依娜姆這兩天不在，我要把之前送來的那個大玩意拆開好好看看！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "呼......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "還、還沒到嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "快了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你跟緊點，這裡野獸多，萬一走丟了，我可不保證你的安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "啊？不是說已經快要到最熱鬧的地方了嗎，怎麼還有野獸出沒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這有什麼稀奇的，我們提亞卡烏戰士，當然要住在野獸出沒的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "能獨自出入雨林，擊倒最兇猛的野獸，才是合格的戰士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "那還真是了不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "我瞧你剛才也是空手和那個菲林打架，這裡的戰士都是這樣的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "差不多。其他人有用長矛的，對付野獸的時候方便，但我不需要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "要我說，戰士有拳頭就夠了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "哈哈，你這麼厲害，確實用不上那些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "對了，我剛剛聽那個菲林話裡的意思，應該是他們的載具出故障了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "你是和他們一起從外頭回到這裡來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......這你都聽出來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "哎，這個，湊巧聽到而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "而且你剛剛通用語說得不錯，我猜應該是在薩爾貢外頭學的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "聽了就聽了，你緊張什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "前段時間，有幾個外頭的人跑來我們這，說是能帶我們出去賺大錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "哦哦！所以你就跟著去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "放屁！我看起來很無聊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "也就是因為他們中間有不少看起來很強的高手，我才會跟著他們走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "結果這些人成天派我保護一些就知道待在鐵皮盒子裡的窩囊廢，我才不幹！外頭人就是奇怪，明明又菜又膽小，還整天瞎指揮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "所以我也沒要什麼工錢，直接回來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "本來那幾個捎我一程的傻大個早該走了，就因為非要說那個大鐵皮盒子壞了，才磨蹭到現在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "誰知道他們那個大鐵皮破爛要怎麼修！還有那麼多奇形怪狀的金屬玩意，見都沒見過！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "我看你們這也不像是有修理器材的樣子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你說啥？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "咳咳，我是說，載具可不好修理，要費一番功夫了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "不知各位阿卡胡拉的戰士，有沒有考慮過弄些更方便的工具？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "比如說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "比如說，呃，那個菲林的載具，或者是能自動幫忙幹活的機器什麼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "不感興趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "要那些幹啥？我敢打賭，那些花裡胡哨的金屬玩意挨不了我一拳頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "這真是奇怪了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "什麼奇怪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "實不相瞞，我是在外頭聽說了阿卡胡拉這片地方的傳聞，才決定要到這來碰碰運氣，看看能不能做成什麼買賣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "可現在看來......倒是沒什麼機會了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哦？外頭都說了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "是不是提亞卡烏戰士的威名——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "啊，和這個無關。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "聽說這片雨林裡住的部族又大又繁華，還掌握了不少機械技術，最近還開始對外通商......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "今天一看，好像這消息不太準確。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "不過現在下結論還太早，呵呵，我們做商人的，就是得要有耐心，細心，回頭還是把這附近都轉轉才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "沒準真能找到傳言裡那樣的大部族呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......你這話是什麼意思，難道你懷疑我騙你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "這是哪裡的話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "——等等，別動！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "到我身後找個地方躲好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "快點，別磨蹭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "——有個大傢伙來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "行了，沒事了，出來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "你竟然真的能獨自一人打倒這麼一大群猛獸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這不算什麼，我不是說了？能擊倒最兇猛的野獸，才是合格的戰士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "就是這一群的量太多，要不然還能更輕鬆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......多謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "有什麼好謝的，本來就是我把你帶進雨林的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......你剛剛還說不保證我的安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "行了，趕緊處理處理你的傷口，等會，我找找藥，還有繃帶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "喏，都給你，算是剛剛護衛的報酬，就不收你錢了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哦，哦！可以嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "有什麼不行的，拿去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "哎，你們這確實，和外頭說的不太一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "那些小道消息，現在看來都是些不實的傳言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "慢著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "誰說都是不實傳言了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "什麼？難道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我們的部族又大又繁華這點千真萬確！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "部族裡外出狩獵的隊伍，最多的時候能有四五十人呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "小心！你怎麼忽然站都站不穩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "沒、沒事，就是走了太久，有點腿軟......我們還沒到嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "別急，就在前頭不遠，很快就到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "保證讓你看個夠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "你回來了，怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商",
      "text": "......沒什麼收穫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "你臉怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "別提了，哎，遇上個腦子裡長肌肉的野蠻人，非說要進村子，就得先和他們的勇士較量，直接把我給打了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "那邊村子又小又破，人也不多，就連修載具的工具都沒見過，白跑一趟！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "你那裡發現什麼沒有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "沒有。我往另一邊走了一段，有個紅髮的沃爾珀在修他的載具，還非要說等修好了載我兜風。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "我跟著轉了一圈，也就幾間破房子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "不過那人似乎有意不讓我太過深入，或許有什麼古怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "......我認為是外面傳言不實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "這麼肯定？我說，你沒忘記帕夏吩咐我們過來的目的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "當然沒忘。但現在結果顯而易見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "至少目前看起來，這裡根本沒有什麼發展中的勢力可言，也沒什麼油水可撈，那個被安排在這的信使沒騙我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "但那些風言風語......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "我還是覺得哪裡有點不對勁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "你也說了，是風言風語。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "這裡的信使......資料上說是叫依娜姆吧，她本來就喜歡搞些買賣，被傳得誇張些也還算正常。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "況且......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "若是這裡沒能達到那些等著接管領地的王酋大人的期待，我們卻上報了，你我都不會有好下場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "......也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的女性",
      "text": "你說的對，料那些只想著比誰拳頭大的野蠻人，也不至於能騙過你我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "被捲入的行商？",
      "text": "走吧，儘快趕回都城，給帕夏一個交代。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "都解決了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你那邊呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "那些自動機械和車床都集中拉到附近的岩洞裡藏好了，沒被人看到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "部落裡的其他人也都又叮囑了一遍，在外來人面前絕對不能提起機械的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "辛苦你了。現在我們只需要等著依娜姆她們回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "那傢伙就留了封信，自己跑得沒影，嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "對了，你臉上的傷......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "對不起，下回在訓練場讓你揍回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "不用，別在意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "比起我，賈維更擅長演這種戲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "沒辦法，對方不止一個人，我拜託賈維去拖住另一個了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "其實我們也可以選擇不打這一場，不過......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "不過？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "咳，不過我一時手癢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "下回在訓練場讓我揍回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哈哈，開玩笑的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這麼一來，那邊的人才更容易相信我們這些野蠻人腦子裡只有拳頭吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我帶那傢伙去了早就棄之不用，只有外出的戰士偶爾歇腳的舊村落，他竟然也沒怎麼懷疑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "不一定完全沒懷疑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "只要他不能確定就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "只要讓對方摸不透底，拿不準主意，他們就暫時不會向上彙報......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "——博士是這麼說的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "確實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "他們也是嘍囉，會避開有風險的選項。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "說得沒錯！況且還有小爺我出手，肯定沒問題！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "哎呀累死我了，自己把載具拆了再修太累人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "抱歉，當時只想到這個藉口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "如果需要賠償的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "犯不著，小事一樁！這事我們以前騙......做買賣的時候常幹，不信你問布洛卡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "等會，哈哈哈哈哈布洛卡你的臉哈哈哈哈哈笑死小爺了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......閉嘴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "哈哈哈哈哈哈哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "咳。好了，說正經的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這回把人打發回去，應該就能撐一段時間，現在依娜姆還有祖瑪瑪、嘉維爾她們都不在，也只能暫時先這樣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "那些傢伙不會就這麼算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我猜也是。要是他們有這麼好解決，依娜姆就不會特地讓我過來守著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "嗯......我會讓我們部族的人盯好雨林外圍，如果還有人來，再想辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "嘖嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......怎麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "沒想到啊，這裡的頭頭，那個叫依娜姆的，還挺信任你的嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "我看你整天跟在煌後頭，和這邊出身的那幾個人都不太親近，還以為你這次不會和她們一樣收到信就急衝衝跑回來呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我確實和部族裡聯絡不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "恰好前段時間去了趟哥倫比亞，依娜姆聯繫我，讓我帶一批報廢車床回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這次的事......也不知道她為什麼會相信我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "那些都是你帶回來的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "挑得不錯，修好還能用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "還能為什麼，估計看你長進了。這是好事啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "這次跟著你們一起來，還想著關鍵時刻能幫忙出出主意，結果現在看來，根本不需要小爺出手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "原本看你經常和布洛卡幹架，還以為你會是那種直接衝上去，把人都揍翻的傢伙呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "也不是完全沒揍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "沒什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "阿卡胡拉變了太多，部族裡那些奇形怪狀的......機械，真不知道他們是怎麼想得出做得出的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我原本以為祖瑪瑪做的那些玩意就已經很怪了，但那些東西好歹形狀還算正常。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "我倒是覺得挺有意思的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "實用就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "那倒也是，至少有了這些機械，日子變得好過多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "這麼好說話？現在你們可是生產種植打獵全方位開始用這些機械了，你那套提亞卡烏戰士拳頭論，估計也撐不了多久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "說真的，你完全不在乎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "喂，賈維！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "哎，我就好奇隨便問問！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "從我拋下族人離開這裡開始，我就沒有再干涉部族發展的權力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "如果這是提亞卡烏人自己做出的選擇，那就一定沒問題，我搞不明白這些機械，但我信這的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "有理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "而且我自己在羅德島這段時間，也不是完全沒有反思過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......要是萬事都能簡單地把敵人揍翻了事，我就沒那麼煩心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "之前有一次......呃，我作為護衛，陪同博士和一家公司商談，對面派人要給我們下馬威。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "常有的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我一不小心，就把人全打了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "......常有的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "啊......這種事有時候處理起來是挺麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "博士怎麼沒攔著你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "攔了。我趁著博士睡著，出門打的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "嚯。等會，我好像聽說過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "是不是就是你說，想讓博士能多休息一會，結果愣是守著門，把一早過來找碴的人全打了那回？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "別提了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "那次差點就沒談成，最後還是靠博士補救，反而害博士休息得更少了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......總之，那次給大家都添了不少麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "還好是博士在，博士沒怪你吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "那倒沒有。回羅德島之後博士還和我說，其實拳頭大就有道理這話沒說錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "哈？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "但那得真的足夠大才行......至少我們現在還沒這個本事，所以遇事就得想想其他辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "布洛卡",
      "text": "有道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "有、有道理......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "等等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你們有沒有，聽到什麼聲音？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "呼，終於上來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "別感慨了，我們得快做準備。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "嗯？這裡怎麼堆著這麼多機械？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "哎呀，克瑪爾，真高興能見到你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "看你的表情，嗯，至少不像是有壞事的樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......確實不算是壞事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "那就好，看來你已經把那些人都打發走了？我就覺得交給你一定沒問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "之後還有不少事要請你幫忙，不過目前......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "先麻煩各位幫我們一起收拾一片村莊出來吧，我們阿卡胡拉，很快就有一大群來自地底的客人光臨了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
