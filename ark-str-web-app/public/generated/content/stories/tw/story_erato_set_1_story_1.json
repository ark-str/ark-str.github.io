{
  "server": "tw",
  "storyId": "story_erato_set_1_story_1",
  "groupId": "story_erato_set_1",
  "stageId": null,
  "title": "英雄們的敘事詩",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_erato_1_1.txt",
  "sourceHash": "0679b62d66178846eddbda00e78606d6114b63215af8919cb2f406cde1c8bf6e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "咕咚，咕咚——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "哈，美酒的芬芳，真令人陶醉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "開門，埃拉托小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托——你把自己關在裡面也想不出來的，我建議你放棄。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "酗酒祭司，你太吵了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "我是關心你，埃拉托小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "昨夜我徜徉美酒之時，偶然聽到幹員們的交談，聽聞你將自己關在宿舍裡兩天兩夜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "身為祭司，我自然牽掛著你的情況。你看，清晨的日光才剛剛鋪滿窗沿，我就前來探望你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "探望我......你手上拎著的是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "佳釀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "米諾斯的群山啊，可否賜予我不被酒品奇差之人騷擾的恩澤？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "你尚有諷刺的力氣，新詩篇的創作一定很順利吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......你怎麼知道我正在創作一部新的詩篇？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "來到羅德島之後，你已經遊手好閒夠久了......準備寫點什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "一部長篇詩歌，講述幾位所長不同、性格各異的英雄，合力帶領備受壓迫的人們戰勝困難，共同前往希望之地......大概是這樣的故事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "然而在開始動筆時，我還是遇上阻礙了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "一字未動？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "胡說，我......至少寫上了標題！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "在故事前期，我設想了三位英雄，分別是善戰的勇士、天才的工匠和仁愛的醫生......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "可由於擱筆太久，我對角色的理解已經生疏了，構思的故事缺乏真實感，角色形象難以建立......我需要更多的靈感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "不如就像我們在故鄉那樣，一邊痛飲美酒，一邊暢敘諸山之間的英雄傳說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "酣醉之時，靈感便如樹上熟透的果實一般任你採摘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "請不要為你帶酒上門找理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "翻閱典籍，或是外出進行采風米諾斯的詩人們善用這些方法，你應當比我更清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "當然，我這不就準備出發去尋找英雄事蹟了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "說起英雄事蹟，除我們的故鄉外，維多利亞與卡西米爾應該是合適的采風地，或許還有其他的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不會跑這麼遠，我已經想好要去哪些地方了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "閒聊還是下次吧，我得抓緊時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "請留步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "還有事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐如何創作詩篇，我一直對此非常感興趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "這是一次難逢的機會，若我想與你同行，你應該不會拒絕吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "跟上我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "這裡就是我計劃的第一站。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "出乎意料，埃拉托小姐，原來你就沒有計劃離開羅德島？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "當然啦，在本艦上就足夠我尋找靈感了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "說起善戰的勇士，那必定是在訓練室最容易遇上了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是我們來太早了嗎？似乎沒有人在......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哈，這拳如何？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "有人在說話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我也聽到了——你好？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嘗嘗這拳！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "啊，是燧石小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你是帕拉斯，還有你，你是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你個子不高，也很少來訓練場打架，我不記得你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我叫埃拉托，大部分時間都在出外勤任務，我們確實只有幾面之緣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "好，你們好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "對了，埃拉托，要來打架嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "欸！怎麼突然——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你不想打架，那算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "抱歉，我不擅長近身格鬥，射箭的話倒是可以比試一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "沒關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "（轉向沙袋）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哈！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "等待一下吧，這個時間，再過一陣子就會有其他幹員前來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "雖然過去就聽過燧石小姐很厲害，但戰鬥姿態的燧石小姐我還是第一次見到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "這矯健的身姿，凌厲的拳風......啊，這不就是我在尋找的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "燧石小姐，不，能征善戰的勇士啊！你的經歷一定非同凡響，我想要瞭解你的英雄事蹟，能與我分享一二嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "英雄？我沒見過什麼英雄，你說的我聽不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你要這些什麼......事蹟有用嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我正在尋找能給予我靈感的英雄事蹟，為了幫助我創作出一部偉大的詩篇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哦，明白了，你是想要靈感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "那你過來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "過來，站這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這是沙袋，揍它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "啊......這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "力氣太小了，用點勁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "這樣？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "還不夠，再用力。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "哈！疼疼疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "對，就是這樣，你感覺到什麼了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "還有呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "沒了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "不可能，你沒有感受到靈感嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "完全沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "真奇怪，我打拳的時候就會有很多靈感，比如說會突然想到，下一次可以佯攻面門而直擊下盤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "任何麻煩應該都能用拳頭來解決，我想想，應該是你打得太少了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "來，再多打幾拳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "先停一停......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "燧石，燧石，你在裡面嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我在這裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "啊，埃拉托，帕拉斯，兩位也在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "燧石，這是上一次外勤任務的賠償清單，你好好看看。為了處理你出外勤留下的麻煩，後勤部又多了一大筆支出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "特別是這一項，你在任務報告中寫的是：“因為那個高個子的傢伙眼神兇惡地俯視我，我就把他打倒了。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "你何止是把他打倒了，他可是痛得滿地打滾，足足撞爛了兩扇門！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "不可能，我明明收了力的。你看，我就是這麼打了兩下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "總之，以後出外勤任務，千萬要注意不要破壞公物，要是再有下次——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "沙袋......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "被一拳打爆了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "對不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "唉，算了。燧石，這個給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "這是什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "上次外勤任務中，你救下的那個女孩寄給你的感謝信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哦，好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "（把信塞進拳套裡）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我去換個新沙袋。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我們走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "果然，埃拉托小姐，我的選擇沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "與你同行實在盡興，甚至勝過在艦橋上自斟自飲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是你們祭司都這樣說話，還是只有你這麼無聊，“勝利女神”小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "你知道，我是獨一無二的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "下個地方到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "羅德島上有不少厲害的工程師，在這裡一定能找到——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "嘿！帕拉斯，埃拉托，兩位，早上好啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "你好，賈維，這裡只有你在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "剛剛奧斯塔還在呢？欸，他去哪裡了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "奧斯塔，你在哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "等等，不用麻煩叫他出來啦，我就問你好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我記得你......應該還挺擅長機械設計吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "那當然了，小爺我的改裝技術可是一等一的，稱之為天才也不為過！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "太好了，我有個問題想問你，你有沒有覺得自己有過什麼英雄事蹟......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "喏，幫我拿著這個。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "這是......液壓鉗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "你不是問我的改裝技術嗎？我學修車的時候師傅曾經說過，嘴上吹得再好聽，都不如親手做一遍來得實在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不是，我是想詢問英雄......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "拿好了，我這就給你演示一下。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "演示什麼......\n啊啊啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "它怎麼、怎麼飛起來了？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "怎麼樣？這就是我的最新作品，自懸浮液壓鉗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "小爺我在這裡工作，經常要對付一些大型設備，每次都要帶著工具爬梯子實在是太麻煩了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "現在，只要抓住經過我改裝的這套工具，身體就能跟著飄起來！去再高的地方都不用搬梯子了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "抓穩了！它還能飄得更高！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "欸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "它、它在震動，這正常嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "震動......我記得我沒裝轉子電機啊？等等，我到底裝了沒有......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "它開始亂晃了！我抓不住了，要放手了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "小心！液壓鉗朝你飛過去了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "什麼——\n哎喲！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "痛，痛，我的腦袋......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "為什麼會出現這種故障呢？奇怪，是不是噴氣引擎功率太大了？算了，等一下再說吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "你剛剛是不是問我，我有沒有什麼英雄事蹟？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "小爺我必須自豪地告訴你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "這個回答倒是意外。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "這是因為，我的心血全部獻給了我改裝的這些機械設備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "它們才是真正的英雄，代替我成就了許多前無古人的壯舉！我的改裝才是應該被所有人銘記的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "至於我......我發明了它們，那我就應該算是......嗯......“英雄創造者”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "嘖，這個稱號還不賴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧斯塔",
      "text": "“英雄創造者”？嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "奧斯塔！你那聲“嘁”是什麼意思？你不認可我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧斯塔",
      "text": "你的英雄們是指會唱歌的電鑽，還是會跳舞的扳手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧斯塔",
      "text": "哦，現在又多了一個會飛行的液壓鉗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "不，奧斯塔，你怎麼能這麼貶低你的頭兒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧斯塔",
      "text": "根據我的統計，你上一次收到改裝的需求，還是......三個月前？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "你好好回憶一下，我一定還有做得很好的改裝吧！一定有吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧斯塔",
      "text": "承認吧，賈維，你已經沒救了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "欸，桌子上的這個頭盔......我似乎在前不久的一次外勤任務中見過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "當時那位重裝幹員非常氣憤地說：“我只是想修一下護目鏡，那傢伙竟然給我加了一大堆亂七八糟的功能！”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "然而在任務中，小隊遭遇意料之外的源石污染。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "在未攜帶專業源石探測裝備的情況下，頭盔的源石探測功能起了作用，幫助小隊渡過了危機。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "奧斯塔，你聽見了嗎？我還是有能幫上忙的地方！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧斯塔",
      "text": "嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧斯塔",
      "text": "那這個頭盔為什麼被送了回來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我記得，在任務的後半程頭盔漏電了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "不論如何，我是不會放棄發揮我的創意的，我的天賦絕不能被掩埋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "總有一天，小爺我也配得上堂堂正正的英雄之名，而不是什麼，“英雄創造者”之類的。奧斯塔，你就等著瞧好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "哦，差點忘了你們還在了。抱歉啊，埃拉托，沒給你你要的英雄事蹟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "沒關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "但是我想到了，你們想要詢問英雄事蹟的話，我有一個人選。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是哪位？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "那就是小爺我的摯友，Lancet-2！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "她最近格外消極啊，明明工作非常努力的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "不過她是不是一直都很消極......如果你們可以向她瞭解一些她的英雄事蹟，說不定她就能開心一點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "好，我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賈維",
      "text": "有空常來玩啊，有想要改裝的玩意也儘管找我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐，你真的打算聽賈維的建議嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "當然啦，在我的計劃裡，要去的最後一個地方恰好也是醫療室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "這趟“旅程”至今，原諒我用了傳統的“旅程”一詞，你覺得會對你的創作有所幫助嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "在過去我收集了許多傳說與故事，為了將它們完好地保存下來，我會努力把自己當作一個忠實的記錄者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不在記錄中摻雜主觀的情緒與思考，讓故事能保持它原本的樣貌，這是我的訣竅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "當旅途告一段落時，那些我所見證的，所聽聞的，所記錄的，最終會在幾個夜晚沉澱下來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "而後，在筆下流淌為詩歌，以我之口向眾生訴說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "這趟“旅程”還未結束，所以我不知道最後會有怎樣的結果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "記錄、創作與傳頌，你讓自己肩負了遠超一名吟遊詩人的責任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我想我熱衷於此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "這是你的自由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......我有一種預感，這次的所見所聞會給我的創作帶來些許不同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "先前我只是好奇你的創作過程，現在你會寫出怎樣的詩篇，我也很有興趣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "該怎麼辦，該怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "Lancet-2，你好......你在幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "兩位好，根據我的運動模組顯示的狀態，我在轉圈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我看得出來，可是，你為什麼要轉圈呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "博士，因為博士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "博士他出什麼狀況了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "不對，是因為我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "是因為無能的、沒有作用的、什麼都做不好的我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "等等，我們好好說清楚可以嗎？究竟是發生了什麼事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "帕拉斯，你說我這樣拍兩下，Lancet-2能正常說話嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "可以試試。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "語言模組自檢中——自檢完畢，恢復運行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "原因是，博士他最近實在太忙了，每天都要處理好多文件，直到凌晨才能上床休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "這樣下去，下一次博士的體檢結果一定會出現異常指標的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "都是我不好，沒有照顧好博士，都怪我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "停停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "Lancet-2，博士有他的職責，他的工作對我們所有人都非常重要，偶爾有忙碌的時候也是正常狀況哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "你不應該把這樣的情況怪罪在自己的頭上，你也在很努力地工作啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "真的嗎？埃拉托幹員，你真的是這麼認為的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "當然啦，我這次前來就是想找你幫忙的。請問你有什麼可以分享給我的英雄事蹟嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "英雄事蹟......在看護的時候我有聽見幹員們的閒聊，在我的儲存模組中應該保存有一些事件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不不不，不需要那些。我想要瞭解的是，你覺得自己做得好的，像英雄一樣的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "Lancet-2的工作那麼出色，這樣的事情一定不少吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "我的英雄事蹟......不，我應該沒有足以稱之為英雄事蹟的行為，我連英雄都稱不上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "在我的崗位上，能把所有幹員都照顧得很好，讓大家都保持健康，才能被稱為英雄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "而我沒有這樣的事蹟，我照顧不好博士......我是不是根本就不稱職......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "她真的很消極。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "好啦好啦，Lancet-2，要不這樣，請你也照看我一下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "照顧埃拉托幹員嗎？這的確在我的工作範圍內，但是......你讓我這麼做有什麼理由嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "這樣我就會告訴你，你做得到底好不好，或許Lancet-2就能體會到自己也是很有用的呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "明白了，我馬上對埃拉托幹員進行全身生理檢測，請稍等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "好哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "檢測——完成。檢測結果顯示，埃拉托幹員有27小時13分鐘27秒沒有進入過睡眠狀態，身體嚴重缺乏休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "......埃拉托幹員在數小時前攝入了大量糖分，以及脂肪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐，你上次可是口口聲聲說要減肥的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......這是為了構思，為了構思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "怎麼會這樣？我竟然沒有及時發現埃拉托幹員的異常......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "你一進來我就該發現的，可是我忙於處理自己的情緒模組，沒有照看好你......我太不稱職了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "沒有，這不是你的問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "果然，我什麼作用都起不了，我就該自己駛向報廢區域的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "埃拉托，帕拉斯，你們好。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "埃拉托，帕拉斯，你們也在這裡啊。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托&帕拉斯",
          "text": "博士好。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Lancet-2，我來體檢了......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你看起來狀態不太好，有什麼心事嗎？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "博士......對不起，我沒有照顧好你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "多虧Lancet-2的幫助，我的體檢結果一直正常。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "欸，竟然是這樣的嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "短暫的時間內，你完成了體檢的全部內容。"
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "體檢結果出來了，各項數據指標——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "一切正常。太好了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我都說了，不用擔心。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "完全沒有擔心的必要。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "（減少了博士的咖啡配給，果然還是有用的。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "Lancet-2的工作真的很出色啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "埃拉托，你還好嗎？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "啊，抱歉，我剛剛只是在思考......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "博士，我有點事，先離開了！再見！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "好，再見。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "一周後"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "賈維",
          "text": "原來不止小爺我，大家都收到邀請了啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "燧石",
          "text": "“詩篇吟誦會”邀請，我不懂，什麼是詩篇？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "是一種用凝練語言敘述事件或表達情緒的文學體裁，聽眾能從詩篇的吟誦中收穫精神的力量。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "這次是埃拉托最新作品的第一次公開朗誦，預計會對幹員們的心理健康帶來積極的影響。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "埃拉托的新詩篇嗎......我還挺期待的。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "咳、咳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "（雖說給大家都發了邀請，可沒想到竟然來了這麼多人......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "感謝大家參加我的新詩篇吟誦會，願大家在此度過一段愜意的時光。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "好了，話不多說，下面我將為大家吟誦的是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "（深呼吸）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "（啊，好緊張，上一次在這麼多人面前吟誦新詩，還是好多年前在科林尼亞的城市廣場......）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "賈維",
          "text": "埃拉托！埃拉托！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "咳咳，下面，我將為大家吟誦的是，我最新創作的詩篇——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "《英雄們的敘事詩》。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "......"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "伴隨著豎琴聲與埃拉托輕緩的吟誦，三位英雄的故事被娓娓道來。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "黎明掀開她的面紗，太陽的光輝灑向大地，拂過灰塵遮蔽的臉龐。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "遠方飄來芬芳，人們拾起行囊，將繼續踏上道路。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "謝謝大家，謝謝。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "詩篇吟誦會告一段落，大家戀戀不捨地離去。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "喂，帕拉斯，之前我就把詩篇讀給你聽了，過去了兩三天，你還沒有什麼想法嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "如果我沒聽錯，這只是詩篇的第一節。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "沒錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "我必須承認，詩篇很有你的風格，但在你的詩篇完成之前，我決定不予評價。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "能讓喋喋不休的帕拉斯把評價吞進肚子裡，應該還不錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "比起和你拌嘴，我更想知道你打算如何完成詩篇後續的創作。上一次收集到的素材應該不足以支撐後續寫作吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "是的，所以現在我的確沒有更多的靈感，只有一個我一直都很喜歡的構想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "我要創作一個以我自己為原型的角色，在故事中與英雄們一起，同行至鮮花盛開的理想之地。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "米諾斯人都曾夢想過與英雄同行，我理解。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "不......和過去不一樣，你應該記得我和你說過，這一次的創作會有所不同。可我創作的詩篇和過去相比並沒有改變。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "在寫作時我一直思索這個預感從何而來，直到放下筆的刹那，我忽然明白，那份不同或許早已發生在我的身旁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "過去的旅途中，我將自己寫進故事，成為故事中的角色，期待著凝結心血的創作能引導與鼓舞人們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "但身處此地，第一次認真地觀察過羅德島上的大家後，我發現......我的詩意產生了前所未有的共鳴......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "我想我已經置身於英雄之間，正與英雄們同行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "我應當將其記敘。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
