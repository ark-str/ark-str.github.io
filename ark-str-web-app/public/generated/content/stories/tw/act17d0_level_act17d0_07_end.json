{"server":"tw","storyId":"act17d0_level_act17d0_07_end","groupId":"act17d0","stageId":"act17d0_07","title":"地堡防線","storyCode":"OD-7","avgTag":"行動後","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/activities/act17d0/level_act17d0_07_end.txt","sourceHash":"c9c4794b3445436d30e9178eb31c0a77543295b1ad8afebb19522040832688a4","bodyAvailable":true,"blocks":[{"type":"background","backgroundId":"bg_nobleD"},{"type":"dialogue","speakerName":"皮加爾","speakerId":"avg_npc_159_1","isRemote":false,"text":"滾開！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"皮加爾","speakerId":"avg_npc_159_1","isRemote":false,"text":"真是沒完沒了。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"他們到底造了多少這種鬼東西！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"雷蛇！小心身後！"},{"type":"dialogue","speakerName":"源石畸變體","speakerId":null,"isRemote":false,"text":"噶......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"！！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"avg_npc_155_1","isRemote":false,"text":"小心！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"芙蘭卡！"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"你在搞什麼！"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"領主小姐，幫我搭把手！"},{"type":"dialogue","speakerName":"皮加爾","speakerId":"avg_npc_159_1","isRemote":false,"text":"好，好的!"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"avg_npc_155_1","isRemote":false,"text":"你......快跑。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"你不要說話了！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"avg_npc_155_1","isRemote":false,"text":"我的腿......你......你，別管我了。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"不要說蠢話！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"我背你，快上來。"},{"type":"dialogue","speakerName":"皮加爾","speakerId":"avg_npc_159_1","isRemote":false,"text":"它們又衝上來了！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"趁現在，快跑！"},{"type":"dialogue","speakerName":"奧克芬","speakerId":"avg_npc_012","isRemote":false,"text":"到這來！"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"奧克芬先生！你怎麼上來了！"},{"type":"dialogue","speakerName":"奧克芬","speakerId":"avg_npc_012","isRemote":false,"text":"我實在是做不到待在下面乾等著，我可也是羅德島幹員啊！"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"avg_npc_156_1","isRemote":false,"text":"太好了！幫大忙了！"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"準備引爆爆炸物......"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"三、二、一......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"怎麼樣了？"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"只是短暫被擊退，用不了多久它們還會再來的。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"它們......好像變少了一點？"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"“迎賓踏墊”已經用完了，我也沒有子彈了。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"亞歷山大，接下來怎麼辦？"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"去避難所。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"什麼？"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"去避難所！帶著羅德島的幹員，去避難所！"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"那你呢？"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"我掩護你們。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"掩護？那誰掩護你？"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"我不需要掩護。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"冷靜點，亞歷山大！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"我很冷靜。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"我已經受夠了不停地躲藏和撤退了。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"撤退無法帶來戰爭的勝利，歷史無數次證明了這件事。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"但我們不是在打仗。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"對我來說，這就是在打仗。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"當他們向感染者掏出武器，想要加害我所熟識之人時，這就是一場戰爭。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"我這輩子經歷的戰爭太多了。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"只要我在這裡多幹掉一隻該死的怪物，那些鎮民存活下來的機率就會上升。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"我就會守在這裡，直到彈盡糧絕，直到天昏地暗。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"戰爭沒有結束，我為什麼要撤退？"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"你自己說過不要逞英雄的！"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"但是我不覺得這是“逞英雄”，蒂娜。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"我只是在做對的事情。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"無論如何，這一切都得在今天結束。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"亞歷山大！"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"我會留下來的。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"老先生，怎麼你也......"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"事情總歸會變成這樣，從你們決定留下來幫忙的時候，其實大家都預料到了。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"我會留下來，和這位戰士協助防守，如果情況太糟，我可以掩護他撤離。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"老先生......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"亞歷山大，給你。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"這是什麼？"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"我自己試做的源石爆炸物，只剩下這兩個了。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"......謝謝。"},{"type":"dialogue","speakerName":"FROST","speakerId":"char_458_rfrost","isRemote":false,"text":"活著！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"......我不敢保證。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"你沒和她說實話，你也沒打算撤。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"哈哈哈......你就不要戳穿我這個老頭子的小算盤了。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"你需要有人幫你頂住那些怪物。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"這是......"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"據說是老領主的佩刀，我借來用了。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"這把刀很好，老領主的品味很不錯。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"漂亮的花紋鋼，手工鑲嵌的松綠石刀柄，不比那些現代工業生產的武器差多少。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"比起衝在最前線，拿著弓箭在後方要安全得多。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"我老了，動作遲鈍了許多。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"但是這把刀，依舊是鋒利的。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"我還一直都不知道你的名字，戰士。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"亞歷山大·謝納維耶夫。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"叫我亞歷山大就行了。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"我也應該告訴你我的名字。"},{"type":"dialogue","speakerName":"巡林者","speakerId":"char_503_rang","isRemote":false,"text":"但是從鮮血塗抹山谷的那天起，我的名字也隨著過去的一切掩蓋在黃沙之下了。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"沒關係。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"你決定留下戰鬥，這很重要。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"“巡林者”。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"“當時他們都說我要死了，但是他們錯了，我重生了。”"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"無論那些怪物有多少隻。"},{"type":"dialogue","speakerName":"TACHANKA","speakerId":"char_459_tachak","isRemote":false,"text":"讓它們放馬過來。"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_458_rfrost","aliases":["FROST"]},{"speakerId":"char_459_tachak","aliases":["TACHANKA"]},{"speakerId":"char_503_rang","aliases":["巡林者"]}]}
