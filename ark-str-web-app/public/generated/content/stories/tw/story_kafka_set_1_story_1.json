    {
      "type": "dialogue",
      "speakerName": "卡夫卡",
      "speakerId": "avg_214_kafka_1",
      "text": "“小偷就是卡夫卡”，早點結束這件糟心事對他們來說，才更重要。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡夫卡",
      "speakerId": "avg_214_kafka_1",
      "text": "沒人會認真聽一個毫無背景的小園藝師說話。"
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "speakerId": "avg_108_silent_1",
      "text": "我還在聽，卡夫卡。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡夫卡",
      "speakerId": "avg_214_kafka_1",
      "text": "可是卡夫卡故意欺騙了赫默哦？"
