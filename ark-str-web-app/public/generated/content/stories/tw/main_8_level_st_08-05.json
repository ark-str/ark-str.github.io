{
  "server": "tw",
  "storyId": "main_8_level_st_08-05",
  "groupId": "main_8",
  "stageId": "st_08-05",
  "title": "厄運，等候已久",
  "storyCode": "M8-5",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_st_08-05.txt",
  "sourceHash": "8d36dba29153f06f082e6e0e2416e6bdbb0ca09850c7000d132b1e8fc3796a03",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "现在线5"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "通訊接通了！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "是隊長嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "是我，是我！你們現在怎麼樣了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "我們其他人還好，雖然現在被困在地下這個建築裡了，但我們找到了通道用門。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "過段時間我們找到其他出口就來和你們會合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "我們已經切斷了重啟功能。你們要過來也可以放心，整個區域都能用來防守了，可以不用擔心會被人打個措手不及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "碧銀姐，碧銀姐她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "呃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "......不，不，迷迭香！等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "繼續任務......不准來找我們！我們出來之前，你簽過保證書的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "可是......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "既然答應了，就不能反悔！否則我們是不會支持你，也不會跟著你來到切城的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "還記得我們加入你小隊的時候，我們商量了什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "聽著，隊長，聽我說......我們說過，每個精英幹員和他們的小隊都不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "你能做的事情很多，你的法術很強，我們實際上支援不了你什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "但是，你沒法忍受的那些東西，我們是會和你共同承擔的，和阿米婭一樣，和其他精英幹員一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "但你們都是我的隊員！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "別急！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "碧銀姐她最後說了，我們答應過你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "要讓你成長成一個戰士，不是士兵，也不是武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "隊長，做你該做的。我們會安全出來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "聽好，隊長，這可能很難。但碧銀姐就是這麼說了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "“你不只是精英幹員，你是迷迭香。不光隊員們，羅德島以及感染者，這裡討厭失去和破壞的人......都會愛你。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "所以，隊長，“想想看，「迷迭香」會做什麼”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "我們掛斷了。替我們向阿米婭問好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "別離開我。要記得回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香小隊成員",
      "text": "一定記得。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "......通訊結束。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "狀況怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅德島幹員",
      "text": "啊，阿米婭。工程小組一人犧牲，其他人暫且還安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "迷迭香......我們的正面火力有點不足。遊擊隊的迫擊炮小隊需要補給。我們要打個時間差。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......你還好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "......阿米婭，Ace死了以後，你在想什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "不想回答也行。我只是很想知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "抱歉，我不想想起太多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "阿米婭也會想要逃避嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不是，只是還沒到重新面對的時候。眼淚要留到一切都結束之後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我只記得最後，我覺得......我想起來——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不能讓他和羅德島的幹員們白白死去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "偵查幹員，告訴我方位，我去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "整合運動已經陷入了一片混亂，要小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷迭香",
      "text": "因為我們是他們的敵人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "因為什麼都是他們的敵人。有的人在缺少敵人的時候，就會為自己創造敵人......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "text": "擔心什麼？先鋒小組，突擊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "狙擊小組，後撤！",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "狙擊幹員",
              "text": "明白！重整隊形，補充彈藥！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "重裝幹員們，為他們提供掩護！",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "重裝幹員",
              "text": "是！頂住！不要讓通道被截斷！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "術師，停火！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "術師幹員",
              "text": "施術停止！小心，別波及友軍！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "牧群化薩卡茲戰士",
          "text": "不要再向前走！令人恐慌。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "牧群化薩卡茲戰士",
          "text": "不要打人，痛苦！到處是痛苦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "真是令人不快的感染傾向。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他們已經不是人了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "比起龍門的變異感染者更令人不安。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "你如果問我擔心不擔心迷迭香，阿米婭，以及他們帶領的小隊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我只能坦白，擔心是沒用的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "計畫已經制定好了，一切都在被設計好的軌道上運行，這時你擠在別人的軌道上，只會讓兩輛電車一起脫軌。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "羅德島幹員",
          "text": "牧群的戰士沒有前進的趨勢......！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不要大意！我們的目標是通過，不是殲滅！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "分批次解決。我們沒有完全處理整片戰場的能力。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭讓人擔心。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "凱爾希",
              "text": "阿米婭是成熟的領導者和優秀的戰士。她熟悉小隊的運作模式以及我們的作戰目的。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "迷迭香讓人擔心。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "凱爾希",
              "text": "迷迭香是強大的攻堅幹員和最受小隊支援的精英幹員。她能夠完整且合理地完成每一項任務，只要這個任務的運作模式是為她量身制訂的。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "戰況讓人擔心。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "凱爾希",
              "text": "切爾諾伯格已經身處風暴的中心，在這種情況下，我們微不足道的關心並不能改變戰局的任何一個部分。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "凱爾希",
              "text": "我們對他們最大的支援，就是成功達成我們小隊的戰略目標。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這樣就夠了？！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "是不是太沒人情味了？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "我不同意。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "她撐過了全部七項訓練流程，在各個測試中取得的成績都在合格以上。有三門是特別優秀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "我不相信這樣的施術者。凱爾希，作為術師，我以源石技藝為豪，以讓源石技藝福澤他人為業。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "Rosmontis絕非這樣的術師。她源石技藝的本質絕非服務人類的那類。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我希望她參與戰鬥，只出於一個考量。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "如果Rosmontis一直身在溫室之中，一旦這個美好的環境破裂，她就會立刻成為一場災難。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "你下不了手的話我來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "Pith！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "你和阿米婭太相信他們的未來了。我們一步踏錯，只會讓別的人永遠失去未來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "決斷之前，至少先有所作為。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "我畏懼那個沒能決斷的未來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "現在。讓她成為精英幹員。不是未來，是現在。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我們現在教導她，打磨她，把她的力量鑄造成型，以最高的標準去要求她，讓她即使被天災襲擊也絕不動搖。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "直到大地上的一切都不能左右她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "到那時候她才有可能真正擺脫哥倫比亞人丟給她的可怕命運，自己決定自己的人生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "這就是我的目的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "我知道你會這麼說，凱爾希。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Pith",
          "text": "誰來保證？誰來做？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我需要你和我一起，需要精英幹員們和我一起去做這件事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "以及，我可以向你保證，只要我還活著，我們就一定能做到。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "如果用溫情和善良去渲染戰爭，那麼戰爭只會變得更加危險。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "我不想這樣去渲染一件既可怖又殘酷的事情，即使我知道這件事從來不該發生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "阿米婭與迷迭香，她們的監護人是整個羅德島，以及羅德島所有負有責任心的幹員。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "在此之上，她們又是小隊戰術的核心，Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凱爾希",
          "text": "對她們有信心，就是對自己有信心。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "喂，霍克，你看到了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "怎麼會沒看到。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "你別說話，會暴露的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（那你問我幹什麼？你可還在大聲喧嘩。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（噓，噓，再這樣說，你可要被隊長罵了。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（她又說不了話，我怎麼知道是她要罵我，還是假借她名義罵我。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（我不會的。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（我知道。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（我說......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（不說了，你是想問這攤東西。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（這一箱箱的武器和護甲。還有這些擺得整整齊齊的機械。如果這是隨手擺在這裡的，那我一定也能隨手撿到幾百萬維多利亞鑄幣。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（那些軍備，我打賭兩百塊，就是烏薩斯的。我還在拉瓦勒搞走私的時候見過，這全都是新款的。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（除了中央軍團，其他部隊裝備這些武器的時間......我猜，打底不超過五年。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（你覺得，這些武器鎧甲什麼的，有多大機率只是整合運動搶來的？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（整合運動那幫拿水管的，我看連怎麼給這些東西上油都不會。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（遊擊隊呢？遊擊隊可是烏薩斯軍出身的。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（遊擊隊，遊擊隊離開所屬集團軍多少年了？那些又大又沉的鐵傢伙，只是被推進湖裡就全都會淹死。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（就算當年他們有帶勤務隊出來，那勤務隊可能也已經死光了。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（你想想，看他們現在的裝備狀況，他們能把自己那身鎧甲擦乾淨就已經是謝天謝地。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（讓他們來整理這些武器？他們可能連哪頭是用來朝著敵人的都弄不清楚。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（你這麼一說，我感覺他們有點傻。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（傻和不懂是兩回事。幹後勤不僅要本事，還要知識。遊擊隊也不蠢，只不過要正好碰到幾個感染了逃出來的勤務官，這種事想碰上都難。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（想趕在烏薩斯處決他們之前救下幾個剛剛被感染的勤務官......難上加難。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（喏......裝備編碼被刮掉了。你可以說逃兵都喜歡這麼幹，但也可以說......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "（要掩人耳目也會這麼幹。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "（手法也太外行了，這刮痕，我連銼鑄碼的銼刀是什麼型號哪家廠子的都看得出。有些人，哈，只能說是被逼急了。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "可現在，最重要的是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "......通知他們。現在通知他們，不管有沒有用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "希望還來得及。隊長，是讓Raidian把消息轉給阿米婭她們，還是我們直接去和他們說？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "我們要從後方牽制住整合運動和這些怪模怪樣的傢伙？知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "等等。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "有不明單位在靠近我們的位置。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "Mantra，你去嗎？讓他們忘記自己在做什麼就行，先別給他們偽造命令啊把他們變成白癡啊什麼的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "你的體力還很寶貴，要是我們真的和整合運動正面衝突了，要靠你化解風險。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "唔？嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "“好。你們也小心。”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍克",
          "text": "知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "那就......我就發信了，隊長。就這個。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "極境",
          "text": "“烏薩斯軍在核心城。”",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
