  "stageId": "main_03-04",
  "title": "龜裂",
  "storyCode": "3-4",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_03-04_end.txt",
