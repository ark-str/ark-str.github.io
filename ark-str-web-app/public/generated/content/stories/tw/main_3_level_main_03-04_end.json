。"},{"type":"dialogue","speakerName":"碎骨","speakerId":null,"isRemote":false,"text":"......咳......好疼......"},{"type":"dialogue","speakerName":"碎骨","speakerId":null,"isRemote":false,"text":"明明有這種力量......"},{"type":"dialogue","speakerName":"碎骨","speakerId":null,"isRemote":false,"text":"......你......就甘......心......看著同胞們......"},{"type":"dialogue","speakerName":"碎骨","speakerId":null,"isRemote":false,"text":"我不能，原諒......"},{"type":"dialogue","speakerName":"碎骨","speakerId":null,"isRemote":false,"text":"原諒你們這種......"},{"type":"dialogue","speakerName":"碎骨","speakerId":null,"isRemote":false,"text":"呃......"},{"type":"sceneBreak"},{"type":"background","backgroundId":null},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"............"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"不...........不要............."},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米婭"]},{"speakerId":"char_012_misa","aliases":["米莎"]},{"speakerId":"char_103_angel","aliases":["能天使"]},{"speakerId":"char_106_franka","aliases":["芙蘭卡"]},{"speakerId":"char_107_liskam","aliases":["雷蛇"]},{"speakerId":"char_136_hsguma","aliases":["星熊"]},{"speakerId":"char_1500_skulsr","aliases":["星熊","碎骨","芙蘭卡"]}]}
