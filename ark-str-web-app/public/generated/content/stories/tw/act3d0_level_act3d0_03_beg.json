  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錫蘭",
      "text": "黑？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "克洛寧的命令現在就是市長的命令，所有人，動手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "把這些人都綁起來。注意不要傷到小姐了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錫蘭",
      "text": "你說什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錫蘭",
      "text": "你也以為我是在鬧著玩嗎？！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "走！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "現在不是說話的時候！",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "保鏢A",
          "text": "他們沿著這條路往沙灘跑了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "保鏢B",
          "text": "嘖，人太多了，不好追。聯絡沙灘的崗哨，圍住他們！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "別想走！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "！？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "欸？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "博士，走，這裡先交給我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "欸？！你，你是......！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "錫蘭，我們先走！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "等一下，哈，哈......博士，我好累......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "終於......到了沙灘......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我也......跑不動了......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "保鏢",
          "text": "大小姐，請跟我們回去吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "我不要！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "保鏢A",
          "text": "別傷著大小姐，那個什麼博士隨便你們處置。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "誰敢隨便處置博士！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "保鏢B",
          "text": "好燙好燙！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "保鏢C",
          "text": "哪兒來的臭小鬼！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "保鏢C",
          "text": "噫！我的屁股！我的屁股！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "喂，博士，你又惹上什麼好玩的事情了，怎麼不叫上我？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "保鏢A",
          "text": "嘖，只是一個臭小鬼，給她點顏色瞧瞧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "我正愁無聊呢，嘿嘿......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "錫蘭",
          "text": "博士，你的臉色怎麼變得比剛才還差？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "伊芙利特，下手別太重！！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "把他們衣服燒光差不多了。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "嘖——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伊芙利特",
          "text": "那就三成！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
