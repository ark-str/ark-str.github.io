  "groupId": "story_melan_set_1",
  "stageId": null,
  "title": "小隊長",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_melan_1_1.txt",
  "sourceHash": "8a561393970447296b220ca8a2277398efce3ee24fc72cab72143884dfb1212d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 玫兰莎"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "10：30p.m.\n羅德島訓練室外"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "這麼晚了，怎麼訓練場的燈還亮著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "還有人在訓練？嗚哇......也太拼了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "啊，玫蘭莎小姐，晚上好！今天也辛苦了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "......你好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "是訓練剛結束嗎？都這個時間了，最近預備小組訓練結束得是不是越來越晚了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "大家有幹勁是好事，但是也要多注意身體啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "啊，呃，謝謝......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "沒關係的，法倫教官在幫我控制訓練量，不會有事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "這樣啊。對了，玫蘭莎小姐吃晚飯了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "還沒有......但是沒有關係，請不用擔心我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "別這麼說嘛，一日三餐可是頭等大事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "有點麻煩了，這個時間食堂可能已經沒剩什麼熟食，要想吃口熱的，估計只能自己做點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "玫蘭莎小姐會做嗎？啊，要不然我來幫忙吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "怎麼了，都堵在路上幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "呃，杜賓教官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "杜賓教官，芙蘭卡小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "嗨~小姑娘，又見面啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "還有空在這裡聊天，怎麼，科林，看來你這周的文件都整理完了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "還要幫人家做飯，我怎麼記得你從來沒把食物煮熟過？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "這個，哈哈，杜賓教官不要這樣揭我短嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "提醒一下，賓斯剛剛還在找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "呃！我還有工作要做，就不打擾幾位了，我這就走......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "求求各位千萬別和主任提起我來過！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "哈哈哈哈，你們羅德島的人還是這麼有意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "丟人，這傢伙還是老樣子......見笑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "玫蘭莎，科林沒做什麼沒禮貌的事吧？他這個人不壞，就是油嘴滑舌了點......如果覺得煩，就別理他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "不、不會，科林先生很親切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "是嗎，那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "當然啦，換我遇到這麼可愛的小姑娘，也會變得很親切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "哎，哎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......你別這麼笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "不懷好意。我怕你會嚇到我的訓練生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "哎呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "教官小姐真嚴格，是不是？小玫，她平時也是這麼管著你們的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "小、小玫？這個......不是的，杜賓教官人很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "雖然嚴格，但都是為了我們著想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "你聽聽，在誇你呢。這不是人望很不錯嘛，你現在是不是在心裡偷著樂？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "咳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "別說這些了。玫蘭莎，關於這次組建預備小隊的事，法倫應該已經和你提過了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "我們討論過後決定，由你來擔任隊長。預備小隊編號A4，如果沒有問題的話，明天我會準備好要簽字的文件帶來給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "透露一下，你們一共有幾支預備小隊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "你怎麼覺得我會說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "問問又不虧，萬一說了呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "放心啦，我只是好奇。對於黑鋼這樣規模的組織來說，羅德島就算再多培養幾支預備隊伍，也完全不算是什麼威脅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "畢竟比起外部的合作方，大家都更傾向於培養屬於自己的班底嘛，我懂我懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "哎，不過，你們的預備血液，看起來好像有點心事哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......玫蘭莎，怎麼了，你有什麼想說的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "那個，教官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "連麵包都已經沒有了嗎......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "（今天果然是有一點太晚了吧，也沒辦法。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "（工作人員都不在，也不能因為這種事情就去麻煩別人......算了，今晚就先忍一忍，回去早點睡吧。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "怎麼啦！怎麼一個人站在這裡歎氣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "哇！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "哇哇哇，什麼，怎麼了！？嚇我一跳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "呃......啊，梅莉，是你啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "欸嘿嘿，是我哦~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "玫蘭莎在這裡幹什麼呢？晚餐供應的時間已經結束了哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "啊，難道說玫蘭莎還沒有吃晚飯？！是肚子餓了嗎？安德切爾做了不少甜點，我正要去找你呢，一起來吃吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "對了對了，今天教官把你留下來說了什麼呀，是什麼好事情嗎？史都華德說玫蘭莎要做我們的隊長了，是真的嗎！史都華德還說——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "——啊！！完蛋了，史都華德還說要保密來著！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "哎呀算了說都說出來了，這種高興的事情根本藏不住嘛！所以是真的嗎？如果是真的就好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我......梅莉，你覺得我真的可以嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "教官，我認為......我不能勝任A4預備小隊隊長這個職位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "非常抱歉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "請法倫老師和教官重新，重新考慮人選。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "唉喲，這我沒想到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "這丫頭說自己不行。怎麼樣，你覺得呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "別不說話啊，你們正經人都這麼悶的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "哎，小玫，那你認為誰適合當你們的小隊長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "......相比起我，史都華德考慮事情更全面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "之前的模擬戰我們有三處失誤，是史都華德在背後補全，才拿到了最後的好成績，大家都很信賴他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "安賽爾他總是關注我們的身體狀況，常常大家還什麼都沒說，他就已經能判斷出我們的狀態，並且已經準備好對應的措施。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "安德切爾，呃，雖然我仍然還是不太懂他在想什麼，但當我們需要火力時，安德切爾總能察覺每個隊友的需要，從最合適的位置發起攻擊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "梅莉......卡緹她心思活潑，但也不缺謹慎，在戰鬥時她會留意保護小隊裡的其他成員，我們的隊形很多時候都圍繞卡緹展開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我認為他們之中不論是誰，都會很適合擔任隊長！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "你知道你現在說的這些，已經都是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......算了。有些東西不該由我來提醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "總之，我暫時不會收回任命，我們有自己的判斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "教官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "現在別再說了。我建議，你應當仔細考慮清楚，最好和小隊其他人聊聊，明天再給我一個回答。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "我們不會干擾你的判斷，合不合適，能不能夠，你自己應當有所決斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "但是，我只問你一個問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "幹員玫蘭莎，你為什麼堅持要成為前線幹員？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我熟悉那些精緻帶有香氣的東西。\n澄淨的午後陽光，瑩亮的玻璃瓶，細滑的絲絨布以及其他高雅的，文明的，享受的東西我都熟悉。\n這是理所當然的，因為那些都是我曾度過的時光。\n但會流血的戰場不是。\n我為什麼要走上戰場？\n為什麼要選擇面對這樣的風險，承受這樣的重壓？\n我想要的......\n我想要的是什麼？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "梅莉，我......我是不是不適合成為幹員？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "你這是說什麼傻話呢！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "欸？等等梅莉，等等，冷靜點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "小心桌子——梅莉，別捶桌子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "現在重點不是桌子啦！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "哪裡不適合了，玫蘭莎不要說自己不好！玫蘭莎明明是最好最好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "別這樣說，我沒有你誇的這麼好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "哼哼！不許反駁！我宣佈玫蘭莎根本不瞭解自己，我比玫蘭莎更瞭解玫蘭莎！不許你說自己不好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "如果玫蘭莎還要反駁，好呀，那就讓我來替你數數！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "玫蘭莎會陪我一起訓練，替我測試新的防禦戰術！她超級好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "玫蘭莎會幫我準備備用的設備，雖然她從來不告訴我，但是我知道！她超級好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "還會給大家帶好吃的零食！全都是我們喜歡的口味！她超級好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "玫蘭莎還和我一起偷偷給教官紮小辮子，她真的超級好！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "等、等一下，最後那個才不會啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "嘿嘿，果然還是騙不過去呀，明明之前史都華德都沒反應過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "啊，雖然最後一句是假的，但是玫蘭莎超級超級好絕對是真的哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "還有什麼要反駁的嗎~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "沒有就好！我們才沒有人會覺得玫蘭莎不適合當隊長呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "但是，最重要的是，玫蘭莎自己是怎麼想的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我的想法......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我真的可以嗎？\n我有這樣的能力，能回應所有人的期盼嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我、我可能不夠好，可能還有很多地方需要學習......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "拋開其他人的想法，我自己......我自己是怎麼想的？\n我想要的是什麼？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我想要有能力保護別人。而不是只能被爸爸媽媽保護，連和家人聯絡都做不到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "我會努力的！我希望自己能成為一個合格的隊長，和大家一起努力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "梅莉，我......可以嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "當然啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "我們不是一直都在一起加油嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "......嗯，謝謝你，梅莉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "嗯嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "嘿嘿，太好了，玫蘭莎你終於笑了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "text": "嗯......看樣子應該是已經沒問題了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "text": "她們在冷凍箱裡找到速凍食品了，她們開始加熱速凍食品了！史都華德，現在該怎麼做，我這些小點心還要送過去嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安賽爾",
      "text": "我們剛剛為什麼不直接出去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "史都華德",
      "text": "應該不要緊了，等等，安德切爾，安賽爾，先別過去。就讓她們單獨相處一會吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "史都華德",
      "text": "我還是頭一次看到玫蘭莎小姐笑得這麼開心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "text": "可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安賽爾",
      "text": "史都華德說得對，現在出去也太不解風情了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "text": "可是，按照卡緹小姐那樣的操作方式......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "嗚哇！怎麼回事，這個東西怎麼不動啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玫蘭莎",
      "text": "這個是......加熱按鈕嗎？好像是接觸不良，是不是不該這樣轉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "沒問題沒問題，我知道該怎麼處理，大致上所有機器都是這樣的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "text": "嘿嘿，看我的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "text": "......她這樣，加熱裝置會壞掉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "史都華德",
      "text": "這種事情拜託你下一次早點說！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "史都華德",
      "text": "等一等，卡緹！別碰那個開關！也不要敲那個發條！！玫蘭莎小姐請快攔住她！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "text": "啊哈哈，來不及了，完蛋了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安賽爾",
      "text": "......哎。你們鬧歸鬧，不要受傷了啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "頭痛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......有一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "因為手下的小隊又多了一筆毀壞廚房器具的帳單？還是因為那個害羞的小隊長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "都有。玫蘭莎她還是對自己太沒有自信了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "是嗎？不過，我倒是覺得這也不是什麼壞事啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "比起那些明明能力不足卻還自信滿滿的傢伙，謹慎點的人反而更加讓人放心，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "而且你聽聽她說的那些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "每一個隊員，她這不是都看在眼裡？這不就是隊長該做的事嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "如果她能意識到這一點，就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "放心，照我說，那幾個小朋友肯定沒什麼問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "text": "哎，我想到了！她也是用劍？那不如，就讓我來教導這小姑娘吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
