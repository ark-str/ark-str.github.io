{
  "server": "tw",
  "storyId": "story_sqrrel_set_2_story_2",
  "groupId": "story_sqrrel_set_2",
  "stageId": null,
  "title": "易燃品",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_sqrrel_2_1.txt",
  "sourceHash": "23918027478f69086990164aed950963f98c881435b7811a5bbff8d30eac6e42",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "阿消工作日誌\n1月5日  陰\n下城區一棟居民樓發生火災。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "請各位不要慌亂聽從指示儘快撤至警戒線外，請大家不要慌亂......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "完了......一輩子積蓄，全沒了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哈哈......燒得好啊，把這鬼地方燒得乾乾淨淨才好！哈哈哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "媽......媽媽......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "開闢道路！優先確保重傷人員得到救治！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "咳咳......咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "居民都疏散完了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局成員",
      "text": "報告長官，沒有發現其他被困人員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "媽媽！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性居民",
      "text": "萌萌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "請大家相互看看，有沒有自己認識的人還沒有撤離出來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性居民",
      "text": "有沒有人見到，住在三樓的那個怪人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民",
      "text": "對啊，好像沒見到他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "三樓，那不就是起火的樓層嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "這可不是開玩笑的事，你們能確定他在家嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性居民",
      "text": "我......我不確定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "我知道！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "那個叔叔每次出門的時候都會拉開窗簾，可我剛才跑下來的時候，看到窗簾是拉上的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "......麻煩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "喂，喂——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "報告總部，現場還有被困人員，火勢嚴峻已不允許消防人員再次進入，請儘快調派消防車，請儘快——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "讓我去吧！我會想辦法把那個人帶出來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "開什麼玩笑，你這是在送命！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "這應該是源石點火裝置爆炸引起的火災，現場隨時可能發生連鎖爆炸——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "所以困在裡面的人才更危險！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "沒時間猶豫了長官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我有不止一次的火場救援經驗請相信我長官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "保持聯絡......千萬小心。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通訊聲",
      "text": "......阿消，現場怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "報告，我已進入燃燒建築。火場溫度大概在四百五十度左右。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "建築是老式居民樓，樓體為普通鋼筋混凝土結構。如果不能及時滅火樓體承載能力也會受到影響。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "一樓暫時沒有被火情波及但是已有大量煙霧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我已進入秘密頻道，即將進入二樓。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通訊聲",
      "text": "收到，請注意安全。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通訊聲",
      "text": "阿消，彙報情況。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "咳咳......目前我在二樓煙霧濃度很高......三樓情況應該更加嚴峻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "被困的人處境一定很危險得抓緊時間才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "視野很不清楚......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通訊聲",
      "text": "阿消，不要逞能。如果無法進入就立刻撤出來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "報告長官安全通道可以通行！準備進入三——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通訊聲",
      "text": "阿消！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "咳咳......報告長官我沒事！是居民放在這裡的櫃子倒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "（安全通道裡一定不能堆積雜物這個知識點得加到下次的消防安全演講稿裡才行。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通訊聲",
      "text": "小心一點......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "救命......救......命......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "啊！報告長官我聽到求救聲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "在那邊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "是這間屋子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "救......救救我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "先生！我聽見您了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "請您捂住口鼻不要說話儘量保留體力！我這就想辦法救您出來。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "瘦小的札拉克用肩膀拼命撞向灼熱的鐵門，大門紋絲未動。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "（糟糕門框已經因為高溫變形了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "（試試能不能用斧子劈開。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "先生！請您離門邊遠一點！要小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "嘿呀——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "可以！有效果！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火星飛濺，阿消手中的斧頭也因火場的高溫變得滾燙。\n阿消用力攥緊斧柄，又更用力地向門鎖劈砍下去。門鎖處的裂口已經清晰可見。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "就差一點了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "救火......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "救火......救火......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "救人......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "阿消？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "阿消，阿消！醒醒！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "火滅了嗎——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "阿消！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "嚇死我了，你可算醒了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "火、火情怎麼樣了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "你別亂動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "別擔心，火已經滅了。你已經做得很好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "現在問題在你。醫生說你吸入了過多一氧化碳，現在必須安靜休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "不要亂動，把呼吸面罩戴好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "等，等一下！那個人呢！還有一個人被困在火場裡那位先生怎麼樣了？！我得去——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "阿消！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "長官我還能——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "已經來不及了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿消沒有想到，在那扇門後面居然是這樣狹小的一間房間。\n屋裡的一切都化為焦炭，這讓它看上去又有些空曠。\n在房間的角落裡有一個保險箱，已經因為高溫而變形，裡面存放的東西卻奇跡般地保留了下來。\n是一小疊龍門幣和一本集郵冊。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "阿消。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "收隊了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火災事發突然，造成一人死亡，十一人重傷。\n第一次見到生命在眼前消逝。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "1月8日  小雨\n找回了一隻寵物羽獸。\n訓練的時候走神了，受到批評。寫了一份檢討。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "1月11日 晴\n關於之前火災的調查結束了，是家用源石點火裝置老化引發的火災，進而引發連鎖爆炸。居民樓中堆積了許多雜物導致火勢迅速蔓延。\n在大會上得到表揚。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "1月13日 陰\n請假。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "您、您說查不到？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "是啊，現場你也看到了，生活痕跡全都被燒得乾乾淨淨，什麼線索都沒留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "後來我們在周圍鄰居間調查過，只瞭解到死者是名男性，平時獨居，工作不明，沒有什麼人際來往。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "那他的親人呢？他的親人，總該要知道的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "我們已經在報紙上發了屍體認領通知，但是到現在也沒有人來認領。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "可是萬一，萬一家屬看不到呢？如果他的家人都不在龍門......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "這可不是我們職責範圍內的事了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "難道真的沒有辦法了嗎......\n對了，集郵冊！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "房間裡不是還剩下一本集郵冊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "你說那個啊，我們也研究過了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "雖然不知道他為什麼要專門鎖在保險箱裡，但經過檢查可以確定只是本普通的集郵冊，甚至連指紋都沒有。查不出什麼線索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "話說回來，阿消，你為什麼還在追問那次火災的事，相關調查應該已經結束了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "就是家用源石點火裝置引發的火災，這是近衛局和消防隊一致得出的結論，應該沒什麼疑問才對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "長官......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "長官......可以把那本集郵冊給我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "按規定，這種無名死者的遺物本來是要銷毀的。給你倒也不是不行，不過你要它幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "長官......我有非常重要的事想要知道但我還不知道怎麼解釋——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "唉，真拿你沒辦法......跟我來吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "非常感謝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民",
      "text": "三樓住戶？不是前幾天才來問過一遍嗎？都說了不認識他！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民",
      "text": "整天擺著張臭臉，見誰都愛搭不理的樣子，誰會理那種人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民",
      "text": "我一大半屋子都燒沒了，哪還有功夫管別人？我很忙，別煩我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "非常抱歉，打擾您了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性居民",
      "text": "這棟樓裡居民不多，大家基本都是相互認識的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性居民",
      "text": "但是那一位，從來不和別人說話，好像甚至從來不在白天出門，所以大家都不太清楚他的情況......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "我見過那個叔叔一次，他個子特別高！有這——麼高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "他對我笑了，還給了我一顆糖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "咦，是叔叔還是爺爺？我也不清楚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性居民",
      "text": "萌萌！和你說過多少次，不許拿陌生人的東西！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性居民",
      "text": "不好意思沒能幫上您，我們還有事，先走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "打擾您了非常感謝再見！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "還是不知道......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "1月15日  陰\n請假。\n問過了許多人，沒有人知道那位先生的情況。\n好像火災真的可以把一個人的生活痕跡燒得乾乾淨淨。他彷彿從來沒有在這個城市出現過一樣。\n不對，這些不是工作內容，不應該寫在這......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "......請等一下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "您好打擾您了請問您是郵局的工作人員嗎我可以向您諮詢一點事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "請您看看這本集郵冊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "啊？要是想諮詢收藏品價值，你得找郵局的收藏專家掛號預約才行。我這都要下班了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "不是的！非常抱歉，我想問一下，您可以透過這本集郵冊看出它的主人的資訊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "這是什麼意思......這本集郵冊不是你的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "不是......不對也不能說不是，總之可以麻煩您看看嗎？這真的很重要......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "好吧好吧，你先別急，我看看再說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "嗯......這種收集倒是少見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "您看出什麼了嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "也算不上看出什麼，只是很奇怪啊，為什麼會有人收集這種郵票？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "這、這怎麼說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "人們一般都會選擇收集有特殊意義，或者是限量發行的郵票對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "但是這本集郵冊裡全是最常見的郵票，完全沒有收藏價值啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "沒有收藏價值？可是它的主人明明把它保管得很好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "完全看不懂這位藏主的收藏邏輯，郵票的主題和年份都很混亂，有郵戳和沒有郵戳的郵票也都混在一起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "不過關於勾吳風景的格外多，你看，從這一頁開始後面就全是勾吳風景主題的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "這張“灰齊山麓”倒是有些年頭了，沒記錯的話應該是好幾十年前發行的？當時發行量很大，所以也不算很值錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "除了這些，我是真的看不出這套收藏有什麼特別的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "只有這些了嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "你要是問能從這套收藏中看出藏主的什麼資訊，我只能說抱歉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "非要說的話，那他大概是個很喜歡勾吳風景的人吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "明白了......非常感謝您！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "勾吳風景......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "那位先生......是勾吳人嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "“勾吳人家”......就是這了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "客人裡面請，隨便坐啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "老闆您好我想和您打聽一些事......請問您這是正宗勾吳菜嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "哎你這小姑娘，你倒是在整個龍門打聽一遍，看哪家勾吳菜敢說比我家正宗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "對、對不起！我不是這個意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我想問的是，會有勾吳人經常來您這裡吃飯嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "勾吳人？當然有啊。好多來龍門打工的勾吳人，來我這吃過，都說和老家味道一模一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "你要是不信，不如親自嘗嘗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "老闆......我想向您打聽一個客人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "他......他應該是勾吳人......是男性，個子特別高。應該很拮据。看上去或許有點凶，也許不凶......只會在晚上過來吃飯，經常獨來獨往......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "可能我說得不太清楚但是......您有印象嗎！哪怕是一點點線索都行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "你說......個子特別高？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "有印象，有印象。的確有這麼一號客人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "您認識他？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "嗯......算是個熟人吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "就像你說的，每次都是一個人來吃飯，還總是趕凌晨我快打烊了才過來。就為他一個客人，我得晚收攤一個小時，唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "他來了也不多點，就點一條鱗一盤小菜，還有一瓶酒。吃完喝完，自己坐一會兒就走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "對，看上去是有點凶，但人還不錯，吃完飯還會主動幫我收拾。有時候多喝幾杯，還會拉著我給我講他老家的事，真是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "老闆......您知道，他有什麼親人朋友嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "親人朋友？那他可沒跟我說過。不過看起來不像是結了婚的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "不過你要這麼想知道，他下回來我可以幫你問問？不對不對，我這算不算洩露客人隱私啊......哎，還是下回你自己找他問吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "老闆，您能再和我說說，這個客人的事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "他應該，再也不會來了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "不會來了？不可能不可能，他可喜歡吃我做的菜了。就是他說，我做的菜和老家的味道一模一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "不過說起來，他的確有段時間沒來了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "那個年輕人，也不知道在忙什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "等、等一下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "您、您剛說，他是個......年輕人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "對啊，是個年輕人，看上去年紀比你大一些，但也大不了多少吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "郵局員工",
      "text": "這張“灰齊山麓”倒是有些年頭了，沒記錯的話應該是好幾十年前發行的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "哎哎哎，小姑娘你怎麼哭了？你，你是要找親人還是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "好好我答應你，下回那個人來的時候我一定問清楚，你別哭了好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "哎喲，這不是巧了。小夥子你可來了，你看看這個小姑娘，說是找我打聽你，結果說著說著還哭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老闆",
      "text": "我可不知道發生了什麼事啊，你看著勸勸吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "是......是您！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "阿消？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "真懷念啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "“灰齊山麓”......我就是在這灰齊山腳下的小鎮子長大的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "還記得，後山有一座小池塘。小時候家裡吃的鱗，都是從那裡面釣的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "到了龍門，碼頭倒也能買到挺新鮮的鱗，可是再也找不到那樣釣鱗的好去處了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "好久沒回去了，老家風景，在郵票上看起來居然這麼好看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "您說的這些地方，那個人也去過嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "那可不好說啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "勾吳不大，但人口也算不上少。只可惜，我不認識那一位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "不過，剛聽你講了這些，我對這個人好像也不能說是陌生了——你倒是心細，我們之前調查時，都沒有想到這一層。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "長官......您覺得，這位先生是怎樣的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "不好說啊......應該，是個很想家的人吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "所以你要這本集郵冊，就是想找到死者的家人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "為什麼這麼執著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我......我沒能救下他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "當時......我，我已經聽到他的聲音了，他就在門口向我求救......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "如果當時我的動作可以再快一點，我是不是就可以......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "一個人不應該就這樣消失了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我想至少要找到他的家人，把他這本集郵冊交給他們，說一句對不起......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "阿消，不管多少遍我還是要說，你盡力了。在那種情況下，沒人能做得比你更好，你自己也不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "我不能告訴你這樣的念頭就是錯的，但是，你背著這樣的包袱，下次還能毫不猶豫地衝進火場嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "阿消，這不是你的錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "不說了，這是你自己要想明白的事，我也沒什麼資格教育你就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "資深近衛局成員",
      "text": "晚上風大，早點回去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "嗚......嗚嗚......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "嗚......嗚嗚......嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "嗚啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿消工作日誌\n1月16日  陰\n調休的最後一天，做了很丟臉的事。\n雖然到最後還是沒有找到那位先生的資訊，也不知道該怎麼整理好心情，但是還有更重要的事要去做。\n1月17日  晴\n回到崗位第一天。\n落下了許多訓練，得抓緊補上才行。似乎有點感冒，要努力恢復過來！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "剛才，向大家講述了常見的點火裝置可能造成的危害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "事例中的火災情形並不只是理論上的可能，在兩年前，龍門就發生過這樣的一場火災......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我們要牢記在火災現場正確的逃生方式，但是歸根結底，對於火災，最有效的方式，永遠是防患於未然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "比起天災，火災，往往因人的行為而產生，但卻很難因人的意志而消失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "事故可以從源頭上防範，而悲劇一旦發生，無論怎樣懊悔，都無法挽回......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "喂喂，天火。是不是我的錯覺，剛才小個子說了那麼一大段話好像都沒有緊張哎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "噓——認真聽講，就是專門說給你聽的，你還打岔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "你還說我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "可是，小個子怎麼看起來很難過的樣子，這種時候該怎麼辦？是不是應該掌聲鼓勵一下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "安靜聽講！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "大家，大家都聽明白了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "我、我是不是講得太快了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "不能緊張不能緊張......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "咳......剛、剛才講了點火裝置造成的火災，但是除此之外造成火災的原因還有很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿消",
      "text": "接下來我們要講的電路安全請相關工程幹員一定要認真聽講......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
